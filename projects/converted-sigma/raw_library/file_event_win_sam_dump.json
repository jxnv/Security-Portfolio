{
  "title": "Potential SAM Database Dump",
  "id": "4e87b8e2-2ee9-4b2a-a715-4727d297ece0",
  "status": "test",
  "description": "Detects the creation of files that look like exports of the local SAM (Security Account Manager)",
  "author": "Florian Roth (Nextron Systems)",
  "date": "2022-02-11",
  "tags": [
    "attack.credential-access",
    "attack.t1003.002"
  ],
  "level": "high",
  "logsource": {
    "product": "windows",
    "category": "file_event"
  },
  "detection": {
    "selection": [
      {
        "TargetFilename|endswith": [
          "\\Temp\\sam",
          "\\sam.sav",
          "\\Intel\\sam",
          "\\sam.hive",
          "\\Perflogs\\sam",
          "\\ProgramData\\sam",
          "\\Users\\Public\\sam",
          "\\AppData\\Local\\sam",
          "\\AppData\\Roaming\\sam",
          "_ShadowSteal.zip",
          "\\Documents\\SAM.export",
          ":\\sam"
        ]
      },
      {
        "TargetFilename|contains": [
          "\\hive_sam_",
          "\\sam.save",
          "\\sam.export",
          "\\~reg_sam.save",
          "\\sam_backup",
          "\\sam.bck",
          "\\sam.backup"
        ]
      }
    ],
    "condition": "selection"
  }
}
