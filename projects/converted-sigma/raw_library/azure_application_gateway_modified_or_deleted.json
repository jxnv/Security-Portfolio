  "status": "test",
  "description": "Identifies when a application gateway is modified or deleted.",
  "author": "Austin Songer",
  "date": "2021-08-16",
  "tags": [
    "attack.impact"
  ],
  "level": "medium",
  "logsource": {
    "product": "azure",
    "service": "activitylogs"
  },
  "detection": {
    "selection": {
      "operationName": [
