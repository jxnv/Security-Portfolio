{
  "title": "BITS Transfer Job Download To Potential Suspicious Folder",
  "id": "f8a56cb7-a363-44ed-a82f-5926bb44cd05",
  "status": "test",
  "description": "Detects new BITS transfer job where the LocalName/Saved file is stored in a potentially suspicious location",
  "author": "Florian Roth (Nextron Systems)",
  "date": "2022-06-28",
  "tags": [
    "attack.persistence",
    "attack.execution",
    "attack.stealth",
    "attack.t1197"
  ],
  "level": "high",
  "logsource": {
    "product": "windows",
    "service": "bits-client"
  },
  "detection": {
    "selection": {
      "EventID": 16403,
      "LocalName|contains": [
        "\\Desktop\\",
        "C:\\Users\\Public\\",
        "C:\\PerfLogs\\"
      ]
    },
    "condition": "selection"
  }
}
