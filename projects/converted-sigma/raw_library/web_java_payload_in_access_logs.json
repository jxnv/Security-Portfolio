{
  "title": "Java Payload Strings",
  "id": "583aa0a2-30b1-4d62-8bf3-ab73689efe6c",
  "status": "test",
  "description": "Detects possible Java payloads in web access logs",
  "author": "frack113, Harjot Singh, \"@cyb3rjy0t\" (update)",
  "date": "2022-06-04",
  "tags": [
    "cve.2022-26134",
    "cve.2021-26084",
    "attack.initial-access",
    "attack.t1190"
  ],
  "level": "high",
  "logsource": {
    "category": "webserver"
  },
  "detection": {
    "keywords": [
      "%24%7B%28%23a%3D%40",
      "${(#a=@",
      "%24%7B%40java",
      "${@java",
      "u0022java",
      "%2F%24%7B%23",
      "/${#",
      "new+java.",
      "getRuntime().exec(",
      "getRuntime%28%29.exec%28"
    ],
    "condition": "keywords"
  }
}
