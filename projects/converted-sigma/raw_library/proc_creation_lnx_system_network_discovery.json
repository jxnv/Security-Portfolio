{
  "title": "System Network Discovery - Linux",
  "id": "e7bd1cfa-b446-4c88-8afb-403bcd79e3fa",
  "status": "test",
  "description": "Detects enumeration of local network configuration",
  "author": "\u00d6mer G\u00fcnal and remotephone, oscd.community",
  "date": "2020-10-06",
  "tags": [
    "attack.discovery",
    "attack.t1016"
  ],
  "level": "informational",
  "logsource": {
    "category": "process_creation",
    "product": "linux"
  },
  "detection": {
    "selection_img": {
      "Image|endswith": [
        "/firewall-cmd",
        "/ufw",
        "/iptables",
        "/netstat",
        "/ss",
        "/ip",
        "/ifconfig",
        "/systemd-resolve",
        "/route"
      ]
    },
    "selection_cli": {
      "CommandLine|contains": "/etc/resolv.conf"
    },
    "condition": "1 of selection_*"
  }
}
