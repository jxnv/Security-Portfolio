{
  "title": "SysKey Registry Keys Access",
  "id": "9a4ff3b8-6187-4fd2-8e8b-e0eae1129495",
  "status": "test",
  "description": "Detects handle requests and access operations to specific registry keys to calculate the SysKey",
  "author": "Roberto Rodriguez @Cyb3rWard0g",
  "date": "2019-08-12",
  "tags": [
    "attack.discovery",
    "attack.t1012"
  ],
  "level": "high",
  "logsource": {
    "product": "windows",
    "service": "security"
  },
  "detection": {
    "selection": {
      "EventID": [
        4656,
        4663
      ],
      "ObjectType": "key",
      "ObjectName|endswith": [
        "lsa\\JD",
        "lsa\\GBG",
        "lsa\\Skew1",
        "lsa\\Data"
      ]
    },
    "condition": "selection"
  }
}
