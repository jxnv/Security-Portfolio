{
  "title": "VHD Image Download Via Browser",
  "id": "8468111a-ef07-4654-903b-b863a80bbc95",
  "status": "test",
  "description": "Detects creation of \".vhd\"/\".vhdx\" files by browser processes.\nMalware can use mountable Virtual Hard Disk \".vhd\" files to encapsulate payloads and evade security controls.\n",
  "author": "frack113, Christopher Peacock '@securepeacock', SCYTHE '@scythe_io'",
  "date": "2021-10-25",
  "tags": [
    "attack.resource-development",
    "attack.t1587.001"
  ],
  "level": "medium",
  "logsource": {
    "category": "file_event",
    "product": "windows"
  },
  "detection": {
    "selection": {
      "Image|endswith": [
        "\\brave.exe",
        "\\chrome.exe",
        "\\firefox.exe",
        "\\iexplore.exe",
        "\\maxthon.exe",
        "\\MicrosoftEdge.exe",
        "\\msedge.exe",
        "\\msedgewebview2.exe",
        "\\opera.exe",
        "\\safari.exe",
        "\\seamonkey.exe",
        "\\vivaldi.exe",
        "\\whale.exe"
      ],
      "TargetFilename|contains": ".vhd"
    },
    "condition": "selection"
  }
}
