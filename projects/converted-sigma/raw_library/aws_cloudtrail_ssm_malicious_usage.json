{
  "title": "Potential Malicious Usage of CloudTrail System Manager",
  "id": "38e7f511-3f74-41d4-836e-f57dfa18eead",
  "status": "test",
  "description": "Detect when System Manager successfully executes commands against an instance.\n",
  "author": "jamesc-grafana",
  "date": "2024-07-11",
  "tags": [
    "attack.privilege-escalation",
    "attack.initial-access",
    "attack.t1566",
    "attack.t1566.002"
  ],
  "level": "high",
  "logsource": {
    "product": "aws",
    "service": "cloudtrail"
  },
  "detection": {
    "selection_event": {
      "eventName": "SendCommand",
      "eventSource": "ssm.amazonaws.com"
    },
    "selection_status_success": {
      "errorCode": "Success"
    },
    "selection_status_null": {
      "errorCode": null
    },
    "condition": "selection_event and 1 of selection_status_*"
  }
}
