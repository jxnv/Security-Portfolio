{
  "title": "Password Policy Discovery - Linux",
  "id": "ca94a6db-8106-4737-9ed2-3e3bb826af0a",
  "status": "stable",
  "description": "Detects password policy discovery commands",
  "author": "\u00d6mer G\u00fcnal, oscd.community, Pawel Mazur",
  "date": "2020-10-08",
  "tags": [
    "attack.discovery",
    "attack.t1201"
  ],
  "level": "low",
  "logsource": {
    "product": "linux",
    "service": "auditd"
  },
  "detection": {
    "selection_files": {
      "type": "PATH",
      "name": [
        "/etc/login.defs",
        "/etc/pam.d/auth",
        "/etc/pam.d/common-account",
        "/etc/pam.d/common-auth",
        "/etc/pam.d/common-password",
        "/etc/pam.d/system-auth",
        "/etc/security/pwquality.conf"
      ]
    },
    "selection_chage": {
      "type": "EXECVE",
      "a0": "chage",
      "a1": [
        "--list",
        "-l"
      ]
    },
    "selection_passwd": {
      "type": "EXECVE",
      "a0": "passwd",
      "a1": [
        "-S",
        "--status"
      ]
    },
    "condition": "1 of selection_*"
  }
}
