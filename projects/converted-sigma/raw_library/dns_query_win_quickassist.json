{
  "title": "DNS Query Request By QuickAssist.EXE",
  "id": "882e858a-3233-4ba8-855e-2f3d3575803d",
  "status": "experimental",
  "description": "Detects DNS queries initiated by \"QuickAssist.exe\" to Microsoft Quick Assist primary endpoint that is used to establish a session.\n",
  "author": "Muhammad Faisal (@faisalusuf)",
  "date": "2024-12-19",
  "tags": [
    "attack.command-and-control",
    "attack.initial-access",
    "attack.lateral-movement",
    "attack.t1071.001",
    "attack.t1210"
  ],
  "level": "low",
  "logsource": {
    "category": "dns_query",
    "product": "windows"
  },
  "detection": {
    "selection": {
      "Image|endswith": "\\QuickAssist.exe",
      "QueryName|endswith": "remoteassistance.support.services.microsoft.com"
    },
    "condition": "selection"
  }
}
