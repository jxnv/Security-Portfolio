{
  "title": "BloodHound Collection Files",
  "id": "02773bed-83bf-469f-b7ff-e676e7d78bab",
  "status": "test",
  "description": "Detects default file names outputted by the BloodHound collection tool SharpHound",
  "author": "C.J. May",
  "date": "2022-08-09",
  "tags": [
    "attack.discovery",
    "attack.t1087.001",
    "attack.t1087.002",
    "attack.t1482",
    "attack.t1069.001",
    "attack.t1069.002",
    "attack.execution",
    "attack.t1059.001"
  ],
  "level": "high",
  "logsource": {
    "product": "windows",
    "category": "file_event"
  },
  "detection": {
    "selection": {
      "TargetFilename|endswith": [
        "BloodHound.zip",
        "_computers.json",
        "_containers.json",
        "_gpos.json",
        "_groups.json",
        "_ous.json",
        "_users.json"
      ]
    },
    "filter_optional_ms_winapps": {
      "Image|endswith": "\\svchost.exe",
      "TargetFilename|startswith": "C:\\Program Files\\WindowsApps\\Microsoft.",
      "TargetFilename|endswith": "\\pocket_containers.json"
    },
    "condition": "selection and not 1 of filter_optional_*"
  }
}
