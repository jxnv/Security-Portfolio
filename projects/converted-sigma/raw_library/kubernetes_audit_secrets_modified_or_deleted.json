{
  "title": "Kubernetes Secrets Modified or Deleted",
  "id": "58d31a75-a4f8-4c40-985b-373d58162ca2",
  "status": "test",
  "description": "Detects when Kubernetes Secrets are Modified or Deleted.\n",
  "author": "kelnage",
  "date": "2024-07-11",
  "tags": [
    "attack.credential-access"
  ],
  "level": "medium",
  "logsource": {
    "product": "kubernetes",
    "service": "audit"
  },
  "detection": {
    "selection": {
      "objectRef.resource": "secrets",
      "verb": [
        "create",
        "delete",
        "patch",
        "replace",
        "update"
      ]
    },
    "condition": "selection"
  }
}
