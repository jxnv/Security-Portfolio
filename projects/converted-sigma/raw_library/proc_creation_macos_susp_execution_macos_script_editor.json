{
  "title": "Suspicious Execution via macOS Script Editor",
  "id": "6e4dcdd1-e48b-42f7-b2d8-3b413fc58cb4",
  "status": "test",
  "description": "Detects when the macOS Script Editor utility spawns an unusual child process.",
  "author": "Tim Rauch (rule), Elastic (idea)",
  "date": "2022-10-21",
  "tags": [
    "attack.defense-impairment",
    "attack.t1566",
    "attack.t1566.002",
    "attack.initial-access",
    "attack.t1059",
    "attack.t1059.002",
    "attack.t1204",
    "attack.t1204.001",
    "attack.execution",
    "attack.persistence",
    "attack.t1553"
  ],
  "level": "medium",
  "logsource": {
    "category": "process_creation",
    "product": "macos"
  },
  "detection": {
    "selection_parent": {
      "ParentImage|endswith": "/Script Editor"
    },
    "selection_img": [
      {
        "Image|endswith": [
          "/curl",
          "/bash",
          "/sh",
          "/zsh",
          "/dash",
          "/fish",
          "/osascript",
          "/mktemp",
          "/chmod",
          "/php",
          "/nohup",
          "/openssl",
          "/plutil",
          "/PlistBuddy",
          "/xattr",
          "/sqlite",
          "/funzip",
          "/popen"
        ]
      },
      {
        "Image|contains": [
          "python",
          "perl"
        ]
      }
    ],
    "condition": "all of selection_*"
  }
}
