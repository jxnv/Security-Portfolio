{
  "title": "Vim GTFOBin Abuse - Linux",
  "id": "7ab8f73a-fcff-428b-84aa-6a5ff7877dea",
  "status": "test",
  "description": "Detects the use of \"vim\" and it's siblings commands to execute a shell or proxy commands.\nSuch behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments.\n",
  "author": "Nasreddine Bencherchali (Nextron Systems), Luc G\u00e9naux",
  "date": "2022-12-28",
  "tags": [
    "attack.execution",
    "attack.discovery",
    "attack.t1059",
    "attack.t1083"
  ],
  "level": "high",
  "logsource": {
    "category": "process_creation",
    "product": "linux"
  },
  "detection": {
    "selection_img": {
      "Image|endswith": [
        "/rvim",
        "/vi",
        "/vim",
        "/vimdiff"
      ],
      "CommandLine|contains": [
        " --cmd ",
        " -c"
      ]
    },
    "selection_cli": {
      "CommandLine|contains": [
        ":!/",
        ":!$",
        ":!..",
        ":lua ",
        ":py ",
        ":shell",
        "/bin/bash",
        "/bin/dash",
        "/bin/fish",
        "/bin/sh",
        "/bin/csh",
        "/bin/ksh",
        "/bin/zsh",
        "/bin/tmux"
      ]
    },
    "condition": "all of selection_*"
  }
}
