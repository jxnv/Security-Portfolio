{
  "title": "SQLite Chromium Profile Data DB Access",
  "id": "24c77512-782b-448a-8950-eddb0785fc71",
  "status": "test",
  "description": "Detect usage of the \"sqlite\" binary to query databases in Chromium-based browsers for potential data stealing.",
  "author": "TropChaud",
  "date": "2022-12-19",
  "tags": [
    "attack.credential-access",
    "attack.t1539",
    "attack.t1555.003",
    "attack.collection",
    "attack.t1005"
  ],
  "level": "high",
  "logsource": {
    "category": "process_creation",
    "product": "windows"
  },
  "detection": {
    "selection_sql": [
      {
        "Product": "SQLite"
      },
      {
        "Image|endswith": [
          "\\sqlite.exe",
          "\\sqlite3.exe"
        ]
      }
    ],
    "selection_chromium": {
      "CommandLine|contains": [
        "\\User Data\\",
        "\\Opera Software\\",
        "\\ChromiumViewer\\"
      ]
    },
    "selection_data": {
      "CommandLine|contains": [
        "Login Data",
        "Cookies",
        "Web Data",
        "History",
        "Bookmarks"
      ]
    },
    "condition": "all of selection_*"
  }
}
