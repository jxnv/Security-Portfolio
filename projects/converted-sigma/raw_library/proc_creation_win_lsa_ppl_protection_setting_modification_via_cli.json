{
  "title": "LSA PPL Protection Setting Modification via CommandLine",
  "id": "8c0eca51-0f88-4db2-9183-fdfb10c703f9",
  "status": "test",
  "description": "Detects modification of LSA PPL protection settings via CommandLine.\nIt may indicate an attempt to disable protection and enable credential dumping tools to access LSASS process memory.\n",
  "author": "Florian Roth (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems)",
  "date": "2022-03-22",
  "tags": [
    "attack.defense-impairment",
    "attack.t1689"
  ],
  "level": "medium",
  "logsource": {
    "category": "process_creation",
    "product": "windows"
  },
  "detection": {
    "selection_img": [
      {
        "Image|endswith": [
          "\\reg.exe",
          "\\powershell.exe",
          "\\pwsh.exe"
        ]
      },
      {
        "OriginalFileName": [
          "reg.exe",
          "powershell.exe",
          "pwsh.dll"
        ]
      }
    ],
    "selection_cli_action": {
      "CommandLine|contains|all": [
        "ControlSet",
        "\\Control\\Lsa"
      ],
      "CommandLine|contains": [
        "Set-ItemProperty",
        "New-ItemProperty",
        " add "
      ]
    },
    "selection_key": {
      "CommandLine|contains": [
        "IsPplAutoEnabled",
        "RunAsPPL",
        "RunAsPPLBoot"
      ]
    },
    "condition": "all of selection_*"
  }
}
