{
  "title": "Curl File Upload To File Sharing Websites",
  "id": "e328cc73-f92a-42fb-b3fa-7c2cffda981a",
  "status": "experimental",
  "description": "Detects usage of curl to upload files to known file sharing domains, which may indicate data exfiltration.",
  "author": "Swachchhanda Shrawan Poudel (Nextron Systems)",
  "date": "2026-03-29",
  "tags": [
    "attack.exfiltration",
    "attack.t1567.002"
  ],
  "level": "high",
  "logsource": {
    "category": "process_creation",
    "product": "windows"
  },
  "detection": {
    "selection_img": [
      {
        "Image|endswith": "\\curl.exe"
      },
      {
        "OriginalFileName": "curl.exe"
      }
    ],
    "selection_cli_domain": {
      "CommandLine|contains": [
        "0x0.st",
        "bashupload.com",
        "chunk.io",
        "file.io",
        "filebin.net",
        "pastebin",
        "send.firefox.com",
        "temp.sh",
        "transfer.sh",
        "ufile.io",
        "uploadfiles.io",
        "wetransfer.com",
        "x0.at"
      ]
    },
    "selection_cli_flags": [
      {
        "CommandLine|contains": [
          " --form",
          " --upload-file",
          " --data",
          " -X POST",
          " --request POST "
        ]
      },
      {
        "CommandLine|re": [
          "\\s-[FTd]\\s",
          "\\s-sT\\s"
        ]
      }
    ],
    "condition": "all of selection_*"
  }
}
