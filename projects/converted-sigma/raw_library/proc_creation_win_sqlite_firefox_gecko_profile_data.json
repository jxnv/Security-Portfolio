{
  "title": "SQLite Firefox Profile Data DB Access",
  "id": "4833155a-4053-4c9c-a997-777fcea0baa7",
  "status": "test",
  "description": "Detect usage of the \"sqlite\" binary to query databases in Firefox and other Gecko-based browsers for potential data stealing.",
  "author": "frack113",
  "date": "2022-04-08",
  "tags": [
    "attack.credential-access",
    "attack.t1539",
    "attack.collection",
    "attack.t1005"
  ],
  "level": "high",
  "logsource": {
    "category": "process_creation",
    "product": "windows"
  },
  "detection": {
    "selection_sql": [
      {
        "Product": "SQLite"
      },
      {
        "Image|endswith": [
          "\\sqlite.exe",
          "\\sqlite3.exe"
        ]
      }
    ],
    "selection_firefox": {
      "CommandLine|contains": [
        "cookies.sqlite",
        "places.sqlite"
      ]
    },
    "condition": "all of selection_*"
  }
}
