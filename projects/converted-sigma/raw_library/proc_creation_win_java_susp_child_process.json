{
  "title": "Suspicious Processes Spawned by Java.EXE",
  "id": "0d34ed8b-1c12-4ff2-828c-16fc860b766d",
  "status": "test",
  "description": "Detects suspicious processes spawned from a Java host process which could indicate a sign of exploitation (e.g. log4j)",
  "author": "Andreas Hunkeler (@Karneades), Florian Roth",
  "date": "2021-12-17",
  "tags": [
    "attack.initial-access",
    "attack.persistence",
    "attack.privilege-escalation"
  ],
  "level": "high",
  "logsource": {
    "category": "process_creation",
    "product": "windows"
  },
  "detection": {
    "selection": {
      "ParentImage|endswith": "\\java.exe",
      "Image|endswith": [
        "\\AppVLP.exe",
        "\\bitsadmin.exe",
        "\\certutil.exe",
        "\\cscript.exe",
        "\\curl.exe",
        "\\forfiles.exe",
        "\\hh.exe",
        "\\mftrace.exe",
        "\\mshta.exe",
        "\\net.exe",
        "\\net1.exe",
        "\\query.exe",
        "\\reg.exe",
        "\\regsvr32.exe",
        "\\rundll32.exe",
        "\\schtasks.exe",
        "\\scrcons.exe",
        "\\scriptrunner.exe",
        "\\sh.exe",
        "\\systeminfo.exe",
        "\\whoami.exe",
        "\\wmic.exe",
        "\\wscript.exe"
      ]
    },
    "condition": "selection"
  }
}
