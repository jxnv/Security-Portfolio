  "status": "test",
  "description": "Detects the abuse of custom file open handler, executing powershell",
  "author": "CD_R0M_",
  "date": "2022-06-11",
  "tags": [
    "attack.stealth",
    "attack.t1202"
  ],
  "level": "high",
  "logsource": {
    "category": "registry_set",
    "product": "windows"
  },
  "detection": {
    "selection": {
