{
  "title": "Webshell ReGeorg Detection Via Web Logs",
  "id": "2ea44a60-cfda-11ea-87d0-0242ac130003",
  "status": "test",
  "description": "Certain strings in the uri_query field when combined with null referer and null user agent can indicate activity associated with the webshell ReGeorg.",
  "author": "Cian Heasley",
  "date": "2020-08-04",
  "tags": [
    "attack.persistence",
    "attack.t1505.003"
  ],
  "level": "high",
  "logsource": {
    "category": "webserver"
  },
  "detection": {
    "selection": {
      "cs-uri-query|contains": [
        "cmd=read",
        "connect&target",
        "cmd=connect",
        "cmd=disconnect",
        "cmd=forward"
      ]
    },
    "filter": {
      "cs-referer": null,
      "cs-user-agent": null,
      "cs-method": "POST"
    },
    "condition": "selection and filter"
  }
}
