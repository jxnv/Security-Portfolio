{
  "title": "Suspicious HH.EXE Execution",
  "id": "e8a95b5e-c891-46e2-b33a-93937d3abc31",
  "status": "test",
  "description": "Detects a suspicious execution of a Microsoft HTML Help (HH.exe)",
  "author": "Maxim Pavlunin",
  "date": "2020-04-01",
  "tags": [
    "attack.execution",
    "attack.initial-access",
    "attack.stealth",
    "attack.t1047",
    "attack.t1059.001",
    "attack.t1059.003",
    "attack.t1059.005",
    "attack.t1059.007",
    "attack.t1218",
    "attack.t1218.001",
    "attack.t1218.010",
    "attack.t1218.011",
    "attack.t1566",
    "attack.t1566.001"
  ],
  "level": "high",
  "logsource": {
    "category": "process_creation",
    "product": "windows"
  },
  "detection": {
    "selection_img": [
      {
        "OriginalFileName": "HH.exe"
      },
      {
        "Image|endswith": "\\hh.exe"
      }
    ],
    "selection_paths": {
      "CommandLine|contains": [
        ".application",
        "\\AppData\\Local\\Temp\\",
        "\\Content.Outlook\\",
        "\\Downloads\\",
        "\\Users\\Public\\",
        "\\Windows\\Temp\\"
      ]
    },
    "condition": "all of selection_*"
  }
}
