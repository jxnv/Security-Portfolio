{
  "title": "DotNet CLR DLL Loaded By Scripting Applications",
  "id": "4508a70e-97ef-4300-b62b-ff27992990ea",
  "status": "test",
  "description": "Detects .NET CLR DLLs being loaded by scripting applications such as wscript or cscript. This could be an indication of potential suspicious execution.",
  "author": "omkar72, oscd.community",
  "date": "2020-10-14",
  "tags": [
    "attack.execution",
    "attack.privilege-escalation",
    "attack.stealth",
    "attack.t1055"
  ],
  "level": "high",
  "logsource": {
    "category": "image_load",
    "product": "windows"
  },
  "detection": {
    "selection": {
      "Image|endswith": [
        "\\cmstp.exe",
        "\\cscript.exe",
        "\\mshta.exe",
        "\\msxsl.exe",
        "\\regsvr32.exe",
        "\\wmic.exe",
        "\\wscript.exe"
      ],
      "ImageLoaded|endswith": [
        "\\clr.dll",
        "\\mscoree.dll",
        "\\mscorlib.dll"
      ]
    },
    "condition": "selection"
  }
}
