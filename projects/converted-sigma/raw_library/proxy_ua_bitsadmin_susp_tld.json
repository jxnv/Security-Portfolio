{
  "title": "Bitsadmin to Uncommon TLD",
  "id": "9eb68894-7476-4cd6-8752-23b51f5883a7",
  "status": "test",
  "description": "Detects Bitsadmin connections to domains with uncommon TLDs",
  "author": "Florian Roth (Nextron Systems), Tim Shelton",
  "date": "2019-03-07",
  "tags": [
    "attack.command-and-control",
    "attack.execution",
    "attack.stealth",
    "attack.t1071.001",
    "attack.persistence",
    "attack.t1197",
    "attack.s0190"
  ],
  "level": "high",
  "logsource": {
    "category": "proxy"
  },
  "detection": {
    "selection": {
      "c-useragent|startswith": "Microsoft BITS/"
    },
    "filter_main_legit_tlds": {
      "cs-host|endswith": [
        ".com",
        ".microsoft",
        ".net",
        ".org",
        ".scdn.co",
        ".sfx.ms"
      ]
    },
    "condition": "selection and not 1 of filter_main_*"
  }
}
