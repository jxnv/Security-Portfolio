# Description: Detects suspicious child processes of "BgInfo.exe" which could be a sign of potential abuse of the binary to proxy execution via external VBScript
# Converted by: Sigma Universal SIEM/EDR CLI

((((Image:*\\calc.exe OR Image:*\\cmd.exe OR Image:*\\cscript.exe OR Image:*\\mshta.exe OR Image:*\\notepad.exe OR Image:*\\powershell.exe OR Image:*\\pwsh.exe OR Image:*\\wscript.exe)) OR ((Image:*\\AppData\\Local\\* OR Image:*\\AppData\\Roaming\\* OR Image:*:\\Users\\Public\\* OR Image:*:\\Temp\\* OR Image:*:\\Windows\\Temp\\* OR Image:*:\\PerfLogs\\*))) AND ((ParentImage:*\\bginfo.exe OR ParentImage:*\\bginfo64.exe)))
