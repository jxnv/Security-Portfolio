# Title: Process Proxy Execution Via Squirrel.EXE
# ID: 45239e6a-b035-4aaf-b339-8ad379fcb67e
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems), Karneades / Markus Neis, Jonhnathan Ribeiro, oscd.community
# Date: 2022-06-09
# Tags: attack.execution, attack.stealth, attack.t1218
# Description: Detects the usage of the "Squirrel.exe" binary to execute arbitrary processes. This binary is part of multiple Electron based software installations (Slack, Teams, Discord, etc.)
# Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine:*--processStart* OR CommandLine:*--processStartAndWait* OR CommandLine:*--createShortcut*)) AND ((Image:*\\squirrel.exe OR Image:*\\update.exe))) AND NOT ((((CommandLine:*:\\Users\\* AND CommandLine:*\\AppData\\Local\\Discord\\Update.exe* AND CommandLine:*Discord.exe*) AND (CommandLine:*--createShortcut* OR CommandLine:*--processStart*)) OR ((CommandLine:*:\\Users\\* AND CommandLine:*\\AppData\\Local\\GitHubDesktop\\Update.exe* AND CommandLine:*GitHubDesktop.exe*) AND (CommandLine:*--createShortcut* OR CommandLine:*--processStartAndWait*)) OR ((CommandLine:*:\\Users\\* AND CommandLine:*\\AppData\\Local\\Microsoft\\Teams\\Update.exe* AND CommandLine:*Teams.exe*) AND (CommandLine:*--processStart* OR CommandLine:*--createShortcut*)) OR ((CommandLine:*:\\Users\\* AND CommandLine:*\\AppData\\Local\\yammerdesktop\\Update.exe* AND CommandLine:*Yammer.exe*) AND (CommandLine:*--processStart* OR CommandLine:*--createShortcut*)))))
