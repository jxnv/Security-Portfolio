# Title: Access To Potentially Sensitive Sysvol Files By Uncommon Applications
# ID: d51694fe-484a-46ac-92d6-969e76d60d10
# Status: test
# Level: medium
# Author: frack113
# Date: 2023-12-21
# Tags: attack.credential-access, attack.t1552.006
# Description: Detects file access requests to potentially sensitive files hosted on the Windows Sysvol share.
# Converted by: Sigma Universal SIEM/EDR CLI

((FileName:\\\\* AND (FileName:*\\sysvol\\* AND FileName:*\\Policies\\*) AND (FileName:*audit.csv OR FileName:*Files.xml OR FileName:*GptTmpl.inf OR FileName:*groups.xml OR FileName:*Registry.pol OR FileName:*Registry.xml OR FileName:*scheduledtasks.xml OR FileName:*scripts.ini OR FileName:*services.xml)) AND NOT (((Image:"C:\\Windows\\explorer.exe") OR ((Image:C:\\Program Files (x86)\\* OR Image:C:\\Program Files\\* OR Image:C:\\Windows\\system32\\* OR Image:C:\\Windows\\SysWOW64\\*)))))
