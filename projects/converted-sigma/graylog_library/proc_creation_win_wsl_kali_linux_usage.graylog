# Title: WSL Kali-Linux Usage
# ID: 6f1a11aa-4b8a-4b7f-9e13-4d3e4ff0e0d4
# Status: experimental
# Level: high
# Author: Swachchhanda Shrawan Poudel (Nextron Systems)
# Date: 2025-10-10
# Tags: attack.stealth, attack.t1202
# Description: Detects the use of Kali Linux through Windows Subsystem for Linux
# Converted by: Sigma Universal SIEM/EDR CLI

(((((Image:*:\\Users\\* AND Image:*\\AppData\\Local\\packages\\KaliLinux*)) OR ((Image:*:\\Users\\* AND Image:*\\AppData\\Local\\Microsoft\\WindowsApps\\kali.exe*))) OR (Image:*:\\Program Files\\WindowsApps\\KaliLinux.* AND Image:*\\kali.exe)) OR (((((Image:*\\kali.exe* OR Image:*\\KaliLinux*)) OR ((CommandLine:*Kali.exe* OR CommandLine:*Kali-linux* OR CommandLine:*kalilinux*))) AND ((ParentImage:*\\wsl.exe OR ParentImage:*\\wslhost.exe))) AND NOT (((CommandLine:* -i * OR CommandLine:* --install * OR CommandLine:* --unregister *)))))
