# Title: VBScript Payload Stored in Registry
# ID: 46490193-1b22-4c29-bdd6-5bf63907216f
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2021-03-05
# Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
# Description: Detects VBScript content stored into registry keys as seen being used by UNC2452 group
# Converted by: Sigma Universal SIEM/EDR CLI

((TargetObject:*Software\\Microsoft\\Windows\\CurrentVersion* AND (Details:*vbscript:* OR Details:*jscript:* OR Details:*mshtml,* OR Details:*RunHTMLApplication* OR Details:*Execute(* OR Details:*CreateObject* OR Details:*window.close*)) AND NOT (((TargetObject:*Software\\Microsoft\\Windows\\CurrentVersion\\Run*) OR (Image:*\\msiexec.exe AND TargetObject:*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Installer\\UserData\\* AND (Details:*\\Microsoft.NET\\Primary Interop Assemblies\\Microsoft.mshtml.dll* OR Details:*<\\Microsoft.mshtml,fileVersion=* OR Details:*_mshtml_dll_* OR Details:*<\\Microsoft.mshtml,culture=*)))))
