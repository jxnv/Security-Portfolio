# Description: Detects Certipy execution, a tool for Active Directory Certificate Services enumeration and abuse based on PE metadata characteristics and common command line arguments.
# Converted by: Sigma Universal SIEM/EDR CLI

(((Image:*\\Certipy.exe) OR (OriginalFileName:"Certipy.exe") OR (Description:*Certipy*)) OR (((CommandLine:* account * OR CommandLine:* auth * OR CommandLine:* cert * OR CommandLine:* find * OR CommandLine:* forge * OR CommandLine:* ptt * OR CommandLine:* relay * OR CommandLine:* req * OR CommandLine:* shadow * OR CommandLine:* template *)) AND ((CommandLine:* -bloodhound* OR CommandLine:* -ca-pfx * OR CommandLine:* -dc-ip * OR CommandLine:* -kirbi* OR CommandLine:* -old-bloodhound* OR CommandLine:* -pfx * OR CommandLine:* -target* OR CommandLine:* -template* OR CommandLine:* -username * OR CommandLine:* -vulnerable* OR CommandLine:*auth -pfx* OR CommandLine:*shadow auto* OR CommandLine:*shadow list*))))
