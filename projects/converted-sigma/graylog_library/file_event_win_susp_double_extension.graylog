# Title: Suspicious Double Extension Files
# ID: b4926b47-a9d7-434c-b3a0-adc3fa0bd13e
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems), frack113
# Date: 2022-06-19
# Tags: attack.stealth, attack.t1036.007
# Description: Detects dropped files with double extensions, which is often used by malware as a method to abuse the fact that Windows hide default extensions by default.
# Converted by: Sigma Universal SIEM/EDR CLI

((((TargetFilename:*.rar.exe OR TargetFilename:*.zip.exe)) OR ((TargetFilename:*.exe OR TargetFilename:*.iso OR TargetFilename:*.rar OR TargetFilename:*.svg OR TargetFilename:*.zip) AND (TargetFilename:*.doc.* OR TargetFilename:*.docx.* OR TargetFilename:*.gif.* OR TargetFilename:*.jpeg.* OR TargetFilename:*.jpg.* OR TargetFilename:*.mp3.* OR TargetFilename:*.mp4.* OR TargetFilename:*.pdf.* OR TargetFilename:*.png.* OR TargetFilename:*.ppt.* OR TargetFilename:*.pptx.* OR TargetFilename:*.rtf.* OR TargetFilename:*.svg.* OR TargetFilename:*.txt.* OR TargetFilename:*.xls.* OR TargetFilename:*.xlsx.*))) AND NOT ((TargetFilename:/usr/share/icons/*)))
