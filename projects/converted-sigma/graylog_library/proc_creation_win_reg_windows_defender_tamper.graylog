# Title: Suspicious Windows Defender Registry Key Tampering Via Reg.EXE
# ID: 452bce90-6fb0-43cc-97a5-affc283139b3
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), Swachchhanda Shrawan Poudel, Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-03-22
# Tags: attack.defense-impairment, attack.t1685
# Description: Detects the usage of "reg.exe" to tamper with different Windows Defender registry keys in order to disable some important features related to protection and detection
# Converted by: Sigma Universal SIEM/EDR CLI

((((Image:*\\reg.exe) OR (OriginalFileName:"reg.exe")) AND ((CommandLine:*SOFTWARE\\Microsoft\\Windows Defender\\* OR CommandLine:*SOFTWARE\\Policies\\Microsoft\\Windows Defender Security Center* OR CommandLine:*SOFTWARE\\Policies\\Microsoft\\Windows Defender\\*))) AND (((CommandLine:* add * AND CommandLine:*d 0*) AND (CommandLine:*DisallowExploitProtectionOverride* OR CommandLine:*EnableControlledFolderAccess* OR CommandLine:*MpEnablePus* OR CommandLine:*PUAProtection* OR CommandLine:*SpynetReporting* OR CommandLine:*SubmitSamplesConsent* OR CommandLine:*TamperProtection*)) OR ((CommandLine:* add * AND CommandLine:*d 1*) AND (CommandLine:*DisableAccess* OR CommandLine:*DisableAntiSpyware* OR CommandLine:*DisableAntiSpywareRealtimeProtection* OR CommandLine:*DisableAntiVirus* OR CommandLine:*DisableAntiVirusSignatures* OR CommandLine:*DisableArchiveScanning* OR CommandLine:*DisableBehaviorMonitoring* OR CommandLine:*DisableBlockAtFirstSeen* OR CommandLine:*DisableCloudProtection* OR CommandLine:*DisableConfig* OR CommandLine:*DisableEnhancedNotifications* OR CommandLine:*DisableIntrusionPreventionSystem* OR CommandLine:*DisableIOAVProtection* OR CommandLine:*DisableNetworkProtection* OR CommandLine:*DisableOnAccessProtection* OR CommandLine:*DisablePrivacyMode* OR CommandLine:*DisableRealtimeMonitoring* OR CommandLine:*DisableRoutinelyTakingAction* OR CommandLine:*DisableScanOnRealtimeEnable* OR CommandLine:*DisableScriptScanning* OR CommandLine:*DisableSecurityCenter* OR CommandLine:*Notification_Suppress* OR CommandLine:*SignatureDisableUpdateOnStartupWithoutEngine*))))
