# Title: Potentially Suspicious File Download From ZIP TLD
# ID: 0bb4bbeb-fe52-4044-b40c-430a04577ebe
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2023-05-18
# Tags: attack.stealth
# Description: Detects the download of a file with a potentially suspicious extension from a .zip top level domain.
# Converted by: Sigma Universal SIEM/EDR CLI

(Contents:*.zip/* AND (filemod_name:*.bat:Zone* OR filemod_name:*.dat:Zone* OR filemod_name:*.dll:Zone* OR filemod_name:*.doc:Zone* OR filemod_name:*.docm:Zone* OR filemod_name:*.exe:Zone* OR filemod_name:*.hta:Zone* OR filemod_name:*.pptm:Zone* OR filemod_name:*.ps1:Zone* OR filemod_name:*.rar:Zone* OR filemod_name:*.rtf:Zone* OR filemod_name:*.sct:Zone* OR filemod_name:*.vbe:Zone* OR filemod_name:*.vbs:Zone* OR filemod_name:*.ws:Zone* OR filemod_name:*.wsf:Zone* OR filemod_name:*.xll:Zone* OR filemod_name:*.xls:Zone* OR filemod_name:*.xlsm:Zone* OR filemod_name:*.zip:Zone*))
