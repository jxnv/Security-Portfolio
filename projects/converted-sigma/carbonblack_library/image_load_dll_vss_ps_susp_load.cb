# Title: Suspicious Volume Shadow Copy VSS_PS.dll Load
# ID: 333cdbe8-27bb-4246-bf82-b41a0dca4b70
# Status: test
# Level: high
# Author: Markus Neis, @markus_neis
# Date: 2021-07-07
# Tags: attack.impact, attack.t1490
# Description: Detects the image load of vss_ps.dll by uncommon executables. This DLL is used by the Volume Shadow Copy Service (VSS) to manage shadow copies of files and volumes.
# It is often abused by attackers to delete or manipulate shadow copies, which can hinder forensic investigations and data recovery efforts.
# The fact that it is loaded by processes that are not typically associated with VSS operations can indicate suspicious activity.
# Converted by: Sigma Universal SIEM/EDR CLI

((ImageLoaded:*\\vss_ps.dll) AND -(((-process_name:*) OR (process_name:C:\\Windows\\* AND (process_name:*\\clussvc.exe OR process_name:*\\dismhost.exe OR process_name:*\\dllhost.exe OR process_name:*\\inetsrv\\appcmd.exe OR process_name:*\\inetsrv\\iissetup.exe OR process_name:*\\msiexec.exe OR process_name:*\\rundll32.exe OR process_name:*\\searchindexer.exe OR process_name:*\\srtasks.exe OR process_name:*\\svchost.exe OR process_name:*\\System32\\SystemPropertiesAdvanced.exe OR process_name:*\\taskhostw.exe OR process_name:*\\thor.exe OR process_name:*\\thor64.exe OR process_name:*\\tiworker.exe OR process_name:*\\vssvc.exe OR process_name:*\\vssadmin.exe OR process_name:*\\WmiPrvSE.exe OR process_name:*\\wsmprovhost.exe)) OR (cmdline:C:\\$WinREAgent\\Scratch\\* AND cmdline:*\\dismhost.exe {*))) AND -(((process_name:C:\\Program Files\\* OR process_name:C:\\Program Files (x86)\\*))))
