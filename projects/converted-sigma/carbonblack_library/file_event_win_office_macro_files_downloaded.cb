# Title: Office Macro File Download
# ID: 0e29e3a7-1ad8-40aa-b691-9f82ecd33d66
# Status: test
# Level: low
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-01-23
# Tags: attack.initial-access, attack.t1566.001
# Description: Detects the creation of a new office macro files on the system via an application (browser, mail client).
# This can help identify potential malicious activity, such as the download of macro-enabled documents that could be used for exploitation.
# Converted by: Sigma Universal SIEM/EDR CLI

((((filemod_name:*.docm OR filemod_name:*.dotm OR filemod_name:*.xlsm OR filemod_name:*.xltm OR filemod_name:*.potm OR filemod_name:*.pptm)) OR ((filemod_name:*.docm:Zone* OR filemod_name:*.dotm:Zone* OR filemod_name:*.xlsm:Zone* OR filemod_name:*.xltm:Zone* OR filemod_name:*.potm:Zone* OR filemod_name:*.pptm:Zone*))) AND ((process_name:*\\RuntimeBroker.exe OR process_name:*\\outlook.exe OR process_name:*\\thunderbird.exe OR process_name:*\\brave.exe OR process_name:*\\chrome.exe OR process_name:*\\firefox.exe OR process_name:*\\iexplore.exe OR process_name:*\\maxthon.exe OR process_name:*\\MicrosoftEdge.exe OR process_name:*\\msedge.exe OR process_name:*\\msedgewebview2.exe OR process_name:*\\opera.exe OR process_name:*\\safari.exe OR process_name:*\\seamonkey.exe OR process_name:*\\vivaldi.exe OR process_name:*\\whale.exe)))
