# Title: Script Event Consumer Spawning Process
# ID: f6d1dd2f-b8ce-40ca-bc23-062efb686b34
# Status: test
# Level: high
# Author: Sittikorn S
# Date: 2021-06-21
# Tags: attack.execution, attack.t1047
# Description: Detects a suspicious child process of Script Event Consumer (scrcons.exe).
# Converted by: Sigma Universal SIEM/EDR CLI

(parent_name:*\\scrcons.exe AND (process_name:*\\svchost.exe OR process_name:*\\dllhost.exe OR process_name:*\\powershell.exe OR process_name:*\\pwsh.exe OR process_name:*\\wscript.exe OR process_name:*\\cscript.exe OR process_name:*\\schtasks.exe OR process_name:*\\regsvr32.exe OR process_name:*\\mshta.exe OR process_name:*\\rundll32.exe OR process_name:*\\msiexec.exe OR process_name:*\\msbuild.exe))
