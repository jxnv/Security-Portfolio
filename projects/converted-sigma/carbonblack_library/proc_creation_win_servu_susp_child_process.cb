# Title: Suspicious Serv-U Process Pattern
# ID: 58f4ea09-0fc2-4520-ba18-b85c540b0eaf
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2021-07-14
# Tags: attack.credential-access, attack.t1555, cve.2021-35211
# Description: Detects a suspicious process pattern which could be a sign of an exploited Serv-U service
# Converted by: Sigma Universal SIEM/EDR CLI

(parent_name:*\\Serv-U.exe AND (process_name:*\\cmd.exe OR process_name:*\\powershell.exe OR process_name:*\\pwsh.exe OR process_name:*\\wscript.exe OR process_name:*\\cscript.exe OR process_name:*\\sh.exe OR process_name:*\\bash.exe OR process_name:*\\schtasks.exe OR process_name:*\\regsvr32.exe OR process_name:*\\wmic.exe OR process_name:*\\mshta.exe OR process_name:*\\rundll32.exe OR process_name:*\\msiexec.exe OR process_name:*\\forfiles.exe OR process_name:*\\scriptrunner.exe))
