# Title: HackTool - LaZagne Execution
# ID: c2b86e67-b880-4eec-b045-50bc98ef4844
# Status: experimental
# Level: medium
# Author: Nasreddine Bencherchali, Swachchhanda Shrawan Poudel (Nextron Systems)
# Date: 2024-06-24
# Tags: attack.credential-access
# Description: Detects the execution of the LaZagne. A utility used to retrieve multiple types of passwords stored on a local computer.
# LaZagne has been leveraged multiple times by threat actors in order to dump credentials.
# Converted by: Sigma Universal SIEM/EDR CLI

((((process_name:*:\\PerfLogs\\* OR process_name:*:\\ProgramData\\* OR process_name:*:\\Temp\\* OR process_name:*:\\Tmp\\* OR process_name:*:\\Users\\Public\\* OR process_name:*:\\Windows\\Temp\\* OR process_name:*\\$Recycle.bin* OR process_name:*\\AppData\\* OR process_name:*\\Desktop\\* OR process_name:*\\Downloads\\* OR process_name:*\\Favorites\\* OR process_name:*\\Links\\* OR process_name:*\\Music\\* OR process_name:*\\Photos\\* OR process_name:*\\Pictures\\* OR process_name:*\\Saved Games\\* OR process_name:*\\Searches\\* OR process_name:*\\Users\\Contacts\\* OR process_name:*\\Users\\Default\\* OR process_name:*\\Users\\Searches\\* OR process_name:*\\Videos\\* OR process_name:*\\Windows\\addins\\* OR process_name:*\\Windows\\Fonts\\* OR process_name:*\\Windows\\IME\\*) AND (cmdline:*.exe all OR cmdline:*.exe browsers OR cmdline:*.exe chats OR cmdline:*.exe databases OR cmdline:*.exe games OR cmdline:*.exe git OR cmdline:*.exe mails OR cmdline:*.exe maven OR cmdline:*.exe memory OR cmdline:*.exe multimedia OR cmdline:*.exe sysadmin OR cmdline:*.exe unused OR cmdline:*.exe wifi OR cmdline:*.exe windows)) OR (process_name:*\\lazagne.exe)) OR (((cmdline:* all * OR cmdline:* browsers * OR cmdline:* chats * OR cmdline:* databases * OR cmdline:* games * OR cmdline:* mails * OR cmdline:* maven * OR cmdline:* memory * OR cmdline:* multimedia * OR cmdline:* php * OR cmdline:* svn * OR cmdline:* sysadmin * OR cmdline:* unused * OR cmdline:* wifi *)) AND ((cmdline:*-1Password* OR cmdline:*-apachedirectorystudio* OR cmdline:*-autologon* OR cmdline:*-ChromiumBased* OR cmdline:*-coreftp* OR cmdline:*-credfiles* OR cmdline:*-credman* OR cmdline:*-cyberduck* OR cmdline:*-dbvis* OR cmdline:*-EyeCon* OR cmdline:*-filezilla* OR cmdline:*-filezillaserver* OR cmdline:*-ftpnavigator* OR cmdline:*-galconfusion* OR cmdline:*-gitforwindows* OR cmdline:*-hashdump* OR cmdline:*-iisapppool* OR cmdline:*-IISCentralCertP* OR cmdline:*-kalypsomedia* OR cmdline:*-keepass* OR cmdline:*-keepassconfig* OR cmdline:*-lsa_secrets* OR cmdline:*-mavenrepositories* OR cmdline:*-memory_dump* OR cmdline:*-Mozilla* OR cmdline:*-mRemoteNG* OR cmdline:*-mscache* OR cmdline:*-opensshforwindows* OR cmdline:*-openvpn* OR cmdline:*-outlook* OR cmdline:*-pidgin* OR cmdline:*-postgresql* OR cmdline:*-psi-im* OR cmdline:*-puttycm* OR cmdline:*-pypykatz* OR cmdline:*-Rclone* OR cmdline:*-rdpmanager* OR cmdline:*-robomongo* OR cmdline:*-roguestale* OR cmdline:*-skype* OR cmdline:*-SQLDeveloper* OR cmdline:*-squirrel* OR cmdline:*-tortoise* OR cmdline:*-turba* OR cmdline:*-UCBrowser* OR cmdline:*-unattended* OR cmdline:*-vault* OR cmdline:*-vaultfiles* OR cmdline:*-vnc* OR cmdline:*-winscp*))))
