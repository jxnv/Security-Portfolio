# Title: Potentially Suspicious Child Processes Spawned by ConHost
# ID: dfa03a09-8b92-4d83-8e74-f72839b1c407
# Status: experimental
# Level: high
# Author: Swachchhanda Shrawan Poudel (Nextron Systems)
# Date: 2025-02-05
# Tags: attack.stealth, attack.t1202, attack.t1218
# Description: Detects suspicious child processes related to Windows Shell utilities spawned by `conhost.exe`, which could indicate malicious activity using trusted system components.
# Converted by: Sigma Universal SIEM/EDR CLI

((((process_name:*\\cmd.exe OR process_name:*\\cscript.exe OR process_name:*\\mshta.exe OR process_name:*\\powershell_ise.exe OR process_name:*\\powershell.exe OR process_name:*\\pwsh.exe OR process_name:*\\regsvr32.exe OR process_name:*\\wscript.exe)) OR ((OriginalFileName:"cmd.exe" OR OriginalFileName:"cscript.exe" OR OriginalFileName:"mshta.exe" OR OriginalFileName:"powershell_ise.exe" OR OriginalFileName:"powershell.exe" OR OriginalFileName:"pwsh.dll" OR OriginalFileName:"regsvr32.exe" OR OriginalFileName:"wscript.exe"))) AND (parent_name:*\\conhost.exe))
