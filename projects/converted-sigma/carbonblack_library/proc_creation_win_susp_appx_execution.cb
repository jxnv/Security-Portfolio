# Title: Potentially Suspicious Windows App Activity
# ID: f91ed517-a6ba-471d-9910-b3b4a398c0f3
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-01-12
# Tags: attack.stealth
# Description: Detects potentially suspicious child process of applications launched from inside the WindowsApps directory. This could be a sign of a rogue ".appx" package installation/execution
# Converted by: Sigma Universal SIEM/EDR CLI

((parent_name:*C:\\Program Files\\WindowsApps\\*) AND (((cmdline:*cmd /c* OR cmdline:*Invoke-* OR cmdline:*Base64*)) OR ((process_name:*\\cmd.exe OR process_name:*\\cscript.exe OR process_name:*\\mshta.exe OR process_name:*\\powershell.exe OR process_name:*\\powershell_ise.exe OR process_name:*\\pwsh.exe OR process_name:*\\regsvr32.exe OR process_name:*\\rundll32.exe OR process_name:*\\wscript.exe))) AND -(((parent_name:C:\\Program Files\\WindowsApps\\Microsoft.SysinternalsSuite* AND process_name:*\\cmd.exe) OR (parent_name:*:\\Program Files\\WindowsApps\\Microsoft.WindowsTerminal* AND parent_name:*\\WindowsTerminal.exe AND (process_name:*\\powershell.exe OR process_name:*\\cmd.exe OR process_name:*\\pwsh.exe)))))
