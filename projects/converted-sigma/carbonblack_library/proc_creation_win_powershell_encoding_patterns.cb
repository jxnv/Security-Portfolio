# Title: Potential Encoded PowerShell Patterns In CommandLine
# ID: cdf05894-89e7-4ead-b2b0-0a5f97a90f2f
# Status: test
# Level: low
# Author: Teymur Kheirkhabarov (idea), Vasiliy Burov (rule), oscd.community, Tim Shelton
# Date: 2020-10-11
# Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
# Description: Detects specific combinations of encoding methods in PowerShell via the commandline
# Converted by: Sigma Universal SIEM/EDR CLI

((((process_name:*\\powershell.exe OR process_name:*\\pwsh.exe)) OR ((OriginalFileName:"PowerShell.EXE" OR OriginalFileName:"pwsh.dll"))) AND ((((cmdline:*ToInt* OR cmdline:*ToDecimal* OR cmdline:*ToByte* OR cmdline:*ToUint* OR cmdline:*ToSingle* OR cmdline:*ToSByte*)) AND ((cmdline:*ToChar* OR cmdline:*ToString* OR cmdline:*String*))) OR (((cmdline:*char* AND cmdline:*join*)) OR ((cmdline:*split* AND cmdline:*join*)))))
