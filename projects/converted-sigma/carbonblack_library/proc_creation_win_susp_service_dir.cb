# Title: Suspicious Service Binary Directory
# ID: 883faa95-175a-4e22-8181-e5761aeb373c
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2021-03-09
# Tags: attack.stealth, attack.t1202
# Description: Detects a service binary running in a suspicious directory
# Converted by: Sigma Universal SIEM/EDR CLI

((process_name:*\\Users\\Public\\* OR process_name:*\\$Recycle.bin* OR process_name:*\\Users\\All Users\\* OR process_name:*\\Users\\Default\\* OR process_name:*\\Users\\Contacts\\* OR process_name:*\\Users\\Searches\\* OR process_name:*C:\\Perflogs\\* OR process_name:*\\config\\systemprofile\\* OR process_name:*\\Windows\\Fonts\\* OR process_name:*\\Windows\\IME\\* OR process_name:*\\Windows\\addins\\*) AND (parent_name:*\\services.exe OR parent_name:*\\svchost.exe))
