(((Destination:*new-object* AND Destination:*net.webclient* AND Destination:*.downloadstring*)) OR ((Destination:*new-object* AND Destination:*net.webclient* AND Destination:*.downloadfile*)) OR ((Destination:* iex(* OR Destination:* -nop * OR Destination:* -noprofile * OR Destination:* -decode * OR Destination:* -enc * OR Destination:*WScript.Shell* OR Destination:*System.Security.Cryptography.FromBase64Transform*)))
