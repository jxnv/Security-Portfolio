# Title: Obfuscated IP Download Activity
# ID: cb5a2333-56cf-4562-8fcb-22ba1bca728d
# Status: test
# Level: medium
# Author: Florian Roth (Nextron Systems), X__Junior (Nextron Systems)
# Date: 2022-08-03
# Tags: attack.discovery
# Description: Detects use of an encoded/obfuscated version of an IP address (hex, octal...) in an URL combined with a download command
# Converted by: Sigma Universal SIEM/EDR CLI

(((cmdline:*Invoke-WebRequest* OR cmdline:*iwr * OR cmdline:*Invoke-RestMethod* OR cmdline:*irm * OR cmdline:*wget * OR cmdline:*curl * OR cmdline:*DownloadFile* OR cmdline:*DownloadString*)) AND (((cmdline:* 0x* OR cmdline:*//0x* OR cmdline:*.0x* OR cmdline:*.00x*)) OR ((cmdline:*http://%* AND cmdline:*%2e*)) OR ((cmdline=regex("https?://[0-9]{1,3}\\.[0-9]{1,3}\\.0[0-9]{3,4}")) OR (cmdline=regex("https?://[0-9]{1,3}\\.0[0-9]{3,7}")) OR (cmdline=regex("https?://0[0-9]{3,11}")) OR (cmdline=regex("https?://(?:0[0-9]{1,11}\\.){3}0[0-9]{1,11}")) OR (cmdline=regex("https?://0[0-9]{1,11}")) OR (cmdline=regex(" [0-7]{7,13}")))) AND -((cmdline=regex("https?://(?:(?:25[0-5]|(?:2[0-4]|1\\d|[1-9])?\\d)(?:\\.|\\b)){4}"))))
