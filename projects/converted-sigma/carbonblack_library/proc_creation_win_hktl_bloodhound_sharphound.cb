# Description: Detects command line parameters used by Bloodhound and Sharphound hack tools
# Converted by: Sigma Universal SIEM/EDR CLI

(((cmdline:* -CollectionMethod All * OR cmdline:* --CollectionMethods Session * OR cmdline:* --Loop --Loopduration * OR cmdline:* --PortScanTimeout * OR cmdline:*.exe -c All -d * OR cmdline:*Invoke-Bloodhound* OR cmdline:*Get-BloodHoundData*)) OR ((cmdline:* -JsonFolder * AND cmdline:* -ZipFileName *)) OR ((cmdline:* DCOnly * AND cmdline:* --NoSaveCache *)) OR ((Product:*SharpHound*) OR (Description:*SharpHound*) OR ((Company:*SpecterOps* OR Company:*evil corp*)) OR ((process_name:*\\Bloodhound.exe* OR process_name:*\\SharpHound.exe*))))
