# Title: Suspicious File Download From IP Via Wget.EXE - Paths
# ID: 40aa399c-7b02-4715-8e5f-73572b493f33
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2024-02-23
# Tags: attack.execution
# Description: Detects potentially suspicious file downloads directly from IP addresses and stored in suspicious locations using Wget.exe
# Converted by: Sigma Universal SIEM/EDR CLI

(((cmdline=regex("\\s-O\\s")) OR (cmdline:*--output-document*)) AND (cmdline:*http*) AND ((process_name:*\\wget.exe) OR (OriginalFileName:"wget.exe")) AND (cmdline=regex("://[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}")) AND (((cmdline:*:\\PerfLogs\\* OR cmdline:*:\\Temp\\* OR cmdline:*:\\Users\\Public\\* OR cmdline:*:\\Windows\\Help\\* OR cmdline:*:\\Windows\\Temp\\* OR cmdline:*\\Temporary Internet*)) OR ((cmdline:*:\\Users\\* AND cmdline:*\\Favorites\\*)) OR ((cmdline:*:\\Users\\* AND cmdline:*\\Favourites\\*)) OR ((cmdline:*:\\Users\\* AND cmdline:*\\Contacts\\*)) OR ((cmdline:*:\\Users\\* AND cmdline:*\\Pictures\\*))))
