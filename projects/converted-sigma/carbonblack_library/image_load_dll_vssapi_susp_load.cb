# Title: Suspicious Volume Shadow Copy Vssapi.dll Load
# ID: 37774c23-25a1-4adb-bb6d-8bb9fd59c0f8
# Status: test
# Level: high
# Author: frack113
# Date: 2022-10-31
# Tags: attack.impact, attack.t1490
# Description: Detects the image load of VSS DLL by uncommon executables
# Converted by: Sigma Universal SIEM/EDR CLI

((ImageLoaded:*\\vssapi.dll) AND -(((-process_name:*) OR ((process_name:C:\\Program Files\\* OR process_name:C:\\Program Files (x86)\\*)) OR (((process_name:"C:\\Windows\\explorer.exe" OR process_name:"C:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe" OR process_name:"C:\\Windows\\servicing\\TrustedInstaller.exe")) OR ((process_name:C:\\Windows\\System32\\* OR process_name:C:\\Windows\\SysWOW64\\* OR process_name:C:\\Windows\\Temp\\{* OR process_name:C:\\Windows\\WinSxS\\* OR process_name:C:\\$WinREAgent\\Scratch\\*))))) AND -((((process_name:*\\temp\\is-* AND process_name:*\\avira_system_speedup.tmp*)) OR (process_name:C:\\ProgramData\\Package Cache\\*))))
