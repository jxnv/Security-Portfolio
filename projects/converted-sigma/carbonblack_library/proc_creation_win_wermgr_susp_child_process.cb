# Title: Suspicious Child Process Of Wermgr.EXE
# ID: 396f6630-f3ac-44e3-bfc8-1b161bc00c4e
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-10-14
# Tags: attack.privilege-escalation, attack.stealth, attack.t1055, attack.t1036
# Description: Detects suspicious Windows Error Reporting manager (wermgr.exe) child process
# Converted by: Sigma Universal SIEM/EDR CLI

((parent_name:*\\wermgr.exe AND (process_name:*\\cmd.exe OR process_name:*\\cscript.exe OR process_name:*\\ipconfig.exe OR process_name:*\\mshta.exe OR process_name:*\\net.exe OR process_name:*\\net1.exe OR process_name:*\\netstat.exe OR process_name:*\\nslookup.exe OR process_name:*\\powershell_ise.exe OR process_name:*\\powershell.exe OR process_name:*\\pwsh.exe OR process_name:*\\regsvr32.exe OR process_name:*\\rundll32.exe OR process_name:*\\systeminfo.exe OR process_name:*\\whoami.exe OR process_name:*\\wscript.exe)) AND -((process_name:*\\rundll32.exe AND (cmdline:*C:\\Windows\\system32\\WerConCpl.dll* AND cmdline:*LaunchErcApp *) AND (cmdline:*-queuereporting* OR cmdline:*-responsepester*))))
