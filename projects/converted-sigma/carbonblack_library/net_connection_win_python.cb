# Title: Python Initiated Connection
# ID: bef0bc5a-b9ae-425d-85c6-7b2d705980c6
# Status: test
# Level: medium
# Author: frack113
# Date: 2021-12-10
# Tags: attack.discovery, attack.t1046
# Description: Detects a Python process initiating a network connection. While this often relates to package installation, it can also indicate a potential malicious script communicating with a C&C server.
# Converted by: Sigma Universal SIEM/EDR CLI

((Initiated:"true" AND (process_name:*\\python* AND process_name:*.exe*)) AND -(((DestinationIp:"127.0.0.1" AND SourceIp:"127.0.0.1") OR ((cmdline:*pip.exe* AND cmdline:*install*)))) AND -(((parent_name:"C:\\ProgramData\\Anaconda3\\Scripts\\conda.exe" AND (cmdline:*:\\ProgramData\\Anaconda3\\Scripts\\conda-script.py* AND cmdline:*update*)) OR (parent_name:"C:\\ProgramData\\Anaconda3\\python.exe" AND cmdline:*C:\\ProgramData\\Anaconda3\\Scripts\\jupyter-notebook-script.py*))))
