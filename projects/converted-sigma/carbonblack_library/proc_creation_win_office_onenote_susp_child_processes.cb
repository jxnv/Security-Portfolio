# Title: Suspicious Microsoft OneNote Child Process
# ID: c27515df-97a9-4162-8a60-dc0eeb51b775
# Status: test
# Level: high
# Author: Tim Rauch (Nextron Systems), Nasreddine Bencherchali (Nextron Systems), Elastic (idea)
# Date: 2022-10-21
# Tags: attack.t1566, attack.t1566.001, attack.initial-access
# Description: Detects suspicious child processes of the Microsoft OneNote application. This may indicate an attempt to execute malicious embedded objects from a .one file.
# Converted by: Sigma Universal SIEM/EDR CLI

((parent_name:*\\onenote.exe) AND ((process_name:*\\explorer.exe AND (cmdline:*.hta* OR cmdline:*.vb* OR cmdline:*.wsh* OR cmdline:*.js* OR cmdline:*.ps* OR cmdline:*.scr* OR cmdline:*.pif* OR cmdline:*.bat* OR cmdline:*.cmd*)) OR (((OriginalFileName:"bitsadmin.exe" OR OriginalFileName:"CertOC.exe" OR OriginalFileName:"CertUtil.exe" OR OriginalFileName:"Cmd.Exe" OR OriginalFileName:"CMSTP.EXE" OR OriginalFileName:"cscript.exe" OR OriginalFileName:"curl.exe" OR OriginalFileName:"HH.exe" OR OriginalFileName:"IEExec.exe" OR OriginalFileName:"InstallUtil.exe" OR OriginalFileName:"javaw.exe" OR OriginalFileName:"Microsoft.Workflow.Compiler.exe" OR OriginalFileName:"msdt.exe" OR OriginalFileName:"MSHTA.EXE" OR OriginalFileName:"msiexec.exe" OR OriginalFileName:"Msxsl.exe" OR OriginalFileName:"odbcconf.exe" OR OriginalFileName:"pcalua.exe" OR OriginalFileName:"PowerShell.EXE" OR OriginalFileName:"RegAsm.exe" OR OriginalFileName:"RegSvcs.exe" OR OriginalFileName:"REGSVR32.exe" OR OriginalFileName:"RUNDLL32.exe" OR OriginalFileName:"schtasks.exe" OR OriginalFileName:"ScriptRunner.exe" OR OriginalFileName:"wmic.exe" OR OriginalFileName:"WorkFolders.exe" OR OriginalFileName:"wscript.exe")) OR ((process_name:*\\AppVLP.exe OR process_name:*\\bash.exe OR process_name:*\\bitsadmin.exe OR process_name:*\\certoc.exe OR process_name:*\\certutil.exe OR process_name:*\\cmd.exe OR process_name:*\\cmstp.exe OR process_name:*\\control.exe OR process_name:*\\cscript.exe OR process_name:*\\curl.exe OR process_name:*\\forfiles.exe OR process_name:*\\hh.exe OR process_name:*\\ieexec.exe OR process_name:*\\installutil.exe OR process_name:*\\javaw.exe OR process_name:*\\mftrace.exe OR process_name:*\\Microsoft.Workflow.Compiler.exe OR process_name:*\\msbuild.exe OR process_name:*\\msdt.exe OR process_name:*\\mshta.exe OR process_name:*\\msidb.exe OR process_name:*\\msiexec.exe OR process_name:*\\msxsl.exe OR process_name:*\\odbcconf.exe OR process_name:*\\pcalua.exe OR process_name:*\\powershell.exe OR process_name:*\\pwsh.exe OR process_name:*\\regasm.exe OR process_name:*\\regsvcs.exe OR process_name:*\\regsvr32.exe OR process_name:*\\rundll32.exe OR process_name:*\\schtasks.exe OR process_name:*\\scrcons.exe OR process_name:*\\scriptrunner.exe OR process_name:*\\sh.exe OR process_name:*\\svchost.exe OR process_name:*\\verclsid.exe OR process_name:*\\wmic.exe OR process_name:*\\workfolders.exe OR process_name:*\\wscript.exe))) OR ((process_name:*\\AppData\\* OR process_name:*\\Users\\Public\\* OR process_name:*\\ProgramData\\* OR process_name:*\\Windows\\Tasks\\* OR process_name:*\\Windows\\Temp\\* OR process_name:*\\Windows\\System32\\Tasks\\*))) AND -(((process_name:*\\AppData\\Local\\Microsoft\\OneDrive\\* AND process_name:*\\FileCoAuth.exe AND cmdline:*-Embedding) OR (process_name:*\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe AND cmdline:*-Embedding))))
