# Title: Potentially Suspicious Child Process Of WinRAR.EXE
# ID: 146aace8-9bd6-42ba-be7a-0070d8027b76
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-08-31
# Tags: attack.execution, attack.t1203
# Description: Detects potentially suspicious child processes of WinRAR.exe.
# Converted by: Sigma Universal SIEM/EDR CLI

((((process_name:*\\cmd.exe OR process_name:*\\cscript.exe OR process_name:*\\mshta.exe OR process_name:*\\powershell.exe OR process_name:*\\pwsh.exe OR process_name:*\\regsvr32.exe OR process_name:*\\rundll32.exe OR process_name:*\\wscript.exe)) OR ((OriginalFileName:"Cmd.Exe" OR OriginalFileName:"cscript.exe" OR OriginalFileName:"mshta.exe" OR OriginalFileName:"PowerShell.EXE" OR OriginalFileName:"pwsh.dll" OR OriginalFileName:"regsvr32.exe" OR OriginalFileName:"RUNDLL32.EXE" OR OriginalFileName:"wscript.exe"))) AND (parent_name:*\\WinRAR.exe))
