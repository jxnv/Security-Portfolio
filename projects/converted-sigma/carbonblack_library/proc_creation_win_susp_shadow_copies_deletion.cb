# Title: Shadow Copies Deletion Using Operating Systems Utilities
# ID: c947b146-0abc-4c87-9c64-b17e9d7274a2
# Status: stable
# Level: high
# Author: Florian Roth (Nextron Systems), Michael Haag, Teymur Kheirkhabarov, Daniil Yugoslavskiy, oscd.community, Andreas Hunkeler (@Karneades)
# Date: 2019-10-22
# Tags: attack.impact, attack.stealth, attack.t1070, attack.t1490
# Description: Shadow Copies deletion using operating systems utilities
# Converted by: Sigma Universal SIEM/EDR CLI

((((cmdline:*shadow* AND cmdline:*delete*)) AND (((process_name:*\\powershell.exe OR process_name:*\\pwsh.exe OR process_name:*\\wmic.exe OR process_name:*\\vssadmin.exe OR process_name:*\\diskshadow.exe)) OR ((OriginalFileName:"PowerShell.EXE" OR OriginalFileName:"pwsh.dll" OR OriginalFileName:"wmic.exe" OR OriginalFileName:"VSSADMIN.EXE" OR OriginalFileName:"diskshadow.exe")))) OR (((cmdline:*delete* AND cmdline:*catalog* AND cmdline:*quiet*)) AND ((process_name:*\\wbadmin.exe) OR (OriginalFileName:"WBADMIN.EXE"))) OR (((cmdline:*resize* AND cmdline:*shadowstorage*) AND (cmdline:*unbounded* OR cmdline:*/MaxSize=*)) AND ((process_name:*\\vssadmin.exe) OR (OriginalFileName:"VSSADMIN.EXE"))))
