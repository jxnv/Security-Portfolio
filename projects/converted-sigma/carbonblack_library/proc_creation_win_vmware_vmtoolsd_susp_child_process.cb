# Title: VMToolsd Suspicious Child Process
# ID: 5687f942-867b-4578-ade7-1e341c46e99a
# Status: test
# Level: high
# Author: bohops, Bhabesh Raj
# Date: 2021-10-08
# Tags: attack.execution, attack.persistence, attack.t1059
# Description: Detects suspicious child process creations of VMware Tools process which may indicate persistence setup
# Converted by: Sigma Universal SIEM/EDR CLI

(((((process_name:*\\cmd.exe OR process_name:*\\cscript.exe OR process_name:*\\mshta.exe OR process_name:*\\powershell.exe OR process_name:*\\pwsh.exe OR process_name:*\\regsvr32.exe OR process_name:*\\rundll32.exe OR process_name:*\\wscript.exe)) OR ((OriginalFileName:"Cmd.Exe" OR OriginalFileName:"cscript.exe" OR OriginalFileName:"MSHTA.EXE" OR OriginalFileName:"PowerShell.EXE" OR OriginalFileName:"pwsh.dll" OR OriginalFileName:"REGSVR32.EXE" OR OriginalFileName:"RUNDLL32.EXE" OR OriginalFileName:"wscript.exe"))) AND (parent_name:*\\vmtoolsd.exe)) AND -(((process_name:*\\cmd.exe AND cmdline:"") OR (process_name:*\\cmd.exe AND -cmdline:*) OR (process_name:*\\cmd.exe AND (cmdline:*\\VMware\\VMware Tools\\poweron-vm-default.bat* OR cmdline:*\\VMware\\VMware Tools\\poweroff-vm-default.bat* OR cmdline:*\\VMware\\VMware Tools\\resume-vm-default.bat* OR cmdline:*\\VMware\\VMware Tools\\suspend-vm-default.bat*)))))
