# Description: Detects potential RDP connection via Mstsc using a local ".rdp" file located in suspicious locations.
# Converted by: Sigma Universal SIEM/EDR CLI

(((process_name:*\\mstsc.exe) OR (OriginalFileName:"mstsc.exe")) AND ((parent_name:*\\brave.exe OR parent_name:*\\CCleanerBrowser.exe OR parent_name:*\\chrome.exe OR parent_name:*\\chromium.exe OR parent_name:*\\firefox.exe OR parent_name:*\\iexplore.exe OR parent_name:*\\microsoftedge.exe OR parent_name:*\\msedge.exe OR parent_name:*\\opera.exe OR parent_name:*\\vivaldi.exe OR parent_name:*\\whale.exe OR parent_name:*\\outlook.exe)))
