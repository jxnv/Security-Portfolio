# Title: Potentially Suspicious Office Document Executed From Trusted Location
# ID: f99abdf0-6283-4e71-bd2b-b5c048a94743
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-06-21
# Tags: attack.stealth, attack.t1202
# Description: Detects the execution of an Office application that points to a document that is located in a trusted location. Attackers often used this to avoid macro security and execute their malicious code.
# Converted by: Sigma Universal SIEM/EDR CLI

(((((process_name:*\\EXCEL.EXE OR process_name:*\\POWERPNT.EXE OR process_name:*\\WINWORD.exe)) OR ((OriginalFileName:"Excel.exe" OR OriginalFileName:"POWERPNT.EXE" OR OriginalFileName:"WinWord.exe"))) AND ((parent_name:*\\explorer.exe OR parent_name:*\\dopus.exe)) AND ((cmdline:*\\AppData\\Roaming\\Microsoft\\Templates* OR cmdline:*\\AppData\\Roaming\\Microsoft\\Word\\Startup\\* OR cmdline:*\\Microsoft Office\\root\\Templates\\* OR cmdline:*\\Microsoft Office\\Templates\\*))) AND -(((cmdline:*.dotx OR cmdline:*.xltx OR cmdline:*.potx))))
