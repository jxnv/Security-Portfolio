# Title: Potential Persistence Via Microsoft Office Startup Folder
# ID: 0e20c89d-2264-44ae-8238-aeeaba609ece
# Status: test
# Level: high
# Author: Max Altgelt (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-06-02
# Tags: attack.persistence, attack.t1137
# Description: Detects creation of Microsoft Office files inside of one of the default startup folders in order to achieve persistence.
# Converted by: Sigma Universal SIEM/EDR CLI

(((((filemod_name:*.doc OR filemod_name:*.docm OR filemod_name:*.docx OR filemod_name:*.dot OR filemod_name:*.dotm OR filemod_name:*.rtf)) AND ((filemod_name:*\\Microsoft\\Word\\STARTUP*) OR ((filemod_name:*\\Office* AND filemod_name:*\\Program Files* AND filemod_name:*\\STARTUP*)))) OR (((filemod_name:*.xls OR filemod_name:*.xlsm OR filemod_name:*.xlsx OR filemod_name:*.xlt OR filemod_name:*.xltm)) AND ((filemod_name:*\\Microsoft\\Excel\\XLSTART*) OR ((filemod_name:*\\Office* AND filemod_name:*\\Program Files* AND filemod_name:*\\XLSTART*))))) AND -(((process_name:*\\WINWORD.exe OR process_name:*\\EXCEL.exe))))
