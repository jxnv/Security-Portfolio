# Title: Suspicious Mstsc.EXE Execution With Local RDP File
# ID: 6e22722b-dfb1-4508-a911-49ac840b40f8
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-04-18
# Tags: attack.command-and-control, attack.t1219.002
# Description: Detects potential RDP connection via Mstsc using a local ".rdp" file located in suspicious locations.
# Converted by: Sigma Universal SIEM/EDR CLI

(((cmdline:*.rdp OR cmdline:*.rdp\")) AND ((process_name:*\\mstsc.exe) OR (OriginalFileName:"mstsc.exe")) AND ((cmdline:*:\\Users\\Public\\* OR cmdline:*:\\Windows\\System32\\spool\\drivers\\color* OR cmdline:*:\\Windows\\System32\\Tasks_Migrated * OR cmdline:*:\\Windows\\Tasks\\* OR cmdline:*:\\Windows\\Temp\\* OR cmdline:*:\\Windows\\Tracing\\* OR cmdline:*\\AppData\\Local\\Temp\\* OR cmdline:*\\Downloads\\*)))
