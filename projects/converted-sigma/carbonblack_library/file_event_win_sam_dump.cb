# Title: Potential SAM Database Dump
# ID: 4e87b8e2-2ee9-4b2a-a715-4727d297ece0
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-02-11
# Tags: attack.credential-access, attack.t1003.002
# Description: Detects the creation of files that look like exports of the local SAM (Security Account Manager)
# Converted by: Sigma Universal SIEM/EDR CLI

(((filemod_name:*\\Temp\\sam OR filemod_name:*\\sam.sav OR filemod_name:*\\Intel\\sam OR filemod_name:*\\sam.hive OR filemod_name:*\\Perflogs\\sam OR filemod_name:*\\ProgramData\\sam OR filemod_name:*\\Users\\Public\\sam OR filemod_name:*\\AppData\\Local\\sam OR filemod_name:*\\AppData\\Roaming\\sam OR filemod_name:*_ShadowSteal.zip OR filemod_name:*\\Documents\\SAM.export OR filemod_name:*:\\sam)) OR ((filemod_name:*\\hive_sam_* OR filemod_name:*\\sam.save* OR filemod_name:*\\sam.export* OR filemod_name:*\\~reg_sam.save* OR filemod_name:*\\sam_backup* OR filemod_name:*\\sam.bck* OR filemod_name:*\\sam.backup*)))
