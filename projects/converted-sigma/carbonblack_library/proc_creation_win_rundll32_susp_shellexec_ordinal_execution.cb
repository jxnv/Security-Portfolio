# Title: Suspicious ShellExec_RunDLL Call Via Ordinal
# ID: 8823e85d-31d8-473e-b7f4-92da070f0fc6
# Status: test
# Level: high
# Author: Swachchhanda Shrawan Poudel
# Date: 2024-12-01
# Tags: attack.stealth, attack.t1218.011
# Description: Detects suspicious call to the "ShellExec_RunDLL" exported function of SHELL32.DLL through the ordinal number to launch other commands.
# Adversary might only use the ordinal number in order to bypass existing detection that alert on usage of ShellExec_RunDLL on CommandLine.
# Converted by: Sigma Universal SIEM/EDR CLI

(((ParentCommandLine:*SHELL32.DLL*) AND ((ParentCommandLine:*#568* OR ParentCommandLine:*#570* OR ParentCommandLine:*#572* OR ParentCommandLine:*#576*))) AND (((process_name:*\\bash.exe OR process_name:*\\bitsadmin.exe OR process_name:*\\cmd.exe OR process_name:*\\cscript.exe OR process_name:*\\curl.exe OR process_name:*\\mshta.exe OR process_name:*\\msiexec.exe OR process_name:*\\msxsl.exe OR process_name:*\\odbcconf.exe OR process_name:*\\powershell.exe OR process_name:*\\pwsh.exe OR process_name:*\\regsvr32.exe OR process_name:*\\schtasks.exe OR process_name:*\\wmic.exe OR process_name:*\\wscript.exe)) OR (((ParentCommandLine:*comspec* OR ParentCommandLine:*iex* OR ParentCommandLine:*Invoke-* OR ParentCommandLine:*msiexec* OR ParentCommandLine:*odbcconf* OR ParentCommandLine:*regsvr32*)) OR ((ParentCommandLine:*\\Desktop\\* OR ParentCommandLine:*\\ProgramData\\* OR ParentCommandLine:*\\Temp\\* OR ParentCommandLine:*\\Users\\Public\\*)))))
