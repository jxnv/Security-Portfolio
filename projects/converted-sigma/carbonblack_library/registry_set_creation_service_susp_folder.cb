# Title: Service Binary in Suspicious Folder
# ID: a07f0359-4c90-4dc4-a681-8ffea40b4f47
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), frack113
# Date: 2022-05-02
# Tags: attack.persistence, attack.defense-impairment, attack.t1112
# Description: Detect the creation of a service with a service binary located in a suspicious directory
# Converted by: Sigma Universal SIEM/EDR CLI

(((TargetObject:HKLM\\System\\CurrentControlSet\\Services\\* AND TargetObject:*\\ImagePath AND (Details:*\\Users\\Public\\* OR Details:*\\Perflogs\\* OR Details:*\\ADMIN$\\* OR Details:*\\Temp\\*)) OR (TargetObject:HKLM\\System\\CurrentControlSet\\Services\\* AND TargetObject:*\\Start AND (process_name:*\\Users\\Public\\* OR process_name:*\\Perflogs\\* OR process_name:*\\ADMIN$\\* OR process_name:*\\Temp\\*) AND (Details:"DWORD (0x00000000)" OR Details:"DWORD (0x00000001)" OR Details:"DWORD (0x00000002)"))) AND -((((process_name:*\\Common Files\\* AND process_name:*\\Temp\\*)) OR (TargetObject:*\\CurrentControlSet\\Services\\MBAMInstallerService\\ImagePath AND Details:*\\AppData\\Local\\Temp\\MBAMInstallerService.exe\" AND process_name:"C:\\Windows\\system32\\services.exe"))))
