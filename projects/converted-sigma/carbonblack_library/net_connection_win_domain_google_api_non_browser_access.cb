(((DestinationHostname:*drive.googleapis.com* OR DestinationHostname:*oauth2.googleapis.com* OR DestinationHostname:*sheets.googleapis.com* OR DestinationHostname:*www.googleapis.com*)) AND -(((process_name:"") OR (-process_name:*))) AND -(((process_name:*\\brave.exe) OR ((process_name:*:\\Program Files\\Google\\Chrome\\Application\\chrome.exe OR process_name:*:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe)) OR ((process_name:*:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*) OR ((process_name:*:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe OR process_name:*:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe OR process_name:*\\WindowsApps\\MicrosoftEdge.exe))) OR ((process_name:*:\\Program Files (x86)\\Microsoft\\EdgeCore\\* OR process_name:*:\\Program Files\\Microsoft\\EdgeCore\\*) AND (process_name:*\\msedge.exe OR process_name:*\\msedgewebview2.exe)) OR ((process_name:*:\\Program Files\\Mozilla Firefox\\firefox.exe OR process_name:*:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe)) OR (process_name:*:\\Program Files\\Google\\Drive File Stream\\* AND process_name:*\\GoogleDriveFS.exe) OR (process_name:*\\GoogleUpdate.exe) OR ((process_name:*:\\Program Files (x86)\\Internet Explorer\\iexplore.exe OR process_name:*:\\Program Files\\Internet Explorer\\iexplore.exe)) OR (process_name:*\\maxthon.exe) OR (process_name:*\\opera.exe) OR (process_name:*\\outlook.exe) OR (process_name:*\\safari.exe) OR (process_name:*\\seamonkey.exe) OR (process_name:*\\vivaldi.exe) OR (process_name:*\\whale.exe))))
