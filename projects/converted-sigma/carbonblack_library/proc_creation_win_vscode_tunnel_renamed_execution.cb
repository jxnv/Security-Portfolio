# Title: Renamed Visual Studio Code Tunnel Execution
# ID: 2cf29f11-e356-4f61-98c0-1bdb9393d6da
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-09-28
# Tags: attack.command-and-control, attack.t1071.001, attack.t1219
# Description: Detects renamed Visual Studio Code tunnel execution. Attackers can abuse this functionality to establish a C2 channel
# Converted by: Sigma Universal SIEM/EDR CLI

((((-OriginalFileName:* AND cmdline:*.exe tunnel) OR ((cmdline:*.exe tunnel* AND cmdline:*--accept-server-license-terms*)) OR ((cmdline:*tunnel * AND cmdline:*service* AND cmdline:*internal-run* AND cmdline:*tunnel-service.log*))) AND -(((process_name:*\\code-tunnel.exe OR process_name:*\\code.exe)))) OR ((ParentCommandLine:* tunnel AND process_name:*\\cmd.exe AND (cmdline:*/d /c * AND cmdline:*\\servers\\Stable-* AND cmdline:*code-server.cmd*)) AND -(((parent_name:*\\code-tunnel.exe OR parent_name:*\\code.exe)))))
