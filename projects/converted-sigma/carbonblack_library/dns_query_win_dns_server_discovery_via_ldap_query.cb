# Title: DNS Server Discovery Via LDAP Query
# ID: a21bcd7e-38ec-49ad-b69a-9ea17e69509e
# Status: test
# Level: low
# Author: frack113
# Date: 2022-08-20
# Tags: attack.discovery, attack.t1482
# Description: Detects DNS server discovery via LDAP query requests from uncommon applications
# Converted by: Sigma Universal SIEM/EDR CLI

((QueryName:_ldap.*) AND -(((process_name:*:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\* AND process_name:*\\MsMpEng.exe) OR ((process_name:*:\\Program Files\\* OR process_name:*:\\Program Files (x86)\\* OR process_name:*:\\Windows\\*)) OR (-process_name:*) OR (process_name:"<unknown process>"))) AND -(((process_name:C:\\WindowsAzure\\GuestAgent*) OR ((process_name:*\\chrome.exe OR process_name:*\\firefox.exe OR process_name:*\\opera.exe)))))
