# Title: Suspicious Process Start Locations
# ID: 15b75071-74cc-47e0-b4c6-b43744a62a2b
# Status: test
# Level: medium
# Author: juju4, Jonhnathan Ribeiro, oscd.community
# Date: 2019-01-16
# Tags: attack.stealth, attack.t1036, car.2013-05-002
# Description: Detects suspicious process run from unusual locations
# Converted by: Sigma Universal SIEM/EDR CLI

(((process_name:*:\\RECYCLER\\* OR process_name:*:\\SystemVolumeInformation\\*)) OR ((process_name:C:\\Windows\\Tasks\\* OR process_name:C:\\Windows\\debug\\* OR process_name:C:\\Windows\\fonts\\* OR process_name:C:\\Windows\\help\\* OR process_name:C:\\Windows\\drivers\\* OR process_name:C:\\Windows\\addins\\* OR process_name:C:\\Windows\\cursors\\* OR process_name:C:\\Windows\\system32\\tasks\\*)))
