# Title: Change PowerShell Policies to an Insecure Level
# ID: 87e3c4e8-a6a8-4ad9-bb4f-46e7ff99a180
# Status: test
# Level: medium
# Author: frack113
# Date: 2021-11-01
# Tags: attack.execution, attack.t1059.001
# Description: Detects changing the PowerShell script execution policy to a potentially insecure level using the "-ExecutionPolicy" flag.
# Converted by: Sigma Universal SIEM/EDR CLI

(((((OriginalFileName:"powershell_ise.exe" OR OriginalFileName:"PowerShell.EXE" OR OriginalFileName:"pwsh.dll")) OR ((process_name:*\\powershell_ise.exe OR process_name:*\\powershell.exe OR process_name:*\\pwsh.exe))) AND ((cmdline:*Bypass* OR cmdline:*Unrestricted*)) AND ((cmdline:*-executionpolicy * OR cmdline:* -ep * OR cmdline:* -exec *))) AND -(((parent_name:"C:\\Windows\\SysWOW64\\msiexec.exe" OR parent_name:"C:\\Windows\\System32\\msiexec.exe") AND (cmdline:*-NoProfile -ExecutionPolicy Bypass -File \"C:\\Program Files\\PowerShell\\7\\* OR cmdline:*-NoProfile -ExecutionPolicy Bypass -File \"C:\\Program Files (x86)\\PowerShell\\7\\*))) AND -(((parent_name:*C:\\Program Files\\Avast Software\\Avast\\* OR parent_name:*C:\\Program Files (x86)\\Avast Software\\Avast\\* OR parent_name:*\\instup.exe*) AND (cmdline:*-ExecutionPolicy ByPass -File \"C:\\Program Files\\Avast Software\\Avast* OR cmdline:*-ExecutionPolicy ByPass -File \"C:\\Program Files (x86)\\Avast Software\\Avast\\*))))
