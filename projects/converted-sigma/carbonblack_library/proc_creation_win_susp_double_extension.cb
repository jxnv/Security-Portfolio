# Title: Suspicious Double Extension File Execution
# ID: 1cdd9a09-06c9-4769-99ff-626e2b3991b8
# Status: stable
# Level: high
# Author: Florian Roth (Nextron Systems), @blu3_team (idea), Nasreddine Bencherchali (Nextron Systems)
# Date: 2019-06-26
# Tags: attack.initial-access, attack.t1566.001
# Description: Detects suspicious use of an .exe extension after a non-executable file extension like .pdf.exe, a set of spaces or underlines to cloak the executable file in spear phishing campaigns
# Converted by: Sigma Universal SIEM/EDR CLI

((process_name:*      .exe OR process_name:*______.exe OR process_name:*.doc.exe OR process_name:*.doc.js OR process_name:*.docx.exe OR process_name:*.docx.js OR process_name:*.gif.exe OR process_name:*.jpeg.exe OR process_name:*.jpg.exe OR process_name:*.mkv.exe OR process_name:*.mov.exe OR process_name:*.mp3.exe OR process_name:*.mp4.exe OR process_name:*.pdf.exe OR process_name:*.pdf.js OR process_name:*.png.exe OR process_name:*.ppt.exe OR process_name:*.ppt.js OR process_name:*.pptx.exe OR process_name:*.pptx.js OR process_name:*.rtf.exe OR process_name:*.rtf.js OR process_name:*.svg.exe OR process_name:*.txt.exe OR process_name:*.txt.js OR process_name:*.xls.exe OR process_name:*.xls.js OR process_name:*.xlsx.exe OR process_name:*.xlsx.js OR process_name:*⠀⠀⠀⠀⠀⠀.exe) AND (cmdline:*      .exe* OR cmdline:*______.exe* OR cmdline:*.doc.exe* OR cmdline:*.doc.js* OR cmdline:*.docx.exe* OR cmdline:*.docx.js* OR cmdline:*.gif.exe* OR cmdline:*.jpeg.exe* OR cmdline:*.jpg.exe* OR cmdline:*.mkv.exe* OR cmdline:*.mov.exe* OR cmdline:*.mp3.exe* OR cmdline:*.mp4.exe* OR cmdline:*.pdf.exe* OR cmdline:*.pdf.js* OR cmdline:*.png.exe* OR cmdline:*.ppt.exe* OR cmdline:*.ppt.js* OR cmdline:*.pptx.exe* OR cmdline:*.pptx.js* OR cmdline:*.rtf.exe* OR cmdline:*.rtf.js* OR cmdline:*.svg.exe* OR cmdline:*.txt.exe* OR cmdline:*.txt.js* OR cmdline:*.xls.exe* OR cmdline:*.xls.js* OR cmdline:*.xlsx.exe* OR cmdline:*.xlsx.js* OR cmdline:*⠀⠀⠀⠀⠀⠀.exe*))
