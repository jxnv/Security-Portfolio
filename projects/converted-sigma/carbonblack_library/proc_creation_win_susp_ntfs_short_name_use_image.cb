# Title: Use NTFS Short Name in Image
# ID: 3ef5605c-9eb9-47b0-9a71-b727e6aa5c3b
# Status: test
# Level: medium
# Author: frack113, Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-08-06
# Tags: attack.stealth, attack.t1564.004
# Description: Detect use of the Windows 8.3 short name. Which could be used as a method to avoid Image based detection
# Converted by: Sigma Universal SIEM/EDR CLI

(((process_name:*~1.bat* OR process_name:*~1.dll* OR process_name:*~1.exe* OR process_name:*~1.hta* OR process_name:*~1.js* OR process_name:*~1.msi* OR process_name:*~1.ps1* OR process_name:*~1.tmp* OR process_name:*~1.vbe* OR process_name:*~1.vbs* OR process_name:*~2.bat* OR process_name:*~2.dll* OR process_name:*~2.exe* OR process_name:*~2.hta* OR process_name:*~2.js* OR process_name:*~2.msi* OR process_name:*~2.ps1* OR process_name:*~2.tmp* OR process_name:*~2.vbe* OR process_name:*~2.vbs*)) AND -((parent_name:"C:\\Windows\\explorer.exe")) AND -(((parent_name:*\\thor\\thor64.exe) OR (process_name:*\\VCREDI~1.EXE) OR (parent_name:*\\WebEx\\WebexHost.exe) OR (process_name:"C:\\PROGRA~1\\WinZip\\WZPREL~1.EXE"))))
