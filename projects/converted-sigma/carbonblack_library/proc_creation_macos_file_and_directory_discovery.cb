# Title: File and Directory Discovery - MacOS
# ID: 089dbdf6-b960-4bcc-90e3-ffc3480c20f6
# Status: test
# Level: informational
# Author: Daniil Yugoslavskiy, oscd.community
# Date: 2020-10-19
# Tags: attack.discovery, attack.t1083
# Description: Detects usage of system utilities to discover files and directories
# Converted by: Sigma Universal SIEM/EDR CLI

((process_name:"/usr/bin/file" AND cmdline=regex("(.){200,}")) OR (process_name:"/usr/bin/find") OR (process_name:"/usr/bin/mdfind") OR (process_name:"/bin/ls" AND cmdline:*-R*) OR 1=1)
