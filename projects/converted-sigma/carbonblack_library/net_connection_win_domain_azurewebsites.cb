# Title: Network Connection Initiated To AzureWebsites.NET By Non-Browser Process
# ID: 5c80b618-0dbb-46e6-acbb-03d90bcb6d83
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2024-06-24
# Tags: attack.command-and-control, attack.t1102, attack.t1102.001
# Description: Detects an initiated network connection by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
# Converted by: Sigma Universal SIEM/EDR CLI

((Initiated:"true" AND DestinationHostname:*azurewebsites.net) AND -((((process_name:C:\\Program Files (x86)\\Avant Browser\\* OR process_name:C:\\Program Files\\Avant Browser\\*) AND process_name:*\\avant.exe) OR (process_name:C:\\Program Files\\BraveSoftware\\* AND process_name:*\\brave.exe) OR ((process_name:"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR process_name:"C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR (process_name:C:\\Users\\* AND process_name:*\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe) OR ((process_name:*C:\\Program Files\\Windows Defender Advanced Threat Protection\\* OR process_name:*C:\\Program Files\\Windows Defender\\* OR process_name:*C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*) AND (process_name:*\\MsMpEng.exe OR process_name:*\\MsSense.exe)) OR (process_name:*\\AppData\\Local\\Discord\\* AND process_name:*\\Discord.exe) OR ((process_name:C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*) OR (process_name:*\\WindowsApps\\MicrosoftEdge.exe) OR ((process_name:"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR process_name:"C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process_name:C:\\Program Files (x86)\\Microsoft\\EdgeCore\\* OR process_name:C:\\Program Files\\Microsoft\\EdgeCore\\*) AND (process_name:*\\msedge.exe OR process_name:*\\msedgewebview2.exe)) OR (process_name:"") OR ((process_name:C:\\Program Files\\Falkon\\* OR process_name:C:\\Program Files (x86)\\Falkon\\*) AND process_name:*\\falkon.exe) OR ((process_name:"C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR process_name:"C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR (process_name:C:\\Users\\* AND process_name:*\\AppData\\Local\\Mozilla Firefox\\firefox.exe) OR (process_name:*\\AppData\\Local\\Flock\\* AND process_name:*\\Flock.exe) OR ((process_name:"C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR process_name:"C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process_name:*\\AppData\\Local\\Maxthon\\* AND process_name:*\\maxthon.exe) OR (-process_name:*) OR (process_name:*\\AppData\\Local\\Programs\\Opera\\* AND process_name:*\\opera.exe) OR (process_name:*\\AppData\\Local\\Phoebe\\* AND process_name:*\\Phoebe.exe) OR ((process_name:*C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe OR process_name:*C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe)) OR ((process_name:C:\\Program Files (x86)\\QtWeb\\* OR process_name:C:\\Program Files\\QtWeb\\*) AND process_name:*\\QtWeb.exe) OR ((process_name:*C:\\Program Files (x86)\\Safari\\* OR process_name:*C:\\Program Files\\Safari\\*) AND process_name:*\\safari.exe) OR ((process_name:C:\\Program Files\\SeaMonkey\\* OR process_name:C:\\Program Files (x86)\\SeaMonkey\\*) AND process_name:*\\seamonkey.exe) OR ((process_name:C:\\Program Files\\SlimBrowser\\* OR process_name:C:\\Program Files (x86)\\SlimBrowser\\*) AND process_name:*\\slimbrowser.exe) OR (process_name:*\\AppData\\Local\\Vivaldi\\* AND process_name:*\\vivaldi.exe) OR ((process_name:C:\\Program Files\\Naver\\Naver Whale\\* OR process_name:C:\\Program Files (x86)\\Naver\\Naver Whale\\*) AND process_name:*\\whale.exe) OR ((process_name:C:\\Program Files\\Waterfox\\* OR process_name:C:\\Program Files (x86)\\Waterfox\\*) AND process_name:*\\Waterfox.exe))))
