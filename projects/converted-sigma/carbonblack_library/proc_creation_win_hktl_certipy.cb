(((process_name:*\\Certipy.exe) OR (OriginalFileName:"Certipy.exe") OR (Description:*Certipy*)) OR (((cmdline:* account * OR cmdline:* auth * OR cmdline:* cert * OR cmdline:* find * OR cmdline:* forge * OR cmdline:* ptt * OR cmdline:* relay * OR cmdline:* req * OR cmdline:* shadow * OR cmdline:* template *)) AND ((cmdline:* -bloodhound* OR cmdline:* -ca-pfx * OR cmdline:* -dc-ip * OR cmdline:* -kirbi* OR cmdline:* -old-bloodhound* OR cmdline:* -pfx * OR cmdline:* -target* OR cmdline:* -template* OR cmdline:* -username * OR cmdline:* -vulnerable* OR cmdline:*auth -pfx* OR cmdline:*shadow auto* OR cmdline:*shadow list*))))
