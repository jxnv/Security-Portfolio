# Description: Detects the execution of the PUA/Recon tool Seatbelt via PE information of command line parameters
# Converted by: Sigma Universal SIEM/EDR CLI

(((process_name:*\\Seatbelt.exe) OR (OriginalFileName:"Seatbelt.exe") OR (Description:"Seatbelt") OR ((cmdline:* DpapiMasterKeys* OR cmdline:* InterestingProcesses* OR cmdline:* InterestingFiles* OR cmdline:* CertificateThumbprints* OR cmdline:* ChromiumBookmarks* OR cmdline:* ChromiumHistory* OR cmdline:* ChromiumPresence* OR cmdline:* CloudCredentials* OR cmdline:* CredEnum* OR cmdline:* CredGuard* OR cmdline:* FirefoxHistory* OR cmdline:* ProcessCreationEvents*))) OR (((cmdline:* -group=misc* OR cmdline:* -group=remote* OR cmdline:* -group=chromium* OR cmdline:* -group=slack* OR cmdline:* -group=system* OR cmdline:* -group=user* OR cmdline:* -group=all*)) AND (cmdline:* -outputfile=*)))
