# Title: Suspicious Manipulation Of Default Accounts Via Net.EXE
# ID: 5b768e71-86f2-4879-b448-81061cbae951
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-09-01
# Tags: attack.collection, attack.t1560.001
# Description: Detects suspicious manipulations of default accounts such as 'administrator' and 'guest'. For example 'enable' or 'disable' accounts or change the password...etc
# Converted by: Sigma Universal SIEM/EDR CLI

(((((process_name:*\\net.exe OR process_name:*\\net1.exe)) OR ((OriginalFileName:"net.exe" OR OriginalFileName:"net1.exe"))) AND (cmdline:* user *) AND ((cmdline:* Järjestelmänvalvoja * OR cmdline:* Rendszergazda * OR cmdline:* Администратор * OR cmdline:* Administrateur * OR cmdline:* Administrador * OR cmdline:* Administratör * OR cmdline:* Administrator * OR cmdline:* guest * OR cmdline:* DefaultAccount * OR cmdline:* \"Järjestelmänvalvoja\" * OR cmdline:* \"Rendszergazda\" * OR cmdline:* \"Администратор\" * OR cmdline:* \"Administrateur\" * OR cmdline:* \"Administrador\" * OR cmdline:* \"Administratör\" * OR cmdline:* \"Administrator\" * OR cmdline:* \"guest\" * OR cmdline:* \"DefaultAccount\" * OR cmdline:* 'Järjestelmänvalvoja' * OR cmdline:* 'Rendszergazda' * OR cmdline:* 'Администратор' * OR cmdline:* 'Administrateur' * OR cmdline:* 'Administrador' * OR cmdline:* 'Administratör' * OR cmdline:* 'Administrator' * OR cmdline:* 'guest' * OR cmdline:* 'DefaultAccount' *))) AND -(((cmdline:*guest* AND cmdline:*/active no*))))
