# Title: Suspicious RunAs-Like Flag Combination
# ID: 50d66fb0-03f8-4da0-8add-84e77d12a020
# Status: test
# Level: medium
# Author: Florian Roth (Nextron Systems)
# Date: 2022-11-11
# Tags: attack.privilege-escalation
# Description: Detects suspicious command line flags that let the user set a target user and command as e.g. seen in PsExec-like tools
# Converted by: Sigma Universal SIEM/EDR CLI

(((cmdline:* -c cmd* OR cmdline:* -c \"cmd* OR cmdline:* -c powershell* OR cmdline:* -c \"powershell* OR cmdline:* --command cmd* OR cmdline:* --command powershell* OR cmdline:* -c whoami* OR cmdline:* -c wscript* OR cmdline:* -c cscript*)) AND ((cmdline:* -u system * OR cmdline:* --user system * OR cmdline:* -u NT* OR cmdline:* -u \"NT* OR cmdline:* -u 'NT* OR cmdline:* --system * OR cmdline:* -u administrator *)))
