# Title: CredUI.DLL Loaded By Uncommon Process
# ID: 9ae01559-cf7e-4f8e-8e14-4c290a1b4784
# Status: test
# Level: medium
# Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
# Date: 2020-10-20
# Tags: attack.credential-access, attack.collection, attack.t1056.002
# Description: Detects loading of "credui.dll" and related DLLs by an uncommon process. Attackers might leverage this DLL for potential use of "CredUIPromptForCredentials" or "CredUnPackAuthenticationBufferW".
# Converted by: Sigma Universal SIEM/EDR CLI

((((ImageLoaded:*\\credui.dll OR ImageLoaded:*\\wincredui.dll)) OR ((OriginalFileName:"credui.dll" OR OriginalFileName:"wincredui.dll"))) AND -((((process_name:"C:\\Windows\\explorer.exe" OR process_name:"C:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe" OR process_name:"C:\\Windows\\regedit.exe")) OR ((process_name:C:\\Program Files (x86)\\* OR process_name:C:\\Program Files\\* OR process_name:C:\\Windows\\System32\\* OR process_name:C:\\Windows\\SysWOW64\\* OR process_name:C:\\Windows\\SystemApps\\*)))) AND -(((process_name:C:\\Users\\* AND process_name:*\\AppData\\Local\\Microsoft\\OneDrive\\*) OR (process_name:*\\opera_autoupdate.exe) OR ((process_name:*\\procexp64.exe OR process_name:*\\procexp64a.exe OR process_name:*\\procexp.exe)) OR (process_name:C:\\Users\\* AND process_name:*\\AppData\\Local\\Microsoft\\Teams\\* AND process_name:*\\Teams.exe))))
