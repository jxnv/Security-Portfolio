# Title: Suspicious Invoke-WebRequest Execution With DirectIP
# ID: 1edff897-9146-48d2-9066-52e8d8f80a2f
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-04-21
# Tags: attack.command-and-control, attack.t1105
# Description: Detects calls to PowerShell with Invoke-WebRequest cmdlet using direct IP access
# Converted by: Sigma Universal SIEM/EDR CLI

(((cmdline:*curl * OR cmdline:*Invoke-RestMethod* OR cmdline:*Invoke-WebRequest* OR cmdline:* irm * OR cmdline:*iwr * OR cmdline:*wget *)) AND (((process_name:*\\powershell_ise.exe OR process_name:*\\powershell.exe OR process_name:*\\pwsh.exe)) OR ((OriginalFileName:"powershell_ise.EXE" OR OriginalFileName:"PowerShell.EXE" OR OriginalFileName:"pwsh.dll"))) AND ((cmdline:*://1* OR cmdline:*://2* OR cmdline:*://3* OR cmdline:*://4* OR cmdline:*://5* OR cmdline:*://6* OR cmdline:*://7* OR cmdline:*://8* OR cmdline:*://9*)))
