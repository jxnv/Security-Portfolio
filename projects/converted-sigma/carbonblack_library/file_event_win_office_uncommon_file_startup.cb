# Title: Uncommon File Created In Office Startup Folder
# ID: a10a2c40-2c4d-49f8-b557-1a946bc55d9d
# Status: test
# Level: high
# Author: frack113, Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-06-05
# Tags: attack.resource-development, attack.t1587.001
# Description: Detects the creation of a file with an uncommon extension in an Office application startup folder
# Converted by: Sigma Universal SIEM/EDR CLI

(((((filemod_name:*\\Microsoft\\Word\\STARTUP*) OR ((filemod_name:*\\Office* AND filemod_name:*\\Program Files* AND filemod_name:*\\STARTUP*))) AND -(((filemod_name:*.docb OR filemod_name:*.docm OR filemod_name:*.docx OR filemod_name:*.dotm OR filemod_name:*.mdb OR filemod_name:*.mdw OR filemod_name:*.pdf OR filemod_name:*.wll OR filemod_name:*.wwl)))) OR (((filemod_name:*\\Microsoft\\Excel\\XLSTART*) OR ((filemod_name:*\\Office* AND filemod_name:*\\Program Files* AND filemod_name:*\\XLSTART*))) AND -(((filemod_name:*.xll OR filemod_name:*.xls OR filemod_name:*.xlsm OR filemod_name:*.xlsx OR filemod_name:*.xlt OR filemod_name:*.xltm OR filemod_name:*.xlw))))) AND -((((process_name:*:\\Program Files\\Microsoft Office\\* OR process_name:*:\\Program Files (x86)\\Microsoft Office\\*) AND (process_name:*\\winword.exe OR process_name:*\\excel.exe)) OR (process_name:*:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\* AND process_name:*\\OfficeClickToRun.exe))))
