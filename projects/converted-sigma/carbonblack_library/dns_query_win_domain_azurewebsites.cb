# Title: DNS Query To AzureWebsites.NET By Non-Browser Process
# ID: e043f529-8514-4205-8ab0-7f7d2927b400
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2024-06-24
# Tags: attack.command-and-control, attack.t1219.002
# Description: Detects a DNS query by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
# Converted by: Sigma Universal SIEM/EDR CLI

((QueryName:*azurewebsites.net) AND -((((process_name:C:\\Program Files (x86)\\Avant Browser\\* OR process_name:C:\\Program Files\\Avant Browser\\*) AND process_name:*\\avant.exe) OR (process_name:*\\brave.exe AND process_name:C:\\Program Files\\BraveSoftware\\*) OR ((process_name:"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR process_name:"C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((process_name:*\\MsMpEng.exe OR process_name:*\\MsSense.exe)) OR ((process_name:C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*) OR (process_name:*\\WindowsApps\\MicrosoftEdge.exe) OR ((process_name:"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR process_name:"C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process_name:C:\\Program Files (x86)\\Microsoft\\EdgeCore\\* OR process_name:C:\\Program Files\\Microsoft\\EdgeCore\\*) AND (process_name:*\\msedge.exe OR process_name:*\\msedgewebview2.exe)) OR ((process_name:C:\\Program Files\\Falkon\\* OR process_name:C:\\Program Files (x86)\\Falkon\\*) AND process_name:*\\falkon.exe) OR ((process_name:"C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR process_name:"C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR (process_name:*\\AppData\\Local\\Flock\\* AND process_name:*\\Flock.exe) OR ((process_name:"C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR process_name:"C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process_name:*\\AppData\\Local\\Maxthon\\* AND process_name:*\\maxthon.exe) OR (process_name:*\\AppData\\Local\\Programs\\midori-ng\\* AND process_name:*\\Midori Next Generation.exe) OR (process_name:*\\AppData\\Local\\Programs\\Opera\\* AND process_name:*\\opera.exe) OR (process_name:*\\AppData\\Local\\Phoebe\\* AND process_name:*\\Phoebe.exe) OR (process_name:*\\safari.exe) OR ((process_name:C:\\Program Files\\SeaMonkey\\* OR process_name:C:\\Program Files (x86)\\SeaMonkey\\*) AND process_name:*\\seamonkey.exe) OR ((process_name:C:\\Program Files\\SlimBrowser\\* OR process_name:C:\\Program Files (x86)\\SlimBrowser\\*) AND process_name:*\\slimbrowser.exe) OR (process_name:*\\Tor Browser\\*) OR (process_name:*\\AppData\\Local\\Vivaldi\\* AND process_name:*\\vivaldi.exe) OR ((process_name:C:\\Program Files\\Naver\\Naver Whale\\* OR process_name:C:\\Program Files (x86)\\Naver\\Naver Whale\\*) AND process_name:*\\whale.exe) OR ((process_name:C:\\Program Files\\Waterfox\\* OR process_name:C:\\Program Files (x86)\\Waterfox\\*) AND process_name:*\\Waterfox.exe))))
