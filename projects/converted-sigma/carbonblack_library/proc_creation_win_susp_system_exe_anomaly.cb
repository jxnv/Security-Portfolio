# Title: System File Execution Location Anomaly
# ID: e4a6b256-3e47-40fc-89d2-7a477edd6915
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), Patrick Bareiss, Anton Kutepov, oscd.community, Nasreddine Bencherchali (Nextron Systems)
# Date: 2017-11-27
# Tags: attack.stealth, attack.t1036
# Description: Detects the execution of a Windows system binary that is usually located in the system folder from an uncommon location.
# Converted by: Sigma Universal SIEM/EDR CLI

(((process_name:*\\atbroker.exe OR process_name:*\\audiodg.exe OR process_name:*\\bcdedit.exe OR process_name:*\\bitsadmin.exe OR process_name:*\\certreq.exe OR process_name:*\\certutil.exe OR process_name:*\\cmstp.exe OR process_name:*\\conhost.exe OR process_name:*\\consent.exe OR process_name:*\\cscript.exe OR process_name:*\\csrss.exe OR process_name:*\\dashost.exe OR process_name:*\\defrag.exe OR process_name:*\\dfrgui.exe OR process_name:*\\dism.exe OR process_name:*\\dllhost.exe OR process_name:*\\dllhst3g.exe OR process_name:*\\dwm.exe OR process_name:*\\eventvwr.exe OR process_name:*\\fsquirt.exe OR process_name:*\\finger.exe OR process_name:*\\logonui.exe OR process_name:*\\LsaIso.exe OR process_name:*\\lsass.exe OR process_name:*\\lsm.exe OR process_name:*\\msiexec.exe OR process_name:*\\ntoskrnl.exe OR process_name:*\\powershell_ise.exe OR process_name:*\\powershell.exe OR process_name:*\\pwsh.exe OR process_name:*\\regsvr32.exe OR process_name:*\\rundll32.exe OR process_name:*\\runonce.exe OR process_name:*\\RuntimeBroker.exe OR process_name:*\\schtasks.exe OR process_name:*\\services.exe OR process_name:*\\sihost.exe OR process_name:*\\smartscreen.exe OR process_name:*\\smss.exe OR process_name:*\\spoolsv.exe OR process_name:*\\svchost.exe OR process_name:*\\taskhost.exe OR process_name:*\\taskhostw.exe OR process_name:*\\Taskmgr.exe OR process_name:*\\userinit.exe OR process_name:*\\werfault.exe OR process_name:*\\werfaultsecure.exe OR process_name:*\\wininit.exe OR process_name:*\\winlogon.exe OR process_name:*\\winver.exe OR process_name:*\\wlanext.exe OR process_name:*\\wmic.exe OR process_name:*\\wscript.exe OR process_name:*\\wsl.exe OR process_name:*\\wsmprovhost.exe)) AND -((((process_name:C:\\$WINDOWS.~BT\\* OR process_name:C:\\$WinREAgent\\* OR process_name:C:\\Windows\\SoftwareDistribution\\* OR process_name:C:\\Windows\\System32\\* OR process_name:C:\\Windows\\SystemTemp\\* OR process_name:C:\\Windows\\SysWOW64\\* OR process_name:C:\\Windows\\uus\\* OR process_name:C:\\Windows\\WinSxS\\*)) OR ((process_name:*C:\\Program Files\\PowerShell\\7\\* OR process_name:*C:\\Program Files\\PowerShell\\7-preview\\* OR process_name:*C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview* OR process_name:*\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview*) AND process_name:*\\pwsh.exe) OR (process_name:C:\\Users\\* AND process_name:*\\AppData\\Local\\Microsoft\\WindowsApps\\* AND process_name:*\\wsl.exe) OR ((process_name:C:\\Program Files\\WindowsApps\\MicrosoftCorporationII.WindowsSubsystemForLinux* OR process_name:C:\\Program Files\\WSL\\*) AND process_name:*\\wsl.exe))) AND -((process_name:*\\SystemRoot\\System32\\*)))
