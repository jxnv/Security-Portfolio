# Title: Suspicious Msiexec Quiet Install From Remote Location
# ID: 8150732a-0c9d-4a99-82b9-9efb9b90c40c
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-10-28
# Tags: attack.stealth, attack.t1218.007
# Description: Detects usage of Msiexec.exe to install packages hosted remotely quietly
# Converted by: Sigma Universal SIEM/EDR CLI

((((cmdline:*-i* OR cmdline:*/i* OR cmdline:*-package* OR cmdline:*/package* OR cmdline:*-a* OR cmdline:*/a* OR cmdline:*-j* OR cmdline:*/j*)) AND ((process_name:*\\msiexec.exe) OR (OriginalFileName:"msiexec.exe")) AND ((cmdline:*-q* OR cmdline:*/q*)) AND ((cmdline:*http* OR cmdline:*\\\\\\\\*))) AND -(((cmdline:*\\AppData\\Local\\Temp\\OpenOffice* AND cmdline:*Installation Files\\openoffice*))))
