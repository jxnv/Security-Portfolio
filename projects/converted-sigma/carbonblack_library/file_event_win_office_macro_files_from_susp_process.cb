# Title: Office Macro File Creation From Suspicious Process
# ID: b1c50487-1967-4315-a026-6491686d860e
# Status: test
# Level: high
# Author: frack113, Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-01-23
# Tags: attack.initial-access, attack.t1566.001
# Description: Detects the creation of a office macro file from a a suspicious process
# Converted by: Sigma Universal SIEM/EDR CLI

((((process_name:*\\cscript.exe OR process_name:*\\mshta.exe OR process_name:*\\regsvr32.exe OR process_name:*\\rundll32.exe OR process_name:*\\wscript.exe)) OR ((parent_name:*\\cscript.exe OR parent_name:*\\mshta.exe OR parent_name:*\\regsvr32.exe OR parent_name:*\\rundll32.exe OR parent_name:*\\wscript.exe))) AND ((filemod_name:*.docm OR filemod_name:*.dotm OR filemod_name:*.xlsm OR filemod_name:*.xltm OR filemod_name:*.potm OR filemod_name:*.pptm)))
