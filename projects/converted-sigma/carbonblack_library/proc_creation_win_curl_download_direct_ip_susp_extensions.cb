# Title: Suspicious File Download From IP Via Curl.EXE
# ID: 5cb299fc-5fb1-4d07-b989-0644c68b6043
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-07-27
# Tags: attack.execution
# Description: Detects potentially suspicious file downloads directly from IP addresses using curl.exe
# Converted by: Sigma Universal SIEM/EDR CLI

(((cmdline:*.bat OR cmdline:*.bat\" OR cmdline:*.dat OR cmdline:*.dat\" OR cmdline:*.dll OR cmdline:*.dll\" OR cmdline:*.exe OR cmdline:*.exe\" OR cmdline:*.gif OR cmdline:*.gif\" OR cmdline:*.hta OR cmdline:*.hta\" OR cmdline:*.jpeg OR cmdline:*.jpeg\" OR cmdline:*.log OR cmdline:*.log\" OR cmdline:*.msi OR cmdline:*.msi\" OR cmdline:*.png OR cmdline:*.png\" OR cmdline:*.ps1 OR cmdline:*.ps1\" OR cmdline:*.psm1 OR cmdline:*.psm1\" OR cmdline:*.vbe OR cmdline:*.vbe\" OR cmdline:*.vbs OR cmdline:*.vbs\" OR cmdline:*.bat' OR cmdline:*.dat' OR cmdline:*.dll' OR cmdline:*.exe' OR cmdline:*.gif' OR cmdline:*.hta' OR cmdline:*.jpeg' OR cmdline:*.log' OR cmdline:*.msi' OR cmdline:*.png' OR cmdline:*.ps1' OR cmdline:*.psm1' OR cmdline:*.vbe' OR cmdline:*.vbs')) AND ((cmdline:* -O* OR cmdline:*--remote-name* OR cmdline:*--output*)) AND (cmdline:*http*) AND ((process_name:*\\curl.exe) OR (OriginalFileName:"curl.exe")) AND (cmdline=regex("://[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}")))
