# Title: Suspicious Microsoft Office Child Process
# ID: 438025f9-5856-4663-83f7-52f878a70a50
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), Markus Neis, FPT.EagleEye Team, Vadim Khrykov, Cyb3rEng, Michael Haag, Christopher Peacock @securepeacock, @scythe_io
# Date: 2018-04-06
# Tags: attack.execution, attack.stealth, attack.t1047, attack.t1204.002, attack.t1218.010
# Description: Detects a suspicious process spawning from one of the Microsoft Office suite products (Word, Excel, PowerPoint, Publisher, Visio, etc.)
# Converted by: Sigma Universal SIEM/EDR CLI

(((parent_name:*\\EQNEDT32.EXE OR parent_name:*\\EXCEL.EXE OR parent_name:*\\MSACCESS.EXE OR parent_name:*\\MSPUB.exe OR parent_name:*\\ONENOTE.EXE OR parent_name:*\\POWERPNT.exe OR parent_name:*\\VISIO.exe OR parent_name:*\\WINWORD.EXE OR parent_name:*\\wordpad.exe OR parent_name:*\\wordview.exe)) AND ((((OriginalFileName:"bitsadmin.exe" OR OriginalFileName:"CertOC.exe" OR OriginalFileName:"CertUtil.exe" OR OriginalFileName:"Cmd.Exe" OR OriginalFileName:"CMSTP.EXE" OR OriginalFileName:"cscript.exe" OR OriginalFileName:"curl.exe" OR OriginalFileName:"HH.exe" OR OriginalFileName:"IEExec.exe" OR OriginalFileName:"InstallUtil.exe" OR OriginalFileName:"javaw.exe" OR OriginalFileName:"Microsoft.Workflow.Compiler.exe" OR OriginalFileName:"msdt.exe" OR OriginalFileName:"MSHTA.EXE" OR OriginalFileName:"msiexec.exe" OR OriginalFileName:"Msxsl.exe" OR OriginalFileName:"odbcconf.exe" OR OriginalFileName:"pcalua.exe" OR OriginalFileName:"PowerShell.EXE" OR OriginalFileName:"RegAsm.exe" OR OriginalFileName:"RegSvcs.exe" OR OriginalFileName:"REGSVR32.exe" OR OriginalFileName:"RUNDLL32.exe" OR OriginalFileName:"schtasks.exe" OR OriginalFileName:"ScriptRunner.exe" OR OriginalFileName:"wmic.exe" OR OriginalFileName:"WorkFolders.exe" OR OriginalFileName:"wscript.exe")) OR ((process_name:*\\AppVLP.exe OR process_name:*\\bash.exe OR process_name:*\\bitsadmin.exe OR process_name:*\\certoc.exe OR process_name:*\\certutil.exe OR process_name:*\\cmd.exe OR process_name:*\\cmstp.exe OR process_name:*\\control.exe OR process_name:*\\cscript.exe OR process_name:*\\curl.exe OR process_name:*\\forfiles.exe OR process_name:*\\hh.exe OR process_name:*\\ieexec.exe OR process_name:*\\installutil.exe OR process_name:*\\javaw.exe OR process_name:*\\mftrace.exe OR process_name:*\\Microsoft.Workflow.Compiler.exe OR process_name:*\\msbuild.exe OR process_name:*\\msdt.exe OR process_name:*\\mshta.exe OR process_name:*\\msidb.exe OR process_name:*\\msiexec.exe OR process_name:*\\msxsl.exe OR process_name:*\\odbcconf.exe OR process_name:*\\pcalua.exe OR process_name:*\\powershell.exe OR process_name:*\\pwsh.exe OR process_name:*\\regasm.exe OR process_name:*\\regsvcs.exe OR process_name:*\\regsvr32.exe OR process_name:*\\rundll32.exe OR process_name:*\\schtasks.exe OR process_name:*\\scrcons.exe OR process_name:*\\scriptrunner.exe OR process_name:*\\sh.exe OR process_name:*\\svchost.exe OR process_name:*\\verclsid.exe OR process_name:*\\wmic.exe OR process_name:*\\workfolders.exe OR process_name:*\\wscript.exe))) OR ((process_name:*\\AppData\\* OR process_name:*\\Users\\Public\\* OR process_name:*\\ProgramData\\* OR process_name:*\\Windows\\Tasks\\* OR process_name:*\\Windows\\Temp\\* OR process_name:*\\Windows\\System32\\Tasks\\*))))
