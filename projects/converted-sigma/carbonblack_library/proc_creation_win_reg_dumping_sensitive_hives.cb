# Description: Detects the usage of "reg.exe" in order to dump sensitive registry hives. This includes SAM, SYSTEM and SECURITY hives.
# Converted by: Sigma Universal SIEM/EDR CLI

(((cmdline:* save * OR cmdline:* export * OR cmdline:* ˢave * OR cmdline:* eˣport *)) AND ((cmdline:*\\system* OR cmdline:*\\sam* OR cmdline:*\\security* OR cmdline:*\\ˢystem* OR cmdline:*\\syˢtem* OR cmdline:*\\ˢyˢtem* OR cmdline:*\\ˢam* OR cmdline:*\\ˢecurity*)) AND ((cmdline:*hklm* OR cmdline:*hk˪m* OR cmdline:*hkey_local_machine* OR cmdline:*hkey_˪ocal_machine* OR cmdline:*hkey_loca˪_machine* OR cmdline:*hkey_˪oca˪_machine*)) AND ((process_name:*\\reg.exe) OR (OriginalFileName:"reg.exe")))
