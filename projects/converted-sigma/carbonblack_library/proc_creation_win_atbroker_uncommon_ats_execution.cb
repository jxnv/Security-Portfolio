# Title: Uncommon  Assistive Technology Applications Execution Via AtBroker.EXE
# ID: f24bcaea-0cd1-11eb-adc1-0242ac120002
# Status: test
# Level: medium
# Author: Mateusz Wydra, oscd.community
# Date: 2020-10-12
# Tags: attack.stealth, attack.t1218
# Description: Detects the start of a non built-in assistive technology applications via "Atbroker.EXE".
# Converted by: Sigma Universal SIEM/EDR CLI

(((cmdline:*start*) AND ((process_name:*\\AtBroker.exe) OR (OriginalFileName:"AtBroker.exe"))) AND -(((cmdline:*animations* OR cmdline:*audiodescription* OR cmdline:*caretbrowsing* OR cmdline:*caretwidth* OR cmdline:*colorfiltering* OR cmdline:*cursorindicator* OR cmdline:*cursorscheme* OR cmdline:*filterkeys* OR cmdline:*focusborderheight* OR cmdline:*focusborderwidth* OR cmdline:*highcontrast* OR cmdline:*keyboardcues* OR cmdline:*keyboardpref* OR cmdline:*livecaptions* OR cmdline:*magnifierpane* OR cmdline:*messageduration* OR cmdline:*minimumhitradius* OR cmdline:*mousekeys* OR cmdline:*Narrator* OR cmdline:*osk* OR cmdline:*overlappedcontent* OR cmdline:*showsounds* OR cmdline:*soundsentry* OR cmdline:*speechreco* OR cmdline:*stickykeys* OR cmdline:*togglekeys* OR cmdline:*voiceaccess* OR cmdline:*windowarranging* OR cmdline:*windowtracking* OR cmdline:*windowtrackingtimeout* OR cmdline:*windowtrackingzorder*))) AND -((cmdline:*Oracle_JavaAccessBridge*)))
