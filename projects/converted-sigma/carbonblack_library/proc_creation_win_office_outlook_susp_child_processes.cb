# Title: Suspicious Outlook Child Process
# ID: 208748f7-881d-47ac-a29c-07ea84bf691d
# Status: test
# Level: high
# Author: Michael Haag, Florian Roth (Nextron Systems), Markus Neis, Elastic, FPT.EagleEye Team
# Date: 2022-02-28
# Tags: attack.execution, attack.t1204.002
# Description: Detects a suspicious process spawning from an Outlook process.
# Converted by: Sigma Universal SIEM/EDR CLI

(parent_name:*\\OUTLOOK.EXE AND (process_name:*\\AppVLP.exe OR process_name:*\\bash.exe OR process_name:*\\cmd.exe OR process_name:*\\cscript.exe OR process_name:*\\forfiles.exe OR process_name:*\\hh.exe OR process_name:*\\mftrace.exe OR process_name:*\\msbuild.exe OR process_name:*\\msdt.exe OR process_name:*\\mshta.exe OR process_name:*\\msiexec.exe OR process_name:*\\powershell.exe OR process_name:*\\pwsh.exe OR process_name:*\\regsvr32.exe OR process_name:*\\schtasks.exe OR process_name:*\\scrcons.exe OR process_name:*\\scriptrunner.exe OR process_name:*\\sh.exe OR process_name:*\\svchost.exe OR process_name:*\\wmic.exe OR process_name:*\\wscript.exe))
