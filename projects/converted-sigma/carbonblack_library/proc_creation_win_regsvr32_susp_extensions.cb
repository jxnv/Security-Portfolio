# Title: Regsvr32 DLL Execution With Suspicious File Extension
# ID: 089fc3d2-71e8-4763-a8a5-c97fbb0a403e
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), frack113
# Date: 2021-11-29
# Tags: attack.stealth, attack.t1218.010
# Description: Detects the execution of REGSVR32.exe with DLL files masquerading as other files
# Converted by: Sigma Universal SIEM/EDR CLI

(((cmdline:*.bin OR cmdline:*.bmp OR cmdline:*.cr2 OR cmdline:*.dat OR cmdline:*.eps OR cmdline:*.gif OR cmdline:*.ico OR cmdline:*.jpeg OR cmdline:*.jpg OR cmdline:*.log OR cmdline:*.nef OR cmdline:*.orf OR cmdline:*.png OR cmdline:*.raw OR cmdline:*.rtf OR cmdline:*.sr2 OR cmdline:*.temp OR cmdline:*.tif OR cmdline:*.tiff OR cmdline:*.tmp OR cmdline:*.txt)) AND ((process_name:*\\regsvr32.exe) OR (OriginalFileName:"REGSVR32.EXE")))
