# Description: Detects suspicious command lines used in Covenant luanchers
# Converted by: Sigma Universal SIEM/EDR CLI

(((cmdline:*-Sta* AND cmdline:*-Nop* AND cmdline:*-Window* AND cmdline:*Hidden*) AND (cmdline:*-Command* OR cmdline:*-EncodedCommand*)) OR ((cmdline:*sv o (New-Object IO.MemorySteam);sv d * OR cmdline:*mshta file.hta* OR cmdline:*GruntHTTP* OR cmdline:*-EncodedCommand cwB2ACAAbwAgA*)))
