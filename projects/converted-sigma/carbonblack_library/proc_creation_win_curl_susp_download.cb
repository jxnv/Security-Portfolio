# Title: Suspicious Curl.EXE Download
# ID: e218595b-bbe7-4ee5-8a96-f32a24ad3468
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
# Date: 2020-07-03
# Tags: attack.command-and-control, attack.t1105
# Description: Detects a suspicious curl process start on Windows and outputs the requested document to a local file
# Converted by: Sigma Universal SIEM/EDR CLI

(((process_name:*\\curl.exe) OR (Product:"The curl executable")) AND (((cmdline:*.dll OR cmdline:*.gif OR cmdline:*.jpeg OR cmdline:*.jpg OR cmdline:*.png OR cmdline:*.temp OR cmdline:*.tmp OR cmdline:*.txt OR cmdline:*.vbe OR cmdline:*.vbs)) OR ((cmdline:*%AppData%* OR cmdline:*%Public%* OR cmdline:*%Temp%* OR cmdline:*%tmp%* OR cmdline:*\\AppData\\* OR cmdline:*\\Desktop\\* OR cmdline:*\\Temp\\* OR cmdline:*\\Users\\Public\\* OR cmdline:*C:\\PerfLogs\\* OR cmdline:*C:\\ProgramData\\* OR cmdline:*C:\\Windows\\Temp\\*))) AND -((parent_name:"C:\\Program Files\\Git\\usr\\bin\\sh.exe" AND process_name:"C:\\Program Files\\Git\\mingw64\\bin\\curl.exe" AND (cmdline:*--silent --show-error --output * AND cmdline:*gfw-httpget-* AND cmdline:*AppData*))))
