# Title: LOLBIN Execution From Abnormal Drive
# ID: d4ca7c59-e9e4-42d8-bf57-91a776efcb87
# Status: test
# Level: medium
# Author: Christopher Peacock '@securepeacock', SCYTHE '@scythe_io', Angelo Violetti - SEC Consult '@angelo_violetti', Aaron Herman
# Date: 2022-01-25
# Tags: attack.stealth
# Description: Detects LOLBINs executing from an abnormal or uncommon drive such as a mounted ISO.
# Converted by: Sigma Universal SIEM/EDR CLI

((((process_name:*\\calc.exe OR process_name:*\\certutil.exe OR process_name:*\\cmstp.exe OR process_name:*\\cscript.exe OR process_name:*\\installutil.exe OR process_name:*\\mshta.exe OR process_name:*\\regsvr32.exe OR process_name:*\\rundll32.exe OR process_name:*\\wscript.exe)) OR ((OriginalFileName:"CALC.EXE" OR OriginalFileName:"CertUtil.exe" OR OriginalFileName:"CMSTP.EXE" OR OriginalFileName:"cscript.exe" OR OriginalFileName:"installutil.exe" OR OriginalFileName:"MSHTA.EXE" OR OriginalFileName:"REGSVR32.EXE" OR OriginalFileName:"RUNDLL32.EXE" OR OriginalFileName:"wscript.exe"))) AND -(((CurrentDirectory:*C:\\*) OR (CurrentDirectory:"") OR (-CurrentDirectory:*))))
