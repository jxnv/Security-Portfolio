# Title: File Download with Headless Browser
# ID: 0e8cfe08-02c9-4815-a2f8-0d157b7ed33e
# Status: test
# Level: high
# Author: Sreeman, Florian Roth (Nextron Systems)
# Date: 2022-01-04
# Tags: attack.command-and-control, attack.stealth, attack.t1105, attack.t1564.003
# Description: Detects execution of chromium based browser in headless mode using the "dump-dom" command line to download files
# Converted by: Sigma Universal SIEM/EDR CLI

(((process_name:*\\brave.exe OR process_name:*\\chrome.exe OR process_name:*\\msedge.exe OR process_name:*\\opera.exe OR process_name:*\\vivaldi.exe) AND (cmdline:*--headless* AND cmdline:*dump-dom* AND cmdline:*http*)) AND -((((process_name:C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\* OR process_name:C:\\Program Files (x86)\\Microsoft\\EdgeCore\\* OR process_name:C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\* OR process_name:C:\\Program Files\\Microsoft\\Edge\\Application\\* OR process_name:C:\\Program Files\\Microsoft\\EdgeCore\\* OR process_name:C:\\Program Files\\Microsoft\\EdgeWebView\\* OR process_name:C:\\Program Files\\WindowsApps\\Microsoft.MicrosoftEdge*) AND (process_name:*\\msedge.exe OR process_name:*\\msedgewebview2.exe OR process_name:*\\MicrosoftEdge.exe) AND cmdline:*--headless --disable-gpu --disable-extensions --disable-plugins --mute-audio --no-first-run --incognito --aggressive-cache-discard --dump-dom*) OR ((process_name:*\\AppData\\Local\\Microsoft\\WindowsApps\\* OR process_name:*\\Windows\\SystemApps\\Microsoft.MicrosoftEdge*) AND (process_name:*\\msedge.exe OR process_name:*\\MicrosoftEdge.exe) AND cmdline:*--headless --disable-gpu --disable-extensions --disable-plugins --mute-audio --no-first-run --incognito --aggressive-cache-discard --dump-dom*))))
