# Title: Potentially Suspicious Child Process Of ClickOnce Application
# ID: 67bc0e75-c0a9-4cfc-8754-84a505b63c04
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-06-12
# Tags: attack.execution, attack.stealth
# Description: Detects potentially suspicious child processes of a ClickOnce deployment application
# Converted by: Sigma Universal SIEM/EDR CLI

(parent_name:*\\AppData\\Local\\Apps\\2.0\\* AND (process_name:*\\calc.exe OR process_name:*\\cmd.exe OR process_name:*\\cscript.exe OR process_name:*\\explorer.exe OR process_name:*\\mshta.exe OR process_name:*\\net.exe OR process_name:*\\net1.exe OR process_name:*\\nltest.exe OR process_name:*\\notepad.exe OR process_name:*\\powershell.exe OR process_name:*\\pwsh.exe OR process_name:*\\reg.exe OR process_name:*\\regsvr32.exe OR process_name:*\\rundll32.exe OR process_name:*\\schtasks.exe OR process_name:*\\werfault.exe OR process_name:*\\wscript.exe))
