# Title: File With Uncommon Extension Created By An Office Application
# ID: c7a74c80-ba5a-486e-9974-ab9e682bc5e4
# Status: test
# Level: high
# Author: Vadim Khrykov (ThreatIntel), Cyb3rEng (Rule), Nasreddine Bencherchali (Nextron Systems)
# Date: 2021-08-23
# Tags: attack.t1204.002, attack.execution
# Description: Detects the creation of files with an executable or script extension by an Office application.
# Converted by: Sigma Universal SIEM/EDR CLI

((((process_name:*\\excel.exe OR process_name:*\\msaccess.exe OR process_name:*\\mspub.exe OR process_name:*\\powerpnt.exe OR process_name:*\\visio.exe OR process_name:*\\winword.exe)) AND ((filemod_name:*.bat OR filemod_name:*.cmd OR filemod_name:*.com OR filemod_name:*.dll OR filemod_name:*.exe OR filemod_name:*.hta OR filemod_name:*.ocx OR filemod_name:*.proj OR filemod_name:*.ps1 OR filemod_name:*.scf OR filemod_name:*.scr OR filemod_name:*.sys OR filemod_name:*.vbe OR filemod_name:*.vbs OR filemod_name:*.wsf OR filemod_name:*.wsh))) AND -((filemod_name:*\\AppData\\Local\\assembly\\tmp\\* AND filemod_name:*.dll)) AND -((((filemod_name:*C:\\Users\\* AND filemod_name:*\\AppData\\Local\\Microsoft\\Office\\* AND filemod_name:*\\BackstageInAppNavCache\\*) AND filemod_name:*.com) OR (process_name:*\\winword.exe AND filemod_name:*\\AppData\\Local\\Temp\\webexdelta\\* AND (filemod_name:*.dll OR filemod_name:*.exe)) OR ((filemod_name:*C:\\Users\\* AND filemod_name:*\\AppData\\Local\\Microsoft\\Office\\* AND filemod_name:*\\WebServiceCache\\AllUsers*) AND filemod_name:*.com))))
