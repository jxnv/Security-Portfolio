# Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.stealth, attack.t1543.003, attack.t1574.011
# Description: Detects the modification of an existing service in order to execute an arbitrary payload when the service is started or killed as a potential method for persistence.
# Converted by: Sigma Universal SIEM/EDR CLI

((((cmdline:*sc * AND cmdline:*config * AND cmdline:*binpath=*)) OR ((cmdline:*sc * AND cmdline:*failure* AND cmdline:*command=*))) OR (((cmdline:*.sh* OR cmdline:*.exe* OR cmdline:*.dll* OR cmdline:*.bin$* OR cmdline:*.bat* OR cmdline:*.cmd* OR cmdline:*.js* OR cmdline:*.msh$* OR cmdline:*.reg$* OR cmdline:*.scr* OR cmdline:*.ps* OR cmdline:*.vb* OR cmdline:*.jar* OR cmdline:*.pl*)) AND (((cmdline:*reg * AND cmdline:*add * AND cmdline:*FailureCommand*)) OR ((cmdline:*reg * AND cmdline:*add * AND cmdline:*ImagePath*)))))
