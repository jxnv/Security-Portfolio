(((process_name:*\\cmd.exe AND (cmdline:* /c* AND cmdline:*dir * AND cmdline:*\\Users\\*)) AND -((cmdline:* rmdir *))) OR (((process_name:*\\net.exe OR process_name:*\\net1.exe) AND cmdline:*user*) AND -(((cmdline:*/domain* OR cmdline:*/add* OR cmdline:*/delete* OR cmdline:*/active* OR cmdline:*/expires* OR cmdline:*/passwordreq* OR cmdline:*/scriptpath* OR cmdline:*/times* OR cmdline:*/workstations*)))) OR ((process_name:*\\cmdkey.exe AND cmdline:* /l*) OR (((process_name:*\\whoami.exe OR process_name:*\\quser.exe OR process_name:*\\qwinsta.exe)) OR ((OriginalFileName:"whoami.exe" OR OriginalFileName:"quser.exe" OR OriginalFileName:"qwinsta.exe"))) OR (process_name:*\\wmic.exe AND (cmdline:*useraccount* AND cmdline:*get*))))
