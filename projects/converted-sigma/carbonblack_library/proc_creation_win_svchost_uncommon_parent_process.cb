# Title: Uncommon Svchost Parent Process
# ID: 01d2e2a1-5f09-44f7-9fc1-24faa7479b6d
# Status: test
# Level: medium
# Author: Florian Roth (Nextron Systems)
# Date: 2017-08-15
# Tags: attack.stealth, attack.t1036.005
# Description: Detects an uncommon svchost parent process
# Converted by: Sigma Universal SIEM/EDR CLI

((process_name:*\\svchost.exe) AND -((((parent_name:*\\Mrt.exe OR parent_name:*\\MsMpEng.exe OR parent_name:*\\ngen.exe OR parent_name:*\\rpcnet.exe OR parent_name:*\\services.exe OR parent_name:*\\TiWorker.exe)) OR ((parent_name:"-" OR parent_name:"")) OR (-parent_name:*))))
