# Tags: attack.execution, attack.t1059
# Description: Detects java process spawning suspicious children
# Converted by: Sigma Universal SIEM/EDR CLI

(parent_name:*/java AND (cmdline:*/bin/sh* OR cmdline:*bash* OR cmdline:*dash* OR cmdline:*ksh* OR cmdline:*zsh* OR cmdline:*csh* OR cmdline:*fish* OR cmdline:*curl* OR cmdline:*wget* OR cmdline:*python*))
