# Title: Potential Persistence Via Notepad++ Plugins
# ID: 54127bd4-f541-4ac3-afdb-ea073f63f692
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-06-10
# Tags: attack.persistence
# Description: Detects creation of new ".dll" files inside the plugins directory of a notepad++ installation by a process other than "gup.exe". Which could indicates possible persistence
# Converted by: Sigma Universal SIEM/EDR CLI

((filemod_name:*\\Notepad++\\plugins\\* AND filemod_name:*.dll) AND -(((process_name:*\\Notepad++\\updater\\gup.exe) OR (process_name:C:\\Users\\* AND process_name:*\\AppData\\Local\\Temp\\* AND (process_name:*\\target.exe OR process_name:*Installer.x64.exe)) OR (process_name:*\\npp.* AND process_name:*.exe AND (filemod_name:"C:\\Program Files\\Notepad++\\plugins\\NppExport\\NppExport.dll" OR filemod_name:"C:\\Program Files\\Notepad++\\plugins\\mimeTools\\mimeTools.dll" OR filemod_name:"C:\\Program Files\\Notepad++\\plugins\\NppConverter\\NppConverter.dll" OR filemod_name:"C:\\Program Files\\Notepad++\\plugins\\Config\\nppPluginList.dll")))))
