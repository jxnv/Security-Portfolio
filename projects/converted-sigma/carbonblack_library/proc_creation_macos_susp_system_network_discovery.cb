# Tags: attack.discovery, attack.t1016
# Description: Detects enumeration of local network configuration
# Converted by: Sigma Universal SIEM/EDR CLI

((((process_name:*/arp OR process_name:*/ifconfig OR process_name:*/netstat OR process_name:*/networksetup OR process_name:*/socketfilterfw)) OR (process_name:"/usr/bin/defaults" AND (cmdline:*/Library/Preferences/com.apple.alf* AND cmdline:*read*))) AND -((parent_name:*/wifivelocityd)))
