# Title: Potentially Suspicious Child Process Of Regsvr32
# ID: 6f0947a4-1c5e-4e0d-8ac7-53159b8f23ca
# Status: test
# Level: high
# Author: elhoim, Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-05-05
# Tags: attack.stealth, attack.t1218.010
# Description: Detects potentially suspicious child processes of "regsvr32.exe".
# Converted by: Sigma Universal SIEM/EDR CLI

((parent_name:*\\regsvr32.exe AND (process_name:*\\calc.exe OR process_name:*\\cscript.exe OR process_name:*\\explorer.exe OR process_name:*\\mshta.exe OR process_name:*\\net.exe OR process_name:*\\net1.exe OR process_name:*\\nltest.exe OR process_name:*\\notepad.exe OR process_name:*\\powershell.exe OR process_name:*\\pwsh.exe OR process_name:*\\reg.exe OR process_name:*\\schtasks.exe OR process_name:*\\werfault.exe OR process_name:*\\wscript.exe)) AND -((process_name:*\\werfault.exe AND cmdline:* -u -p *)))
