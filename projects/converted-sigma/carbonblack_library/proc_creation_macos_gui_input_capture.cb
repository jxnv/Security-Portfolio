# Title: GUI Input Capture - macOS
# ID: 60f1ce20-484e-41bd-85f4-ac4afec2c541
# Status: test
# Level: low
# Author: remotephone, oscd.community
# Date: 2020-10-13
# Tags: attack.collection, attack.credential-access, attack.t1056.002
# Description: Detects attempts to use system dialog prompts to capture user credentials
# Converted by: Sigma Universal SIEM/EDR CLI

(((cmdline:*-e* AND cmdline:*display* AND cmdline:*dialog* AND cmdline:*answer*)) AND ((cmdline:*admin* OR cmdline:*administrator* OR cmdline:*authenticate* OR cmdline:*authentication* OR cmdline:*credentials* OR cmdline:*pass* OR cmdline:*password* OR cmdline:*unlock*)) AND (process_name:*/osascript))
