# Description: Detects persistence via Visual Studio Tools for Office (VSTO) add-ins in Office applications.
# Converted by: Sigma Universal SIEM/EDR CLI

(((TargetObject:*\\Software\\Microsoft\\Office\\Outlook\\Addins\\* OR TargetObject:*\\Software\\Microsoft\\Office\\Word\\Addins\\* OR TargetObject:*\\Software\\Microsoft\\Office\\Excel\\Addins\\* OR TargetObject:*\\Software\\Microsoft\\Office\\Powerpoint\\Addins\\* OR TargetObject:*\\Software\\Microsoft\\VSTO\\Security\\Inclusion\\*)) AND -((((process_name:"C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe" OR process_name:"C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe")) OR ((process_name:C:\\Program Files\\Microsoft Office\\OFFICE* OR process_name:C:\\Program Files (x86)\\Microsoft Office\\OFFICE* OR process_name:C:\\Program Files\\Microsoft Office\\Root\\OFFICE* OR process_name:C:\\Program Files (x86)\\Microsoft Office\\Root\\OFFICE* OR process_name:C:\\PROGRA~2\\MICROS~2\\Office*) AND (process_name:*\\excel.exe OR process_name:*\\Integrator.exe OR process_name:*\\OneNote.exe OR process_name:*\\outlook.exe OR process_name:*\\powerpnt.exe OR process_name:*\\Teams.exe OR process_name:*\\visio.exe OR process_name:*\\winword.exe)) OR ((process_name:C:\\Program Files\\Common Files (x86)\\Microsoft Shared\\ClickToRun\\* OR process_name:C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\*) AND process_name:*\\OfficeClickToRun.exe) OR ((process_name:"C:\\Windows\\System32\\msiexec.exe" OR process_name:"C:\\Windows\\SysWOW64\\msiexec.exe" OR process_name:"C:\\Windows\\System32\\regsvr32.exe" OR process_name:"C:\\Windows\\SysWOW64\\regsvr32.exe")) OR ((process_name:C:\\Program Files\\Common Files\\Microsoft Shared\\VSTO\\* OR process_name:C:\\Program Files (x86)\\Microsoft Shared\\VSTO\\*) AND process_name:*\\VSTOInstaller.exe))) AND -((((process_name:"C:\\Program Files\\Avast Software\\Avast\\RegSvr.exe" OR process_name:"C:\\Program Files (x86)\\Avast Software\\Avast\\RegSvr.exe") AND TargetObject:*\\Microsoft\\Office\\Outlook\\Addins\\Avast.AsOutExt\\*) OR ((process_name:"C:\\Program Files\\AVG\\Antivirus\\RegSvr.exe" OR process_name:"C:\\Program Files (x86)\\AVG\\Antivirus\\RegSvr.exe") AND TargetObject:*\\Microsoft\\Office\\Outlook\\Addins\\Antivirus.AsOutExt\\*))))
