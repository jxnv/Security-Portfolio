# Title: HackTool - CrackMapExec Execution
# ID: 42a993dd-bb3e-48c8-b372-4d6684c4106c
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-02-25
# Tags: attack.execution, attack.persistence, attack.privilege-escalation, attack.credential-access, attack.discovery, attack.t1047, attack.t1053, attack.t1059.003, attack.t1059.001, attack.t1110, attack.t1201
# Description: This rule detect common flag combinations used by CrackMapExec in order to detect its use even if the binary has been replaced.
# Converted by: Sigma Universal SIEM/EDR CLI

(((process_name:*\\crackmapexec.exe) OR ((cmdline:* --local-auth* AND cmdline:* -u * AND cmdline:* -x *)) OR ((cmdline:* --local-auth* AND cmdline:* -u * AND cmdline:* -p * AND cmdline:* -H 'NTHASH'*)) OR ((cmdline:* mssql * AND cmdline:* -u * AND cmdline:* -p * AND cmdline:* -M * AND cmdline:* -d *)) OR ((cmdline:* smb * AND cmdline:* -u * AND cmdline:* -H * AND cmdline:* -M * AND cmdline:* -o *)) OR ((cmdline:* smb * AND cmdline:* -u * AND cmdline:* -p * AND cmdline:* --local-auth*)) OR (cmdline:* -M pe_inject *)) OR (((cmdline:* --local-auth* AND cmdline:* -u * AND cmdline:* -p *)) AND ((cmdline:* 10.* AND cmdline:* 192.168.* AND cmdline:*/24 *))))
