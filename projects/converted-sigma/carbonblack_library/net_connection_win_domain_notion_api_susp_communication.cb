# Title: Potentially Suspicious Network Connection To Notion API
# ID: 7e9cf7b6-e827-11ed-a05b-15959c120003
# Status: test
# Level: low
# Author: Gavin Knapp
# Date: 2023-05-03
# Tags: attack.command-and-control, attack.t1102
# Description: Detects a non-browser process communicating with the Notion API. This could indicate potential use of a covert C2 channel such as "OffensiveNotion C2"
# Converted by: Sigma Universal SIEM/EDR CLI

((DestinationHostname:*api.notion.com*) AND -(((process_name:*\\brave.exe) OR ((process_name:"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR process_name:"C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((process_name:C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*) OR (process_name:*\\WindowsApps\\MicrosoftEdge.exe) OR ((process_name:"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR process_name:"C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process_name:C:\\Program Files (x86)\\Microsoft\\EdgeCore\\* OR process_name:C:\\Program Files\\Microsoft\\EdgeCore\\*) AND (process_name:*\\msedge.exe OR process_name:*\\msedgewebview2.exe)) OR ((process_name:"C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR process_name:"C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR ((process_name:"C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR process_name:"C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process_name:*\\maxthon.exe) OR (process_name:*\\AppData\\Local\\Programs\\Notion\\Notion.exe) OR (process_name:*\\opera.exe) OR (process_name:*\\safari.exe) OR (process_name:*\\seamonkey.exe) OR (process_name:*\\vivaldi.exe) OR (process_name:*\\whale.exe))))
