# Title: Msiexec Quiet Installation
# ID: 79a87aa6-e4bd-42fc-a5bb-5e6fbdcd62f5
# Status: test
# Level: medium
# Author: frack113
# Date: 2022-01-16
# Tags: attack.stealth, attack.t1218.007
# Description: Adversaries may abuse msiexec.exe to proxy execution of malicious payloads.
# Msiexec.exe is the command-line utility for the Windows Installer and is thus commonly associated with executing installation packages (.msi)
# Converted by: Sigma Universal SIEM/EDR CLI

((((cmdline:*-i* OR cmdline:*/i* OR cmdline:*-package* OR cmdline:*/package* OR cmdline:*-a* OR cmdline:*/a* OR cmdline:*-j* OR cmdline:*/j*)) AND ((process_name:*\\msiexec.exe) OR (OriginalFileName:"msiexec.exe")) AND ((cmdline:*-q* OR cmdline:*/q*))) AND -(((parent_name:"C:\\Windows\\CCM\\Ccm32BitLauncher.exe" AND (IntegrityLevel:"System" OR IntegrityLevel:"S-1-16-16384")) OR (parent_name:C:\\Windows\\Temp\\*))) AND -(((parent_name:C:\\Users\\* AND parent_name:*\\AppData\\Local\\Temp\\*) OR (parent_name:*C:\\Windows\\System32\\wsl.exe AND process_name:*C:\\Windows\\System32\\msiexec.exe))))
