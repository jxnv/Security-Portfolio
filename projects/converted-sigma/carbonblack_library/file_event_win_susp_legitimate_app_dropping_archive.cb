# Title: Legitimate Application Dropped Archive
# ID: 654fcc6d-840d-4844-9b07-2c3300e54a26
# Status: test
# Level: high
# Author: frack113, Florian Roth
# Date: 2022-08-21
# Tags: attack.stealth, attack.t1218
# Description: Detects programs on a Windows system that should not write an archive to disk
# Converted by: Sigma Universal SIEM/EDR CLI

((process_name:*\\winword.exe OR process_name:*\\excel.exe OR process_name:*\\powerpnt.exe OR process_name:*\\msaccess.exe OR process_name:*\\mspub.exe OR process_name:*\\eqnedt32.exe OR process_name:*\\visio.exe OR process_name:*\\wordpad.exe OR process_name:*\\wordview.exe OR process_name:*\\certutil.exe OR process_name:*\\certoc.exe OR process_name:*\\CertReq.exe OR process_name:*\\Desktopimgdownldr.exe OR process_name:*\\esentutl.exe OR process_name:*\\finger.exe OR process_name:*\\notepad.exe OR process_name:*\\AcroRd32.exe OR process_name:*\\RdrCEF.exe OR process_name:*\\mshta.exe OR process_name:*\\hh.exe) AND (filemod_name:*.zip OR filemod_name:*.rar OR filemod_name:*.7z OR filemod_name:*.diagcab OR filemod_name:*.appx))
