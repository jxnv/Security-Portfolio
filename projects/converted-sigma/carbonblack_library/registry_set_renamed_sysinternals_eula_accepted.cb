# Title: Usage of Renamed Sysinternals Tools - RegistrySet
# ID: 8023f872-3f1d-4301-a384-801889917ab4
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-08-24
# Tags: attack.resource-development, attack.t1588.002
# Description: Detects non-sysinternals tools setting the "accepteula" key which normally is set on sysinternals tool execution
# Converted by: Sigma Universal SIEM/EDR CLI

(((TargetObject:*\\PsExec* OR TargetObject:*\\ProcDump* OR TargetObject:*\\Handle* OR TargetObject:*\\LiveKd* OR TargetObject:*\\Process Explorer* OR TargetObject:*\\PsLoglist* OR TargetObject:*\\PsPasswd* OR TargetObject:*\\Active Directory Explorer*) AND TargetObject:*\\EulaAccepted) AND -(((process_name:*\\PsExec.exe OR process_name:*\\PsExec64.exe OR process_name:*\\PsExec64a.exe OR process_name:*\\procdump.exe OR process_name:*\\procdump64.exe OR process_name:*\\procdump64a.exe OR process_name:*\\handle.exe OR process_name:*\\handle64.exe OR process_name:*\\handle64a.exe OR process_name:*\\livekd.exe OR process_name:*\\livekd64.exe OR process_name:*\\procexp.exe OR process_name:*\\procexp64.exe OR process_name:*\\procexp64a.exe OR process_name:*\\psloglist.exe OR process_name:*\\psloglist64.exe OR process_name:*\\psloglist64a.exe OR process_name:*\\pspasswd.exe OR process_name:*\\pspasswd64.exe OR process_name:*\\pspasswd64a.exe OR process_name:*\\ADExplorer.exe OR process_name:*\\ADExplorer64.exe OR process_name:*\\ADExplorer64a.exe))) AND -((-process_name:*)))
