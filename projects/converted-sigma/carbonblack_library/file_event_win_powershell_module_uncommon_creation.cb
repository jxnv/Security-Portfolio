# Title: PowerShell Module File Created By Non-PowerShell Process
# ID: e3845023-ca9a-4024-b2b2-5422156d5527
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-05-09
# Tags: attack.persistence
# Description: Detects the creation of a new PowerShell module ".psm1", ".psd1", ".dll", ".ps1", etc. by a non-PowerShell process
# Converted by: Sigma Universal SIEM/EDR CLI

(((filemod_name:*\\WindowsPowerShell\\Modules\\* OR filemod_name:*\\PowerShell\\7\\Modules\\*)) AND -((((process_name:"C:\\Windows\\System32\\msiexec.exe" OR process_name:"C:\\Windows\\SysWOW64\\msiexec.exe")) OR ((process_name:*:\\Program Files\\PowerShell\\7-preview\\pwsh.exe OR process_name:*:\\Program Files\\PowerShell\\7\\pwsh.exe OR process_name:*:\\Windows\\System32\\poqexec.exe OR process_name:*:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe OR process_name:*:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe OR process_name:*:\\Windows\\SysWOW64\\poqexec.exe OR process_name:*:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe OR process_name:*:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe)))))
