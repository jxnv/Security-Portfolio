# Title: Suspicious Processes Spawned by Java.EXE
# ID: 0d34ed8b-1c12-4ff2-828c-16fc860b766d
# Status: test
# Level: high
# Author: Andreas Hunkeler (@Karneades), Florian Roth
# Date: 2021-12-17
# Tags: attack.initial-access, attack.persistence, attack.privilege-escalation
# Description: Detects suspicious processes spawned from a Java host process which could indicate a sign of exploitation (e.g. log4j)
# Converted by: Sigma Universal SIEM/EDR CLI

(parent_name:*\\java.exe AND (process_name:*\\AppVLP.exe OR process_name:*\\bitsadmin.exe OR process_name:*\\certutil.exe OR process_name:*\\cscript.exe OR process_name:*\\curl.exe OR process_name:*\\forfiles.exe OR process_name:*\\hh.exe OR process_name:*\\mftrace.exe OR process_name:*\\mshta.exe OR process_name:*\\net.exe OR process_name:*\\net1.exe OR process_name:*\\query.exe OR process_name:*\\reg.exe OR process_name:*\\regsvr32.exe OR process_name:*\\rundll32.exe OR process_name:*\\schtasks.exe OR process_name:*\\scrcons.exe OR process_name:*\\scriptrunner.exe OR process_name:*\\sh.exe OR process_name:*\\systeminfo.exe OR process_name:*\\whoami.exe OR process_name:*\\wmic.exe OR process_name:*\\wscript.exe))
