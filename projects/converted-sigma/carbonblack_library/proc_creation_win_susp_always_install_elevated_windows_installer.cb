# Title: Always Install Elevated Windows Installer
# ID: cd951fdc-4b2f-47f5-ba99-a33bf61e3770
# Status: test
# Level: medium
# Author: Teymur Kheirkhabarov (idea), Mangatas Tondang (rule), oscd.community
# Date: 2020-10-13
# Tags: attack.privilege-escalation, attack.t1548.002
# Description: Detects Windows Installer service (msiexec.exe) trying to install MSI packages with SYSTEM privilege
# Converted by: Sigma Universal SIEM/EDR CLI

((((process_name:*\\Windows\\Installer\\* AND process_name:*msi*) AND process_name:*tmp) OR (process_name:*\\msiexec.exe AND (IntegrityLevel:"System" OR IntegrityLevel:"S-1-16-16384"))) AND ((username:*AUTHORI* OR username:*AUTORI*)) AND -((((parent_name:C:\\Program Files\\Avast Software\\* OR parent_name:C:\\Program Files (x86)\\Avast Software\\*)) OR (parent_name:C:\\ProgramData\\Avira\\*) OR ((parent_name:C:\\Program Files\\Google\\Update\\* OR parent_name:C:\\Program Files (x86)\\Google\\Update\\*)) OR (parent_name:"C:\\Windows\\System32\\services.exe") OR ((cmdline:*\\system32\\msiexec.exe /V) OR (ParentCommandLine:*\\system32\\msiexec.exe /V)) OR (parent_name:C:\\ProgramData\\Sophos\\*))))
