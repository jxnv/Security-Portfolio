# Title: Operator Bloopers Cobalt Strike Commands
# ID: 647c7b9e-d784-4fda-b9a0-45c565a7b729
# Status: test
# Level: high
# Author: _pete_0, TheDFIRReport
# Date: 2022-05-06
# Tags: attack.execution, attack.t1059.003, stp.1u
# Description: Detects use of Cobalt Strike commands accidentally entered in the CMD shell
# Converted by: Sigma Universal SIEM/EDR CLI

(((cmdline:cmd * OR cmdline:cmd.exe* OR cmdline:c:\\windows\\system32\\cmd.exe*) AND (cmdline:*psinject* OR cmdline:*spawnas* OR cmdline:*make_token* OR cmdline:*remote-exec* OR cmdline:*rev2self* OR cmdline:*dcsync* OR cmdline:*logonpasswords* OR cmdline:*execute-assembly* OR cmdline:*getsystem*)) AND ((OriginalFileName:"Cmd.Exe") OR (process_name:*\\cmd.exe)))
