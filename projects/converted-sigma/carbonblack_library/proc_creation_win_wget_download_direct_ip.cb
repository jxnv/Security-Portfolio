# Title: Suspicious File Download From IP Via Wget.EXE
# ID: 17f0c0a8-8bd5-4ee0-8c5f-a342c0199f35
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-07-27
# Tags: attack.execution
# Description: Detects potentially suspicious file downloads directly from IP addresses using Wget.exe
# Converted by: Sigma Universal SIEM/EDR CLI

(((cmdline:*.ps1 OR cmdline:*.ps1' OR cmdline:*.ps1\" OR cmdline:*.dat OR cmdline:*.dat' OR cmdline:*.dat\" OR cmdline:*.msi OR cmdline:*.msi' OR cmdline:*.msi\" OR cmdline:*.bat OR cmdline:*.bat' OR cmdline:*.bat\" OR cmdline:*.exe OR cmdline:*.exe' OR cmdline:*.exe\" OR cmdline:*.vbs OR cmdline:*.vbs' OR cmdline:*.vbs\" OR cmdline:*.vbe OR cmdline:*.vbe' OR cmdline:*.vbe\" OR cmdline:*.hta OR cmdline:*.hta' OR cmdline:*.hta\" OR cmdline:*.dll OR cmdline:*.dll' OR cmdline:*.dll\" OR cmdline:*.psm1 OR cmdline:*.psm1' OR cmdline:*.psm1\")) AND ((cmdline=regex("\\s-O\\s")) OR (cmdline:*--output-document*)) AND (cmdline:*http*) AND ((process_name:*\\wget.exe) OR (OriginalFileName:"wget.exe")) AND (cmdline=regex("://[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}")))
