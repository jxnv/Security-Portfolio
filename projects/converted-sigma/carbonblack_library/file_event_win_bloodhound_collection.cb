# Tags: attack.discovery, attack.t1087.001, attack.t1087.002, attack.t1482, attack.t1069.001, attack.t1069.002, attack.execution, attack.t1059.001
# Description: Detects default file names outputted by the BloodHound collection tool SharpHound
# Converted by: Sigma Universal SIEM/EDR CLI

(((filemod_name:*BloodHound.zip OR filemod_name:*_computers.json OR filemod_name:*_containers.json OR filemod_name:*_gpos.json OR filemod_name:*_groups.json OR filemod_name:*_ous.json OR filemod_name:*_users.json)) AND -((process_name:*\\svchost.exe AND filemod_name:C:\\Program Files\\WindowsApps\\Microsoft.* AND filemod_name:*\\pocket_containers.json)))
