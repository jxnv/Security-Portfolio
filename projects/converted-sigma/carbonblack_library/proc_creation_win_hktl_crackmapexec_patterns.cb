# Title: HackTool - CrackMapExec Process Patterns
# ID: f26307d8-14cd-47e3-a26b-4b4769f24af6
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-03-12
# Tags: attack.credential-access, attack.t1003.001
# Description: Detects suspicious process patterns found in logs when CrackMapExec is used
# Converted by: Sigma Universal SIEM/EDR CLI

(((cmdline:*tasklist /fi * AND cmdline:*Imagename eq lsass.exe*) AND (cmdline:*cmd.exe /c * OR cmdline:*cmd.exe /r * OR cmdline:*cmd.exe /k * OR cmdline:*cmd /c * OR cmdline:*cmd /r * OR cmdline:*cmd /k *) AND (username:*AUTHORI* OR username:*AUTORI*)) OR ((cmdline:*do rundll32.exe C:\\windows\\System32\\comsvcs.dll, MiniDump* AND cmdline:*\\Windows\\Temp\\* AND cmdline:* full* AND cmdline:*%%B*)) OR ((cmdline:*tasklist /v /fo csv* AND cmdline:*findstr /i \"lsass\"*)))
