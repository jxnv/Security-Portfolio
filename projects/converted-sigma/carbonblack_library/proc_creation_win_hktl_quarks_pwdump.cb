# Tags: attack.credential-access, attack.t1003.002
# Description: Detects usage of the Quarks PwDump tool via commandline arguments
# Converted by: Sigma Universal SIEM/EDR CLI

(((cmdline:" -dhl" OR cmdline:" --dump-hash-local" OR cmdline:" -dhdc" OR cmdline:" --dump-hash-domain-cached" OR cmdline:" --dump-bitlocker" OR cmdline:" -dhd " OR cmdline:" --dump-hash-domain " OR cmdline:"--ntds-file")) OR (process_name:*\\QuarksPwDump.exe))
