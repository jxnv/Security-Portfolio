# Title: Potential Remote PowerShell Session Initiated
# ID: c539afac-c12a-46ed-b1bd-5a5567c9f045
# Status: test
# Level: high
# Author: Roberto Rodriguez @Cyb3rWard0g
# Date: 2019-09-12
# Tags: attack.execution, attack.t1059.001, attack.lateral-movement, attack.t1021.006
# Description: Detects a process that initiated a network connection over ports 5985 or 5986 from a non-network service account.
# This could potentially indicates a remote PowerShell connection.
# Converted by: Sigma Universal SIEM/EDR CLI

(((DestinationPort:"5985" OR DestinationPort:"5986") AND Initiated:"true" AND SourceIsIpv6:"false") AND -((((SourceIp:"::1" OR SourceIp:"127.0.0.1") AND (DestinationIp:"::1" OR DestinationIp:"127.0.0.1")) OR (((username:*NETWORK SERVICE* OR username:*NETZWERKDIENST* OR username:*SERVICIO DE RED* OR username:*SERVIZIO DI RETE*)) OR ((username:*SERVICE R* AND username:*SEAU*))))) AND -(((process_name:"C:\\Program Files\\Avast Software\\Avast\\AvastSvc.exe" OR process_name:"C:\\Program Files (x86)\\Avast Software\\Avast\\AvastSvc.exe"))))
