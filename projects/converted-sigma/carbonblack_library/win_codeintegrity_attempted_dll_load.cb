# Title: CodeIntegrity - Unmet Signing Level Requirements By File Under Validation
# ID: f8931561-97f5-4c46-907f-0a4a592e47a7
# Status: experimental
# Level: low
# Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-01-20
# Tags: attack.execution
# Description: Detects attempted file load events that did not meet the signing level requirements. It often means the file's signature is revoked or a signature with the Lifetime Signing EKU has expired.
# This event is best correlated with EID 3089 to determine the error of the validation.
# Converted by: Sigma Universal SIEM/EDR CLI

(((EventID:"3033" OR EventID:"3034")) AND -((FileNameBuffer:*\\Windows\\assembly\\GAC\\* AND ProcessNameBuffer:*\\mscorsvw.exe AND ProcessNameBuffer:*\\Windows\\Microsoft.NET\\* AND RequestedPolicy:"8")) AND -(((FileNameBuffer:*\\Windows\\System32\\DriverStore\\FileRepository\\* AND FileNameBuffer:*\\igd10iumd64.dll AND RequestedPolicy:"7") OR ((FileNameBuffer:*\\Program Files\\Avast Software\\Avast\\aswAMSI.dll OR FileNameBuffer:*\\Program Files (x86)\\Avast Software\\Avast\\aswAMSI.dll) AND (RequestedPolicy:"8" OR RequestedPolicy:"12")) OR (FileNameBuffer:*\\Program Files\\Bonjour\\mdnsNSP.dll AND (ProcessNameBuffer:*\\Windows\\System32\\svchost.exe OR ProcessNameBuffer:*\\Windows\\System32\\SIHClient.exe) AND (RequestedPolicy:"8" OR RequestedPolicy:"12")) OR (FileNameBuffer:*\\Program Files\\comodo\\comodo internet security\\amsiprovider_x64.dll) OR (FileNameBuffer:*\\Program Files\\DTrace\\dtrace.dll AND ProcessNameBuffer:*\\Windows\\System32\\svchost.exe AND RequestedPolicy:"12") OR (FileNameBuffer:*\\Windows\\System32\\nvspcap64.dll AND (ProcessNameBuffer:*\\AppData\\Local\\Keybase\\Gui\\Keybase.exe OR ProcessNameBuffer:*\\Microsoft\\Teams\\stage\\Teams.exe) AND RequestedPolicy:"8") OR (FileNameBuffer:*\\Program Files\\ESET\\ESET Security\\eamsi.dll) OR ((FileNameBuffer:*\\Mozilla Firefox\\mozavcodec.dll OR FileNameBuffer:*\\Mozilla Firefox\\mozavutil.dll) AND ProcessNameBuffer:*\\Mozilla Firefox\\firefox.exe AND RequestedPolicy:"8") OR (FileNameBuffer:*\\Program Files\\Google\\Drive File Stream\\* AND FileNameBuffer:*\\crashpad_handler.exe AND ProcessNameBuffer:*\\Windows\\ImmersiveControlPanel\\SystemSettings.exe AND RequestedPolicy:"8") OR (((ProcessNameBuffer:*\\Kaspersky Lab\\* AND ProcessNameBuffer:*\\avp.exe*)) OR ((FileNameBuffer:*\\Kaspersky Lab\\* AND FileNameBuffer:*\\antimalware_provider.dll*))) OR ((FileNameBuffer:*\\Program Files\\McAfee\\Endpoint Security\\Threat Prevention\\MfeAmsiProvider.dll OR FileNameBuffer:*\\Program Files\\McAfee\\MfeAV\\AMSIExt.dll)) OR (FileNameBuffer:*\\Program Files\\National Instruments\\Shared\\mDNS Responder\\nimdnsNSP.dll ) OR (FileNameBuffer:*\\Microsoft Office\\root\\vfs\\ProgramFilesCommonX64\\Microsoft Shared\\OFFICE* AND FileNameBuffer:*\\MSOXMLMF.DLL AND RequestedPolicy:"7") OR (ProcessNameBuffer:*\\Program Files\\Microsoft Office\\root\\vfs\\ProgramFilesCommonX64\\Microsoft Shared\\Office* AND FileNameBuffer:*\\Windows\\System32\\* AND RequestedPolicy:"8") OR (FileNameBuffer:*\\National Instruments\\Shared\\mDNS Responder\\*) OR ((FileNameBuffer:*\\Program Files\\SentinelOne\\Sentinel Agent*) OR (ProcessNameBuffer:*\\Program Files\\SentinelOne\\Sentinel Agent*)) OR (FileNameBuffer:*\\Windows\\System32\\nvspcap64.dll AND ProcessNameBuffer:*\\AppData\\Local\\slack\\app-* AND ProcessNameBuffer:*\\slack.exe AND RequestedPolicy:"8") OR (FileNameBuffer:*\\Trend Micro\\Client Server Security Agent\\perficrcperfmonmgr.dll AND RequestedPolicy:"8"))))
