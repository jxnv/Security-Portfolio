# Title: Windows Firewall Disabled via PowerShell
# ID: 12f6b752-042d-483e-bf9c-915a6d06ad75
# Status: test
# Level: medium
# Author: Tim Rauch, Elastic (idea)
# Date: 2022-09-14
# Tags: attack.defense-impairment, attack.t1685
# Description: Detects attempts to disable the Windows Firewall using PowerShell
# Converted by: Sigma Universal SIEM/EDR CLI

(((cmdline:*Set-NetFirewallProfile * AND cmdline:* -Enabled * AND cmdline:* False*)) AND (((process_name:*\\powershell.exe OR process_name:*\\pwsh.exe OR process_name:*\\powershell_ise.exe)) OR ((OriginalFileName:"PowerShell.EXE" OR OriginalFileName:"pwsh.dll"))) AND ((cmdline:* -All * OR cmdline:*Public* OR cmdline:*Domain* OR cmdline:*Private*)))
