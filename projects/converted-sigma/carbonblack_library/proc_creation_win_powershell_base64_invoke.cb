# Title: PowerShell Base64 Encoded Invoke Keyword
# ID: 6385697e-9f1b-40bd-8817-f4a91f40508e
# Status: test
# Level: high
# Author: pH-T (Nextron Systems), Harjot Singh, @cyb3rjy0t
# Date: 2022-05-20
# Tags: attack.execution, attack.stealth, attack.t1059.001, attack.t1027
# Description: Detects UTF-8 and UTF-16 Base64 encoded powershell 'Invoke-' calls
# Converted by: Sigma Universal SIEM/EDR CLI

((cmdline:* -e*) AND ((cmdline:*SQBuAHYAbwBrAGUALQ* OR cmdline:*kAbgB2AG8AawBlAC0A* OR cmdline:*JAG4AdgBvAGsAZQAtA* OR cmdline:*SW52b2tlL* OR cmdline:*ludm9rZS* OR cmdline:*JbnZva2Ut*)) AND (((process_name:*\\powershell.exe OR process_name:*\\pwsh.exe)) OR ((OriginalFileName:"PowerShell.EXE" OR OriginalFileName:"pwsh.dll"))))
