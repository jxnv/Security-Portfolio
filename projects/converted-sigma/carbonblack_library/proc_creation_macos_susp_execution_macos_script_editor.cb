# Title: Suspicious Execution via macOS Script Editor
# ID: 6e4dcdd1-e48b-42f7-b2d8-3b413fc58cb4
# Status: test
# Level: medium
# Author: Tim Rauch (rule), Elastic (idea)
# Date: 2022-10-21
# Tags: attack.defense-impairment, attack.t1566, attack.t1566.002, attack.initial-access, attack.t1059, attack.t1059.002, attack.t1204, attack.t1204.001, attack.execution, attack.persistence, attack.t1553
# Description: Detects when the macOS Script Editor utility spawns an unusual child process.
# Converted by: Sigma Universal SIEM/EDR CLI

((((process_name:*/curl OR process_name:*/bash OR process_name:*/sh OR process_name:*/zsh OR process_name:*/dash OR process_name:*/fish OR process_name:*/osascript OR process_name:*/mktemp OR process_name:*/chmod OR process_name:*/php OR process_name:*/nohup OR process_name:*/openssl OR process_name:*/plutil OR process_name:*/PlistBuddy OR process_name:*/xattr OR process_name:*/sqlite OR process_name:*/funzip OR process_name:*/popen)) OR ((process_name:*python* OR process_name:*perl*))) AND (parent_name:*/Script Editor))
