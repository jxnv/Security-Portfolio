# Title: Private Keys Reconnaissance Via CommandLine Tools
# ID: 213d6a77-3d55-4ce8-ba74-fcfef741974e
# Status: test
# Level: medium
# Author: frack113, Nasreddine Bencherchali (Nextron Systems)
# Date: 2021-07-20
# Tags: attack.credential-access, attack.t1552.004
# Description: Adversaries may search for private key certificate files on compromised systems for insecurely stored credential
# Converted by: Sigma Universal SIEM/EDR CLI

(((cmdline:*.key* OR cmdline:*.pgp* OR cmdline:*.gpg* OR cmdline:*.ppk* OR cmdline:*.p12* OR cmdline:*.pem* OR cmdline:*.pfx* OR cmdline:*.cer* OR cmdline:*.p7b* OR cmdline:*.asc*)) AND (((cmdline:*dir *) AND ((process_name:*\\cmd.exe) OR (OriginalFileName:"Cmd.Exe"))) OR ((cmdline:*Get-ChildItem *) AND (((process_name:*\\powershell.exe OR process_name:*\\pwsh.exe)) OR ((OriginalFileName:"PowerShell.EXE" OR OriginalFileName:"pwsh.dll")))) OR ((process_name:*\\findstr.exe) OR (OriginalFileName:"FINDSTR.EXE"))))
