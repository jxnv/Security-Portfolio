((((parent_name:*\\java.exe OR parent_name:*\\javaw.exe) AND (parent_name:*-tomcat-* OR parent_name:*\\tomcat*)) OR ((parent_name:*\\java.exe OR parent_name:*\\javaw.exe) AND (cmdline:*catalina.jar* OR cmdline:*CATALINA_HOME*)) OR ((parent_name:*\\w3wp.exe OR parent_name:*\\php-cgi.exe OR parent_name:*\\nginx.exe OR parent_name:*\\httpd.exe OR parent_name:*\\caddy.exe OR parent_name:*\\ws_tomcatservice.exe))) AND (((cmdline:*&cd&echo* OR cmdline:*cd /d *)) OR (((process_name:*\\dsquery.exe OR process_name:*\\find.exe OR process_name:*\\findstr.exe OR process_name:*\\ipconfig.exe OR process_name:*\\netstat.exe OR process_name:*\\nslookup.exe OR process_name:*\\pathping.exe OR process_name:*\\quser.exe OR process_name:*\\schtasks.exe OR process_name:*\\systeminfo.exe OR process_name:*\\tasklist.exe OR process_name:*\\tracert.exe OR process_name:*\\wevtutil.exe OR process_name:*\\whoami.exe)) OR ((OriginalFileName:"dsquery.exe" OR OriginalFileName:"find.exe" OR OriginalFileName:"findstr.exe" OR OriginalFileName:"ipconfig.exe" OR OriginalFileName:"netstat.exe" OR OriginalFileName:"nslookup.exe" OR OriginalFileName:"pathping.exe" OR OriginalFileName:"quser.exe" OR OriginalFileName:"schtasks.exe" OR OriginalFileName:"sysinfo.exe" OR OriginalFileName:"tasklist.exe" OR OriginalFileName:"tracert.exe" OR OriginalFileName:"VSSADMIN.EXE" OR OriginalFileName:"wevtutil.exe" OR OriginalFileName:"whoami.exe"))) OR ((cmdline:* Test-NetConnection * OR cmdline:*dir \\*)) OR ((OriginalFileName:"net.exe" OR OriginalFileName:"net1.exe") AND (cmdline:* user * OR cmdline:* use * OR cmdline:* group *)) OR (OriginalFileName:"ping.exe" AND cmdline:* -n *) OR ((process_name:*\\cmd.exe OR process_name:*\\powershell.exe OR process_name:*\\pwsh.exe) AND (cmdline:* -enc * OR cmdline:* -EncodedCommand * OR cmdline:* -w hidden * OR cmdline:* -windowstyle hidden* OR cmdline:*.WebClient).Download*)) OR (OriginalFileName:"wmic.exe" AND cmdline:* /node:*)))
