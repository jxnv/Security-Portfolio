# Title: Schtasks Creation Or Modification With SYSTEM Privileges
# ID: 89ca78fd-b37c-4310-b3d3-81a023f83936
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-07-28
# Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053.005
# Description: Detects the creation or update of a scheduled task to run with "NT AUTHORITY\SYSTEM" privileges
# Converted by: Sigma Universal SIEM/EDR CLI

(((process_name:*\\schtasks.exe AND (cmdline:* /change * OR cmdline:* /create *)) AND (cmdline:*/ru *) AND ((cmdline:*NT AUT* OR cmdline:* SYSTEM *))) AND -((((cmdline:*/Create /F /RU System /SC WEEKLY /TN AviraSystemSpeedupVerify /TR * OR cmdline:*:\\Program Files (x86)\\Avira\\System Speedup\\setup\\avira_speedup_setup.exe* OR cmdline:*/VERIFY /VERYSILENT /NOSTART /NODOTNET /NORESTART\" /RL HIGHEST*)) OR ((cmdline:*Subscription Heartbeat* AND cmdline:*\\HeartbeatConfig.xml* AND cmdline:*\\Microsoft Shared\\OFFICE*)) OR (process_name:*\\schtasks.exe AND (cmdline:*/TN TVInstallRestore* AND cmdline:*\\TeamViewer_.exe*)))))
