# Title: Potentially Suspicious Volume Shadow Copy Vsstrace.dll Load
# ID: 48bfd177-7cf2-412b-ad77-baf923489e82
# Status: test
# Level: medium
# Author: frack113
# Date: 2023-02-17
# Tags: attack.impact, attack.t1490
# Description: Detects the image load of VSS DLL by uncommon executables
# Converted by: Sigma Universal SIEM/EDR CLI

((ImageLoaded:*\\vsstrace.dll) AND -(((-process_name:*) OR ((process_name:C:\\Program Files\\* OR process_name:C:\\Program Files (x86)\\*)) OR (((process_name:"C:\\Windows\\explorer.exe" OR process_name:"C:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe" OR process_name:"C:\\Windows\\servicing\\TrustedInstaller.exe")) OR ((process_name:C:\\Windows\\System32\\* OR process_name:C:\\Windows\\SysWOW64\\* OR process_name:C:\\Windows\\Temp\\{* OR process_name:C:\\Windows\\WinSxS\\* OR process_name:C:\\ProgramData\\Package Cache\\{*))))) AND -((((process_name:*\\temp\\is-* AND process_name:*\\avira_system_speedup.tmp*)) OR (process_name:C:\\$WinREAgent\\Scratch\\*))))
