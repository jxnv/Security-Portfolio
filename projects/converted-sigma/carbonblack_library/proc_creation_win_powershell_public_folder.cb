# Title: Execution of Powershell Script in Public Folder
# ID: fb9d3ff7-7348-46ab-af8c-b55f5fbf39b4
# Status: test
# Level: high
# Author: Max Altgelt (Nextron Systems)
# Date: 2022-04-06
# Tags: attack.execution, attack.t1059.001
# Description: This rule detects execution of PowerShell scripts located in the "C:\Users\Public" folder
# Converted by: Sigma Universal SIEM/EDR CLI

((process_name:*\\powershell.exe OR process_name:*\\pwsh.exe) AND (cmdline:*-f C:\\Users\\Public* OR cmdline:*-f \"C:\\Users\\Public* OR cmdline:*-f %Public%* OR cmdline:*-fi C:\\Users\\Public* OR cmdline:*-fi \"C:\\Users\\Public* OR cmdline:*-fi %Public%* OR cmdline:*-fil C:\\Users\\Public* OR cmdline:*-fil \"C:\\Users\\Public* OR cmdline:*-fil %Public%* OR cmdline:*-file C:\\Users\\Public* OR cmdline:*-file \"C:\\Users\\Public* OR cmdline:*-file %Public%*))
