# Title: Suspicious Program Location Whitelisted In Firewall Via Netsh.EXE
# ID: a35f5a72-f347-4e36-8895-9869b0d5fc6d
# Status: test
# Level: high
# Author: Sander Wiebing, Jonhnathan Ribeiro, Daniil Yugoslavskiy, oscd.community
# Date: 2020-05-25
# Tags: attack.defense-impairment, attack.t1686.003
# Description: Detects Netsh command execution that whitelists a program located in a suspicious location in the Windows Firewall
# Converted by: Sigma Universal SIEM/EDR CLI

((((cmdline:*firewall* AND cmdline:*add* AND cmdline:*allowedprogram*)) OR ((cmdline:*advfirewall* AND cmdline:*firewall* AND cmdline:*add* AND cmdline:*rule* AND cmdline:*action=allow* AND cmdline:*program=*))) AND ((process_name:*\\netsh.exe) OR (OriginalFileName:"netsh.exe")) AND ((cmdline:*:\\$Recycle.bin\\* OR cmdline:*:\\RECYCLER.BIN\\* OR cmdline:*:\\RECYCLERS.BIN\\* OR cmdline:*:\\SystemVolumeInformation\\* OR cmdline:*:\\Temp\\* OR cmdline:*:\\Users\\Default\\* OR cmdline:*:\\Users\\Desktop\\* OR cmdline:*:\\Users\\Public\\* OR cmdline:*:\\Windows\\addins\\* OR cmdline:*:\\Windows\\cursors\\* OR cmdline:*:\\Windows\\debug\\* OR cmdline:*:\\Windows\\drivers\\* OR cmdline:*:\\Windows\\fonts\\* OR cmdline:*:\\Windows\\help\\* OR cmdline:*:\\Windows\\system32\\tasks\\* OR cmdline:*:\\Windows\\Tasks\\* OR cmdline:*:\\Windows\\Temp\\* OR cmdline:*\\Downloads\\* OR cmdline:*\\Local Settings\\Temporary Internet Files\\* OR cmdline:*\\Temporary Internet Files\\Content.Outlook\\* OR cmdline:*%Public%\\* OR cmdline:*%TEMP%* OR cmdline:*%TMP%*)))
