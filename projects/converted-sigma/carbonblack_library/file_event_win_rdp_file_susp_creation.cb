# Title: .RDP File Created By Uncommon Application
# ID: fccfb43e-09a7-4bd2-8b37-a5a7df33386d
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-04-18
# Tags: attack.stealth
# Description: Detects creation of a file with an ".rdp" extension by an application that doesn't commonly create such files.
# Converted by: Sigma Universal SIEM/EDR CLI

(filemod_name:*.rdp AND (process_name:*\\brave.exe OR process_name:*\\CCleaner Browser\\Application\\CCleanerBrowser.exe OR process_name:*\\chromium.exe OR process_name:*\\firefox.exe OR process_name:*\\Google\\Chrome\\Application\\chrome.exe OR process_name:*\\iexplore.exe OR process_name:*\\microsoftedge.exe OR process_name:*\\msedge.exe OR process_name:*\\Opera.exe OR process_name:*\\Vivaldi.exe OR process_name:*\\Whale.exe OR process_name:*\\olk.exe OR process_name:*\\Outlook.exe OR process_name:*\\RuntimeBroker.exe OR process_name:*\\Thunderbird.exe OR process_name:*\\Discord.exe OR process_name:*\\Keybase.exe OR process_name:*\\msteams.exe OR process_name:*\\Slack.exe OR process_name:*\\teams.exe))
