# Title: Suspicious Msbuild Execution By Uncommon Parent Process
# ID: 33be4333-2c6b-44f4-ae28-102cdbde0a31
# Status: test
# Level: medium
# Author: frack113
# Date: 2022-11-17
# Tags: attack.stealth
# Description: Detects suspicious execution of 'Msbuild.exe' by a uncommon parent process
# Converted by: Sigma Universal SIEM/EDR CLI

(((process_name:*\\MSBuild.exe) OR (OriginalFileName:"MSBuild.exe")) AND -(((parent_name:*\\devenv.exe OR parent_name:*\\cmd.exe OR parent_name:*\\msbuild.exe OR parent_name:*\\python.exe OR parent_name:*\\explorer.exe OR parent_name:*\\nuget.exe))))
