// Title: HackTool - Quarks PwDump Execution
// ID: 0685b176-c816-4837-8e7b-1216f346636b
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-05
// Tags: attack.credential-access, attack.t1003.002
// Description: Detects usage of the Quarks PwDump tool via commandline arguments
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine EQUALS " -dhl" OR CommandLine EQUALS " --dump-hash-local" OR CommandLine EQUALS " -dhdc" OR CommandLine EQUALS " --dump-hash-domain-cached" OR CommandLine EQUALS " --dump-bitlocker" OR CommandLine EQUALS " -dhd " OR CommandLine EQUALS " --dump-hash-domain " OR CommandLine EQUALS "--ntds-file")) OR (Image="*\\QuarksPwDump.exe"))
