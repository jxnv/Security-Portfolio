// Title: Potential Remote PowerShell Session Initiated
// ID: c539afac-c12a-46ed-b1bd-5a5567c9f045
// Status: test
// Level: high
// Author: Roberto Rodriguez @Cyb3rWard0g
// Date: 2019-09-12
// Tags: attack.execution, attack.t1059.001, attack.lateral-movement, attack.t1021.006
// Description: Detects a process that initiated a network connection over ports 5985 or 5986 from a non-network service account.
// This could potentially indicates a remote PowerShell connection.
// Converted by: Sigma Universal SIEM/EDR CLI

(((DestinationPort EQUALS "5985" OR DestinationPort EQUALS "5986") AND Initiated EQUALS "true" AND SourceIsIpv6 EQUALS "false") AND NOT ((((SourceIp EQUALS "::1" OR SourceIp EQUALS "127.0.0.1") AND (DestinationIp EQUALS "::1" OR DestinationIp EQUALS "127.0.0.1")) OR (((User CONTAINS "NETWORK SERVICE" OR User CONTAINS "NETZWERKDIENST" OR User CONTAINS "SERVICIO DE RED" OR User CONTAINS "SERVIZIO DI RETE")) OR ((User CONTAINS "SERVICE R" AND User CONTAINS "SEAU"))))) AND NOT (((Image EQUALS "C:\\Program Files\\Avast Software\\Avast\\AvastSvc.exe" OR Image EQUALS "C:\\Program Files (x86)\\Avast Software\\Avast\\AvastSvc.exe"))))
