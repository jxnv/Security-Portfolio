// Title: Potentially Suspicious Network Connection To Notion API
// ID: 7e9cf7b6-e827-11ed-a05b-15959c120003
// Status: test
// Level: low
// Author: Gavin Knapp
// Date: 2023-05-03
// Tags: attack.command-and-control, attack.t1102
// Description: Detects a non-browser process communicating with the Notion API. This could indicate potential use of a covert C2 channel such as "OffensiveNotion C2"
// Converted by: Sigma Universal SIEM/EDR CLI

((DestinationHostname CONTAINS "api.notion.com") AND NOT (((Image="*\\brave.exe") OR ((Image EQUALS "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR Image EQUALS "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((Image="C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*") OR (Image="*\\WindowsApps\\MicrosoftEdge.exe") OR ((Image EQUALS "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR Image EQUALS "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((Image="C:\\Program Files (x86)\\Microsoft\\EdgeCore\\*" OR Image="C:\\Program Files\\Microsoft\\EdgeCore\\*") AND (Image="*\\msedge.exe" OR Image="*\\msedgewebview2.exe")) OR ((Image EQUALS "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR Image EQUALS "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR ((Image EQUALS "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR Image EQUALS "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (Image="*\\maxthon.exe") OR (Image="*\\AppData\\Local\\Programs\\Notion\\Notion.exe") OR (Image="*\\opera.exe") OR (Image="*\\safari.exe") OR (Image="*\\seamonkey.exe") OR (Image="*\\vivaldi.exe") OR (Image="*\\whale.exe"))))
