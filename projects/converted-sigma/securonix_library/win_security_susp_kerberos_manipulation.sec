// Title: Kerberos Manipulation
// ID: f7644214-0eb0-4ace-9455-331ec4c09253
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2017-02-10
// Tags: attack.credential-access, attack.t1212
// Description: Detects failed Kerberos TGT issue operation. This can be a sign of manipulations of TGT messages by an attacker.
// Converted by: Sigma Universal SIEM/EDR CLI

((EventID EQUALS "675" OR EventID EQUALS "4768" OR EventID EQUALS "4769" OR EventID EQUALS "4771") AND (Status EQUALS "0x9" OR Status EQUALS "0xA" OR Status EQUALS "0xB" OR Status EQUALS "0xF" OR Status EQUALS "0x10" OR Status EQUALS "0x11" OR Status EQUALS "0x13" OR Status EQUALS "0x14" OR Status EQUALS "0x1A" OR Status EQUALS "0x1F" OR Status EQUALS "0x21" OR Status EQUALS "0x22" OR Status EQUALS "0x23" OR Status EQUALS "0x24" OR Status EQUALS "0x26" OR Status EQUALS "0x27" OR Status EQUALS "0x28" OR Status EQUALS "0x29" OR Status EQUALS "0x2C" OR Status EQUALS "0x2D" OR Status EQUALS "0x2E" OR Status EQUALS "0x2F" OR Status EQUALS "0x31" OR Status EQUALS "0x32" OR Status EQUALS "0x3E" OR Status EQUALS "0x3F" OR Status EQUALS "0x40" OR Status EQUALS "0x41" OR Status EQUALS "0x43" OR Status EQUALS "0x44"))
