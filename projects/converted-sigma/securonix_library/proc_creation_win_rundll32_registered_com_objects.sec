// Description: load malicious registered COM objects
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAINS "-sta " OR CommandLine CONTAINS "-localserver ") AND (CommandLine CONTAINS "{" AND CommandLine CONTAINS "}")) AND ((Image="*\\rundll32.exe") OR (OriginalFileName EQUALS "RUNDLL32.EXE")))
