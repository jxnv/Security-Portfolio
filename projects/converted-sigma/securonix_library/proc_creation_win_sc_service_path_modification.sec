// Title: Suspicious Service Path Modification
// ID: 138d3531-8793-4f50-a2cd-f291b2863d78
// Status: test
// Level: high
// Author: Victor Sergeev, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-10-21
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects service path modification via the "sc" binary to a suspicious command or path
// Converted by: Sigma Universal SIEM/EDR CLI

(Image="*\\sc.exe" AND (CommandLine CONTAINS "config" AND CommandLine CONTAINS "binPath") AND (CommandLine CONTAINS "powershell" OR CommandLine CONTAINS "cmd " OR CommandLine CONTAINS "mshta" OR CommandLine CONTAINS "wscript" OR CommandLine CONTAINS "cscript" OR CommandLine CONTAINS "rundll32" OR CommandLine CONTAINS "svchost" OR CommandLine CONTAINS "dllhost" OR CommandLine CONTAINS "cmd.exe /c" OR CommandLine CONTAINS "cmd.exe /k" OR CommandLine CONTAINS "cmd.exe /r" OR CommandLine CONTAINS "cmd /c" OR CommandLine CONTAINS "cmd /k" OR CommandLine CONTAINS "cmd /r" OR CommandLine CONTAINS "C:\\Users\\Public" OR CommandLine CONTAINS "\\Downloads\\" OR CommandLine CONTAINS "\\Desktop\\" OR CommandLine CONTAINS "\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\" OR CommandLine CONTAINS "C:\\Windows\\TEMP\\" OR CommandLine CONTAINS "\\AppData\\Local\\Temp"))
