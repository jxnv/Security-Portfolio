// Title: Remote Schedule Task Lateral Movement via SASec
// ID: aff229ab-f8cd-447b-b215-084d11e79eb0
// Status: test
// Level: high
// Author: Sagie Dulce, Dekel Paz
// Date: 2022-01-01
// Tags: attack.privilege-escalation, attack.lateral-movement, attack.execution, attack.persistence, attack.t1053, attack.t1053.002
// Description: Detects remote RPC calls to create or execute a scheduled task via SASec
// Converted by: Sigma Universal SIEM/EDR CLI

(EventLog EQUALS "RPCFW" AND EventID EQUALS "3" AND InterfaceUuid EQUALS "378e52b0-c0a9-11cf-822d-00aa0051e40f" AND (OpNum EQUALS "0" OR OpNum EQUALS "1"))
