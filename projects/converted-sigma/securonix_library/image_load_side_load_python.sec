(((ImageLoaded="*\\python39.dll" OR ImageLoaded="*\\python310.dll" OR ImageLoaded="*\\python311.dll" OR ImageLoaded="*\\python312.dll")) AND NOT (((((ImageLoaded="C:\\Program Files\\Python3*" OR ImageLoaded="C:\\Program Files (x86)\\Python3*")) OR (ImageLoaded CONTAINS "\\AppData\\Local\\Programs\\Python\\Python3")) OR (Product EQUALS "Python" AND Signed EQUALS "true" AND Description EQUALS "Python" AND Company EQUALS "Python Software Foundation"))) AND NOT (((ImageLoaded="C:\\ProgramData\\Anaconda3\\*") OR ((ImageLoaded CONTAINS "\\cpython\\externals\\" OR ImageLoaded CONTAINS "\\cpython\\PCbuild\\")) OR (ImageLoaded="C:\\Users*" AND ImageLoaded CONTAINS "\\AppData\\Local\\Temp\\_MEI") OR (ImageLoaded="C:\\Program Files\\Microsoft Visual Studio\\*"))))
