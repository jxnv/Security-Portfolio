// Title: New Module Module Added To IIS Server
// ID: dd857d3e-0c6e-457b-9b48-e82ae7f86bd7
// Status: test
// Level: medium
// Author: frack113
// Date: 2024-10-06
// Tags: attack.persistence, attack.defense-impairment, attack.t1685.001, attack.t1505.004
// Description: Detects the addition of a new module to an IIS server.
// Converted by: Sigma Universal SIEM/EDR CLI

((EventID EQUALS "29" AND Configuration CONTAINS "/system.webServer/modules/add") AND NOT ((((NewValue EQUALS "AnonymousAuthenticationModule" OR NewValue EQUALS "CustomErrorModule" OR NewValue EQUALS "DefaultDocumentModule" OR NewValue EQUALS "DirectoryListingModule" OR NewValue EQUALS "FileCacheModule" OR NewValue EQUALS "HttpCacheModule" OR NewValue EQUALS "HttpLoggingModule" OR NewValue EQUALS "ProtocolSupportModule" OR NewValue EQUALS "RequestFilteringModule" OR NewValue EQUALS "StaticCompressionModule" OR NewValue EQUALS "StaticFileModule" OR NewValue EQUALS "TokenCacheModule" OR NewValue EQUALS "UriCacheModule")) OR (NewValue EQUALS ""))))
