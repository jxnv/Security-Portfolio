// Title: AWS S3 Data Management Tampering
// ID: 78b3756a-7804-4ef7-8555-7b9024a02e2d
// Status: test
// Level: low
// Author: Austin Songer @austinsonger
// Date: 2021-07-24
// Tags: attack.exfiltration, attack.t1537
// Description: Detects when a user tampers with S3 data management in Amazon Web Services.
// Converted by: Sigma Universal SIEM/EDR CLI

(eventSource EQUALS "s3.amazonaws.com" AND (eventName EQUALS "PutBucketLogging" OR eventName EQUALS "PutBucketWebsite" OR eventName EQUALS "PutEncryptionConfiguration" OR eventName EQUALS "PutLifecycleConfiguration" OR eventName EQUALS "PutReplicationConfiguration" OR eventName EQUALS "ReplicateObject" OR eventName EQUALS "RestoreObject"))
