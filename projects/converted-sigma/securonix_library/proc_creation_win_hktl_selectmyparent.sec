// Description: Detects the use of parent process ID spoofing tools like Didier Stevens tool SelectMyParent
// Converted by: Sigma Universal SIEM/EDR CLI

((Image="*\\SelectMyParent.exe") OR ((CommandLine CONTAINS "PPID-spoof" OR CommandLine CONTAINS "ppid_spoof" OR CommandLine CONTAINS "spoof-ppid" OR CommandLine CONTAINS "spoof_ppid" OR CommandLine CONTAINS "ppidspoof" OR CommandLine CONTAINS "spoofppid" OR CommandLine CONTAINS "spoofedppid" OR CommandLine CONTAINS " -spawnto ")) OR ((OriginalFileName CONTAINS "PPID-spoof" OR OriginalFileName CONTAINS "ppid_spoof" OR OriginalFileName CONTAINS "spoof-ppid" OR OriginalFileName CONTAINS "spoof_ppid" OR OriginalFileName CONTAINS "ppidspoof" OR OriginalFileName CONTAINS "spoofppid" OR OriginalFileName CONTAINS "spoofedppid")) OR (Description EQUALS "SelectMyParent") OR ((Hashes CONTAINS "IMPHASH=04D974875BD225F00902B4CAD9AF3FBC" OR Hashes CONTAINS "IMPHASH=A782AF154C9E743DDF3F3EB2B8F3D16E" OR Hashes CONTAINS "IMPHASH=89059503D7FBF470E68F7E63313DA3AD" OR Hashes CONTAINS "IMPHASH=CA28337632625C8281AB8A130B3D6BAD")))
