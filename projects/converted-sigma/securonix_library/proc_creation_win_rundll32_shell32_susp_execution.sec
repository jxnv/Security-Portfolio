// Title: Shell32 DLL Execution in Suspicious Directory
// ID: 32b96012-7892-429e-b26c-ac2bf46066ff
// Status: test
// Level: high
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-11-24
// Tags: attack.execution, attack.stealth, attack.t1218.011
// Description: Detects shell32.dll executing a DLL in a suspicious directory
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAINS "shell32.dll" AND CommandLine CONTAINS "Control_RunDLL") AND (CommandLine CONTAINS "%AppData%" OR CommandLine CONTAINS "%LocalAppData%" OR CommandLine CONTAINS "%Temp%" OR CommandLine CONTAINS "%tmp%" OR CommandLine CONTAINS "\\AppData\\" OR CommandLine CONTAINS "\\Temp\\" OR CommandLine CONTAINS "\\Users\\Public\\")) AND ((Image="*\\rundll32.exe") OR (OriginalFileName EQUALS "RUNDLL32.EXE")))
