// Title: Suspicious Msiexec Quiet Install From Remote Location
// ID: 8150732a-0c9d-4a99-82b9-9efb9b90c40c
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-28
// Tags: attack.stealth, attack.t1218.007
// Description: Detects usage of Msiexec.exe to install packages hosted remotely quietly
// Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine CONTAINS "-i" OR CommandLine CONTAINS "/i" OR CommandLine CONTAINS "-package" OR CommandLine CONTAINS "/package" OR CommandLine CONTAINS "-a" OR CommandLine CONTAINS "/a" OR CommandLine CONTAINS "-j" OR CommandLine CONTAINS "/j")) AND ((Image="*\\msiexec.exe") OR (OriginalFileName EQUALS "msiexec.exe")) AND ((CommandLine CONTAINS "-q" OR CommandLine CONTAINS "/q")) AND ((CommandLine CONTAINS "http" OR CommandLine CONTAINS "\\\\\\\\"))) AND NOT (((CommandLine CONTAINS "\\AppData\\Local\\Temp\\OpenOffice" AND CommandLine CONTAINS "Installation Files\\openoffice"))))
