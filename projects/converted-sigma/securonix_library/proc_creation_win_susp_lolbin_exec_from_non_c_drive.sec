// Title: LOLBIN Execution From Abnormal Drive
// ID: d4ca7c59-e9e4-42d8-bf57-91a776efcb87
// Status: test
// Level: medium
// Author: Christopher Peacock '@securepeacock', SCYTHE '@scythe_io', Angelo Violetti - SEC Consult '@angelo_violetti', Aaron Herman
// Date: 2022-01-25
// Tags: attack.stealth
// Description: Detects LOLBINs executing from an abnormal or uncommon drive such as a mounted ISO.
// Converted by: Sigma Universal SIEM/EDR CLI

((((Image="*\\calc.exe" OR Image="*\\certutil.exe" OR Image="*\\cmstp.exe" OR Image="*\\cscript.exe" OR Image="*\\installutil.exe" OR Image="*\\mshta.exe" OR Image="*\\regsvr32.exe" OR Image="*\\rundll32.exe" OR Image="*\\wscript.exe")) OR ((OriginalFileName EQUALS "CALC.EXE" OR OriginalFileName EQUALS "CertUtil.exe" OR OriginalFileName EQUALS "CMSTP.EXE" OR OriginalFileName EQUALS "cscript.exe" OR OriginalFileName EQUALS "installutil.exe" OR OriginalFileName EQUALS "MSHTA.EXE" OR OriginalFileName EQUALS "REGSVR32.EXE" OR OriginalFileName EQUALS "RUNDLL32.EXE" OR OriginalFileName EQUALS "wscript.exe"))) AND NOT (((CurrentDirectory CONTAINS "C:\\") OR (CurrentDirectory EQUALS "") OR (NOT CurrentDirectory=*))))
