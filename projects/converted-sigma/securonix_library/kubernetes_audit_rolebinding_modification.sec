// Title: Kubernetes Rolebinding Modification
// ID: 10b97915-ec8d-455f-a815-9a78926585f6
// Status: test
// Level: medium
// Author: kelnage
// Date: 2024-07-11
// Tags: attack.privilege-escalation
// Description: Detects when a Kubernetes Rolebinding is created or modified.
// Converted by: Sigma Universal SIEM/EDR CLI

(objectRef.apiGroup EQUALS "rbac.authorization.k8s.io" AND (objectRef.resource EQUALS "clusterrolebindings" OR objectRef.resource EQUALS "rolebindings") AND (verb EQUALS "create" OR verb EQUALS "delete" OR verb EQUALS "patch" OR verb EQUALS "replace" OR verb EQUALS "update"))
