// Tags: attack.collection, attack.t1560.001
// Description: An adversary may compress or encrypt data that is collected prior to exfiltration using 3rd party utilities
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAINS " a " OR CommandLine CONTAINS " u ")) AND ((Description CONTAINS "7-Zip") OR ((Image="*\\7z.exe" OR Image="*\\7zr.exe" OR Image="*\\7za.exe")) OR ((OriginalFileName EQUALS "7z.exe" OR OriginalFileName EQUALS "7za.exe" OR OriginalFileName EQUALS "7zr.exe"))) AND (CommandLine CONTAINS " -p"))
