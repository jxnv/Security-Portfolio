// Title: Download From Suspicious TLD - Whitelist
// ID: b5de2919-b74a-4805-91a7-5049accbaefe
// Status: test
// Level: low
// Author: Florian Roth (Nextron Systems)
// Date: 2017-03-13
// Tags: attack.initial-access, attack.t1566, attack.execution, attack.t1203, attack.t1204.002
// Description: Detects executable downloads from suspicious remote systems
// Converted by: Sigma Universal SIEM/EDR CLI

(((c-uri-extension EQUALS "exe" OR c-uri-extension EQUALS "vbs" OR c-uri-extension EQUALS "bat" OR c-uri-extension EQUALS "rar" OR c-uri-extension EQUALS "ps1" OR c-uri-extension EQUALS "doc" OR c-uri-extension EQUALS "docm" OR c-uri-extension EQUALS "xls" OR c-uri-extension EQUALS "xlsm" OR c-uri-extension EQUALS "pptm" OR c-uri-extension EQUALS "rtf" OR c-uri-extension EQUALS "hta" OR c-uri-extension EQUALS "dll" OR c-uri-extension EQUALS "ws" OR c-uri-extension EQUALS "wsf" OR c-uri-extension EQUALS "sct" OR c-uri-extension EQUALS "zip")) AND NOT (((cs-host="*.com" OR cs-host="*.org" OR cs-host="*.net" OR cs-host="*.edu" OR cs-host="*.gov" OR cs-host="*.uk" OR cs-host="*.ca" OR cs-host="*.de" OR cs-host="*.jp" OR cs-host="*.fr" OR cs-host="*.au" OR cs-host="*.us" OR cs-host="*.ch" OR cs-host="*.it" OR cs-host="*.nl" OR cs-host="*.se" OR cs-host="*.no" OR cs-host="*.es"))))
