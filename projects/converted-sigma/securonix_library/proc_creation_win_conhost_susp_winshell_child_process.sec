// Title: Potentially Suspicious Child Processes Spawned by ConHost
// ID: dfa03a09-8b92-4d83-8e74-f72839b1c407
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-02-05
// Tags: attack.stealth, attack.t1202, attack.t1218
// Description: Detects suspicious child processes related to Windows Shell utilities spawned by `conhost.exe`, which could indicate malicious activity using trusted system components.
// Converted by: Sigma Universal SIEM/EDR CLI

((((Image="*\\cmd.exe" OR Image="*\\cscript.exe" OR Image="*\\mshta.exe" OR Image="*\\powershell_ise.exe" OR Image="*\\powershell.exe" OR Image="*\\pwsh.exe" OR Image="*\\regsvr32.exe" OR Image="*\\wscript.exe")) OR ((OriginalFileName EQUALS "cmd.exe" OR OriginalFileName EQUALS "cscript.exe" OR OriginalFileName EQUALS "mshta.exe" OR OriginalFileName EQUALS "powershell_ise.exe" OR OriginalFileName EQUALS "powershell.exe" OR OriginalFileName EQUALS "pwsh.dll" OR OriginalFileName EQUALS "regsvr32.exe" OR OriginalFileName EQUALS "wscript.exe"))) AND (ParentImage="*\\conhost.exe"))
