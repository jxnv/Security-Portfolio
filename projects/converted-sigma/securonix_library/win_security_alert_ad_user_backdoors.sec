(((EventID EQUALS "4738") AND NOT ((((AllowedToDelegateTo EQUALS "" OR AllowedToDelegateTo EQUALS "-")) OR (NOT AllowedToDelegateTo=*)))) OR ((EventID EQUALS "5136" AND AttributeLDAPDisplayName EQUALS "msDS-AllowedToDelegateTo") OR (EventID EQUALS "5136" AND ObjectClass EQUALS "user" AND AttributeLDAPDisplayName EQUALS "servicePrincipalName") OR (EventID EQUALS "5136" AND AttributeLDAPDisplayName EQUALS "msDS-AllowedToActOnBehalfOfOtherIdentity")))
