// Title: ETW Logging Disabled For rpcrt4.dll
// ID: 90f342e1-1aaa-4e43-b092-39fda57ed11e
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-09
// Tags: attack.persistence, attack.defense-impairment, attack.t1112, attack.t1685
// Description: Detects changes to the "ExtErrorInformation" key in order to disable ETW logging for rpcrt4.dll
// Converted by: Sigma Universal SIEM/EDR CLI

(TargetObject="*\\Microsoft\\Windows NT\\Rpc\\ExtErrorInformation" AND (Details EQUALS "DWORD (0x00000000)" OR Details EQUALS "DWORD (0x00000002)"))
