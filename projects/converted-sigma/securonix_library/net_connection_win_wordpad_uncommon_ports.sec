// Title: Suspicious Wordpad Outbound Connections
// ID: 786cdae8-fefb-4eb2-9227-04e34060db01
// Status: test
// Level: medium
// Author: X__Junior (Nextron Systems)
// Date: 2023-07-12
// Tags: attack.command-and-control, attack.stealth
// Description: Detects a network connection initiated by "wordpad.exe" over uncommon destination ports.
// This might indicate potential process injection activity from a beacon or similar mechanisms.
// Converted by: Sigma Universal SIEM/EDR CLI

((Initiated EQUALS "true" AND Image="*\\wordpad.exe") AND NOT (((DestinationPort EQUALS "80" OR DestinationPort EQUALS "139" OR DestinationPort EQUALS "443" OR DestinationPort EQUALS "445" OR DestinationPort EQUALS "465" OR DestinationPort EQUALS "587" OR DestinationPort EQUALS "993" OR DestinationPort EQUALS "995"))))
