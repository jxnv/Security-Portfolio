// Title: Suspicious Usage Of ShellExec_RunDLL
// ID: d87bd452-6da1-456e-8155-7dc988157b7d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-01
// Tags: attack.stealth
// Description: Detects suspicious usage of the ShellExec_RunDLL function to launch other commands as seen in the the raspberry-robin attack
// Converted by: Sigma Universal SIEM/EDR CLI

((CommandLine CONTAINS "ShellExec_RunDLL") AND ((CommandLine CONTAINS "\\Desktop\\" OR CommandLine CONTAINS "\\Temp\\" OR CommandLine CONTAINS "\\Users\\Public\\" OR CommandLine CONTAINS "comspec" OR CommandLine CONTAINS "iex" OR CommandLine CONTAINS "Invoke-" OR CommandLine CONTAINS "msiexec" OR CommandLine CONTAINS "odbcconf" OR CommandLine CONTAINS "regsvr32")))
