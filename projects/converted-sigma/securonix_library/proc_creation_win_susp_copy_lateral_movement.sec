// Title: Copy From Or To Admin Share Or Sysvol Folder
// ID: 855bc8b5-2ae8-402e-a9ed-b889e6df1900
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), oscd.community, Teymur Kheirkhabarov @HeirhabarovT, Zach Stanford @svch0st, Nasreddine Bencherchali
// Date: 2019-12-30
// Tags: attack.lateral-movement, attack.collection, attack.exfiltration, attack.t1039, attack.t1048, attack.t1021.002
// Description: Detects a copy command or a copy utility execution to or from an Admin share or remote
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAINS "\\\\\\\\*\\\\*$" OR CommandLine CONTAINS "\\Sysvol\\")) AND ((((Image="*\\robocopy.exe" OR Image="*\\xcopy.exe")) OR ((OriginalFileName EQUALS "robocopy.exe" OR OriginalFileName EQUALS "XCOPY.EXE"))) OR ((CommandLine CONTAINS "copy") AND ((Image="*\\cmd.exe") OR (OriginalFileName EQUALS "Cmd.Exe"))) OR (((CommandLine CONTAINS "copy-item" OR CommandLine CONTAINS "copy " OR CommandLine CONTAINS "cpi " OR CommandLine CONTAINS " cp " OR CommandLine CONTAINS "move " OR CommandLine CONTAINS " move-item" OR CommandLine CONTAINS " mi " OR CommandLine CONTAINS " mv ")) AND (((Image CONTAINS "\\powershell_ise.exe" OR Image CONTAINS "\\powershell.exe" OR Image CONTAINS "\\pwsh.exe")) OR ((OriginalFileName EQUALS "powershell_ise.exe" OR OriginalFileName EQUALS "PowerShell.EXE" OR OriginalFileName EQUALS "pwsh.dll"))))))
