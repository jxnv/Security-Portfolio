// Title: Suspicious New Service Creation
// ID: 17a1be64-8d88-40bf-b5ff-a4f7a50ebcc8
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-14
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects creation of a new service via "sc" command or the powershell "new-service" cmdlet with suspicious binary paths
// Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine CONTAINS "New-Service" AND CommandLine CONTAINS "-BinaryPathName")) OR (Image="*\\sc.exe" AND (CommandLine CONTAINS "create" AND CommandLine CONTAINS "binPath="))) AND ((CommandLine CONTAINS "powershell" OR CommandLine CONTAINS "mshta" OR CommandLine CONTAINS "wscript" OR CommandLine CONTAINS "cscript" OR CommandLine CONTAINS "svchost" OR CommandLine CONTAINS "dllhost" OR CommandLine CONTAINS "cmd " OR CommandLine CONTAINS "cmd.exe /c" OR CommandLine CONTAINS "cmd.exe /k" OR CommandLine CONTAINS "cmd.exe /r" OR CommandLine CONTAINS "rundll32" OR CommandLine CONTAINS "C:\\Users\\Public" OR CommandLine CONTAINS "\\Downloads\\" OR CommandLine CONTAINS "\\Desktop\\" OR CommandLine CONTAINS "\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\" OR CommandLine CONTAINS "C:\\Windows\\TEMP\\" OR CommandLine CONTAINS "\\AppData\\Local\\Temp")))
