// Tags: attack.privilege-escalation, attack.persistence, attack.initial-access, attack.stealth, attack.t1078
// Description: Detects when there is a interruption in the authentication process.
// Converted by: Sigma Universal SIEM/EDR CLI

((ResultType EQUALS "50097" AND ResultDescription EQUALS "Device authentication is required") OR (ResultType EQUALS "50155" AND ResultDescription EQUALS "DeviceAuthenticationFailed") OR (ResultType EQUALS "50158" AND ResultDescription EQUALS "ExternalSecurityChallenge - External security challenge was not satisfied"))
