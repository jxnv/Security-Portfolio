// Title: Schtasks From Suspicious Folders
// ID: 8a8379b8-780b-4dbf-b1e9-31c8d112fefb
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-04-15
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects scheduled task creations that have suspicious action command and folder combinations
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAINS "C:\\ProgramData\\" OR CommandLine CONTAINS "%ProgramData%")) AND ((CommandLine CONTAINS "powershell" OR CommandLine CONTAINS "pwsh" OR CommandLine CONTAINS "cmd /c " OR CommandLine CONTAINS "cmd /k " OR CommandLine CONTAINS "cmd /r " OR CommandLine CONTAINS "cmd.exe /c " OR CommandLine CONTAINS "cmd.exe /k " OR CommandLine CONTAINS "cmd.exe /r ")) AND (CommandLine CONTAINS " /create ") AND ((Image="*\\schtasks.exe") OR (OriginalFileName EQUALS "schtasks.exe")))
