// Description: Detects remote RPC calls to modify the registry and possible execute code
// Converted by: Sigma Universal SIEM/EDR CLI

(EventLog EQUALS "RPCFW" AND EventID EQUALS "3" AND InterfaceUuid EQUALS "338cd001-2244-31f1-aaaa-900038001003" AND (OpNum EQUALS "6" OR OpNum EQUALS "7" OR OpNum EQUALS "8" OR OpNum EQUALS "13" OR OpNum EQUALS "18" OR OpNum EQUALS "19" OR OpNum EQUALS "21" OR OpNum EQUALS "22" OR OpNum EQUALS "23" OR OpNum EQUALS "35"))
