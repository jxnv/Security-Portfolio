// Tags: attack.lateral-movement, attack.defense-impairment, attack.t1112, attack.persistence
// Description: Detects remote RPC calls to modify the registry and possible execute code
// Converted by: Sigma Universal SIEM/EDR CLI

(EventLog EQ "RPCFW" AND EventID EQ "3" AND InterfaceUuid EQ "338cd001-2244-31f1-aaaa-900038001003" AND (OpNum EQ "6" OR OpNum EQ "7" OR OpNum EQ "8" OR OpNum EQ "13" OR OpNum EQ "18" OR OpNum EQ "19" OR OpNum EQ "21" OR OpNum EQ "22" OR OpNum EQ "23" OR OpNum EQ "35"))
