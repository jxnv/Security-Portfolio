// Title: Always Install Elevated Windows Installer
// ID: cd951fdc-4b2f-47f5-ba99-a33bf61e3770
// Status: test
// Level: medium
// Author: Teymur Kheirkhabarov (idea), Mangatas Tondang (rule), oscd.community
// Date: 2020-10-13
// Tags: attack.privilege-escalation, attack.t1548.002
// Description: Detects Windows Installer service (msiexec.exe) trying to install MSI packages with SYSTEM privilege
// Converted by: Sigma Universal SIEM/EDR CLI

((((Image CONTAINS "\\Windows\\Installer\\" AND Image CONTAINS "msi") AND Image ENDSWITH "tmp") OR (Image ENDSWITH "\\msiexec.exe" AND (IntegrityLevel EQ "System" OR IntegrityLevel EQ "S-1-16-16384"))) AND ((User CONTAINS "AUTHORI" OR User CONTAINS "AUTORI")) AND NOT ((((ParentImage STARTSWITH "C:\\Program Files\\Avast Software\\" OR ParentImage STARTSWITH "C:\\Program Files (x86)\\Avast Software\\")) OR (ParentImage STARTSWITH "C:\\ProgramData\\Avira\\") OR ((ParentImage STARTSWITH "C:\\Program Files\\Google\\Update\\" OR ParentImage STARTSWITH "C:\\Program Files (x86)\\Google\\Update\\")) OR (ParentImage EQ "C:\\Windows\\System32\\services.exe") OR ((CommandLine ENDSWITH "\\system32\\msiexec.exe /V") OR (ParentCommandLine ENDSWITH "\\system32\\msiexec.exe /V")) OR (ParentImage STARTSWITH "C:\\ProgramData\\Sophos\\"))))
