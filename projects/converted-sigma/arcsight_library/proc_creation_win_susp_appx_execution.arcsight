// Title: Potentially Suspicious Windows App Activity
// ID: f91ed517-a6ba-471d-9910-b3b4a398c0f3
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-12
// Tags: attack.stealth
// Description: Detects potentially suspicious child process of applications launched from inside the WindowsApps directory. This could be a sign of a rogue ".appx" package installation/execution
// Converted by: Sigma Universal SIEM/EDR CLI

((ParentImage CONTAINS "C:\\Program Files\\WindowsApps\\") AND (((CommandLine CONTAINS "cmd /c" OR CommandLine CONTAINS "Invoke-" OR CommandLine CONTAINS "Base64")) OR ((Image ENDSWITH "\\cmd.exe" OR Image ENDSWITH "\\cscript.exe" OR Image ENDSWITH "\\mshta.exe" OR Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\powershell_ise.exe" OR Image ENDSWITH "\\pwsh.exe" OR Image ENDSWITH "\\regsvr32.exe" OR Image ENDSWITH "\\rundll32.exe" OR Image ENDSWITH "\\wscript.exe"))) AND NOT (((ParentImage STARTSWITH "C:\\Program Files\\WindowsApps\\Microsoft.SysinternalsSuite" AND Image ENDSWITH "\\cmd.exe") OR (ParentImage CONTAINS ":\\Program Files\\WindowsApps\\Microsoft.WindowsTerminal" AND ParentImage ENDSWITH "\\WindowsTerminal.exe" AND (Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\cmd.exe" OR Image ENDSWITH "\\pwsh.exe")))))
