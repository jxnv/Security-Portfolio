// Title: HackTool - CrackMapExec PowerShell Obfuscation
// ID: 6f8b3439-a203-45dc-a88b-abf57ea15ccf
// Status: test
// Level: high
// Author: Thomas Patzke
// Date: 2020-05-22
// Tags: attack.execution, attack.stealth, attack.t1059.001, attack.t1027.005
// Description: The CrachMapExec pentesting framework implements a PowerShell obfuscation with some static strings detected by this rule.
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAINS "join*split" OR CommandLine CONTAINS "( $ShellId[1]+$ShellId[13]+'x')" OR CommandLine CONTAINS "( $PSHome[*]+$PSHOME[*]+" OR CommandLine CONTAINS "( $env:Public[13]+$env:Public[5]+'x')" OR CommandLine CONTAINS "( $env:ComSpec[4,*,25]-Join'')" OR CommandLine CONTAINS "[1,3]+'x'-Join'')")) AND (((Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\pwsh.exe")) OR ((OriginalFileName EQ "PowerShell.EXE" OR OriginalFileName EQ "pwsh.dll"))))
