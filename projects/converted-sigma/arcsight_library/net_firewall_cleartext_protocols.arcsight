(((dst_port EQ "8080" OR dst_port EQ "21" OR dst_port EQ "80" OR dst_port EQ "23" OR dst_port EQ "50000" OR dst_port EQ "1521" OR dst_port EQ "27017" OR dst_port EQ "3306" OR dst_port EQ "1433" OR dst_port EQ "11211" OR dst_port EQ "15672" OR dst_port EQ "5900" OR dst_port EQ "5901" OR dst_port EQ "5902" OR dst_port EQ "5903" OR dst_port EQ "5904")) AND (((action EQ "forward" OR action EQ "accept" OR action EQ "2")) OR (blocked EQ "false")))
