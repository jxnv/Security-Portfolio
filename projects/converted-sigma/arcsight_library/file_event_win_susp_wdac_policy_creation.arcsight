// Title: Potentially Suspicious WDAC Policy File Creation
// ID: 1d2de8a6-4803-4fde-b85b-f58f3aa7a705
// Status: experimental
// Level: medium
// Author: X__Junior
// Date: 2025-02-07
// Tags: attack.defense-impairment
// Description: Detects suspicious Windows Defender Application Control (WDAC) policy file creation from abnormal processes that could be abused by attacker to block EDR/AV components while allowing their own malicious code to run on the system.
// Converted by: Sigma Universal SIEM/EDR CLI

((TargetFilename CONTAINS "\\Windows\\System32\\CodeIntegrity\\") AND NOT (((((CommandLine CONTAINS "ConvertFrom-CIPolicy -XmlFilePath" AND CommandLine CONTAINS "-BinaryFilePath ")) OR (CommandLine CONTAINS "CiTool --update-policy") OR ((CommandLine CONTAINS "Copy-Item -Path" AND CommandLine CONTAINS "-Destination"))) OR ((Image ENDSWITH "\\Microsoft.ConfigurationManagement.exe" OR Image ENDSWITH "\\WDAC Wizard.exe" OR Image ENDSWITH "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" OR Image ENDSWITH "C:\\Program Files\\PowerShell\\7\\pwsh.exe" OR Image ENDSWITH "C:\\Windows\\System32\\dllhost.exe" OR Image ENDSWITH "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" OR Image ENDSWITH "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" OR Image ENDSWITH "C:\\Windows\\SysWOW64\\dllhost.exe" OR Image ENDSWITH "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" OR Image ENDSWITH "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")) OR (Image EQ "System") OR (Image EQ "C:\\Windows\\System32\\wuauclt.exe") OR ((Image EQ "C:\\Windows\\UUS\\arm64\\wuaucltcore.exe" OR Image EQ "C:\\Windows\\UUS\\Packages\\Preview\\arm64\\wuaucltcore.exe")))))
