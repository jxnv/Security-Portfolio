// Title: Mstsc.EXE Execution From Uncommon Parent
// ID: ff3b6b39-e765-42f9-bb2c-ea6761e0e0f6
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.lateral-movement
// Description: Detects potential RDP connection via Mstsc using a local ".rdp" file located in suspicious locations.
// Converted by: Sigma Universal SIEM/EDR CLI

(((Image ENDSWITH "\\mstsc.exe") OR (OriginalFileName EQ "mstsc.exe")) AND ((ParentImage ENDSWITH "\\brave.exe" OR ParentImage ENDSWITH "\\CCleanerBrowser.exe" OR ParentImage ENDSWITH "\\chrome.exe" OR ParentImage ENDSWITH "\\chromium.exe" OR ParentImage ENDSWITH "\\firefox.exe" OR ParentImage ENDSWITH "\\iexplore.exe" OR ParentImage ENDSWITH "\\microsoftedge.exe" OR ParentImage ENDSWITH "\\msedge.exe" OR ParentImage ENDSWITH "\\opera.exe" OR ParentImage ENDSWITH "\\vivaldi.exe" OR ParentImage ENDSWITH "\\whale.exe" OR ParentImage ENDSWITH "\\outlook.exe")))
