// Description: Detects the use of smbexec.py tool by detecting a specific service installation
// Converted by: Sigma Universal SIEM/EDR CLI

((Provider_Name EQ "Service Control Manager" AND EventID EQ "7045") AND (((ImagePath CONTAINS ".bat & del " OR ImagePath CONTAINS "__output 2^>^&1 >")) OR (ServiceName EQ "BTOBTO")))
