// Title: Potential DLL Sideloading Of DBGCORE.DLL
// ID: 9ca2bf31-0570-44d8-a543-534c47c33ed7
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Wietze Beukema (project and research)
// Date: 2022-10-25
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects DLL sideloading of "dbgcore.dll"
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageLoaded ENDSWITH "\\dbgcore.dll") AND NOT (((ImageLoaded STARTSWITH "C:\\Program Files (x86)\\" OR ImageLoaded STARTSWITH "C:\\Program Files\\" OR ImageLoaded STARTSWITH "C:\\Windows\\SoftwareDistribution\\" OR ImageLoaded STARTSWITH "C:\\Windows\\System32\\" OR ImageLoaded STARTSWITH "C:\\Windows\\SystemTemp\\" OR ImageLoaded STARTSWITH "C:\\Windows\\SysWOW64\\" OR ImageLoaded STARTSWITH "C:\\Windows\\WinSxS\\"))) AND NOT (((ImageLoaded CONTAINS "opera\\Opera Installer Temp\\opera_package" AND ImageLoaded ENDSWITH "\\assistant\\dbgcore.dll") OR (ImageLoaded ENDSWITH "\\Steam\\bin\\cef\\cef.win7x64\\dbgcore.dll"))))
