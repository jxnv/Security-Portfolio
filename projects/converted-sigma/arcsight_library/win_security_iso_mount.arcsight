// Title: ISO Image Mounted
// ID: 0248a7bc-8a9a-4cd8-a57e-3ae8e073a073
// Status: test
// Level: medium
// Author: Syed Hasan (@syedhasan009)
// Date: 2021-05-29
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects the mount of an ISO image on an endpoint
// Converted by: Sigma Universal SIEM/EDR CLI

((EventID EQ "4663" AND ObjectServer EQ "Security" AND ObjectType EQ "File" AND ObjectName STARTSWITH "\\Device\\CdRom") AND NOT (((ObjectName EQ "\\Device\\CdRom0\\autorun.ico" OR ObjectName EQ "\\Device\\CdRom0\\setup.exe" OR ObjectName EQ "\\Device\\CdRom0\\setup64.exe"))))
