// Title: Potentially Suspicious Rundll32 Activity
// ID: e593cf51-88db-4ee1-b920-37e89012a3c9
// Status: test
// Level: medium
// Author: juju4, Jonhnathan Ribeiro, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-01-16
// Tags: attack.stealth, attack.t1218.011
// Description: Detects suspicious execution of rundll32, with specific calls to some DLLs with known LOLBIN functionalities
// Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine CONTAINS "javascript:" AND CommandLine CONTAINS ".RegisterXLL")) OR ((CommandLine CONTAINS "url.dll" AND CommandLine CONTAINS "OpenURL")) OR ((CommandLine CONTAINS "url.dll" AND CommandLine CONTAINS "OpenURLA")) OR ((CommandLine CONTAINS "url.dll" AND CommandLine CONTAINS "FileProtocolHandler")) OR ((CommandLine CONTAINS "zipfldr.dll" AND CommandLine CONTAINS "RouteTheCall")) OR ((CommandLine CONTAINS "shell32.dll" AND CommandLine CONTAINS "Control_RunDLL")) OR ((CommandLine CONTAINS "shell32.dll" AND CommandLine CONTAINS "ShellExec_RunDLL")) OR ((CommandLine CONTAINS "mshtml.dll" AND CommandLine CONTAINS "PrintHTML")) OR ((CommandLine CONTAINS "advpack.dll" AND CommandLine CONTAINS "LaunchINFSection")) OR ((CommandLine CONTAINS "advpack.dll" AND CommandLine CONTAINS "RegisterOCX")) OR ((CommandLine CONTAINS "ieadvpack.dll" AND CommandLine CONTAINS "LaunchINFSection")) OR ((CommandLine CONTAINS "ieadvpack.dll" AND CommandLine CONTAINS "RegisterOCX")) OR ((CommandLine CONTAINS "ieframe.dll" AND CommandLine CONTAINS "OpenURL")) OR ((CommandLine CONTAINS "shdocvw.dll" AND CommandLine CONTAINS "OpenURL")) OR ((CommandLine CONTAINS "syssetup.dll" AND CommandLine CONTAINS "SetupInfObjectInstallAction")) OR ((CommandLine CONTAINS "setupapi.dll" AND CommandLine CONTAINS "InstallHinfSection")) OR ((CommandLine CONTAINS "pcwutl.dll" AND CommandLine CONTAINS "LaunchApplication")) OR ((CommandLine CONTAINS "dfshim.dll" AND CommandLine CONTAINS "ShOpenVerbApplication")) OR ((CommandLine CONTAINS "dfshim.dll" AND CommandLine CONTAINS "ShOpenVerbShortcut")) OR ((CommandLine CONTAINS "scrobj.dll" AND CommandLine CONTAINS "GenerateTypeLib" AND CommandLine CONTAINS "http")) OR ((CommandLine CONTAINS "shimgvw.dll" AND CommandLine CONTAINS "ImageView_Fullscreen" AND CommandLine CONTAINS "http")) OR ((CommandLine CONTAINS "comsvcs.dll" AND CommandLine CONTAINS "MiniDump"))) AND NOT (((ParentImage EQ "C:\\Windows\\System32\\control.exe" AND ParentCommandLine CONTAINS ".cpl" AND (CommandLine CONTAINS "Shell32.dll" AND CommandLine CONTAINS "Control_RunDLL" AND CommandLine CONTAINS ".cpl")) OR (CommandLine CONTAINS "shell32.dll,Control_RunDLL desk.cpl,screensaver,@screensaver") OR (ParentImage EQ "C:\\Windows\\System32\\control.exe" AND CommandLine STARTSWITH "\"C:\\Windows\\system32\\rundll32.exe\" Shell32.dll,Control_RunDLL \"C:\\Windows\\System32\\" AND CommandLine ENDSWITH ".cpl\","))))
