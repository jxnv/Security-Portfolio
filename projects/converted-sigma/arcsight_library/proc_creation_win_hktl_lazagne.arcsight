// Title: HackTool - LaZagne Execution
// ID: c2b86e67-b880-4eec-b045-50bc98ef4844
// Status: experimental
// Level: medium
// Author: Nasreddine Bencherchali, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.credential-access
// Description: Detects the execution of the LaZagne. A utility used to retrieve multiple types of passwords stored on a local computer.
// LaZagne has been leveraged multiple times by threat actors in order to dump credentials.
// Converted by: Sigma Universal SIEM/EDR CLI

((((Image CONTAINS ":\\PerfLogs\\" OR Image CONTAINS ":\\ProgramData\\" OR Image CONTAINS ":\\Temp\\" OR Image CONTAINS ":\\Tmp\\" OR Image CONTAINS ":\\Users\\Public\\" OR Image CONTAINS ":\\Windows\\Temp\\" OR Image CONTAINS "\\$Recycle.bin" OR Image CONTAINS "\\AppData\\" OR Image CONTAINS "\\Desktop\\" OR Image CONTAINS "\\Downloads\\" OR Image CONTAINS "\\Favorites\\" OR Image CONTAINS "\\Links\\" OR Image CONTAINS "\\Music\\" OR Image CONTAINS "\\Photos\\" OR Image CONTAINS "\\Pictures\\" OR Image CONTAINS "\\Saved Games\\" OR Image CONTAINS "\\Searches\\" OR Image CONTAINS "\\Users\\Contacts\\" OR Image CONTAINS "\\Users\\Default\\" OR Image CONTAINS "\\Users\\Searches\\" OR Image CONTAINS "\\Videos\\" OR Image CONTAINS "\\Windows\\addins\\" OR Image CONTAINS "\\Windows\\Fonts\\" OR Image CONTAINS "\\Windows\\IME\\") AND (CommandLine ENDSWITH ".exe all" OR CommandLine ENDSWITH ".exe browsers" OR CommandLine ENDSWITH ".exe chats" OR CommandLine ENDSWITH ".exe databases" OR CommandLine ENDSWITH ".exe games" OR CommandLine ENDSWITH ".exe git" OR CommandLine ENDSWITH ".exe mails" OR CommandLine ENDSWITH ".exe maven" OR CommandLine ENDSWITH ".exe memory" OR CommandLine ENDSWITH ".exe multimedia" OR CommandLine ENDSWITH ".exe sysadmin" OR CommandLine ENDSWITH ".exe unused" OR CommandLine ENDSWITH ".exe wifi" OR CommandLine ENDSWITH ".exe windows")) OR (Image ENDSWITH "\\lazagne.exe")) OR (((CommandLine CONTAINS " all " OR CommandLine CONTAINS " browsers " OR CommandLine CONTAINS " chats " OR CommandLine CONTAINS " databases " OR CommandLine CONTAINS " games " OR CommandLine CONTAINS " mails " OR CommandLine CONTAINS " maven " OR CommandLine CONTAINS " memory " OR CommandLine CONTAINS " multimedia " OR CommandLine CONTAINS " php " OR CommandLine CONTAINS " svn " OR CommandLine CONTAINS " sysadmin " OR CommandLine CONTAINS " unused " OR CommandLine CONTAINS " wifi ")) AND ((CommandLine CONTAINS "-1Password" OR CommandLine CONTAINS "-apachedirectorystudio" OR CommandLine CONTAINS "-autologon" OR CommandLine CONTAINS "-ChromiumBased" OR CommandLine CONTAINS "-coreftp" OR CommandLine CONTAINS "-credfiles" OR CommandLine CONTAINS "-credman" OR CommandLine CONTAINS "-cyberduck" OR CommandLine CONTAINS "-dbvis" OR CommandLine CONTAINS "-EyeCon" OR CommandLine CONTAINS "-filezilla" OR CommandLine CONTAINS "-filezillaserver" OR CommandLine CONTAINS "-ftpnavigator" OR CommandLine CONTAINS "-galconfusion" OR CommandLine CONTAINS "-gitforwindows" OR CommandLine CONTAINS "-hashdump" OR CommandLine CONTAINS "-iisapppool" OR CommandLine CONTAINS "-IISCentralCertP" OR CommandLine CONTAINS "-kalypsomedia" OR CommandLine CONTAINS "-keepass" OR CommandLine CONTAINS "-keepassconfig" OR CommandLine CONTAINS "-lsa_secrets" OR CommandLine CONTAINS "-mavenrepositories" OR CommandLine CONTAINS "-memory_dump" OR CommandLine CONTAINS "-Mozilla" OR CommandLine CONTAINS "-mRemoteNG" OR CommandLine CONTAINS "-mscache" OR CommandLine CONTAINS "-opensshforwindows" OR CommandLine CONTAINS "-openvpn" OR CommandLine CONTAINS "-outlook" OR CommandLine CONTAINS "-pidgin" OR CommandLine CONTAINS "-postgresql" OR CommandLine CONTAINS "-psi-im" OR CommandLine CONTAINS "-puttycm" OR CommandLine CONTAINS "-pypykatz" OR CommandLine CONTAINS "-Rclone" OR CommandLine CONTAINS "-rdpmanager" OR CommandLine CONTAINS "-robomongo" OR CommandLine CONTAINS "-roguestale" OR CommandLine CONTAINS "-skype" OR CommandLine CONTAINS "-SQLDeveloper" OR CommandLine CONTAINS "-squirrel" OR CommandLine CONTAINS "-tortoise" OR CommandLine CONTAINS "-turba" OR CommandLine CONTAINS "-UCBrowser" OR CommandLine CONTAINS "-unattended" OR CommandLine CONTAINS "-vault" OR CommandLine CONTAINS "-vaultfiles" OR CommandLine CONTAINS "-vnc" OR CommandLine CONTAINS "-winscp"))))
