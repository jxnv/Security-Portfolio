// Title: Suspicious Microsoft Office Child Process
// ID: 438025f9-5856-4663-83f7-52f878a70a50
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Markus Neis, FPT.EagleEye Team, Vadim Khrykov, Cyb3rEng, Michael Haag, Christopher Peacock @securepeacock, @scythe_io
// Date: 2018-04-06
// Tags: attack.execution, attack.stealth, attack.t1047, attack.t1204.002, attack.t1218.010
// Description: Detects a suspicious process spawning from one of the Microsoft Office suite products (Word, Excel, PowerPoint, Publisher, Visio, etc.)
// Converted by: Sigma Universal SIEM/EDR CLI

(((ParentImage ENDSWITH "\\EQNEDT32.EXE" OR ParentImage ENDSWITH "\\EXCEL.EXE" OR ParentImage ENDSWITH "\\MSACCESS.EXE" OR ParentImage ENDSWITH "\\MSPUB.exe" OR ParentImage ENDSWITH "\\ONENOTE.EXE" OR ParentImage ENDSWITH "\\POWERPNT.exe" OR ParentImage ENDSWITH "\\VISIO.exe" OR ParentImage ENDSWITH "\\WINWORD.EXE" OR ParentImage ENDSWITH "\\wordpad.exe" OR ParentImage ENDSWITH "\\wordview.exe")) AND ((((OriginalFileName EQ "bitsadmin.exe" OR OriginalFileName EQ "CertOC.exe" OR OriginalFileName EQ "CertUtil.exe" OR OriginalFileName EQ "Cmd.Exe" OR OriginalFileName EQ "CMSTP.EXE" OR OriginalFileName EQ "cscript.exe" OR OriginalFileName EQ "curl.exe" OR OriginalFileName EQ "HH.exe" OR OriginalFileName EQ "IEExec.exe" OR OriginalFileName EQ "InstallUtil.exe" OR OriginalFileName EQ "javaw.exe" OR OriginalFileName EQ "Microsoft.Workflow.Compiler.exe" OR OriginalFileName EQ "msdt.exe" OR OriginalFileName EQ "MSHTA.EXE" OR OriginalFileName EQ "msiexec.exe" OR OriginalFileName EQ "Msxsl.exe" OR OriginalFileName EQ "odbcconf.exe" OR OriginalFileName EQ "pcalua.exe" OR OriginalFileName EQ "PowerShell.EXE" OR OriginalFileName EQ "RegAsm.exe" OR OriginalFileName EQ "RegSvcs.exe" OR OriginalFileName EQ "REGSVR32.exe" OR OriginalFileName EQ "RUNDLL32.exe" OR OriginalFileName EQ "schtasks.exe" OR OriginalFileName EQ "ScriptRunner.exe" OR OriginalFileName EQ "wmic.exe" OR OriginalFileName EQ "WorkFolders.exe" OR OriginalFileName EQ "wscript.exe")) OR ((Image ENDSWITH "\\AppVLP.exe" OR Image ENDSWITH "\\bash.exe" OR Image ENDSWITH "\\bitsadmin.exe" OR Image ENDSWITH "\\certoc.exe" OR Image ENDSWITH "\\certutil.exe" OR Image ENDSWITH "\\cmd.exe" OR Image ENDSWITH "\\cmstp.exe" OR Image ENDSWITH "\\control.exe" OR Image ENDSWITH "\\cscript.exe" OR Image ENDSWITH "\\curl.exe" OR Image ENDSWITH "\\forfiles.exe" OR Image ENDSWITH "\\hh.exe" OR Image ENDSWITH "\\ieexec.exe" OR Image ENDSWITH "\\installutil.exe" OR Image ENDSWITH "\\javaw.exe" OR Image ENDSWITH "\\mftrace.exe" OR Image ENDSWITH "\\Microsoft.Workflow.Compiler.exe" OR Image ENDSWITH "\\msbuild.exe" OR Image ENDSWITH "\\msdt.exe" OR Image ENDSWITH "\\mshta.exe" OR Image ENDSWITH "\\msidb.exe" OR Image ENDSWITH "\\msiexec.exe" OR Image ENDSWITH "\\msxsl.exe" OR Image ENDSWITH "\\odbcconf.exe" OR Image ENDSWITH "\\pcalua.exe" OR Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\pwsh.exe" OR Image ENDSWITH "\\regasm.exe" OR Image ENDSWITH "\\regsvcs.exe" OR Image ENDSWITH "\\regsvr32.exe" OR Image ENDSWITH "\\rundll32.exe" OR Image ENDSWITH "\\schtasks.exe" OR Image ENDSWITH "\\scrcons.exe" OR Image ENDSWITH "\\scriptrunner.exe" OR Image ENDSWITH "\\sh.exe" OR Image ENDSWITH "\\svchost.exe" OR Image ENDSWITH "\\verclsid.exe" OR Image ENDSWITH "\\wmic.exe" OR Image ENDSWITH "\\workfolders.exe" OR Image ENDSWITH "\\wscript.exe"))) OR ((Image CONTAINS "\\AppData\\" OR Image CONTAINS "\\Users\\Public\\" OR Image CONTAINS "\\ProgramData\\" OR Image CONTAINS "\\Windows\\Tasks\\" OR Image CONTAINS "\\Windows\\Temp\\" OR Image CONTAINS "\\Windows\\System32\\Tasks\\"))))
