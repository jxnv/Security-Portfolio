// Title: Suspicious User Agent
// ID: 7195a772-4b3f-43a4-a210-6a003d65caa1
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2017-07-08
// Tags: attack.command-and-control, attack.t1071.001
// Description: Detects suspicious malformed user agent strings in proxy logs
// Converted by: Sigma Universal SIEM/EDR CLI

((((c-useragent STARTSWITH "user-agent" OR c-useragent STARTSWITH "Mozilla/3.0 " OR c-useragent STARTSWITH "Mozilla/2.0 " OR c-useragent STARTSWITH "Mozilla/1.0 " OR c-useragent STARTSWITH "Mozilla " OR c-useragent STARTSWITH " Mozilla/" OR c-useragent STARTSWITH "Mozila/" OR c-useragent STARTSWITH "Mozilla/4.0 (compatible; MSIE 6.0; MS Web Services Client Protocol")) OR ((c-useragent CONTAINS " (compatible;MSIE " OR c-useragent CONTAINS ".0;Windows NT " OR c-useragent CONTAINS "loader")) OR ((c-useragent EQ "_" OR c-useragent EQ "CertUtil URL Agent" OR c-useragent EQ "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:60.0)" OR c-useragent EQ "Mozilla/5.0 (Windows NT 6.3; WOW64; rv:28.0) Gecko/20100101 Firefox/28.0" OR c-useragent EQ "HTTPS" OR c-useragent EQ "Erbium-UA-4ce7c27cb4be9d32e333bf032c88235a" OR c-useragent EQ "x" OR c-useragent EQ "xxx"))) AND NOT (((c-useragent EQ "Mozilla/3.0 * Acrobat *") OR ((cs-host ENDSWITH ".acrobat.com" OR cs-host ENDSWITH ".adobe.com" OR cs-host ENDSWITH ".adobe.io")))))
