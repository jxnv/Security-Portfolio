(((ImageLoaded ENDSWITH "\\log.dll") AND NOT ((((ImageLoaded EQ "C:\\Program Files\\AVAST Software\\Avast\\log.dll" OR ImageLoaded EQ "C:\\Program Files (x86)\\AVAST Software\\Avast\\log.dll")) OR ((ImageLoaded EQ "C:\\Program Files\\AVG\\Antivirus\\log.dll" OR ImageLoaded EQ "C:\\Program Files (x86)\\AVG\\Antivirus\\log.dll")) OR ((ImageLoaded STARTSWITH "C:\\Program Files\\Bitdefender Antivirus Free\\" OR ImageLoaded STARTSWITH "C:\\Program Files (x86)\\Bitdefender Antivirus Free\\")) OR (ImageLoaded STARTSWITH "C:\\Program Files\\Canon\\MyPrinter\\") OR (Image EQ "C:\\Program Files\\Dell\\SARemediation\\audit\\TelemetryUtility.exe" AND (ImageLoaded EQ "C:\\Program Files\\Dell\\SARemediation\\plugin\\log.dll" OR ImageLoaded EQ "C:\\Program Files\\Dell\\SARemediation\\audit\\log.dll"))))) OR ((ImageLoaded ENDSWITH "\\qrt.dll") AND NOT (((ImageLoaded STARTSWITH "C:\\Program Files\\F-Secure\\Anti-Virus\\" OR ImageLoaded STARTSWITH "C:\\Program Files (x86)\\F-Secure\\Anti-Virus\\")))) OR (((ImageLoaded ENDSWITH "\\ashldres.dll" OR ImageLoaded ENDSWITH "\\lockdown.dll" OR ImageLoaded ENDSWITH "\\vsodscpl.dll")) AND NOT (((ImageLoaded STARTSWITH "C:\\Program Files\\McAfee\\" OR ImageLoaded STARTSWITH "C:\\Program Files (x86)\\McAfee\\")))) OR ((ImageLoaded ENDSWITH "\\vftrace.dll") AND NOT (((ImageLoaded STARTSWITH "C:\\Program Files\\CyberArk\\Endpoint Privilege Manager\\Agent\\x32\\" OR ImageLoaded STARTSWITH "C:\\Program Files (x86)\\CyberArk\\Endpoint Privilege Manager\\Agent\\x32\\")))) OR ((ImageLoaded ENDSWITH "\\wsc.dll") AND NOT ((((ImageLoaded STARTSWITH "C:\\program Files\\AVAST Software\\Avast\\" OR ImageLoaded STARTSWITH "C:\\program Files (x86)\\AVAST Software\\Avast\\")) OR ((ImageLoaded STARTSWITH "C:\\Program Files\\AVG\\Antivirus\\" OR ImageLoaded STARTSWITH "C:\\Program Files (x86)\\AVG\\Antivirus\\"))))) OR ((ImageLoaded ENDSWITH "\\tmdbglog.dll") AND NOT (((ImageLoaded STARTSWITH "C:\\program Files\\Trend Micro\\Titanium\\" OR ImageLoaded STARTSWITH "C:\\program Files (x86)\\Trend Micro\\Titanium\\")))) OR ((ImageLoaded ENDSWITH "\\DLPPREM32.dll") AND NOT (((ImageLoaded STARTSWITH "C:\\program Files\\ESET" OR ImageLoaded STARTSWITH "C:\\program Files (x86)\\ESET")))))
