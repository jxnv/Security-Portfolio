// Tags: attack.persistence, attack.t1137
// Description: Hides the file extension through modification of the registry
// Converted by: Sigma Universal SIEM/EDR CLI

((TargetObject CONTAINS "\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\ZoneMap\\Domains\\") AND NOT (((Details EQ "DWORD (0x00000000)" OR Details EQ "DWORD (0x00000001)" OR Details EQ "(Empty)"))))
