// Title: Potential Persistence Via Visual Studio Tools for Office
// ID: 9d15044a-7cfe-4d23-8085-6ebc11df7685
// Status: test
// Level: medium
// Author: Bhabesh Raj
// Date: 2021-01-10
// Tags: attack.t1137.006, attack.persistence
// Description: Detects persistence via Visual Studio Tools for Office (VSTO) add-ins in Office applications.
// Converted by: Sigma Universal SIEM/EDR CLI

(((TargetObject CONTAINS "\\Software\\Microsoft\\Office\\Outlook\\Addins\\" OR TargetObject CONTAINS "\\Software\\Microsoft\\Office\\Word\\Addins\\" OR TargetObject CONTAINS "\\Software\\Microsoft\\Office\\Excel\\Addins\\" OR TargetObject CONTAINS "\\Software\\Microsoft\\Office\\Powerpoint\\Addins\\" OR TargetObject CONTAINS "\\Software\\Microsoft\\VSTO\\Security\\Inclusion\\")) AND NOT ((((Image EQ "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe" OR Image EQ "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe")) OR ((Image STARTSWITH "C:\\Program Files\\Microsoft Office\\OFFICE" OR Image STARTSWITH "C:\\Program Files (x86)\\Microsoft Office\\OFFICE" OR Image STARTSWITH "C:\\Program Files\\Microsoft Office\\Root\\OFFICE" OR Image STARTSWITH "C:\\Program Files (x86)\\Microsoft Office\\Root\\OFFICE" OR Image STARTSWITH "C:\\PROGRA~2\\MICROS~2\\Office") AND (Image ENDSWITH "\\excel.exe" OR Image ENDSWITH "\\Integrator.exe" OR Image ENDSWITH "\\OneNote.exe" OR Image ENDSWITH "\\outlook.exe" OR Image ENDSWITH "\\powerpnt.exe" OR Image ENDSWITH "\\Teams.exe" OR Image ENDSWITH "\\visio.exe" OR Image ENDSWITH "\\winword.exe")) OR ((Image STARTSWITH "C:\\Program Files\\Common Files (x86)\\Microsoft Shared\\ClickToRun\\" OR Image STARTSWITH "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\") AND Image ENDSWITH "\\OfficeClickToRun.exe") OR ((Image EQ "C:\\Windows\\System32\\msiexec.exe" OR Image EQ "C:\\Windows\\SysWOW64\\msiexec.exe" OR Image EQ "C:\\Windows\\System32\\regsvr32.exe" OR Image EQ "C:\\Windows\\SysWOW64\\regsvr32.exe")) OR ((Image STARTSWITH "C:\\Program Files\\Common Files\\Microsoft Shared\\VSTO\\" OR Image STARTSWITH "C:\\Program Files (x86)\\Microsoft Shared\\VSTO\\") AND Image ENDSWITH "\\VSTOInstaller.exe"))) AND NOT ((((Image EQ "C:\\Program Files\\Avast Software\\Avast\\RegSvr.exe" OR Image EQ "C:\\Program Files (x86)\\Avast Software\\Avast\\RegSvr.exe") AND TargetObject CONTAINS "\\Microsoft\\Office\\Outlook\\Addins\\Avast.AsOutExt\\") OR ((Image EQ "C:\\Program Files\\AVG\\Antivirus\\RegSvr.exe" OR Image EQ "C:\\Program Files (x86)\\AVG\\Antivirus\\RegSvr.exe") AND TargetObject CONTAINS "\\Microsoft\\Office\\Outlook\\Addins\\Antivirus.AsOutExt\\"))))
