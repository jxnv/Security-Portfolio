// Title: Suspicious Installer Package Child Process
// ID: e0cfaecd-602d-41af-988d-f6ccebb2af26
// Status: test
// Level: medium
// Author: Sohan G (D4rkCiph3r)
// Date: 2023-02-18
// Tags: attack.t1059, attack.t1059.007, attack.t1071, attack.t1071.001, attack.execution, attack.command-and-control
// Description: Detects the execution of suspicious child processes from macOS installer package parent process. This includes osascript, JXA, curl and wget amongst other interpreters
// Converted by: Sigma Universal SIEM/EDR CLI

((ParentImage ENDSWITH "/package_script_service" OR ParentImage ENDSWITH "/installer") AND (Image ENDSWITH "/sh" OR Image ENDSWITH "/bash" OR Image ENDSWITH "/dash" OR Image ENDSWITH "/python" OR Image ENDSWITH "/ruby" OR Image ENDSWITH "/perl" OR Image ENDSWITH "/php" OR Image ENDSWITH "/javascript" OR Image ENDSWITH "/osascript" OR Image ENDSWITH "/tclsh" OR Image ENDSWITH "/curl" OR Image ENDSWITH "/wget") AND (CommandLine CONTAINS "preinstall" OR CommandLine CONTAINS "postinstall"))
