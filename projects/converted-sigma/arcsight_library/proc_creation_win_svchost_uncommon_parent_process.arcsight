// Title: Uncommon Svchost Parent Process
// ID: 01d2e2a1-5f09-44f7-9fc1-24faa7479b6d
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2017-08-15
// Tags: attack.stealth, attack.t1036.005
// Description: Detects an uncommon svchost parent process
// Converted by: Sigma Universal SIEM/EDR CLI

((Image ENDSWITH "\\svchost.exe") AND NOT ((((ParentImage ENDSWITH "\\Mrt.exe" OR ParentImage ENDSWITH "\\MsMpEng.exe" OR ParentImage ENDSWITH "\\ngen.exe" OR ParentImage ENDSWITH "\\rpcnet.exe" OR ParentImage ENDSWITH "\\services.exe" OR ParentImage ENDSWITH "\\TiWorker.exe")) OR ((ParentImage EQ "-" OR ParentImage EQ "")) OR (NOT ParentImage=*))))
