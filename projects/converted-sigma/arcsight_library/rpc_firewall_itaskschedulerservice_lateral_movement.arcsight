// Date: 2022-01-01
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.lateral-movement, attack.t1053, attack.t1053.002
// Description: Detects remote RPC calls to create or execute a scheduled task
// Converted by: Sigma Universal SIEM/EDR CLI

(EventLog EQ "RPCFW" AND EventID EQ "3" AND InterfaceUuid EQ "86d35949-83c9-4044-b424-db363231fd0c" AND (OpNum EQ "1" OR OpNum EQ "3" OR OpNum EQ "4" OR OpNum EQ "10" OR OpNum EQ "11" OR OpNum EQ "12" OR OpNum EQ "13" OR OpNum EQ "14" OR OpNum EQ "15"))
