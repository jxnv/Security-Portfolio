// Title: Suspicious Processes Spawned by Java.EXE
// ID: 0d34ed8b-1c12-4ff2-828c-16fc860b766d
// Status: test
// Level: high
// Author: Andreas Hunkeler (@Karneades), Florian Roth
// Date: 2021-12-17
// Tags: attack.initial-access, attack.persistence, attack.privilege-escalation
// Description: Detects suspicious processes spawned from a Java host process which could indicate a sign of exploitation (e.g. log4j)
// Converted by: Sigma Universal SIEM/EDR CLI

(ParentImage ENDSWITH "\\java.exe" AND (Image ENDSWITH "\\AppVLP.exe" OR Image ENDSWITH "\\bitsadmin.exe" OR Image ENDSWITH "\\certutil.exe" OR Image ENDSWITH "\\cscript.exe" OR Image ENDSWITH "\\curl.exe" OR Image ENDSWITH "\\forfiles.exe" OR Image ENDSWITH "\\hh.exe" OR Image ENDSWITH "\\mftrace.exe" OR Image ENDSWITH "\\mshta.exe" OR Image ENDSWITH "\\net.exe" OR Image ENDSWITH "\\net1.exe" OR Image ENDSWITH "\\query.exe" OR Image ENDSWITH "\\reg.exe" OR Image ENDSWITH "\\regsvr32.exe" OR Image ENDSWITH "\\rundll32.exe" OR Image ENDSWITH "\\schtasks.exe" OR Image ENDSWITH "\\scrcons.exe" OR Image ENDSWITH "\\scriptrunner.exe" OR Image ENDSWITH "\\sh.exe" OR Image ENDSWITH "\\systeminfo.exe" OR Image ENDSWITH "\\whoami.exe" OR Image ENDSWITH "\\wmic.exe" OR Image ENDSWITH "\\wscript.exe"))
