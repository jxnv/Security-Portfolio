// Title: Potential Initial Access via DLL Search Order Hijacking
// ID: dbbd9f66-2ed3-4ca2-98a4-6ea985dd1a1c
// Status: test
// Level: medium
// Author: Tim Rauch (rule), Elastic (idea)
// Date: 2022-10-21
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.stealth, attack.t1566, attack.t1566.001, attack.initial-access, attack.t1574, attack.t1574.001
// Description: Detects attempts to create a DLL file to a known desktop application dependencies folder such as Slack, Teams or OneDrive and by an unusual process. This may indicate an attempt to load a malicious module via DLL search order hijacking.
// Converted by: Sigma Universal SIEM/EDR CLI

(((Image ENDSWITH "\\winword.exe" OR Image ENDSWITH "\\excel.exe" OR Image ENDSWITH "\\powerpnt.exe" OR Image ENDSWITH "\\MSACCESS.EXE" OR Image ENDSWITH "\\MSPUB.EXE" OR Image ENDSWITH "\\fltldr.exe" OR Image ENDSWITH "\\cmd.exe" OR Image ENDSWITH "\\certutil.exe" OR Image ENDSWITH "\\mshta.exe" OR Image ENDSWITH "\\cscript.exe" OR Image ENDSWITH "\\wscript.exe" OR Image ENDSWITH "\\curl.exe" OR Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\pwsh.exe") AND TargetFilename ENDSWITH ".dll" AND (TargetFilename CONTAINS "\\Users\\" AND TargetFilename CONTAINS "\\AppData\\") AND (TargetFilename CONTAINS "\\Microsoft\\OneDrive\\" OR TargetFilename CONTAINS "\\Microsoft OneDrive\\" OR TargetFilename CONTAINS "\\Microsoft\\Teams\\" OR TargetFilename CONTAINS "\\Local\\slack\\app-" OR TargetFilename CONTAINS "\\Local\\Programs\\Microsoft VS Code\\")) AND NOT ((Image ENDSWITH "\\cmd.exe" AND (TargetFilename CONTAINS "\\Users\\" AND TargetFilename CONTAINS "\\AppData\\" AND TargetFilename CONTAINS "\\Microsoft\\OneDrive\\" AND TargetFilename CONTAINS "\\api-ms-win-core-"))))
