// Title: Potentially Suspicious GrantedAccess Flags On LSASS
// ID: a18dd26b-6450-46de-8c91-9659150cf088
// Status: test
// Level: medium
// Author: Florian Roth, Roberto Rodriguez, Dimitrios Slamaris, Mark Russinovich, Thomas Patzke, Teymur Kheirkhabarov, Sherif Eldeeb, James Dickenson, Aleksey Potapov, oscd.community
// Date: 2021-11-22
// Tags: attack.credential-access, attack.t1003.001, attack.s0002
// Description: Detects process access requests to LSASS process with potentially suspicious access flags
// Converted by: Sigma Universal SIEM/EDR CLI

(((((GrantedAccess ENDSWITH "30" OR GrantedAccess ENDSWITH "50" OR GrantedAccess ENDSWITH "70" OR GrantedAccess ENDSWITH "90" OR GrantedAccess ENDSWITH "B0" OR GrantedAccess ENDSWITH "D0" OR GrantedAccess ENDSWITH "F0" OR GrantedAccess ENDSWITH "18" OR GrantedAccess ENDSWITH "38" OR GrantedAccess ENDSWITH "58" OR GrantedAccess ENDSWITH "78" OR GrantedAccess ENDSWITH "98" OR GrantedAccess ENDSWITH "B8" OR GrantedAccess ENDSWITH "D8" OR GrantedAccess ENDSWITH "F8" OR GrantedAccess ENDSWITH "1A" OR GrantedAccess ENDSWITH "3A" OR GrantedAccess ENDSWITH "5A" OR GrantedAccess ENDSWITH "7A" OR GrantedAccess ENDSWITH "9A" OR GrantedAccess ENDSWITH "BA" OR GrantedAccess ENDSWITH "DA" OR GrantedAccess ENDSWITH "FA" OR GrantedAccess ENDSWITH "0x14C2")) OR ((GrantedAccess STARTSWITH "0x100000" OR GrantedAccess STARTSWITH "0x1418" OR GrantedAccess STARTSWITH "0x1438" OR GrantedAccess STARTSWITH "0x143a" OR GrantedAccess STARTSWITH "0x1f0fff" OR GrantedAccess STARTSWITH "0x1f1fff" OR GrantedAccess STARTSWITH "0x1f2fff" OR GrantedAccess STARTSWITH "0x1f3fff" OR GrantedAccess STARTSWITH "0x40"))) AND (TargetImage ENDSWITH "\\lsass.exe")) AND NOT (((SourceImage ENDSWITH "\\explorer.exe" AND GrantedAccess EQ "0x401") OR ((SourceImage CONTAINS ":\\Program Files (x86)\\" OR SourceImage CONTAINS ":\\Program Files\\" OR SourceImage CONTAINS ":\\Windows\\System32\\" OR SourceImage CONTAINS ":\\Windows\\SysWOW64\\")) OR (SourceImage CONTAINS ":\\ProgramData\\Microsoft\\Windows Defender\\" AND SourceImage ENDSWITH "\\MsMpEng.exe") OR ((CallTrace CONTAINS "|?:\\ProgramData\\Microsoft\\Windows Defender\\Definition Updates\\{" AND CallTrace CONTAINS "}\\mpengine.dll+") AND GrantedAccess EQ "0x1418") OR ((CallTrace CONTAINS "|c:\\program files\\windows defender\\mprtp.dll" OR CallTrace CONTAINS "|c:\\program files\\windows defender\\MpClient.dll")))) AND NOT (((SourceImage ENDSWITH ":\\ProgramData\\MALWAREBYTES\\MBAMSERVICE\\ctlrupdate\\mbupdatr.exe") OR (SourceImage ENDSWITH "\\MBAMInstallerService.exe" AND GrantedAccess EQ "0x40") OR ((SourceImage ENDSWITH "\\aurora-agent-64.exe" OR SourceImage ENDSWITH "\\aurora-agent.exe" OR SourceImage ENDSWITH "\\thor.exe" OR SourceImage ENDSWITH "\\thor64.exe") AND GrantedAccess EQ "0x40") OR (SourceImage CONTAINS "\\SteamLibrary\\steamapps\\") OR ((SourceImage ENDSWITH "\\handle.exe" OR SourceImage ENDSWITH "\\handle64.exe" OR SourceImage ENDSWITH "\\handle64a.exe") AND GrantedAccess EQ "0x40") OR ((SourceImage ENDSWITH "\\PROCEXP64.EXE" OR SourceImage ENDSWITH "\\PROCEXP.EXE") AND GrantedAccess EQ "0x40") OR (SourceImage CONTAINS ":\\ProgramData\\VMware\\VMware Tools\\" AND SourceImage ENDSWITH "\\vmtoolsd.exe") OR (SourceImage ENDSWITH "\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe") OR (SourceImage ENDSWITH "\\AppData\\Local\\WebEx\\WebexHost.exe" AND GrantedAccess EQ "0x401"))))
