R Image ENDSWITH "C:\\Program Files\\Microsoft\\EdgeUpdate\\MicrosoftEdgeUpdate.exe")) OR ((Image ENDSWITH "C:\\Program Files (x86)\\Microsoft OneDrive\\OneDrive.exe" OR Image ENDSWITH "C:\\Program Files\\Microsoft OneDrive\\OneDrive.exe")))))
