// Title: PUA - Netcat Suspicious Execution
// ID: e31033fc-33f0-4020-9a16-faf9b31cbf08
// Status: test
// Level: high
// Author: frack113, Florian Roth (Nextron Systems)
// Date: 2021-07-21
// Tags: attack.command-and-control, attack.t1095
// Description: Detects execution of Netcat. Adversaries may use a non-application layer protocol for communication between host and C2 server or among infected hosts within a network
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAINS " -lvp " OR CommandLine CONTAINS " -lvnp" OR CommandLine CONTAINS " -l -v -p " OR CommandLine CONTAINS " -lv -p " OR CommandLine CONTAINS " -l --proxy-type http " OR CommandLine CONTAINS " -vnl --exec " OR CommandLine CONTAINS " -vnl -e " OR CommandLine CONTAINS " --lua-exec " OR CommandLine CONTAINS " --sh-exec ")) OR ((Image ENDSWITH "\\nc.exe" OR Image ENDSWITH "\\ncat.exe" OR Image ENDSWITH "\\netcat.exe")))
