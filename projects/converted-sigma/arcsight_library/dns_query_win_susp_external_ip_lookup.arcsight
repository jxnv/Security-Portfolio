// Title: Suspicious DNS Query for IP Lookup Service APIs
// ID: ec82e2a5-81ea-4211-a1f8-37a0286df2c2
// Status: test
// Level: medium
// Author: Brandon George (blog post), Thomas Patzke
// Date: 2021-07-08
// Tags: attack.reconnaissance, attack.t1590
// Description: Detects DNS queries for IP lookup services such as "api.ipify.org" originating from a non browser process.
// Converted by: Sigma Universal SIEM/EDR CLI

((((QueryName EQ "www.ip.cn" OR QueryName EQ "l2.io")) OR ((QueryName CONTAINS "api.2ip.ua" OR QueryName CONTAINS "api.bigdatacloud.net" OR QueryName CONTAINS "api.ipify.org" OR QueryName CONTAINS "bot.whatismyipaddress.com" OR QueryName CONTAINS "canireachthe.net" OR QueryName CONTAINS "checkip.amazonaws.com" OR QueryName CONTAINS "checkip.dyndns.org" OR QueryName CONTAINS "curlmyip.com" OR QueryName CONTAINS "db-ip.com" OR QueryName CONTAINS "edns.ip-api.com" OR QueryName CONTAINS "eth0.me" OR QueryName CONTAINS "freegeoip.app" OR QueryName CONTAINS "geoipy.com" OR QueryName CONTAINS "getip.pro" OR QueryName CONTAINS "icanhazip.com" OR QueryName CONTAINS "ident.me" OR QueryName CONTAINS "ifconfig.io" OR QueryName CONTAINS "ifconfig.me" OR QueryName CONTAINS "ip-api.com" OR QueryName CONTAINS "ip.360.cn" OR QueryName CONTAINS "ip.anysrc.net" OR QueryName CONTAINS "ip.taobao.com" OR QueryName CONTAINS "ip.tyk.nu" OR QueryName CONTAINS "ipaddressworld.com" OR QueryName CONTAINS "ipapi.co" OR QueryName CONTAINS "ipconfig.io" OR QueryName CONTAINS "ipecho.net" OR QueryName CONTAINS "ipinfo.io" OR QueryName CONTAINS "ipip.net" OR QueryName CONTAINS "ipof.in" OR QueryName CONTAINS "ipv4.icanhazip.com" OR QueryName CONTAINS "ipv4bot.whatismyipaddress.com" OR QueryName CONTAINS "ipv6-test.com" OR QueryName CONTAINS "ipwho.is" OR QueryName CONTAINS "jsonip.com" OR QueryName CONTAINS "myexternalip.com" OR QueryName CONTAINS "seeip.org" OR QueryName CONTAINS "wgetip.com" OR QueryName CONTAINS "whatismyip.akamai.com" OR QueryName CONTAINS "whois.pconline.com.cn" OR QueryName CONTAINS "wtfismyip.com"))) AND NOT (((Image ENDSWITH "\\brave.exe") OR ((Image EQ "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR Image EQ "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((Image STARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") OR (Image ENDSWITH "\\WindowsApps\\MicrosoftEdge.exe") OR ((Image EQ "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR Image EQ "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((Image STARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" OR Image STARTSWITH "C:\\Program Files\\Microsoft\\EdgeCore\\") AND (Image ENDSWITH "\\msedge.exe" OR Image ENDSWITH "\\msedgewebview2.exe")) OR ((Image EQ "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR Image EQ "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR ((Image EQ "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR Image EQ "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (Image ENDSWITH "\\maxthon.exe") OR (Image ENDSWITH "\\opera.exe") OR (Image ENDSWITH "\\safari.exe") OR (Image ENDSWITH "\\seamonkey.exe") OR (Image ENDSWITH "\\vivaldi.exe") OR (Image ENDSWITH "\\whale.exe"))))
