// Title: Arbitrary DLL or Csproj Code Execution Via Dotnet.EXE
// ID: d80d5c81-04ba-45b4-84e4-92eba40e0ad3
// Status: test
// Level: medium
// Author: Beyu Denis, oscd.community
// Date: 2020-10-18
// Tags: attack.stealth, attack.t1218
// Description: Detects execution of arbitrary DLLs or unsigned code via a ".csproj" files via Dotnet.EXE.
// Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine ENDSWITH ".csproj" OR CommandLine ENDSWITH ".csproj\"" OR CommandLine ENDSWITH ".dll" OR CommandLine ENDSWITH ".dll\"" OR CommandLine ENDSWITH ".csproj'" OR CommandLine ENDSWITH ".dll'")) AND ((Image ENDSWITH "\\dotnet.exe") OR (OriginalFileName EQ ".NET Host"))) AND NOT (((ParentImage EQ "C:\\Program Files (x86)\\Notepad++\\notepad++.exe" OR ParentImage EQ "C:\\Program Files\\Notepad++\\notepad++.exe") AND (CommandLine CONTAINS "C:\\ProgramData\\CSScriptNpp\\" AND CommandLine CONTAINS "-cscs_path:" AND CommandLine CONTAINS "\\cs-script\\cscs.dll"))))
