// Title: Potential Python DLL SideLoading
// ID: d36f7c12-14a3-4d48-b6b8-774b9c66f44d
// Status: test
// Level: medium
// Author: Swachchhanda Shrawan Poudel
// Date: 2024-10-06
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of Python DLL files.
// Converted by: Sigma Universal SIEM/EDR CLI

(((ImageLoaded ENDSWITH "\\python39.dll" OR ImageLoaded ENDSWITH "\\python310.dll" OR ImageLoaded ENDSWITH "\\python311.dll" OR ImageLoaded ENDSWITH "\\python312.dll")) AND NOT (((((ImageLoaded STARTSWITH "C:\\Program Files\\Python3" OR ImageLoaded STARTSWITH "C:\\Program Files (x86)\\Python3")) OR (ImageLoaded CONTAINS "\\AppData\\Local\\Programs\\Python\\Python3")) OR (Product EQ "Python" AND Signed EQ "true" AND Description EQ "Python" AND Company EQ "Python Software Foundation"))) AND NOT (((ImageLoaded STARTSWITH "C:\\ProgramData\\Anaconda3\\") OR ((ImageLoaded CONTAINS "\\cpython\\externals\\" OR ImageLoaded CONTAINS "\\cpython\\PCbuild\\")) OR (ImageLoaded STARTSWITH "C:\\Users" AND ImageLoaded CONTAINS "\\AppData\\Local\\Temp\\_MEI") OR (ImageLoaded STARTSWITH "C:\\Program Files\\Microsoft Visual Studio\\"))))
