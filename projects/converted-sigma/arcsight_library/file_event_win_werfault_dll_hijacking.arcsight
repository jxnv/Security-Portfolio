// Title: Creation of WerFault.exe/Wer.dll in Unusual Folder
// ID: 28a452f3-786c-4fd8-b8f2-bddbe9d616d1
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-05-09
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects the creation of a file named "WerFault.exe" or "wer.dll" in an uncommon folder, which could be a sign of WerFault DLL hijacking.
// Converted by: Sigma Universal SIEM/EDR CLI

(((TargetFilename ENDSWITH "\\WerFault.exe" OR TargetFilename ENDSWITH "\\wer.dll")) AND NOT ((((TargetFilename STARTSWITH "C:\\Windows\\SoftwareDistribution\\" OR TargetFilename STARTSWITH "C:\\Windows\\System32\\" OR TargetFilename STARTSWITH "C:\\Windows\\SysWOW64\\" OR TargetFilename STARTSWITH "C:\\Windows\\WinSxS\\" OR TargetFilename STARTSWITH "C:\\Windows\\UUS\\")) OR (Image ENDSWITH "\\wuaucltcore.exe"))))
