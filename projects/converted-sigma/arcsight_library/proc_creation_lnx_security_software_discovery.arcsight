// Title: Security Software Discovery - Linux
// ID: c9d8b7fd-78e4-44fe-88f6-599135d46d60
// Status: test
// Level: low
// Author: Daniil Yugoslavskiy, oscd.community
// Date: 2020-10-19
// Tags: attack.discovery, attack.t1518.001
// Description: Detects usage of system utilities (only grep and egrep for now) to discover security software discovery
// Converted by: Sigma Universal SIEM/EDR CLI

((Image ENDSWITH "/grep" OR Image ENDSWITH "/egrep") AND (CommandLine CONTAINS "nessusd" OR CommandLine CONTAINS "td-agent" OR CommandLine CONTAINS "packetbeat" OR CommandLine CONTAINS "filebeat" OR CommandLine CONTAINS "auditbeat" OR CommandLine CONTAINS "osqueryd" OR CommandLine CONTAINS "cbagentd" OR CommandLine CONTAINS "falcond"))
