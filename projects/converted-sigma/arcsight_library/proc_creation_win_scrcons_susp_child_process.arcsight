// Title: Script Event Consumer Spawning Process
// ID: f6d1dd2f-b8ce-40ca-bc23-062efb686b34
// Status: test
// Level: high
// Author: Sittikorn S
// Date: 2021-06-21
// Tags: attack.execution, attack.t1047
// Description: Detects a suspicious child process of Script Event Consumer (scrcons.exe).
// Converted by: Sigma Universal SIEM/EDR CLI

(ParentImage ENDSWITH "\\scrcons.exe" AND (Image ENDSWITH "\\svchost.exe" OR Image ENDSWITH "\\dllhost.exe" OR Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\pwsh.exe" OR Image ENDSWITH "\\wscript.exe" OR Image ENDSWITH "\\cscript.exe" OR Image ENDSWITH "\\schtasks.exe" OR Image ENDSWITH "\\regsvr32.exe" OR Image ENDSWITH "\\mshta.exe" OR Image ENDSWITH "\\rundll32.exe" OR Image ENDSWITH "\\msiexec.exe" OR Image ENDSWITH "\\msbuild.exe"))
