// Title: LOLBIN Execution From Abnormal Drive
// ID: d4ca7c59-e9e4-42d8-bf57-91a776efcb87
// Status: test
// Level: medium
// Author: Christopher Peacock '@securepeacock', SCYTHE '@scythe_io', Angelo Violetti - SEC Consult '@angelo_violetti', Aaron Herman
// Date: 2022-01-25
// Tags: attack.stealth
// Description: Detects LOLBINs executing from an abnormal or uncommon drive such as a mounted ISO.
// Converted by: Sigma Universal SIEM/EDR CLI

((((Image ENDSWITH "\\calc.exe" OR Image ENDSWITH "\\certutil.exe" OR Image ENDSWITH "\\cmstp.exe" OR Image ENDSWITH "\\cscript.exe" OR Image ENDSWITH "\\installutil.exe" OR Image ENDSWITH "\\mshta.exe" OR Image ENDSWITH "\\regsvr32.exe" OR Image ENDSWITH "\\rundll32.exe" OR Image ENDSWITH "\\wscript.exe")) OR ((OriginalFileName EQ "CALC.EXE" OR OriginalFileName EQ "CertUtil.exe" OR OriginalFileName EQ "CMSTP.EXE" OR OriginalFileName EQ "cscript.exe" OR OriginalFileName EQ "installutil.exe" OR OriginalFileName EQ "MSHTA.EXE" OR OriginalFileName EQ "REGSVR32.EXE" OR OriginalFileName EQ "RUNDLL32.EXE" OR OriginalFileName EQ "wscript.exe"))) AND NOT (((CurrentDirectory CONTAINS "C:\\") OR (CurrentDirectory EQ "") OR (NOT CurrentDirectory=*))))
