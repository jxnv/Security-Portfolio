// Title: Suspicious Curl.EXE Download
// ID: e218595b-bbe7-4ee5-8a96-f32a24ad3468
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2020-07-03
// Tags: attack.command-and-control, attack.t1105
// Description: Detects a suspicious curl process start on Windows and outputs the requested document to a local file
// Converted by: Sigma Universal SIEM/EDR CLI

(((Image ENDSWITH "\\curl.exe") OR (Product EQ "The curl executable")) AND (((CommandLine ENDSWITH ".dll" OR CommandLine ENDSWITH ".gif" OR CommandLine ENDSWITH ".jpeg" OR CommandLine ENDSWITH ".jpg" OR CommandLine ENDSWITH ".png" OR CommandLine ENDSWITH ".temp" OR CommandLine ENDSWITH ".tmp" OR CommandLine ENDSWITH ".txt" OR CommandLine ENDSWITH ".vbe" OR CommandLine ENDSWITH ".vbs")) OR ((CommandLine CONTAINS "%AppData%" OR CommandLine CONTAINS "%Public%" OR CommandLine CONTAINS "%Temp%" OR CommandLine CONTAINS "%tmp%" OR CommandLine CONTAINS "\\AppData\\" OR CommandLine CONTAINS "\\Desktop\\" OR CommandLine CONTAINS "\\Temp\\" OR CommandLine CONTAINS "\\Users\\Public\\" OR CommandLine CONTAINS "C:\\PerfLogs\\" OR CommandLine CONTAINS "C:\\ProgramData\\" OR CommandLine CONTAINS "C:\\Windows\\Temp\\"))) AND NOT ((ParentImage EQ "C:\\Program Files\\Git\\usr\\bin\\sh.exe" AND Image EQ "C:\\Program Files\\Git\\mingw64\\bin\\curl.exe" AND (CommandLine CONTAINS "--silent --show-error --output " AND CommandLine CONTAINS "gfw-httpget-" AND CommandLine CONTAINS "AppData"))))
