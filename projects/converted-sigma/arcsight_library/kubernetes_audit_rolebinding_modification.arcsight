// Title: Kubernetes Rolebinding Modification
// ID: 10b97915-ec8d-455f-a815-9a78926585f6
// Status: test
// Level: medium
// Author: kelnage
// Date: 2024-07-11
// Tags: attack.privilege-escalation
// Description: Detects when a Kubernetes Rolebinding is created or modified.
// Converted by: Sigma Universal SIEM/EDR CLI

(objectRef.apiGroup EQ "rbac.authorization.k8s.io" AND (objectRef.resource EQ "clusterrolebindings" OR objectRef.resource EQ "rolebindings") AND (verb EQ "create" OR verb EQ "delete" OR verb EQ "patch" OR verb EQ "replace" OR verb EQ "update"))
