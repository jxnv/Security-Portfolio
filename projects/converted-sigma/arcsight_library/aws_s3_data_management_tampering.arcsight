// Title: AWS S3 Data Management Tampering
// ID: 78b3756a-7804-4ef7-8555-7b9024a02e2d
// Status: test
// Level: low
// Author: Austin Songer @austinsonger
// Date: 2021-07-24
// Tags: attack.exfiltration, attack.t1537
// Description: Detects when a user tampers with S3 data management in Amazon Web Services.
// Converted by: Sigma Universal SIEM/EDR CLI

(eventSource EQ "s3.amazonaws.com" AND (eventName EQ "PutBucketLogging" OR eventName EQ "PutBucketWebsite" OR eventName EQ "PutEncryptionConfiguration" OR eventName EQ "PutLifecycleConfiguration" OR eventName EQ "PutReplicationConfiguration" OR eventName EQ "ReplicateObject" OR eventName EQ "RestoreObject"))
