// Tags: attack.command-and-control, attack.lateral-movement, attack.t1090.001, attack.t1090.002, attack.t1021.001, car.2013-07-002
// Description: Detects svchost hosting RDP termsvcs communicating with the loopback address
// Converted by: Sigma Universal SIEM/EDR CLI

((EventID EQ "5156") AND ((SourcePort EQ "3389" AND (DestAddress EQ "127.*" OR DestAddress EQ "::1")) OR (DestPort EQ "3389" AND (SourceAddress EQ "127.*" OR SourceAddress EQ "::1"))) AND NOT (((FilterOrigin EQ "AppContainer Loopback") OR ((Application ENDSWITH "\\thor.exe" OR Application ENDSWITH "\\thor64.exe")))))
