// Title: Unusual Parent Process For Cmd.EXE
// ID: 4b991083-3d0e-44ce-8fc4-b254025d8d4b
// Status: test
// Level: medium
// Author: Tim Rauch, Elastic (idea)
// Date: 2022-09-21
// Tags: attack.execution, attack.t1059
// Description: Detects suspicious parent process for cmd.exe
// Converted by: Sigma Universal SIEM/EDR CLI

(Image ENDSWITH "\\cmd.exe" AND (ParentImage ENDSWITH "\\csrss.exe" OR ParentImage ENDSWITH "\\ctfmon.exe" OR ParentImage ENDSWITH "\\dllhost.exe" OR ParentImage ENDSWITH "\\epad.exe" OR ParentImage ENDSWITH "\\FlashPlayerUpdateService.exe" OR ParentImage ENDSWITH "\\GoogleUpdate.exe" OR ParentImage ENDSWITH "\\jucheck.exe" OR ParentImage ENDSWITH "\\jusched.exe" OR ParentImage ENDSWITH "\\LogonUI.exe" OR ParentImage ENDSWITH "\\lsass.exe" OR ParentImage ENDSWITH "\\regsvr32.exe" OR ParentImage ENDSWITH "\\SearchIndexer.exe" OR ParentImage ENDSWITH "\\SearchProtocolHost.exe" OR ParentImage ENDSWITH "\\SIHClient.exe" OR ParentImage ENDSWITH "\\sihost.exe" OR ParentImage ENDSWITH "\\slui.exe" OR ParentImage ENDSWITH "\\spoolsv.exe" OR ParentImage ENDSWITH "\\sppsvc.exe" OR ParentImage ENDSWITH "\\taskhostw.exe" OR ParentImage ENDSWITH "\\unsecapp.exe" OR ParentImage ENDSWITH "\\WerFault.exe" OR ParentImage ENDSWITH "\\wermgr.exe" OR ParentImage ENDSWITH "\\wlanext.exe" OR ParentImage ENDSWITH "\\WUDFHost.exe"))
