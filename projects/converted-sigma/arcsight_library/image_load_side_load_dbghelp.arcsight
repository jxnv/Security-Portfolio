// Title: Potential DLL Sideloading Of DBGHELP.DLL
// ID: 6414b5cd-b19d-447e-bb5e-9f03940b5784
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Wietze Beukema (project and research)
// Date: 2022-10-25
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of "dbghelp.dll"
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageLoaded ENDSWITH "\\dbghelp.dll") AND NOT (((ImageLoaded STARTSWITH "C:\\Program Files (x86)\\" OR ImageLoaded STARTSWITH "C:\\Program Files\\" OR ImageLoaded STARTSWITH "C:\\Windows\\SoftwareDistribution\\" OR ImageLoaded STARTSWITH "C:\\Windows\\System32\\" OR ImageLoaded STARTSWITH "C:\\Windows\\SystemTemp\\" OR ImageLoaded STARTSWITH "C:\\Windows\\SysWOW64\\" OR ImageLoaded STARTSWITH "C:\\Windows\\WinSxS\\"))) AND NOT ((((ImageLoaded ENDSWITH "\\Anaconda3\\Lib\\site-packages\\vtrace\\platforms\\windll\\amd64\\dbghelp.dll" OR ImageLoaded ENDSWITH "\\Anaconda3\\Lib\\site-packages\\vtrace\\platforms\\windll\\i386\\dbghelp.dll")) OR ((ImageLoaded ENDSWITH "\\Epic Games\\Launcher\\Engine\\Binaries\\ThirdParty\\DbgHelp\\dbghelp.dll" OR ImageLoaded ENDSWITH "\\Epic Games\\MagicLegends\\x86\\dbghelp.dll")) OR (ImageLoaded CONTAINS "opera\\Opera Installer Temp\\opera_package" AND ImageLoaded ENDSWITH "\\assistant\\dbghelp.dll"))))
