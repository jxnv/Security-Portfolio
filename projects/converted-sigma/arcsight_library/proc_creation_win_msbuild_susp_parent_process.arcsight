// Title: Suspicious Msbuild Execution By Uncommon Parent Process
// ID: 33be4333-2c6b-44f4-ae28-102cdbde0a31
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-11-17
// Tags: attack.stealth
// Description: Detects suspicious execution of 'Msbuild.exe' by a uncommon parent process
// Converted by: Sigma Universal SIEM/EDR CLI

(((Image ENDSWITH "\\MSBuild.exe") OR (OriginalFileName EQ "MSBuild.exe")) AND NOT (((ParentImage ENDSWITH "\\devenv.exe" OR ParentImage ENDSWITH "\\cmd.exe" OR ParentImage ENDSWITH "\\msbuild.exe" OR ParentImage ENDSWITH "\\python.exe" OR ParentImage ENDSWITH "\\explorer.exe" OR ParentImage ENDSWITH "\\nuget.exe"))))
