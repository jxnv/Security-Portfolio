// Description: Detects known hacktool execution based on image name.
// Converted by: Sigma Universal SIEM/EDR CLI

(((Image CONTAINS "/cobaltstrike" OR Image CONTAINS "/teamserver")) OR ((Image ENDSWITH "/crackmapexec" OR Image ENDSWITH "/havoc" OR Image ENDSWITH "/merlin-agent" OR Image ENDSWITH "/merlinServer-Linux-x64" OR Image ENDSWITH "/msfconsole" OR Image ENDSWITH "/msfvenom" OR Image ENDSWITH "/ps-empire server" OR Image ENDSWITH "/ps-empire" OR Image ENDSWITH "/sliver-client" OR Image ENDSWITH "/sliver-server" OR Image ENDSWITH "/Villain.py")) OR ((Image ENDSWITH "/aircrack-ng" OR Image ENDSWITH "/bloodhound-python" OR Image ENDSWITH "/bpfdos" OR Image ENDSWITH "/ebpfki" OR Image ENDSWITH "/evil-winrm" OR Image ENDSWITH "/hashcat" OR Image ENDSWITH "/hoaxshell.py" OR Image ENDSWITH "/hydra" OR Image ENDSWITH "/john" OR Image ENDSWITH "/ncrack" OR Image ENDSWITH "/nxc-ubuntu-latest" OR Image ENDSWITH "/pidhide" OR Image ENDSWITH "/pspy32" OR Image ENDSWITH "/pspy32s" OR Image ENDSWITH "/pspy64" OR Image ENDSWITH "/pspy64s" OR Image ENDSWITH "/setoolkit" OR Image ENDSWITH "/sqlmap" OR Image ENDSWITH "/writeblocker")) OR (Image CONTAINS "/linpeas") OR ((Image ENDSWITH "/autorecon" OR Image ENDSWITH "/httpx" OR Image ENDSWITH "/legion" OR Image ENDSWITH "/naabu" OR Image ENDSWITH "/netdiscover" OR Image ENDSWITH "/nuclei" OR Image ENDSWITH "/recon-ng")) OR (Image CONTAINS "/sniper") OR ((Image ENDSWITH "/dirb" OR Image ENDSWITH "/dirbuster" OR Image ENDSWITH "/eyewitness" OR Image ENDSWITH "/feroxbuster" OR Image ENDSWITH "/ffuf" OR Image ENDSWITH "/gobuster" OR Image ENDSWITH "/wfuzz" OR Image ENDSWITH "/whatweb")) OR ((Image ENDSWITH "/joomscan" OR Image ENDSWITH "/nikto" OR Image ENDSWITH "/wpscan")))
