// Title: Change PowerShell Policies to an Insecure Level
// ID: 87e3c4e8-a6a8-4ad9-bb4f-46e7ff99a180
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-11-01
// Tags: attack.execution, attack.t1059.001
// Description: Detects changing the PowerShell script execution policy to a potentially insecure level using the "-ExecutionPolicy" flag.
// Converted by: Sigma Universal SIEM/EDR CLI

(((((OriginalFileName EQ "powershell_ise.exe" OR OriginalFileName EQ "PowerShell.EXE" OR OriginalFileName EQ "pwsh.dll")) OR ((Image ENDSWITH "\\powershell_ise.exe" OR Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\pwsh.exe"))) AND ((CommandLine CONTAINS "Bypass" OR CommandLine CONTAINS "Unrestricted")) AND ((CommandLine CONTAINS "-executionpolicy " OR CommandLine CONTAINS " -ep " OR CommandLine CONTAINS " -exec "))) AND NOT (((ParentImage EQ "C:\\Windows\\SysWOW64\\msiexec.exe" OR ParentImage EQ "C:\\Windows\\System32\\msiexec.exe") AND (CommandLine CONTAINS "-NoProfile -ExecutionPolicy Bypass -File \"C:\\Program Files\\PowerShell\\7\\" OR CommandLine CONTAINS "-NoProfile -ExecutionPolicy Bypass -File \"C:\\Program Files (x86)\\PowerShell\\7\\"))) AND NOT (((ParentImage CONTAINS "C:\\Program Files\\Avast Software\\Avast\\" OR ParentImage CONTAINS "C:\\Program Files (x86)\\Avast Software\\Avast\\" OR ParentImage CONTAINS "\\instup.exe") AND (CommandLine CONTAINS "-ExecutionPolicy ByPass -File \"C:\\Program Files\\Avast Software\\Avast" OR CommandLine CONTAINS "-ExecutionPolicy ByPass -File \"C:\\Program Files (x86)\\Avast Software\\Avast\\"))))
