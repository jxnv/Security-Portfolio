// Description: WinPEAS is a script that search for possible paths to escalate privileges on Windows hosts. The checks are explained on book.hacktricks.xyz
// Converted by: Sigma Universal SIEM/EDR CLI

((CommandLine CONTAINS "https://github.com/carlospolop/PEASS-ng/releases/latest/download/") OR ((CommandLine CONTAINS " applicationsinfo" OR CommandLine CONTAINS " browserinfo" OR CommandLine CONTAINS " eventsinfo" OR CommandLine CONTAINS " fileanalysis" OR CommandLine CONTAINS " filesinfo" OR CommandLine CONTAINS " processinfo" OR CommandLine CONTAINS " servicesinfo" OR CommandLine CONTAINS " windowscreds")) OR ((ParentCommandLine ENDSWITH " -linpeas") OR (CommandLine ENDSWITH " -linpeas")) OR ((OriginalFileName EQ "winPEAS.exe") OR ((Image ENDSWITH "\\winPEASany_ofs.exe" OR Image ENDSWITH "\\winPEASany.exe" OR Image ENDSWITH "\\winPEASx64_ofs.exe" OR Image ENDSWITH "\\winPEASx64.exe" OR Image ENDSWITH "\\winPEASx86_ofs.exe" OR Image ENDSWITH "\\winPEASx86.exe"))))
