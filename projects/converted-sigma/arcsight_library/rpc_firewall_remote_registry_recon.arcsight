// Title: Remote Registry Recon
// ID: d8ffe17e-04be-4886-beb9-c1dd1944b9a8
// Status: test
// Level: high
// Author: Sagie Dulce, Dekel Paz
// Date: 2022-01-01
// Tags: attack.discovery
// Description: Detects remote RPC calls to collect information
// Converted by: Sigma Universal SIEM/EDR CLI

((EventLog EQ "RPCFW" AND EventID EQ "3" AND InterfaceUuid EQ "338cd001-2244-31f1-aaaa-900038001003") AND NOT (((OpNum EQ "6" OR OpNum EQ "7" OR OpNum EQ "8" OR OpNum EQ "13" OR OpNum EQ "18" OR OpNum EQ "19" OR OpNum EQ "21" OR OpNum EQ "22" OR OpNum EQ "23" OR OpNum EQ "35"))))
