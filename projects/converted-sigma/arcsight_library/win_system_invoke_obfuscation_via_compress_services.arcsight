// Title: Invoke-Obfuscation COMPRESS OBFUSCATION - System
// ID: 175997c5-803c-4b08-8bb0-70b099f47595
// Status: test
// Level: medium
// Author: Timur Zinniatullin, oscd.community
// Date: 2020-10-18
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via COMPRESS OBFUSCATION
// Converted by: Sigma Universal SIEM/EDR CLI

(Provider_Name EQ "Service Control Manager" AND EventID EQ "7045" AND (ImagePath CONTAINS "new-object" AND ImagePath CONTAINS "text.encoding]::ascii" AND ImagePath CONTAINS "readtoend") AND (ImagePath CONTAINS ":system.io.compression.deflatestream" OR ImagePath CONTAINS "system.io.streamreader"))
