// Title: Suspicious Non-Browser Network Communication With Telegram API
// ID: c3dbbc9f-ef1d-470a-a90a-d343448d5875
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-19
// Tags: attack.command-and-control, attack.exfiltration, attack.t1102, attack.t1567, attack.t1105
// Description: Detects an a non-browser process interacting with the Telegram API which could indicate use of a covert C2
// Converted by: Sigma Universal SIEM/EDR CLI

((DestinationHostname CONTAINS "api.telegram.org") AND NOT (((Image ENDSWITH "\\brave.exe") OR ((Image EQ "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR Image EQ "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((Image STARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") OR (Image ENDSWITH "\\WindowsApps\\MicrosoftEdge.exe") OR ((Image EQ "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR Image EQ "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((Image STARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" OR Image STARTSWITH "C:\\Program Files\\Microsoft\\EdgeCore\\") AND (Image ENDSWITH "\\msedge.exe" OR Image ENDSWITH "\\msedgewebview2.exe")) OR ((Image EQ "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR Image EQ "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR ((Image EQ "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR Image EQ "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (Image ENDSWITH "\\maxthon.exe") OR (Image ENDSWITH "\\opera.exe") OR (Image ENDSWITH "\\safari.exe") OR (Image ENDSWITH "\\seamonkey.exe") OR (Image ENDSWITH "\\vivaldi.exe") OR (Image ENDSWITH "\\whale.exe"))))
