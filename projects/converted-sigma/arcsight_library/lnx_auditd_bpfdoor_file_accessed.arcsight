// Title: BPFDoor Abnormal Process ID or Lock File Accessed
// ID: 808146b2-9332-4d78-9416-d7e47012d83d
// Status: test
// Level: high
// Author: Rafal Piasecki
// Date: 2022-08-10
// Tags: attack.execution, attack.t1106, attack.t1059
// Description: detects BPFDoor .lock and .pid files access in temporary file storage facility
// Converted by: Sigma Universal SIEM/EDR CLI

(type EQ "PATH" AND (name EQ "/var/run/aepmonend.pid" OR name EQ "/var/run/auditd.lock" OR name EQ "/var/run/cma.lock" OR name EQ "/var/run/console-kit.pid" OR name EQ "/var/run/consolekit.pid" OR name EQ "/var/run/daemon.pid" OR name EQ "/var/run/hald-addon.pid" OR name EQ "/var/run/hald-smartd.pid" OR name EQ "/var/run/haldrund.pid" OR name EQ "/var/run/hp-health.pid" OR name EQ "/var/run/hpasmlit.lock" OR name EQ "/var/run/hpasmlited.pid" OR name EQ "/var/run/kdevrund.pid" OR name EQ "/var/run/lldpad.lock" OR name EQ "/var/run/mcelog.pid" OR name EQ "/var/run/system.pid" OR name EQ "/var/run/uvp-srv.pid" OR name EQ "/var/run/vmtoolagt.pid" OR name EQ "/var/run/xinetd.lock"))
