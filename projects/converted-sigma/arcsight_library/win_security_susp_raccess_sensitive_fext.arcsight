// Title: Suspicious Access to Sensitive File Extensions
// ID: 91c945bc-2ad1-4799-a591-4d00198a1215
// Status: test
// Level: medium
// Author: Samir Bousseaden
// Date: 2019-04-03
// Tags: attack.collection, attack.t1039
// Description: Detects known sensitive file extensions accessed on a network share
// Converted by: Sigma Universal SIEM/EDR CLI

(EventID EQ "5145" AND (RelativeTargetName ENDSWITH ".bak" OR RelativeTargetName ENDSWITH ".dmp" OR RelativeTargetName ENDSWITH ".edb" OR RelativeTargetName ENDSWITH ".kirbi" OR RelativeTargetName ENDSWITH ".msg" OR RelativeTargetName ENDSWITH ".nsf" OR RelativeTargetName ENDSWITH ".nst" OR RelativeTargetName ENDSWITH ".oab" OR RelativeTargetName ENDSWITH ".ost" OR RelativeTargetName ENDSWITH ".pst" OR RelativeTargetName ENDSWITH ".rdp"))
