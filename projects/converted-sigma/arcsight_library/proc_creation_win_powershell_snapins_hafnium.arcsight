// Title: Exchange PowerShell Snap-Ins Usage
// ID: 25676e10-2121-446e-80a4-71ff8506af47
// Status: test
// Level: high
// Author: FPT.EagleEye, Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-03-03
// Tags: attack.execution, attack.t1059.001, attack.collection, attack.t1114
// Description: Detects adding and using Exchange PowerShell snap-ins to export mailbox data. As seen used by HAFNIUM and APT27
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAINS "Add-PSSnapin") AND (((Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\pwsh.exe")) OR ((OriginalFileName EQ "PowerShell.EXE" OR OriginalFileName EQ "pwsh.dll"))) AND ((CommandLine CONTAINS "Microsoft.Exchange.Powershell.Snapin" OR CommandLine CONTAINS "Microsoft.Exchange.Management.PowerShell.SnapIn"))) AND NOT ((ParentImage EQ "C:\\Windows\\System32\\msiexec.exe" AND CommandLine CONTAINS "$exserver=Get-ExchangeServer ([Environment]::MachineName) -ErrorVariable exerr 2> $null")))
