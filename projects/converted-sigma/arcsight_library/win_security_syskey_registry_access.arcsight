// Title: SysKey Registry Keys Access
// ID: 9a4ff3b8-6187-4fd2-8e8b-e0eae1129495
// Status: test
// Level: high
// Author: Roberto Rodriguez @Cyb3rWard0g
// Date: 2019-08-12
// Tags: attack.discovery, attack.t1012
// Description: Detects handle requests and access operations to specific registry keys to calculate the SysKey
// Converted by: Sigma Universal SIEM/EDR CLI

((EventID EQ "4656" OR EventID EQ "4663") AND ObjectType EQ "key" AND (ObjectName ENDSWITH "lsa\\JD" OR ObjectName ENDSWITH "lsa\\GBG" OR ObjectName ENDSWITH "lsa\\Skew1" OR ObjectName ENDSWITH "lsa\\Data"))
