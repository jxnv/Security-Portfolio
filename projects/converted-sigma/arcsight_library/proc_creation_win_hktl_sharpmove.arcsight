// Title: HackTool - SharpMove Tool Execution
// ID: 055fb54c-a8f4-4aee-bd44-f74cf30a0d9d
// Status: test
// Level: high
// Author: Luca Di Bartolomeo (CrimpSec)
// Date: 2024-01-29
// Tags: attack.lateral-movement, attack.t1021.002
// Description: Detects the execution of SharpMove, a .NET utility performing multiple tasks such as "Task Creation", "SCM" query, VBScript execution using WMI via its PE metadata and command line options.
// Converted by: Sigma Universal SIEM/EDR CLI

(((Image ENDSWITH "\\SharpMove.exe") OR (OriginalFileName EQ "SharpMove.exe")) OR (((CommandLine CONTAINS "action=create" OR CommandLine CONTAINS "action=dcom" OR CommandLine CONTAINS "action=executevbs" OR CommandLine CONTAINS "action=hijackdcom" OR CommandLine CONTAINS "action=modschtask" OR CommandLine CONTAINS "action=modsvc" OR CommandLine CONTAINS "action=query" OR CommandLine CONTAINS "action=scm" OR CommandLine CONTAINS "action=startservice" OR CommandLine CONTAINS "action=taskscheduler")) AND (CommandLine CONTAINS "computername=")))
