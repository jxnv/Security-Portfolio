// Title: New Module Module Added To IIS Server
// ID: dd857d3e-0c6e-457b-9b48-e82ae7f86bd7
// Status: test
// Level: medium
// Author: frack113
// Date: 2024-10-06
// Tags: attack.persistence, attack.defense-impairment, attack.t1685.001, attack.t1505.004
// Description: Detects the addition of a new module to an IIS server.
// Converted by: Sigma Universal SIEM/EDR CLI

((EventID EQ "29" AND Configuration CONTAINS "/system.webServer/modules/add") AND NOT ((((NewValue EQ "AnonymousAuthenticationModule" OR NewValue EQ "CustomErrorModule" OR NewValue EQ "DefaultDocumentModule" OR NewValue EQ "DirectoryListingModule" OR NewValue EQ "FileCacheModule" OR NewValue EQ "HttpCacheModule" OR NewValue EQ "HttpLoggingModule" OR NewValue EQ "ProtocolSupportModule" OR NewValue EQ "RequestFilteringModule" OR NewValue EQ "StaticCompressionModule" OR NewValue EQ "StaticFileModule" OR NewValue EQ "TokenCacheModule" OR NewValue EQ "UriCacheModule")) OR (NewValue EQ ""))))
