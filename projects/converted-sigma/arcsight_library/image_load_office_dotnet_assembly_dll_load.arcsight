// Title: DotNET Assembly DLL Loaded Via Office Application
// ID: ff0f2b05-09db-4095-b96d-1b75ca24894a
// Status: test
// Level: medium
// Author: Antonlovesdnb
// Date: 2020-02-19
// Tags: attack.execution, attack.t1204.002
// Description: Detects any assembly DLL being loaded by an Office Product
// Converted by: Sigma Universal SIEM/EDR CLI

((Image ENDSWITH "\\excel.exe" OR Image ENDSWITH "\\mspub.exe" OR Image ENDSWITH "\\onenote.exe" OR Image ENDSWITH "\\onenoteim.exe" OR Image ENDSWITH "\\outlook.exe" OR Image ENDSWITH "\\powerpnt.exe" OR Image ENDSWITH "\\winword.exe") AND ImageLoaded STARTSWITH "C:\\Windows\\assembly\\")
