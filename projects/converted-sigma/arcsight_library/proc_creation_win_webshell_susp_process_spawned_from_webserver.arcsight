// Title: Suspicious Process By Web Server Process
// ID: 8202070f-edeb-4d31-a010-a26c72ac5600
// Status: test
// Level: high
// Author: Thomas Patzke, Florian Roth (Nextron Systems), Zach Stanford @svch0st, Tim Shelton, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-01-16
// Tags: attack.persistence, attack.initial-access, attack.t1505.003, attack.t1190
// Description: Detects potentially suspicious processes being spawned by a web server process which could be the result of a successfully placed web shell or exploitation
// Converted by: Sigma Universal SIEM/EDR CLI

((((ParentImage ENDSWITH "\\java.exe" OR ParentImage ENDSWITH "\\javaw.exe") AND (ParentImage CONTAINS "-tomcat-" OR ParentImage CONTAINS "\\tomcat")) OR ((ParentImage ENDSWITH "\\java.exe" OR ParentImage ENDSWITH "\\javaw.exe") AND (ParentCommandLine CONTAINS "CATALINA_HOME" OR ParentCommandLine CONTAINS "catalina.home" OR ParentCommandLine CONTAINS "catalina.jar")) OR ((ParentImage ENDSWITH "\\caddy.exe" OR ParentImage ENDSWITH "\\httpd.exe" OR ParentImage ENDSWITH "\\nginx.exe" OR ParentImage ENDSWITH "\\php-cgi.exe" OR ParentImage ENDSWITH "\\php.exe" OR ParentImage ENDSWITH "\\tomcat.exe" OR ParentImage ENDSWITH "\\UMWorkerProcess.exe" OR ParentImage ENDSWITH "\\w3wp.exe" OR ParentImage ENDSWITH "\\ws_TomcatService.exe"))) AND ((Image ENDSWITH "\\arp.exe" OR Image ENDSWITH "\\at.exe" OR Image ENDSWITH "\\bash.exe" OR Image ENDSWITH "\\bitsadmin.exe" OR Image ENDSWITH "\\certutil.exe" OR Image ENDSWITH "\\cmd.exe" OR Image ENDSWITH "\\cscript.exe" OR Image ENDSWITH "\\dsget.exe" OR Image ENDSWITH "\\hostname.exe" OR Image ENDSWITH "\\nbtstat.exe" OR Image ENDSWITH "\\net.exe" OR Image ENDSWITH "\\net1.exe" OR Image ENDSWITH "\\netdom.exe" OR Image ENDSWITH "\\netsh.exe" OR Image ENDSWITH "\\nltest.exe" OR Image ENDSWITH "\\ntdsutil.exe" OR Image ENDSWITH "\\powershell_ise.exe" OR Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\pwsh.exe" OR Image ENDSWITH "\\qprocess.exe" OR Image ENDSWITH "\\query.exe" OR Image ENDSWITH "\\qwinsta.exe" OR Image ENDSWITH "\\reg.exe" OR Image ENDSWITH "\\rundll32.exe" OR Image ENDSWITH "\\sc.exe" OR Image ENDSWITH "\\sh.exe" OR Image ENDSWITH "\\wmic.exe" OR Image ENDSWITH "\\wscript.exe" OR Image ENDSWITH "\\wusa.exe")) AND NOT (((ParentImage ENDSWITH "\\java.exe" AND CommandLine ENDSWITH "Windows\\system32\\cmd.exe /c C:\\ManageEngine\\ADManager \"Plus\\ES\\bin\\elasticsearch.bat -Enode.name=RMP-NODE1 -pelasticsearch-pid.txt") OR (ParentImage ENDSWITH "\\java.exe" AND (CommandLine CONTAINS "sc query" AND CommandLine CONTAINS "ADManager Plus")))))
