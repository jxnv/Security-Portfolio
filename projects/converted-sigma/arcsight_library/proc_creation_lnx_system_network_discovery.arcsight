// Date: 2020-10-06
// Tags: attack.discovery, attack.t1016
// Description: Detects enumeration of local network configuration
// Converted by: Sigma Universal SIEM/EDR CLI

((CommandLine CONTAINS "/etc/resolv.conf") OR ((Image ENDSWITH "/firewall-cmd" OR Image ENDSWITH "/ufw" OR Image ENDSWITH "/iptables" OR Image ENDSWITH "/netstat" OR Image ENDSWITH "/ss" OR Image ENDSWITH "/ip" OR Image ENDSWITH "/ifconfig" OR Image ENDSWITH "/systemd-resolve" OR Image ENDSWITH "/route")))
