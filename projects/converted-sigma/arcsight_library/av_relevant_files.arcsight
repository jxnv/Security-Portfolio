// Title: Antivirus - Relevant File Paths Alerts Signature
// ID: c9a88268-0047-4824-ba6e-4d81ce0b907c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Arnim Rupp
// Date: 2018-09-09
// Tags: attack.resource-development, attack.t1588
// Description: Detects an Antivirus alert in a highly relevant file path or with a relevant file name.
// This event must not be ignored just because the AV has blocked the malware but investigate, how it came there in the first place.
// Converted by: Sigma Universal SIEM/EDR CLI

(((Filename ENDSWITH ".asax" OR Filename ENDSWITH ".ashx" OR Filename ENDSWITH ".asmx" OR Filename ENDSWITH ".asp" OR Filename ENDSWITH ".aspx" OR Filename ENDSWITH ".bat" OR Filename ENDSWITH ".cfm" OR Filename ENDSWITH ".cgi" OR Filename ENDSWITH ".chm" OR Filename ENDSWITH ".cmd" OR Filename ENDSWITH ".dat" OR Filename ENDSWITH ".ear" OR Filename ENDSWITH ".gif" OR Filename ENDSWITH ".hta" OR Filename ENDSWITH ".jpeg" OR Filename ENDSWITH ".jpg" OR Filename ENDSWITH ".jsp" OR Filename ENDSWITH ".jspx" OR Filename ENDSWITH ".lnk" OR Filename ENDSWITH ".msc" OR Filename ENDSWITH ".php" OR Filename ENDSWITH ".pl" OR Filename ENDSWITH ".png" OR Filename ENDSWITH ".ps1" OR Filename ENDSWITH ".psm1" OR Filename ENDSWITH ".py" OR Filename ENDSWITH ".pyc" OR Filename ENDSWITH ".rb" OR Filename ENDSWITH ".scf" OR Filename ENDSWITH ".sct" OR Filename ENDSWITH ".sh" OR Filename ENDSWITH ".svg" OR Filename ENDSWITH ".txt" OR Filename ENDSWITH ".vbe" OR Filename ENDSWITH ".vbs" OR Filename ENDSWITH ".war" OR Filename ENDSWITH ".wll" OR Filename ENDSWITH ".wsf" OR Filename ENDSWITH ".wsh" OR Filename ENDSWITH ".xll" OR Filename ENDSWITH ".xml")) OR ((Filename CONTAINS ":\\PerfLogs\\" OR Filename CONTAINS ":\\Temp\\" OR Filename CONTAINS ":\\Users\\Default\\" OR Filename CONTAINS ":\\Users\\Public\\" OR Filename CONTAINS ":\\Windows\\" OR Filename CONTAINS "/www/" OR Filename CONTAINS "\\inetpub\\" OR Filename CONTAINS "\\tsclient\\" OR Filename CONTAINS "apache" OR Filename CONTAINS "nginx" OR Filename CONTAINS "tomcat" OR Filename CONTAINS "weblogic")))
