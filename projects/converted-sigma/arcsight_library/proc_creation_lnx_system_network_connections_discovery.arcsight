// Title: System Network Connections Discovery - Linux
// ID: 4c519226-f0cd-4471-bd2f-6fbb2bb68a79
// Status: test
// Level: low
// Author: Daniil Yugoslavskiy, oscd.community
// Date: 2020-10-19
// Tags: attack.discovery, attack.t1049
// Description: Detects usage of system utilities to discover system network connections
// Converted by: Sigma Universal SIEM/EDR CLI

(((Image ENDSWITH "/who" OR Image ENDSWITH "/w" OR Image ENDSWITH "/last" OR Image ENDSWITH "/lsof" OR Image ENDSWITH "/netstat")) AND NOT ((ParentCommandLine CONTAINS "/usr/bin/landscape-sysinfo" AND Image ENDSWITH "/who")))
