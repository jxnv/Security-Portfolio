// Title: PUA - PingCastle Execution From Potentially Suspicious Parent
// ID: b37998de-a70b-4f33-b219-ec36bf433dc0
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2024-01-11
// Tags: attack.reconnaissance, attack.t1595
// Description: Detects the execution of PingCastle, a tool designed to quickly assess the Active Directory security level via a script located in a potentially suspicious or uncommon location.
// Converted by: Sigma Universal SIEM/EDR CLI

((((ParentCommandLine CONTAINS ".bat" OR ParentCommandLine CONTAINS ".chm" OR ParentCommandLine CONTAINS ".cmd" OR ParentCommandLine CONTAINS ".hta" OR ParentCommandLine CONTAINS ".htm" OR ParentCommandLine CONTAINS ".html" OR ParentCommandLine CONTAINS ".js" OR ParentCommandLine CONTAINS ".lnk" OR ParentCommandLine CONTAINS ".ps1" OR ParentCommandLine CONTAINS ".vbe" OR ParentCommandLine CONTAINS ".vbs" OR ParentCommandLine CONTAINS ".wsf")) OR ((ParentCommandLine CONTAINS ":\\Perflogs\\" OR ParentCommandLine CONTAINS ":\\Temp\\" OR ParentCommandLine CONTAINS ":\\Users\\Public\\" OR ParentCommandLine CONTAINS ":\\Windows\\Temp\\" OR ParentCommandLine CONTAINS "\\AppData\\Local\\Temp" OR ParentCommandLine CONTAINS "\\AppData\\Roaming\\" OR ParentCommandLine CONTAINS "\\Temporary Internet")) OR (((ParentCommandLine CONTAINS ":\\Users\\" AND ParentCommandLine CONTAINS "\\Favorites\\")) OR ((ParentCommandLine CONTAINS ":\\Users\\" AND ParentCommandLine CONTAINS "\\Favourites\\")) OR ((ParentCommandLine CONTAINS ":\\Users\\" AND ParentCommandLine CONTAINS "\\Contacts\\")))) AND ((ParentCommandLine CONTAINS ".bat" OR ParentCommandLine CONTAINS ".chm" OR ParentCommandLine CONTAINS ".cmd" OR ParentCommandLine CONTAINS ".hta" OR ParentCommandLine CONTAINS ".htm" OR ParentCommandLine CONTAINS ".html" OR ParentCommandLine CONTAINS ".js" OR ParentCommandLine CONTAINS ".lnk" OR ParentCommandLine CONTAINS ".ps1" OR ParentCommandLine CONTAINS ".vbe" OR ParentCommandLine CONTAINS ".vbs" OR ParentCommandLine CONTAINS ".wsf")) AND ((Image ENDSWITH "\\PingCastle.exe") OR (OriginalFileName EQ "PingCastle.exe") OR (Product EQ "Ping Castle") OR ((CommandLine CONTAINS "--scanner aclcheck" OR CommandLine CONTAINS "--scanner antivirus" OR CommandLine CONTAINS "--scanner computerversion" OR CommandLine CONTAINS "--scanner foreignusers" OR CommandLine CONTAINS "--scanner laps_bitlocker" OR CommandLine CONTAINS "--scanner localadmin" OR CommandLine CONTAINS "--scanner nullsession" OR CommandLine CONTAINS "--scanner nullsession-trust" OR CommandLine CONTAINS "--scanner oxidbindings" OR CommandLine CONTAINS "--scanner remote" OR CommandLine CONTAINS "--scanner share" OR CommandLine CONTAINS "--scanner smb" OR CommandLine CONTAINS "--scanner smb3querynetwork" OR CommandLine CONTAINS "--scanner spooler" OR CommandLine CONTAINS "--scanner startup" OR CommandLine CONTAINS "--scanner zerologon")) OR (CommandLine CONTAINS "--no-enum-limit") OR ((CommandLine CONTAINS "--healthcheck" AND CommandLine CONTAINS "--level Full")) OR ((CommandLine CONTAINS "--healthcheck" AND CommandLine CONTAINS "--server "))))
