// Title: Remote Access Tool - ScreenConnect Potential Suspicious Remote Command Execution
// ID: 7b582f1a-b318-4c6a-bf4e-66fe49bf55a5
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems), @Kostastsale
// Date: 2022-02-25
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects potentially suspicious child processes launched via the ScreenConnect client service.
// Converted by: Sigma Universal SIEM/EDR CLI

((ParentCommandLine CONTAINS ":\\Windows\\TEMP\\ScreenConnect\\" AND ParentCommandLine CONTAINS "run.cmd") AND (Image ENDSWITH "\\bitsadmin.exe" OR Image ENDSWITH "\\cmd.exe" OR Image ENDSWITH "\\curl.exe" OR Image ENDSWITH "\\dllhost.exe" OR Image ENDSWITH "\\net.exe" OR Image ENDSWITH "\\nltest.exe" OR Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\pwsh.exe" OR Image ENDSWITH "\\rundll32.exe" OR Image ENDSWITH "\\wevtutil.exe"))
