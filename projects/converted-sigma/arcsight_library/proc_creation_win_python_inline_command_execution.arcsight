// Title: Python Inline Command Execution
// ID: 899133d5-4d7c-4a7f-94ee-27355c879d90
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-02
// Tags: attack.execution, attack.t1059
// Description: Detects execution of python using the "-c" flag. This is could be used as a way to launch a reverse shell or execute live python code.
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAINS " -c") AND ((OriginalFileName EQ "python.exe") OR ((Image ENDSWITH "python.exe" OR Image ENDSWITH "python3.exe" OR Image ENDSWITH "python2.exe")))) AND NOT ((((ParentImage STARTSWITH "C:\\Program Files\\Python" OR ParentImage STARTSWITH "C:\\Program Files (x86)\\Python") AND ParentImage ENDSWITH "\\python.exe" AND ParentCommandLine CONTAINS "-E -s -m ensurepip -U --default-pip") OR ((ParentImage STARTSWITH "C:\\Program Files\\Python" OR ParentImage STARTSWITH "C:\\Program Files (x86)\\Python") AND (CommandLine CONTAINS "-W ignore::DeprecationWarning" AND CommandLine CONTAINS "['install', '--no-cache-dir', '--no-index', '--find-links'," AND CommandLine CONTAINS "'--upgrade', 'pip'")))) AND NOT ((((CommandLine CONTAINS "<pip-setuptools-caller>" AND CommandLine CONTAINS "exec(compile(")) OR ((ParentImage ENDSWITH "\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe") OR ((ParentImage EQ "C:\\Program Files\\Microsoft VS Code\\Code.exe" OR ParentImage EQ "C:\\Program Files (x86)\\Microsoft VS Code\\Code.exe"))))))
