// Title: Suspicious File Download From IP Via Wget.EXE
// ID: 17f0c0a8-8bd5-4ee0-8c5f-a342c0199f35
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-07-27
// Tags: attack.execution
// Description: Detects potentially suspicious file downloads directly from IP addresses using Wget.exe
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine ENDSWITH ".ps1" OR CommandLine ENDSWITH ".ps1'" OR CommandLine ENDSWITH ".ps1\"" OR CommandLine ENDSWITH ".dat" OR CommandLine ENDSWITH ".dat'" OR CommandLine ENDSWITH ".dat\"" OR CommandLine ENDSWITH ".msi" OR CommandLine ENDSWITH ".msi'" OR CommandLine ENDSWITH ".msi\"" OR CommandLine ENDSWITH ".bat" OR CommandLine ENDSWITH ".bat'" OR CommandLine ENDSWITH ".bat\"" OR CommandLine ENDSWITH ".exe" OR CommandLine ENDSWITH ".exe'" OR CommandLine ENDSWITH ".exe\"" OR CommandLine ENDSWITH ".vbs" OR CommandLine ENDSWITH ".vbs'" OR CommandLine ENDSWITH ".vbs\"" OR CommandLine ENDSWITH ".vbe" OR CommandLine ENDSWITH ".vbe'" OR CommandLine ENDSWITH ".vbe\"" OR CommandLine ENDSWITH ".hta" OR CommandLine ENDSWITH ".hta'" OR CommandLine ENDSWITH ".hta\"" OR CommandLine ENDSWITH ".dll" OR CommandLine ENDSWITH ".dll'" OR CommandLine ENDSWITH ".dll\"" OR CommandLine ENDSWITH ".psm1" OR CommandLine ENDSWITH ".psm1'" OR CommandLine ENDSWITH ".psm1\"")) AND ((CommandLine=regex("\\s-O\\s")) OR (CommandLine CONTAINS "--output-document")) AND (CommandLine CONTAINS "http") AND ((Image ENDSWITH "\\wget.exe") OR (OriginalFileName EQ "wget.exe")) AND (CommandLine=regex("://[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}")))
