// Title: Elevated System Shell Spawned From Uncommon Parent Location
// ID: 178e615d-e666-498b-9630-9ed363038101
// Status: test
// Level: medium
// Author: frack113, Tim Shelton (update fp)
// Date: 2022-12-05
// Tags: attack.privilege-escalation, attack.execution, attack.t1059
// Description: Detects when a shell program such as the Windows command prompt or PowerShell is launched with system privileges from a uncommon parent location.
// Converted by: Sigma Universal SIEM/EDR CLI

(((((Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\powershell_ise.exe" OR Image ENDSWITH "\\pwsh.exe" OR Image ENDSWITH "\\cmd.exe")) OR ((OriginalFileName EQ "PowerShell.EXE" OR OriginalFileName EQ "powershell_ise.EXE" OR OriginalFileName EQ "pwsh.dll" OR OriginalFileName EQ "Cmd.Exe"))) AND ((User CONTAINS "AUTHORI" OR User CONTAINS "AUTORI") AND LogonId EQ "0x3e7")) AND NOT ((((ParentImage CONTAINS ":\\Program Files (x86)\\" OR ParentImage CONTAINS ":\\Program Files\\" OR ParentImage CONTAINS ":\\ProgramData\\" OR ParentImage CONTAINS ":\\Windows\\System32\\" OR ParentImage CONTAINS ":\\Windows\\SysWOW64\\" OR ParentImage CONTAINS ":\\Windows\\Temp\\" OR ParentImage CONTAINS ":\\Windows\\WinSxS\\")) OR ((ParentImage EQ "" OR ParentImage EQ "-")) OR (NOT ParentImage=*))) AND NOT (((CommandLine CONTAINS ":\\WINDOWS\\system32\\cmd.exe /c \"" AND CurrentDirectory CONTAINS ":\\WINDOWS\\Temp\\asgard2-agent\\") OR (ParentImage CONTAINS ":\\IBM\\SpectrumProtect\\webserver\\scripts\\" AND CommandLine CONTAINS ":\\IBM\\SpectrumProtect\\webserver\\scripts\\") OR (ParentImage ENDSWITH ":\\ManageEngine\\ADManager Plus\\pgsql\\bin\\postgres.exe" AND Image ENDSWITH "\\cmd.exe"))))
