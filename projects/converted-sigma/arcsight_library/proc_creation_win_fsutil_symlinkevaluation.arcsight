// Title: Potentially Suspicious NTFS Symlink Behavior Modification
// ID: c0b2768a-dd06-4671-8339-b16ca8d1f27f
// Status: test
// Level: medium
// Author: frack113, The DFIR Report
// Date: 2022-03-02
// Tags: attack.execution, attack.defense-impairment, attack.t1059, attack.t1222.001
// Description: Detects the modification of NTFS symbolic link behavior using fsutil, which could be used to enable remote to local or remote to remote symlinks for potential attacks.
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAINS "fsutil" AND CommandLine CONTAINS "behavior" AND CommandLine CONTAINS "set" AND CommandLine CONTAINS "SymlinkEvaluation")) AND (((Image ENDSWITH "\\cmd.exe" OR Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\pwsh.exe")) OR ((OriginalFileName EQ "Cmd.Exe" OR OriginalFileName EQ "PowerShell.EXE" OR OriginalFileName EQ "pwsh.dll"))) AND ((CommandLine CONTAINS "R2L:1" OR CommandLine CONTAINS "R2R:1" OR CommandLine CONTAINS "L2L:1")))
