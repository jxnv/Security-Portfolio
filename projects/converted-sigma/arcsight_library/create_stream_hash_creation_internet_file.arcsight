// Title: Creation Of a Suspicious ADS File Outside a Browser Download
// ID: 573df571-a223-43bc-846e-3f98da481eca
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-10-22
// Tags: attack.stealth
// Description: Detects the creation of a suspicious ADS (Alternate Data Stream) file by software other than browsers
// Converted by: Sigma Universal SIEM/EDR CLI

((Contents STARTSWITH "[ZoneTransfer]  ZoneId=3" AND TargetFilename ENDSWITH ":Zone.Identifier" AND (TargetFilename CONTAINS ".exe" OR TargetFilename CONTAINS ".scr" OR TargetFilename CONTAINS ".bat" OR TargetFilename CONTAINS ".cmd" OR TargetFilename CONTAINS ".docx" OR TargetFilename CONTAINS ".hta" OR TargetFilename CONTAINS ".jse" OR TargetFilename CONTAINS ".lnk" OR TargetFilename CONTAINS ".pptx" OR TargetFilename CONTAINS ".ps" OR TargetFilename CONTAINS ".reg" OR TargetFilename CONTAINS ".sct" OR TargetFilename CONTAINS ".vb" OR TargetFilename CONTAINS ".wsc" OR TargetFilename CONTAINS ".wsf" OR TargetFilename CONTAINS ".xlsx")) AND NOT (((Image ENDSWITH "\\brave.exe") OR ((Image EQ "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR Image EQ "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((Image STARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") OR (Image ENDSWITH "\\WindowsApps\\MicrosoftEdge.exe") OR ((Image EQ "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR Image EQ "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((Image STARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" OR Image STARTSWITH "C:\\Program Files\\Microsoft\\EdgeCore\\") AND (Image ENDSWITH "\\msedge.exe" OR Image ENDSWITH "\\msedgewebview2.exe")) OR ((Image EQ "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR Image EQ "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR ((Image EQ "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR Image EQ "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (Image ENDSWITH "\\maxthon.exe") OR (Image ENDSWITH "\\opera.exe") OR (Image ENDSWITH "\\safari.exe") OR (Image ENDSWITH "\\seamonkey.exe") OR (Image STARTSWITH "C:\\Program Files\\WindowsApps\\Microsoft.ScreenSketch_" AND Image ENDSWITH "\\SnippingTool\\SnippingTool.exe" AND TargetFilename STARTSWITH "C:\\Users\\" AND (TargetFilename CONTAINS "\\AppData\\Local\\Packages\\Microsoft.ScreenSketch_" AND TargetFilename CONTAINS "\\TempState\\Screenshot ") AND TargetFilename ENDSWITH ".png:Zone.Identifier") OR (Image ENDSWITH "\\vivaldi.exe") OR (Image ENDSWITH "\\whale.exe"))))
