// Title: System File Execution Location Anomaly
// ID: e4a6b256-3e47-40fc-89d2-7a477edd6915
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Patrick Bareiss, Anton Kutepov, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2017-11-27
// Tags: attack.stealth, attack.t1036
// Description: Detects the execution of a Windows system binary that is usually located in the system folder from an uncommon location.
// Converted by: Sigma Universal SIEM/EDR CLI

(((Image ENDSWITH "\\atbroker.exe" OR Image ENDSWITH "\\audiodg.exe" OR Image ENDSWITH "\\bcdedit.exe" OR Image ENDSWITH "\\bitsadmin.exe" OR Image ENDSWITH "\\certreq.exe" OR Image ENDSWITH "\\certutil.exe" OR Image ENDSWITH "\\cmstp.exe" OR Image ENDSWITH "\\conhost.exe" OR Image ENDSWITH "\\consent.exe" OR Image ENDSWITH "\\cscript.exe" OR Image ENDSWITH "\\csrss.exe" OR Image ENDSWITH "\\dashost.exe" OR Image ENDSWITH "\\defrag.exe" OR Image ENDSWITH "\\dfrgui.exe" OR Image ENDSWITH "\\dism.exe" OR Image ENDSWITH "\\dllhost.exe" OR Image ENDSWITH "\\dllhst3g.exe" OR Image ENDSWITH "\\dwm.exe" OR Image ENDSWITH "\\eventvwr.exe" OR Image ENDSWITH "\\fsquirt.exe" OR Image ENDSWITH "\\finger.exe" OR Image ENDSWITH "\\logonui.exe" OR Image ENDSWITH "\\LsaIso.exe" OR Image ENDSWITH "\\lsass.exe" OR Image ENDSWITH "\\lsm.exe" OR Image ENDSWITH "\\msiexec.exe" OR Image ENDSWITH "\\ntoskrnl.exe" OR Image ENDSWITH "\\powershell_ise.exe" OR Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\pwsh.exe" OR Image ENDSWITH "\\regsvr32.exe" OR Image ENDSWITH "\\rundll32.exe" OR Image ENDSWITH "\\runonce.exe" OR Image ENDSWITH "\\RuntimeBroker.exe" OR Image ENDSWITH "\\schtasks.exe" OR Image ENDSWITH "\\services.exe" OR Image ENDSWITH "\\sihost.exe" OR Image ENDSWITH "\\smartscreen.exe" OR Image ENDSWITH "\\smss.exe" OR Image ENDSWITH "\\spoolsv.exe" OR Image ENDSWITH "\\svchost.exe" OR Image ENDSWITH "\\taskhost.exe" OR Image ENDSWITH "\\taskhostw.exe" OR Image ENDSWITH "\\Taskmgr.exe" OR Image ENDSWITH "\\userinit.exe" OR Image ENDSWITH "\\werfault.exe" OR Image ENDSWITH "\\werfaultsecure.exe" OR Image ENDSWITH "\\wininit.exe" OR Image ENDSWITH "\\winlogon.exe" OR Image ENDSWITH "\\winver.exe" OR Image ENDSWITH "\\wlanext.exe" OR Image ENDSWITH "\\wmic.exe" OR Image ENDSWITH "\\wscript.exe" OR Image ENDSWITH "\\wsl.exe" OR Image ENDSWITH "\\wsmprovhost.exe")) AND NOT ((((Image STARTSWITH "C:\\$WINDOWS.~BT\\" OR Image STARTSWITH "C:\\$WinREAgent\\" OR Image STARTSWITH "C:\\Windows\\SoftwareDistribution\\" OR Image STARTSWITH "C:\\Windows\\System32\\" OR Image STARTSWITH "C:\\Windows\\SystemTemp\\" OR Image STARTSWITH "C:\\Windows\\SysWOW64\\" OR Image STARTSWITH "C:\\Windows\\uus\\" OR Image STARTSWITH "C:\\Windows\\WinSxS\\")) OR ((Image CONTAINS "C:\\Program Files\\PowerShell\\7\\" OR Image CONTAINS "C:\\Program Files\\PowerShell\\7-preview\\" OR Image CONTAINS "C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview" OR Image CONTAINS "\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview") AND Image ENDSWITH "\\pwsh.exe") OR (Image STARTSWITH "C:\\Users\\" AND Image CONTAINS "\\AppData\\Local\\Microsoft\\WindowsApps\\" AND Image ENDSWITH "\\wsl.exe") OR ((Image STARTSWITH "C:\\Program Files\\WindowsApps\\MicrosoftCorporationII.WindowsSubsystemForLinux" OR Image STARTSWITH "C:\\Program Files\\WSL\\") AND Image ENDSWITH "\\wsl.exe"))) AND NOT ((Image CONTAINS "\\SystemRoot\\System32\\")))
