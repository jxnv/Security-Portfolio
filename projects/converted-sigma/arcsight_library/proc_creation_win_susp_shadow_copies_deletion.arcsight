// Title: Shadow Copies Deletion Using Operating Systems Utilities
// ID: c947b146-0abc-4c87-9c64-b17e9d7274a2
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems), Michael Haag, Teymur Kheirkhabarov, Daniil Yugoslavskiy, oscd.community, Andreas Hunkeler (@Karneades)
// Date: 2019-10-22
// Tags: attack.impact, attack.stealth, attack.t1070, attack.t1490
// Description: Shadow Copies deletion using operating systems utilities
// Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine CONTAINS "shadow" AND CommandLine CONTAINS "delete")) AND (((Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\pwsh.exe" OR Image ENDSWITH "\\wmic.exe" OR Image ENDSWITH "\\vssadmin.exe" OR Image ENDSWITH "\\diskshadow.exe")) OR ((OriginalFileName EQ "PowerShell.EXE" OR OriginalFileName EQ "pwsh.dll" OR OriginalFileName EQ "wmic.exe" OR OriginalFileName EQ "VSSADMIN.EXE" OR OriginalFileName EQ "diskshadow.exe")))) OR (((CommandLine CONTAINS "delete" AND CommandLine CONTAINS "catalog" AND CommandLine CONTAINS "quiet")) AND ((Image ENDSWITH "\\wbadmin.exe") OR (OriginalFileName EQ "WBADMIN.EXE"))) OR (((CommandLine CONTAINS "resize" AND CommandLine CONTAINS "shadowstorage") AND (CommandLine CONTAINS "unbounded" OR CommandLine CONTAINS "/MaxSize=")) AND ((Image ENDSWITH "\\vssadmin.exe") OR (OriginalFileName EQ "VSSADMIN.EXE"))))
