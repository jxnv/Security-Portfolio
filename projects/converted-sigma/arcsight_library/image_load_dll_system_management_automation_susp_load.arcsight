// Title: PowerShell Core DLL Loaded By Non PowerShell Process
// ID: 092bc4b9-3d1d-43b4-a6b4-8c8acd83522f
// Status: test
// Level: medium
// Author: Tom Kern, oscd.community, Natalia Shornikova, Tim Shelton, Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2019-11-14
// Tags: attack.t1059.001, attack.execution
// Description: Detects loading of essential DLLs used by PowerShell by non-PowerShell process.
// Detects behavior similar to meterpreter's "load powershell" extension.
// Converted by: Sigma Universal SIEM/EDR CLI

(((Description EQ "System.Management.Automation") OR (OriginalFileName EQ "System.Management.Automation.dll") OR ((ImageLoaded ENDSWITH "\\System.Management.Automation.dll" OR ImageLoaded ENDSWITH "\\System.Management.Automation.ni.dll"))) AND NOT ((((Image STARTSWITH "C:\\Windows\\Microsoft.NET\\Framework\\" OR Image STARTSWITH "C:\\Windows\\Microsoft.NET\\FrameworkArm\\" OR Image STARTSWITH "C:\\Windows\\Microsoft.NET\\FrameworkArm64\\" OR Image STARTSWITH "C:\\Windows\\Microsoft.NET\\Framework64\\") AND Image ENDSWITH "\\mscorsvw.exe") OR ((Image EQ "C:\\Windows\\System32\\dsac.exe" OR Image EQ "C:\\WINDOWS\\System32\\RemoteFXvGPUDisablement.exe" OR Image EQ "C:\\Windows\\System32\\runscripthelper.exe" OR Image EQ "C:\\WINDOWS\\System32\\sdiagnhost.exe" OR Image EQ "C:\\Windows\\System32\\ServerManager.exe" OR Image EQ "C:\\Windows\\System32\\SyncAppvPublishingServer.exe" OR Image EQ "C:\\Windows\\System32\\winrshost.exe" OR Image EQ "C:\\Windows\\System32\\wsmprovhost.exe" OR Image EQ "C:\\Windows\\SysWOW64\\winrshost.exe" OR Image EQ "C:\\Windows\\SysWOW64\\wsmprovhost.exe")) OR ((Image EQ "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" OR Image EQ "C:\\Program Files\\PowerShell\\7\\pwsh.exe" OR Image EQ "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" OR Image EQ "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" OR Image EQ "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" OR Image EQ "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")) OR ((Image CONTAINS "C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview" OR Image CONTAINS "\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview") AND Image ENDSWITH "\\pwsh.exe"))) AND NOT (((NOT Image=*) OR (Image STARTSWITH "C:\\ProgramData\\chocolatey\\choco.exe") OR (Image ENDSWITH "\\Citrix\\ConfigSync\\ConfigSyncRun.exe") OR (Image STARTSWITH "C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_" AND Image ENDSWITH "\\GetHelp.exe") OR (Image STARTSWITH "C:\\Windows\\Temp\\asgard2-agent\\" AND (Image ENDSWITH "\\thor64.exe" OR Image ENDSWITH "\\thor.exe")) OR ((Image STARTSWITH "C:\\Program Files (x86)\\Microsoft SQL Server Management Studio" OR Image STARTSWITH "C:\\Program Files\\Microsoft SQL Server Management Studio") AND Image ENDSWITH "\\IDE\\Ssms.exe") OR ((Image STARTSWITH "C:\\Program Files (x86)\\Microsoft SQL Server\\" OR Image STARTSWITH "C:\\Program Files\\Microsoft SQL Server\\") AND Image ENDSWITH "\\Tools\\Binn\\SQLPS.exe") OR ((Image STARTSWITH "C:\\Program Files (x86)\\Microsoft Visual Studio\\" OR Image STARTSWITH "C:\\Program Files\\Microsoft Visual Studio\\")))))
