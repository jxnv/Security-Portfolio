// Title: Audio Capture
// ID: a7af2487-9c2f-42e4-9bb9-ff961f0561d5
// Status: test
// Level: low
// Author: Pawel Mazur, Milad Cheraghi
// Date: 2021-09-04
// Tags: attack.collection, attack.t1123
// Description: Detects attempts to record audio using the arecord and ecasound utilities.
// Converted by: Sigma Universal SIEM/EDR CLI

((type EQ "EXECVE" AND a0 EQ "arecord" AND a1 EQ "-vv" AND a2 EQ "-fdat") OR (type EQ "SYSCALL" AND exe ENDSWITH "/ecasound" AND SYSCALL EQ "memfd_create"))
