// Title: Suspicious MSDT Parent Process
// ID: 7a74da6b-ea76-47db-92cc-874ad90df734
// Status: test
// Level: high
// Author: Nextron Systems
// Date: 2022-06-01
// Tags: attack.stealth, attack.t1036, attack.t1218
// Description: Detects msdt.exe executed by a suspicious parent as seen in CVE-2022-30190 / Follina exploitation
// Converted by: Sigma Universal SIEM/EDR CLI

(((Image ENDSWITH "\\msdt.exe") OR (OriginalFileName EQ "msdt.exe")) AND ((ParentImage ENDSWITH "\\cmd.exe" OR ParentImage ENDSWITH "\\cscript.exe" OR ParentImage ENDSWITH "\\mshta.exe" OR ParentImage ENDSWITH "\\powershell.exe" OR ParentImage ENDSWITH "\\pwsh.exe" OR ParentImage ENDSWITH "\\regsvr32.exe" OR ParentImage ENDSWITH "\\rundll32.exe" OR ParentImage ENDSWITH "\\schtasks.exe" OR ParentImage ENDSWITH "\\wmic.exe" OR ParentImage ENDSWITH "\\wscript.exe" OR ParentImage ENDSWITH "\\wsl.exe")))
