// Title: Suspicious Child Process Of SQL Server
// ID: 869b9ca7-9ea2-4a5a-8325-e80e62f75445
// Status: test
// Level: high
// Author: FPT.EagleEye Team, wagga
// Date: 2020-12-11
// Tags: attack.t1505.003, attack.t1190, attack.initial-access, attack.persistence, attack.privilege-escalation
// Description: Detects suspicious child processes of the SQLServer process. This could indicate potential RCE or SQL Injection.
// Converted by: Sigma Universal SIEM/EDR CLI

((ParentImage ENDSWITH "\\sqlservr.exe" AND (Image ENDSWITH "\\bash.exe" OR Image ENDSWITH "\\bitsadmin.exe" OR Image ENDSWITH "\\cmd.exe" OR Image ENDSWITH "\\netstat.exe" OR Image ENDSWITH "\\nltest.exe" OR Image ENDSWITH "\\ping.exe" OR Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\pwsh.exe" OR Image ENDSWITH "\\regsvr32.exe" OR Image ENDSWITH "\\rundll32.exe" OR Image ENDSWITH "\\sh.exe" OR Image ENDSWITH "\\systeminfo.exe" OR Image ENDSWITH "\\tasklist.exe" OR Image ENDSWITH "\\wsl.exe")) AND NOT ((ParentImage STARTSWITH "C:\\Program Files\\Microsoft SQL Server\\" AND ParentImage ENDSWITH "DATEV_DBENGINE\\MSSQL\\Binn\\sqlservr.exe" AND Image EQ "C:\\Windows\\System32\\cmd.exe" AND CommandLine STARTSWITH "\"C:\\Windows\\system32\\cmd.exe\" ")))
