((((Image ENDSWITH "\\tree.com" OR Image ENDSWITH "\\WMIC.exe" OR Image ENDSWITH "\\doskey.exe" OR Image ENDSWITH "\\sc.exe")) OR ((OriginalFileName EQ "wmic.exe" OR OriginalFileName EQ "DOSKEY.EXE" OR OriginalFileName EQ "sc.exe"))) AND ((ParentCommandLine CONTAINS " > %TEMP%\\" OR ParentCommandLine CONTAINS " > %TMP%\\")))
