// Title: ServiceDll Hijack
// ID: 612e47e9-8a59-43a6-b404-f48683f45bd6
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-02-04
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects changes to the "ServiceDLL" value related to a service in the registry.
// This is often used as a method of persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

(((TargetObject CONTAINS "\\System\\" AND TargetObject CONTAINS "ControlSet" AND TargetObject CONTAINS "\\Services\\") AND TargetObject ENDSWITH "\\Parameters\\ServiceDll") AND NOT (((Image EQ "C:\\Windows\\system32\\lsass.exe" AND TargetObject ENDSWITH "\\Services\\NTDS\\Parameters\\ServiceDll" AND Details EQ "%%systemroot%%\\system32\\ntdsa.dll") OR (Image EQ "C:\\Windows\\System32\\poqexec.exe") OR (Details EQ "C:\\Windows\\system32\\spool\\drivers\\x64\\3\\PrintConfig.dll") OR (Image ENDSWITH "\\regsvr32.exe" AND TargetObject ENDSWITH "\\Services\\PrintNotify\\Parameters\\ServiceDll" AND Details STARTSWITH "C:\\WINDOWS\\System32\\DriverStore\\FileRepository\\" AND Details ENDSWITH "\\arm64\\PrintConfig.dll"))) AND NOT ((Image ENDSWITH "\\regsvr32.exe" AND Details EQ "C:\\Windows\\System32\\STAgent.dll")))
