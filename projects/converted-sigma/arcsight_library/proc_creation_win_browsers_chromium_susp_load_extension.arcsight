// Title: Suspicious Chromium Browser Instance Executed With Custom Extension
// ID: 27ba3207-dd30-4812-abbf-5d20c57d474e
// Status: test
// Level: high
// Author: Aedan Russell, frack113, X__Junior (Nextron Systems)
// Date: 2022-06-19
// Tags: attack.persistence, attack.t1176.001
// Description: Detects a suspicious process spawning a Chromium based browser process with the 'load-extension' flag to start an instance with a custom extension
// Converted by: Sigma Universal SIEM/EDR CLI

((ParentImage ENDSWITH "\\cmd.exe" OR ParentImage ENDSWITH "\\cscript.exe" OR ParentImage ENDSWITH "\\mshta.exe" OR ParentImage ENDSWITH "\\powershell.exe" OR ParentImage ENDSWITH "\\pwsh.exe" OR ParentImage ENDSWITH "\\regsvr32.exe" OR ParentImage ENDSWITH "\\rundll32.exe" OR ParentImage ENDSWITH "\\wscript.exe") AND (Image ENDSWITH "\\brave.exe" OR Image ENDSWITH "\\chrome.exe" OR Image ENDSWITH "\\msedge.exe" OR Image ENDSWITH "\\opera.exe" OR Image ENDSWITH "\\vivaldi.exe") AND CommandLine CONTAINS "--load-extension=")
