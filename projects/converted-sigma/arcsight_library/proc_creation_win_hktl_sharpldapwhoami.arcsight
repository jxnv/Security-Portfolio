// Title: HackTool - SharpLdapWhoami Execution
// ID: d9367cbb-c2e0-47ce-bdc0-128cb6da898d
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-08-29
// Tags: attack.discovery, attack.t1033, car.2016-03-001
// Description: Detects SharpLdapWhoami, a whoami alternative that queries the LDAP service on a domain controller
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine ENDSWITH " /method:ntlm" OR CommandLine ENDSWITH " /method:kerb" OR CommandLine ENDSWITH " /method:nego" OR CommandLine ENDSWITH " /m:nego" OR CommandLine ENDSWITH " /m:ntlm" OR CommandLine ENDSWITH " /m:kerb")) OR (Image ENDSWITH "\\SharpLdapWhoami.exe") OR ((OriginalFileName CONTAINS "SharpLdapWhoami") OR (Product EQ "SharpLdapWhoami")))
