// Title: New Connection Initiated To Potential Dead Drop Resolver Domain
// ID: 297ae038-edc2-4b2e-bb3e-7c5fc94dd5c7
// Status: test
// Level: high
// Author: Sorina Ionescu, X__Junior (Nextron Systems)
// Date: 2022-08-17
// Tags: attack.command-and-control, attack.t1102, attack.t1102.001
// Description: Detects an executable, which is not an internet browser or known application, initiating network connections to legit popular websites, which were seen to be used as dead drop resolvers in previous attacks.
// In this context attackers leverage known websites such as "facebook", "youtube", etc. In order to pass through undetected.
// Converted by: Sigma Universal SIEM/EDR CLI

((Initiated EQ "true" AND (DestinationHostname ENDSWITH ".t.me" OR DestinationHostname ENDSWITH "0x0.st" OR DestinationHostname ENDSWITH "4shared.com" OR DestinationHostname ENDSWITH "abuse.ch" OR DestinationHostname ENDSWITH "anonfiles.com" OR DestinationHostname ENDSWITH "bashupload.com" OR DestinationHostname ENDSWITH "cdn.discordapp.com" OR DestinationHostname ENDSWITH "chunk.io" OR DestinationHostname ENDSWITH "cloudflare.com" OR DestinationHostname ENDSWITH "ddns.net" OR DestinationHostname ENDSWITH "discord.com" OR DestinationHostname ENDSWITH "docs.google.com" OR DestinationHostname ENDSWITH "drive.google.com" OR DestinationHostname ENDSWITH "dropbox.com" OR DestinationHostname ENDSWITH "dropmefiles.com" OR DestinationHostname ENDSWITH "facebook.com" OR DestinationHostname ENDSWITH "feeds.rapidfeeds.com" OR DestinationHostname ENDSWITH "fotolog.com" OR DestinationHostname ENDSWITH "ghostbin.co/" OR DestinationHostname ENDSWITH "githubusercontent.com" OR DestinationHostname ENDSWITH "gofile.io" OR DestinationHostname ENDSWITH "hastebin.com" OR DestinationHostname ENDSWITH "imgur.com" OR DestinationHostname ENDSWITH "livejournal.com" OR DestinationHostname ENDSWITH "mediafire.com" OR DestinationHostname ENDSWITH "mega.co.nz" OR DestinationHostname ENDSWITH "mega.nz" OR DestinationHostname ENDSWITH "onedrive.com" OR DestinationHostname ENDSWITH "pages.dev" OR DestinationHostname ENDSWITH "paste.ee" OR DestinationHostname ENDSWITH "pastebin.com" OR DestinationHostname ENDSWITH "pastebin.pl" OR DestinationHostname ENDSWITH "pastetext.net" OR DestinationHostname ENDSWITH "pixeldrain.com" OR DestinationHostname ENDSWITH "privatlab.com" OR DestinationHostname ENDSWITH "privatlab.net" OR DestinationHostname ENDSWITH "reddit.com" OR DestinationHostname ENDSWITH "send.exploit.in" OR DestinationHostname ENDSWITH "sendspace.com" OR DestinationHostname ENDSWITH "steamcommunity.com" OR DestinationHostname ENDSWITH "storage.googleapis.com" OR DestinationHostname ENDSWITH "technet.microsoft.com" OR DestinationHostname ENDSWITH "temp.sh" OR DestinationHostname ENDSWITH "transfer.sh" OR DestinationHostname ENDSWITH "trycloudflare.com" OR DestinationHostname ENDSWITH "twitter.com" OR DestinationHostname ENDSWITH "ufile.io" OR DestinationHostname ENDSWITH "vimeo.com" OR DestinationHostname ENDSWITH "w3spaces.com" OR DestinationHostname ENDSWITH "wetransfer.com" OR DestinationHostname ENDSWITH "workers.dev" OR DestinationHostname ENDSWITH "x0.at" OR DestinationHostname ENDSWITH "youtube.com")) AND NOT ((((Image STARTSWITH "C:\\Program Files (x86)\\Avant Browser\\" OR Image STARTSWITH "C:\\Program Files\\Avant Browser\\") AND Image ENDSWITH "\\avant.exe") OR (Image STARTSWITH "C:\\Program Files\\BraveSoftware\\" AND Image ENDSWITH "\\brave.exe") OR ((Image EQ "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR Image EQ "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR (Image STARTSWITH "C:\\Users\\" AND Image ENDSWITH "\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe") OR ((Image CONTAINS "C:\\Program Files\\Windows Defender Advanced Threat Protection\\" OR Image CONTAINS "C:\\Program Files\\Windows Defender\\" OR Image CONTAINS "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\") AND (Image ENDSWITH "\\MsMpEng.exe" OR Image ENDSWITH "\\MsSense.exe")) OR (Image CONTAINS "\\AppData\\Local\\Discord\\" AND Image ENDSWITH "\\Discord.exe" AND (DestinationHostname ENDSWITH "discord.com" OR DestinationHostname ENDSWITH "cdn.discordapp.com")) OR ((Image STARTSWITH "C:\\Program Files (x86)\\Dropbox\\Client\\" OR Image STARTSWITH "C:\\Program Files\\Dropbox\\Client\\") AND (Image ENDSWITH "\\Dropbox.exe" OR Image ENDSWITH "\\DropboxInstaller.exe") AND DestinationHostname ENDSWITH "dropbox.com") OR ((Image STARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") OR (Image ENDSWITH "\\WindowsApps\\MicrosoftEdge.exe") OR ((Image EQ "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR Image EQ "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((Image STARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" OR Image STARTSWITH "C:\\Program Files\\Microsoft\\EdgeCore\\") AND (Image ENDSWITH "\\msedge.exe" OR Image ENDSWITH "\\msedgewebview2.exe")) OR (Image EQ "") OR ((Image STARTSWITH "C:\\Program Files\\Falkon\\" OR Image STARTSWITH "C:\\Program Files (x86)\\Falkon\\") AND Image ENDSWITH "\\falkon.exe") OR ((Image EQ "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR Image EQ "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR (Image STARTSWITH "C:\\Users\\" AND Image ENDSWITH "\\AppData\\Local\\Mozilla Firefox\\firefox.exe") OR (Image CONTAINS "\\AppData\\Local\\Flock\\" AND Image ENDSWITH "\\Flock.exe") OR ((Image CONTAINS "C:\\Program Files\\Google\\Drive File Stream\\" OR Image CONTAINS "C:\\Program Files (x86)\\Google\\Drive File Stream\\") AND Image ENDSWITH "GoogleDriveFS.exe" AND DestinationHostname ENDSWITH "drive.google.com") OR ((Image EQ "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR Image EQ "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (Image CONTAINS "\\AppData\\Local\\Maxthon\\" AND Image ENDSWITH "\\maxthon.exe") OR ((Image ENDSWITH "\\MEGAsync.exe" OR Image ENDSWITH "\\MEGAsyncSetup32_*RC.exe" OR Image ENDSWITH "\\MEGAsyncSetup32.exe" OR Image ENDSWITH "\\MEGAsyncSetup64.exe" OR Image ENDSWITH "\\MEGAupdater.exe") AND (DestinationHostname ENDSWITH "mega.co.nz" OR DestinationHostname ENDSWITH "mega.nz")) OR (Image CONTAINS "\\AppData\\Local\\Programs\\midori-ng\\" AND Image ENDSWITH "\\Midori Next Generation.exe") OR (NOT Image=*) OR (Image CONTAINS "\\AppData\\Local\\Microsoft\\OneDrive\\" AND Image ENDSWITH "\\OneDrive.exe" AND DestinationHostname ENDSWITH "onedrive.com") OR (Image CONTAINS "\\AppData\\Local\\Programs\\Opera\\" AND Image ENDSWITH "\\opera.exe") OR (Image CONTAINS "\\AppData\\Local\\Phoebe\\" AND Image ENDSWITH "\\Phoebe.exe") OR ((Image ENDSWITH "C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe" OR Image ENDSWITH "C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe")) OR ((Image STARTSWITH "C:\\Program Files (x86)\\QtWeb\\" OR Image STARTSWITH "C:\\Program Files\\QtWeb\\") AND Image ENDSWITH "\\QtWeb.exe") OR ((Image CONTAINS "C:\\Program Files (x86)\\Safari\\" OR Image CONTAINS "C:\\Program Files\\Safari\\") AND Image ENDSWITH "\\safari.exe") OR ((Image STARTSWITH "C:\\Program Files\\SeaMonkey\\" OR Image STARTSWITH "C:\\Program Files (x86)\\SeaMonkey\\") AND Image ENDSWITH "\\seamonkey.exe") OR ((Image STARTSWITH "C:\\Program Files\\SlimBrowser\\" OR Image STARTSWITH "C:\\Program Files (x86)\\SlimBrowser\\") AND Image ENDSWITH "\\slimbrowser.exe") OR (Image CONTAINS "\\AppData\\Roaming\\Telegram Desktop\\" AND Image ENDSWITH "\\Telegram.exe" AND DestinationHostname ENDSWITH ".t.me") OR (Image CONTAINS "\\AppData\\Local\\Vivaldi\\" AND Image ENDSWITH "\\vivaldi.exe") OR ((Image STARTSWITH "C:\\Program Files\\Naver\\Naver Whale\\" OR Image STARTSWITH "C:\\Program Files (x86)\\Naver\\Naver Whale\\") AND Image ENDSWITH "\\whale.exe") OR ((Image STARTSWITH "C:\\Program Files\\Waterfox\\" OR Image STARTSWITH "C:\\Program Files (x86)\\Waterfox\\") AND Image ENDSWITH "\\Waterfox.exe") OR ((Image STARTSWITH "C:\\Program Files (x86)\\WindowsApps\\" OR Image STARTSWITH "C:\\Program Files\\WindowsApps\\") AND Image ENDSWITH "\\WhatsApp.exe" AND DestinationHostname ENDSWITH "facebook.com"))))
