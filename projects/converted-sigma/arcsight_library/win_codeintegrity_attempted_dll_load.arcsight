// Title: CodeIntegrity - Unmet Signing Level Requirements By File Under Validation
// ID: f8931561-97f5-4c46-907f-0a4a592e47a7
// Status: experimental
// Level: low
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-20
// Tags: attack.execution
// Description: Detects attempted file load events that did not meet the signing level requirements. It often means the file's signature is revoked or a signature with the Lifetime Signing EKU has expired.
// This event is best correlated with EID 3089 to determine the error of the validation.
// Converted by: Sigma Universal SIEM/EDR CLI

(((EventID EQ "3033" OR EventID EQ "3034")) AND NOT ((FileNameBuffer CONTAINS "\\Windows\\assembly\\GAC\\" AND ProcessNameBuffer ENDSWITH "\\mscorsvw.exe" AND ProcessNameBuffer CONTAINS "\\Windows\\Microsoft.NET\\" AND RequestedPolicy EQ "8")) AND NOT (((FileNameBuffer CONTAINS "\\Windows\\System32\\DriverStore\\FileRepository\\" AND FileNameBuffer ENDSWITH "\\igd10iumd64.dll" AND RequestedPolicy EQ "7") OR ((FileNameBuffer ENDSWITH "\\Program Files\\Avast Software\\Avast\\aswAMSI.dll" OR FileNameBuffer ENDSWITH "\\Program Files (x86)\\Avast Software\\Avast\\aswAMSI.dll") AND (RequestedPolicy EQ "8" OR RequestedPolicy EQ "12")) OR (FileNameBuffer ENDSWITH "\\Program Files\\Bonjour\\mdnsNSP.dll" AND (ProcessNameBuffer ENDSWITH "\\Windows\\System32\\svchost.exe" OR ProcessNameBuffer ENDSWITH "\\Windows\\System32\\SIHClient.exe") AND (RequestedPolicy EQ "8" OR RequestedPolicy EQ "12")) OR (FileNameBuffer ENDSWITH "\\Program Files\\comodo\\comodo internet security\\amsiprovider_x64.dll") OR (FileNameBuffer ENDSWITH "\\Program Files\\DTrace\\dtrace.dll" AND ProcessNameBuffer ENDSWITH "\\Windows\\System32\\svchost.exe" AND RequestedPolicy EQ "12") OR (FileNameBuffer ENDSWITH "\\Windows\\System32\\nvspcap64.dll" AND (ProcessNameBuffer ENDSWITH "\\AppData\\Local\\Keybase\\Gui\\Keybase.exe" OR ProcessNameBuffer ENDSWITH "\\Microsoft\\Teams\\stage\\Teams.exe") AND RequestedPolicy EQ "8") OR (FileNameBuffer ENDSWITH "\\Program Files\\ESET\\ESET Security\\eamsi.dll") OR ((FileNameBuffer ENDSWITH "\\Mozilla Firefox\\mozavcodec.dll" OR FileNameBuffer ENDSWITH "\\Mozilla Firefox\\mozavutil.dll") AND ProcessNameBuffer ENDSWITH "\\Mozilla Firefox\\firefox.exe" AND RequestedPolicy EQ "8") OR (FileNameBuffer CONTAINS "\\Program Files\\Google\\Drive File Stream\\" AND FileNameBuffer ENDSWITH "\\crashpad_handler.exe" AND ProcessNameBuffer ENDSWITH "\\Windows\\ImmersiveControlPanel\\SystemSettings.exe" AND RequestedPolicy EQ "8") OR (((ProcessNameBuffer CONTAINS "\\Kaspersky Lab\\" AND ProcessNameBuffer CONTAINS "\\avp.exe")) OR ((FileNameBuffer CONTAINS "\\Kaspersky Lab\\" AND FileNameBuffer CONTAINS "\\antimalware_provider.dll"))) OR ((FileNameBuffer ENDSWITH "\\Program Files\\McAfee\\Endpoint Security\\Threat Prevention\\MfeAmsiProvider.dll" OR FileNameBuffer ENDSWITH "\\Program Files\\McAfee\\MfeAV\\AMSIExt.dll")) OR (FileNameBuffer ENDSWITH "\\Program Files\\National Instruments\\Shared\\mDNS Responder\\nimdnsNSP.dll ") OR (FileNameBuffer CONTAINS "\\Microsoft Office\\root\\vfs\\ProgramFilesCommonX64\\Microsoft Shared\\OFFICE" AND FileNameBuffer ENDSWITH "\\MSOXMLMF.DLL" AND RequestedPolicy EQ "7") OR (ProcessNameBuffer CONTAINS "\\Program Files\\Microsoft Office\\root\\vfs\\ProgramFilesCommonX64\\Microsoft Shared\\Office" AND FileNameBuffer CONTAINS "\\Windows\\System32\\" AND RequestedPolicy EQ "8") OR (FileNameBuffer CONTAINS "\\National Instruments\\Shared\\mDNS Responder\\") OR ((FileNameBuffer CONTAINS "\\Program Files\\SentinelOne\\Sentinel Agent") OR (ProcessNameBuffer CONTAINS "\\Program Files\\SentinelOne\\Sentinel Agent")) OR (FileNameBuffer ENDSWITH "\\Windows\\System32\\nvspcap64.dll" AND ProcessNameBuffer CONTAINS "\\AppData\\Local\\slack\\app-" AND ProcessNameBuffer ENDSWITH "\\slack.exe" AND RequestedPolicy EQ "8") OR (FileNameBuffer ENDSWITH "\\Trend Micro\\Client Server Security Agent\\perficrcperfmonmgr.dll" AND RequestedPolicy EQ "8"))))
