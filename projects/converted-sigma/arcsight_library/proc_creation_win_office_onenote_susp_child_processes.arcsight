// Title: Suspicious Microsoft OneNote Child Process
// ID: c27515df-97a9-4162-8a60-dc0eeb51b775
// Status: test
// Level: high
// Author: Tim Rauch (Nextron Systems), Nasreddine Bencherchali (Nextron Systems), Elastic (idea)
// Date: 2022-10-21
// Tags: attack.t1566, attack.t1566.001, attack.initial-access
// Description: Detects suspicious child processes of the Microsoft OneNote application. This may indicate an attempt to execute malicious embedded objects from a .one file.
// Converted by: Sigma Universal SIEM/EDR CLI

((ParentImage ENDSWITH "\\onenote.exe") AND ((Image ENDSWITH "\\explorer.exe" AND (CommandLine CONTAINS ".hta" OR CommandLine CONTAINS ".vb" OR CommandLine CONTAINS ".wsh" OR CommandLine CONTAINS ".js" OR CommandLine CONTAINS ".ps" OR CommandLine CONTAINS ".scr" OR CommandLine CONTAINS ".pif" OR CommandLine CONTAINS ".bat" OR CommandLine CONTAINS ".cmd")) OR (((OriginalFileName EQ "bitsadmin.exe" OR OriginalFileName EQ "CertOC.exe" OR OriginalFileName EQ "CertUtil.exe" OR OriginalFileName EQ "Cmd.Exe" OR OriginalFileName EQ "CMSTP.EXE" OR OriginalFileName EQ "cscript.exe" OR OriginalFileName EQ "curl.exe" OR OriginalFileName EQ "HH.exe" OR OriginalFileName EQ "IEExec.exe" OR OriginalFileName EQ "InstallUtil.exe" OR OriginalFileName EQ "javaw.exe" OR OriginalFileName EQ "Microsoft.Workflow.Compiler.exe" OR OriginalFileName EQ "msdt.exe" OR OriginalFileName EQ "MSHTA.EXE" OR OriginalFileName EQ "msiexec.exe" OR OriginalFileName EQ "Msxsl.exe" OR OriginalFileName EQ "odbcconf.exe" OR OriginalFileName EQ "pcalua.exe" OR OriginalFileName EQ "PowerShell.EXE" OR OriginalFileName EQ "RegAsm.exe" OR OriginalFileName EQ "RegSvcs.exe" OR OriginalFileName EQ "REGSVR32.exe" OR OriginalFileName EQ "RUNDLL32.exe" OR OriginalFileName EQ "schtasks.exe" OR OriginalFileName EQ "ScriptRunner.exe" OR OriginalFileName EQ "wmic.exe" OR OriginalFileName EQ "WorkFolders.exe" OR OriginalFileName EQ "wscript.exe")) OR ((Image ENDSWITH "\\AppVLP.exe" OR Image ENDSWITH "\\bash.exe" OR Image ENDSWITH "\\bitsadmin.exe" OR Image ENDSWITH "\\certoc.exe" OR Image ENDSWITH "\\certutil.exe" OR Image ENDSWITH "\\cmd.exe" OR Image ENDSWITH "\\cmstp.exe" OR Image ENDSWITH "\\control.exe" OR Image ENDSWITH "\\cscript.exe" OR Image ENDSWITH "\\curl.exe" OR Image ENDSWITH "\\forfiles.exe" OR Image ENDSWITH "\\hh.exe" OR Image ENDSWITH "\\ieexec.exe" OR Image ENDSWITH "\\installutil.exe" OR Image ENDSWITH "\\javaw.exe" OR Image ENDSWITH "\\mftrace.exe" OR Image ENDSWITH "\\Microsoft.Workflow.Compiler.exe" OR Image ENDSWITH "\\msbuild.exe" OR Image ENDSWITH "\\msdt.exe" OR Image ENDSWITH "\\mshta.exe" OR Image ENDSWITH "\\msidb.exe" OR Image ENDSWITH "\\msiexec.exe" OR Image ENDSWITH "\\msxsl.exe" OR Image ENDSWITH "\\odbcconf.exe" OR Image ENDSWITH "\\pcalua.exe" OR Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\pwsh.exe" OR Image ENDSWITH "\\regasm.exe" OR Image ENDSWITH "\\regsvcs.exe" OR Image ENDSWITH "\\regsvr32.exe" OR Image ENDSWITH "\\rundll32.exe" OR Image ENDSWITH "\\schtasks.exe" OR Image ENDSWITH "\\scrcons.exe" OR Image ENDSWITH "\\scriptrunner.exe" OR Image ENDSWITH "\\sh.exe" OR Image ENDSWITH "\\svchost.exe" OR Image ENDSWITH "\\verclsid.exe" OR Image ENDSWITH "\\wmic.exe" OR Image ENDSWITH "\\workfolders.exe" OR Image ENDSWITH "\\wscript.exe"))) OR ((Image CONTAINS "\\AppData\\" OR Image CONTAINS "\\Users\\Public\\" OR Image CONTAINS "\\ProgramData\\" OR Image CONTAINS "\\Windows\\Tasks\\" OR Image CONTAINS "\\Windows\\Temp\\" OR Image CONTAINS "\\Windows\\System32\\Tasks\\"))) AND NOT (((Image CONTAINS "\\AppData\\Local\\Microsoft\\OneDrive\\" AND Image ENDSWITH "\\FileCoAuth.exe" AND CommandLine ENDSWITH "-Embedding") OR (Image ENDSWITH "\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe" AND CommandLine ENDSWITH "-Embedding"))))
