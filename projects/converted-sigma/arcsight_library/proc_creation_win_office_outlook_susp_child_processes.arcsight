// Title: Suspicious Outlook Child Process
// ID: 208748f7-881d-47ac-a29c-07ea84bf691d
// Status: test
// Level: high
// Author: Michael Haag, Florian Roth (Nextron Systems), Markus Neis, Elastic, FPT.EagleEye Team
// Date: 2022-02-28
// Tags: attack.execution, attack.t1204.002
// Description: Detects a suspicious process spawning from an Outlook process.
// Converted by: Sigma Universal SIEM/EDR CLI

(ParentImage ENDSWITH "\\OUTLOOK.EXE" AND (Image ENDSWITH "\\AppVLP.exe" OR Image ENDSWITH "\\bash.exe" OR Image ENDSWITH "\\cmd.exe" OR Image ENDSWITH "\\cscript.exe" OR Image ENDSWITH "\\forfiles.exe" OR Image ENDSWITH "\\hh.exe" OR Image ENDSWITH "\\mftrace.exe" OR Image ENDSWITH "\\msbuild.exe" OR Image ENDSWITH "\\msdt.exe" OR Image ENDSWITH "\\mshta.exe" OR Image ENDSWITH "\\msiexec.exe" OR Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\pwsh.exe" OR Image ENDSWITH "\\regsvr32.exe" OR Image ENDSWITH "\\schtasks.exe" OR Image ENDSWITH "\\scrcons.exe" OR Image ENDSWITH "\\scriptrunner.exe" OR Image ENDSWITH "\\sh.exe" OR Image ENDSWITH "\\svchost.exe" OR Image ENDSWITH "\\wmic.exe" OR Image ENDSWITH "\\wscript.exe"))
