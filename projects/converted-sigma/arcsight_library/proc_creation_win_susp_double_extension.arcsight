// Title: Suspicious Double Extension File Execution
// ID: 1cdd9a09-06c9-4769-99ff-626e2b3991b8
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems), @blu3_team (idea), Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-06-26
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects suspicious use of an .exe extension after a non-executable file extension like .pdf.exe, a set of spaces or underlines to cloak the executable file in spear phishing campaigns
// Converted by: Sigma Universal SIEM/EDR CLI

((Image ENDSWITH "      .exe" OR Image ENDSWITH "______.exe" OR Image ENDSWITH ".doc.exe" OR Image ENDSWITH ".doc.js" OR Image ENDSWITH ".docx.exe" OR Image ENDSWITH ".docx.js" OR Image ENDSWITH ".gif.exe" OR Image ENDSWITH ".jpeg.exe" OR Image ENDSWITH ".jpg.exe" OR Image ENDSWITH ".mkv.exe" OR Image ENDSWITH ".mov.exe" OR Image ENDSWITH ".mp3.exe" OR Image ENDSWITH ".mp4.exe" OR Image ENDSWITH ".pdf.exe" OR Image ENDSWITH ".pdf.js" OR Image ENDSWITH ".png.exe" OR Image ENDSWITH ".ppt.exe" OR Image ENDSWITH ".ppt.js" OR Image ENDSWITH ".pptx.exe" OR Image ENDSWITH ".pptx.js" OR Image ENDSWITH ".rtf.exe" OR Image ENDSWITH ".rtf.js" OR Image ENDSWITH ".svg.exe" OR Image ENDSWITH ".txt.exe" OR Image ENDSWITH ".txt.js" OR Image ENDSWITH ".xls.exe" OR Image ENDSWITH ".xls.js" OR Image ENDSWITH ".xlsx.exe" OR Image ENDSWITH ".xlsx.js" OR Image ENDSWITH "⠀⠀⠀⠀⠀⠀.exe") AND (CommandLine CONTAINS "      .exe" OR CommandLine CONTAINS "______.exe" OR CommandLine CONTAINS ".doc.exe" OR CommandLine CONTAINS ".doc.js" OR CommandLine CONTAINS ".docx.exe" OR CommandLine CONTAINS ".docx.js" OR CommandLine CONTAINS ".gif.exe" OR CommandLine CONTAINS ".jpeg.exe" OR CommandLine CONTAINS ".jpg.exe" OR CommandLine CONTAINS ".mkv.exe" OR CommandLine CONTAINS ".mov.exe" OR CommandLine CONTAINS ".mp3.exe" OR CommandLine CONTAINS ".mp4.exe" OR CommandLine CONTAINS ".pdf.exe" OR CommandLine CONTAINS ".pdf.js" OR CommandLine CONTAINS ".png.exe" OR CommandLine CONTAINS ".ppt.exe" OR CommandLine CONTAINS ".ppt.js" OR CommandLine CONTAINS ".pptx.exe" OR CommandLine CONTAINS ".pptx.js" OR CommandLine CONTAINS ".rtf.exe" OR CommandLine CONTAINS ".rtf.js" OR CommandLine CONTAINS ".svg.exe" OR CommandLine CONTAINS ".txt.exe" OR CommandLine CONTAINS ".txt.js" OR CommandLine CONTAINS ".xls.exe" OR CommandLine CONTAINS ".xls.js" OR CommandLine CONTAINS ".xlsx.exe" OR CommandLine CONTAINS ".xlsx.js" OR CommandLine CONTAINS "⠀⠀⠀⠀⠀⠀.exe"))
