// Title: Suspicious PowerShell Encoded Command Patterns
// ID: b9d9cc83-380b-4ba3-8d8f-60c0e7e2930c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-05-24
// Tags: attack.execution, attack.t1059.001
// Description: Detects PowerShell command line patterns in combincation with encoded commands that often appear in malware infection chains
// Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine CONTAINS " JAB" OR CommandLine CONTAINS " SUVYI" OR CommandLine CONTAINS " SQBFAFgA" OR CommandLine CONTAINS " aWV4I" OR CommandLine CONTAINS " IAB" OR CommandLine CONTAINS " PAA" OR CommandLine CONTAINS " aQBlAHgA")) AND ((CommandLine CONTAINS " -e " OR CommandLine CONTAINS " -en " OR CommandLine CONTAINS " -enc " OR CommandLine CONTAINS " -enco")) AND (((Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\pwsh.exe")) OR ((OriginalFileName EQ "PowerShell.Exe" OR OriginalFileName EQ "pwsh.dll")))) AND NOT (((ParentImage CONTAINS "C:\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\" OR ParentImage CONTAINS "\\gc_worker.exe"))))
