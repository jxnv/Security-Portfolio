// Title: PowerShell Core DLL Loaded Via Office Application
// ID: bb2ba6fb-95d4-4a25-89fc-30bb736c021a
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-01
// Tags: attack.stealth
// Description: Detects PowerShell core DLL being loaded by an Office Product
// Converted by: Sigma Universal SIEM/EDR CLI

((Image ENDSWITH "\\excel.exe" OR Image ENDSWITH "\\mspub.exe" OR Image ENDSWITH "\\outlook.exe" OR Image ENDSWITH "\\onenote.exe" OR Image ENDSWITH "\\onenoteim.exe" OR Image ENDSWITH "\\powerpnt.exe" OR Image ENDSWITH "\\winword.exe") AND (ImageLoaded CONTAINS "\\System.Management.Automation.Dll" OR ImageLoaded CONTAINS "\\System.Management.Automation.ni.Dll"))
