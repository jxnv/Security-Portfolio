// Title: Local Groups Discovery - Linux
// ID: 676381a6-15ca-4d73-a9c8-6a22e970b90d
// Status: test
// Level: low
// Author: Ömer Günal, Alejandro Ortuno, oscd.community
// Date: 2020-10-11
// Tags: attack.discovery, attack.t1069.001
// Description: Detects enumeration of local system groups. Adversaries may attempt to find local system groups and permission settings
// Converted by: Sigma Universal SIEM/EDR CLI

((Image ENDSWITH "/groups") OR ((Image ENDSWITH "/cat" OR Image ENDSWITH "/ed" OR Image ENDSWITH "/head" OR Image ENDSWITH "/less" OR Image ENDSWITH "/more" OR Image ENDSWITH "/nano" OR Image ENDSWITH "/tail" OR Image ENDSWITH "/vi" OR Image ENDSWITH "/vim") AND CommandLine CONTAINS "/etc/group"))
