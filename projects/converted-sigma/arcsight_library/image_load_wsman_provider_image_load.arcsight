// Title: Suspicious WSMAN Provider Image Loads
// ID: ad1f4bb9-8dfb-4765-adb6-2a7cfb6c0f94
// Status: test
// Level: medium
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2020-06-24
// Tags: attack.execution, attack.t1059.001, attack.lateral-movement, attack.t1021.003
// Description: Detects signs of potential use of the WSMAN provider from uncommon processes locally and remote execution.
// Converted by: Sigma Universal SIEM/EDR CLI

(((((ImageLoaded ENDSWITH "\\WsmSvc.dll" OR ImageLoaded ENDSWITH "\\WsmAuto.dll" OR ImageLoaded ENDSWITH "\\Microsoft.WSMan.Management.ni.dll")) OR ((OriginalFileName EQ "WsmSvc.dll" OR OriginalFileName EQ "WSMANAUTOMATION.DLL" OR OriginalFileName EQ "Microsoft.WSMan.Management.dll"))) OR (Image ENDSWITH "\\svchost.exe" AND OriginalFileName EQ "WsmWmiPl.dll")) AND NOT (((Image STARTSWITH "C:\\Program Files\\Citrix\\") OR ((Image EQ "C:\\Program Files (x86)\\PowerShell\\6\\pwsh.exe" OR Image EQ "C:\\Program Files (x86)\\PowerShell\\7\\pwsh.exe" OR Image EQ "C:\\Program Files\\PowerShell\\6\\pwsh.exe" OR Image EQ "C:\\Program Files\\PowerShell\\7\\pwsh.exe" OR Image EQ "C:\\Windows\\System32\\sdiagnhost.exe" OR Image EQ "C:\\Windows\\System32\\services.exe" OR Image EQ "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" OR Image EQ "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe")) OR (Image STARTSWITH "C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_" AND Image ENDSWITH "\\GetHelp.exe") OR (Image ENDSWITH "\\mmc.exe") OR ((Image STARTSWITH "C:\\Windows\\Microsoft.NET\\Framework64\\v" OR Image STARTSWITH "C:\\Windows\\Microsoft.NET\\Framework\\v" OR Image STARTSWITH "C:\\Windows\\Microsoft.NET\\FrameworkArm\\v" OR Image STARTSWITH "C:\\Windows\\Microsoft.NET\\FrameworkArm64\\v") AND Image ENDSWITH "\\mscorsvw.exe") OR (Image STARTSWITH "C:\\Windows\\Temp\\asgard2-agent\\") OR ((CommandLine CONTAINS "svchost.exe -k netsvcs -p -s BITS" OR CommandLine CONTAINS "svchost.exe -k GraphicsPerfSvcGroup -s GraphicsPerfSvc" OR CommandLine CONTAINS "svchost.exe -k NetworkService -p -s Wecsvc" OR CommandLine CONTAINS "svchost.exe -k netsvcs")) OR ((Image EQ "C:\\Windows\\System32\\Configure-SMRemoting.exe" OR Image EQ "C:\\Windows\\System32\\ServerManager.exe")) OR (Image STARTSWITH "C:\\$WINDOWS.~BT\\Sources\\"))) AND NOT (((Image ENDSWITH "\\svchost.exe") AND (NOT CommandLine=*))))
