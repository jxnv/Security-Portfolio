// Title: Network Communication Initiated To File Sharing Domains From Process Located In Suspicious Folder
// ID: e0f8ab85-0ac9-423b-a73a-81b3c7b1aa97
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2018-08-30
// Tags: attack.command-and-control, attack.t1105
// Description: Detects executables located in potentially suspicious directories initiating network connections towards file sharing domains.
// Converted by: Sigma Universal SIEM/EDR CLI

((Initiated EQ "true" AND (DestinationHostname ENDSWITH ".githubusercontent.com" OR DestinationHostname ENDSWITH "0x0.st" OR DestinationHostname ENDSWITH "anonfiles.com" OR DestinationHostname ENDSWITH "bashupload.com" OR DestinationHostname ENDSWITH "cdn.discordapp.com" OR DestinationHostname ENDSWITH "chunk.io" OR DestinationHostname ENDSWITH "ddns.net" OR DestinationHostname ENDSWITH "dl.dropboxusercontent.com" OR DestinationHostname ENDSWITH "ghostbin.co" OR DestinationHostname ENDSWITH "github.com" OR DestinationHostname ENDSWITH "glitch.me" OR DestinationHostname ENDSWITH "gofile.io" OR DestinationHostname ENDSWITH "hastebin.com" OR DestinationHostname ENDSWITH "mediafire.com" OR DestinationHostname ENDSWITH "mega.co.nz" OR DestinationHostname ENDSWITH "mega.nz" OR DestinationHostname ENDSWITH "onrender.com" OR DestinationHostname ENDSWITH "pages.dev" OR DestinationHostname ENDSWITH "paste.ee" OR DestinationHostname ENDSWITH "pastebin.com" OR DestinationHostname ENDSWITH "pastebin.pl" OR DestinationHostname ENDSWITH "pastetext.net" OR DestinationHostname ENDSWITH "pixeldrain.com" OR DestinationHostname ENDSWITH "privatlab.com" OR DestinationHostname ENDSWITH "privatlab.net" OR DestinationHostname ENDSWITH "send.exploit.in" OR DestinationHostname ENDSWITH "sendspace.com" OR DestinationHostname ENDSWITH "storage.googleapis.com" OR DestinationHostname ENDSWITH "storjshare.io" OR DestinationHostname ENDSWITH "supabase.co" OR DestinationHostname ENDSWITH "temp.sh" OR DestinationHostname ENDSWITH "transfer.sh" OR DestinationHostname ENDSWITH "trycloudflare.com" OR DestinationHostname ENDSWITH "ufile.io" OR DestinationHostname ENDSWITH "w3spaces.com" OR DestinationHostname ENDSWITH "workers.dev" OR DestinationHostname ENDSWITH "x0.at")) AND ((Image CONTAINS ":\\$Recycle.bin" OR Image CONTAINS ":\\Perflogs\\" OR Image CONTAINS ":\\Temp\\" OR Image CONTAINS ":\\Users\\Default\\" OR Image CONTAINS ":\\Users\\Public\\" OR Image CONTAINS ":\\Windows\\Fonts\\" OR Image CONTAINS ":\\Windows\\IME\\" OR Image CONTAINS ":\\Windows\\System32\\Tasks\\" OR Image CONTAINS ":\\Windows\\Tasks\\" OR Image CONTAINS ":\\Windows\\Temp\\" OR Image CONTAINS "\\AppData\\Temp\\" OR Image CONTAINS "\\config\\systemprofile\\" OR Image CONTAINS "\\Windows\\addins\\")))
