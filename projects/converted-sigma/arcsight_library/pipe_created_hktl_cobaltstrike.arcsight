// Title: CobaltStrike Named Pipe
// ID: d5601f8c-b26f-4ab0-9035-69e11a8d4ad2
// Status: test
// Level: critical
// Author: Florian Roth (Nextron Systems), Wojciech Lesicki
// Date: 2021-05-25
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects the creation of a named pipe as used by CobaltStrike
// Converted by: Sigma Universal SIEM/EDR CLI

(((PipeName CONTAINS "\\MSSE-" AND PipeName CONTAINS "-server")) OR (PipeName STARTSWITH "\\interprocess_") OR (PipeName STARTSWITH "\\lsarpc_") OR (PipeName STARTSWITH "\\mojo_") OR (PipeName STARTSWITH "\\msagent_") OR (PipeName STARTSWITH "\\netlogon_") OR (PipeName STARTSWITH "\\postex_") OR (PipeName STARTSWITH "\\samr_") OR (PipeName STARTSWITH "\\srvsvc_") OR (PipeName STARTSWITH "\\status_") OR (PipeName STARTSWITH "\\wkssvc_"))
