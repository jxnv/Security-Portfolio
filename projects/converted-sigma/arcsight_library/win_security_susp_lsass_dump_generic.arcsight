// Title: Potentially Suspicious AccessMask Requested From LSASS
// ID: 4a1b6da0-d94f-4fc3-98fc-2d9cb9e5ee76
// Status: test
// Level: medium
// Author: Roberto Rodriguez, Teymur Kheirkhabarov, Dimitrios Slamaris, Mark Russinovich, Aleksey Potapov, oscd.community (update)
// Date: 2019-11-01
// Tags: attack.credential-access, car.2019-04-004, attack.t1003.001
// Description: Detects process handle on LSASS process with certain access mask
// Converted by: Sigma Universal SIEM/EDR CLI

(((EventID EQ "4656" AND ObjectName ENDSWITH "\\lsass.exe" AND (AccessMask CONTAINS "0x40" OR AccessMask CONTAINS "0x1400" OR AccessMask CONTAINS "0x100000" OR AccessMask CONTAINS "0x1410" OR AccessMask CONTAINS "0x1010" OR AccessMask CONTAINS "0x1438" OR AccessMask CONTAINS "0x143a" OR AccessMask CONTAINS "0x1418" OR AccessMask CONTAINS "0x1f0fff" OR AccessMask CONTAINS "0x1f1fff" OR AccessMask CONTAINS "0x1f2fff" OR AccessMask CONTAINS "0x1f3fff")) OR (EventID EQ "4663" AND ObjectName ENDSWITH "\\lsass.exe" AND (AccessList CONTAINS "4484" OR AccessList CONTAINS "4416"))) AND NOT (((ProcessName CONTAINS ":\\Windows\\Temp\\asgard2-agent-sc\\aurora\\" AND ProcessName ENDSWITH "\\aurora-agent-64.exe" AND AccessList CONTAINS "%%4484") OR ((ProcessName CONTAINS ":\\Users\\" AND ProcessName CONTAINS "\\AppData\\Local\\Temp\\is-") AND ProcessName ENDSWITH "\\avira_system_speedup.tmp" AND AccessList CONTAINS "%%4484") OR (ProcessName CONTAINS ":\\Windows\\Temp\\" AND ProcessName ENDSWITH "\\avira_speedup_setup_update.tmp" AND AccessList CONTAINS "%%4484") OR ((ProcessName ENDSWITH ":\\Windows\\System32\\taskhostw.exe" OR ProcessName ENDSWITH ":\\Windows\\System32\\msiexec.exe" OR ProcessName ENDSWITH ":\\Windows\\CCM\\CcmExec.exe")) OR (ProcessName CONTAINS ":\\Program Files") OR (ProcessName CONTAINS ":\\Windows\\SystemTemp\\" AND ProcessName ENDSWITH "\\GoogleUpdate.exe" AND AccessList CONTAINS "%%4484") OR (ProcessName ENDSWITH "\\x64\\SCENARIOENGINE.EXE" AND AccessList CONTAINS "%%4484") OR (ProcessName ENDSWITH ":\\Windows\\System32\\snmp.exe" AND AccessList CONTAINS "%%4484") OR ((ProcessName ENDSWITH "\\csrss.exe" OR ProcessName ENDSWITH "\\GamingServices.exe" OR ProcessName ENDSWITH "\\lsm.exe" OR ProcessName ENDSWITH "\\MicrosoftEdgeUpdate.exe" OR ProcessName ENDSWITH "\\minionhost.exe" OR ProcessName ENDSWITH "\\MRT.exe" OR ProcessName ENDSWITH "\\MsMpEng.exe" OR ProcessName ENDSWITH "\\perfmon.exe" OR ProcessName ENDSWITH "\\procexp.exe" OR ProcessName ENDSWITH "\\procexp64.exe" OR ProcessName ENDSWITH "\\procexp64a.exe" OR ProcessName ENDSWITH "\\svchost.exe" OR ProcessName ENDSWITH "\\taskmgr.exe" OR ProcessName ENDSWITH "\\thor.exe" OR ProcessName ENDSWITH "\\thor64.exe" OR ProcessName ENDSWITH "\\vmtoolsd.exe" OR ProcessName ENDSWITH "\\VsTskMgr.exe" OR ProcessName ENDSWITH "\\wininit.exe" OR ProcessName ENDSWITH "\\wmiprvse.exe" OR ProcessName ENDSWITH "RtkAudUService64") AND (ProcessName CONTAINS ":\\Program Files (x86)\\" OR ProcessName CONTAINS ":\\Program Files\\" OR ProcessName CONTAINS ":\\ProgramData\\Microsoft\\Windows Defender\\Platform\\" OR ProcessName CONTAINS ":\\Windows\\SysNative\\" OR ProcessName CONTAINS ":\\Windows\\System32\\" OR ProcessName CONTAINS ":\\Windows\\SysWow64\\" OR ProcessName CONTAINS ":\\Windows\\Temp\\asgard2-agent\\")) OR ((ProcessName ENDSWITH ":\\Windows\\Sysmon64.exe" OR ProcessName ENDSWITH ":\\Windows\\Sysmon64a.exe") AND AccessList CONTAINS "%%4484"))) AND NOT (((ProcessName ENDSWITH "\\procmon64.exe" OR ProcessName ENDSWITH "\\procmon64a.exe" OR ProcessName ENDSWITH "\\procmon.exe") AND AccessList CONTAINS "%%4484")))
