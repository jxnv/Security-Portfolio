// Title: Suspicious Windows Defender Registry Key Tampering Via Reg.EXE
// ID: 452bce90-6fb0-43cc-97a5-affc283139b3
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Swachchhanda Shrawan Poudel, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-03-22
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects the usage of "reg.exe" to tamper with different Windows Defender registry keys in order to disable some important features related to protection and detection
// Converted by: Sigma Universal SIEM/EDR CLI

((((Image ENDSWITH "\\reg.exe") OR (OriginalFileName EQ "reg.exe")) AND ((CommandLine CONTAINS "SOFTWARE\\Microsoft\\Windows Defender\\" OR CommandLine CONTAINS "SOFTWARE\\Policies\\Microsoft\\Windows Defender Security Center" OR CommandLine CONTAINS "SOFTWARE\\Policies\\Microsoft\\Windows Defender\\"))) AND (((CommandLine CONTAINS " add " AND CommandLine CONTAINS "d 0") AND (CommandLine CONTAINS "DisallowExploitProtectionOverride" OR CommandLine CONTAINS "EnableControlledFolderAccess" OR CommandLine CONTAINS "MpEnablePus" OR CommandLine CONTAINS "PUAProtection" OR CommandLine CONTAINS "SpynetReporting" OR CommandLine CONTAINS "SubmitSamplesConsent" OR CommandLine CONTAINS "TamperProtection")) OR ((CommandLine CONTAINS " add " AND CommandLine CONTAINS "d 1") AND (CommandLine CONTAINS "DisableAccess" OR CommandLine CONTAINS "DisableAntiSpyware" OR CommandLine CONTAINS "DisableAntiSpywareRealtimeProtection" OR CommandLine CONTAINS "DisableAntiVirus" OR CommandLine CONTAINS "DisableAntiVirusSignatures" OR CommandLine CONTAINS "DisableArchiveScanning" OR CommandLine CONTAINS "DisableBehaviorMonitoring" OR CommandLine CONTAINS "DisableBlockAtFirstSeen" OR CommandLine CONTAINS "DisableCloudProtection" OR CommandLine CONTAINS "DisableConfig" OR CommandLine CONTAINS "DisableEnhancedNotifications" OR CommandLine CONTAINS "DisableIntrusionPreventionSystem" OR CommandLine CONTAINS "DisableIOAVProtection" OR CommandLine CONTAINS "DisableNetworkProtection" OR CommandLine CONTAINS "DisableOnAccessProtection" OR CommandLine CONTAINS "DisablePrivacyMode" OR CommandLine CONTAINS "DisableRealtimeMonitoring" OR CommandLine CONTAINS "DisableRoutinelyTakingAction" OR CommandLine CONTAINS "DisableScanOnRealtimeEnable" OR CommandLine CONTAINS "DisableScriptScanning" OR CommandLine CONTAINS "DisableSecurityCenter" OR CommandLine CONTAINS "Notification_Suppress" OR CommandLine CONTAINS "SignatureDisableUpdateOnStartupWithoutEngine"))))
