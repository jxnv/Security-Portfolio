// Title: Scheduled Task Creation Via Schtasks.EXE
// ID: 92626ddd-662c-49e3-ac59-f6535f12d189
// Status: test
// Level: low
// Author: Florian Roth (Nextron Systems)
// Date: 2019-01-16
// Tags: attack.execution, attack.persistence, attack.privilege-escalation, attack.t1053.005, attack.s0111, car.2013-08-001, stp.1u
// Description: Detects the creation of scheduled tasks by user accounts via the "schtasks" utility.
// Converted by: Sigma Universal SIEM/EDR CLI

((Image ENDSWITH "\\schtasks.exe" AND CommandLine CONTAINS " /create ") AND NOT (((User CONTAINS "AUTHORI" OR User CONTAINS "AUTORI"))) AND NOT (((ParentImage EQ "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe" OR ParentImage EQ "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe") AND (Image EQ "C:\\Windows\\System32\\schtasks.exe" OR Image EQ "C:\\Windows\\SysWOW64\\schtasks.exe") AND CommandLine CONTAINS "Microsoft\\Office\\Office Performance Monitor")))
