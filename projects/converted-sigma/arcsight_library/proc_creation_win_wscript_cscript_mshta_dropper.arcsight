// Title: Potential Dropper Script Execution Via WScript/CScript/MSHTA
// ID: cea72823-df4d-4567-950c-0b579eaf0846
// Status: test
// Level: medium
// Author: Margaritis Dimitrios (idea), Florian Roth (Nextron Systems), oscd.community, Nasreddine Bencherchali (Nextron Systems), Dave Johnson
// Date: 2019-01-16
// Tags: attack.execution, attack.t1059.005, attack.t1059.007
// Description: Detects wscript/cscript/mshta executions of scripts located in user directories
// Converted by: Sigma Universal SIEM/EDR CLI

(((Image ENDSWITH "\\wscript.exe" OR Image ENDSWITH "\\cscript.exe" OR Image ENDSWITH "\\mshta.exe")) AND ((CommandLine CONTAINS ".hta" OR CommandLine CONTAINS ".js" OR CommandLine CONTAINS ".jse" OR CommandLine CONTAINS ".vba" OR CommandLine CONTAINS ".vbe" OR CommandLine CONTAINS ".vbs" OR CommandLine CONTAINS ".wsf" OR CommandLine CONTAINS ".wsh")) AND ((CommandLine CONTAINS ":\\Perflogs\\" OR CommandLine CONTAINS ":\\Temp\\" OR CommandLine CONTAINS ":\\Tmp\\" OR CommandLine CONTAINS ":\\Users\\Public\\" OR CommandLine CONTAINS ":\\Windows\\Temp\\" OR CommandLine CONTAINS "\\AppData\\Local\\Temp\\" OR CommandLine CONTAINS "\\AppData\\Roaming\\Temp\\" OR CommandLine CONTAINS "\\Start Menu\\Programs\\Startup\\" OR CommandLine CONTAINS "\\Temporary Internet" OR CommandLine CONTAINS "\\Windows\\Temp" OR CommandLine CONTAINS "%LocalAppData%\\Temp\\" OR CommandLine CONTAINS "%TEMP%" OR CommandLine CONTAINS "%TMP%")))
