// Title: File Download with Headless Browser
// ID: 0e8cfe08-02c9-4815-a2f8-0d157b7ed33e
// Status: test
// Level: high
// Author: Sreeman, Florian Roth (Nextron Systems)
// Date: 2022-01-04
// Tags: attack.command-and-control, attack.stealth, attack.t1105, attack.t1564.003
// Description: Detects execution of chromium based browser in headless mode using the "dump-dom" command line to download files
// Converted by: Sigma Universal SIEM/EDR CLI

(((Image ENDSWITH "\\brave.exe" OR Image ENDSWITH "\\chrome.exe" OR Image ENDSWITH "\\msedge.exe" OR Image ENDSWITH "\\opera.exe" OR Image ENDSWITH "\\vivaldi.exe") AND (CommandLine CONTAINS "--headless" AND CommandLine CONTAINS "dump-dom" AND CommandLine CONTAINS "http")) AND NOT ((((Image STARTSWITH "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\" OR Image STARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" OR Image STARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\" OR Image STARTSWITH "C:\\Program Files\\Microsoft\\Edge\\Application\\" OR Image STARTSWITH "C:\\Program Files\\Microsoft\\EdgeCore\\" OR Image STARTSWITH "C:\\Program Files\\Microsoft\\EdgeWebView\\" OR Image STARTSWITH "C:\\Program Files\\WindowsApps\\Microsoft.MicrosoftEdge") AND (Image ENDSWITH "\\msedge.exe" OR Image ENDSWITH "\\msedgewebview2.exe" OR Image ENDSWITH "\\MicrosoftEdge.exe") AND CommandLine CONTAINS "--headless --disable-gpu --disable-extensions --disable-plugins --mute-audio --no-first-run --incognito --aggressive-cache-discard --dump-dom") OR ((Image CONTAINS "\\AppData\\Local\\Microsoft\\WindowsApps\\" OR Image CONTAINS "\\Windows\\SystemApps\\Microsoft.MicrosoftEdge") AND (Image ENDSWITH "\\msedge.exe" OR Image ENDSWITH "\\MicrosoftEdge.exe") AND CommandLine CONTAINS "--headless --disable-gpu --disable-extensions --disable-plugins --mute-audio --no-first-run --incognito --aggressive-cache-discard --dump-dom"))))
