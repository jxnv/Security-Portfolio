// Title: Suspicious Binary In User Directory Spawned From Office Application
// ID: aa3a6f94-890e-4e22-b634-ffdfd54792cc
// Status: test
// Level: high
// Author: Jason Lynch
// Date: 2019-04-02
// Tags: attack.execution, attack.t1204.002, attack.g0046, car.2013-05-002
// Description: Detects an executable in the users directory started from one of the Microsoft Office suite applications (Word, Excel, PowerPoint, Publisher, Visio)
// Converted by: Sigma Universal SIEM/EDR CLI

(((ParentImage ENDSWITH "\\WINWORD.EXE" OR ParentImage ENDSWITH "\\EXCEL.EXE" OR ParentImage ENDSWITH "\\POWERPNT.exe" OR ParentImage ENDSWITH "\\MSPUB.exe" OR ParentImage ENDSWITH "\\VISIO.exe" OR ParentImage ENDSWITH "\\MSACCESS.exe" OR ParentImage ENDSWITH "\\EQNEDT32.exe") AND Image STARTSWITH "C:\\users\\" AND Image ENDSWITH ".exe") AND NOT ((Image ENDSWITH "\\Teams.exe")))
