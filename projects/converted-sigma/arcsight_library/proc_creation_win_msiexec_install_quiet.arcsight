// Title: Msiexec Quiet Installation
// ID: 79a87aa6-e4bd-42fc-a5bb-5e6fbdcd62f5
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-01-16
// Tags: attack.stealth, attack.t1218.007
// Description: Adversaries may abuse msiexec.exe to proxy execution of malicious payloads.
// Msiexec.exe is the command-line utility for the Windows Installer and is thus commonly associated with executing installation packages (.msi)
// Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine CONTAINS "-i" OR CommandLine CONTAINS "/i" OR CommandLine CONTAINS "-package" OR CommandLine CONTAINS "/package" OR CommandLine CONTAINS "-a" OR CommandLine CONTAINS "/a" OR CommandLine CONTAINS "-j" OR CommandLine CONTAINS "/j")) AND ((Image ENDSWITH "\\msiexec.exe") OR (OriginalFileName EQ "msiexec.exe")) AND ((CommandLine CONTAINS "-q" OR CommandLine CONTAINS "/q"))) AND NOT (((ParentImage EQ "C:\\Windows\\CCM\\Ccm32BitLauncher.exe" AND (IntegrityLevel EQ "System" OR IntegrityLevel EQ "S-1-16-16384")) OR (ParentImage STARTSWITH "C:\\Windows\\Temp\\"))) AND NOT (((ParentImage STARTSWITH "C:\\Users\\" AND ParentImage CONTAINS "\\AppData\\Local\\Temp\\") OR (ParentImage ENDSWITH "C:\\Windows\\System32\\wsl.exe" AND Image ENDSWITH "C:\\Windows\\System32\\msiexec.exe"))))
