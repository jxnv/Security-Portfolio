// Title: Potential Persistence Via Notepad++ Plugins
// ID: 54127bd4-f541-4ac3-afdb-ea073f63f692
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-10
// Tags: attack.persistence
// Description: Detects creation of new ".dll" files inside the plugins directory of a notepad++ installation by a process other than "gup.exe". Which could indicates possible persistence
// Converted by: Sigma Universal SIEM/EDR CLI

((TargetFilename CONTAINS "\\Notepad++\\plugins\\" AND TargetFilename ENDSWITH ".dll") AND NOT (((Image ENDSWITH "\\Notepad++\\updater\\gup.exe") OR (Image STARTSWITH "C:\\Users\\" AND Image CONTAINS "\\AppData\\Local\\Temp\\" AND (Image ENDSWITH "\\target.exe" OR Image ENDSWITH "Installer.x64.exe")) OR (Image CONTAINS "\\npp." AND Image ENDSWITH ".exe" AND (TargetFilename EQ "C:\\Program Files\\Notepad++\\plugins\\NppExport\\NppExport.dll" OR TargetFilename EQ "C:\\Program Files\\Notepad++\\plugins\\mimeTools\\mimeTools.dll" OR TargetFilename EQ "C:\\Program Files\\Notepad++\\plugins\\NppConverter\\NppConverter.dll" OR TargetFilename EQ "C:\\Program Files\\Notepad++\\plugins\\Config\\nppPluginList.dll")))))
