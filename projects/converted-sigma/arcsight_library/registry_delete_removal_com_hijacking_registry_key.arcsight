// Title: Removal of Potential COM Hijacking Registry Keys
// ID: 96f697b0-b499-4e5d-9908-a67bec11cdb6
// Status: test
// Level: medium
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2020-05-02
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects any deletion of entries in ".*\shell\open\command" registry keys.
// These registry keys might have been used for COM hijacking activities by a threat actor or an attacker and the deletion could indicate steps to remove its tracks.
// Converted by: Sigma Universal SIEM/EDR CLI

((TargetObject ENDSWITH "\\shell\\open\\command") AND NOT (((Image ENDSWITH "C:\\Windows\\explorer.exe") OR ((Image STARTSWITH "C:\\Program Files\\" OR Image STARTSWITH "C:\\Program Files (x86)\\")) OR ((Image EQ "C:\\Windows\\System32\\msiexec.exe" OR Image EQ "C:\\Windows\\SysWOW64\\msiexec.exe")) OR (Image EQ "C:\\Windows\\System32\\OpenWith.exe") OR (Image EQ "C:\\Windows\\system32\\svchost.exe"))) AND NOT ((((Image EQ "C:\\Program Files (x86)\\Avira\\Antivirus\\" OR Image EQ "C:\\Program Files\\Avira\\Antivirus\\") AND (TargetObject ENDSWITH "\\CLSID\\{305CA226-D286-468e-B848-2B2E8E697B74}\\Shell\\Open\\Command" OR TargetObject ENDSWITH "\\AntiVir.Keyfile\\shell\\open\\command")) OR (Image ENDSWITH "\\reg.exe" AND TargetObject ENDSWITH "\\Discord\\shell\\open\\command") OR (Image ENDSWITH "\\Dropbox.exe" AND TargetObject CONTAINS "\\Dropbox.") OR (Image ENDSWITH "C:\\eclipse\\eclipse.exe" AND TargetObject CONTAINS "_Classes\\eclipse+") OR (Image CONTAINS "\\Microsoft\\EdgeUpdate\\Install") OR (Image ENDSWITH "\\Everything.exe" AND TargetObject CONTAINS "\\Everything.") OR (((Image CONTAINS "AppData\\Local\\Temp" AND Image CONTAINS "\\setup.exe")) OR ((Image CONTAINS "\\Temp\\is-" AND Image CONTAINS "\\target.tmp"))) OR (Image STARTSWITH "C:\\Program Files (x86)\\Java\\" AND Image ENDSWITH "\\installer.exe" AND TargetObject CONTAINS "\\Classes\\WOW6432Node\\CLSID\\{4299124F-F2C3-41b4-9C73-9236B2AD0E8F}") OR (Image ENDSWITH "\\ninite.exe") OR (Image CONTAINS "peazip" AND TargetObject CONTAINS "\\PeaZip.") OR (Image ENDSWITH "\\Spotify.exe" AND TargetObject ENDSWITH "\\Spotify\\shell\\open\\command") OR ((Image CONTAINS "\\Temp" AND Image CONTAINS "\\TeamViewer")) OR (Image STARTSWITH "C:\\Windows\\Installer\\MSI") OR (Image ENDSWITH "\\AppData\\Local\\Temp\\Wireshark_uninstaller.exe" AND TargetObject CONTAINS "\\wireshark-capture-file\\"))))
