// Title: PowerShell Set-Acl On Windows Folder
// ID: 0944e002-e3f6-4eb5-bf69-3a3067b53d73
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-18
// Tags: attack.stealth
// Description: Detects PowerShell scripts to set the ACL to a file in the Windows folder
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAINS "Set-Acl " AND CommandLine CONTAINS "-AclObject ")) AND (((OriginalFileName EQ "PowerShell.EXE" OR OriginalFileName EQ "pwsh.dll")) OR ((Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\pwsh.exe"))) AND ((CommandLine CONTAINS "-Path \"C:\\Windows" OR CommandLine CONTAINS "-Path 'C:\\Windows" OR CommandLine CONTAINS "-Path %windir%" OR CommandLine CONTAINS "-Path $env:windir")) AND ((CommandLine CONTAINS "FullControl" OR CommandLine CONTAINS "Allow")))
