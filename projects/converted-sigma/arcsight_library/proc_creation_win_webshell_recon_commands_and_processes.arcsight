// Title: Webshell Detection With Command Line Keywords
// ID: bed2a484-9348-4143-8a8a-b801c979301c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Jonhnathan Ribeiro, Anton Kutepov, oscd.community, Chad Hudson, Matt Anderson
// Date: 2017-01-01
// Tags: attack.persistence, attack.discovery, attack.t1505.003, attack.t1018, attack.t1033, attack.t1087
// Description: Detects certain command line parameters often used during reconnaissance activity via web shells
// Converted by: Sigma Universal SIEM/EDR CLI

((((ParentImage ENDSWITH "\\java.exe" OR ParentImage ENDSWITH "\\javaw.exe") AND (ParentImage CONTAINS "-tomcat-" OR ParentImage CONTAINS "\\tomcat")) OR ((ParentImage ENDSWITH "\\java.exe" OR ParentImage ENDSWITH "\\javaw.exe") AND (CommandLine CONTAINS "catalina.jar" OR CommandLine CONTAINS "CATALINA_HOME")) OR ((ParentImage ENDSWITH "\\w3wp.exe" OR ParentImage ENDSWITH "\\php-cgi.exe" OR ParentImage ENDSWITH "\\nginx.exe" OR ParentImage ENDSWITH "\\httpd.exe" OR ParentImage ENDSWITH "\\caddy.exe" OR ParentImage ENDSWITH "\\ws_tomcatservice.exe"))) AND (((CommandLine CONTAINS "&cd&echo" OR CommandLine CONTAINS "cd /d ")) OR (((Image ENDSWITH "\\dsquery.exe" OR Image ENDSWITH "\\find.exe" OR Image ENDSWITH "\\findstr.exe" OR Image ENDSWITH "\\ipconfig.exe" OR Image ENDSWITH "\\netstat.exe" OR Image ENDSWITH "\\nslookup.exe" OR Image ENDSWITH "\\pathping.exe" OR Image ENDSWITH "\\quser.exe" OR Image ENDSWITH "\\schtasks.exe" OR Image ENDSWITH "\\systeminfo.exe" OR Image ENDSWITH "\\tasklist.exe" OR Image ENDSWITH "\\tracert.exe" OR Image ENDSWITH "\\wevtutil.exe" OR Image ENDSWITH "\\whoami.exe")) OR ((OriginalFileName EQ "dsquery.exe" OR OriginalFileName EQ "find.exe" OR OriginalFileName EQ "findstr.exe" OR OriginalFileName EQ "ipconfig.exe" OR OriginalFileName EQ "netstat.exe" OR OriginalFileName EQ "nslookup.exe" OR OriginalFileName EQ "pathping.exe" OR OriginalFileName EQ "quser.exe" OR OriginalFileName EQ "schtasks.exe" OR OriginalFileName EQ "sysinfo.exe" OR OriginalFileName EQ "tasklist.exe" OR OriginalFileName EQ "tracert.exe" OR OriginalFileName EQ "VSSADMIN.EXE" OR OriginalFileName EQ "wevtutil.exe" OR OriginalFileName EQ "whoami.exe"))) OR ((CommandLine CONTAINS " Test-NetConnection " OR CommandLine CONTAINS "dir \\")) OR ((OriginalFileName EQ "net.exe" OR OriginalFileName EQ "net1.exe") AND (CommandLine CONTAINS " user " OR CommandLine CONTAINS " use " OR CommandLine CONTAINS " group ")) OR (OriginalFileName EQ "ping.exe" AND CommandLine CONTAINS " -n ") OR ((Image ENDSWITH "\\cmd.exe" OR Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\pwsh.exe") AND (CommandLine CONTAINS " -enc " OR CommandLine CONTAINS " -EncodedCommand " OR CommandLine CONTAINS " -w hidden " OR CommandLine CONTAINS " -windowstyle hidden" OR CommandLine CONTAINS ".WebClient).Download")) OR (OriginalFileName EQ "wmic.exe" AND CommandLine CONTAINS " /node:")))
