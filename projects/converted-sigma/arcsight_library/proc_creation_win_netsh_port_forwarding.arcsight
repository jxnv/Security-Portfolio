// Title: New Port Forwarding Rule Added Via Netsh.EXE
// ID: 322ed9ec-fcab-4f67-9a34-e7c6aef43614
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), omkar72, oscd.community, Swachchhanda Shrawan Poudel
// Date: 2019-01-29
// Tags: attack.lateral-movement, attack.command-and-control, attack.t1090
// Description: Detects the execution of netsh commands that configure a new port forwarding (PortProxy) rule
// Converted by: Sigma Universal SIEM/EDR CLI

(((Image ENDSWITH "\\netsh.exe") OR (OriginalFileName EQ "netsh.exe")) AND (((CommandLine CONTAINS "interface" AND CommandLine CONTAINS "portproxy" AND CommandLine CONTAINS "add" AND CommandLine CONTAINS "v4tov4")) OR ((CommandLine CONTAINS "i " AND CommandLine CONTAINS "p " AND CommandLine CONTAINS "a " AND CommandLine CONTAINS "v ")) OR ((CommandLine CONTAINS "connectp" AND CommandLine CONTAINS "listena" AND CommandLine CONTAINS "c="))))
