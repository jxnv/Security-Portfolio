// Title: Potential Arbitrary File Download Using Office Application
// ID: 4ae3e30b-b03f-43aa-87e3-b622f4048eed
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Beyu Denis, oscd.community
// Date: 2022-05-17
// Tags: attack.stealth, attack.t1202
// Description: Detects potential arbitrary file download using a Microsoft Office application
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAINS "http://" OR CommandLine CONTAINS "https://")) AND (((Image ENDSWITH "\\EXCEL.EXE" OR Image ENDSWITH "\\MSOXMLED.EXE" OR Image ENDSWITH "\\POWERPNT.EXE" OR Image ENDSWITH "\\WINWORD.exe")) OR ((OriginalFileName EQ "Excel.exe" OR OriginalFileName EQ "msoxmled.exe" OR OriginalFileName EQ "POWERPNT.EXE" OR OriginalFileName EQ "WinWord.exe"))))
