// Title: Network Connection Initiated From Process Located In Potentially Suspicious Or Uncommon Location
// ID: 7b434893-c57d-4f41-908d-6a17bf1ae98f
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2017-03-19
// Tags: attack.command-and-control, attack.t1105
// Description: Detects a network connection initiated by programs or processes running from suspicious or uncommon files system locations.
// Converted by: Sigma Universal SIEM/EDR CLI

((Initiated EQ "true" AND (Image CONTAINS ":\\$Recycle.bin" OR Image CONTAINS ":\\Perflogs\\" OR Image CONTAINS ":\\Temp\\" OR Image CONTAINS ":\\Users\\Default\\" OR Image CONTAINS ":\\Users\\Public\\" OR Image CONTAINS ":\\Windows\\Fonts\\" OR Image CONTAINS ":\\Windows\\IME\\" OR Image CONTAINS ":\\Windows\\System32\\Tasks\\" OR Image CONTAINS ":\\Windows\\Tasks\\" OR Image CONTAINS "\\config\\systemprofile\\" OR Image CONTAINS "\\Contacts\\" OR Image CONTAINS "\\Favorites\\" OR Image CONTAINS "\\Favourites\\" OR Image CONTAINS "\\Music\\" OR Image CONTAINS "\\Pictures\\" OR Image CONTAINS "\\Videos\\" OR Image CONTAINS "\\Windows\\addins\\")) AND NOT (((DestinationHostname ENDSWITH ".githubusercontent.com" OR DestinationHostname ENDSWITH "0x0.st" OR DestinationHostname ENDSWITH "anonfiles.com" OR DestinationHostname ENDSWITH "bashupload.com" OR DestinationHostname ENDSWITH "cdn.discordapp.com" OR DestinationHostname ENDSWITH "chunk.io" OR DestinationHostname ENDSWITH "ddns.net" OR DestinationHostname ENDSWITH "dl.dropboxusercontent.com" OR DestinationHostname ENDSWITH "ghostbin.co" OR DestinationHostname ENDSWITH "github.com" OR DestinationHostname ENDSWITH "glitch.me" OR DestinationHostname ENDSWITH "gofile.io" OR DestinationHostname ENDSWITH "hastebin.com" OR DestinationHostname ENDSWITH "mediafire.com" OR DestinationHostname ENDSWITH "mega.co.nz" OR DestinationHostname ENDSWITH "mega.nz" OR DestinationHostname ENDSWITH "onrender.com" OR DestinationHostname ENDSWITH "pages.dev" OR DestinationHostname ENDSWITH "paste.ee" OR DestinationHostname ENDSWITH "pastebin.com" OR DestinationHostname ENDSWITH "pastebin.pl" OR DestinationHostname ENDSWITH "pastetext.net" OR DestinationHostname ENDSWITH "portmap.io" OR DestinationHostname ENDSWITH "privatlab.com" OR DestinationHostname ENDSWITH "privatlab.net" OR DestinationHostname ENDSWITH "send.exploit.in" OR DestinationHostname ENDSWITH "sendspace.com" OR DestinationHostname ENDSWITH "storage.googleapis.com" OR DestinationHostname ENDSWITH "storjshare.io" OR DestinationHostname ENDSWITH "supabase.co" OR DestinationHostname ENDSWITH "temp.sh" OR DestinationHostname ENDSWITH "transfer.sh" OR DestinationHostname ENDSWITH "trycloudflare.com" OR DestinationHostname ENDSWITH "ufile.io" OR DestinationHostname ENDSWITH "w3spaces.com" OR DestinationHostname ENDSWITH "workers.dev" OR DestinationHostname ENDSWITH "x0.at"))))
