// Title: Suspicious Child Process Of Manage Engine ServiceDesk
// ID: cea2b7ea-792b-405f-95a1-b903ea06458f
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2023-01-18
// Tags: attack.command-and-control, attack.t1102
// Description: Detects suspicious child processes of the "Manage Engine ServiceDesk Plus" Java web service
// Converted by: Sigma Universal SIEM/EDR CLI

(((ParentImage CONTAINS "\\ManageEngine\\ServiceDesk\\" AND ParentImage CONTAINS "\\java.exe") AND (Image ENDSWITH "\\AppVLP.exe" OR Image ENDSWITH "\\bash.exe" OR Image ENDSWITH "\\bitsadmin.exe" OR Image ENDSWITH "\\calc.exe" OR Image ENDSWITH "\\certutil.exe" OR Image ENDSWITH "\\cscript.exe" OR Image ENDSWITH "\\curl.exe" OR Image ENDSWITH "\\forfiles.exe" OR Image ENDSWITH "\\mftrace.exe" OR Image ENDSWITH "\\mshta.exe" OR Image ENDSWITH "\\net.exe" OR Image ENDSWITH "\\net1.exe" OR Image ENDSWITH "\\notepad.exe" OR Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\pwsh.exe" OR Image ENDSWITH "\\query.exe" OR Image ENDSWITH "\\reg.exe" OR Image ENDSWITH "\\schtasks.exe" OR Image ENDSWITH "\\scrcons.exe" OR Image ENDSWITH "\\sh.exe" OR Image ENDSWITH "\\systeminfo.exe" OR Image ENDSWITH "\\whoami.exe" OR Image ENDSWITH "\\wmic.exe" OR Image ENDSWITH "\\wscript.exe")) AND NOT (((Image ENDSWITH "\\net.exe" OR Image ENDSWITH "\\net1.exe") AND CommandLine CONTAINS " stop")))
