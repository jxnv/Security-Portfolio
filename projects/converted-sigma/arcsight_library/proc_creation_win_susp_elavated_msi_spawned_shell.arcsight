// Title: Always Install Elevated MSI Spawned Cmd And Powershell
// ID: 1e53dd56-8d83-4eb4-a43e-b790a05510aa
// Status: test
// Level: medium
// Author: Teymur Kheirkhabarov (idea), Mangatas Tondang (rule), oscd.community
// Date: 2020-10-13
// Tags: attack.privilege-escalation, attack.t1548.002
// Description: Detects Windows Installer service (msiexec.exe) spawning "cmd" or "powershell"
// Converted by: Sigma Universal SIEM/EDR CLI

((((Image ENDSWITH "\\cmd.exe" OR Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\pwsh.exe")) OR ((OriginalFileName EQ "Cmd.Exe" OR OriginalFileName EQ "PowerShell.EXE" OR OriginalFileName EQ "pwsh.dll"))) AND ((ParentImage CONTAINS "\\Windows\\Installer\\" AND ParentImage CONTAINS "msi") AND ParentImage ENDSWITH "tmp"))
