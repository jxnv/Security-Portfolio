// Title: Remote Thread Creation By Uncommon Source Image
// ID: 66d31e5f-52d6-40a4-9615-002d3789a119
// Status: test
// Level: medium
// Author: Perez Diego (@darkquassar), oscd.community
// Date: 2019-10-27
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects uncommon processes creating remote threads.
// Converted by: Sigma Universal SIEM/EDR CLI

(((SourceImage ENDSWITH "\\explorer.exe" OR SourceImage ENDSWITH "\\iexplore.exe" OR SourceImage ENDSWITH "\\msiexec.exe" OR SourceImage ENDSWITH "\\powerpnt.exe" OR SourceImage ENDSWITH "\\schtasks.exe" OR SourceImage ENDSWITH "\\winlogon.exe")) AND NOT (((TargetImage EQ "") OR (SourceImage EQ "C:\\Windows\\explorer.exe" AND (TargetImage STARTSWITH "C:\\Program Files (x86)\\" OR TargetImage STARTSWITH "C:\\Program Files\\" OR TargetImage STARTSWITH "C:\\Windows\\System32\\" OR TargetImage STARTSWITH "C:\\Windows\\SysWOW64\\")) OR (SourceImage EQ "C:\\Program Files\\Internet Explorer\\iexplore.exe" AND (TargetImage EQ "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR TargetImage EQ "C:\\Windows\\System32\\rundll32.exe")) OR (SourceImage ENDSWITH "\\msiexec.exe" AND (TargetImage CONTAINS "\\AppData\\Local\\" OR TargetImage CONTAINS "C:\\Program Files (x86)\\" OR TargetImage CONTAINS "C:\\Program Files\\" OR TargetImage CONTAINS "C:\\Windows\\Microsoft.NET\\Framework64\\")) OR (SourceImage ENDSWITH "\\msiexec.exe" AND (TargetImage EQ "C:\\Windows\\System32\\msiexec.exe" OR TargetImage EQ "C:\\Windows\\SysWOW64\\msiexec.exe")) OR (NOT TargetImage=*) OR (SourceImage ENDSWITH "\\POWERPNT.EXE" AND (TargetImage CONTAINS "C:\\Program Files\\Microsoft Office\\" OR TargetImage CONTAINS "C:\\Program Files (x86)\\Microsoft Office\\")) OR ((SourceImage EQ "C:\\Windows\\System32\\schtasks.exe" OR SourceImage EQ "C:\\Windows\\SysWOW64\\schtasks.exe") AND TargetImage EQ "C:\\Windows\\System32\\conhost.exe") OR (TargetImage EQ "System") OR (SourceImage EQ "C:\\Windows\\System32\\winlogon.exe" AND (TargetImage EQ "C:\\Windows\\System32\\services.exe" OR TargetImage EQ "C:\\Windows\\System32\\wininit.exe" OR TargetImage EQ "C:\\Windows\\System32\\csrss.exe" OR TargetImage EQ "C:\\Windows\\System32\\LogonUI.exe" OR TargetImage EQ "C:\\Windows\\System32\\wlrmdr.exe" OR TargetImage EQ "C:\\Windows\\System32\\AtBroker.exe" OR TargetImage EQ "C:\\Windows\\System32\\dwm.exe" OR TargetImage EQ "C:\\Windows\\System32\\fontdrvhost.exe" OR TargetImage EQ "C:\\Windows\\System32\\userinit.exe")) OR (SourceImage EQ "C:\\Windows\\System32\\winlogon.exe" AND TargetParentProcessId EQ "4"))) AND NOT (((SourceImage EQ "C:\\Windows\\explorer.exe" AND TargetImage ENDSWITH "\\aurora-dashboard.exe") OR (SourceImage EQ "C:\\Program Files\\internet explorer\\iexplore.exe" AND (SourceCommandLine CONTAINS "https://" AND SourceCommandLine CONTAINS ".checkpoint.com/documents/" AND SourceCommandLine CONTAINS "SmartConsole_OLH/" AND SourceCommandLine CONTAINS "default.htm#cshid=")) OR (SourceImage EQ "C:\\Program Files\\internet explorer\\iexplore.exe" AND (SourceParentImage STARTSWITH "C:\\Program Files\\" OR SourceParentImage STARTSWITH "C:\\Program Files (x86)\\") AND (SourceParentImage CONTAINS "\\CheckPoint\\SmartConsole\\" AND SourceParentImage CONTAINS "\\SmartConsole.exe")) OR (SourceImage EQ "C:\\Windows\\explorer.exe" AND TargetImage ENDSWITH "\\OfficeSetup.exe") OR (SourceImage EQ "C:\\Windows\\explorer.exe" AND TargetImage ENDSWITH "\\AppData\\Local\\Microsoft\\OneDrive\\OneDrive.exe") OR (SourceImage CONTAINS "\\Microsoft Office\\" AND SourceImage ENDSWITH "\\POWERPNT.EXE" AND TargetImage EQ "C:\\Windows\\System32\\csrss.exe"))))
