// Title: Potentially Suspicious Electron Application CommandLine
// ID: 378a05d8-963c-46c9-bcce-13c7657eac99
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-09-05
// Tags: attack.execution
// Description: Detects potentially suspicious CommandLine of electron apps (teams, discord, slack, etc.). This could be a sign of abuse to proxy execution through a signed binary.
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAINS "--browser-subprocess-path" OR CommandLine CONTAINS "--gpu-launcher" OR CommandLine CONTAINS "--renderer-cmd-prefix" OR CommandLine CONTAINS "--utility-cmd-prefix")) AND (((Image ENDSWITH "\\chrome.exe" OR Image ENDSWITH "\\code.exe" OR Image ENDSWITH "\\discord.exe" OR Image ENDSWITH "\\GitHubDesktop.exe" OR Image ENDSWITH "\\keybase.exe" OR Image ENDSWITH "\\msedge_proxy.exe" OR Image ENDSWITH "\\msedge.exe" OR Image ENDSWITH "\\msedgewebview2.exe" OR Image ENDSWITH "\\msteams.exe" OR Image ENDSWITH "\\slack.exe" OR Image ENDSWITH "\\Teams.exe")) OR ((OriginalFileName EQ "chrome.exe" OR OriginalFileName EQ "code.exe" OR OriginalFileName EQ "discord.exe" OR OriginalFileName EQ "GitHubDesktop.exe" OR OriginalFileName EQ "keybase.exe" OR OriginalFileName EQ "msedge_proxy.exe" OR OriginalFileName EQ "msedge.exe" OR OriginalFileName EQ "msedgewebview2.exe" OR OriginalFileName EQ "msteams.exe" OR OriginalFileName EQ "slack.exe" OR OriginalFileName EQ "Teams.exe"))))
