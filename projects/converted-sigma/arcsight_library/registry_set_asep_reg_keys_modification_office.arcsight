// Title: Office Autorun Keys Modification
// ID: baecf8fb-edbf-429f-9ade-31fc3f22b970
// Status: test
// Level: medium
// Author: Victor Sergeev, Daniil Yugoslavskiy, Gleb Sukhodolskiy, Timur Zinniatullin, oscd.community, Tim Shelton, frack113 (split)
// Date: 2019-10-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects modification of autostart extensibility point (ASEP) in registry. Adversaries may modify these keys to execute malicious code when Office files are opened.
// There are various legitimate add-ins that also use these keys and this filter list might not be exhaustive.
// Thus, it is recommended to review and tune filters for your environment to reduce false positives before deploying to production.
// Converted by: Sigma Universal SIEM/EDR CLI

((((TargetObject CONTAINS "\\Word\\Addins" OR TargetObject CONTAINS "\\PowerPoint\\Addins" OR TargetObject CONTAINS "\\Outlook\\Addins" OR TargetObject CONTAINS "\\Onenote\\Addins" OR TargetObject CONTAINS "\\Excel\\Addins" OR TargetObject CONTAINS "\\Access\\Addins" OR TargetObject CONTAINS "test\\Special\\Perf")) AND ((TargetObject CONTAINS "\\Software\\Wow6432Node\\Microsoft\\Office" OR TargetObject CONTAINS "\\Software\\Microsoft\\Office"))) AND NOT (((Details EQ "(Empty)") OR ((Image STARTSWITH "C:\\Program Files\\Microsoft Office\\" OR Image STARTSWITH "C:\\Program Files (x86)\\Microsoft Office\\" OR Image STARTSWITH "C:\\PROGRA~2\\MICROS~2\\Office" OR Image STARTSWITH "C:\\Windows\\System32\\msiexec.exe" OR Image STARTSWITH "C:\\Windows\\SysWOW64\\msiexec.exe" OR Image STARTSWITH "C:\\Windows\\System32\\regsvr32.exe" OR Image STARTSWITH "C:\\Windows\\SysWOW64\\regsvr32.exe") AND (TargetObject CONTAINS "\\Excel\\Addins\\AdHocReportingExcelClientLib.AdHocReportingExcelClientAddIn.1\\" OR TargetObject CONTAINS "\\Excel\\Addins\\ExcelPlugInShell.PowerMapConnect\\" OR TargetObject CONTAINS "\\Excel\\Addins\\NativeShim\\" OR TargetObject CONTAINS "\\Excel\\Addins\\NativeShim.InquireConnector.1\\" OR TargetObject CONTAINS "\\Excel\\Addins\\PowerPivotExcelClientAddIn.NativeEntry.1\\" OR TargetObject CONTAINS "\\Outlook\\AddIns\\AccessAddin.DC\\" OR TargetObject CONTAINS "\\Outlook\\AddIns\\ColleagueImport.ColleagueImportAddin\\" OR TargetObject CONTAINS "\\Outlook\\AddIns\\EvernoteCC.EvernoteContactConnector\\" OR TargetObject CONTAINS "\\Outlook\\AddIns\\EvernoteOLRD.Connect\\" OR TargetObject CONTAINS "\\Outlook\\Addins\\OneNote.OutlookAddin" OR TargetObject CONTAINS "\\Outlook\\Addins\\DriveFSExtensionLib.Connect\\" OR TargetObject CONTAINS "\\Outlook\\Addins\\GoogleAppsSync.Connect\\" OR TargetObject CONTAINS "\\Outlook\\Addins\\Microsoft.VbaAddinForOutlook.1\\" OR TargetObject CONTAINS "\\Outlook\\Addins\\OcOffice.OcForms\\" OR TargetObject CONTAINS "\\Outlook\\Addins\\OscAddin.Connect\\" OR TargetObject CONTAINS "\\Outlook\\Addins\\OutlookChangeNotifier.Connect\\" OR TargetObject CONTAINS "\\Outlook\\Addins\\UCAddin.LyncAddin.1" OR TargetObject CONTAINS "\\Outlook\\Addins\\UCAddin.UCAddin.1" OR TargetObject CONTAINS "\\Outlook\\Addins\\UmOutlookAddin.FormRegionAddin\\" OR TargetObject CONTAINS "AddinTakeNotesService\\FriendlyName")) OR (NOT Details=*) OR ((Image STARTSWITH "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\" OR Image STARTSWITH "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\") AND Image ENDSWITH "\\OfficeClickToRun.exe") OR ((Image STARTSWITH "C:\\Program Files\\Common Files\\Microsoft Shared\\VSTO\\" OR Image STARTSWITH "C:\\Program Files (x86)\\Microsoft Shared\\VSTO\\") AND Image ENDSWITH "\\VSTOInstaller.exe"))) AND NOT ((((Image EQ "C:\\Program Files\\Avast Software\\Avast\\RegSvr.exe" OR Image EQ "C:\\Program Files\\Avast Software\\Avast\\x86\\RegSvr.exe") AND TargetObject CONTAINS "\\Microsoft\\Office\\Outlook\\Addins\\Avast.AsOutExt\\") OR ((Image EQ "C:\\Program Files\\AVG\\Antivirus\\RegSvr.exe" OR Image EQ "C:\\Program Files\\AVG\\Antivirus\\x86\\RegSvr.exe") AND TargetObject CONTAINS "\\Microsoft\\Office\\Outlook\\Addins\\Antivirus.AsOutExt\\"))))
