// Title: Whoami.EXE Execution Anomaly
// ID: 8de1cbe8-d6f5-496d-8237-5f44a721c7a0
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2021-08-12
// Tags: attack.discovery, attack.t1033, car.2016-03-001
// Description: Detects the execution of whoami.exe with suspicious parent processes.
// Converted by: Sigma Universal SIEM/EDR CLI

(((Image ENDSWITH "\\whoami.exe") OR (OriginalFileName EQ "whoami.exe")) AND NOT ((((ParentImage ENDSWITH "\\cmd.exe" OR ParentImage ENDSWITH "\\powershell_ise.exe" OR ParentImage ENDSWITH "\\powershell.exe" OR ParentImage ENDSWITH "\\pwsh.exe")) OR ((ParentImage EQ "" OR ParentImage EQ "-")) OR (NOT ParentImage=*))) AND NOT ((ParentImage ENDSWITH ":\\Program Files\\Microsoft Monitoring Agent\\Agent\\MonitoringHost.exe")))
