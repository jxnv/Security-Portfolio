// Title: Network Connection Initiated To AzureWebsites.NET By Non-Browser Process
// ID: 5c80b618-0dbb-46e6-acbb-03d90bcb6d83
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.command-and-control, attack.t1102, attack.t1102.001
// Description: Detects an initiated network connection by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
// Converted by: Sigma Universal SIEM/EDR CLI

((Initiated EQ "true" AND DestinationHostname ENDSWITH "azurewebsites.net") AND NOT ((((Image STARTSWITH "C:\\Program Files (x86)\\Avant Browser\\" OR Image STARTSWITH "C:\\Program Files\\Avant Browser\\") AND Image ENDSWITH "\\avant.exe") OR (Image STARTSWITH "C:\\Program Files\\BraveSoftware\\" AND Image ENDSWITH "\\brave.exe") OR ((Image EQ "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR Image EQ "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR (Image STARTSWITH "C:\\Users\\" AND Image ENDSWITH "\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe") OR ((Image CONTAINS "C:\\Program Files\\Windows Defender Advanced Threat Protection\\" OR Image CONTAINS "C:\\Program Files\\Windows Defender\\" OR Image CONTAINS "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\") AND (Image ENDSWITH "\\MsMpEng.exe" OR Image ENDSWITH "\\MsSense.exe")) OR (Image CONTAINS "\\AppData\\Local\\Discord\\" AND Image ENDSWITH "\\Discord.exe") OR ((Image STARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") OR (Image ENDSWITH "\\WindowsApps\\MicrosoftEdge.exe") OR ((Image EQ "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR Image EQ "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((Image STARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" OR Image STARTSWITH "C:\\Program Files\\Microsoft\\EdgeCore\\") AND (Image ENDSWITH "\\msedge.exe" OR Image ENDSWITH "\\msedgewebview2.exe")) OR (Image EQ "") OR ((Image STARTSWITH "C:\\Program Files\\Falkon\\" OR Image STARTSWITH "C:\\Program Files (x86)\\Falkon\\") AND Image ENDSWITH "\\falkon.exe") OR ((Image EQ "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR Image EQ "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR (Image STARTSWITH "C:\\Users\\" AND Image ENDSWITH "\\AppData\\Local\\Mozilla Firefox\\firefox.exe") OR (Image CONTAINS "\\AppData\\Local\\Flock\\" AND Image ENDSWITH "\\Flock.exe") OR ((Image EQ "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR Image EQ "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (Image CONTAINS "\\AppData\\Local\\Maxthon\\" AND Image ENDSWITH "\\maxthon.exe") OR (NOT Image=*) OR (Image CONTAINS "\\AppData\\Local\\Programs\\Opera\\" AND Image ENDSWITH "\\opera.exe") OR (Image CONTAINS "\\AppData\\Local\\Phoebe\\" AND Image ENDSWITH "\\Phoebe.exe") OR ((Image ENDSWITH "C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe" OR Image ENDSWITH "C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe")) OR ((Image STARTSWITH "C:\\Program Files (x86)\\QtWeb\\" OR Image STARTSWITH "C:\\Program Files\\QtWeb\\") AND Image ENDSWITH "\\QtWeb.exe") OR ((Image CONTAINS "C:\\Program Files (x86)\\Safari\\" OR Image CONTAINS "C:\\Program Files\\Safari\\") AND Image ENDSWITH "\\safari.exe") OR ((Image STARTSWITH "C:\\Program Files\\SeaMonkey\\" OR Image STARTSWITH "C:\\Program Files (x86)\\SeaMonkey\\") AND Image ENDSWITH "\\seamonkey.exe") OR ((Image STARTSWITH "C:\\Program Files\\SlimBrowser\\" OR Image STARTSWITH "C:\\Program Files (x86)\\SlimBrowser\\") AND Image ENDSWITH "\\slimbrowser.exe") OR (Image CONTAINS "\\AppData\\Local\\Vivaldi\\" AND Image ENDSWITH "\\vivaldi.exe") OR ((Image STARTSWITH "C:\\Program Files\\Naver\\Naver Whale\\" OR Image STARTSWITH "C:\\Program Files (x86)\\Naver\\Naver Whale\\") AND Image ENDSWITH "\\whale.exe") OR ((Image STARTSWITH "C:\\Program Files\\Waterfox\\" OR Image STARTSWITH "C:\\Program Files (x86)\\Waterfox\\") AND Image ENDSWITH "\\Waterfox.exe"))))
