// Title: Uncommon File Created by Notepad++ Updater Gup.EXE
// ID: 3b8f4c92-6a51-4d7e-9c3a-8e2d1f5a7b09
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-02-03
// Tags: attack.collection, attack.credential-access, attack.t1195.002, attack.initial-access, attack.t1557
// Description: Detects when the Notepad++ updater (gup.exe) creates files in suspicious or uncommon locations.
// This could indicate potential exploitation of the updater component to deliver unwanted malware or unwarranted files.
// Converted by: Sigma Universal SIEM/EDR CLI

((Image ENDSWITH "\\gup.exe") AND NOT ((((TargetFilename STARTSWITH "C:\\Program Files\\Notepad++\\" OR TargetFilename STARTSWITH "C:\\Program Files (x86)\\Notepad++\\")) OR (((TargetFilename CONTAINS "\\plugins\\JsonTools\\testfiles\\" OR TargetFilename CONTAINS "\\Notepad++\\plugins\\ComparePlugin\\")) OR ((TargetFilename CONTAINS "npp." AND TargetFilename CONTAINS ".portable." AND TargetFilename CONTAINS "\\plugins\\"))) OR (TargetFilename STARTSWITH "C:\\$Recycle.Bin\\S-1-5-21") OR (TargetFilename STARTSWITH "C:\\Users\\" AND (TargetFilename CONTAINS "\\AppData\\Local\\Temp\\" AND TargetFilename CONTAINS ".zip")) OR (TargetFilename STARTSWITH "C:\\Users\\" AND (TargetFilename CONTAINS "\\AppData\\Local\\Temp\\" AND TargetFilename CONTAINS "npp." AND TargetFilename CONTAINS ".Installer." AND TargetFilename CONTAINS ".exe")))))
