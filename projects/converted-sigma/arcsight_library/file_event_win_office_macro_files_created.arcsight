// Title: Office Macro File Creation
// ID: 91174a41-dc8f-401b-be89-7bfc140612a0
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-23
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects the creation of a new office macro files on the systems
// Converted by: Sigma Universal SIEM/EDR CLI

(((TargetFilename ENDSWITH ".docm" OR TargetFilename ENDSWITH ".dotm" OR TargetFilename ENDSWITH ".xlsm" OR TargetFilename ENDSWITH ".xltm" OR TargetFilename ENDSWITH ".potm" OR TargetFilename ENDSWITH ".pptm")) AND NOT (((Image STARTSWITH "C:\\Program Files\\Microsoft Office\\" OR Image STARTSWITH "C:\\Program Files (x86)\\Microsoft Office\\") AND (Image ENDSWITH "\\WINWORD.EXE" OR Image ENDSWITH "\\EXCEL.EXE" OR Image ENDSWITH "\\POWERPNT.EXE") AND TargetFilename CONTAINS "\\~$")))
