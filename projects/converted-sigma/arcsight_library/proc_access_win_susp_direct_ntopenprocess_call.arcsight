// Title: Potential Direct Syscall of NtOpenProcess
// ID: 3f3f3506-1895-401b-9cc3-e86b16e630d0
// Status: test
// Level: medium
// Author: Christian Burkard (Nextron Systems), Tim Shelton (FP)
// Date: 2021-07-28
// Tags: attack.execution, attack.t1106
// Description: Detects potential calls to NtOpenProcess directly from NTDLL.
// Converted by: Sigma Universal SIEM/EDR CLI

((CallTrace STARTSWITH "UNKNOWN") AND NOT ((((SourceImage CONTAINS ":\\Program Files (x86)\\" OR SourceImage CONTAINS ":\\Program Files\\" OR SourceImage CONTAINS ":\\Windows\\System32\\" OR SourceImage CONTAINS ":\\Windows\\SysWOW64\\" OR SourceImage CONTAINS ":\\Windows\\WinSxS\\") AND (TargetImage CONTAINS ":\\Program Files (x86)\\" OR TargetImage CONTAINS ":\\Program Files\\" OR TargetImage CONTAINS ":\\Windows\\System32\\" OR TargetImage CONTAINS ":\\Windows\\SysWOW64\\" OR TargetImage CONTAINS ":\\Windows\\WinSxS\\")) OR (Provider_Name EQ "Microsoft-Windows-Kernel-Audit-API-Calls") OR (TargetImage ENDSWITH "vcredist_x64.exe" AND SourceImage ENDSWITH "vcredist_x64.exe"))) AND NOT (((SourceImage CONTAINS ":\\Program Files\\Adobe\\Acrobat DC\\Acrobat\\" AND SourceImage ENDSWITH "\\AcroCEF.exe" AND TargetImage CONTAINS ":\\Program Files\\Adobe\\Acrobat DC\\Acrobat\\" AND TargetImage ENDSWITH "\\AcroCEF.exe") OR (SourceImage ENDSWITH "AmazonSSMAgentSetup.exe" AND TargetImage ENDSWITH "AmazonSSMAgentSetup.exe") OR (SourceImage ENDSWITH ":\\Windows\\Explorer.EXE" AND TargetImage ENDSWITH ":\\Program Files\\Cylance\\Desktop\\CylanceUI.exe") OR (TargetImage CONTAINS "\\AppData\\Local\\Discord\\" AND TargetImage ENDSWITH "\\Discord.exe") OR (TargetImage ENDSWITH "\\Evernote\\Evernote.exe") OR (TargetImage ENDSWITH "\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe" AND SourceImage ENDSWITH "\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe") OR (TargetImage ENDSWITH ":\\Windows\\system32\\systeminfo.exe" AND SourceImage ENDSWITH "setup64.exe") OR (SourceImage ENDSWITH "\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe" AND TargetImage ENDSWITH "\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe") OR (SourceImage CONTAINS "\\AppData\\Local\\yammerdesktop\\app-" AND SourceImage ENDSWITH "\\Yammer.exe" AND TargetImage CONTAINS "\\AppData\\Local\\yammerdesktop\\app-" AND TargetImage ENDSWITH "\\Yammer.exe" AND GrantedAccess EQ "0x1000"))))
