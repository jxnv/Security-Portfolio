// Title: WSL Kali-Linux Usage
// ID: 6f1a11aa-4b8a-4b7f-9e13-4d3e4ff0e0d4
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-10-10
// Tags: attack.stealth, attack.t1202
// Description: Detects the use of Kali Linux through Windows Subsystem for Linux
// Converted by: Sigma Universal SIEM/EDR CLI

(((((Image CONTAINS ":\\Users\\" AND Image CONTAINS "\\AppData\\Local\\packages\\KaliLinux")) OR ((Image CONTAINS ":\\Users\\" AND Image CONTAINS "\\AppData\\Local\\Microsoft\\WindowsApps\\kali.exe"))) OR (Image CONTAINS ":\\Program Files\\WindowsApps\\KaliLinux." AND Image ENDSWITH "\\kali.exe")) OR (((((Image CONTAINS "\\kali.exe" OR Image CONTAINS "\\KaliLinux")) OR ((CommandLine CONTAINS "Kali.exe" OR CommandLine CONTAINS "Kali-linux" OR CommandLine CONTAINS "kalilinux"))) AND ((ParentImage ENDSWITH "\\wsl.exe" OR ParentImage ENDSWITH "\\wslhost.exe"))) AND NOT (((CommandLine CONTAINS " -i " OR CommandLine CONTAINS " --install " OR CommandLine CONTAINS " --unregister ")))))
