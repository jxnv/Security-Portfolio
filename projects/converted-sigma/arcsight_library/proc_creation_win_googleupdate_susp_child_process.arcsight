// Title: Potentially Suspicious GoogleUpdate Child Process
// ID: 84b1ecf9-6eff-4004-bafb-bae5c0e251b2
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-15
// Tags: attack.stealth
// Description: Detects potentially suspicious child processes of "GoogleUpdate.exe"
// Converted by: Sigma Universal SIEM/EDR CLI

((ParentImage ENDSWITH "\\GoogleUpdate.exe") AND NOT (((NOT Image=*) OR ((Image CONTAINS "\\Google") OR ((Image ENDSWITH "\\setup.exe" OR Image ENDSWITH "chrome_updater.exe" OR Image ENDSWITH "chrome_installer.exe"))))))
