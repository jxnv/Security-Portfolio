// Title: Kerberos Manipulation
// ID: f7644214-0eb0-4ace-9455-331ec4c09253
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2017-02-10
// Tags: attack.credential-access, attack.t1212
// Description: Detects failed Kerberos TGT issue operation. This can be a sign of manipulations of TGT messages by an attacker.
// Converted by: Sigma Universal SIEM/EDR CLI

((EventID EQ "675" OR EventID EQ "4768" OR EventID EQ "4769" OR EventID EQ "4771") AND (Status EQ "0x9" OR Status EQ "0xA" OR Status EQ "0xB" OR Status EQ "0xF" OR Status EQ "0x10" OR Status EQ "0x11" OR Status EQ "0x13" OR Status EQ "0x14" OR Status EQ "0x1A" OR Status EQ "0x1F" OR Status EQ "0x21" OR Status EQ "0x22" OR Status EQ "0x23" OR Status EQ "0x24" OR Status EQ "0x26" OR Status EQ "0x27" OR Status EQ "0x28" OR Status EQ "0x29" OR Status EQ "0x2C" OR Status EQ "0x2D" OR Status EQ "0x2E" OR Status EQ "0x2F" OR Status EQ "0x31" OR Status EQ "0x32" OR Status EQ "0x3E" OR Status EQ "0x3F" OR Status EQ "0x40" OR Status EQ "0x41" OR Status EQ "0x43" OR Status EQ "0x44"))
