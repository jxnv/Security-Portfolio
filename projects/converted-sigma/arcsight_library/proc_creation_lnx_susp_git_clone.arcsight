// Title: Suspicious Git Clone - Linux
// ID: cfec9d29-64ec-4a0f-9ffe-0fdb856d5446
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-03
// Tags: attack.reconnaissance, attack.t1593.003
// Description: Detects execution of "git" in order to clone a remote repository that contain suspicious keywords which might be suspicious
// Converted by: Sigma Universal SIEM/EDR CLI

((Image ENDSWITH "/git" AND CommandLine CONTAINS " clone ") AND ((CommandLine CONTAINS "exploit" OR CommandLine CONTAINS "Vulns" OR CommandLine CONTAINS "vulnerability" OR CommandLine CONTAINS "RCE" OR CommandLine CONTAINS "RemoteCodeExecution" OR CommandLine CONTAINS "Invoke-" OR CommandLine CONTAINS "CVE-" OR CommandLine CONTAINS "poc-" OR CommandLine CONTAINS "ProofOfConcept" OR CommandLine CONTAINS "proxyshell" OR CommandLine CONTAINS "log4shell" OR CommandLine CONTAINS "eternalblue" OR CommandLine CONTAINS "eternal-blue" OR CommandLine CONTAINS "MS17-")))
