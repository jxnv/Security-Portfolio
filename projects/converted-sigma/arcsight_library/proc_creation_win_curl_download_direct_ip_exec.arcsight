// Title: File Download From IP URL Via Curl.EXE
// ID: 9cc85849-3b02-4cb5-b371-3a1ff54f2218
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-10-18
// Tags: attack.execution
// Description: Detects file downloads directly from IP address URL using curl.exe
// Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine CONTAINS " -O" OR CommandLine CONTAINS "--remote-name" OR CommandLine CONTAINS "--output")) AND (CommandLine CONTAINS "http") AND ((Image ENDSWITH "\\curl.exe") OR (OriginalFileName EQ "curl.exe")) AND (CommandLine=regex("://[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}"))) AND NOT (((CommandLine ENDSWITH ".bat" OR CommandLine ENDSWITH ".bat\"" OR CommandLine ENDSWITH ".dat" OR CommandLine ENDSWITH ".dat\"" OR CommandLine ENDSWITH ".dll" OR CommandLine ENDSWITH ".dll\"" OR CommandLine ENDSWITH ".exe" OR CommandLine ENDSWITH ".exe\"" OR CommandLine ENDSWITH ".gif" OR CommandLine ENDSWITH ".gif\"" OR CommandLine ENDSWITH ".hta" OR CommandLine ENDSWITH ".hta\"" OR CommandLine ENDSWITH ".jpeg" OR CommandLine ENDSWITH ".jpeg\"" OR CommandLine ENDSWITH ".log" OR CommandLine ENDSWITH ".log\"" OR CommandLine ENDSWITH ".msi" OR CommandLine ENDSWITH ".msi\"" OR CommandLine ENDSWITH ".png" OR CommandLine ENDSWITH ".png\"" OR CommandLine ENDSWITH ".ps1" OR CommandLine ENDSWITH ".ps1\"" OR CommandLine ENDSWITH ".psm1" OR CommandLine ENDSWITH ".psm1\"" OR CommandLine ENDSWITH ".vbe" OR CommandLine ENDSWITH ".vbe\"" OR CommandLine ENDSWITH ".vbs" OR CommandLine ENDSWITH ".vbs\"" OR CommandLine ENDSWITH ".bat'" OR CommandLine ENDSWITH ".dat'" OR CommandLine ENDSWITH ".dll'" OR CommandLine ENDSWITH ".exe'" OR CommandLine ENDSWITH ".gif'" OR CommandLine ENDSWITH ".hta'" OR CommandLine ENDSWITH ".jpeg'" OR CommandLine ENDSWITH ".log'" OR CommandLine ENDSWITH ".msi'" OR CommandLine ENDSWITH ".png'" OR CommandLine ENDSWITH ".ps1'" OR CommandLine ENDSWITH ".psm1'" OR CommandLine ENDSWITH ".vbe'" OR CommandLine ENDSWITH ".vbs'"))))
