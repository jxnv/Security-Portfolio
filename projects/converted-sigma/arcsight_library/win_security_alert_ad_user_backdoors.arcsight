// Tags: attack.privilege-escalation, attack.t1098, attack.persistence
// Description: Detects scenarios where one can control another users or computers account without having to use their credentials.
// Converted by: Sigma Universal SIEM/EDR CLI

(((EventID EQ "4738") AND NOT ((((AllowedToDelegateTo EQ "" OR AllowedToDelegateTo EQ "-")) OR (NOT AllowedToDelegateTo=*)))) OR ((EventID EQ "5136" AND AttributeLDAPDisplayName EQ "msDS-AllowedToDelegateTo") OR (EventID EQ "5136" AND ObjectClass EQ "user" AND AttributeLDAPDisplayName EQ "servicePrincipalName") OR (EventID EQ "5136" AND AttributeLDAPDisplayName EQ "msDS-AllowedToActOnBehalfOfOtherIdentity")))
