// Title: Linux Package Uninstall
// ID: 95d61234-7f56-465c-6f2d-b562c6fedbc4
// Status: test
// Level: low
// Author: Tuan Le (NCSGroup), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-03-09
// Tags: attack.stealth, attack.t1070
// Description: Detects linux package removal using builtin tools such as "yum", "apt", "apt-get" or "dpkg".
// Converted by: Sigma Universal SIEM/EDR CLI

(((Image ENDSWITH "/apt" OR Image ENDSWITH "/apt-get") AND (CommandLine CONTAINS "remove" OR CommandLine CONTAINS "purge")) OR (Image ENDSWITH "/dpkg" AND (CommandLine CONTAINS "--remove " OR CommandLine CONTAINS " -r ")) OR (Image ENDSWITH "/rpm" AND CommandLine CONTAINS " -e ") OR (Image ENDSWITH "/yum" AND (CommandLine CONTAINS "erase" OR CommandLine CONTAINS "remove")))
