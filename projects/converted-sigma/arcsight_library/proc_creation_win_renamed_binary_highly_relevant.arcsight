// Title: Potential Defense Evasion Via Rename Of Highly Relevant Binaries
// ID: 0ba1da6d-b6ce-4366-828c-18826c9de23e
// Status: test
// Level: high
// Author: Matthew Green - @mgreen27, Florian Roth (Nextron Systems), frack113
// Date: 2019-06-15
// Tags: attack.stealth, attack.t1036.003, car.2013-05-009
// Description: Detects the execution of a renamed binary often used by attackers or malware leveraging new Sysmon OriginalFileName datapoint.
// Converted by: Sigma Universal SIEM/EDR CLI

(((Description EQ "Execute processes remotely") OR (Product EQ "Sysinternals PsExec") OR ((Description STARTSWITH "Windows PowerShell" OR Description STARTSWITH "pwsh")) OR ((OriginalFileName EQ "certutil.exe" OR OriginalFileName EQ "cmstp.exe" OR OriginalFileName EQ "cscript.exe" OR OriginalFileName EQ "IE4UINIT.EXE" OR OriginalFileName EQ "finger.exe" OR OriginalFileName EQ "mshta.exe" OR OriginalFileName EQ "msiexec.exe" OR OriginalFileName EQ "msxsl.exe" OR OriginalFileName EQ "powershell_ise.exe" OR OriginalFileName EQ "powershell.exe" OR OriginalFileName EQ "psexec.c" OR OriginalFileName EQ "psexec.exe" OR OriginalFileName EQ "psexesvc.exe" OR OriginalFileName EQ "pwsh.dll" OR OriginalFileName EQ "reg.exe" OR OriginalFileName EQ "regsvr32.exe" OR OriginalFileName EQ "rundll32.exe" OR OriginalFileName EQ "WerMgr" OR OriginalFileName EQ "wmic.exe" OR OriginalFileName EQ "wscript.exe"))) AND NOT (((Image ENDSWITH "\\certutil.exe" OR Image ENDSWITH "\\cmstp.exe" OR Image ENDSWITH "\\cscript.exe" OR Image ENDSWITH "\\ie4uinit.exe" OR Image ENDSWITH "\\finger.exe" OR Image ENDSWITH "\\mshta.exe" OR Image ENDSWITH "\\msiexec.exe" OR Image ENDSWITH "\\msxsl.exe" OR Image ENDSWITH "\\powershell_ise.exe" OR Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\psexec.exe" OR Image ENDSWITH "\\psexec64.exe" OR Image ENDSWITH "\\psexec64a.exe" OR Image ENDSWITH "\\PSEXESVC.exe" OR Image ENDSWITH "\\pwsh.exe" OR Image ENDSWITH "\\reg.exe" OR Image ENDSWITH "\\regsvr32.exe" OR Image ENDSWITH "\\rundll32.exe" OR Image ENDSWITH "\\wermgr.exe" OR Image ENDSWITH "\\wmic.exe" OR Image ENDSWITH "\\wscript.exe"))))
