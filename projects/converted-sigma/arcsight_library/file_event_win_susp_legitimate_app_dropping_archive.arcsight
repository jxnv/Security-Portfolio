// Title: Legitimate Application Dropped Archive
// ID: 654fcc6d-840d-4844-9b07-2c3300e54a26
// Status: test
// Level: high
// Author: frack113, Florian Roth
// Date: 2022-08-21
// Tags: attack.stealth, attack.t1218
// Description: Detects programs on a Windows system that should not write an archive to disk
// Converted by: Sigma Universal SIEM/EDR CLI

((Image ENDSWITH "\\winword.exe" OR Image ENDSWITH "\\excel.exe" OR Image ENDSWITH "\\powerpnt.exe" OR Image ENDSWITH "\\msaccess.exe" OR Image ENDSWITH "\\mspub.exe" OR Image ENDSWITH "\\eqnedt32.exe" OR Image ENDSWITH "\\visio.exe" OR Image ENDSWITH "\\wordpad.exe" OR Image ENDSWITH "\\wordview.exe" OR Image ENDSWITH "\\certutil.exe" OR Image ENDSWITH "\\certoc.exe" OR Image ENDSWITH "\\CertReq.exe" OR Image ENDSWITH "\\Desktopimgdownldr.exe" OR Image ENDSWITH "\\esentutl.exe" OR Image ENDSWITH "\\finger.exe" OR Image ENDSWITH "\\notepad.exe" OR Image ENDSWITH "\\AcroRd32.exe" OR Image ENDSWITH "\\RdrCEF.exe" OR Image ENDSWITH "\\mshta.exe" OR Image ENDSWITH "\\hh.exe") AND (TargetFilename ENDSWITH ".zip" OR TargetFilename ENDSWITH ".rar" OR TargetFilename ENDSWITH ".7z" OR TargetFilename ENDSWITH ".diagcab" OR TargetFilename ENDSWITH ".appx"))
