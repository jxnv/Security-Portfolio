// Title: Unix Shell Configuration Modification
// ID: a94cdd87-6c54-4678-a6cc-2814ffe5a13d
// Status: test
// Level: medium
// Author: Peter Matkovski, IAI
// Date: 2023-03-06
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.004
// Description: Detect unix shell configuration modification. Adversaries may establish persistence through executing malicious commands triggered when a new shell is opened.
// Converted by: Sigma Universal SIEM/EDR CLI

(type EQ "PATH" AND (name EQ "/etc/shells" OR name EQ "/etc/profile" OR name EQ "/etc/profile.d/*" OR name EQ "/etc/bash.bashrc" OR name EQ "/etc/bashrc" OR name EQ "/etc/zsh/zprofile" OR name EQ "/etc/zsh/zshrc" OR name EQ "/etc/zsh/zlogin" OR name EQ "/etc/zsh/zlogout" OR name EQ "/etc/csh.cshrc" OR name EQ "/etc/csh.login" OR name EQ "/root/.bashrc" OR name EQ "/root/.bash_profile" OR name EQ "/root/.profile" OR name EQ "/root/.zshrc" OR name EQ "/root/.zprofile" OR name EQ "/home/*/.bashrc" OR name EQ "/home/*/.zshrc" OR name EQ "/home/*/.bash_profile" OR name EQ "/home/*/.zprofile" OR name EQ "/home/*/.profile" OR name EQ "/home/*/.bash_login" OR name EQ "/home/*/.bash_logout" OR name EQ "/home/*/.zlogin" OR name EQ "/home/*/.zlogout"))
