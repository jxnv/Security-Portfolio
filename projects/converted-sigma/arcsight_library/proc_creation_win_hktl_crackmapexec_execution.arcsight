// Title: HackTool - CrackMapExec Execution
// ID: 42a993dd-bb3e-48c8-b372-4d6684c4106c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-25
// Tags: attack.execution, attack.persistence, attack.privilege-escalation, attack.credential-access, attack.discovery, attack.t1047, attack.t1053, attack.t1059.003, attack.t1059.001, attack.t1110, attack.t1201
// Description: This rule detect common flag combinations used by CrackMapExec in order to detect its use even if the binary has been replaced.
// Converted by: Sigma Universal SIEM/EDR CLI

(((Image ENDSWITH "\\crackmapexec.exe") OR ((CommandLine CONTAINS " --local-auth" AND CommandLine CONTAINS " -u " AND CommandLine CONTAINS " -x ")) OR ((CommandLine CONTAINS " --local-auth" AND CommandLine CONTAINS " -u " AND CommandLine CONTAINS " -p " AND CommandLine CONTAINS " -H 'NTHASH'")) OR ((CommandLine CONTAINS " mssql " AND CommandLine CONTAINS " -u " AND CommandLine CONTAINS " -p " AND CommandLine CONTAINS " -M " AND CommandLine CONTAINS " -d ")) OR ((CommandLine CONTAINS " smb " AND CommandLine CONTAINS " -u " AND CommandLine CONTAINS " -H " AND CommandLine CONTAINS " -M " AND CommandLine CONTAINS " -o ")) OR ((CommandLine CONTAINS " smb " AND CommandLine CONTAINS " -u " AND CommandLine CONTAINS " -p " AND CommandLine CONTAINS " --local-auth")) OR (CommandLine CONTAINS " -M pe_inject ")) OR (((CommandLine CONTAINS " --local-auth" AND CommandLine CONTAINS " -u " AND CommandLine CONTAINS " -p ")) AND ((CommandLine CONTAINS " 10." AND CommandLine CONTAINS " 192.168." AND CommandLine CONTAINS "/24 "))))
