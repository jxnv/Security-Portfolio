// Title: Suspicious Process Start Locations
// ID: 15b75071-74cc-47e0-b4c6-b43744a62a2b
// Status: test
// Level: medium
// Author: juju4, Jonhnathan Ribeiro, oscd.community
// Date: 2019-01-16
// Tags: attack.stealth, attack.t1036, car.2013-05-002
// Description: Detects suspicious process run from unusual locations
// Converted by: Sigma Universal SIEM/EDR CLI

(((Image CONTAINS ":\\RECYCLER\\" OR Image CONTAINS ":\\SystemVolumeInformation\\")) OR ((Image STARTSWITH "C:\\Windows\\Tasks\\" OR Image STARTSWITH "C:\\Windows\\debug\\" OR Image STARTSWITH "C:\\Windows\\fonts\\" OR Image STARTSWITH "C:\\Windows\\help\\" OR Image STARTSWITH "C:\\Windows\\drivers\\" OR Image STARTSWITH "C:\\Windows\\addins\\" OR Image STARTSWITH "C:\\Windows\\cursors\\" OR Image STARTSWITH "C:\\Windows\\system32\\tasks\\")))
