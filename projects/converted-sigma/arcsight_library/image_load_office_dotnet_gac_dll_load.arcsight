// Title: GAC DLL Loaded Via Office Applications
// ID: 90217a70-13fc-48e4-b3db-0d836c5824ac
// Status: test
// Level: high
// Author: Antonlovesdnb
// Date: 2020-02-19
// Tags: attack.execution, attack.t1204.002
// Description: Detects any GAC DLL being loaded by an Office Product
// Converted by: Sigma Universal SIEM/EDR CLI

((Image ENDSWITH "\\excel.exe" OR Image ENDSWITH "\\mspub.exe" OR Image ENDSWITH "\\onenote.exe" OR Image ENDSWITH "\\onenoteim.exe" OR Image ENDSWITH "\\outlook.exe" OR Image ENDSWITH "\\powerpnt.exe" OR Image ENDSWITH "\\winword.exe") AND ImageLoaded STARTSWITH "C:\\Windows\\Microsoft.NET\\assembly\\GAC_MSIL")
