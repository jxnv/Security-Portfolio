// Title: .RDP File Created By Uncommon Application
// ID: fccfb43e-09a7-4bd2-8b37-a5a7df33386d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.stealth
// Description: Detects creation of a file with an ".rdp" extension by an application that doesn't commonly create such files.
// Converted by: Sigma Universal SIEM/EDR CLI

(TargetFilename ENDSWITH ".rdp" AND (Image ENDSWITH "\\brave.exe" OR Image ENDSWITH "\\CCleaner Browser\\Application\\CCleanerBrowser.exe" OR Image ENDSWITH "\\chromium.exe" OR Image ENDSWITH "\\firefox.exe" OR Image ENDSWITH "\\Google\\Chrome\\Application\\chrome.exe" OR Image ENDSWITH "\\iexplore.exe" OR Image ENDSWITH "\\microsoftedge.exe" OR Image ENDSWITH "\\msedge.exe" OR Image ENDSWITH "\\Opera.exe" OR Image ENDSWITH "\\Vivaldi.exe" OR Image ENDSWITH "\\Whale.exe" OR Image ENDSWITH "\\olk.exe" OR Image ENDSWITH "\\Outlook.exe" OR Image ENDSWITH "\\RuntimeBroker.exe" OR Image ENDSWITH "\\Thunderbird.exe" OR Image ENDSWITH "\\Discord.exe" OR Image ENDSWITH "\\Keybase.exe" OR Image ENDSWITH "\\msteams.exe" OR Image ENDSWITH "\\Slack.exe" OR Image ENDSWITH "\\teams.exe"))
