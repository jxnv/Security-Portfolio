// Title: Suspicious Program Location Whitelisted In Firewall Via Netsh.EXE
// ID: a35f5a72-f347-4e36-8895-9869b0d5fc6d
// Status: test
// Level: high
// Author: Sander Wiebing, Jonhnathan Ribeiro, Daniil Yugoslavskiy, oscd.community
// Date: 2020-05-25
// Tags: attack.defense-impairment, attack.t1686.003
// Description: Detects Netsh command execution that whitelists a program located in a suspicious location in the Windows Firewall
// Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine CONTAINS "firewall" AND CommandLine CONTAINS "add" AND CommandLine CONTAINS "allowedprogram")) OR ((CommandLine CONTAINS "advfirewall" AND CommandLine CONTAINS "firewall" AND CommandLine CONTAINS "add" AND CommandLine CONTAINS "rule" AND CommandLine CONTAINS "action=allow" AND CommandLine CONTAINS "program="))) AND ((Image ENDSWITH "\\netsh.exe") OR (OriginalFileName EQ "netsh.exe")) AND ((CommandLine CONTAINS ":\\$Recycle.bin\\" OR CommandLine CONTAINS ":\\RECYCLER.BIN\\" OR CommandLine CONTAINS ":\\RECYCLERS.BIN\\" OR CommandLine CONTAINS ":\\SystemVolumeInformation\\" OR CommandLine CONTAINS ":\\Temp\\" OR CommandLine CONTAINS ":\\Users\\Default\\" OR CommandLine CONTAINS ":\\Users\\Desktop\\" OR CommandLine CONTAINS ":\\Users\\Public\\" OR CommandLine CONTAINS ":\\Windows\\addins\\" OR CommandLine CONTAINS ":\\Windows\\cursors\\" OR CommandLine CONTAINS ":\\Windows\\debug\\" OR CommandLine CONTAINS ":\\Windows\\drivers\\" OR CommandLine CONTAINS ":\\Windows\\fonts\\" OR CommandLine CONTAINS ":\\Windows\\help\\" OR CommandLine CONTAINS ":\\Windows\\system32\\tasks\\" OR CommandLine CONTAINS ":\\Windows\\Tasks\\" OR CommandLine CONTAINS ":\\Windows\\Temp\\" OR CommandLine CONTAINS "\\Downloads\\" OR CommandLine CONTAINS "\\Local Settings\\Temporary Internet Files\\" OR CommandLine CONTAINS "\\Temporary Internet Files\\Content.Outlook\\" OR CommandLine CONTAINS "%Public%\\" OR CommandLine CONTAINS "%TEMP%" OR CommandLine CONTAINS "%TMP%")))
