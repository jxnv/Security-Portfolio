// Title: PowerShell Download Pattern
// ID: 3b6ab547-8ec2-4991-b9d2-2b06702a48d7
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), oscd.community, Jonhnathan Ribeiro
// Date: 2019-01-16
// Tags: attack.execution, attack.t1059.001
// Description: Detects a Powershell process that contains download commands in its command line string
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAINS "new-object" AND CommandLine CONTAINS "net.webclient)." AND CommandLine CONTAINS "download") AND (CommandLine CONTAINS "string(" OR CommandLine CONTAINS "file(")) AND (((Image ENDSWITH "\\powershell_ise.exe" OR Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\pwsh.exe")) OR ((OriginalFileName EQ "PowerShell_ISE.EXE" OR OriginalFileName EQ "PowerShell.EXE" OR OriginalFileName EQ "pwsh.dll"))))
