// Title: Potentially Suspicious Network Connection To Notion API
// ID: 7e9cf7b6-e827-11ed-a05b-15959c120003
// Status: test
// Level: low
// Author: Gavin Knapp
// Date: 2023-05-03
// Tags: attack.command-and-control, attack.t1102
// Description: Detects a non-browser process communicating with the Notion API. This could indicate potential use of a covert C2 channel such as "OffensiveNotion C2"
// Converted by: Sigma Universal SIEM/EDR CLI

((DestinationHostname CONTAINS "api.notion.com") AND NOT (((Image ENDSWITH "\\brave.exe") OR ((Image EQ "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR Image EQ "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((Image STARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") OR (Image ENDSWITH "\\WindowsApps\\MicrosoftEdge.exe") OR ((Image EQ "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR Image EQ "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((Image STARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" OR Image STARTSWITH "C:\\Program Files\\Microsoft\\EdgeCore\\") AND (Image ENDSWITH "\\msedge.exe" OR Image ENDSWITH "\\msedgewebview2.exe")) OR ((Image EQ "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR Image EQ "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR ((Image EQ "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR Image EQ "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (Image ENDSWITH "\\maxthon.exe") OR (Image ENDSWITH "\\AppData\\Local\\Programs\\Notion\\Notion.exe") OR (Image ENDSWITH "\\opera.exe") OR (Image ENDSWITH "\\safari.exe") OR (Image ENDSWITH "\\seamonkey.exe") OR (Image ENDSWITH "\\vivaldi.exe") OR (Image ENDSWITH "\\whale.exe"))))
