// Title: Execution of Powershell Script in Public Folder
// ID: fb9d3ff7-7348-46ab-af8c-b55f5fbf39b4
// Status: test
// Level: high
// Author: Max Altgelt (Nextron Systems)
// Date: 2022-04-06
// Tags: attack.execution, attack.t1059.001
// Description: This rule detects execution of PowerShell scripts located in the "C:\Users\Public" folder
// Converted by: Sigma Universal SIEM/EDR CLI

((Image ENDSWITH "\\powershell.exe" OR Image ENDSWITH "\\pwsh.exe") AND (CommandLine CONTAINS "-f C:\\Users\\Public" OR CommandLine CONTAINS "-f \"C:\\Users\\Public" OR CommandLine CONTAINS "-f %Public%" OR CommandLine CONTAINS "-fi C:\\Users\\Public" OR CommandLine CONTAINS "-fi \"C:\\Users\\Public" OR CommandLine CONTAINS "-fi %Public%" OR CommandLine CONTAINS "-fil C:\\Users\\Public" OR CommandLine CONTAINS "-fil \"C:\\Users\\Public" OR CommandLine CONTAINS "-fil %Public%" OR CommandLine CONTAINS "-file C:\\Users\\Public" OR CommandLine CONTAINS "-file \"C:\\Users\\Public" OR CommandLine CONTAINS "-file %Public%"))
