// Description: Windows DCE-RPC functions which indicate an execution techniques on the remote system. All credit for the Zeek mapping of the suspicious endpoint/operation field goes to MITRE
// Converted by: Sigma Universal SIEM/EDR CLI

((endpoint EQ "JobAdd" AND operation EQ "atsvc") OR (endpoint EQ "svcctl" AND operation EQ "StartServiceW") OR (endpoint EQ "ITaskSchedulerService" AND operation EQ "SchRpcEnableTask") OR (endpoint EQ "ITaskSchedulerService" AND operation EQ "SchRpcRegisterTask") OR (endpoint EQ "ITaskSchedulerService" AND operation EQ "SchRpcRun") OR (endpoint EQ "IWbemServices" AND operation EQ "ExecMethod") OR (endpoint EQ "IWbemServices" AND operation EQ "ExecMethodAsync") OR (endpoint EQ "svcctl" AND operation EQ "CreateServiceA") OR (endpoint EQ "svcctl" AND operation EQ "CreateServiceW") OR (endpoint EQ "svcctl" AND operation EQ "StartServiceA"))
