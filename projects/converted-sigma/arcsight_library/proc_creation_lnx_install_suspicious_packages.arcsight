// Title: Suspicious Package Installed - Linux
// ID: 700fb7e8-2981-401c-8430-be58e189e741
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-03
// Tags: attack.defense-impairment, attack.t1553.004
// Description: Detects installation of suspicious packages using system installation utilities
// Converted by: Sigma Universal SIEM/EDR CLI

((((Image ENDSWITH "/apt" OR Image ENDSWITH "/apt-get") AND CommandLine CONTAINS "install") OR (Image ENDSWITH "/dpkg" AND (CommandLine CONTAINS "--install" OR CommandLine CONTAINS "-i")) OR (Image ENDSWITH "/rpm" AND CommandLine CONTAINS "-i") OR (Image ENDSWITH "/yum" AND (CommandLine CONTAINS "localinstall" OR CommandLine CONTAINS "install"))) AND ((CommandLine CONTAINS "nmap" OR CommandLine CONTAINS " nc" OR CommandLine CONTAINS "netcat" OR CommandLine CONTAINS "wireshark" OR CommandLine CONTAINS "tshark" OR CommandLine CONTAINS "openconnect" OR CommandLine CONTAINS "proxychains" OR CommandLine CONTAINS "socat")))
