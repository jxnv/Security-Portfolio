// Title: Disable Security Tools
// ID: ff39f1a6-84ac-476f-a1af-37fcdf53d7c0
// Status: test
// Level: medium
// Author: Daniil Yugoslavskiy, oscd.community
// Date: 2020-10-19
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects disabling security tools
// Converted by: Sigma Universal SIEM/EDR CLI

(((Image EQ "/bin/launchctl" AND CommandLine CONTAINS "unload") AND ((CommandLine CONTAINS "com.objective-see.lulu.plist" OR CommandLine CONTAINS "com.objective-see.blockblock.plist" OR CommandLine CONTAINS "com.google.santad.plist" OR CommandLine CONTAINS "com.carbonblack.defense.daemon.plist" OR CommandLine CONTAINS "com.carbonblack.daemon.plist" OR CommandLine CONTAINS "at.obdev.littlesnitchd.plist" OR CommandLine CONTAINS "com.tenablesecurity.nessusagent.plist" OR CommandLine CONTAINS "com.opendns.osx.RoamingClientConfigUpdater.plist" OR CommandLine CONTAINS "com.crowdstrike.falcond.plist" OR CommandLine CONTAINS "com.crowdstrike.userdaemon.plist" OR CommandLine CONTAINS "osquery" OR CommandLine CONTAINS "filebeat" OR CommandLine CONTAINS "auditbeat" OR CommandLine CONTAINS "packetbeat" OR CommandLine CONTAINS "td-agent"))) OR (Image EQ "/usr/sbin/spctl" AND CommandLine CONTAINS "disable"))
