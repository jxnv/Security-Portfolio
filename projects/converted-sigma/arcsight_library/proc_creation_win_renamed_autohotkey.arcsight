// Title: Renamed AutoHotkey.EXE Execution
// ID: 0f16d9cf-0616-45c8-8fad-becc11b5a41c
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali
// Date: 2023-02-07
// Tags: attack.stealth
// Description: Detects execution of a renamed autohotkey.exe binary based on PE metadata fields
// Converted by: Sigma Universal SIEM/EDR CLI

(((Product CONTAINS "AutoHotkey") OR (Description CONTAINS "AutoHotkey") OR ((OriginalFileName EQ "AutoHotkey.exe" OR OriginalFileName EQ "AutoHotkey.rc"))) AND NOT ((((Image ENDSWITH "\\AutoHotkey.exe" OR Image ENDSWITH "\\AutoHotkey32.exe" OR Image ENDSWITH "\\AutoHotkey32_UIA.exe" OR Image ENDSWITH "\\AutoHotkey64.exe" OR Image ENDSWITH "\\AutoHotkey64_UIA.exe" OR Image ENDSWITH "\\AutoHotkeyA32.exe" OR Image ENDSWITH "\\AutoHotkeyA32_UIA.exe" OR Image ENDSWITH "\\AutoHotkeyU32.exe" OR Image ENDSWITH "\\AutoHotkeyU32_UIA.exe" OR Image ENDSWITH "\\AutoHotkeyU64.exe" OR Image ENDSWITH "\\AutoHotkeyU64_UIA.exe")) OR (Image CONTAINS "\\AutoHotkey"))))
