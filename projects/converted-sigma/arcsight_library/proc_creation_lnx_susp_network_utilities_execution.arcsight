// Title: Linux Network Service Scanning Tools Execution
// ID: 3e102cd9-a70d-4a7a-9508-403963092f31
// Status: test
// Level: low
// Author: Alejandro Ortuno, oscd.community, Georg Lauenstein (sure[secure])
// Date: 2020-10-21
// Tags: attack.discovery, attack.t1046
// Description: Detects execution of network scanning and reconnaisance tools. These tools can be used for the enumeration of local or remote network services for example.
// Converted by: Sigma Universal SIEM/EDR CLI

((((Image ENDSWITH "/nc" OR Image ENDSWITH "/ncat" OR Image ENDSWITH "/netcat" OR Image ENDSWITH "/socat")) AND NOT (((CommandLine CONTAINS " --listen " OR CommandLine CONTAINS " -l ")))) OR ((Image ENDSWITH "/autorecon" OR Image ENDSWITH "/hping" OR Image ENDSWITH "/hping2" OR Image ENDSWITH "/hping3" OR Image ENDSWITH "/naabu" OR Image ENDSWITH "/nmap" OR Image ENDSWITH "/nping" OR Image ENDSWITH "/telnet" OR Image ENDSWITH "/zenmap")))
