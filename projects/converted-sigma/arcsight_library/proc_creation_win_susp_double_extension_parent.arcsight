// Title: Suspicious Parent Double Extension File Execution
// ID: 5e6a80c8-2d45-4633-9ef4-fa2671a39c5c
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-06
// Tags: attack.stealth, attack.t1036.007
// Description: Detect execution of suspicious double extension files in ParentCommandLine
// Converted by: Sigma Universal SIEM/EDR CLI

(((ParentImage ENDSWITH ".doc.lnk" OR ParentImage ENDSWITH ".docx.lnk" OR ParentImage ENDSWITH ".xls.lnk" OR ParentImage ENDSWITH ".xlsx.lnk" OR ParentImage ENDSWITH ".ppt.lnk" OR ParentImage ENDSWITH ".pptx.lnk" OR ParentImage ENDSWITH ".rtf.lnk" OR ParentImage ENDSWITH ".pdf.lnk" OR ParentImage ENDSWITH ".txt.lnk" OR ParentImage ENDSWITH ".doc.js" OR ParentImage ENDSWITH ".docx.js" OR ParentImage ENDSWITH ".xls.js" OR ParentImage ENDSWITH ".xlsx.js" OR ParentImage ENDSWITH ".ppt.js" OR ParentImage ENDSWITH ".pptx.js" OR ParentImage ENDSWITH ".rtf.js" OR ParentImage ENDSWITH ".pdf.js" OR ParentImage ENDSWITH ".txt.js")) OR ((ParentCommandLine CONTAINS ".doc.lnk" OR ParentCommandLine CONTAINS ".docx.lnk" OR ParentCommandLine CONTAINS ".xls.lnk" OR ParentCommandLine CONTAINS ".xlsx.lnk" OR ParentCommandLine CONTAINS ".ppt.lnk" OR ParentCommandLine CONTAINS ".pptx.lnk" OR ParentCommandLine CONTAINS ".rtf.lnk" OR ParentCommandLine CONTAINS ".pdf.lnk" OR ParentCommandLine CONTAINS ".txt.lnk" OR ParentCommandLine CONTAINS ".doc.js" OR ParentCommandLine CONTAINS ".docx.js" OR ParentCommandLine CONTAINS ".xls.js" OR ParentCommandLine CONTAINS ".xlsx.js" OR ParentCommandLine CONTAINS ".ppt.js" OR ParentCommandLine CONTAINS ".pptx.js" OR ParentCommandLine CONTAINS ".rtf.js" OR ParentCommandLine CONTAINS ".pdf.js" OR ParentCommandLine CONTAINS ".txt.js")))
