// Title: Office Autorun Keys Modification
// ID: baecf8fb-edbf-429f-9ade-31fc3f22b970
// Status: test
// Level: medium
// Author: Victor Sergeev, Daniil Yugoslavskiy, Gleb Sukhodolskiy, Timur Zinniatullin, oscd.community, Tim Shelton, frack113 (split)
// Date: 2019-10-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects modification of autostart extensibility point (ASEP) in registry. Adversaries may modify these keys to execute malicious code when Office files are opened.
// There are various legitimate add-ins that also use these keys and this filter list might not be exhaustive.
// Thus, it is recommended to review and tune filters for your environment to reduce false positives before deploying to production.
// Converted by: Sigma Universal SIEM/EDR CLI

dataset = xdr_data | filter ((((TargetObject contains "\\Word\\Addins" or TargetObject contains "\\PowerPoint\\Addins" or TargetObject contains "\\Outlook\\Addins" or TargetObject contains "\\Onenote\\Addins" or TargetObject contains "\\Excel\\Addins" or TargetObject contains "\\Access\\Addins" or TargetObject contains "test\\Special\\Perf")) and ((TargetObject contains "\\Software\\Wow6432Node\\Microsoft\\Office" or TargetObject contains "\\Software\\Microsoft\\Office"))) and not (((Details = "(Empty)") or ((action_process_image_path startswith "C:\\Program Files\\Microsoft Office\\" or action_process_image_path startswith "C:\\Program Files (x86)\\Microsoft Office\\" or action_process_image_path startswith "C:\\PROGRA~2\\MICROS~2\\Office" or action_process_image_path startswith "C:\\Windows\\System32\\msiexec.exe" or action_process_image_path startswith "C:\\Windows\\SysWOW64\\msiexec.exe" or action_process_image_path startswith "C:\\Windows\\System32\\regsvr32.exe" or action_process_image_path startswith "C:\\Windows\\SysWOW64\\regsvr32.exe") and (TargetObject contains "\\Excel\\Addins\\AdHocReportingExcelClientLib.AdHocReportingExcelClientAddIn.1\\" or TargetObject contains "\\Excel\\Addins\\ExcelPlugInShell.PowerMapConnect\\" or TargetObject contains "\\Excel\\Addins\\NativeShim\\" or TargetObject contains "\\Excel\\Addins\\NativeShim.InquireConnector.1\\" or TargetObject contains "\\Excel\\Addins\\PowerPivotExcelClientAddIn.NativeEntry.1\\" or TargetObject contains "\\Outlook\\AddIns\\AccessAddin.DC\\" or TargetObject contains "\\Outlook\\AddIns\\ColleagueImport.ColleagueImportAddin\\" or TargetObject contains "\\Outlook\\AddIns\\EvernoteCC.EvernoteContactConnector\\" or TargetObject contains "\\Outlook\\AddIns\\EvernoteOLRD.Connect\\" or TargetObject contains "\\Outlook\\Addins\\OneNote.OutlookAddin" or TargetObject contains "\\Outlook\\Addins\\DriveFSExtensionLib.Connect\\" or TargetObject contains "\\Outlook\\Addins\\GoogleAppsSync.Connect\\" or TargetObject contains "\\Outlook\\Addins\\Microsoft.VbaAddinForOutlook.1\\" or TargetObject contains "\\Outlook\\Addins\\OcOffice.OcForms\\" or TargetObject contains "\\Outlook\\Addins\\OscAddin.Connect\\" or TargetObject contains "\\Outlook\\Addins\\OutlookChangeNotifier.Connect\\" or TargetObject contains "\\Outlook\\Addins\\UCAddin.LyncAddin.1" or TargetObject contains "\\Outlook\\Addins\\UCAddin.UCAddin.1" or TargetObject contains "\\Outlook\\Addins\\UmOutlookAddin.FormRegionAddin\\" or TargetObject contains "AddinTakeNotesService\\FriendlyName")) or (Details = null) or ((action_process_image_path startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\" or action_process_image_path startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\") and action_process_image_path endswith "\\OfficeClickToRun.exe") or ((action_process_image_path startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\VSTO\\" or action_process_image_path startswith "C:\\Program Files (x86)\\Microsoft Shared\\VSTO\\") and action_process_image_path endswith "\\VSTOInstaller.exe"))) and not ((((action_process_image_path = "C:\\Program Files\\Avast Software\\Avast\\RegSvr.exe" or action_process_image_path = "C:\\Program Files\\Avast Software\\Avast\\x86\\RegSvr.exe") and TargetObject contains "\\Microsoft\\Office\\Outlook\\Addins\\Avast.AsOutExt\\") or ((action_process_image_path = "C:\\Program Files\\AVG\\Antivirus\\RegSvr.exe" or action_process_image_path = "C:\\Program Files\\AVG\\Antivirus\\x86\\RegSvr.exe") and TargetObject contains "\\Microsoft\\Office\\Outlook\\Addins\\Antivirus.AsOutExt\\"))))
