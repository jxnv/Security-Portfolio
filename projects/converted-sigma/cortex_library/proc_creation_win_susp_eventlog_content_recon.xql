// Title: Potentially Suspicious EventLog Recon Activity Using Log Query Utilities
// ID: beaa66d6-aa1b-4e3c-80f5-e0145369bfaf
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.credential-access, attack.discovery, attack.t1552, attack.t1087
// Description: Detects execution of different log query utilities and commands to search and dump the content of specific event logs or look for specific event IDs.
// This technique is used by threat actors in order to extract sensitive information from events logs such as usernames, IP addresses, hostnames, etc.
// Converted by: Sigma Universal SIEM/EDR CLI

dataset = xdr_data | filter ((((action_process_image_command_line contains "-InstanceId 462?" or action_process_image_command_line contains ".eventid -eq 462?" or action_process_image_command_line contains ".ID -eq 462?" or action_process_image_command_line contains "EventCode=?462?" or action_process_image_command_line contains "EventIdentifier=?462?" or action_process_image_command_line contains "System[EventID=462?]" or action_process_image_command_line contains "-InstanceId 4778" or action_process_image_command_line contains ".eventid -eq 4778" or action_process_image_command_line contains ".ID -eq 4778" or action_process_image_command_line contains "EventCode=?4778?" or action_process_image_command_line contains "EventIdentifier=?4778?" or action_process_image_command_line contains "System[EventID=4778]" or action_process_image_command_line contains "-InstanceId 25" or action_process_image_command_line contains ".eventid -eq 25" or action_process_image_command_line contains ".ID -eq 25" or action_process_image_command_line contains "EventCode=?25?" or action_process_image_command_line contains "EventIdentifier=?25?" or action_process_image_command_line contains "System[EventID=25]" or action_process_image_command_line contains "-InstanceId 1149" or action_process_image_command_line contains ".eventid -eq 1149" or action_process_image_command_line contains ".ID -eq 1149" or action_process_image_command_line contains "EventCode=?1149?" or action_process_image_command_line contains "EventIdentifier=?1149?" or action_process_image_command_line contains "System[EventID=1149]" or action_process_image_command_line contains "-InstanceId 21" or action_process_image_command_line contains ".eventid -eq 21" or action_process_image_command_line contains ".ID -eq 21" or action_process_image_command_line contains "EventCode=?21?" or action_process_image_command_line contains "EventIdentifier=?21?" or action_process_image_command_line contains "System[EventID=21]" or action_process_image_command_line contains "-InstanceId 22" or action_process_image_command_line contains ".eventid -eq 22" or action_process_image_command_line contains ".ID -eq 22" or action_process_image_command_line contains "EventCode=?22?" or action_process_image_command_line contains "EventIdentifier=?22?" or action_process_image_command_line contains "System[EventID=22]")) or ((action_process_image_command_line contains "Microsoft-Windows-PowerShell" or action_process_image_command_line contains "Microsoft-Windows-Security-Auditing" or action_process_image_command_line contains "Microsoft-Windows-TerminalServices-LocalSessionManager" or action_process_image_command_line contains "Microsoft-Windows-TerminalServices-RemoteConnectionManager" or action_process_image_command_line contains "Microsoft-Windows-Windows Defender" or action_process_image_command_line contains "PowerShellCore" or action_process_image_command_line contains "Security" or action_process_image_command_line contains "Windows PowerShell"))) and (((action_process_image_command_line contains "Select" and action_process_image_command_line contains "Win32_NTLogEvent")) or (((action_process_image_command_line contains " qe " or action_process_image_command_line contains " query-events ")) and ((action_process_image_path endswith "\\wevtutil.exe") or (action_process_image_name = "wevtutil.exe"))) or ((action_process_image_command_line contains " ntevent") and ((action_process_image_path endswith "\\wmic.exe") or (action_process_image_name = "wmic.exe"))) or ((action_process_image_command_line contains "Get-WinEvent " or action_process_image_command_line contains "get-eventlog "))))
