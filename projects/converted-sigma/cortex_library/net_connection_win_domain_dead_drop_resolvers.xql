// Title: New Connection Initiated To Potential Dead Drop Resolver Domain
// ID: 297ae038-edc2-4b2e-bb3e-7c5fc94dd5c7
// Status: test
// Level: high
// Author: Sorina Ionescu, X__Junior (Nextron Systems)
// Date: 2022-08-17
// Tags: attack.command-and-control, attack.t1102, attack.t1102.001
// Description: Detects an executable, which is not an internet browser or known application, initiating network connections to legit popular websites, which were seen to be used as dead drop resolvers in previous attacks.
// In this context attackers leverage known websites such as "facebook", "youtube", etc. In order to pass through undetected.
// Converted by: Sigma Universal SIEM/EDR CLI

dataset = xdr_data | filter ((Initiated = "true" and (DestinationHostname endswith ".t.me" or DestinationHostname endswith "0x0.st" or DestinationHostname endswith "4shared.com" or DestinationHostname endswith "abuse.ch" or DestinationHostname endswith "anonfiles.com" or DestinationHostname endswith "bashupload.com" or DestinationHostname endswith "cdn.discordapp.com" or DestinationHostname endswith "chunk.io" or DestinationHostname endswith "cloudflare.com" or DestinationHostname endswith "ddns.net" or DestinationHostname endswith "discord.com" or DestinationHostname endswith "docs.google.com" or DestinationHostname endswith "drive.google.com" or DestinationHostname endswith "dropbox.com" or DestinationHostname endswith "dropmefiles.com" or DestinationHostname endswith "facebook.com" or DestinationHostname endswith "feeds.rapidfeeds.com" or DestinationHostname endswith "fotolog.com" or DestinationHostname endswith "ghostbin.co/" or DestinationHostname endswith "githubusercontent.com" or DestinationHostname endswith "gofile.io" or DestinationHostname endswith "hastebin.com" or DestinationHostname endswith "imgur.com" or DestinationHostname endswith "livejournal.com" or DestinationHostname endswith "mediafire.com" or DestinationHostname endswith "mega.co.nz" or DestinationHostname endswith "mega.nz" or DestinationHostname endswith "onedrive.com" or DestinationHostname endswith "pages.dev" or DestinationHostname endswith "paste.ee" or DestinationHostname endswith "pastebin.com" or DestinationHostname endswith "pastebin.pl" or DestinationHostname endswith "pastetext.net" or DestinationHostname endswith "pixeldrain.com" or DestinationHostname endswith "privatlab.com" or DestinationHostname endswith "privatlab.net" or DestinationHostname endswith "reddit.com" or DestinationHostname endswith "send.exploit.in" or DestinationHostname endswith "sendspace.com" or DestinationHostname endswith "steamcommunity.com" or DestinationHostname endswith "storage.googleapis.com" or DestinationHostname endswith "technet.microsoft.com" or DestinationHostname endswith "temp.sh" or DestinationHostname endswith "transfer.sh" or DestinationHostname endswith "trycloudflare.com" or DestinationHostname endswith "twitter.com" or DestinationHostname endswith "ufile.io" or DestinationHostname endswith "vimeo.com" or DestinationHostname endswith "w3spaces.com" or DestinationHostname endswith "wetransfer.com" or DestinationHostname endswith "workers.dev" or DestinationHostname endswith "x0.at" or DestinationHostname endswith "youtube.com")) and not ((((action_process_image_path startswith "C:\\Program Files (x86)\\Avant Browser\\" or action_process_image_path startswith "C:\\Program Files\\Avant Browser\\") and action_process_image_path endswith "\\avant.exe") or (action_process_image_path startswith "C:\\Program Files\\BraveSoftware\\" and action_process_image_path endswith "\\brave.exe") or ((action_process_image_path = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or action_process_image_path = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or (action_process_image_path startswith "C:\\Users\\" and action_process_image_path endswith "\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe") or ((action_process_image_path contains "C:\\Program Files\\Windows Defender Advanced Threat Protection\\" or action_process_image_path contains "C:\\Program Files\\Windows Defender\\" or action_process_image_path contains "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\") and (action_process_image_path endswith "\\MsMpEng.exe" or action_process_image_path endswith "\\MsSense.exe")) or (action_process_image_path contains "\\AppData\\Local\\Discord\\" and action_process_image_path endswith "\\Discord.exe" and (DestinationHostname endswith "discord.com" or DestinationHostname endswith "cdn.discordapp.com")) or ((action_process_image_path startswith "C:\\Program Files (x86)\\Dropbox\\Client\\" or action_process_image_path startswith "C:\\Program Files\\Dropbox\\Client\\") and (action_process_image_path endswith "\\Dropbox.exe" or action_process_image_path endswith "\\DropboxInstaller.exe") and DestinationHostname endswith "dropbox.com") or ((action_process_image_path startswith "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") or (action_process_image_path endswith "\\WindowsApps\\MicrosoftEdge.exe") or ((action_process_image_path = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or action_process_image_path = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((action_process_image_path startswith "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" or action_process_image_path startswith "C:\\Program Files\\Microsoft\\EdgeCore\\") and (action_process_image_path endswith "\\msedge.exe" or action_process_image_path endswith "\\msedgewebview2.exe")) or (action_process_image_path = "") or ((action_process_image_path startswith "C:\\Program Files\\Falkon\\" or action_process_image_path startswith "C:\\Program Files (x86)\\Falkon\\") and action_process_image_path endswith "\\falkon.exe") or ((action_process_image_path = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or action_process_image_path = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or (action_process_image_path startswith "C:\\Users\\" and action_process_image_path endswith "\\AppData\\Local\\Mozilla Firefox\\firefox.exe") or (action_process_image_path contains "\\AppData\\Local\\Flock\\" and action_process_image_path endswith "\\Flock.exe") or ((action_process_image_path contains "C:\\Program Files\\Google\\Drive File Stream\\" or action_process_image_path contains "C:\\Program Files (x86)\\Google\\Drive File Stream\\") and action_process_image_path endswith "GoogleDriveFS.exe" and DestinationHostname endswith "drive.google.com") or ((action_process_image_path = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or action_process_image_path = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (action_process_image_path contains "\\AppData\\Local\\Maxthon\\" and action_process_image_path endswith "\\maxthon.exe") or ((action_process_image_path endswith "\\MEGAsync.exe" or action_process_image_path endswith "\\MEGAsyncSetup32_*RC.exe" or action_process_image_path endswith "\\MEGAsyncSetup32.exe" or action_process_image_path endswith "\\MEGAsyncSetup64.exe" or action_process_image_path endswith "\\MEGAupdater.exe") and (DestinationHostname endswith "mega.co.nz" or DestinationHostname endswith "mega.nz")) or (action_process_image_path contains "\\AppData\\Local\\Programs\\midori-ng\\" and action_process_image_path endswith "\\Midori Next Generation.exe") or (action_process_image_path = null) or (action_process_image_path contains "\\AppData\\Local\\Microsoft\\OneDrive\\" and action_process_image_path endswith "\\OneDrive.exe" and DestinationHostname endswith "onedrive.com") or (action_process_image_path contains "\\AppData\\Local\\Programs\\Opera\\" and action_process_image_path endswith "\\opera.exe") or (action_process_image_path contains "\\AppData\\Local\\Phoebe\\" and action_process_image_path endswith "\\Phoebe.exe") or ((action_process_image_path endswith "C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe" or action_process_image_path endswith "C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe")) or ((action_process_image_path startswith "C:\\Program Files (x86)\\QtWeb\\" or action_process_image_path startswith "C:\\Program Files\\QtWeb\\") and action_process_image_path endswith "\\QtWeb.exe") or ((action_process_image_path contains "C:\\Program Files (x86)\\Safari\\" or action_process_image_path contains "C:\\Program Files\\Safari\\") and action_process_image_path endswith "\\safari.exe") or ((action_process_image_path startswith "C:\\Program Files\\SeaMonkey\\" or action_process_image_path startswith "C:\\Program Files (x86)\\SeaMonkey\\") and action_process_image_path endswith "\\seamonkey.exe") or ((action_process_image_path startswith "C:\\Program Files\\SlimBrowser\\" or action_process_image_path startswith "C:\\Program Files (x86)\\SlimBrowser\\") and action_process_image_path endswith "\\slimbrowser.exe") or (action_process_image_path contains "\\AppData\\Roaming\\Telegram Desktop\\" and action_process_image_path endswith "\\Telegram.exe" and DestinationHostname endswith ".t.me") or (action_process_image_path contains "\\AppData\\Local\\Vivaldi\\" and action_process_image_path endswith "\\vivaldi.exe") or ((action_process_image_path startswith "C:\\Program Files\\Naver\\Naver Whale\\" or action_process_image_path startswith "C:\\Program Files (x86)\\Naver\\Naver Whale\\") and action_process_image_path endswith "\\whale.exe") or ((action_process_image_path startswith "C:\\Program Files\\Waterfox\\" or action_process_image_path startswith "C:\\Program Files (x86)\\Waterfox\\") and action_process_image_path endswith "\\Waterfox.exe") or ((action_process_image_path startswith "C:\\Program Files (x86)\\WindowsApps\\" or action_process_image_path startswith "C:\\Program Files\\WindowsApps\\") and action_process_image_path endswith "\\WhatsApp.exe" and DestinationHostname endswith "facebook.com"))))
