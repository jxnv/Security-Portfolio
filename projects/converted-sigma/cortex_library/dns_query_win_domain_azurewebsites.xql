// Title: DNS Query To AzureWebsites.NET By Non-Browser Process
// ID: e043f529-8514-4205-8ab0-7f7d2927b400
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects a DNS query by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
// Converted by: Sigma Universal SIEM/EDR CLI

dataset = xdr_data | filter ((QueryName endswith "azurewebsites.net") and not ((((action_process_image_path startswith "C:\\Program Files (x86)\\Avant Browser\\" or action_process_image_path startswith "C:\\Program Files\\Avant Browser\\") and action_process_image_path endswith "\\avant.exe") or (action_process_image_path endswith "\\brave.exe" and action_process_image_path startswith "C:\\Program Files\\BraveSoftware\\") or ((action_process_image_path = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or action_process_image_path = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or ((action_process_image_path endswith "\\MsMpEng.exe" or action_process_image_path endswith "\\MsSense.exe")) or ((action_process_image_path startswith "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") or (action_process_image_path endswith "\\WindowsApps\\MicrosoftEdge.exe") or ((action_process_image_path = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or action_process_image_path = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((action_process_image_path startswith "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" or action_process_image_path startswith "C:\\Program Files\\Microsoft\\EdgeCore\\") and (action_process_image_path endswith "\\msedge.exe" or action_process_image_path endswith "\\msedgewebview2.exe")) or ((action_process_image_path startswith "C:\\Program Files\\Falkon\\" or action_process_image_path startswith "C:\\Program Files (x86)\\Falkon\\") and action_process_image_path endswith "\\falkon.exe") or ((action_process_image_path = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or action_process_image_path = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or (action_process_image_path contains "\\AppData\\Local\\Flock\\" and action_process_image_path endswith "\\Flock.exe") or ((action_process_image_path = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or action_process_image_path = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (action_process_image_path contains "\\AppData\\Local\\Maxthon\\" and action_process_image_path endswith "\\maxthon.exe") or (action_process_image_path contains "\\AppData\\Local\\Programs\\midori-ng\\" and action_process_image_path endswith "\\Midori Next Generation.exe") or (action_process_image_path contains "\\AppData\\Local\\Programs\\Opera\\" and action_process_image_path endswith "\\opera.exe") or (action_process_image_path contains "\\AppData\\Local\\Phoebe\\" and action_process_image_path endswith "\\Phoebe.exe") or (action_process_image_path endswith "\\safari.exe") or ((action_process_image_path startswith "C:\\Program Files\\SeaMonkey\\" or action_process_image_path startswith "C:\\Program Files (x86)\\SeaMonkey\\") and action_process_image_path endswith "\\seamonkey.exe") or ((action_process_image_path startswith "C:\\Program Files\\SlimBrowser\\" or action_process_image_path startswith "C:\\Program Files (x86)\\SlimBrowser\\") and action_process_image_path endswith "\\slimbrowser.exe") or (action_process_image_path contains "\\Tor Browser\\") or (action_process_image_path contains "\\AppData\\Local\\Vivaldi\\" and action_process_image_path endswith "\\vivaldi.exe") or ((action_process_image_path startswith "C:\\Program Files\\Naver\\Naver Whale\\" or action_process_image_path startswith "C:\\Program Files (x86)\\Naver\\Naver Whale\\") and action_process_image_path endswith "\\whale.exe") or ((action_process_image_path startswith "C:\\Program Files\\Waterfox\\" or action_process_image_path startswith "C:\\Program Files (x86)\\Waterfox\\") and action_process_image_path endswith "\\Waterfox.exe"))))
