// Title: Suspicious SYSTEM User Process Creation
// ID: 2617e7ed-adb7-40ba-b0f3-8f9945fe6c09
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), David ANDRE (additional keywords)
// Date: 2021-12-20
// Tags: attack.credential-access, attack.privilege-escalation, attack.stealth, attack.t1134, attack.t1003, attack.t1027
// Description: Detects a suspicious process creation as SYSTEM user (suspicious program or command line parameter)
// Converted by: Sigma Universal SIEM/EDR CLI

dataset = xdr_data | filter ((((IntegrityLevel = "System" or IntegrityLevel = "S-1-16-16384") and (action_process_username contains "AUTHORI" or action_process_username contains "AUTORI")) and (((action_process_image_path endswith "\\calc.exe" or action_process_image_path endswith "\\cscript.exe" or action_process_image_path endswith "\\forfiles.exe" or action_process_image_path endswith "\\hh.exe" or action_process_image_path endswith "\\mshta.exe" or action_process_image_path endswith "\\ping.exe" or action_process_image_path endswith "\\wscript.exe")) or (action_process_image_command_line ~= "net\\s+user\\s+") or ((action_process_image_command_line contains " -NoP " or action_process_image_command_line contains " -W Hidden " or action_process_image_command_line contains " -decode " or action_process_image_command_line contains " /decode " or action_process_image_command_line contains " /urlcache " or action_process_image_command_line contains " -urlcache " or action_process_image_command_line contains " -e* JAB" or action_process_image_command_line contains " -e* SUVYI" or action_process_image_command_line contains " -e* SQBFAFgA" or action_process_image_command_line contains " -e* aWV4I" or action_process_image_command_line contains " -e* IAB" or action_process_image_command_line contains " -e* PAA" or action_process_image_command_line contains " -e* aQBlAHgA" or action_process_image_command_line contains "vssadmin delete shadows" or action_process_image_command_line contains "reg SAVE HKLM" or action_process_image_command_line contains " -ma " or action_process_image_command_line contains "Microsoft\\Windows\\CurrentVersion\\Run" or action_process_image_command_line contains ".downloadstring(" or action_process_image_command_line contains ".downloadfile(" or action_process_image_command_line contains " /ticket:" or action_process_image_command_line contains "dpapi::" or action_process_image_command_line contains "event::clear" or action_process_image_command_line contains "event::drop" or action_process_image_command_line contains "id::modify" or action_process_image_command_line contains "kerberos::" or action_process_image_command_line contains "lsadump::" or action_process_image_command_line contains "misc::" or action_process_image_command_line contains "privilege::" or action_process_image_command_line contains "rpc::" or action_process_image_command_line contains "sekurlsa::" or action_process_image_command_line contains "sid::" or action_process_image_command_line contains "token::" or action_process_image_command_line contains "vault::cred" or action_process_image_command_line contains "vault::list" or action_process_image_command_line contains " p::d " or action_process_image_command_line contains ";iex(" or action_process_image_command_line contains "MiniDump")))) and not (((actor_process_image_path contains ":\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\") or ((actor_process_image_path contains ":\\Program Files (x86)\\Java\\" or actor_process_image_path contains ":\\Program Files\\Java\\") and actor_process_image_path endswith "\\bin\\javaws.exe" and (action_process_image_path contains ":\\Program Files (x86)\\Java\\" or action_process_image_path contains ":\\Program Files\\Java\\") and action_process_image_path endswith "\\bin\\jp2launcher.exe" and action_process_image_command_line contains " -ma ") or ((action_process_image_command_line contains "ping" and action_process_image_command_line contains "127.0.0.1" and action_process_image_command_line contains " -n ")) or (action_process_image_path endswith "\\PING.EXE" and actor_process_command_line contains "\\DismFoDInstall.cmd"))))
