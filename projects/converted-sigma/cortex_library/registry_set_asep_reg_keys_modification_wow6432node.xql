dataset = xdr_data | filter (((TargetObject contains "\\SOFTWARE\\Wow6432Node\\Microsoft\\Windows\\CurrentVersion") and ((TargetObject contains "\\ShellServiceObjectDelayLoad" or TargetObject contains "\\Run\\" or TargetObject contains "\\RunOnce\\" or TargetObject contains "\\RunOnceEx\\" or TargetObject contains "\\RunServices\\" or TargetObject contains "\\RunServicesOnce\\" or TargetObject contains "\\Explorer\\ShellServiceObjects" or TargetObject contains "\\Explorer\\ShellIconOverlayIdentifiers" or TargetObject contains "\\Explorer\\ShellExecuteHooks" or TargetObject contains "\\Explorer\\SharedTaskScheduler" or TargetObject contains "\\Explorer\\Browser Helper Objects"))) and not ((((action_process_image_path contains "C:\\Program Files (x86)\\Microsoft\\EdgeUpdate\\Install\\{" and action_process_image_path contains "\\setup.exe")) or (Details = "(Empty)") or (Details startswith "\"C:\\ProgramData\\Package Cache\\{d21a4f20-968a-4b0c-bf04-a38da5f06e41}\\windowsdesktop-runtime-") or (action_process_image_path = "C:\\WINDOWS\\system32\\msiexec.exe" and TargetObject contains "\\SOFTWARE\\Wow6432Node\\Microsoft\\Windows\\CurrentVersion\\Run\\") or (Details = null) or (action_process_image_path startswith "C:\\Windows\\Installer\\MSI" and TargetObject contains "\\Explorer\\Browser Helper Objects") or ((action_process_image_path startswith "C:\\ProgramData\\Package Cache" or action_process_image_path startswith "C:\\Windows\\Temp\\") and (action_process_image_path contains "\\winsdksetup.exe" or action_process_image_path contains "\\windowsdesktop-runtime-" or action_process_image_path contains "\\AspNetCoreSharedFrameworkBundle-") and Details endswith " /burn.runonce") or (action_process_image_path endswith "\\VC_redist.x64.exe" and Details endswith "}\\VC_redist.x64.exe\" /burn.runonce"))) and not (((action_process_image_path endswith "\\instup.exe" and TargetObject endswith "\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\AvRepair" and Details endswith "instup.exe\" /instop:repair /wait") or (action_process_image_path endswith "\\instup.exe" and (TargetObject endswith "\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Explorer\\ShellIconOverlayIdentifiers\\00avg\\(Default)" or TargetObject endswith "\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Explorer\\ShellIconOverlayIdentifiers\\00asw\\(Default)") and (Details = "{472083B1-C522-11CF-8763-00608CC02F24}" or Details = "{472083B0-C522-11CF-8763-00608CC02F24}")) or (Details endswith "\\Avira.OE.Setup.Bundle.exe\" /burn.runonce" and action_process_image_path endswith "\\Avira.OE.Setup.Bundle.exe") or (TargetObject endswith "\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run\\Discord" and Details endswith "Discord.exe --checkInstall") or (action_process_image_path contains "\\windowsdesktop-runtime-" and (TargetObject endswith "\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\{e2d1ae32-dd1d-4ad7-a298-10e42e7840fc}" or TargetObject endswith "\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\{7037b699-7382-448c-89a7-4765961d2537}") and Details startswith "\"C:\\ProgramData\\Package Cache\\" and Details endswith ".exe\" /burn.runonce") or ((Details endswith "-A251-47B7-93E1-CDD82E34AF8B}") or (Details = "grpconv -o") or ((Details contains "C:\\Program Files" and Details contains "\\Dropbox\\Client\\Dropbox.exe" and Details contains " /systemstartup"))) or (TargetObject endswith "\\Explorer\\Browser Helper Objects\\{92EF2EAD-A7CE-4424-B0DB-499CF856608E}\\NoExplorer") or (action_process_image_path = "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\OfficeClickToRun.exe" and TargetObject contains "\\Office\\ClickToRun\\REGISTRY\\MACHINE\\Software\\Wow6432Node\\") or ((action_process_image_path = "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe" or action_process_image_path = "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe") and TargetObject contains "\\Explorer\\Browser Helper Objects\\{31D09BA0-12F5-4CCE-BE8A-2923E76605DA}\\") or ((action_process_image_path startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\" or action_process_image_path startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\") and action_process_image_path endswith "\\OfficeClickToRun.exe"))))
