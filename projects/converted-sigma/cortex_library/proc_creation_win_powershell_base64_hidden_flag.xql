// Title: Malicious Base64 Encoded PowerShell Keywords in Command Lines
// ID: f26c6093-6f14-4b12-800f-0fcb46f5ffd0
// Status: test
// Level: high
// Author: John Lambert (rule)
// Date: 2019-01-16
// Tags: attack.execution, attack.t1059.001
// Description: Detects base64 encoded strings used in hidden malicious PowerShell command lines
// Converted by: Sigma Universal SIEM/EDR CLI

dataset = xdr_data | filter (((action_process_image_command_line contains "AGkAdABzAGEAZABtAGkAbgAgAC8AdAByAGEAbgBzAGYAZQByA" or action_process_image_command_line contains "aXRzYWRtaW4gL3RyYW5zZmVy" or action_process_image_command_line contains "IAaQB0AHMAYQBkAG0AaQBuACAALwB0AHIAYQBuAHMAZgBlAHIA" or action_process_image_command_line contains "JpdHNhZG1pbiAvdHJhbnNmZX" or action_process_image_command_line contains "YgBpAHQAcwBhAGQAbQBpAG4AIAAvAHQAcgBhAG4AcwBmAGUAcg" or action_process_image_command_line contains "Yml0c2FkbWluIC90cmFuc2Zlc" or action_process_image_command_line contains "AGMAaAB1AG4AawBfAHMAaQB6AGUA" or action_process_image_command_line contains "JABjAGgAdQBuAGsAXwBzAGkAegBlA" or action_process_image_command_line contains "JGNodW5rX3Npem" or action_process_image_command_line contains "QAYwBoAHUAbgBrAF8AcwBpAHoAZQ" or action_process_image_command_line contains "RjaHVua19zaXpl" or action_process_image_command_line contains "Y2h1bmtfc2l6Z" or action_process_image_command_line contains "AE8ALgBDAG8AbQBwAHIAZQBzAHMAaQBvAG4A" or action_process_image_command_line contains "kATwAuAEMAbwBtAHAAcgBlAHMAcwBpAG8Abg" or action_process_image_command_line contains "lPLkNvbXByZXNzaW9u" or action_process_image_command_line contains "SQBPAC4AQwBvAG0AcAByAGUAcwBzAGkAbwBuA" or action_process_image_command_line contains "SU8uQ29tcHJlc3Npb2" or action_process_image_command_line contains "Ty5Db21wcmVzc2lvb" or action_process_image_command_line contains "AE8ALgBNAGUAbQBvAHIAeQBTAHQAcgBlAGEAbQ" or action_process_image_command_line contains "kATwAuAE0AZQBtAG8AcgB5AFMAdAByAGUAYQBtA" or action_process_image_command_line contains "lPLk1lbW9yeVN0cmVhb" or action_process_image_command_line contains "SQBPAC4ATQBlAG0AbwByAHkAUwB0AHIAZQBhAG0A" or action_process_image_command_line contains "SU8uTWVtb3J5U3RyZWFt" or action_process_image_command_line contains "Ty5NZW1vcnlTdHJlYW" or action_process_image_command_line contains "4ARwBlAHQAQwBoAHUAbgBrA" or action_process_image_command_line contains "5HZXRDaHVua" or action_process_image_command_line contains "AEcAZQB0AEMAaAB1AG4Aaw" or action_process_image_command_line contains "LgBHAGUAdABDAGgAdQBuAGsA" or action_process_image_command_line contains "LkdldENodW5r" or action_process_image_command_line contains "R2V0Q2h1bm" or action_process_image_command_line contains "AEgAUgBFAEEARABfAEkATgBGAE8ANgA0A" or action_process_image_command_line contains "QASABSAEUAQQBEAF8ASQBOAEYATwA2ADQA" or action_process_image_command_line contains "RIUkVBRF9JTkZPNj" or action_process_image_command_line contains "SFJFQURfSU5GTzY0" or action_process_image_command_line contains "VABIAFIARQBBAEQAXwBJAE4ARgBPADYANA" or action_process_image_command_line contains "VEhSRUFEX0lORk82N" or action_process_image_command_line contains "AHIAZQBhAHQAZQBSAGUAbQBvAHQAZQBUAGgAcgBlAGEAZA" or action_process_image_command_line contains "cmVhdGVSZW1vdGVUaHJlYW" or action_process_image_command_line contains "MAcgBlAGEAdABlAFIAZQBtAG8AdABlAFQAaAByAGUAYQBkA" or action_process_image_command_line contains "NyZWF0ZVJlbW90ZVRocmVhZ" or action_process_image_command_line contains "Q3JlYXRlUmVtb3RlVGhyZWFk" or action_process_image_command_line contains "QwByAGUAYQB0AGUAUgBlAG0AbwB0AGUAVABoAHIAZQBhAGQA" or action_process_image_command_line contains "0AZQBtAG0AbwB2AGUA" or action_process_image_command_line contains "1lbW1vdm" or action_process_image_command_line contains "AGUAbQBtAG8AdgBlA" or action_process_image_command_line contains "bQBlAG0AbQBvAHYAZQ" or action_process_image_command_line contains "bWVtbW92Z" or action_process_image_command_line contains "ZW1tb3Zl")) and (action_process_image_command_line contains " hidden ") and (((action_process_image_path endswith "\\powershell.exe" or action_process_image_path endswith "\\pwsh.exe")) or ((action_process_image_name = "PowerShell.EXE" or action_process_image_name = "pwsh.dll"))))
