// Title: Common Autorun Keys Modification
// ID: f59c3faf-50f3-464b-9f4c-1b67ab512d99
// Status: test
// Level: medium
// Author: Victor Sergeev, Daniil Yugoslavskiy, Gleb Sukhodolskiy, Timur Zinniatullin, oscd.community, Tim Shelton, frack113 (split), wagga (name)
// Date: 2019-10-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects modification of autostart extensibility point (ASEP) in registry.
// Converted by: Sigma Universal SIEM/EDR CLI

dataset = xdr_data | filter (((TargetObject contains "\\SOFTWARE\\Wow6432Node\\Microsoft\\Windows CE Services\\AutoStart" or TargetObject contains "\\Software\\Wow6432Node\\Microsoft\\Command Processor\\Autorun" or TargetObject contains "\\SOFTWARE\\Wow6432Node\\Microsoft\\Active Setup\\Installed Components" or TargetObject contains "\\SOFTWARE\\Microsoft\\Windows CE Services\\AutoStartOnDisconnect" or TargetObject contains "\\SOFTWARE\\Microsoft\\Windows CE Services\\AutoStartOnConnect" or TargetObject contains "\\SYSTEM\\Setup\\CmdLine" or TargetObject contains "\\Software\\Microsoft\\Ctf\\LangBarAddin" or TargetObject contains "\\Software\\Microsoft\\Command Processor\\Autorun" or TargetObject contains "\\SOFTWARE\\Microsoft\\Active Setup\\Installed Components" or TargetObject contains "\\SOFTWARE\\Classes\\Protocols\\Handler" or TargetObject contains "\\SOFTWARE\\Classes\\Protocols\\Filter" or TargetObject contains "\\SOFTWARE\\Classes\\Htmlfile\\Shell\\Open\\Command\\(Default)" or TargetObject contains "\\Environment\\UserInitMprLogonScript" or TargetObject contains "\\SOFTWARE\\Policies\\Microsoft\\Windows\\Control Panel\\Desktop\\Scrnsave.exe" or TargetObject contains "\\Software\\Microsoft\\Internet Explorer\\UrlSearchHooks" or TargetObject contains "\\SOFTWARE\\Microsoft\\Internet Explorer\\Desktop\\Components" or TargetObject contains "\\Software\\Classes\\Clsid\\{AB8902B4-09CA-4bb6-B78D-A8F59079A8D5}\\Inprocserver32" or TargetObject contains "\\Control Panel\\Desktop\\Scrnsave.exe")) and not (((Details = "(Empty)") or (Details = null) or (action_process_image_path = "C:\\Windows\\System32\\poqexec.exe"))) and not (((TargetObject contains "\\Software\\Microsoft\\Active Setup\\Installed Components\\{89820200-ECBD-11cf-8B85-00AA005B4383}") or (TargetObject contains "\\SOFTWARE\\Microsoft\\Active Setup\\Installed Components\\{8A69D345-D564-463c-AFF1-A69D9E530F96}") or (TargetObject contains "\\SOFTWARE\\Microsoft\\Active Setup\\Installed Components\\{9459C573-B17A-45AE-9F64-1857B5D58CEE}") or ((action_process_image_path = "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe" or action_process_image_path = "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe")) or (((TargetObject contains "\\Office\\ClickToRun\\REGISTRY\\MACHINE\\Software\\Classes\\PROTOCOLS\\Handler\\" or TargetObject contains "\\ClickToRunStore\\HKMU\\SOFTWARE\\Classes\\PROTOCOLS\\Handler\\")) or ((Details = "{314111c7-a502-11d2-bbca-00c04f8ec294}" or Details = "{3459B272-CC19-4448-86C9-DDC3B4B2FAD3}" or Details = "{42089D2D-912D-4018-9087-2B87803E93FB}" or Details = "{5504BE45-A83B-4808-900A-3A5C36E7F77A}" or Details = "{807583E5-5146-11D5-A672-00B0D022E945}"))) or ((action_process_image_path startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\" or action_process_image_path startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\") and action_process_image_path endswith "\\OfficeClickToRun.exe"))))
