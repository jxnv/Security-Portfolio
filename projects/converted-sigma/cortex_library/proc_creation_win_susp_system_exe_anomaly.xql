// Title: System File Execution Location Anomaly
// ID: e4a6b256-3e47-40fc-89d2-7a477edd6915
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Patrick Bareiss, Anton Kutepov, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2017-11-27
// Tags: attack.stealth, attack.t1036
// Description: Detects the execution of a Windows system binary that is usually located in the system folder from an uncommon location.
// Converted by: Sigma Universal SIEM/EDR CLI

dataset = xdr_data | filter (((action_process_image_path endswith "\\atbroker.exe" or action_process_image_path endswith "\\audiodg.exe" or action_process_image_path endswith "\\bcdedit.exe" or action_process_image_path endswith "\\bitsadmin.exe" or action_process_image_path endswith "\\certreq.exe" or action_process_image_path endswith "\\certutil.exe" or action_process_image_path endswith "\\cmstp.exe" or action_process_image_path endswith "\\conhost.exe" or action_process_image_path endswith "\\consent.exe" or action_process_image_path endswith "\\cscript.exe" or action_process_image_path endswith "\\csrss.exe" or action_process_image_path endswith "\\dashost.exe" or action_process_image_path endswith "\\defrag.exe" or action_process_image_path endswith "\\dfrgui.exe" or action_process_image_path endswith "\\dism.exe" or action_process_image_path endswith "\\dllhost.exe" or action_process_image_path endswith "\\dllhst3g.exe" or action_process_image_path endswith "\\dwm.exe" or action_process_image_path endswith "\\eventvwr.exe" or action_process_image_path endswith "\\fsquirt.exe" or action_process_image_path endswith "\\finger.exe" or action_process_image_path endswith "\\logonui.exe" or action_process_image_path endswith "\\LsaIso.exe" or action_process_image_path endswith "\\lsass.exe" or action_process_image_path endswith "\\lsm.exe" or action_process_image_path endswith "\\msiexec.exe" or action_process_image_path endswith "\\ntoskrnl.exe" or action_process_image_path endswith "\\powershell_ise.exe" or action_process_image_path endswith "\\powershell.exe" or action_process_image_path endswith "\\pwsh.exe" or action_process_image_path endswith "\\regsvr32.exe" or action_process_image_path endswith "\\rundll32.exe" or action_process_image_path endswith "\\runonce.exe" or action_process_image_path endswith "\\RuntimeBroker.exe" or action_process_image_path endswith "\\schtasks.exe" or action_process_image_path endswith "\\services.exe" or action_process_image_path endswith "\\sihost.exe" or action_process_image_path endswith "\\smartscreen.exe" or action_process_image_path endswith "\\smss.exe" or action_process_image_path endswith "\\spoolsv.exe" or action_process_image_path endswith "\\svchost.exe" or action_process_image_path endswith "\\taskhost.exe" or action_process_image_path endswith "\\taskhostw.exe" or action_process_image_path endswith "\\Taskmgr.exe" or action_process_image_path endswith "\\userinit.exe" or action_process_image_path endswith "\\werfault.exe" or action_process_image_path endswith "\\werfaultsecure.exe" or action_process_image_path endswith "\\wininit.exe" or action_process_image_path endswith "\\winlogon.exe" or action_process_image_path endswith "\\winver.exe" or action_process_image_path endswith "\\wlanext.exe" or action_process_image_path endswith "\\wmic.exe" or action_process_image_path endswith "\\wscript.exe" or action_process_image_path endswith "\\wsl.exe" or action_process_image_path endswith "\\wsmprovhost.exe")) and not ((((action_process_image_path startswith "C:\\$WINDOWS.~BT\\" or action_process_image_path startswith "C:\\$WinREAgent\\" or action_process_image_path startswith "C:\\Windows\\SoftwareDistribution\\" or action_process_image_path startswith "C:\\Windows\\System32\\" or action_process_image_path startswith "C:\\Windows\\SystemTemp\\" or action_process_image_path startswith "C:\\Windows\\SysWOW64\\" or action_process_image_path startswith "C:\\Windows\\uus\\" or action_process_image_path startswith "C:\\Windows\\WinSxS\\")) or ((action_process_image_path contains "C:\\Program Files\\PowerShell\\7\\" or action_process_image_path contains "C:\\Program Files\\PowerShell\\7-preview\\" or action_process_image_path contains "C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview" or action_process_image_path contains "\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview") and action_process_image_path endswith "\\pwsh.exe") or (action_process_image_path startswith "C:\\Users\\" and action_process_image_path contains "\\AppData\\Local\\Microsoft\\WindowsApps\\" and action_process_image_path endswith "\\wsl.exe") or ((action_process_image_path startswith "C:\\Program Files\\WindowsApps\\MicrosoftCorporationII.WindowsSubsystemForLinux" or action_process_image_path startswith "C:\\Program Files\\WSL\\") and action_process_image_path endswith "\\wsl.exe"))) and not ((action_process_image_path contains "\\SystemRoot\\System32\\")))
