// Title: PowerShell Core DLL Loaded By Non PowerShell Process
// ID: 092bc4b9-3d1d-43b4-a6b4-8c8acd83522f
// Status: test
// Level: medium
// Author: Tom Kern, oscd.community, Natalia Shornikova, Tim Shelton, Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2019-11-14
// Tags: attack.t1059.001, attack.execution
// Description: Detects loading of essential DLLs used by PowerShell by non-PowerShell process.
// Detects behavior similar to meterpreter's "load powershell" extension.
// Converted by: Sigma Universal SIEM/EDR CLI

dataset = xdr_data | filter (((Description = "System.Management.Automation") or (action_process_image_name = "System.Management.Automation.dll") or ((ImageLoaded endswith "\\System.Management.Automation.dll" or ImageLoaded endswith "\\System.Management.Automation.ni.dll"))) and not ((((action_process_image_path startswith "C:\\Windows\\Microsoft.NET\\Framework\\" or action_process_image_path startswith "C:\\Windows\\Microsoft.NET\\FrameworkArm\\" or action_process_image_path startswith "C:\\Windows\\Microsoft.NET\\FrameworkArm64\\" or action_process_image_path startswith "C:\\Windows\\Microsoft.NET\\Framework64\\") and action_process_image_path endswith "\\mscorsvw.exe") or ((action_process_image_path = "C:\\Windows\\System32\\dsac.exe" or action_process_image_path = "C:\\WINDOWS\\System32\\RemoteFXvGPUDisablement.exe" or action_process_image_path = "C:\\Windows\\System32\\runscripthelper.exe" or action_process_image_path = "C:\\WINDOWS\\System32\\sdiagnhost.exe" or action_process_image_path = "C:\\Windows\\System32\\ServerManager.exe" or action_process_image_path = "C:\\Windows\\System32\\SyncAppvPublishingServer.exe" or action_process_image_path = "C:\\Windows\\System32\\winrshost.exe" or action_process_image_path = "C:\\Windows\\System32\\wsmprovhost.exe" or action_process_image_path = "C:\\Windows\\SysWOW64\\winrshost.exe" or action_process_image_path = "C:\\Windows\\SysWOW64\\wsmprovhost.exe")) or ((action_process_image_path = "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" or action_process_image_path = "C:\\Program Files\\PowerShell\\7\\pwsh.exe" or action_process_image_path = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or action_process_image_path = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" or action_process_image_path = "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or action_process_image_path = "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")) or ((action_process_image_path contains "C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview" or action_process_image_path contains "\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview") and action_process_image_path endswith "\\pwsh.exe"))) and not (((action_process_image_path = null) or (action_process_image_path startswith "C:\\ProgramData\\chocolatey\\choco.exe") or (action_process_image_path endswith "\\Citrix\\ConfigSync\\ConfigSyncRun.exe") or (action_process_image_path startswith "C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_" and action_process_image_path endswith "\\GetHelp.exe") or (action_process_image_path startswith "C:\\Windows\\Temp\\asgard2-agent\\" and (action_process_image_path endswith "\\thor64.exe" or action_process_image_path endswith "\\thor.exe")) or ((action_process_image_path startswith "C:\\Program Files (x86)\\Microsoft SQL Server Management Studio" or action_process_image_path startswith "C:\\Program Files\\Microsoft SQL Server Management Studio") and action_process_image_path endswith "\\IDE\\Ssms.exe") or ((action_process_image_path startswith "C:\\Program Files (x86)\\Microsoft SQL Server\\" or action_process_image_path startswith "C:\\Program Files\\Microsoft SQL Server\\") and action_process_image_path endswith "\\Tools\\Binn\\SQLPS.exe") or ((action_process_image_path startswith "C:\\Program Files (x86)\\Microsoft Visual Studio\\" or action_process_image_path startswith "C:\\Program Files\\Microsoft Visual Studio\\")))))
