// Title: Network Connection Initiated To AzureWebsites.NET By Non-Browser Process
// ID: 5c80b618-0dbb-46e6-acbb-03d90bcb6d83
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.command-and-control, attack.t1102, attack.t1102.001
// Description: Detects an initiated network connection by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
// Converted by: Sigma Universal SIEM/EDR CLI

dataset = xdr_data | filter ((Initiated = "true" and DestinationHostname endswith "azurewebsites.net") and not ((((action_process_image_path startswith "C:\\Program Files (x86)\\Avant Browser\\" or action_process_image_path startswith "C:\\Program Files\\Avant Browser\\") and action_process_image_path endswith "\\avant.exe") or (action_process_image_path startswith "C:\\Program Files\\BraveSoftware\\" and action_process_image_path endswith "\\brave.exe") or ((action_process_image_path = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or action_process_image_path = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or (action_process_image_path startswith "C:\\Users\\" and action_process_image_path endswith "\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe") or ((action_process_image_path contains "C:\\Program Files\\Windows Defender Advanced Threat Protection\\" or action_process_image_path contains "C:\\Program Files\\Windows Defender\\" or action_process_image_path contains "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\") and (action_process_image_path endswith "\\MsMpEng.exe" or action_process_image_path endswith "\\MsSense.exe")) or (action_process_image_path contains "\\AppData\\Local\\Discord\\" and action_process_image_path endswith "\\Discord.exe") or ((action_process_image_path startswith "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") or (action_process_image_path endswith "\\WindowsApps\\MicrosoftEdge.exe") or ((action_process_image_path = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or action_process_image_path = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((action_process_image_path startswith "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" or action_process_image_path startswith "C:\\Program Files\\Microsoft\\EdgeCore\\") and (action_process_image_path endswith "\\msedge.exe" or action_process_image_path endswith "\\msedgewebview2.exe")) or (action_process_image_path = "") or ((action_process_image_path startswith "C:\\Program Files\\Falkon\\" or action_process_image_path startswith "C:\\Program Files (x86)\\Falkon\\") and action_process_image_path endswith "\\falkon.exe") or ((action_process_image_path = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or action_process_image_path = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or (action_process_image_path startswith "C:\\Users\\" and action_process_image_path endswith "\\AppData\\Local\\Mozilla Firefox\\firefox.exe") or (action_process_image_path contains "\\AppData\\Local\\Flock\\" and action_process_image_path endswith "\\Flock.exe") or ((action_process_image_path = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or action_process_image_path = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (action_process_image_path contains "\\AppData\\Local\\Maxthon\\" and action_process_image_path endswith "\\maxthon.exe") or (action_process_image_path = null) or (action_process_image_path contains "\\AppData\\Local\\Programs\\Opera\\" and action_process_image_path endswith "\\opera.exe") or (action_process_image_path contains "\\AppData\\Local\\Phoebe\\" and action_process_image_path endswith "\\Phoebe.exe") or ((action_process_image_path endswith "C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe" or action_process_image_path endswith "C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe")) or ((action_process_image_path startswith "C:\\Program Files (x86)\\QtWeb\\" or action_process_image_path startswith "C:\\Program Files\\QtWeb\\") and action_process_image_path endswith "\\QtWeb.exe") or ((action_process_image_path contains "C:\\Program Files (x86)\\Safari\\" or action_process_image_path contains "C:\\Program Files\\Safari\\") and action_process_image_path endswith "\\safari.exe") or ((action_process_image_path startswith "C:\\Program Files\\SeaMonkey\\" or action_process_image_path startswith "C:\\Program Files (x86)\\SeaMonkey\\") and action_process_image_path endswith "\\seamonkey.exe") or ((action_process_image_path startswith "C:\\Program Files\\SlimBrowser\\" or action_process_image_path startswith "C:\\Program Files (x86)\\SlimBrowser\\") and action_process_image_path endswith "\\slimbrowser.exe") or (action_process_image_path contains "\\AppData\\Local\\Vivaldi\\" and action_process_image_path endswith "\\vivaldi.exe") or ((action_process_image_path startswith "C:\\Program Files\\Naver\\Naver Whale\\" or action_process_image_path startswith "C:\\Program Files (x86)\\Naver\\Naver Whale\\") and action_process_image_path endswith "\\whale.exe") or ((action_process_image_path startswith "C:\\Program Files\\Waterfox\\" or action_process_image_path startswith "C:\\Program Files (x86)\\Waterfox\\") and action_process_image_path endswith "\\Waterfox.exe"))))
