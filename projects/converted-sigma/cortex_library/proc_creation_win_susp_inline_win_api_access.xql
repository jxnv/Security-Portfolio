// Title: Potential WinAPI Calls Via CommandLine
// ID: ba3f5c1b-6272-4119-9dbd-0bc8d21c2702
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-06
// Tags: attack.execution, attack.t1106
// Description: Detects the use of WinAPI Functions via the commandline. As seen used by threat actors via the tool winapiexec
// Converted by: Sigma Universal SIEM/EDR CLI

dataset = xdr_data | filter (((action_process_image_command_line contains "AddSecurityPackage" or action_process_image_command_line contains "AdjustTokenPrivileges" or action_process_image_command_line contains "Advapi32" or action_process_image_command_line contains "CloseHandle" or action_process_image_command_line contains "CreateProcessWithToken" or action_process_image_command_line contains "CreatePseudoConsole" or action_process_image_command_line contains "CreateRemoteThread" or action_process_image_command_line contains "CreateThread" or action_process_image_command_line contains "CreateUserThread" or action_process_image_command_line contains "DangerousGetHandle" or action_process_image_command_line contains "DuplicateTokenEx" or action_process_image_command_line contains "EnumerateSecurityPackages" or action_process_image_command_line contains "FreeHGlobal" or action_process_image_command_line contains "FreeLibrary" or action_process_image_command_line contains "GetDelegateForFunctionPointer" or action_process_image_command_line contains "GetLogonSessionData" or action_process_image_command_line contains "GetModuleHandle" or action_process_image_command_line contains "GetProcAddress" or action_process_image_command_line contains "GetProcessHandle" or action_process_image_command_line contains "GetTokenInformation" or action_process_image_command_line contains "ImpersonateLoggedOnUser" or action_process_image_command_line contains "kernel32" or action_process_image_command_line contains "LoadLibrary" or action_process_image_command_line contains "memcpy" or action_process_image_command_line contains "MiniDumpWriteDump" or action_process_image_command_line contains "ntdll" or action_process_image_command_line contains "OpenDesktop" or action_process_image_command_line contains "OpenProcess" or action_process_image_command_line contains "OpenProcessToken" or action_process_image_command_line contains "OpenThreadToken" or action_process_image_command_line contains "OpenWindowStation" or action_process_image_command_line contains "PtrToString" or action_process_image_command_line contains "QueueUserApc" or action_process_image_command_line contains "ReadProcessMemory" or action_process_image_command_line contains "RevertToSelf" or action_process_image_command_line contains "RtlCreateUserThread" or action_process_image_command_line contains "secur32" or action_process_image_command_line contains "SetThreadToken" or action_process_image_command_line contains "VirtualAlloc" or action_process_image_command_line contains "VirtualFree" or action_process_image_command_line contains "VirtualProtect" or action_process_image_command_line contains "WaitForSingleObject" or action_process_image_command_line contains "WriteInt32" or action_process_image_command_line contains "WriteProcessMemory" or action_process_image_command_line contains "ZeroFreeGlobalAllocUnicode")) and not (((actor_process_image_path endswith "\\CompatTelRunner.exe" and (action_process_image_command_line contains "FreeHGlobal" or action_process_image_command_line contains "PtrToString" or action_process_image_command_line contains "kernel32" or action_process_image_command_line contains "CloseHandle")) or (action_process_image_path endswith "\\MpCmdRun.exe" and action_process_image_command_line contains "GetLoadLibraryWAddress32"))))
