// Title: HackTool - LaZagne Execution
// ID: c2b86e67-b880-4eec-b045-50bc98ef4844
// Status: experimental
// Level: medium
// Author: Nasreddine Bencherchali, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.credential-access
// Description: Detects the execution of the LaZagne. A utility used to retrieve multiple types of passwords stored on a local computer.
// LaZagne has been leveraged multiple times by threat actors in order to dump credentials.
// Converted by: Sigma Universal SIEM/EDR CLI

dataset = xdr_data | filter ((((action_process_image_path contains ":\\PerfLogs\\" or action_process_image_path contains ":\\ProgramData\\" or action_process_image_path contains ":\\Temp\\" or action_process_image_path contains ":\\Tmp\\" or action_process_image_path contains ":\\Users\\Public\\" or action_process_image_path contains ":\\Windows\\Temp\\" or action_process_image_path contains "\\$Recycle.bin" or action_process_image_path contains "\\AppData\\" or action_process_image_path contains "\\Desktop\\" or action_process_image_path contains "\\Downloads\\" or action_process_image_path contains "\\Favorites\\" or action_process_image_path contains "\\Links\\" or action_process_image_path contains "\\Music\\" or action_process_image_path contains "\\Photos\\" or action_process_image_path contains "\\Pictures\\" or action_process_image_path contains "\\Saved Games\\" or action_process_image_path contains "\\Searches\\" or action_process_image_path contains "\\Users\\Contacts\\" or action_process_image_path contains "\\Users\\Default\\" or action_process_image_path contains "\\Users\\Searches\\" or action_process_image_path contains "\\Videos\\" or action_process_image_path contains "\\Windows\\addins\\" or action_process_image_path contains "\\Windows\\Fonts\\" or action_process_image_path contains "\\Windows\\IME\\") and (action_process_image_command_line endswith ".exe all" or action_process_image_command_line endswith ".exe browsers" or action_process_image_command_line endswith ".exe chats" or action_process_image_command_line endswith ".exe databases" or action_process_image_command_line endswith ".exe games" or action_process_image_command_line endswith ".exe git" or action_process_image_command_line endswith ".exe mails" or action_process_image_command_line endswith ".exe maven" or action_process_image_command_line endswith ".exe memory" or action_process_image_command_line endswith ".exe multimedia" or action_process_image_command_line endswith ".exe sysadmin" or action_process_image_command_line endswith ".exe unused" or action_process_image_command_line endswith ".exe wifi" or action_process_image_command_line endswith ".exe windows")) or (action_process_image_path endswith "\\lazagne.exe")) or (((action_process_image_command_line contains " all " or action_process_image_command_line contains " browsers " or action_process_image_command_line contains " chats " or action_process_image_command_line contains " databases " or action_process_image_command_line contains " games " or action_process_image_command_line contains " mails " or action_process_image_command_line contains " maven " or action_process_image_command_line contains " memory " or action_process_image_command_line contains " multimedia " or action_process_image_command_line contains " php " or action_process_image_command_line contains " svn " or action_process_image_command_line contains " sysadmin " or action_process_image_command_line contains " unused " or action_process_image_command_line contains " wifi ")) and ((action_process_image_command_line contains "-1Password" or action_process_image_command_line contains "-apachedirectorystudio" or action_process_image_command_line contains "-autologon" or action_process_image_command_line contains "-ChromiumBased" or action_process_image_command_line contains "-coreftp" or action_process_image_command_line contains "-credfiles" or action_process_image_command_line contains "-credman" or action_process_image_command_line contains "-cyberduck" or action_process_image_command_line contains "-dbvis" or action_process_image_command_line contains "-EyeCon" or action_process_image_command_line contains "-filezilla" or action_process_image_command_line contains "-filezillaserver" or action_process_image_command_line contains "-ftpnavigator" or action_process_image_command_line contains "-galconfusion" or action_process_image_command_line contains "-gitforwindows" or action_process_image_command_line contains "-hashdump" or action_process_image_command_line contains "-iisapppool" or action_process_image_command_line contains "-IISCentralCertP" or action_process_image_command_line contains "-kalypsomedia" or action_process_image_command_line contains "-keepass" or action_process_image_command_line contains "-keepassconfig" or action_process_image_command_line contains "-lsa_secrets" or action_process_image_command_line contains "-mavenrepositories" or action_process_image_command_line contains "-memory_dump" or action_process_image_command_line contains "-Mozilla" or action_process_image_command_line contains "-mRemoteNG" or action_process_image_command_line contains "-mscache" or action_process_image_command_line contains "-opensshforwindows" or action_process_image_command_line contains "-openvpn" or action_process_image_command_line contains "-outlook" or action_process_image_command_line contains "-pidgin" or action_process_image_command_line contains "-postgresql" or action_process_image_command_line contains "-psi-im" or action_process_image_command_line contains "-puttycm" or action_process_image_command_line contains "-pypykatz" or action_process_image_command_line contains "-Rclone" or action_process_image_command_line contains "-rdpmanager" or action_process_image_command_line contains "-robomongo" or action_process_image_command_line contains "-roguestale" or action_process_image_command_line contains "-skype" or action_process_image_command_line contains "-SQLDeveloper" or action_process_image_command_line contains "-squirrel" or action_process_image_command_line contains "-tortoise" or action_process_image_command_line contains "-turba" or action_process_image_command_line contains "-UCBrowser" or action_process_image_command_line contains "-unattended" or action_process_image_command_line contains "-vault" or action_process_image_command_line contains "-vaultfiles" or action_process_image_command_line contains "-vnc" or action_process_image_command_line contains "-winscp"))))
