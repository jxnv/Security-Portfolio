// Title: Suspicious Double Extension File Execution
// ID: 1cdd9a09-06c9-4769-99ff-626e2b3991b8
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems), @blu3_team (idea), Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-06-26
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects suspicious use of an .exe extension after a non-executable file extension like .pdf.exe, a set of spaces or underlines to cloak the executable file in spear phishing campaigns
// Converted by: Sigma Universal SIEM/EDR CLI

dataset = xdr_data | filter ((action_process_image_path endswith "      .exe" or action_process_image_path endswith "______.exe" or action_process_image_path endswith ".doc.exe" or action_process_image_path endswith ".doc.js" or action_process_image_path endswith ".docx.exe" or action_process_image_path endswith ".docx.js" or action_process_image_path endswith ".gif.exe" or action_process_image_path endswith ".jpeg.exe" or action_process_image_path endswith ".jpg.exe" or action_process_image_path endswith ".mkv.exe" or action_process_image_path endswith ".mov.exe" or action_process_image_path endswith ".mp3.exe" or action_process_image_path endswith ".mp4.exe" or action_process_image_path endswith ".pdf.exe" or action_process_image_path endswith ".pdf.js" or action_process_image_path endswith ".png.exe" or action_process_image_path endswith ".ppt.exe" or action_process_image_path endswith ".ppt.js" or action_process_image_path endswith ".pptx.exe" or action_process_image_path endswith ".pptx.js" or action_process_image_path endswith ".rtf.exe" or action_process_image_path endswith ".rtf.js" or action_process_image_path endswith ".svg.exe" or action_process_image_path endswith ".txt.exe" or action_process_image_path endswith ".txt.js" or action_process_image_path endswith ".xls.exe" or action_process_image_path endswith ".xls.js" or action_process_image_path endswith ".xlsx.exe" or action_process_image_path endswith ".xlsx.js" or action_process_image_path endswith "⠀⠀⠀⠀⠀⠀.exe") and (action_process_image_command_line contains "      .exe" or action_process_image_command_line contains "______.exe" or action_process_image_command_line contains ".doc.exe" or action_process_image_command_line contains ".doc.js" or action_process_image_command_line contains ".docx.exe" or action_process_image_command_line contains ".docx.js" or action_process_image_command_line contains ".gif.exe" or action_process_image_command_line contains ".jpeg.exe" or action_process_image_command_line contains ".jpg.exe" or action_process_image_command_line contains ".mkv.exe" or action_process_image_command_line contains ".mov.exe" or action_process_image_command_line contains ".mp3.exe" or action_process_image_command_line contains ".mp4.exe" or action_process_image_command_line contains ".pdf.exe" or action_process_image_command_line contains ".pdf.js" or action_process_image_command_line contains ".png.exe" or action_process_image_command_line contains ".ppt.exe" or action_process_image_command_line contains ".ppt.js" or action_process_image_command_line contains ".pptx.exe" or action_process_image_command_line contains ".pptx.js" or action_process_image_command_line contains ".rtf.exe" or action_process_image_command_line contains ".rtf.js" or action_process_image_command_line contains ".svg.exe" or action_process_image_command_line contains ".txt.exe" or action_process_image_command_line contains ".txt.js" or action_process_image_command_line contains ".xls.exe" or action_process_image_command_line contains ".xls.js" or action_process_image_command_line contains ".xlsx.exe" or action_process_image_command_line contains ".xlsx.js" or action_process_image_command_line contains "⠀⠀⠀⠀⠀⠀.exe"))
