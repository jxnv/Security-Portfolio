// Title: Files With System Process Name In Unsuspected Locations
// ID: d5866ddf-ce8f-4aea-b28e-d96485a20d3d
// Status: test
// Level: medium
// Author: Sander Wiebing, Tim Shelton, Nasreddine Bencherchali (Nextron Systems)
// Date: 2020-05-26
// Tags: attack.stealth, attack.t1036.005
// Description: Detects the creation of an executable with a system process name in folders other than the system ones (System32, SysWOW64, etc.).
// It is highly recommended to perform an initial baseline before using this rule in production.
// Converted by: Sigma Universal SIEM/EDR CLI

dataset = xdr_data | filter (((action_file_path endswith "\\AtBroker.exe" or action_file_path endswith "\\audiodg.exe" or action_file_path endswith "\\backgroundTaskHost.exe" or action_file_path endswith "\\bcdedit.exe" or action_file_path endswith "\\bitsadmin.exe" or action_file_path endswith "\\cmdl32.exe" or action_file_path endswith "\\cmstp.exe" or action_file_path endswith "\\conhost.exe" or action_file_path endswith "\\csrss.exe" or action_file_path endswith "\\dasHost.exe" or action_file_path endswith "\\dfrgui.exe" or action_file_path endswith "\\dllhost.exe" or action_file_path endswith "\\dwm.exe" or action_file_path endswith "\\eventcreate.exe" or action_file_path endswith "\\eventvwr.exe" or action_file_path endswith "\\explorer.exe" or action_file_path endswith "\\extrac32.exe" or action_file_path endswith "\\fontdrvhost.exe" or action_file_path endswith "\\fsquirt.exe" or action_file_path endswith "\\ipconfig.exe" or action_file_path endswith "\\iscsicli.exe" or action_file_path endswith "\\iscsicpl.exe" or action_file_path endswith "\\logman.exe" or action_file_path endswith "\\LogonUI.exe" or action_file_path endswith "\\LsaIso.exe" or action_file_path endswith "\\lsass.exe" or action_file_path endswith "\\lsm.exe" or action_file_path endswith "\\msiexec.exe" or action_file_path endswith "\\msinfo32.exe" or action_file_path endswith "\\mstsc.exe" or action_file_path endswith "\\nbtstat.exe" or action_file_path endswith "\\odbcconf.exe" or action_file_path endswith "\\powershell.exe" or action_file_path endswith "\\pwsh.exe" or action_file_path endswith "\\regini.exe" or action_file_path endswith "\\regsvr32.exe" or action_file_path endswith "\\rundll32.exe" or action_file_path endswith "\\RuntimeBroker.exe" or action_file_path endswith "\\schtasks.exe" or action_file_path endswith "\\SearchFilterHost.exe" or action_file_path endswith "\\SearchIndexer.exe" or action_file_path endswith "\\SearchProtocolHost.exe" or action_file_path endswith "\\SecurityHealthService.exe" or action_file_path endswith "\\SecurityHealthSystray.exe" or action_file_path endswith "\\services.exe" or action_file_path endswith "\\ShellAppRuntime.exe" or action_file_path endswith "\\sihost.exe" or action_file_path endswith "\\smartscreen.exe" or action_file_path endswith "\\smss.exe" or action_file_path endswith "\\spoolsv.exe" or action_file_path endswith "\\svchost.exe" or action_file_path endswith "\\SystemSettingsBroker.exe" or action_file_path endswith "\\taskhost.exe" or action_file_path endswith "\\taskhostw.exe" or action_file_path endswith "\\Taskmgr.exe" or action_file_path endswith "\\TiWorker.exe" or action_file_path endswith "\\vssadmin.exe" or action_file_path endswith "\\w32tm.exe" or action_file_path endswith "\\WerFault.exe" or action_file_path endswith "\\WerFaultSecure.exe" or action_file_path endswith "\\wermgr.exe" or action_file_path endswith "\\wevtutil.exe" or action_file_path endswith "\\wininit.exe" or action_file_path endswith "\\winlogon.exe" or action_file_path endswith "\\winrshost.exe" or action_file_path endswith "\\WinRTNetMUAHostServer.exe" or action_file_path endswith "\\wlanext.exe" or action_file_path endswith "\\wlrmdr.exe" or action_file_path endswith "\\WmiPrvSE.exe" or action_file_path endswith "\\wslhost.exe" or action_file_path endswith "\\WSReset.exe" or action_file_path endswith "\\WUDFHost.exe" or action_file_path endswith "\\WWAHost.exe")) and not (((action_file_path endswith "C:\\Windows\\explorer.exe") or ((action_file_path contains "C:\\$WINDOWS.~BT\\" or action_file_path contains "C:\\$WinREAgent\\" or action_file_path contains "C:\\Windows\\SoftwareDistribution\\" or action_file_path contains "C:\\Windows\\System32\\" or action_file_path contains "C:\\Windows\\SysWOW64\\" or action_file_path contains "C:\\Windows\\WinSxS\\" or action_file_path contains "C:\\Windows\\uus\\")) or (action_file_path contains "C:\\Windows\\System32\\SecurityHealth\\" and action_file_path endswith "\\SecurityHealthSystray.exe" and action_process_image_path endswith "\\SecurityHealthSetup.exe") or ((action_process_image_path endswith "C:\\WINDOWS\\system32\\msiexec.exe" or action_process_image_path endswith "C:\\WINDOWS\\SysWOW64\\msiexec.exe") and (action_file_path startswith "C:\\Program Files\\PowerShell\\7\\pwsh.exe" or action_file_path startswith "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" or action_file_path startswith "C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview\\")) or ((action_process_image_path endswith "C:\\Windows\\system32\\svchost.exe" or action_process_image_path endswith "C:\\Windows\\SysWOW64\\svchost.exe") and (action_file_path contains "C:\\Program Files\\WindowsApps\\" or action_file_path contains "C:\\Program Files (x86)\\WindowsApps\\" or action_file_path contains "\\AppData\\Local\\Microsoft\\WindowsApps\\")) or ((action_process_image_path endswith "\\TiWorker.exe" or action_process_image_path endswith "\\wuaucltcore.exe") and action_file_path startswith "C:\\Windows\\Temp\\") or ((action_process_image_path = "C:\\Windows\\System32\\wuauclt.exe" or action_process_image_path = "C:\\Windows\\SysWOW64\\wuauclt.exe" or action_process_image_path = "C:\\Windows\\UUS\\arm64\\wuaucltcore.exe")))) and not (((action_file_path = "C:\\Program Files\\WSL\\wslhost.exe") or ((action_file_path contains "C:\\Program Files\\WindowsApps\\MicrosoftCorporationII.WindowsSubsystemForLinux_" and action_file_path contains "\\wslhost.exe")) or ((action_file_path contains "C:\\Users\\" and action_file_path contains "\\AppData\\Local\\Microsoft\\WindowsApps\\" and action_file_path contains "\\wslhost.exe")))))
