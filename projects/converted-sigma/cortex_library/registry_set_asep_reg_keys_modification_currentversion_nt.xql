// Title: CurrentVersion NT Autorun Keys Modification
// ID: cbf93e5d-ca6c-4722-8bea-e9119007c248
// Status: test
// Level: medium
// Author: Victor Sergeev, Daniil Yugoslavskiy, Gleb Sukhodolskiy, Timur Zinniatullin, oscd.community, Tim Shelton, frack113 (split)
// Date: 2019-10-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects modification of autostart extensibility point (ASEP) in registry.
// Converted by: Sigma Universal SIEM/EDR CLI

dataset = xdr_data | filter ((((TargetObject contains "\\Winlogon\\VmApplet" or TargetObject contains "\\Winlogon\\Userinit" or TargetObject contains "\\Winlogon\\Taskman" or TargetObject contains "\\Winlogon\\Shell" or TargetObject contains "\\Winlogon\\GpExtensions" or TargetObject contains "\\Winlogon\\AppSetup" or TargetObject contains "\\Winlogon\\AlternateShells\\AvailableShells" or TargetObject contains "\\Windows\\IconServiceLib" or TargetObject contains "\\Windows\\Appinit_Dlls" or TargetObject contains "\\Image File Execution Options" or TargetObject contains "\\Font Drivers" or TargetObject contains "\\Drivers32" or TargetObject contains "\\Windows\\Run" or TargetObject contains "\\Windows\\Load")) and (TargetObject contains "\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion")) and not (((Details = "(Empty)") or (TargetObject contains "\\Image File Execution Options\\" and (TargetObject endswith "\\DisableExceptionChainValidation" or TargetObject endswith "\\MitigationOptions")) or (Details = null) or (action_process_image_path = "C:\\Windows\\System32\\poqexec.exe") or (action_process_image_path = "C:\\Windows\\System32\\RuntimeBroker.exe" and TargetObject contains "\\runtimebroker.exe\\Microsoft.Windows.ShellExperienceHost") or (action_process_image_path = "C:\\Windows\\system32\\svchost.exe" and (TargetObject contains "\\Winlogon\\GPExtensions\\{827D319E-6EAC-11D2-A4EA-00C04F79F83A}\\PreviousPolicyAreas" or TargetObject contains "\\Winlogon\\GPExtensions\\{827D319E-6EAC-11D2-A4EA-00C04F79F83A}\\MaxNoGPOListChangesInterval") and (Details = "DWORD (0x00000001)" or Details = "DWORD (0x00000009)" or Details = "DWORD (0x000003c0)")))) and not ((((action_process_image_path startswith "C:\\Program Files (x86)\\Avira\\Antivirus\\avguard.exe" or action_process_image_path startswith "C:\\Program Files\\Avira\\Antivirus\\avguard.exe") and TargetObject contains "SOFTWARE\\WOW6432Node\\Avira\\Antivirus\\Overwrite_Keys\\HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon\\" and (TargetObject endswith "\\userinit\\UseAsDefault" or TargetObject endswith "\\shell\\UseAsDefault") and (Details = "explorer.exe" or Details = "C:\\Windows\\system32\\userinit.exe,")) or (action_process_image_path startswith "C:\\Program Files (x86)\\Microsoft\\Temp\\" and action_process_image_path endswith "\\MicrosoftEdgeUpdate.exe") or (((TargetObject contains "\\ClickToRunStore\\HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\" or TargetObject contains "\\ClickToRun\\REGISTRY\\MACHINE\\Software\\Microsoft\\Windows NT\\CurrentVersion\\")) or ((action_process_image_path = "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe" or action_process_image_path = "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe"))) or (action_process_image_path startswith "C:\\Windows\\Microsoft.NET\\Framework" and action_process_image_path endswith "\\ngen.exe") or ((action_process_image_path startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\" or action_process_image_path startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\") and action_process_image_path endswith "\\OfficeClickToRun.exe") or (action_process_image_path endswith "\\AppData\\Local\\Microsoft\\OneDrive\\StandaloneUpdater\\OneDriveSetup.exe" and TargetObject endswith "\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\Delete Cached Update Binary" and Details startswith "C:\\Windows\\system32\\cmd.exe /q /c del /q \"C:\\Users\\" and Details endswith "\\AppData\\Local\\Microsoft\\OneDrive\\Update\\OneDriveSetup.exe\""))))
