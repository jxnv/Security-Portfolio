// Title: Potential Tampering With Security Products Via WMIC
// ID: 847d5ff3-8a31-4737-a970-aeae8fe21765
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-01-30
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects uninstallation or termination of security products using the WMIC utility
// Converted by: Sigma Universal SIEM/EDR CLI

dataset = xdr_data | filter ((((action_process_image_command_line contains "wmic" and action_process_image_command_line contains "product " and action_process_image_command_line contains "uninstall") and (action_process_image_command_line contains "/nointeractive" or action_process_image_command_line contains "-nointeractive")) or ((action_process_image_command_line contains "wmic" and action_process_image_command_line contains "caption like ") and (action_process_image_command_line contains "call delete" or action_process_image_command_line contains "call terminate")) or ((action_process_image_command_line contains "process " and action_process_image_command_line contains "where " and action_process_image_command_line contains "delete"))) and ((action_process_image_command_line contains "%carbon%" or action_process_image_command_line contains "%cylance%" or action_process_image_command_line contains "%endpoint%" or action_process_image_command_line contains "%eset%" or action_process_image_command_line contains "%malware%" or action_process_image_command_line contains "%Sophos%" or action_process_image_command_line contains "%symantec%" or action_process_image_command_line contains "Antivirus" or action_process_image_command_line contains "AVG " or action_process_image_command_line contains "Carbon Black" or action_process_image_command_line contains "CarbonBlack" or action_process_image_command_line contains "Cb Defense Sensor 64-bit" or action_process_image_command_line contains "Crowdstrike Sensor" or action_process_image_command_line contains "Cylance " or action_process_image_command_line contains "Dell Threat Defense" or action_process_image_command_line contains "DLP Endpoint" or action_process_image_command_line contains "Endpoint Detection" or action_process_image_command_line contains "Endpoint Protection" or action_process_image_command_line contains "Endpoint Security" or action_process_image_command_line contains "Endpoint Sensor" or action_process_image_command_line contains "ESET File Security" or action_process_image_command_line contains "LogRhythm System Monitor Service" or action_process_image_command_line contains "Malwarebytes" or action_process_image_command_line contains "McAfee Agent" or action_process_image_command_line contains "Microsoft Security Client" or action_process_image_command_line contains "Sophos Anti-Virus" or action_process_image_command_line contains "Sophos AutoUpdate" or action_process_image_command_line contains "Sophos Credential Store" or action_process_image_command_line contains "Sophos Management Console" or action_process_image_command_line contains "Sophos Management Database" or action_process_image_command_line contains "Sophos Management Server" or action_process_image_command_line contains "Sophos Remote Management System" or action_process_image_command_line contains "Sophos Update Manager" or action_process_image_command_line contains "Threat Protection" or action_process_image_command_line contains "VirusScan" or action_process_image_command_line contains "Webroot SecureAnywhere" or action_process_image_command_line contains "Windows Defender")))
