# Title: Suspicious PowerShell Parameter Substring
# ID: 36210e0d-5b19-485d-a087-c096088885f0
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), Daniel Bohannon (idea), Roberto Rodriguez (Fix)
# Date: 2019-01-16
# Tags: attack.execution, attack.t1059.001
# Description: Detects suspicious PowerShell invocation with a parameter substring
# Converted by: Sigma Universal SIEM/EDR CLI

((Image="*\\powershell.exe" OR Image="*\\pwsh.exe") AND (CommandLine CONTAINS " -windowstyle h " OR CommandLine CONTAINS " -windowstyl h" OR CommandLine CONTAINS " -windowsty h" OR CommandLine CONTAINS " -windowst h" OR CommandLine CONTAINS " -windows h" OR CommandLine CONTAINS " -windo h" OR CommandLine CONTAINS " -wind h" OR CommandLine CONTAINS " -win h" OR CommandLine CONTAINS " -wi h" OR CommandLine CONTAINS " -win h " OR CommandLine CONTAINS " -win hi " OR CommandLine CONTAINS " -win hid " OR CommandLine CONTAINS " -win hidd " OR CommandLine CONTAINS " -win hidde " OR CommandLine CONTAINS " -NoPr " OR CommandLine CONTAINS " -NoPro " OR CommandLine CONTAINS " -NoProf " OR CommandLine CONTAINS " -NoProfi " OR CommandLine CONTAINS " -NoProfil " OR CommandLine CONTAINS " -nonin " OR CommandLine CONTAINS " -nonint " OR CommandLine CONTAINS " -noninte " OR CommandLine CONTAINS " -noninter " OR CommandLine CONTAINS " -nonintera " OR CommandLine CONTAINS " -noninterac " OR CommandLine CONTAINS " -noninteract " OR CommandLine CONTAINS " -noninteracti " OR CommandLine CONTAINS " -noninteractiv " OR CommandLine CONTAINS " -ec " OR CommandLine CONTAINS " -encodedComman " OR CommandLine CONTAINS " -encodedComma " OR CommandLine CONTAINS " -encodedComm " OR CommandLine CONTAINS " -encodedCom " OR CommandLine CONTAINS " -encodedCo " OR CommandLine CONTAINS " -encodedC " OR CommandLine CONTAINS " -encoded " OR CommandLine CONTAINS " -encode " OR CommandLine CONTAINS " -encod " OR CommandLine CONTAINS " -enco " OR CommandLine CONTAINS " -en " OR CommandLine CONTAINS " -executionpolic " OR CommandLine CONTAINS " -executionpoli " OR CommandLine CONTAINS " -executionpol " OR CommandLine CONTAINS " -executionpo " OR CommandLine CONTAINS " -executionp " OR CommandLine CONTAINS " -execution bypass" OR CommandLine CONTAINS " -executio bypass" OR CommandLine CONTAINS " -executi bypass" OR CommandLine CONTAINS " -execut bypass" OR CommandLine CONTAINS " -execu bypass" OR CommandLine CO