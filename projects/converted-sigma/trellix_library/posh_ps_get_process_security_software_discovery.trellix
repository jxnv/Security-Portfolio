# Title: Security Software Discovery Via Powershell Script
# ID: 904e8e61-8edf-4350-b59c-b905fc8e810c
# Status: test
# Level: medium
# Author: frack113, Anish Bogati, Nasreddine Bencherchali (Nextron Systems)
# Date: 2021-12-16
# Tags: attack.discovery, attack.t1518.001
# Description: Detects calls to "get-process" where the output is piped to a "where-object" filter to search for security solution processes.
# Adversaries may attempt to get a listing of security software, configurations, defensive tools, and sensors that are installed on a system or in a cloud environment. This may include things such as firewall rules and anti-virus
# Converted by: Sigma Universal SIEM/EDR CLI

(((ScriptBlockText CONTAINS "get-process | \\?" OR ScriptBlockText CONTAINS "get-process | where" OR ScriptBlockText CONTAINS "gps | \\?" OR ScriptBlockText CONTAINS "gps | where")) AND ((ScriptBlockText CONTAINS "Company -like" OR ScriptBlockText CONTAINS "Description -like" OR ScriptBlockText CONTAINS "Name -like" OR ScriptBlockText CONTAINS "Path -like" OR ScriptBlockText CONTAINS "Product -like")) AND ((ScriptBlockText CONTAINS "\\*avira\\*" OR ScriptBlockText CONTAINS "\\*carbonblack\\*" OR ScriptBlockText CONTAINS "\\*cylance\\*" OR ScriptBlockText CONTAINS "\\*defender\\*" OR ScriptBlockText CONTAINS "\\*kaspersky\\*" OR ScriptBlockText CONTAINS "\\*malware\\*" OR ScriptBlockText CONTAINS "\\*sentinel\\*" OR ScriptBlockText CONTAINS "\\*symantec\\*" OR ScriptBlockText CONTAINS "\\*virus\\*")))
