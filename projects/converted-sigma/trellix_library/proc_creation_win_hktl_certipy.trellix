# Title: HackTool - Certipy Execution
# ID: 6938366d-8954-4ddc-baff-c830b3ba8fcd
# Status: test
# Level: high
# Author: pH-T (Nextron Systems), Sittikorn Sangrattanapitak
# Date: 2023-04-17
# Tags: attack.discovery, attack.credential-access, attack.t1649
# Description: Detects Certipy execution, a tool for Active Directory Certificate Services enumeration and abuse based on PE metadata characteristics and common command line arguments.
# Converted by: Sigma Universal SIEM/EDR CLI

(((Image="*\\Certipy.exe") OR (OriginalFileName == "Certipy.exe") OR (Description CONTAINS "Certipy")) OR (((CommandLine CONTAINS " account " OR CommandLine CONTAINS " auth " OR CommandLine CONTAINS " cert " OR CommandLine CONTAINS " find " OR CommandLine CONTAINS " forge " OR CommandLine CONTAINS " ptt " OR CommandLine CONTAINS " relay " OR CommandLine CONTAINS " req " OR CommandLine CONTAINS " shadow " OR CommandLine CONTAINS " template ")) AND ((CommandLine CONTAINS " -bloodhound" OR CommandLine CONTAINS " -ca-pfx " OR CommandLine CONTAINS " -dc-ip " OR CommandLine CONTAINS " -kirbi" OR CommandLine CONTAINS " -old-bloodhound" OR CommandLine CONTAINS " -pfx " OR CommandLine CONTAINS " -target" OR CommandLine CONTAINS " -template" OR CommandLine CONTAINS " -username " OR CommandLine CONTAINS " -vulnerable" OR CommandLine CONTAINS "auth -pfx" OR CommandLine CONTAINS "shadow auto" OR CommandLine CONTAINS "shadow list"))))
