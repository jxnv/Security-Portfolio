# Description: Potential adversaries accessing the microphone and webcam in an endpoint.
# Converted by: Sigma Universal SIEM/EDR CLI

((EventID == "4657" OR EventID == "4656" OR EventID == "4663") AND (ObjectName CONTAINS "\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\CapabilityAccessManager\\ConsentStore\\microphone\\NonPackaged" OR ObjectName CONTAINS "\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\CapabilityAccessManager\\ConsentStore\\webcam\\NonPackaged"))
