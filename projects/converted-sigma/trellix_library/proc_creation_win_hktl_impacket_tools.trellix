# Title: HackTool - Impacket Tools Execution
# ID: 4627c6ae-6899-46e2-aa0c-6ebcb1becd19
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2021-07-24
# Tags: attack.collection, attack.execution, attack.credential-access, attack.t1557.001
# Description: Detects the execution of different compiled Windows binaries of the impacket toolset (based on names or part of their names - could lead to false positives)
# Converted by: Sigma Universal SIEM/EDR CLI

(((Image CONTAINS "\\goldenPac" OR Image CONTAINS "\\karmaSMB" OR Image CONTAINS "\\kintercept" OR Image CONTAINS "\\ntlmrelayx" OR Image CONTAINS "\\rpcdump" OR Image CONTAINS "\\samrdump" OR Image CONTAINS "\\secretsdump" OR Image CONTAINS "\\smbexec" OR Image CONTAINS "\\smbrelayx" OR Image CONTAINS "\\wmiexec" OR Image CONTAINS "\\wmipersist")) OR ((Image="*\\atexec_windows.exe" OR Image="*\\dcomexec_windows.exe" OR Image="*\\dpapi_windows.exe" OR Image="*\\findDelegation_windows.exe" OR Image="*\\GetADUsers_windows.exe" OR Image="*\\GetNPUsers_windows.exe" OR Image="*\\getPac_windows.exe" OR Image="*\\getST_windows.exe" OR Image="*\\getTGT_windows.exe" OR Image="*\\GetUserSPNs_windows.exe" OR Image="*\\ifmap_windows.exe" OR Image="*\\mimikatz_windows.exe" OR Image="*\\netview_windows.exe" OR Image="*\\nmapAnswerMachine_windows.exe" OR Image="*\\opdump_windows.exe" OR Image="*\\psexec_windows.exe" OR Image="*\\rdp_check_windows.exe" OR Image="*\\sambaPipe_windows.exe" OR Image="*\\smbclient_windows.exe" OR Image="*\\smbserver_windows.exe" OR Image="*\\sniff_windows.exe" OR Image="*\\sniffer_windows.exe" OR Image="*\\split_windows.exe" OR Image="*\\ticketer_windows.exe")))
