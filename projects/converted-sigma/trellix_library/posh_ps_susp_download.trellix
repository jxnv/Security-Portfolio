# Title: Suspicious PowerShell Download - Powershell Script
# ID: 403c2cc0-7f6b-4925-9423-bfa573bed7eb
# Status: test
# Level: medium
# Author: Florian Roth (Nextron Systems)
# Date: 2017-03-05
# Tags: attack.execution, attack.t1059.001
# Description: Detects suspicious PowerShell download command
# Converted by: Sigma Universal SIEM/EDR CLI

((ScriptBlockText CONTAINS "System.Net.WebClient") AND ((ScriptBlockText CONTAINS ".DownloadFile(" OR ScriptBlockText CONTAINS ".DownloadFileAsync(" OR ScriptBlockText CONTAINS ".DownloadString(" OR ScriptBlockText CONTAINS ".DownloadStringAsync(")))
