# Title: Suspicious Program Names
# ID: efdd8dd5-cee8-4e59-9390-7d4d5e4dd6f6
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-02-11
# Tags: attack.execution, attack.t1059
# Description: Detects suspicious patterns in program names or folders that are often found in malicious samples or hacktools
# Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAINS "inject.ps1" OR CommandLine CONTAINS "Invoke-CVE" OR CommandLine CONTAINS "pupy.ps1" OR CommandLine CONTAINS "payload.ps1" OR CommandLine CONTAINS "beacon.ps1" OR CommandLine CONTAINS "PowerView.ps1" OR CommandLine CONTAINS "bypass.ps1" OR CommandLine CONTAINS "obfuscated.ps1" OR CommandLine CONTAINS "obfusc.ps1" OR CommandLine CONTAINS "obfus.ps1" OR CommandLine CONTAINS "obfs.ps1" OR CommandLine CONTAINS "evil.ps1" OR CommandLine CONTAINS "MiniDogz.ps1" OR CommandLine CONTAINS "_enc.ps1" OR CommandLine CONTAINS "\\shell.ps1" OR CommandLine CONTAINS "\\rshell.ps1" OR CommandLine CONTAINS "revshell.ps1" OR CommandLine CONTAINS "\\av.ps1" OR CommandLine CONTAINS "\\av_test.ps1" OR CommandLine CONTAINS "adrecon.ps1" OR CommandLine CONTAINS "mimikatz.ps1" OR CommandLine CONTAINS "\\PowerUp_" OR CommandLine CONTAINS "powerup.ps1" OR CommandLine CONTAINS "\\Temp\\a.ps1" OR CommandLine CONTAINS "\\Temp\\p.ps1" OR CommandLine CONTAINS "\\Temp\\1.ps1" OR CommandLine CONTAINS "Hound.ps1" OR CommandLine CONTAINS "encode.ps1" OR CommandLine CONTAINS "powercat.ps1")) OR (((Image CONTAINS "\\CVE-202" OR Image CONTAINS "\\CVE202")) OR ((Image="*\\poc.exe" OR Image="*\\artifact.exe" OR Image="*\\artifact64.exe" OR Image="*\\artifact_protected.exe" OR Image="*\\artifact32.exe" OR Image="*\\artifact32big.exe" OR Image="*obfuscated.exe" OR Image="*obfusc.exe" OR Image="*\\meterpreter"))))
