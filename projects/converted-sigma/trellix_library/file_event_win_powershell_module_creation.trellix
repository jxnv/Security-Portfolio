# Tags: attack.persistence
# Description: Detects the creation of a new PowerShell module ".psm1", ".psd1", ".dll", ".ps1", etc.
# Converted by: Sigma Universal SIEM/EDR CLI

((Image="*\\powershell.exe" OR Image="*\\pwsh.exe") AND (TargetFilename CONTAINS "\\WindowsPowerShell\\Modules\\" OR TargetFilename CONTAINS "\\PowerShell\\7\\Modules\\"))
