# Tags: attack.credential-access, attack.t1003.001, attack.t1003.002, attack.t1003.004, attack.t1003.005, attack.t1003.006
# Description: Detection well-known mimikatz command line arguments
# Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAINS "::aadcookie" OR CommandLine CONTAINS "::detours" OR CommandLine CONTAINS "::memssp" OR CommandLine CONTAINS "::mflt" OR CommandLine CONTAINS "::ncroutemon" OR CommandLine CONTAINS "::ngcsign" OR CommandLine CONTAINS "::printnightmare" OR CommandLine CONTAINS "::skeleton" OR CommandLine CONTAINS "::preshutdown" OR CommandLine CONTAINS "::mstsc" OR CommandLine CONTAINS "::multirdp")) OR ((CommandLine CONTAINS "rpc::" OR CommandLine CONTAINS "token::" OR CommandLine CONTAINS "crypto::" OR CommandLine CONTAINS "dpapi::" OR CommandLine CONTAINS "sekurlsa::" OR CommandLine CONTAINS "kerberos::" OR CommandLine CONTAINS "lsadump::" OR CommandLine CONTAINS "privilege::" OR CommandLine CONTAINS "process::" OR CommandLine CONTAINS "vault::")) OR ((CommandLine CONTAINS "DumpCreds" OR CommandLine CONTAINS "mimikatz")))
