# Title: Potentially Suspicious EventLog Recon Activity Using Log Query Utilities
# ID: beaa66d6-aa1b-4e3c-80f5-e0145369bfaf
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
# Date: 2022-09-09
# Tags: attack.credential-access, attack.discovery, attack.t1552, attack.t1087
# Description: Detects execution of different log query utilities and commands to search and dump the content of specific event logs or look for specific event IDs.
# This technique is used by threat actors in order to extract sensitive information from events logs such as usernames, IP addresses, hostnames, etc.
# Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine CONTAINS "-InstanceId 462?" OR CommandLine CONTAINS ".eventid -eq 462?" OR CommandLine CONTAINS ".ID -eq 462?" OR CommandLine CONTAINS "EventCode=?462?" OR CommandLine CONTAINS "EventIdentifier=?462?" OR CommandLine CONTAINS "System[EventID=462?]" OR CommandLine CONTAINS "-InstanceId 4778" OR CommandLine CONTAINS ".eventid -eq 4778" OR CommandLine CONTAINS ".ID -eq 4778" OR CommandLine CONTAINS "EventCode=?4778?" OR CommandLine CONTAINS "EventIdentifier=?4778?" OR CommandLine CONTAINS "System[EventID=4778]" OR CommandLine CONTAINS "-InstanceId 25" OR CommandLine CONTAINS ".eventid -eq 25" OR CommandLine CONTAINS ".ID -eq 25" OR CommandLine CONTAINS "EventCode=?25?" OR CommandLine CONTAINS "EventIdentifier=?25?" OR CommandLine CONTAINS "System[EventID=25]" OR CommandLine CONTAINS "-InstanceId 1149" OR CommandLine CONTAINS ".eventid -eq 1149" OR CommandLine CONTAINS ".ID -eq 1149" OR CommandLine CONTAINS "EventCode=?1149?" OR CommandLine CONTAINS "EventIdentifier=?1149?" OR CommandLine CONTAINS "System[EventID=1149]" OR CommandLine CONTAINS "-InstanceId 21" OR CommandLine CONTAINS ".eventid -eq 21" OR CommandLine CONTAINS ".ID -eq 21" OR CommandLine CONTAINS "EventCode=?21?" OR CommandLine CONTAINS "EventIdentifier=?21?" OR CommandLine CONTAINS "System[EventID=21]" OR CommandLine CONTAINS "-InstanceId 22" OR CommandLine CONTAINS ".eventid -eq 22" OR CommandLine CONTAINS ".ID -eq 22" OR CommandLine CONTAINS "EventCode=?22?" OR CommandLine CONTAINS "EventIdentifier=?22?" OR CommandLine CONTAINS "System[EventID=22]")) OR ((CommandLine CONTAINS "Microsoft-Windows-PowerShell" OR CommandLine CONTAINS "Microsoft-Windows-Security-Auditing" OR CommandLine CONTAINS "Microsoft-Windows-TerminalServices-LocalSessionManager" OR CommandLine CONTAINS "Microsoft-Windows-TerminalServices-RemoteConnectionManager" OR CommandLine CONTAINS "Microsoft-Windows-Windows Defender" OR CommandLine CONTAINS "PowerShellCore" OR CommandLine CONTAINS "Security" OR CommandLine CONTAINS "Windows PowerShell"))) AND (((CommandLine CONTAINS "Select" AND CommandLine CONTAINS "Win32_NTLogEvent")) OR (((CommandLine CONTAINS " qe " OR CommandLine CONTAINS " query-events ")) AND ((Image="*\\wevtutil.exe") OR (OriginalFileName == "wevtutil.exe"))) OR ((CommandLine CONTAINS " ntevent") AND ((Image="*\\wmic.exe") OR (OriginalFileName == "wmic.exe"))) OR ((CommandLine CONTAINS "Get-WinEvent " OR CommandLine CONTAINS "get-eventlog "))))
