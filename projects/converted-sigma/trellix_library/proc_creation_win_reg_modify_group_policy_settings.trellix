# Title: Modify Group Policy Settings
# ID: ada4b0c4-758b-46ac-9033-9004613a150d
# Status: test
# Level: medium
# Author: frack113
# Date: 2022-08-19
# Tags: attack.privilege-escalation, attack.defense-impairment, attack.t1484.001
# Description: Detect malicious GPO modifications can be used to implement many other malicious behaviors.
# Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAINS "GroupPolicyRefreshTimeDC" OR CommandLine CONTAINS "GroupPolicyRefreshTimeOffsetDC" OR CommandLine CONTAINS "GroupPolicyRefreshTime" OR CommandLine CONTAINS "GroupPolicyRefreshTimeOffset" OR CommandLine CONTAINS "EnableSmartScreen" OR CommandLine CONTAINS "ShellSmartScreenLevel")) AND (CommandLine CONTAINS "\\SOFTWARE\\Policies\\Microsoft\\Windows\\System") AND ((Image="*\\reg.exe") OR (OriginalFileName == "reg.exe")))
