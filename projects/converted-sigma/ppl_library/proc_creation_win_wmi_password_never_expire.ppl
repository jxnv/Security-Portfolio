// Title: Password Set to Never Expire via WMI
// ID: 7864a175-3654-4824-9f0d-f0da18ab27c0
// Status: experimental
// Level: medium
// Author: Daniel Koifman (KoifSec)
// Date: 2025-07-30
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1047, attack.t1098
// Description: Detects the use of wmic.exe to modify user account settings and explicitly disable password expiration.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%useraccount%" AND process.command_line like "% set %" AND process.command_line like "%passwordexpires%" AND process.command_line like "%false%")) AND ((process.executable="*\\wmic.exe") OR (process.pe.original_file_name = "wmic.exe")))
