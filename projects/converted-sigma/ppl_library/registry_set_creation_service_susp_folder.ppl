// Title: Service Binary in Suspicious Folder
// ID: a07f0359-4c90-4dc4-a681-8ffea40b4f47
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), frack113
// Date: 2022-05-02
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detect the creation of a service with a service binary located in a suspicious directory
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((registry.path="HKLM\\System\\CurrentControlSet\\Services\\*" AND registry.path="*\\ImagePath" AND (registry.data.strings like "%\\Users\\Public\\%" OR registry.data.strings like "%\\Perflogs\\%" OR registry.data.strings like "%\\ADMIN$\\%" OR registry.data.strings like "%\\Temp\\%")) OR (registry.path="HKLM\\System\\CurrentControlSet\\Services\\*" AND registry.path="*\\Start" AND (process.executable like "%\\Users\\Public\\%" OR process.executable like "%\\Perflogs\\%" OR process.executable like "%\\ADMIN$\\%" OR process.executable like "%\\Temp\\%") AND (registry.data.strings = "DWORD (0x00000000)" OR registry.data.strings = "DWORD (0x00000001)" OR registry.data.strings = "DWORD (0x00000002)"))) AND NOT ((((process.executable like "%\\Common Files\\%" AND process.executable like "%\\Temp\\%")) OR (registry.path="*\\CurrentControlSet\\Services\\MBAMInstallerService\\ImagePath" AND registry.data.strings="*\\AppData\\Local\\Temp\\MBAMInstallerService.exe\"" AND process.executable = "C:\\Windows\\system32\\services.exe"))))
