// Title: Suspicious PowerShell Encoded Command Patterns
// ID: b9d9cc83-380b-4ba3-8d8f-60c0e7e2930c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-05-24
// Tags: attack.execution, attack.t1059.001
// Description: Detects PowerShell command line patterns in combincation with encoded commands that often appear in malware infection chains
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.command_line like "% JAB%" OR process.command_line like "% SUVYI%" OR process.command_line like "% SQBFAFgA%" OR process.command_line like "% aWV4I%" OR process.command_line like "% IAB%" OR process.command_line like "% PAA%" OR process.command_line like "% aQBlAHgA%")) AND ((process.command_line like "% -e %" OR process.command_line like "% -en %" OR process.command_line like "% -enc %" OR process.command_line like "% -enco%")) AND (((process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe")) OR ((process.pe.original_file_name = "PowerShell.Exe" OR process.pe.original_file_name = "pwsh.dll")))) AND NOT (((process.parent.executable like "%C:\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\%" OR process.parent.executable like "%\\gc_worker.exe%"))))
