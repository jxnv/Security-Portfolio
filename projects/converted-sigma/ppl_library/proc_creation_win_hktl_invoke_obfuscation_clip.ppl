// Title: Invoke-Obfuscation CLIP+ Launcher
// ID: b222df08-0e07-11eb-adc1-0242ac120002
// Status: test
// Level: high
// Author: Jonathan Cheong, oscd.community
// Date: 2020-10-13
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated use of Clip.exe to execute PowerShell
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.command_line like "%cmd%" AND process.command_line like "%&&%" AND process.command_line like "%clipboard]::%" AND process.command_line like "%-f%") AND (process.command_line like "%/c%" OR process.command_line like "%/r%"))
