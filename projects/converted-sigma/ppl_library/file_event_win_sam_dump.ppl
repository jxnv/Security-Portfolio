// Title: Potential SAM Database Dump
// ID: 4e87b8e2-2ee9-4b2a-a715-4727d297ece0
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-11
// Tags: attack.credential-access, attack.t1003.002
// Description: Detects the creation of files that look like exports of the local SAM (Security Account Manager)
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((file.path="*\\Temp\\sam" OR file.path="*\\sam.sav" OR file.path="*\\Intel\\sam" OR file.path="*\\sam.hive" OR file.path="*\\Perflogs\\sam" OR file.path="*\\ProgramData\\sam" OR file.path="*\\Users\\Public\\sam" OR file.path="*\\AppData\\Local\\sam" OR file.path="*\\AppData\\Roaming\\sam" OR file.path="*_ShadowSteal.zip" OR file.path="*\\Documents\\SAM.export" OR file.path="*:\\sam")) OR ((file.path like "%\\hive_sam_%" OR file.path like "%\\sam.save%" OR file.path like "%\\sam.export%" OR file.path like "%\\~reg_sam.save%" OR file.path like "%\\sam_backup%" OR file.path like "%\\sam.bck%" OR file.path like "%\\sam.backup%")))
