// Title: Suspicious Java Children Processes
// ID: d292e0af-9a18-420c-9525-ec0ac3936892
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-03
// Tags: attack.execution, attack.t1059
// Description: Detects java process spawning suspicious children
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (process.parent.executable="*/java" AND (process.command_line like "%/bin/sh%" OR process.command_line like "%bash%" OR process.command_line like "%dash%" OR process.command_line like "%ksh%" OR process.command_line like "%zsh%" OR process.command_line like "%csh%" OR process.command_line like "%fish%" OR process.command_line like "%curl%" OR process.command_line like "%wget%" OR process.command_line like "%python%"))
