// Title: GAC DLL Loaded Via Office Applications
// ID: 90217a70-13fc-48e4-b3db-0d836c5824ac
// Status: test
// Level: high
// Author: Antonlovesdnb
// Date: 2020-02-19
// Tags: attack.execution, attack.t1204.002
// Description: Detects any GAC DLL being loaded by an Office Product
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.executable="*\\excel.exe" OR process.executable="*\\mspub.exe" OR process.executable="*\\onenote.exe" OR process.executable="*\\onenoteim.exe" OR process.executable="*\\outlook.exe" OR process.executable="*\\powerpnt.exe" OR process.executable="*\\winword.exe") AND ImageLoaded="C:\\Windows\\Microsoft.NET\\assembly\\GAC_MSIL*")
