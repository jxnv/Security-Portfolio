// Title: Invoke-Obfuscation COMPRESS OBFUSCATION - System
// ID: 175997c5-803c-4b08-8bb0-70b099f47595
// Status: test
// Level: medium
// Author: Timur Zinniatullin, oscd.community
// Date: 2020-10-18
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via COMPRESS OBFUSCATION
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (winlog.provider_name = "Service Control Manager" AND winlog.event_id = "7045" AND (ImagePath like "%new-object%" AND ImagePath like "%text.encoding]::ascii%" AND ImagePath like "%readtoend%") AND (ImagePath like "%:system.io.compression.deflatestream%" OR ImagePath like "%system.io.streamreader%"))
