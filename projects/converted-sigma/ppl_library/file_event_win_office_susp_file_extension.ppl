// Title: File With Uncommon Extension Created By An Office Application
// ID: c7a74c80-ba5a-486e-9974-ab9e682bc5e4
// Status: test
// Level: high
// Author: Vadim Khrykov (ThreatIntel), Cyb3rEng (Rule), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-08-23
// Tags: attack.t1204.002, attack.execution
// Description: Detects the creation of files with an executable or script extension by an Office application.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.executable="*\\excel.exe" OR process.executable="*\\msaccess.exe" OR process.executable="*\\mspub.exe" OR process.executable="*\\powerpnt.exe" OR process.executable="*\\visio.exe" OR process.executable="*\\winword.exe")) AND ((file.path="*.bat" OR file.path="*.cmd" OR file.path="*.com" OR file.path="*.dll" OR file.path="*.exe" OR file.path="*.hta" OR file.path="*.ocx" OR file.path="*.proj" OR file.path="*.ps1" OR file.path="*.scf" OR file.path="*.scr" OR file.path="*.sys" OR file.path="*.vbe" OR file.path="*.vbs" OR file.path="*.wsf" OR file.path="*.wsh"))) AND NOT ((file.path like "%\\AppData\\Local\\assembly\\tmp\\%" AND file.path="*.dll")) AND NOT ((((file.path like "%C:\\Users\\%" AND file.path like "%\\AppData\\Local\\Microsoft\\Office\\%" AND file.path like "%\\BackstageInAppNavCache\\%") AND file.path="*.com") OR (process.executable="*\\winword.exe" AND file.path like "%\\AppData\\Local\\Temp\\webexdelta\\%" AND (file.path="*.dll" OR file.path="*.exe")) OR ((file.path like "%C:\\Users\\%" AND file.path like "%\\AppData\\Local\\Microsoft\\Office\\%" AND file.path like "%\\WebServiceCache\\AllUsers%") AND file.path="*.com"))))
