// Title: Suspicious PowerShell Parameter Substring
// ID: 36210e0d-5b19-485d-a087-c096088885f0
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Daniel Bohannon (idea), Roberto Rodriguez (Fix)
// Date: 2019-01-16
// Tags: attack.execution, attack.t1059.001
// Description: Detects suspicious PowerShell invocation with a parameter substring
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe") AND (process.command_line like "% -windowstyle h %" OR process.command_line like "% -windowstyl h%" OR process.command_line like "% -windowsty h%" OR process.command_line like "% -windowst h%" OR process.command_line like "% -windows h%" OR process.command_line like "% -windo h%" OR process.command_line like "% -wind h%" OR process.command_line like "% -win h%" OR process.command_line like "% -wi h%" OR process.command_line like "% -win h %" OR process.command_line like "% -win hi %" OR process.command_line like "% -win hid %" OR process.command_line like "% -win hidd %" OR process.command_line like "% -win hidde %" OR process.command_line like "% -NoPr %" OR process.command_line like "% -NoPro %" OR process.command_line like "% -NoProf %" OR process.command_line like "% -NoProfi %" OR process.command_line like "% -NoProfil %" OR process.command_line like "% -nonin %" OR process.command_line like "% -nonint %" OR process.command_line like "% -noninte %" OR process.command_line like "% -noninter %" OR process.command_line like "% -nonintera %" OR process.command_line like "% -noninterac %" OR process.command_line like "% -noninteract %" OR process.command_line like "% -noninteracti %" OR process.command_line like "% -noninteractiv %" OR process.command_line like "% -ec %" OR process.command_line like "% -encodedComman %" OR process.command_line like "% -encodedComma %" OR process.command_line like "% -encodedComm %" OR process.command_line like "% -encodedCom %" OR process.command_line like "% -encodedCo %" OR process.command_line like "% -encodedC %" OR process.command_line like "% -encoded %" OR process.command_line like "% -encode %" OR process.command_line like "% -encod %" OR process.command_line like "% -enco %" OR process.command_line like "% -en %" OR process.command_line like "% -executionpolic %" OR process.command_line like "% -executionpoli %" OR process.command_line like "% -executionpol %" OR process.command_line like "% -executionpo %" OR process.command_line like "% -executionp %" OR process.command_line like "% -execution bypass%" OR process.command_line like "% -executio bypass%" OR process.command_line like "% -executi bypass%" OR process.command_line like "% -execut bypass%" OR process.command_line like "% -execu bypass%" OR process.command_line like "% -exec bypass%" OR process.command_line like "% -exe bypass%" OR process.command_line like "% -ex bypass%" OR process.command_line like "% -ep bypass%" OR process.command_line like "% /windowstyle h %" OR process.command_line like "% /windowstyl h%" OR process.command_line like "% /windowsty h%" OR process.command_line like "% /windowst h%" OR process.command_line like "% /windows h%" OR process.command_line like "% /windo h%" OR process.command_line like "% /wind h%" OR process.command_line like "% /win h%" OR process.command_line like "% /wi h%" OR process.command_line like "% /win h %" OR process.command_line like "% /win hi %" OR process.command_line like "% /win hid %" OR process.command_line like "% /win hidd %" OR process.command_line like "% /win hidde %" OR process.command_line like "% /NoPr %" OR process.command_line like "% /NoPro %" OR process.command_line like "% /NoProf %" OR process.command_line like "% /NoProfi %" OR process.command_line like "% /NoProfil %" OR process.command_line like "% /nonin %" OR process.command_line like "% /nonint %" OR process.command_line like "% /noninte %" OR process.command_line like "% /noninter %" OR process.command_line like "% /nonintera %" OR process.command_line like "% /noninterac %" OR process.command_line like "% /noninteract %" OR process.command_line like "% /noninteracti %" OR process.command_line like "% /noninteractiv %" OR process.command_line like "% /ec %" OR process.command_line like "% /encodedComman %" OR process.command_line like "% /encodedComma %" OR process.command_line like "% /encodedComm %" OR process.command_line like "% /encodedCom %" OR process.command_line like "% /encodedCo %" OR process.command_line like "% /encodedC %" OR process.command_line like "% /encoded %" OR process.command_line like "% /encode %" OR process.command_line like "% /encod %" OR process.command_line like "% /enco %" OR process.command_line like "% /en %" OR process.command_line like "% /executionpolic %" OR process.command_line like "% /executionpoli %" OR process.command_line like "% /executionpol %" OR process.command_line like "% /executionpo %" OR process.command_line like "% /executionp %" OR process.command_line like "% /execution bypass%" OR process.command_line like "% /executio bypass%" OR process.command_line like "% /executi bypass%" OR process.command_line like "% /execut bypass%" OR process.command_line like "% /execu bypass%" OR process.command_line like "% /exec bypass%" OR process.command_line like "% /exe bypass%" OR process.command_line like "% /ex bypass%" OR process.command_line like "% /ep bypass%"))
