// Title: HackTool - Generic Process Access
// ID: d0d2f720-d14f-448d-8242-51ff396a334e
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Swachchhanda Shrawan Poudel
// Date: 2023-11-27
// Tags: attack.credential-access, attack.t1003.001, attack.s0002
// Description: Detects process access requests from hacktool processes based on their default image name
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((SourceImage="*\\Akagi.exe" OR SourceImage="*\\Akagi64.exe" OR SourceImage="*\\atexec_windows.exe" OR SourceImage="*\\Certify.exe" OR SourceImage="*\\Certipy.exe" OR SourceImage="*\\CoercedPotato.exe" OR SourceImage="*\\crackmapexec.exe" OR SourceImage="*\\CreateMiniDump.exe" OR SourceImage="*\\dcomexec_windows.exe" OR SourceImage="*\\dpapi_windows.exe" OR SourceImage="*\\findDelegation_windows.exe" OR SourceImage="*\\GetADUsers_windows.exe" OR SourceImage="*\\GetNPUsers_windows.exe" OR SourceImage="*\\getPac_windows.exe" OR SourceImage="*\\getST_windows.exe" OR SourceImage="*\\getTGT_windows.exe" OR SourceImage="*\\GetUserSPNs_windows.exe" OR SourceImage="*\\gmer.exe" OR SourceImage="*\\hashcat.exe" OR SourceImage="*\\htran.exe" OR SourceImage="*\\ifmap_windows.exe" OR SourceImage="*\\impersonate.exe" OR SourceImage="*\\Inveigh.exe" OR SourceImage="*\\LocalPotato.exe" OR SourceImage="*\\mimikatz_windows.exe" OR SourceImage="*\\mimikatz.exe" OR SourceImage="*\\netview_windows.exe" OR SourceImage="*\\nmapAnswerMachine_windows.exe" OR SourceImage="*\\opdump_windows.exe" OR SourceImage="*\\PasswordDump.exe" OR SourceImage="*\\Potato.exe" OR SourceImage="*\\PowerTool.exe" OR SourceImage="*\\PowerTool64.exe" OR SourceImage="*\\psexec_windows.exe" OR SourceImage="*\\PurpleSharp.exe" OR SourceImage="*\\pypykatz.exe" OR SourceImage="*\\QuarksPwDump.exe" OR SourceImage="*\\rdp_check_windows.exe" OR SourceImage="*\\Rubeus.exe" OR SourceImage="*\\SafetyKatz.exe" OR SourceImage="*\\sambaPipe_windows.exe" OR SourceImage="*\\SelectMyParent.exe" OR SourceImage="*\\SharpChisel.exe" OR SourceImage="*\\SharPersist.exe" OR SourceImage="*\\SharpEvtMute.exe" OR SourceImage="*\\SharpImpersonation.exe" OR SourceImage="*\\SharpLDAPmonitor.exe" OR SourceImage="*\\SharpLdapWhoami.exe" OR SourceImage="*\\SharpUp.exe" OR SourceImage="*\\SharpView.exe" OR SourceImage="*\\smbclient_windows.exe" OR SourceImage="*\\smbserver_windows.exe" OR SourceImage="*\\sniff_windows.exe" OR SourceImage="*\\sniffer_windows.exe" OR SourceImage="*\\split_windows.exe" OR SourceImage="*\\SpoolSample.exe" OR SourceImage="*\\Stracciatella.exe" OR SourceImage="*\\SysmonEOP.exe" OR SourceImage="*\\temp\\rot.exe" OR SourceImage="*\\ticketer_windows.exe" OR SourceImage="*\\TruffleSnout.exe" OR SourceImage="*\\winPEASany_ofs.exe" OR SourceImage="*\\winPEASany.exe" OR SourceImage="*\\winPEASx64_ofs.exe" OR SourceImage="*\\winPEASx64.exe" OR SourceImage="*\\winPEASx86_ofs.exe" OR SourceImage="*\\winPEASx86.exe" OR SourceImage="*\\xordump.exe")) OR ((SourceImage like "%\\goldenPac%" OR SourceImage like "%\\just_dce_%" OR SourceImage like "%\\karmaSMB%" OR SourceImage like "%\\kintercept%" OR SourceImage like "%\\LocalPotato%" OR SourceImage like "%\\ntlmrelayx%" OR SourceImage like "%\\rpcdump%" OR SourceImage like "%\\samrdump%" OR SourceImage like "%\\secretsdump%" OR SourceImage like "%\\smbexec%" OR SourceImage like "%\\smbrelayx%" OR SourceImage like "%\\wmiexec%" OR SourceImage like "%\\wmipersist%" OR SourceImage like "%HotPotato%" OR SourceImage like "%Juicy Potato%" OR SourceImage like "%JuicyPotato%" OR SourceImage like "%PetitPotam%" OR SourceImage like "%RottenPotato%")))
