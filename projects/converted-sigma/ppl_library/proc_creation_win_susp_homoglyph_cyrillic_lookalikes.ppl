// Title: Potential Homoglyph Attack Using Lookalike Characters
// ID: 32e280f1-8ad4-46ef-9e80-910657611fbc
// Status: test
// Level: medium
// Author: Micah Babinski, @micahbabinski
// Date: 2023-05-07
// Tags: attack.stealth, attack.t1036, attack.t1036.003
// Description: Detects the presence of unicode characters which are homoglyphs, or identical in appearance, to ASCII letter characters.
// This is used as an obfuscation and masquerading techniques. Only "perfect" homoglyphs are included; these are characters that
// are indistinguishable from ASCII characters and thus may make excellent candidates for homoglyph attack characters.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%а%" OR process.command_line like "%е%" OR process.command_line like "%о%" OR process.command_line like "%р%" OR process.command_line like "%с%" OR process.command_line like "%х%" OR process.command_line like "%ѕ%" OR process.command_line like "%і%" OR process.command_line like "%ӏ%" OR process.command_line like "%ј%" OR process.command_line like "%һ%" OR process.command_line like "%ԁ%" OR process.command_line like "%ԛ%" OR process.command_line like "%ԝ%" OR process.command_line like "%ο%")) OR ((process.command_line like "%А%" OR process.command_line like "%В%" OR process.command_line like "%Е%" OR process.command_line like "%К%" OR process.command_line like "%М%" OR process.command_line like "%Н%" OR process.command_line like "%О%" OR process.command_line like "%Р%" OR process.command_line like "%С%" OR process.command_line like "%Т%" OR process.command_line like "%Х%" OR process.command_line like "%Ѕ%" OR process.command_line like "%І%" OR process.command_line like "%Ј%" OR process.command_line like "%Ү%" OR process.command_line like "%Ӏ%" OR process.command_line like "%Ԍ%" OR process.command_line like "%Ԛ%" OR process.command_line like "%Ԝ%" OR process.command_line like "%Α%" OR process.command_line like "%Β%" OR process.command_line like "%Ε%" OR process.command_line like "%Ζ%" OR process.command_line like "%Η%" OR process.command_line like "%Ι%" OR process.command_line like "%Κ%" OR process.command_line like "%Μ%" OR process.command_line like "%Ν%" OR process.command_line like "%Ο%" OR process.command_line like "%Ρ%" OR process.command_line like "%Τ%" OR process.command_line like "%Υ%" OR process.command_line like "%Χ%")))
