// Title: Suspicious File Access to Browser Credential Storage
// ID: a1dfd976-4852-41d4-9507-dc6590a3ccd0
// Status: experimental
// Level: low
// Author: frack113, X__Junior (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems), Parth-FourCore
// Date: 2025-05-22
// Tags: attack.credential-access, attack.t1555.003, attack.discovery, attack.t1217
// Description: Detects file access to browser credential storage paths by non-browser processes, which may indicate credential access attempts.
// Adversaries may attempt to access browser credential storage to extract sensitive information such as usernames and passwords or cookies.
// This behavior is often commonly observed in credential stealing malware.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((FileName like "%\\Sputnik\\Sputnik%" OR FileName like "%\\MapleStudio\\ChromePlus%" OR FileName like "%\\QIP Surf%" OR FileName like "%\\BlackHawk%" OR FileName like "%\\7Star\\7Star%" OR FileName like "%\\CatalinaGroup\\Citrio%" OR FileName like "%\\Google\\Chrome%" OR FileName like "%\\Coowon\\Coowon%" OR FileName like "%\\CocCoc\\Browser%" OR FileName like "%\\uCozMedia\\Uran%" OR FileName like "%\\Tencent\\QQBrowser%" OR FileName like "%\\Orbitum%" OR FileName like "%\\Slimjet%" OR FileName like "%\\Iridium%" OR FileName like "%\\Vivaldi%" OR FileName like "%\\Chromium%" OR FileName like "%\\GhostBrowser%" OR FileName like "%\\CentBrowser%" OR FileName like "%\\Xvast%" OR FileName like "%\\Chedot%" OR FileName like "%\\SuperBird%" OR FileName like "%\\360Browser\\Browser%" OR FileName like "%\\360Chrome\\Chrome%" OR FileName like "%\\Comodo\\Dragon%" OR FileName like "%\\BraveSoftware\\Brave-Browser%" OR FileName like "%\\Torch%" OR FileName like "%\\UCBrowser\\%" OR FileName like "%\\Blisk%" OR FileName like "%\\Epic Privacy Browser%" OR FileName like "%\\Nichrome%" OR FileName like "%\\Amigo%" OR FileName like "%\\Kometa%" OR FileName like "%\\Xpom%" OR FileName like "%\\Microsoft\\Edge%" OR FileName like "%\\Liebao7Default\\EncryptedStorage%" OR FileName like "%\\AVAST Software\\Browser%" OR FileName like "%\\Kinza%" OR FileName like "%\\Mozilla\\SeaMonkey\\%" OR FileName like "%\\Comodo\\IceDragon\\%" OR FileName like "%\\8pecxstudios\\Cyberfox\\%" OR FileName like "%\\FlashPeak\\SlimBrowser\\%" OR FileName like "%\\Moonchild Productions\\Pale Moon\\%")) AND ((FileName like "%\\Profiles\\%" OR FileName like "%\\User Data%")) AND (((FileName like "%\\Login Data%" OR FileName like "%\\Cookies%" OR FileName like "%\\EncryptedStorage%" OR FileName like "%\\WebCache\\%")) OR ((FileName="*cert9.db" OR FileName="*cookies.sqlite" OR FileName="*formhistory.sqlite" OR FileName="*key3.db" OR FileName="*key4.db" OR FileName="*Login Data.sqlite" OR FileName="*logins.json" OR FileName="*places.sqlite")))) AND NOT ((((process.executable="C:\\Program Files\\*" OR process.executable="C:\\Program Files (x86)\\*" OR process.executable="C:\\Windows\\System32\\*" OR process.executable="C:\\Windows\\SysWOW64\\*")) OR ((process.executable="*\\Sputnik.exe" OR process.executable="*\\ChromePlus.exe" OR process.executable="*\\QIP Surf.exe" OR process.executable="*\\BlackHawk.exe" OR process.executable="*\\7Star.exe" OR process.executable="*\\Sleipnir5.exe" OR process.executable="*\\Citrio.exe" OR process.executable="*\\Chrome SxS.exe" OR process.executable="*\\Chrome.exe" OR process.executable="*\\Coowon.exe" OR process.executable="*\\CocCocBrowser.exe" OR process.executable="*\\Uran.exe" OR process.executable="*\\QQBrowser.exe" OR process.executable="*\\Orbitum.exe" OR process.executable="*\\Slimjet.exe" OR process.executable="*\\Iridium.exe" OR process.executable="*\\Vivaldi.exe" OR process.executable="*\\Chromium.exe" OR process.executable="*\\GhostBrowser.exe" OR process.executable="*\\CentBrowser.exe" OR process.executable="*\\Xvast.exe" OR process.executable="*\\Chedot.exe" OR process.executable="*\\SuperBird.exe" OR process.executable="*\\360Browser.exe" OR process.executable="*\\360Chrome.exe" OR process.executable="*\\dragon.exe" OR process.executable="*\\brave.exe" OR process.executable="*\\torch.exe" OR process.executable="*\\UCBrowser.exe" OR process.executable="*\\BliskBrowser.exe" OR process.executable="*\\Epic Privacy Browser.exe" OR process.executable="*\\nichrome.exe" OR process.executable="*\\AmigoBrowser.exe" OR process.executable="*\\KometaBrowser.exe" OR process.executable="*\\XpomBrowser.exe" OR process.executable="*\\msedge.exe" OR process.executable="*\\LiebaoBrowser.exe" OR process.executable="*\\AvastBrowser.exe" OR process.executable="*\\Kinza.exe" OR process.executable="*\\seamonkey.exe" OR process.executable="*\\icedragon.exe" OR process.executable="*\\cyberfox.exe" OR process.executable="*\\SlimBrowser.exe" OR process.executable="*\\palemoon.exe")) OR ((process.executable like "%\\Sputnik\\%" OR process.executable like "%\\MapleStudio\\%" OR process.executable like "%\\QIP Surf\\%" OR process.executable like "%\\BlackHawk\\%" OR process.executable like "%\\7Star\\%" OR process.executable like "%\\Fenrir Inc\\%" OR process.executable like "%\\CatalinaGroup\\%" OR process.executable like "%\\Google\\%" OR process.executable like "%\\Coowon\\%" OR process.executable like "%\\CocCoc\\%" OR process.executable like "%\\uCozMedia\\%" OR process.executable like "%\\Tencent\\%" OR process.executable like "%\\Orbitum\\%" OR process.executable like "%\\Slimjet\\%" OR process.executable like "%\\Iridium\\%" OR process.executable like "%\\Vivaldi\\%" OR process.executable like "%\\Chromium\\%" OR process.executable like "%\\GhostBrowser\\%" OR process.executable like "%\\CentBrowser\\%" OR process.executable like "%\\Xvast\\%" OR process.executable like "%\\Chedot\\%" OR process.executable like "%\\SuperBird\\%" OR process.executable like "%\\360Browser\\%" OR process.executable like "%\\360Chrome\\%" OR process.executable like "%\\Comodo\\%" OR process.executable like "%\\BraveSoftware\\%" OR process.executable like "%\\Torch\\%" OR process.executable like "%\\UCBrowser\\%" OR process.executable like "%\\Blisk\\%" OR process.executable like "%\\Epic Privacy Browser\\%" OR process.executable like "%\\Nichrome\\%" OR process.executable like "%\\Amigo\\%" OR process.executable like "%\\Kometa\\%" OR process.executable like "%\\Xpom\\%" OR process.executable like "%\\Microsoft\\%" OR process.executable like "%\\Liebao7\\%" OR process.executable like "%\\AVAST Software\\%" OR process.executable like "%\\Kinza\\%" OR process.executable like "%\\Mozilla\\%" OR process.executable like "%\\8pecxstudios\\%" OR process.executable like "%\\FlashPeak\\%" OR process.executable like "%\\Moonchild Productions\\%")) OR (process.executable = "System" AND process.parent.executable = "Idle"))) AND NOT (((process.executable like "%\\Microsoft\\Windows Defender\\%" AND (process.executable="*\\MpCopyAccelerator.exe" OR process.executable="*\\MsMpEng.exe")) OR (process.parent.executable = "C:\\Windows\\System32\\msiexec.exe") OR (process.executable="*\\everything.exe") OR ((process.executable="*\\thor.exe" OR process.executable="*\\thor64.exe")))))
