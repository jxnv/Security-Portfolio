// Title: Eventlog Cleared
// ID: a62b37e0-45d3-48d9-a517-90c1a1b0186b
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2017-01-10
// Tags: attack.defense-impairment, attack.t1685.005, car.2016-04-002
// Description: One of the Windows Eventlogs has been cleared. e.g. caused by "wevtutil cl" command execution
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((winlog.event_id = "104" AND winlog.provider_name = "Microsoft-Windows-Eventlog") AND NOT (((Channel = "Microsoft-Windows-PowerShell/Operational" OR Channel = "Microsoft-Windows-Sysmon/Operational" OR Channel = "PowerShellCore/Operational" OR Channel = "Security" OR Channel = "System" OR Channel = "Windows PowerShell"))))
