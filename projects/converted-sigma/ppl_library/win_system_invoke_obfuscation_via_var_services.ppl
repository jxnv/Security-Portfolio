// Title: Invoke-Obfuscation VAR++ LAUNCHER OBFUSCATION - System
// ID: 14bcba49-a428-42d9-b943-e2ce0f0f7ae6
// Status: test
// Level: high
// Author: Timur Zinniatullin, oscd.community
// Date: 2020-10-13
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via VAR++ LAUNCHER
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (winlog.provider_name = "Service Control Manager" AND winlog.event_id = "7045" AND (ImagePath like "%&&set%" AND ImagePath like "%cmd%" AND ImagePath like "%/c%" AND ImagePath like "%-f%") AND (ImagePath like "%{0}%" OR ImagePath like "%{1}%" OR ImagePath like "%{2}%" OR ImagePath like "%{3}%" OR ImagePath like "%{4}%" OR ImagePath like "%{5}%"))
