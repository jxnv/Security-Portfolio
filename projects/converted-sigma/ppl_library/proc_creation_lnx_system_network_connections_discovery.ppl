// Title: System Network Connections Discovery - Linux
// ID: 4c519226-f0cd-4471-bd2f-6fbb2bb68a79
// Status: test
// Level: low
// Author: Daniil Yugoslavskiy, oscd.community
// Date: 2020-10-19
// Tags: attack.discovery, attack.t1049
// Description: Detects usage of system utilities to discover system network connections
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.executable="*/who" OR process.executable="*/w" OR process.executable="*/last" OR process.executable="*/lsof" OR process.executable="*/netstat")) AND NOT ((process.parent.command_line like "%/usr/bin/landscape-sysinfo%" AND process.executable="*/who")))
