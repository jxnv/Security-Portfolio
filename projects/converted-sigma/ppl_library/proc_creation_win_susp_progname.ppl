// Title: Suspicious Program Names
// ID: efdd8dd5-cee8-4e59-9390-7d4d5e4dd6f6
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-11
// Tags: attack.execution, attack.t1059
// Description: Detects suspicious patterns in program names or folders that are often found in malicious samples or hacktools
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%inject.ps1%" OR process.command_line like "%Invoke-CVE%" OR process.command_line like "%pupy.ps1%" OR process.command_line like "%payload.ps1%" OR process.command_line like "%beacon.ps1%" OR process.command_line like "%PowerView.ps1%" OR process.command_line like "%bypass.ps1%" OR process.command_line like "%obfuscated.ps1%" OR process.command_line like "%obfusc.ps1%" OR process.command_line like "%obfus.ps1%" OR process.command_line like "%obfs.ps1%" OR process.command_line like "%evil.ps1%" OR process.command_line like "%MiniDogz.ps1%" OR process.command_line like "%_enc.ps1%" OR process.command_line like "%\\shell.ps1%" OR process.command_line like "%\\rshell.ps1%" OR process.command_line like "%revshell.ps1%" OR process.command_line like "%\\av.ps1%" OR process.command_line like "%\\av_test.ps1%" OR process.command_line like "%adrecon.ps1%" OR process.command_line like "%mimikatz.ps1%" OR process.command_line like "%\\PowerUp_%" OR process.command_line like "%powerup.ps1%" OR process.command_line like "%\\Temp\\a.ps1%" OR process.command_line like "%\\Temp\\p.ps1%" OR process.command_line like "%\\Temp\\1.ps1%" OR process.command_line like "%Hound.ps1%" OR process.command_line like "%encode.ps1%" OR process.command_line like "%powercat.ps1%")) OR (((process.executable like "%\\CVE-202%" OR process.executable like "%\\CVE202%")) OR ((process.executable="*\\poc.exe" OR process.executable="*\\artifact.exe" OR process.executable="*\\artifact64.exe" OR process.executable="*\\artifact_protected.exe" OR process.executable="*\\artifact32.exe" OR process.executable="*\\artifact32big.exe" OR process.executable="*obfuscated.exe" OR process.executable="*obfusc.exe" OR process.executable="*\\meterpreter"))))
