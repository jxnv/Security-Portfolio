// Title: Netsh Allow Group Policy on Microsoft Defender Firewall
// ID: 347906f3-e207-4d18-ae5b-a9403d6bcdef
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-01-09
// Tags: attack.defense-impairment, attack.t1686.003
// Description: Adversaries may modify system firewalls in order to bypass controls limiting network usage
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%advfirewall%" AND process.command_line like "%firewall%" AND process.command_line like "%set%" AND process.command_line like "%rule%" AND process.command_line like "%group=%" AND process.command_line like "%new%" AND process.command_line like "%enable=Yes%")) AND ((process.executable="*\\netsh.exe") OR (process.pe.original_file_name = "netsh.exe")))
