// Title: Potential PowerShell Execution Via DLL
// ID: 6812a10b-60ea-420c-832f-dfcc33b646ba
// Status: test
// Level: high
// Author: Markus Neis, Nasreddine Bencherchali (Nextron Systems)
// Date: 2018-08-25
// Tags: attack.stealth, attack.t1218.011
// Description: Detects potential PowerShell execution from a DLL instead of the usual PowerShell process as seen used in PowerShdll.
// This detection assumes that PowerShell commands are passed via the CommandLine.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%Default.GetString%" OR process.command_line like "%DownloadString%" OR process.command_line like "%FromBase64String%" OR process.command_line like "%ICM %" OR process.command_line like "%IEX %" OR process.command_line like "%Invoke-Command%" OR process.command_line like "%Invoke-Expression%")) AND (((process.executable="*\\InstallUtil.exe" OR process.executable="*\\RegAsm.exe" OR process.executable="*\\RegSvcs.exe" OR process.executable="*\\regsvr32.exe" OR process.executable="*\\rundll32.exe")) OR ((process.pe.original_file_name = "InstallUtil.exe" OR process.pe.original_file_name = "RegAsm.exe" OR process.pe.original_file_name = "RegSvcs.exe" OR process.pe.original_file_name = "REGSVR32.EXE" OR process.pe.original_file_name = "RUNDLL32.EXE"))))
