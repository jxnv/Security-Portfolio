// Title: Raccine Uninstall
// ID: a31eeaed-3fd5-478e-a8ba-e62c6b3f9ecc
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-01-21
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects commands that indicate a Raccine removal from an end system. Raccine is a free ransomware protection tool.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%taskkill %" AND process.command_line like "%RaccineSettings.exe%")) OR ((process.command_line like "%reg.exe%" AND process.command_line like "%delete%" AND process.command_line like "%Raccine Tray%")) OR ((process.command_line like "%schtasks%" AND process.command_line like "%/DELETE%" AND process.command_line like "%Raccine Rules Updater%")))
