// Title: Potential SysInternals ProcDump Evasion
// ID: 79b06761-465f-4f88-9ef2-150e24d3d737
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-01-11
// Tags: attack.stealth, attack.t1036, attack.t1003.001, attack.credential-access
// Description: Detects uses of the SysInternals ProcDump utility in which ProcDump or its output get renamed, or a dump file is moved or copied to a different name
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%copy procdump%" OR process.command_line like "%move procdump%")) OR ((process.command_line like "%copy %" AND process.command_line like "%.dmp %") AND (process.command_line like "%2.dmp%" OR process.command_line like "%lsass%" OR process.command_line like "%out.dmp%")) OR ((process.command_line like "%copy lsass.exe_%" OR process.command_line like "%move lsass.exe_%")))
