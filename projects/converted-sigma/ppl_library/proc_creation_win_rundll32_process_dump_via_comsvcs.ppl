// Title: Process Memory Dump Via Comsvcs.DLL
// ID: 646ea171-dded-4578-8a4d-65e9822892e3
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Modexp, Nasreddine Bencherchali (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2020-02-18
// Tags: attack.credential-access, attack.stealth, attack.t1036, attack.t1003.001, car.2013-05-009
// Description: Detects a process memory dump via "comsvcs.dll" using rundll32, covering multiple different techniques (ordinal, minidump function, etc.)
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.executable="*\\rundll32.exe") OR (process.pe.original_file_name = "RUNDLL32.EXE") OR (process.command_line like "%rundll32%")) AND ((process.command_line like "%comsvcs%" AND process.command_line like "%full%") AND (process.command_line like "%#-%" OR process.command_line like "%#+%" OR process.command_line like "%#24%" OR process.command_line like "%24 %" OR process.command_line like "%MiniDump%" OR process.command_line like "%#65560%"))) OR ((process.command_line like "%24%" AND process.command_line like "%comsvcs%" AND process.command_line like "%full%") AND (process.command_line like "% #%" OR process.command_line like "%,#%" OR process.command_line like "%, #%" OR process.command_line like "%\"#%")))
