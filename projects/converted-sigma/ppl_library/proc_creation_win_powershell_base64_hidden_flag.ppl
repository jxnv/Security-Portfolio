// Title: Malicious Base64 Encoded PowerShell Keywords in Command Lines
// ID: f26c6093-6f14-4b12-800f-0fcb46f5ffd0
// Status: test
// Level: high
// Author: John Lambert (rule)
// Date: 2019-01-16
// Tags: attack.execution, attack.t1059.001
// Description: Detects base64 encoded strings used in hidden malicious PowerShell command lines
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%AGkAdABzAGEAZABtAGkAbgAgAC8AdAByAGEAbgBzAGYAZQByA%" OR process.command_line like "%aXRzYWRtaW4gL3RyYW5zZmVy%" OR process.command_line like "%IAaQB0AHMAYQBkAG0AaQBuACAALwB0AHIAYQBuAHMAZgBlAHIA%" OR process.command_line like "%JpdHNhZG1pbiAvdHJhbnNmZX%" OR process.command_line like "%YgBpAHQAcwBhAGQAbQBpAG4AIAAvAHQAcgBhAG4AcwBmAGUAcg%" OR process.command_line like "%Yml0c2FkbWluIC90cmFuc2Zlc%" OR process.command_line like "%AGMAaAB1AG4AawBfAHMAaQB6AGUA%" OR process.command_line like "%JABjAGgAdQBuAGsAXwBzAGkAegBlA%" OR process.command_line like "%JGNodW5rX3Npem%" OR process.command_line like "%QAYwBoAHUAbgBrAF8AcwBpAHoAZQ%" OR process.command_line like "%RjaHVua19zaXpl%" OR process.command_line like "%Y2h1bmtfc2l6Z%" OR process.command_line like "%AE8ALgBDAG8AbQBwAHIAZQBzAHMAaQBvAG4A%" OR process.command_line like "%kATwAuAEMAbwBtAHAAcgBlAHMAcwBpAG8Abg%" OR process.command_line like "%lPLkNvbXByZXNzaW9u%" OR process.command_line like "%SQBPAC4AQwBvAG0AcAByAGUAcwBzAGkAbwBuA%" OR process.command_line like "%SU8uQ29tcHJlc3Npb2%" OR process.command_line like "%Ty5Db21wcmVzc2lvb%" OR process.command_line like "%AE8ALgBNAGUAbQBvAHIAeQBTAHQAcgBlAGEAbQ%" OR process.command_line like "%kATwAuAE0AZQBtAG8AcgB5AFMAdAByAGUAYQBtA%" OR process.command_line like "%lPLk1lbW9yeVN0cmVhb%" OR process.command_line like "%SQBPAC4ATQBlAG0AbwByAHkAUwB0AHIAZQBhAG0A%" OR process.command_line like "%SU8uTWVtb3J5U3RyZWFt%" OR process.command_line like "%Ty5NZW1vcnlTdHJlYW%" OR process.command_line like "%4ARwBlAHQAQwBoAHUAbgBrA%" OR process.command_line like "%5HZXRDaHVua%" OR process.command_line like "%AEcAZQB0AEMAaAB1AG4Aaw%" OR process.command_line like "%LgBHAGUAdABDAGgAdQBuAGsA%" OR process.command_line like "%LkdldENodW5r%" OR process.command_line like "%R2V0Q2h1bm%" OR process.command_line like "%AEgAUgBFAEEARABfAEkATgBGAE8ANgA0A%" OR process.command_line like "%QASABSAEUAQQBEAF8ASQBOAEYATwA2ADQA%" OR process.command_line like "%RIUkVBRF9JTkZPNj%" OR process.command_line like "%SFJFQURfSU5GTzY0%" OR process.command_line like "%VABIAFIARQBBAEQAXwBJAE4ARgBPADYANA%" OR process.command_line like "%VEhSRUFEX0lORk82N%" OR process.command_line like "%AHIAZQBhAHQAZQBSAGUAbQBvAHQAZQBUAGgAcgBlAGEAZA%" OR process.command_line like "%cmVhdGVSZW1vdGVUaHJlYW%" OR process.command_line like "%MAcgBlAGEAdABlAFIAZQBtAG8AdABlAFQAaAByAGUAYQBkA%" OR process.command_line like "%NyZWF0ZVJlbW90ZVRocmVhZ%" OR process.command_line like "%Q3JlYXRlUmVtb3RlVGhyZWFk%" OR process.command_line like "%QwByAGUAYQB0AGUAUgBlAG0AbwB0AGUAVABoAHIAZQBhAGQA%" OR process.command_line like "%0AZQBtAG0AbwB2AGUA%" OR process.command_line like "%1lbW1vdm%" OR process.command_line like "%AGUAbQBtAG8AdgBlA%" OR process.command_line like "%bQBlAG0AbQBvAHYAZQ%" OR process.command_line like "%bWVtbW92Z%" OR process.command_line like "%ZW1tb3Zl%")) AND (process.command_line like "% hidden %") AND (((process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe")) OR ((process.pe.original_file_name = "PowerShell.EXE" OR process.pe.original_file_name = "pwsh.dll"))))
