// Title: Sticky Key Like Backdoor Execution
// ID: 2fdefcb3-dbda-401e-ae23-f0db027628bc
// Status: test
// Level: critical
// Author: Florian Roth (Nextron Systems), @twjackomo, Jonhnathan Ribeiro, oscd.community
// Date: 2018-03-15
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.008, car.2014-11-003, car.2014-11-008
// Description: Detects the usage and installation of a backdoor that uses an option to register a malicious debugger for built-in tools that are accessible in the login screen
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (process.parent.executable="*\\winlogon.exe" AND (process.executable="*\\cmd.exe" OR process.executable="*\\cscript.exe" OR process.executable="*\\mshta.exe" OR process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe" OR process.executable="*\\regsvr32.exe" OR process.executable="*\\rundll32.exe" OR process.executable="*\\wscript.exe" OR process.executable="*\\wt.exe") AND (process.command_line like "%sethc.exe%" OR process.command_line like "%utilman.exe%" OR process.command_line like "%osk.exe%" OR process.command_line like "%Magnify.exe%" OR process.command_line like "%Narrator.exe%" OR process.command_line like "%DisplaySwitch.exe%"))
