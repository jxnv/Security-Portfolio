// Title: PUA - Netcat Suspicious Execution
// ID: e31033fc-33f0-4020-9a16-faf9b31cbf08
// Status: test
// Level: high
// Author: frack113, Florian Roth (Nextron Systems)
// Date: 2021-07-21
// Tags: attack.command-and-control, attack.t1095
// Description: Detects execution of Netcat. Adversaries may use a non-application layer protocol for communication between host and C2 server or among infected hosts within a network
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "% -lvp %" OR process.command_line like "% -lvnp%" OR process.command_line like "% -l -v -p %" OR process.command_line like "% -lv -p %" OR process.command_line like "% -l --proxy-type http %" OR process.command_line like "% -vnl --exec %" OR process.command_line like "% -vnl -e %" OR process.command_line like "% --lua-exec %" OR process.command_line like "% --sh-exec %")) OR ((process.executable="*\\nc.exe" OR process.executable="*\\ncat.exe" OR process.executable="*\\netcat.exe")))
