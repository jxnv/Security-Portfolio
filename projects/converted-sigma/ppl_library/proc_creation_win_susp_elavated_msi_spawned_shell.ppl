// Title: Always Install Elevated MSI Spawned Cmd And Powershell
// ID: 1e53dd56-8d83-4eb4-a43e-b790a05510aa
// Status: test
// Level: medium
// Author: Teymur Kheirkhabarov (idea), Mangatas Tondang (rule), oscd.community
// Date: 2020-10-13
// Tags: attack.privilege-escalation, attack.t1548.002
// Description: Detects Windows Installer service (msiexec.exe) spawning "cmd" or "powershell"
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.executable="*\\cmd.exe" OR process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe")) OR ((process.pe.original_file_name = "Cmd.Exe" OR process.pe.original_file_name = "PowerShell.EXE" OR process.pe.original_file_name = "pwsh.dll"))) AND ((process.parent.executable like "%\\Windows\\Installer\\%" AND process.parent.executable like "%msi%") AND process.parent.executable="*tmp"))
