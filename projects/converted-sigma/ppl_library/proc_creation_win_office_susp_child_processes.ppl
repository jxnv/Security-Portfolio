// Title: Suspicious Microsoft Office Child Process
// ID: 438025f9-5856-4663-83f7-52f878a70a50
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Markus Neis, FPT.EagleEye Team, Vadim Khrykov, Cyb3rEng, Michael Haag, Christopher Peacock @securepeacock, @scythe_io
// Date: 2018-04-06
// Tags: attack.execution, attack.stealth, attack.t1047, attack.t1204.002, attack.t1218.010
// Description: Detects a suspicious process spawning from one of the Microsoft Office suite products (Word, Excel, PowerPoint, Publisher, Visio, etc.)
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.parent.executable="*\\EQNEDT32.EXE" OR process.parent.executable="*\\EXCEL.EXE" OR process.parent.executable="*\\MSACCESS.EXE" OR process.parent.executable="*\\MSPUB.exe" OR process.parent.executable="*\\ONENOTE.EXE" OR process.parent.executable="*\\POWERPNT.exe" OR process.parent.executable="*\\VISIO.exe" OR process.parent.executable="*\\WINWORD.EXE" OR process.parent.executable="*\\wordpad.exe" OR process.parent.executable="*\\wordview.exe")) AND ((((process.pe.original_file_name = "bitsadmin.exe" OR process.pe.original_file_name = "CertOC.exe" OR process.pe.original_file_name = "CertUtil.exe" OR process.pe.original_file_name = "Cmd.Exe" OR process.pe.original_file_name = "CMSTP.EXE" OR process.pe.original_file_name = "cscript.exe" OR process.pe.original_file_name = "curl.exe" OR process.pe.original_file_name = "HH.exe" OR process.pe.original_file_name = "IEExec.exe" OR process.pe.original_file_name = "InstallUtil.exe" OR process.pe.original_file_name = "javaw.exe" OR process.pe.original_file_name = "Microsoft.Workflow.Compiler.exe" OR process.pe.original_file_name = "msdt.exe" OR process.pe.original_file_name = "MSHTA.EXE" OR process.pe.original_file_name = "msiexec.exe" OR process.pe.original_file_name = "Msxsl.exe" OR process.pe.original_file_name = "odbcconf.exe" OR process.pe.original_file_name = "pcalua.exe" OR process.pe.original_file_name = "PowerShell.EXE" OR process.pe.original_file_name = "RegAsm.exe" OR process.pe.original_file_name = "RegSvcs.exe" OR process.pe.original_file_name = "REGSVR32.exe" OR process.pe.original_file_name = "RUNDLL32.exe" OR process.pe.original_file_name = "schtasks.exe" OR process.pe.original_file_name = "ScriptRunner.exe" OR process.pe.original_file_name = "wmic.exe" OR process.pe.original_file_name = "WorkFolders.exe" OR process.pe.original_file_name = "wscript.exe")) OR ((process.executable="*\\AppVLP.exe" OR process.executable="*\\bash.exe" OR process.executable="*\\bitsadmin.exe" OR process.executable="*\\certoc.exe" OR process.executable="*\\certutil.exe" OR process.executable="*\\cmd.exe" OR process.executable="*\\cmstp.exe" OR process.executable="*\\control.exe" OR process.executable="*\\cscript.exe" OR process.executable="*\\curl.exe" OR process.executable="*\\forfiles.exe" OR process.executable="*\\hh.exe" OR process.executable="*\\ieexec.exe" OR process.executable="*\\installutil.exe" OR process.executable="*\\javaw.exe" OR process.executable="*\\mftrace.exe" OR process.executable="*\\Microsoft.Workflow.Compiler.exe" OR process.executable="*\\msbuild.exe" OR process.executable="*\\msdt.exe" OR process.executable="*\\mshta.exe" OR process.executable="*\\msidb.exe" OR process.executable="*\\msiexec.exe" OR process.executable="*\\msxsl.exe" OR process.executable="*\\odbcconf.exe" OR process.executable="*\\pcalua.exe" OR process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe" OR process.executable="*\\regasm.exe" OR process.executable="*\\regsvcs.exe" OR process.executable="*\\regsvr32.exe" OR process.executable="*\\rundll32.exe" OR process.executable="*\\schtasks.exe" OR process.executable="*\\scrcons.exe" OR process.executable="*\\scriptrunner.exe" OR process.executable="*\\sh.exe" OR process.executable="*\\svchost.exe" OR process.executable="*\\verclsid.exe" OR process.executable="*\\wmic.exe" OR process.executable="*\\workfolders.exe" OR process.executable="*\\wscript.exe"))) OR ((process.executable like "%\\AppData\\%" OR process.executable like "%\\Users\\Public\\%" OR process.executable like "%\\ProgramData\\%" OR process.executable like "%\\Windows\\Tasks\\%" OR process.executable like "%\\Windows\\Temp\\%" OR process.executable like "%\\Windows\\System32\\Tasks\\%"))))
