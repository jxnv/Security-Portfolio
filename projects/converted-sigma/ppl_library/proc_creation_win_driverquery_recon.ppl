// Title: Potential Recon Activity Using DriverQuery.EXE
// ID: 9fc3072c-dc8f-4bf7-b231-18950000fadd
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-19
// Tags: attack.discovery
// Description: Detect usage of the "driverquery" utility to perform reconnaissance on installed drivers
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.executable="*driverquery.exe") OR (process.pe.original_file_name = "drvqry.exe")) AND (((process.parent.executable="*\\cscript.exe" OR process.parent.executable="*\\mshta.exe" OR process.parent.executable="*\\regsvr32.exe" OR process.parent.executable="*\\rundll32.exe" OR process.parent.executable="*\\wscript.exe")) OR ((process.parent.executable like "%\\AppData\\Local\\%" OR process.parent.executable like "%\\Users\\Public\\%" OR process.parent.executable like "%\\Windows\\Temp\\%"))))
