// Title: Powershell Base64 Encoded MpPreference Cmdlet
// ID: c6fb44c6-71f5-49e6-9462-1425d328aee3
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-04
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects base64 encoded "MpPreference" PowerShell cmdlet code that tries to modifies or tamper with Windows Defender AV
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%QWRkLU1wUHJlZmVyZW5jZS%" OR process.command_line like "%FkZC1NcFByZWZlcmVuY2Ug%" OR process.command_line like "%BZGQtTXBQcmVmZXJlbmNlI%" OR process.command_line like "%U2V0LU1wUHJlZmVyZW5jZS%" OR process.command_line like "%NldC1NcFByZWZlcmVuY2Ug%" OR process.command_line like "%TZXQtTXBQcmVmZXJlbmNlI%" OR process.command_line like "%YWRkLW1wcHJlZmVyZW5jZS%" OR process.command_line like "%FkZC1tcHByZWZlcmVuY2Ug%" OR process.command_line like "%hZGQtbXBwcmVmZXJlbmNlI%" OR process.command_line like "%c2V0LW1wcHJlZmVyZW5jZS%" OR process.command_line like "%NldC1tcHByZWZlcmVuY2Ug%" OR process.command_line like "%zZXQtbXBwcmVmZXJlbmNlI%")) OR ((process.command_line like "%QQBkAGQALQBNAHAAUAByAGUAZgBlAHIAZQBuAGMAZQAgA%" OR process.command_line like "%EAZABkAC0ATQBwAFAAcgBlAGYAZQByAGUAbgBjAGUAIA%" OR process.command_line like "%BAGQAZAAtAE0AcABQAHIAZQBmAGUAcgBlAG4AYwBlACAA%" OR process.command_line like "%UwBlAHQALQBNAHAAUAByAGUAZgBlAHIAZQBuAGMAZQAgA%" OR process.command_line like "%MAZQB0AC0ATQBwAFAAcgBlAGYAZQByAGUAbgBjAGUAIA%" OR process.command_line like "%TAGUAdAAtAE0AcABQAHIAZQBmAGUAcgBlAG4AYwBlACAA%" OR process.command_line like "%YQBkAGQALQBtAHAAcAByAGUAZgBlAHIAZQBuAGMAZQAgA%" OR process.command_line like "%EAZABkAC0AbQBwAHAAcgBlAGYAZQByAGUAbgBjAGUAIA%" OR process.command_line like "%hAGQAZAAtAG0AcABwAHIAZQBmAGUAcgBlAG4AYwBlACAA%" OR process.command_line like "%cwBlAHQALQBtAHAAcAByAGUAZgBlAHIAZQBuAGMAZQAgA%" OR process.command_line like "%MAZQB0AC0AbQBwAHAAcgBlAGYAZQByAGUAbgBjAGUAIA%" OR process.command_line like "%zAGUAdAAtAG0AcABwAHIAZQBmAGUAcgBlAG4AYwBlACAA%")))
