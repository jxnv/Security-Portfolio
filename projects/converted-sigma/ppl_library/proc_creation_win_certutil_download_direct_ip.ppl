// Title: Suspicious File Downloaded From Direct IP Via Certutil.EXE
// ID: 13e6fe51-d478-4c7e-b0f2-6da9b400a829
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-15
// Tags: attack.stealth, attack.t1027, attack.command-and-control, attack.t1105
// Description: Detects the execution of certutil with certain flags that allow the utility to download files from direct IPs.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.command_line like "%urlcache %" OR process.command_line like "%verifyctl %" OR process.command_line like "%URL %")) AND ((process.command_line like "%://1%" OR process.command_line like "%://2%" OR process.command_line like "%://3%" OR process.command_line like "%://4%" OR process.command_line like "%://5%" OR process.command_line like "%://6%" OR process.command_line like "%://7%" OR process.command_line like "%://8%" OR process.command_line like "%://9%")) AND ((process.executable="*\\certutil.exe") OR (process.pe.original_file_name = "CertUtil.exe"))) AND NOT ((process.command_line like "%://7-%")))
