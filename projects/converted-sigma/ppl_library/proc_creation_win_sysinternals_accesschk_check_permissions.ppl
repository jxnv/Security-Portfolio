// Title: Permission Check Via Accesschk.EXE
// ID: c625d754-6a3d-4f65-9c9a-536aea960d37
// Status: test
// Level: medium
// Author: Teymur Kheirkhabarov (idea), Mangatas Tondang, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2020-10-13
// Tags: attack.discovery, attack.t1069.001
// Description: Detects the usage of the "Accesschk" utility, an access and privilege audit tool developed by SysInternal and often being abused by attacker to verify process privileges
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%uwcqv %" OR process.command_line like "%kwsu %" OR process.command_line like "%qwsu %" OR process.command_line like "%uwdqs %")) AND ((Product="*AccessChk") OR (Description like "%Reports effective permissions%") OR ((process.executable="*\\accesschk.exe" OR process.executable="*\\accesschk64.exe" OR process.executable="*\\accesschk64a.exe")) OR (process.pe.original_file_name = "accesschk.exe")))
