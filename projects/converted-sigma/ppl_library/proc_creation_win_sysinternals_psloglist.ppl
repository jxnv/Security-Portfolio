// Title: Suspicious Use of PsLogList
// ID: aae1243f-d8af-40d8-ab20-33fc6d0c55bc
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-12-18
// Tags: attack.discovery, attack.t1087, attack.t1087.001, attack.t1087.002
// Description: Detects usage of the PsLogList utility to dump event log in order to extract admin accounts and perform account discovery or delete events logs
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "% security%" OR process.command_line like "% application%" OR process.command_line like "% system%")) AND ((process.command_line like "% -d%" OR process.command_line like "% -x%" OR process.command_line like "% -s%" OR process.command_line like "% -c%" OR process.command_line like "% -g%")) AND ((process.pe.original_file_name = "psloglist.exe") OR ((process.executable="*\\psloglist.exe" OR process.executable="*\\psloglist64.exe" OR process.executable="*\\psloglist64a.exe"))))
