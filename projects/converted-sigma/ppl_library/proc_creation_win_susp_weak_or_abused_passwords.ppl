// Title: Weak or Abused Passwords In CLI
// ID: 91edcfb1-2529-4ac2-9ecc-7617f895c7e4
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-14
// Tags: attack.execution, attack.stealth
// Description: Detects weak passwords or often abused passwords (seen used by threat actors) via the CLI.
// An example would be a threat actor creating a new user via the net command and providing the password inline
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.command_line like "%123456789%" OR process.command_line like "%123123qwE%" OR process.command_line like "%Asd123.aaaa%" OR process.command_line like "%Decryptme%" OR process.command_line like "%P@ssw0rd!%" OR process.command_line like "%Pass8080%" OR process.command_line like "%password123%" OR process.command_line like "%test@202%"))
