// Title: Python Initiated Connection
// ID: bef0bc5a-b9ae-425d-85c6-7b2d705980c6
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-12-10
// Tags: attack.discovery, attack.t1046
// Description: Detects a Python process initiating a network connection. While this often relates to package installation, it can also indicate a potential malicious script communicating with a C&C server.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((Initiated = "true" AND (process.executable like "%\\python%" AND process.executable like "%.exe%")) AND NOT (((destination.ip = "127.0.0.1" AND source.ip = "127.0.0.1") OR ((process.command_line like "%pip.exe%" AND process.command_line like "%install%")))) AND NOT (((process.parent.executable = "C:\\ProgramData\\Anaconda3\\Scripts\\conda.exe" AND (process.command_line like "%:\\ProgramData\\Anaconda3\\Scripts\\conda-script.py%" AND process.command_line like "%update%")) OR (process.parent.executable = "C:\\ProgramData\\Anaconda3\\python.exe" AND process.command_line like "%C:\\ProgramData\\Anaconda3\\Scripts\\jupyter-notebook-script.py%"))))
