// Title: Suspicious Download From File-Sharing Website Via Bitsadmin
// ID: 8518ed3d-f7c9-4601-a26c-f361a4256a0c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-06-28
// Tags: attack.persistence, attack.execution, attack.stealth, attack.t1197, attack.s0190, attack.t1036.003, attack.command-and-control, attack.t1105
// Description: Detects usage of bitsadmin downloading a file from a suspicious domain
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%.githubusercontent.com%" OR process.command_line like "%0x0.st%" OR process.command_line like "%anonfiles.com%" OR process.command_line like "%bashupload.com%" OR process.command_line like "%cdn.discordapp.com%" OR process.command_line like "%chunk.io%" OR process.command_line like "%ddns.net%" OR process.command_line like "%dl.dropboxusercontent.com%" OR process.command_line like "%ghostbin.co%" OR process.command_line like "%github.com%" OR process.command_line like "%glitch.me%" OR process.command_line like "%gofile.io%" OR process.command_line like "%hastebin.com%" OR process.command_line like "%mediafire.com%" OR process.command_line like "%mega.nz%" OR process.command_line like "%onrender.com%" OR process.command_line like "%pages.dev%" OR process.command_line like "%paste.ee%" OR process.command_line like "%pastebin.com%" OR process.command_line like "%pastebin.pl%" OR process.command_line like "%pastetext.net%" OR process.command_line like "%privatlab.com%" OR process.command_line like "%privatlab.net%" OR process.command_line like "%send.exploit.in%" OR process.command_line like "%sendspace.com%" OR process.command_line like "%storage.googleapis.com%" OR process.command_line like "%storjshare.io%" OR process.command_line like "%supabase.co%" OR process.command_line like "%temp.sh%" OR process.command_line like "%transfer.sh%" OR process.command_line like "%trycloudflare.com%" OR process.command_line like "%ufile.io%" OR process.command_line like "%w3spaces.com%" OR process.command_line like "%workers.dev%" OR process.command_line like "%x0.at%")) AND ((process.command_line like "% /transfer %" OR process.command_line like "% /create %" OR process.command_line like "% /addfile %")) AND ((process.executable="*\\bitsadmin.exe") OR (process.pe.original_file_name = "bitsadmin.exe")))
