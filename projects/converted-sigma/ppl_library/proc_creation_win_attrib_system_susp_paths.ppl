// Title: Set Suspicious Files as System Files Using Attrib.EXE
// ID: efec536f-72e8-4656-8960-5e85d091345b
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-28
// Tags: attack.stealth, attack.t1564.001
// Description: Detects the usage of attrib with the "+s" option to set scripts or executables located in suspicious locations as system files to hide them from users and make them unable to be deleted with simple rights. The rule limits the search to specific extensions and directories to avoid FPs
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "% +s%") AND ((process.command_line like "%.bat%" OR process.command_line like "%.dll%" OR process.command_line like "%.exe%" OR process.command_line like "%.hta%" OR process.command_line like "%.ps1%" OR process.command_line like "%.vbe%" OR process.command_line like "%.vbs%")) AND ((process.executable="*\\attrib.exe") OR (process.pe.original_file_name = "ATTRIB.EXE")) AND ((process.command_line like "% %%" OR process.command_line like "%\\Users\\Public\\%" OR process.command_line like "%\\AppData\\Local\\%" OR process.command_line like "%\\ProgramData\\%" OR process.command_line like "%\\Downloads\\%" OR process.command_line like "%\\Windows\\Temp\\%"))) AND NOT (((process.command_line like "%\\Windows\\TEMP\\%" AND process.command_line like "%.exe%"))))
