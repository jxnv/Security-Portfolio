// Title: Potentially Suspicious NTFS Symlink Behavior Modification
// ID: c0b2768a-dd06-4671-8339-b16ca8d1f27f
// Status: test
// Level: medium
// Author: frack113, The DFIR Report
// Date: 2022-03-02
// Tags: attack.execution, attack.defense-impairment, attack.t1059, attack.t1222.001
// Description: Detects the modification of NTFS symbolic link behavior using fsutil, which could be used to enable remote to local or remote to remote symlinks for potential attacks.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%fsutil%" AND process.command_line like "%behavior%" AND process.command_line like "%set%" AND process.command_line like "%SymlinkEvaluation%")) AND (((process.executable="*\\cmd.exe" OR process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe")) OR ((process.pe.original_file_name = "Cmd.Exe" OR process.pe.original_file_name = "PowerShell.EXE" OR process.pe.original_file_name = "pwsh.dll"))) AND ((process.command_line like "%R2L:1%" OR process.command_line like "%R2R:1%" OR process.command_line like "%L2L:1%")))
