source = logs-* | where ((ScriptBlockText like "%Invoke-DNSExfiltrator%") OR ((ScriptBlockText like "% -i %" AND ScriptBlockText like "% -d %" AND ScriptBlockText like "% -p %" AND ScriptBlockText like "% -doh %" AND ScriptBlockText like "% -t %")))
