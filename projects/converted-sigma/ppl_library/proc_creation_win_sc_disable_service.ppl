// Title: Service StartupType Change Via Sc.EXE
// ID: 85c312b7-f44d-4a51-a024-d671c40b49fc
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-01
// Tags: attack.execution, attack.defense-impairment, attack.t1685
// Description: Detect the use of "sc.exe" to change the startup type of a service to "disabled" or "demand"
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "% config %" AND process.command_line like "%start%") AND (process.command_line like "%disabled%" OR process.command_line like "%demand%")) AND ((process.executable="*\\sc.exe") OR (process.pe.original_file_name = "sc.exe")))
