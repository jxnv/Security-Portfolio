// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects the presence and execution of Inveigh via dropped artefacts
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((file.path="*\\Inveigh-Log.txt" OR file.path="*\\Inveigh-Cleartext.txt" OR file.path="*\\Inveigh-NTLMv1Users.txt" OR file.path="*\\Inveigh-NTLMv2Users.txt" OR file.path="*\\Inveigh-NTLMv1.txt" OR file.path="*\\Inveigh-NTLMv2.txt" OR file.path="*\\Inveigh-FormInput.txt" OR file.path="*\\Inveigh.dll" OR file.path="*\\Inveigh.exe" OR file.path="*\\Inveigh.ps1" OR file.path="*\\Inveigh-Relay.ps1"))
