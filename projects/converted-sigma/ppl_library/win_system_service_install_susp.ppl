// Title: Suspicious Service Installation
// ID: 1d61f71d-59d2-479e-9562-4ff5f4ead16b
// Status: test
// Level: high
// Author: pH-T (Nextron Systems), Florian Roth (Nextron Systems)
// Date: 2022-03-18
// Tags: attack.persistence, attack.privilege-escalation, car.2013-09-005, attack.t1543.003
// Description: Detects suspicious service installation commands
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (winlog.provider_name = "Service Control Manager" AND winlog.event_id = "7045" AND (ImagePath like "% -nop %" OR ImagePath like "% -sta %" OR ImagePath like "% -w hidden %" OR ImagePath like "%:\\Temp\\%" OR ImagePath like "%.downloadfile(%" OR ImagePath like "%.downloadstring(%" OR ImagePath like "%\\ADMIN$\\%" OR ImagePath like "%\\Perflogs\\%" OR ImagePath like "%&&%"))
