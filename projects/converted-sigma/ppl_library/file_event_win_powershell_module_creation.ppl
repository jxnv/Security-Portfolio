// Title: PowerShell Module File Created
// ID: e36941d0-c0f0-443f-bc6f-cb2952eb69ea
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-09
// Tags: attack.persistence
// Description: Detects the creation of a new PowerShell module ".psm1", ".psd1", ".dll", ".ps1", etc.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe") AND (file.path like "%\\WindowsPowerShell\\Modules\\%" OR file.path like "%\\PowerShell\\7\\Modules\\%"))
