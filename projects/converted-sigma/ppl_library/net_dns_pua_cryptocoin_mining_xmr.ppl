// Title: Monero Crypto Coin Mining Pool Lookup
// ID: b593fd50-7335-4682-a36c-4edcb68e4641
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-10-24
// Tags: attack.impact, attack.t1496, attack.exfiltration, attack.t1567
// Description: Detects suspicious DNS queries to Monero mining pools
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((query like "%pool.minexmr.com%" OR query like "%fr.minexmr.com%" OR query like "%de.minexmr.com%" OR query like "%sg.minexmr.com%" OR query like "%ca.minexmr.com%" OR query like "%us-west.minexmr.com%" OR query like "%pool.supportxmr.com%" OR query like "%mine.c3pool.com%" OR query like "%xmr-eu1.nanopool.org%" OR query like "%xmr-eu2.nanopool.org%" OR query like "%xmr-us-east1.nanopool.org%" OR query like "%xmr-us-west1.nanopool.org%" OR query like "%xmr-asia1.nanopool.org%" OR query like "%xmr-jp1.nanopool.org%" OR query like "%xmr-au1.nanopool.org%" OR query like "%xmr.2miners.com%" OR query like "%xmr.hashcity.org%" OR query like "%xmr.f2pool.com%" OR query like "%xmrpool.eu%" OR query like "%pool.hashvault.pro%"))
