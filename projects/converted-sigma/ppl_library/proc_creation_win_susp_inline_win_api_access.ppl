// Title: Potential WinAPI Calls Via CommandLine
// ID: ba3f5c1b-6272-4119-9dbd-0bc8d21c2702
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-06
// Tags: attack.execution, attack.t1106
// Description: Detects the use of WinAPI Functions via the commandline. As seen used by threat actors via the tool winapiexec
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%AddSecurityPackage%" OR process.command_line like "%AdjustTokenPrivileges%" OR process.command_line like "%Advapi32%" OR process.command_line like "%CloseHandle%" OR process.command_line like "%CreateProcessWithToken%" OR process.command_line like "%CreatePseudoConsole%" OR process.command_line like "%CreateRemoteThread%" OR process.command_line like "%CreateThread%" OR process.command_line like "%CreateUserThread%" OR process.command_line like "%DangerousGetHandle%" OR process.command_line like "%DuplicateTokenEx%" OR process.command_line like "%EnumerateSecurityPackages%" OR process.command_line like "%FreeHGlobal%" OR process.command_line like "%FreeLibrary%" OR process.command_line like "%GetDelegateForFunctionPointer%" OR process.command_line like "%GetLogonSessionData%" OR process.command_line like "%GetModuleHandle%" OR process.command_line like "%GetProcAddress%" OR process.command_line like "%GetProcessHandle%" OR process.command_line like "%GetTokenInformation%" OR process.command_line like "%ImpersonateLoggedOnUser%" OR process.command_line like "%kernel32%" OR process.command_line like "%LoadLibrary%" OR process.command_line like "%memcpy%" OR process.command_line like "%MiniDumpWriteDump%" OR process.command_line like "%ntdll%" OR process.command_line like "%OpenDesktop%" OR process.command_line like "%OpenProcess%" OR process.command_line like "%OpenProcessToken%" OR process.command_line like "%OpenThreadToken%" OR process.command_line like "%OpenWindowStation%" OR process.command_line like "%PtrToString%" OR process.command_line like "%QueueUserApc%" OR process.command_line like "%ReadProcessMemory%" OR process.command_line like "%RevertToSelf%" OR process.command_line like "%RtlCreateUserThread%" OR process.command_line like "%secur32%" OR process.command_line like "%SetThreadToken%" OR process.command_line like "%VirtualAlloc%" OR process.command_line like "%VirtualFree%" OR process.command_line like "%VirtualProtect%" OR process.command_line like "%WaitForSingleObject%" OR process.command_line like "%WriteInt32%" OR process.command_line like "%WriteProcessMemory%" OR process.command_line like "%ZeroFreeGlobalAllocUnicode%")) AND NOT (((process.parent.executable="*\\CompatTelRunner.exe" AND (process.command_line like "%FreeHGlobal%" OR process.command_line like "%PtrToString%" OR process.command_line like "%kernel32%" OR process.command_line like "%CloseHandle%")) OR (process.executable="*\\MpCmdRun.exe" AND process.command_line like "%GetLoadLibraryWAddress32%"))))
