// Title: Service Startup Type Change Via Wmic.EXE
// ID: c0514f28-fdae-42df-b886-06e2b2bc5b37
// Status: experimental
// Level: medium
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-04-27
// Tags: attack.execution, attack.defense-impairment, attack.t1047, attack.t1685
// Description: Detects changes to service startup type to 'disabled' or 'manual' using the WMIC command-line utility.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "% service %" AND process.command_line like "%ChangeStartMode%") AND (process.command_line like "%Manual%" OR process.command_line like "%Disabled%")) AND ((process.executable="*\\WMIC.exe") OR (process.pe.original_file_name = "wmic.exe")))
