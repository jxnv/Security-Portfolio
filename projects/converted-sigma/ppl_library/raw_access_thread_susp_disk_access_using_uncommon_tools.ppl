// Title: Potential Defense Evasion Via Raw Disk Access By Uncommon Tools
// ID: db809f10-56ce-4420-8c86-d6a7d793c79c
// Status: test
// Level: low
// Author: Teymur Kheirkhabarov, oscd.community
// Date: 2019-10-22
// Tags: attack.stealth, attack.t1006
// Description: Detects raw disk access using uncommon tools or tools that are located in suspicious locations (heavy filtering is required), which could indicate possible defense evasion attempts
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (NOT (((Device like "%floppy%") OR ((process.executable="C:\\$WINDOWS.~BT\\*" OR process.executable="C:\\Program Files (x86)\\*" OR process.executable="C:\\Program Files\\*" OR process.executable="C:\\Windows\\CCM\\*" OR process.executable="C:\\Windows\\explorer.exe*" OR process.executable="C:\\Windows\\servicing\\*" OR process.executable="C:\\Windows\\SoftwareDistribution\\*" OR process.executable="C:\\Windows\\System32\\*" OR process.executable="C:\\Windows\\SystemApps\\*" OR process.executable="C:\\Windows\\SysWOW64\\*" OR process.executable="C:\\Windows\\uus\\*" OR process.executable="C:\\Windows\\WinSxS\\*")) OR (process.executable="C:\\Users\\*" AND (process.executable like "%\\AppData\\%" AND process.executable like "%\\Microsoft\\%")) OR (NOT process.executable=*) OR (process.executable="C:\\Windows\\Temp\\*" AND (process.executable="*\\Executables\\SSDUpdate.exe" OR process.executable="*\\HostMetadata\\NVMEHostmetadata.exe")) OR ((process.executable = "Registry" OR process.executable = "System")) OR (process.executable = "C:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe") OR (process.executable="C:\\$WinREAgent\\Scratch\\*") OR (process.executable="C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*" AND (process.executable="*\\MsMpEng.exe" OR process.executable="*\\MpDefenderCoreService.exe")))) AND NOT (((process.executable="C:\\Users\\*" AND process.executable like "%\\AppData\\Local\\Keybase\\upd.exe%") OR (process.executable="C:\\Users\\*" AND process.executable like "%\\AppData\\Local\\GitHubDesktop\\app-%" AND process.executable="*\\resources\\app\\git\\mingw64\\bin\\git.exe") OR (process.executable="C:\\Windows\\Temp\\asgard2-agent\\*" AND process.executable="*\\thor.exe"))))
