// Title: Suspicious Scheduled Task Update
// ID: 614cf376-6651-47c4-9dcc-6b9527f749f4
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-05
// Tags: attack.execution, attack.privilege-escalation, attack.persistence, attack.t1053.005
// Description: Detects update to a scheduled task event that contain suspicious keywords.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((TaskContentNew like "%regsvr32%" OR TaskContentNew like "%rundll32%" OR TaskContentNew like "%cmd.exe</Command>%" OR TaskContentNew like "%cmd</Command>%" OR TaskContentNew like "%<Arguments>/c %" OR TaskContentNew like "%<Arguments>/k %" OR TaskContentNew like "%<Arguments>/r %" OR TaskContentNew like "%powershell%" OR TaskContentNew like "%pwsh%" OR TaskContentNew like "%mshta%" OR TaskContentNew like "%wscript%" OR TaskContentNew like "%cscript%" OR TaskContentNew like "%certutil%" OR TaskContentNew like "%bitsadmin%" OR TaskContentNew like "%bash.exe%" OR TaskContentNew like "%bash %" OR TaskContentNew like "%scrcons%" OR TaskContentNew like "%wmic %" OR TaskContentNew like "%wmic.exe%" OR TaskContentNew like "%forfiles%" OR TaskContentNew like "%scriptrunner%" OR TaskContentNew like "%hh.exe%")) AND (winlog.event_id = "4702") AND ((TaskContentNew like "%\\AppData\\Local\\Temp\\%" OR TaskContentNew like "%\\AppData\\Roaming\\%" OR TaskContentNew like "%\\Users\\Public\\%" OR TaskContentNew like "%\\WINDOWS\\Temp\\%" OR TaskContentNew like "%C:\\Temp\\%" OR TaskContentNew like "%\\Desktop\\%" OR TaskContentNew like "%\\Downloads\\%" OR TaskContentNew like "%\\Temporary Internet%" OR TaskContentNew like "%C:\\ProgramData\\%" OR TaskContentNew like "%C:\\Perflogs\\%")))
