// Title: Usage Of Web Request Commands And Cmdlets
// ID: 9fc51a3c-81b3-4fa7-b35f-7c02cf10fd2d
// Status: test
// Level: medium
// Author: James Pemberton / @4A616D6573, Endgame, JHasenbusch, oscd.community, Austin Songer @austinsonger
// Date: 2019-10-24
// Tags: attack.execution, attack.t1059.001
// Description: Detects the use of various web request commands with commandline tools and Windows PowerShell cmdlets (including aliases) via CommandLine
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.command_line like "%[System.Net.WebRequest]::create%" OR process.command_line like "%curl %" OR process.command_line like "%Invoke-RestMethod%" OR process.command_line like "%Invoke-WebRequest%" OR process.command_line like "% irm %" OR process.command_line like "%iwr %" OR process.command_line like "%Resume-BitsTransfer%" OR process.command_line like "%Start-BitsTransfer%" OR process.command_line like "%wget %" OR process.command_line like "%WinHttp.WinHttpRequest%"))
