// Title: Suspicious DNS Query for IP Lookup Service APIs
// ID: ec82e2a5-81ea-4211-a1f8-37a0286df2c2
// Status: test
// Level: medium
// Author: Brandon George (blog post), Thomas Patzke
// Date: 2021-07-08
// Tags: attack.reconnaissance, attack.t1590
// Description: Detects DNS queries for IP lookup services such as "api.ipify.org" originating from a non browser process.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((QueryName = "www.ip.cn" OR QueryName = "l2.io")) OR ((QueryName like "%api.2ip.ua%" OR QueryName like "%api.bigdatacloud.net%" OR QueryName like "%api.ipify.org%" OR QueryName like "%bot.whatismyipaddress.com%" OR QueryName like "%canireachthe.net%" OR QueryName like "%checkip.amazonaws.com%" OR QueryName like "%checkip.dyndns.org%" OR QueryName like "%curlmyip.com%" OR QueryName like "%db-ip.com%" OR QueryName like "%edns.ip-api.com%" OR QueryName like "%eth0.me%" OR QueryName like "%freegeoip.app%" OR QueryName like "%geoipy.com%" OR QueryName like "%getip.pro%" OR QueryName like "%icanhazip.com%" OR QueryName like "%ident.me%" OR QueryName like "%ifconfig.io%" OR QueryName like "%ifconfig.me%" OR QueryName like "%ip-api.com%" OR QueryName like "%ip.360.cn%" OR QueryName like "%ip.anysrc.net%" OR QueryName like "%ip.taobao.com%" OR QueryName like "%ip.tyk.nu%" OR QueryName like "%ipaddressworld.com%" OR QueryName like "%ipapi.co%" OR QueryName like "%ipconfig.io%" OR QueryName like "%ipecho.net%" OR QueryName like "%ipinfo.io%" OR QueryName like "%ipip.net%" OR QueryName like "%ipof.in%" OR QueryName like "%ipv4.icanhazip.com%" OR QueryName like "%ipv4bot.whatismyipaddress.com%" OR QueryName like "%ipv6-test.com%" OR QueryName like "%ipwho.is%" OR QueryName like "%jsonip.com%" OR QueryName like "%myexternalip.com%" OR QueryName like "%seeip.org%" OR QueryName like "%wgetip.com%" OR QueryName like "%whatismyip.akamai.com%" OR QueryName like "%whois.pconline.com.cn%" OR QueryName like "%wtfismyip.com%"))) AND NOT (((process.executable="*\\brave.exe") OR ((process.executable = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR process.executable = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((process.executable="C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*") OR (process.executable="*\\WindowsApps\\MicrosoftEdge.exe") OR ((process.executable = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR process.executable = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process.executable="C:\\Program Files (x86)\\Microsoft\\EdgeCore\\*" OR process.executable="C:\\Program Files\\Microsoft\\EdgeCore\\*") AND (process.executable="*\\msedge.exe" OR process.executable="*\\msedgewebview2.exe")) OR ((process.executable = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR process.executable = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR ((process.executable = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR process.executable = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process.executable="*\\maxthon.exe") OR (process.executable="*\\opera.exe") OR (process.executable="*\\safari.exe") OR (process.executable="*\\seamonkey.exe") OR (process.executable="*\\vivaldi.exe") OR (process.executable="*\\whale.exe"))))
