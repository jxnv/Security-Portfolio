// Title: PUA - AdFind Suspicious Execution
// ID: 9a132afa-654e-11eb-ae93-0242ac130002
// Status: test
// Level: high
// Author: Janantha Marasinghe (https://github.com/blueteam0ps), FPT.EagleEye Team, omkar72, oscd.community
// Date: 2021-02-02
// Tags: attack.discovery, attack.t1018, attack.t1087.002, attack.t1482, attack.t1069.002, stp.1u
// Description: Detects AdFind execution with common flags seen used during attacks
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.command_line like "%domainlist%" OR process.command_line like "%trustdmp%" OR process.command_line like "%dcmodes%" OR process.command_line like "%adinfo%" OR process.command_line like "%-sc dclist%" OR process.command_line like "%computer_pwdnotreqd%" OR process.command_line like "%objectcategory=%" OR process.command_line like "%-subnets -f%" OR process.command_line like "%name=\"Domain Admins\"%" OR process.command_line like "%-sc u:%" OR process.command_line like "%domainncs%" OR process.command_line like "%dompol%" OR process.command_line like "% oudmp %" OR process.command_line like "%subnetdmp%" OR process.command_line like "%gpodmp%" OR process.command_line like "%fspdmp%" OR process.command_line like "%users_noexpire%" OR process.command_line like "%computers_active%" OR process.command_line like "%computers_pwdnotreqd%"))
