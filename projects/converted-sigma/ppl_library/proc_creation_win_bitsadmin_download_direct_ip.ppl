// Title: Suspicious Download From Direct IP Via Bitsadmin
// ID: 99c840f2-2012-46fd-9141-c761987550ef
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-06-28
// Tags: attack.persistence, attack.execution, attack.stealth, attack.t1197, attack.s0190, attack.t1036.003
// Description: Detects usage of bitsadmin downloading a file using an URL that contains an IP
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.command_line like "%://1%" OR process.command_line like "%://2%" OR process.command_line like "%://3%" OR process.command_line like "%://4%" OR process.command_line like "%://5%" OR process.command_line like "%://6%" OR process.command_line like "%://7%" OR process.command_line like "%://8%" OR process.command_line like "%://9%")) AND ((process.command_line like "% /transfer %" OR process.command_line like "% /create %" OR process.command_line like "% /addfile %")) AND ((process.executable="*\\bitsadmin.exe") OR (process.pe.original_file_name = "bitsadmin.exe"))) AND NOT ((process.command_line like "%://7-%")))
