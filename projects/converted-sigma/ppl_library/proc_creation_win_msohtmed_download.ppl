// Title: Arbitrary File Download Via MSOHTMED.EXE
// ID: 459f2f98-397b-4a4a-9f47-6a5ec2f1c69d
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-19
// Tags: attack.execution, attack.stealth, attack.t1218
// Description: Detects usage of "MSOHTMED" to download arbitrary files
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%ftp://%" OR process.command_line like "%http://%" OR process.command_line like "%https://%")) AND ((process.executable="*\\MSOHTMED.exe") OR (process.pe.original_file_name = "MsoHtmEd.exe")))
