// Title: Process Creation Using Sysnative Folder
// ID: 3c1b5fb0-c72f-45ba-abd1-4d4c353144ab
// Status: test
// Level: medium
// Author: Max Altgelt (Nextron Systems)
// Date: 2022-08-23
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects process creation events that use the Sysnative folder (common for CobaltStrike spawns)
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%:\\Windows\\Sysnative\\%") OR (process.executable like "%:\\Windows\\Sysnative\\%")) AND NOT (((process.executable like "%C:\\Windows\\Microsoft.NET\\Framework64\\v%" OR process.executable like "%C:\\Windows\\Microsoft.NET\\Framework\\v%" OR process.executable like "%C:\\Windows\\Microsoft.NET\\FrameworkArm\\v%" OR process.executable like "%C:\\Windows\\Microsoft.NET\\FrameworkArm64\\v%") AND process.executable="*\\ngen.exe" AND process.command_line like "%install%")) AND NOT (((process.command_line like "%\"C:\\Windows\\sysnative\\cmd.exe\"%" AND process.command_line like "%\\xampp\\%" AND process.command_line like "%\\catalina_start.bat%"))))
