// Title: Suspicious Service Binary Directory
// ID: 883faa95-175a-4e22-8181-e5761aeb373c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-03-09
// Tags: attack.stealth, attack.t1202
// Description: Detects a service binary running in a suspicious directory
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.executable like "%\\Users\\Public\\%" OR process.executable like "%\\$Recycle.bin%" OR process.executable like "%\\Users\\All Users\\%" OR process.executable like "%\\Users\\Default\\%" OR process.executable like "%\\Users\\Contacts\\%" OR process.executable like "%\\Users\\Searches\\%" OR process.executable like "%C:\\Perflogs\\%" OR process.executable like "%\\config\\systemprofile\\%" OR process.executable like "%\\Windows\\Fonts\\%" OR process.executable like "%\\Windows\\IME\\%" OR process.executable like "%\\Windows\\addins\\%") AND (process.parent.executable="*\\services.exe" OR process.parent.executable="*\\svchost.exe"))
