// Title: Modify User Shell Folders Startup Value
// ID: 9c226817-8dc9-46c2-a58d-66655aafd7dc
// Status: test
// Level: high
// Author: frack113, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2022-10-01
// Tags: attack.persistence, attack.privilege-escalation, attack.t1547.001
// Description: Detect modification of the User Shell Folders registry values for Startup or Common Startup which could indicate persistence attempts.
// Attackers may modify User Shell Folders registry keys to point to malicious executables or scripts that will be executed during startup.
// This technique is often used to maintain persistence on a compromised system by ensuring that the malicious payload is executed automatically.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((registry.path like "%SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\User Shell Folders%" OR registry.path like "%SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Shell Folders%") AND (registry.path="*\\Common Startup" OR registry.path="*\\Startup")) AND NOT (((NOT registry.data.strings=*) OR ((registry.data.strings like "%C:\\ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\\Startup%" OR registry.data.strings like "%%ProgramData%\\Microsoft\\Windows\\Start Menu\\Programs\\Startup%")) OR ((registry.data.strings like "%%USERPROFILE%\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\Startup%" OR registry.data.strings like "%%%USERPROFILE%%\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\Startup%")) OR ((registry.data.strings like "%C:\\Users\\%" AND registry.data.strings like "%\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\Startup%")))))
