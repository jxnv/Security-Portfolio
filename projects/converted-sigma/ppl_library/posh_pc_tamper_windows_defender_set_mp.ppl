// Title: Tamper Windows Defender - PSClassic
// ID: ec19ebab-72dc-40e1-9728-4c0b805d722c
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-06-07
// Tags: attack.defense-impairment, attack.t1685
// Description: Attempting to disable scheduled scanning and other parts of Windows Defender ATP or set default actions to allow.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((Data like "%Set-MpPreference%") AND (((Data like "%HighThreatDefaultAction Allow%" OR Data like "%htdefac Allow%" OR Data like "%LowThreatDefaultAction Allow%" OR Data like "%ltdefac Allow%" OR Data like "%ModerateThreatDefaultAction Allow%" OR Data like "%mtdefac Allow%" OR Data like "%SevereThreatDefaultAction Allow%" OR Data like "%stdefac Allow%")) OR ((Data like "%-dbaf $true%" OR Data like "%-dbaf 1%" OR Data like "%-dbm $true%" OR Data like "%-dbm 1%" OR Data like "%-dips $true%" OR Data like "%-dips 1%" OR Data like "%-DisableArchiveScanning $true%" OR Data like "%-DisableArchiveScanning 1%" OR Data like "%-DisableBehaviorMonitoring $true%" OR Data like "%-DisableBehaviorMonitoring 1%" OR Data like "%-DisableBlockAtFirstSeen $true%" OR Data like "%-DisableBlockAtFirstSeen 1%" OR Data like "%-DisableCatchupFullScan $true%" OR Data like "%-DisableCatchupFullScan 1%" OR Data like "%-DisableCatchupQuickScan $true%" OR Data like "%-DisableCatchupQuickScan 1%" OR Data like "%-DisableIntrusionPreventionSystem $true%" OR Data like "%-DisableIntrusionPreventionSystem 1%" OR Data like "%-DisableIOAVProtection $true%" OR Data like "%-DisableIOAVProtection 1%" OR Data like "%-DisableRealtimeMonitoring $true%" OR Data like "%-DisableRealtimeMonitoring 1%" OR Data like "%-DisableRemovableDriveScanning $true%" OR Data like "%-DisableRemovableDriveScanning 1%" OR Data like "%-DisableScanningMappedNetworkDrivesForFullScan $true%" OR Data like "%-DisableScanningMappedNetworkDrivesForFullScan 1%" OR Data like "%-DisableScanningNetworkFiles $true%" OR Data like "%-DisableScanningNetworkFiles 1%" OR Data like "%-DisableScriptScanning $true%" OR Data like "%-DisableScriptScanning 1%" OR Data like "%-MAPSReporting $false%" OR Data like "%-MAPSReporting 0%" OR Data like "%-drdsc $true%" OR Data like "%-drdsc 1%" OR Data like "%-drtm $true%" OR Data like "%-drtm 1%" OR Data like "%-dscrptsc $true%" OR Data like "%-dscrptsc 1%" OR Data like "%-dsmndf $true%" OR Data like "%-dsmndf 1%" OR Data like "%-dsnf $true%" OR Data like "%-dsnf 1%" OR Data like "%-dss $true%" OR Data like "%-dss 1%"))))
