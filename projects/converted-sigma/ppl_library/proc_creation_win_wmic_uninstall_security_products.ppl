// Title: Potential Tampering With Security Products Via WMIC
// ID: 847d5ff3-8a31-4737-a970-aeae8fe21765
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-01-30
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects uninstallation or termination of security products using the WMIC utility
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.command_line like "%wmic%" AND process.command_line like "%product %" AND process.command_line like "%uninstall%") AND (process.command_line like "%/nointeractive%" OR process.command_line like "%-nointeractive%")) OR ((process.command_line like "%wmic%" AND process.command_line like "%caption like %") AND (process.command_line like "%call delete%" OR process.command_line like "%call terminate%")) OR ((process.command_line like "%process %" AND process.command_line like "%where %" AND process.command_line like "%delete%"))) AND ((process.command_line like "%%carbon%%" OR process.command_line like "%%cylance%%" OR process.command_line like "%%endpoint%%" OR process.command_line like "%%eset%%" OR process.command_line like "%%malware%%" OR process.command_line like "%%Sophos%%" OR process.command_line like "%%symantec%%" OR process.command_line like "%Antivirus%" OR process.command_line like "%AVG %" OR process.command_line like "%Carbon Black%" OR process.command_line like "%CarbonBlack%" OR process.command_line like "%Cb Defense Sensor 64-bit%" OR process.command_line like "%Crowdstrike Sensor%" OR process.command_line like "%Cylance %" OR process.command_line like "%Dell Threat Defense%" OR process.command_line like "%DLP Endpoint%" OR process.command_line like "%Endpoint Detection%" OR process.command_line like "%Endpoint Protection%" OR process.command_line like "%Endpoint Security%" OR process.command_line like "%Endpoint Sensor%" OR process.command_line like "%ESET File Security%" OR process.command_line like "%LogRhythm System Monitor Service%" OR process.command_line like "%Malwarebytes%" OR process.command_line like "%McAfee Agent%" OR process.command_line like "%Microsoft Security Client%" OR process.command_line like "%Sophos Anti-Virus%" OR process.command_line like "%Sophos AutoUpdate%" OR process.command_line like "%Sophos Credential Store%" OR process.command_line like "%Sophos Management Console%" OR process.command_line like "%Sophos Management Database%" OR process.command_line like "%Sophos Management Server%" OR process.command_line like "%Sophos Remote Management System%" OR process.command_line like "%Sophos Update Manager%" OR process.command_line like "%Threat Protection%" OR process.command_line like "%VirusScan%" OR process.command_line like "%Webroot SecureAnywhere%" OR process.command_line like "%Windows Defender%")))
