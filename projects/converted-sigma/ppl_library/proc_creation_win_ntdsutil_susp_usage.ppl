// Title: Suspicious Usage Of Active Directory Diagnostic Tool (ntdsutil.exe)
// ID: a58353df-af43-4753-bad0-cd83ef35eef5
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-14
// Tags: attack.credential-access, attack.t1003.003
// Description: Detects execution of ntdsutil.exe to perform different actions such as restoring snapshots...etc.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.command_line like "%snapshot%" AND process.command_line like "%mount %")) OR ((process.command_line like "%ac%" AND process.command_line like "% i%" AND process.command_line like "% ntds%"))) AND ((process.executable="*\\ntdsutil.exe") OR (process.pe.original_file_name = "ntdsutil.exe")))
