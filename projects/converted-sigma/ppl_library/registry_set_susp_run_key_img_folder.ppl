// Title: New RUN Key Pointing to Suspicious Folder
// ID: 02ee49e2-e294-4d0f-9278-f5b3212fc588
// Status: experimental
// Level: high
// Author: Florian Roth (Nextron Systems), Markus Neis, Sander Wiebing, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2018-08-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects suspicious new RUN key element pointing to an executable in a suspicious folder
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((registry.path like "%\\Software\\Microsoft\\Windows\\CurrentVersion\\Run%" OR registry.path like "%\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run%" OR registry.path like "%\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\Run%")) AND (((registry.data.strings like "%:\\Perflogs%" OR registry.data.strings like "%:\\ProgramData'%" OR registry.data.strings like "%:\\Windows\\Temp%" OR registry.data.strings like "%:\\Temp%" OR registry.data.strings like "%\\AppData\\Local\\Temp%" OR registry.data.strings like "%\\AppData\\Roaming%" OR registry.data.strings like "%:\\$Recycle.bin%" OR registry.data.strings like "%:\\Users\\Default%" OR registry.data.strings like "%:\\Users\\public%" OR registry.data.strings like "%%temp%%" OR registry.data.strings like "%%tmp%%" OR registry.data.strings like "%%Public%%" OR registry.data.strings like "%%AppData%%")) OR ((registry.data.strings like "%:\\Users\\%") AND ((registry.data.strings like "%\\Favorites%" OR registry.data.strings like "%\\Favourites%" OR registry.data.strings like "%\\Contacts%" OR registry.data.strings like "%\\Music%" OR registry.data.strings like "%\\Pictures%" OR registry.data.strings like "%\\Documents%" OR registry.data.strings like "%\\Photos%")))) AND NOT ((registry.path like "%\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\%" AND process.executable="C:\\Windows\\SoftwareDistribution\\Download\\*" AND (registry.data.strings like "%rundll32.exe %" AND registry.data.strings like "%C:\\WINDOWS\\system32\\advpack.dll,DelNodeRunDLL32%") AND (registry.data.strings like "%\\AppData\\Local\\Temp\\%" OR registry.data.strings like "%C:\\Windows\\Temp\\%"))) AND NOT (((process.executable="*C:\\Program Files\\Spotify\\Spotify.exe" OR process.executable="*C:\\Program Files (x86)\\Spotify\\Spotify.exe" OR process.executable="*\\AppData\\Roaming\\Spotify\\Spotify.exe") AND registry.path="*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\\Spotify" AND registry.data.strings="*Spotify.exe --autostart --minimized")))
