// Title: Potentially Suspicious Execution Of Regasm/Regsvcs From Uncommon Location
// ID: cc368ed0-2411-45dc-a222-510ace303cb2
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-25
// Tags: attack.stealth, attack.t1218.009
// Description: Detects potentially suspicious execution of the Regasm/Regsvcs utilities from a potentially suspicious location
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%\\AppData\\Local\\Temp\\%" OR process.command_line like "%\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\%" OR process.command_line like "%\\PerfLogs\\%" OR process.command_line like "%\\Users\\Public\\%" OR process.command_line like "%\\Windows\\Temp\\%")) AND (((process.executable="*\\Regsvcs.exe" OR process.executable="*\\Regasm.exe")) OR ((process.pe.original_file_name = "RegSvcs.exe" OR process.pe.original_file_name = "RegAsm.exe"))))
