// Title: Security Support Provider (SSP) Added to LSA Configuration
// ID: eeb30123-9fbd-4ee8-aaa0-2e545bbed6dc
// Status: test
// Level: high
// Author: iwillkeepwatch
// Date: 2019-01-18
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.005
// Description: Detects the addition of a SSP to the registry. Upon a reboot or API call, SSP DLLs gain access to encrypted and plaintext passwords stored in Windows.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((registry.path="*\\Control\\Lsa\\Security Packages" OR registry.path="*\\Control\\Lsa\\OSConfig\\Security Packages")) AND NOT (((NOT process.executable=*) OR ((process.executable = "C:\\Windows\\system32\\msiexec.exe" OR process.executable = "C:\\Windows\\syswow64\\MsiExec.exe")))))
