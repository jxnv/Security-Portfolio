// Title: Powershell Defender Disable Scan Feature
// ID: 1ec65a5f-9473-4f12-97da-622044d6df21
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-03
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects requests to disable Microsoft Defender features using PowerShell commands
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.command_line like "%Add-MpPreference %" OR process.command_line like "%Set-MpPreference %")) AND ((process.command_line like "%DisableArchiveScanning %" OR process.command_line like "%DisableRealtimeMonitoring %" OR process.command_line like "%DisableIOAVProtection %" OR process.command_line like "%DisableBehaviorMonitoring %" OR process.command_line like "%DisableBlockAtFirstSeen %" OR process.command_line like "%DisableCatchupFullScan %" OR process.command_line like "%DisableCatchupQuickScan %")) AND ((process.command_line like "%$true%" OR process.command_line like "% 1 %"))) OR (((process.command_line like "%RABpAHMAYQBiAGwAZQBSAGUAYQBsAHQAaQBtAGUATQBvAG4AaQB0AG8AcgBpAG4AZwAgA%" OR process.command_line like "%QAaQBzAGEAYgBsAGUAUgBlAGEAbAB0AGkAbQBlAE0AbwBuAGkAdABvAHIAaQBuAGcAIA%" OR process.command_line like "%EAGkAcwBhAGIAbABlAFIAZQBhAGwAdABpAG0AZQBNAG8AbgBpAHQAbwByAGkAbgBnACAA%" OR process.command_line like "%RABpAHMAYQBiAGwAZQBJAE8AQQBWAFAAcgBvAHQAZQBjAHQAaQBvAG4AIA%" OR process.command_line like "%QAaQBzAGEAYgBsAGUASQBPAEEAVgBQAHIAbwB0AGUAYwB0AGkAbwBuACAA%" OR process.command_line like "%EAGkAcwBhAGIAbABlAEkATwBBAFYAUAByAG8AdABlAGMAdABpAG8AbgAgA%" OR process.command_line like "%RABpAHMAYQBiAGwAZQBCAGUAaABhAHYAaQBvAHIATQBvAG4AaQB0AG8AcgBpAG4AZwAgA%" OR process.command_line like "%QAaQBzAGEAYgBsAGUAQgBlAGgAYQB2AGkAbwByAE0AbwBuAGkAdABvAHIAaQBuAGcAIA%" OR process.command_line like "%EAGkAcwBhAGIAbABlAEIAZQBoAGEAdgBpAG8AcgBNAG8AbgBpAHQAbwByAGkAbgBnACAA%" OR process.command_line like "%RABpAHMAYQBiAGwAZQBCAGwAbwBjAGsAQQB0AEYAaQByAHMAdABTAGUAZQBuACAA%" OR process.command_line like "%QAaQBzAGEAYgBsAGUAQgBsAG8AYwBrAEEAdABGAGkAcgBzAHQAUwBlAGUAbgAgA%" OR process.command_line like "%EAGkAcwBhAGIAbABlAEIAbABvAGMAawBBAHQARgBpAHIAcwB0AFMAZQBlAG4AIA%" OR process.command_line like "%ZABpAHMAYQBiAGwAZQByAGUAYQBsAHQAaQBtAGUAbQBvAG4AaQB0AG8AcgBpAG4AZwAgA%" OR process.command_line like "%QAaQBzAGEAYgBsAGUAcgBlAGEAbAB0AGkAbQBlAG0AbwBuAGkAdABvAHIAaQBuAGcAIA%" OR process.command_line like "%kAGkAcwBhAGIAbABlAHIAZQBhAGwAdABpAG0AZQBtAG8AbgBpAHQAbwByAGkAbgBnACAA%" OR process.command_line like "%ZABpAHMAYQBiAGwAZQBpAG8AYQB2AHAAcgBvAHQAZQBjAHQAaQBvAG4AIA%" OR process.command_line like "%QAaQBzAGEAYgBsAGUAaQBvAGEAdgBwAHIAbwB0AGUAYwB0AGkAbwBuACAA%" OR process.command_line like "%kAGkAcwBhAGIAbABlAGkAbwBhAHYAcAByAG8AdABlAGMAdABpAG8AbgAgA%" OR process.command_line like "%ZABpAHMAYQBiAGwAZQBiAGUAaABhAHYAaQBvAHIAbQBvAG4AaQB0AG8AcgBpAG4AZwAgA%" OR process.command_line like "%QAaQBzAGEAYgBsAGUAYgBlAGgAYQB2AGkAbwByAG0AbwBuAGkAdABvAHIAaQBuAGcAIA%" OR process.command_line like "%kAGkAcwBhAGIAbABlAGIAZQBoAGEAdgBpAG8AcgBtAG8AbgBpAHQAbwByAGkAbgBnACAA%" OR process.command_line like "%ZABpAHMAYQBiAGwAZQBiAGwAbwBjAGsAYQB0AGYAaQByAHMAdABzAGUAZQBuACAA%" OR process.command_line like "%QAaQBzAGEAYgBsAGUAYgBsAG8AYwBrAGEAdABmAGkAcgBzAHQAcwBlAGUAbgAgA%" OR process.command_line like "%kAGkAcwBhAGIAbABlAGIAbABvAGMAawBhAHQAZgBpAHIAcwB0AHMAZQBlAG4AIA%" OR process.command_line like "%RABpAHMAYQBiAGwAZQBDAGEAdABjAGgAdQBwAEYAdQBsAGwAUwBjAGEAbgA%" OR process.command_line like "%RABpAHMAYQBiAGwAZQBDAGEAdABjAGgAdQBwAFEAdQBpAGMAawBTAGMAYQBuAA%" OR process.command_line like "%RABpAHMAYQBiAGwAZQBBAHIAYwBoAGkAdgBlAFMAYwBhAG4AbgBpAG4AZwA%")) OR ((process.command_line like "%ZGlzYWJsZWFyY2hpdmVzY2FubmluZy%" OR process.command_line like "%Rpc2FibGVhcmNoaXZlc2Nhbm5pbmcg%" OR process.command_line like "%kaXNhYmxlYXJjaGl2ZXNjYW5uaW5nI%" OR process.command_line like "%RGlzYWJsZUFyY2hpdmVTY2FubmluZy%" OR process.command_line like "%Rpc2FibGVBcmNoaXZlU2Nhbm5pbmcg%" OR process.command_line like "%EaXNhYmxlQXJjaGl2ZVNjYW5uaW5nI%" OR process.command_line like "%ZGlzYWJsZWJlaGF2aW9ybW9uaXRvcmluZy%" OR process.command_line like "%Rpc2FibGViZWhhdmlvcm1vbml0b3Jpbmcg%" OR process.command_line like "%kaXNhYmxlYmVoYXZpb3Jtb25pdG9yaW5nI%" OR process.command_line like "%RGlzYWJsZUJlaGF2aW9yTW9uaXRvcmluZy%" OR process.command_line like "%Rpc2FibGVCZWhhdmlvck1vbml0b3Jpbmcg%" OR process.command_line like "%EaXNhYmxlQmVoYXZpb3JNb25pdG9yaW5nI%" OR process.command_line like "%ZGlzYWJsZWJsb2NrYXRmaXJzdHNlZW4g%" OR process.command_line like "%Rpc2FibGVibG9ja2F0Zmlyc3RzZWVuI%" OR process.command_line like "%kaXNhYmxlYmxvY2thdGZpcnN0c2Vlbi%" OR process.command_line like "%RGlzYWJsZUJsb2NrQXRGaXJzdFNlZW4g%" OR process.command_line like "%Rpc2FibGVCbG9ja0F0Rmlyc3RTZWVuI%" OR process.command_line like "%EaXNhYmxlQmxvY2tBdEZpcnN0U2Vlbi%" OR process.command_line like "%ZGlzYWJsZWNhdGNodXBmdWxsc2Nhbi%" OR process.command_line like "%Rpc2FibGVjYXRjaHVwZnVsbHNjYW4g%" OR process.command_line like "%kaXNhYmxlY2F0Y2h1cGZ1bGxzY2FuI%" OR process.command_line like "%RGlzYWJsZUNhdGNodXBGdWxsU2Nhbi%" OR process.command_line like "%Rpc2FibGVDYXRjaHVwRnVsbFNjYW4g%" OR process.command_line like "%EaXNhYmxlQ2F0Y2h1cEZ1bGxTY2FuI%" OR process.command_line like "%ZGlzYWJsZWNhdGNodXBxdWlja3NjYW4g%" OR process.command_line like "%Rpc2FibGVjYXRjaHVwcXVpY2tzY2FuI%" OR process.command_line like "%kaXNhYmxlY2F0Y2h1cHF1aWNrc2Nhbi%" OR process.command_line like "%RGlzYWJsZUNhdGNodXBRdWlja1NjYW4g%" OR process.command_line like "%Rpc2FibGVDYXRjaHVwUXVpY2tTY2FuI%" OR process.command_line like "%EaXNhYmxlQ2F0Y2h1cFF1aWNrU2Nhbi%" OR process.command_line like "%ZGlzYWJsZWlvYXZwcm90ZWN0aW9uI%" OR process.command_line like "%Rpc2FibGVpb2F2cHJvdGVjdGlvbi%" OR process.command_line like "%kaXNhYmxlaW9hdnByb3RlY3Rpb24g%" OR process.command_line like "%RGlzYWJsZUlPQVZQcm90ZWN0aW9uI%" OR process.command_line like "%Rpc2FibGVJT0FWUHJvdGVjdGlvbi%" OR process.command_line like "%EaXNhYmxlSU9BVlByb3RlY3Rpb24g%" OR process.command_line like "%ZGlzYWJsZXJlYWx0aW1lbW9uaXRvcmluZy%" OR process.command_line like "%Rpc2FibGVyZWFsdGltZW1vbml0b3Jpbmcg%" OR process.command_line like "%kaXNhYmxlcmVhbHRpbWVtb25pdG9yaW5nI%" OR process.command_line like "%RGlzYWJsZVJlYWx0aW1lTW9uaXRvcmluZy%" OR process.command_line like "%Rpc2FibGVSZWFsdGltZU1vbml0b3Jpbmcg%" OR process.command_line like "%EaXNhYmxlUmVhbHRpbWVNb25pdG9yaW5nI%"))))
