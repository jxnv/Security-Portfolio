// Title: HackTool - Certipy Execution
// ID: 6938366d-8954-4ddc-baff-c830b3ba8fcd
// Status: test
// Level: high
// Author: pH-T (Nextron Systems), Sittikorn Sangrattanapitak
// Date: 2023-04-17
// Tags: attack.discovery, attack.credential-access, attack.t1649
// Description: Detects Certipy execution, a tool for Active Directory Certificate Services enumeration and abuse based on PE metadata characteristics and common command line arguments.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.executable="*\\Certipy.exe") OR (process.pe.original_file_name = "Certipy.exe") OR (Description like "%Certipy%")) OR (((process.command_line like "% account %" OR process.command_line like "% auth %" OR process.command_line like "% cert %" OR process.command_line like "% find %" OR process.command_line like "% forge %" OR process.command_line like "% ptt %" OR process.command_line like "% relay %" OR process.command_line like "% req %" OR process.command_line like "% shadow %" OR process.command_line like "% template %")) AND ((process.command_line like "% -bloodhound%" OR process.command_line like "% -ca-pfx %" OR process.command_line like "% -dc-ip %" OR process.command_line like "% -kirbi%" OR process.command_line like "% -old-bloodhound%" OR process.command_line like "% -pfx %" OR process.command_line like "% -target%" OR process.command_line like "% -template%" OR process.command_line like "% -username %" OR process.command_line like "% -vulnerable%" OR process.command_line like "%auth -pfx%" OR process.command_line like "%shadow auto%" OR process.command_line like "%shadow list%"))))
