// Title: Wab/Wabmig Unusual Parent Or Child Processes
// ID: 63d1ccc0-2a43-4f4b-9289-361b308991ff
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-12
// Tags: attack.execution, attack.stealth
// Description: Detects unusual parent or children of the wab.exe (Windows Contacts) and Wabmig.exe (Microsoft Address Book Import Tool) processes as seen being used with bumblebee activity
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.parent.executable="*\\wab.exe" OR process.parent.executable="*\\wabmig.exe")) OR ((process.parent.executable="*\\WmiPrvSE.exe" OR process.parent.executable="*\\svchost.exe" OR process.parent.executable="*\\dllhost.exe") AND (process.executable="*\\wab.exe" OR process.executable="*\\wabmig.exe")))
