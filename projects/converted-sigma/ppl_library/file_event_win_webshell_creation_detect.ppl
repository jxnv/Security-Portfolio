// Title: Potential Webshell Creation On Static Website
// ID: 39f1f9f2-9636-45de-98f6-a4046aa8e4b9
// Status: test
// Level: medium
// Author: Beyu Denis, oscd.community, Tim Shelton, Thurein Oo
// Date: 2019-10-22
// Tags: attack.persistence, attack.t1505.003
// Description: Detects the creation of files with certain extensions on a static web site. This can be indicative of potential uploads of a web shell.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((((file.path like "%.ashx%" OR file.path like "%.asp%" OR file.path like "%.ph%" OR file.path like "%.soap%")) AND (file.path like "%\\inetpub\\wwwroot\\%")) OR ((file.path like "%.ph%") AND ((file.path like "%\\www\\%" OR file.path like "%\\htdocs\\%" OR file.path like "%\\html\\%")))) AND NOT (((file.path like "%\\xampp%") OR (process.executable = "System") OR ((file.path like "%\\AppData\\Local\\Temp\\%" OR file.path like "%\\Windows\\Temp\\%")))))
