// Title: Suspicious ShellExec_RunDLL Call Via Ordinal
// ID: 8823e85d-31d8-473e-b7f4-92da070f0fc6
// Status: test
// Level: high
// Author: Swachchhanda Shrawan Poudel
// Date: 2024-12-01
// Tags: attack.stealth, attack.t1218.011
// Description: Detects suspicious call to the "ShellExec_RunDLL" exported function of SHELL32.DLL through the ordinal number to launch other commands.
// Adversary might only use the ordinal number in order to bypass existing detection that alert on usage of ShellExec_RunDLL on CommandLine.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.parent.command_line like "%SHELL32.DLL%") AND ((process.parent.command_line like "%#568%" OR process.parent.command_line like "%#570%" OR process.parent.command_line like "%#572%" OR process.parent.command_line like "%#576%"))) AND (((process.executable="*\\bash.exe" OR process.executable="*\\bitsadmin.exe" OR process.executable="*\\cmd.exe" OR process.executable="*\\cscript.exe" OR process.executable="*\\curl.exe" OR process.executable="*\\mshta.exe" OR process.executable="*\\msiexec.exe" OR process.executable="*\\msxsl.exe" OR process.executable="*\\odbcconf.exe" OR process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe" OR process.executable="*\\regsvr32.exe" OR process.executable="*\\schtasks.exe" OR process.executable="*\\wmic.exe" OR process.executable="*\\wscript.exe")) OR (((process.parent.command_line like "%comspec%" OR process.parent.command_line like "%iex%" OR process.parent.command_line like "%Invoke-%" OR process.parent.command_line like "%msiexec%" OR process.parent.command_line like "%odbcconf%" OR process.parent.command_line like "%regsvr32%")) OR ((process.parent.command_line like "%\\Desktop\\%" OR process.parent.command_line like "%\\ProgramData\\%" OR process.parent.command_line like "%\\Temp\\%" OR process.parent.command_line like "%\\Users\\Public\\%")))))
