// Title: Suspicious MsiExec Embedding Parent
// ID: 4a2a2c3e-209f-4d01-b513-4155a540b469
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-04-16
// Tags: attack.stealth, attack.t1218.007
// Description: Adversaries may abuse msiexec.exe to proxy the execution of malicious payloads
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe" OR process.executable="*\\cmd.exe") AND (process.parent.command_line like "%MsiExec.exe%" AND process.parent.command_line like "%-Embedding %")) AND NOT (((process.executable="*:\\Windows\\System32\\cmd.exe" AND process.command_line like "%C:\\Program Files\\SplunkUniversalForwarder\\bin\\%") OR ((process.command_line like "%\\DismFoDInstall.cmd%") OR ((process.parent.command_line like "%\\MsiExec.exe -Embedding %" AND process.parent.command_line like "%Global\\MSI0000%"))))))
