// Title: Suspicious Microsoft OneNote Child Process
// ID: c27515df-97a9-4162-8a60-dc0eeb51b775
// Status: test
// Level: high
// Author: Tim Rauch (Nextron Systems), Nasreddine Bencherchali (Nextron Systems), Elastic (idea)
// Date: 2022-10-21
// Tags: attack.t1566, attack.t1566.001, attack.initial-access
// Description: Detects suspicious child processes of the Microsoft OneNote application. This may indicate an attempt to execute malicious embedded objects from a .one file.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.parent.executable="*\\onenote.exe") AND ((process.executable="*\\explorer.exe" AND (process.command_line like "%.hta%" OR process.command_line like "%.vb%" OR process.command_line like "%.wsh%" OR process.command_line like "%.js%" OR process.command_line like "%.ps%" OR process.command_line like "%.scr%" OR process.command_line like "%.pif%" OR process.command_line like "%.bat%" OR process.command_line like "%.cmd%")) OR (((process.pe.original_file_name = "bitsadmin.exe" OR process.pe.original_file_name = "CertOC.exe" OR process.pe.original_file_name = "CertUtil.exe" OR process.pe.original_file_name = "Cmd.Exe" OR process.pe.original_file_name = "CMSTP.EXE" OR process.pe.original_file_name = "cscript.exe" OR process.pe.original_file_name = "curl.exe" OR process.pe.original_file_name = "HH.exe" OR process.pe.original_file_name = "IEExec.exe" OR process.pe.original_file_name = "InstallUtil.exe" OR process.pe.original_file_name = "javaw.exe" OR process.pe.original_file_name = "Microsoft.Workflow.Compiler.exe" OR process.pe.original_file_name = "msdt.exe" OR process.pe.original_file_name = "MSHTA.EXE" OR process.pe.original_file_name = "msiexec.exe" OR process.pe.original_file_name = "Msxsl.exe" OR process.pe.original_file_name = "odbcconf.exe" OR process.pe.original_file_name = "pcalua.exe" OR process.pe.original_file_name = "PowerShell.EXE" OR process.pe.original_file_name = "RegAsm.exe" OR process.pe.original_file_name = "RegSvcs.exe" OR process.pe.original_file_name = "REGSVR32.exe" OR process.pe.original_file_name = "RUNDLL32.exe" OR process.pe.original_file_name = "schtasks.exe" OR process.pe.original_file_name = "ScriptRunner.exe" OR process.pe.original_file_name = "wmic.exe" OR process.pe.original_file_name = "WorkFolders.exe" OR process.pe.original_file_name = "wscript.exe")) OR ((process.executable="*\\AppVLP.exe" OR process.executable="*\\bash.exe" OR process.executable="*\\bitsadmin.exe" OR process.executable="*\\certoc.exe" OR process.executable="*\\certutil.exe" OR process.executable="*\\cmd.exe" OR process.executable="*\\cmstp.exe" OR process.executable="*\\control.exe" OR process.executable="*\\cscript.exe" OR process.executable="*\\curl.exe" OR process.executable="*\\forfiles.exe" OR process.executable="*\\hh.exe" OR process.executable="*\\ieexec.exe" OR process.executable="*\\installutil.exe" OR process.executable="*\\javaw.exe" OR process.executable="*\\mftrace.exe" OR process.executable="*\\Microsoft.Workflow.Compiler.exe" OR process.executable="*\\msbuild.exe" OR process.executable="*\\msdt.exe" OR process.executable="*\\mshta.exe" OR process.executable="*\\msidb.exe" OR process.executable="*\\msiexec.exe" OR process.executable="*\\msxsl.exe" OR process.executable="*\\odbcconf.exe" OR process.executable="*\\pcalua.exe" OR process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe" OR process.executable="*\\regasm.exe" OR process.executable="*\\regsvcs.exe" OR process.executable="*\\regsvr32.exe" OR process.executable="*\\rundll32.exe" OR process.executable="*\\schtasks.exe" OR process.executable="*\\scrcons.exe" OR process.executable="*\\scriptrunner.exe" OR process.executable="*\\sh.exe" OR process.executable="*\\svchost.exe" OR process.executable="*\\verclsid.exe" OR process.executable="*\\wmic.exe" OR process.executable="*\\workfolders.exe" OR process.executable="*\\wscript.exe"))) OR ((process.executable like "%\\AppData\\%" OR process.executable like "%\\Users\\Public\\%" OR process.executable like "%\\ProgramData\\%" OR process.executable like "%\\Windows\\Tasks\\%" OR process.executable like "%\\Windows\\Temp\\%" OR process.executable like "%\\Windows\\System32\\Tasks\\%"))) AND NOT (((process.executable like "%\\AppData\\Local\\Microsoft\\OneDrive\\%" AND process.executable="*\\FileCoAuth.exe" AND process.command_line="*-Embedding") OR (process.executable="*\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe" AND process.command_line="*-Embedding"))))
