// Title: PowerShell Base64 Encoded Invoke Keyword
// ID: 6385697e-9f1b-40bd-8817-f4a91f40508e
// Status: test
// Level: high
// Author: pH-T (Nextron Systems), Harjot Singh, @cyb3rjy0t
// Date: 2022-05-20
// Tags: attack.execution, attack.stealth, attack.t1059.001, attack.t1027
// Description: Detects UTF-8 and UTF-16 Base64 encoded powershell 'Invoke-' calls
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.command_line like "% -e%") AND ((process.command_line like "%SQBuAHYAbwBrAGUALQ%" OR process.command_line like "%kAbgB2AG8AawBlAC0A%" OR process.command_line like "%JAG4AdgBvAGsAZQAtA%" OR process.command_line like "%SW52b2tlL%" OR process.command_line like "%ludm9rZS%" OR process.command_line like "%JbnZva2Ut%")) AND (((process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe")) OR ((process.pe.original_file_name = "PowerShell.EXE" OR process.pe.original_file_name = "pwsh.dll"))))
