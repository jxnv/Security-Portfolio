// Title: Suspicious Provlaunch.EXE Child Process
// ID: f9999590-1f94-4a34-a91e-951e47bedefd
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-08-08
// Tags: attack.stealth, attack.t1218
// Description: Detects suspicious child processes of "provlaunch.exe" which might indicate potential abuse to proxy execution.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.executable="*\\calc.exe" OR process.executable="*\\cmd.exe" OR process.executable="*\\cscript.exe" OR process.executable="*\\mshta.exe" OR process.executable="*\\notepad.exe" OR process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe" OR process.executable="*\\regsvr32.exe" OR process.executable="*\\rundll32.exe" OR process.executable="*\\wscript.exe")) OR ((process.executable like "%:\\PerfLogs\\%" OR process.executable like "%:\\Temp\\%" OR process.executable like "%:\\Users\\Public\\%" OR process.executable like "%\\AppData\\Temp\\%" OR process.executable like "%\\Windows\\System32\\Tasks\\%" OR process.executable like "%\\Windows\\Tasks\\%" OR process.executable like "%\\Windows\\Temp\\%"))) AND (process.parent.executable="*\\provlaunch.exe"))
