// Title: Arbitrary File Download Via MSPUB.EXE
// ID: 3b3c7f55-f771-4dd6-8a6e-08d057a17caf
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-19
// Tags: attack.execution, attack.stealth, attack.t1218
// Description: Detects usage of "MSPUB" (Microsoft Publisher) to download arbitrary files
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%ftp://%" OR process.command_line like "%http://%" OR process.command_line like "%https://%")) AND ((process.executable="*\\MSPUB.exe") OR (process.pe.original_file_name = "MSPUB.exe")))
