// Title: Suspicious Network Command
// ID: a29c1813-ab1f-4dde-b489-330b952e91ae
// Status: test
// Level: low
// Author: frack113, Christopher Peacock '@securepeacock', SCYTHE '@scythe_io'
// Date: 2021-12-07
// Tags: attack.discovery, attack.t1016
// Description: Adversaries may look for details about the network configuration and settings of systems they access or through information discovery of remote systems
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.command_line=regex("ipconfig\\s+/all") OR process.command_line=regex("netsh\\s+interface show interface") OR process.command_line=regex("arp\\s+-a") OR process.command_line=regex("nbtstat\\s+-n") OR process.command_line=regex("net\\s+config") OR process.command_line=regex("route\\s+print")))
