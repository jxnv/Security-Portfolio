// Title: New Connection Initiated To Potential Dead Drop Resolver Domain
// ID: 297ae038-edc2-4b2e-bb3e-7c5fc94dd5c7
// Status: test
// Level: high
// Author: Sorina Ionescu, X__Junior (Nextron Systems)
// Date: 2022-08-17
// Tags: attack.command-and-control, attack.t1102, attack.t1102.001
// Description: Detects an executable, which is not an internet browser or known application, initiating network connections to legit popular websites, which were seen to be used as dead drop resolvers in previous attacks.
// In this context attackers leverage known websites such as "facebook", "youtube", etc. In order to pass through undetected.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((Initiated = "true" AND (DestinationHostname="*.t.me" OR DestinationHostname="*0x0.st" OR DestinationHostname="*4shared.com" OR DestinationHostname="*abuse.ch" OR DestinationHostname="*anonfiles.com" OR DestinationHostname="*bashupload.com" OR DestinationHostname="*cdn.discordapp.com" OR DestinationHostname="*chunk.io" OR DestinationHostname="*cloudflare.com" OR DestinationHostname="*ddns.net" OR DestinationHostname="*discord.com" OR DestinationHostname="*docs.google.com" OR DestinationHostname="*drive.google.com" OR DestinationHostname="*dropbox.com" OR DestinationHostname="*dropmefiles.com" OR DestinationHostname="*facebook.com" OR DestinationHostname="*feeds.rapidfeeds.com" OR DestinationHostname="*fotolog.com" OR DestinationHostname="*ghostbin.co/" OR DestinationHostname="*githubusercontent.com" OR DestinationHostname="*gofile.io" OR DestinationHostname="*hastebin.com" OR DestinationHostname="*imgur.com" OR DestinationHostname="*livejournal.com" OR DestinationHostname="*mediafire.com" OR DestinationHostname="*mega.co.nz" OR DestinationHostname="*mega.nz" OR DestinationHostname="*onedrive.com" OR DestinationHostname="*pages.dev" OR DestinationHostname="*paste.ee" OR DestinationHostname="*pastebin.com" OR DestinationHostname="*pastebin.pl" OR DestinationHostname="*pastetext.net" OR DestinationHostname="*pixeldrain.com" OR DestinationHostname="*privatlab.com" OR DestinationHostname="*privatlab.net" OR DestinationHostname="*reddit.com" OR DestinationHostname="*send.exploit.in" OR DestinationHostname="*sendspace.com" OR DestinationHostname="*steamcommunity.com" OR DestinationHostname="*storage.googleapis.com" OR DestinationHostname="*technet.microsoft.com" OR DestinationHostname="*temp.sh" OR DestinationHostname="*transfer.sh" OR DestinationHostname="*trycloudflare.com" OR DestinationHostname="*twitter.com" OR DestinationHostname="*ufile.io" OR DestinationHostname="*vimeo.com" OR DestinationHostname="*w3spaces.com" OR DestinationHostname="*wetransfer.com" OR DestinationHostname="*workers.dev" OR DestinationHostname="*x0.at" OR DestinationHostname="*youtube.com")) AND NOT ((((process.executable="C:\\Program Files (x86)\\Avant Browser\\*" OR process.executable="C:\\Program Files\\Avant Browser\\*") AND process.executable="*\\avant.exe") OR (process.executable="C:\\Program Files\\BraveSoftware\\*" AND process.executable="*\\brave.exe") OR ((process.executable = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR process.executable = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR (process.executable="C:\\Users\\*" AND process.executable="*\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe") OR ((process.executable like "%C:\\Program Files\\Windows Defender Advanced Threat Protection\\%" OR process.executable like "%C:\\Program Files\\Windows Defender\\%" OR process.executable like "%C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\%") AND (process.executable="*\\MsMpEng.exe" OR process.executable="*\\MsSense.exe")) OR (process.executable like "%\\AppData\\Local\\Discord\\%" AND process.executable="*\\Discord.exe" AND (DestinationHostname="*discord.com" OR DestinationHostname="*cdn.discordapp.com")) OR ((process.executable="C:\\Program Files (x86)\\Dropbox\\Client\\*" OR process.executable="C:\\Program Files\\Dropbox\\Client\\*") AND (process.executable="*\\Dropbox.exe" OR process.executable="*\\DropboxInstaller.exe") AND DestinationHostname="*dropbox.com") OR ((process.executable="C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*") OR (process.executable="*\\WindowsApps\\MicrosoftEdge.exe") OR ((process.executable = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR process.executable = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process.executable="C:\\Program Files (x86)\\Microsoft\\EdgeCore\\*" OR process.executable="C:\\Program Files\\Microsoft\\EdgeCore\\*") AND (process.executable="*\\msedge.exe" OR process.executable="*\\msedgewebview2.exe")) OR (process.executable = "") OR ((process.executable="C:\\Program Files\\Falkon\\*" OR process.executable="C:\\Program Files (x86)\\Falkon\\*") AND process.executable="*\\falkon.exe") OR ((process.executable = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR process.executable = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR (process.executable="C:\\Users\\*" AND process.executable="*\\AppData\\Local\\Mozilla Firefox\\firefox.exe") OR (process.executable like "%\\AppData\\Local\\Flock\\%" AND process.executable="*\\Flock.exe") OR ((process.executable like "%C:\\Program Files\\Google\\Drive File Stream\\%" OR process.executable like "%C:\\Program Files (x86)\\Google\\Drive File Stream\\%") AND process.executable="*GoogleDriveFS.exe" AND DestinationHostname="*drive.google.com") OR ((process.executable = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR process.executable = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process.executable like "%\\AppData\\Local\\Maxthon\\%" AND process.executable="*\\maxthon.exe") OR ((process.executable="*\\MEGAsync.exe" OR process.executable="*\\MEGAsyncSetup32_*RC.exe" OR process.executable="*\\MEGAsyncSetup32.exe" OR process.executable="*\\MEGAsyncSetup64.exe" OR process.executable="*\\MEGAupdater.exe") AND (DestinationHostname="*mega.co.nz" OR DestinationHostname="*mega.nz")) OR (process.executable like "%\\AppData\\Local\\Programs\\midori-ng\\%" AND process.executable="*\\Midori Next Generation.exe") OR (NOT process.executable=*) OR (process.executable like "%\\AppData\\Local\\Microsoft\\OneDrive\\%" AND process.executable="*\\OneDrive.exe" AND DestinationHostname="*onedrive.com") OR (process.executable like "%\\AppData\\Local\\Programs\\Opera\\%" AND process.executable="*\\opera.exe") OR (process.executable like "%\\AppData\\Local\\Phoebe\\%" AND process.executable="*\\Phoebe.exe") OR ((process.executable="*C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe" OR process.executable="*C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe")) OR ((process.executable="C:\\Program Files (x86)\\QtWeb\\*" OR process.executable="C:\\Program Files\\QtWeb\\*") AND process.executable="*\\QtWeb.exe") OR ((process.executable like "%C:\\Program Files (x86)\\Safari\\%" OR process.executable like "%C:\\Program Files\\Safari\\%") AND process.executable="*\\safari.exe") OR ((process.executable="C:\\Program Files\\SeaMonkey\\*" OR process.executable="C:\\Program Files (x86)\\SeaMonkey\\*") AND process.executable="*\\seamonkey.exe") OR ((process.executable="C:\\Program Files\\SlimBrowser\\*" OR process.executable="C:\\Program Files (x86)\\SlimBrowser\\*") AND process.executable="*\\slimbrowser.exe") OR (process.executable like "%\\AppData\\Roaming\\Telegram Desktop\\%" AND process.executable="*\\Telegram.exe" AND DestinationHostname="*.t.me") OR (process.executable like "%\\AppData\\Local\\Vivaldi\\%" AND process.executable="*\\vivaldi.exe") OR ((process.executable="C:\\Program Files\\Naver\\Naver Whale\\*" OR process.executable="C:\\Program Files (x86)\\Naver\\Naver Whale\\*") AND process.executable="*\\whale.exe") OR ((process.executable="C:\\Program Files\\Waterfox\\*" OR process.executable="C:\\Program Files (x86)\\Waterfox\\*") AND process.executable="*\\Waterfox.exe") OR ((process.executable="C:\\Program Files (x86)\\WindowsApps\\*" OR process.executable="C:\\Program Files\\WindowsApps\\*") AND process.executable="*\\WhatsApp.exe" AND DestinationHostname="*facebook.com"))))
