// Title: Office Autorun Keys Modification
// ID: baecf8fb-edbf-429f-9ade-31fc3f22b970
// Status: test
// Level: medium
// Author: Victor Sergeev, Daniil Yugoslavskiy, Gleb Sukhodolskiy, Timur Zinniatullin, oscd.community, Tim Shelton, frack113 (split)
// Date: 2019-10-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects modification of autostart extensibility point (ASEP) in registry. Adversaries may modify these keys to execute malicious code when Office files are opened.
// There are various legitimate add-ins that also use these keys and this filter list might not be exhaustive.
// Thus, it is recommended to review and tune filters for your environment to reduce false positives before deploying to production.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((registry.path like "%\\Word\\Addins%" OR registry.path like "%\\PowerPoint\\Addins%" OR registry.path like "%\\Outlook\\Addins%" OR registry.path like "%\\Onenote\\Addins%" OR registry.path like "%\\Excel\\Addins%" OR registry.path like "%\\Access\\Addins%" OR registry.path like "%test\\Special\\Perf%")) AND ((registry.path like "%\\Software\\Wow6432Node\\Microsoft\\Office%" OR registry.path like "%\\Software\\Microsoft\\Office%"))) AND NOT (((registry.data.strings = "(Empty)") OR ((process.executable="C:\\Program Files\\Microsoft Office\\*" OR process.executable="C:\\Program Files (x86)\\Microsoft Office\\*" OR process.executable="C:\\PROGRA~2\\MICROS~2\\Office*" OR process.executable="C:\\Windows\\System32\\msiexec.exe*" OR process.executable="C:\\Windows\\SysWOW64\\msiexec.exe*" OR process.executable="C:\\Windows\\System32\\regsvr32.exe*" OR process.executable="C:\\Windows\\SysWOW64\\regsvr32.exe*") AND (registry.path like "%\\Excel\\Addins\\AdHocReportingExcelClientLib.AdHocReportingExcelClientAddIn.1\\%" OR registry.path like "%\\Excel\\Addins\\ExcelPlugInShell.PowerMapConnect\\%" OR registry.path like "%\\Excel\\Addins\\NativeShim\\%" OR registry.path like "%\\Excel\\Addins\\NativeShim.InquireConnector.1\\%" OR registry.path like "%\\Excel\\Addins\\PowerPivotExcelClientAddIn.NativeEntry.1\\%" OR registry.path like "%\\Outlook\\AddIns\\AccessAddin.DC\\%" OR registry.path like "%\\Outlook\\AddIns\\ColleagueImport.ColleagueImportAddin\\%" OR registry.path like "%\\Outlook\\AddIns\\EvernoteCC.EvernoteContactConnector\\%" OR registry.path like "%\\Outlook\\AddIns\\EvernoteOLRD.Connect\\%" OR registry.path like "%\\Outlook\\Addins\\OneNote.OutlookAddin%" OR registry.path like "%\\Outlook\\Addins\\DriveFSExtensionLib.Connect\\%" OR registry.path like "%\\Outlook\\Addins\\GoogleAppsSync.Connect\\%" OR registry.path like "%\\Outlook\\Addins\\Microsoft.VbaAddinForOutlook.1\\%" OR registry.path like "%\\Outlook\\Addins\\OcOffice.OcForms\\%" OR registry.path like "%\\Outlook\\Addins\\OscAddin.Connect\\%" OR registry.path like "%\\Outlook\\Addins\\OutlookChangeNotifier.Connect\\%" OR registry.path like "%\\Outlook\\Addins\\UCAddin.LyncAddin.1%" OR registry.path like "%\\Outlook\\Addins\\UCAddin.UCAddin.1%" OR registry.path like "%\\Outlook\\Addins\\UmOutlookAddin.FormRegionAddin\\%" OR registry.path like "%AddinTakeNotesService\\FriendlyName%")) OR (NOT registry.data.strings=*) OR ((process.executable="C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\*" OR process.executable="C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\*") AND process.executable="*\\OfficeClickToRun.exe") OR ((process.executable="C:\\Program Files\\Common Files\\Microsoft Shared\\VSTO\\*" OR process.executable="C:\\Program Files (x86)\\Microsoft Shared\\VSTO\\*") AND process.executable="*\\VSTOInstaller.exe"))) AND NOT ((((process.executable = "C:\\Program Files\\Avast Software\\Avast\\RegSvr.exe" OR process.executable = "C:\\Program Files\\Avast Software\\Avast\\x86\\RegSvr.exe") AND registry.path like "%\\Microsoft\\Office\\Outlook\\Addins\\Avast.AsOutExt\\%") OR ((process.executable = "C:\\Program Files\\AVG\\Antivirus\\RegSvr.exe" OR process.executable = "C:\\Program Files\\AVG\\Antivirus\\x86\\RegSvr.exe") AND registry.path like "%\\Microsoft\\Office\\Outlook\\Addins\\Antivirus.AsOutExt\\%"))))
