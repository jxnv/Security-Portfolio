// Title: System File Execution Location Anomaly
// ID: e4a6b256-3e47-40fc-89d2-7a477edd6915
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Patrick Bareiss, Anton Kutepov, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2017-11-27
// Tags: attack.stealth, attack.t1036
// Description: Detects the execution of a Windows system binary that is usually located in the system folder from an uncommon location.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.executable="*\\atbroker.exe" OR process.executable="*\\audiodg.exe" OR process.executable="*\\bcdedit.exe" OR process.executable="*\\bitsadmin.exe" OR process.executable="*\\certreq.exe" OR process.executable="*\\certutil.exe" OR process.executable="*\\cmstp.exe" OR process.executable="*\\conhost.exe" OR process.executable="*\\consent.exe" OR process.executable="*\\cscript.exe" OR process.executable="*\\csrss.exe" OR process.executable="*\\dashost.exe" OR process.executable="*\\defrag.exe" OR process.executable="*\\dfrgui.exe" OR process.executable="*\\dism.exe" OR process.executable="*\\dllhost.exe" OR process.executable="*\\dllhst3g.exe" OR process.executable="*\\dwm.exe" OR process.executable="*\\eventvwr.exe" OR process.executable="*\\fsquirt.exe" OR process.executable="*\\finger.exe" OR process.executable="*\\logonui.exe" OR process.executable="*\\LsaIso.exe" OR process.executable="*\\lsass.exe" OR process.executable="*\\lsm.exe" OR process.executable="*\\msiexec.exe" OR process.executable="*\\ntoskrnl.exe" OR process.executable="*\\powershell_ise.exe" OR process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe" OR process.executable="*\\regsvr32.exe" OR process.executable="*\\rundll32.exe" OR process.executable="*\\runonce.exe" OR process.executable="*\\RuntimeBroker.exe" OR process.executable="*\\schtasks.exe" OR process.executable="*\\services.exe" OR process.executable="*\\sihost.exe" OR process.executable="*\\smartscreen.exe" OR process.executable="*\\smss.exe" OR process.executable="*\\spoolsv.exe" OR process.executable="*\\svchost.exe" OR process.executable="*\\taskhost.exe" OR process.executable="*\\taskhostw.exe" OR process.executable="*\\Taskmgr.exe" OR process.executable="*\\userinit.exe" OR process.executable="*\\werfault.exe" OR process.executable="*\\werfaultsecure.exe" OR process.executable="*\\wininit.exe" OR process.executable="*\\winlogon.exe" OR process.executable="*\\winver.exe" OR process.executable="*\\wlanext.exe" OR process.executable="*\\wmic.exe" OR process.executable="*\\wscript.exe" OR process.executable="*\\wsl.exe" OR process.executable="*\\wsmprovhost.exe")) AND NOT ((((process.executable="C:\\$WINDOWS.~BT\\*" OR process.executable="C:\\$WinREAgent\\*" OR process.executable="C:\\Windows\\SoftwareDistribution\\*" OR process.executable="C:\\Windows\\System32\\*" OR process.executable="C:\\Windows\\SystemTemp\\*" OR process.executable="C:\\Windows\\SysWOW64\\*" OR process.executable="C:\\Windows\\uus\\*" OR process.executable="C:\\Windows\\WinSxS\\*")) OR ((process.executable like "%C:\\Program Files\\PowerShell\\7\\%" OR process.executable like "%C:\\Program Files\\PowerShell\\7-preview\\%" OR process.executable like "%C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview%" OR process.executable like "%\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview%") AND process.executable="*\\pwsh.exe") OR (process.executable="C:\\Users\\*" AND process.executable like "%\\AppData\\Local\\Microsoft\\WindowsApps\\%" AND process.executable="*\\wsl.exe") OR ((process.executable="C:\\Program Files\\WindowsApps\\MicrosoftCorporationII.WindowsSubsystemForLinux*" OR process.executable="C:\\Program Files\\WSL\\*") AND process.executable="*\\wsl.exe"))) AND NOT ((process.executable like "%\\SystemRoot\\System32\\%")))
