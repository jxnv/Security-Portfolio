// Title: Suspicious SYSTEM User Process Creation
// ID: 2617e7ed-adb7-40ba-b0f3-8f9945fe6c09
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), David ANDRE (additional keywords)
// Date: 2021-12-20
// Tags: attack.credential-access, attack.privilege-escalation, attack.stealth, attack.t1134, attack.t1003, attack.t1027
// Description: Detects a suspicious process creation as SYSTEM user (suspicious program or command line parameter)
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((IntegrityLevel = "System" OR IntegrityLevel = "S-1-16-16384") AND (user.name like "%AUTHORI%" OR user.name like "%AUTORI%")) AND (((process.executable="*\\calc.exe" OR process.executable="*\\cscript.exe" OR process.executable="*\\forfiles.exe" OR process.executable="*\\hh.exe" OR process.executable="*\\mshta.exe" OR process.executable="*\\ping.exe" OR process.executable="*\\wscript.exe")) OR (process.command_line=regex("net\\s+user\\s+")) OR ((process.command_line like "% -NoP %" OR process.command_line like "% -W Hidden %" OR process.command_line like "% -decode %" OR process.command_line like "% /decode %" OR process.command_line like "% /urlcache %" OR process.command_line like "% -urlcache %" OR process.command_line like "% -e* JAB%" OR process.command_line like "% -e* SUVYI%" OR process.command_line like "% -e* SQBFAFgA%" OR process.command_line like "% -e* aWV4I%" OR process.command_line like "% -e* IAB%" OR process.command_line like "% -e* PAA%" OR process.command_line like "% -e* aQBlAHgA%" OR process.command_line like "%vssadmin delete shadows%" OR process.command_line like "%reg SAVE HKLM%" OR process.command_line like "% -ma %" OR process.command_line like "%Microsoft\\Windows\\CurrentVersion\\Run%" OR process.command_line like "%.downloadstring(%" OR process.command_line like "%.downloadfile(%" OR process.command_line like "% /ticket:%" OR process.command_line like "%dpapi::%" OR process.command_line like "%event::clear%" OR process.command_line like "%event::drop%" OR process.command_line like "%id::modify%" OR process.command_line like "%kerberos::%" OR process.command_line like "%lsadump::%" OR process.command_line like "%misc::%" OR process.command_line like "%privilege::%" OR process.command_line like "%rpc::%" OR process.command_line like "%sekurlsa::%" OR process.command_line like "%sid::%" OR process.command_line like "%token::%" OR process.command_line like "%vault::cred%" OR process.command_line like "%vault::list%" OR process.command_line like "% p::d %" OR process.command_line like "%;iex(%" OR process.command_line like "%MiniDump%")))) AND NOT (((process.parent.executable like "%:\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\%") OR ((process.parent.executable like "%:\\Program Files (x86)\\Java\\%" OR process.parent.executable like "%:\\Program Files\\Java\\%") AND process.parent.executable="*\\bin\\javaws.exe" AND (process.executable like "%:\\Program Files (x86)\\Java\\%" OR process.executable like "%:\\Program Files\\Java\\%") AND process.executable="*\\bin\\jp2launcher.exe" AND process.command_line like "% -ma %") OR ((process.command_line like "%ping%" AND process.command_line like "%127.0.0.1%" AND process.command_line like "% -n %")) OR (process.executable="*\\PING.EXE" AND process.parent.command_line like "%\\DismFoDInstall.cmd%"))))
