// Title: Potential Credential Dumping Via WER
// ID: 9a4ccd1a-3526-4d99-b980-9f9c5d3a6ff3
// Status: test
// Level: high
// Author: @pbssubhash , Nasreddine Bencherchali
// Date: 2022-12-08
// Tags: attack.credential-access, attack.t1003.001
// Description: Detects potential credential dumping via Windows Error Reporting LSASS Shtinkering technique which uses the Windows Error Reporting to dump lsass
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((ParentUser like "%AUTHORI%" OR ParentUser like "%AUTORI%") AND (user.name like "%AUTHORI%" OR user.name like "%AUTORI%") AND (process.command_line like "% -u -p %" AND process.command_line like "% -ip %" AND process.command_line like "% -s %")) AND ((process.executable="*\\Werfault.exe") OR (process.pe.original_file_name = "WerFault.exe"))) AND NOT ((process.parent.executable = "C:\\Windows\\System32\\lsass.exe")))
