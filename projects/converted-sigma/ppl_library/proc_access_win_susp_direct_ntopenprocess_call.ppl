// Title: Potential Direct Syscall of NtOpenProcess
// ID: 3f3f3506-1895-401b-9cc3-e86b16e630d0
// Status: test
// Level: medium
// Author: Christian Burkard (Nextron Systems), Tim Shelton (FP)
// Date: 2021-07-28
// Tags: attack.execution, attack.t1106
// Description: Detects potential calls to NtOpenProcess directly from NTDLL.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((CallTrace="UNKNOWN*") AND NOT ((((SourceImage like "%:\\Program Files (x86)\\%" OR SourceImage like "%:\\Program Files\\%" OR SourceImage like "%:\\Windows\\System32\\%" OR SourceImage like "%:\\Windows\\SysWOW64\\%" OR SourceImage like "%:\\Windows\\WinSxS\\%") AND (TargetImage like "%:\\Program Files (x86)\\%" OR TargetImage like "%:\\Program Files\\%" OR TargetImage like "%:\\Windows\\System32\\%" OR TargetImage like "%:\\Windows\\SysWOW64\\%" OR TargetImage like "%:\\Windows\\WinSxS\\%")) OR (winlog.provider_name = "Microsoft-Windows-Kernel-Audit-API-Calls") OR (TargetImage="*vcredist_x64.exe" AND SourceImage="*vcredist_x64.exe"))) AND NOT (((SourceImage like "%:\\Program Files\\Adobe\\Acrobat DC\\Acrobat\\%" AND SourceImage="*\\AcroCEF.exe" AND TargetImage like "%:\\Program Files\\Adobe\\Acrobat DC\\Acrobat\\%" AND TargetImage="*\\AcroCEF.exe") OR (SourceImage="*AmazonSSMAgentSetup.exe" AND TargetImage="*AmazonSSMAgentSetup.exe") OR (SourceImage="*:\\Windows\\Explorer.EXE" AND TargetImage="*:\\Program Files\\Cylance\\Desktop\\CylanceUI.exe") OR (TargetImage like "%\\AppData\\Local\\Discord\\%" AND TargetImage="*\\Discord.exe") OR (TargetImage="*\\Evernote\\Evernote.exe") OR (TargetImage="*\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe" AND SourceImage="*\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe") OR (TargetImage="*:\\Windows\\system32\\systeminfo.exe" AND SourceImage="*setup64.exe") OR (SourceImage="*\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe" AND TargetImage="*\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe") OR (SourceImage like "%\\AppData\\Local\\yammerdesktop\\app-%" AND SourceImage="*\\Yammer.exe" AND TargetImage like "%\\AppData\\Local\\yammerdesktop\\app-%" AND TargetImage="*\\Yammer.exe" AND GrantedAccess = "0x1000"))))
