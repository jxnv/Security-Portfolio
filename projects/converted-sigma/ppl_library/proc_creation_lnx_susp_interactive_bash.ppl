// Title: Interactive Bash Suspicious Children
// ID: ea3ecad2-db86-4a89-ad0b-132a10d2db55
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-14
// Tags: attack.execution, attack.stealth, attack.t1059.004, attack.t1036
// Description: Detects suspicious interactive bash as a parent to rather uncommon child processes
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.parent.command_line = "bash -i") AND (((process.command_line like "%-c import %" OR process.command_line like "%base64%" OR process.command_line like "%pty.spawn%")) OR ((process.executable="*whoami" OR process.executable="*iptables" OR process.executable="*/ncat" OR process.executable="*/nc" OR process.executable="*/netcat"))))
