// Title: Suspicious ScreenSave Change by Reg.exe
// ID: 0fc35fc3-efe6-4898-8a37-0b233339524f
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-08-19
// Tags: attack.persistence, attack.privilege-escalation, attack.t1546.002
// Description: Adversaries may establish persistence by executing malicious content triggered by user inactivity.
// Screensavers are programs that execute after a configurable time of user inactivity and consist of Portable Executable (PE) files with a .scr file extension
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.executable="*\\reg.exe" AND (process.command_line like "%HKEY_CURRENT_USER\\Control Panel\\Desktop%" OR process.command_line like "%HKCU\\Control Panel\\Desktop%")) AND (((process.command_line like "%/v ScreenSaveActive%" AND process.command_line like "%/t REG_SZ%" AND process.command_line like "%/d 1%" AND process.command_line like "%/f%")) OR ((process.command_line like "%/v ScreenSaveTimeout%" AND process.command_line like "%/t REG_SZ%" AND process.command_line like "%/d %" AND process.command_line like "%/f%")) OR ((process.command_line like "%/v ScreenSaverIsSecure%" AND process.command_line like "%/t REG_SZ%" AND process.command_line like "%/d 0%" AND process.command_line like "%/f%")) OR ((process.command_line like "%/v SCRNSAVE.EXE%" AND process.command_line like "%/t REG_SZ%" AND process.command_line like "%/d %" AND process.command_line like "%.scr%" AND process.command_line like "%/f%"))))
