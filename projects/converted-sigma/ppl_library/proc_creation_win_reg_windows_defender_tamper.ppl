// Title: Suspicious Windows Defender Registry Key Tampering Via Reg.EXE
// ID: 452bce90-6fb0-43cc-97a5-affc283139b3
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Swachchhanda Shrawan Poudel, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-03-22
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects the usage of "reg.exe" to tamper with different Windows Defender registry keys in order to disable some important features related to protection and detection
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.executable="*\\reg.exe") OR (process.pe.original_file_name = "reg.exe")) AND ((process.command_line like "%SOFTWARE\\Microsoft\\Windows Defender\\%" OR process.command_line like "%SOFTWARE\\Policies\\Microsoft\\Windows Defender Security Center%" OR process.command_line like "%SOFTWARE\\Policies\\Microsoft\\Windows Defender\\%"))) AND (((process.command_line like "% add %" AND process.command_line like "%d 0%") AND (process.command_line like "%DisallowExploitProtectionOverride%" OR process.command_line like "%EnableControlledFolderAccess%" OR process.command_line like "%MpEnablePus%" OR process.command_line like "%PUAProtection%" OR process.command_line like "%SpynetReporting%" OR process.command_line like "%SubmitSamplesConsent%" OR process.command_line like "%TamperProtection%")) OR ((process.command_line like "% add %" AND process.command_line like "%d 1%") AND (process.command_line like "%DisableAccess%" OR process.command_line like "%DisableAntiSpyware%" OR process.command_line like "%DisableAntiSpywareRealtimeProtection%" OR process.command_line like "%DisableAntiVirus%" OR process.command_line like "%DisableAntiVirusSignatures%" OR process.command_line like "%DisableArchiveScanning%" OR process.command_line like "%DisableBehaviorMonitoring%" OR process.command_line like "%DisableBlockAtFirstSeen%" OR process.command_line like "%DisableCloudProtection%" OR process.command_line like "%DisableConfig%" OR process.command_line like "%DisableEnhancedNotifications%" OR process.command_line like "%DisableIntrusionPreventionSystem%" OR process.command_line like "%DisableIOAVProtection%" OR process.command_line like "%DisableNetworkProtection%" OR process.command_line like "%DisableOnAccessProtection%" OR process.command_line like "%DisablePrivacyMode%" OR process.command_line like "%DisableRealtimeMonitoring%" OR process.command_line like "%DisableRoutinelyTakingAction%" OR process.command_line like "%DisableScanOnRealtimeEnable%" OR process.command_line like "%DisableScriptScanning%" OR process.command_line like "%DisableSecurityCenter%" OR process.command_line like "%Notification_Suppress%" OR process.command_line like "%SignatureDisableUpdateOnStartupWithoutEngine%"))))
