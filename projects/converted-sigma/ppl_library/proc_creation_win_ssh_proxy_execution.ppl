// Title: Program Executed Using Proxy/Local Command Via SSH.EXE
// ID: 7d6d30b8-5b91-4b90-a891-46cccaf29598
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali
// Date: 2022-12-29
// Tags: attack.stealth, attack.t1218
// Description: Detect usage of the "ssh.exe" binary as a proxy to launch other programs.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.parent.executable = "C:\\Windows\\System32\\OpenSSH\\sshd.exe") OR (((process.command_line like "%ProxyCommand=%") OR ((process.command_line like "%PermitLocalCommand=yes%" AND process.command_line like "% LocalCommand%"))) AND ((process.executable="*\\ssh.exe") OR (Product = "OpenSSH for Windows") OR ((Hashes like "%IMPHASH=55b4964d29aad5438b9e950052dbbbc0%" OR Hashes like "%IMPHASH=334d66c33503ccbf647c15b47c27eef4%" OR Hashes like "%IMPHASH=27b0da080ef92afb37983d30d839141e%" OR Hashes like "%IMPHASH=977eb4c263d384e47daa0712d34713ab%" OR Hashes like "%IMPHASH=3eaadce9ae43d5a918bb082065815c3b%" OR Hashes like "%IMPHASH=980fe6cf0d996ab1eedf877222e722aa%" OR Hashes like "%IMPHASH=5f959422308ac3d721010d66647e100e%" OR Hashes like "%IMPHASH=a49aaa3d03d1cd9c8dc7fca60f7f480b%" OR Hashes like "%IMPHASH=dd335f759b6d5d6a8382b71dd9d65791%")))))
