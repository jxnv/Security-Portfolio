// Title: HackTool - CrackMapExec PowerShell Obfuscation
// ID: 6f8b3439-a203-45dc-a88b-abf57ea15ccf
// Status: test
// Level: high
// Author: Thomas Patzke
// Date: 2020-05-22
// Tags: attack.execution, attack.stealth, attack.t1059.001, attack.t1027.005
// Description: The CrachMapExec pentesting framework implements a PowerShell obfuscation with some static strings detected by this rule.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%join*split%" OR process.command_line like "%( $ShellId[1]+$ShellId[13]+'x')%" OR process.command_line like "%( $PSHome[*]+$PSHOME[*]+%" OR process.command_line like "%( $env:Public[13]+$env:Public[5]+'x')%" OR process.command_line like "%( $env:ComSpec[4,*,25]-Join'')%" OR process.command_line like "%[1,3]+'x'-Join'')%")) AND (((process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe")) OR ((process.pe.original_file_name = "PowerShell.EXE" OR process.pe.original_file_name = "pwsh.dll"))))
