// Title: Potentially Suspicious Call To Win32_NTEventlogFile Class
// ID: caf201a9-c2ce-4a26-9c3a-2b9525413711
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-07-13
// Tags: attack.defense-impairment
// Description: Detects usage of the WMI class "Win32_NTEventlogFile" in a potentially suspicious way (delete, backup, change permissions, etc.) from a PowerShell script
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.command_line like "%Win32_NTEventlogFile%") AND ((process.command_line like "%.BackupEventlog(%" OR process.command_line like "%.ChangeSecurityPermissions(%" OR process.command_line like "%.ChangeSecurityPermissionsEx(%" OR process.command_line like "%.ClearEventLog(%" OR process.command_line like "%.Delete(%" OR process.command_line like "%.DeleteEx(%" OR process.command_line like "%.Rename(%" OR process.command_line like "%.TakeOwnerShip(%" OR process.command_line like "%.TakeOwnerShipEx(%")))
