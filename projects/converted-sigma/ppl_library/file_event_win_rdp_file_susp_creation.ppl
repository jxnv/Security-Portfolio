// Title: .RDP File Created By Uncommon Application
// ID: fccfb43e-09a7-4bd2-8b37-a5a7df33386d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.stealth
// Description: Detects creation of a file with an ".rdp" extension by an application that doesn't commonly create such files.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (file.path="*.rdp" AND (process.executable="*\\brave.exe" OR process.executable="*\\CCleaner Browser\\Application\\CCleanerBrowser.exe" OR process.executable="*\\chromium.exe" OR process.executable="*\\firefox.exe" OR process.executable="*\\Google\\Chrome\\Application\\chrome.exe" OR process.executable="*\\iexplore.exe" OR process.executable="*\\microsoftedge.exe" OR process.executable="*\\msedge.exe" OR process.executable="*\\Opera.exe" OR process.executable="*\\Vivaldi.exe" OR process.executable="*\\Whale.exe" OR process.executable="*\\olk.exe" OR process.executable="*\\Outlook.exe" OR process.executable="*\\RuntimeBroker.exe" OR process.executable="*\\Thunderbird.exe" OR process.executable="*\\Discord.exe" OR process.executable="*\\Keybase.exe" OR process.executable="*\\msteams.exe" OR process.executable="*\\Slack.exe" OR process.executable="*\\teams.exe"))
