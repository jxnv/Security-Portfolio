// Title: Invoke-Obfuscation Via Stdin - System
// ID: 487c7524-f892-4054-b263-8a0ace63fc25
// Status: test
// Level: high
// Author: Nikita Nazarov, oscd.community
// Date: 2020-10-12
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via Stdin in Scripts
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (winlog.provider_name = "Service Control Manager" AND winlog.event_id = "7045" AND (ImagePath like "%set%" AND ImagePath like "%&&%") AND (ImagePath like "%environment%" OR ImagePath like "%invoke%" OR ImagePath like "%input%"))
