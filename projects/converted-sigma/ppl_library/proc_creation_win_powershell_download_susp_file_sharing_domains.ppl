// Title: Potentially Suspicious File Download From File Sharing Domain Via PowerShell.EXE
// ID: b6e04788-29e1-4557-bb14-77f761848ab8
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-02-23
// Tags: attack.execution
// Description: Detects potentially suspicious file downloads from file sharing domains using PowerShell.exe
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%.DownloadString(%" OR process.command_line like "%.DownloadFile(%" OR process.command_line like "%Invoke-WebRequest %" OR process.command_line like "%iwr %" OR process.command_line like "%wget %")) AND (((process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe")) OR ((process.pe.original_file_name = "PowerShell.EXE" OR process.pe.original_file_name = "pwsh.dll"))) AND ((process.command_line like "%0x0.st%" OR process.command_line like "%anonfiles.com%" OR process.command_line like "%bashupload.com%" OR process.command_line like "%cdn.discordapp.com%" OR process.command_line like "%chunk.io%" OR process.command_line like "%ddns.net%" OR process.command_line like "%dl.dropboxusercontent.com%" OR process.command_line like "%ghostbin.co%" OR process.command_line like "%glitch.me%" OR process.command_line like "%gofile.io%" OR process.command_line like "%hastebin.com%" OR process.command_line like "%mediafire.com%" OR process.command_line like "%mega.nz%" OR process.command_line like "%onrender.com%" OR process.command_line like "%pages.dev%" OR process.command_line like "%paste.ee%" OR process.command_line like "%pastebin.com%" OR process.command_line like "%pastebin.pl%" OR process.command_line like "%pastetext.net%" OR process.command_line like "%pixeldrain.com%" OR process.command_line like "%privatlab.com%" OR process.command_line like "%privatlab.net%" OR process.command_line like "%send.exploit.in%" OR process.command_line like "%sendspace.com%" OR process.command_line like "%storage.googleapis.com%" OR process.command_line like "%storjshare.io%" OR process.command_line like "%supabase.co%" OR process.command_line like "%temp.sh%" OR process.command_line like "%transfer.sh%" OR process.command_line like "%trycloudflare.com%" OR process.command_line like "%ufile.io%" OR process.command_line like "%w3spaces.com%" OR process.command_line like "%workers.dev%" OR process.command_line like "%x0.at%")))
