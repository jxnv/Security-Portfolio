// Title: Registry Manipulation via WMI Stdregprov
// ID: c453ab7a-1f5c-4716-a3b4-dea8135fb43a
// Status: experimental
// Level: medium
// Author: Daniel Koifman (KoifSec)
// Date: 2025-07-30
// Tags: attack.execution, attack.t1047, attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects the usage of wmic.exe to modify Windows registry via the WMI StdRegProv class write methods (CreateKey, DeleteKey, SetStringValue, etc.).
// This behaviour could be potentially suspicious because it uses an alternative method to modify registry keys instead of legitimate registry tools like reg.exe or regedit.exe.
// Attackers specifically choose this technique to evade detection and bypass security monitoring focused on traditional registry modification commands.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%stdregprov%" AND process.command_line like "%call%") AND (process.command_line like "%CreateKey%" OR process.command_line like "%DeleteKey%" OR process.command_line like "%DeleteValue%" OR process.command_line like "%SetBinaryValue%" OR process.command_line like "%SetDWORDValue%" OR process.command_line like "%SetExpandedStringValue%" OR process.command_line like "%SetMultiStringValue%" OR process.command_line like "%SetQWORDValue%" OR process.command_line like "%SetSecurityDescriptor%" OR process.command_line like "%SetStringValue%")) AND ((process.executable="*\\wmic.exe") OR (process.pe.original_file_name = "wmic.exe")))
