// Title: Potential Suspicious Change To Sensitive/Critical Files
// ID: 86157017-c2b1-4d4a-8c33-93b8e67e4af4
// Status: test
// Level: medium
// Author: @d4ns4n_ (Wuerth-Phoenix)
// Date: 2023-05-30
// Tags: attack.impact, attack.t1565.001
// Description: Detects changes of sensitive and critical files. Monitors files that you don't expect to change without planning on Linux system.
// These files include, but are not limited to, system configuration files, authentication files, and critical application files.
// Attackers often target these files to maintain persistence, escalate privileges, or disrupt system operations.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.executable="*/cat" OR process.executable="*/echo" OR process.executable="*/grep" OR process.executable="*/head" OR process.executable="*/more" OR process.executable="*/tail") AND process.command_line like "%>%") OR ((process.executable="*/emacs" OR process.executable="*/nano" OR process.executable="*/sed" OR process.executable="*/vi" OR process.executable="*/vim"))) AND ((process.command_line like "%/bin/login%" OR process.command_line like "%/bin/passwd%" OR process.command_line like "%/boot/%" OR process.command_line like "%/etc/*.conf%" OR process.command_line like "%/etc/cron.%" OR process.command_line like "%/etc/crontab%" OR process.command_line like "%/etc/hosts%" OR process.command_line like "%/etc/init.d%" OR process.command_line like "%/etc/sudoers%" OR process.command_line like "%/opt/bin/%" OR process.command_line like "%/sbin%" OR process.command_line like "%/usr/bin/%" OR process.command_line like "%/usr/local/bin/%")) AND NOT (1=1))
