// Title: Persistence and Execution at Scale via GPO Scheduled Task
// ID: a8f29a7b-b137-4446-80a0-b804272f3da2
// Status: test
// Level: high
// Author: Samir Bousseaden
// Date: 2019-04-03
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.lateral-movement, attack.t1053.005
// Description: Detect lateral movement using GPO scheduled task, usually used to deploy ransomware at scale
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((winlog.event_id = "5136" AND (AttributeLDAPDisplayName = "gPCMachineExtensionNames" OR AttributeLDAPDisplayName = "gPCUserExtensionNames") AND (AttributeValue like "%CAB54552-DEEA-4691-817E-ED4A4D1AFC72%" OR AttributeValue like "%AADCED64-746C-4633-A97C-D61349046527%")) OR (winlog.event_id = "5145" AND ShareName="*\\SYSVOL" AND RelativeTargetName="*ScheduledTasks.xml" AND (AccessList like "%WriteData%" OR AccessList like "%%%4417%")))
