// Title: Access To Crypto Currency Wallets By Uncommon Applications
// ID: f41b0311-44f9-44f0-816d-dd45e39d4bc8
// Status: test
// Level: medium
// Author: X__Junior (Nextron Systems)
// Date: 2024-07-29
// Tags: attack.t1003, attack.credential-access
// Description: Detects file access requests to crypto currency files by uncommon processes.
// Could indicate potential attempt of crypto currency wallet stealing.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((FileName like "%\\AppData\\Roaming\\Ethereum\\keystore\\%" OR FileName like "%\\AppData\\Roaming\\EthereumClassic\\keystore\\%" OR FileName like "%\\AppData\\Roaming\\monero\\wallets\\%")) OR ((FileName="*\\AppData\\Roaming\\Bitcoin\\wallet.dat" OR FileName="*\\AppData\\Roaming\\BitcoinABC\\wallet.dat" OR FileName="*\\AppData\\Roaming\\BitcoinSV\\wallet.dat" OR FileName="*\\AppData\\Roaming\\DashCore\\wallet.dat" OR FileName="*\\AppData\\Roaming\\DogeCoin\\wallet.dat" OR FileName="*\\AppData\\Roaming\\Litecoin\\wallet.dat" OR FileName="*\\AppData\\Roaming\\Ripple\\wallet.dat" OR FileName="*\\AppData\\Roaming\\Zcash\\wallet.dat"))) AND NOT ((((process.executable="C:\\Program Files (x86)\\*" OR process.executable="C:\\Program Files\\*" OR process.executable="C:\\Windows\\system32\\*" OR process.executable="C:\\Windows\\SysWOW64\\*")) OR (process.executable = "System"))) AND NOT ((process.executable="C:\\ProgramData\\Microsoft\\Windows Defender\\*" AND (process.executable="*\\MpCopyAccelerator.exe" OR process.executable="*\\MsMpEng.exe"))))
