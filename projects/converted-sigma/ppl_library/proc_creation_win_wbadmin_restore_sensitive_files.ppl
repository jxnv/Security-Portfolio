// Title: Sensitive File Recovery From Backup Via Wbadmin.EXE
// ID: 84972c80-251c-4c3a-9079-4f00aad93938
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), frack113
// Date: 2024-05-10
// Tags: attack.credential-access, attack.t1003.003
// Description: Detects the dump of highly sensitive files such as "NTDS.DIT" and "SECURITY" hive.
// Attackers can leverage the "wbadmin" utility in order to dump sensitive files that might contain credential or sensitive information.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "% recovery%" AND process.command_line like "%recoveryTarget%" AND process.command_line like "%itemtype:File%") AND (process.command_line like "%\\config\\SAM%" OR process.command_line like "%\\config\\SECURITY%" OR process.command_line like "%\\config\\SYSTEM%" OR process.command_line like "%\\Windows\\NTDS\\NTDS.dit%")) AND ((process.executable="*\\wbadmin.exe") OR (process.pe.original_file_name = "WBADMIN.EXE")))
