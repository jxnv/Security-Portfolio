// Title: Process Execution From A Potentially Suspicious Folder
// ID: 3dfd06d2-eaf4-4532-9555-68aca59f57c4
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Tim Shelton
// Date: 2019-01-16
// Tags: attack.stealth, attack.t1036
// Description: Detects a potentially suspicious execution from an uncommon folder.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.executable like "%:\\Perflogs\\%" OR process.executable like "%:\\Users\\All Users\\%" OR process.executable like "%:\\Users\\Default\\%" OR process.executable like "%:\\Users\\NetworkService\\%" OR process.executable like "%:\\Windows\\addins\\%" OR process.executable like "%:\\Windows\\debug\\%" OR process.executable like "%:\\Windows\\Fonts\\%" OR process.executable like "%:\\Windows\\Help\\%" OR process.executable like "%:\\Windows\\IME\\%" OR process.executable like "%:\\Windows\\Media\\%" OR process.executable like "%:\\Windows\\repair\\%" OR process.executable like "%:\\Windows\\security\\%" OR process.executable like "%:\\Windows\\System32\\Tasks\\%" OR process.executable like "%:\\Windows\\Tasks\\%" OR process.executable like "%$Recycle.bin%" OR process.executable like "%\\config\\systemprofile\\%" OR process.executable like "%\\Intel\\Logs\\%" OR process.executable like "%\\RSA\\MachineKeys\\%")) AND NOT (((process.executable="C:\\Windows\\SysWOW64\\config\\systemprofile\\Citrix\\UpdaterBinaries\\*" AND process.executable="*\\CitrixReceiverUpdater.exe") OR (process.executable="C:\\Users\\Public\\IBM\\ClientSolutions\\Start_Programs\\*"))))
