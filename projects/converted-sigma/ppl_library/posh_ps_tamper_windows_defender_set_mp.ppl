// Title: Tamper Windows Defender - ScriptBlockLogging
// ID: 14c71865-6cd3-44ae-adaa-1db923fae5f2
// Status: test
// Level: high
// Author: frack113, elhoim, Tim Shelton (fps, alias support), Swachchhanda Shrawan Poudel, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-16
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects PowerShell scripts attempting to disable scheduled scanning and other parts of Windows Defender ATP or set default actions to allow.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((ScriptBlockText like "%-dbaf $true%" OR ScriptBlockText like "%-dbaf 1%" OR ScriptBlockText like "%-dbm $true%" OR ScriptBlockText like "%-dbm 1%" OR ScriptBlockText like "%-dips $true%" OR ScriptBlockText like "%-dips 1%" OR ScriptBlockText like "%-DisableArchiveScanning $true%" OR ScriptBlockText like "%-DisableArchiveScanning 1%" OR ScriptBlockText like "%-DisableBehaviorMonitoring $true%" OR ScriptBlockText like "%-DisableBehaviorMonitoring 1%" OR ScriptBlockText like "%-DisableBlockAtFirstSeen $true%" OR ScriptBlockText like "%-DisableBlockAtFirstSeen 1%" OR ScriptBlockText like "%-DisableCatchupFullScan $true%" OR ScriptBlockText like "%-DisableCatchupFullScan 1%" OR ScriptBlockText like "%-DisableCatchupQuickScan $true%" OR ScriptBlockText like "%-DisableCatchupQuickScan 1%" OR ScriptBlockText like "%-DisableIntrusionPreventionSystem $true%" OR ScriptBlockText like "%-DisableIntrusionPreventionSystem 1%" OR ScriptBlockText like "%-DisableIOAVProtection $true%" OR ScriptBlockText like "%-DisableIOAVProtection 1%" OR ScriptBlockText like "%-DisableRealtimeMonitoring $true%" OR ScriptBlockText like "%-DisableRealtimeMonitoring 1%" OR ScriptBlockText like "%-DisableRemovableDriveScanning $true%" OR ScriptBlockText like "%-DisableRemovableDriveScanning 1%" OR ScriptBlockText like "%-DisableScanningMappedNetworkDrivesForFullScan $true%" OR ScriptBlockText like "%-DisableScanningMappedNetworkDrivesForFullScan 1%" OR ScriptBlockText like "%-DisableScanningNetworkFiles $true%" OR ScriptBlockText like "%-DisableScanningNetworkFiles 1%" OR ScriptBlockText like "%-DisableScriptScanning $true%" OR ScriptBlockText like "%-DisableScriptScanning 1%" OR ScriptBlockText like "%-MAPSReporting $false%" OR ScriptBlockText like "%-MAPSReporting 0%" OR ScriptBlockText like "%-drdsc $true%" OR ScriptBlockText like "%-drdsc 1%" OR ScriptBlockText like "%-drtm $true%" OR ScriptBlockText like "%-drtm 1%" OR ScriptBlockText like "%-dscrptsc $true%" OR ScriptBlockText like "%-dscrptsc 1%" OR ScriptBlockText like "%-dsmndf $true%" OR ScriptBlockText like "%-dsmndf 1%" OR ScriptBlockText like "%-dsnf $true%" OR ScriptBlockText like "%-dsnf 1%" OR ScriptBlockText like "%-dss $true%" OR ScriptBlockText like "%-dss 1%")) AND (ScriptBlockText like "%Set-MpPreference%")) OR ((ScriptBlockText like "%Set-MpPreference%") AND ((ScriptBlockText like "%HighThreatDefaultAction Allow%" OR ScriptBlockText like "%htdefac Allow%" OR ScriptBlockText like "%LowThreatDefaultAction Allow%" OR ScriptBlockText like "%ltdefac Allow%" OR ScriptBlockText like "%ModerateThreatDefaultAction Allow%" OR ScriptBlockText like "%mtdefac Allow%" OR ScriptBlockText like "%SevereThreatDefaultAction Allow%" OR ScriptBlockText like "%stdefac Allow%"))))
