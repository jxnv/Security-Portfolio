// Title: Invoke-Obfuscation VAR++ LAUNCHER OBFUSCATION
// ID: e9f55347-2928-4c06-88e5-1a7f8169942e
// Status: test
// Level: high
// Author: Timur Zinniatullin, oscd.community
// Date: 2020-10-13
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via VAR++ LAUNCHER
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.command_line like "%&&set%" AND process.command_line like "%cmd%" AND process.command_line like "%/c%" AND process.command_line like "%-f%") AND (process.command_line like "%{0}%" OR process.command_line like "%{1}%" OR process.command_line like "%{2}%" OR process.command_line like "%{3}%" OR process.command_line like "%{4}%" OR process.command_line like "%{5}%"))
