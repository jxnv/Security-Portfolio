// Title: Execution Of Script Located In Potentially Suspicious Directory
// ID: 30bcce26-51c5-49f2-99c8-7b59e3af36c7
// Status: test
// Level: medium
// Author: Joseliyo Sanchez, @Joseliyo_Jstnk
// Date: 2023-06-02
// Tags: attack.execution
// Description: Detects executions of scripts located in potentially suspicious locations such as "/tmp" via a shell such as "bash", "sh", etc.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.command_line like "% -c %") AND ((process.executable="*/bash" OR process.executable="*/csh" OR process.executable="*/dash" OR process.executable="*/fish" OR process.executable="*/ksh" OR process.executable="*/sh" OR process.executable="*/zsh")) AND (process.command_line like "%/tmp/%"))
