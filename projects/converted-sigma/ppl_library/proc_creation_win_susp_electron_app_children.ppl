// Title: Suspicious Electron Application Child Processes
// ID: f26eb764-fd89-464b-85e2-dc4a8e6e77b8
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-21
// Tags: attack.execution
// Description: Detects suspicious child processes of electron apps (teams, discord, slack, etc.). This could be a potential sign of ".asar" file tampering (See reference section for more information) or binary execution proxy through specific CLI arguments (see related rule)
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.parent.executable="*\\chrome.exe" OR process.parent.executable="*\\discord.exe" OR process.parent.executable="*\\GitHubDesktop.exe" OR process.parent.executable="*\\keybase.exe" OR process.parent.executable="*\\msedge.exe" OR process.parent.executable="*\\msedgewebview2.exe" OR process.parent.executable="*\\msteams.exe" OR process.parent.executable="*\\slack.exe" OR process.parent.executable="*\\teams.exe")) AND (((process.executable="*\\cmd.exe" OR process.executable="*\\cscript.exe" OR process.executable="*\\mshta.exe" OR process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe" OR process.executable="*\\regsvr32.exe" OR process.executable="*\\whoami.exe" OR process.executable="*\\wscript.exe")) OR ((process.executable like "%:\\ProgramData\\%" OR process.executable like "%:\\Temp\\%" OR process.executable like "%\\AppData\\Local\\Temp\\%" OR process.executable like "%\\Users\\Public\\%" OR process.executable like "%\\Windows\\Temp\\%"))) AND NOT ((process.parent.executable="*\\Discord.exe" AND process.executable="*\\cmd.exe" AND process.command_line like "%\\NVSMI\\nvidia-smi.exe%")))
