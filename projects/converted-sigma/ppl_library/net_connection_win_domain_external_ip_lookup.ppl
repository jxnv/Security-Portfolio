// Title: Suspicious Network Connection to IP Lookup Service APIs
// ID: edf3485d-dac4-4d50-90e4-b0e5813f7e60
// Status: test
// Level: medium
// Author: Janantha Marasinghe, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-24
// Tags: attack.discovery, attack.t1016
// Description: Detects external IP address lookups by non-browser processes via services such as "api.ipify.org". This could be indicative of potential post compromise internet test activity.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((DestinationHostname = "www.ip.cn" OR DestinationHostname = "l2.io")) OR ((DestinationHostname like "%api.2ip.ua%" OR DestinationHostname like "%api.bigdatacloud.net%" OR DestinationHostname like "%api.ipify.org%" OR DestinationHostname like "%bot.whatismyipaddress.com%" OR DestinationHostname like "%canireachthe.net%" OR DestinationHostname like "%checkip.amazonaws.com%" OR DestinationHostname like "%checkip.dyndns.org%" OR DestinationHostname like "%curlmyip.com%" OR DestinationHostname like "%db-ip.com%" OR DestinationHostname like "%edns.ip-api.com%" OR DestinationHostname like "%eth0.me%" OR DestinationHostname like "%freegeoip.app%" OR DestinationHostname like "%geoipy.com%" OR DestinationHostname like "%getip.pro%" OR DestinationHostname like "%icanhazip.com%" OR DestinationHostname like "%ident.me%" OR DestinationHostname like "%ifconfig.io%" OR DestinationHostname like "%ifconfig.me%" OR DestinationHostname like "%ip-api.com%" OR DestinationHostname like "%ip.360.cn%" OR DestinationHostname like "%ip.anysrc.net%" OR DestinationHostname like "%ip.taobao.com%" OR DestinationHostname like "%ip.tyk.nu%" OR DestinationHostname like "%ipaddressworld.com%" OR DestinationHostname like "%ipapi.co%" OR DestinationHostname like "%ipconfig.io%" OR DestinationHostname like "%ipecho.net%" OR DestinationHostname like "%ipinfo.io%" OR DestinationHostname like "%ipip.net%" OR DestinationHostname like "%ipof.in%" OR DestinationHostname like "%ipv4.icanhazip.com%" OR DestinationHostname like "%ipv4bot.whatismyipaddress.com%" OR DestinationHostname like "%ipv6-test.com%" OR DestinationHostname like "%ipwho.is%" OR DestinationHostname like "%jsonip.com%" OR DestinationHostname like "%myexternalip.com%" OR DestinationHostname like "%seeip.org%" OR DestinationHostname like "%wgetip.com%" OR DestinationHostname like "%whatismyip.akamai.com%" OR DestinationHostname like "%whois.pconline.com.cn%" OR DestinationHostname like "%wtfismyip.com%"))) AND NOT (((process.executable="*\\brave.exe") OR ((process.executable = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR process.executable = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((process.executable="C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*") OR (process.executable="*\\WindowsApps\\MicrosoftEdge.exe") OR ((process.executable = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR process.executable = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process.executable="C:\\Program Files (x86)\\Microsoft\\EdgeCore\\*" OR process.executable="C:\\Program Files\\Microsoft\\EdgeCore\\*") AND (process.executable="*\\msedge.exe" OR process.executable="*\\msedgewebview2.exe")) OR ((process.executable = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR process.executable = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR ((process.executable = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR process.executable = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process.executable="*\\maxthon.exe") OR (process.executable="*\\opera.exe") OR (process.executable="*\\safari.exe") OR (process.executable="*\\seamonkey.exe") OR (process.executable="*\\vivaldi.exe") OR (process.executable="*\\whale.exe"))))
