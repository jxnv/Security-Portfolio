// Title: PowerShell Base64 Encoded WMI Classes
// ID: 1816994b-42e1-4fb1-afd2-134d88184f71
// Status: test
// Level: high
// Author: Christian Burkard (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-30
// Tags: attack.execution, attack.stealth, attack.t1059.001, attack.t1027
// Description: Detects calls to base64 encoded WMI class such as "Win32_ShadowCopy", "Win32_ScheduledJob", etc.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe")) OR ((process.pe.original_file_name = "PowerShell.EXE" OR process.pe.original_file_name = "pwsh.dll"))) AND (((process.command_line like "%VwBpAG4AMwAyAF8ATABvAGcAZwBlAGQATwBuAFUAcwBlAHIA%" OR process.command_line like "%cAaQBuADMAMgBfAEwAbwBnAGcAZQBkAE8AbgBVAHMAZQByA%" OR process.command_line like "%XAGkAbgAzADIAXwBMAG8AZwBnAGUAZABPAG4AVQBzAGUAcg%" OR process.command_line like "%V2luMzJfTG9nZ2VkT25Vc2Vy%" OR process.command_line like "%dpbjMyX0xvZ2dlZE9uVXNlc%" OR process.command_line like "%XaW4zMl9Mb2dnZWRPblVzZX%")) OR ((process.command_line like "%VwBpAG4AMwAyAF8AUAByAG8AYwBlAHMAcw%" OR process.command_line like "%cAaQBuADMAMgBfAFAAcgBvAGMAZQBzAHMA%" OR process.command_line like "%XAGkAbgAzADIAXwBQAHIAbwBjAGUAcwBzA%" OR process.command_line like "%V2luMzJfUHJvY2Vzc%" OR process.command_line like "%dpbjMyX1Byb2Nlc3%" OR process.command_line like "%XaW4zMl9Qcm9jZXNz%")) OR ((process.command_line like "%VwBpAG4AMwAyAF8AUwBjAGgAZQBkAHUAbABlAGQASgBvAGIA%" OR process.command_line like "%cAaQBuADMAMgBfAFMAYwBoAGUAZAB1AGwAZQBkAEoAbwBiA%" OR process.command_line like "%XAGkAbgAzADIAXwBTAGMAaABlAGQAdQBsAGUAZABKAG8AYg%" OR process.command_line like "%V2luMzJfU2NoZWR1bGVkSm9i%" OR process.command_line like "%dpbjMyX1NjaGVkdWxlZEpvY%" OR process.command_line like "%XaW4zMl9TY2hlZHVsZWRKb2%")) OR ((process.command_line like "%VwBpAG4AMwAyAF8AUwBoAGEAZABvAHcAYwBvAHAAeQ%" OR process.command_line like "%cAaQBuADMAMgBfAFMAaABhAGQAbwB3AGMAbwBwAHkA%" OR process.command_line like "%XAGkAbgAzADIAXwBTAGgAYQBkAG8AdwBjAG8AcAB5A%" OR process.command_line like "%V2luMzJfU2hhZG93Y29we%" OR process.command_line like "%dpbjMyX1NoYWRvd2NvcH%" OR process.command_line like "%XaW4zMl9TaGFkb3djb3B5%")) OR ((process.command_line like "%VwBpAG4AMwAyAF8AVQBzAGUAcgBBAGMAYwBvAHUAbgB0A%" OR process.command_line like "%cAaQBuADMAMgBfAFUAcwBlAHIAQQBjAGMAbwB1AG4AdA%" OR process.command_line like "%XAGkAbgAzADIAXwBVAHMAZQByAEEAYwBjAG8AdQBuAHQA%" OR process.command_line like "%V2luMzJfVXNlckFjY291bn%" OR process.command_line like "%dpbjMyX1VzZXJBY2NvdW50%" OR process.command_line like "%XaW4zMl9Vc2VyQWNjb3Vud%"))))
