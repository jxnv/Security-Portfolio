// Title: Use of W32tm as Timer
// ID: 6da2c9f5-7c53-401b-aacb-92c040ce1215
// Status: test
// Level: high
// Author: frack113
// Date: 2022-09-25
// Tags: attack.discovery, attack.t1124
// Description: When configured with suitable command line arguments, w32tm can act as a delay mechanism
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%/stripchart%" AND process.command_line like "%/computer:%" AND process.command_line like "%/period:%" AND process.command_line like "%/dataonly%" AND process.command_line like "%/samples:%")) AND ((process.executable="*\\w32tm.exe") OR (process.pe.original_file_name = "w32time.dll")))
