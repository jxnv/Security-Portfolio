// Title: PowerShell Set-Acl On Windows Folder
// ID: 0944e002-e3f6-4eb5-bf69-3a3067b53d73
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-18
// Tags: attack.stealth
// Description: Detects PowerShell scripts to set the ACL to a file in the Windows folder
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%Set-Acl %" AND process.command_line like "%-AclObject %")) AND (((process.pe.original_file_name = "PowerShell.EXE" OR process.pe.original_file_name = "pwsh.dll")) OR ((process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe"))) AND ((process.command_line like "%-Path \"C:\\Windows%" OR process.command_line like "%-Path 'C:\\Windows%" OR process.command_line like "%-Path %windir%%" OR process.command_line like "%-Path $env:windir%")) AND ((process.command_line like "%FullControl%" OR process.command_line like "%Allow%")))
