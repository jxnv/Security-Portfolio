// Title: Suspicious Network Connection Binary No CommandLine
// ID: 20384606-a124-4fec-acbb-8bd373728613
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-07-03
// Tags: attack.stealth
// Description: Detects suspicious network connections made by a well-known Windows binary run with no command line parameters
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((Initiated = "true" AND (process.executable="*\\regsvr32.exe" OR process.executable="*\\rundll32.exe" OR process.executable="*\\dllhost.exe") AND (process.command_line="*\\regsvr32.exe" OR process.command_line="*\\rundll32.exe" OR process.command_line="*\\dllhost.exe")) AND NOT (((process.command_line = "") OR (NOT process.command_line=*))))
