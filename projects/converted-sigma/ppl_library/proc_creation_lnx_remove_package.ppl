// Title: Linux Package Uninstall
// ID: 95d61234-7f56-465c-6f2d-b562c6fedbc4
// Status: test
// Level: low
// Author: Tuan Le (NCSGroup), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-03-09
// Tags: attack.stealth, attack.t1070
// Description: Detects linux package removal using builtin tools such as "yum", "apt", "apt-get" or "dpkg".
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.executable="*/apt" OR process.executable="*/apt-get") AND (process.command_line like "%remove%" OR process.command_line like "%purge%")) OR (process.executable="*/dpkg" AND (process.command_line like "%--remove %" OR process.command_line like "% -r %")) OR (process.executable="*/rpm" AND process.command_line like "% -e %") OR (process.executable="*/yum" AND (process.command_line like "%erase%" OR process.command_line like "%remove%")))
