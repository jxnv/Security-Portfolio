// Title: Potentially Suspicious GoogleUpdate Child Process
// ID: 84b1ecf9-6eff-4004-bafb-bae5c0e251b2
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-15
// Tags: attack.stealth
// Description: Detects potentially suspicious child processes of "GoogleUpdate.exe"
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.parent.executable="*\\GoogleUpdate.exe") AND NOT (((NOT process.executable=*) OR ((process.executable like "%\\Google%") OR ((process.executable="*\\setup.exe" OR process.executable="*chrome_updater.exe" OR process.executable="*chrome_installer.exe"))))))
