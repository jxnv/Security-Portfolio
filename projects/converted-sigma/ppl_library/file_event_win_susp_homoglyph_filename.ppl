// Title: Potential Homoglyph Attack Using Lookalike Characters in Filename
// ID: 4f1707b1-b50b-45b4-b5a2-3978b5a5d0d6
// Status: test
// Level: medium
// Author: Micah Babinski, @micahbabinski
// Date: 2023-05-08
// Tags: attack.stealth, attack.t1036, attack.t1036.003
// Description: Detects the presence of unicode characters which are homoglyphs, or identical in appearance, to ASCII letter characters.
// This is used as an obfuscation and masquerading techniques. Only "perfect" homoglyphs are included; these are characters that
// are indistinguishable from ASCII characters and thus may make excellent candidates for homoglyph attack characters.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((file.path like "%а%" OR file.path like "%е%" OR file.path like "%о%" OR file.path like "%р%" OR file.path like "%с%" OR file.path like "%х%" OR file.path like "%ѕ%" OR file.path like "%і%" OR file.path like "%ӏ%" OR file.path like "%ј%" OR file.path like "%һ%" OR file.path like "%ԁ%" OR file.path like "%ԛ%" OR file.path like "%ԝ%" OR file.path like "%ο%")) OR ((file.path like "%А%" OR file.path like "%В%" OR file.path like "%Е%" OR file.path like "%К%" OR file.path like "%М%" OR file.path like "%Н%" OR file.path like "%О%" OR file.path like "%Р%" OR file.path like "%С%" OR file.path like "%Т%" OR file.path like "%Х%" OR file.path like "%Ѕ%" OR file.path like "%І%" OR file.path like "%Ј%" OR file.path like "%Ү%" OR file.path like "%Ӏ%" OR file.path like "%Ԍ%" OR file.path like "%Ԛ%" OR file.path like "%Ԝ%" OR file.path like "%Α%" OR file.path like "%Β%" OR file.path like "%Ε%" OR file.path like "%Ζ%" OR file.path like "%Η%" OR file.path like "%Ι%" OR file.path like "%Κ%" OR file.path like "%Μ%" OR file.path like "%Ν%" OR file.path like "%Ο%" OR file.path like "%Ρ%" OR file.path like "%Τ%" OR file.path like "%Υ%" OR file.path like "%Χ%")))
