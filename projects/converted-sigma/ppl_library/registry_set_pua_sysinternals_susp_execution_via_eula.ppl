// Title: PUA - Sysinternals Tools Execution - Registry
// ID: c7da8edc-49ae-45a2-9e61-9fd860e4e73d
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-24
// Tags: attack.resource-development, attack.t1588.002
// Description: Detects the execution of some potentially unwanted tools such as PsExec, Procdump, etc. (part of the Sysinternals suite) via the creation of the "accepteula" registry key.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((registry.path like "%\\Active Directory Explorer%" OR registry.path like "%\\Handle%" OR registry.path like "%\\LiveKd%" OR registry.path like "%\\Process Explorer%" OR registry.path like "%\\ProcDump%" OR registry.path like "%\\PsExec%" OR registry.path like "%\\PsLoglist%" OR registry.path like "%\\PsPasswd%" OR registry.path like "%\\SDelete%" OR registry.path like "%\\Sysinternals%") AND registry.path="*\\EulaAccepted")
