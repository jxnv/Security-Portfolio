// Title: Print History File Contents
// ID: d7821ff1-4527-4e33-9f84-d0d57fa2fb66
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-06-20
// Tags: attack.reconnaissance, attack.t1592.004
// Description: Detects events in which someone prints the contents of history files to the commandline or redirects it to a file for reconnaissance
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.executable="*/cat" OR process.executable="*/head" OR process.executable="*/tail" OR process.executable="*/more")) AND (((process.command_line like "%/.bash_history%" OR process.command_line like "%/.zsh_history%")) OR ((process.command_line="*_history" OR process.command_line="*.history" OR process.command_line="*zhistory"))))
