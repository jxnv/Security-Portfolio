// Title: New Firewall Rule Added In Windows Firewall Exception List For Potential Suspicious Application
// ID: 9e2575e7-2cb9-4da1-adc8-ed94221dca5e
// Status: test
// Level: high
// Author: frack113
// Date: 2023-02-26
// Tags: attack.defense-impairment, attack.t1686.003
// Description: Detects the addition of a new rule to the Windows Firewall exception list for an application located in a potentially suspicious location.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((winlog.event_id = "2004" OR winlog.event_id = "2071" OR winlog.event_id = "2097") AND (ApplicationPath like "%:\\PerfLogs\\%" OR ApplicationPath like "%:\\Temp\\%" OR ApplicationPath like "%:\\Tmp\\%" OR ApplicationPath like "%:\\Users\\Public\\%" OR ApplicationPath like "%:\\Windows\\Tasks\\%" OR ApplicationPath like "%:\\Windows\\Temp\\%" OR ApplicationPath like "%\\AppData\\Local\\Temp\\%")) AND NOT ((Action = "2")))
