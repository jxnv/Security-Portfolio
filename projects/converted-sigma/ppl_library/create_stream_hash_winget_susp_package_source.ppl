// Title: Potential Suspicious Winget Package Installation
// ID: a3f5c081-e75b-43a0-9f5b-51f26fe5dba2
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.persistence, attack.stealth
// Description: Detects potential suspicious winget package installation from a suspicious source.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (Contents="[ZoneTransfer]  ZoneId=3*" AND (Contents like "%://1%" OR Contents like "%://2%" OR Contents like "%://3%" OR Contents like "%://4%" OR Contents like "%://5%" OR Contents like "%://6%" OR Contents like "%://7%" OR Contents like "%://8%" OR Contents like "%://9%") AND file.path="*:Zone.Identifier" AND file.path like "%\\AppData\\Local\\Temp\\WinGet\\%")
