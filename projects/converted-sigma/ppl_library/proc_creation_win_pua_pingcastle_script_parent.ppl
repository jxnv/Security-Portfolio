// Title: PUA - PingCastle Execution From Potentially Suspicious Parent
// ID: b37998de-a70b-4f33-b219-ec36bf433dc0
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2024-01-11
// Tags: attack.reconnaissance, attack.t1595
// Description: Detects the execution of PingCastle, a tool designed to quickly assess the Active Directory security level via a script located in a potentially suspicious or uncommon location.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.parent.command_line like "%.bat%" OR process.parent.command_line like "%.chm%" OR process.parent.command_line like "%.cmd%" OR process.parent.command_line like "%.hta%" OR process.parent.command_line like "%.htm%" OR process.parent.command_line like "%.html%" OR process.parent.command_line like "%.js%" OR process.parent.command_line like "%.lnk%" OR process.parent.command_line like "%.ps1%" OR process.parent.command_line like "%.vbe%" OR process.parent.command_line like "%.vbs%" OR process.parent.command_line like "%.wsf%")) OR ((process.parent.command_line like "%:\\Perflogs\\%" OR process.parent.command_line like "%:\\Temp\\%" OR process.parent.command_line like "%:\\Users\\Public\\%" OR process.parent.command_line like "%:\\Windows\\Temp\\%" OR process.parent.command_line like "%\\AppData\\Local\\Temp%" OR process.parent.command_line like "%\\AppData\\Roaming\\%" OR process.parent.command_line like "%\\Temporary Internet%")) OR (((process.parent.command_line like "%:\\Users\\%" AND process.parent.command_line like "%\\Favorites\\%")) OR ((process.parent.command_line like "%:\\Users\\%" AND process.parent.command_line like "%\\Favourites\\%")) OR ((process.parent.command_line like "%:\\Users\\%" AND process.parent.command_line like "%\\Contacts\\%")))) AND ((process.parent.command_line like "%.bat%" OR process.parent.command_line like "%.chm%" OR process.parent.command_line like "%.cmd%" OR process.parent.command_line like "%.hta%" OR process.parent.command_line like "%.htm%" OR process.parent.command_line like "%.html%" OR process.parent.command_line like "%.js%" OR process.parent.command_line like "%.lnk%" OR process.parent.command_line like "%.ps1%" OR process.parent.command_line like "%.vbe%" OR process.parent.command_line like "%.vbs%" OR process.parent.command_line like "%.wsf%")) AND ((process.executable="*\\PingCastle.exe") OR (process.pe.original_file_name = "PingCastle.exe") OR (Product = "Ping Castle") OR ((process.command_line like "%--scanner aclcheck%" OR process.command_line like "%--scanner antivirus%" OR process.command_line like "%--scanner computerversion%" OR process.command_line like "%--scanner foreignusers%" OR process.command_line like "%--scanner laps_bitlocker%" OR process.command_line like "%--scanner localadmin%" OR process.command_line like "%--scanner nullsession%" OR process.command_line like "%--scanner nullsession-trust%" OR process.command_line like "%--scanner oxidbindings%" OR process.command_line like "%--scanner remote%" OR process.command_line like "%--scanner share%" OR process.command_line like "%--scanner smb%" OR process.command_line like "%--scanner smb3querynetwork%" OR process.command_line like "%--scanner spooler%" OR process.command_line like "%--scanner startup%" OR process.command_line like "%--scanner zerologon%")) OR (process.command_line like "%--no-enum-limit%") OR ((process.command_line like "%--healthcheck%" AND process.command_line like "%--level Full%")) OR ((process.command_line like "%--healthcheck%" AND process.command_line like "%--server %"))))
