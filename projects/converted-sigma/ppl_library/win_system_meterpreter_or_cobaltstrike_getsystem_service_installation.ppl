// Title: Meterpreter or Cobalt Strike Getsystem Service Installation - System
// ID: 843544a7-56e0-4dcc-a44f-5cc266dd97d6
// Status: test
// Level: high
// Author: Teymur Kheirkhabarov, Ecco, Florian Roth (Nextron Systems)
// Date: 2019-10-26
// Tags: attack.privilege-escalation, attack.stealth, attack.t1134.001, attack.t1134.002
// Description: Detects the use of getsystem Meterpreter/Cobalt Strike command by detecting a specific service installation
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((winlog.provider_name = "Service Control Manager" AND winlog.event_id = "7045") AND (((ImagePath like "%/c%" AND ImagePath like "%echo%" AND ImagePath like "%\\pipe\\%") AND (ImagePath like "%cmd%" OR ImagePath like "%%COMSPEC%%")) OR ((ImagePath like "%rundll32%" AND ImagePath like "%.dll,a%" AND ImagePath like "%/p:%")) OR (ImagePath="\\\\\\\\127.0.0.1\\\\ADMIN$\\*")))
