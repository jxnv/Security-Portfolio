// Title: Curl File Upload To File Sharing Websites
// ID: e328cc73-f92a-42fb-b3fa-7c2cffda981a
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-03-29
// Tags: attack.exfiltration, attack.t1567.002
// Description: Detects usage of curl to upload files to known file sharing domains, which may indicate data exfiltration.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%0x0.st%" OR process.command_line like "%bashupload.com%" OR process.command_line like "%chunk.io%" OR process.command_line like "%file.io%" OR process.command_line like "%filebin.net%" OR process.command_line like "%pastebin%" OR process.command_line like "%send.firefox.com%" OR process.command_line like "%temp.sh%" OR process.command_line like "%transfer.sh%" OR process.command_line like "%ufile.io%" OR process.command_line like "%uploadfiles.io%" OR process.command_line like "%wetransfer.com%" OR process.command_line like "%x0.at%")) AND (((process.command_line like "% --form%" OR process.command_line like "% --upload-file%" OR process.command_line like "% --data%" OR process.command_line like "% -X POST%" OR process.command_line like "% --request POST %")) OR ((process.command_line=regex("\\s-[FTd]\\s") OR process.command_line=regex("\\s-sT\\s")))) AND ((process.executable="*\\curl.exe") OR (process.pe.original_file_name = "curl.exe")))
