// Title: Potential Browser Data Stealing
// ID: 47147b5b-9e17-4d76-b8d2-7bac24c5ce1b
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-23
// Tags: attack.credential-access, attack.t1555.003
// Description: Adversaries may acquire credentials from web browsers by reading files specific to the target browser.
// Web browsers commonly save credentials such as website usernames and passwords so that they do not need to be entered manually in the future.
// Web browsers typically store the credentials in an encrypted format within a credential store.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.command_line like "%copy-item%" OR process.command_line like "%copy %" OR process.command_line like "%cpi %" OR process.command_line like "% cp %" OR process.command_line like "%move %" OR process.command_line like "%move-item%" OR process.command_line like "% mi %" OR process.command_line like "% mv %")) OR ((process.executable="*\\esentutl.exe" OR process.executable="*\\xcopy.exe" OR process.executable="*\\robocopy.exe")) OR ((process.pe.original_file_name = "esentutl.exe" OR process.pe.original_file_name = "XCOPY.EXE" OR process.pe.original_file_name = "robocopy.exe"))) AND ((process.command_line like "%\\Amigo\\User Data%" OR process.command_line like "%\\BraveSoftware\\Brave-Browser\\User Data%" OR process.command_line like "%\\CentBrowser\\User Data%" OR process.command_line like "%\\Chromium\\User Data%" OR process.command_line like "%\\CocCoc\\Browser\\User Data%" OR process.command_line like "%\\Comodo\\Dragon\\User Data%" OR process.command_line like "%\\Elements Browser\\User Data%" OR process.command_line like "%\\Epic Privacy Browser\\User Data%" OR process.command_line like "%\\Google\\Chrome Beta\\User Data%" OR process.command_line like "%\\Google\\Chrome SxS\\User Data%" OR process.command_line like "%\\Google\\Chrome\\User Data\\%" OR process.command_line like "%\\Kometa\\User Data%" OR process.command_line like "%\\Maxthon5\\Users%" OR process.command_line like "%\\Microsoft\\Edge\\User Data%" OR process.command_line like "%\\Mozilla\\Firefox\\Profiles%" OR process.command_line like "%\\Nichrome\\User Data%" OR process.command_line like "%\\Opera Software\\Opera GX Stable\\%" OR process.command_line like "%\\Opera Software\\Opera Neon\\User Data%" OR process.command_line like "%\\Opera Software\\Opera Stable\\%" OR process.command_line like "%\\Orbitum\\User Data%" OR process.command_line like "%\\QIP Surf\\User Data%" OR process.command_line like "%\\Sputnik\\User Data%" OR process.command_line like "%\\Torch\\User Data%" OR process.command_line like "%\\uCozMedia\\Uran\\User Data%" OR process.command_line like "%\\Vivaldi\\User Data%")))
