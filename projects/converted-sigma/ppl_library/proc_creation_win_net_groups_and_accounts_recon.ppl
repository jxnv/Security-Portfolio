// Title: Suspicious Group And Account Reconnaissance Activity Using Net.EXE
// ID: d95de845-b83c-4a9a-8a6a-4fc802ebf6c0
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), omkar72, @svch0st, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-01-16
// Tags: attack.discovery, attack.t1087.001, attack.t1087.002
// Description: Detects suspicious reconnaissance command line activity on Windows systems using Net.EXE
// Check if the user that executed the commands is suspicious (e.g. service accounts, LOCAL_SYSTEM)
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.executable="*\\net.exe" OR process.executable="*\\net1.exe")) OR ((process.pe.original_file_name = "net.exe" OR process.pe.original_file_name = "net1.exe"))) AND (((((process.command_line like "%domain admins%" OR process.command_line like "% administrator%" OR process.command_line like "% administrateur%" OR process.command_line like "%enterprise admins%" OR process.command_line like "%Exchange Trusted Subsystem%" OR process.command_line like "%Remote Desktop Users%" OR process.command_line like "%Utilisateurs du Bureau à distance%" OR process.command_line like "%Usuarios de escritorio remoto%" OR process.command_line like "% /do%")) AND ((process.command_line like "% group %" OR process.command_line like "% localgroup %"))) AND NOT ((process.command_line like "% /add%"))) OR ((process.command_line like "% /do%") AND (process.command_line like "% accounts %"))))
