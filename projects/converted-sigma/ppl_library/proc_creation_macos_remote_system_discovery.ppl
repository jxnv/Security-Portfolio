// Title: Macos Remote System Discovery
// ID: 10227522-8429-47e6-a301-f2b2d014e7ad
// Status: test
// Level: informational
// Author: Alejandro Ortuno, oscd.community
// Date: 2020-10-22
// Tags: attack.discovery, attack.t1018
// Description: Detects the enumeration of other remote systems.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.executable="*/arp" AND process.command_line like "%-a%") OR (process.executable="*/ping" AND (process.command_line like "% 10.%" OR process.command_line like "% 192.168.%" OR process.command_line like "% 172.16.%" OR process.command_line like "% 172.17.%" OR process.command_line like "% 172.18.%" OR process.command_line like "% 172.19.%" OR process.command_line like "% 172.20.%" OR process.command_line like "% 172.21.%" OR process.command_line like "% 172.22.%" OR process.command_line like "% 172.23.%" OR process.command_line like "% 172.24.%" OR process.command_line like "% 172.25.%" OR process.command_line like "% 172.26.%" OR process.command_line like "% 172.27.%" OR process.command_line like "% 172.28.%" OR process.command_line like "% 172.29.%" OR process.command_line like "% 172.30.%" OR process.command_line like "% 172.31.%" OR process.command_line like "% 127.%" OR process.command_line like "% 169.254.%")))
