// Title: Potential Registry Persistence Attempt Via Windows Telemetry
// ID: 73a883d0-0348-4be4-a8d8-51031c2564f8
// Status: test
// Level: high
// Author: Lednyov Alexey, oscd.community, Sreeman
// Date: 2020-10-16
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053.005
// Description: Detects potential persistence behavior using the windows telemetry registry key.
// Windows telemetry makes use of the binary CompatTelRunner.exe to run a variety of commands and perform the actual telemetry collections.
// This binary was created to be easily extensible, and to that end, it relies on the registry to instruct on which commands to run.
// The problem is, it will run any arbitrary command without restriction of location or type.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((registry.path like "%\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\AppCompatFlags\\TelemetryController\\%" AND registry.path="*\\Command" AND (registry.data.strings like "%.bat%" OR registry.data.strings like "%.bin%" OR registry.data.strings like "%.cmd%" OR registry.data.strings like "%.dat%" OR registry.data.strings like "%.dll%" OR registry.data.strings like "%.exe%" OR registry.data.strings like "%.hta%" OR registry.data.strings like "%.jar%" OR registry.data.strings like "%.js%" OR registry.data.strings like "%.msi%" OR registry.data.strings like "%.ps%" OR registry.data.strings like "%.sh%" OR registry.data.strings like "%.vb%")) AND NOT (((registry.data.strings like "%\\system32\\CompatTelRunner.exe%" OR registry.data.strings like "%\\system32\\DeviceCensus.exe%"))))
