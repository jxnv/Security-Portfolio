// Title: WinDivert Driver Load
// ID: 679085d5-f427-4484-9f58-1dc30a7c426d
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-07-30
// Tags: attack.credential-access, attack.collection, attack.defense-impairment, attack.t1599.001, attack.t1557.001
// Description: Detects the load of the Windiver driver, a powerful user-mode capture/sniffing/modification/blocking/re-injection package for Windows
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((ImageLoaded like "%\\WinDivert.sys%" OR ImageLoaded like "%\\WinDivert64.sys%" OR ImageLoaded like "%\\NordDivert.sys%" OR ImageLoaded like "%\\lingtiwfp.sys%" OR ImageLoaded like "%\\eswfp.sys%")) OR ((Hashes like "%IMPHASH=0604bb7cb4bb851e2168d5c7d9399087%" OR Hashes like "%IMPHASH=2e5f0e649d97f32b03c09e4686d0574f%" OR Hashes like "%IMPHASH=52f8aa269f69f0edad9e8fcdaedce276%" OR Hashes like "%IMPHASH=c0e5d314da39dbf65a2dbff409cc2c76%" OR Hashes like "%IMPHASH=58623490691babe8330adc81cd04a663%" OR Hashes like "%IMPHASH=8ee39b48656e4d6b8459d7ba7da7438b%" OR Hashes like "%IMPHASH=45ee545ae77e8d43fc70ede9efcd4c96%" OR Hashes like "%IMPHASH=a1b2e245acd47e4a348e1a552a02859a%" OR Hashes like "%IMPHASH=2a5f85fe4609461c6339637594fa9b0a%" OR Hashes like "%IMPHASH=6b2c6f95233c2914d1d488ee27531acc%" OR Hashes like "%IMPHASH=9f2fdd3f9ab922bbb0560a7df46f4342%" OR Hashes like "%IMPHASH=d8a719865c448b1bd2ec241e46ac1c88%" OR Hashes like "%IMPHASH=0ea54f8c9af4a2fe8367fa457f48ed38%" OR Hashes like "%IMPHASH=9d519ae0a0864d6d6ae3f8b6c9c70af6%" OR Hashes like "%IMPHASH=a74929edfc3289895e3f2885278947ae%" OR Hashes like "%IMPHASH=a66b476c2d06c370f0a53b5537f2f11e%" OR Hashes like "%IMPHASH=bdcd836a46bc2415773f6b5ea77a46e4%" OR Hashes like "%IMPHASH=c28cd6ccd83179e79dac132a553693d9%")))
