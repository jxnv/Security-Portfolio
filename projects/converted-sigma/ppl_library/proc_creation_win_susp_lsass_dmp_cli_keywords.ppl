// Title: LSASS Dump Keyword In CommandLine
// ID: ffa6861c-4461-4f59-8a41-578c39f3f23e
// Status: test
// Level: high
// Author: E.M. Anhaus, Tony Lambert, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-10-24
// Tags: attack.credential-access, attack.t1003.001
// Description: Detects the presence of the keywords "lsass" and ".dmp" in the commandline, which could indicate a potential attempt to dump or create a dump of the lsass process.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%lsass.dmp%" OR process.command_line like "%lsass.zip%" OR process.command_line like "%lsass.rar%" OR process.command_line like "%Andrew.dmp%" OR process.command_line like "%Coredump.dmp%" OR process.command_line like "%NotLSASS.zip%" OR process.command_line like "%lsass_2%" OR process.command_line like "%lsassdump%" OR process.command_line like "%lsassdmp%")) OR ((process.command_line like "%lsass%" AND process.command_line like "%.dmp%")) OR ((process.command_line like "%SQLDmpr%" AND process.command_line like "%.mdmp%")) OR ((process.command_line like "%nanodump%" AND process.command_line like "%.dmp%")))
