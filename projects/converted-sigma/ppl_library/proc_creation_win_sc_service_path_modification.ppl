// Title: Suspicious Service Path Modification
// ID: 138d3531-8793-4f50-a2cd-f291b2863d78
// Status: test
// Level: high
// Author: Victor Sergeev, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-10-21
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects service path modification via the "sc" binary to a suspicious command or path
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (process.executable="*\\sc.exe" AND (process.command_line like "%config%" AND process.command_line like "%binPath%") AND (process.command_line like "%powershell%" OR process.command_line like "%cmd %" OR process.command_line like "%mshta%" OR process.command_line like "%wscript%" OR process.command_line like "%cscript%" OR process.command_line like "%rundll32%" OR process.command_line like "%svchost%" OR process.command_line like "%dllhost%" OR process.command_line like "%cmd.exe /c%" OR process.command_line like "%cmd.exe /k%" OR process.command_line like "%cmd.exe /r%" OR process.command_line like "%cmd /c%" OR process.command_line like "%cmd /k%" OR process.command_line like "%cmd /r%" OR process.command_line like "%C:\\Users\\Public%" OR process.command_line like "%\\Downloads\\%" OR process.command_line like "%\\Desktop\\%" OR process.command_line like "%\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\%" OR process.command_line like "%C:\\Windows\\TEMP\\%" OR process.command_line like "%\\AppData\\Local\\Temp%"))
