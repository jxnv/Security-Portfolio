// Title: File Download From IP URL Via Curl.EXE
// ID: 9cc85849-3b02-4cb5-b371-3a1ff54f2218
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-10-18
// Tags: attack.execution
// Description: Detects file downloads directly from IP address URL using curl.exe
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.command_line like "% -O%" OR process.command_line like "%--remote-name%" OR process.command_line like "%--output%")) AND (process.command_line like "%http%") AND ((process.executable="*\\curl.exe") OR (process.pe.original_file_name = "curl.exe")) AND (process.command_line=regex("://[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}"))) AND NOT (((process.command_line="*.bat" OR process.command_line="*.bat\"" OR process.command_line="*.dat" OR process.command_line="*.dat\"" OR process.command_line="*.dll" OR process.command_line="*.dll\"" OR process.command_line="*.exe" OR process.command_line="*.exe\"" OR process.command_line="*.gif" OR process.command_line="*.gif\"" OR process.command_line="*.hta" OR process.command_line="*.hta\"" OR process.command_line="*.jpeg" OR process.command_line="*.jpeg\"" OR process.command_line="*.log" OR process.command_line="*.log\"" OR process.command_line="*.msi" OR process.command_line="*.msi\"" OR process.command_line="*.png" OR process.command_line="*.png\"" OR process.command_line="*.ps1" OR process.command_line="*.ps1\"" OR process.command_line="*.psm1" OR process.command_line="*.psm1\"" OR process.command_line="*.vbe" OR process.command_line="*.vbe\"" OR process.command_line="*.vbs" OR process.command_line="*.vbs\"" OR process.command_line="*.bat'" OR process.command_line="*.dat'" OR process.command_line="*.dll'" OR process.command_line="*.exe'" OR process.command_line="*.gif'" OR process.command_line="*.hta'" OR process.command_line="*.jpeg'" OR process.command_line="*.log'" OR process.command_line="*.msi'" OR process.command_line="*.png'" OR process.command_line="*.ps1'" OR process.command_line="*.psm1'" OR process.command_line="*.vbe'" OR process.command_line="*.vbs'"))))
