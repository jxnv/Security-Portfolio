// Title: Creation Of a Suspicious ADS File Outside a Browser Download
// ID: 573df571-a223-43bc-846e-3f98da481eca
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-10-22
// Tags: attack.stealth
// Description: Detects the creation of a suspicious ADS (Alternate Data Stream) file by software other than browsers
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((Contents="[ZoneTransfer]  ZoneId=3*" AND file.path="*:Zone.Identifier" AND (file.path like "%.exe%" OR file.path like "%.scr%" OR file.path like "%.bat%" OR file.path like "%.cmd%" OR file.path like "%.docx%" OR file.path like "%.hta%" OR file.path like "%.jse%" OR file.path like "%.lnk%" OR file.path like "%.pptx%" OR file.path like "%.ps%" OR file.path like "%.reg%" OR file.path like "%.sct%" OR file.path like "%.vb%" OR file.path like "%.wsc%" OR file.path like "%.wsf%" OR file.path like "%.xlsx%")) AND NOT (((process.executable="*\\brave.exe") OR ((process.executable = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR process.executable = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((process.executable="C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*") OR (process.executable="*\\WindowsApps\\MicrosoftEdge.exe") OR ((process.executable = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR process.executable = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process.executable="C:\\Program Files (x86)\\Microsoft\\EdgeCore\\*" OR process.executable="C:\\Program Files\\Microsoft\\EdgeCore\\*") AND (process.executable="*\\msedge.exe" OR process.executable="*\\msedgewebview2.exe")) OR ((process.executable = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR process.executable = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR ((process.executable = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR process.executable = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process.executable="*\\maxthon.exe") OR (process.executable="*\\opera.exe") OR (process.executable="*\\safari.exe") OR (process.executable="*\\seamonkey.exe") OR (process.executable="C:\\Program Files\\WindowsApps\\Microsoft.ScreenSketch_*" AND process.executable="*\\SnippingTool\\SnippingTool.exe" AND file.path="C:\\Users\\*" AND (file.path like "%\\AppData\\Local\\Packages\\Microsoft.ScreenSketch_%" AND file.path like "%\\TempState\\Screenshot %") AND file.path="*.png:Zone.Identifier") OR (process.executable="*\\vivaldi.exe") OR (process.executable="*\\whale.exe"))))
