// Title: Suspicious Process By Web Server Process
// ID: 8202070f-edeb-4d31-a010-a26c72ac5600
// Status: test
// Level: high
// Author: Thomas Patzke, Florian Roth (Nextron Systems), Zach Stanford @svch0st, Tim Shelton, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-01-16
// Tags: attack.persistence, attack.initial-access, attack.t1505.003, attack.t1190
// Description: Detects potentially suspicious processes being spawned by a web server process which could be the result of a successfully placed web shell or exploitation
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.parent.executable="*\\java.exe" OR process.parent.executable="*\\javaw.exe") AND (process.parent.executable like "%-tomcat-%" OR process.parent.executable like "%\\tomcat%")) OR ((process.parent.executable="*\\java.exe" OR process.parent.executable="*\\javaw.exe") AND (process.parent.command_line like "%CATALINA_HOME%" OR process.parent.command_line like "%catalina.home%" OR process.parent.command_line like "%catalina.jar%")) OR ((process.parent.executable="*\\caddy.exe" OR process.parent.executable="*\\httpd.exe" OR process.parent.executable="*\\nginx.exe" OR process.parent.executable="*\\php-cgi.exe" OR process.parent.executable="*\\php.exe" OR process.parent.executable="*\\tomcat.exe" OR process.parent.executable="*\\UMWorkerProcess.exe" OR process.parent.executable="*\\w3wp.exe" OR process.parent.executable="*\\ws_TomcatService.exe"))) AND ((process.executable="*\\arp.exe" OR process.executable="*\\at.exe" OR process.executable="*\\bash.exe" OR process.executable="*\\bitsadmin.exe" OR process.executable="*\\certutil.exe" OR process.executable="*\\cmd.exe" OR process.executable="*\\cscript.exe" OR process.executable="*\\dsget.exe" OR process.executable="*\\hostname.exe" OR process.executable="*\\nbtstat.exe" OR process.executable="*\\net.exe" OR process.executable="*\\net1.exe" OR process.executable="*\\netdom.exe" OR process.executable="*\\netsh.exe" OR process.executable="*\\nltest.exe" OR process.executable="*\\ntdsutil.exe" OR process.executable="*\\powershell_ise.exe" OR process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe" OR process.executable="*\\qprocess.exe" OR process.executable="*\\query.exe" OR process.executable="*\\qwinsta.exe" OR process.executable="*\\reg.exe" OR process.executable="*\\rundll32.exe" OR process.executable="*\\sc.exe" OR process.executable="*\\sh.exe" OR process.executable="*\\wmic.exe" OR process.executable="*\\wscript.exe" OR process.executable="*\\wusa.exe")) AND NOT (((process.parent.executable="*\\java.exe" AND process.command_line="*Windows\\system32\\cmd.exe /c C:\\ManageEngine\\ADManager \"Plus\\ES\\bin\\elasticsearch.bat -Enode.name=RMP-NODE1 -pelasticsearch-pid.txt") OR (process.parent.executable="*\\java.exe" AND (process.command_line like "%sc query%" AND process.command_line like "%ADManager Plus%")))))
