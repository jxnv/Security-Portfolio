// Title: Removal of Potential COM Hijacking Registry Keys
// ID: 96f697b0-b499-4e5d-9908-a67bec11cdb6
// Status: test
// Level: medium
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2020-05-02
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects any deletion of entries in ".*\shell\open\command" registry keys.
// These registry keys might have been used for COM hijacking activities by a threat actor or an attacker and the deletion could indicate steps to remove its tracks.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((registry.path="*\\shell\\open\\command") AND NOT (((process.executable="*C:\\Windows\\explorer.exe") OR ((process.executable="C:\\Program Files\\*" OR process.executable="C:\\Program Files (x86)\\*")) OR ((process.executable = "C:\\Windows\\System32\\msiexec.exe" OR process.executable = "C:\\Windows\\SysWOW64\\msiexec.exe")) OR (process.executable = "C:\\Windows\\System32\\OpenWith.exe") OR (process.executable = "C:\\Windows\\system32\\svchost.exe"))) AND NOT ((((process.executable = "C:\\Program Files (x86)\\Avira\\Antivirus\\" OR process.executable = "C:\\Program Files\\Avira\\Antivirus\\") AND (registry.path="*\\CLSID\\{305CA226-D286-468e-B848-2B2E8E697B74}\\Shell\\Open\\Command" OR registry.path="*\\AntiVir.Keyfile\\shell\\open\\command")) OR (process.executable="*\\reg.exe" AND registry.path="*\\Discord\\shell\\open\\command") OR (process.executable="*\\Dropbox.exe" AND registry.path like "%\\Dropbox.%") OR (process.executable="*C:\\eclipse\\eclipse.exe" AND registry.path like "%_Classes\\eclipse+%") OR (process.executable like "%\\Microsoft\\EdgeUpdate\\Install%") OR (process.executable="*\\Everything.exe" AND registry.path like "%\\Everything.%") OR (((process.executable like "%AppData\\Local\\Temp%" AND process.executable like "%\\setup.exe%")) OR ((process.executable like "%\\Temp\\is-%" AND process.executable like "%\\target.tmp%"))) OR (process.executable="C:\\Program Files (x86)\\Java\\*" AND process.executable="*\\installer.exe" AND registry.path like "%\\Classes\\WOW6432Node\\CLSID\\{4299124F-F2C3-41b4-9C73-9236B2AD0E8F}%") OR (process.executable="*\\ninite.exe") OR (process.executable like "%peazip%" AND registry.path like "%\\PeaZip.%") OR (process.executable="*\\Spotify.exe" AND registry.path="*\\Spotify\\shell\\open\\command") OR ((process.executable like "%\\Temp%" AND process.executable like "%\\TeamViewer%")) OR (process.executable="C:\\Windows\\Installer\\MSI*") OR (process.executable="*\\AppData\\Local\\Temp\\Wireshark_uninstaller.exe" AND registry.path like "%\\wireshark-capture-file\\%"))))
