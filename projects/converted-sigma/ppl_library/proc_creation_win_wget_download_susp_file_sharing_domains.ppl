// Title: Suspicious File Download From File Sharing Domain Via Wget.EXE
// ID: a0d7e4d2-bede-4141-8896-bc6e237e977c
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-05
// Tags: attack.execution
// Description: Detects potentially suspicious file downloads from file sharing domains using wget.exe
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line="*.ps1" OR process.command_line="*.ps1'" OR process.command_line="*.ps1\"" OR process.command_line="*.dat" OR process.command_line="*.dat'" OR process.command_line="*.dat\"" OR process.command_line="*.msi" OR process.command_line="*.msi'" OR process.command_line="*.msi\"" OR process.command_line="*.bat" OR process.command_line="*.bat'" OR process.command_line="*.bat\"" OR process.command_line="*.exe" OR process.command_line="*.exe'" OR process.command_line="*.exe\"" OR process.command_line="*.vbs" OR process.command_line="*.vbs'" OR process.command_line="*.vbs\"" OR process.command_line="*.vbe" OR process.command_line="*.vbe'" OR process.command_line="*.vbe\"" OR process.command_line="*.hta" OR process.command_line="*.hta'" OR process.command_line="*.hta\"" OR process.command_line="*.dll" OR process.command_line="*.dll'" OR process.command_line="*.dll\"" OR process.command_line="*.psm1" OR process.command_line="*.psm1'" OR process.command_line="*.psm1\"")) AND ((process.command_line=regex("\\s-O\\s")) OR (process.command_line like "%--output-document%")) AND (process.command_line like "%http%") AND ((process.executable="*\\wget.exe") OR (process.pe.original_file_name = "wget.exe")) AND ((process.command_line like "%.githubusercontent.com%" OR process.command_line like "%0x0.st%" OR process.command_line like "%anonfiles.com%" OR process.command_line like "%bashupload.com%" OR process.command_line like "%cdn.discordapp.com%" OR process.command_line like "%chunk.io%" OR process.command_line like "%ddns.net%" OR process.command_line like "%dl.dropboxusercontent.com%" OR process.command_line like "%ghostbin.co%" OR process.command_line like "%github.com%" OR process.command_line like "%glitch.me%" OR process.command_line like "%gofile.io%" OR process.command_line like "%hastebin.com%" OR process.command_line like "%mediafire.com%" OR process.command_line like "%mega.nz%" OR process.command_line like "%onrender.com%" OR process.command_line like "%pages.dev%" OR process.command_line like "%paste.ee%" OR process.command_line like "%pastebin.com%" OR process.command_line like "%pastebin.pl%" OR process.command_line like "%pastetext.net%" OR process.command_line like "%pixeldrain.com%" OR process.command_line like "%privatlab.com%" OR process.command_line like "%privatlab.net%" OR process.command_line like "%send.exploit.in%" OR process.command_line like "%sendspace.com%" OR process.command_line like "%storage.googleapis.com%" OR process.command_line like "%storjshare.io%" OR process.command_line like "%supabase.co%" OR process.command_line like "%temp.sh%" OR process.command_line like "%transfer.sh%" OR process.command_line like "%trycloudflare.com%" OR process.command_line like "%ufile.io%" OR process.command_line like "%w3spaces.com%" OR process.command_line like "%workers.dev%" OR process.command_line like "%x0.at%")))
