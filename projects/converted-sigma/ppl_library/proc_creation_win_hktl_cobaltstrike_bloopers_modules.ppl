// Title: Operator Bloopers Cobalt Strike Modules
// ID: 4f154fb6-27d1-4813-a759-78b93e0b9c48
// Status: test
// Level: high
// Author: _pete_0, TheDFIRReport
// Date: 2022-05-06
// Tags: attack.execution, attack.t1059.003
// Description: Detects Cobalt Strike module/commands accidentally entered in CMD shell
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%Invoke-UserHunter%" OR process.command_line like "%Invoke-ShareFinder%" OR process.command_line like "%Invoke-Kerberoast%" OR process.command_line like "%Invoke-SMBAutoBrute%" OR process.command_line like "%Invoke-Nightmare%" OR process.command_line like "%zerologon%" OR process.command_line like "%av_query%")) AND ((process.pe.original_file_name = "Cmd.Exe") OR (process.executable="*\\cmd.exe")))
