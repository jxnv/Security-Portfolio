// Title: HackTool - KrbRelay Execution
// ID: e96253b8-6b3b-4f90-9e59-3b24b99cf9b4
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-04-27
// Tags: attack.credential-access, attack.t1558.003
// Description: Detects the use of KrbRelay, a Kerberos relaying tool
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "% -spn %" AND process.command_line like "% -clsid %" AND process.command_line like "% -rbcd %")) OR ((process.command_line like "%shadowcred%" AND process.command_line like "%clsid%" AND process.command_line like "%spn%")) OR ((process.command_line like "%spn %" AND process.command_line like "%session %" AND process.command_line like "%clsid %")) OR ((process.executable="*\\KrbRelay.exe") OR (process.pe.original_file_name = "KrbRelay.exe")))
