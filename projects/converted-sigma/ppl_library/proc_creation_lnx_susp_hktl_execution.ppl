// Title: Linux HackTool Execution
// ID: a015e032-146d-4717-8944-7a1884122111
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Georg Lauenstein (sure[secure])
// Date: 2023-01-03
// Tags: attack.execution, attack.resource-development, attack.t1587
// Description: Detects known hacktool execution based on image name.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.executable like "%/cobaltstrike%" OR process.executable like "%/teamserver%")) OR ((process.executable="*/crackmapexec" OR process.executable="*/havoc" OR process.executable="*/merlin-agent" OR process.executable="*/merlinServer-Linux-x64" OR process.executable="*/msfconsole" OR process.executable="*/msfvenom" OR process.executable="*/ps-empire server" OR process.executable="*/ps-empire" OR process.executable="*/sliver-client" OR process.executable="*/sliver-server" OR process.executable="*/Villain.py")) OR ((process.executable="*/aircrack-ng" OR process.executable="*/bloodhound-python" OR process.executable="*/bpfdos" OR process.executable="*/ebpfki" OR process.executable="*/evil-winrm" OR process.executable="*/hashcat" OR process.executable="*/hoaxshell.py" OR process.executable="*/hydra" OR process.executable="*/john" OR process.executable="*/ncrack" OR process.executable="*/nxc-ubuntu-latest" OR process.executable="*/pidhide" OR process.executable="*/pspy32" OR process.executable="*/pspy32s" OR process.executable="*/pspy64" OR process.executable="*/pspy64s" OR process.executable="*/setoolkit" OR process.executable="*/sqlmap" OR process.executable="*/writeblocker")) OR (process.executable like "%/linpeas%") OR ((process.executable="*/autorecon" OR process.executable="*/httpx" OR process.executable="*/legion" OR process.executable="*/naabu" OR process.executable="*/netdiscover" OR process.executable="*/nuclei" OR process.executable="*/recon-ng")) OR (process.executable like "%/sniper%") OR ((process.executable="*/dirb" OR process.executable="*/dirbuster" OR process.executable="*/eyewitness" OR process.executable="*/feroxbuster" OR process.executable="*/ffuf" OR process.executable="*/gobuster" OR process.executable="*/wfuzz" OR process.executable="*/whatweb")) OR ((process.executable="*/joomscan" OR process.executable="*/nikto" OR process.executable="*/wpscan")))
