// Title: Webshell Hacking Activity Patterns
// ID: 4ebc877f-4612-45cb-b3a5-8e3834db36c9
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-17
// Tags: attack.persistence, attack.discovery, attack.t1505.003, attack.t1018, attack.t1033, attack.t1087
// Description: Detects certain parent child patterns found in cases in which a web shell is used to perform certain credential dumping or exfiltration activities on a compromised system
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.parent.executable="*\\java.exe" OR process.parent.executable="*\\javaw.exe") AND (process.parent.executable like "%-tomcat-%" OR process.parent.executable like "%\\tomcat%")) OR ((process.parent.executable="*\\java.exe" OR process.parent.executable="*\\javaw.exe") AND (process.command_line like "%catalina.jar%" OR process.command_line like "%CATALINA_HOME%")) OR ((process.parent.executable="*\\caddy.exe" OR process.parent.executable="*\\httpd.exe" OR process.parent.executable="*\\nginx.exe" OR process.parent.executable="*\\php-cgi.exe" OR process.parent.executable="*\\w3wp.exe" OR process.parent.executable="*\\ws_tomcatservice.exe"))) AND (((process.command_line like "%rundll32%" AND process.command_line like "%comsvcs%")) OR ((process.command_line like "% -hp%" AND process.command_line like "% a %" AND process.command_line like "% -m%")) OR ((process.command_line like "%net%" AND process.command_line like "% user %" AND process.command_line like "% /add%")) OR ((process.command_line like "%net%" AND process.command_line like "% localgroup %" AND process.command_line like "% administrators %" AND process.command_line like "%/add%")) OR ((process.executable="*\\ntdsutil.exe" OR process.executable="*\\ldifde.exe" OR process.executable="*\\adfind.exe" OR process.executable="*\\procdump.exe" OR process.executable="*\\Nanodump.exe" OR process.executable="*\\vssadmin.exe" OR process.executable="*\\fsutil.exe")) OR ((process.command_line like "% -decode %" OR process.command_line like "% -NoP %" OR process.command_line like "% -W Hidden %" OR process.command_line like "% /decode %" OR process.command_line like "% /ticket:%" OR process.command_line like "% sekurlsa%" OR process.command_line like "%.dmp full%" OR process.command_line like "%.downloadfile(%" OR process.command_line like "%.downloadstring(%" OR process.command_line like "%FromBase64String%" OR process.command_line like "%process call create%" OR process.command_line like "%reg save %" OR process.command_line like "%whoami /priv%"))))
