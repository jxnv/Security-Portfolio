// Title: System Network Discovery - Linux
// ID: e7bd1cfa-b446-4c88-8afb-403bcd79e3fa
// Status: test
// Level: informational
// Author: Ömer Günal and remotephone, oscd.community
// Date: 2020-10-06
// Tags: attack.discovery, attack.t1016
// Description: Detects enumeration of local network configuration
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.command_line like "%/etc/resolv.conf%") OR ((process.executable="*/firewall-cmd" OR process.executable="*/ufw" OR process.executable="*/iptables" OR process.executable="*/netstat" OR process.executable="*/ss" OR process.executable="*/ip" OR process.executable="*/ifconfig" OR process.executable="*/systemd-resolve" OR process.executable="*/route")))
