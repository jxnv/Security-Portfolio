// Title: Suspicious File Download From IP Via Curl.EXE
// ID: 5cb299fc-5fb1-4d07-b989-0644c68b6043
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-07-27
// Tags: attack.execution
// Description: Detects potentially suspicious file downloads directly from IP addresses using curl.exe
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line="*.bat" OR process.command_line="*.bat\"" OR process.command_line="*.dat" OR process.command_line="*.dat\"" OR process.command_line="*.dll" OR process.command_line="*.dll\"" OR process.command_line="*.exe" OR process.command_line="*.exe\"" OR process.command_line="*.gif" OR process.command_line="*.gif\"" OR process.command_line="*.hta" OR process.command_line="*.hta\"" OR process.command_line="*.jpeg" OR process.command_line="*.jpeg\"" OR process.command_line="*.log" OR process.command_line="*.log\"" OR process.command_line="*.msi" OR process.command_line="*.msi\"" OR process.command_line="*.png" OR process.command_line="*.png\"" OR process.command_line="*.ps1" OR process.command_line="*.ps1\"" OR process.command_line="*.psm1" OR process.command_line="*.psm1\"" OR process.command_line="*.vbe" OR process.command_line="*.vbe\"" OR process.command_line="*.vbs" OR process.command_line="*.vbs\"" OR process.command_line="*.bat'" OR process.command_line="*.dat'" OR process.command_line="*.dll'" OR process.command_line="*.exe'" OR process.command_line="*.gif'" OR process.command_line="*.hta'" OR process.command_line="*.jpeg'" OR process.command_line="*.log'" OR process.command_line="*.msi'" OR process.command_line="*.png'" OR process.command_line="*.ps1'" OR process.command_line="*.psm1'" OR process.command_line="*.vbe'" OR process.command_line="*.vbs'")) AND ((process.command_line like "% -O%" OR process.command_line like "%--remote-name%" OR process.command_line like "%--output%")) AND (process.command_line like "%http%") AND ((process.executable="*\\curl.exe") OR (process.pe.original_file_name = "curl.exe")) AND (process.command_line=regex("://[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}")))
