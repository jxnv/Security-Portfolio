// Title: Process Proxy Execution Via Squirrel.EXE
// ID: 45239e6a-b035-4aaf-b339-8ad379fcb67e
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Karneades / Markus Neis, Jonhnathan Ribeiro, oscd.community
// Date: 2022-06-09
// Tags: attack.execution, attack.stealth, attack.t1218
// Description: Detects the usage of the "Squirrel.exe" binary to execute arbitrary processes. This binary is part of multiple Electron based software installations (Slack, Teams, Discord, etc.)
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.command_line like "%--processStart%" OR process.command_line like "%--processStartAndWait%" OR process.command_line like "%--createShortcut%")) AND ((process.executable="*\\squirrel.exe" OR process.executable="*\\update.exe"))) AND NOT ((((process.command_line like "%:\\Users\\%" AND process.command_line like "%\\AppData\\Local\\Discord\\Update.exe%" AND process.command_line like "%Discord.exe%") AND (process.command_line like "%--createShortcut%" OR process.command_line like "%--processStart%")) OR ((process.command_line like "%:\\Users\\%" AND process.command_line like "%\\AppData\\Local\\GitHubDesktop\\Update.exe%" AND process.command_line like "%GitHubDesktop.exe%") AND (process.command_line like "%--createShortcut%" OR process.command_line like "%--processStartAndWait%")) OR ((process.command_line like "%:\\Users\\%" AND process.command_line like "%\\AppData\\Local\\Microsoft\\Teams\\Update.exe%" AND process.command_line like "%Teams.exe%") AND (process.command_line like "%--processStart%" OR process.command_line like "%--createShortcut%")) OR ((process.command_line like "%:\\Users\\%" AND process.command_line like "%\\AppData\\Local\\yammerdesktop\\Update.exe%" AND process.command_line like "%Yammer.exe%") AND (process.command_line like "%--processStart%" OR process.command_line like "%--createShortcut%")))))
