// Title: DNS Server Discovery Via LDAP Query
// ID: a21bcd7e-38ec-49ad-b69a-9ea17e69509e
// Status: test
// Level: low
// Author: frack113
// Date: 2022-08-20
// Tags: attack.discovery, attack.t1482
// Description: Detects DNS server discovery via LDAP query requests from uncommon applications
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((QueryName="_ldap.*") AND NOT (((process.executable like "%:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\%" AND process.executable="*\\MsMpEng.exe") OR ((process.executable like "%:\\Program Files\\%" OR process.executable like "%:\\Program Files (x86)\\%" OR process.executable like "%:\\Windows\\%")) OR (NOT process.executable=*) OR (process.executable = "<unknown process>"))) AND NOT (((process.executable="C:\\WindowsAzure\\GuestAgent*") OR ((process.executable="*\\chrome.exe" OR process.executable="*\\firefox.exe" OR process.executable="*\\opera.exe")))))
