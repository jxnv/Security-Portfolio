// Title: Run PowerShell Script from ADS
// ID: 45a594aa-1fbd-4972-a809-ff5a99dd81b8
// Status: test
// Level: high
// Author: Sergey Soldatov, Kaspersky Lab, oscd.community
// Date: 2019-10-30
// Tags: attack.stealth, attack.t1564.004
// Description: Detects PowerShell script execution from Alternate Data Stream (ADS)
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.parent.executable="*\\powershell.exe" OR process.parent.executable="*\\pwsh.exe") AND (process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe") AND (process.command_line like "%Get-Content%" AND process.command_line like "%-Stream%"))
