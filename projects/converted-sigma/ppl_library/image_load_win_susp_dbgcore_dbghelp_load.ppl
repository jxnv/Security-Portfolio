// Title: Suspicious Loading of Dbgcore/Dbghelp DLLs from Uncommon Location
// ID: 416bc4a2-7217-4519-8dc7-c3271817f1d5
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-11-27
// Tags: attack.credential-access, attack.defense-impairment, attack.t1003, attack.t1685
// Description: Detects loading of dbgcore.dll or dbghelp.dll from uncommon locations such as user directories.
// These DLLs contain the MiniDumpWriteDump function, which can be abused for credential dumping purposes or in some cases for evading EDR/AV detection by suspending processes.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((ImageLoaded="*\\dbgcore.dll" OR ImageLoaded="*\\dbghelp.dll")) AND ((process.executable like "%:\\Perflogs\\%" OR process.executable like "%:\\Temp\\%" OR process.executable like "%:\\Users\\Public\\%" OR process.executable like "%\\$Recycle.Bin\\%" OR process.executable like "%\\Contacts\\%" OR process.executable like "%\\Documents\\%" OR process.executable like "%\\Favorites\\%" OR process.executable like "%\\Favourites\\%" OR process.executable like "%\\inetpub\\wwwroot\\%" OR process.executable like "%\\Music\\%" OR process.executable like "%\\Pictures\\%" OR process.executable like "%\\Start Menu\\Programs\\Startup\\%" OR process.executable like "%\\Users\\Default\\%" OR process.executable like "%\\Videos\\%")))
