// Title: AWL Bypass with Winrm.vbs and Malicious WsmPty.xsl/WsmTxt.xsl
// ID: 074e0ded-6ced-4ebd-8b4d-53f55908119d
// Status: test
// Level: medium
// Author: Julia Fomina, oscd.community
// Date: 2020-10-06
// Tags: attack.stealth, attack.t1216
// Description: Detects execution of attacker-controlled WsmPty.xsl or WsmTxt.xsl via winrm.vbs and copied cscript.exe (can be renamed)
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.command_line like "%winrm%") AND (((process.command_line like "%format:pretty%" OR process.command_line like "%format:\"pretty\"%" OR process.command_line like "%format:\"text\"%" OR process.command_line like "%format:text%")) AND NOT (((process.executable="C:\\Windows\\System32\\*" OR process.executable="C:\\Windows\\SysWOW64\\*")))))
