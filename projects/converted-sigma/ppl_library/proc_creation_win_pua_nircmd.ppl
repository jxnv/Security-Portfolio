// Title: PUA - NirCmd Execution
// ID: 4e2ed651-1906-4a59-a78a-18220fca1b22
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-24
// Tags: attack.execution, attack.t1569.002, attack.s0029
// Description: Detects the use of NirCmd tool for command execution, which could be the result of legitimate administrative activity
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.command_line like "% execmd %" OR process.command_line like "%.exe script %" OR process.command_line like "%.exe shexec %" OR process.command_line like "% runinteractive %")) OR ((process.executable="*\\NirCmd.exe") OR (process.pe.original_file_name = "NirCmd.exe"))) OR (((process.command_line like "% exec %" OR process.command_line like "% exec2 %")) AND ((process.command_line like "% show %" OR process.command_line like "% hide %"))))
