// Title: User Shell Folders Registry Modification via CommandLine
// ID: 8f3ab69a-aa22-4943-aa58-e0a52fdf6818
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-01-05
// Tags: attack.persistence, attack.privilege-escalation, attack.defense-impairment, attack.t1547.001, attack.t1112
// Description: Detects modifications to User Shell Folders registry values via reg.exe or PowerShell, which could indicate persistence attempts.
// Attackers may modify User Shell Folders registry values to point to malicious executables or scripts that will be executed during startup.
// This technique is often used to maintain persistence on a compromised system by ensuring that malicious payloads are executed automatically.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "% add %" OR process.command_line like "%New-ItemProperty%" OR process.command_line like "%Set-ItemProperty%" OR process.command_line like "%si %")) AND ((process.command_line like "%\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Shell Folders%" OR process.command_line like "%\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\User Shell Folders%")) AND (process.command_line like "%Startup%") AND (((process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe" OR process.executable="*\\reg.exe")) OR ((process.pe.original_file_name = "powershell.exe" OR process.pe.original_file_name = "pwsh.dll" OR process.pe.original_file_name = "reg.exe"))))
