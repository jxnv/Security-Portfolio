// Title: Webshell Detection With Command Line Keywords
// ID: bed2a484-9348-4143-8a8a-b801c979301c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Jonhnathan Ribeiro, Anton Kutepov, oscd.community, Chad Hudson, Matt Anderson
// Date: 2017-01-01
// Tags: attack.persistence, attack.discovery, attack.t1505.003, attack.t1018, attack.t1033, attack.t1087
// Description: Detects certain command line parameters often used during reconnaissance activity via web shells
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.parent.executable="*\\java.exe" OR process.parent.executable="*\\javaw.exe") AND (process.parent.executable like "%-tomcat-%" OR process.parent.executable like "%\\tomcat%")) OR ((process.parent.executable="*\\java.exe" OR process.parent.executable="*\\javaw.exe") AND (process.command_line like "%catalina.jar%" OR process.command_line like "%CATALINA_HOME%")) OR ((process.parent.executable="*\\w3wp.exe" OR process.parent.executable="*\\php-cgi.exe" OR process.parent.executable="*\\nginx.exe" OR process.parent.executable="*\\httpd.exe" OR process.parent.executable="*\\caddy.exe" OR process.parent.executable="*\\ws_tomcatservice.exe"))) AND (((process.command_line like "%&cd&echo%" OR process.command_line like "%cd /d %")) OR (((process.executable="*\\dsquery.exe" OR process.executable="*\\find.exe" OR process.executable="*\\findstr.exe" OR process.executable="*\\ipconfig.exe" OR process.executable="*\\netstat.exe" OR process.executable="*\\nslookup.exe" OR process.executable="*\\pathping.exe" OR process.executable="*\\quser.exe" OR process.executable="*\\schtasks.exe" OR process.executable="*\\systeminfo.exe" OR process.executable="*\\tasklist.exe" OR process.executable="*\\tracert.exe" OR process.executable="*\\wevtutil.exe" OR process.executable="*\\whoami.exe")) OR ((process.pe.original_file_name = "dsquery.exe" OR process.pe.original_file_name = "find.exe" OR process.pe.original_file_name = "findstr.exe" OR process.pe.original_file_name = "ipconfig.exe" OR process.pe.original_file_name = "netstat.exe" OR process.pe.original_file_name = "nslookup.exe" OR process.pe.original_file_name = "pathping.exe" OR process.pe.original_file_name = "quser.exe" OR process.pe.original_file_name = "schtasks.exe" OR process.pe.original_file_name = "sysinfo.exe" OR process.pe.original_file_name = "tasklist.exe" OR process.pe.original_file_name = "tracert.exe" OR process.pe.original_file_name = "VSSADMIN.EXE" OR process.pe.original_file_name = "wevtutil.exe" OR process.pe.original_file_name = "whoami.exe"))) OR ((process.command_line like "% Test-NetConnection %" OR process.command_line like "%dir \\%")) OR ((process.pe.original_file_name = "net.exe" OR process.pe.original_file_name = "net1.exe") AND (process.command_line like "% user %" OR process.command_line like "% use %" OR process.command_line like "% group %")) OR (process.pe.original_file_name = "ping.exe" AND process.command_line like "% -n %") OR ((process.executable="*\\cmd.exe" OR process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe") AND (process.command_line like "% -enc %" OR process.command_line like "% -EncodedCommand %" OR process.command_line like "% -w hidden %" OR process.command_line like "% -windowstyle hidden%" OR process.command_line like "%.WebClient).Download%")) OR (process.pe.original_file_name = "wmic.exe" AND process.command_line like "% /node:%")))
