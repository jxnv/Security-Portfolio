// Title: Suspicious Double Extension File Execution
// ID: 1cdd9a09-06c9-4769-99ff-626e2b3991b8
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems), @blu3_team (idea), Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-06-26
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects suspicious use of an .exe extension after a non-executable file extension like .pdf.exe, a set of spaces or underlines to cloak the executable file in spear phishing campaigns
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.executable="*      .exe" OR process.executable="*______.exe" OR process.executable="*.doc.exe" OR process.executable="*.doc.js" OR process.executable="*.docx.exe" OR process.executable="*.docx.js" OR process.executable="*.gif.exe" OR process.executable="*.jpeg.exe" OR process.executable="*.jpg.exe" OR process.executable="*.mkv.exe" OR process.executable="*.mov.exe" OR process.executable="*.mp3.exe" OR process.executable="*.mp4.exe" OR process.executable="*.pdf.exe" OR process.executable="*.pdf.js" OR process.executable="*.png.exe" OR process.executable="*.ppt.exe" OR process.executable="*.ppt.js" OR process.executable="*.pptx.exe" OR process.executable="*.pptx.js" OR process.executable="*.rtf.exe" OR process.executable="*.rtf.js" OR process.executable="*.svg.exe" OR process.executable="*.txt.exe" OR process.executable="*.txt.js" OR process.executable="*.xls.exe" OR process.executable="*.xls.js" OR process.executable="*.xlsx.exe" OR process.executable="*.xlsx.js" OR process.executable="*⠀⠀⠀⠀⠀⠀.exe") AND (process.command_line like "%      .exe%" OR process.command_line like "%______.exe%" OR process.command_line like "%.doc.exe%" OR process.command_line like "%.doc.js%" OR process.command_line like "%.docx.exe%" OR process.command_line like "%.docx.js%" OR process.command_line like "%.gif.exe%" OR process.command_line like "%.jpeg.exe%" OR process.command_line like "%.jpg.exe%" OR process.command_line like "%.mkv.exe%" OR process.command_line like "%.mov.exe%" OR process.command_line like "%.mp3.exe%" OR process.command_line like "%.mp4.exe%" OR process.command_line like "%.pdf.exe%" OR process.command_line like "%.pdf.js%" OR process.command_line like "%.png.exe%" OR process.command_line like "%.ppt.exe%" OR process.command_line like "%.ppt.js%" OR process.command_line like "%.pptx.exe%" OR process.command_line like "%.pptx.js%" OR process.command_line like "%.rtf.exe%" OR process.command_line like "%.rtf.js%" OR process.command_line like "%.svg.exe%" OR process.command_line like "%.txt.exe%" OR process.command_line like "%.txt.js%" OR process.command_line like "%.xls.exe%" OR process.command_line like "%.xls.js%" OR process.command_line like "%.xlsx.exe%" OR process.command_line like "%.xlsx.js%" OR process.command_line like "%⠀⠀⠀⠀⠀⠀.exe%"))
