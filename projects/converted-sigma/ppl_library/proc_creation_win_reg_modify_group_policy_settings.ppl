// Title: Modify Group Policy Settings
// ID: ada4b0c4-758b-46ac-9033-9004613a150d
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-08-19
// Tags: attack.privilege-escalation, attack.defense-impairment, attack.t1484.001
// Description: Detect malicious GPO modifications can be used to implement many other malicious behaviors.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%GroupPolicyRefreshTimeDC%" OR process.command_line like "%GroupPolicyRefreshTimeOffsetDC%" OR process.command_line like "%GroupPolicyRefreshTime%" OR process.command_line like "%GroupPolicyRefreshTimeOffset%" OR process.command_line like "%EnableSmartScreen%" OR process.command_line like "%ShellSmartScreenLevel%")) AND (process.command_line like "%\\SOFTWARE\\Policies\\Microsoft\\Windows\\System%") AND ((process.executable="*\\reg.exe") OR (process.pe.original_file_name = "reg.exe")))
