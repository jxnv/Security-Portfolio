// Title: Renamed AutoIt Execution
// ID: f4264e47-f522-4c38-a420-04525d5b880f
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2023-06-04
// Tags: attack.stealth, attack.t1027
// Description: Detects the execution of a renamed AutoIt2.exe or AutoIt3.exe.
// AutoIt is a scripting language and automation tool for Windows systems. While primarily used for legitimate automation tasks, it can be misused in cyber attacks.
// Attackers can leverage AutoIt to create and distribute malware, including keyloggers, spyware, and botnets. A renamed AutoIt executable is particularly suspicious.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.command_line like "% /AutoIt3ExecuteScript%" OR process.command_line like "% /ErrorStdOut%")) OR ((Hashes like "%IMPHASH=FDC554B3A8683918D731685855683DDF%" OR Hashes like "%IMPHASH=CD30A61B60B3D60CECDB034C8C83C290%" OR Hashes like "%IMPHASH=F8A00C72F2D667D2EDBB234D0C0AE000%")) OR ((process.pe.original_file_name = "AutoIt3.exe" OR process.pe.original_file_name = "AutoIt2.exe" OR process.pe.original_file_name = "AutoIt.exe"))) AND NOT (((process.executable="*\\AutoIt.exe" OR process.executable="*\\AutoIt2.exe" OR process.executable="*\\AutoIt3_x64.exe" OR process.executable="*\\AutoIt3.exe"))))
