// Title: Whoami.EXE Execution Anomaly
// ID: 8de1cbe8-d6f5-496d-8237-5f44a721c7a0
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2021-08-12
// Tags: attack.discovery, attack.t1033, car.2016-03-001
// Description: Detects the execution of whoami.exe with suspicious parent processes.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.executable="*\\whoami.exe") OR (process.pe.original_file_name = "whoami.exe")) AND NOT ((((process.parent.executable="*\\cmd.exe" OR process.parent.executable="*\\powershell_ise.exe" OR process.parent.executable="*\\powershell.exe" OR process.parent.executable="*\\pwsh.exe")) OR ((process.parent.executable = "" OR process.parent.executable = "-")) OR (NOT process.parent.executable=*))) AND NOT ((process.parent.executable="*:\\Program Files\\Microsoft Monitoring Agent\\Agent\\MonitoringHost.exe")))
