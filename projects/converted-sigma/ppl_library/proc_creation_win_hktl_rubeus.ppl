// Title: HackTool - Rubeus Execution
// ID: 7ec2c172-dceb-4c10-92c9-87c1881b7e18
// Status: stable
// Level: critical
// Author: Florian Roth (Nextron Systems)
// Date: 2018-12-19
// Tags: attack.credential-access, attack.t1003, attack.t1558.003, attack.lateral-movement, attack.t1550.003
// Description: Detects the execution of the hacktool Rubeus via PE information of command line parameters
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.executable="*\\Rubeus.exe") OR (process.pe.original_file_name = "Rubeus.exe") OR (Description = "Rubeus") OR ((process.command_line like "%asreproast %" OR process.command_line like "%dump /service:krbtgt %" OR process.command_line like "%dump /luid:0x%" OR process.command_line like "%kerberoast %" OR process.command_line like "%createnetonly /program:%" OR process.command_line like "%ptt /ticket:%" OR process.command_line like "%/impersonateuser:%" OR process.command_line like "%renew /ticket:%" OR process.command_line like "%asktgt /user:%" OR process.command_line like "%harvest /interval:%" OR process.command_line like "%s4u /user:%" OR process.command_line like "%s4u /ticket:%" OR process.command_line like "%hash /password:%" OR process.command_line like "%golden /aes256:%" OR process.command_line like "%silver /user:%")))
