// Title: Suspicious New Service Creation
// ID: 17a1be64-8d88-40bf-b5ff-a4f7a50ebcc8
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-14
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects creation of a new service via "sc" command or the powershell "new-service" cmdlet with suspicious binary paths
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.command_line like "%New-Service%" AND process.command_line like "%-BinaryPathName%")) OR (process.executable="*\\sc.exe" AND (process.command_line like "%create%" AND process.command_line like "%binPath=%"))) AND ((process.command_line like "%powershell%" OR process.command_line like "%mshta%" OR process.command_line like "%wscript%" OR process.command_line like "%cscript%" OR process.command_line like "%svchost%" OR process.command_line like "%dllhost%" OR process.command_line like "%cmd %" OR process.command_line like "%cmd.exe /c%" OR process.command_line like "%cmd.exe /k%" OR process.command_line like "%cmd.exe /r%" OR process.command_line like "%rundll32%" OR process.command_line like "%C:\\Users\\Public%" OR process.command_line like "%\\Downloads\\%" OR process.command_line like "%\\Desktop\\%" OR process.command_line like "%\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\%" OR process.command_line like "%C:\\Windows\\TEMP\\%" OR process.command_line like "%\\AppData\\Local\\Temp%")))
