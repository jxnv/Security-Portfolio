// Title: Potentially Suspicious Rundll32 Activity
// ID: e593cf51-88db-4ee1-b920-37e89012a3c9
// Status: test
// Level: medium
// Author: juju4, Jonhnathan Ribeiro, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-01-16
// Tags: attack.stealth, attack.t1218.011
// Description: Detects suspicious execution of rundll32, with specific calls to some DLLs with known LOLBIN functionalities
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.command_line like "%javascript:%" AND process.command_line like "%.RegisterXLL%")) OR ((process.command_line like "%url.dll%" AND process.command_line like "%OpenURL%")) OR ((process.command_line like "%url.dll%" AND process.command_line like "%OpenURLA%")) OR ((process.command_line like "%url.dll%" AND process.command_line like "%FileProtocolHandler%")) OR ((process.command_line like "%zipfldr.dll%" AND process.command_line like "%RouteTheCall%")) OR ((process.command_line like "%shell32.dll%" AND process.command_line like "%Control_RunDLL%")) OR ((process.command_line like "%shell32.dll%" AND process.command_line like "%ShellExec_RunDLL%")) OR ((process.command_line like "%mshtml.dll%" AND process.command_line like "%PrintHTML%")) OR ((process.command_line like "%advpack.dll%" AND process.command_line like "%LaunchINFSection%")) OR ((process.command_line like "%advpack.dll%" AND process.command_line like "%RegisterOCX%")) OR ((process.command_line like "%ieadvpack.dll%" AND process.command_line like "%LaunchINFSection%")) OR ((process.command_line like "%ieadvpack.dll%" AND process.command_line like "%RegisterOCX%")) OR ((process.command_line like "%ieframe.dll%" AND process.command_line like "%OpenURL%")) OR ((process.command_line like "%shdocvw.dll%" AND process.command_line like "%OpenURL%")) OR ((process.command_line like "%syssetup.dll%" AND process.command_line like "%SetupInfObjectInstallAction%")) OR ((process.command_line like "%setupapi.dll%" AND process.command_line like "%InstallHinfSection%")) OR ((process.command_line like "%pcwutl.dll%" AND process.command_line like "%LaunchApplication%")) OR ((process.command_line like "%dfshim.dll%" AND process.command_line like "%ShOpenVerbApplication%")) OR ((process.command_line like "%dfshim.dll%" AND process.command_line like "%ShOpenVerbShortcut%")) OR ((process.command_line like "%scrobj.dll%" AND process.command_line like "%GenerateTypeLib%" AND process.command_line like "%http%")) OR ((process.command_line like "%shimgvw.dll%" AND process.command_line like "%ImageView_Fullscreen%" AND process.command_line like "%http%")) OR ((process.command_line like "%comsvcs.dll%" AND process.command_line like "%MiniDump%"))) AND NOT (((process.parent.executable = "C:\\Windows\\System32\\control.exe" AND process.parent.command_line like "%.cpl%" AND (process.command_line like "%Shell32.dll%" AND process.command_line like "%Control_RunDLL%" AND process.command_line like "%.cpl%")) OR (process.command_line like "%shell32.dll,Control_RunDLL desk.cpl,screensaver,@screensaver%") OR (process.parent.executable = "C:\\Windows\\System32\\control.exe" AND process.command_line="\"C:\\Windows\\system32\\rundll32.exe\" Shell32.dll,Control_RunDLL \"C:\\Windows\\System32\\*" AND process.command_line="*.cpl\","))))
