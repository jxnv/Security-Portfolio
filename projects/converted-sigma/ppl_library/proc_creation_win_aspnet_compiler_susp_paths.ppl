// Title: Potentially Suspicious ASP.NET Compilation Via AspNetCompiler
// ID: 9f50fe98-fe5c-4a2d-86c7-fad7f63ed622
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-08-14
// Tags: attack.execution, attack.stealth, attack.t1127
// Description: Detects execution of "aspnet_compiler.exe" with potentially suspicious paths for compilation.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.executable like "%:\\Windows\\Microsoft.NET\\Framework\\%" OR process.executable like "%:\\Windows\\Microsoft.NET\\Framework64\\%" OR process.executable like "%:\\Windows\\Microsoft.NET\\FrameworkArm\\%" OR process.executable like "%:\\Windows\\Microsoft.NET\\FrameworkArm64\\%") AND process.executable="*\\aspnet_compiler.exe" AND (process.command_line like "%\\Users\\Public\\%" OR process.command_line like "%\\AppData\\Local\\Temp\\%" OR process.command_line like "%\\AppData\\Local\\Roaming\\%" OR process.command_line like "%:\\Temp\\%" OR process.command_line like "%:\\Windows\\Temp\\%" OR process.command_line like "%:\\Windows\\System32\\Tasks\\%" OR process.command_line like "%:\\Windows\\Tasks\\%"))
