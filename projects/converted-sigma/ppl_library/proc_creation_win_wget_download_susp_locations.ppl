// Title: Suspicious File Download From IP Via Wget.EXE - Paths
// ID: 40aa399c-7b02-4715-8e5f-73572b493f33
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-02-23
// Tags: attack.execution
// Description: Detects potentially suspicious file downloads directly from IP addresses and stored in suspicious locations using Wget.exe
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line=regex("\\s-O\\s")) OR (process.command_line like "%--output-document%")) AND (process.command_line like "%http%") AND ((process.executable="*\\wget.exe") OR (process.pe.original_file_name = "wget.exe")) AND (process.command_line=regex("://[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}")) AND (((process.command_line like "%:\\PerfLogs\\%" OR process.command_line like "%:\\Temp\\%" OR process.command_line like "%:\\Users\\Public\\%" OR process.command_line like "%:\\Windows\\Help\\%" OR process.command_line like "%:\\Windows\\Temp\\%" OR process.command_line like "%\\Temporary Internet%")) OR ((process.command_line like "%:\\Users\\%" AND process.command_line like "%\\Favorites\\%")) OR ((process.command_line like "%:\\Users\\%" AND process.command_line like "%\\Favourites\\%")) OR ((process.command_line like "%:\\Users\\%" AND process.command_line like "%\\Contacts\\%")) OR ((process.command_line like "%:\\Users\\%" AND process.command_line like "%\\Pictures\\%"))))
