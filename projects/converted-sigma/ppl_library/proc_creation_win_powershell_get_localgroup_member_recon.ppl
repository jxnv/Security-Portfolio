// Title: Suspicious Reconnaissance Activity Using Get-LocalGroupMember Cmdlet
// ID: c8a180d6-47a3-4345-a609-53f9c3d834fc
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-10
// Tags: attack.discovery, attack.t1087.001
// Description: Detects suspicious reconnaissance command line activity on Windows systems using the PowerShell Get-LocalGroupMember Cmdlet
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.command_line like "%Get-LocalGroupMember %") AND ((process.command_line like "%domain admins%" OR process.command_line like "% administrator%" OR process.command_line like "% administrateur%" OR process.command_line like "%enterprise admins%" OR process.command_line like "%Exchange Trusted Subsystem%" OR process.command_line like "%Remote Desktop Users%" OR process.command_line like "%Utilisateurs du Bureau à distance%" OR process.command_line like "%Usuarios de escritorio remoto%")))
