// Title: Wow6432Node CurrentVersion Autorun Keys Modification
// ID: b29aed60-ebd1-442b-9cb5-16a1d0324adb
// Status: test
// Level: medium
// Author: Victor Sergeev, Daniil Yugoslavskiy, Gleb Sukhodolskiy, Timur Zinniatullin, oscd.community, Tim Shelton, frack113 (split)
// Date: 2019-10-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects modification of autostart extensibility point (ASEP) in registry.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((registry.path like "%\\SOFTWARE\\Wow6432Node\\Microsoft\\Windows\\CurrentVersion%") AND ((registry.path like "%\\ShellServiceObjectDelayLoad%" OR registry.path like "%\\Run\\%" OR registry.path like "%\\RunOnce\\%" OR registry.path like "%\\RunOnceEx\\%" OR registry.path like "%\\RunServices\\%" OR registry.path like "%\\RunServicesOnce\\%" OR registry.path like "%\\Explorer\\ShellServiceObjects%" OR registry.path like "%\\Explorer\\ShellIconOverlayIdentifiers%" OR registry.path like "%\\Explorer\\ShellExecuteHooks%" OR registry.path like "%\\Explorer\\SharedTaskScheduler%" OR registry.path like "%\\Explorer\\Browser Helper Objects%"))) AND NOT ((((process.executable like "%C:\\Program Files (x86)\\Microsoft\\EdgeUpdate\\Install\\{%" AND process.executable like "%\\setup.exe%")) OR (registry.data.strings = "(Empty)") OR (registry.data.strings="\"C:\\ProgramData\\Package Cache\\{d21a4f20-968a-4b0c-bf04-a38da5f06e41}\\windowsdesktop-runtime-*") OR (process.executable = "C:\\WINDOWS\\system32\\msiexec.exe" AND registry.path like "%\\SOFTWARE\\Wow6432Node\\Microsoft\\Windows\\CurrentVersion\\Run\\%") OR (NOT registry.data.strings=*) OR (process.executable="C:\\Windows\\Installer\\MSI*" AND registry.path like "%\\Explorer\\Browser Helper Objects%") OR ((process.executable="C:\\ProgramData\\Package Cache*" OR process.executable="C:\\Windows\\Temp\\*") AND (process.executable like "%\\winsdksetup.exe%" OR process.executable like "%\\windowsdesktop-runtime-%" OR process.executable like "%\\AspNetCoreSharedFrameworkBundle-%") AND registry.data.strings="* /burn.runonce") OR (process.executable="*\\VC_redist.x64.exe" AND registry.data.strings="*}\\VC_redist.x64.exe\" /burn.runonce"))) AND NOT (((process.executable="*\\instup.exe" AND registry.path="*\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\AvRepair" AND registry.data.strings="*instup.exe\" /instop:repair /wait") OR (process.executable="*\\instup.exe" AND (registry.path="*\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Explorer\\ShellIconOverlayIdentifiers\\00avg\\(Default)" OR registry.path="*\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Explorer\\ShellIconOverlayIdentifiers\\00asw\\(Default)") AND (registry.data.strings = "{472083B1-C522-11CF-8763-00608CC02F24}" OR registry.data.strings = "{472083B0-C522-11CF-8763-00608CC02F24}")) OR (registry.data.strings="*\\Avira.OE.Setup.Bundle.exe\" /burn.runonce" AND process.executable="*\\Avira.OE.Setup.Bundle.exe") OR (registry.path="*\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run\\Discord" AND registry.data.strings="*Discord.exe --checkInstall") OR (process.executable like "%\\windowsdesktop-runtime-%" AND (registry.path="*\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\{e2d1ae32-dd1d-4ad7-a298-10e42e7840fc}" OR registry.path="*\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\{7037b699-7382-448c-89a7-4765961d2537}") AND registry.data.strings="\"C:\\ProgramData\\Package Cache\\*" AND registry.data.strings="*.exe\" /burn.runonce") OR ((registry.data.strings="*-A251-47B7-93E1-CDD82E34AF8B}") OR (registry.data.strings = "grpconv -o") OR ((registry.data.strings like "%C:\\Program Files%" AND registry.data.strings like "%\\Dropbox\\Client\\Dropbox.exe%" AND registry.data.strings like "% /systemstartup%"))) OR (registry.path="*\\Explorer\\Browser Helper Objects\\{92EF2EAD-A7CE-4424-B0DB-499CF856608E}\\NoExplorer") OR (process.executable = "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\OfficeClickToRun.exe" AND registry.path like "%\\Office\\ClickToRun\\REGISTRY\\MACHINE\\Software\\Wow6432Node\\%") OR ((process.executable = "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe" OR process.executable = "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe") AND registry.path like "%\\Explorer\\Browser Helper Objects\\{31D09BA0-12F5-4CCE-BE8A-2923E76605DA}\\%") OR ((process.executable="C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\*" OR process.executable="C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\*") AND process.executable="*\\OfficeClickToRun.exe"))))
