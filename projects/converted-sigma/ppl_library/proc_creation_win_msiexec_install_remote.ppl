// Title: Suspicious Msiexec Quiet Install From Remote Location
// ID: 8150732a-0c9d-4a99-82b9-9efb9b90c40c
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-28
// Tags: attack.stealth, attack.t1218.007
// Description: Detects usage of Msiexec.exe to install packages hosted remotely quietly
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.command_line like "%-i%" OR process.command_line like "%/i%" OR process.command_line like "%-package%" OR process.command_line like "%/package%" OR process.command_line like "%-a%" OR process.command_line like "%/a%" OR process.command_line like "%-j%" OR process.command_line like "%/j%")) AND ((process.executable="*\\msiexec.exe") OR (process.pe.original_file_name = "msiexec.exe")) AND ((process.command_line like "%-q%" OR process.command_line like "%/q%")) AND ((process.command_line like "%http%" OR process.command_line like "%\\\\\\\\%"))) AND NOT (((process.command_line like "%\\AppData\\Local\\Temp\\OpenOffice%" AND process.command_line like "%Installation Files\\openoffice%"))))
