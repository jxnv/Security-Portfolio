// Title: Powershell Defender Exclusion
// ID: 17769c90-230e-488b-a463-e05c08e9d48f
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2021-04-29
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects requests to exclude files, folders or processes from Antivirus scanning using PowerShell cmdlets
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%Add-MpPreference %" OR process.command_line like "%Set-MpPreference %")) AND ((process.command_line like "% -ExclusionPath %" OR process.command_line like "% -ExclusionExtension %" OR process.command_line like "% -ExclusionProcess %" OR process.command_line like "% -ExclusionIpAddress %")))
