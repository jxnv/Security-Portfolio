// Title: Suspicious Process Patterns NTDS.DIT Exfil
// ID: 8bc64091-6875-4881-aaf9-7bd25b5dda08
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-11
// Tags: attack.credential-access, attack.t1003.003
// Description: Detects suspicious process patterns used in NTDS.DIT exfiltration
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.command_line like "%ac i ntds%" AND process.command_line like "%create full%")) OR ((process.command_line like "%/c copy %" AND process.command_line like "%\\windows\\ntds\\ntds.dit%")) OR ((process.command_line like "%activate instance ntds%" AND process.command_line like "%create full%")) OR ((process.command_line like "%powershell%" AND process.command_line like "%ntds.dit%")) OR (((process.executable="*\\NTDSDump.exe" OR process.executable="*\\NTDSDumpEx.exe")) OR ((process.command_line like "%ntds.dit%" AND process.command_line like "%system.hiv%")) OR (process.command_line like "%NTDSgrab.ps1%"))) OR ((((process.parent.executable like "%\\apache%" OR process.parent.executable like "%\\tomcat%" OR process.parent.executable like "%\\AppData\\%" OR process.parent.executable like "%\\Temp\\%" OR process.parent.executable like "%\\Public\\%" OR process.parent.executable like "%\\PerfLogs\\%")) OR ((process.executable like "%\\apache%" OR process.executable like "%\\tomcat%" OR process.executable like "%\\AppData\\%" OR process.executable like "%\\Temp\\%" OR process.executable like "%\\Public\\%" OR process.executable like "%\\PerfLogs\\%"))) AND (process.command_line like "%ntds.dit%")))
