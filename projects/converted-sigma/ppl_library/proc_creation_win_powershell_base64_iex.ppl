// Title: PowerShell Base64 Encoded IEX Cmdlet
// ID: 88f680b8-070e-402c-ae11-d2914f2257f1
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2019-08-23
// Tags: attack.execution, attack.t1059.001
// Description: Detects usage of a base64 encoded "IEX" cmdlet in a process command line
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%SUVYIChb%" OR process.command_line like "%lFWCAoW%" OR process.command_line like "%JRVggKF%" OR process.command_line like "%aWV4IChb%" OR process.command_line like "%lleCAoW%" OR process.command_line like "%pZXggKF%" OR process.command_line like "%aWV4IChOZX%" OR process.command_line like "%lleCAoTmV3%" OR process.command_line like "%pZXggKE5ld%" OR process.command_line like "%SUVYIChOZX%" OR process.command_line like "%lFWCAoTmV3%" OR process.command_line like "%JRVggKE5ld%" OR process.command_line like "%SUVYKF%" OR process.command_line like "%lFWChb%" OR process.command_line like "%JRVgoW%" OR process.command_line like "%aWV4KF%" OR process.command_line like "%lleChb%" OR process.command_line like "%pZXgoW%" OR process.command_line like "%aWV4KE5ld%" OR process.command_line like "%lleChOZX%" OR process.command_line like "%pZXgoTmV3%" OR process.command_line like "%SUVYKE5ld%" OR process.command_line like "%lFWChOZX%" OR process.command_line like "%JRVgoTmV3%" OR process.command_line like "%SUVYKCgn%" OR process.command_line like "%lFWCgoJ%" OR process.command_line like "%JRVgoKC%" OR process.command_line like "%aWV4KCgn%" OR process.command_line like "%lleCgoJ%" OR process.command_line like "%pZXgoKC%")) OR ((process.command_line like "%SQBFAFgAIAAoAFsA%" OR process.command_line like "%kARQBYACAAKABbA%" OR process.command_line like "%JAEUAWAAgACgAWw%" OR process.command_line like "%aQBlAHgAIAAoAFsA%" OR process.command_line like "%kAZQB4ACAAKABbA%" OR process.command_line like "%pAGUAeAAgACgAWw%" OR process.command_line like "%aQBlAHgAIAAoAE4AZQB3A%" OR process.command_line like "%kAZQB4ACAAKABOAGUAdw%" OR process.command_line like "%pAGUAeAAgACgATgBlAHcA%" OR process.command_line like "%SQBFAFgAIAAoAE4AZQB3A%" OR process.command_line like "%kARQBYACAAKABOAGUAdw%" OR process.command_line like "%JAEUAWAAgACgATgBlAHcA%")))
