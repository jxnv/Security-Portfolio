// Title: User Discovery And Export Via Get-ADUser Cmdlet
// ID: 1114e048-b69c-4f41-bc20-657245ae6e3f
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.discovery, attack.t1033
// Description: Detects usage of the Get-ADUser cmdlet to collect user information and output it to a file
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%Get-ADUser %" AND process.command_line like "% -Filter \\*%") AND (process.command_line like "% > %" OR process.command_line like "% | Select %" OR process.command_line like "%Out-File%" OR process.command_line like "%Set-Content%" OR process.command_line like "%Add-Content%")) AND (((process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe")) OR ((process.pe.original_file_name = "PowerShell.EXE" OR process.pe.original_file_name = "pwsh.dll"))))
