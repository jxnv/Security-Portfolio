// Title: Reg Add Suspicious Paths
// ID: b7e2a8d4-74bb-4b78-adc9-3f92af2d4829
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-19
// Tags: attack.persistence, attack.defense-impairment, attack.t1112, attack.t1685
// Description: Detects when an adversary uses the reg.exe utility to add or modify new keys or subkeys
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%\\AppDataLow\\Software\\Microsoft\\%" OR process.command_line like "%\\Policies\\Microsoft\\Windows\\OOBE%" OR process.command_line like "%\\Policies\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon%" OR process.command_line like "%\\SOFTWARE\\Microsoft\\Windows NT\\Currentversion\\Winlogon%" OR process.command_line like "%\\CurrentControlSet\\Control\\SecurityProviders\\WDigest%" OR process.command_line like "%\\Microsoft\\Windows Defender\\%")) AND ((process.executable="*\\reg.exe") OR (process.pe.original_file_name = "reg.exe")))
