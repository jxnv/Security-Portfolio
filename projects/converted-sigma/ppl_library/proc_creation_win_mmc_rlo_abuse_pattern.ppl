// Title: MMC Executing Files with Reversed Extensions Using RTLO Abuse
// ID: 9cfe4b27-1e56-48b4-b7a8-d46851c91a44
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-02-05
// Tags: attack.execution, attack.stealth, attack.t1204.002, attack.t1218.014, attack.t1036.002
// Description: Detects malicious behavior where the MMC utility (`mmc.exe`) executes files with reversed extensions caused by Right-to-Left Override (RLO) abuse, disguising them as document formats.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%cod.msc%" OR process.command_line like "%fdp.msc%" OR process.command_line like "%ftr.msc%" OR process.command_line like "%lmth.msc%" OR process.command_line like "%slx.msc%" OR process.command_line like "%tdo.msc%" OR process.command_line like "%xcod.msc%" OR process.command_line like "%xslx.msc%" OR process.command_line like "%xtpp.msc%")) AND ((process.executable="*\\mmc.exe") OR (process.pe.original_file_name = "MMC.exe")))
