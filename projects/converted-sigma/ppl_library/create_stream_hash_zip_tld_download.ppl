// Title: Potentially Suspicious File Download From ZIP TLD
// ID: 0bb4bbeb-fe52-4044-b40c-430a04577ebe
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2023-05-18
// Tags: attack.stealth
// Description: Detects the download of a file with a potentially suspicious extension from a .zip top level domain.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (Contents like "%.zip/%" AND (file.path like "%.bat:Zone%" OR file.path like "%.dat:Zone%" OR file.path like "%.dll:Zone%" OR file.path like "%.doc:Zone%" OR file.path like "%.docm:Zone%" OR file.path like "%.exe:Zone%" OR file.path like "%.hta:Zone%" OR file.path like "%.pptm:Zone%" OR file.path like "%.ps1:Zone%" OR file.path like "%.rar:Zone%" OR file.path like "%.rtf:Zone%" OR file.path like "%.sct:Zone%" OR file.path like "%.vbe:Zone%" OR file.path like "%.vbs:Zone%" OR file.path like "%.ws:Zone%" OR file.path like "%.wsf:Zone%" OR file.path like "%.xll:Zone%" OR file.path like "%.xls:Zone%" OR file.path like "%.xlsm:Zone%" OR file.path like "%.zip:Zone%"))
