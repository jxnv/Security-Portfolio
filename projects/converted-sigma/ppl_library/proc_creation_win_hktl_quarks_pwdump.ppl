// Title: HackTool - Quarks PwDump Execution
// ID: 0685b176-c816-4837-8e7b-1216f346636b
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-05
// Tags: attack.credential-access, attack.t1003.002
// Description: Detects usage of the Quarks PwDump tool via commandline arguments
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line = " -dhl" OR process.command_line = " --dump-hash-local" OR process.command_line = " -dhdc" OR process.command_line = " --dump-hash-domain-cached" OR process.command_line = " --dump-bitlocker" OR process.command_line = " -dhd " OR process.command_line = " --dump-hash-domain " OR process.command_line = "--ntds-file")) OR (process.executable="*\\QuarksPwDump.exe"))
