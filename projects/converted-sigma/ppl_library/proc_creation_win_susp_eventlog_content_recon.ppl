// Title: Potentially Suspicious EventLog Recon Activity Using Log Query Utilities
// ID: beaa66d6-aa1b-4e3c-80f5-e0145369bfaf
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.credential-access, attack.discovery, attack.t1552, attack.t1087
// Description: Detects execution of different log query utilities and commands to search and dump the content of specific event logs or look for specific event IDs.
// This technique is used by threat actors in order to extract sensitive information from events logs such as usernames, IP addresses, hostnames, etc.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.command_line like "%-InstanceId 462?%" OR process.command_line like "%.eventid -eq 462?%" OR process.command_line like "%.ID -eq 462?%" OR process.command_line like "%EventCode=?462?%" OR process.command_line like "%EventIdentifier=?462?%" OR process.command_line like "%System[EventID=462?]%" OR process.command_line like "%-InstanceId 4778%" OR process.command_line like "%.eventid -eq 4778%" OR process.command_line like "%.ID -eq 4778%" OR process.command_line like "%EventCode=?4778?%" OR process.command_line like "%EventIdentifier=?4778?%" OR process.command_line like "%System[EventID=4778]%" OR process.command_line like "%-InstanceId 25%" OR process.command_line like "%.eventid -eq 25%" OR process.command_line like "%.ID -eq 25%" OR process.command_line like "%EventCode=?25?%" OR process.command_line like "%EventIdentifier=?25?%" OR process.command_line like "%System[EventID=25]%" OR process.command_line like "%-InstanceId 1149%" OR process.command_line like "%.eventid -eq 1149%" OR process.command_line like "%.ID -eq 1149%" OR process.command_line like "%EventCode=?1149?%" OR process.command_line like "%EventIdentifier=?1149?%" OR process.command_line like "%System[EventID=1149]%" OR process.command_line like "%-InstanceId 21%" OR process.command_line like "%.eventid -eq 21%" OR process.command_line like "%.ID -eq 21%" OR process.command_line like "%EventCode=?21?%" OR process.command_line like "%EventIdentifier=?21?%" OR process.command_line like "%System[EventID=21]%" OR process.command_line like "%-InstanceId 22%" OR process.command_line like "%.eventid -eq 22%" OR process.command_line like "%.ID -eq 22%" OR process.command_line like "%EventCode=?22?%" OR process.command_line like "%EventIdentifier=?22?%" OR process.command_line like "%System[EventID=22]%")) OR ((process.command_line like "%Microsoft-Windows-PowerShell%" OR process.command_line like "%Microsoft-Windows-Security-Auditing%" OR process.command_line like "%Microsoft-Windows-TerminalServices-LocalSessionManager%" OR process.command_line like "%Microsoft-Windows-TerminalServices-RemoteConnectionManager%" OR process.command_line like "%Microsoft-Windows-Windows Defender%" OR process.command_line like "%PowerShellCore%" OR process.command_line like "%Security%" OR process.command_line like "%Windows PowerShell%"))) AND (((process.command_line like "%Select%" AND process.command_line like "%Win32_NTLogEvent%")) OR (((process.command_line like "% qe %" OR process.command_line like "% query-events %")) AND ((process.executable="*\\wevtutil.exe") OR (process.pe.original_file_name = "wevtutil.exe"))) OR ((process.command_line like "% ntevent%") AND ((process.executable="*\\wmic.exe") OR (process.pe.original_file_name = "wmic.exe"))) OR ((process.command_line like "%Get-WinEvent %" OR process.command_line like "%get-eventlog %"))))
