// Title: PUA - Ngrok Execution
// ID: ee37eb7c-a4e7-4cd5-8fa4-efa27f1c3f31
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-05-14
// Tags: attack.command-and-control, attack.t1572
// Description: Detects the use of Ngrok, a utility used for port forwarding and tunneling, often used by threat actors to make local protected services publicly available.
// Involved domains are bin.equinox.io for download and *.ngrok.io for connections.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "% tcp 139%" OR process.command_line like "% tcp 445%" OR process.command_line like "% tcp 3389%" OR process.command_line like "% tcp 5985%" OR process.command_line like "% tcp 5986%")) OR ((process.command_line like "% start %" AND process.command_line like "%--all%" AND process.command_line like "%--config%" AND process.command_line like "%.yml%")) OR (process.executable="*ngrok.exe" AND (process.command_line like "% tcp %" OR process.command_line like "% http %" OR process.command_line like "% authtoken %")) OR ((process.command_line like "%.exe authtoken %" OR process.command_line like "%.exe start --all%")))
