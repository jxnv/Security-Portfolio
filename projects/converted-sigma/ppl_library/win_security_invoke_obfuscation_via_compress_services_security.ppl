// Title: Invoke-Obfuscation COMPRESS OBFUSCATION - Security
// ID: 7a922f1b-2635-4d6c-91ef-af228b198ad3
// Status: test
// Level: medium
// Author: Timur Zinniatullin, oscd.community
// Date: 2020-10-18
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via COMPRESS OBFUSCATION
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (winlog.event_id = "4697" AND (ServiceFileName like "%new-object%" AND ServiceFileName like "%text.encoding]::ascii%" AND ServiceFileName like "%readtoend%") AND (ServiceFileName like "%system.io.compression.deflatestream%" OR ServiceFileName like "%system.io.streamreader%"))
