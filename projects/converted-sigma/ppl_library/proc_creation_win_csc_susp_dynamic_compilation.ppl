// Title: Dynamic .NET Compilation Via Csc.EXE
// ID: dcaa3f04-70c3-427a-80b4-b870d73c94c4
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2019-08-24
// Tags: attack.stealth, attack.t1027.004
// Description: Detects execution of "csc.exe" to compile .NET code. Attackers often leverage this to compile code on the fly and use it in other stages.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.executable="*\\csc.exe") AND (((process.command_line like "%:\\Perflogs\\%" OR process.command_line like "%:\\Users\\Public\\%" OR process.command_line like "%\\AppData\\Local\\Temp\\%" OR process.command_line like "%\\Temporary Internet%" OR process.command_line like "%\\Windows\\Temp\\%")) OR (((process.command_line like "%:\\Users\\%" AND process.command_line like "%\\Favorites\\%")) OR ((process.command_line like "%:\\Users\\%" AND process.command_line like "%\\Favourites\\%")) OR ((process.command_line like "%:\\Users\\%" AND process.command_line like "%\\Contacts\\%")) OR ((process.command_line like "%:\\Users\\%" AND process.command_line like "%\\Pictures\\%"))) OR (process.command_line=regex("(?:[Pp]rogram[Dd]ata|%(?:[Ll]ocal)?[Aa]pp[Dd]ata%|\\\\[Aa]pp[Dd]ata\\\\(?:[Ll]ocal(?:[Ll]ow)?|[Rr]oaming))\\\\[^\\\\]{1,256}$"))) AND NOT ((((process.parent.executable="C:\\Program Files (x86)\\*" OR process.parent.executable="C:\\Program Files\\*")) OR (process.parent.executable = "C:\\Windows\\System32\\sdiagnhost.exe") OR (process.parent.executable = "C:\\Windows\\System32\\inetsrv\\w3wp.exe"))) AND NOT ((((process.parent.command_line like "%JwB7ACIAZgBhAGkAbABlAGQAIgA6AHQAcgB1AGUALAAiAG0AcwBnACIAOgAiAEEAbgBzAGkAYgBsAGUAIAByAGUAcQB1AGkAcgBlAHMAIABQAG8AdwBlAHIAUwBoAGUAbABsACAAdgAzAC4AMAAgAG8AcgAgAG4AZQB3AGUAcgAiAH0AJw%" OR process.parent.command_line like "%cAewAiAGYAYQBpAGwAZQBkACIAOgB0AHIAdQBlACwAIgBtAHMAZwAiADoAIgBBAG4AcwBpAGIAbABlACAAcgBlAHEAdQBpAHIAZQBzACAAUABvAHcAZQByAFMAaABlAGwAbAAgAHYAMwAuADAAIABvAHIAIABuAGUAdwBlAHIAIgB9ACcA%" OR process.parent.command_line like "%nAHsAIgBmAGEAaQBsAGUAZAAiADoAdAByAHUAZQAsACIAbQBzAGcAIgA6ACIAQQBuAHMAaQBiAGwAZQAgAHIAZQBxAHUAaQByAGUAcwAgAFAAbwB3AGUAcgBTAGgAZQBsAGwAIAB2ADMALgAwACAAbwByACAAbgBlAHcAZQByACIAfQAnA%")) OR ((process.parent.executable = "C:\\ProgramData\\chocolatey\\choco.exe" OR process.parent.executable = "C:\\ProgramData\\chocolatey\\tools\\shimgen.exe")) OR (process.parent.command_line like "%\\ProgramData\\Microsoft\\Windows Defender Advanced Threat Protection%"))))
