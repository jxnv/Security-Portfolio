// Title: HackTool - LaZagne Execution
// ID: c2b86e67-b880-4eec-b045-50bc98ef4844
// Status: experimental
// Level: medium
// Author: Nasreddine Bencherchali, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.credential-access
// Description: Detects the execution of the LaZagne. A utility used to retrieve multiple types of passwords stored on a local computer.
// LaZagne has been leveraged multiple times by threat actors in order to dump credentials.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.executable like "%:\\PerfLogs\\%" OR process.executable like "%:\\ProgramData\\%" OR process.executable like "%:\\Temp\\%" OR process.executable like "%:\\Tmp\\%" OR process.executable like "%:\\Users\\Public\\%" OR process.executable like "%:\\Windows\\Temp\\%" OR process.executable like "%\\$Recycle.bin%" OR process.executable like "%\\AppData\\%" OR process.executable like "%\\Desktop\\%" OR process.executable like "%\\Downloads\\%" OR process.executable like "%\\Favorites\\%" OR process.executable like "%\\Links\\%" OR process.executable like "%\\Music\\%" OR process.executable like "%\\Photos\\%" OR process.executable like "%\\Pictures\\%" OR process.executable like "%\\Saved Games\\%" OR process.executable like "%\\Searches\\%" OR process.executable like "%\\Users\\Contacts\\%" OR process.executable like "%\\Users\\Default\\%" OR process.executable like "%\\Users\\Searches\\%" OR process.executable like "%\\Videos\\%" OR process.executable like "%\\Windows\\addins\\%" OR process.executable like "%\\Windows\\Fonts\\%" OR process.executable like "%\\Windows\\IME\\%") AND (process.command_line="*.exe all" OR process.command_line="*.exe browsers" OR process.command_line="*.exe chats" OR process.command_line="*.exe databases" OR process.command_line="*.exe games" OR process.command_line="*.exe git" OR process.command_line="*.exe mails" OR process.command_line="*.exe maven" OR process.command_line="*.exe memory" OR process.command_line="*.exe multimedia" OR process.command_line="*.exe sysadmin" OR process.command_line="*.exe unused" OR process.command_line="*.exe wifi" OR process.command_line="*.exe windows")) OR (process.executable="*\\lazagne.exe")) OR (((process.command_line like "% all %" OR process.command_line like "% browsers %" OR process.command_line like "% chats %" OR process.command_line like "% databases %" OR process.command_line like "% games %" OR process.command_line like "% mails %" OR process.command_line like "% maven %" OR process.command_line like "% memory %" OR process.command_line like "% multimedia %" OR process.command_line like "% php %" OR process.command_line like "% svn %" OR process.command_line like "% sysadmin %" OR process.command_line like "% unused %" OR process.command_line like "% wifi %")) AND ((process.command_line like "%-1Password%" OR process.command_line like "%-apachedirectorystudio%" OR process.command_line like "%-autologon%" OR process.command_line like "%-ChromiumBased%" OR process.command_line like "%-coreftp%" OR process.command_line like "%-credfiles%" OR process.command_line like "%-credman%" OR process.command_line like "%-cyberduck%" OR process.command_line like "%-dbvis%" OR process.command_line like "%-EyeCon%" OR process.command_line like "%-filezilla%" OR process.command_line like "%-filezillaserver%" OR process.command_line like "%-ftpnavigator%" OR process.command_line like "%-galconfusion%" OR process.command_line like "%-gitforwindows%" OR process.command_line like "%-hashdump%" OR process.command_line like "%-iisapppool%" OR process.command_line like "%-IISCentralCertP%" OR process.command_line like "%-kalypsomedia%" OR process.command_line like "%-keepass%" OR process.command_line like "%-keepassconfig%" OR process.command_line like "%-lsa_secrets%" OR process.command_line like "%-mavenrepositories%" OR process.command_line like "%-memory_dump%" OR process.command_line like "%-Mozilla%" OR process.command_line like "%-mRemoteNG%" OR process.command_line like "%-mscache%" OR process.command_line like "%-opensshforwindows%" OR process.command_line like "%-openvpn%" OR process.command_line like "%-outlook%" OR process.command_line like "%-pidgin%" OR process.command_line like "%-postgresql%" OR process.command_line like "%-psi-im%" OR process.command_line like "%-puttycm%" OR process.command_line like "%-pypykatz%" OR process.command_line like "%-Rclone%" OR process.command_line like "%-rdpmanager%" OR process.command_line like "%-robomongo%" OR process.command_line like "%-roguestale%" OR process.command_line like "%-skype%" OR process.command_line like "%-SQLDeveloper%" OR process.command_line like "%-squirrel%" OR process.command_line like "%-tortoise%" OR process.command_line like "%-turba%" OR process.command_line like "%-UCBrowser%" OR process.command_line like "%-unattended%" OR process.command_line like "%-vault%" OR process.command_line like "%-vaultfiles%" OR process.command_line like "%-vnc%" OR process.command_line like "%-winscp%"))))
