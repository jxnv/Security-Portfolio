// Title: Suspicious DLL Loaded via CertOC.EXE
// ID: 84232095-ecca-4015-b0d7-7726507ee793
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-15
// Tags: attack.stealth, attack.t1218
// Description: Detects when a user installs certificates by using CertOC.exe to load the target DLL file.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.command_line like "% -LoadDLL %") AND ((process.executable="*\\certoc.exe") OR (process.pe.original_file_name = "CertOC.exe")) AND ((process.command_line like "%\\Appdata\\Local\\Temp\\%" OR process.command_line like "%\\Desktop\\%" OR process.command_line like "%\\Downloads\\%" OR process.command_line like "%\\Users\\Public\\%" OR process.command_line like "%C:\\Windows\\Tasks\\%" OR process.command_line like "%C:\\Windows\\Temp\\%")))
