// Title: ServiceDll Hijack
// ID: 612e47e9-8a59-43a6-b404-f48683f45bd6
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-02-04
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects changes to the "ServiceDLL" value related to a service in the registry.
// This is often used as a method of persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((registry.path like "%\\System\\%" AND registry.path like "%ControlSet%" AND registry.path like "%\\Services\\%") AND registry.path="*\\Parameters\\ServiceDll") AND NOT (((process.executable = "C:\\Windows\\system32\\lsass.exe" AND registry.path="*\\Services\\NTDS\\Parameters\\ServiceDll" AND registry.data.strings = "%%systemroot%%\\system32\\ntdsa.dll") OR (process.executable = "C:\\Windows\\System32\\poqexec.exe") OR (registry.data.strings = "C:\\Windows\\system32\\spool\\drivers\\x64\\3\\PrintConfig.dll") OR (process.executable="*\\regsvr32.exe" AND registry.path="*\\Services\\PrintNotify\\Parameters\\ServiceDll" AND registry.data.strings="C:\\WINDOWS\\System32\\DriverStore\\FileRepository\\*" AND registry.data.strings="*\\arm64\\PrintConfig.dll"))) AND NOT ((process.executable="*\\regsvr32.exe" AND registry.data.strings = "C:\\Windows\\System32\\STAgent.dll")))
