// Title: Office Macro File Creation
// ID: 91174a41-dc8f-401b-be89-7bfc140612a0
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-23
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects the creation of a new office macro files on the systems
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((file.path="*.docm" OR file.path="*.dotm" OR file.path="*.xlsm" OR file.path="*.xltm" OR file.path="*.potm" OR file.path="*.pptm")) AND NOT (((process.executable="C:\\Program Files\\Microsoft Office\\*" OR process.executable="C:\\Program Files (x86)\\Microsoft Office\\*") AND (process.executable="*\\WINWORD.EXE" OR process.executable="*\\EXCEL.EXE" OR process.executable="*\\POWERPNT.EXE") AND file.path like "%\\~$%")))
