// Title: Scripting/CommandLine Process Spawned Regsvr32
// ID: ab37a6ec-6068-432b-a64e-2c7bf95b1d22
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-26
// Tags: attack.stealth, attack.t1218.010
// Description: Detects various command line and scripting engines/processes such as "PowerShell", "Wscript", "Cmd", etc. spawning a "regsvr32" instance.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.parent.executable="*\\cmd.exe" OR process.parent.executable="*\\cscript.exe" OR process.parent.executable="*\\mshta.exe" OR process.parent.executable="*\\powershell_ise.exe" OR process.parent.executable="*\\powershell.exe" OR process.parent.executable="*\\pwsh.exe" OR process.parent.executable="*\\wscript.exe") AND process.executable="*\\regsvr32.exe") AND NOT ((process.parent.executable = "C:\\Windows\\System32\\cmd.exe" AND process.command_line="* /s C:\\Windows\\System32\\RpcProxy\\RpcProxy.dll")))
