// Title: Suspicious MacOS Firmware Activity
// ID: 7ed2c9f7-c59d-4c82-a7e2-f859aa676099
// Status: test
// Level: medium
// Author: Austin Songer @austinsonger
// Date: 2021-09-30
// Tags: attack.impact
// Description: Detects when a user manipulates with Firmward Password on MacOS. NOTE - this command has been disabled on silicon-based apple computers.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (process.executable = "/usr/sbin/firmwarepasswd" AND (process.command_line like "%setpasswd%" OR process.command_line like "%full%" OR process.command_line like "%delete%" OR process.command_line like "%check%"))
