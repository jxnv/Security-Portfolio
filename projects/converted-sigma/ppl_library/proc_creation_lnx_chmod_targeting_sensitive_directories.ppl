// Title: Chmod Targeting Sensitive Directories
// ID: 6419afd1-3742-47a5-a7e6-b50386cd15f8
// Status: test
// Level: medium
// Author: Christopher Peacock @SecurePeacock, SCYTHE @scythe_io
// Date: 2022-06-03
// Tags: attack.defense-impairment, attack.t1222.002
// Description: Detects chmod targeting files in sensitive directory paths on Linux systems.
// Attackers may use chmod to change permissions of files in these directories to maintain persistence, escalate privileges, or disrupt system operations.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.executable="*/chmod" AND (process.command_line like "%/tmp/%" OR process.command_line like "%/.Library/%" OR process.command_line like "%/etc/%" OR process.command_line like "%/opt/%")) AND NOT (((process.command_line="chmod 700 /tmp/apt-key-gpghome.*") OR (process.command_line = "chmod 0775 /etc/landscape/") OR (process.command_line="chmod 755 /var/tmp/mkinitramfs*") OR (process.command_line like "%/etc/%" AND (process.parent.command_line like "%/var/lib/dpkg/info/%" AND process.parent.command_line like "%.postinst configure%")) OR (process.command_line = "chmod 644 /etc/apparmor.d/tunables/home.d/ubuntu") OR (process.command_line like "%chmod --reference=/etc/shells%" AND process.parent.command_line="*/update-shells"))))
