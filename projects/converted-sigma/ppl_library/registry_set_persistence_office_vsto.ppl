// Title: Potential Persistence Via Visual Studio Tools for Office
// ID: 9d15044a-7cfe-4d23-8085-6ebc11df7685
// Status: test
// Level: medium
// Author: Bhabesh Raj
// Date: 2021-01-10
// Tags: attack.t1137.006, attack.persistence
// Description: Detects persistence via Visual Studio Tools for Office (VSTO) add-ins in Office applications.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((registry.path like "%\\Software\\Microsoft\\Office\\Outlook\\Addins\\%" OR registry.path like "%\\Software\\Microsoft\\Office\\Word\\Addins\\%" OR registry.path like "%\\Software\\Microsoft\\Office\\Excel\\Addins\\%" OR registry.path like "%\\Software\\Microsoft\\Office\\Powerpoint\\Addins\\%" OR registry.path like "%\\Software\\Microsoft\\VSTO\\Security\\Inclusion\\%")) AND NOT ((((process.executable = "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe" OR process.executable = "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe")) OR ((process.executable="C:\\Program Files\\Microsoft Office\\OFFICE*" OR process.executable="C:\\Program Files (x86)\\Microsoft Office\\OFFICE*" OR process.executable="C:\\Program Files\\Microsoft Office\\Root\\OFFICE*" OR process.executable="C:\\Program Files (x86)\\Microsoft Office\\Root\\OFFICE*" OR process.executable="C:\\PROGRA~2\\MICROS~2\\Office*") AND (process.executable="*\\excel.exe" OR process.executable="*\\Integrator.exe" OR process.executable="*\\OneNote.exe" OR process.executable="*\\outlook.exe" OR process.executable="*\\powerpnt.exe" OR process.executable="*\\Teams.exe" OR process.executable="*\\visio.exe" OR process.executable="*\\winword.exe")) OR ((process.executable="C:\\Program Files\\Common Files (x86)\\Microsoft Shared\\ClickToRun\\*" OR process.executable="C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\*") AND process.executable="*\\OfficeClickToRun.exe") OR ((process.executable = "C:\\Windows\\System32\\msiexec.exe" OR process.executable = "C:\\Windows\\SysWOW64\\msiexec.exe" OR process.executable = "C:\\Windows\\System32\\regsvr32.exe" OR process.executable = "C:\\Windows\\SysWOW64\\regsvr32.exe")) OR ((process.executable="C:\\Program Files\\Common Files\\Microsoft Shared\\VSTO\\*" OR process.executable="C:\\Program Files (x86)\\Microsoft Shared\\VSTO\\*") AND process.executable="*\\VSTOInstaller.exe"))) AND NOT ((((process.executable = "C:\\Program Files\\Avast Software\\Avast\\RegSvr.exe" OR process.executable = "C:\\Program Files (x86)\\Avast Software\\Avast\\RegSvr.exe") AND registry.path like "%\\Microsoft\\Office\\Outlook\\Addins\\Avast.AsOutExt\\%") OR ((process.executable = "C:\\Program Files\\AVG\\Antivirus\\RegSvr.exe" OR process.executable = "C:\\Program Files (x86)\\AVG\\Antivirus\\RegSvr.exe") AND registry.path like "%\\Microsoft\\Office\\Outlook\\Addins\\Antivirus.AsOutExt\\%"))))
