// Title: Compress Data and Lock With Password for Exfiltration With 7-ZIP
// ID: 9fbf5927-5261-4284-a71d-f681029ea574
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-07-27
// Tags: attack.collection, attack.t1560.001
// Description: An adversary may compress or encrypt data that is collected prior to exfiltration using 3rd party utilities
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "% a %" OR process.command_line like "% u %")) AND ((Description like "%7-Zip%") OR ((process.executable="*\\7z.exe" OR process.executable="*\\7zr.exe" OR process.executable="*\\7za.exe")) OR ((process.pe.original_file_name = "7z.exe" OR process.pe.original_file_name = "7za.exe" OR process.pe.original_file_name = "7zr.exe"))) AND (process.command_line like "% -p%"))
