// Title: Execution Of Non-Existing File
// ID: 71158e3f-df67-472b-930e-7d287acaa3e1
// Status: test
// Level: high
// Author: Max Altgelt (Nextron Systems)
// Date: 2021-12-09
// Tags: attack.stealth, attack.privilege-escalation, attack.t1055
// Description: Detects process creation events where the Image field lacks an absolute path,
// which occurs when the backing file no longer exists on disk at the time of
// logging - commonly caused by Process Ghosting or other unorthodox process creation techniques.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (NOT ((process.executable like "%\\%")) AND NOT (((((process.executable = "MemCompression" OR process.executable = "Registry" OR process.executable = "System" OR process.executable = "vmmem" OR process.executable = "vmmemWSL")) OR ((process.command_line = "MemCompression" OR process.command_line = "Registry" OR process.command_line = "vmmem" OR process.command_line = "vmmemWSL"))) OR ((process.executable = "-" OR process.executable = "")) OR (NOT process.executable=*))))
