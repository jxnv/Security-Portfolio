// Title: RDP Connection Allowed Via Netsh.EXE
// ID: 01aeb693-138d-49d2-9403-c4f52d7d3d62
// Status: test
// Level: high
// Author: Sander Wiebing
// Date: 2020-05-23
// Tags: attack.defense-impairment, attack.t1686.003
// Description: Detects usage of the netsh command to open and allow connections to port 3389 (RDP). As seen used by Sarwent Malware
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%firewall %" AND process.command_line like "%add %" AND process.command_line like "%tcp %" AND process.command_line like "%3389%") AND (process.command_line like "%portopening%" OR process.command_line like "%allow%")) AND ((process.executable="*\\netsh.exe") OR (process.pe.original_file_name = "netsh.exe")))
