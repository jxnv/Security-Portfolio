// Title: Execute From Alternate Data Streams
// ID: 7f43c430-5001-4f8b-aaa9-c3b88f18fa5c
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-09-01
// Tags: attack.stealth, attack.t1564.004
// Description: Detects execution from an Alternate Data Stream (ADS). Adversaries may use NTFS file attributes to hide their malicious data in order to evade detection
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.command_line like "%txt:%") AND (((process.command_line like "%esentutl %" AND process.command_line like "% /y %" AND process.command_line like "% /d %" AND process.command_line like "% /o %")) OR ((process.command_line like "%makecab %" AND process.command_line like "%.cab%")) OR ((process.command_line like "%reg %" AND process.command_line like "% export %")) OR ((process.command_line like "%regedit %" AND process.command_line like "% /E %")) OR ((process.command_line like "%type %" AND process.command_line like "% > %"))))
