// Title: Network Connection Initiated To AzureWebsites.NET By Non-Browser Process
// ID: 5c80b618-0dbb-46e6-acbb-03d90bcb6d83
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.command-and-control, attack.t1102, attack.t1102.001
// Description: Detects an initiated network connection by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((Initiated = "true" AND DestinationHostname="*azurewebsites.net") AND NOT ((((process.executable="C:\\Program Files (x86)\\Avant Browser\\*" OR process.executable="C:\\Program Files\\Avant Browser\\*") AND process.executable="*\\avant.exe") OR (process.executable="C:\\Program Files\\BraveSoftware\\*" AND process.executable="*\\brave.exe") OR ((process.executable = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR process.executable = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR (process.executable="C:\\Users\\*" AND process.executable="*\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe") OR ((process.executable like "%C:\\Program Files\\Windows Defender Advanced Threat Protection\\%" OR process.executable like "%C:\\Program Files\\Windows Defender\\%" OR process.executable like "%C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\%") AND (process.executable="*\\MsMpEng.exe" OR process.executable="*\\MsSense.exe")) OR (process.executable like "%\\AppData\\Local\\Discord\\%" AND process.executable="*\\Discord.exe") OR ((process.executable="C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*") OR (process.executable="*\\WindowsApps\\MicrosoftEdge.exe") OR ((process.executable = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR process.executable = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process.executable="C:\\Program Files (x86)\\Microsoft\\EdgeCore\\*" OR process.executable="C:\\Program Files\\Microsoft\\EdgeCore\\*") AND (process.executable="*\\msedge.exe" OR process.executable="*\\msedgewebview2.exe")) OR (process.executable = "") OR ((process.executable="C:\\Program Files\\Falkon\\*" OR process.executable="C:\\Program Files (x86)\\Falkon\\*") AND process.executable="*\\falkon.exe") OR ((process.executable = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR process.executable = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR (process.executable="C:\\Users\\*" AND process.executable="*\\AppData\\Local\\Mozilla Firefox\\firefox.exe") OR (process.executable like "%\\AppData\\Local\\Flock\\%" AND process.executable="*\\Flock.exe") OR ((process.executable = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR process.executable = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process.executable like "%\\AppData\\Local\\Maxthon\\%" AND process.executable="*\\maxthon.exe") OR (NOT process.executable=*) OR (process.executable like "%\\AppData\\Local\\Programs\\Opera\\%" AND process.executable="*\\opera.exe") OR (process.executable like "%\\AppData\\Local\\Phoebe\\%" AND process.executable="*\\Phoebe.exe") OR ((process.executable="*C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe" OR process.executable="*C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe")) OR ((process.executable="C:\\Program Files (x86)\\QtWeb\\*" OR process.executable="C:\\Program Files\\QtWeb\\*") AND process.executable="*\\QtWeb.exe") OR ((process.executable like "%C:\\Program Files (x86)\\Safari\\%" OR process.executable like "%C:\\Program Files\\Safari\\%") AND process.executable="*\\safari.exe") OR ((process.executable="C:\\Program Files\\SeaMonkey\\*" OR process.executable="C:\\Program Files (x86)\\SeaMonkey\\*") AND process.executable="*\\seamonkey.exe") OR ((process.executable="C:\\Program Files\\SlimBrowser\\*" OR process.executable="C:\\Program Files (x86)\\SlimBrowser\\*") AND process.executable="*\\slimbrowser.exe") OR (process.executable like "%\\AppData\\Local\\Vivaldi\\%" AND process.executable="*\\vivaldi.exe") OR ((process.executable="C:\\Program Files\\Naver\\Naver Whale\\*" OR process.executable="C:\\Program Files (x86)\\Naver\\Naver Whale\\*") AND process.executable="*\\whale.exe") OR ((process.executable="C:\\Program Files\\Waterfox\\*" OR process.executable="C:\\Program Files (x86)\\Waterfox\\*") AND process.executable="*\\Waterfox.exe"))))
