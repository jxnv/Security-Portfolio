// Title: PowerShell as a Service in Registry
// ID: 4a5f5a5e-ac01-474b-9b4e-d61298c9df1d
// Status: test
// Level: high
// Author: oscd.community, Natalia Shornikova
// Date: 2020-10-06
// Tags: attack.execution, attack.t1569.002
// Description: Detects that a powershell code is written to the registry as a service.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (registry.path like "%\\Services\\%" AND registry.path="*\\ImagePath" AND (registry.data.strings like "%powershell%" OR registry.data.strings like "%pwsh%"))
