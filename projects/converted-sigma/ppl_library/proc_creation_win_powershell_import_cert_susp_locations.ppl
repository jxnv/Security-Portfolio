// Title: Root Certificate Installed From Susp Locations
// ID: 5f6a601c-2ecb-498b-9c33-660362323afa
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.defense-impairment, attack.t1553.004
// Description: Adversaries may install a root certificate on a compromised system to avoid warnings when connecting to adversary controlled web servers.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.command_line like "%Import-Certificate%" AND process.command_line like "% -FilePath %" AND process.command_line like "%Cert:\\LocalMachine\\Root%") AND (process.command_line like "%\\AppData\\Local\\Temp\\%" OR process.command_line like "%:\\Windows\\TEMP\\%" OR process.command_line like "%\\Desktop\\%" OR process.command_line like "%\\Downloads\\%" OR process.command_line like "%\\Perflogs\\%" OR process.command_line like "%:\\Users\\Public\\%"))
