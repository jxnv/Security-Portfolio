// Title: Potential Goopdate.DLL Sideloading
// ID: b6188d2f-b3c4-4d2c-a17d-9706e0851af0
// Status: test
// Level: medium
// Author: X__Junior (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-15
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of "goopdate.dll", a DLL used by googleupdate.exe
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((ImageLoaded="*\\goopdate.dll") AND NOT (((ImageLoaded="C:\\Program Files (x86)\\*" OR ImageLoaded="C:\\Program Files\\*"))) AND NOT ((((process.executable like "%\\AppData\\Local\\Temp\\GUM%" AND process.executable like "%.tmp\\Dropbox%") AND (ImageLoaded like "%\\AppData\\Local\\Temp\\GUM%" AND ImageLoaded like "%.tmp\\goopdate.dll%")) OR ((process.executable like "%\\AppData\\Local\\Temp\\GUM%" OR process.executable like "%:\\Windows\\SystemTemp\\GUM%") AND process.executable="*.tmp\\GoogleUpdate.exe" AND (ImageLoaded like "%\\AppData\\Local\\Temp\\GUM%" OR ImageLoaded like "%:\\Windows\\SystemTemp\\GUM%")))))
