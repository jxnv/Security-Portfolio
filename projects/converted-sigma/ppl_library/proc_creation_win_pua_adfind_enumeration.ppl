// Title: PUA - Suspicious ActiveDirectory Enumeration Via AdFind.EXE
// ID: 455b9d50-15a1-4b99-853f-8d37655a4c1b
// Status: test
// Level: high
// Author: frack113
// Date: 2021-12-13
// Tags: attack.discovery, attack.t1087.002
// Description: Detects active directory enumeration activity using known AdFind CLI flags
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.command_line like "%-sc admincountdmp%") OR (process.command_line like "%-sc exchaddresses%") OR ((process.command_line like "%lockoutduration%" OR process.command_line like "%lockoutthreshold%" OR process.command_line like "%lockoutobservationwindow%" OR process.command_line like "%maxpwdage%" OR process.command_line like "%minpwdage%" OR process.command_line like "%minpwdlength%" OR process.command_line like "%pwdhistorylength%" OR process.command_line like "%pwdproperties%")))
