// Title: Execution of Powershell Script in Public Folder
// ID: fb9d3ff7-7348-46ab-af8c-b55f5fbf39b4
// Status: test
// Level: high
// Author: Max Altgelt (Nextron Systems)
// Date: 2022-04-06
// Tags: attack.execution, attack.t1059.001
// Description: This rule detects execution of PowerShell scripts located in the "C:\Users\Public" folder
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((process.executable="*\\powershell.exe" OR process.executable="*\\pwsh.exe") AND (process.command_line like "%-f C:\\Users\\Public%" OR process.command_line like "%-f \"C:\\Users\\Public%" OR process.command_line like "%-f %Public%%" OR process.command_line like "%-fi C:\\Users\\Public%" OR process.command_line like "%-fi \"C:\\Users\\Public%" OR process.command_line like "%-fi %Public%%" OR process.command_line like "%-fil C:\\Users\\Public%" OR process.command_line like "%-fil \"C:\\Users\\Public%" OR process.command_line like "%-fil %Public%%" OR process.command_line like "%-file C:\\Users\\Public%" OR process.command_line like "%-file \"C:\\Users\\Public%" OR process.command_line like "%-file %Public%%"))
