// Title: Shell Execution GCC  - Linux
// ID: 9b5de532-a757-4d70-946c-1f3e44f48b4d
// Status: test
// Level: high
// Author: Li Ling, Andy Parkidomo, Robert Rakowski, Blake Hartstein (Bloomberg L.P.)
// Date: 2024-09-02
// Tags: attack.discovery, attack.t1083
// Description: Detects the use of the "gcc" utility to execute a shell. Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%/bin/bash,-s%" OR process.command_line like "%/bin/dash,-s%" OR process.command_line like "%/bin/fish,-s%" OR process.command_line like "%/bin/sh,-s%" OR process.command_line like "%/bin/zsh,-s%")) AND ((process.executable="*/c89" OR process.executable="*/c99" OR process.executable="*/gcc") AND process.command_line like "%-wrapper%"))
