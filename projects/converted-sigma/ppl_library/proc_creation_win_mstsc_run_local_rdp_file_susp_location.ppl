// Title: Suspicious Mstsc.EXE Execution With Local RDP File
// ID: 6e22722b-dfb1-4508-a911-49ac840b40f8
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects potential RDP connection via Mstsc using a local ".rdp" file located in suspicious locations.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line="*.rdp" OR process.command_line="*.rdp\"")) AND ((process.executable="*\\mstsc.exe") OR (process.pe.original_file_name = "mstsc.exe")) AND ((process.command_line like "%:\\Users\\Public\\%" OR process.command_line like "%:\\Windows\\System32\\spool\\drivers\\color%" OR process.command_line like "%:\\Windows\\System32\\Tasks_Migrated %" OR process.command_line like "%:\\Windows\\Tasks\\%" OR process.command_line like "%:\\Windows\\Temp\\%" OR process.command_line like "%:\\Windows\\Tracing\\%" OR process.command_line like "%\\AppData\\Local\\Temp\\%" OR process.command_line like "%\\Downloads\\%")))
