// Title: PowerShell Script Run in AppData
// ID: ac175779-025a-4f12-98b0-acdaeb77ea85
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), Jonhnathan Ribeiro, oscd.community
// Date: 2019-01-09
// Tags: attack.execution, attack.t1059.001
// Description: Detects a suspicious command line execution that invokes PowerShell with reference to an AppData folder
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.command_line like "%powershell.exe%" OR process.command_line like "%\\powershell%" OR process.command_line like "%\\pwsh%" OR process.command_line like "%pwsh.exe%")) AND ((process.command_line like "%/c %" AND process.command_line like "%\\AppData\\%") AND (process.command_line like "%Local\\%" OR process.command_line like "%Roaming\\%")))
