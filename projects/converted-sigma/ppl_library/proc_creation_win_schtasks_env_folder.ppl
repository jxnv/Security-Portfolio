// Title: Schedule Task Creation From Env Variable Or Potentially Suspicious Path Via Schtasks.EXE
// ID: 81325ce1-be01-4250-944f-b4789644556f
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-21
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects Schtask creations that point to a suspicious folder or an environment variable often used by malware
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((((process.command_line like "%:\\Perflogs%" OR process.command_line like "%:\\Users\\All Users\\%" OR process.command_line like "%:\\Users\\Default\\%" OR process.command_line like "%:\\Users\\Public%" OR process.command_line like "%:\\Windows\\Temp%" OR process.command_line like "%\\AppData\\Local\\%" OR process.command_line like "%\\AppData\\Roaming\\%" OR process.command_line like "%%AppData%%" OR process.command_line like "%%Public%%")) AND (process.executable="*\\schtasks.exe" AND process.command_line like "% /create %")) OR ((process.parent.command_line="*\\svchost.exe -k netsvcs -p -s Schedule") AND ((process.command_line like "%:\\Perflogs%" OR process.command_line like "%:\\Windows\\Temp%" OR process.command_line like "%\\Users\\Public%" OR process.command_line like "%%Public%%")))) AND NOT ((((process.command_line like "%/Create /Xml %" AND process.command_line like "%\\Temp\\.CR.%" AND process.command_line like "%\\Avira_Security_Installation.xml%")) OR ((process.command_line like "%/Create /F /TN%" AND process.command_line like "%/Xml %" AND process.command_line like "%\\Temp\\%" AND process.command_line like "%Avira_%") AND (process.command_line like "%.tmp\\UpdateFallbackTask.xml%" OR process.command_line like "%.tmp\\WatchdogServiceControlManagerTimeout.xml%" OR process.command_line like "%.tmp\\SystrayAutostart.xml%" OR process.command_line like "%.tmp\\MaintenanceTask.xml%")) OR ((process.command_line like "%\\Temp\\%" AND process.command_line like "%/Create /TN \"klcp_update\" /XML %" AND process.command_line like "%\\klcp_update_task.xml%")) OR ((process.parent.command_line like "%unattended.ini%") OR (process.command_line like "%update_task.xml%")) OR (process.command_line like "%/Create /TN TVInstallRestore /TR%"))))
