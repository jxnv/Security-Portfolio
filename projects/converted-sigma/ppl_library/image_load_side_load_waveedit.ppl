// Title: Potential Waveedit.DLL Sideloading
// ID: 71b31e99-9ad0-47d4-aeb5-c0ca3928eeeb
// Status: test
// Level: high
// Author: X__Junior (Nextron Systems)
// Date: 2023-06-14
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of "waveedit.dll", which is part of the Nero WaveEditor audio editing software.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((ImageLoaded="*\\waveedit.dll") AND NOT (((process.executable = "C:\\Program Files (x86)\\Nero\\Nero Apps\\Nero WaveEditor\\waveedit.exe" OR process.executable = "C:\\Program Files\\Nero\\Nero Apps\\Nero WaveEditor\\waveedit.exe") AND (ImageLoaded="C:\\Program Files (x86)\\Nero\\Nero Apps\\Nero WaveEditor\\*" OR ImageLoaded="C:\\Program Files\\Nero\\Nero Apps\\Nero WaveEditor\\*"))))
