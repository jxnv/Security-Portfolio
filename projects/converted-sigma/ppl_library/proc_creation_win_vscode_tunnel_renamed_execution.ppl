// Title: Renamed Visual Studio Code Tunnel Execution
// ID: 2cf29f11-e356-4f61-98c0-1bdb9393d6da
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-09-28
// Tags: attack.command-and-control, attack.t1071.001, attack.t1219
// Description: Detects renamed Visual Studio Code tunnel execution. Attackers can abuse this functionality to establish a C2 channel
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((NOT process.pe.original_file_name=* AND process.command_line="*.exe tunnel") OR ((process.command_line like "%.exe tunnel%" AND process.command_line like "%--accept-server-license-terms%")) OR ((process.command_line like "%tunnel %" AND process.command_line like "%service%" AND process.command_line like "%internal-run%" AND process.command_line like "%tunnel-service.log%"))) AND NOT (((process.executable="*\\code-tunnel.exe" OR process.executable="*\\code.exe")))) OR ((process.parent.command_line="* tunnel" AND process.executable="*\\cmd.exe" AND (process.command_line like "%/d /c %" AND process.command_line like "%\\servers\\Stable-%" AND process.command_line like "%code-server.cmd%")) AND NOT (((process.parent.executable="*\\code-tunnel.exe" OR process.parent.executable="*\\code.exe")))))
