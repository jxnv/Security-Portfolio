// Title: Rundll32 Execution With Uncommon DLL Extension
// ID: c3a99af4-35a9-4668-879e-c09aeb4f2bdf
// Status: test
// Level: medium
// Author: Tim Shelton, Florian Roth (Nextron Systems), Yassine Oukessou
// Date: 2022-01-13
// Tags: attack.stealth, attack.t1218.011
// Description: Detects the execution of rundll32 with a command line that doesn't contain a common extension
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.executable="*\\rundll32.exe") OR (process.pe.original_file_name = "RUNDLL32.EXE")) AND NOT (((process.command_line = "") OR (((process.command_line like "%.cpl %" OR process.command_line like "%.cpl,%" OR process.command_line like "%.cpl\"%" OR process.command_line like "%.cpl'%" OR process.command_line like "%.dll %" OR process.command_line like "%.dll,%" OR process.command_line like "%.dll\"%" OR process.command_line like "%.dll'%" OR process.command_line like "%.inf %" OR process.command_line like "%.inf,%" OR process.command_line like "%.inf\"%" OR process.command_line like "%.inf'%")) OR ((process.command_line="*.cpl" OR process.command_line="*.dll" OR process.command_line="*.inf"))) OR (process.command_line like "% -localserver %") OR (NOT process.command_line=*) OR (process.parent.executable="*\\msiexec.exe" AND (process.command_line like "%:\\Windows\\Installer\\%" AND process.command_line like "%.tmp%" AND process.command_line like "%zzzzInvokeManagedCustomActionOutOfProc%")))) AND NOT (((process.parent.command_line like "%:\\Users\\%" AND process.parent.command_line like "%\\AppData\\Local\\Microsoft\\EdgeUpdate\\Install\\{%" AND process.parent.command_line like "%\\EDGEMITMP_%" AND process.parent.command_line like "%.tmp\\setup.exe%" AND process.parent.command_line like "%--install-archive=%" AND process.parent.command_line like "%--previous-version=%" AND process.parent.command_line like "%--msedgewebview --verbose-logging --do-not-launch-msedge --user-level%"))))
