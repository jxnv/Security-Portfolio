// Title: Hack Tool User Agent
// ID: c42a3073-30fb-48ae-8c99-c23ada84b103
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2017-07-08
// Tags: attack.initial-access, attack.t1190, attack.credential-access, attack.t1110
// Description: Detects suspicious user agent strings user by hack tools in proxy logs
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((c-useragent like "%(hydra)%" OR c-useragent like "% arachni/%" OR c-useragent like "% BFAC %" OR c-useragent like "% brutus %" OR c-useragent like "% cgichk %" OR c-useragent like "%core-project/1.0%" OR c-useragent like "% crimscanner/%" OR c-useragent like "%datacha0s%" OR c-useragent like "%dirbuster%" OR c-useragent like "%domino hunter%" OR c-useragent like "%dotdotpwn%" OR c-useragent like "%FHScan Core%" OR c-useragent like "%floodgate%" OR c-useragent like "%get-minimal%" OR c-useragent like "%gootkit auto-rooter scanner%" OR c-useragent like "%grendel-scan%" OR c-useragent like "% inspath %" OR c-useragent like "%internet ninja%" OR c-useragent like "%jaascois%" OR c-useragent like "% zmeu %" OR c-useragent like "%masscan%" OR c-useragent like "% metis %" OR c-useragent like "%morfeus fucking scanner%" OR c-useragent like "%n-stealth%" OR c-useragent like "%nsauditor%" OR c-useragent like "%pmafind%" OR c-useragent like "%security scan%" OR c-useragent like "%springenwerk%" OR c-useragent like "%teh forest lobster%" OR c-useragent like "%toata dragostea%" OR c-useragent like "% vega/%" OR c-useragent like "%voideye%" OR c-useragent like "%webshag%" OR c-useragent like "%webvulnscan%" OR c-useragent like "% whcc/%" OR c-useragent like "% Havij%" OR c-useragent like "%absinthe%" OR c-useragent like "%bsqlbf%" OR c-useragent like "%mysqloit%" OR c-useragent like "%pangolin%" OR c-useragent like "%sql power injector%" OR c-useragent like "%sqlmap%" OR c-useragent like "%sqlninja%" OR c-useragent like "%uil2pn%" OR c-useragent like "%ruler%" OR c-useragent like "%Mozilla/5.0 (Windows; U; Windows NT 5.1; pt-PT; rv:1.9.1.2) Gecko/20090729 Firefox/3.5.2 (.NET CLR 3.5.30729)%"))
