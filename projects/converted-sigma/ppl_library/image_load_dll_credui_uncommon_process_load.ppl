// Title: CredUI.DLL Loaded By Uncommon Process
// ID: 9ae01559-cf7e-4f8e-8e14-4c290a1b4784
// Status: test
// Level: medium
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2020-10-20
// Tags: attack.credential-access, attack.collection, attack.t1056.002
// Description: Detects loading of "credui.dll" and related DLLs by an uncommon process. Attackers might leverage this DLL for potential use of "CredUIPromptForCredentials" or "CredUnPackAuthenticationBufferW".
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((ImageLoaded="*\\credui.dll" OR ImageLoaded="*\\wincredui.dll")) OR ((process.pe.original_file_name = "credui.dll" OR process.pe.original_file_name = "wincredui.dll"))) AND NOT ((((process.executable = "C:\\Windows\\explorer.exe" OR process.executable = "C:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe" OR process.executable = "C:\\Windows\\regedit.exe")) OR ((process.executable="C:\\Program Files (x86)\\*" OR process.executable="C:\\Program Files\\*" OR process.executable="C:\\Windows\\System32\\*" OR process.executable="C:\\Windows\\SysWOW64\\*" OR process.executable="C:\\Windows\\SystemApps\\*")))) AND NOT (((process.executable="C:\\Users\\*" AND process.executable like "%\\AppData\\Local\\Microsoft\\OneDrive\\%") OR (process.executable="*\\opera_autoupdate.exe") OR ((process.executable="*\\procexp64.exe" OR process.executable="*\\procexp64a.exe" OR process.executable="*\\procexp.exe")) OR (process.executable="C:\\Users\\*" AND process.executable like "%\\AppData\\Local\\Microsoft\\Teams\\%" AND process.executable="*\\Teams.exe"))))
