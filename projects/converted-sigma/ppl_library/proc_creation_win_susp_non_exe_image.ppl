// Title: Execution of Suspicious File Type Extension
// ID: c09dad97-1c78-4f71-b127-7edb2b8e491a
// Status: test
// Level: medium
// Author: Max Altgelt (Nextron Systems)
// Date: 2021-12-09
// Tags: attack.stealth
// Description: Detects whether the image specified in a process creation event doesn't refer to an ".exe" (or other known executable extension) file. This can be caused by process ghosting or other unorthodox methods to start a process.
// This rule might require some initial baselining to align with some third party tooling in the user environment.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (NOT (((process.executable="*.bin" OR process.executable="*.cgi" OR process.executable="*.com" OR process.executable="*.exe" OR process.executable="*.scr" OR process.executable="*.tmp"))) AND NOT (((process.executable like "%:\\$Extend\\$Deleted\\%") OR (process.executable like "%:\\Windows\\System32\\DriverStore\\FileRepository\\%") OR ((process.executable = "-" OR process.executable = "")) OR ((process.executable = "System" OR process.executable = "Registry" OR process.executable = "MemCompression" OR process.executable = "vmmem")) OR (process.executable like "%:\\Windows\\Installer\\MSI%") OR (process.executable like "%:\\Config.Msi\\%" AND (process.executable="*.rbf" OR process.executable="*.rbs")) OR (NOT process.executable=*) OR ((process.parent.executable like "%:\\Windows\\Temp\\%") OR (process.executable like "%:\\Windows\\Temp\\%")))) AND NOT (((process.parent.executable like "%:\\ProgramData\\Avira\\%") OR (process.parent.executable = "C:\\Windows\\System32\\services.exe" AND process.executable="*com.docker.service") OR (process.executable like "%:\\Program Files\\Mozilla Firefox\\%") OR (process.executable="*\\LZMA_EXE") OR ((process.executable="*:\\Program Files (x86)\\MyQ\\Server\\pcltool.dll" OR process.executable="*:\\Program Files\\MyQ\\Server\\pcltool.dll")) OR (process.executable like "%NVIDIA\\NvBackend\\%" AND process.executable="*.dat") OR ((process.executable like "%:\\Program Files (x86)\\WINPAKPRO\\%" OR process.executable like "%:\\Program Files\\WINPAKPRO\\%") AND process.executable="*.ngn") OR ((process.executable like "%\\AppData\\Local\\Packages\\%" AND process.executable like "%\\LocalState\\rootfs\\%")))))
