// Title: HackTool - CrackMapExec Execution
// ID: 42a993dd-bb3e-48c8-b372-4d6684c4106c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-25
// Tags: attack.execution, attack.persistence, attack.privilege-escalation, attack.credential-access, attack.discovery, attack.t1047, attack.t1053, attack.t1059.003, attack.t1059.001, attack.t1110, attack.t1201
// Description: This rule detect common flag combinations used by CrackMapExec in order to detect its use even if the binary has been replaced.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (((process.executable="*\\crackmapexec.exe") OR ((process.command_line like "% --local-auth%" AND process.command_line like "% -u %" AND process.command_line like "% -x %")) OR ((process.command_line like "% --local-auth%" AND process.command_line like "% -u %" AND process.command_line like "% -p %" AND process.command_line like "% -H 'NTHASH'%")) OR ((process.command_line like "% mssql %" AND process.command_line like "% -u %" AND process.command_line like "% -p %" AND process.command_line like "% -M %" AND process.command_line like "% -d %")) OR ((process.command_line like "% smb %" AND process.command_line like "% -u %" AND process.command_line like "% -H %" AND process.command_line like "% -M %" AND process.command_line like "% -o %")) OR ((process.command_line like "% smb %" AND process.command_line like "% -u %" AND process.command_line like "% -p %" AND process.command_line like "% --local-auth%")) OR (process.command_line like "% -M pe_inject %")) OR (((process.command_line like "% --local-auth%" AND process.command_line like "% -u %" AND process.command_line like "% -p %")) AND ((process.command_line like "% 10.%" AND process.command_line like "% 192.168.%" AND process.command_line like "%/24 %"))))
