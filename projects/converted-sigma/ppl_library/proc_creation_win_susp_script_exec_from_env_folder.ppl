// Title: Script Interpreter Execution From Suspicious Folder
// ID: 1228c958-e64e-4e71-92ad-7d429f4138ba
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-02-08
// Tags: attack.execution, attack.t1059
// Description: Detects suspicious script execution from suspicious directories or folders accessible by environment variables that may indicate malware activity.
// Script interpreters (cscript, wscript, mshta, powershell) executing from folders like Temp, Public, or user profile directories may suggest attempts to evade detection or execute malicious scripts.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.command_line like "% -ep bypass %" OR process.command_line like "% -ExecutionPolicy bypass %" OR process.command_line like "% -w hidden %" OR process.command_line like "%/e:javascript %" OR process.command_line like "%/e:Jscript %" OR process.command_line like "%/e:vbscript %")) OR ((process.executable="*\\cscript.exe" OR process.executable="*\\mshta.exe" OR process.executable="*\\wscript.exe")) OR ((process.pe.original_file_name = "cscript.exe" OR process.pe.original_file_name = "mshta.exe" OR process.pe.original_file_name = "wscript.exe"))) AND (((process.command_line like "%:\\Perflogs\\%" OR process.command_line like "%:\\Users\\Public\\%" OR process.command_line like "%\\%Public%%" OR process.command_line like "%\\AppData\\Local\\Temp%" OR process.command_line like "%\\AppData\\Roaming\\Temp%" OR process.command_line like "%\\Temporary Internet%" OR process.command_line like "%\\Windows\\Temp%" OR process.command_line like "%\\Start Menu\\Programs\\Startup\\%" OR process.command_line like "%%TEMP%%" OR process.command_line like "%%TMP%%" OR process.command_line like "%%LocalAppData%\\Temp%")) OR (((process.command_line like "%:\\Users\\%" AND process.command_line like "%\\Favorites\\%")) OR ((process.command_line like "%:\\Users\\%" AND process.command_line like "%\\Favourites\\%")) OR ((process.command_line like "%:\\Users\\%" AND process.command_line like "%\\Contacts\\%")) OR ((process.command_line like "%:\\Users\\%" AND process.command_line like "%\\Documents\\%")) OR ((process.command_line like "%:\\Users\\%" AND process.command_line like "%\\Music\\%")) OR ((process.command_line like "%:\\Users\\%" AND process.command_line like "%\\Pictures\\%")) OR ((process.command_line like "%:\\Users\\%" AND process.command_line like "%\\Videos\\%")))) AND NOT (((process.parent.executable = "C:\\Windows\\System32\\Msiexec.exe" OR process.parent.executable = "C:\\Windows\\SysWOW64\\Msiexec.exe") AND process.executable="*\\powershell.exe" AND (process.command_line like "%-NoProfile -ExecutionPolicy Bypass -Command%" AND process.command_line like "%AppData\\Local\\Temp\\%" AND process.command_line like "%Install-Chocolatey.ps1%"))))
