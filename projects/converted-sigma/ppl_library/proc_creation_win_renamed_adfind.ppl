// Title: Renamed AdFind Execution
// ID: df55196f-f105-44d3-a675-e9dfb6cc2f2b
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-08-21
// Tags: attack.discovery, attack.t1018, attack.t1087.002, attack.t1482, attack.t1069.002
// Description: Detects the use of a renamed Adfind.exe. AdFind continues to be seen across majority of breaches. It is used to domain trust discovery to plan out subsequent steps in the attack chain.
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((((process.command_line like "%domainlist%" OR process.command_line like "%trustdmp%" OR process.command_line like "%dcmodes%" OR process.command_line like "%adinfo%" OR process.command_line like "% dclist %" OR process.command_line like "%computer_pwdnotreqd%" OR process.command_line like "%objectcategory=%" OR process.command_line like "%-subnets -f%" OR process.command_line like "%name=\"Domain Admins\"%" OR process.command_line like "%-sc u:%" OR process.command_line like "%domainncs%" OR process.command_line like "%dompol%" OR process.command_line like "% oudmp %" OR process.command_line like "%subnetdmp%" OR process.command_line like "%gpodmp%" OR process.command_line like "%fspdmp%" OR process.command_line like "%users_noexpire%" OR process.command_line like "%computers_active%" OR process.command_line like "%computers_pwdnotreqd%")) OR ((Hashes like "%IMPHASH=BCA5675746D13A1F246E2DA3C2217492%" OR Hashes like "%IMPHASH=53E117A96057EAF19C41380D0E87F1C2%" OR Hashes like "%IMPHASH=d144de8117df2beceaba2201ad304764%" OR Hashes like "%IMPHASH=12ce1c0f3f5837ecc18a3782408fa975%" OR Hashes like "%IMPHASH=4fbf3f084fbbb2470b80b2013134df35%" OR Hashes like "%IMPHASH=49b639b4acbecc49d72a01f357aa4930%" OR Hashes like "%IMPHASH=680dad9e300346e05a85023965867201%" OR Hashes like "%IMPHASH=21aa085d54992511b9f115355e468782%")) OR (process.pe.original_file_name = "AdFind.exe")) AND NOT ((process.executable="*\\AdFind.exe")))
