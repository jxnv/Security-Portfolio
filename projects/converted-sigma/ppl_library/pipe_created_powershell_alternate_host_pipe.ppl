// Title: Alternate PowerShell Hosts Pipe
// ID: 58cb02d5-78ce-4692-b3e1-dce850aae41a
// Status: test
// Level: medium
// Author: Roberto Rodriguez @Cyb3rWard0g, Tim Shelton
// Date: 2019-09-12
// Tags: attack.execution, attack.t1059.001
// Description: Detects alternate PowerShell hosts potentially bypassing detections looking for powershell.exe
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where ((PipeName="\\PSHost*") AND NOT (((((process.executable like "%:\\Program Files\\PowerShell\\7-preview\\pwsh.exe%" OR process.executable like "%:\\Program Files\\PowerShell\\7\\pwsh.exe%" OR process.executable like "%:\\Windows\\system32\\dsac.exe%" OR process.executable like "%:\\Windows\\system32\\inetsrv\\w3wp.exe%" OR process.executable like "%:\\Windows\\System32\\sdiagnhost.exe%" OR process.executable like "%:\\Windows\\system32\\ServerManager.exe%" OR process.executable like "%:\\Windows\\system32\\wbem\\wmiprvse.exe%" OR process.executable like "%:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe%" OR process.executable like "%:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe%" OR process.executable like "%:\\Windows\\System32\\wsmprovhost.exe%" OR process.executable like "%:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe%" OR process.executable like "%:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe%")) OR ((process.executable like "%C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview%" AND process.executable like "%\\pwsh.exe%")) OR ((process.executable like "%\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview%" AND process.executable like "%\\pwsh.exe%"))) OR (NOT process.executable=*))) AND NOT (((process.executable="C:\\Program Files\\AzureConnectedMachineAgent\\GCArcService*" AND process.executable="*\\GC\\gc_worker.exe") OR (process.executable="C:\\Program Files\\Citrix\\*") OR (process.executable="C:\\Program Files\\Microsoft\\Exchange Server\\*") OR ((process.executable="C:\\Program Files (x86)\\*" OR process.executable="C:\\Program Files\\*") AND process.executable like "%\\Microsoft SQL Server\\%" AND process.executable="*\\Tools\\Binn\\SQLPS.exe"))))
