// Title: Unusual Parent Process For Cmd.EXE
// ID: 4b991083-3d0e-44ce-8fc4-b254025d8d4b
// Status: test
// Level: medium
// Author: Tim Rauch, Elastic (idea)
// Date: 2022-09-21
// Tags: attack.execution, attack.t1059
// Description: Detects suspicious parent process for cmd.exe
// Converted by: Sigma Universal SIEM/EDR CLI

source = logs-* | where (process.executable="*\\cmd.exe" AND (process.parent.executable="*\\csrss.exe" OR process.parent.executable="*\\ctfmon.exe" OR process.parent.executable="*\\dllhost.exe" OR process.parent.executable="*\\epad.exe" OR process.parent.executable="*\\FlashPlayerUpdateService.exe" OR process.parent.executable="*\\GoogleUpdate.exe" OR process.parent.executable="*\\jucheck.exe" OR process.parent.executable="*\\jusched.exe" OR process.parent.executable="*\\LogonUI.exe" OR process.parent.executable="*\\lsass.exe" OR process.parent.executable="*\\regsvr32.exe" OR process.parent.executable="*\\SearchIndexer.exe" OR process.parent.executable="*\\SearchProtocolHost.exe" OR process.parent.executable="*\\SIHClient.exe" OR process.parent.executable="*\\sihost.exe" OR process.parent.executable="*\\slui.exe" OR process.parent.executable="*\\spoolsv.exe" OR process.parent.executable="*\\sppsvc.exe" OR process.parent.executable="*\\taskhostw.exe" OR process.parent.executable="*\\unsecapp.exe" OR process.parent.executable="*\\WerFault.exe" OR process.parent.executable="*\\wermgr.exe" OR process.parent.executable="*\\wlanext.exe" OR process.parent.executable="*\\WUDFHost.exe"))
