// Description: Windows DCE-RPC functions which indicate a persistence techniques on the remote system. All credit for the Zeek mapping of the suspicious endpoint/operation field goes to MITRE.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(endpoint = "spoolss") AND where(operation = "RpcAddMonitor")) OR (where(endpoint = "spoolss") AND where(operation = "RpcAddPrintProcessor")) OR (where(endpoint = "IRemoteWinspool") AND where(operation = "RpcAsyncAddMonitor")) OR (where(endpoint = "IRemoteWinspool") AND where(operation = "RpcAsyncAddPrintProcessor")) OR (where(endpoint = "ISecLogon") AND where(operation = "SeclCreateProcessWithLogonW")) OR (where(endpoint = "ISecLogon") AND where(operation = "SeclCreateProcessWithLogonExW")))
