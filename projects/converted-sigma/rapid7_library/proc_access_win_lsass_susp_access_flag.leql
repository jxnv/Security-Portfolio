// Title: Potentially Suspicious GrantedAccess Flags On LSASS
// ID: a18dd26b-6450-46de-8c91-9659150cf088
// Status: test
// Level: medium
// Author: Florian Roth, Roberto Rodriguez, Dimitrios Slamaris, Mark Russinovich, Thomas Patzke, Teymur Kheirkhabarov, Sherif Eldeeb, James Dickenson, Aleksey Potapov, oscd.community
// Date: 2021-11-22
// Tags: attack.credential-access, attack.t1003.001, attack.s0002
// Description: Detects process access requests to LSASS process with potentially suspicious access flags
// Converted by: Sigma Universal SIEM/EDR CLI

(((((where(GrantedAccess IENDSWITH "30") OR where(GrantedAccess IENDSWITH "50") OR where(GrantedAccess IENDSWITH "70") OR where(GrantedAccess IENDSWITH "90") OR where(GrantedAccess IENDSWITH "B0") OR where(GrantedAccess IENDSWITH "D0") OR where(GrantedAccess IENDSWITH "F0") OR where(GrantedAccess IENDSWITH "18") OR where(GrantedAccess IENDSWITH "38") OR where(GrantedAccess IENDSWITH "58") OR where(GrantedAccess IENDSWITH "78") OR where(GrantedAccess IENDSWITH "98") OR where(GrantedAccess IENDSWITH "B8") OR where(GrantedAccess IENDSWITH "D8") OR where(GrantedAccess IENDSWITH "F8") OR where(GrantedAccess IENDSWITH "1A") OR where(GrantedAccess IENDSWITH "3A") OR where(GrantedAccess IENDSWITH "5A") OR where(GrantedAccess IENDSWITH "7A") OR where(GrantedAccess IENDSWITH "9A") OR where(GrantedAccess IENDSWITH "BA") OR where(GrantedAccess IENDSWITH "DA") OR where(GrantedAccess IENDSWITH "FA") OR where(GrantedAccess IENDSWITH "0x14C2"))) OR ((where(GrantedAccess ISTARTSWITH "0x100000") OR where(GrantedAccess ISTARTSWITH "0x1418") OR where(GrantedAccess ISTARTSWITH "0x1438") OR where(GrantedAccess ISTARTSWITH "0x143a") OR where(GrantedAccess ISTARTSWITH "0x1f0fff") OR where(GrantedAccess ISTARTSWITH "0x1f1fff") OR where(GrantedAccess ISTARTSWITH "0x1f2fff") OR where(GrantedAccess ISTARTSWITH "0x1f3fff") OR where(GrantedAccess ISTARTSWITH "0x40")))) AND (where(TargetImage IENDSWITH "\\lsass.exe"))) AND NOT (((where(SourceImage IENDSWITH "\\explorer.exe") AND where(GrantedAccess = "0x401")) OR ((where(SourceImage ICONTAINS ":\\Program Files (x86)\\") OR where(SourceImage ICONTAINS ":\\Program Files\\") OR where(SourceImage ICONTAINS ":\\Windows\\System32\\") OR where(SourceImage ICONTAINS ":\\Windows\\SysWOW64\\"))) OR (where(SourceImage ICONTAINS ":\\ProgramData\\Microsoft\\Windows Defender\\") AND where(SourceImage IENDSWITH "\\MsMpEng.exe")) OR ((where(CallTrace ICONTAINS "|?:\\ProgramData\\Microsoft\\Windows Defender\\Definition Updates\\{") AND where(CallTrace ICONTAINS "}\\mpengine.dll+")) AND where(GrantedAccess = "0x1418")) OR ((where(CallTrace ICONTAINS "|c:\\program files\\windows defender\\mprtp.dll") OR where(CallTrace ICONTAINS "|c:\\program files\\windows defender\\MpClient.dll"))))) AND NOT (((where(SourceImage IENDSWITH ":\\ProgramData\\MALWAREBYTES\\MBAMSERVICE\\ctlrupdate\\mbupdatr.exe")) OR (where(SourceImage IENDSWITH "\\MBAMInstallerService.exe") AND where(GrantedAccess = "0x40")) OR ((where(SourceImage IENDSWITH "\\aurora-agent-64.exe") OR where(SourceImage IENDSWITH "\\aurora-agent.exe") OR where(SourceImage IENDSWITH "\\thor.exe") OR where(SourceImage IENDSWITH "\\thor64.exe")) AND where(GrantedAccess = "0x40")) OR (where(SourceImage ICONTAINS "\\SteamLibrary\\steamapps\\")) OR ((where(SourceImage IENDSWITH "\\handle.exe") OR where(SourceImage IENDSWITH "\\handle64.exe") OR where(SourceImage IENDSWITH "\\handle64a.exe")) AND where(GrantedAccess = "0x40")) OR ((where(SourceImage IENDSWITH "\\PROCEXP64.EXE") OR where(SourceImage IENDSWITH "\\PROCEXP.EXE")) AND where(GrantedAccess = "0x40")) OR (where(SourceImage ICONTAINS ":\\ProgramData\\VMware\\VMware Tools\\") AND where(SourceImage IENDSWITH "\\vmtoolsd.exe")) OR (where(SourceImage IENDSWITH "\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe")) OR (where(SourceImage IENDSWITH "\\AppData\\Local\\WebEx\\WebexHost.exe") AND where(GrantedAccess = "0x401")))))
