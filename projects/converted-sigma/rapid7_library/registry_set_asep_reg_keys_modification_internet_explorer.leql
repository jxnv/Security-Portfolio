// Title: Internet Explorer Autorun Keys Modification
// ID: a80f662f-022f-4429-9b8c-b1a41aaa6688
// Status: test
// Level: medium
// Author: Victor Sergeev, Daniil Yugoslavskiy, Gleb Sukhodolskiy, Timur Zinniatullin, oscd.community, Tim Shelton, frack113 (split)
// Date: 2019-10-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects modification of autostart extensibility point (ASEP) in registry.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(TargetObject ICONTAINS "\\Software\\Wow6432Node\\Microsoft\\Internet Explorer") OR where(TargetObject ICONTAINS "\\Software\\Microsoft\\Internet Explorer"))) AND ((where(TargetObject ICONTAINS "\\Toolbar") OR where(TargetObject ICONTAINS "\\Extensions") OR where(TargetObject ICONTAINS "\\Explorer Bars"))) AND NOT (((where(Details = "(Empty)")) OR ((where(TargetObject ICONTAINS "\\Extensions\\{2670000A-7350-4f3c-8081-5663EE0C6C49}") OR where(TargetObject ICONTAINS "\\Extensions\\{31D09BA0-12F5-4CCE-BE8A-2923E76605DA}") OR where(TargetObject ICONTAINS "\\Extensions\\{789FE86F-6FC4-46A1-9849-EDE0DB0C95CA}") OR where(TargetObject ICONTAINS "\\Extensions\\{A95fe080-8f5d-11d2-a20b-00aa003c157a}"))) OR ((where(TargetObject IENDSWITH "\\Toolbar\\ShellBrowser\\ITBar7Layout") OR where(TargetObject IENDSWITH "\\Toolbar\\ShowDiscussionButton") OR where(TargetObject IENDSWITH "\\Toolbar\\Locked"))))))
