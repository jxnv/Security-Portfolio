// Title: Service Binary in Suspicious Folder
// ID: a07f0359-4c90-4dc4-a681-8ffea40b4f47
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), frack113
// Date: 2022-05-02
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detect the creation of a service with a service binary located in a suspicious directory
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(TargetObject ISTARTSWITH "HKLM\\System\\CurrentControlSet\\Services\\") AND where(TargetObject IENDSWITH "\\ImagePath") AND (where(Details ICONTAINS "\\Users\\Public\\") OR where(Details ICONTAINS "\\Perflogs\\") OR where(Details ICONTAINS "\\ADMIN$\\") OR where(Details ICONTAINS "\\Temp\\"))) OR (where(TargetObject ISTARTSWITH "HKLM\\System\\CurrentControlSet\\Services\\") AND where(TargetObject IENDSWITH "\\Start") AND (where(Image ICONTAINS "\\Users\\Public\\") OR where(Image ICONTAINS "\\Perflogs\\") OR where(Image ICONTAINS "\\ADMIN$\\") OR where(Image ICONTAINS "\\Temp\\")) AND (where(Details = "DWORD (0x00000000)") OR where(Details = "DWORD (0x00000001)") OR where(Details = "DWORD (0x00000002)")))) AND NOT ((((where(Image ICONTAINS "\\Common Files\\") AND where(Image ICONTAINS "\\Temp\\"))) OR (where(TargetObject IENDSWITH "\\CurrentControlSet\\Services\\MBAMInstallerService\\ImagePath") AND where(Details IENDSWITH "\\AppData\\Local\\Temp\\MBAMInstallerService.exe\"") AND where(Image = "C:\\Windows\\system32\\services.exe")))))
