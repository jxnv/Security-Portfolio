// Title: Potential Arbitrary File Download Using Office Application
// ID: 4ae3e30b-b03f-43aa-87e3-b622f4048eed
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Beyu Denis, oscd.community
// Date: 2022-05-17
// Tags: attack.stealth, attack.t1202
// Description: Detects potential arbitrary file download using a Microsoft Office application
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "http://") OR where(CommandLine ICONTAINS "https://"))) AND (((where(Image IENDSWITH "\\EXCEL.EXE") OR where(Image IENDSWITH "\\MSOXMLED.EXE") OR where(Image IENDSWITH "\\POWERPNT.EXE") OR where(Image IENDSWITH "\\WINWORD.exe"))) OR ((where(OriginalFileName = "Excel.exe") OR where(OriginalFileName = "msoxmled.exe") OR where(OriginalFileName = "POWERPNT.EXE") OR where(OriginalFileName = "WinWord.exe")))))
