// Title: Rare Remote Thread Creation By Uncommon Source Image
// ID: 02d1d718-dd13-41af-989d-ea85c7fab93f
// Status: test
// Level: high
// Author: Perez Diego (@darkquassar), oscd.community
// Date: 2019-10-27
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects uncommon processes creating remote threads.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(SourceImage IENDSWITH "\\bash.exe") OR where(SourceImage IENDSWITH "\\cscript.exe") OR where(SourceImage IENDSWITH "\\cvtres.exe") OR where(SourceImage IENDSWITH "\\defrag.exe") OR where(SourceImage IENDSWITH "\\dialer.exe") OR where(SourceImage IENDSWITH "\\dnx.exe") OR where(SourceImage IENDSWITH "\\esentutl.exe") OR where(SourceImage IENDSWITH "\\excel.exe") OR where(SourceImage IENDSWITH "\\expand.exe") OR where(SourceImage IENDSWITH "\\find.exe") OR where(SourceImage IENDSWITH "\\findstr.exe") OR where(SourceImage IENDSWITH "\\forfiles.exe") OR where(SourceImage IENDSWITH "\\gpupdate.exe") OR where(SourceImage IENDSWITH "\\hh.exe") OR where(SourceImage IENDSWITH "\\installutil.exe") OR where(SourceImage IENDSWITH "\\lync.exe") OR where(SourceImage IENDSWITH "\\makecab.exe") OR where(SourceImage IENDSWITH "\\mDNSResponder.exe") OR where(SourceImage IENDSWITH "\\monitoringhost.exe") OR where(SourceImage IENDSWITH "\\msbuild.exe") OR where(SourceImage IENDSWITH "\\mshta.exe") OR where(SourceImage IENDSWITH "\\mspaint.exe") OR where(SourceImage IENDSWITH "\\outlook.exe") OR where(SourceImage IENDSWITH "\\ping.exe") OR where(SourceImage IENDSWITH "\\provtool.exe") OR where(SourceImage IENDSWITH "\\python.exe") OR where(SourceImage IENDSWITH "\\regsvr32.exe") OR where(SourceImage IENDSWITH "\\robocopy.exe") OR where(SourceImage IENDSWITH "\\runonce.exe") OR where(SourceImage IENDSWITH "\\sapcimc.exe") OR where(SourceImage IENDSWITH "\\smartscreen.exe") OR where(SourceImage IENDSWITH "\\spoolsv.exe") OR where(SourceImage IENDSWITH "\\tstheme.exe") OR where(SourceImage IENDSWITH "\\userinit.exe") OR where(SourceImage IENDSWITH "\\vssadmin.exe") OR where(SourceImage IENDSWITH "\\vssvc.exe") OR where(SourceImage IENDSWITH "\\w3wp.exe") OR where(SourceImage IENDSWITH "\\winscp.exe") OR where(SourceImage IENDSWITH "\\winword.exe") OR where(SourceImage IENDSWITH "\\wmic.exe") OR where(SourceImage IENDSWITH "\\wscript.exe"))) AND NOT ((((where(SourceImage = "C:\\Windows\\System32\\Defrag.exe") OR where(SourceImage = "C:\\Windows\\System32\\makecab.exe")) AND where(TargetImage = "C:\\Windows\\System32\\conhost.exe")) OR ((where(SourceImage ISTARTSWITH "C:\\Program Files\\Microsoft Office\\") OR where(SourceImage ISTARTSWITH "C:\\Program Files (x86)\\Microsoft Office\\")) AND where(TargetImage = "System")) OR (where(SourceImage = "C:\\Windows\\System32\\provtool.exe") AND where(TargetImage = "C:\\Windows\\System32\\svchost.exe")) OR (where(SourceImage = "C:\\Windows\\System32\\provtool.exe") AND where(TargetImage = "System")) OR (where(SourceImage = "C:\\Windows\\System32\\userinit.exe") AND where(TargetImage = "C:\\Windows\\explorer.exe")) OR (where(SourceImage IENDSWITH "\\WINWORD.EXE") AND (where(TargetImage ISTARTSWITH "C:\\Program Files (x86)\\") OR where(TargetImage ISTARTSWITH "C:\\Program Files\\"))))) AND NOT ((where(SourceImage IENDSWITH "\\SysWOW64\\explorer.exe") AND (where(TargetImage = "C:\\Program Files (x86)\\VMware\\VMware Tools\\vmtoolsd.exe") OR where(TargetImage = "C:\\Program Files\\VMware\\VMware Tools\\vmtoolsd.exe")))))
