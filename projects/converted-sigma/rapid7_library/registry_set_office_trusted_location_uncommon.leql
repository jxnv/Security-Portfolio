// Title: Uncommon Microsoft Office Trusted Location Added
// ID: f742bde7-9528-42e5-bd82-84f51a8387d2
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-21
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects changes to registry keys related to "Trusted Location" of Microsoft Office where the path is set to something uncommon. Attackers might add additional trusted locations to avoid macro security restrictions.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(TargetObject ICONTAINS "Security\\Trusted Locations\\Location") AND where(TargetObject IENDSWITH "\\Path")) AND NOT ((((where(Image ICONTAINS ":\\Program Files\\Microsoft Office\\") OR where(Image ICONTAINS ":\\Program Files (x86)\\Microsoft Office\\"))) OR (where(Image ICONTAINS ":\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\") AND where(Image IENDSWITH "\\OfficeClickToRun.exe")))) AND NOT (((where(Details ICONTAINS "%APPDATA%\\Microsoft\\Templates") OR where(Details ICONTAINS "%%APPDATA%%\\Microsoft\\Templates") OR where(Details ICONTAINS "%APPDATA%\\Microsoft\\Word\\Startup") OR where(Details ICONTAINS "%%APPDATA%%\\Microsoft\\Word\\Startup") OR where(Details ICONTAINS ":\\Program Files (x86)\\Microsoft Office\\root\\Templates\\") OR where(Details ICONTAINS ":\\Program Files\\Microsoft Office (x86)\\Templates") OR where(Details ICONTAINS ":\\Program Files\\Microsoft Office\\root\\Templates\\") OR where(Details ICONTAINS ":\\Program Files\\Microsoft Office\\Templates\\")))))
