// Title: Potential Defense Evasion Via Rename Of Highly Relevant Binaries
// ID: 0ba1da6d-b6ce-4366-828c-18826c9de23e
// Status: test
// Level: high
// Author: Matthew Green - @mgreen27, Florian Roth (Nextron Systems), frack113
// Date: 2019-06-15
// Tags: attack.stealth, attack.t1036.003, car.2013-05-009
// Description: Detects the execution of a renamed binary often used by attackers or malware leveraging new Sysmon OriginalFileName datapoint.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Description = "Execute processes remotely")) OR (where(Product = "Sysinternals PsExec")) OR ((where(Description ISTARTSWITH "Windows PowerShell") OR where(Description ISTARTSWITH "pwsh"))) OR ((where(OriginalFileName = "certutil.exe") OR where(OriginalFileName = "cmstp.exe") OR where(OriginalFileName = "cscript.exe") OR where(OriginalFileName = "IE4UINIT.EXE") OR where(OriginalFileName = "finger.exe") OR where(OriginalFileName = "mshta.exe") OR where(OriginalFileName = "msiexec.exe") OR where(OriginalFileName = "msxsl.exe") OR where(OriginalFileName = "powershell_ise.exe") OR where(OriginalFileName = "powershell.exe") OR where(OriginalFileName = "psexec.c") OR where(OriginalFileName = "psexec.exe") OR where(OriginalFileName = "psexesvc.exe") OR where(OriginalFileName = "pwsh.dll") OR where(OriginalFileName = "reg.exe") OR where(OriginalFileName = "regsvr32.exe") OR where(OriginalFileName = "rundll32.exe") OR where(OriginalFileName = "WerMgr") OR where(OriginalFileName = "wmic.exe") OR where(OriginalFileName = "wscript.exe")))) AND NOT (((where(Image IENDSWITH "\\certutil.exe") OR where(Image IENDSWITH "\\cmstp.exe") OR where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\ie4uinit.exe") OR where(Image IENDSWITH "\\finger.exe") OR where(Image IENDSWITH "\\mshta.exe") OR where(Image IENDSWITH "\\msiexec.exe") OR where(Image IENDSWITH "\\msxsl.exe") OR where(Image IENDSWITH "\\powershell_ise.exe") OR where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\psexec.exe") OR where(Image IENDSWITH "\\psexec64.exe") OR where(Image IENDSWITH "\\psexec64a.exe") OR where(Image IENDSWITH "\\PSEXESVC.exe") OR where(Image IENDSWITH "\\pwsh.exe") OR where(Image IENDSWITH "\\reg.exe") OR where(Image IENDSWITH "\\regsvr32.exe") OR where(Image IENDSWITH "\\rundll32.exe") OR where(Image IENDSWITH "\\wermgr.exe") OR where(Image IENDSWITH "\\wmic.exe") OR where(Image IENDSWITH "\\wscript.exe")))))
