(((where(dst_port = "8080") OR where(dst_port = "21") OR where(dst_port = "80") OR where(dst_port = "23") OR where(dst_port = "50000") OR where(dst_port = "1521") OR where(dst_port = "27017") OR where(dst_port = "3306") OR where(dst_port = "1433") OR where(dst_port = "11211") OR where(dst_port = "15672") OR where(dst_port = "5900") OR where(dst_port = "5901") OR where(dst_port = "5902") OR where(dst_port = "5903") OR where(dst_port = "5904"))) AND (((where(action = "forward") OR where(action = "accept") OR where(action = "2"))) OR (where(blocked = "false"))))
