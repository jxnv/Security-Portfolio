// Title: MSI Installation From Suspicious Locations
// ID: c7c8aa1c-5aff-408e-828b-998e3620b341
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-31
// Tags: attack.execution
// Description: Detects MSI package installation from suspicious locations
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Provider_Name = "MsiInstaller") AND (where(EventID = "1040") OR where(EventID = "1042")) AND (where(Data ICONTAINS ":\\Windows\\TEMP\\") OR where(Data ICONTAINS "\\\\\\\\") OR where(Data ICONTAINS "\\Desktop\\") OR where(Data ICONTAINS "\\PerfLogs\\") OR where(Data ICONTAINS "\\Users\\Public\\"))) AND NOT (((where(Data ICONTAINS "C:\\Windows\\TEMP\\UpdHealthTools.msi")) OR (where(Data ICONTAINS "\\AppData\\Local\\Temp\\WinGet\\")))))
