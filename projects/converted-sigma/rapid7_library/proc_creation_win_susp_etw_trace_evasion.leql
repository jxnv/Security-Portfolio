// Title: ETW Trace Evasion Activity
// ID: a238b5d0-ce2d-4414-a676-7a531b3d13d6
// Status: test
// Level: high
// Author: @neu5ron, Florian Roth (Nextron Systems), Jonhnathan Ribeiro, oscd.community
// Date: 2019-03-22
// Tags: attack.stealth, attack.defense-impairment, attack.t1070, attack.t1685, car.2016-04-002
// Description: Detects command line activity that tries to clear or disable any ETW trace log which could be a sign of logging evasion.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "cl") AND where(CommandLine ICONTAINS "/Trace"))) OR ((where(CommandLine ICONTAINS "clear-log") AND where(CommandLine ICONTAINS "/Trace"))) OR ((where(CommandLine ICONTAINS "sl") AND where(CommandLine ICONTAINS "/e:false"))) OR ((where(CommandLine ICONTAINS "set-log") AND where(CommandLine ICONTAINS "/e:false"))) OR ((where(CommandLine ICONTAINS "logman") AND where(CommandLine ICONTAINS "update") AND where(CommandLine ICONTAINS "trace") AND where(CommandLine ICONTAINS "--p") AND where(CommandLine ICONTAINS "-ets"))) OR (where(CommandLine ICONTAINS "Remove-EtwTraceProvider")) OR ((where(CommandLine ICONTAINS "Set-EtwTraceProvider") AND where(CommandLine ICONTAINS "0x11"))))
