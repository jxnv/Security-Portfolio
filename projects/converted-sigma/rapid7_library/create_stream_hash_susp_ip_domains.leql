// Title: Unusual File Download from Direct IP Address
// ID: 025bd229-fd1f-4fdb-97ab-20006e1a5368
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Florian Roth (Nextron Systems)
// Date: 2022-09-07
// Tags: attack.stealth, attack.t1564.004
// Description: Detects the download of suspicious file type from URLs with IP
// Converted by: Sigma Universal SIEM/EDR CLI

(where(Contents /http[s]?://[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}/) AND (where(TargetFilename ICONTAINS ".ps1:Zone") OR where(TargetFilename ICONTAINS ".bat:Zone") OR where(TargetFilename ICONTAINS ".exe:Zone") OR where(TargetFilename ICONTAINS ".vbe:Zone") OR where(TargetFilename ICONTAINS ".vbs:Zone") OR where(TargetFilename ICONTAINS ".dll:Zone") OR where(TargetFilename ICONTAINS ".one:Zone") OR where(TargetFilename ICONTAINS ".cmd:Zone") OR where(TargetFilename ICONTAINS ".hta:Zone") OR where(TargetFilename ICONTAINS ".xll:Zone") OR where(TargetFilename ICONTAINS ".lnk:Zone")))
