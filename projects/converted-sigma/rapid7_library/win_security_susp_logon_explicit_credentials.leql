// Title: Suspicious Remote Logon with Explicit Credentials
// ID: 941e5c45-cda7-4864-8cea-bbb7458d194a
// Status: test
// Level: medium
// Author: oscd.community, Teymur Kheirkhabarov @HeirhabarovT, Zach Stanford @svch0st, Tim Shelton
// Date: 2020-10-05
// Tags: attack.privilege-escalation, attack.persistence, attack.initial-access, attack.stealth, attack.t1078, attack.lateral-movement
// Description: Detects suspicious processes logging on with explicit credentials
// Converted by: Sigma Universal SIEM/EDR CLI

((where(EventID = "4648") AND (where(ProcessName IENDSWITH "\\cmd.exe") OR where(ProcessName IENDSWITH "\\powershell.exe") OR where(ProcessName IENDSWITH "\\pwsh.exe") OR where(ProcessName IENDSWITH "\\winrs.exe") OR where(ProcessName IENDSWITH "\\wmic.exe") OR where(ProcessName IENDSWITH "\\net.exe") OR where(ProcessName IENDSWITH "\\net1.exe") OR where(ProcessName IENDSWITH "\\reg.exe"))) AND NOT (((where(TargetServerName = "localhost")) OR (where(SubjectUserName IENDSWITH "$") AND where(TargetUserName IENDSWITH "$")))))
