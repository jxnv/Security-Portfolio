// Title: PUA - Sysinternals Tools Execution - Registry
// ID: c7da8edc-49ae-45a2-9e61-9fd860e4e73d
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-24
// Tags: attack.resource-development, attack.t1588.002
// Description: Detects the execution of some potentially unwanted tools such as PsExec, Procdump, etc. (part of the Sysinternals suite) via the creation of the "accepteula" registry key.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(TargetObject ICONTAINS "\\Active Directory Explorer") OR where(TargetObject ICONTAINS "\\Handle") OR where(TargetObject ICONTAINS "\\LiveKd") OR where(TargetObject ICONTAINS "\\Process Explorer") OR where(TargetObject ICONTAINS "\\ProcDump") OR where(TargetObject ICONTAINS "\\PsExec") OR where(TargetObject ICONTAINS "\\PsLoglist") OR where(TargetObject ICONTAINS "\\PsPasswd") OR where(TargetObject ICONTAINS "\\SDelete") OR where(TargetObject ICONTAINS "\\Sysinternals")) AND where(TargetObject IENDSWITH "\\EulaAccepted"))
