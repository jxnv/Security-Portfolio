// Title: DriverQuery.EXE Execution
// ID: a20def93-0709-4eae-9bd2-31206e21e6b2
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-19
// Tags: attack.discovery
// Description: Detect usage of the "driverquery" utility. Which can be used to perform reconnaissance on installed drivers
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "driverquery.exe")) OR (where(OriginalFileName = "drvqry.exe"))) AND NOT ((((where(ParentImage IENDSWITH "\\cscript.exe") OR where(ParentImage IENDSWITH "\\mshta.exe") OR where(ParentImage IENDSWITH "\\regsvr32.exe") OR where(ParentImage IENDSWITH "\\rundll32.exe") OR where(ParentImage IENDSWITH "\\wscript.exe"))) OR ((where(ParentImage ICONTAINS "\\AppData\\Local\\") OR where(ParentImage ICONTAINS "\\Users\\Public\\") OR where(ParentImage ICONTAINS "\\Windows\\Temp\\"))))))
