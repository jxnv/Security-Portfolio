// Title: Suspicious SYSTEM User Process Creation
// ID: 2617e7ed-adb7-40ba-b0f3-8f9945fe6c09
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), David ANDRE (additional keywords)
// Date: 2021-12-20
// Tags: attack.credential-access, attack.privilege-escalation, attack.stealth, attack.t1134, attack.t1003, attack.t1027
// Description: Detects a suspicious process creation as SYSTEM user (suspicious program or command line parameter)
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(IntegrityLevel = "System") OR where(IntegrityLevel = "S-1-16-16384")) AND (where(User ICONTAINS "AUTHORI") OR where(User ICONTAINS "AUTORI"))) AND (((where(Image IENDSWITH "\\calc.exe") OR where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\forfiles.exe") OR where(Image IENDSWITH "\\hh.exe") OR where(Image IENDSWITH "\\mshta.exe") OR where(Image IENDSWITH "\\ping.exe") OR where(Image IENDSWITH "\\wscript.exe"))) OR (where(CommandLine /net\s+user\s+/)) OR ((where(CommandLine ICONTAINS " -NoP ") OR where(CommandLine ICONTAINS " -W Hidden ") OR where(CommandLine ICONTAINS " -decode ") OR where(CommandLine ICONTAINS " /decode ") OR where(CommandLine ICONTAINS " /urlcache ") OR where(CommandLine ICONTAINS " -urlcache ") OR where(CommandLine ICONTAINS " -e* JAB") OR where(CommandLine ICONTAINS " -e* SUVYI") OR where(CommandLine ICONTAINS " -e* SQBFAFgA") OR where(CommandLine ICONTAINS " -e* aWV4I") OR where(CommandLine ICONTAINS " -e* IAB") OR where(CommandLine ICONTAINS " -e* PAA") OR where(CommandLine ICONTAINS " -e* aQBlAHgA") OR where(CommandLine ICONTAINS "vssadmin delete shadows") OR where(CommandLine ICONTAINS "reg SAVE HKLM") OR where(CommandLine ICONTAINS " -ma ") OR where(CommandLine ICONTAINS "Microsoft\\Windows\\CurrentVersion\\Run") OR where(CommandLine ICONTAINS ".downloadstring(") OR where(CommandLine ICONTAINS ".downloadfile(") OR where(CommandLine ICONTAINS " /ticket:") OR where(CommandLine ICONTAINS "dpapi::") OR where(CommandLine ICONTAINS "event::clear") OR where(CommandLine ICONTAINS "event::drop") OR where(CommandLine ICONTAINS "id::modify") OR where(CommandLine ICONTAINS "kerberos::") OR where(CommandLine ICONTAINS "lsadump::") OR where(CommandLine ICONTAINS "misc::") OR where(CommandLine ICONTAINS "privilege::") OR where(CommandLine ICONTAINS "rpc::") OR where(CommandLine ICONTAINS "sekurlsa::") OR where(CommandLine ICONTAINS "sid::") OR where(CommandLine ICONTAINS "token::") OR where(CommandLine ICONTAINS "vault::cred") OR where(CommandLine ICONTAINS "vault::list") OR where(CommandLine ICONTAINS " p::d ") OR where(CommandLine ICONTAINS ";iex(") OR where(CommandLine ICONTAINS "MiniDump"))))) AND NOT (((where(ParentImage ICONTAINS ":\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\")) OR ((where(ParentImage ICONTAINS ":\\Program Files (x86)\\Java\\") OR where(ParentImage ICONTAINS ":\\Program Files\\Java\\")) AND where(ParentImage IENDSWITH "\\bin\\javaws.exe") AND (where(Image ICONTAINS ":\\Program Files (x86)\\Java\\") OR where(Image ICONTAINS ":\\Program Files\\Java\\")) AND where(Image IENDSWITH "\\bin\\jp2launcher.exe") AND where(CommandLine ICONTAINS " -ma ")) OR ((where(CommandLine ICONTAINS "ping") AND where(CommandLine ICONTAINS "127.0.0.1") AND where(CommandLine ICONTAINS " -n "))) OR (where(Image IENDSWITH "\\PING.EXE") AND where(ParentCommandLine ICONTAINS "\\DismFoDInstall.cmd")))))
