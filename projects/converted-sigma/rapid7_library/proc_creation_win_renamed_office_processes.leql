// Title: Renamed Office Binary Execution
// ID: 0b0cd537-fc77-4e6e-a973-e53495c1083d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-20
// Tags: attack.stealth, attack.t1036.003
// Description: Detects the execution of a renamed office binary
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(OriginalFileName = "Excel.exe") OR where(OriginalFileName = "MSACCESS.EXE") OR where(OriginalFileName = "MSPUB.EXE") OR where(OriginalFileName = "OneNote.exe") OR where(OriginalFileName = "OneNoteM.exe") OR where(OriginalFileName = "OUTLOOK.EXE") OR where(OriginalFileName = "POWERPNT.EXE") OR where(OriginalFileName = "WinWord.exe") OR where(OriginalFileName = "Olk.exe"))) OR ((where(Description = "Microsoft Access") OR where(Description = "Microsoft Excel") OR where(Description = "Microsoft OneNote") OR where(Description = "Microsoft Outlook") OR where(Description = "Microsoft PowerPoint") OR where(Description = "Microsoft Publisher") OR where(Description = "Microsoft Word") OR where(Description = "Sent to OneNote Tool")))) AND NOT (((where(Image IENDSWITH "\\EXCEL.exe") OR where(Image IENDSWITH "\\excelcnv.exe") OR where(Image IENDSWITH "\\MSACCESS.exe") OR where(Image IENDSWITH "\\MSPUB.EXE") OR where(Image IENDSWITH "\\ONENOTE.EXE") OR where(Image IENDSWITH "\\ONENOTEM.EXE") OR where(Image IENDSWITH "\\OUTLOOK.EXE") OR where(Image IENDSWITH "\\POWERPNT.EXE") OR where(Image IENDSWITH "\\WINWORD.exe") OR where(Image IENDSWITH "\\OLK.EXE")))))
