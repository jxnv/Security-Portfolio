// Title: Linux Network Service Scanning - Auditd
// ID: 3761e026-f259-44e6-8826-719ed8079408
// Status: test
// Level: low
// Author: Alejandro Ortuno, oscd.community
// Date: 2020-10-21
// Tags: attack.discovery, attack.t1046
// Description: Detects enumeration of local or remote network services.
// Converted by: Sigma Universal SIEM/EDR CLI

(where(type = "SYSCALL") AND (where(exe IENDSWITH "/telnet") OR where(exe IENDSWITH "/nmap") OR where(exe IENDSWITH "/netcat") OR where(exe IENDSWITH "/nc") OR where(exe IENDSWITH "/ncat") OR where(exe IENDSWITH "/nc.openbsd")) AND where(key = "network_connect_4"))
