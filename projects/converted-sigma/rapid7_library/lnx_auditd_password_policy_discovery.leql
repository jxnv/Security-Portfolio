// Title: Password Policy Discovery - Linux
// ID: ca94a6db-8106-4737-9ed2-3e3bb826af0a
// Status: stable
// Level: low
// Author: Ömer Günal, oscd.community, Pawel Mazur
// Date: 2020-10-08
// Tags: attack.discovery, attack.t1201
// Description: Detects password policy discovery commands
// Converted by: Sigma Universal SIEM/EDR CLI

((where(type = "EXECVE") AND where(a0 = "chage") AND (where(a1 = "--list") OR where(a1 = "-l"))) OR (where(type = "PATH") AND (where(name = "/etc/login.defs") OR where(name = "/etc/pam.d/auth") OR where(name = "/etc/pam.d/common-account") OR where(name = "/etc/pam.d/common-auth") OR where(name = "/etc/pam.d/common-password") OR where(name = "/etc/pam.d/system-auth") OR where(name = "/etc/security/pwquality.conf"))) OR (where(type = "EXECVE") AND where(a0 = "passwd") AND (where(a1 = "-S") OR where(a1 = "--status"))))
