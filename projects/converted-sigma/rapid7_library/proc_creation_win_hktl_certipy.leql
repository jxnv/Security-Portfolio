// Title: HackTool - Certipy Execution
// ID: 6938366d-8954-4ddc-baff-c830b3ba8fcd
// Status: test
// Level: high
// Author: pH-T (Nextron Systems), Sittikorn Sangrattanapitak
// Date: 2023-04-17
// Tags: attack.discovery, attack.credential-access, attack.t1649
// Description: Detects Certipy execution, a tool for Active Directory Certificate Services enumeration and abuse based on PE metadata characteristics and common command line arguments.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "\\Certipy.exe")) OR (where(OriginalFileName = "Certipy.exe")) OR (where(Description ICONTAINS "Certipy"))) OR (((where(CommandLine ICONTAINS " account ") OR where(CommandLine ICONTAINS " auth ") OR where(CommandLine ICONTAINS " cert ") OR where(CommandLine ICONTAINS " find ") OR where(CommandLine ICONTAINS " forge ") OR where(CommandLine ICONTAINS " ptt ") OR where(CommandLine ICONTAINS " relay ") OR where(CommandLine ICONTAINS " req ") OR where(CommandLine ICONTAINS " shadow ") OR where(CommandLine ICONTAINS " template "))) AND ((where(CommandLine ICONTAINS " -bloodhound") OR where(CommandLine ICONTAINS " -ca-pfx ") OR where(CommandLine ICONTAINS " -dc-ip ") OR where(CommandLine ICONTAINS " -kirbi") OR where(CommandLine ICONTAINS " -old-bloodhound") OR where(CommandLine ICONTAINS " -pfx ") OR where(CommandLine ICONTAINS " -target") OR where(CommandLine ICONTAINS " -template") OR where(CommandLine ICONTAINS " -username ") OR where(CommandLine ICONTAINS " -vulnerable") OR where(CommandLine ICONTAINS "auth -pfx") OR where(CommandLine ICONTAINS "shadow auto") OR where(CommandLine ICONTAINS "shadow list")))))
