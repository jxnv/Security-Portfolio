// Tags: attack.persistence, attack.execution, attack.privilege-escalation, attack.stealth, attack.t1203, attack.t1574.001
// Description: Detects potentially suspicious child processes of KeyScrambler.exe
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(Image IENDSWITH "\\cmd.exe") OR where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\mshta.exe") OR where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe") OR where(Image IENDSWITH "\\regsvr32.exe") OR where(Image IENDSWITH "\\rundll32.exe") OR where(Image IENDSWITH "\\wscript.exe"))) OR ((where(OriginalFileName = "Cmd.Exe") OR where(OriginalFileName = "cscript.exe") OR where(OriginalFileName = "mshta.exe") OR where(OriginalFileName = "PowerShell.EXE") OR where(OriginalFileName = "pwsh.dll") OR where(OriginalFileName = "regsvr32.exe") OR where(OriginalFileName = "RUNDLL32.EXE") OR where(OriginalFileName = "wscript.exe")))) AND (where(ParentImage IENDSWITH "\\KeyScrambler.exe")))
