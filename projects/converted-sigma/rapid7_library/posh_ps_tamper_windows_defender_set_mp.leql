// Title: Tamper Windows Defender - ScriptBlockLogging
// ID: 14c71865-6cd3-44ae-adaa-1db923fae5f2
// Status: test
// Level: high
// Author: frack113, elhoim, Tim Shelton (fps, alias support), Swachchhanda Shrawan Poudel, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-16
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects PowerShell scripts attempting to disable scheduled scanning and other parts of Windows Defender ATP or set default actions to allow.
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(ScriptBlockText ICONTAINS "-dbaf $true") OR where(ScriptBlockText ICONTAINS "-dbaf 1") OR where(ScriptBlockText ICONTAINS "-dbm $true") OR where(ScriptBlockText ICONTAINS "-dbm 1") OR where(ScriptBlockText ICONTAINS "-dips $true") OR where(ScriptBlockText ICONTAINS "-dips 1") OR where(ScriptBlockText ICONTAINS "-DisableArchiveScanning $true") OR where(ScriptBlockText ICONTAINS "-DisableArchiveScanning 1") OR where(ScriptBlockText ICONTAINS "-DisableBehaviorMonitoring $true") OR where(ScriptBlockText ICONTAINS "-DisableBehaviorMonitoring 1") OR where(ScriptBlockText ICONTAINS "-DisableBlockAtFirstSeen $true") OR where(ScriptBlockText ICONTAINS "-DisableBlockAtFirstSeen 1") OR where(ScriptBlockText ICONTAINS "-DisableCatchupFullScan $true") OR where(ScriptBlockText ICONTAINS "-DisableCatchupFullScan 1") OR where(ScriptBlockText ICONTAINS "-DisableCatchupQuickScan $true") OR where(ScriptBlockText ICONTAINS "-DisableCatchupQuickScan 1") OR where(ScriptBlockText ICONTAINS "-DisableIntrusionPreventionSystem $true") OR where(ScriptBlockText ICONTAINS "-DisableIntrusionPreventionSystem 1") OR where(ScriptBlockText ICONTAINS "-DisableIOAVProtection $true") OR where(ScriptBlockText ICONTAINS "-DisableIOAVProtection 1") OR where(ScriptBlockText ICONTAINS "-DisableRealtimeMonitoring $true") OR where(ScriptBlockText ICONTAINS "-DisableRealtimeMonitoring 1") OR where(ScriptBlockText ICONTAINS "-DisableRemovableDriveScanning $true") OR where(ScriptBlockText ICONTAINS "-DisableRemovableDriveScanning 1") OR where(ScriptBlockText ICONTAINS "-DisableScanningMappedNetworkDrivesForFullScan $true") OR where(ScriptBlockText ICONTAINS "-DisableScanningMappedNetworkDrivesForFullScan 1") OR where(ScriptBlockText ICONTAINS "-DisableScanningNetworkFiles $true") OR where(ScriptBlockText ICONTAINS "-DisableScanningNetworkFiles 1") OR where(ScriptBlockText ICONTAINS "-DisableScriptScanning $true") OR where(ScriptBlockText ICONTAINS "-DisableScriptScanning 1") OR where(ScriptBlockText ICONTAINS "-MAPSReporting $false") OR where(ScriptBlockText ICONTAINS "-MAPSReporting 0") OR where(ScriptBlockText ICONTAINS "-drdsc $true") OR where(ScriptBlockText ICONTAINS "-drdsc 1") OR where(ScriptBlockText ICONTAINS "-drtm $true") OR where(ScriptBlockText ICONTAINS "-drtm 1") OR where(ScriptBlockText ICONTAINS "-dscrptsc $true") OR where(ScriptBlockText ICONTAINS "-dscrptsc 1") OR where(ScriptBlockText ICONTAINS "-dsmndf $true") OR where(ScriptBlockText ICONTAINS "-dsmndf 1") OR where(ScriptBlockText ICONTAINS "-dsnf $true") OR where(ScriptBlockText ICONTAINS "-dsnf 1") OR where(ScriptBlockText ICONTAINS "-dss $true") OR where(ScriptBlockText ICONTAINS "-dss 1"))) AND (where(ScriptBlockText ICONTAINS "Set-MpPreference"))) OR ((where(ScriptBlockText ICONTAINS "Set-MpPreference")) AND ((where(ScriptBlockText ICONTAINS "HighThreatDefaultAction Allow") OR where(ScriptBlockText ICONTAINS "htdefac Allow") OR where(ScriptBlockText ICONTAINS "LowThreatDefaultAction Allow") OR where(ScriptBlockText ICONTAINS "ltdefac Allow") OR where(ScriptBlockText ICONTAINS "ModerateThreatDefaultAction Allow") OR where(ScriptBlockText ICONTAINS "mtdefac Allow") OR where(ScriptBlockText ICONTAINS "SevereThreatDefaultAction Allow") OR where(ScriptBlockText ICONTAINS "stdefac Allow")))))
