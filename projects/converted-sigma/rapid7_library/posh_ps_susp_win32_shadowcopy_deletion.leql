// Description: Detects deletion of Windows Volume Shadow Copies with PowerShell code and Get-WMIObject. This technique is used by numerous ransomware families such as Sodinokibi/REvil
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(ScriptBlockText ICONTAINS ".Delete()") OR where(ScriptBlockText ICONTAINS "Remove-WmiObject") OR where(ScriptBlockText ICONTAINS "rwmi") OR where(ScriptBlockText ICONTAINS "Remove-CimInstance") OR where(ScriptBlockText ICONTAINS "rcim"))) AND ((where(ScriptBlockText ICONTAINS "Get-WmiObject") OR where(ScriptBlockText ICONTAINS "gwmi") OR where(ScriptBlockText ICONTAINS "Get-CimInstance") OR where(ScriptBlockText ICONTAINS "gcim"))) AND (where(ScriptBlockText ICONTAINS "Win32_ShadowCopy")))
