// Description: Detects potential DLL sideloading of "dbghelp.dll"
// Converted by: Sigma Universal SIEM/EDR CLI

((where(ImageLoaded IENDSWITH "\\dbghelp.dll")) AND NOT (((where(ImageLoaded ISTARTSWITH "C:\\Program Files (x86)\\") OR where(ImageLoaded ISTARTSWITH "C:\\Program Files\\") OR where(ImageLoaded ISTARTSWITH "C:\\Windows\\SoftwareDistribution\\") OR where(ImageLoaded ISTARTSWITH "C:\\Windows\\System32\\") OR where(ImageLoaded ISTARTSWITH "C:\\Windows\\SystemTemp\\") OR where(ImageLoaded ISTARTSWITH "C:\\Windows\\SysWOW64\\") OR where(ImageLoaded ISTARTSWITH "C:\\Windows\\WinSxS\\")))) AND NOT ((((where(ImageLoaded IENDSWITH "\\Anaconda3\\Lib\\site-packages\\vtrace\\platforms\\windll\\amd64\\dbghelp.dll") OR where(ImageLoaded IENDSWITH "\\Anaconda3\\Lib\\site-packages\\vtrace\\platforms\\windll\\i386\\dbghelp.dll"))) OR ((where(ImageLoaded IENDSWITH "\\Epic Games\\Launcher\\Engine\\Binaries\\ThirdParty\\DbgHelp\\dbghelp.dll") OR where(ImageLoaded IENDSWITH "\\Epic Games\\MagicLegends\\x86\\dbghelp.dll"))) OR (where(ImageLoaded ICONTAINS "opera\\Opera Installer Temp\\opera_package") AND where(ImageLoaded IENDSWITH "\\assistant\\dbghelp.dll")))))
