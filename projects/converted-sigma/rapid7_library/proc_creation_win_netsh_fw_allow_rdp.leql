// Title: RDP Connection Allowed Via Netsh.EXE
// ID: 01aeb693-138d-49d2-9403-c4f52d7d3d62
// Status: test
// Level: high
// Author: Sander Wiebing
// Date: 2020-05-23
// Tags: attack.defense-impairment, attack.t1686.003
// Description: Detects usage of the netsh command to open and allow connections to port 3389 (RDP). As seen used by Sarwent Malware
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "firewall ") AND where(CommandLine ICONTAINS "add ") AND where(CommandLine ICONTAINS "tcp ") AND where(CommandLine ICONTAINS "3389")) AND (where(CommandLine ICONTAINS "portopening") OR where(CommandLine ICONTAINS "allow"))) AND ((where(Image IENDSWITH "\\netsh.exe")) OR (where(OriginalFileName = "netsh.exe"))))
