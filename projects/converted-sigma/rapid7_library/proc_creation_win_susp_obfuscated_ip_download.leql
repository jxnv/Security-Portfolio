// Title: Obfuscated IP Download Activity
// ID: cb5a2333-56cf-4562-8fcb-22ba1bca728d
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2022-08-03
// Tags: attack.discovery
// Description: Detects use of an encoded/obfuscated version of an IP address (hex, octal...) in an URL combined with a download command
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "Invoke-WebRequest") OR where(CommandLine ICONTAINS "iwr ") OR where(CommandLine ICONTAINS "Invoke-RestMethod") OR where(CommandLine ICONTAINS "irm ") OR where(CommandLine ICONTAINS "wget ") OR where(CommandLine ICONTAINS "curl ") OR where(CommandLine ICONTAINS "DownloadFile") OR where(CommandLine ICONTAINS "DownloadString"))) AND (((where(CommandLine ICONTAINS " 0x") OR where(CommandLine ICONTAINS "//0x") OR where(CommandLine ICONTAINS ".0x") OR where(CommandLine ICONTAINS ".00x"))) OR ((where(CommandLine ICONTAINS "http://%") AND where(CommandLine ICONTAINS "%2e"))) OR ((where(CommandLine /https?://[0-9]{1,3}\.[0-9]{1,3}\.0[0-9]{3,4}/)) OR (where(CommandLine /https?://[0-9]{1,3}\.0[0-9]{3,7}/)) OR (where(CommandLine /https?://0[0-9]{3,11}/)) OR (where(CommandLine /https?://(?:0[0-9]{1,11}\.){3}0[0-9]{1,11}/)) OR (where(CommandLine /https?://0[0-9]{1,11}/)) OR (where(CommandLine / [0-7]{7,13}/)))) AND NOT ((where(CommandLine /https?://(?:(?:25[0-5]|(?:2[0-4]|1\d|[1-9])?\d)(?:\.|\b)){4}/))))
