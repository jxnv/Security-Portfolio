// Title: Remote Code Execute via Winrm.vbs
// ID: 9df0dd3a-1a5c-47e3-a2bc-30ed177646a0
// Status: test
// Level: medium
// Author: Julia Fomina, oscd.community
// Date: 2020-10-07
// Tags: attack.stealth, attack.t1216
// Description: Detects an attempt to execute code or create service on remote host via winrm.vbs.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "winrm") AND where(CommandLine ICONTAINS "invoke Create wmicimv2/Win32_") AND where(CommandLine ICONTAINS "-r:http"))) AND ((where(Image IENDSWITH "\\cscript.exe")) OR (where(OriginalFileName = "cscript.exe"))))
