// Date: 2021-11-24
// Tags: attack.execution, attack.stealth, attack.t1127
// Description: Detects execution of "aspnet_compiler.exe" which can be abused to compile and execute C# code.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image ICONTAINS ":\\Windows\\Microsoft.NET\\Framework\\") OR where(Image ICONTAINS ":\\Windows\\Microsoft.NET\\Framework64\\") OR where(Image ICONTAINS ":\\Windows\\Microsoft.NET\\FrameworkArm\\") OR where(Image ICONTAINS ":\\Windows\\Microsoft.NET\\FrameworkArm64\\")) AND where(Image IENDSWITH "\\aspnet_compiler.exe"))
