// Title: Suspicious Camera and Microphone Access
// ID: 62120148-6b7a-42be-8b91-271c04e281a3
// Status: test
// Level: high
// Author: Den Iuzvyk
// Date: 2020-06-07
// Tags: attack.collection, attack.t1125, attack.t1123
// Description: Detects Processes accessing the camera and microphone from suspicious folder
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(TargetObject ICONTAINS "\\Software\\Microsoft\\Windows\\CurrentVersion\\CapabilityAccessManager\\ConsentStore\\") AND where(TargetObject ICONTAINS "\\NonPackaged"))) AND ((where(TargetObject ICONTAINS "microphone") OR where(TargetObject ICONTAINS "webcam"))) AND ((where(TargetObject ICONTAINS ":#Windows#Temp#") OR where(TargetObject ICONTAINS ":#$Recycle.bin#") OR where(TargetObject ICONTAINS ":#Temp#") OR where(TargetObject ICONTAINS ":#Users#Public#") OR where(TargetObject ICONTAINS ":#Users#Default#") OR where(TargetObject ICONTAINS ":#Users#Desktop#"))))
