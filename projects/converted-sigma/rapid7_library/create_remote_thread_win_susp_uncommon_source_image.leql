(((where(SourceImage IENDSWITH "\\explorer.exe") OR where(SourceImage IENDSWITH "\\iexplore.exe") OR where(SourceImage IENDSWITH "\\msiexec.exe") OR where(SourceImage IENDSWITH "\\powerpnt.exe") OR where(SourceImage IENDSWITH "\\schtasks.exe") OR where(SourceImage IENDSWITH "\\winlogon.exe"))) AND NOT (((where(TargetImage = "")) OR (where(SourceImage = "C:\\Windows\\explorer.exe") AND (where(TargetImage ISTARTSWITH "C:\\Program Files (x86)\\") OR where(TargetImage ISTARTSWITH "C:\\Program Files\\") OR where(TargetImage ISTARTSWITH "C:\\Windows\\System32\\") OR where(TargetImage ISTARTSWITH "C:\\Windows\\SysWOW64\\"))) OR (where(SourceImage = "C:\\Program Files\\Internet Explorer\\iexplore.exe") AND (where(TargetImage = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe") OR where(TargetImage = "C:\\Windows\\System32\\rundll32.exe"))) OR (where(SourceImage IENDSWITH "\\msiexec.exe") AND (where(TargetImage ICONTAINS "\\AppData\\Local\\") OR where(TargetImage ICONTAINS "C:\\Program Files (x86)\\") OR where(TargetImage ICONTAINS "C:\\Program Files\\") OR where(TargetImage ICONTAINS "C:\\Windows\\Microsoft.NET\\Framework64\\"))) OR (where(SourceImage IENDSWITH "\\msiexec.exe") AND (where(TargetImage = "C:\\Windows\\System32\\msiexec.exe") OR where(TargetImage = "C:\\Windows\\SysWOW64\\msiexec.exe"))) OR (NOT TargetImage=*) OR (where(SourceImage IENDSWITH "\\POWERPNT.EXE") AND (where(TargetImage ICONTAINS "C:\\Program Files\\Microsoft Office\\") OR where(TargetImage ICONTAINS "C:\\Program Files (x86)\\Microsoft Office\\"))) OR ((where(SourceImage = "C:\\Windows\\System32\\schtasks.exe") OR where(SourceImage = "C:\\Windows\\SysWOW64\\schtasks.exe")) AND where(TargetImage = "C:\\Windows\\System32\\conhost.exe")) OR (where(TargetImage = "System")) OR (where(SourceImage = "C:\\Windows\\System32\\winlogon.exe") AND (where(TargetImage = "C:\\Windows\\System32\\services.exe") OR where(TargetImage = "C:\\Windows\\System32\\wininit.exe") OR where(TargetImage = "C:\\Windows\\System32\\csrss.exe") OR where(TargetImage = "C:\\Windows\\System32\\LogonUI.exe") OR where(TargetImage = "C:\\Windows\\System32\\wlrmdr.exe") OR where(TargetImage = "C:\\Windows\\System32\\AtBroker.exe") OR where(TargetImage = "C:\\Windows\\System32\\dwm.exe") OR where(TargetImage = "C:\\Windows\\System32\\fontdrvhost.exe") OR where(TargetImage = "C:\\Windows\\System32\\userinit.exe"))) OR (where(SourceImage = "C:\\Windows\\System32\\winlogon.exe") AND where(TargetParentProcessId = "4")))) AND NOT (((where(SourceImage = "C:\\Windows\\explorer.exe") AND where(TargetImage IENDSWITH "\\aurora-dashboard.exe")) OR (where(SourceImage = "C:\\Program Files\\internet explorer\\iexplore.exe") AND (where(SourceCommandLine ICONTAINS "https://") AND where(SourceCommandLine ICONTAINS ".checkpoint.com/documents/") AND where(SourceCommandLine ICONTAINS "SmartConsole_OLH/") AND where(SourceCommandLine ICONTAINS "default.htm#cshid="))) OR (where(SourceImage = "C:\\Program Files\\internet explorer\\iexplore.exe") AND (where(SourceParentImage ISTARTSWITH "C:\\Program Files\\") OR where(SourceParentImage ISTARTSWITH "C:\\Program Files (x86)\\")) AND (where(SourceParentImage ICONTAINS "\\CheckPoint\\SmartConsole\\") AND where(SourceParentImage ICONTAINS "\\SmartConsole.exe"))) OR (where(SourceImage = "C:\\Windows\\explorer.exe") AND where(TargetImage IENDSWITH "\\OfficeSetup.exe")) OR (where(SourceImage = "C:\\Windows\\explorer.exe") AND where(TargetImage IENDSWITH "\\AppData\\Local\\Microsoft\\OneDrive\\OneDrive.exe")) OR (where(SourceImage ICONTAINS "\\Microsoft Office\\") AND where(SourceImage IENDSWITH "\\POWERPNT.EXE") AND where(TargetImage = "C:\\Windows\\System32\\csrss.exe")))))
