e ICONTAINS " maven ") OR where(CommandLine ICONTAINS " memory ") OR where(CommandLine ICONTAINS " multimedia ") OR where(CommandLine ICONTAINS " php ") OR where(CommandLine ICONTAINS " svn ") OR where(CommandLine ICONTAINS " sysadmin ") OR where(CommandLine ICONTAINS " unused ") OR where(CommandLine ICONTAINS " wifi "))) AND ((where(CommandLine ICONTAINS "-1Password") OR where(CommandLine ICONTAINS "-apachedirectorystudio") OR where(CommandLine ICONTAINS "-autologon") OR where(CommandLine ICONTAINS "-ChromiumBased") OR where(CommandLine ICONTAINS "-coreftp") OR where(CommandLine ICONTAINS "-credfiles") OR where(CommandLine ICONTAINS "-credman") OR where(CommandLine ICONTAINS "-cyberduck") OR where(CommandLine ICONTAINS "-dbvis") OR where(CommandLine ICONTAINS "-EyeCon") OR where(CommandLine ICONTAINS "-filezilla") OR where(CommandLine ICONTAINS "-filezillaserver") OR where(CommandLine ICONTAINS "-ftpnavigator") OR where(CommandLine ICONTAINS "-galconfusion") OR where(CommandLine ICONTAINS "-gitforwindows") OR where(CommandLine ICONTAINS "-hashdump") OR where(CommandLine ICONTAINS "-iisapppool") OR where(CommandLine ICONTAINS "-IISCentralCertP") OR where(CommandLine ICONTAINS "-kalypsomedia") OR where(CommandLine ICONTAINS "-keepass") OR where(CommandLine ICONTAINS "-keepassconfig") OR where(CommandLine ICONTAINS "-lsa_secrets") OR where(CommandLine ICONTAINS "-mavenrepositories") OR where(CommandLine ICONTAINS "-memory_dump") OR where(CommandLine ICONTAINS "-Mozilla") OR where(CommandLine ICONTAINS "-mRemoteNG") OR where(CommandLine ICONTAINS "-mscache") OR where(CommandLine ICONTAINS "-opensshforwindows") OR where(CommandLine ICONTAINS "-openvpn") OR where(CommandLine ICONTAINS "-outlook") OR where(CommandLine ICONTAINS "-pidgin") OR where(CommandLine ICONTAINS "-postgresql") OR where(CommandLine ICONTAINS "-psi-im") OR where(CommandLine ICONTAINS "-puttycm") OR where(CommandLine ICONTAINS "-pypykatz") OR where(CommandLine ICONTAINS "-Rclone") OR where(CommandLine