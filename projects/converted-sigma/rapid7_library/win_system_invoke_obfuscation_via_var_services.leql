// Description: Detects Obfuscated Powershell via VAR++ LAUNCHER
// Converted by: Sigma Universal SIEM/EDR CLI

(where(Provider_Name = "Service Control Manager") AND where(EventID = "7045") AND (where(ImagePath ICONTAINS "&&set") AND where(ImagePath ICONTAINS "cmd") AND where(ImagePath ICONTAINS "/c") AND where(ImagePath ICONTAINS "-f")) AND (where(ImagePath ICONTAINS "{0}") OR where(ImagePath ICONTAINS "{1}") OR where(ImagePath ICONTAINS "{2}") OR where(ImagePath ICONTAINS "{3}") OR where(ImagePath ICONTAINS "{4}") OR where(ImagePath ICONTAINS "{5}")))
