// Title: PUA - Chisel Tunneling Tool Execution
// ID: 8b0e12da-d3c3-49db-bb4f-256703f380e5
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-09-13
// Tags: attack.command-and-control, attack.t1090.001
// Description: Detects usage of the Chisel tunneling tool via the commandline arguments
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image IENDSWITH "\\chisel.exe")) OR (((where(CommandLine ICONTAINS "exe client ") OR where(CommandLine ICONTAINS "exe server "))) AND ((where(CommandLine ICONTAINS "-socks5") OR where(CommandLine ICONTAINS "-reverse") OR where(CommandLine ICONTAINS " r:") OR where(CommandLine ICONTAINS ":127.0.0.1:") OR where(CommandLine ICONTAINS "-tls-skip-verify ") OR where(CommandLine ICONTAINS ":socks")))))
