// Tags: attack.stealth, attack.t1218
// Description: Detects possible password spraying attempts using Dsacls
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "/user:") AND where(CommandLine ICONTAINS "/passwd:"))) AND ((where(Image IENDSWITH "\\dsacls.exe")) OR (where(OriginalFileName = "DSACLS.EXE"))))
