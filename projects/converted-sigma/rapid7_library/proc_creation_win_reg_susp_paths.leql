// Title: Reg Add Suspicious Paths
// ID: b7e2a8d4-74bb-4b78-adc9-3f92af2d4829
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-19
// Tags: attack.persistence, attack.defense-impairment, attack.t1112, attack.t1685
// Description: Detects when an adversary uses the reg.exe utility to add or modify new keys or subkeys
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "\\AppDataLow\\Software\\Microsoft\\") OR where(CommandLine ICONTAINS "\\Policies\\Microsoft\\Windows\\OOBE") OR where(CommandLine ICONTAINS "\\Policies\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon") OR where(CommandLine ICONTAINS "\\SOFTWARE\\Microsoft\\Windows NT\\Currentversion\\Winlogon") OR where(CommandLine ICONTAINS "\\CurrentControlSet\\Control\\SecurityProviders\\WDigest") OR where(CommandLine ICONTAINS "\\Microsoft\\Windows Defender\\"))) AND ((where(Image IENDSWITH "\\reg.exe")) OR (where(OriginalFileName = "reg.exe"))))
