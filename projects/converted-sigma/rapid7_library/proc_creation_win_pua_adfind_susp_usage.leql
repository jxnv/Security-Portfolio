// Title: PUA - AdFind Suspicious Execution
// ID: 9a132afa-654e-11eb-ae93-0242ac130002
// Status: test
// Level: high
// Author: Janantha Marasinghe (https://github.com/blueteam0ps), FPT.EagleEye Team, omkar72, oscd.community
// Date: 2021-02-02
// Tags: attack.discovery, attack.t1018, attack.t1087.002, attack.t1482, attack.t1069.002, stp.1u
// Description: Detects AdFind execution with common flags seen used during attacks
// Converted by: Sigma Universal SIEM/EDR CLI

((where(CommandLine ICONTAINS "domainlist") OR where(CommandLine ICONTAINS "trustdmp") OR where(CommandLine ICONTAINS "dcmodes") OR where(CommandLine ICONTAINS "adinfo") OR where(CommandLine ICONTAINS "-sc dclist") OR where(CommandLine ICONTAINS "computer_pwdnotreqd") OR where(CommandLine ICONTAINS "objectcategory=") OR where(CommandLine ICONTAINS "-subnets -f") OR where(CommandLine ICONTAINS "name=\"Domain Admins\"") OR where(CommandLine ICONTAINS "-sc u:") OR where(CommandLine ICONTAINS "domainncs") OR where(CommandLine ICONTAINS "dompol") OR where(CommandLine ICONTAINS " oudmp ") OR where(CommandLine ICONTAINS "subnetdmp") OR where(CommandLine ICONTAINS "gpodmp") OR where(CommandLine ICONTAINS "fspdmp") OR where(CommandLine ICONTAINS "users_noexpire") OR where(CommandLine ICONTAINS "computers_active") OR where(CommandLine ICONTAINS "computers_pwdnotreqd")))
