// Description: Detects download of certain file types from hosts in suspicious TLDs
// Converted by: Sigma Universal SIEM/EDR CLI

((where(c-uri-extension = "exe") OR where(c-uri-extension = "vbs") OR where(c-uri-extension = "bat") OR where(c-uri-extension = "rar") OR where(c-uri-extension = "ps1") OR where(c-uri-extension = "doc") OR where(c-uri-extension = "docm") OR where(c-uri-extension = "xls") OR where(c-uri-extension = "xlsm") OR where(c-uri-extension = "pptm") OR where(c-uri-extension = "rtf") OR where(c-uri-extension = "hta") OR where(c-uri-extension = "dll") OR where(c-uri-extension = "ws") OR where(c-uri-extension = "wsf") OR where(c-uri-extension = "sct") OR where(c-uri-extension = "zip")) AND (where(cs-host IENDSWITH ".country") OR where(cs-host IENDSWITH ".stream") OR where(cs-host IENDSWITH ".gdn") OR where(cs-host IENDSWITH ".mom") OR where(cs-host IENDSWITH ".xin") OR where(cs-host IENDSWITH ".kim") OR where(cs-host IENDSWITH ".men") OR where(cs-host IENDSWITH ".loan") OR where(cs-host IENDSWITH ".download") OR where(cs-host IENDSWITH ".racing") OR where(cs-host IENDSWITH ".online") OR where(cs-host IENDSWITH ".science") OR where(cs-host IENDSWITH ".ren") OR where(cs-host IENDSWITH ".gb") OR where(cs-host IENDSWITH ".win") OR where(cs-host IENDSWITH ".top") OR where(cs-host IENDSWITH ".review") OR where(cs-host IENDSWITH ".vip") OR where(cs-host IENDSWITH ".party") OR where(cs-host IENDSWITH ".tech") OR where(cs-host IENDSWITH ".xyz") OR where(cs-host IENDSWITH ".date") OR where(cs-host IENDSWITH ".faith") OR where(cs-host IENDSWITH ".zip") OR where(cs-host IENDSWITH ".cricket") OR where(cs-host IENDSWITH ".space") OR where(cs-host IENDSWITH ".info") OR where(cs-host IENDSWITH ".vn") OR where(cs-host IENDSWITH ".cm") OR where(cs-host IENDSWITH ".am") OR where(cs-host IENDSWITH ".cc") OR where(cs-host IENDSWITH ".asia") OR where(cs-host IENDSWITH ".ws") OR where(cs-host IENDSWITH ".tk") OR where(cs-host IENDSWITH ".biz") OR where(cs-host IENDSWITH ".su") OR where(cs-host IENDSWITH ".st") OR where(cs-host IENDSWITH ".ro") OR where(cs-host IENDSWITH ".ge") OR where(cs-host IENDSWITH ".ms") OR where(cs-host IENDSWITH ".pk") OR where(cs-host IENDSWITH ".nu") OR where(cs-host IENDSWITH ".me") OR where(cs-host IENDSWITH ".ph") OR where(cs-host IENDSWITH ".to") OR where(cs-host IENDSWITH ".tt") OR where(cs-host IENDSWITH ".name") OR where(cs-host IENDSWITH ".tv") OR where(cs-host IENDSWITH ".kz") OR where(cs-host IENDSWITH ".tc") OR where(cs-host IENDSWITH ".mobi") OR where(cs-host IENDSWITH ".study") OR where(cs-host IENDSWITH ".click") OR where(cs-host IENDSWITH ".link") OR where(cs-host IENDSWITH ".trade") OR where(cs-host IENDSWITH ".accountant") OR where(cs-host IENDSWITH ".cf") OR where(cs-host IENDSWITH ".gq") OR where(cs-host IENDSWITH ".ml") OR where(cs-host IENDSWITH ".ga") OR where(cs-host IENDSWITH ".pw")))
