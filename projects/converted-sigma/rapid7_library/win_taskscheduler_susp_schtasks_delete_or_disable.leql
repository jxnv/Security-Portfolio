// Title: Important Scheduled Task Deleted or Disabled
// ID: 9e3cb244-bdb8-4632-8c90-6079c8f4f16d
// Status: test
// Level: high
// Author: frack113
// Date: 2023-01-13
// Tags: attack.impact, attack.t1489
// Description: Detects when adversaries try to stop system services or processes by deleting or disabling their respective scheduled tasks in order to conduct data destructive activities
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(EventID = "141") OR where(EventID = "142")) AND (where(TaskName ICONTAINS "\\Windows\\SystemRestore\\SR") OR where(TaskName ICONTAINS "\\Windows\\Windows Defender\\") OR where(TaskName ICONTAINS "\\Windows\\BitLocker") OR where(TaskName ICONTAINS "\\Windows\\WindowsBackup\\") OR where(TaskName ICONTAINS "\\Windows\\WindowsUpdate\\") OR where(TaskName ICONTAINS "\\Windows\\UpdateOrchestrator\\") OR where(TaskName ICONTAINS "\\Windows\\ExploitGuard"))) AND NOT (((where(UserName ICONTAINS "AUTHORI") OR where(UserName ICONTAINS "AUTORI")))))
