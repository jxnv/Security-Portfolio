// Title: Potentially Suspicious EventLog Recon Activity Using Log Query Utilities
// ID: beaa66d6-aa1b-4e3c-80f5-e0145369bfaf
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.credential-access, attack.discovery, attack.t1552, attack.t1087
// Description: Detects execution of different log query utilities and commands to search and dump the content of specific event logs or look for specific event IDs.
// This technique is used by threat actors in order to extract sensitive information from events logs such as usernames, IP addresses, hostnames, etc.
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(CommandLine ICONTAINS "-InstanceId 462?") OR where(CommandLine ICONTAINS ".eventid -eq 462?") OR where(CommandLine ICONTAINS ".ID -eq 462?") OR where(CommandLine ICONTAINS "EventCode=?462?") OR where(CommandLine ICONTAINS "EventIdentifier=?462?") OR where(CommandLine ICONTAINS "System[EventID=462?]") OR where(CommandLine ICONTAINS "-InstanceId 4778") OR where(CommandLine ICONTAINS ".eventid -eq 4778") OR where(CommandLine ICONTAINS ".ID -eq 4778") OR where(CommandLine ICONTAINS "EventCode=?4778?") OR where(CommandLine ICONTAINS "EventIdentifier=?4778?") OR where(CommandLine ICONTAINS "System[EventID=4778]") OR where(CommandLine ICONTAINS "-InstanceId 25") OR where(CommandLine ICONTAINS ".eventid -eq 25") OR where(CommandLine ICONTAINS ".ID -eq 25") OR where(CommandLine ICONTAINS "EventCode=?25?") OR where(CommandLine ICONTAINS "EventIdentifier=?25?") OR where(CommandLine ICONTAINS "System[EventID=25]") OR where(CommandLine ICONTAINS "-InstanceId 1149") OR where(CommandLine ICONTAINS ".eventid -eq 1149") OR where(CommandLine ICONTAINS ".ID -eq 1149") OR where(CommandLine ICONTAINS "EventCode=?1149?") OR where(CommandLine ICONTAINS "EventIdentifier=?1149?") OR where(CommandLine ICONTAINS "System[EventID=1149]") OR where(CommandLine ICONTAINS "-InstanceId 21") OR where(CommandLine ICONTAINS ".eventid -eq 21") OR where(CommandLine ICONTAINS ".ID -eq 21") OR where(CommandLine ICONTAINS "EventCode=?21?") OR where(CommandLine ICONTAINS "EventIdentifier=?21?") OR where(CommandLine ICONTAINS "System[EventID=21]") OR where(CommandLine ICONTAINS "-InstanceId 22") OR where(CommandLine ICONTAINS ".eventid -eq 22") OR where(CommandLine ICONTAINS ".ID -eq 22") OR where(CommandLine ICONTAINS "EventCode=?22?") OR where(CommandLine ICONTAINS "EventIdentifier=?22?") OR where(CommandLine ICONTAINS "System[EventID=22]"))) OR ((where(CommandLine ICONTAINS "Microsoft-Windows-PowerShell") OR where(CommandLine ICONTAINS "Microsoft-Windows-Security-Auditing") OR where(CommandLine ICONTAINS "Microsoft-Windows-TerminalServices-LocalSessionManager") OR where(CommandLine ICONTAINS "Microsoft-Windows-TerminalServices-RemoteConnectionManager") OR where(CommandLine ICONTAINS "Microsoft-Windows-Windows Defender") OR where(CommandLine ICONTAINS "PowerShellCore") OR where(CommandLine ICONTAINS "Security") OR where(CommandLine ICONTAINS "Windows PowerShell")))) AND (((where(CommandLine ICONTAINS "Select") AND where(CommandLine ICONTAINS "Win32_NTLogEvent"))) OR (((where(CommandLine ICONTAINS " qe ") OR where(CommandLine ICONTAINS " query-events "))) AND ((where(Image IENDSWITH "\\wevtutil.exe")) OR (where(OriginalFileName = "wevtutil.exe")))) OR ((where(CommandLine ICONTAINS " ntevent")) AND ((where(Image IENDSWITH "\\wmic.exe")) OR (where(OriginalFileName = "wmic.exe")))) OR ((where(CommandLine ICONTAINS "Get-WinEvent ") OR where(CommandLine ICONTAINS "get-eventlog ")))))
