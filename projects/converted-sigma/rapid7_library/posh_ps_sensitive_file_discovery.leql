// Tags: attack.discovery, attack.t1083
// Description: Detect adversaries enumerate sensitive files
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(ScriptBlockText ICONTAINS "ls") OR where(ScriptBlockText ICONTAINS "get-childitem") OR where(ScriptBlockText ICONTAINS "gci"))) AND ((where(ScriptBlockText ICONTAINS ".pass") OR where(ScriptBlockText ICONTAINS ".kdbx") OR where(ScriptBlockText ICONTAINS ".kdb"))) AND (where(ScriptBlockText ICONTAINS "-recurse")))
