// Title: Startup/Logon Script Added to Group Policy Object
// ID: 123e4e6d-b123-48f8-b261-7214938acaf0
// Status: test
// Level: medium
// Author: Elastic, Josh Nickels, Marius Rothenbücher
// Date: 2024-09-06
// Tags: attack.persistence, attack.privilege-escalation, attack.defense-impairment, attack.t1484.001, attack.t1547
// Description: Detects the modification of Group Policy Objects (GPO) to add a startup/logon script to users or computer objects.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(EventID = "5136") OR where(EventID = "5145"))) AND ((((where(AttributeLDAPDisplayName = "gPCMachineExtensionNames") OR where(AttributeLDAPDisplayName = "gPCUserExtensionNames")) AND where(AttributeValue ICONTAINS "42B5FAAE-6536-11D2-AE5A-0000F87571E3")) AND ((where(AttributeValue ICONTAINS "40B6664F-4972-11D1-A7CA-0000F87571E3") OR where(AttributeValue ICONTAINS "40B66650-4972-11D1-A7CA-0000F87571E3")))) OR (where(ShareName IENDSWITH "\\SYSVOL") AND (where(RelativeTargetName IENDSWITH "\\scripts.ini") OR where(RelativeTargetName IENDSWITH "\\psscripts.ini")) AND where(AccessList ICONTAINS "%%4417"))))
