// Title: New Firewall Rule Added In Windows Firewall Exception List For Potential Suspicious Application
// ID: 9e2575e7-2cb9-4da1-adc8-ed94221dca5e
// Status: test
// Level: high
// Author: frack113
// Date: 2023-02-26
// Tags: attack.defense-impairment, attack.t1686.003
// Description: Detects the addition of a new rule to the Windows Firewall exception list for an application located in a potentially suspicious location.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(EventID = "2004") OR where(EventID = "2071") OR where(EventID = "2097")) AND (where(ApplicationPath ICONTAINS ":\\PerfLogs\\") OR where(ApplicationPath ICONTAINS ":\\Temp\\") OR where(ApplicationPath ICONTAINS ":\\Tmp\\") OR where(ApplicationPath ICONTAINS ":\\Users\\Public\\") OR where(ApplicationPath ICONTAINS ":\\Windows\\Tasks\\") OR where(ApplicationPath ICONTAINS ":\\Windows\\Temp\\") OR where(ApplicationPath ICONTAINS "\\AppData\\Local\\Temp\\"))) AND NOT ((where(Action = "2"))))
