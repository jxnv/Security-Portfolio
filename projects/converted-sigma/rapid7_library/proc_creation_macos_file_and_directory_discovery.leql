// Title: File and Directory Discovery - MacOS
// ID: 089dbdf6-b960-4bcc-90e3-ffc3480c20f6
// Status: test
// Level: informational
// Author: Daniil Yugoslavskiy, oscd.community
// Date: 2020-10-19
// Tags: attack.discovery, attack.t1083
// Description: Detects usage of system utilities to discover files and directories
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image = "/usr/bin/file") AND where(CommandLine /(.){200,}/)) OR (where(Image = "/usr/bin/find")) OR (where(Image = "/usr/bin/mdfind")) OR (where(Image = "/bin/ls") AND where(CommandLine ICONTAINS "-R")) OR 1=1)
