// Title: DNS Query To AzureWebsites.NET By Non-Browser Process
// ID: e043f529-8514-4205-8ab0-7f7d2927b400
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects a DNS query by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(QueryName IENDSWITH "azurewebsites.net")) AND NOT ((((where(Image ISTARTSWITH "C:\\Program Files (x86)\\Avant Browser\\") OR where(Image ISTARTSWITH "C:\\Program Files\\Avant Browser\\")) AND where(Image IENDSWITH "\\avant.exe")) OR (where(Image IENDSWITH "\\brave.exe") AND where(Image ISTARTSWITH "C:\\Program Files\\BraveSoftware\\")) OR ((where(Image = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe") OR where(Image = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe"))) OR ((where(Image IENDSWITH "\\MsMpEng.exe") OR where(Image IENDSWITH "\\MsSense.exe"))) OR ((where(Image ISTARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\")) OR (where(Image IENDSWITH "\\WindowsApps\\MicrosoftEdge.exe")) OR ((where(Image = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe") OR where(Image = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe")))) OR ((where(Image ISTARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\") OR where(Image ISTARTSWITH "C:\\Program Files\\Microsoft\\EdgeCore\\")) AND (where(Image IENDSWITH "\\msedge.exe") OR where(Image IENDSWITH "\\msedgewebview2.exe"))) OR ((where(Image ISTARTSWITH "C:\\Program Files\\Falkon\\") OR where(Image ISTARTSWITH "C:\\Program Files (x86)\\Falkon\\")) AND where(Image IENDSWITH "\\falkon.exe")) OR ((where(Image = "C:\\Program Files\\Mozilla Firefox\\firefox.exe") OR where(Image = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe"))) OR (where(Image ICONTAINS "\\AppData\\Local\\Flock\\") AND where(Image IENDSWITH "\\Flock.exe")) OR ((where(Image = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe") OR where(Image = "C:\\Program Files\\Internet Explorer\\iexplore.exe"))) OR (where(Image ICONTAINS "\\AppData\\Local\\Maxthon\\") AND where(Image IENDSWITH "\\maxthon.exe")) OR (where(Image ICONTAINS "\\AppData\\Local\\Programs\\midori-ng\\") AND where(Image IENDSWITH "\\Midori Next Generation.exe")) OR (where(Image ICONTAINS "\\AppData\\Local\\Programs\\Opera\\") AND where(Image IENDSWITH "\\opera.exe")) OR (where(Image ICONTAINS "\\AppData\\Local\\Phoebe\\") AND where(Image IENDSWITH "\\Phoebe.exe")) OR (where(Image IENDSWITH "\\safari.exe")) OR ((where(Image ISTARTSWITH "C:\\Program Files\\SeaMonkey\\") OR where(Image ISTARTSWITH "C:\\Program Files (x86)\\SeaMonkey\\")) AND where(Image IENDSWITH "\\seamonkey.exe")) OR ((where(Image ISTARTSWITH "C:\\Program Files\\SlimBrowser\\") OR where(Image ISTARTSWITH "C:\\Program Files (x86)\\SlimBrowser\\")) AND where(Image IENDSWITH "\\slimbrowser.exe")) OR (where(Image ICONTAINS "\\Tor Browser\\")) OR (where(Image ICONTAINS "\\AppData\\Local\\Vivaldi\\") AND where(Image IENDSWITH "\\vivaldi.exe")) OR ((where(Image ISTARTSWITH "C:\\Program Files\\Naver\\Naver Whale\\") OR where(Image ISTARTSWITH "C:\\Program Files (x86)\\Naver\\Naver Whale\\")) AND where(Image IENDSWITH "\\whale.exe")) OR ((where(Image ISTARTSWITH "C:\\Program Files\\Waterfox\\") OR where(Image ISTARTSWITH "C:\\Program Files (x86)\\Waterfox\\")) AND where(Image IENDSWITH "\\Waterfox.exe")))))
