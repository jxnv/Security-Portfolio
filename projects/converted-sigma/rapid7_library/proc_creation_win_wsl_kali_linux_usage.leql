// Title: WSL Kali-Linux Usage
// ID: 6f1a11aa-4b8a-4b7f-9e13-4d3e4ff0e0d4
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-10-10
// Tags: attack.stealth, attack.t1202
// Description: Detects the use of Kali Linux through Windows Subsystem for Linux
// Converted by: Sigma Universal SIEM/EDR CLI

(((((where(Image ICONTAINS ":\\Users\\") AND where(Image ICONTAINS "\\AppData\\Local\\packages\\KaliLinux"))) OR ((where(Image ICONTAINS ":\\Users\\") AND where(Image ICONTAINS "\\AppData\\Local\\Microsoft\\WindowsApps\\kali.exe")))) OR (where(Image ICONTAINS ":\\Program Files\\WindowsApps\\KaliLinux.") AND where(Image IENDSWITH "\\kali.exe"))) OR (((((where(Image ICONTAINS "\\kali.exe") OR where(Image ICONTAINS "\\KaliLinux"))) OR ((where(CommandLine ICONTAINS "Kali.exe") OR where(CommandLine ICONTAINS "Kali-linux") OR where(CommandLine ICONTAINS "kalilinux")))) AND ((where(ParentImage IENDSWITH "\\wsl.exe") OR where(ParentImage IENDSWITH "\\wslhost.exe")))) AND NOT (((where(CommandLine ICONTAINS " -i ") OR where(CommandLine ICONTAINS " --install ") OR where(CommandLine ICONTAINS " --unregister "))))))
