// Title: Suspicious Modification Of Scheduled Tasks
// ID: 1c0e41cd-21bb-4433-9acc-4a2cd6367b9b
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-28
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects when an attacker tries to modify an already existing scheduled tasks to run from a suspicious location
// Attackers can create a simple looking task in order to avoid detection on creation as it's often the most focused on
// Instead they modify the task after creation to include their malicious payload
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image IENDSWITH "\\schtasks.exe") AND (where(CommandLine ICONTAINS " /Change ") AND where(CommandLine ICONTAINS " /TN "))) AND ((where(CommandLine ICONTAINS "regsvr32") OR where(CommandLine ICONTAINS "rundll32") OR where(CommandLine ICONTAINS "cmd /c ") OR where(CommandLine ICONTAINS "cmd /k ") OR where(CommandLine ICONTAINS "cmd /r ") OR where(CommandLine ICONTAINS "cmd.exe /c ") OR where(CommandLine ICONTAINS "cmd.exe /k ") OR where(CommandLine ICONTAINS "cmd.exe /r ") OR where(CommandLine ICONTAINS "powershell") OR where(CommandLine ICONTAINS "mshta") OR where(CommandLine ICONTAINS "wscript") OR where(CommandLine ICONTAINS "cscript") OR where(CommandLine ICONTAINS "certutil") OR where(CommandLine ICONTAINS "bitsadmin") OR where(CommandLine ICONTAINS "bash.exe") OR where(CommandLine ICONTAINS "bash ") OR where(CommandLine ICONTAINS "scrcons") OR where(CommandLine ICONTAINS "wmic ") OR where(CommandLine ICONTAINS "wmic.exe") OR where(CommandLine ICONTAINS "forfiles") OR where(CommandLine ICONTAINS "scriptrunner") OR where(CommandLine ICONTAINS "hh.exe") OR where(CommandLine ICONTAINS "hh "))) AND ((where(CommandLine ICONTAINS "\\AppData\\Local\\Temp") OR where(CommandLine ICONTAINS "\\AppData\\Roaming\\") OR where(CommandLine ICONTAINS "\\Users\\Public\\") OR where(CommandLine ICONTAINS "\\WINDOWS\\Temp\\") OR where(CommandLine ICONTAINS "\\Desktop\\") OR where(CommandLine ICONTAINS "\\Downloads\\") OR where(CommandLine ICONTAINS "\\Temporary Internet") OR where(CommandLine ICONTAINS "C:\\ProgramData\\") OR where(CommandLine ICONTAINS "C:\\Perflogs\\") OR where(CommandLine ICONTAINS "%ProgramData%") OR where(CommandLine ICONTAINS "%appdata%") OR where(CommandLine ICONTAINS "%comspec%") OR where(CommandLine ICONTAINS "%localappdata%"))))
