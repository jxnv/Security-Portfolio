// Title: Uncommon Process Access Rights For Target Image
// ID: a24e5861-c6ca-4fde-a93c-ba9256feddf0
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems), frack113
// Date: 2024-05-27
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055.011
// Description: Detects process access request to uncommon target images with a "PROCESS_ALL_ACCESS" access mask.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(TargetImage IENDSWITH "\\calc.exe") OR where(TargetImage IENDSWITH "\\calculator.exe") OR where(TargetImage IENDSWITH "\\mspaint.exe") OR where(TargetImage IENDSWITH "\\notepad.exe") OR where(TargetImage IENDSWITH "\\ping.exe") OR where(TargetImage IENDSWITH "\\wordpad.exe") OR where(TargetImage IENDSWITH "\\write.exe")) AND where(GrantedAccess = "0x1FFFFF"))
