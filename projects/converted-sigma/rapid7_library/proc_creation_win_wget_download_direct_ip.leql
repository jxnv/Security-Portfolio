// Title: Suspicious File Download From IP Via Wget.EXE
// ID: 17f0c0a8-8bd5-4ee0-8c5f-a342c0199f35
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-07-27
// Tags: attack.execution
// Description: Detects potentially suspicious file downloads directly from IP addresses using Wget.exe
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine IENDSWITH ".ps1") OR where(CommandLine IENDSWITH ".ps1'") OR where(CommandLine IENDSWITH ".ps1\"") OR where(CommandLine IENDSWITH ".dat") OR where(CommandLine IENDSWITH ".dat'") OR where(CommandLine IENDSWITH ".dat\"") OR where(CommandLine IENDSWITH ".msi") OR where(CommandLine IENDSWITH ".msi'") OR where(CommandLine IENDSWITH ".msi\"") OR where(CommandLine IENDSWITH ".bat") OR where(CommandLine IENDSWITH ".bat'") OR where(CommandLine IENDSWITH ".bat\"") OR where(CommandLine IENDSWITH ".exe") OR where(CommandLine IENDSWITH ".exe'") OR where(CommandLine IENDSWITH ".exe\"") OR where(CommandLine IENDSWITH ".vbs") OR where(CommandLine IENDSWITH ".vbs'") OR where(CommandLine IENDSWITH ".vbs\"") OR where(CommandLine IENDSWITH ".vbe") OR where(CommandLine IENDSWITH ".vbe'") OR where(CommandLine IENDSWITH ".vbe\"") OR where(CommandLine IENDSWITH ".hta") OR where(CommandLine IENDSWITH ".hta'") OR where(CommandLine IENDSWITH ".hta\"") OR where(CommandLine IENDSWITH ".dll") OR where(CommandLine IENDSWITH ".dll'") OR where(CommandLine IENDSWITH ".dll\"") OR where(CommandLine IENDSWITH ".psm1") OR where(CommandLine IENDSWITH ".psm1'") OR where(CommandLine IENDSWITH ".psm1\""))) AND ((where(CommandLine /\s-O\s/)) OR (where(CommandLine ICONTAINS "--output-document"))) AND (where(CommandLine ICONTAINS "http")) AND ((where(Image IENDSWITH "\\wget.exe")) OR (where(OriginalFileName = "wget.exe"))) AND (where(CommandLine /://[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}/)))
