// Tags: attack.execution, attack.privilege-escalation, attack.t1548.002
// Description: Detects the "IDiagnosticProfileUAC" UAC bypass technique
// Converted by: Sigma Universal SIEM/EDR CLI

(where(ParentImage IENDSWITH "\\DllHost.exe") AND where(ParentCommandLine ICONTAINS " /Processid:{12C21EA7-2EB8-4B55-9249-AC243DA8C666}") AND (where(IntegrityLevel = "High") OR where(IntegrityLevel = "System") OR where(IntegrityLevel = "S-1-16-16384") OR where(IntegrityLevel = "S-1-16-12288")))
