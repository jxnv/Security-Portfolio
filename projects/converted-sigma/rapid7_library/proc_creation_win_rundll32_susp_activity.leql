mandLine ICONTAINS "http"))) OR ((where(CommandLine ICONTAINS "shimgvw.dll") AND where(CommandLine ICONTAINS "ImageView_Fullscreen") AND where(CommandLine ICONTAINS "http"))) OR ((where(CommandLine ICONTAINS "comsvcs.dll") AND where(CommandLine ICONTAINS "MiniDump")))) AND NOT (((where(ParentImage = "C:\\Windows\\System32\\control.exe") AND where(ParentCommandLine ICONTAINS ".cpl") AND (where(CommandLine ICONTAINS "Shell32.dll") AND where(CommandLine ICONTAINS "Control_RunDLL") AND where(CommandLine ICONTAINS ".cpl"))) OR (where(CommandLine ICONTAINS "shell32.dll,Control_RunDLL desk.cpl,screensaver,@screensaver")) OR (where(ParentImage = "C:\\Windows\\System32\\control.exe") AND where(CommandLine ISTARTSWITH "\"C:\\Windows\\system32\\rundll32.exe\" Shell32.dll,Control_RunDLL \"C:\\Windows\\System32\\") AND where(CommandLine IENDSWITH ".cpl\",")))))
