// Title: Potential Dosfuscation Activity
// ID: a77c1610-fc73-4019-8e29-0f51efc04a51
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-02-15
// Tags: attack.execution, attack.t1059
// Description: Detects possible payload obfuscation via the commandline
// Converted by: Sigma Universal SIEM/EDR CLI

((where(CommandLine ICONTAINS "^^") OR where(CommandLine ICONTAINS "^|^") OR where(CommandLine ICONTAINS ",;,") OR where(CommandLine ICONTAINS ";;;;") OR where(CommandLine ICONTAINS ";; ;;") OR where(CommandLine ICONTAINS "(,(,") OR where(CommandLine ICONTAINS "%COMSPEC:~") OR where(CommandLine ICONTAINS " c^m^d") OR where(CommandLine ICONTAINS "^c^m^d") OR where(CommandLine ICONTAINS " c^md") OR where(CommandLine ICONTAINS " cm^d") OR where(CommandLine ICONTAINS "^cm^d") OR where(CommandLine ICONTAINS " s^et ") OR where(CommandLine ICONTAINS " s^e^t ") OR where(CommandLine ICONTAINS " se^t ")))
