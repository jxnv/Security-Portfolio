// Title: New Port Forwarding Rule Added Via Netsh.EXE
// ID: 322ed9ec-fcab-4f67-9a34-e7c6aef43614
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), omkar72, oscd.community, Swachchhanda Shrawan Poudel
// Date: 2019-01-29
// Tags: attack.lateral-movement, attack.command-and-control, attack.t1090
// Description: Detects the execution of netsh commands that configure a new port forwarding (PortProxy) rule
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "\\netsh.exe")) OR (where(OriginalFileName = "netsh.exe"))) AND (((where(CommandLine ICONTAINS "interface") AND where(CommandLine ICONTAINS "portproxy") AND where(CommandLine ICONTAINS "add") AND where(CommandLine ICONTAINS "v4tov4"))) OR ((where(CommandLine ICONTAINS "i ") AND where(CommandLine ICONTAINS "p ") AND where(CommandLine ICONTAINS "a ") AND where(CommandLine ICONTAINS "v "))) OR ((where(CommandLine ICONTAINS "connectp") AND where(CommandLine ICONTAINS "listena") AND where(CommandLine ICONTAINS "c=")))))
