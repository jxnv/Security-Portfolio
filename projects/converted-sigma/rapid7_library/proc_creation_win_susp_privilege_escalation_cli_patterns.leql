// Title: Suspicious RunAs-Like Flag Combination
// ID: 50d66fb0-03f8-4da0-8add-84e77d12a020
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-11-11
// Tags: attack.privilege-escalation
// Description: Detects suspicious command line flags that let the user set a target user and command as e.g. seen in PsExec-like tools
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS " -c cmd") OR where(CommandLine ICONTAINS " -c \"cmd") OR where(CommandLine ICONTAINS " -c powershell") OR where(CommandLine ICONTAINS " -c \"powershell") OR where(CommandLine ICONTAINS " --command cmd") OR where(CommandLine ICONTAINS " --command powershell") OR where(CommandLine ICONTAINS " -c whoami") OR where(CommandLine ICONTAINS " -c wscript") OR where(CommandLine ICONTAINS " -c cscript"))) AND ((where(CommandLine ICONTAINS " -u system ") OR where(CommandLine ICONTAINS " --user system ") OR where(CommandLine ICONTAINS " -u NT") OR where(CommandLine ICONTAINS " -u \"NT") OR where(CommandLine ICONTAINS " -u 'NT") OR where(CommandLine ICONTAINS " --system ") OR where(CommandLine ICONTAINS " -u administrator "))))
