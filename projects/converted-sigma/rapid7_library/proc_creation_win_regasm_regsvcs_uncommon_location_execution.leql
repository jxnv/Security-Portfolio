// Title: Potentially Suspicious Execution Of Regasm/Regsvcs From Uncommon Location
// ID: cc368ed0-2411-45dc-a222-510ace303cb2
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-25
// Tags: attack.stealth, attack.t1218.009
// Description: Detects potentially suspicious execution of the Regasm/Regsvcs utilities from a potentially suspicious location
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "\\AppData\\Local\\Temp\\") OR where(CommandLine ICONTAINS "\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\") OR where(CommandLine ICONTAINS "\\PerfLogs\\") OR where(CommandLine ICONTAINS "\\Users\\Public\\") OR where(CommandLine ICONTAINS "\\Windows\\Temp\\"))) AND (((where(Image IENDSWITH "\\Regsvcs.exe") OR where(Image IENDSWITH "\\Regasm.exe"))) OR ((where(OriginalFileName = "RegSvcs.exe") OR where(OriginalFileName = "RegAsm.exe")))))
