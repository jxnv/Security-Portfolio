// Title: PUA - PingCastle Execution From Potentially Suspicious Parent
// ID: b37998de-a70b-4f33-b219-ec36bf433dc0
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2024-01-11
// Tags: attack.reconnaissance, attack.t1595
// Description: Detects the execution of PingCastle, a tool designed to quickly assess the Active Directory security level via a script located in a potentially suspicious or uncommon location.
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(ParentCommandLine ICONTAINS ".bat") OR where(ParentCommandLine ICONTAINS ".chm") OR where(ParentCommandLine ICONTAINS ".cmd") OR where(ParentCommandLine ICONTAINS ".hta") OR where(ParentCommandLine ICONTAINS ".htm") OR where(ParentCommandLine ICONTAINS ".html") OR where(ParentCommandLine ICONTAINS ".js") OR where(ParentCommandLine ICONTAINS ".lnk") OR where(ParentCommandLine ICONTAINS ".ps1") OR where(ParentCommandLine ICONTAINS ".vbe") OR where(ParentCommandLine ICONTAINS ".vbs") OR where(ParentCommandLine ICONTAINS ".wsf"))) OR ((where(ParentCommandLine ICONTAINS ":\\Perflogs\\") OR where(ParentCommandLine ICONTAINS ":\\Temp\\") OR where(ParentCommandLine ICONTAINS ":\\Users\\Public\\") OR where(ParentCommandLine ICONTAINS ":\\Windows\\Temp\\") OR where(ParentCommandLine ICONTAINS "\\AppData\\Local\\Temp") OR where(ParentCommandLine ICONTAINS "\\AppData\\Roaming\\") OR where(ParentCommandLine ICONTAINS "\\Temporary Internet"))) OR (((where(ParentCommandLine ICONTAINS ":\\Users\\") AND where(ParentCommandLine ICONTAINS "\\Favorites\\"))) OR ((where(ParentCommandLine ICONTAINS ":\\Users\\") AND where(ParentCommandLine ICONTAINS "\\Favourites\\"))) OR ((where(ParentCommandLine ICONTAINS ":\\Users\\") AND where(ParentCommandLine ICONTAINS "\\Contacts\\"))))) AND ((where(ParentCommandLine ICONTAINS ".bat") OR where(ParentCommandLine ICONTAINS ".chm") OR where(ParentCommandLine ICONTAINS ".cmd") OR where(ParentCommandLine ICONTAINS ".hta") OR where(ParentCommandLine ICONTAINS ".htm") OR where(ParentCommandLine ICONTAINS ".html") OR where(ParentCommandLine ICONTAINS ".js") OR where(ParentCommandLine ICONTAINS ".lnk") OR where(ParentCommandLine ICONTAINS ".ps1") OR where(ParentCommandLine ICONTAINS ".vbe") OR where(ParentCommandLine ICONTAINS ".vbs") OR where(ParentCommandLine ICONTAINS ".wsf"))) AND ((where(Image IENDSWITH "\\PingCastle.exe")) OR (where(OriginalFileName = "PingCastle.exe")) OR (where(Product = "Ping Castle")) OR ((where(CommandLine ICONTAINS "--scanner aclcheck") OR where(CommandLine ICONTAINS "--scanner antivirus") OR where(CommandLine ICONTAINS "--scanner computerversion") OR where(CommandLine ICONTAINS "--scanner foreignusers") OR where(CommandLine ICONTAINS "--scanner laps_bitlocker") OR where(CommandLine ICONTAINS "--scanner localadmin") OR where(CommandLine ICONTAINS "--scanner nullsession") OR where(CommandLine ICONTAINS "--scanner nullsession-trust") OR where(CommandLine ICONTAINS "--scanner oxidbindings") OR where(CommandLine ICONTAINS "--scanner remote") OR where(CommandLine ICONTAINS "--scanner share") OR where(CommandLine ICONTAINS "--scanner smb") OR where(CommandLine ICONTAINS "--scanner smb3querynetwork") OR where(CommandLine ICONTAINS "--scanner spooler") OR where(CommandLine ICONTAINS "--scanner startup") OR where(CommandLine ICONTAINS "--scanner zerologon"))) OR (where(CommandLine ICONTAINS "--no-enum-limit")) OR ((where(CommandLine ICONTAINS "--healthcheck") AND where(CommandLine ICONTAINS "--level Full"))) OR ((where(CommandLine ICONTAINS "--healthcheck") AND where(CommandLine ICONTAINS "--server ")))))
