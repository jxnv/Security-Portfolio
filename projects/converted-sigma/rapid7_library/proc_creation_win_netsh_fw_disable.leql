// Title: Firewall Disabled via Netsh.EXE
// ID: 57c4bf16-227f-4394-8ec7-1b745ee061c3
// Status: test
// Level: medium
// Author: Fatih Sirin
// Date: 2019-11-01
// Tags: attack.defense-impairment, attack.t1686.003, attack.s0108
// Description: Detects netsh commands that turns off the Windows firewall
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "\\netsh.exe")) OR (where(OriginalFileName = "netsh.exe"))) AND (((where(CommandLine ICONTAINS "firewall") AND where(CommandLine ICONTAINS "set") AND where(CommandLine ICONTAINS "opmode") AND where(CommandLine ICONTAINS "disable"))) OR ((where(CommandLine ICONTAINS "advfirewall") AND where(CommandLine ICONTAINS "set") AND where(CommandLine ICONTAINS "state") AND where(CommandLine ICONTAINS "off")))))
