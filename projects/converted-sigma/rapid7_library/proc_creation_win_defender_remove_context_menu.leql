// Title: Windows Defender Context Menu Removed
// ID: b9e8c7d6-a5f4-4e3d-8b1a-9f0c8d7e6a5b
// Status: experimental
// Level: high
// Author: Matt Anderson (Huntress)
// Date: 2025-07-09
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects the use of reg.exe or PowerShell to delete the Windows Defender context menu handler registry keys.
// This action removes the "Scan with Microsoft Defender" option from the right-click menu for files, directories, and drives.
// Attackers may use this technique to hinder manual, on-demand scans and reduce the visibility of the security product.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "del") OR where(CommandLine ICONTAINS "Remove-Item") OR where(CommandLine ICONTAINS "ri "))) AND (((where(Image IENDSWITH "\\powershell_ise.exe") OR where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe") OR where(Image IENDSWITH "\\reg.exe"))) OR ((where(OriginalFileName = "powershell_ise.EXE") OR where(OriginalFileName = "PowerShell.EXE") OR where(OriginalFileName = "pwsh.dll") OR where(OriginalFileName = "reg.exe")))) AND (where(CommandLine ICONTAINS "\\shellex\\ContextMenuHandlers\\EPP")))
