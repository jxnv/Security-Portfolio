// Title: Execute From Alternate Data Streams
// ID: 7f43c430-5001-4f8b-aaa9-c3b88f18fa5c
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-09-01
// Tags: attack.stealth, attack.t1564.004
// Description: Detects execution from an Alternate Data Stream (ADS). Adversaries may use NTFS file attributes to hide their malicious data in order to evade detection
// Converted by: Sigma Universal SIEM/EDR CLI

((where(CommandLine ICONTAINS "txt:")) AND (((where(CommandLine ICONTAINS "esentutl ") AND where(CommandLine ICONTAINS " /y ") AND where(CommandLine ICONTAINS " /d ") AND where(CommandLine ICONTAINS " /o "))) OR ((where(CommandLine ICONTAINS "makecab ") AND where(CommandLine ICONTAINS ".cab"))) OR ((where(CommandLine ICONTAINS "reg ") AND where(CommandLine ICONTAINS " export "))) OR ((where(CommandLine ICONTAINS "regedit ") AND where(CommandLine ICONTAINS " /E "))) OR ((where(CommandLine ICONTAINS "type ") AND where(CommandLine ICONTAINS " > ")))))
