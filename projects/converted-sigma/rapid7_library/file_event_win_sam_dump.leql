// Title: Potential SAM Database Dump
// ID: 4e87b8e2-2ee9-4b2a-a715-4727d297ece0
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-11
// Tags: attack.credential-access, attack.t1003.002
// Description: Detects the creation of files that look like exports of the local SAM (Security Account Manager)
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(TargetFilename IENDSWITH "\\Temp\\sam") OR where(TargetFilename IENDSWITH "\\sam.sav") OR where(TargetFilename IENDSWITH "\\Intel\\sam") OR where(TargetFilename IENDSWITH "\\sam.hive") OR where(TargetFilename IENDSWITH "\\Perflogs\\sam") OR where(TargetFilename IENDSWITH "\\ProgramData\\sam") OR where(TargetFilename IENDSWITH "\\Users\\Public\\sam") OR where(TargetFilename IENDSWITH "\\AppData\\Local\\sam") OR where(TargetFilename IENDSWITH "\\AppData\\Roaming\\sam") OR where(TargetFilename IENDSWITH "_ShadowSteal.zip") OR where(TargetFilename IENDSWITH "\\Documents\\SAM.export") OR where(TargetFilename IENDSWITH ":\\sam"))) OR ((where(TargetFilename ICONTAINS "\\hive_sam_") OR where(TargetFilename ICONTAINS "\\sam.save") OR where(TargetFilename ICONTAINS "\\sam.export") OR where(TargetFilename ICONTAINS "\\~reg_sam.save") OR where(TargetFilename ICONTAINS "\\sam_backup") OR where(TargetFilename ICONTAINS "\\sam.bck") OR where(TargetFilename ICONTAINS "\\sam.backup"))))
