// Title: Suspicious Workstation Locking via Rundll32
// ID: 3b5b0213-0460-4e3f-8937-3abf98ff7dcc
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-06-04
// Tags: attack.stealth
// Description: Detects a suspicious call to the user32.dll function that locks the user workstation
// Converted by: Sigma Universal SIEM/EDR CLI

((where(CommandLine ICONTAINS "user32.dll,")) AND ((where(Image IENDSWITH "\\rundll32.exe")) OR (where(OriginalFileName = "RUNDLL32.EXE"))) AND (where(ParentImage IENDSWITH "\\cmd.exe")) AND (where(CommandLine ICONTAINS "LockWorkStation")))
