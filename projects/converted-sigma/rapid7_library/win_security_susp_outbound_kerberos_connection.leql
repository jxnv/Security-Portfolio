// Title: Uncommon Outbound Kerberos Connection - Security
// ID: eca91c7c-9214-47b9-b4c5-cb1d7e4f2350
// Status: test
// Level: medium
// Author: Ilyas Ochkov, oscd.community
// Date: 2019-10-24
// Tags: attack.lateral-movement, attack.credential-access, attack.t1558.003
// Description: Detects uncommon outbound network activity via Kerberos default port indicating possible lateral movement or first stage PrivEsc via delegation.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(EventID = "5156") AND where(DestPort = "88")) AND NOT (((where(Application ISTARTSWITH "\\device\\harddiskvolume") OR where(Application ISTARTSWITH "C:")) AND where(Application IENDSWITH "\\Windows\\System32\\lsass.exe"))) AND NOT ((((where(Application ISTARTSWITH "\\device\\harddiskvolume") OR where(Application ISTARTSWITH "C:")) AND (where(Application IENDSWITH "\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe") OR where(Application IENDSWITH "\\Program Files\\Google\\Chrome\\Application\\chrome.exe"))) OR ((where(Application ISTARTSWITH "\\device\\harddiskvolume") OR where(Application ISTARTSWITH "C:")) AND (where(Application IENDSWITH "\\Program Files (x86)\\Mozilla Firefox\\firefox.exe") OR where(Application IENDSWITH "\\Program Files\\Mozilla Firefox\\firefox.exe"))) OR (where(Application IENDSWITH "\\tomcat\\bin\\tomcat8.exe")))))
