// Title: Suspicious Browser Child Process - MacOS
// ID: 0250638a-2b28-4541-86fc-ea4c558fa0c6
// Status: test
// Level: medium
// Author: Sohan G (D4rkCiph3r)
// Date: 2023-04-05
// Tags: attack.initial-access, attack.execution, attack.t1189, attack.t1203, attack.t1059
// Description: Detects suspicious child processes spawned from browsers. This could be a result of a potential web browser exploitation.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(ParentImage ICONTAINS "com.apple.WebKit.WebContent") OR where(ParentImage ICONTAINS "firefox") OR where(ParentImage ICONTAINS "Google Chrome Helper") OR where(ParentImage ICONTAINS "Google Chrome") OR where(ParentImage ICONTAINS "Microsoft Edge") OR where(ParentImage ICONTAINS "Opera") OR where(ParentImage ICONTAINS "Safari") OR where(ParentImage ICONTAINS "Tor Browser")) AND (where(Image IENDSWITH "/bash") OR where(Image IENDSWITH "/curl") OR where(Image IENDSWITH "/dash") OR where(Image IENDSWITH "/ksh") OR where(Image IENDSWITH "/osascript") OR where(Image IENDSWITH "/perl") OR where(Image IENDSWITH "/php") OR where(Image IENDSWITH "/pwsh") OR where(Image IENDSWITH "/python") OR where(Image IENDSWITH "/sh") OR where(Image IENDSWITH "/tcsh") OR where(Image IENDSWITH "/wget") OR where(Image IENDSWITH "/zsh"))) AND NOT ((((where(ParentImage ICONTAINS "Google Chrome Helper") OR where(ParentImage ICONTAINS "Google Chrome")) AND (where(CommandLine ICONTAINS "/Volumes/Google Chrome/Google Chrome.app/Contents/Frameworks/*/Resources/install.sh") OR where(CommandLine ICONTAINS "/Applications/Google Chrome.app/Contents/Frameworks/Google Chrome Framework.framework/*/Resources/keystone_promote_preflight.sh") OR where(CommandLine ICONTAINS "/Applications/Google Chrome.app/Contents/Frameworks/Google Chrome Framework.framework/*/Resources/keystone_promote_postflight.sh"))) OR ((where(ParentImage ICONTAINS "Google Chrome Helper") OR where(ParentImage ICONTAINS "Google Chrome")) AND (where(CommandLine ICONTAINS "/Users/") AND where(CommandLine ICONTAINS "/Library/Application Support/Google/Chrome/recovery/") AND where(CommandLine ICONTAINS "/ChromeRecovery"))) OR (where(CommandLine ICONTAINS "--defaults-torrc")) OR (where(CommandLine ICONTAINS "/Library/Application Support/Microsoft/MAU*/Microsoft AutoUpdate.app/Contents/MacOS/msupdate")) OR (where(ParentImage ICONTAINS "Microsoft Edge") AND (where(CommandLine ICONTAINS "IOPlatformExpertDevice") OR where(CommandLine ICONTAINS "hw.model"))))) AND NOT (((where(CommandLine = "")) OR (NOT CommandLine=*))))
