// Title: File Download Via Nscurl - MacOS
// ID: 6d8a7cf1-8085-423b-b87d-7e880faabbdf
// Status: test
// Level: medium
// Author: Daniel Cortez
// Date: 2024-06-04
// Tags: attack.command-and-control, attack.t1105
// Description: Detects the execution of the nscurl utility in order to download files.
// Converted by: Sigma Universal SIEM/EDR CLI

(where(Image IENDSWITH "/nscurl") AND (where(CommandLine ICONTAINS "--download ") OR where(CommandLine ICONTAINS "--download-directory ") OR where(CommandLine ICONTAINS "--output ") OR where(CommandLine ICONTAINS "-dir ") OR where(CommandLine ICONTAINS "-dl ") OR where(CommandLine ICONTAINS "-ld") OR where(CommandLine ICONTAINS "-o ")))
