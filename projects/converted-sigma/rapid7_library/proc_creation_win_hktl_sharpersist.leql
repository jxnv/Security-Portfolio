// Title: HackTool - SharPersist Execution
// ID: 26488ad0-f9fd-4536-876f-52fea846a2e4
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-09-15
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053
// Description: Detects the execution of the hacktool SharPersist - used to deploy various different kinds of persistence mechanisms
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS " -t schtask -c ") OR where(CommandLine ICONTAINS " -t startupfolder -c "))) OR ((where(CommandLine ICONTAINS " -t reg -c ") AND where(CommandLine ICONTAINS " -m add"))) OR ((where(CommandLine ICONTAINS " -t service -c ") AND where(CommandLine ICONTAINS " -m add"))) OR ((where(CommandLine ICONTAINS " -t schtask -c ") AND where(CommandLine ICONTAINS " -m add"))) OR ((where(Image IENDSWITH "\\SharPersist.exe")) OR (where(Product = "SharPersist"))))
