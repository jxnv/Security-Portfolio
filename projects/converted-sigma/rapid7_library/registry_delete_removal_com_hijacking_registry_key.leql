// Title: Removal of Potential COM Hijacking Registry Keys
// ID: 96f697b0-b499-4e5d-9908-a67bec11cdb6
// Status: test
// Level: medium
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2020-05-02
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects any deletion of entries in ".*\shell\open\command" registry keys.
// These registry keys might have been used for COM hijacking activities by a threat actor or an attacker and the deletion could indicate steps to remove its tracks.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(TargetObject IENDSWITH "\\shell\\open\\command")) AND NOT (((where(Image IENDSWITH "C:\\Windows\\explorer.exe")) OR ((where(Image ISTARTSWITH "C:\\Program Files\\") OR where(Image ISTARTSWITH "C:\\Program Files (x86)\\"))) OR ((where(Image = "C:\\Windows\\System32\\msiexec.exe") OR where(Image = "C:\\Windows\\SysWOW64\\msiexec.exe"))) OR (where(Image = "C:\\Windows\\System32\\OpenWith.exe")) OR (where(Image = "C:\\Windows\\system32\\svchost.exe")))) AND NOT ((((where(Image = "C:\\Program Files (x86)\\Avira\\Antivirus\\") OR where(Image = "C:\\Program Files\\Avira\\Antivirus\\")) AND (where(TargetObject IENDSWITH "\\CLSID\\{305CA226-D286-468e-B848-2B2E8E697B74}\\Shell\\Open\\Command") OR where(TargetObject IENDSWITH "\\AntiVir.Keyfile\\shell\\open\\command"))) OR (where(Image IENDSWITH "\\reg.exe") AND where(TargetObject IENDSWITH "\\Discord\\shell\\open\\command")) OR (where(Image IENDSWITH "\\Dropbox.exe") AND where(TargetObject ICONTAINS "\\Dropbox.")) OR (where(Image IENDSWITH "C:\\eclipse\\eclipse.exe") AND where(TargetObject ICONTAINS "_Classes\\eclipse+")) OR (where(Image ICONTAINS "\\Microsoft\\EdgeUpdate\\Install")) OR (where(Image IENDSWITH "\\Everything.exe") AND where(TargetObject ICONTAINS "\\Everything.")) OR (((where(Image ICONTAINS "AppData\\Local\\Temp") AND where(Image ICONTAINS "\\setup.exe"))) OR ((where(Image ICONTAINS "\\Temp\\is-") AND where(Image ICONTAINS "\\target.tmp")))) OR (where(Image ISTARTSWITH "C:\\Program Files (x86)\\Java\\") AND where(Image IENDSWITH "\\installer.exe") AND where(TargetObject ICONTAINS "\\Classes\\WOW6432Node\\CLSID\\{4299124F-F2C3-41b4-9C73-9236B2AD0E8F}")) OR (where(Image IENDSWITH "\\ninite.exe")) OR (where(Image ICONTAINS "peazip") AND where(TargetObject ICONTAINS "\\PeaZip.")) OR (where(Image IENDSWITH "\\Spotify.exe") AND where(TargetObject IENDSWITH "\\Spotify\\shell\\open\\command")) OR ((where(Image ICONTAINS "\\Temp") AND where(Image ICONTAINS "\\TeamViewer"))) OR (where(Image ISTARTSWITH "C:\\Windows\\Installer\\MSI")) OR (where(Image IENDSWITH "\\AppData\\Local\\Temp\\Wireshark_uninstaller.exe") AND where(TargetObject ICONTAINS "\\wireshark-capture-file\\")))))
