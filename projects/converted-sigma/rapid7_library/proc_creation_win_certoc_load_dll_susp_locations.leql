// Title: Suspicious DLL Loaded via CertOC.EXE
// ID: 84232095-ecca-4015-b0d7-7726507ee793
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-15
// Tags: attack.stealth, attack.t1218
// Description: Detects when a user installs certificates by using CertOC.exe to load the target DLL file.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(CommandLine ICONTAINS " -LoadDLL ")) AND ((where(Image IENDSWITH "\\certoc.exe")) OR (where(OriginalFileName = "CertOC.exe"))) AND ((where(CommandLine ICONTAINS "\\Appdata\\Local\\Temp\\") OR where(CommandLine ICONTAINS "\\Desktop\\") OR where(CommandLine ICONTAINS "\\Downloads\\") OR where(CommandLine ICONTAINS "\\Users\\Public\\") OR where(CommandLine ICONTAINS "C:\\Windows\\Tasks\\") OR where(CommandLine ICONTAINS "C:\\Windows\\Temp\\"))))
