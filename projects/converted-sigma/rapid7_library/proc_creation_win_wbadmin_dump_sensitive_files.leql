// Title: Sensitive File Dump Via Wbadmin.EXE
// ID: 8b93a509-1cb8-42e1-97aa-ee24224cdc15
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), frack113
// Date: 2024-05-10
// Tags: attack.credential-access, attack.t1003.003
// Description: Detects the dump of highly sensitive files such as "NTDS.DIT" and "SECURITY" hive.
// Attackers can leverage the "wbadmin" utility in order to dump sensitive files that might contain credential or sensitive information.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "start") OR where(CommandLine ICONTAINS "backup"))) AND ((where(Image IENDSWITH "\\wbadmin.exe")) OR (where(OriginalFileName = "WBADMIN.EXE"))) AND ((where(CommandLine ICONTAINS "\\config\\SAM") OR where(CommandLine ICONTAINS "\\config\\SECURITY") OR where(CommandLine ICONTAINS "\\config\\SYSTEM") OR where(CommandLine ICONTAINS "\\Windows\\NTDS\\NTDS.dit"))))
