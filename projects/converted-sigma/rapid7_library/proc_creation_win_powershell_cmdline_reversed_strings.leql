// Title: Potential PowerShell Obfuscation Via Reversed Commands
// ID: b6b49cd1-34d6-4ead-b1bf-176e9edba9a4
// Status: test
// Level: high
// Author: Teymur Kheirkhabarov (idea), Vasiliy Burov (rule), oscd.community, Tim Shelton
// Date: 2020-10-11
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects the presence of reversed PowerShell commands in the CommandLine. This is often used as a method of obfuscation by attackers
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(CommandLine ICONTAINS "hctac") OR where(CommandLine ICONTAINS "kaerb") OR where(CommandLine ICONTAINS "dnammoc") OR where(CommandLine ICONTAINS "ekovn") OR where(CommandLine ICONTAINS "eliFd") OR where(CommandLine ICONTAINS "rahc") OR where(CommandLine ICONTAINS "etirw") OR where(CommandLine ICONTAINS "golon") OR where(CommandLine ICONTAINS "tninon") OR where(CommandLine ICONTAINS "eddih") OR where(CommandLine ICONTAINS "tpircS") OR where(CommandLine ICONTAINS "ssecorp") OR where(CommandLine ICONTAINS "llehsrewop") OR where(CommandLine ICONTAINS "esnopser") OR where(CommandLine ICONTAINS "daolnwod") OR where(CommandLine ICONTAINS "tneilCbeW") OR where(CommandLine ICONTAINS "tneilc") OR where(CommandLine ICONTAINS "ptth") OR where(CommandLine ICONTAINS "elifotevas") OR where(CommandLine ICONTAINS "46esab") OR where(CommandLine ICONTAINS "htaPpmeTteG") OR where(CommandLine ICONTAINS "tcejbO") OR where(CommandLine ICONTAINS "maerts") OR where(CommandLine ICONTAINS "hcaerof") OR where(CommandLine ICONTAINS "retupmoc"))) AND (((where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe"))) OR ((where(OriginalFileName = "PowerShell.EXE") OR where(OriginalFileName = "pwsh.dll"))))) AND NOT (((where(CommandLine ICONTAINS " -EncodedCommand ") OR where(CommandLine ICONTAINS " -enc ")))))
