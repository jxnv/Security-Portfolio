// Title: Suspicious Download From File-Sharing Website Via Bitsadmin
// ID: 8518ed3d-f7c9-4601-a26c-f361a4256a0c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-06-28
// Tags: attack.persistence, attack.execution, attack.stealth, attack.t1197, attack.s0190, attack.t1036.003, attack.command-and-control, attack.t1105
// Description: Detects usage of bitsadmin downloading a file from a suspicious domain
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS ".githubusercontent.com") OR where(CommandLine ICONTAINS "0x0.st") OR where(CommandLine ICONTAINS "anonfiles.com") OR where(CommandLine ICONTAINS "bashupload.com") OR where(CommandLine ICONTAINS "cdn.discordapp.com") OR where(CommandLine ICONTAINS "chunk.io") OR where(CommandLine ICONTAINS "ddns.net") OR where(CommandLine ICONTAINS "dl.dropboxusercontent.com") OR where(CommandLine ICONTAINS "ghostbin.co") OR where(CommandLine ICONTAINS "github.com") OR where(CommandLine ICONTAINS "glitch.me") OR where(CommandLine ICONTAINS "gofile.io") OR where(CommandLine ICONTAINS "hastebin.com") OR where(CommandLine ICONTAINS "mediafire.com") OR where(CommandLine ICONTAINS "mega.nz") OR where(CommandLine ICONTAINS "onrender.com") OR where(CommandLine ICONTAINS "pages.dev") OR where(CommandLine ICONTAINS "paste.ee") OR where(CommandLine ICONTAINS "pastebin.com") OR where(CommandLine ICONTAINS "pastebin.pl") OR where(CommandLine ICONTAINS "pastetext.net") OR where(CommandLine ICONTAINS "privatlab.com") OR where(CommandLine ICONTAINS "privatlab.net") OR where(CommandLine ICONTAINS "send.exploit.in") OR where(CommandLine ICONTAINS "sendspace.com") OR where(CommandLine ICONTAINS "storage.googleapis.com") OR where(CommandLine ICONTAINS "storjshare.io") OR where(CommandLine ICONTAINS "supabase.co") OR where(CommandLine ICONTAINS "temp.sh") OR where(CommandLine ICONTAINS "transfer.sh") OR where(CommandLine ICONTAINS "trycloudflare.com") OR where(CommandLine ICONTAINS "ufile.io") OR where(CommandLine ICONTAINS "w3spaces.com") OR where(CommandLine ICONTAINS "workers.dev") OR where(CommandLine ICONTAINS "x0.at"))) AND ((where(CommandLine ICONTAINS " /transfer ") OR where(CommandLine ICONTAINS " /create ") OR where(CommandLine ICONTAINS " /addfile "))) AND ((where(Image IENDSWITH "\\bitsadmin.exe")) OR (where(OriginalFileName = "bitsadmin.exe"))))
