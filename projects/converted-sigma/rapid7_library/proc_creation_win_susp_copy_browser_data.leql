// Title: Potential Browser Data Stealing
// ID: 47147b5b-9e17-4d76-b8d2-7bac24c5ce1b
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-23
// Tags: attack.credential-access, attack.t1555.003
// Description: Adversaries may acquire credentials from web browsers by reading files specific to the target browser.
// Web browsers commonly save credentials such as website usernames and passwords so that they do not need to be entered manually in the future.
// Web browsers typically store the credentials in an encrypted format within a credential store.
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(CommandLine ICONTAINS "copy-item") OR where(CommandLine ICONTAINS "copy ") OR where(CommandLine ICONTAINS "cpi ") OR where(CommandLine ICONTAINS " cp ") OR where(CommandLine ICONTAINS "move ") OR where(CommandLine ICONTAINS "move-item") OR where(CommandLine ICONTAINS " mi ") OR where(CommandLine ICONTAINS " mv "))) OR ((where(Image IENDSWITH "\\esentutl.exe") OR where(Image IENDSWITH "\\xcopy.exe") OR where(Image IENDSWITH "\\robocopy.exe"))) OR ((where(OriginalFileName = "esentutl.exe") OR where(OriginalFileName = "XCOPY.EXE") OR where(OriginalFileName = "robocopy.exe")))) AND ((where(CommandLine ICONTAINS "\\Amigo\\User Data") OR where(CommandLine ICONTAINS "\\BraveSoftware\\Brave-Browser\\User Data") OR where(CommandLine ICONTAINS "\\CentBrowser\\User Data") OR where(CommandLine ICONTAINS "\\Chromium\\User Data") OR where(CommandLine ICONTAINS "\\CocCoc\\Browser\\User Data") OR where(CommandLine ICONTAINS "\\Comodo\\Dragon\\User Data") OR where(CommandLine ICONTAINS "\\Elements Browser\\User Data") OR where(CommandLine ICONTAINS "\\Epic Privacy Browser\\User Data") OR where(CommandLine ICONTAINS "\\Google\\Chrome Beta\\User Data") OR where(CommandLine ICONTAINS "\\Google\\Chrome SxS\\User Data") OR where(CommandLine ICONTAINS "\\Google\\Chrome\\User Data\\") OR where(CommandLine ICONTAINS "\\Kometa\\User Data") OR where(CommandLine ICONTAINS "\\Maxthon5\\Users") OR where(CommandLine ICONTAINS "\\Microsoft\\Edge\\User Data") OR where(CommandLine ICONTAINS "\\Mozilla\\Firefox\\Profiles") OR where(CommandLine ICONTAINS "\\Nichrome\\User Data") OR where(CommandLine ICONTAINS "\\Opera Software\\Opera GX Stable\\") OR where(CommandLine ICONTAINS "\\Opera Software\\Opera Neon\\User Data") OR where(CommandLine ICONTAINS "\\Opera Software\\Opera Stable\\") OR where(CommandLine ICONTAINS "\\Orbitum\\User Data") OR where(CommandLine ICONTAINS "\\QIP Surf\\User Data") OR where(CommandLine ICONTAINS "\\Sputnik\\User Data") OR where(CommandLine ICONTAINS "\\Torch\\User Data") OR where(CommandLine ICONTAINS "\\uCozMedia\\Uran\\User Data") OR where(CommandLine ICONTAINS "\\Vivaldi\\User Data"))))
