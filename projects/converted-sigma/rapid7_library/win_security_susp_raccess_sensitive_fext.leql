// Title: Suspicious Access to Sensitive File Extensions
// ID: 91c945bc-2ad1-4799-a591-4d00198a1215
// Status: test
// Level: medium
// Author: Samir Bousseaden
// Date: 2019-04-03
// Tags: attack.collection, attack.t1039
// Description: Detects known sensitive file extensions accessed on a network share
// Converted by: Sigma Universal SIEM/EDR CLI

(where(EventID = "5145") AND (where(RelativeTargetName IENDSWITH ".bak") OR where(RelativeTargetName IENDSWITH ".dmp") OR where(RelativeTargetName IENDSWITH ".edb") OR where(RelativeTargetName IENDSWITH ".kirbi") OR where(RelativeTargetName IENDSWITH ".msg") OR where(RelativeTargetName IENDSWITH ".nsf") OR where(RelativeTargetName IENDSWITH ".nst") OR where(RelativeTargetName IENDSWITH ".oab") OR where(RelativeTargetName IENDSWITH ".ost") OR where(RelativeTargetName IENDSWITH ".pst") OR where(RelativeTargetName IENDSWITH ".rdp")))
