// Title: Suspicious Binary In User Directory Spawned From Office Application
// ID: aa3a6f94-890e-4e22-b634-ffdfd54792cc
// Status: test
// Level: high
// Author: Jason Lynch
// Date: 2019-04-02
// Tags: attack.execution, attack.t1204.002, attack.g0046, car.2013-05-002
// Description: Detects an executable in the users directory started from one of the Microsoft Office suite applications (Word, Excel, PowerPoint, Publisher, Visio)
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(ParentImage IENDSWITH "\\WINWORD.EXE") OR where(ParentImage IENDSWITH "\\EXCEL.EXE") OR where(ParentImage IENDSWITH "\\POWERPNT.exe") OR where(ParentImage IENDSWITH "\\MSPUB.exe") OR where(ParentImage IENDSWITH "\\VISIO.exe") OR where(ParentImage IENDSWITH "\\MSACCESS.exe") OR where(ParentImage IENDSWITH "\\EQNEDT32.exe")) AND where(Image ISTARTSWITH "C:\\users\\") AND where(Image IENDSWITH ".exe")) AND NOT ((where(Image IENDSWITH "\\Teams.exe"))))
