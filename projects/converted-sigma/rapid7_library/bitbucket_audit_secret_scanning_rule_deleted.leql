// Tags: attack.defense-impairment, attack.t1685
// Description: Detects when secret scanning rule is deleted for the project or repository.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(auditType.category = "Projects") OR where(auditType.category = "Repositories")) AND (where(auditType.action = "Project secret scanning rule deleted") OR where(auditType.action = "Repository secret scanning rule deleted")))
