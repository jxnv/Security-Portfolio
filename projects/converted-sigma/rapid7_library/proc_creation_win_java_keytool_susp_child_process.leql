// Title: Suspicious Shells Spawn by Java Utility Keytool
// ID: 90fb5e62-ca1f-4e22-b42e-cc521874c938
// Status: test
// Level: high
// Author: Andreas Hunkeler (@Karneades)
// Date: 2021-12-22
// Tags: attack.initial-access, attack.persistence, attack.privilege-escalation
// Description: Detects suspicious shell spawn from Java utility keytool process (e.g. adselfservice plus exploitation)
// Converted by: Sigma Universal SIEM/EDR CLI

(where(ParentImage IENDSWITH "\\keytool.exe") AND (where(Image IENDSWITH "\\cmd.exe") OR where(Image IENDSWITH "\\sh.exe") OR where(Image IENDSWITH "\\bash.exe") OR where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe") OR where(Image IENDSWITH "\\schtasks.exe") OR where(Image IENDSWITH "\\certutil.exe") OR where(Image IENDSWITH "\\whoami.exe") OR where(Image IENDSWITH "\\bitsadmin.exe") OR where(Image IENDSWITH "\\wscript.exe") OR where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\scrcons.exe") OR where(Image IENDSWITH "\\regsvr32.exe") OR where(Image IENDSWITH "\\hh.exe") OR where(Image IENDSWITH "\\wmic.exe") OR where(Image IENDSWITH "\\mshta.exe") OR where(Image IENDSWITH "\\rundll32.exe") OR where(Image IENDSWITH "\\forfiles.exe") OR where(Image IENDSWITH "\\scriptrunner.exe") OR where(Image IENDSWITH "\\mftrace.exe") OR where(Image IENDSWITH "\\AppVLP.exe") OR where(Image IENDSWITH "\\systeminfo.exe") OR where(Image IENDSWITH "\\reg.exe") OR where(Image IENDSWITH "\\query.exe")))
