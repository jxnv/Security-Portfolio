// Title: Linux Logs Clearing Attempts
// ID: 80915f59-9b56-4616-9de0-fd0dea6c12fe
// Status: stable
// Level: medium
// Author: Ömer Günal, oscd.community
// Date: 2020-10-07
// Tags: attack.defense-impairment, attack.t1685.006
// Description: Detects logs clearing attempts on Linux systems via utilities such as 'rm', 'rmdir', 'shred', and 'unlink' targeting log files and directories.
// Adversaries often try to clear logs to cover their tracks after performing malicious activities.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "/rm") OR where(Image IENDSWITH "/rmdir") OR where(Image IENDSWITH "/shred") OR where(Image IENDSWITH "/unlink")) AND (where(CommandLine ICONTAINS "/var/log") OR where(CommandLine ICONTAINS "/var/spool/mail"))) AND NOT (((where(Image IENDSWITH "/rm") AND where(CommandLine ISTARTSWITH "rm -f -- /var/log//dmesg")) OR (where(Image IENDSWITH "/rm") AND where(CommandLine ISTARTSWITH "rm -f /var/log/sysstat/")))))
