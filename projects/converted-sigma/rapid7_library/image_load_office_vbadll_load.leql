// Title: VBA DLL Loaded Via Office Application
// ID: e6ce8457-68b1-485b-9bdd-3c2b5d679aa9
// Status: test
// Level: high
// Author: Antonlovesdnb
// Date: 2020-02-19
// Tags: attack.execution, attack.t1204.002
// Description: Detects VB DLL's loaded by an office application. Which could indicate the presence of VBA Macros.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image IENDSWITH "\\excel.exe") OR where(Image IENDSWITH "\\mspub.exe") OR where(Image IENDSWITH "\\onenote.exe") OR where(Image IENDSWITH "\\onenoteim.exe") OR where(Image IENDSWITH "\\outlook.exe") OR where(Image IENDSWITH "\\powerpnt.exe") OR where(Image IENDSWITH "\\winword.exe")) AND (where(ImageLoaded IENDSWITH "\\VBE7.DLL") OR where(ImageLoaded IENDSWITH "\\VBEUI.DLL") OR where(ImageLoaded IENDSWITH "\\VBE7INTL.DLL")))
