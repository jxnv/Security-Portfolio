// Title: Print History File Contents
// ID: d7821ff1-4527-4e33-9f84-d0d57fa2fb66
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-06-20
// Tags: attack.reconnaissance, attack.t1592.004
// Description: Detects events in which someone prints the contents of history files to the commandline or redirects it to a file for reconnaissance
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "/cat") OR where(Image IENDSWITH "/head") OR where(Image IENDSWITH "/tail") OR where(Image IENDSWITH "/more"))) AND (((where(CommandLine ICONTAINS "/.bash_history") OR where(CommandLine ICONTAINS "/.zsh_history"))) OR ((where(CommandLine IENDSWITH "_history") OR where(CommandLine IENDSWITH ".history") OR where(CommandLine IENDSWITH "zhistory")))))
