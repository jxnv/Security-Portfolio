// Title: Standard User In High Privileged Group
// ID: 7ac407cc-0f48-4328-aede-de1d2e6fef41
// Status: test
// Level: medium
// Author: frack113
// Date: 2023-01-13
// Tags: attack.credential-access, attack.privilege-escalation
// Description: Detect standard users login that are part of high privileged groups such as the Administrator group
// Converted by: Sigma Universal SIEM/EDR CLI

((where(EventID = "300") AND where(TargetUserSid ISTARTSWITH "S-1-5-21-") AND (where(SidList ICONTAINS "S-1-5-32-544") OR where(SidList ICONTAINS "-500}") OR where(SidList ICONTAINS "-518}") OR where(SidList ICONTAINS "-519}"))) AND NOT (((where(TargetUserSid IENDSWITH "-500") OR where(TargetUserSid IENDSWITH "-518") OR where(TargetUserSid IENDSWITH "-519")))))
