// Title: BITS Transfer Job Download From File Sharing Domains
// ID: d635249d-86b5-4dad-a8c7-d7272b788586
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-06-28
// Tags: attack.persistence, attack.execution, attack.stealth, attack.t1197
// Description: Detects BITS transfer job downloading files from a file sharing domain.
// Converted by: Sigma Universal SIEM/EDR CLI

(where(EventID = "16403") AND (where(RemoteName ICONTAINS ".githubusercontent.com") OR where(RemoteName ICONTAINS "0x0.st") OR where(RemoteName ICONTAINS "anonfiles.com") OR where(RemoteName ICONTAINS "bashupload.com") OR where(RemoteName ICONTAINS "cdn.discordapp.com") OR where(RemoteName ICONTAINS "chunk.io") OR where(RemoteName ICONTAINS "ddns.net") OR where(RemoteName ICONTAINS "dl.dropboxusercontent.com") OR where(RemoteName ICONTAINS "ghostbin.co") OR where(RemoteName ICONTAINS "github.com") OR where(RemoteName ICONTAINS "glitch.me") OR where(RemoteName ICONTAINS "gofile.io") OR where(RemoteName ICONTAINS "hastebin.com") OR where(RemoteName ICONTAINS "mediafire.com") OR where(RemoteName ICONTAINS "mega.nz") OR where(RemoteName ICONTAINS "onrender.com") OR where(RemoteName ICONTAINS "pages.dev") OR where(RemoteName ICONTAINS "paste.ee") OR where(RemoteName ICONTAINS "pastebin.com") OR where(RemoteName ICONTAINS "pastebin.pl") OR where(RemoteName ICONTAINS "pastetext.net") OR where(RemoteName ICONTAINS "pixeldrain.com") OR where(RemoteName ICONTAINS "privatlab.com") OR where(RemoteName ICONTAINS "privatlab.net") OR where(RemoteName ICONTAINS "send.exploit.in") OR where(RemoteName ICONTAINS "sendspace.com") OR where(RemoteName ICONTAINS "storage.googleapis.com") OR where(RemoteName ICONTAINS "storjshare.io") OR where(RemoteName ICONTAINS "supabase.co") OR where(RemoteName ICONTAINS "temp.sh") OR where(RemoteName ICONTAINS "transfer.sh") OR where(RemoteName ICONTAINS "trycloudflare.com") OR where(RemoteName ICONTAINS "ufile.io") OR where(RemoteName ICONTAINS "w3spaces.com") OR where(RemoteName ICONTAINS "workers.dev") OR where(RemoteName ICONTAINS "x0.at")))
