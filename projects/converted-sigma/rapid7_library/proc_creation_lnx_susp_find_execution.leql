// Title: Potential Discovery Activity Using Find - Linux
// ID: 8344c0e5-5783-47cc-9cf9-a0f7fd03e6cf
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-28
// Tags: attack.discovery, attack.t1083
// Description: Detects usage of "find" binary in a suspicious manner to perform discovery
// Converted by: Sigma Universal SIEM/EDR CLI

(where(Image IENDSWITH "/find") AND (where(CommandLine ICONTAINS "-perm -4000") OR where(CommandLine ICONTAINS "-perm -2000") OR where(CommandLine ICONTAINS "-perm 0777") OR where(CommandLine ICONTAINS "-perm -222") OR where(CommandLine ICONTAINS "-perm -o w") OR where(CommandLine ICONTAINS "-perm -o x") OR where(CommandLine ICONTAINS "-perm -u=s") OR where(CommandLine ICONTAINS "-perm -g=s")))
