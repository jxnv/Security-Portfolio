// Title: Suspicious Persistence Via VMwareToolBoxCmd.EXE VM State Change Script
// ID: 236d8e89-ed95-4789-a982-36f4643738ba
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-14
// Tags: attack.execution, attack.persistence, attack.t1059
// Description: Detects execution of the "VMwareToolBoxCmd.exe" with the "script" and "set" flag to setup a specific script that's located in a potentially suspicious location to run for a specific VM state
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS " script ") AND where(CommandLine ICONTAINS " set "))) AND ((where(Image IENDSWITH "\\VMwareToolBoxCmd.exe")) OR (where(OriginalFileName = "toolbox-cmd.exe"))) AND ((where(CommandLine ICONTAINS ":\\PerfLogs\\") OR where(CommandLine ICONTAINS ":\\Temp\\") OR where(CommandLine ICONTAINS ":\\Windows\\System32\\Tasks\\") OR where(CommandLine ICONTAINS ":\\Windows\\Tasks\\") OR where(CommandLine ICONTAINS ":\\Windows\\Temp\\") OR where(CommandLine ICONTAINS "\\AppData\\Local\\Temp"))))
