// Title: Potentially Suspicious File Download From ZIP TLD
// ID: 0bb4bbeb-fe52-4044-b40c-430a04577ebe
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2023-05-18
// Tags: attack.stealth
// Description: Detects the download of a file with a potentially suspicious extension from a .zip top level domain.
// Converted by: Sigma Universal SIEM/EDR CLI

(where(Contents ICONTAINS ".zip/") AND (where(TargetFilename ICONTAINS ".bat:Zone") OR where(TargetFilename ICONTAINS ".dat:Zone") OR where(TargetFilename ICONTAINS ".dll:Zone") OR where(TargetFilename ICONTAINS ".doc:Zone") OR where(TargetFilename ICONTAINS ".docm:Zone") OR where(TargetFilename ICONTAINS ".exe:Zone") OR where(TargetFilename ICONTAINS ".hta:Zone") OR where(TargetFilename ICONTAINS ".pptm:Zone") OR where(TargetFilename ICONTAINS ".ps1:Zone") OR where(TargetFilename ICONTAINS ".rar:Zone") OR where(TargetFilename ICONTAINS ".rtf:Zone") OR where(TargetFilename ICONTAINS ".sct:Zone") OR where(TargetFilename ICONTAINS ".vbe:Zone") OR where(TargetFilename ICONTAINS ".vbs:Zone") OR where(TargetFilename ICONTAINS ".ws:Zone") OR where(TargetFilename ICONTAINS ".wsf:Zone") OR where(TargetFilename ICONTAINS ".xll:Zone") OR where(TargetFilename ICONTAINS ".xls:Zone") OR where(TargetFilename ICONTAINS ".xlsm:Zone") OR where(TargetFilename ICONTAINS ".zip:Zone")))
