// Title: Potential PowerShell Execution Via DLL
// ID: 6812a10b-60ea-420c-832f-dfcc33b646ba
// Status: test
// Level: high
// Author: Markus Neis, Nasreddine Bencherchali (Nextron Systems)
// Date: 2018-08-25
// Tags: attack.stealth, attack.t1218.011
// Description: Detects potential PowerShell execution from a DLL instead of the usual PowerShell process as seen used in PowerShdll.
// This detection assumes that PowerShell commands are passed via the CommandLine.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "Default.GetString") OR where(CommandLine ICONTAINS "DownloadString") OR where(CommandLine ICONTAINS "FromBase64String") OR where(CommandLine ICONTAINS "ICM ") OR where(CommandLine ICONTAINS "IEX ") OR where(CommandLine ICONTAINS "Invoke-Command") OR where(CommandLine ICONTAINS "Invoke-Expression"))) AND (((where(Image IENDSWITH "\\InstallUtil.exe") OR where(Image IENDSWITH "\\RegAsm.exe") OR where(Image IENDSWITH "\\RegSvcs.exe") OR where(Image IENDSWITH "\\regsvr32.exe") OR where(Image IENDSWITH "\\rundll32.exe"))) OR ((where(OriginalFileName = "InstallUtil.exe") OR where(OriginalFileName = "RegAsm.exe") OR where(OriginalFileName = "RegSvcs.exe") OR where(OriginalFileName = "REGSVR32.EXE") OR where(OriginalFileName = "RUNDLL32.EXE")))))
