// Title: Unusual Parent Process For Cmd.EXE
// ID: 4b991083-3d0e-44ce-8fc4-b254025d8d4b
// Status: test
// Level: medium
// Author: Tim Rauch, Elastic (idea)
// Date: 2022-09-21
// Tags: attack.execution, attack.t1059
// Description: Detects suspicious parent process for cmd.exe
// Converted by: Sigma Universal SIEM/EDR CLI

(where(Image IENDSWITH "\\cmd.exe") AND (where(ParentImage IENDSWITH "\\csrss.exe") OR where(ParentImage IENDSWITH "\\ctfmon.exe") OR where(ParentImage IENDSWITH "\\dllhost.exe") OR where(ParentImage IENDSWITH "\\epad.exe") OR where(ParentImage IENDSWITH "\\FlashPlayerUpdateService.exe") OR where(ParentImage IENDSWITH "\\GoogleUpdate.exe") OR where(ParentImage IENDSWITH "\\jucheck.exe") OR where(ParentImage IENDSWITH "\\jusched.exe") OR where(ParentImage IENDSWITH "\\LogonUI.exe") OR where(ParentImage IENDSWITH "\\lsass.exe") OR where(ParentImage IENDSWITH "\\regsvr32.exe") OR where(ParentImage IENDSWITH "\\SearchIndexer.exe") OR where(ParentImage IENDSWITH "\\SearchProtocolHost.exe") OR where(ParentImage IENDSWITH "\\SIHClient.exe") OR where(ParentImage IENDSWITH "\\sihost.exe") OR where(ParentImage IENDSWITH "\\slui.exe") OR where(ParentImage IENDSWITH "\\spoolsv.exe") OR where(ParentImage IENDSWITH "\\sppsvc.exe") OR where(ParentImage IENDSWITH "\\taskhostw.exe") OR where(ParentImage IENDSWITH "\\unsecapp.exe") OR where(ParentImage IENDSWITH "\\WerFault.exe") OR where(ParentImage IENDSWITH "\\wermgr.exe") OR where(ParentImage IENDSWITH "\\wlanext.exe") OR where(ParentImage IENDSWITH "\\WUDFHost.exe")))
