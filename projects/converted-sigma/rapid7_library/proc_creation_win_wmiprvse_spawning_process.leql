// Title: WmiPrvSE Spawned A Process
// ID: d21374ff-f574-44a7-9998-4a8c8bf33d7d
// Status: stable
// Level: medium
// Author: Roberto Rodriguez @Cyb3rWard0g
// Date: 2019-08-15
// Tags: attack.execution, attack.t1047
// Description: Detects WmiPrvSE spawning a process
// Converted by: Sigma Universal SIEM/EDR CLI

((where(ParentImage IENDSWITH "\\WmiPrvSe.exe")) AND NOT ((((where(LogonId = "0x3e7") OR where(LogonId = "null"))) OR (NOT LogonId=*) OR ((where(User ICONTAINS "AUTHORI") OR where(User ICONTAINS "AUTORI"))) OR (where(Image IENDSWITH "\\WerFault.exe")) OR (where(Image IENDSWITH "\\WmiPrvSE.exe")))))
