// Title: Potential AMSI Bypass Via .NET Reflection
// ID: 30edb182-aa75-42c0-b0a9-e998bb29067c
// Status: test
// Level: high
// Author: Markus Neis, @Kostastsale
// Date: 2018-08-17
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects Request to "amsiInitFailed" that can be used to disable AMSI Scanning
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "System.Management.Automation.AmsiUtils") AND where(CommandLine ICONTAINS "amsiInitFailed"))) OR ((where(CommandLine ICONTAINS "[Ref].Assembly.GetType") AND where(CommandLine ICONTAINS "SetValue($null,$true)") AND where(CommandLine ICONTAINS "NonPublic,Static"))))
