// Description: Detects svchost hosting RDP termsvcs communicating with the loopback address
// Converted by: Sigma Universal SIEM/EDR CLI

((where(EventID = "5156")) AND ((where(SourcePort = "3389") AND (where(DestAddress = "127.*") OR where(DestAddress = "::1"))) OR (where(DestPort = "3389") AND (where(SourceAddress = "127.*") OR where(SourceAddress = "::1")))) AND NOT (((where(FilterOrigin = "AppContainer Loopback")) OR ((where(Application IENDSWITH "\\thor.exe") OR where(Application IENDSWITH "\\thor64.exe"))))))
