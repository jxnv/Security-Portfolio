// Title: Suspicious Curl.EXE Download
// ID: e218595b-bbe7-4ee5-8a96-f32a24ad3468
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2020-07-03
// Tags: attack.command-and-control, attack.t1105
// Description: Detects a suspicious curl process start on Windows and outputs the requested document to a local file
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "\\curl.exe")) OR (where(Product = "The curl executable"))) AND (((where(CommandLine IENDSWITH ".dll") OR where(CommandLine IENDSWITH ".gif") OR where(CommandLine IENDSWITH ".jpeg") OR where(CommandLine IENDSWITH ".jpg") OR where(CommandLine IENDSWITH ".png") OR where(CommandLine IENDSWITH ".temp") OR where(CommandLine IENDSWITH ".tmp") OR where(CommandLine IENDSWITH ".txt") OR where(CommandLine IENDSWITH ".vbe") OR where(CommandLine IENDSWITH ".vbs"))) OR ((where(CommandLine ICONTAINS "%AppData%") OR where(CommandLine ICONTAINS "%Public%") OR where(CommandLine ICONTAINS "%Temp%") OR where(CommandLine ICONTAINS "%tmp%") OR where(CommandLine ICONTAINS "\\AppData\\") OR where(CommandLine ICONTAINS "\\Desktop\\") OR where(CommandLine ICONTAINS "\\Temp\\") OR where(CommandLine ICONTAINS "\\Users\\Public\\") OR where(CommandLine ICONTAINS "C:\\PerfLogs\\") OR where(CommandLine ICONTAINS "C:\\ProgramData\\") OR where(CommandLine ICONTAINS "C:\\Windows\\Temp\\")))) AND NOT ((where(ParentImage = "C:\\Program Files\\Git\\usr\\bin\\sh.exe") AND where(Image = "C:\\Program Files\\Git\\mingw64\\bin\\curl.exe") AND (where(CommandLine ICONTAINS "--silent --show-error --output ") AND where(CommandLine ICONTAINS "gfw-httpget-") AND where(CommandLine ICONTAINS "AppData")))))
