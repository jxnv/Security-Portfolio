// Title: Suspicious File Encoded To Base64 Via Certutil.EXE
// ID: ea0cdc3e-2239-4f26-a947-4e8f8224e464
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-15
// Tags: attack.stealth, attack.t1027
// Description: Detects the execution of certutil with the "encode" flag to encode a file to base64 where the extensions of the file is suspicious
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "-encode") OR where(CommandLine ICONTAINS "/encode"))) AND ((where(CommandLine ICONTAINS ".acl") OR where(CommandLine ICONTAINS ".bat") OR where(CommandLine ICONTAINS ".doc") OR where(CommandLine ICONTAINS ".gif") OR where(CommandLine ICONTAINS ".jpeg") OR where(CommandLine ICONTAINS ".jpg") OR where(CommandLine ICONTAINS ".mp3") OR where(CommandLine ICONTAINS ".pdf") OR where(CommandLine ICONTAINS ".png") OR where(CommandLine ICONTAINS ".ppt") OR where(CommandLine ICONTAINS ".tmp") OR where(CommandLine ICONTAINS ".xls") OR where(CommandLine ICONTAINS ".xml"))) AND ((where(Image IENDSWITH "\\certutil.exe")) OR (where(OriginalFileName = "CertUtil.exe"))))
