((((where(ScriptBlockText ICONTAINS "Invoke-CimMethod") AND where(ScriptBlockText ICONTAINS "-ClassName") AND where(ScriptBlockText ICONTAINS "PS_ScheduledTask") AND where(ScriptBlockText ICONTAINS "-NameSpace") AND where(ScriptBlockText ICONTAINS "Root\\Microsoft\\Windows\\TaskScheduler"))) OR ((where(ScriptBlockText ICONTAINS "New-ScheduledTaskAction") OR where(ScriptBlockText ICONTAINS "New-ScheduledTaskTrigger") OR where(ScriptBlockText ICONTAINS "New-ScheduledTaskPrincipal") OR where(ScriptBlockText ICONTAINS "New-ScheduledTaskSettingsSet") OR where(ScriptBlockText ICONTAINS "New-ScheduledTask") OR where(ScriptBlockText ICONTAINS "Register-ScheduledTask")))) AND NOT (((where(ScriptBlockText ICONTAINS "Microsoft.PowerShell.Core\\Export-ModuleMember") AND where(ScriptBlockText ICONTAINS "Microsoft.Management.Infrastructure.CimInstance") AND where(ScriptBlockText ICONTAINS "__cmdletization_methodParameter")))))
