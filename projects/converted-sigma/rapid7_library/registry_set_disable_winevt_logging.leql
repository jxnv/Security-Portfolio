// Title: Disable Windows Event Logging Via Registry
// ID: 2f78da12-f7c7-430b-8b19-a28f269b77a3
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-04
// Tags: attack.defense-impairment, attack.t1685.001
// Description: Detects tampering with the "Enabled" registry key in order to disable Windows logging of a Windows event channel
// Converted by: Sigma Universal SIEM/EDR CLI

((where(TargetObject ICONTAINS "\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\") AND where(TargetObject IENDSWITH "\\Enabled") AND where(Details = "DWORD (0x00000000)")) AND NOT (((where(Image ISTARTSWITH "C:\\Windows\\winsxs\\") AND where(Image IENDSWITH "\\TiWorker.exe")) OR (where(Image = "C:\\Windows\\System32\\svchost.exe") AND (where(TargetObject ICONTAINS "\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-FileInfoMinifilter") OR where(TargetObject ICONTAINS "\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-ASN1\\") OR where(TargetObject ICONTAINS "\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-Kernel-AppCompat\\") OR where(TargetObject ICONTAINS "\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-Runtime\\Error\\") OR where(TargetObject ICONTAINS "\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-CAPI2/Operational\\"))) OR (where(Image = "C:\\Windows\\servicing\\TrustedInstaller.exe") AND where(TargetObject ICONTAINS "\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-Compat-Appraiser")) OR (where(Image = "C:\\Windows\\system32\\wevtutil.exe")))) AND NOT (((where(Image = "")) OR (NOT Image=*))))
