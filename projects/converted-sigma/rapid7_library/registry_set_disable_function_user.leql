// Title: Disable Internal Tools or Feature in Registry
// ID: e2482f8d-3443-4237-b906-cc145d87a076
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems), CrimpSec
// Date: 2022-03-18
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects registry modifications that change features of internal Windows tools (malware like Agent Tesla uses this technique)
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(TargetObject IENDSWITH "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\ConsentPromptBehaviorAdmin") OR where(TargetObject IENDSWITH "Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\InactivityTimeoutSecs") OR where(TargetObject IENDSWITH "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\shutdownwithoutlogon") OR where(TargetObject IENDSWITH "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\PushNotifications\\ToastEnabled") OR where(TargetObject IENDSWITH "SYSTEM\\CurrentControlSet\\Control\\Storage\\Write Protection") OR where(TargetObject IENDSWITH "SYSTEM\\CurrentControlSet\\Control\\StorageDevicePolicies\\WriteProtect")) AND where(Details = "DWORD (0x00000000)")) OR ((where(TargetObject IENDSWITH "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\DisableCMD") OR where(TargetObject IENDSWITH "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\NoControlPanel") OR where(TargetObject IENDSWITH "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\NoRun") OR where(TargetObject IENDSWITH "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\StartMenuLogOff") OR where(TargetObject IENDSWITH "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\DisableChangePassword") OR where(TargetObject IENDSWITH "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\DisableLockWorkstation") OR where(TargetObject IENDSWITH "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\DisableRegistryTools") OR where(TargetObject IENDSWITH "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\DisableTaskmgr") OR where(TargetObject IENDSWITH "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\NoDispBackgroundPage") OR where(TargetObject IENDSWITH "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\NoDispCPL") OR where(TargetObject IENDSWITH "SOFTWARE\\Policies\\Microsoft\\Windows\\Explorer\\DisableNotificationCenter") OR where(TargetObject IENDSWITH "SOFTWARE\\Policies\\Microsoft\\Windows\\System\\DisableCMD")) AND where(Details = "DWORD (0x00000001)")))
