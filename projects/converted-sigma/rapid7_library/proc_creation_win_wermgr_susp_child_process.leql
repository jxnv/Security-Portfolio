// Title: Suspicious Child Process Of Wermgr.EXE
// ID: 396f6630-f3ac-44e3-bfc8-1b161bc00c4e
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-10-14
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055, attack.t1036
// Description: Detects suspicious Windows Error Reporting manager (wermgr.exe) child process
// Converted by: Sigma Universal SIEM/EDR CLI

((where(ParentImage IENDSWITH "\\wermgr.exe") AND (where(Image IENDSWITH "\\cmd.exe") OR where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\ipconfig.exe") OR where(Image IENDSWITH "\\mshta.exe") OR where(Image IENDSWITH "\\net.exe") OR where(Image IENDSWITH "\\net1.exe") OR where(Image IENDSWITH "\\netstat.exe") OR where(Image IENDSWITH "\\nslookup.exe") OR where(Image IENDSWITH "\\powershell_ise.exe") OR where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe") OR where(Image IENDSWITH "\\regsvr32.exe") OR where(Image IENDSWITH "\\rundll32.exe") OR where(Image IENDSWITH "\\systeminfo.exe") OR where(Image IENDSWITH "\\whoami.exe") OR where(Image IENDSWITH "\\wscript.exe"))) AND NOT ((where(Image IENDSWITH "\\rundll32.exe") AND (where(CommandLine ICONTAINS "C:\\Windows\\system32\\WerConCpl.dll") AND where(CommandLine ICONTAINS "LaunchErcApp ")) AND (where(CommandLine ICONTAINS "-queuereporting") OR where(CommandLine ICONTAINS "-responsepester")))))
