// Title: Remote Access Tool Services Have Been Installed - System
// ID: 1a31b18a-f00c-4061-9900-f735b96c99fc
// Status: test
// Level: medium
// Author: Connor Martin, Nasreddine Bencherchali
// Date: 2022-12-23
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1543.003, attack.t1569.002
// Description: Detects service installation of different remote access tools software. These software are often abused by threat actors to perform
// Converted by: Sigma Universal SIEM/EDR CLI

(where(Provider_Name = "Service Control Manager") AND (where(EventID = "7045") OR where(EventID = "7036")) AND (where(ServiceName ICONTAINS "AmmyyAdmin") OR where(ServiceName ICONTAINS "Atera") OR where(ServiceName ICONTAINS "BASupportExpressSrvcUpdater") OR where(ServiceName ICONTAINS "BASupportExpressStandaloneService") OR where(ServiceName ICONTAINS "chromoting") OR where(ServiceName ICONTAINS "GoToAssist") OR where(ServiceName ICONTAINS "GoToMyPC") OR where(ServiceName ICONTAINS "jumpcloud") OR where(ServiceName ICONTAINS "LMIGuardianSvc") OR where(ServiceName ICONTAINS "LogMeIn") OR where(ServiceName ICONTAINS "monblanking") OR where(ServiceName ICONTAINS "Parsec") OR where(ServiceName ICONTAINS "RManService") OR where(ServiceName ICONTAINS "RPCPerformanceService") OR where(ServiceName ICONTAINS "RPCService") OR where(ServiceName ICONTAINS "SplashtopRemoteService") OR where(ServiceName ICONTAINS "SSUService") OR where(ServiceName ICONTAINS "TeamViewer") OR where(ServiceName ICONTAINS "TightVNC") OR where(ServiceName ICONTAINS "vncserver") OR where(ServiceName ICONTAINS "Zoho")))
