// Title: Suspicious Microsoft Office Child Process - MacOS
// ID: 69483748-1525-4a6c-95ca-90dc8d431b68
// Status: test
// Level: high
// Author: Sohan G (D4rkCiph3r)
// Date: 2023-01-31
// Tags: attack.execution, attack.persistence, attack.t1059.002, attack.t1137.002, attack.t1204.002
// Description: Detects suspicious child processes spawning from microsoft office suite applications such as word or excel. This could indicates malicious macro execution
// Converted by: Sigma Universal SIEM/EDR CLI

((where(ParentImage ICONTAINS "Microsoft Word") OR where(ParentImage ICONTAINS "Microsoft Excel") OR where(ParentImage ICONTAINS "Microsoft PowerPoint") OR where(ParentImage ICONTAINS "Microsoft OneNote")) AND (where(Image IENDSWITH "/bash") OR where(Image IENDSWITH "/curl") OR where(Image IENDSWITH "/dash") OR where(Image IENDSWITH "/fish") OR where(Image IENDSWITH "/osacompile") OR where(Image IENDSWITH "/osascript") OR where(Image IENDSWITH "/sh") OR where(Image IENDSWITH "/zsh") OR where(Image IENDSWITH "/python") OR where(Image IENDSWITH "/python3") OR where(Image IENDSWITH "/wget")))
