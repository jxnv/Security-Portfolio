// Title: Suspicious PowerShell Invocations - Specific
// ID: ae7fbf8e-f3cb-49fd-8db4-5f3bed522c71
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Jonhnathan Ribeiro
// Date: 2017-03-05
// Tags: attack.execution, attack.t1059.001
// Description: Detects suspicious PowerShell invocation command parameters
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(ScriptBlockText ICONTAINS "-nop") AND where(ScriptBlockText ICONTAINS " -w ") AND where(ScriptBlockText ICONTAINS "hidden") AND where(ScriptBlockText ICONTAINS " -c ") AND where(ScriptBlockText ICONTAINS "[Convert]::FromBase64String"))) OR ((where(ScriptBlockText ICONTAINS " -w ") AND where(ScriptBlockText ICONTAINS "hidden") AND where(ScriptBlockText ICONTAINS "-ep") AND where(ScriptBlockText ICONTAINS "bypass") AND where(ScriptBlockText ICONTAINS "-Enc"))) OR ((where(ScriptBlockText ICONTAINS " -w ") AND where(ScriptBlockText ICONTAINS "hidden") AND where(ScriptBlockText ICONTAINS "-noni") AND where(ScriptBlockText ICONTAINS "-nop") AND where(ScriptBlockText ICONTAINS " -c ") AND where(ScriptBlockText ICONTAINS "iex") AND where(ScriptBlockText ICONTAINS "New-Object"))) OR ((where(ScriptBlockText ICONTAINS "iex") AND where(ScriptBlockText ICONTAINS "New-Object") AND where(ScriptBlockText ICONTAINS "Net.WebClient") AND where(ScriptBlockText ICONTAINS ".Download"))) OR ((where(ScriptBlockText ICONTAINS "powershell") AND where(ScriptBlockText ICONTAINS "reg") AND where(ScriptBlockText ICONTAINS "add")) AND (where(ScriptBlockText ICONTAINS "\\software\\microsoft\\windows\\currentversion\\run") OR where(ScriptBlockText ICONTAINS "\\software\\wow6432node\\microsoft\\windows\\currentversion\\run") OR where(ScriptBlockText ICONTAINS "\\software\\microsoft\\windows\\currentversion\\policies\\explorer\\run"))) OR ((where(ScriptBlockText ICONTAINS "bypass") AND where(ScriptBlockText ICONTAINS "-noprofile") AND where(ScriptBlockText ICONTAINS "-windowstyle") AND where(ScriptBlockText ICONTAINS "hidden") AND where(ScriptBlockText ICONTAINS "new-object") AND where(ScriptBlockText ICONTAINS "system.net.webclient") AND where(ScriptBlockText ICONTAINS ".download")))) AND NOT (((where(ScriptBlockText ICONTAINS "(New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1") OR where(ScriptBlockText ICONTAINS "(New-Object System.Net.WebClient).DownloadString('https://chocolatey.org/install.ps1')") OR where(ScriptBlockText ICONTAINS "Write-ChocolateyWarning")))))
