// Description: Detects potentially suspicious processes being spawned by a web server process which could be the result of a successfully placed web shell or exploitation
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(ParentImage IENDSWITH "\\java.exe") OR where(ParentImage IENDSWITH "\\javaw.exe")) AND (where(ParentImage ICONTAINS "-tomcat-") OR where(ParentImage ICONTAINS "\\tomcat"))) OR ((where(ParentImage IENDSWITH "\\java.exe") OR where(ParentImage IENDSWITH "\\javaw.exe")) AND (where(ParentCommandLine ICONTAINS "CATALINA_HOME") OR where(ParentCommandLine ICONTAINS "catalina.home") OR where(ParentCommandLine ICONTAINS "catalina.jar"))) OR ((where(ParentImage IENDSWITH "\\caddy.exe") OR where(ParentImage IENDSWITH "\\httpd.exe") OR where(ParentImage IENDSWITH "\\nginx.exe") OR where(ParentImage IENDSWITH "\\php-cgi.exe") OR where(ParentImage IENDSWITH "\\php.exe") OR where(ParentImage IENDSWITH "\\tomcat.exe") OR where(ParentImage IENDSWITH "\\UMWorkerProcess.exe") OR where(ParentImage IENDSWITH "\\w3wp.exe") OR where(ParentImage IENDSWITH "\\ws_TomcatService.exe")))) AND ((where(Image IENDSWITH "\\arp.exe") OR where(Image IENDSWITH "\\at.exe") OR where(Image IENDSWITH "\\bash.exe") OR where(Image IENDSWITH "\\bitsadmin.exe") OR where(Image IENDSWITH "\\certutil.exe") OR where(Image IENDSWITH "\\cmd.exe") OR where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\dsget.exe") OR where(Image IENDSWITH "\\hostname.exe") OR where(Image IENDSWITH "\\nbtstat.exe") OR where(Image IENDSWITH "\\net.exe") OR where(Image IENDSWITH "\\net1.exe") OR where(Image IENDSWITH "\\netdom.exe") OR where(Image IENDSWITH "\\netsh.exe") OR where(Image IENDSWITH "\\nltest.exe") OR where(Image IENDSWITH "\\ntdsutil.exe") OR where(Image IENDSWITH "\\powershell_ise.exe") OR where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe") OR where(Image IENDSWITH "\\qprocess.exe") OR where(Image IENDSWITH "\\query.exe") OR where(Image IENDSWITH "\\qwinsta.exe") OR where(Image IENDSWITH "\\reg.exe") OR where(Image IENDSWITH "\\rundll32.exe") OR where(Image IENDSWITH "\\sc.exe") OR where(Image IENDSWITH "\\sh.exe") OR where(Image IENDSWITH "\\wmic.exe") OR where(Image IENDSWITH "\\wscript.exe") OR where(Image IENDSWITH "\\wusa.exe"))) AND NOT (((where(ParentImage IENDSWITH "\\java.exe") AND where(CommandLine IENDSWITH "Windows\\system32\\cmd.exe /c C:\\ManageEngine\\ADManager \"Plus\\ES\\bin\\elasticsearch.bat -Enode.name=RMP-NODE1 -pelasticsearch-pid.txt")) OR (where(ParentImage IENDSWITH "\\java.exe") AND (where(CommandLine ICONTAINS "sc query") AND where(CommandLine ICONTAINS "ADManager Plus"))))))
