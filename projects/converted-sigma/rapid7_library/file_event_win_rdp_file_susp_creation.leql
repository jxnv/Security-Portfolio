// Title: .RDP File Created By Uncommon Application
// ID: fccfb43e-09a7-4bd2-8b37-a5a7df33386d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.stealth
// Description: Detects creation of a file with an ".rdp" extension by an application that doesn't commonly create such files.
// Converted by: Sigma Universal SIEM/EDR CLI

(where(TargetFilename IENDSWITH ".rdp") AND (where(Image IENDSWITH "\\brave.exe") OR where(Image IENDSWITH "\\CCleaner Browser\\Application\\CCleanerBrowser.exe") OR where(Image IENDSWITH "\\chromium.exe") OR where(Image IENDSWITH "\\firefox.exe") OR where(Image IENDSWITH "\\Google\\Chrome\\Application\\chrome.exe") OR where(Image IENDSWITH "\\iexplore.exe") OR where(Image IENDSWITH "\\microsoftedge.exe") OR where(Image IENDSWITH "\\msedge.exe") OR where(Image IENDSWITH "\\Opera.exe") OR where(Image IENDSWITH "\\Vivaldi.exe") OR where(Image IENDSWITH "\\Whale.exe") OR where(Image IENDSWITH "\\olk.exe") OR where(Image IENDSWITH "\\Outlook.exe") OR where(Image IENDSWITH "\\RuntimeBroker.exe") OR where(Image IENDSWITH "\\Thunderbird.exe") OR where(Image IENDSWITH "\\Discord.exe") OR where(Image IENDSWITH "\\Keybase.exe") OR where(Image IENDSWITH "\\msteams.exe") OR where(Image IENDSWITH "\\Slack.exe") OR where(Image IENDSWITH "\\teams.exe")))
