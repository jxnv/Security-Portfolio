// Title: Potentially Suspicious Office Document Executed From Trusted Location
// ID: f99abdf0-6283-4e71-bd2b-b5c048a94743
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-21
// Tags: attack.stealth, attack.t1202
// Description: Detects the execution of an Office application that points to a document that is located in a trusted location. Attackers often used this to avoid macro security and execute their malicious code.
// Converted by: Sigma Universal SIEM/EDR CLI

(((((where(Image IENDSWITH "\\EXCEL.EXE") OR where(Image IENDSWITH "\\POWERPNT.EXE") OR where(Image IENDSWITH "\\WINWORD.exe"))) OR ((where(OriginalFileName = "Excel.exe") OR where(OriginalFileName = "POWERPNT.EXE") OR where(OriginalFileName = "WinWord.exe")))) AND ((where(ParentImage IENDSWITH "\\explorer.exe") OR where(ParentImage IENDSWITH "\\dopus.exe"))) AND ((where(CommandLine ICONTAINS "\\AppData\\Roaming\\Microsoft\\Templates") OR where(CommandLine ICONTAINS "\\AppData\\Roaming\\Microsoft\\Word\\Startup\\") OR where(CommandLine ICONTAINS "\\Microsoft Office\\root\\Templates\\") OR where(CommandLine ICONTAINS "\\Microsoft Office\\Templates\\")))) AND NOT (((where(CommandLine IENDSWITH ".dotx") OR where(CommandLine IENDSWITH ".xltx") OR where(CommandLine IENDSWITH ".potx")))))
