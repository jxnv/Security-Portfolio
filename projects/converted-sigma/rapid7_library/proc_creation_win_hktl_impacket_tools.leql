// Title: HackTool - Impacket Tools Execution
// ID: 4627c6ae-6899-46e2-aa0c-6ebcb1becd19
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-07-24
// Tags: attack.collection, attack.execution, attack.credential-access, attack.t1557.001
// Description: Detects the execution of different compiled Windows binaries of the impacket toolset (based on names or part of their names - could lead to false positives)
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image ICONTAINS "\\goldenPac") OR where(Image ICONTAINS "\\karmaSMB") OR where(Image ICONTAINS "\\kintercept") OR where(Image ICONTAINS "\\ntlmrelayx") OR where(Image ICONTAINS "\\rpcdump") OR where(Image ICONTAINS "\\samrdump") OR where(Image ICONTAINS "\\secretsdump") OR where(Image ICONTAINS "\\smbexec") OR where(Image ICONTAINS "\\smbrelayx") OR where(Image ICONTAINS "\\wmiexec") OR where(Image ICONTAINS "\\wmipersist"))) OR ((where(Image IENDSWITH "\\atexec_windows.exe") OR where(Image IENDSWITH "\\dcomexec_windows.exe") OR where(Image IENDSWITH "\\dpapi_windows.exe") OR where(Image IENDSWITH "\\findDelegation_windows.exe") OR where(Image IENDSWITH "\\GetADUsers_windows.exe") OR where(Image IENDSWITH "\\GetNPUsers_windows.exe") OR where(Image IENDSWITH "\\getPac_windows.exe") OR where(Image IENDSWITH "\\getST_windows.exe") OR where(Image IENDSWITH "\\getTGT_windows.exe") OR where(Image IENDSWITH "\\GetUserSPNs_windows.exe") OR where(Image IENDSWITH "\\ifmap_windows.exe") OR where(Image IENDSWITH "\\mimikatz_windows.exe") OR where(Image IENDSWITH "\\netview_windows.exe") OR where(Image IENDSWITH "\\nmapAnswerMachine_windows.exe") OR where(Image IENDSWITH "\\opdump_windows.exe") OR where(Image IENDSWITH "\\psexec_windows.exe") OR where(Image IENDSWITH "\\rdp_check_windows.exe") OR where(Image IENDSWITH "\\sambaPipe_windows.exe") OR where(Image IENDSWITH "\\smbclient_windows.exe") OR where(Image IENDSWITH "\\smbserver_windows.exe") OR where(Image IENDSWITH "\\sniff_windows.exe") OR where(Image IENDSWITH "\\sniffer_windows.exe") OR where(Image IENDSWITH "\\split_windows.exe") OR where(Image IENDSWITH "\\ticketer_windows.exe"))))
