// Title: Suspicious Service Installation
// ID: 1d61f71d-59d2-479e-9562-4ff5f4ead16b
// Status: test
// Level: high
// Author: pH-T (Nextron Systems), Florian Roth (Nextron Systems)
// Date: 2022-03-18
// Tags: attack.persistence, attack.privilege-escalation, car.2013-09-005, attack.t1543.003
// Description: Detects suspicious service installation commands
// Converted by: Sigma Universal SIEM/EDR CLI

(where(Provider_Name = "Service Control Manager") AND where(EventID = "7045") AND (where(ImagePath ICONTAINS " -nop ") OR where(ImagePath ICONTAINS " -sta ") OR where(ImagePath ICONTAINS " -w hidden ") OR where(ImagePath ICONTAINS ":\\Temp\\") OR where(ImagePath ICONTAINS ".downloadfile(") OR where(ImagePath ICONTAINS ".downloadstring(") OR where(ImagePath ICONTAINS "\\ADMIN$\\") OR where(ImagePath ICONTAINS "\\Perflogs\\") OR where(ImagePath ICONTAINS "&&")))
