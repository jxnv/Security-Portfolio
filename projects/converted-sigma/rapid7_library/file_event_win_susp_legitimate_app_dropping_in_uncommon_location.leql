// Title: Legitimate Application Writing Files In Uncommon Location
// ID: 1cf465a1-2609-4c15-9b66-c32dbe4bfd67
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-12-10
// Tags: attack.stealth, attack.t1218, attack.command-and-control, attack.t1105
// Description: Detects legitimate applications writing any type of file to uncommon or suspicious locations that are not typical for application data storage or execution.
// Adversaries may leverage legitimate applications (Living off the Land Binaries - LOLBins) to drop or download malicious files to uncommon locations on the system to evade detection by security solutions.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "\\eqnedt32.exe") OR where(Image IENDSWITH "\\wordpad.exe") OR where(Image IENDSWITH "\\wordview.exe") OR where(Image IENDSWITH "\\cmdl32.exe") OR where(Image IENDSWITH "\\certutil.exe") OR where(Image IENDSWITH "\\certoc.exe") OR where(Image IENDSWITH "\\CertReq.exe") OR where(Image IENDSWITH "\\bitsadmin.exe") OR where(Image IENDSWITH "\\Desktopimgdownldr.exe") OR where(Image IENDSWITH "\\esentutl.exe") OR where(Image IENDSWITH "\\expand.exe") OR where(Image IENDSWITH "\\extrac32.exe") OR where(Image IENDSWITH "\\replace.exe") OR where(Image IENDSWITH "\\mshta.exe") OR where(Image IENDSWITH "\\ftp.exe") OR where(Image IENDSWITH "\\Ldifde.exe") OR where(Image IENDSWITH "\\RdrCEF.exe") OR where(Image IENDSWITH "\\hh.exe") OR where(Image IENDSWITH "\\finger.exe") OR where(Image IENDSWITH "\\findstr.exe"))) AND ((where(TargetFilename ICONTAINS ":\\Perflogs") OR where(TargetFilename ICONTAINS ":\\ProgramData\\") OR where(TargetFilename ICONTAINS ":\\Temp\\") OR where(TargetFilename ICONTAINS ":\\Users\\Public\\") OR where(TargetFilename ICONTAINS ":\\Windows\\") OR where(TargetFilename ICONTAINS "\\$Recycle.Bin\\") OR where(TargetFilename ICONTAINS "\\AppData\\Local\\") OR where(TargetFilename ICONTAINS "\\AppData\\Roaming\\") OR where(TargetFilename ICONTAINS "\\Contacts\\") OR where(TargetFilename ICONTAINS "\\Desktop\\") OR where(TargetFilename ICONTAINS "\\Favorites\\") OR where(TargetFilename ICONTAINS "\\Favourites\\") OR where(TargetFilename ICONTAINS "\\inetpub\\wwwroot\\") OR where(TargetFilename ICONTAINS "\\Music\\") OR where(TargetFilename ICONTAINS "\\Pictures\\") OR where(TargetFilename ICONTAINS "\\Start Menu\\Programs\\Startup\\") OR where(TargetFilename ICONTAINS "\\Users\\Default\\") OR where(TargetFilename ICONTAINS "\\Videos\\"))))
