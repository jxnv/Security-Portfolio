// Description: Windows DCE-RPC functions which indicate an execution techniques on the remote system. All credit for the Zeek mapping of the suspicious endpoint/operation field goes to MITRE
// Converted by: Sigma Universal SIEM/EDR CLI

((where(endpoint = "JobAdd") AND where(operation = "atsvc")) OR (where(endpoint = "svcctl") AND where(operation = "StartServiceW")) OR (where(endpoint = "ITaskSchedulerService") AND where(operation = "SchRpcEnableTask")) OR (where(endpoint = "ITaskSchedulerService") AND where(operation = "SchRpcRegisterTask")) OR (where(endpoint = "ITaskSchedulerService") AND where(operation = "SchRpcRun")) OR (where(endpoint = "IWbemServices") AND where(operation = "ExecMethod")) OR (where(endpoint = "IWbemServices") AND where(operation = "ExecMethodAsync")) OR (where(endpoint = "svcctl") AND where(operation = "CreateServiceA")) OR (where(endpoint = "svcctl") AND where(operation = "CreateServiceW")) OR (where(endpoint = "svcctl") AND where(operation = "StartServiceA")))
