(((where(TargetObject IENDSWITH "\\COMPlus_ETWEnabled") OR where(TargetObject IENDSWITH "\\COMPlus_ETWFlags")) AND (where(Details = "0") OR where(Details = "DWORD (0x00000000)"))) OR (where(TargetObject IENDSWITH "SOFTWARE\\Microsoft\\.NETFramework\\ETWEnabled") AND where(Details = "DWORD (0x00000000)")))
