(((where(CommandLine ICONTAINS " --cpu-priority=") OR where(CommandLine ICONTAINS "--donate-level=0") OR where(CommandLine ICONTAINS " -o pool.") OR where(CommandLine ICONTAINS " --nicehash") OR where(CommandLine ICONTAINS " --algo=rx/0 ") OR where(CommandLine ICONTAINS "stratum+tcp://") OR where(CommandLine ICONTAINS "stratum+udp://") OR where(CommandLine ICONTAINS "LS1kb25hdGUtbGV2ZWw9") OR where(CommandLine ICONTAINS "0tZG9uYXRlLWxldmVsP") OR where(CommandLine ICONTAINS "tLWRvbmF0ZS1sZXZlbD") OR where(CommandLine ICONTAINS "c3RyYXR1bSt0Y3A6Ly") OR where(CommandLine ICONTAINS "N0cmF0dW0rdGNwOi8v") OR where(CommandLine ICONTAINS "zdHJhdHVtK3RjcDovL") OR where(CommandLine ICONTAINS "c3RyYXR1bSt1ZHA6Ly") OR where(CommandLine ICONTAINS "N0cmF0dW0rdWRwOi8v") OR where(CommandLine ICONTAINS "zdHJhdHVtK3VkcDovL"))) AND NOT (((where(CommandLine ICONTAINS " pool.c ") OR where(CommandLine ICONTAINS " pool.o ") OR where(CommandLine ICONTAINS "gcc -")))))
