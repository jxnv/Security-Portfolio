((((where(Image IENDSWITH "\\csrss.exe") OR where(Image IENDSWITH "\\lsass.exe") OR where(Image IENDSWITH "\\RuntimeBroker.exe") OR where(Image IENDSWITH "\\sihost.exe") OR where(Image IENDSWITH "\\smss.exe") OR where(Image IENDSWITH "\\wininit.exe") OR where(Image IENDSWITH "\\winlogon.exe")) AND (where(TargetFilename IENDSWITH ".bat") OR where(TargetFilename IENDSWITH ".dll") OR where(TargetFilename IENDSWITH ".exe") OR where(TargetFilename IENDSWITH ".hta") OR where(TargetFilename IENDSWITH ".iso") OR where(TargetFilename IENDSWITH ".ps1") OR where(TargetFilename IENDSWITH ".txt") OR where(TargetFilename IENDSWITH ".vbe") OR where(TargetFilename IENDSWITH ".vbs"))) OR ((where(Image IENDSWITH "\\dllhost.exe") OR where(Image IENDSWITH "\\rundll32.exe") OR where(Image IENDSWITH "\\svchost.exe")) AND (where(TargetFilename IENDSWITH ".bat") OR where(TargetFilename IENDSWITH ".hta") OR where(TargetFilename IENDSWITH ".iso") OR where(TargetFilename IENDSWITH ".ps1") OR where(TargetFilename IENDSWITH ".vbe") OR where(TargetFilename IENDSWITH ".vbs")))) AND NOT (((where(Image = "C:\\Windows\\System32\\dllhost.exe") AND (where(TargetFilename ICONTAINS ":\\Users\\") AND where(TargetFilename ICONTAINS "\\AppData\\Local\\Temp\\__PSScriptPolicyTest_")) AND where(TargetFilename IENDSWITH ".ps1")) OR (where(Image = "C:\\Windows\\system32\\svchost.exe") AND (where(TargetFilename ICONTAINS "C:\\Program Files\\WindowsApps\\Clipchamp") AND where(TargetFilename ICONTAINS ".ps1"))) OR ((where(Image = "C:\\Windows\\system32\\svchost.exe") OR where(Image = "C:\\Windows\\SysWOW64\\svchost.exe")) AND (where(TargetFilename ISTARTSWITH "C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview") OR where(TargetFilename ISTARTSWITH "C:\\Program Files (x86)\\WindowsApps\\Microsoft.PowerShellPreview")) AND where(TargetFilename IENDSWITH ".ps1")) OR (where(Image = "C:\\Windows\\system32\\svchost.exe") AND (where(TargetFilename ICONTAINS "C:\\Windows\\System32\\GroupPolicy\\DataStore\\") AND where(TargetFilename ICONTAINS "\\sysvol\\") AND where(TargetFilename ICONTAINS "\\Policies\\") AND where(TargetFilename ICONTAINS "\\Machine\\Scripts\\Startup\\")) AND (where(TargetFilename IENDSWITH ".ps1") OR where(TargetFilename IENDSWITH ".bat"))))))
