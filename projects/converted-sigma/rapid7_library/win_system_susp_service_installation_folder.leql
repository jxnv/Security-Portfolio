// Title: Service Installation in Suspicious Folder
// ID: 5e993621-67d4-488a-b9ae-b420d08b96cb
// Status: test
// Level: medium
// Author: pH-T (Nextron Systems)
// Date: 2022-03-18
// Tags: attack.persistence, attack.privilege-escalation, car.2013-09-005, attack.t1543.003
// Description: Detects service installation in suspicious folder appdata
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Provider_Name = "Service Control Manager") AND where(EventID = "7045") AND (where(ImagePath ICONTAINS "\\AppData\\") OR where(ImagePath ICONTAINS "\\\\\\\\127.0.0.1") OR where(ImagePath ICONTAINS "\\\\\\\\localhost"))) AND NOT ((where(ServiceName = "Zoom Sharing Service") AND where(ImagePath ICONTAINS ":\\Program Files\\Common Files\\Zoom\\Support\\CptService.exe"))))
