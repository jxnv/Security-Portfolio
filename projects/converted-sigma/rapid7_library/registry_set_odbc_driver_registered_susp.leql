// Title: Potentially Suspicious ODBC Driver Registered
// ID: e4d22291-f3d5-4b78-9a0c-a1fbaf32a6a4
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-23
// Tags: attack.credential-access, attack.persistence, attack.t1003
// Description: Detects the registration of a new ODBC driver where the driver is located in a potentially suspicious location
// Converted by: Sigma Universal SIEM/EDR CLI

(where(TargetObject ICONTAINS "\\SOFTWARE\\ODBC\\ODBCINST.INI\\") AND (where(TargetObject IENDSWITH "\\Driver") OR where(TargetObject IENDSWITH "\\Setup")) AND (where(Details ICONTAINS ":\\PerfLogs\\") OR where(Details ICONTAINS ":\\ProgramData\\") OR where(Details ICONTAINS ":\\Temp\\") OR where(Details ICONTAINS ":\\Users\\Public\\") OR where(Details ICONTAINS ":\\Windows\\Registration\\CRMLog") OR where(Details ICONTAINS ":\\Windows\\System32\\com\\dmp\\") OR where(Details ICONTAINS ":\\Windows\\System32\\FxsTmp\\") OR where(Details ICONTAINS ":\\Windows\\System32\\Microsoft\\Crypto\\RSA\\MachineKeys\\") OR where(Details ICONTAINS ":\\Windows\\System32\\spool\\drivers\\color\\") OR where(Details ICONTAINS ":\\Windows\\System32\\spool\\PRINTERS\\") OR where(Details ICONTAINS ":\\Windows\\System32\\spool\\SERVERS\\") OR where(Details ICONTAINS ":\\Windows\\System32\\Tasks_Migrated\\") OR where(Details ICONTAINS ":\\Windows\\System32\\Tasks\\Microsoft\\Windows\\SyncCenter\\") OR where(Details ICONTAINS ":\\Windows\\SysWOW64\\com\\dmp\\") OR where(Details ICONTAINS ":\\Windows\\SysWOW64\\FxsTmp\\") OR where(Details ICONTAINS ":\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\PLA\\System\\") OR where(Details ICONTAINS ":\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\SyncCenter\\") OR where(Details ICONTAINS ":\\Windows\\Tasks\\") OR where(Details ICONTAINS ":\\Windows\\Temp\\") OR where(Details ICONTAINS ":\\Windows\\Tracing\\") OR where(Details ICONTAINS "\\AppData\\Local\\Temp\\") OR where(Details ICONTAINS "\\AppData\\Roaming\\")))
