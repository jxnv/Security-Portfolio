// Title: Python Spawning Pretty TTY on Windows
// ID: 480e7e51-e797-47e3-8d72-ebfce65b6d8d
// Status: test
// Level: high
// Author: Nextron Systems
// Date: 2022-06-03
// Tags: attack.execution, attack.t1059
// Description: Detects python spawning a pretty tty
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "python.exe") OR where(Image IENDSWITH "python3.exe") OR where(Image IENDSWITH "python2.exe"))) AND (((where(CommandLine ICONTAINS "import pty") AND where(CommandLine ICONTAINS ".spawn("))) OR (where(CommandLine ICONTAINS "from pty import spawn"))))
