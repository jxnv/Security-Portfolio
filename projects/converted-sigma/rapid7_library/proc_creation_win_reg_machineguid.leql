// Tags: attack.discovery, attack.t1082
// Description: Use of reg to get MachineGuid information
// Converted by: Sigma Universal SIEM/EDR CLI

(where(Image IENDSWITH "\\reg.exe") AND (where(CommandLine ICONTAINS "SOFTWARE\\Microsoft\\Cryptography") AND where(CommandLine ICONTAINS "/v ") AND where(CommandLine ICONTAINS "MachineGuid")))
