// Title: Suspicious Process Start Locations
// ID: 15b75071-74cc-47e0-b4c6-b43744a62a2b
// Status: test
// Level: medium
// Author: juju4, Jonhnathan Ribeiro, oscd.community
// Date: 2019-01-16
// Tags: attack.stealth, attack.t1036, car.2013-05-002
// Description: Detects suspicious process run from unusual locations
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image ICONTAINS ":\\RECYCLER\\") OR where(Image ICONTAINS ":\\SystemVolumeInformation\\"))) OR ((where(Image ISTARTSWITH "C:\\Windows\\Tasks\\") OR where(Image ISTARTSWITH "C:\\Windows\\debug\\") OR where(Image ISTARTSWITH "C:\\Windows\\fonts\\") OR where(Image ISTARTSWITH "C:\\Windows\\help\\") OR where(Image ISTARTSWITH "C:\\Windows\\drivers\\") OR where(Image ISTARTSWITH "C:\\Windows\\addins\\") OR where(Image ISTARTSWITH "C:\\Windows\\cursors\\") OR where(Image ISTARTSWITH "C:\\Windows\\system32\\tasks\\"))))
