// Title: Change PowerShell Policies to an Insecure Level
// ID: 87e3c4e8-a6a8-4ad9-bb4f-46e7ff99a180
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-11-01
// Tags: attack.execution, attack.t1059.001
// Description: Detects changing the PowerShell script execution policy to a potentially insecure level using the "-ExecutionPolicy" flag.
// Converted by: Sigma Universal SIEM/EDR CLI

(((((where(OriginalFileName = "powershell_ise.exe") OR where(OriginalFileName = "PowerShell.EXE") OR where(OriginalFileName = "pwsh.dll"))) OR ((where(Image IENDSWITH "\\powershell_ise.exe") OR where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe")))) AND ((where(CommandLine ICONTAINS "Bypass") OR where(CommandLine ICONTAINS "Unrestricted"))) AND ((where(CommandLine ICONTAINS "-executionpolicy ") OR where(CommandLine ICONTAINS " -ep ") OR where(CommandLine ICONTAINS " -exec ")))) AND NOT (((where(ParentImage = "C:\\Windows\\SysWOW64\\msiexec.exe") OR where(ParentImage = "C:\\Windows\\System32\\msiexec.exe")) AND (where(CommandLine ICONTAINS "-NoProfile -ExecutionPolicy Bypass -File \"C:\\Program Files\\PowerShell\\7\\") OR where(CommandLine ICONTAINS "-NoProfile -ExecutionPolicy Bypass -File \"C:\\Program Files (x86)\\PowerShell\\7\\")))) AND NOT (((where(ParentImage ICONTAINS "C:\\Program Files\\Avast Software\\Avast\\") OR where(ParentImage ICONTAINS "C:\\Program Files (x86)\\Avast Software\\Avast\\") OR where(ParentImage ICONTAINS "\\instup.exe")) AND (where(CommandLine ICONTAINS "-ExecutionPolicy ByPass -File \"C:\\Program Files\\Avast Software\\Avast") OR where(CommandLine ICONTAINS "-ExecutionPolicy ByPass -File \"C:\\Program Files (x86)\\Avast Software\\Avast\\")))))
