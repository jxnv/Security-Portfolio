// Title: Suspicious Serv-U Process Pattern
// ID: 58f4ea09-0fc2-4520-ba18-b85c540b0eaf
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-07-14
// Tags: attack.credential-access, attack.t1555, cve.2021-35211
// Description: Detects a suspicious process pattern which could be a sign of an exploited Serv-U service
// Converted by: Sigma Universal SIEM/EDR CLI

(where(ParentImage IENDSWITH "\\Serv-U.exe") AND (where(Image IENDSWITH "\\cmd.exe") OR where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe") OR where(Image IENDSWITH "\\wscript.exe") OR where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\sh.exe") OR where(Image IENDSWITH "\\bash.exe") OR where(Image IENDSWITH "\\schtasks.exe") OR where(Image IENDSWITH "\\regsvr32.exe") OR where(Image IENDSWITH "\\wmic.exe") OR where(Image IENDSWITH "\\mshta.exe") OR where(Image IENDSWITH "\\rundll32.exe") OR where(Image IENDSWITH "\\msiexec.exe") OR where(Image IENDSWITH "\\forfiles.exe") OR where(Image IENDSWITH "\\scriptrunner.exe")))
