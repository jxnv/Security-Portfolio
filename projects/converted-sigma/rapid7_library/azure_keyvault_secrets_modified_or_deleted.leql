// Title: Azure Keyvault Secrets Modified or Deleted
// ID: b831353c-1971-477b-abb6-2828edc3bca1
// Status: test
// Level: medium
// Author: Austin Songer @austinsonger
// Date: 2021-08-16
// Tags: attack.impact, attack.credential-access, attack.t1552, attack.t1552.001
// Description: Identifies when secrets are modified or deleted in Azure.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(operationName = "MICROSOFT.KEYVAULT/VAULTS/SECRETS/WRITE") OR where(operationName = "MICROSOFT.KEYVAULT/VAULTS/SECRETS/DELETE") OR where(operationName = "MICROSOFT.KEYVAULT/VAULTS/SECRETS/BACKUP/ACTION") OR where(operationName = "MICROSOFT.KEYVAULT/VAULTS/SECRETS/PURGE/ACTION") OR where(operationName = "MICROSOFT.KEYVAULT/VAULTS/SECRETS/UPDATE/ACTION") OR where(operationName = "MICROSOFT.KEYVAULT/VAULTS/SECRETS/RECOVER/ACTION") OR where(operationName = "MICROSOFT.KEYVAULT/VAULTS/SECRETS/RESTORE/ACTION") OR where(operationName = "MICROSOFT.KEYVAULT/VAULTS/SECRETS/SETSECRET/ACTION")))
