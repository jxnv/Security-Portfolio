// Title: Suspicious ShellExec_RunDLL Call Via Ordinal
// ID: 8823e85d-31d8-473e-b7f4-92da070f0fc6
// Status: test
// Level: high
// Author: Swachchhanda Shrawan Poudel
// Date: 2024-12-01
// Tags: attack.stealth, attack.t1218.011
// Description: Detects suspicious call to the "ShellExec_RunDLL" exported function of SHELL32.DLL through the ordinal number to launch other commands.
// Adversary might only use the ordinal number in order to bypass existing detection that alert on usage of ShellExec_RunDLL on CommandLine.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(ParentCommandLine ICONTAINS "SHELL32.DLL")) AND ((where(ParentCommandLine ICONTAINS "#568") OR where(ParentCommandLine ICONTAINS "#570") OR where(ParentCommandLine ICONTAINS "#572") OR where(ParentCommandLine ICONTAINS "#576")))) AND (((where(Image IENDSWITH "\\bash.exe") OR where(Image IENDSWITH "\\bitsadmin.exe") OR where(Image IENDSWITH "\\cmd.exe") OR where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\curl.exe") OR where(Image IENDSWITH "\\mshta.exe") OR where(Image IENDSWITH "\\msiexec.exe") OR where(Image IENDSWITH "\\msxsl.exe") OR where(Image IENDSWITH "\\odbcconf.exe") OR where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe") OR where(Image IENDSWITH "\\regsvr32.exe") OR where(Image IENDSWITH "\\schtasks.exe") OR where(Image IENDSWITH "\\wmic.exe") OR where(Image IENDSWITH "\\wscript.exe"))) OR (((where(ParentCommandLine ICONTAINS "comspec") OR where(ParentCommandLine ICONTAINS "iex") OR where(ParentCommandLine ICONTAINS "Invoke-") OR where(ParentCommandLine ICONTAINS "msiexec") OR where(ParentCommandLine ICONTAINS "odbcconf") OR where(ParentCommandLine ICONTAINS "regsvr32"))) OR ((where(ParentCommandLine ICONTAINS "\\Desktop\\") OR where(ParentCommandLine ICONTAINS "\\ProgramData\\") OR where(ParentCommandLine ICONTAINS "\\Temp\\") OR where(ParentCommandLine ICONTAINS "\\Users\\Public\\"))))))
