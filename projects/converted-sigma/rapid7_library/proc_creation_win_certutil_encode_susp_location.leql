// Title: File In Suspicious Location Encoded To Base64 Via Certutil.EXE
// ID: 82a6714f-4899-4f16-9c1e-9a333544d4c3
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-15
// Tags: attack.stealth, attack.t1027
// Description: Detects the execution of certutil with the "encode" flag to encode a file to base64 where the files are located in potentially suspicious locations
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "-encode") OR where(CommandLine ICONTAINS "/encode"))) AND ((where(CommandLine ICONTAINS "\\AppData\\Roaming\\") OR where(CommandLine ICONTAINS "\\Desktop\\") OR where(CommandLine ICONTAINS "\\Local\\Temp\\") OR where(CommandLine ICONTAINS "\\PerfLogs\\") OR where(CommandLine ICONTAINS "\\Users\\Public\\") OR where(CommandLine ICONTAINS "\\Windows\\Temp\\") OR where(CommandLine ICONTAINS "$Recycle.Bin"))) AND ((where(Image IENDSWITH "\\certutil.exe")) OR (where(OriginalFileName = "CertUtil.exe"))))
