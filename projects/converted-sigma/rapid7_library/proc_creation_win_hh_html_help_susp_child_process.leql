// Title: HTML Help HH.EXE Suspicious Child Process
// ID: 52cad028-0ff0-4854-8f67-d25dfcbc78b4
// Status: test
// Level: high
// Author: Maxim Pavlunin, Nasreddine Bencherchali (Nextron Systems)
// Date: 2020-04-01
// Tags: attack.execution, attack.initial-access, attack.stealth, attack.t1047, attack.t1059.001, attack.t1059.003, attack.t1059.005, attack.t1059.007, attack.t1218, attack.t1218.001, attack.t1218.010, attack.t1218.011, attack.t1566, attack.t1566.001
// Description: Detects a suspicious child process of a Microsoft HTML Help (HH.exe)
// Converted by: Sigma Universal SIEM/EDR CLI

(where(ParentImage IENDSWITH "\\hh.exe") AND (where(Image IENDSWITH "\\CertReq.exe") OR where(Image IENDSWITH "\\CertUtil.exe") OR where(Image IENDSWITH "\\cmd.exe") OR where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\installutil.exe") OR where(Image IENDSWITH "\\MSbuild.exe") OR where(Image IENDSWITH "\\MSHTA.EXE") OR where(Image IENDSWITH "\\msiexec.exe") OR where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe") OR where(Image IENDSWITH "\\regsvr32.exe") OR where(Image IENDSWITH "\\rundll32.exe") OR where(Image IENDSWITH "\\schtasks.exe") OR where(Image IENDSWITH "\\wmic.exe") OR where(Image IENDSWITH "\\wscript.exe")))
