// Title: Program Executions in Suspicious Folders
// ID: a39d7fa7-3fbd-4dc2-97e1-d87f546b1bbc
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2018-01-23
// Tags: attack.t1587, attack.t1584, attack.resource-development
// Description: Detects program executions in suspicious non-program folders related to malware or hacking activity
// Converted by: Sigma Universal SIEM/EDR CLI

(where(type = "SYSCALL") AND (where(exe ISTARTSWITH "/tmp/") OR where(exe ISTARTSWITH "/var/www/") OR where(exe ISTARTSWITH "/home/*/public_html/") OR where(exe ISTARTSWITH "/usr/local/apache2/") OR where(exe ISTARTSWITH "/usr/local/httpd/") OR where(exe ISTARTSWITH "/var/apache/") OR where(exe ISTARTSWITH "/srv/www/") OR where(exe ISTARTSWITH "/home/httpd/html/") OR where(exe ISTARTSWITH "/srv/http/") OR where(exe ISTARTSWITH "/usr/share/nginx/html/") OR where(exe ISTARTSWITH "/var/lib/pgsql/data/") OR where(exe ISTARTSWITH "/usr/local/mysql/data/") OR where(exe ISTARTSWITH "/var/lib/mysql/") OR where(exe ISTARTSWITH "/var/vsftpd/") OR where(exe ISTARTSWITH "/etc/bind/") OR where(exe ISTARTSWITH "/var/named/")))
