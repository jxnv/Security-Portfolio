// Title: PUA - Netcat Suspicious Execution
// ID: e31033fc-33f0-4020-9a16-faf9b31cbf08
// Status: test
// Level: high
// Author: frack113, Florian Roth (Nextron Systems)
// Date: 2021-07-21
// Tags: attack.command-and-control, attack.t1095
// Description: Detects execution of Netcat. Adversaries may use a non-application layer protocol for communication between host and C2 server or among infected hosts within a network
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS " -lvp ") OR where(CommandLine ICONTAINS " -lvnp") OR where(CommandLine ICONTAINS " -l -v -p ") OR where(CommandLine ICONTAINS " -lv -p ") OR where(CommandLine ICONTAINS " -l --proxy-type http ") OR where(CommandLine ICONTAINS " -vnl --exec ") OR where(CommandLine ICONTAINS " -vnl -e ") OR where(CommandLine ICONTAINS " --lua-exec ") OR where(CommandLine ICONTAINS " --sh-exec "))) OR ((where(Image IENDSWITH "\\nc.exe") OR where(Image IENDSWITH "\\ncat.exe") OR where(Image IENDSWITH "\\netcat.exe"))))
