// Title: Firewall Configuration Discovery Via Netsh.EXE
// ID: 0e4164da-94bc-450d-a7be-a4b176179f1f
// Status: test
// Level: low
// Author: frack113, Christopher Peacock '@securepeacock', SCYTHE '@scythe_io'
// Date: 2021-12-07
// Tags: attack.discovery, attack.t1016
// Description: Adversaries may look for details about the network configuration and settings of systems they access or through information discovery of remote systems
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "netsh") AND where(CommandLine ICONTAINS "show ") AND where(CommandLine ICONTAINS "firewall ")) AND (where(CommandLine ICONTAINS "config ") OR where(CommandLine ICONTAINS "state ") OR where(CommandLine ICONTAINS "rule ") OR where(CommandLine ICONTAINS "name=all"))) AND ((where(Image IENDSWITH "\\netsh.exe")) OR (where(OriginalFileName = "netsh.exe"))))
