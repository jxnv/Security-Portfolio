// Title: Script Interpreter Execution From Suspicious Folder
// ID: 1228c958-e64e-4e71-92ad-7d429f4138ba
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-02-08
// Tags: attack.execution, attack.t1059
// Description: Detects suspicious script execution from suspicious directories or folders accessible by environment variables that may indicate malware activity.
// Script interpreters (cscript, wscript, mshta, powershell) executing from folders like Temp, Public, or user profile directories may suggest attempts to evade detection or execute malicious scripts.
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(CommandLine ICONTAINS " -ep bypass ") OR where(CommandLine ICONTAINS " -ExecutionPolicy bypass ") OR where(CommandLine ICONTAINS " -w hidden ") OR where(CommandLine ICONTAINS "/e:javascript ") OR where(CommandLine ICONTAINS "/e:Jscript ") OR where(CommandLine ICONTAINS "/e:vbscript "))) OR ((where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\mshta.exe") OR where(Image IENDSWITH "\\wscript.exe"))) OR ((where(OriginalFileName = "cscript.exe") OR where(OriginalFileName = "mshta.exe") OR where(OriginalFileName = "wscript.exe")))) AND (((where(CommandLine ICONTAINS ":\\Perflogs\\") OR where(CommandLine ICONTAINS ":\\Users\\Public\\") OR where(CommandLine ICONTAINS "\\%Public%") OR where(CommandLine ICONTAINS "\\AppData\\Local\\Temp") OR where(CommandLine ICONTAINS "\\AppData\\Roaming\\Temp") OR where(CommandLine ICONTAINS "\\Temporary Internet") OR where(CommandLine ICONTAINS "\\Windows\\Temp") OR where(CommandLine ICONTAINS "\\Start Menu\\Programs\\Startup\\") OR where(CommandLine ICONTAINS "%TEMP%") OR where(CommandLine ICONTAINS "%TMP%") OR where(CommandLine ICONTAINS "%LocalAppData%\\Temp"))) OR (((where(CommandLine ICONTAINS ":\\Users\\") AND where(CommandLine ICONTAINS "\\Favorites\\"))) OR ((where(CommandLine ICONTAINS ":\\Users\\") AND where(CommandLine ICONTAINS "\\Favourites\\"))) OR ((where(CommandLine ICONTAINS ":\\Users\\") AND where(CommandLine ICONTAINS "\\Contacts\\"))) OR ((where(CommandLine ICONTAINS ":\\Users\\") AND where(CommandLine ICONTAINS "\\Documents\\"))) OR ((where(CommandLine ICONTAINS ":\\Users\\") AND where(CommandLine ICONTAINS "\\Music\\"))) OR ((where(CommandLine ICONTAINS ":\\Users\\") AND where(CommandLine ICONTAINS "\\Pictures\\"))) OR ((where(CommandLine ICONTAINS ":\\Users\\") AND where(CommandLine ICONTAINS "\\Videos\\"))))) AND NOT (((where(ParentImage = "C:\\Windows\\System32\\Msiexec.exe") OR where(ParentImage = "C:\\Windows\\SysWOW64\\Msiexec.exe")) AND where(Image IENDSWITH "\\powershell.exe") AND (where(CommandLine ICONTAINS "-NoProfile -ExecutionPolicy Bypass -Command") AND where(CommandLine ICONTAINS "AppData\\Local\\Temp\\") AND where(CommandLine ICONTAINS "Install-Chocolatey.ps1")))))
