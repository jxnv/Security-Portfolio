// Title: CobaltStrike Named Pipe Pattern Regex
// ID: 0e7163d4-9e19-4fa7-9be6-000c61aad77a
// Status: test
// Level: critical
// Author: Florian Roth (Nextron Systems)
// Date: 2021-07-30
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects the creation of a named pipe matching a pattern used by CobaltStrike Malleable C2 profiles
// Converted by: Sigma Universal SIEM/EDR CLI

((where(PipeName /\\mojo\.5688\.8052\.(?:183894939787088877|35780273329370473)[0-9a-f]{2}/)) OR (where(PipeName /\\wkssvc_?[0-9a-f]{2}/)) OR (where(PipeName /\\ntsvcs[0-9a-f]{2}/)) OR (where(PipeName /\\DserNamePipe[0-9a-f]{2}/)) OR (where(PipeName /\\SearchTextHarvester[0-9a-f]{2}/)) OR (where(PipeName /\\mypipe-(?:f|h)[0-9a-f]{2}/)) OR (where(PipeName /\\windows\.update\.manager[0-9a-f]{2,3}/)) OR (where(PipeName /\\ntsvcs_[0-9a-f]{2}/)) OR (where(PipeName /\\scerpc_?[0-9a-f]{2}/)) OR (where(PipeName /\\PGMessagePipe[0-9a-f]{2}/)) OR (where(PipeName /\\MsFteWds[0-9a-f]{2}/)) OR (where(PipeName /\\f4c3[0-9a-f]{2}/)) OR (where(PipeName /\\fullduplex_[0-9a-f]{2}/)) OR (where(PipeName /\\msrpc_[0-9a-f]{4}/)) OR (where(PipeName /\\win\\msrpc_[0-9a-f]{2}/)) OR (where(PipeName /\\f53f[0-9a-f]{2}$/)) OR (where(PipeName /\\rpc_[0-9a-f]{2}/)) OR (where(PipeName /\\spoolss_[0-9a-f]{2}/)) OR (where(PipeName /\\Winsock2\\CatalogChangeListener-[0-9a-f]{3}-0,/)))
