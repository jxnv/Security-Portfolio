// Title: DotNET Assembly DLL Loaded Via Office Application
// ID: ff0f2b05-09db-4095-b96d-1b75ca24894a
// Status: test
// Level: medium
// Author: Antonlovesdnb
// Date: 2020-02-19
// Tags: attack.execution, attack.t1204.002
// Description: Detects any assembly DLL being loaded by an Office Product
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image IENDSWITH "\\excel.exe") OR where(Image IENDSWITH "\\mspub.exe") OR where(Image IENDSWITH "\\onenote.exe") OR where(Image IENDSWITH "\\onenoteim.exe") OR where(Image IENDSWITH "\\outlook.exe") OR where(Image IENDSWITH "\\powerpnt.exe") OR where(Image IENDSWITH "\\winword.exe")) AND where(ImageLoaded ISTARTSWITH "C:\\Windows\\assembly\\"))
