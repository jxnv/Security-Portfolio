// Title: Renamed PAExec Execution
// ID: c4e49831-1496-40cf-8ce1-b53f942b02f9
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Jason Lynch
// Date: 2021-05-22
// Tags: attack.stealth, attack.t1202
// Description: Detects execution of renamed version of PAExec. Often used by attackers
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Description = "PAExec Application")) OR (where(OriginalFileName = "PAExec.exe")) OR (where(Product ICONTAINS "PAExec")) OR ((where(Hashes ICONTAINS "IMPHASH=11D40A7B7876288F919AB819CC2D9802") OR where(Hashes ICONTAINS "IMPHASH=6444f8a34e99b8f7d9647de66aabe516") OR where(Hashes ICONTAINS "IMPHASH=dfd6aa3f7b2b1035b76b718f1ddc689f") OR where(Hashes ICONTAINS "IMPHASH=1a6cca4d5460b1710a12dea39e4a592c")))) AND NOT (((where(Image IENDSWITH "\\paexec.exe")) OR (where(Image ISTARTSWITH "C:\\Windows\\PAExec-")))))
