// Title: Suspicious Login Activity Classified By Google
// ID: 38360161-76c4-4283-842e-efcf997dafc8
// Status: experimental
// Level: medium
// Author: Tom Kluter
// Date: 2026-04-28
// Tags: attack.initial-access, attack.privilege-escalation, attack.persistence, attack.stealth, attack.t1078.004
// Description: Detects Google Workspace login activity that's classified as suspicious by Google.
// Converted by: Sigma Universal SIEM/EDR CLI

(where(protoPayload.serviceName = "login.googleapis.com") AND (where(protoPayload.metadata.event.eventName = "suspicious_login_less_secure_app") OR where(protoPayload.metadata.event.eventName = "suspicious_login") OR where(protoPayload.metadata.event.eventName = "suspicious_programmatic_login")))
