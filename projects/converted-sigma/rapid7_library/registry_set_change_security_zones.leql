((where(TargetObject ICONTAINS "\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\ZoneMap\\Domains\\")) AND NOT (((where(Details = "DWORD (0x00000000)") OR where(Details = "DWORD (0x00000001)") OR where(Details = "(Empty)")))))
