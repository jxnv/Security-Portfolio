// Title: Potentially Suspicious Child Process Of ClickOnce Application
// ID: 67bc0e75-c0a9-4cfc-8754-84a505b63c04
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-12
// Tags: attack.execution, attack.stealth
// Description: Detects potentially suspicious child processes of a ClickOnce deployment application
// Converted by: Sigma Universal SIEM/EDR CLI

(where(ParentImage ICONTAINS "\\AppData\\Local\\Apps\\2.0\\") AND (where(Image IENDSWITH "\\calc.exe") OR where(Image IENDSWITH "\\cmd.exe") OR where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\explorer.exe") OR where(Image IENDSWITH "\\mshta.exe") OR where(Image IENDSWITH "\\net.exe") OR where(Image IENDSWITH "\\net1.exe") OR where(Image IENDSWITH "\\nltest.exe") OR where(Image IENDSWITH "\\notepad.exe") OR where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe") OR where(Image IENDSWITH "\\reg.exe") OR where(Image IENDSWITH "\\regsvr32.exe") OR where(Image IENDSWITH "\\rundll32.exe") OR where(Image IENDSWITH "\\schtasks.exe") OR where(Image IENDSWITH "\\werfault.exe") OR where(Image IENDSWITH "\\wscript.exe")))
