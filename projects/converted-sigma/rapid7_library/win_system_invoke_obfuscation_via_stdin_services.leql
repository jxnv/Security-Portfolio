// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via Stdin in Scripts
// Converted by: Sigma Universal SIEM/EDR CLI

(where(Provider_Name = "Service Control Manager") AND where(EventID = "7045") AND (where(ImagePath ICONTAINS "set") AND where(ImagePath ICONTAINS "&&")) AND (where(ImagePath ICONTAINS "environment") OR where(ImagePath ICONTAINS "invoke") OR where(ImagePath ICONTAINS "input")))
