// Title: MSSQL Server Failed Logon From External Network
// ID: ebfe73c2-5bc9-4ed9-aaa8-8b54b2b4777d
// Status: test
// Level: medium
// Author: j4son
// Date: 2023-10-11
// Tags: attack.credential-access, attack.t1110
// Description: Detects failed logon attempts from clients with external network IP to an MSSQL server. This can be a sign of a bruteforce attack.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Provider_Name ICONTAINS "MSSQL") AND where(EventID = "18456")) AND NOT (((where(Data ICONTAINS "CLIENT: 10.") OR where(Data ICONTAINS "CLIENT: 172.16.") OR where(Data ICONTAINS "CLIENT: 172.17.") OR where(Data ICONTAINS "CLIENT: 172.18.") OR where(Data ICONTAINS "CLIENT: 172.19.") OR where(Data ICONTAINS "CLIENT: 172.20.") OR where(Data ICONTAINS "CLIENT: 172.21.") OR where(Data ICONTAINS "CLIENT: 172.22.") OR where(Data ICONTAINS "CLIENT: 172.23.") OR where(Data ICONTAINS "CLIENT: 172.24.") OR where(Data ICONTAINS "CLIENT: 172.25.") OR where(Data ICONTAINS "CLIENT: 172.26.") OR where(Data ICONTAINS "CLIENT: 172.27.") OR where(Data ICONTAINS "CLIENT: 172.28.") OR where(Data ICONTAINS "CLIENT: 172.29.") OR where(Data ICONTAINS "CLIENT: 172.30.") OR where(Data ICONTAINS "CLIENT: 172.31.") OR where(Data ICONTAINS "CLIENT: 192.168.") OR where(Data ICONTAINS "CLIENT: 127.") OR where(Data ICONTAINS "CLIENT: 169.254.") OR where(Data ICONTAINS "CLIENT: <local machine>")))))
