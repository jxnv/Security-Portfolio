// Title: Local Groups Discovery - MacOs
// ID: 89bb1f97-c7b9-40e8-b52b-7d6afbd67276
// Status: test
// Level: informational
// Author: Ömer Günal, Alejandro Ortuno, oscd.community
// Date: 2020-10-11
// Tags: attack.discovery, attack.t1069.001
// Description: Detects enumeration of local system groups
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image IENDSWITH "/dscacheutil") AND (where(CommandLine ICONTAINS "-q") AND where(CommandLine ICONTAINS "group"))) OR (where(Image IENDSWITH "/cat") AND where(CommandLine ICONTAINS "/etc/group")) OR (where(Image IENDSWITH "/dscl") AND (where(CommandLine ICONTAINS "-list") AND where(CommandLine ICONTAINS "/groups"))))
