// Title: Suspicious User-Agents Related To Recon Tools
// ID: 19aa4f58-94ca-45ff-bc34-92e533c0994a
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Tim Shelton
// Date: 2022-07-19
// Tags: attack.initial-access, attack.t1190
// Description: Detects known suspicious (default) user-agents related to scanning/recon tools
// Converted by: Sigma Universal SIEM/EDR CLI

((where(cs-user-agent ICONTAINS "commix/") OR where(cs-user-agent ICONTAINS "feroxbuster/") OR where(cs-user-agent ICONTAINS "Fuzz Faster U Fool") OR where(cs-user-agent ICONTAINS "GIS - AppSec Team - Project Vision") OR where(cs-user-agent ICONTAINS "gobuster/") OR where(cs-user-agent ICONTAINS "Nikto/") OR where(cs-user-agent ICONTAINS "Nmap Scripting Engine") OR where(cs-user-agent ICONTAINS "Recon-ng/v") OR where(cs-user-agent ICONTAINS "sqlmap/") OR where(cs-user-agent ICONTAINS "WhatWeb/") OR where(cs-user-agent ICONTAINS "Wfuzz/") OR where(cs-user-agent ICONTAINS "WPScan v") OR where(cs-user-agent ICONTAINS "zgrab/")))
