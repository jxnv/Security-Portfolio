// Title: Suspicious Windows Defender Registry Key Tampering Via Reg.EXE
// ID: 452bce90-6fb0-43cc-97a5-affc283139b3
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Swachchhanda Shrawan Poudel, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-03-22
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects the usage of "reg.exe" to tamper with different Windows Defender registry keys in order to disable some important features related to protection and detection
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(Image IENDSWITH "\\reg.exe")) OR (where(OriginalFileName = "reg.exe"))) AND ((where(CommandLine ICONTAINS "SOFTWARE\\Microsoft\\Windows Defender\\") OR where(CommandLine ICONTAINS "SOFTWARE\\Policies\\Microsoft\\Windows Defender Security Center") OR where(CommandLine ICONTAINS "SOFTWARE\\Policies\\Microsoft\\Windows Defender\\")))) AND (((where(CommandLine ICONTAINS " add ") AND where(CommandLine ICONTAINS "d 0")) AND (where(CommandLine ICONTAINS "DisallowExploitProtectionOverride") OR where(CommandLine ICONTAINS "EnableControlledFolderAccess") OR where(CommandLine ICONTAINS "MpEnablePus") OR where(CommandLine ICONTAINS "PUAProtection") OR where(CommandLine ICONTAINS "SpynetReporting") OR where(CommandLine ICONTAINS "SubmitSamplesConsent") OR where(CommandLine ICONTAINS "TamperProtection"))) OR ((where(CommandLine ICONTAINS " add ") AND where(CommandLine ICONTAINS "d 1")) AND (where(CommandLine ICONTAINS "DisableAccess") OR where(CommandLine ICONTAINS "DisableAntiSpyware") OR where(CommandLine ICONTAINS "DisableAntiSpywareRealtimeProtection") OR where(CommandLine ICONTAINS "DisableAntiVirus") OR where(CommandLine ICONTAINS "DisableAntiVirusSignatures") OR where(CommandLine ICONTAINS "DisableArchiveScanning") OR where(CommandLine ICONTAINS "DisableBehaviorMonitoring") OR where(CommandLine ICONTAINS "DisableBlockAtFirstSeen") OR where(CommandLine ICONTAINS "DisableCloudProtection") OR where(CommandLine ICONTAINS "DisableConfig") OR where(CommandLine ICONTAINS "DisableEnhancedNotifications") OR where(CommandLine ICONTAINS "DisableIntrusionPreventionSystem") OR where(CommandLine ICONTAINS "DisableIOAVProtection") OR where(CommandLine ICONTAINS "DisableNetworkProtection") OR where(CommandLine ICONTAINS "DisableOnAccessProtection") OR where(CommandLine ICONTAINS "DisablePrivacyMode") OR where(CommandLine ICONTAINS "DisableRealtimeMonitoring") OR where(CommandLine ICONTAINS "DisableRoutinelyTakingAction") OR where(CommandLine ICONTAINS "DisableScanOnRealtimeEnable") OR where(CommandLine ICONTAINS "DisableScriptScanning") OR where(CommandLine ICONTAINS "DisableSecurityCenter") OR where(CommandLine ICONTAINS "Notification_Suppress") OR where(CommandLine ICONTAINS "SignatureDisableUpdateOnStartupWithoutEngine")))))
