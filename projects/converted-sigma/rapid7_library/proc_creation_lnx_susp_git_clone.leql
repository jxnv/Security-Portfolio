// Title: Suspicious Git Clone - Linux
// ID: cfec9d29-64ec-4a0f-9ffe-0fdb856d5446
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-03
// Tags: attack.reconnaissance, attack.t1593.003
// Description: Detects execution of "git" in order to clone a remote repository that contain suspicious keywords which might be suspicious
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image IENDSWITH "/git") AND where(CommandLine ICONTAINS " clone ")) AND ((where(CommandLine ICONTAINS "exploit") OR where(CommandLine ICONTAINS "Vulns") OR where(CommandLine ICONTAINS "vulnerability") OR where(CommandLine ICONTAINS "RCE") OR where(CommandLine ICONTAINS "RemoteCodeExecution") OR where(CommandLine ICONTAINS "Invoke-") OR where(CommandLine ICONTAINS "CVE-") OR where(CommandLine ICONTAINS "poc-") OR where(CommandLine ICONTAINS "ProofOfConcept") OR where(CommandLine ICONTAINS "proxyshell") OR where(CommandLine ICONTAINS "log4shell") OR where(CommandLine ICONTAINS "eternalblue") OR where(CommandLine ICONTAINS "eternal-blue") OR where(CommandLine ICONTAINS "MS17-"))))
