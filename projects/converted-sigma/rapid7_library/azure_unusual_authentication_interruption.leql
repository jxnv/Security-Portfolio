// Description: Detects when there is a interruption in the authentication process.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(ResultType = "50097") AND where(ResultDescription = "Device authentication is required")) OR (where(ResultType = "50155") AND where(ResultDescription = "DeviceAuthenticationFailed")) OR (where(ResultType = "50158") AND where(ResultDescription = "ExternalSecurityChallenge - External security challenge was not satisfied")))
