// Title: Suspicious Reg Add BitLocker
// ID: 0e0255bf-2548-47b8-9582-c0955c9283f5
// Status: test
// Level: high
// Author: frack113
// Date: 2021-11-15
// Tags: attack.impact, attack.t1486
// Description: Detects suspicious addition to BitLocker related registry keys via the reg.exe utility
// Converted by: Sigma Universal SIEM/EDR CLI

((where(CommandLine ICONTAINS "REG") AND where(CommandLine ICONTAINS "ADD") AND where(CommandLine ICONTAINS "\\SOFTWARE\\Policies\\Microsoft\\FVE") AND where(CommandLine ICONTAINS "/v") AND where(CommandLine ICONTAINS "/f")) AND (where(CommandLine ICONTAINS "EnableBDEWithNoTPM") OR where(CommandLine ICONTAINS "UseAdvancedStartup") OR where(CommandLine ICONTAINS "UseTPM") OR where(CommandLine ICONTAINS "UseTPMKey") OR where(CommandLine ICONTAINS "UseTPMKeyPIN") OR where(CommandLine ICONTAINS "RecoveryKeyMessageSource") OR where(CommandLine ICONTAINS "UseTPMPIN") OR where(CommandLine ICONTAINS "RecoveryKeyMessage")))
