// Title: Account Tampering - Suspicious Failed Logon Reasons
// ID: 9eb99343-d336-4020-a3cd-67f3819e68ee
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2017-02-19
// Tags: attack.persistence, attack.privilege-escalation, attack.initial-access, attack.stealth, attack.t1078
// Description: This method uses uncommon error codes on failed logons to determine suspicious activity and tampering with accounts that have been disabled or somehow restricted.
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(EventID = "4625") OR where(EventID = "4776"))) AND (((where(Status = "0xC0000072") OR where(Status = "0xC000006F") OR where(Status = "0xC0000070") OR where(Status = "0xC0000413") OR where(Status = "0xC000018C") OR where(Status = "0xC000015B"))) OR ((where(SubStatus = "0xC0000072") OR where(SubStatus = "0xC000006F") OR where(SubStatus = "0xC0000070") OR where(SubStatus = "0xC0000413") OR where(SubStatus = "0xC000018C") OR where(SubStatus = "0xC000015B"))))) AND NOT ((where(SubjectUserSid = "S-1-0-0"))))
