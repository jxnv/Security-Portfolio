// Title: Windows Defender Configuration Changes
// ID: 801bd44f-ceed-4eb6-887c-11544633c0aa
// Status: stable
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-06
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects suspicious changes to the Windows Defender configuration
// Converted by: Sigma Universal SIEM/EDR CLI

(where(EventID = "5007") AND (where(NewValue ICONTAINS "\\Windows Defender\\DisableAntiSpyware ") OR where(NewValue ICONTAINS "\\Windows Defender\\Scan\\DisableRemovableDriveScanning ") OR where(NewValue ICONTAINS "\\Windows Defender\\Scan\\DisableScanningMappedNetworkDrivesForFullScan ") OR where(NewValue ICONTAINS "\\Windows Defender\\SpyNet\\DisableBlockAtFirstSeen ") OR where(NewValue ICONTAINS "\\Real-Time Protection\\SpyNetReporting ")))
