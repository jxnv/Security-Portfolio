// Title: Download From Suspicious TLD - Whitelist
// ID: b5de2919-b74a-4805-91a7-5049accbaefe
// Status: test
// Level: low
// Author: Florian Roth (Nextron Systems)
// Date: 2017-03-13
// Tags: attack.initial-access, attack.t1566, attack.execution, attack.t1203, attack.t1204.002
// Description: Detects executable downloads from suspicious remote systems
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(c-uri-extension = "exe") OR where(c-uri-extension = "vbs") OR where(c-uri-extension = "bat") OR where(c-uri-extension = "rar") OR where(c-uri-extension = "ps1") OR where(c-uri-extension = "doc") OR where(c-uri-extension = "docm") OR where(c-uri-extension = "xls") OR where(c-uri-extension = "xlsm") OR where(c-uri-extension = "pptm") OR where(c-uri-extension = "rtf") OR where(c-uri-extension = "hta") OR where(c-uri-extension = "dll") OR where(c-uri-extension = "ws") OR where(c-uri-extension = "wsf") OR where(c-uri-extension = "sct") OR where(c-uri-extension = "zip"))) AND NOT (((where(cs-host IENDSWITH ".com") OR where(cs-host IENDSWITH ".org") OR where(cs-host IENDSWITH ".net") OR where(cs-host IENDSWITH ".edu") OR where(cs-host IENDSWITH ".gov") OR where(cs-host IENDSWITH ".uk") OR where(cs-host IENDSWITH ".ca") OR where(cs-host IENDSWITH ".de") OR where(cs-host IENDSWITH ".jp") OR where(cs-host IENDSWITH ".fr") OR where(cs-host IENDSWITH ".au") OR where(cs-host IENDSWITH ".us") OR where(cs-host IENDSWITH ".ch") OR where(cs-host IENDSWITH ".it") OR where(cs-host IENDSWITH ".nl") OR where(cs-host IENDSWITH ".se") OR where(cs-host IENDSWITH ".no") OR where(cs-host IENDSWITH ".es")))))
