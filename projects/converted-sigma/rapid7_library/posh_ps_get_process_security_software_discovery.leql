// Title: Security Software Discovery Via Powershell Script
// ID: 904e8e61-8edf-4350-b59c-b905fc8e810c
// Status: test
// Level: medium
// Author: frack113, Anish Bogati, Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-12-16
// Tags: attack.discovery, attack.t1518.001
// Description: Detects calls to "get-process" where the output is piped to a "where-object" filter to search for security solution processes.
// Adversaries may attempt to get a listing of security software, configurations, defensive tools, and sensors that are installed on a system or in a cloud environment. This may include things such as firewall rules and anti-virus
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(ScriptBlockText ICONTAINS "get-process | \\?") OR where(ScriptBlockText ICONTAINS "get-process | where") OR where(ScriptBlockText ICONTAINS "gps | \\?") OR where(ScriptBlockText ICONTAINS "gps | where"))) AND ((where(ScriptBlockText ICONTAINS "Company -like") OR where(ScriptBlockText ICONTAINS "Description -like") OR where(ScriptBlockText ICONTAINS "Name -like") OR where(ScriptBlockText ICONTAINS "Path -like") OR where(ScriptBlockText ICONTAINS "Product -like"))) AND ((where(ScriptBlockText ICONTAINS "\\*avira\\*") OR where(ScriptBlockText ICONTAINS "\\*carbonblack\\*") OR where(ScriptBlockText ICONTAINS "\\*cylance\\*") OR where(ScriptBlockText ICONTAINS "\\*defender\\*") OR where(ScriptBlockText ICONTAINS "\\*kaspersky\\*") OR where(ScriptBlockText ICONTAINS "\\*malware\\*") OR where(ScriptBlockText ICONTAINS "\\*sentinel\\*") OR where(ScriptBlockText ICONTAINS "\\*symantec\\*") OR where(ScriptBlockText ICONTAINS "\\*virus\\*"))))
