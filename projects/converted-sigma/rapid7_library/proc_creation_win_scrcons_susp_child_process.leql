// Title: Script Event Consumer Spawning Process
// ID: f6d1dd2f-b8ce-40ca-bc23-062efb686b34
// Status: test
// Level: high
// Author: Sittikorn S
// Date: 2021-06-21
// Tags: attack.execution, attack.t1047
// Description: Detects a suspicious child process of Script Event Consumer (scrcons.exe).
// Converted by: Sigma Universal SIEM/EDR CLI

(where(ParentImage IENDSWITH "\\scrcons.exe") AND (where(Image IENDSWITH "\\svchost.exe") OR where(Image IENDSWITH "\\dllhost.exe") OR where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe") OR where(Image IENDSWITH "\\wscript.exe") OR where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\schtasks.exe") OR where(Image IENDSWITH "\\regsvr32.exe") OR where(Image IENDSWITH "\\mshta.exe") OR where(Image IENDSWITH "\\rundll32.exe") OR where(Image IENDSWITH "\\msiexec.exe") OR where(Image IENDSWITH "\\msbuild.exe")))
