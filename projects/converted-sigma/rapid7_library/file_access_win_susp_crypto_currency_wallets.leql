// Title: Access To Crypto Currency Wallets By Uncommon Applications
// ID: f41b0311-44f9-44f0-816d-dd45e39d4bc8
// Status: test
// Level: medium
// Author: X__Junior (Nextron Systems)
// Date: 2024-07-29
// Tags: attack.t1003, attack.credential-access
// Description: Detects file access requests to crypto currency files by uncommon processes.
// Could indicate potential attempt of crypto currency wallet stealing.
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(FileName ICONTAINS "\\AppData\\Roaming\\Ethereum\\keystore\\") OR where(FileName ICONTAINS "\\AppData\\Roaming\\EthereumClassic\\keystore\\") OR where(FileName ICONTAINS "\\AppData\\Roaming\\monero\\wallets\\"))) OR ((where(FileName IENDSWITH "\\AppData\\Roaming\\Bitcoin\\wallet.dat") OR where(FileName IENDSWITH "\\AppData\\Roaming\\BitcoinABC\\wallet.dat") OR where(FileName IENDSWITH "\\AppData\\Roaming\\BitcoinSV\\wallet.dat") OR where(FileName IENDSWITH "\\AppData\\Roaming\\DashCore\\wallet.dat") OR where(FileName IENDSWITH "\\AppData\\Roaming\\DogeCoin\\wallet.dat") OR where(FileName IENDSWITH "\\AppData\\Roaming\\Litecoin\\wallet.dat") OR where(FileName IENDSWITH "\\AppData\\Roaming\\Ripple\\wallet.dat") OR where(FileName IENDSWITH "\\AppData\\Roaming\\Zcash\\wallet.dat")))) AND NOT ((((where(Image ISTARTSWITH "C:\\Program Files (x86)\\") OR where(Image ISTARTSWITH "C:\\Program Files\\") OR where(Image ISTARTSWITH "C:\\Windows\\system32\\") OR where(Image ISTARTSWITH "C:\\Windows\\SysWOW64\\"))) OR (where(Image = "System")))) AND NOT ((where(Image ISTARTSWITH "C:\\ProgramData\\Microsoft\\Windows Defender\\") AND (where(Image IENDSWITH "\\MpCopyAccelerator.exe") OR where(Image IENDSWITH "\\MsMpEng.exe")))))
