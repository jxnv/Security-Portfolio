// Title: Suspicious File Downloaded From Direct IP Via Certutil.EXE
// ID: 13e6fe51-d478-4c7e-b0f2-6da9b400a829
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-15
// Tags: attack.stealth, attack.t1027, attack.command-and-control, attack.t1105
// Description: Detects the execution of certutil with certain flags that allow the utility to download files from direct IPs.
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(CommandLine ICONTAINS "urlcache ") OR where(CommandLine ICONTAINS "verifyctl ") OR where(CommandLine ICONTAINS "URL "))) AND ((where(CommandLine ICONTAINS "://1") OR where(CommandLine ICONTAINS "://2") OR where(CommandLine ICONTAINS "://3") OR where(CommandLine ICONTAINS "://4") OR where(CommandLine ICONTAINS "://5") OR where(CommandLine ICONTAINS "://6") OR where(CommandLine ICONTAINS "://7") OR where(CommandLine ICONTAINS "://8") OR where(CommandLine ICONTAINS "://9"))) AND ((where(Image IENDSWITH "\\certutil.exe")) OR (where(OriginalFileName = "CertUtil.exe")))) AND NOT ((where(CommandLine ICONTAINS "://7-"))))
