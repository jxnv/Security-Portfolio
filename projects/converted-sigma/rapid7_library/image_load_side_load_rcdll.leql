// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of rcdll.dll
// Converted by: Sigma Universal SIEM/EDR CLI

((where(ImageLoaded IENDSWITH "\\rcdll.dll")) AND NOT (((where(ImageLoaded ISTARTSWITH "C:\\Program Files (x86)\\Microsoft Visual Studio\\") OR where(ImageLoaded ISTARTSWITH "C:\\Program Files (x86)\\Windows Kits\\")))))
