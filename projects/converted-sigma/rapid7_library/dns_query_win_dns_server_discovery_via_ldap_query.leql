// Title: DNS Server Discovery Via LDAP Query
// ID: a21bcd7e-38ec-49ad-b69a-9ea17e69509e
// Status: test
// Level: low
// Author: frack113
// Date: 2022-08-20
// Tags: attack.discovery, attack.t1482
// Description: Detects DNS server discovery via LDAP query requests from uncommon applications
// Converted by: Sigma Universal SIEM/EDR CLI

((where(QueryName ISTARTSWITH "_ldap.")) AND NOT (((where(Image ICONTAINS ":\\ProgramData\\Microsoft\\Windows Defender\\Platform\\") AND where(Image IENDSWITH "\\MsMpEng.exe")) OR ((where(Image ICONTAINS ":\\Program Files\\") OR where(Image ICONTAINS ":\\Program Files (x86)\\") OR where(Image ICONTAINS ":\\Windows\\"))) OR (NOT Image=*) OR (where(Image = "<unknown process>")))) AND NOT (((where(Image ISTARTSWITH "C:\\WindowsAzure\\GuestAgent")) OR ((where(Image IENDSWITH "\\chrome.exe") OR where(Image IENDSWITH "\\firefox.exe") OR where(Image IENDSWITH "\\opera.exe"))))))
