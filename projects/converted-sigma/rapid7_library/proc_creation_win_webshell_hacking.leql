// Date: 2022-03-17
// Tags: attack.persistence, attack.discovery, attack.t1505.003, attack.t1018, attack.t1033, attack.t1087
// Description: Detects certain parent child patterns found in cases in which a web shell is used to perform certain credential dumping or exfiltration activities on a compromised system
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(ParentImage IENDSWITH "\\java.exe") OR where(ParentImage IENDSWITH "\\javaw.exe")) AND (where(ParentImage ICONTAINS "-tomcat-") OR where(ParentImage ICONTAINS "\\tomcat"))) OR ((where(ParentImage IENDSWITH "\\java.exe") OR where(ParentImage IENDSWITH "\\javaw.exe")) AND (where(CommandLine ICONTAINS "catalina.jar") OR where(CommandLine ICONTAINS "CATALINA_HOME"))) OR ((where(ParentImage IENDSWITH "\\caddy.exe") OR where(ParentImage IENDSWITH "\\httpd.exe") OR where(ParentImage IENDSWITH "\\nginx.exe") OR where(ParentImage IENDSWITH "\\php-cgi.exe") OR where(ParentImage IENDSWITH "\\w3wp.exe") OR where(ParentImage IENDSWITH "\\ws_tomcatservice.exe")))) AND (((where(CommandLine ICONTAINS "rundll32") AND where(CommandLine ICONTAINS "comsvcs"))) OR ((where(CommandLine ICONTAINS " -hp") AND where(CommandLine ICONTAINS " a ") AND where(CommandLine ICONTAINS " -m"))) OR ((where(CommandLine ICONTAINS "net") AND where(CommandLine ICONTAINS " user ") AND where(CommandLine ICONTAINS " /add"))) OR ((where(CommandLine ICONTAINS "net") AND where(CommandLine ICONTAINS " localgroup ") AND where(CommandLine ICONTAINS " administrators ") AND where(CommandLine ICONTAINS "/add"))) OR ((where(Image IENDSWITH "\\ntdsutil.exe") OR where(Image IENDSWITH "\\ldifde.exe") OR where(Image IENDSWITH "\\adfind.exe") OR where(Image IENDSWITH "\\procdump.exe") OR where(Image IENDSWITH "\\Nanodump.exe") OR where(Image IENDSWITH "\\vssadmin.exe") OR where(Image IENDSWITH "\\fsutil.exe"))) OR ((where(CommandLine ICONTAINS " -decode ") OR where(CommandLine ICONTAINS " -NoP ") OR where(CommandLine ICONTAINS " -W Hidden ") OR where(CommandLine ICONTAINS " /decode ") OR where(CommandLine ICONTAINS " /ticket:") OR where(CommandLine ICONTAINS " sekurlsa") OR where(CommandLine ICONTAINS ".dmp full") OR where(CommandLine ICONTAINS ".downloadfile(") OR where(CommandLine ICONTAINS ".downloadstring(") OR where(CommandLine ICONTAINS "FromBase64String") OR where(CommandLine ICONTAINS "process call create") OR where(CommandLine ICONTAINS "reg save ") OR where(CommandLine ICONTAINS "whoami /priv")))))
