// Title: HTTP Request to Low Reputation TLD or Suspicious File Extension
// ID: 68c2c604-92ad-468b-bf4a-aac49adad08c
// Status: experimental
// Level: medium
// Author: @signalblur, Corelight
// Date: 2025-02-26
// Tags: attack.initial-access, attack.command-and-control
// Description: Detects HTTP requests to low reputation TLDs (e.g. .xyz, .top, .ru) or ending in suspicious file extensions (.exe, .dll, .hta), which may indicate malicious activity.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(host IENDSWITH ".bid") OR where(host IENDSWITH ".by") OR where(host IENDSWITH ".cf") OR where(host IENDSWITH ".click") OR where(host IENDSWITH ".cm") OR where(host IENDSWITH ".ga") OR where(host IENDSWITH ".gq") OR where(host IENDSWITH ".ir") OR where(host IENDSWITH ".kp") OR where(host IENDSWITH ".loan") OR where(host IENDSWITH ".ml") OR where(host IENDSWITH ".mm") OR where(host IENDSWITH ".party") OR where(host IENDSWITH ".pw") OR where(host IENDSWITH ".ru") OR where(host IENDSWITH ".su") OR where(host IENDSWITH ".sy") OR where(host IENDSWITH ".tk") OR where(host IENDSWITH ".top") OR where(host IENDSWITH ".tv") OR where(host IENDSWITH ".ve") OR where(host IENDSWITH ".work") OR where(host IENDSWITH ".xyz"))) AND (((where(uri IENDSWITH ".bat") OR where(uri IENDSWITH ".bin") OR where(uri IENDSWITH ".cmd") OR where(uri IENDSWITH ".cpl") OR where(uri IENDSWITH ".dll") OR where(uri IENDSWITH ".dylib") OR where(uri IENDSWITH ".elf") OR where(uri IENDSWITH ".exe") OR where(uri IENDSWITH ".hta") OR where(uri IENDSWITH ".iso") OR where(uri IENDSWITH ".jar") OR where(uri IENDSWITH ".js") OR where(uri IENDSWITH ".lnk") OR where(uri IENDSWITH ".msi") OR where(uri IENDSWITH ".pif") OR where(uri IENDSWITH ".ps1") OR where(uri IENDSWITH ".py") OR where(uri IENDSWITH ".reg") OR where(uri IENDSWITH ".scr") OR where(uri IENDSWITH ".sh") OR where(uri IENDSWITH ".so") OR where(uri IENDSWITH ".vbs") OR where(uri IENDSWITH ".wsf"))) OR ((where(resp_mime_types = "application/vnd.microsoft.portable-executable") OR where(resp_mime_types = "application/x-bat") OR where(resp_mime_types = "application/x-dosexec") OR where(resp_mime_types = "application/x-elf") OR where(resp_mime_types = "application/x-iso9660-image") OR where(resp_mime_types = "application/x-java-archive") OR where(resp_mime_types = "application/x-ms-shortcut") OR where(resp_mime_types = "application/x-msdos-program") OR where(resp_mime_types = "application/x-msdownload") OR where(resp_mime_types = "application/x-python-code") OR where(resp_mime_types = "application/x-sh")))))
