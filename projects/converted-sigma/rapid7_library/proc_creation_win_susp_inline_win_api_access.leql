// Title: Potential WinAPI Calls Via CommandLine
// ID: ba3f5c1b-6272-4119-9dbd-0bc8d21c2702
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-06
// Tags: attack.execution, attack.t1106
// Description: Detects the use of WinAPI Functions via the commandline. As seen used by threat actors via the tool winapiexec
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "AddSecurityPackage") OR where(CommandLine ICONTAINS "AdjustTokenPrivileges") OR where(CommandLine ICONTAINS "Advapi32") OR where(CommandLine ICONTAINS "CloseHandle") OR where(CommandLine ICONTAINS "CreateProcessWithToken") OR where(CommandLine ICONTAINS "CreatePseudoConsole") OR where(CommandLine ICONTAINS "CreateRemoteThread") OR where(CommandLine ICONTAINS "CreateThread") OR where(CommandLine ICONTAINS "CreateUserThread") OR where(CommandLine ICONTAINS "DangerousGetHandle") OR where(CommandLine ICONTAINS "DuplicateTokenEx") OR where(CommandLine ICONTAINS "EnumerateSecurityPackages") OR where(CommandLine ICONTAINS "FreeHGlobal") OR where(CommandLine ICONTAINS "FreeLibrary") OR where(CommandLine ICONTAINS "GetDelegateForFunctionPointer") OR where(CommandLine ICONTAINS "GetLogonSessionData") OR where(CommandLine ICONTAINS "GetModuleHandle") OR where(CommandLine ICONTAINS "GetProcAddress") OR where(CommandLine ICONTAINS "GetProcessHandle") OR where(CommandLine ICONTAINS "GetTokenInformation") OR where(CommandLine ICONTAINS "ImpersonateLoggedOnUser") OR where(CommandLine ICONTAINS "kernel32") OR where(CommandLine ICONTAINS "LoadLibrary") OR where(CommandLine ICONTAINS "memcpy") OR where(CommandLine ICONTAINS "MiniDumpWriteDump") OR where(CommandLine ICONTAINS "ntdll") OR where(CommandLine ICONTAINS "OpenDesktop") OR where(CommandLine ICONTAINS "OpenProcess") OR where(CommandLine ICONTAINS "OpenProcessToken") OR where(CommandLine ICONTAINS "OpenThreadToken") OR where(CommandLine ICONTAINS "OpenWindowStation") OR where(CommandLine ICONTAINS "PtrToString") OR where(CommandLine ICONTAINS "QueueUserApc") OR where(CommandLine ICONTAINS "ReadProcessMemory") OR where(CommandLine ICONTAINS "RevertToSelf") OR where(CommandLine ICONTAINS "RtlCreateUserThread") OR where(CommandLine ICONTAINS "secur32") OR where(CommandLine ICONTAINS "SetThreadToken") OR where(CommandLine ICONTAINS "VirtualAlloc") OR where(CommandLine ICONTAINS "VirtualFree") OR where(CommandLine ICONTAINS "VirtualProtect") OR where(CommandLine ICONTAINS "WaitForSingleObject") OR where(CommandLine ICONTAINS "WriteInt32") OR where(CommandLine ICONTAINS "WriteProcessMemory") OR where(CommandLine ICONTAINS "ZeroFreeGlobalAllocUnicode"))) AND NOT (((where(ParentImage IENDSWITH "\\CompatTelRunner.exe") AND (where(CommandLine ICONTAINS "FreeHGlobal") OR where(CommandLine ICONTAINS "PtrToString") OR where(CommandLine ICONTAINS "kernel32") OR where(CommandLine ICONTAINS "CloseHandle"))) OR (where(Image IENDSWITH "\\MpCmdRun.exe") AND where(CommandLine ICONTAINS "GetLoadLibraryWAddress32")))))
