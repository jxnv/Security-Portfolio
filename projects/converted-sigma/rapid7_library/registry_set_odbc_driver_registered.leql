// Title: New ODBC Driver Registered
// ID: 3390fbef-c98d-4bdd-a863-d65ed7c610dd
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-23
// Tags: attack.persistence
// Description: Detects the registration of a new ODBC driver.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(TargetObject ICONTAINS "\\SOFTWARE\\ODBC\\ODBCINST.INI\\") AND where(TargetObject IENDSWITH "\\Driver")) AND NOT ((where(TargetObject ICONTAINS "\\SQL Server\\") AND where(Details = "%WINDIR%\\System32\\SQLSRV32.dll"))) AND NOT (((where(TargetObject ICONTAINS "\\Microsoft Access ") AND where(Details ISTARTSWITH "C:\\Progra") AND where(Details IENDSWITH "\\ACEODBC.DLL")) OR (where(TargetObject ICONTAINS "\\Microsoft Excel Driver") AND where(Details ISTARTSWITH "C:\\Progra") AND where(Details IENDSWITH "\\ACEODBC.DLL")))))
