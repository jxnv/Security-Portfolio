// Title: Modify Group Policy Settings
// ID: ada4b0c4-758b-46ac-9033-9004613a150d
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-08-19
// Tags: attack.privilege-escalation, attack.defense-impairment, attack.t1484.001
// Description: Detect malicious GPO modifications can be used to implement many other malicious behaviors.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "GroupPolicyRefreshTimeDC") OR where(CommandLine ICONTAINS "GroupPolicyRefreshTimeOffsetDC") OR where(CommandLine ICONTAINS "GroupPolicyRefreshTime") OR where(CommandLine ICONTAINS "GroupPolicyRefreshTimeOffset") OR where(CommandLine ICONTAINS "EnableSmartScreen") OR where(CommandLine ICONTAINS "ShellSmartScreenLevel"))) AND (where(CommandLine ICONTAINS "\\SOFTWARE\\Policies\\Microsoft\\Windows\\System")) AND ((where(Image IENDSWITH "\\reg.exe")) OR (where(OriginalFileName = "reg.exe"))))
