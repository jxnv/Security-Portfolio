// Title: Potentially Suspicious Child Process Of VsCode
// ID: 5a3164f2-b373-4152-93cf-090b13c12d27
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-26
// Tags: attack.execution, attack.stealth, attack.t1218, attack.t1202
// Description: Detects uncommon or suspicious child processes spawning from a VsCode "code.exe" process. This could indicate an attempt of persistence via VsCode tasks or terminal profiles.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(ParentImage IENDSWITH "\\code.exe")) AND (((where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe") OR where(Image IENDSWITH "\\cmd.exe")) AND (where(CommandLine ICONTAINS "Invoke-Expressions") OR where(CommandLine ICONTAINS "IEX") OR where(CommandLine ICONTAINS "Invoke-Command") OR where(CommandLine ICONTAINS "ICM") OR where(CommandLine ICONTAINS "DownloadString") OR where(CommandLine ICONTAINS "rundll32") OR where(CommandLine ICONTAINS "regsvr32") OR where(CommandLine ICONTAINS "wscript") OR where(CommandLine ICONTAINS "cscript"))) OR ((where(Image IENDSWITH "\\calc.exe") OR where(Image IENDSWITH "\\regsvr32.exe") OR where(Image IENDSWITH "\\rundll32.exe") OR where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\wscript.exe"))) OR ((where(Image ICONTAINS ":\\Users\\Public\\") OR where(Image ICONTAINS ":\\Windows\\Temp\\") OR where(Image ICONTAINS ":\\Temp\\")))))
