// Title: Antivirus - Ransomware Signature
// ID: 4c6ca276-d4d0-4a8c-9e4c-d69832f8671f
// Status: test
// Level: critical
// Author: Florian Roth (Nextron Systems), Arnim Rupp
// Date: 2022-05-12
// Tags: attack.t1486, attack.impact
// Description: Detects a highly relevant Antivirus alert that reports ransomware.
// This event must not be ignored just because the AV has blocked the malware but investigate, how it came there in the first place.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Signature ICONTAINS "Babuk") OR where(Signature ICONTAINS "Babyk") OR where(Signature ICONTAINS "BlackWorm") OR where(Signature ICONTAINS "Chaos") OR where(Signature ICONTAINS "Cobra") OR where(Signature ICONTAINS "ContiCrypt") OR where(Signature ICONTAINS "Crypter") OR where(Signature ICONTAINS "Cryptes") OR where(Signature ICONTAINS "Cryptor") OR where(Signature ICONTAINS "CylanCrypt") OR where(Signature ICONTAINS "DelShad") OR where(Signature ICONTAINS "Destructor") OR where(Signature ICONTAINS "Filecoder") OR where(Signature ICONTAINS "GandCrab") OR where(Signature ICONTAINS "GrandCrab") OR where(Signature ICONTAINS "Haperlock") OR where(Signature ICONTAINS "Hiddentear") OR where(Signature ICONTAINS "HydraCrypt") OR where(Signature ICONTAINS "Krypt") OR where(Signature ICONTAINS "Lockbit") OR where(Signature ICONTAINS "Locker") OR where(Signature ICONTAINS "Mallox") OR where(Signature ICONTAINS "Medusa") OR where(Signature ICONTAINS "Phobos") OR where(Signature ICONTAINS "Ransom") OR where(Signature ICONTAINS "Rook") OR where(Signature ICONTAINS "Ryuk") OR where(Signature ICONTAINS "Ryzerlo") OR where(Signature ICONTAINS "Stopcrypt") OR where(Signature ICONTAINS "Tescrypt") OR where(Signature ICONTAINS "TeslaCrypt") OR where(Signature ICONTAINS "WannaCry") OR where(Signature ICONTAINS "Xorist")))
