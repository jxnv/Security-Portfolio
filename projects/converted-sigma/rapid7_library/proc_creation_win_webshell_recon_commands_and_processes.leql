// Description: Detects certain command line parameters often used during reconnaissance activity via web shells
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(ParentImage IENDSWITH "\\java.exe") OR where(ParentImage IENDSWITH "\\javaw.exe")) AND (where(ParentImage ICONTAINS "-tomcat-") OR where(ParentImage ICONTAINS "\\tomcat"))) OR ((where(ParentImage IENDSWITH "\\java.exe") OR where(ParentImage IENDSWITH "\\javaw.exe")) AND (where(CommandLine ICONTAINS "catalina.jar") OR where(CommandLine ICONTAINS "CATALINA_HOME"))) OR ((where(ParentImage IENDSWITH "\\w3wp.exe") OR where(ParentImage IENDSWITH "\\php-cgi.exe") OR where(ParentImage IENDSWITH "\\nginx.exe") OR where(ParentImage IENDSWITH "\\httpd.exe") OR where(ParentImage IENDSWITH "\\caddy.exe") OR where(ParentImage IENDSWITH "\\ws_tomcatservice.exe")))) AND (((where(CommandLine ICONTAINS "&cd&echo") OR where(CommandLine ICONTAINS "cd /d "))) OR (((where(Image IENDSWITH "\\dsquery.exe") OR where(Image IENDSWITH "\\find.exe") OR where(Image IENDSWITH "\\findstr.exe") OR where(Image IENDSWITH "\\ipconfig.exe") OR where(Image IENDSWITH "\\netstat.exe") OR where(Image IENDSWITH "\\nslookup.exe") OR where(Image IENDSWITH "\\pathping.exe") OR where(Image IENDSWITH "\\quser.exe") OR where(Image IENDSWITH "\\schtasks.exe") OR where(Image IENDSWITH "\\systeminfo.exe") OR where(Image IENDSWITH "\\tasklist.exe") OR where(Image IENDSWITH "\\tracert.exe") OR where(Image IENDSWITH "\\wevtutil.exe") OR where(Image IENDSWITH "\\whoami.exe"))) OR ((where(OriginalFileName = "dsquery.exe") OR where(OriginalFileName = "find.exe") OR where(OriginalFileName = "findstr.exe") OR where(OriginalFileName = "ipconfig.exe") OR where(OriginalFileName = "netstat.exe") OR where(OriginalFileName = "nslookup.exe") OR where(OriginalFileName = "pathping.exe") OR where(OriginalFileName = "quser.exe") OR where(OriginalFileName = "schtasks.exe") OR where(OriginalFileName = "sysinfo.exe") OR where(OriginalFileName = "tasklist.exe") OR where(OriginalFileName = "tracert.exe") OR where(OriginalFileName = "VSSADMIN.EXE") OR where(OriginalFileName = "wevtutil.exe") OR where(OriginalFileName = "whoami.exe")))) OR ((where(CommandLine ICONTAINS " Test-NetConnection ") OR where(CommandLine ICONTAINS "dir \\"))) OR ((where(OriginalFileName = "net.exe") OR where(OriginalFileName = "net1.exe")) AND (where(CommandLine ICONTAINS " user ") OR where(CommandLine ICONTAINS " use ") OR where(CommandLine ICONTAINS " group "))) OR (where(OriginalFileName = "ping.exe") AND where(CommandLine ICONTAINS " -n ")) OR ((where(Image IENDSWITH "\\cmd.exe") OR where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe")) AND (where(CommandLine ICONTAINS " -enc ") OR where(CommandLine ICONTAINS " -EncodedCommand ") OR where(CommandLine ICONTAINS " -w hidden ") OR where(CommandLine ICONTAINS " -windowstyle hidden") OR where(CommandLine ICONTAINS ".WebClient).Download"))) OR (where(OriginalFileName = "wmic.exe") AND where(CommandLine ICONTAINS " /node:"))))
