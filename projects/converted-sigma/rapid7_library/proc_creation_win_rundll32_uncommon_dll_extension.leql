// Title: Rundll32 Execution With Uncommon DLL Extension
// ID: c3a99af4-35a9-4668-879e-c09aeb4f2bdf
// Status: test
// Level: medium
// Author: Tim Shelton, Florian Roth (Nextron Systems), Yassine Oukessou
// Date: 2022-01-13
// Tags: attack.stealth, attack.t1218.011
// Description: Detects the execution of rundll32 with a command line that doesn't contain a common extension
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "\\rundll32.exe")) OR (where(OriginalFileName = "RUNDLL32.EXE"))) AND NOT (((where(CommandLine = "")) OR (((where(CommandLine ICONTAINS ".cpl ") OR where(CommandLine ICONTAINS ".cpl,") OR where(CommandLine ICONTAINS ".cpl\"") OR where(CommandLine ICONTAINS ".cpl'") OR where(CommandLine ICONTAINS ".dll ") OR where(CommandLine ICONTAINS ".dll,") OR where(CommandLine ICONTAINS ".dll\"") OR where(CommandLine ICONTAINS ".dll'") OR where(CommandLine ICONTAINS ".inf ") OR where(CommandLine ICONTAINS ".inf,") OR where(CommandLine ICONTAINS ".inf\"") OR where(CommandLine ICONTAINS ".inf'"))) OR ((where(CommandLine IENDSWITH ".cpl") OR where(CommandLine IENDSWITH ".dll") OR where(CommandLine IENDSWITH ".inf")))) OR (where(CommandLine ICONTAINS " -localserver ")) OR (NOT CommandLine=*) OR (where(ParentImage IENDSWITH "\\msiexec.exe") AND (where(CommandLine ICONTAINS ":\\Windows\\Installer\\") AND where(CommandLine ICONTAINS ".tmp") AND where(CommandLine ICONTAINS "zzzzInvokeManagedCustomActionOutOfProc"))))) AND NOT (((where(ParentCommandLine ICONTAINS ":\\Users\\") AND where(ParentCommandLine ICONTAINS "\\AppData\\Local\\Microsoft\\EdgeUpdate\\Install\\{") AND where(ParentCommandLine ICONTAINS "\\EDGEMITMP_") AND where(ParentCommandLine ICONTAINS ".tmp\\setup.exe") AND where(ParentCommandLine ICONTAINS "--install-archive=") AND where(ParentCommandLine ICONTAINS "--previous-version=") AND where(ParentCommandLine ICONTAINS "--msedgewebview --verbose-logging --do-not-launch-msedge --user-level")))))
