// Title: Sensitive File Recovery From Backup Via Wbadmin.EXE
// ID: 84972c80-251c-4c3a-9079-4f00aad93938
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), frack113
// Date: 2024-05-10
// Tags: attack.credential-access, attack.t1003.003
// Description: Detects the dump of highly sensitive files such as "NTDS.DIT" and "SECURITY" hive.
// Attackers can leverage the "wbadmin" utility in order to dump sensitive files that might contain credential or sensitive information.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS " recovery") AND where(CommandLine ICONTAINS "recoveryTarget") AND where(CommandLine ICONTAINS "itemtype:File")) AND (where(CommandLine ICONTAINS "\\config\\SAM") OR where(CommandLine ICONTAINS "\\config\\SECURITY") OR where(CommandLine ICONTAINS "\\config\\SYSTEM") OR where(CommandLine ICONTAINS "\\Windows\\NTDS\\NTDS.dit"))) AND ((where(Image IENDSWITH "\\wbadmin.exe")) OR (where(OriginalFileName = "WBADMIN.EXE"))))
