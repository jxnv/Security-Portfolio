// Description: Detects potential DLL sideloading of "DbgModel.dll"
// Converted by: Sigma Universal SIEM/EDR CLI

((where(ImageLoaded IENDSWITH "\\dbgmodel.dll")) AND NOT (((where(ImageLoaded ISTARTSWITH "C:\\Windows\\System32\\") OR where(ImageLoaded ISTARTSWITH "C:\\Windows\\SysWOW64\\") OR where(ImageLoaded ISTARTSWITH "C:\\Windows\\WinSxS\\")))) AND NOT (((where(ImageLoaded ISTARTSWITH "C:\\Program Files\\WindowsApps\\Microsoft.WinDbg_")) OR ((where(ImageLoaded ISTARTSWITH "C:\\Program Files (x86)\\Windows Kits\\") OR where(ImageLoaded ISTARTSWITH "C:\\Program Files\\Windows Kits\\"))))))
