// Title: Important Scheduled Task Deleted/Disabled
// ID: 7595ba94-cf3b-4471-aa03-4f6baa9e5fad
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-05
// Tags: attack.execution, attack.privilege-escalation, attack.persistence, attack.t1053.005
// Description: Detects when adversaries stop services or processes by deleting or disabling their respective scheduled tasks in order to conduct data destructive activities
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(EventID = "4699") OR where(EventID = "4701")) AND (where(TaskName ICONTAINS "\\Windows\\SystemRestore\\SR") OR where(TaskName ICONTAINS "\\Windows\\Windows Defender\\") OR where(TaskName ICONTAINS "\\Windows\\BitLocker") OR where(TaskName ICONTAINS "\\Windows\\WindowsBackup\\") OR where(TaskName ICONTAINS "\\Windows\\WindowsUpdate\\") OR where(TaskName ICONTAINS "\\Windows\\UpdateOrchestrator\\Schedule") OR where(TaskName ICONTAINS "\\Windows\\ExploitGuard"))) AND NOT ((where(EventID = "4699") AND where(SubjectUserName IENDSWITH "$") AND where(TaskName ICONTAINS "\\Windows\\Windows Defender\\"))))
