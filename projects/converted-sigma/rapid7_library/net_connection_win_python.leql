// Title: Python Initiated Connection
// ID: bef0bc5a-b9ae-425d-85c6-7b2d705980c6
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-12-10
// Tags: attack.discovery, attack.t1046
// Description: Detects a Python process initiating a network connection. While this often relates to package installation, it can also indicate a potential malicious script communicating with a C&C server.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Initiated = "true") AND (where(Image ICONTAINS "\\python") AND where(Image ICONTAINS ".exe"))) AND NOT (((where(DestinationIp = "127.0.0.1") AND where(SourceIp = "127.0.0.1")) OR ((where(CommandLine ICONTAINS "pip.exe") AND where(CommandLine ICONTAINS "install"))))) AND NOT (((where(ParentImage = "C:\\ProgramData\\Anaconda3\\Scripts\\conda.exe") AND (where(CommandLine ICONTAINS ":\\ProgramData\\Anaconda3\\Scripts\\conda-script.py") AND where(CommandLine ICONTAINS "update"))) OR (where(ParentImage = "C:\\ProgramData\\Anaconda3\\python.exe") AND where(CommandLine ICONTAINS "C:\\ProgramData\\Anaconda3\\Scripts\\jupyter-notebook-script.py")))))
