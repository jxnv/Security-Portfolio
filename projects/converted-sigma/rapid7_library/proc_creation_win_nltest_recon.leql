// Title: Potential Recon Activity Via Nltest.EXE
// ID: 5cc90652-4cbd-4241-aa3b-4b462fa5a248
// Status: test
// Level: medium
// Author: Craig Young, oscd.community, Georg Lauenstein
// Date: 2021-07-24
// Tags: attack.discovery, attack.t1016, attack.t1482
// Description: Detects nltest commands that can be used for information discovery
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "\\nltest.exe")) OR (where(OriginalFileName = "nltestrk.exe"))) AND (((where(CommandLine ICONTAINS "server") AND where(CommandLine ICONTAINS "query"))) OR ((where(CommandLine ICONTAINS "/user") OR where(CommandLine ICONTAINS "all_trusts") OR where(CommandLine ICONTAINS "dclist:") OR where(CommandLine ICONTAINS "dnsgetdc:") OR where(CommandLine ICONTAINS "domain_trusts") OR where(CommandLine ICONTAINS "dsgetdc:") OR where(CommandLine ICONTAINS "parentdomain") OR where(CommandLine ICONTAINS "trusted_domains")))))
