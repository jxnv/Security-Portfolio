// Title: LSASS Memory Access by Tool With Dump Keyword In Name
// ID: 9bd012ee-0dff-44d7-84a0-aa698cfd87a3
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-10
// Tags: attack.credential-access, attack.t1003.001, attack.s0002
// Description: Detects LSASS process access requests from a source process with the "dump" keyword in its image name.
// Converted by: Sigma Universal SIEM/EDR CLI

(where(TargetImage IENDSWITH "\\lsass.exe") AND where(SourceImage ICONTAINS "dump") AND (where(GrantedAccess IENDSWITH "10") OR where(GrantedAccess IENDSWITH "30") OR where(GrantedAccess IENDSWITH "50") OR where(GrantedAccess IENDSWITH "70") OR where(GrantedAccess IENDSWITH "90") OR where(GrantedAccess IENDSWITH "B0") OR where(GrantedAccess IENDSWITH "D0") OR where(GrantedAccess IENDSWITH "F0") OR where(GrantedAccess IENDSWITH "18") OR where(GrantedAccess IENDSWITH "38") OR where(GrantedAccess IENDSWITH "58") OR where(GrantedAccess IENDSWITH "78") OR where(GrantedAccess IENDSWITH "98") OR where(GrantedAccess IENDSWITH "B8") OR where(GrantedAccess IENDSWITH "D8") OR where(GrantedAccess IENDSWITH "F8") OR where(GrantedAccess IENDSWITH "1A") OR where(GrantedAccess IENDSWITH "3A") OR where(GrantedAccess IENDSWITH "5A") OR where(GrantedAccess IENDSWITH "7A") OR where(GrantedAccess IENDSWITH "9A") OR where(GrantedAccess IENDSWITH "BA") OR where(GrantedAccess IENDSWITH "DA") OR where(GrantedAccess IENDSWITH "FA") OR where(GrantedAccess IENDSWITH "0x14C2") OR where(GrantedAccess IENDSWITH "FF")))
