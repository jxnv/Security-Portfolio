// Title: Curl File Upload To File Sharing Websites
// ID: e328cc73-f92a-42fb-b3fa-7c2cffda981a
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-03-29
// Tags: attack.exfiltration, attack.t1567.002
// Description: Detects usage of curl to upload files to known file sharing domains, which may indicate data exfiltration.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "0x0.st") OR where(CommandLine ICONTAINS "bashupload.com") OR where(CommandLine ICONTAINS "chunk.io") OR where(CommandLine ICONTAINS "file.io") OR where(CommandLine ICONTAINS "filebin.net") OR where(CommandLine ICONTAINS "pastebin") OR where(CommandLine ICONTAINS "send.firefox.com") OR where(CommandLine ICONTAINS "temp.sh") OR where(CommandLine ICONTAINS "transfer.sh") OR where(CommandLine ICONTAINS "ufile.io") OR where(CommandLine ICONTAINS "uploadfiles.io") OR where(CommandLine ICONTAINS "wetransfer.com") OR where(CommandLine ICONTAINS "x0.at"))) AND (((where(CommandLine ICONTAINS " --form") OR where(CommandLine ICONTAINS " --upload-file") OR where(CommandLine ICONTAINS " --data") OR where(CommandLine ICONTAINS " -X POST") OR where(CommandLine ICONTAINS " --request POST "))) OR ((where(CommandLine /\s-[FTd]\s/) OR where(CommandLine /\s-sT\s/)))) AND ((where(Image IENDSWITH "\\curl.exe")) OR (where(OriginalFileName = "curl.exe"))))
