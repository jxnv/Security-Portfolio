// Title: Suspicious Parent Double Extension File Execution
// ID: 5e6a80c8-2d45-4633-9ef4-fa2671a39c5c
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-06
// Tags: attack.stealth, attack.t1036.007
// Description: Detect execution of suspicious double extension files in ParentCommandLine
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(ParentImage IENDSWITH ".doc.lnk") OR where(ParentImage IENDSWITH ".docx.lnk") OR where(ParentImage IENDSWITH ".xls.lnk") OR where(ParentImage IENDSWITH ".xlsx.lnk") OR where(ParentImage IENDSWITH ".ppt.lnk") OR where(ParentImage IENDSWITH ".pptx.lnk") OR where(ParentImage IENDSWITH ".rtf.lnk") OR where(ParentImage IENDSWITH ".pdf.lnk") OR where(ParentImage IENDSWITH ".txt.lnk") OR where(ParentImage IENDSWITH ".doc.js") OR where(ParentImage IENDSWITH ".docx.js") OR where(ParentImage IENDSWITH ".xls.js") OR where(ParentImage IENDSWITH ".xlsx.js") OR where(ParentImage IENDSWITH ".ppt.js") OR where(ParentImage IENDSWITH ".pptx.js") OR where(ParentImage IENDSWITH ".rtf.js") OR where(ParentImage IENDSWITH ".pdf.js") OR where(ParentImage IENDSWITH ".txt.js"))) OR ((where(ParentCommandLine ICONTAINS ".doc.lnk") OR where(ParentCommandLine ICONTAINS ".docx.lnk") OR where(ParentCommandLine ICONTAINS ".xls.lnk") OR where(ParentCommandLine ICONTAINS ".xlsx.lnk") OR where(ParentCommandLine ICONTAINS ".ppt.lnk") OR where(ParentCommandLine ICONTAINS ".pptx.lnk") OR where(ParentCommandLine ICONTAINS ".rtf.lnk") OR where(ParentCommandLine ICONTAINS ".pdf.lnk") OR where(ParentCommandLine ICONTAINS ".txt.lnk") OR where(ParentCommandLine ICONTAINS ".doc.js") OR where(ParentCommandLine ICONTAINS ".docx.js") OR where(ParentCommandLine ICONTAINS ".xls.js") OR where(ParentCommandLine ICONTAINS ".xlsx.js") OR where(ParentCommandLine ICONTAINS ".ppt.js") OR where(ParentCommandLine ICONTAINS ".pptx.js") OR where(ParentCommandLine ICONTAINS ".rtf.js") OR where(ParentCommandLine ICONTAINS ".pdf.js") OR where(ParentCommandLine ICONTAINS ".txt.js"))))
