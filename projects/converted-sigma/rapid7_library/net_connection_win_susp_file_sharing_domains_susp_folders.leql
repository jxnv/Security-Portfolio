// Title: Network Communication Initiated To File Sharing Domains From Process Located In Suspicious Folder
// ID: e0f8ab85-0ac9-423b-a73a-81b3c7b1aa97
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2018-08-30
// Tags: attack.command-and-control, attack.t1105
// Description: Detects executables located in potentially suspicious directories initiating network connections towards file sharing domains.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Initiated = "true") AND (where(DestinationHostname IENDSWITH ".githubusercontent.com") OR where(DestinationHostname IENDSWITH "0x0.st") OR where(DestinationHostname IENDSWITH "anonfiles.com") OR where(DestinationHostname IENDSWITH "bashupload.com") OR where(DestinationHostname IENDSWITH "cdn.discordapp.com") OR where(DestinationHostname IENDSWITH "chunk.io") OR where(DestinationHostname IENDSWITH "ddns.net") OR where(DestinationHostname IENDSWITH "dl.dropboxusercontent.com") OR where(DestinationHostname IENDSWITH "ghostbin.co") OR where(DestinationHostname IENDSWITH "github.com") OR where(DestinationHostname IENDSWITH "glitch.me") OR where(DestinationHostname IENDSWITH "gofile.io") OR where(DestinationHostname IENDSWITH "hastebin.com") OR where(DestinationHostname IENDSWITH "mediafire.com") OR where(DestinationHostname IENDSWITH "mega.co.nz") OR where(DestinationHostname IENDSWITH "mega.nz") OR where(DestinationHostname IENDSWITH "onrender.com") OR where(DestinationHostname IENDSWITH "pages.dev") OR where(DestinationHostname IENDSWITH "paste.ee") OR where(DestinationHostname IENDSWITH "pastebin.com") OR where(DestinationHostname IENDSWITH "pastebin.pl") OR where(DestinationHostname IENDSWITH "pastetext.net") OR where(DestinationHostname IENDSWITH "pixeldrain.com") OR where(DestinationHostname IENDSWITH "privatlab.com") OR where(DestinationHostname IENDSWITH "privatlab.net") OR where(DestinationHostname IENDSWITH "send.exploit.in") OR where(DestinationHostname IENDSWITH "sendspace.com") OR where(DestinationHostname IENDSWITH "storage.googleapis.com") OR where(DestinationHostname IENDSWITH "storjshare.io") OR where(DestinationHostname IENDSWITH "supabase.co") OR where(DestinationHostname IENDSWITH "temp.sh") OR where(DestinationHostname IENDSWITH "transfer.sh") OR where(DestinationHostname IENDSWITH "trycloudflare.com") OR where(DestinationHostname IENDSWITH "ufile.io") OR where(DestinationHostname IENDSWITH "w3spaces.com") OR where(DestinationHostname IENDSWITH "workers.dev") OR where(DestinationHostname IENDSWITH "x0.at"))) AND ((where(Image ICONTAINS ":\\$Recycle.bin") OR where(Image ICONTAINS ":\\Perflogs\\") OR where(Image ICONTAINS ":\\Temp\\") OR where(Image ICONTAINS ":\\Users\\Default\\") OR where(Image ICONTAINS ":\\Users\\Public\\") OR where(Image ICONTAINS ":\\Windows\\Fonts\\") OR where(Image ICONTAINS ":\\Windows\\IME\\") OR where(Image ICONTAINS ":\\Windows\\System32\\Tasks\\") OR where(Image ICONTAINS ":\\Windows\\Tasks\\") OR where(Image ICONTAINS ":\\Windows\\Temp\\") OR where(Image ICONTAINS "\\AppData\\Temp\\") OR where(Image ICONTAINS "\\config\\systemprofile\\") OR where(Image ICONTAINS "\\Windows\\addins\\"))))
