// Title: Suspicious Use of PsLogList
// ID: aae1243f-d8af-40d8-ab20-33fc6d0c55bc
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-12-18
// Tags: attack.discovery, attack.t1087, attack.t1087.001, attack.t1087.002
// Description: Detects usage of the PsLogList utility to dump event log in order to extract admin accounts and perform account discovery or delete events logs
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS " security") OR where(CommandLine ICONTAINS " application") OR where(CommandLine ICONTAINS " system"))) AND ((where(CommandLine ICONTAINS " -d") OR where(CommandLine ICONTAINS " -x") OR where(CommandLine ICONTAINS " -s") OR where(CommandLine ICONTAINS " -c") OR where(CommandLine ICONTAINS " -g"))) AND ((where(OriginalFileName = "psloglist.exe")) OR ((where(Image IENDSWITH "\\psloglist.exe") OR where(Image IENDSWITH "\\psloglist64.exe") OR where(Image IENDSWITH "\\psloglist64a.exe")))))
