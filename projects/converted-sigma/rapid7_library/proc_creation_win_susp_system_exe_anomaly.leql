// Tags: attack.stealth, attack.t1036
// Description: Detects the execution of a Windows system binary that is usually located in the system folder from an uncommon location.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "\\atbroker.exe") OR where(Image IENDSWITH "\\audiodg.exe") OR where(Image IENDSWITH "\\bcdedit.exe") OR where(Image IENDSWITH "\\bitsadmin.exe") OR where(Image IENDSWITH "\\certreq.exe") OR where(Image IENDSWITH "\\certutil.exe") OR where(Image IENDSWITH "\\cmstp.exe") OR where(Image IENDSWITH "\\conhost.exe") OR where(Image IENDSWITH "\\consent.exe") OR where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\csrss.exe") OR where(Image IENDSWITH "\\dashost.exe") OR where(Image IENDSWITH "\\defrag.exe") OR where(Image IENDSWITH "\\dfrgui.exe") OR where(Image IENDSWITH "\\dism.exe") OR where(Image IENDSWITH "\\dllhost.exe") OR where(Image IENDSWITH "\\dllhst3g.exe") OR where(Image IENDSWITH "\\dwm.exe") OR where(Image IENDSWITH "\\eventvwr.exe") OR where(Image IENDSWITH "\\fsquirt.exe") OR where(Image IENDSWITH "\\finger.exe") OR where(Image IENDSWITH "\\logonui.exe") OR where(Image IENDSWITH "\\LsaIso.exe") OR where(Image IENDSWITH "\\lsass.exe") OR where(Image IENDSWITH "\\lsm.exe") OR where(Image IENDSWITH "\\msiexec.exe") OR where(Image IENDSWITH "\\ntoskrnl.exe") OR where(Image IENDSWITH "\\powershell_ise.exe") OR where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe") OR where(Image IENDSWITH "\\regsvr32.exe") OR where(Image IENDSWITH "\\rundll32.exe") OR where(Image IENDSWITH "\\runonce.exe") OR where(Image IENDSWITH "\\RuntimeBroker.exe") OR where(Image IENDSWITH "\\schtasks.exe") OR where(Image IENDSWITH "\\services.exe") OR where(Image IENDSWITH "\\sihost.exe") OR where(Image IENDSWITH "\\smartscreen.exe") OR where(Image IENDSWITH "\\smss.exe") OR where(Image IENDSWITH "\\spoolsv.exe") OR where(Image IENDSWITH "\\svchost.exe") OR where(Image IENDSWITH "\\taskhost.exe") OR where(Image IENDSWITH "\\taskhostw.exe") OR where(Image IENDSWITH "\\Taskmgr.exe") OR where(Image IENDSWITH "\\userinit.exe") OR where(Image IENDSWITH "\\werfault.exe") OR where(Image IENDSWITH "\\werfaultsecure.exe") OR where(Image IENDSWITH "\\wininit.exe") OR where(Image IENDSWITH "\\winlogon.exe") OR where(Image IENDSWITH "\\winver.exe") OR where(Image IENDSWITH "\\wlanext.exe") OR where(Image IENDSWITH "\\wmic.exe") OR where(Image IENDSWITH "\\wscript.exe") OR where(Image IENDSWITH "\\wsl.exe") OR where(Image IENDSWITH "\\wsmprovhost.exe"))) AND NOT ((((where(Image ISTARTSWITH "C:\\$WINDOWS.~BT\\") OR where(Image ISTARTSWITH "C:\\$WinREAgent\\") OR where(Image ISTARTSWITH "C:\\Windows\\SoftwareDistribution\\") OR where(Image ISTARTSWITH "C:\\Windows\\System32\\") OR where(Image ISTARTSWITH "C:\\Windows\\SystemTemp\\") OR where(Image ISTARTSWITH "C:\\Windows\\SysWOW64\\") OR where(Image ISTARTSWITH "C:\\Windows\\uus\\") OR where(Image ISTARTSWITH "C:\\Windows\\WinSxS\\"))) OR ((where(Image ICONTAINS "C:\\Program Files\\PowerShell\\7\\") OR where(Image ICONTAINS "C:\\Program Files\\PowerShell\\7-preview\\") OR where(Image ICONTAINS "C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview") OR where(Image ICONTAINS "\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview")) AND where(Image IENDSWITH "\\pwsh.exe")) OR (where(Image ISTARTSWITH "C:\\Users\\") AND where(Image ICONTAINS "\\AppData\\Local\\Microsoft\\WindowsApps\\") AND where(Image IENDSWITH "\\wsl.exe")) OR ((where(Image ISTARTSWITH "C:\\Program Files\\WindowsApps\\MicrosoftCorporationII.WindowsSubsystemForLinux") OR where(Image ISTARTSWITH "C:\\Program Files\\WSL\\")) AND where(Image IENDSWITH "\\wsl.exe")))) AND NOT ((where(Image ICONTAINS "\\SystemRoot\\System32\\"))))
