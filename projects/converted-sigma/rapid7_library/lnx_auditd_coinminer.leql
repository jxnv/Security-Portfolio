// Description: Detects command line parameter very often used with coin miners
// Converted by: Sigma Universal SIEM/EDR CLI

((where(a1 ISTARTSWITH "--cpu-priority")) OR (where(a2 ISTARTSWITH "--cpu-priority")) OR (where(a3 ISTARTSWITH "--cpu-priority")) OR (where(a4 ISTARTSWITH "--cpu-priority")) OR (where(a5 ISTARTSWITH "--cpu-priority")) OR (where(a6 ISTARTSWITH "--cpu-priority")) OR (where(a7 ISTARTSWITH "--cpu-priority")))
