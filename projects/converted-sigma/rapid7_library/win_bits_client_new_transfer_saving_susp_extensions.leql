// Title: BITS Transfer Job Downloading File Potential Suspicious Extension
// ID: b85e5894-9b19-4d86-8c87-a2f3b81f0521
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-03-01
// Tags: attack.persistence, attack.execution, attack.stealth, attack.t1197
// Description: Detects new BITS transfer job saving local files with potential suspicious extensions
// Converted by: Sigma Universal SIEM/EDR CLI

((where(EventID = "16403") AND (where(LocalName IENDSWITH ".bat") OR where(LocalName IENDSWITH ".dll") OR where(LocalName IENDSWITH ".exe") OR where(LocalName IENDSWITH ".hta") OR where(LocalName IENDSWITH ".ps1") OR where(LocalName IENDSWITH ".psd1") OR where(LocalName IENDSWITH ".sh") OR where(LocalName IENDSWITH ".vbe") OR where(LocalName IENDSWITH ".vbs"))) AND NOT ((where(LocalName ICONTAINS "\\AppData\\") AND where(RemoteName ICONTAINS ".com"))))
