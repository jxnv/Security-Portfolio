// Title: Windows Processes Suspicious Parent Directory
// ID: 96036718-71cc-4027-a538-d1587e0006a7
// Status: test
// Level: low
// Author: vburov
// Date: 2019-02-23
// Tags: attack.stealth, attack.t1036.003, attack.t1036.005
// Description: Detect suspicious parent processes of well-known Windows processes
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "\\svchost.exe") OR where(Image IENDSWITH "\\taskhost.exe") OR where(Image IENDSWITH "\\lsm.exe") OR where(Image IENDSWITH "\\lsass.exe") OR where(Image IENDSWITH "\\services.exe") OR where(Image IENDSWITH "\\lsaiso.exe") OR where(Image IENDSWITH "\\csrss.exe") OR where(Image IENDSWITH "\\wininit.exe") OR where(Image IENDSWITH "\\winlogon.exe"))) AND NOT ((((where(ParentImage ICONTAINS "\\Windows Defender\\") OR where(ParentImage ICONTAINS "\\Microsoft Security Client\\")) AND where(ParentImage IENDSWITH "\\MsMpEng.exe")) OR ((NOT ParentImage=*) OR ((where(ParentImage = "") OR where(ParentImage = "-")))) OR (((where(ParentImage IENDSWITH "\\SavService.exe") OR where(ParentImage IENDSWITH "\\ngen.exe"))) OR ((where(ParentImage ICONTAINS "\\System32\\") OR where(ParentImage ICONTAINS "\\SysWOW64\\")))))))
