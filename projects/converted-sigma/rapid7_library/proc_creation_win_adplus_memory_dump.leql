// Title: Potential Adplus.EXE Abuse
// ID: 2f869d59-7f6a-4931-992c-cce556ff2d53
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-09
// Tags: attack.execution, attack.credential-access, attack.t1003.001
// Description: Detects execution of "AdPlus.exe", a binary that is part of the Windows SDK that can be used as a LOLBIN in order to dump process memory and execute arbitrary commands.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS " -hang ") OR where(CommandLine ICONTAINS " -pn ") OR where(CommandLine ICONTAINS " -pmn ") OR where(CommandLine ICONTAINS " -p ") OR where(CommandLine ICONTAINS " -po ") OR where(CommandLine ICONTAINS " -c ") OR where(CommandLine ICONTAINS " -sc "))) AND ((where(Image IENDSWITH "\\adplus.exe")) OR (where(OriginalFileName = "Adplus.exe"))))
