// Title: BloodHound Collection Files
// ID: 02773bed-83bf-469f-b7ff-e676e7d78bab
// Status: test
// Level: high
// Author: C.J. May
// Date: 2022-08-09
// Tags: attack.discovery, attack.t1087.001, attack.t1087.002, attack.t1482, attack.t1069.001, attack.t1069.002, attack.execution, attack.t1059.001
// Description: Detects default file names outputted by the BloodHound collection tool SharpHound
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(TargetFilename IENDSWITH "BloodHound.zip") OR where(TargetFilename IENDSWITH "_computers.json") OR where(TargetFilename IENDSWITH "_containers.json") OR where(TargetFilename IENDSWITH "_gpos.json") OR where(TargetFilename IENDSWITH "_groups.json") OR where(TargetFilename IENDSWITH "_ous.json") OR where(TargetFilename IENDSWITH "_users.json"))) AND NOT ((where(Image IENDSWITH "\\svchost.exe") AND where(TargetFilename ISTARTSWITH "C:\\Program Files\\WindowsApps\\Microsoft.") AND where(TargetFilename IENDSWITH "\\pocket_containers.json"))))
