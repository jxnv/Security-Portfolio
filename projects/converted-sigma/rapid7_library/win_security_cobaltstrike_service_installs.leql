// Title: CobaltStrike Service Installations - Security
// ID: d7a95147-145f-4678-b85d-d1ff4a3bb3f6
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Wojciech Lesicki
// Date: 2021-05-26
// Tags: attack.persistence, attack.execution, attack.privilege-escalation, attack.lateral-movement, attack.t1021.002, attack.t1543.003, attack.t1569.002
// Description: Detects known malicious service installs that appear in cases in which a Cobalt Strike beacon elevates privileges or lateral movement
// Converted by: Sigma Universal SIEM/EDR CLI

((where(EventID = "4697")) AND (((where(ServiceFileName ICONTAINS "ADMIN$") AND where(ServiceFileName ICONTAINS ".exe"))) OR ((where(ServiceFileName ICONTAINS "%COMSPEC%") AND where(ServiceFileName ICONTAINS "start") AND where(ServiceFileName ICONTAINS "powershell"))) OR (where(ServiceFileName ICONTAINS "powershell -nop -w hidden -encodedcommand")) OR ((where(ServiceFileName ICONTAINS "SUVYIChOZXctT2JqZWN0IE5ldC5XZWJjbGllbnQpLkRvd25sb2FkU3RyaW5nKCdodHRwOi8vMTI3LjAuMC4xO") OR where(ServiceFileName ICONTAINS "lFWCAoTmV3LU9iamVjdCBOZXQuV2ViY2xpZW50KS5Eb3dubG9hZFN0cmluZygnaHR0cDovLzEyNy4wLjAuMT") OR where(ServiceFileName ICONTAINS "JRVggKE5ldy1PYmplY3QgTmV0LldlYmNsaWVudCkuRG93bmxvYWRTdHJpbmcoJ2h0dHA6Ly8xMjcuMC4wLjE6")))))
