// Title: Linux Webshell Indicators
// ID: 818f7b24-0fba-4c49-a073-8b755573b9c7
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-10-15
// Tags: attack.persistence, attack.t1505.003
// Description: Detects suspicious sub processes of web server processes
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(ParentImage IENDSWITH "/httpd") OR where(ParentImage IENDSWITH "/lighttpd") OR where(ParentImage IENDSWITH "/nginx") OR where(ParentImage IENDSWITH "/apache2") OR where(ParentImage IENDSWITH "/node") OR where(ParentImage IENDSWITH "/caddy"))) OR ((where(ParentCommandLine ICONTAINS "/bin/java") AND where(ParentCommandLine ICONTAINS "tomcat"))) OR ((where(ParentCommandLine ICONTAINS "/bin/java") AND where(ParentCommandLine ICONTAINS "websphere")))) AND ((where(Image IENDSWITH "/whoami") OR where(Image IENDSWITH "/ifconfig") OR where(Image IENDSWITH "/ip") OR where(Image IENDSWITH "/bin/uname") OR where(Image IENDSWITH "/bin/cat") OR where(Image IENDSWITH "/bin/crontab") OR where(Image IENDSWITH "/hostname") OR where(Image IENDSWITH "/iptables") OR where(Image IENDSWITH "/netstat") OR where(Image IENDSWITH "/pwd") OR where(Image IENDSWITH "/route"))) AND NOT ((where(ParentImage IENDSWITH "/node") AND where(CommandLine ICONTAINS "ip neigh show"))))
