NTAINS "-DisableScriptScanning $true") OR where(Data ICONTAINS "-DisableScriptScanning 1") OR where(Data ICONTAINS "-MAPSReporting $false") OR where(Data ICONTAINS "-MAPSReporting 0") OR where(Data ICONTAINS "-drdsc $true") OR where(Data ICONTAINS "-drdsc 1") OR where(Data ICONTAINS "-drtm $true") OR where(Data ICONTAINS "-drtm 1") OR where(Data ICONTAINS "-dscrptsc $true") OR where(Data ICONTAINS "-dscrptsc 1") OR where(Data ICONTAINS "-dsmndf $true") OR where(Data ICONTAINS "-dsmndf 1") OR where(Data ICONTAINS "-dsnf $true") OR where(Data ICONTAINS "-dsnf 1") OR where(Data ICONTAINS "-dss $true") OR where(Data ICONTAINS "-dss 1")))))
