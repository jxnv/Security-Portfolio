// Title: Suspicious Microsoft Office Child Process
// ID: 438025f9-5856-4663-83f7-52f878a70a50
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Markus Neis, FPT.EagleEye Team, Vadim Khrykov, Cyb3rEng, Michael Haag, Christopher Peacock @securepeacock, @scythe_io
// Date: 2018-04-06
// Tags: attack.execution, attack.stealth, attack.t1047, attack.t1204.002, attack.t1218.010
// Description: Detects a suspicious process spawning from one of the Microsoft Office suite products (Word, Excel, PowerPoint, Publisher, Visio, etc.)
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(ParentImage IENDSWITH "\\EQNEDT32.EXE") OR where(ParentImage IENDSWITH "\\EXCEL.EXE") OR where(ParentImage IENDSWITH "\\MSACCESS.EXE") OR where(ParentImage IENDSWITH "\\MSPUB.exe") OR where(ParentImage IENDSWITH "\\ONENOTE.EXE") OR where(ParentImage IENDSWITH "\\POWERPNT.exe") OR where(ParentImage IENDSWITH "\\VISIO.exe") OR where(ParentImage IENDSWITH "\\WINWORD.EXE") OR where(ParentImage IENDSWITH "\\wordpad.exe") OR where(ParentImage IENDSWITH "\\wordview.exe"))) AND ((((where(OriginalFileName = "bitsadmin.exe") OR where(OriginalFileName = "CertOC.exe") OR where(OriginalFileName = "CertUtil.exe") OR where(OriginalFileName = "Cmd.Exe") OR where(OriginalFileName = "CMSTP.EXE") OR where(OriginalFileName = "cscript.exe") OR where(OriginalFileName = "curl.exe") OR where(OriginalFileName = "HH.exe") OR where(OriginalFileName = "IEExec.exe") OR where(OriginalFileName = "InstallUtil.exe") OR where(OriginalFileName = "javaw.exe") OR where(OriginalFileName = "Microsoft.Workflow.Compiler.exe") OR where(OriginalFileName = "msdt.exe") OR where(OriginalFileName = "MSHTA.EXE") OR where(OriginalFileName = "msiexec.exe") OR where(OriginalFileName = "Msxsl.exe") OR where(OriginalFileName = "odbcconf.exe") OR where(OriginalFileName = "pcalua.exe") OR where(OriginalFileName = "PowerShell.EXE") OR where(OriginalFileName = "RegAsm.exe") OR where(OriginalFileName = "RegSvcs.exe") OR where(OriginalFileName = "REGSVR32.exe") OR where(OriginalFileName = "RUNDLL32.exe") OR where(OriginalFileName = "schtasks.exe") OR where(OriginalFileName = "ScriptRunner.exe") OR where(OriginalFileName = "wmic.exe") OR where(OriginalFileName = "WorkFolders.exe") OR where(OriginalFileName = "wscript.exe"))) OR ((where(Image IENDSWITH "\\AppVLP.exe") OR where(Image IENDSWITH "\\bash.exe") OR where(Image IENDSWITH "\\bitsadmin.exe") OR where(Image IENDSWITH "\\certoc.exe") OR where(Image IENDSWITH "\\certutil.exe") OR where(Image IENDSWITH "\\cmd.exe") OR where(Image IENDSWITH "\\cmstp.exe") OR where(Image IENDSWITH "\\control.exe") OR where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\curl.exe") OR where(Image IENDSWITH "\\forfiles.exe") OR where(Image IENDSWITH "\\hh.exe") OR where(Image IENDSWITH "\\ieexec.exe") OR where(Image IENDSWITH "\\installutil.exe") OR where(Image IENDSWITH "\\javaw.exe") OR where(Image IENDSWITH "\\mftrace.exe") OR where(Image IENDSWITH "\\Microsoft.Workflow.Compiler.exe") OR where(Image IENDSWITH "\\msbuild.exe") OR where(Image IENDSWITH "\\msdt.exe") OR where(Image IENDSWITH "\\mshta.exe") OR where(Image IENDSWITH "\\msidb.exe") OR where(Image IENDSWITH "\\msiexec.exe") OR where(Image IENDSWITH "\\msxsl.exe") OR where(Image IENDSWITH "\\odbcconf.exe") OR where(Image IENDSWITH "\\pcalua.exe") OR where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe") OR where(Image IENDSWITH "\\regasm.exe") OR where(Image IENDSWITH "\\regsvcs.exe") OR where(Image IENDSWITH "\\regsvr32.exe") OR where(Image IENDSWITH "\\rundll32.exe") OR where(Image IENDSWITH "\\schtasks.exe") OR where(Image IENDSWITH "\\scrcons.exe") OR where(Image IENDSWITH "\\scriptrunner.exe") OR where(Image IENDSWITH "\\sh.exe") OR where(Image IENDSWITH "\\svchost.exe") OR where(Image IENDSWITH "\\verclsid.exe") OR where(Image IENDSWITH "\\wmic.exe") OR where(Image IENDSWITH "\\workfolders.exe") OR where(Image IENDSWITH "\\wscript.exe")))) OR ((where(Image ICONTAINS "\\AppData\\") OR where(Image ICONTAINS "\\Users\\Public\\") OR where(Image ICONTAINS "\\ProgramData\\") OR where(Image ICONTAINS "\\Windows\\Tasks\\") OR where(Image ICONTAINS "\\Windows\\Temp\\") OR where(Image ICONTAINS "\\Windows\\System32\\Tasks\\")))))
