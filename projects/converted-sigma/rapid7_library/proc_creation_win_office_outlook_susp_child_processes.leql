// Title: Suspicious Outlook Child Process
// ID: 208748f7-881d-47ac-a29c-07ea84bf691d
// Status: test
// Level: high
// Author: Michael Haag, Florian Roth (Nextron Systems), Markus Neis, Elastic, FPT.EagleEye Team
// Date: 2022-02-28
// Tags: attack.execution, attack.t1204.002
// Description: Detects a suspicious process spawning from an Outlook process.
// Converted by: Sigma Universal SIEM/EDR CLI

(where(ParentImage IENDSWITH "\\OUTLOOK.EXE") AND (where(Image IENDSWITH "\\AppVLP.exe") OR where(Image IENDSWITH "\\bash.exe") OR where(Image IENDSWITH "\\cmd.exe") OR where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\forfiles.exe") OR where(Image IENDSWITH "\\hh.exe") OR where(Image IENDSWITH "\\mftrace.exe") OR where(Image IENDSWITH "\\msbuild.exe") OR where(Image IENDSWITH "\\msdt.exe") OR where(Image IENDSWITH "\\mshta.exe") OR where(Image IENDSWITH "\\msiexec.exe") OR where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe") OR where(Image IENDSWITH "\\regsvr32.exe") OR where(Image IENDSWITH "\\schtasks.exe") OR where(Image IENDSWITH "\\scrcons.exe") OR where(Image IENDSWITH "\\scriptrunner.exe") OR where(Image IENDSWITH "\\sh.exe") OR where(Image IENDSWITH "\\svchost.exe") OR where(Image IENDSWITH "\\wmic.exe") OR where(Image IENDSWITH "\\wscript.exe")))
