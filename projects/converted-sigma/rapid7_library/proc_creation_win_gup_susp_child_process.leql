// Title: Suspicious Child Process of Notepad++ Updater - GUP.Exe
// ID: bb0e87ce-c89f-4857-84fa-095e4483e9cb
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-02-03
// Tags: attack.collection, attack.credential-access, attack.t1195.002, attack.initial-access, attack.t1557
// Description: Detects suspicious child process creation by the Notepad++ updater process (gup.exe).
// This could indicate potential exploitation of the updater component to deliver unwanted malware.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(ParentImage IENDSWITH "\\gup.exe")) AND (((where(CommandLine ICONTAINS "bitsadmin") OR where(CommandLine ICONTAINS "certutil") OR where(CommandLine ICONTAINS "curl") OR where(CommandLine ICONTAINS "finger") OR where(CommandLine ICONTAINS "forfiles") OR where(CommandLine ICONTAINS "regsvr32") OR where(CommandLine ICONTAINS "rundll32") OR where(CommandLine ICONTAINS "wget"))) OR ((where(Image IENDSWITH "\\cmd.exe") OR where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe") OR where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\wscript.exe") OR where(Image IENDSWITH "\\mshta.exe")))))
