// Description: Detects Obfuscated Powershell via VAR++ LAUNCHER
// Converted by: Sigma Universal SIEM/EDR CLI

(where(EventID = "4697") AND (where(ServiceFileName ICONTAINS "&&set") AND where(ServiceFileName ICONTAINS "cmd") AND where(ServiceFileName ICONTAINS "/c") AND where(ServiceFileName ICONTAINS "-f")) AND (where(ServiceFileName ICONTAINS "{0}") OR where(ServiceFileName ICONTAINS "{1}") OR where(ServiceFileName ICONTAINS "{2}") OR where(ServiceFileName ICONTAINS "{3}") OR where(ServiceFileName ICONTAINS "{4}") OR where(ServiceFileName ICONTAINS "{5}")))
