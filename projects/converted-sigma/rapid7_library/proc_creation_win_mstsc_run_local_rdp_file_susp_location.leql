// Title: Suspicious Mstsc.EXE Execution With Local RDP File
// ID: 6e22722b-dfb1-4508-a911-49ac840b40f8
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects potential RDP connection via Mstsc using a local ".rdp" file located in suspicious locations.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine IENDSWITH ".rdp") OR where(CommandLine IENDSWITH ".rdp\""))) AND ((where(Image IENDSWITH "\\mstsc.exe")) OR (where(OriginalFileName = "mstsc.exe"))) AND ((where(CommandLine ICONTAINS ":\\Users\\Public\\") OR where(CommandLine ICONTAINS ":\\Windows\\System32\\spool\\drivers\\color") OR where(CommandLine ICONTAINS ":\\Windows\\System32\\Tasks_Migrated ") OR where(CommandLine ICONTAINS ":\\Windows\\Tasks\\") OR where(CommandLine ICONTAINS ":\\Windows\\Temp\\") OR where(CommandLine ICONTAINS ":\\Windows\\Tracing\\") OR where(CommandLine ICONTAINS "\\AppData\\Local\\Temp\\") OR where(CommandLine ICONTAINS "\\Downloads\\"))))
