// Title: Potential Attachment Manager Settings Associations Tamper
// ID: a9b6c011-ab69-4ddb-bc0a-c4f21c80ec47
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-01
// Tags: attack.defense-impairment
// Description: Detects tampering with attachment manager settings policies associations to lower the default file type risks (See reference for more information)
// Converted by: Sigma Universal SIEM/EDR CLI

((where(TargetObject ICONTAINS "\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Associations\\")) AND ((where(TargetObject IENDSWITH "\\DefaultFileTypeRisk") AND where(Details = "DWORD (0x00006152)")) OR (where(TargetObject IENDSWITH "\\LowRiskFileTypes") AND (where(Details ICONTAINS ".zip;") OR where(Details ICONTAINS ".rar;") OR where(Details ICONTAINS ".exe;") OR where(Details ICONTAINS ".bat;") OR where(Details ICONTAINS ".com;") OR where(Details ICONTAINS ".cmd;") OR where(Details ICONTAINS ".reg;") OR where(Details ICONTAINS ".msi;") OR where(Details ICONTAINS ".htm;") OR where(Details ICONTAINS ".html;")))))
