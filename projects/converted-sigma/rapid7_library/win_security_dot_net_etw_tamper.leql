((where(EventID = "4657") AND where(ObjectName ICONTAINS "\\Environment") AND (where(ObjectValueName = "COMPlus_ETWEnabled") OR where(ObjectValueName = "COMPlus_ETWFlags")) AND where(NewValue = "0")) OR (where(EventID = "4657") AND where(ObjectName IENDSWITH "\\SOFTWARE\\Microsoft\\.NETFramework") AND where(ObjectValueName = "ETWEnabled") AND where(NewValue = "0")))
