// Title: Shell Execution GCC  - Linux
// ID: 9b5de532-a757-4d70-946c-1f3e44f48b4d
// Status: test
// Level: high
// Author: Li Ling, Andy Parkidomo, Robert Rakowski, Blake Hartstein (Bloomberg L.P.)
// Date: 2024-09-02
// Tags: attack.discovery, attack.t1083
// Description: Detects the use of the "gcc" utility to execute a shell. Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "/bin/bash,-s") OR where(CommandLine ICONTAINS "/bin/dash,-s") OR where(CommandLine ICONTAINS "/bin/fish,-s") OR where(CommandLine ICONTAINS "/bin/sh,-s") OR where(CommandLine ICONTAINS "/bin/zsh,-s"))) AND ((where(Image IENDSWITH "/c89") OR where(Image IENDSWITH "/c99") OR where(Image IENDSWITH "/gcc")) AND where(CommandLine ICONTAINS "-wrapper")))
