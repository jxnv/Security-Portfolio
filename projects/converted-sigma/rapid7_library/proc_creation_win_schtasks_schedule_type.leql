// Title: Suspicious Schtasks Schedule Types
// ID: 24c8392b-aa3c-46b7-a545-43f71657fe98
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects scheduled task creations or modification on a suspicious schedule type
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(Image IENDSWITH "\\schtasks.exe")) OR (where(OriginalFileName = "schtasks.exe"))) AND ((where(CommandLine ICONTAINS " ONLOGON ") OR where(CommandLine ICONTAINS " ONSTART ") OR where(CommandLine ICONTAINS " ONCE ") OR where(CommandLine ICONTAINS " ONIDLE ")))) AND NOT (((where(CommandLine ICONTAINS "NT AUT") OR where(CommandLine ICONTAINS " SYSTEM") OR where(CommandLine ICONTAINS "HIGHEST")))))
