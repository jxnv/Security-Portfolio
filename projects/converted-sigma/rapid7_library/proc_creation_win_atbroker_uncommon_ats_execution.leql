// Title: Uncommon  Assistive Technology Applications Execution Via AtBroker.EXE
// ID: f24bcaea-0cd1-11eb-adc1-0242ac120002
// Status: test
// Level: medium
// Author: Mateusz Wydra, oscd.community
// Date: 2020-10-12
// Tags: attack.stealth, attack.t1218
// Description: Detects the start of a non built-in assistive technology applications via "Atbroker.EXE".
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "start")) AND ((where(Image IENDSWITH "\\AtBroker.exe")) OR (where(OriginalFileName = "AtBroker.exe")))) AND NOT (((where(CommandLine ICONTAINS "animations") OR where(CommandLine ICONTAINS "audiodescription") OR where(CommandLine ICONTAINS "caretbrowsing") OR where(CommandLine ICONTAINS "caretwidth") OR where(CommandLine ICONTAINS "colorfiltering") OR where(CommandLine ICONTAINS "cursorindicator") OR where(CommandLine ICONTAINS "cursorscheme") OR where(CommandLine ICONTAINS "filterkeys") OR where(CommandLine ICONTAINS "focusborderheight") OR where(CommandLine ICONTAINS "focusborderwidth") OR where(CommandLine ICONTAINS "highcontrast") OR where(CommandLine ICONTAINS "keyboardcues") OR where(CommandLine ICONTAINS "keyboardpref") OR where(CommandLine ICONTAINS "livecaptions") OR where(CommandLine ICONTAINS "magnifierpane") OR where(CommandLine ICONTAINS "messageduration") OR where(CommandLine ICONTAINS "minimumhitradius") OR where(CommandLine ICONTAINS "mousekeys") OR where(CommandLine ICONTAINS "Narrator") OR where(CommandLine ICONTAINS "osk") OR where(CommandLine ICONTAINS "overlappedcontent") OR where(CommandLine ICONTAINS "showsounds") OR where(CommandLine ICONTAINS "soundsentry") OR where(CommandLine ICONTAINS "speechreco") OR where(CommandLine ICONTAINS "stickykeys") OR where(CommandLine ICONTAINS "togglekeys") OR where(CommandLine ICONTAINS "voiceaccess") OR where(CommandLine ICONTAINS "windowarranging") OR where(CommandLine ICONTAINS "windowtracking") OR where(CommandLine ICONTAINS "windowtrackingtimeout") OR where(CommandLine ICONTAINS "windowtrackingzorder")))) AND NOT ((where(CommandLine ICONTAINS "Oracle_JavaAccessBridge"))))
