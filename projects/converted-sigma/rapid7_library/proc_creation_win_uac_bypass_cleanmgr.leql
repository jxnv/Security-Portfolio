// Title: UAC Bypass Using Disk Cleanup
// ID: b697e69c-746f-4a86-9f59-7bfff8eab881
// Status: test
// Level: high
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-08-30
// Tags: attack.privilege-escalation, attack.t1548.002
// Description: Detects the pattern of UAC Bypass using scheduled tasks and variable expansion of cleanmgr.exe (UACMe 34)
// Converted by: Sigma Universal SIEM/EDR CLI

(where(CommandLine IENDSWITH "\"\\system32\\cleanmgr.exe /autoclean /d C:") AND where(ParentCommandLine = "C:\\Windows\\system32\\svchost.exe -k netsvcs -p -s Schedule") AND (where(IntegrityLevel = "High") OR where(IntegrityLevel = "System") OR where(IntegrityLevel = "S-1-16-16384") OR where(IntegrityLevel = "S-1-16-12288")))
