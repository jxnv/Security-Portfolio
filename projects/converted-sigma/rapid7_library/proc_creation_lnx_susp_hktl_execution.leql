(((where(Image ICONTAINS "/cobaltstrike") OR where(Image ICONTAINS "/teamserver"))) OR ((where(Image IENDSWITH "/crackmapexec") OR where(Image IENDSWITH "/havoc") OR where(Image IENDSWITH "/merlin-agent") OR where(Image IENDSWITH "/merlinServer-Linux-x64") OR where(Image IENDSWITH "/msfconsole") OR where(Image IENDSWITH "/msfvenom") OR where(Image IENDSWITH "/ps-empire server") OR where(Image IENDSWITH "/ps-empire") OR where(Image IENDSWITH "/sliver-client") OR where(Image IENDSWITH "/sliver-server") OR where(Image IENDSWITH "/Villain.py"))) OR ((where(Image IENDSWITH "/aircrack-ng") OR where(Image IENDSWITH "/bloodhound-python") OR where(Image IENDSWITH "/bpfdos") OR where(Image IENDSWITH "/ebpfki") OR where(Image IENDSWITH "/evil-winrm") OR where(Image IENDSWITH "/hashcat") OR where(Image IENDSWITH "/hoaxshell.py") OR where(Image IENDSWITH "/hydra") OR where(Image IENDSWITH "/john") OR where(Image IENDSWITH "/ncrack") OR where(Image IENDSWITH "/nxc-ubuntu-latest") OR where(Image IENDSWITH "/pidhide") OR where(Image IENDSWITH "/pspy32") OR where(Image IENDSWITH "/pspy32s") OR where(Image IENDSWITH "/pspy64") OR where(Image IENDSWITH "/pspy64s") OR where(Image IENDSWITH "/setoolkit") OR where(Image IENDSWITH "/sqlmap") OR where(Image IENDSWITH "/writeblocker"))) OR (where(Image ICONTAINS "/linpeas")) OR ((where(Image IENDSWITH "/autorecon") OR where(Image IENDSWITH "/httpx") OR where(Image IENDSWITH "/legion") OR where(Image IENDSWITH "/naabu") OR where(Image IENDSWITH "/netdiscover") OR where(Image IENDSWITH "/nuclei") OR where(Image IENDSWITH "/recon-ng"))) OR (where(Image ICONTAINS "/sniper")) OR ((where(Image IENDSWITH "/dirb") OR where(Image IENDSWITH "/dirbuster") OR where(Image IENDSWITH "/eyewitness") OR where(Image IENDSWITH "/feroxbuster") OR where(Image IENDSWITH "/ffuf") OR where(Image IENDSWITH "/gobuster") OR where(Image IENDSWITH "/wfuzz") OR where(Image IENDSWITH "/whatweb"))) OR ((where(Image IENDSWITH "/joomscan") OR where(Image IENDSWITH "/nikto") OR where(Image IENDSWITH "/wpscan"))))
