// Description: Detects Obfuscated Powershell via COMPRESS OBFUSCATION
// Converted by: Sigma Universal SIEM/EDR CLI

(where(Provider_Name = "Service Control Manager") AND where(EventID = "7045") AND (where(ImagePath ICONTAINS "new-object") AND where(ImagePath ICONTAINS "text.encoding]::ascii") AND where(ImagePath ICONTAINS "readtoend")) AND (where(ImagePath ICONTAINS ":system.io.compression.deflatestream") OR where(ImagePath ICONTAINS "system.io.streamreader")))
