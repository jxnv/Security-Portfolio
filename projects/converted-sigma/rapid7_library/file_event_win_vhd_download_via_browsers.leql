// Title: VHD Image Download Via Browser
// ID: 8468111a-ef07-4654-903b-b863a80bbc95
// Status: test
// Level: medium
// Author: frack113, Christopher Peacock '@securepeacock', SCYTHE '@scythe_io'
// Date: 2021-10-25
// Tags: attack.resource-development, attack.t1587.001
// Description: Detects creation of ".vhd"/".vhdx" files by browser processes.
// Malware can use mountable Virtual Hard Disk ".vhd" files to encapsulate payloads and evade security controls.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image IENDSWITH "\\brave.exe") OR where(Image IENDSWITH "\\chrome.exe") OR where(Image IENDSWITH "\\firefox.exe") OR where(Image IENDSWITH "\\iexplore.exe") OR where(Image IENDSWITH "\\maxthon.exe") OR where(Image IENDSWITH "\\MicrosoftEdge.exe") OR where(Image IENDSWITH "\\msedge.exe") OR where(Image IENDSWITH "\\msedgewebview2.exe") OR where(Image IENDSWITH "\\opera.exe") OR where(Image IENDSWITH "\\safari.exe") OR where(Image IENDSWITH "\\seamonkey.exe") OR where(Image IENDSWITH "\\vivaldi.exe") OR where(Image IENDSWITH "\\whale.exe")) AND where(TargetFilename ICONTAINS ".vhd"))
