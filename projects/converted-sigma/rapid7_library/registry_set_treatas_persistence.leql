// Title: COM Hijacking via TreatAs
// ID: dc5c24af-6995-49b2-86eb-a9ff62199e82
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-08-28
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.015
// Description: Detect modification of TreatAs key to enable "rundll32.exe -sta" command
// Converted by: Sigma Universal SIEM/EDR CLI

((where(TargetObject IENDSWITH "TreatAs\\(Default)")) AND NOT ((((where(Image = "C:\\Windows\\system32\\msiexec.exe") OR where(Image = "C:\\Windows\\SysWOW64\\msiexec.exe"))) OR (where(Image ISTARTSWITH "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\") AND where(Image IENDSWITH "\\OfficeClickToRun.exe")) OR ((where(Image = "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe") OR where(Image = "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe"))) OR (where(Image = "C:\\Windows\\system32\\svchost.exe")))))
