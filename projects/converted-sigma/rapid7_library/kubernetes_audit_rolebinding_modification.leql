// Title: Kubernetes Rolebinding Modification
// ID: 10b97915-ec8d-455f-a815-9a78926585f6
// Status: test
// Level: medium
// Author: kelnage
// Date: 2024-07-11
// Tags: attack.privilege-escalation
// Description: Detects when a Kubernetes Rolebinding is created or modified.
// Converted by: Sigma Universal SIEM/EDR CLI

(where(objectRef.apiGroup = "rbac.authorization.k8s.io") AND (where(objectRef.resource = "clusterrolebindings") OR where(objectRef.resource = "rolebindings")) AND (where(verb = "create") OR where(verb = "delete") OR where(verb = "patch") OR where(verb = "replace") OR where(verb = "update")))
