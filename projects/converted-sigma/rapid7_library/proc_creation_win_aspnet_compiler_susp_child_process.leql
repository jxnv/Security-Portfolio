// Title: Suspicious Child Process of AspNetCompiler
// ID: 9ccba514-7cb6-4c5c-b377-700758f2f120
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-08-14
// Tags: attack.execution, attack.stealth, attack.t1127
// Description: Detects potentially suspicious child processes of "aspnet_compiler.exe".
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(Image IENDSWITH "\\calc.exe") OR where(Image IENDSWITH "\\notepad.exe"))) OR ((where(Image ICONTAINS "\\Users\\Public\\") OR where(Image ICONTAINS "\\AppData\\Local\\Temp\\") OR where(Image ICONTAINS "\\AppData\\Local\\Roaming\\") OR where(Image ICONTAINS ":\\Temp\\") OR where(Image ICONTAINS ":\\Windows\\Temp\\") OR where(Image ICONTAINS ":\\Windows\\System32\\Tasks\\") OR where(Image ICONTAINS ":\\Windows\\Tasks\\")))) AND (where(ParentImage IENDSWITH "\\aspnet_compiler.exe")))
