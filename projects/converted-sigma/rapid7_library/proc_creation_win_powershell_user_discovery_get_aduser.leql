// Title: User Discovery And Export Via Get-ADUser Cmdlet
// ID: 1114e048-b69c-4f41-bc20-657245ae6e3f
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.discovery, attack.t1033
// Description: Detects usage of the Get-ADUser cmdlet to collect user information and output it to a file
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "Get-ADUser ") AND where(CommandLine ICONTAINS " -Filter \\*")) AND (where(CommandLine ICONTAINS " > ") OR where(CommandLine ICONTAINS " | Select ") OR where(CommandLine ICONTAINS "Out-File") OR where(CommandLine ICONTAINS "Set-Content") OR where(CommandLine ICONTAINS "Add-Content"))) AND (((where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe"))) OR ((where(OriginalFileName = "PowerShell.EXE") OR where(OriginalFileName = "pwsh.dll")))))
