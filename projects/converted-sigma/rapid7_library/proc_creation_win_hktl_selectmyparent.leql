// Title: HackTool - PPID Spoofing SelectMyParent Tool Execution
// ID: 52ff7941-8211-46f9-84f8-9903efb7077d
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-07-23
// Tags: attack.privilege-escalation, attack.stealth, attack.t1134.004
// Description: Detects the use of parent process ID spoofing tools like Didier Stevens tool SelectMyParent
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image IENDSWITH "\\SelectMyParent.exe")) OR ((where(CommandLine ICONTAINS "PPID-spoof") OR where(CommandLine ICONTAINS "ppid_spoof") OR where(CommandLine ICONTAINS "spoof-ppid") OR where(CommandLine ICONTAINS "spoof_ppid") OR where(CommandLine ICONTAINS "ppidspoof") OR where(CommandLine ICONTAINS "spoofppid") OR where(CommandLine ICONTAINS "spoofedppid") OR where(CommandLine ICONTAINS " -spawnto "))) OR ((where(OriginalFileName ICONTAINS "PPID-spoof") OR where(OriginalFileName ICONTAINS "ppid_spoof") OR where(OriginalFileName ICONTAINS "spoof-ppid") OR where(OriginalFileName ICONTAINS "spoof_ppid") OR where(OriginalFileName ICONTAINS "ppidspoof") OR where(OriginalFileName ICONTAINS "spoofppid") OR where(OriginalFileName ICONTAINS "spoofedppid"))) OR (where(Description = "SelectMyParent")) OR ((where(Hashes ICONTAINS "IMPHASH=04D974875BD225F00902B4CAD9AF3FBC") OR where(Hashes ICONTAINS "IMPHASH=A782AF154C9E743DDF3F3EB2B8F3D16E") OR where(Hashes ICONTAINS "IMPHASH=89059503D7FBF470E68F7E63313DA3AD") OR where(Hashes ICONTAINS "IMPHASH=CA28337632625C8281AB8A130B3D6BAD"))))
