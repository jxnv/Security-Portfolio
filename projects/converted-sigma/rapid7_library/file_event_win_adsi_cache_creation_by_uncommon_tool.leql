// Title: ADSI-Cache File Creation By Uncommon Tool
// ID: 75bf09fa-1dd7-4d18-9af9-dd9e492562eb
// Status: test
// Level: medium
// Author: xknow @xknow_infosec, Tim Shelton
// Date: 2019-03-24
// Tags: attack.t1001.003, attack.command-and-control
// Description: Detects the creation of an "Active Directory Schema Cache File" (.sch) file by an uncommon tool.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(TargetFilename ICONTAINS "\\Local\\Microsoft\\Windows\\SchCache\\") AND where(TargetFilename IENDSWITH ".sch")) AND NOT (((((where(Image IENDSWITH ":\\Program Files\\Cylance\\Desktop\\CylanceSvc.exe") OR where(Image IENDSWITH ":\\Windows\\CCM\\CcmExec.exe") OR where(Image IENDSWITH ":\\windows\\system32\\dllhost.exe") OR where(Image IENDSWITH ":\\Windows\\system32\\dsac.exe") OR where(Image IENDSWITH ":\\Windows\\system32\\efsui.exe") OR where(Image IENDSWITH ":\\windows\\system32\\mmc.exe") OR where(Image IENDSWITH ":\\windows\\system32\\svchost.exe") OR where(Image IENDSWITH ":\\Windows\\System32\\wbem\\WmiPrvSE.exe") OR where(Image IENDSWITH ":\\windows\\system32\\WindowsPowerShell\\v1.0\\powershell.exe"))) OR ((where(Image ICONTAINS ":\\Windows\\ccmsetup\\autoupgrade\\ccmsetup") OR where(Image ICONTAINS ":\\Program Files\\SentinelOne\\Sentinel Agent")))) OR ((where(Image ICONTAINS ":\\Program Files\\") AND where(Image ICONTAINS "\\Microsoft Office")) AND where(Image IENDSWITH "\\OUTLOOK.EXE")))) AND NOT (((where(Image IENDSWITH ":\\Program Files\\Citrix\\Receiver StoreFront\\Services\\DefaultDomainServices\\Citrix.DeliveryServices.DomainServices.ServiceHost.exe")) OR (where(Image IENDSWITH "\\LANDesk\\LDCLient\\ldapwhoami.exe")))))
