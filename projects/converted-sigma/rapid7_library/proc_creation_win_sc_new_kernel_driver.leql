// Title: New Kernel Driver Via SC.EXE
// ID: 431a1fdb-4799-4f3b-91c3-a683b003fc49
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-14
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects creation of a new service (kernel driver) with the type "kernel"
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image IENDSWITH "\\sc.exe") AND (where(CommandLine ICONTAINS "create") OR where(CommandLine ICONTAINS "config")) AND (where(CommandLine ICONTAINS "binPath") AND where(CommandLine ICONTAINS "type") AND where(CommandLine ICONTAINS "kernel"))) AND NOT ((((where(CommandLine ICONTAINS "create netprotection_network_filter") AND where(CommandLine ICONTAINS "type= kernel start= ") AND where(CommandLine ICONTAINS "binPath= System32\\drivers\\netprotection_network_filter") AND where(CommandLine ICONTAINS "DisplayName= netprotection_network_filter") AND where(CommandLine ICONTAINS "group= PNP_TDI tag= yes"))) OR ((where(CommandLine ICONTAINS "create avelam binpath=C:\\Windows\\system32\\drivers\\avelam.sys") AND where(CommandLine ICONTAINS "type=kernel start=boot error=critical group=Early-Launch"))))))
