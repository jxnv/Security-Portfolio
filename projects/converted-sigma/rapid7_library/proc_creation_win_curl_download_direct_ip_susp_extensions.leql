// Title: Suspicious File Download From IP Via Curl.EXE
// ID: 5cb299fc-5fb1-4d07-b989-0644c68b6043
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-07-27
// Tags: attack.execution
// Description: Detects potentially suspicious file downloads directly from IP addresses using curl.exe
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine IENDSWITH ".bat") OR where(CommandLine IENDSWITH ".bat\"") OR where(CommandLine IENDSWITH ".dat") OR where(CommandLine IENDSWITH ".dat\"") OR where(CommandLine IENDSWITH ".dll") OR where(CommandLine IENDSWITH ".dll\"") OR where(CommandLine IENDSWITH ".exe") OR where(CommandLine IENDSWITH ".exe\"") OR where(CommandLine IENDSWITH ".gif") OR where(CommandLine IENDSWITH ".gif\"") OR where(CommandLine IENDSWITH ".hta") OR where(CommandLine IENDSWITH ".hta\"") OR where(CommandLine IENDSWITH ".jpeg") OR where(CommandLine IENDSWITH ".jpeg\"") OR where(CommandLine IENDSWITH ".log") OR where(CommandLine IENDSWITH ".log\"") OR where(CommandLine IENDSWITH ".msi") OR where(CommandLine IENDSWITH ".msi\"") OR where(CommandLine IENDSWITH ".png") OR where(CommandLine IENDSWITH ".png\"") OR where(CommandLine IENDSWITH ".ps1") OR where(CommandLine IENDSWITH ".ps1\"") OR where(CommandLine IENDSWITH ".psm1") OR where(CommandLine IENDSWITH ".psm1\"") OR where(CommandLine IENDSWITH ".vbe") OR where(CommandLine IENDSWITH ".vbe\"") OR where(CommandLine IENDSWITH ".vbs") OR where(CommandLine IENDSWITH ".vbs\"") OR where(CommandLine IENDSWITH ".bat'") OR where(CommandLine IENDSWITH ".dat'") OR where(CommandLine IENDSWITH ".dll'") OR where(CommandLine IENDSWITH ".exe'") OR where(CommandLine IENDSWITH ".gif'") OR where(CommandLine IENDSWITH ".hta'") OR where(CommandLine IENDSWITH ".jpeg'") OR where(CommandLine IENDSWITH ".log'") OR where(CommandLine IENDSWITH ".msi'") OR where(CommandLine IENDSWITH ".png'") OR where(CommandLine IENDSWITH ".ps1'") OR where(CommandLine IENDSWITH ".psm1'") OR where(CommandLine IENDSWITH ".vbe'") OR where(CommandLine IENDSWITH ".vbs'"))) AND ((where(CommandLine ICONTAINS " -O") OR where(CommandLine ICONTAINS "--remote-name") OR where(CommandLine ICONTAINS "--output"))) AND (where(CommandLine ICONTAINS "http")) AND ((where(Image IENDSWITH "\\curl.exe")) OR (where(OriginalFileName = "curl.exe"))) AND (where(CommandLine /://[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}/)))
