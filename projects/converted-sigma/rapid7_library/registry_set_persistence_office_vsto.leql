// Tags: attack.t1137.006, attack.persistence
// Description: Detects persistence via Visual Studio Tools for Office (VSTO) add-ins in Office applications.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(TargetObject ICONTAINS "\\Software\\Microsoft\\Office\\Outlook\\Addins\\") OR where(TargetObject ICONTAINS "\\Software\\Microsoft\\Office\\Word\\Addins\\") OR where(TargetObject ICONTAINS "\\Software\\Microsoft\\Office\\Excel\\Addins\\") OR where(TargetObject ICONTAINS "\\Software\\Microsoft\\Office\\Powerpoint\\Addins\\") OR where(TargetObject ICONTAINS "\\Software\\Microsoft\\VSTO\\Security\\Inclusion\\"))) AND NOT ((((where(Image = "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe") OR where(Image = "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe"))) OR ((where(Image ISTARTSWITH "C:\\Program Files\\Microsoft Office\\OFFICE") OR where(Image ISTARTSWITH "C:\\Program Files (x86)\\Microsoft Office\\OFFICE") OR where(Image ISTARTSWITH "C:\\Program Files\\Microsoft Office\\Root\\OFFICE") OR where(Image ISTARTSWITH "C:\\Program Files (x86)\\Microsoft Office\\Root\\OFFICE") OR where(Image ISTARTSWITH "C:\\PROGRA~2\\MICROS~2\\Office")) AND (where(Image IENDSWITH "\\excel.exe") OR where(Image IENDSWITH "\\Integrator.exe") OR where(Image IENDSWITH "\\OneNote.exe") OR where(Image IENDSWITH "\\outlook.exe") OR where(Image IENDSWITH "\\powerpnt.exe") OR where(Image IENDSWITH "\\Teams.exe") OR where(Image IENDSWITH "\\visio.exe") OR where(Image IENDSWITH "\\winword.exe"))) OR ((where(Image ISTARTSWITH "C:\\Program Files\\Common Files (x86)\\Microsoft Shared\\ClickToRun\\") OR where(Image ISTARTSWITH "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\")) AND where(Image IENDSWITH "\\OfficeClickToRun.exe")) OR ((where(Image = "C:\\Windows\\System32\\msiexec.exe") OR where(Image = "C:\\Windows\\SysWOW64\\msiexec.exe") OR where(Image = "C:\\Windows\\System32\\regsvr32.exe") OR where(Image = "C:\\Windows\\SysWOW64\\regsvr32.exe"))) OR ((where(Image ISTARTSWITH "C:\\Program Files\\Common Files\\Microsoft Shared\\VSTO\\") OR where(Image ISTARTSWITH "C:\\Program Files (x86)\\Microsoft Shared\\VSTO\\")) AND where(Image IENDSWITH "\\VSTOInstaller.exe")))) AND NOT ((((where(Image = "C:\\Program Files\\Avast Software\\Avast\\RegSvr.exe") OR where(Image = "C:\\Program Files (x86)\\Avast Software\\Avast\\RegSvr.exe")) AND where(TargetObject ICONTAINS "\\Microsoft\\Office\\Outlook\\Addins\\Avast.AsOutExt\\")) OR ((where(Image = "C:\\Program Files\\AVG\\Antivirus\\RegSvr.exe") OR where(Image = "C:\\Program Files (x86)\\AVG\\Antivirus\\RegSvr.exe")) AND where(TargetObject ICONTAINS "\\Microsoft\\Office\\Outlook\\Addins\\Antivirus.AsOutExt\\")))))
