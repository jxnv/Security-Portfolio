// Title: Suspicious Non-Browser Network Communication With Telegram API
// ID: c3dbbc9f-ef1d-470a-a90a-d343448d5875
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-19
// Tags: attack.command-and-control, attack.exfiltration, attack.t1102, attack.t1567, attack.t1105
// Description: Detects an a non-browser process interacting with the Telegram API which could indicate use of a covert C2
// Converted by: Sigma Universal SIEM/EDR CLI

((where(DestinationHostname ICONTAINS "api.telegram.org")) AND NOT (((where(Image IENDSWITH "\\brave.exe")) OR ((where(Image = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe") OR where(Image = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe"))) OR ((where(Image ISTARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\")) OR (where(Image IENDSWITH "\\WindowsApps\\MicrosoftEdge.exe")) OR ((where(Image = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe") OR where(Image = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe")))) OR ((where(Image ISTARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\") OR where(Image ISTARTSWITH "C:\\Program Files\\Microsoft\\EdgeCore\\")) AND (where(Image IENDSWITH "\\msedge.exe") OR where(Image IENDSWITH "\\msedgewebview2.exe"))) OR ((where(Image = "C:\\Program Files\\Mozilla Firefox\\firefox.exe") OR where(Image = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe"))) OR ((where(Image = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe") OR where(Image = "C:\\Program Files\\Internet Explorer\\iexplore.exe"))) OR (where(Image IENDSWITH "\\maxthon.exe")) OR (where(Image IENDSWITH "\\opera.exe")) OR (where(Image IENDSWITH "\\safari.exe")) OR (where(Image IENDSWITH "\\seamonkey.exe")) OR (where(Image IENDSWITH "\\vivaldi.exe")) OR (where(Image IENDSWITH "\\whale.exe")))))
