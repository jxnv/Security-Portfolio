// Title: Potentially Suspicious AccessMask Requested From LSASS
// ID: 4a1b6da0-d94f-4fc3-98fc-2d9cb9e5ee76
// Status: test
// Level: medium
// Author: Roberto Rodriguez, Teymur Kheirkhabarov, Dimitrios Slamaris, Mark Russinovich, Aleksey Potapov, oscd.community (update)
// Date: 2019-11-01
// Tags: attack.credential-access, car.2019-04-004, attack.t1003.001
// Description: Detects process handle on LSASS process with certain access mask
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(EventID = "4656") AND where(ObjectName IENDSWITH "\\lsass.exe") AND (where(AccessMask ICONTAINS "0x40") OR where(AccessMask ICONTAINS "0x1400") OR where(AccessMask ICONTAINS "0x100000") OR where(AccessMask ICONTAINS "0x1410") OR where(AccessMask ICONTAINS "0x1010") OR where(AccessMask ICONTAINS "0x1438") OR where(AccessMask ICONTAINS "0x143a") OR where(AccessMask ICONTAINS "0x1418") OR where(AccessMask ICONTAINS "0x1f0fff") OR where(AccessMask ICONTAINS "0x1f1fff") OR where(AccessMask ICONTAINS "0x1f2fff") OR where(AccessMask ICONTAINS "0x1f3fff"))) OR (where(EventID = "4663") AND where(ObjectName IENDSWITH "\\lsass.exe") AND (where(AccessList ICONTAINS "4484") OR where(AccessList ICONTAINS "4416")))) AND NOT (((where(ProcessName ICONTAINS ":\\Windows\\Temp\\asgard2-agent-sc\\aurora\\") AND where(ProcessName IENDSWITH "\\aurora-agent-64.exe") AND where(AccessList ICONTAINS "%%4484")) OR ((where(ProcessName ICONTAINS ":\\Users\\") AND where(ProcessName ICONTAINS "\\AppData\\Local\\Temp\\is-")) AND where(ProcessName IENDSWITH "\\avira_system_speedup.tmp") AND where(AccessList ICONTAINS "%%4484")) OR (where(ProcessName ICONTAINS ":\\Windows\\Temp\\") AND where(ProcessName IENDSWITH "\\avira_speedup_setup_update.tmp") AND where(AccessList ICONTAINS "%%4484")) OR ((where(ProcessName IENDSWITH ":\\Windows\\System32\\taskhostw.exe") OR where(ProcessName IENDSWITH ":\\Windows\\System32\\msiexec.exe") OR where(ProcessName IENDSWITH ":\\Windows\\CCM\\CcmExec.exe"))) OR (where(ProcessName ICONTAINS ":\\Program Files")) OR (where(ProcessName ICONTAINS ":\\Windows\\SystemTemp\\") AND where(ProcessName IENDSWITH "\\GoogleUpdate.exe") AND where(AccessList ICONTAINS "%%4484")) OR (where(ProcessName IENDSWITH "\\x64\\SCENARIOENGINE.EXE") AND where(AccessList ICONTAINS "%%4484")) OR (where(ProcessName IENDSWITH ":\\Windows\\System32\\snmp.exe") AND where(AccessList ICONTAINS "%%4484")) OR ((where(ProcessName IENDSWITH "\\csrss.exe") OR where(ProcessName IENDSWITH "\\GamingServices.exe") OR where(ProcessName IENDSWITH "\\lsm.exe") OR where(ProcessName IENDSWITH "\\MicrosoftEdgeUpdate.exe") OR where(ProcessName IENDSWITH "\\minionhost.exe") OR where(ProcessName IENDSWITH "\\MRT.exe") OR where(ProcessName IENDSWITH "\\MsMpEng.exe") OR where(ProcessName IENDSWITH "\\perfmon.exe") OR where(ProcessName IENDSWITH "\\procexp.exe") OR where(ProcessName IENDSWITH "\\procexp64.exe") OR where(ProcessName IENDSWITH "\\procexp64a.exe") OR where(ProcessName IENDSWITH "\\svchost.exe") OR where(ProcessName IENDSWITH "\\taskmgr.exe") OR where(ProcessName IENDSWITH "\\thor.exe") OR where(ProcessName IENDSWITH "\\thor64.exe") OR where(ProcessName IENDSWITH "\\vmtoolsd.exe") OR where(ProcessName IENDSWITH "\\VsTskMgr.exe") OR where(ProcessName IENDSWITH "\\wininit.exe") OR where(ProcessName IENDSWITH "\\wmiprvse.exe") OR where(ProcessName IENDSWITH "RtkAudUService64")) AND (where(ProcessName ICONTAINS ":\\Program Files (x86)\\") OR where(ProcessName ICONTAINS ":\\Program Files\\") OR where(ProcessName ICONTAINS ":\\ProgramData\\Microsoft\\Windows Defender\\Platform\\") OR where(ProcessName ICONTAINS ":\\Windows\\SysNative\\") OR where(ProcessName ICONTAINS ":\\Windows\\System32\\") OR where(ProcessName ICONTAINS ":\\Windows\\SysWow64\\") OR where(ProcessName ICONTAINS ":\\Windows\\Temp\\asgard2-agent\\"))) OR ((where(ProcessName IENDSWITH ":\\Windows\\Sysmon64.exe") OR where(ProcessName IENDSWITH ":\\Windows\\Sysmon64a.exe")) AND where(AccessList ICONTAINS "%%4484")))) AND NOT (((where(ProcessName IENDSWITH "\\procmon64.exe") OR where(ProcessName IENDSWITH "\\procmon64a.exe") OR where(ProcessName IENDSWITH "\\procmon.exe")) AND where(AccessList ICONTAINS "%%4484"))))
