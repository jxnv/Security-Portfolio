// Description: Detects wmiexec/dcomexec/atexec/smbexec from Impacket framework
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(ParentCommandLine ICONTAINS "svchost.exe -k netsvcs") OR where(ParentCommandLine ICONTAINS "taskeng.exe")) AND (where(CommandLine ICONTAINS "cmd.exe") AND where(CommandLine ICONTAINS "/C") AND where(CommandLine ICONTAINS "Windows\\Temp\\") AND where(CommandLine ICONTAINS "&1"))) OR ((where(ParentImage IENDSWITH "\\wmiprvse.exe") OR where(ParentImage IENDSWITH "\\mmc.exe") OR where(ParentImage IENDSWITH "\\explorer.exe") OR where(ParentImage IENDSWITH "\\services.exe")) AND (where(CommandLine ICONTAINS "cmd.exe") AND where(CommandLine ICONTAINS "/Q") AND where(CommandLine ICONTAINS "/c") AND where(CommandLine ICONTAINS "\\\\\\\\127.0.0.1\\\\") AND where(CommandLine ICONTAINS "&1"))))
