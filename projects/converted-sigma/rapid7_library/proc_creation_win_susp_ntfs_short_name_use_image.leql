// Title: Use NTFS Short Name in Image
// ID: 3ef5605c-9eb9-47b0-9a71-b727e6aa5c3b
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-06
// Tags: attack.stealth, attack.t1564.004
// Description: Detect use of the Windows 8.3 short name. Which could be used as a method to avoid Image based detection
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image ICONTAINS "~1.bat") OR where(Image ICONTAINS "~1.dll") OR where(Image ICONTAINS "~1.exe") OR where(Image ICONTAINS "~1.hta") OR where(Image ICONTAINS "~1.js") OR where(Image ICONTAINS "~1.msi") OR where(Image ICONTAINS "~1.ps1") OR where(Image ICONTAINS "~1.tmp") OR where(Image ICONTAINS "~1.vbe") OR where(Image ICONTAINS "~1.vbs") OR where(Image ICONTAINS "~2.bat") OR where(Image ICONTAINS "~2.dll") OR where(Image ICONTAINS "~2.exe") OR where(Image ICONTAINS "~2.hta") OR where(Image ICONTAINS "~2.js") OR where(Image ICONTAINS "~2.msi") OR where(Image ICONTAINS "~2.ps1") OR where(Image ICONTAINS "~2.tmp") OR where(Image ICONTAINS "~2.vbe") OR where(Image ICONTAINS "~2.vbs"))) AND NOT ((where(ParentImage = "C:\\Windows\\explorer.exe"))) AND NOT (((where(ParentImage IENDSWITH "\\thor\\thor64.exe")) OR (where(Image IENDSWITH "\\VCREDI~1.EXE")) OR (where(ParentImage IENDSWITH "\\WebEx\\WebexHost.exe")) OR (where(Image = "C:\\PROGRA~1\\WinZip\\WZPREL~1.EXE")))))
