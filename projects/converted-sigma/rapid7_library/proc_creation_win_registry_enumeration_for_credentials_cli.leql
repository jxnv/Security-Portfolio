// Title: Enumeration for 3rd Party Creds From CLI
// ID: 87a476dc-0079-4583-a985-dee7a20a03de
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-20
// Tags: attack.credential-access, attack.t1552.002
// Description: Detects processes that query known 3rd party registry keys that holds credentials via commandline
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "\\Software\\Aerofox\\Foxmail\\V3.1") OR where(CommandLine ICONTAINS "\\Software\\Aerofox\\FoxmailPreview") OR where(CommandLine ICONTAINS "\\Software\\DownloadManager\\Passwords") OR where(CommandLine ICONTAINS "\\Software\\FTPWare\\COREFTP\\Sites") OR where(CommandLine ICONTAINS "\\Software\\IncrediMail\\Identities") OR where(CommandLine ICONTAINS "\\Software\\Martin Prikryl\\WinSCP 2\\Sessions") OR where(CommandLine ICONTAINS "\\Software\\Mobatek\\MobaXterm\\") OR where(CommandLine ICONTAINS "\\Software\\OpenSSH\\Agent\\Keys") OR where(CommandLine ICONTAINS "\\Software\\OpenVPN-GUI\\configs") OR where(CommandLine ICONTAINS "\\Software\\ORL\\WinVNC3\\Password") OR where(CommandLine ICONTAINS "\\Software\\Qualcomm\\Eudora\\CommandLine") OR where(CommandLine ICONTAINS "\\Software\\RealVNC\\WinVNC4") OR where(CommandLine ICONTAINS "\\Software\\RimArts\\B2\\Settings") OR where(CommandLine ICONTAINS "\\Software\\SimonTatham\\PuTTY\\Sessions") OR where(CommandLine ICONTAINS "\\Software\\SimonTatham\\PuTTY\\SshHostKeys\\") OR where(CommandLine ICONTAINS "\\Software\\Sota\\FFFTP") OR where(CommandLine ICONTAINS "\\Software\\TightVNC\\Server") OR where(CommandLine ICONTAINS "\\Software\\WOW6432Node\\Radmin\\v3.0\\Server\\Parameters\\Radmin"))) AND NOT ((where(Image IENDSWITH "reg.exe") AND (where(CommandLine ICONTAINS "export") OR where(CommandLine ICONTAINS "save")))))
