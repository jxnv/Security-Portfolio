// Title: Potential Encoded PowerShell Patterns In CommandLine
// ID: cdf05894-89e7-4ead-b2b0-0a5f97a90f2f
// Status: test
// Level: low
// Author: Teymur Kheirkhabarov (idea), Vasiliy Burov (rule), oscd.community, Tim Shelton
// Date: 2020-10-11
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects specific combinations of encoding methods in PowerShell via the commandline
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe"))) OR ((where(OriginalFileName = "PowerShell.EXE") OR where(OriginalFileName = "pwsh.dll")))) AND ((((where(CommandLine ICONTAINS "ToInt") OR where(CommandLine ICONTAINS "ToDecimal") OR where(CommandLine ICONTAINS "ToByte") OR where(CommandLine ICONTAINS "ToUint") OR where(CommandLine ICONTAINS "ToSingle") OR where(CommandLine ICONTAINS "ToSByte"))) AND ((where(CommandLine ICONTAINS "ToChar") OR where(CommandLine ICONTAINS "ToString") OR where(CommandLine ICONTAINS "String")))) OR (((where(CommandLine ICONTAINS "char") AND where(CommandLine ICONTAINS "join"))) OR ((where(CommandLine ICONTAINS "split") AND where(CommandLine ICONTAINS "join"))))))
