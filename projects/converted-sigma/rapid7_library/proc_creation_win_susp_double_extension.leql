// Title: Suspicious Double Extension File Execution
// ID: 1cdd9a09-06c9-4769-99ff-626e2b3991b8
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems), @blu3_team (idea), Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-06-26
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects suspicious use of an .exe extension after a non-executable file extension like .pdf.exe, a set of spaces or underlines to cloak the executable file in spear phishing campaigns
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image IENDSWITH "      .exe") OR where(Image IENDSWITH "______.exe") OR where(Image IENDSWITH ".doc.exe") OR where(Image IENDSWITH ".doc.js") OR where(Image IENDSWITH ".docx.exe") OR where(Image IENDSWITH ".docx.js") OR where(Image IENDSWITH ".gif.exe") OR where(Image IENDSWITH ".jpeg.exe") OR where(Image IENDSWITH ".jpg.exe") OR where(Image IENDSWITH ".mkv.exe") OR where(Image IENDSWITH ".mov.exe") OR where(Image IENDSWITH ".mp3.exe") OR where(Image IENDSWITH ".mp4.exe") OR where(Image IENDSWITH ".pdf.exe") OR where(Image IENDSWITH ".pdf.js") OR where(Image IENDSWITH ".png.exe") OR where(Image IENDSWITH ".ppt.exe") OR where(Image IENDSWITH ".ppt.js") OR where(Image IENDSWITH ".pptx.exe") OR where(Image IENDSWITH ".pptx.js") OR where(Image IENDSWITH ".rtf.exe") OR where(Image IENDSWITH ".rtf.js") OR where(Image IENDSWITH ".svg.exe") OR where(Image IENDSWITH ".txt.exe") OR where(Image IENDSWITH ".txt.js") OR where(Image IENDSWITH ".xls.exe") OR where(Image IENDSWITH ".xls.js") OR where(Image IENDSWITH ".xlsx.exe") OR where(Image IENDSWITH ".xlsx.js") OR where(Image IENDSWITH "⠀⠀⠀⠀⠀⠀.exe")) AND (where(CommandLine ICONTAINS "      .exe") OR where(CommandLine ICONTAINS "______.exe") OR where(CommandLine ICONTAINS ".doc.exe") OR where(CommandLine ICONTAINS ".doc.js") OR where(CommandLine ICONTAINS ".docx.exe") OR where(CommandLine ICONTAINS ".docx.js") OR where(CommandLine ICONTAINS ".gif.exe") OR where(CommandLine ICONTAINS ".jpeg.exe") OR where(CommandLine ICONTAINS ".jpg.exe") OR where(CommandLine ICONTAINS ".mkv.exe") OR where(CommandLine ICONTAINS ".mov.exe") OR where(CommandLine ICONTAINS ".mp3.exe") OR where(CommandLine ICONTAINS ".mp4.exe") OR where(CommandLine ICONTAINS ".pdf.exe") OR where(CommandLine ICONTAINS ".pdf.js") OR where(CommandLine ICONTAINS ".png.exe") OR where(CommandLine ICONTAINS ".ppt.exe") OR where(CommandLine ICONTAINS ".ppt.js") OR where(CommandLine ICONTAINS ".pptx.exe") OR where(CommandLine ICONTAINS ".pptx.js") OR where(CommandLine ICONTAINS ".rtf.exe") OR where(CommandLine ICONTAINS ".rtf.js") OR where(CommandLine ICONTAINS ".svg.exe") OR where(CommandLine ICONTAINS ".txt.exe") OR where(CommandLine ICONTAINS ".txt.js") OR where(CommandLine ICONTAINS ".xls.exe") OR where(CommandLine ICONTAINS ".xls.js") OR where(CommandLine ICONTAINS ".xlsx.exe") OR where(CommandLine ICONTAINS ".xlsx.js") OR where(CommandLine ICONTAINS "⠀⠀⠀⠀⠀⠀.exe")))
