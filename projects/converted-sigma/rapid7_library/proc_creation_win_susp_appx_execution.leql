// Title: Potentially Suspicious Windows App Activity
// ID: f91ed517-a6ba-471d-9910-b3b4a398c0f3
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-12
// Tags: attack.stealth
// Description: Detects potentially suspicious child process of applications launched from inside the WindowsApps directory. This could be a sign of a rogue ".appx" package installation/execution
// Converted by: Sigma Universal SIEM/EDR CLI

((where(ParentImage ICONTAINS "C:\\Program Files\\WindowsApps\\")) AND (((where(CommandLine ICONTAINS "cmd /c") OR where(CommandLine ICONTAINS "Invoke-") OR where(CommandLine ICONTAINS "Base64"))) OR ((where(Image IENDSWITH "\\cmd.exe") OR where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\mshta.exe") OR where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\powershell_ise.exe") OR where(Image IENDSWITH "\\pwsh.exe") OR where(Image IENDSWITH "\\regsvr32.exe") OR where(Image IENDSWITH "\\rundll32.exe") OR where(Image IENDSWITH "\\wscript.exe")))) AND NOT (((where(ParentImage ISTARTSWITH "C:\\Program Files\\WindowsApps\\Microsoft.SysinternalsSuite") AND where(Image IENDSWITH "\\cmd.exe")) OR (where(ParentImage ICONTAINS ":\\Program Files\\WindowsApps\\Microsoft.WindowsTerminal") AND where(ParentImage IENDSWITH "\\WindowsTerminal.exe") AND (where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\cmd.exe") OR where(Image IENDSWITH "\\pwsh.exe"))))))
