// Title: PowerShell Core DLL Loaded By Non PowerShell Process
// ID: 092bc4b9-3d1d-43b4-a6b4-8c8acd83522f
// Status: test
// Level: medium
// Author: Tom Kern, oscd.community, Natalia Shornikova, Tim Shelton, Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2019-11-14
// Tags: attack.t1059.001, attack.execution
// Description: Detects loading of essential DLLs used by PowerShell by non-PowerShell process.
// Detects behavior similar to meterpreter's "load powershell" extension.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Description = "System.Management.Automation")) OR (where(OriginalFileName = "System.Management.Automation.dll")) OR ((where(ImageLoaded IENDSWITH "\\System.Management.Automation.dll") OR where(ImageLoaded IENDSWITH "\\System.Management.Automation.ni.dll")))) AND NOT ((((where(Image ISTARTSWITH "C:\\Windows\\Microsoft.NET\\Framework\\") OR where(Image ISTARTSWITH "C:\\Windows\\Microsoft.NET\\FrameworkArm\\") OR where(Image ISTARTSWITH "C:\\Windows\\Microsoft.NET\\FrameworkArm64\\") OR where(Image ISTARTSWITH "C:\\Windows\\Microsoft.NET\\Framework64\\")) AND where(Image IENDSWITH "\\mscorsvw.exe")) OR ((where(Image = "C:\\Windows\\System32\\dsac.exe") OR where(Image = "C:\\WINDOWS\\System32\\RemoteFXvGPUDisablement.exe") OR where(Image = "C:\\Windows\\System32\\runscripthelper.exe") OR where(Image = "C:\\WINDOWS\\System32\\sdiagnhost.exe") OR where(Image = "C:\\Windows\\System32\\ServerManager.exe") OR where(Image = "C:\\Windows\\System32\\SyncAppvPublishingServer.exe") OR where(Image = "C:\\Windows\\System32\\winrshost.exe") OR where(Image = "C:\\Windows\\System32\\wsmprovhost.exe") OR where(Image = "C:\\Windows\\SysWOW64\\winrshost.exe") OR where(Image = "C:\\Windows\\SysWOW64\\wsmprovhost.exe"))) OR ((where(Image = "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe") OR where(Image = "C:\\Program Files\\PowerShell\\7\\pwsh.exe") OR where(Image = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe") OR where(Image = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe") OR where(Image = "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe") OR where(Image = "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe"))) OR ((where(Image ICONTAINS "C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview") OR where(Image ICONTAINS "\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview")) AND where(Image IENDSWITH "\\pwsh.exe")))) AND NOT (((NOT Image=*) OR (where(Image ISTARTSWITH "C:\\ProgramData\\chocolatey\\choco.exe")) OR (where(Image IENDSWITH "\\Citrix\\ConfigSync\\ConfigSyncRun.exe")) OR (where(Image ISTARTSWITH "C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_") AND where(Image IENDSWITH "\\GetHelp.exe")) OR (where(Image ISTARTSWITH "C:\\Windows\\Temp\\asgard2-agent\\") AND (where(Image IENDSWITH "\\thor64.exe") OR where(Image IENDSWITH "\\thor.exe"))) OR ((where(Image ISTARTSWITH "C:\\Program Files (x86)\\Microsoft SQL Server Management Studio") OR where(Image ISTARTSWITH "C:\\Program Files\\Microsoft SQL Server Management Studio")) AND where(Image IENDSWITH "\\IDE\\Ssms.exe")) OR ((where(Image ISTARTSWITH "C:\\Program Files (x86)\\Microsoft SQL Server\\") OR where(Image ISTARTSWITH "C:\\Program Files\\Microsoft SQL Server\\")) AND where(Image IENDSWITH "\\Tools\\Binn\\SQLPS.exe")) OR ((where(Image ISTARTSWITH "C:\\Program Files (x86)\\Microsoft Visual Studio\\") OR where(Image ISTARTSWITH "C:\\Program Files\\Microsoft Visual Studio\\"))))))
