// Title: CodeIntegrity - Unmet Signing Level Requirements By File Under Validation
// ID: f8931561-97f5-4c46-907f-0a4a592e47a7
// Status: experimental
// Level: low
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-20
// Tags: attack.execution
// Description: Detects attempted file load events that did not meet the signing level requirements. It often means the file's signature is revoked or a signature with the Lifetime Signing EKU has expired.
// This event is best correlated with EID 3089 to determine the error of the validation.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(EventID = "3033") OR where(EventID = "3034"))) AND NOT ((where(FileNameBuffer ICONTAINS "\\Windows\\assembly\\GAC\\") AND where(ProcessNameBuffer IENDSWITH "\\mscorsvw.exe") AND where(ProcessNameBuffer ICONTAINS "\\Windows\\Microsoft.NET\\") AND where(RequestedPolicy = "8"))) AND NOT (((where(FileNameBuffer ICONTAINS "\\Windows\\System32\\DriverStore\\FileRepository\\") AND where(FileNameBuffer IENDSWITH "\\igd10iumd64.dll") AND where(RequestedPolicy = "7")) OR ((where(FileNameBuffer IENDSWITH "\\Program Files\\Avast Software\\Avast\\aswAMSI.dll") OR where(FileNameBuffer IENDSWITH "\\Program Files (x86)\\Avast Software\\Avast\\aswAMSI.dll")) AND (where(RequestedPolicy = "8") OR where(RequestedPolicy = "12"))) OR (where(FileNameBuffer IENDSWITH "\\Program Files\\Bonjour\\mdnsNSP.dll") AND (where(ProcessNameBuffer IENDSWITH "\\Windows\\System32\\svchost.exe") OR where(ProcessNameBuffer IENDSWITH "\\Windows\\System32\\SIHClient.exe")) AND (where(RequestedPolicy = "8") OR where(RequestedPolicy = "12"))) OR (where(FileNameBuffer IENDSWITH "\\Program Files\\comodo\\comodo internet security\\amsiprovider_x64.dll")) OR (where(FileNameBuffer IENDSWITH "\\Program Files\\DTrace\\dtrace.dll") AND where(ProcessNameBuffer IENDSWITH "\\Windows\\System32\\svchost.exe") AND where(RequestedPolicy = "12")) OR (where(FileNameBuffer IENDSWITH "\\Windows\\System32\\nvspcap64.dll") AND (where(ProcessNameBuffer IENDSWITH "\\AppData\\Local\\Keybase\\Gui\\Keybase.exe") OR where(ProcessNameBuffer IENDSWITH "\\Microsoft\\Teams\\stage\\Teams.exe")) AND where(RequestedPolicy = "8")) OR (where(FileNameBuffer IENDSWITH "\\Program Files\\ESET\\ESET Security\\eamsi.dll")) OR ((where(FileNameBuffer IENDSWITH "\\Mozilla Firefox\\mozavcodec.dll") OR where(FileNameBuffer IENDSWITH "\\Mozilla Firefox\\mozavutil.dll")) AND where(ProcessNameBuffer IENDSWITH "\\Mozilla Firefox\\firefox.exe") AND where(RequestedPolicy = "8")) OR (where(FileNameBuffer ICONTAINS "\\Program Files\\Google\\Drive File Stream\\") AND where(FileNameBuffer IENDSWITH "\\crashpad_handler.exe") AND where(ProcessNameBuffer IENDSWITH "\\Windows\\ImmersiveControlPanel\\SystemSettings.exe") AND where(RequestedPolicy = "8")) OR (((where(ProcessNameBuffer ICONTAINS "\\Kaspersky Lab\\") AND where(ProcessNameBuffer ICONTAINS "\\avp.exe"))) OR ((where(FileNameBuffer ICONTAINS "\\Kaspersky Lab\\") AND where(FileNameBuffer ICONTAINS "\\antimalware_provider.dll")))) OR ((where(FileNameBuffer IENDSWITH "\\Program Files\\McAfee\\Endpoint Security\\Threat Prevention\\MfeAmsiProvider.dll") OR where(FileNameBuffer IENDSWITH "\\Program Files\\McAfee\\MfeAV\\AMSIExt.dll"))) OR (where(FileNameBuffer IENDSWITH "\\Program Files\\National Instruments\\Shared\\mDNS Responder\\nimdnsNSP.dll ")) OR (where(FileNameBuffer ICONTAINS "\\Microsoft Office\\root\\vfs\\ProgramFilesCommonX64\\Microsoft Shared\\OFFICE") AND where(FileNameBuffer IENDSWITH "\\MSOXMLMF.DLL") AND where(RequestedPolicy = "7")) OR (where(ProcessNameBuffer ICONTAINS "\\Program Files\\Microsoft Office\\root\\vfs\\ProgramFilesCommonX64\\Microsoft Shared\\Office") AND where(FileNameBuffer ICONTAINS "\\Windows\\System32\\") AND where(RequestedPolicy = "8")) OR (where(FileNameBuffer ICONTAINS "\\National Instruments\\Shared\\mDNS Responder\\")) OR ((where(FileNameBuffer ICONTAINS "\\Program Files\\SentinelOne\\Sentinel Agent")) OR (where(ProcessNameBuffer ICONTAINS "\\Program Files\\SentinelOne\\Sentinel Agent"))) OR (where(FileNameBuffer IENDSWITH "\\Windows\\System32\\nvspcap64.dll") AND where(ProcessNameBuffer ICONTAINS "\\AppData\\Local\\slack\\app-") AND where(ProcessNameBuffer IENDSWITH "\\slack.exe") AND where(RequestedPolicy = "8")) OR (where(FileNameBuffer IENDSWITH "\\Trend Micro\\Client Server Security Agent\\perficrcperfmonmgr.dll") AND where(RequestedPolicy = "8")))))
