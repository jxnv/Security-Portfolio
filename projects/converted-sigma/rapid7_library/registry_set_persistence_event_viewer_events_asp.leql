// Title: Potential Persistence Via Event Viewer Events.asp
// ID: a1e11042-a74a-46e6-b07c-c4ce8ecc239b
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-17
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects potential registry persistence technique using the Event Viewer "Events.asp" technique
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(TargetObject ICONTAINS "\\Microsoft\\Windows NT\\CurrentVersion\\Event Viewer\\MicrosoftRedirectionProgram") OR where(TargetObject ICONTAINS "\\Microsoft\\Windows NT\\CurrentVersion\\Event Viewer\\MicrosoftRedirectionURL"))) AND NOT (((where(Details = "(Empty)")) OR (where(Image IENDSWITH "C:\\WINDOWS\\system32\\svchost.exe") AND where(TargetObject IENDSWITH "\\Microsoft\\Windows NT\\CurrentVersion\\Event Viewer\\MicrosoftRedirectionProgram") AND where(Details = "%%SystemRoot%%\\PCHealth\\HelpCtr\\Binaries\\HelpCtr.exe")) OR (where(Image IENDSWITH "C:\\WINDOWS\\system32\\svchost.exe") AND where(TargetObject IENDSWITH "\\Microsoft\\Windows NT\\CurrentVersion\\Event Viewer\\MicrosoftRedirectionProgramCommandLineParameters") AND where(Details = "-url hcp://services/centers/support?topic=%%s")) OR (where(Details = "http://go.microsoft.com/fwlink/events.asp")))))
