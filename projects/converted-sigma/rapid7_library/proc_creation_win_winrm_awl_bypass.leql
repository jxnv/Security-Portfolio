// Title: AWL Bypass with Winrm.vbs and Malicious WsmPty.xsl/WsmTxt.xsl
// ID: 074e0ded-6ced-4ebd-8b4d-53f55908119d
// Status: test
// Level: medium
// Author: Julia Fomina, oscd.community
// Date: 2020-10-06
// Tags: attack.stealth, attack.t1216
// Description: Detects execution of attacker-controlled WsmPty.xsl or WsmTxt.xsl via winrm.vbs and copied cscript.exe (can be renamed)
// Converted by: Sigma Universal SIEM/EDR CLI

((where(CommandLine ICONTAINS "winrm")) AND (((where(CommandLine ICONTAINS "format:pretty") OR where(CommandLine ICONTAINS "format:\"pretty\"") OR where(CommandLine ICONTAINS "format:\"text\"") OR where(CommandLine ICONTAINS "format:text"))) AND NOT (((where(Image ISTARTSWITH "C:\\Windows\\System32\\") OR where(Image ISTARTSWITH "C:\\Windows\\SysWOW64\\"))))))
