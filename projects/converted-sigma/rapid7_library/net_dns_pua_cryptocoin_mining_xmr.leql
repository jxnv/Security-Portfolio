// Title: Monero Crypto Coin Mining Pool Lookup
// ID: b593fd50-7335-4682-a36c-4edcb68e4641
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-10-24
// Tags: attack.impact, attack.t1496, attack.exfiltration, attack.t1567
// Description: Detects suspicious DNS queries to Monero mining pools
// Converted by: Sigma Universal SIEM/EDR CLI

((where(query ICONTAINS "pool.minexmr.com") OR where(query ICONTAINS "fr.minexmr.com") OR where(query ICONTAINS "de.minexmr.com") OR where(query ICONTAINS "sg.minexmr.com") OR where(query ICONTAINS "ca.minexmr.com") OR where(query ICONTAINS "us-west.minexmr.com") OR where(query ICONTAINS "pool.supportxmr.com") OR where(query ICONTAINS "mine.c3pool.com") OR where(query ICONTAINS "xmr-eu1.nanopool.org") OR where(query ICONTAINS "xmr-eu2.nanopool.org") OR where(query ICONTAINS "xmr-us-east1.nanopool.org") OR where(query ICONTAINS "xmr-us-west1.nanopool.org") OR where(query ICONTAINS "xmr-asia1.nanopool.org") OR where(query ICONTAINS "xmr-jp1.nanopool.org") OR where(query ICONTAINS "xmr-au1.nanopool.org") OR where(query ICONTAINS "xmr.2miners.com") OR where(query ICONTAINS "xmr.hashcity.org") OR where(query ICONTAINS "xmr.f2pool.com") OR where(query ICONTAINS "xmrpool.eu") OR where(query ICONTAINS "pool.hashvault.pro")))
