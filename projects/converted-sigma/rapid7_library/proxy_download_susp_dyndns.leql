// Title: Download from Suspicious Dyndns Hosts
// ID: 195c1119-ef07-4909-bb12-e66f5e07bf3c
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2017-11-08
// Tags: attack.command-and-control, attack.t1105, attack.t1568
// Description: Detects download of certain file types from hosts with dynamic DNS names (selected list)
// Converted by: Sigma Universal SIEM/EDR CLI

((where(c-uri-extension = "exe") OR where(c-uri-extension = "vbs") OR where(c-uri-extension = "bat") OR where(c-uri-extension = "rar") OR where(c-uri-extension = "ps1") OR where(c-uri-extension = "doc") OR where(c-uri-extension = "docm") OR where(c-uri-extension = "xls") OR where(c-uri-extension = "xlsm") OR where(c-uri-extension = "pptm") OR where(c-uri-extension = "rtf") OR where(c-uri-extension = "hta") OR where(c-uri-extension = "dll") OR where(c-uri-extension = "ws") OR where(c-uri-extension = "wsf") OR where(c-uri-extension = "sct") OR where(c-uri-extension = "zip")) AND (where(cs-host IENDSWITH ".hopto.org") OR where(cs-host IENDSWITH ".no-ip.org") OR where(cs-host IENDSWITH ".no-ip.info") OR where(cs-host IENDSWITH ".no-ip.biz") OR where(cs-host IENDSWITH ".no-ip.com") OR where(cs-host IENDSWITH ".noip.com") OR where(cs-host IENDSWITH ".ddns.name") OR where(cs-host IENDSWITH ".myftp.org") OR where(cs-host IENDSWITH ".myftp.biz") OR where(cs-host IENDSWITH ".serveblog.net") OR where(cs-host IENDSWITH ".servebeer.com") OR where(cs-host IENDSWITH ".servemp3.com") OR where(cs-host IENDSWITH ".serveftp.com") OR where(cs-host IENDSWITH ".servequake.com") OR where(cs-host IENDSWITH ".servehalflife.com") OR where(cs-host IENDSWITH ".servehttp.com") OR where(cs-host IENDSWITH ".servegame.com") OR where(cs-host IENDSWITH ".servepics.com") OR where(cs-host IENDSWITH ".myvnc.com") OR where(cs-host IENDSWITH ".ignorelist.com") OR where(cs-host IENDSWITH ".jkub.com") OR where(cs-host IENDSWITH ".dlinkddns.com") OR where(cs-host IENDSWITH ".jumpingcrab.com") OR where(cs-host IENDSWITH ".ddns.info") OR where(cs-host IENDSWITH ".mooo.com") OR where(cs-host IENDSWITH ".dns-dns.com") OR where(cs-host IENDSWITH ".strangled.net") OR where(cs-host IENDSWITH ".adultdns.net") OR where(cs-host IENDSWITH ".craftx.biz") OR where(cs-host IENDSWITH ".ddns01.com") OR where(cs-host IENDSWITH ".dns53.biz") OR where(cs-host IENDSWITH ".dnsapi.info") OR where(cs-host IENDSWITH ".dnsd.info") OR where(cs-host IENDSWITH ".dnsdynamic.com") OR where(cs-host IENDSWITH ".dnsdynamic.net") OR where(cs-host IENDSWITH ".dnsget.org") OR where(cs-host IENDSWITH ".fe100.net") OR where(cs-host IENDSWITH ".flashserv.net") OR where(cs-host IENDSWITH ".ftp21.net") OR where(cs-host IENDSWITH ".http01.com") OR where(cs-host IENDSWITH ".http80.info") OR where(cs-host IENDSWITH ".https443.com") OR where(cs-host IENDSWITH ".imap01.com") OR where(cs-host IENDSWITH ".kadm5.com") OR where(cs-host IENDSWITH ".mysq1.net") OR where(cs-host IENDSWITH ".ns360.info") OR where(cs-host IENDSWITH ".ntdll.net") OR where(cs-host IENDSWITH ".ole32.com") OR where(cs-host IENDSWITH ".proxy8080.com") OR where(cs-host IENDSWITH ".sql01.com") OR where(cs-host IENDSWITH ".ssh01.com") OR where(cs-host IENDSWITH ".ssh22.net") OR where(cs-host IENDSWITH ".tempors.com") OR where(cs-host IENDSWITH ".tftpd.net") OR where(cs-host IENDSWITH ".ttl60.com") OR where(cs-host IENDSWITH ".ttl60.org") OR where(cs-host IENDSWITH ".user32.com") OR where(cs-host IENDSWITH ".voip01.com") OR where(cs-host IENDSWITH ".wow64.net") OR where(cs-host IENDSWITH ".x64.me") OR where(cs-host IENDSWITH ".xns01.com") OR where(cs-host IENDSWITH ".dyndns.org") OR where(cs-host IENDSWITH ".dyndns.info") OR where(cs-host IENDSWITH ".dyndns.tv") OR where(cs-host IENDSWITH ".dyndns-at-home.com") OR where(cs-host IENDSWITH ".dnsomatic.com") OR where(cs-host IENDSWITH ".zapto.org") OR where(cs-host IENDSWITH ".webhop.net") OR where(cs-host IENDSWITH ".25u.com") OR where(cs-host IENDSWITH ".slyip.net")))
