// Tags: attack.stealth, attack.t1027.004
// Description: Detects execution of "csc.exe" to compile .NET code. Attackers often leverage this to compile code on the fly and use it in other stages.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image IENDSWITH "\\csc.exe")) AND (((where(CommandLine ICONTAINS ":\\Perflogs\\") OR where(CommandLine ICONTAINS ":\\Users\\Public\\") OR where(CommandLine ICONTAINS "\\AppData\\Local\\Temp\\") OR where(CommandLine ICONTAINS "\\Temporary Internet") OR where(CommandLine ICONTAINS "\\Windows\\Temp\\"))) OR (((where(CommandLine ICONTAINS ":\\Users\\") AND where(CommandLine ICONTAINS "\\Favorites\\"))) OR ((where(CommandLine ICONTAINS ":\\Users\\") AND where(CommandLine ICONTAINS "\\Favourites\\"))) OR ((where(CommandLine ICONTAINS ":\\Users\\") AND where(CommandLine ICONTAINS "\\Contacts\\"))) OR ((where(CommandLine ICONTAINS ":\\Users\\") AND where(CommandLine ICONTAINS "\\Pictures\\")))) OR (where(CommandLine /(?:[Pp]rogram[Dd]ata|%(?:[Ll]ocal)?[Aa]pp[Dd]ata%|\\[Aa]pp[Dd]ata\\(?:[Ll]ocal(?:[Ll]ow)?|[Rr]oaming))\\[^\\]{1,256}$/))) AND NOT ((((where(ParentImage ISTARTSWITH "C:\\Program Files (x86)\\") OR where(ParentImage ISTARTSWITH "C:\\Program Files\\"))) OR (where(ParentImage = "C:\\Windows\\System32\\sdiagnhost.exe")) OR (where(ParentImage = "C:\\Windows\\System32\\inetsrv\\w3wp.exe")))) AND NOT ((((where(ParentCommandLine ICONTAINS "JwB7ACIAZgBhAGkAbABlAGQAIgA6AHQAcgB1AGUALAAiAG0AcwBnACIAOgAiAEEAbgBzAGkAYgBsAGUAIAByAGUAcQB1AGkAcgBlAHMAIABQAG8AdwBlAHIAUwBoAGUAbABsACAAdgAzAC4AMAAgAG8AcgAgAG4AZQB3AGUAcgAiAH0AJw") OR where(ParentCommandLine ICONTAINS "cAewAiAGYAYQBpAGwAZQBkACIAOgB0AHIAdQBlACwAIgBtAHMAZwAiADoAIgBBAG4AcwBpAGIAbABlACAAcgBlAHEAdQBpAHIAZQBzACAAUABvAHcAZQByAFMAaABlAGwAbAAgAHYAMwAuADAAIABvAHIAIABuAGUAdwBlAHIAIgB9ACcA") OR where(ParentCommandLine ICONTAINS "nAHsAIgBmAGEAaQBsAGUAZAAiADoAdAByAHUAZQAsACIAbQBzAGcAIgA6ACIAQQBuAHMAaQBiAGwAZQAgAHIAZQBxAHUAaQByAGUAcwAgAFAAbwB3AGUAcgBTAGgAZQBsAGwAIAB2ADMALgAwACAAbwByACAAbgBlAHcAZQByACIAfQAnA"))) OR ((where(ParentImage = "C:\\ProgramData\\chocolatey\\choco.exe") OR where(ParentImage = "C:\\ProgramData\\chocolatey\\tools\\shimgen.exe"))) OR (where(ParentCommandLine ICONTAINS "\\ProgramData\\Microsoft\\Windows Defender Advanced Threat Protection")))))
