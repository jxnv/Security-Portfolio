// Title: Schtasks From Suspicious Folders
// ID: 8a8379b8-780b-4dbf-b1e9-31c8d112fefb
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-04-15
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects scheduled task creations that have suspicious action command and folder combinations
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "C:\\ProgramData\\") OR where(CommandLine ICONTAINS "%ProgramData%"))) AND ((where(CommandLine ICONTAINS "powershell") OR where(CommandLine ICONTAINS "pwsh") OR where(CommandLine ICONTAINS "cmd /c ") OR where(CommandLine ICONTAINS "cmd /k ") OR where(CommandLine ICONTAINS "cmd /r ") OR where(CommandLine ICONTAINS "cmd.exe /c ") OR where(CommandLine ICONTAINS "cmd.exe /k ") OR where(CommandLine ICONTAINS "cmd.exe /r "))) AND (where(CommandLine ICONTAINS " /create ")) AND ((where(Image IENDSWITH "\\schtasks.exe")) OR (where(OriginalFileName = "schtasks.exe"))))
