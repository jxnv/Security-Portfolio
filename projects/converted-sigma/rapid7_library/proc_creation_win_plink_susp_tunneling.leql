// Description: Execution of plink to perform data exfiltration and tunneling
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image IENDSWITH "\\plink.exe") AND where(CommandLine ICONTAINS ":127.0.0.1:3389")) OR ((where(Image IENDSWITH "\\plink.exe") AND where(CommandLine ICONTAINS ":3389")) AND ((where(CommandLine ICONTAINS " -P 443") OR where(CommandLine ICONTAINS " -P 22")))))
