// Title: Schtasks Creation Or Modification With SYSTEM Privileges
// ID: 89ca78fd-b37c-4310-b3d3-81a023f83936
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-28
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053.005
// Description: Detects the creation or update of a scheduled task to run with "NT AUTHORITY\SYSTEM" privileges
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "\\schtasks.exe") AND (where(CommandLine ICONTAINS " /change ") OR where(CommandLine ICONTAINS " /create "))) AND (where(CommandLine ICONTAINS "/ru ")) AND ((where(CommandLine ICONTAINS "NT AUT") OR where(CommandLine ICONTAINS " SYSTEM ")))) AND NOT ((((where(CommandLine ICONTAINS "/Create /F /RU System /SC WEEKLY /TN AviraSystemSpeedupVerify /TR ") OR where(CommandLine ICONTAINS ":\\Program Files (x86)\\Avira\\System Speedup\\setup\\avira_speedup_setup.exe") OR where(CommandLine ICONTAINS "/VERIFY /VERYSILENT /NOSTART /NODOTNET /NORESTART\" /RL HIGHEST"))) OR ((where(CommandLine ICONTAINS "Subscription Heartbeat") AND where(CommandLine ICONTAINS "\\HeartbeatConfig.xml") AND where(CommandLine ICONTAINS "\\Microsoft Shared\\OFFICE"))) OR (where(Image IENDSWITH "\\schtasks.exe") AND (where(CommandLine ICONTAINS "/TN TVInstallRestore") AND where(CommandLine ICONTAINS "\\TeamViewer_.exe"))))))
