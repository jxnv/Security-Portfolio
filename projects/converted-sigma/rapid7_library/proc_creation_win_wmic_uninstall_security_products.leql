// Title: Potential Tampering With Security Products Via WMIC
// ID: 847d5ff3-8a31-4737-a970-aeae8fe21765
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-01-30
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects uninstallation or termination of security products using the WMIC utility
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(CommandLine ICONTAINS "wmic") AND where(CommandLine ICONTAINS "product ") AND where(CommandLine ICONTAINS "uninstall")) AND (where(CommandLine ICONTAINS "/nointeractive") OR where(CommandLine ICONTAINS "-nointeractive"))) OR ((where(CommandLine ICONTAINS "wmic") AND where(CommandLine ICONTAINS "caption like ")) AND (where(CommandLine ICONTAINS "call delete") OR where(CommandLine ICONTAINS "call terminate"))) OR ((where(CommandLine ICONTAINS "process ") AND where(CommandLine ICONTAINS "where ") AND where(CommandLine ICONTAINS "delete")))) AND ((where(CommandLine ICONTAINS "%carbon%") OR where(CommandLine ICONTAINS "%cylance%") OR where(CommandLine ICONTAINS "%endpoint%") OR where(CommandLine ICONTAINS "%eset%") OR where(CommandLine ICONTAINS "%malware%") OR where(CommandLine ICONTAINS "%Sophos%") OR where(CommandLine ICONTAINS "%symantec%") OR where(CommandLine ICONTAINS "Antivirus") OR where(CommandLine ICONTAINS "AVG ") OR where(CommandLine ICONTAINS "Carbon Black") OR where(CommandLine ICONTAINS "CarbonBlack") OR where(CommandLine ICONTAINS "Cb Defense Sensor 64-bit") OR where(CommandLine ICONTAINS "Crowdstrike Sensor") OR where(CommandLine ICONTAINS "Cylance ") OR where(CommandLine ICONTAINS "Dell Threat Defense") OR where(CommandLine ICONTAINS "DLP Endpoint") OR where(CommandLine ICONTAINS "Endpoint Detection") OR where(CommandLine ICONTAINS "Endpoint Protection") OR where(CommandLine ICONTAINS "Endpoint Security") OR where(CommandLine ICONTAINS "Endpoint Sensor") OR where(CommandLine ICONTAINS "ESET File Security") OR where(CommandLine ICONTAINS "LogRhythm System Monitor Service") OR where(CommandLine ICONTAINS "Malwarebytes") OR where(CommandLine ICONTAINS "McAfee Agent") OR where(CommandLine ICONTAINS "Microsoft Security Client") OR where(CommandLine ICONTAINS "Sophos Anti-Virus") OR where(CommandLine ICONTAINS "Sophos AutoUpdate") OR where(CommandLine ICONTAINS "Sophos Credential Store") OR where(CommandLine ICONTAINS "Sophos Management Console") OR where(CommandLine ICONTAINS "Sophos Management Database") OR where(CommandLine ICONTAINS "Sophos Management Server") OR where(CommandLine ICONTAINS "Sophos Remote Management System") OR where(CommandLine ICONTAINS "Sophos Update Manager") OR where(CommandLine ICONTAINS "Threat Protection") OR where(CommandLine ICONTAINS "VirusScan") OR where(CommandLine ICONTAINS "Webroot SecureAnywhere") OR where(CommandLine ICONTAINS "Windows Defender"))))
