// Title: New RUN Key Pointing to Suspicious Folder
// ID: 02ee49e2-e294-4d0f-9278-f5b3212fc588
// Status: experimental
// Level: high
// Author: Florian Roth (Nextron Systems), Markus Neis, Sander Wiebing, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2018-08-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects suspicious new RUN key element pointing to an executable in a suspicious folder
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(TargetObject ICONTAINS "\\Software\\Microsoft\\Windows\\CurrentVersion\\Run") OR where(TargetObject ICONTAINS "\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run") OR where(TargetObject ICONTAINS "\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\Run"))) AND (((where(Details ICONTAINS ":\\Perflogs") OR where(Details ICONTAINS ":\\ProgramData'") OR where(Details ICONTAINS ":\\Windows\\Temp") OR where(Details ICONTAINS ":\\Temp") OR where(Details ICONTAINS "\\AppData\\Local\\Temp") OR where(Details ICONTAINS "\\AppData\\Roaming") OR where(Details ICONTAINS ":\\$Recycle.bin") OR where(Details ICONTAINS ":\\Users\\Default") OR where(Details ICONTAINS ":\\Users\\public") OR where(Details ICONTAINS "%temp%") OR where(Details ICONTAINS "%tmp%") OR where(Details ICONTAINS "%Public%") OR where(Details ICONTAINS "%AppData%"))) OR ((where(Details ICONTAINS ":\\Users\\")) AND ((where(Details ICONTAINS "\\Favorites") OR where(Details ICONTAINS "\\Favourites") OR where(Details ICONTAINS "\\Contacts") OR where(Details ICONTAINS "\\Music") OR where(Details ICONTAINS "\\Pictures") OR where(Details ICONTAINS "\\Documents") OR where(Details ICONTAINS "\\Photos"))))) AND NOT ((where(TargetObject ICONTAINS "\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\") AND where(Image ISTARTSWITH "C:\\Windows\\SoftwareDistribution\\Download\\") AND (where(Details ICONTAINS "rundll32.exe ") AND where(Details ICONTAINS "C:\\WINDOWS\\system32\\advpack.dll,DelNodeRunDLL32")) AND (where(Details ICONTAINS "\\AppData\\Local\\Temp\\") OR where(Details ICONTAINS "C:\\Windows\\Temp\\")))) AND NOT (((where(Image IENDSWITH "C:\\Program Files\\Spotify\\Spotify.exe") OR where(Image IENDSWITH "C:\\Program Files (x86)\\Spotify\\Spotify.exe") OR where(Image IENDSWITH "\\AppData\\Roaming\\Spotify\\Spotify.exe")) AND where(TargetObject IENDSWITH "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\\Spotify") AND where(Details IENDSWITH "Spotify.exe --autostart --minimized"))))
