// Title: PowerShell Script Dropped Via PowerShell.EXE
// ID: 576426ad-0131-4001-ae01-be175da0c108
// Status: test
// Level: low
// Author: frack113
// Date: 2023-05-09
// Tags: attack.persistence
// Description: Detects PowerShell creating a PowerShell file (.ps1). While often times this behavior is benign, sometimes it can be a sign of a dropper script trying to achieve persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe")) AND where(TargetFilename IENDSWITH ".ps1")) AND NOT (((where(TargetFilename ISTARTSWITH "C:\\Users\\") AND where(TargetFilename ICONTAINS "\\AppData\\Local\\Temp\\")) OR (where(TargetFilename ICONTAINS "__PSScriptPolicyTest_")) OR (where(TargetFilename ISTARTSWITH "C:\\Windows\\Temp\\")))))
