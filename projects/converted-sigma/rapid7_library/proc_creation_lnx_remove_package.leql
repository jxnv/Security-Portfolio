// Title: Linux Package Uninstall
// ID: 95d61234-7f56-465c-6f2d-b562c6fedbc4
// Status: test
// Level: low
// Author: Tuan Le (NCSGroup), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-03-09
// Tags: attack.stealth, attack.t1070
// Description: Detects linux package removal using builtin tools such as "yum", "apt", "apt-get" or "dpkg".
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "/apt") OR where(Image IENDSWITH "/apt-get")) AND (where(CommandLine ICONTAINS "remove") OR where(CommandLine ICONTAINS "purge"))) OR (where(Image IENDSWITH "/dpkg") AND (where(CommandLine ICONTAINS "--remove ") OR where(CommandLine ICONTAINS " -r "))) OR (where(Image IENDSWITH "/rpm") AND where(CommandLine ICONTAINS " -e ")) OR (where(Image IENDSWITH "/yum") AND (where(CommandLine ICONTAINS "erase") OR where(CommandLine ICONTAINS "remove"))))
