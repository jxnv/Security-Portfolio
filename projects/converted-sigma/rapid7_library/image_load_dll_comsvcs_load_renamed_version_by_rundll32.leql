// Title: Suspicious Renamed Comsvcs DLL Loaded By Rundll32
// ID: 8cde342c-ba48-4b74-b615-172c330f2e93
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-14
// Tags: attack.credential-access, attack.t1003.001
// Description: Detects rundll32 loading a renamed comsvcs.dll to dump process memory
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image IENDSWITH "\\rundll32.exe") AND (where(Hashes ICONTAINS "IMPHASH=eed93054cb555f3de70eaa9787f32ebb") OR where(Hashes ICONTAINS "IMPHASH=5e0dbdec1fce52daae251a110b4f309d") OR where(Hashes ICONTAINS "IMPHASH=eadbccbb324829acb5f2bbe87e5549a8") OR where(Hashes ICONTAINS "IMPHASH=407ca0f7b523319d758a40d7c0193699") OR where(Hashes ICONTAINS "IMPHASH=281d618f4e6271e527e6386ea6f748de"))) AND NOT ((where(ImageLoaded IENDSWITH "\\comsvcs.dll"))))
