// Title: Suspicious Program Names
// ID: efdd8dd5-cee8-4e59-9390-7d4d5e4dd6f6
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-11
// Tags: attack.execution, attack.t1059
// Description: Detects suspicious patterns in program names or folders that are often found in malicious samples or hacktools
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "inject.ps1") OR where(CommandLine ICONTAINS "Invoke-CVE") OR where(CommandLine ICONTAINS "pupy.ps1") OR where(CommandLine ICONTAINS "payload.ps1") OR where(CommandLine ICONTAINS "beacon.ps1") OR where(CommandLine ICONTAINS "PowerView.ps1") OR where(CommandLine ICONTAINS "bypass.ps1") OR where(CommandLine ICONTAINS "obfuscated.ps1") OR where(CommandLine ICONTAINS "obfusc.ps1") OR where(CommandLine ICONTAINS "obfus.ps1") OR where(CommandLine ICONTAINS "obfs.ps1") OR where(CommandLine ICONTAINS "evil.ps1") OR where(CommandLine ICONTAINS "MiniDogz.ps1") OR where(CommandLine ICONTAINS "_enc.ps1") OR where(CommandLine ICONTAINS "\\shell.ps1") OR where(CommandLine ICONTAINS "\\rshell.ps1") OR where(CommandLine ICONTAINS "revshell.ps1") OR where(CommandLine ICONTAINS "\\av.ps1") OR where(CommandLine ICONTAINS "\\av_test.ps1") OR where(CommandLine ICONTAINS "adrecon.ps1") OR where(CommandLine ICONTAINS "mimikatz.ps1") OR where(CommandLine ICONTAINS "\\PowerUp_") OR where(CommandLine ICONTAINS "powerup.ps1") OR where(CommandLine ICONTAINS "\\Temp\\a.ps1") OR where(CommandLine ICONTAINS "\\Temp\\p.ps1") OR where(CommandLine ICONTAINS "\\Temp\\1.ps1") OR where(CommandLine ICONTAINS "Hound.ps1") OR where(CommandLine ICONTAINS "encode.ps1") OR where(CommandLine ICONTAINS "powercat.ps1"))) OR (((where(Image ICONTAINS "\\CVE-202") OR where(Image ICONTAINS "\\CVE202"))) OR ((where(Image IENDSWITH "\\poc.exe") OR where(Image IENDSWITH "\\artifact.exe") OR where(Image IENDSWITH "\\artifact64.exe") OR where(Image IENDSWITH "\\artifact_protected.exe") OR where(Image IENDSWITH "\\artifact32.exe") OR where(Image IENDSWITH "\\artifact32big.exe") OR where(Image IENDSWITH "obfuscated.exe") OR where(Image IENDSWITH "obfusc.exe") OR where(Image IENDSWITH "\\meterpreter")))))
