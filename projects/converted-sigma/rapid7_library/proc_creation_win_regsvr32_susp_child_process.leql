// Title: Potentially Suspicious Child Process Of Regsvr32
// ID: 6f0947a4-1c5e-4e0d-8ac7-53159b8f23ca
// Status: test
// Level: high
// Author: elhoim, Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-05-05
// Tags: attack.stealth, attack.t1218.010
// Description: Detects potentially suspicious child processes of "regsvr32.exe".
// Converted by: Sigma Universal SIEM/EDR CLI

((where(ParentImage IENDSWITH "\\regsvr32.exe") AND (where(Image IENDSWITH "\\calc.exe") OR where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\explorer.exe") OR where(Image IENDSWITH "\\mshta.exe") OR where(Image IENDSWITH "\\net.exe") OR where(Image IENDSWITH "\\net1.exe") OR where(Image IENDSWITH "\\nltest.exe") OR where(Image IENDSWITH "\\notepad.exe") OR where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe") OR where(Image IENDSWITH "\\reg.exe") OR where(Image IENDSWITH "\\schtasks.exe") OR where(Image IENDSWITH "\\werfault.exe") OR where(Image IENDSWITH "\\wscript.exe"))) AND NOT ((where(Image IENDSWITH "\\werfault.exe") AND where(CommandLine ICONTAINS " -u -p "))))
