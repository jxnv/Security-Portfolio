((where(EventID = "5136") AND (where(AttributeLDAPDisplayName = "gPCMachineExtensionNames") OR where(AttributeLDAPDisplayName = "gPCUserExtensionNames")) AND (where(AttributeValue ICONTAINS "CAB54552-DEEA-4691-817E-ED4A4D1AFC72") OR where(AttributeValue ICONTAINS "AADCED64-746C-4633-A97C-D61349046527"))) OR (where(EventID = "5145") AND where(ShareName IENDSWITH "\\SYSVOL") AND where(RelativeTargetName IENDSWITH "ScheduledTasks.xml") AND (where(AccessList ICONTAINS "WriteData") OR where(AccessList ICONTAINS "%%4417"))))
