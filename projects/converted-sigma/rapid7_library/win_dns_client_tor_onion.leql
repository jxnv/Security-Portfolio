// Title: Query Tor Onion Address - DNS Client
// ID: 8384bd26-bde6-4da9-8e5d-4174a7a47ca2
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-02-20
// Tags: attack.command-and-control, attack.t1090.003
// Description: Detects DNS resolution of an .onion address related to Tor routing networks
// Converted by: Sigma Universal SIEM/EDR CLI

(where(EventID = "3008") AND (where(QueryName IENDSWITH ".hiddenservice.net") OR where(QueryName IENDSWITH ".onion.ca") OR where(QueryName IENDSWITH ".onion.cab") OR where(QueryName IENDSWITH ".onion.casa") OR where(QueryName IENDSWITH ".onion.city") OR where(QueryName IENDSWITH ".onion.direct") OR where(QueryName IENDSWITH ".onion.dog") OR where(QueryName IENDSWITH ".onion.glass") OR where(QueryName IENDSWITH ".onion.gq") OR where(QueryName IENDSWITH ".onion.guide") OR where(QueryName IENDSWITH ".onion.in.net") OR where(QueryName IENDSWITH ".onion.ink") OR where(QueryName IENDSWITH ".onion.it") OR where(QueryName IENDSWITH ".onion.link") OR where(QueryName IENDSWITH ".onion.lt") OR where(QueryName IENDSWITH ".onion.lu") OR where(QueryName IENDSWITH ".onion.ly") OR where(QueryName IENDSWITH ".onion.mn") OR where(QueryName IENDSWITH ".onion.network") OR where(QueryName IENDSWITH ".onion.nu") OR where(QueryName IENDSWITH ".onion.pet") OR where(QueryName IENDSWITH ".onion.plus") OR where(QueryName IENDSWITH ".onion.pt") OR where(QueryName IENDSWITH ".onion.pw") OR where(QueryName IENDSWITH ".onion.rip") OR where(QueryName IENDSWITH ".onion.sh") OR where(QueryName IENDSWITH ".onion.si") OR where(QueryName IENDSWITH ".onion.to") OR where(QueryName IENDSWITH ".onion.top") OR where(QueryName IENDSWITH ".onion.ws") OR where(QueryName IENDSWITH ".onion") OR where(QueryName IENDSWITH ".s1.tor-gateways.de") OR where(QueryName IENDSWITH ".s2.tor-gateways.de") OR where(QueryName IENDSWITH ".s3.tor-gateways.de") OR where(QueryName IENDSWITH ".s4.tor-gateways.de") OR where(QueryName IENDSWITH ".s5.tor-gateways.de") OR where(QueryName IENDSWITH ".t2w.pw") OR where(QueryName IENDSWITH ".tor2web.ae.org") OR where(QueryName IENDSWITH ".tor2web.blutmagie.de") OR where(QueryName IENDSWITH ".tor2web.com") OR where(QueryName IENDSWITH ".tor2web.fi") OR where(QueryName IENDSWITH ".tor2web.io") OR where(QueryName IENDSWITH ".tor2web.org") OR where(QueryName IENDSWITH ".tor2web.xyz") OR where(QueryName IENDSWITH ".torlink.co")))
