// Title: Suspicious Eventlog Clearing or Configuration Change Activity
// ID: cc36992a-4671-4f21-a91d-6c2b72a2edf5
// Status: stable
// Level: high
// Author: Ecco, Daniil Yugoslavskiy, oscd.community, D3F7A5105, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2019-09-26
// Tags: attack.defense-impairment, attack.t1685.005, attack.t1685.001, car.2016-04-002
// Description: Detects the clearing or configuration tampering of EventLog using utilities such as "wevtutil", "powershell" and "wmic".
// This technique were seen used by threat actors and ransomware strains in order to evade defenses.
// Converted by: Sigma Universal SIEM/EDR CLI

(((((where(CommandLine ICONTAINS "clear-log ") OR where(CommandLine ICONTAINS " cl ") OR where(CommandLine ICONTAINS "set-log ") OR where(CommandLine ICONTAINS " sl ") OR where(CommandLine ICONTAINS "lfn:"))) AND ((where(Image IENDSWITH "\\wevtutil.exe")) OR (where(OriginalFileName = "wevtutil.exe")))) OR ((((where(CommandLine ICONTAINS "Clear-EventLog ") OR where(CommandLine ICONTAINS "Remove-EventLog ") OR where(CommandLine ICONTAINS "Limit-EventLog ") OR where(CommandLine ICONTAINS "Clear-WinEvent "))) OR ((where(CommandLine ICONTAINS "Eventing.Reader.EventLogSession") AND where(CommandLine ICONTAINS "ClearLog"))) OR ((where(CommandLine ICONTAINS "Diagnostics.EventLog") AND where(CommandLine ICONTAINS "Clear")))) AND ((where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\powershell_ise.exe") OR where(Image IENDSWITH "\\pwsh.exe")))) OR ((where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\powershell_ise.exe") OR where(Image IENDSWITH "\\pwsh.exe") OR where(Image IENDSWITH "\\wmic.exe")) AND where(CommandLine ICONTAINS "ClearEventLog"))) AND NOT (((where(ParentImage = "C:\\Windows\\SysWOW64\\msiexec.exe") OR where(ParentImage = "C:\\Windows\\System32\\msiexec.exe")) AND where(CommandLine ICONTAINS " sl "))))
