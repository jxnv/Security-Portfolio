// Title: Potential Goopdate.DLL Sideloading
// ID: b6188d2f-b3c4-4d2c-a17d-9706e0851af0
// Status: test
// Level: medium
// Author: X__Junior (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-15
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of "goopdate.dll", a DLL used by googleupdate.exe
// Converted by: Sigma Universal SIEM/EDR CLI

((where(ImageLoaded IENDSWITH "\\goopdate.dll")) AND NOT (((where(ImageLoaded ISTARTSWITH "C:\\Program Files (x86)\\") OR where(ImageLoaded ISTARTSWITH "C:\\Program Files\\")))) AND NOT ((((where(Image ICONTAINS "\\AppData\\Local\\Temp\\GUM") AND where(Image ICONTAINS ".tmp\\Dropbox")) AND (where(ImageLoaded ICONTAINS "\\AppData\\Local\\Temp\\GUM") AND where(ImageLoaded ICONTAINS ".tmp\\goopdate.dll"))) OR ((where(Image ICONTAINS "\\AppData\\Local\\Temp\\GUM") OR where(Image ICONTAINS ":\\Windows\\SystemTemp\\GUM")) AND where(Image IENDSWITH ".tmp\\GoogleUpdate.exe") AND (where(ImageLoaded ICONTAINS "\\AppData\\Local\\Temp\\GUM") OR where(ImageLoaded ICONTAINS ":\\Windows\\SystemTemp\\GUM"))))))
