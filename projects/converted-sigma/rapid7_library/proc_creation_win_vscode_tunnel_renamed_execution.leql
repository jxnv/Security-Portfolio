// Title: Renamed Visual Studio Code Tunnel Execution
// ID: 2cf29f11-e356-4f61-98c0-1bdb9393d6da
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-09-28
// Tags: attack.command-and-control, attack.t1071.001, attack.t1219
// Description: Detects renamed Visual Studio Code tunnel execution. Attackers can abuse this functionality to establish a C2 channel
// Converted by: Sigma Universal SIEM/EDR CLI

((((NOT OriginalFileName=* AND where(CommandLine IENDSWITH ".exe tunnel")) OR ((where(CommandLine ICONTAINS ".exe tunnel") AND where(CommandLine ICONTAINS "--accept-server-license-terms"))) OR ((where(CommandLine ICONTAINS "tunnel ") AND where(CommandLine ICONTAINS "service") AND where(CommandLine ICONTAINS "internal-run") AND where(CommandLine ICONTAINS "tunnel-service.log")))) AND NOT (((where(Image IENDSWITH "\\code-tunnel.exe") OR where(Image IENDSWITH "\\code.exe"))))) OR ((where(ParentCommandLine IENDSWITH " tunnel") AND where(Image IENDSWITH "\\cmd.exe") AND (where(CommandLine ICONTAINS "/d /c ") AND where(CommandLine ICONTAINS "\\servers\\Stable-") AND where(CommandLine ICONTAINS "code-server.cmd"))) AND NOT (((where(ParentImage IENDSWITH "\\code-tunnel.exe") OR where(ParentImage IENDSWITH "\\code.exe"))))))
