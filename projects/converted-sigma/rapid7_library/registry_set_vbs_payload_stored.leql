// Title: VBScript Payload Stored in Registry
// ID: 46490193-1b22-4c29-bdd6-5bf63907216f
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-03-05
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects VBScript content stored into registry keys as seen being used by UNC2452 group
// Converted by: Sigma Universal SIEM/EDR CLI

((where(TargetObject ICONTAINS "Software\\Microsoft\\Windows\\CurrentVersion") AND (where(Details ICONTAINS "vbscript:") OR where(Details ICONTAINS "jscript:") OR where(Details ICONTAINS "mshtml,") OR where(Details ICONTAINS "RunHTMLApplication") OR where(Details ICONTAINS "Execute(") OR where(Details ICONTAINS "CreateObject") OR where(Details ICONTAINS "window.close"))) AND NOT (((where(TargetObject ICONTAINS "Software\\Microsoft\\Windows\\CurrentVersion\\Run")) OR (where(Image IENDSWITH "\\msiexec.exe") AND where(TargetObject ICONTAINS "\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Installer\\UserData\\") AND (where(Details ICONTAINS "\\Microsoft.NET\\Primary Interop Assemblies\\Microsoft.mshtml.dll") OR where(Details ICONTAINS "<\\Microsoft.mshtml,fileVersion=") OR where(Details ICONTAINS "_mshtml_dll_") OR where(Details ICONTAINS "<\\Microsoft.mshtml,culture="))))))
