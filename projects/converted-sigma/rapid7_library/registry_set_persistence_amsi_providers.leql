// Title: Potential Persistence Via New AMSI Providers - Registry
// ID: 33efc23c-6ea2-4503-8cfe-bdf82ce8f705
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-21
// Tags: attack.persistence
// Description: Detects when an attacker adds a new AMSI provider via the Windows Registry to bypass AMSI (Antimalware Scan Interface) protections.
// Attackers may add custom AMSI providers to persist on the system and evade detection by security software that relies on AMSI for scanning scripts and other content.
// This technique is often used in conjunction with fileless malware and script-based attacks to maintain persistence while avoiding detection.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(TargetObject ICONTAINS "\\SOFTWARE\\Microsoft\\AMSI\\Providers\\") OR where(TargetObject ICONTAINS "\\SOFTWARE\\WOW6432Node\\Microsoft\\AMSI\\Providers\\"))) AND NOT ((((where(Image = "C:\\Program Files\\Avast Software\\Avast\\RegSvr.exe") OR where(Image = "C:\\Program Files\\Avast Software\\Avast\\x86\\RegSvr.exe")) AND where(TargetObject ICONTAINS "\\{FB904E4E-D2C7-4C8D-8492-B620BB9896B1}")) OR ((where(Image = "C:\\Program Files\\AVG\\Antivirus\\RegSvr.exe") OR where(Image = "C:\\Program Files\\AVG\\Antivirus\\x86\\RegSvr.exe")) AND where(TargetObject ICONTAINS "\\{FB904E4E-D2C7-4C8D-8492-B620BB9896B1}")) OR (where(Image = "C:\\Program Files\\Avira\\Endpoint Protection SDK\\endpointprotection.exe") AND where(TargetObject ICONTAINS "\\{00000001-3DCC-4B48-A82E-E2071FE58E05}")))))
