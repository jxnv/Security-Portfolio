// Title: New Root or CA or AuthRoot Certificate to Store
// ID: d223b46b-5621-4037-88fe-fda32eead684
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-04-04
// Tags: attack.impact, attack.t1490
// Description: Detects the addition of new root, CA or AuthRoot certificates to the Windows registry
// Converted by: Sigma Universal SIEM/EDR CLI

((where(TargetObject ICONTAINS "\\SOFTWARE\\Microsoft\\SystemCertificates\\Root\\Certificates\\") OR where(TargetObject ICONTAINS "\\SOFTWARE\\Policies\\Microsoft\\SystemCertificates\\Root\\Certificates\\") OR where(TargetObject ICONTAINS "\\SOFTWARE\\Microsoft\\EnterpriseCertificates\\Root\\Certificates\\") OR where(TargetObject ICONTAINS "\\SOFTWARE\\Microsoft\\SystemCertificates\\CA\\Certificates\\") OR where(TargetObject ICONTAINS "\\SOFTWARE\\Policies\\Microsoft\\SystemCertificates\\CA\\Certificates\\") OR where(TargetObject ICONTAINS "\\SOFTWARE\\Microsoft\\EnterpriseCertificates\\CA\\Certificates\\") OR where(TargetObject ICONTAINS "\\SOFTWARE\\Microsoft\\SystemCertificates\\AuthRoot\\Certificates\\") OR where(TargetObject ICONTAINS "\\SOFTWARE\\Policies\\Microsoft\\SystemCertificates\\AuthRoot\\Certificates\\") OR where(TargetObject ICONTAINS "\\SOFTWARE\\Microsoft\\EnterpriseCertificates\\AuthRoot\\Certificates\\")) AND where(TargetObject IENDSWITH "\\Blob") AND where(Details = "Binary Data"))
