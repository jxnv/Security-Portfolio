// Title: PowerShell Core DLL Loaded Via Office Application
// ID: bb2ba6fb-95d4-4a25-89fc-30bb736c021a
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-01
// Tags: attack.stealth
// Description: Detects PowerShell core DLL being loaded by an Office Product
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image IENDSWITH "\\excel.exe") OR where(Image IENDSWITH "\\mspub.exe") OR where(Image IENDSWITH "\\outlook.exe") OR where(Image IENDSWITH "\\onenote.exe") OR where(Image IENDSWITH "\\onenoteim.exe") OR where(Image IENDSWITH "\\powerpnt.exe") OR where(Image IENDSWITH "\\winword.exe")) AND (where(ImageLoaded ICONTAINS "\\System.Management.Automation.Dll") OR where(ImageLoaded ICONTAINS "\\System.Management.Automation.ni.Dll")))
