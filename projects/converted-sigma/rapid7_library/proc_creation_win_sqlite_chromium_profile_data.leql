// Title: SQLite Chromium Profile Data DB Access
// ID: 24c77512-782b-448a-8950-eddb0785fc71
// Status: test
// Level: high
// Author: TropChaud
// Date: 2022-12-19
// Tags: attack.credential-access, attack.t1539, attack.t1555.003, attack.collection, attack.t1005
// Description: Detect usage of the "sqlite" binary to query databases in Chromium-based browsers for potential data stealing.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "\\User Data\\") OR where(CommandLine ICONTAINS "\\Opera Software\\") OR where(CommandLine ICONTAINS "\\ChromiumViewer\\"))) AND ((where(CommandLine ICONTAINS "Login Data") OR where(CommandLine ICONTAINS "Cookies") OR where(CommandLine ICONTAINS "Web Data") OR where(CommandLine ICONTAINS "History") OR where(CommandLine ICONTAINS "Bookmarks"))) AND ((where(Product = "SQLite")) OR ((where(Image IENDSWITH "\\sqlite.exe") OR where(Image IENDSWITH "\\sqlite3.exe")))))
