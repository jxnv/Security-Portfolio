// Title: Suspicious Execution via macOS Script Editor
// ID: 6e4dcdd1-e48b-42f7-b2d8-3b413fc58cb4
// Status: test
// Level: medium
// Author: Tim Rauch (rule), Elastic (idea)
// Date: 2022-10-21
// Tags: attack.defense-impairment, attack.t1566, attack.t1566.002, attack.initial-access, attack.t1059, attack.t1059.002, attack.t1204, attack.t1204.001, attack.execution, attack.persistence, attack.t1553
// Description: Detects when the macOS Script Editor utility spawns an unusual child process.
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(Image IENDSWITH "/curl") OR where(Image IENDSWITH "/bash") OR where(Image IENDSWITH "/sh") OR where(Image IENDSWITH "/zsh") OR where(Image IENDSWITH "/dash") OR where(Image IENDSWITH "/fish") OR where(Image IENDSWITH "/osascript") OR where(Image IENDSWITH "/mktemp") OR where(Image IENDSWITH "/chmod") OR where(Image IENDSWITH "/php") OR where(Image IENDSWITH "/nohup") OR where(Image IENDSWITH "/openssl") OR where(Image IENDSWITH "/plutil") OR where(Image IENDSWITH "/PlistBuddy") OR where(Image IENDSWITH "/xattr") OR where(Image IENDSWITH "/sqlite") OR where(Image IENDSWITH "/funzip") OR where(Image IENDSWITH "/popen"))) OR ((where(Image ICONTAINS "python") OR where(Image ICONTAINS "perl")))) AND (where(ParentImage IENDSWITH "/Script Editor")))
