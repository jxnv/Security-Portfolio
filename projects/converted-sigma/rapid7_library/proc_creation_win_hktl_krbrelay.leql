// Title: HackTool - KrbRelay Execution
// ID: e96253b8-6b3b-4f90-9e59-3b24b99cf9b4
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-04-27
// Tags: attack.credential-access, attack.t1558.003
// Description: Detects the use of KrbRelay, a Kerberos relaying tool
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS " -spn ") AND where(CommandLine ICONTAINS " -clsid ") AND where(CommandLine ICONTAINS " -rbcd "))) OR ((where(CommandLine ICONTAINS "shadowcred") AND where(CommandLine ICONTAINS "clsid") AND where(CommandLine ICONTAINS "spn"))) OR ((where(CommandLine ICONTAINS "spn ") AND where(CommandLine ICONTAINS "session ") AND where(CommandLine ICONTAINS "clsid "))) OR ((where(Image IENDSWITH "\\KrbRelay.exe")) OR (where(OriginalFileName = "KrbRelay.exe"))))
