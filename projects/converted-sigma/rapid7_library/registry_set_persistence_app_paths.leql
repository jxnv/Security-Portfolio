// Title: Potential Persistence Via App Paths Default Property
// ID: 707e097c-e20f-4f67-8807-1f72ff4500d6
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-10
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.012
// Description: Detects changes to the "Default" property for keys located in the \Software\Microsoft\Windows\CurrentVersion\App Paths\ registry. Which might be used as a method of persistence
// The entries found under App Paths are used primarily for the following purposes.
// First, to map an application's executable file name to that file's fully qualified path.
// Second, to prepend information to the PATH environment variable on a per-application, per-process basis.
// Converted by: Sigma Universal SIEM/EDR CLI

(where(TargetObject ICONTAINS "\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths") AND (where(TargetObject IENDSWITH "(Default)") OR where(TargetObject IENDSWITH "Path")) AND (where(Details ICONTAINS "\\Users\\Public") OR where(Details ICONTAINS "\\AppData\\Local\\Temp\\") OR where(Details ICONTAINS "\\Windows\\Temp\\") OR where(Details ICONTAINS "\\Desktop\\") OR where(Details ICONTAINS "\\Downloads\\") OR where(Details ICONTAINS "%temp%") OR where(Details ICONTAINS "%tmp%") OR where(Details ICONTAINS "iex") OR where(Details ICONTAINS "Invoke-") OR where(Details ICONTAINS "rundll32") OR where(Details ICONTAINS "regsvr32") OR where(Details ICONTAINS "mshta") OR where(Details ICONTAINS "cscript") OR where(Details ICONTAINS "wscript") OR where(Details ICONTAINS ".bat") OR where(Details ICONTAINS ".hta") OR where(Details ICONTAINS ".dll") OR where(Details ICONTAINS ".ps1")))
