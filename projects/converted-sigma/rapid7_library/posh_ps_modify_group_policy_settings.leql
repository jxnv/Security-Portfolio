// Title: Modify Group Policy Settings - ScriptBlockLogging
// ID: b7216a7d-687e-4c8d-82b1-3080b2ad961f
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-08-19
// Tags: attack.privilege-escalation, attack.defense-impairment, attack.t1484.001
// Description: Detect malicious GPO modifications can be used to implement many other malicious behaviors.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(ScriptBlockText ICONTAINS "GroupPolicyRefreshTimeDC") OR where(ScriptBlockText ICONTAINS "GroupPolicyRefreshTimeOffsetDC") OR where(ScriptBlockText ICONTAINS "GroupPolicyRefreshTime") OR where(ScriptBlockText ICONTAINS "GroupPolicyRefreshTimeOffset") OR where(ScriptBlockText ICONTAINS "EnableSmartScreen") OR where(ScriptBlockText ICONTAINS "ShellSmartScreenLevel"))) AND (where(ScriptBlockText ICONTAINS "\\SOFTWARE\\Policies\\Microsoft\\Windows\\System")))
