// Title: Suspicious Manipulation Of Default Accounts Via Net.EXE
// ID: 5b768e71-86f2-4879-b448-81061cbae951
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-01
// Tags: attack.collection, attack.t1560.001
// Description: Detects suspicious manipulations of default accounts such as 'administrator' and 'guest'. For example 'enable' or 'disable' accounts or change the password...etc
// Converted by: Sigma Universal SIEM/EDR CLI

(((((where(Image IENDSWITH "\\net.exe") OR where(Image IENDSWITH "\\net1.exe"))) OR ((where(OriginalFileName = "net.exe") OR where(OriginalFileName = "net1.exe")))) AND (where(CommandLine ICONTAINS " user ")) AND ((where(CommandLine ICONTAINS " Järjestelmänvalvoja ") OR where(CommandLine ICONTAINS " Rendszergazda ") OR where(CommandLine ICONTAINS " Администратор ") OR where(CommandLine ICONTAINS " Administrateur ") OR where(CommandLine ICONTAINS " Administrador ") OR where(CommandLine ICONTAINS " Administratör ") OR where(CommandLine ICONTAINS " Administrator ") OR where(CommandLine ICONTAINS " guest ") OR where(CommandLine ICONTAINS " DefaultAccount ") OR where(CommandLine ICONTAINS " \"Järjestelmänvalvoja\" ") OR where(CommandLine ICONTAINS " \"Rendszergazda\" ") OR where(CommandLine ICONTAINS " \"Администратор\" ") OR where(CommandLine ICONTAINS " \"Administrateur\" ") OR where(CommandLine ICONTAINS " \"Administrador\" ") OR where(CommandLine ICONTAINS " \"Administratör\" ") OR where(CommandLine ICONTAINS " \"Administrator\" ") OR where(CommandLine ICONTAINS " \"guest\" ") OR where(CommandLine ICONTAINS " \"DefaultAccount\" ") OR where(CommandLine ICONTAINS " 'Järjestelmänvalvoja' ") OR where(CommandLine ICONTAINS " 'Rendszergazda' ") OR where(CommandLine ICONTAINS " 'Администратор' ") OR where(CommandLine ICONTAINS " 'Administrateur' ") OR where(CommandLine ICONTAINS " 'Administrador' ") OR where(CommandLine ICONTAINS " 'Administratör' ") OR where(CommandLine ICONTAINS " 'Administrator' ") OR where(CommandLine ICONTAINS " 'guest' ") OR where(CommandLine ICONTAINS " 'DefaultAccount' ")))) AND NOT (((where(CommandLine ICONTAINS "guest") AND where(CommandLine ICONTAINS "/active no")))))
