// Title: Security Software Discovery - Linux
// ID: c9d8b7fd-78e4-44fe-88f6-599135d46d60
// Status: test
// Level: low
// Author: Daniil Yugoslavskiy, oscd.community
// Date: 2020-10-19
// Tags: attack.discovery, attack.t1518.001
// Description: Detects usage of system utilities (only grep and egrep for now) to discover security software discovery
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image IENDSWITH "/grep") OR where(Image IENDSWITH "/egrep")) AND (where(CommandLine ICONTAINS "nessusd") OR where(CommandLine ICONTAINS "td-agent") OR where(CommandLine ICONTAINS "packetbeat") OR where(CommandLine ICONTAINS "filebeat") OR where(CommandLine ICONTAINS "auditbeat") OR where(CommandLine ICONTAINS "osqueryd") OR where(CommandLine ICONTAINS "cbagentd") OR where(CommandLine ICONTAINS "falcond")))
