// Title: Suspicious New Service Creation
// ID: 17a1be64-8d88-40bf-b5ff-a4f7a50ebcc8
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-14
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects creation of a new service via "sc" command or the powershell "new-service" cmdlet with suspicious binary paths
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(CommandLine ICONTAINS "New-Service") AND where(CommandLine ICONTAINS "-BinaryPathName"))) OR (where(Image IENDSWITH "\\sc.exe") AND (where(CommandLine ICONTAINS "create") AND where(CommandLine ICONTAINS "binPath=")))) AND ((where(CommandLine ICONTAINS "powershell") OR where(CommandLine ICONTAINS "mshta") OR where(CommandLine ICONTAINS "wscript") OR where(CommandLine ICONTAINS "cscript") OR where(CommandLine ICONTAINS "svchost") OR where(CommandLine ICONTAINS "dllhost") OR where(CommandLine ICONTAINS "cmd ") OR where(CommandLine ICONTAINS "cmd.exe /c") OR where(CommandLine ICONTAINS "cmd.exe /k") OR where(CommandLine ICONTAINS "cmd.exe /r") OR where(CommandLine ICONTAINS "rundll32") OR where(CommandLine ICONTAINS "C:\\Users\\Public") OR where(CommandLine ICONTAINS "\\Downloads\\") OR where(CommandLine ICONTAINS "\\Desktop\\") OR where(CommandLine ICONTAINS "\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\") OR where(CommandLine ICONTAINS "C:\\Windows\\TEMP\\") OR where(CommandLine ICONTAINS "\\AppData\\Local\\Temp"))))
