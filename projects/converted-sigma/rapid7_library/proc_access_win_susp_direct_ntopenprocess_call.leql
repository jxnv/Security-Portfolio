// Tags: attack.execution, attack.t1106
// Description: Detects potential calls to NtOpenProcess directly from NTDLL.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(CallTrace ISTARTSWITH "UNKNOWN")) AND NOT ((((where(SourceImage ICONTAINS ":\\Program Files (x86)\\") OR where(SourceImage ICONTAINS ":\\Program Files\\") OR where(SourceImage ICONTAINS ":\\Windows\\System32\\") OR where(SourceImage ICONTAINS ":\\Windows\\SysWOW64\\") OR where(SourceImage ICONTAINS ":\\Windows\\WinSxS\\")) AND (where(TargetImage ICONTAINS ":\\Program Files (x86)\\") OR where(TargetImage ICONTAINS ":\\Program Files\\") OR where(TargetImage ICONTAINS ":\\Windows\\System32\\") OR where(TargetImage ICONTAINS ":\\Windows\\SysWOW64\\") OR where(TargetImage ICONTAINS ":\\Windows\\WinSxS\\"))) OR (where(Provider_Name = "Microsoft-Windows-Kernel-Audit-API-Calls")) OR (where(TargetImage IENDSWITH "vcredist_x64.exe") AND where(SourceImage IENDSWITH "vcredist_x64.exe")))) AND NOT (((where(SourceImage ICONTAINS ":\\Program Files\\Adobe\\Acrobat DC\\Acrobat\\") AND where(SourceImage IENDSWITH "\\AcroCEF.exe") AND where(TargetImage ICONTAINS ":\\Program Files\\Adobe\\Acrobat DC\\Acrobat\\") AND where(TargetImage IENDSWITH "\\AcroCEF.exe")) OR (where(SourceImage IENDSWITH "AmazonSSMAgentSetup.exe") AND where(TargetImage IENDSWITH "AmazonSSMAgentSetup.exe")) OR (where(SourceImage IENDSWITH ":\\Windows\\Explorer.EXE") AND where(TargetImage IENDSWITH ":\\Program Files\\Cylance\\Desktop\\CylanceUI.exe")) OR (where(TargetImage ICONTAINS "\\AppData\\Local\\Discord\\") AND where(TargetImage IENDSWITH "\\Discord.exe")) OR (where(TargetImage IENDSWITH "\\Evernote\\Evernote.exe")) OR (where(TargetImage IENDSWITH "\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe") AND where(SourceImage IENDSWITH "\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe")) OR (where(TargetImage IENDSWITH ":\\Windows\\system32\\systeminfo.exe") AND where(SourceImage IENDSWITH "setup64.exe")) OR (where(SourceImage IENDSWITH "\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe") AND where(TargetImage IENDSWITH "\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe")) OR (where(SourceImage ICONTAINS "\\AppData\\Local\\yammerdesktop\\app-") AND where(SourceImage IENDSWITH "\\Yammer.exe") AND where(TargetImage ICONTAINS "\\AppData\\Local\\yammerdesktop\\app-") AND where(TargetImage IENDSWITH "\\Yammer.exe") AND where(GrantedAccess = "0x1000")))))
