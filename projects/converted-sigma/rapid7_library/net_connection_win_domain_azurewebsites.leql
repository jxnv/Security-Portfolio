// Title: Network Connection Initiated To AzureWebsites.NET By Non-Browser Process
// ID: 5c80b618-0dbb-46e6-acbb-03d90bcb6d83
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.command-and-control, attack.t1102, attack.t1102.001
// Description: Detects an initiated network connection by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Initiated = "true") AND where(DestinationHostname IENDSWITH "azurewebsites.net")) AND NOT ((((where(Image ISTARTSWITH "C:\\Program Files (x86)\\Avant Browser\\") OR where(Image ISTARTSWITH "C:\\Program Files\\Avant Browser\\")) AND where(Image IENDSWITH "\\avant.exe")) OR (where(Image ISTARTSWITH "C:\\Program Files\\BraveSoftware\\") AND where(Image IENDSWITH "\\brave.exe")) OR ((where(Image = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe") OR where(Image = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe"))) OR (where(Image ISTARTSWITH "C:\\Users\\") AND where(Image IENDSWITH "\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe")) OR ((where(Image ICONTAINS "C:\\Program Files\\Windows Defender Advanced Threat Protection\\") OR where(Image ICONTAINS "C:\\Program Files\\Windows Defender\\") OR where(Image ICONTAINS "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\")) AND (where(Image IENDSWITH "\\MsMpEng.exe") OR where(Image IENDSWITH "\\MsSense.exe"))) OR (where(Image ICONTAINS "\\AppData\\Local\\Discord\\") AND where(Image IENDSWITH "\\Discord.exe")) OR ((where(Image ISTARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\")) OR (where(Image IENDSWITH "\\WindowsApps\\MicrosoftEdge.exe")) OR ((where(Image = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe") OR where(Image = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe")))) OR ((where(Image ISTARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\") OR where(Image ISTARTSWITH "C:\\Program Files\\Microsoft\\EdgeCore\\")) AND (where(Image IENDSWITH "\\msedge.exe") OR where(Image IENDSWITH "\\msedgewebview2.exe"))) OR (where(Image = "")) OR ((where(Image ISTARTSWITH "C:\\Program Files\\Falkon\\") OR where(Image ISTARTSWITH "C:\\Program Files (x86)\\Falkon\\")) AND where(Image IENDSWITH "\\falkon.exe")) OR ((where(Image = "C:\\Program Files\\Mozilla Firefox\\firefox.exe") OR where(Image = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe"))) OR (where(Image ISTARTSWITH "C:\\Users\\") AND where(Image IENDSWITH "\\AppData\\Local\\Mozilla Firefox\\firefox.exe")) OR (where(Image ICONTAINS "\\AppData\\Local\\Flock\\") AND where(Image IENDSWITH "\\Flock.exe")) OR ((where(Image = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe") OR where(Image = "C:\\Program Files\\Internet Explorer\\iexplore.exe"))) OR (where(Image ICONTAINS "\\AppData\\Local\\Maxthon\\") AND where(Image IENDSWITH "\\maxthon.exe")) OR (NOT Image=*) OR (where(Image ICONTAINS "\\AppData\\Local\\Programs\\Opera\\") AND where(Image IENDSWITH "\\opera.exe")) OR (where(Image ICONTAINS "\\AppData\\Local\\Phoebe\\") AND where(Image IENDSWITH "\\Phoebe.exe")) OR ((where(Image IENDSWITH "C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe") OR where(Image IENDSWITH "C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe"))) OR ((where(Image ISTARTSWITH "C:\\Program Files (x86)\\QtWeb\\") OR where(Image ISTARTSWITH "C:\\Program Files\\QtWeb\\")) AND where(Image IENDSWITH "\\QtWeb.exe")) OR ((where(Image ICONTAINS "C:\\Program Files (x86)\\Safari\\") OR where(Image ICONTAINS "C:\\Program Files\\Safari\\")) AND where(Image IENDSWITH "\\safari.exe")) OR ((where(Image ISTARTSWITH "C:\\Program Files\\SeaMonkey\\") OR where(Image ISTARTSWITH "C:\\Program Files (x86)\\SeaMonkey\\")) AND where(Image IENDSWITH "\\seamonkey.exe")) OR ((where(Image ISTARTSWITH "C:\\Program Files\\SlimBrowser\\") OR where(Image ISTARTSWITH "C:\\Program Files (x86)\\SlimBrowser\\")) AND where(Image IENDSWITH "\\slimbrowser.exe")) OR (where(Image ICONTAINS "\\AppData\\Local\\Vivaldi\\") AND where(Image IENDSWITH "\\vivaldi.exe")) OR ((where(Image ISTARTSWITH "C:\\Program Files\\Naver\\Naver Whale\\") OR where(Image ISTARTSWITH "C:\\Program Files (x86)\\Naver\\Naver Whale\\")) AND where(Image IENDSWITH "\\whale.exe")) OR ((where(Image ISTARTSWITH "C:\\Program Files\\Waterfox\\") OR where(Image ISTARTSWITH "C:\\Program Files (x86)\\Waterfox\\")) AND where(Image IENDSWITH "\\Waterfox.exe")))))
