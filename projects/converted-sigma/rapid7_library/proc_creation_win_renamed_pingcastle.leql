// Title: Renamed PingCastle Binary Execution
// ID: 2433a154-bb3d-42e4-86c3-a26bdac91c45
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2024-01-11
// Tags: attack.execution, attack.stealth, attack.t1059, attack.t1202
// Description: Detects the execution of a renamed "PingCastle" binary based on the PE metadata fields.
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(OriginalFileName = "PingCastleReporting.exe") OR where(OriginalFileName = "PingCastleCloud.exe") OR where(OriginalFileName = "PingCastle.exe"))) OR ((where(CommandLine ICONTAINS "--scanner aclcheck") OR where(CommandLine ICONTAINS "--scanner antivirus") OR where(CommandLine ICONTAINS "--scanner computerversion") OR where(CommandLine ICONTAINS "--scanner foreignusers") OR where(CommandLine ICONTAINS "--scanner laps_bitlocker") OR where(CommandLine ICONTAINS "--scanner localadmin") OR where(CommandLine ICONTAINS "--scanner nullsession") OR where(CommandLine ICONTAINS "--scanner nullsession-trust") OR where(CommandLine ICONTAINS "--scanner oxidbindings") OR where(CommandLine ICONTAINS "--scanner remote") OR where(CommandLine ICONTAINS "--scanner share") OR where(CommandLine ICONTAINS "--scanner smb") OR where(CommandLine ICONTAINS "--scanner smb3querynetwork") OR where(CommandLine ICONTAINS "--scanner spooler") OR where(CommandLine ICONTAINS "--scanner startup") OR where(CommandLine ICONTAINS "--scanner zerologon"))) OR (where(CommandLine ICONTAINS "--no-enum-limit")) OR ((where(CommandLine ICONTAINS "--healthcheck") AND where(CommandLine ICONTAINS "--level Full"))) OR ((where(CommandLine ICONTAINS "--healthcheck") AND where(CommandLine ICONTAINS "--server ")))) AND NOT (((where(Image IENDSWITH "\\PingCastleReporting.exe") OR where(Image IENDSWITH "\\PingCastleCloud.exe") OR where(Image IENDSWITH "\\PingCastle.exe")))))
