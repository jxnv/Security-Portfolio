// Title: LSASS Access Detected via Attack Surface Reduction
// ID: a0a278fe-2c0e-4de2-ac3c-c68b08a9ba98
// Status: test
// Level: high
// Author: Markus Neis
// Date: 2018-08-26
// Tags: attack.credential-access, attack.t1003.001
// Description: Detects Access to LSASS Process
// Converted by: Sigma Universal SIEM/EDR CLI

((where(EventID = "1121") AND where(Path IENDSWITH "\\lsass.exe")) AND NOT ((((where(ProcessName ISTARTSWITH "C:\\Windows\\System32\\DriverStore\\") OR where(ProcessName ISTARTSWITH "C:\\WINDOWS\\Installer\\") OR where(ProcessName ISTARTSWITH "C:\\Program Files\\") OR where(ProcessName ISTARTSWITH "C:\\Program Files (x86)\\"))) OR ((where(ProcessName = "C:\\Windows\\System32\\atiesrxx.exe") OR where(ProcessName = "C:\\Windows\\System32\\CompatTelRunner.exe") OR where(ProcessName = "C:\\Windows\\System32\\msiexec.exe") OR where(ProcessName = "C:\\Windows\\System32\\nvwmi64.exe") OR where(ProcessName = "C:\\Windows\\System32\\svchost.exe") OR where(ProcessName = "C:\\Windows\\System32\\Taskmgr.exe") OR where(ProcessName = "C:\\Windows\\System32\\wbem\\WmiPrvSE.exe") OR where(ProcessName = "C:\\Windows\\SysWOW64\\msiexec.exe"))) OR (where(ProcessName ISTARTSWITH "C:\\Windows\\Temp\\asgard2-agent\\") AND (where(ProcessName IENDSWITH "\\thor64.exe") OR where(ProcessName IENDSWITH "\\thor.exe"))))))
