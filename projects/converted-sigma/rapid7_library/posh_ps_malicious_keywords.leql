// Title: Malicious PowerShell Keywords
// ID: f62176f3-8128-4faa-bf6c-83261322e5eb
// Status: test
// Level: medium
// Author: Sean Metcalf (source), Florian Roth (Nextron Systems)
// Date: 2017-03-05
// Tags: attack.execution, attack.t1059.001
// Description: Detects keywords from well-known PowerShell exploitation frameworks
// Converted by: Sigma Universal SIEM/EDR CLI

((where(ScriptBlockText ICONTAINS "AdjustTokenPrivileges") OR where(ScriptBlockText ICONTAINS "IMAGE_NT_OPTIONAL_HDR64_MAGIC") OR where(ScriptBlockText ICONTAINS "Metasploit") OR where(ScriptBlockText ICONTAINS "Microsoft.Win32.UnsafeNativeMethods") OR where(ScriptBlockText ICONTAINS "Mimikatz") OR where(ScriptBlockText ICONTAINS "MiniDumpWriteDump") OR where(ScriptBlockText ICONTAINS "PAGE_EXECUTE_READ") OR where(ScriptBlockText ICONTAINS "ReadProcessMemory.Invoke") OR where(ScriptBlockText ICONTAINS "SE_PRIVILEGE_ENABLED") OR where(ScriptBlockText ICONTAINS "SECURITY_DELEGATION") OR where(ScriptBlockText ICONTAINS "TOKEN_ADJUST_PRIVILEGES") OR where(ScriptBlockText ICONTAINS "TOKEN_ALL_ACCESS") OR where(ScriptBlockText ICONTAINS "TOKEN_ASSIGN_PRIMARY") OR where(ScriptBlockText ICONTAINS "TOKEN_DUPLICATE") OR where(ScriptBlockText ICONTAINS "TOKEN_ELEVATION") OR where(ScriptBlockText ICONTAINS "TOKEN_IMPERSONATE") OR where(ScriptBlockText ICONTAINS "TOKEN_INFORMATION_CLASS") OR where(ScriptBlockText ICONTAINS "TOKEN_PRIVILEGES") OR where(ScriptBlockText ICONTAINS "TOKEN_QUERY")))
