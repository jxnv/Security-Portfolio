// Title: Suspicious Execution Of Renamed Sysinternals Tools - Registry
// ID: f50f3c09-557d-492d-81db-9064a8d4e211
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-24
// Tags: attack.resource-development, attack.t1588.002
// Description: Detects the creation of the "accepteula" key related to the Sysinternals tools being created from executables with the wrong name (e.g. a renamed Sysinternals tool)
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(TargetObject ICONTAINS "\\Active Directory Explorer") OR where(TargetObject ICONTAINS "\\Handle") OR where(TargetObject ICONTAINS "\\LiveKd") OR where(TargetObject ICONTAINS "\\ProcDump") OR where(TargetObject ICONTAINS "\\Process Explorer") OR where(TargetObject ICONTAINS "\\PsExec") OR where(TargetObject ICONTAINS "\\PsLoggedon") OR where(TargetObject ICONTAINS "\\PsLoglist") OR where(TargetObject ICONTAINS "\\PsPasswd") OR where(TargetObject ICONTAINS "\\PsPing") OR where(TargetObject ICONTAINS "\\PsService") OR where(TargetObject ICONTAINS "\\SDelete")) AND where(TargetObject IENDSWITH "\\EulaAccepted")) AND NOT (((where(Image IENDSWITH "\\ADExplorer.exe") OR where(Image IENDSWITH "\\ADExplorer64.exe") OR where(Image IENDSWITH "\\ADExplorer64a.exe") OR where(Image IENDSWITH "\\handle.exe") OR where(Image IENDSWITH "\\handle64.exe") OR where(Image IENDSWITH "\\handle64a.exe") OR where(Image IENDSWITH "\\livekd.exe") OR where(Image IENDSWITH "\\livekd64.exe") OR where(Image IENDSWITH "\\procdump.exe") OR where(Image IENDSWITH "\\procdump64.exe") OR where(Image IENDSWITH "\\procdump64a.exe") OR where(Image IENDSWITH "\\procexp.exe") OR where(Image IENDSWITH "\\procexp64.exe") OR where(Image IENDSWITH "\\procexp64a.exe") OR where(Image IENDSWITH "\\PsExec.exe") OR where(Image IENDSWITH "\\PsExec64.exe") OR where(Image IENDSWITH "\\PsExec64a.exe") OR where(Image IENDSWITH "\\PsLoggedon.exe") OR where(Image IENDSWITH "\\PsLoggedon64.exe") OR where(Image IENDSWITH "\\psloglist.exe") OR where(Image IENDSWITH "\\psloglist64.exe") OR where(Image IENDSWITH "\\psloglist64a.exe") OR where(Image IENDSWITH "\\pspasswd.exe") OR where(Image IENDSWITH "\\pspasswd64.exe") OR where(Image IENDSWITH "\\pspasswd64a.exe") OR where(Image IENDSWITH "\\PsPing.exe") OR where(Image IENDSWITH "\\PsPing64.exe") OR where(Image IENDSWITH "\\PsPing64a.exe") OR where(Image IENDSWITH "\\PsService.exe") OR where(Image IENDSWITH "\\PsService64.exe") OR where(Image IENDSWITH "\\PsService64a.exe") OR where(Image IENDSWITH "\\sdelete.exe")))))
