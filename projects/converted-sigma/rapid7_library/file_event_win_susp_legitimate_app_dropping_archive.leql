// Title: Legitimate Application Dropped Archive
// ID: 654fcc6d-840d-4844-9b07-2c3300e54a26
// Status: test
// Level: high
// Author: frack113, Florian Roth
// Date: 2022-08-21
// Tags: attack.stealth, attack.t1218
// Description: Detects programs on a Windows system that should not write an archive to disk
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image IENDSWITH "\\winword.exe") OR where(Image IENDSWITH "\\excel.exe") OR where(Image IENDSWITH "\\powerpnt.exe") OR where(Image IENDSWITH "\\msaccess.exe") OR where(Image IENDSWITH "\\mspub.exe") OR where(Image IENDSWITH "\\eqnedt32.exe") OR where(Image IENDSWITH "\\visio.exe") OR where(Image IENDSWITH "\\wordpad.exe") OR where(Image IENDSWITH "\\wordview.exe") OR where(Image IENDSWITH "\\certutil.exe") OR where(Image IENDSWITH "\\certoc.exe") OR where(Image IENDSWITH "\\CertReq.exe") OR where(Image IENDSWITH "\\Desktopimgdownldr.exe") OR where(Image IENDSWITH "\\esentutl.exe") OR where(Image IENDSWITH "\\finger.exe") OR where(Image IENDSWITH "\\notepad.exe") OR where(Image IENDSWITH "\\AcroRd32.exe") OR where(Image IENDSWITH "\\RdrCEF.exe") OR where(Image IENDSWITH "\\mshta.exe") OR where(Image IENDSWITH "\\hh.exe")) AND (where(TargetFilename IENDSWITH ".zip") OR where(TargetFilename IENDSWITH ".rar") OR where(TargetFilename IENDSWITH ".7z") OR where(TargetFilename IENDSWITH ".diagcab") OR where(TargetFilename IENDSWITH ".appx")))
