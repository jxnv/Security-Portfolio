((((where(Image IENDSWITH "\\tree.com") OR where(Image IENDSWITH "\\WMIC.exe") OR where(Image IENDSWITH "\\doskey.exe") OR where(Image IENDSWITH "\\sc.exe"))) OR ((where(OriginalFileName = "wmic.exe") OR where(OriginalFileName = "DOSKEY.EXE") OR where(OriginalFileName = "sc.exe")))) AND ((where(ParentCommandLine ICONTAINS " > %TEMP%\\") OR where(ParentCommandLine ICONTAINS " > %TMP%\\"))))
