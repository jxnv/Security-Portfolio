(((where(EventID = "4738")) AND NOT ((((where(AllowedToDelegateTo = "") OR where(AllowedToDelegateTo = "-"))) OR (NOT AllowedToDelegateTo=*)))) OR ((where(EventID = "5136") AND where(AttributeLDAPDisplayName = "msDS-AllowedToDelegateTo")) OR (where(EventID = "5136") AND where(ObjectClass = "user") AND where(AttributeLDAPDisplayName = "servicePrincipalName")) OR (where(EventID = "5136") AND where(AttributeLDAPDisplayName = "msDS-AllowedToActOnBehalfOfOtherIdentity"))))
