(((where(ImageLoaded IENDSWITH "\\coreclr.dll") OR where(ImageLoaded IENDSWITH "\\facesdk.dll") OR where(ImageLoaded IENDSWITH "\\HPCustPartUI.dll") OR where(ImageLoaded IENDSWITH "\\libcef.dll") OR where(ImageLoaded IENDSWITH "\\ZIPDLL.dll"))) AND (((where(ImageLoaded ICONTAINS ":\\Perflogs\\") OR where(ImageLoaded ICONTAINS ":\\Users\\Public\\") OR where(ImageLoaded ICONTAINS "\\Temporary Internet") OR where(ImageLoaded ICONTAINS "\\Windows\\Temp\\"))) OR (((where(ImageLoaded ICONTAINS ":\\Users\\") AND where(ImageLoaded ICONTAINS "\\Favorites\\"))) OR ((where(ImageLoaded ICONTAINS ":\\Users\\") AND where(ImageLoaded ICONTAINS "\\Favourites\\"))) OR ((where(ImageLoaded ICONTAINS ":\\Users\\") AND where(ImageLoaded ICONTAINS "\\Contacts\\"))) OR ((where(ImageLoaded ICONTAINS ":\\Users\\") AND where(ImageLoaded ICONTAINS "\\Pictures\\"))))))
