// Title: Regsvr32 Execution From Highly Suspicious Location
// ID: 327ff235-94eb-4f06-b9de-aaee571324be
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-26
// Tags: attack.stealth, attack.t1218.010
// Description: Detects execution of regsvr32 where the DLL is located in a highly suspicious locations
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "\\regsvr32.exe")) OR (where(OriginalFileName = "REGSVR32.EXE"))) AND (((where(CommandLine ICONTAINS ":\\PerfLogs\\") OR where(CommandLine ICONTAINS ":\\Temp\\") OR where(CommandLine ICONTAINS "\\Windows\\Registration\\CRMLog") OR where(CommandLine ICONTAINS "\\Windows\\System32\\com\\dmp\\") OR where(CommandLine ICONTAINS "\\Windows\\System32\\FxsTmp\\") OR where(CommandLine ICONTAINS "\\Windows\\System32\\Microsoft\\Crypto\\RSA\\MachineKeys\\") OR where(CommandLine ICONTAINS "\\Windows\\System32\\spool\\drivers\\color\\") OR where(CommandLine ICONTAINS "\\Windows\\System32\\spool\\PRINTERS\\") OR where(CommandLine ICONTAINS "\\Windows\\System32\\spool\\SERVERS\\") OR where(CommandLine ICONTAINS "\\Windows\\System32\\Tasks_Migrated\\") OR where(CommandLine ICONTAINS "\\Windows\\System32\\Tasks\\Microsoft\\Windows\\SyncCenter\\") OR where(CommandLine ICONTAINS "\\Windows\\SysWOW64\\com\\dmp\\") OR where(CommandLine ICONTAINS "\\Windows\\SysWOW64\\FxsTmp\\") OR where(CommandLine ICONTAINS "\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\PLA\\System\\") OR where(CommandLine ICONTAINS "\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\SyncCenter\\") OR where(CommandLine ICONTAINS "\\Windows\\Tasks\\") OR where(CommandLine ICONTAINS "\\Windows\\Tracing\\"))) OR (((where(CommandLine ICONTAINS " \"C:\\") OR where(CommandLine ICONTAINS " C:\\") OR where(CommandLine ICONTAINS " 'C:\\") OR where(CommandLine ICONTAINS "D:\\"))) AND NOT (((where(CommandLine ICONTAINS "C:\\Program Files (x86)\\") OR where(CommandLine ICONTAINS "C:\\Program Files\\") OR where(CommandLine ICONTAINS "C:\\ProgramData\\") OR where(CommandLine ICONTAINS "C:\\Users\\") OR where(CommandLine ICONTAINS " C:\\Windows\\") OR where(CommandLine ICONTAINS " \"C:\\Windows\\") OR where(CommandLine ICONTAINS " 'C:\\Windows\\")))))) AND NOT (((where(CommandLine = "")) OR (NOT CommandLine=*))))
