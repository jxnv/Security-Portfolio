// Title: Potentially Suspicious ASP.NET Compilation Via AspNetCompiler
// ID: 9f50fe98-fe5c-4a2d-86c7-fad7f63ed622
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-08-14
// Tags: attack.execution, attack.stealth, attack.t1127
// Description: Detects execution of "aspnet_compiler.exe" with potentially suspicious paths for compilation.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image ICONTAINS ":\\Windows\\Microsoft.NET\\Framework\\") OR where(Image ICONTAINS ":\\Windows\\Microsoft.NET\\Framework64\\") OR where(Image ICONTAINS ":\\Windows\\Microsoft.NET\\FrameworkArm\\") OR where(Image ICONTAINS ":\\Windows\\Microsoft.NET\\FrameworkArm64\\")) AND where(Image IENDSWITH "\\aspnet_compiler.exe") AND (where(CommandLine ICONTAINS "\\Users\\Public\\") OR where(CommandLine ICONTAINS "\\AppData\\Local\\Temp\\") OR where(CommandLine ICONTAINS "\\AppData\\Local\\Roaming\\") OR where(CommandLine ICONTAINS ":\\Temp\\") OR where(CommandLine ICONTAINS ":\\Windows\\Temp\\") OR where(CommandLine ICONTAINS ":\\Windows\\System32\\Tasks\\") OR where(CommandLine ICONTAINS ":\\Windows\\Tasks\\")))
