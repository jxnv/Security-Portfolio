// Date: 2022-02-19
// Tags: attack.defense-impairment, attack.t1686.003
// Description: Detects when a rule has been added to the Windows Firewall exception list
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(EventID = "2004") OR where(EventID = "2071") OR where(EventID = "2097"))) AND NOT (((where(Action = "2")) OR ((where(ApplicationPath ICONTAINS "C:\\PerfLogs\\") OR where(ApplicationPath ICONTAINS "C:\\Temp\\") OR where(ApplicationPath ICONTAINS "C:\\Tmp\\") OR where(ApplicationPath ICONTAINS "C:\\Users\\Public\\") OR where(ApplicationPath ICONTAINS "C:\\Windows\\Tasks\\") OR where(ApplicationPath ICONTAINS "C:\\Windows\\Temp\\") OR where(ApplicationPath ICONTAINS "\\AppData\\Local\\Temp\\"))) OR (where(ApplicationPath ISTARTSWITH "C:\\Windows\\ehome\\") AND where(ModifyingApplication = "C:\\Windows\\System32\\oobe\\Setup.exe")) OR ((where(ApplicationPath ISTARTSWITH "C:\\Program Files (x86)\\") OR where(ApplicationPath ISTARTSWITH "C:\\Program Files\\") OR where(ApplicationPath ISTARTSWITH "C:\\Windows\\System32\\") OR where(ApplicationPath ISTARTSWITH "C:\\Windows\\SysWOW64\\") OR where(ApplicationPath ISTARTSWITH "C:\\Windows\\WinSxS\\"))) OR (NOT ApplicationPath=*) OR (where(ApplicationPath = "SYSTEM") AND (where(ModifyingApplication = "C:\\Windows\\System32\\dllhost.exe") OR where(ModifyingApplication = "C:\\Windows\\System32\\oobe\\Setup.exe") OR where(ModifyingApplication = "C:\\Windows\\System32\\svchost.exe"))) OR (where(ModifyingApplication ISTARTSWITH "C:\\Windows\\WinSxS\\") AND where(ModifyingApplication IENDSWITH "\\TiWorker.exe")))) AND NOT (((((where(ModifyingApplication ISTARTSWITH "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\") OR where(ModifyingApplication ISTARTSWITH "C:\\Program Files\\Windows Defender\\")) AND where(ModifyingApplication IENDSWITH "\\MsMpEng.exe")) OR ((where(ApplicationPath ISTARTSWITH "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\") OR where(ApplicationPath ISTARTSWITH "C:\\Program Files\\Windows Defender\\")) AND where(ApplicationPath IENDSWITH "\\MsMpEng.exe"))) OR ((where(ModifyingApplication = "C:\\Windows\\System32\\svchost.exe") OR where(ModifyingApplication = "C:\\Windows\\System32\\dllhost.exe")) AND where(ApplicationPath = "")) OR (where(ApplicationPath ISTARTSWITH "C:\\Windows\\SystemApps\\") AND where(ModifyingApplication = "C:\\Windows\\System32\\svchost.exe")))))
