// Title: Process Creation Using Sysnative Folder
// ID: 3c1b5fb0-c72f-45ba-abd1-4d4c353144ab
// Status: test
// Level: medium
// Author: Max Altgelt (Nextron Systems)
// Date: 2022-08-23
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects process creation events that use the Sysnative folder (common for CobaltStrike spawns)
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS ":\\Windows\\Sysnative\\")) OR (where(Image ICONTAINS ":\\Windows\\Sysnative\\"))) AND NOT (((where(Image ICONTAINS "C:\\Windows\\Microsoft.NET\\Framework64\\v") OR where(Image ICONTAINS "C:\\Windows\\Microsoft.NET\\Framework\\v") OR where(Image ICONTAINS "C:\\Windows\\Microsoft.NET\\FrameworkArm\\v") OR where(Image ICONTAINS "C:\\Windows\\Microsoft.NET\\FrameworkArm64\\v")) AND where(Image IENDSWITH "\\ngen.exe") AND where(CommandLine ICONTAINS "install"))) AND NOT (((where(CommandLine ICONTAINS "\"C:\\Windows\\sysnative\\cmd.exe\"") AND where(CommandLine ICONTAINS "\\xampp\\") AND where(CommandLine ICONTAINS "\\catalina_start.bat")))))
