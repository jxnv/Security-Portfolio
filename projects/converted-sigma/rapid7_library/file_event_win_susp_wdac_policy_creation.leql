// Title: Potentially Suspicious WDAC Policy File Creation
// ID: 1d2de8a6-4803-4fde-b85b-f58f3aa7a705
// Status: experimental
// Level: medium
// Author: X__Junior
// Date: 2025-02-07
// Tags: attack.defense-impairment
// Description: Detects suspicious Windows Defender Application Control (WDAC) policy file creation from abnormal processes that could be abused by attacker to block EDR/AV components while allowing their own malicious code to run on the system.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(TargetFilename ICONTAINS "\\Windows\\System32\\CodeIntegrity\\")) AND NOT (((((where(CommandLine ICONTAINS "ConvertFrom-CIPolicy -XmlFilePath") AND where(CommandLine ICONTAINS "-BinaryFilePath "))) OR (where(CommandLine ICONTAINS "CiTool --update-policy")) OR ((where(CommandLine ICONTAINS "Copy-Item -Path") AND where(CommandLine ICONTAINS "-Destination")))) OR ((where(Image IENDSWITH "\\Microsoft.ConfigurationManagement.exe") OR where(Image IENDSWITH "\\WDAC Wizard.exe") OR where(Image IENDSWITH "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe") OR where(Image IENDSWITH "C:\\Program Files\\PowerShell\\7\\pwsh.exe") OR where(Image IENDSWITH "C:\\Windows\\System32\\dllhost.exe") OR where(Image IENDSWITH "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe") OR where(Image IENDSWITH "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe") OR where(Image IENDSWITH "C:\\Windows\\SysWOW64\\dllhost.exe") OR where(Image IENDSWITH "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe") OR where(Image IENDSWITH "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe"))) OR (where(Image = "System")) OR (where(Image = "C:\\Windows\\System32\\wuauclt.exe")) OR ((where(Image = "C:\\Windows\\UUS\\arm64\\wuaucltcore.exe") OR where(Image = "C:\\Windows\\UUS\\Packages\\Preview\\arm64\\wuaucltcore.exe"))))))
