// Title: Uncommon Connection to Active Directory Web Services
// ID: b3ad3c0f-c949-47a1-a30e-b0491ccae876
// Status: test
// Level: medium
// Author: @kostastsale
// Date: 2024-01-26
// Tags: attack.discovery, attack.t1087
// Description: Detects uncommon network connections to the Active Directory Web Services (ADWS) from processes not typically associated with ADWS management.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Initiated = "True") AND where(DestinationPort = "9389")) AND NOT (((where(Image = "C:\\Windows\\system32\\dsac.exe")) OR (where(Image = "C:\\Program Files\\Microsoft Monitoring Agent\\")) OR ((where(Image ISTARTSWITH "C:\\Program Files\\PowerShell\\7\\pwsh.exe") OR where(Image ISTARTSWITH "C:\\Program Files\\PowerShell\\7-preview\\pwsh.ex") OR where(Image ISTARTSWITH "C:\\Windows\\System32\\WindowsPowerShell\\") OR where(Image ISTARTSWITH "C:\\Windows\\SysWOW64\\WindowsPowerShell\\"))))))
