// Title: Suspicious DNS Query for IP Lookup Service APIs
// ID: ec82e2a5-81ea-4211-a1f8-37a0286df2c2
// Status: test
// Level: medium
// Author: Brandon George (blog post), Thomas Patzke
// Date: 2021-07-08
// Tags: attack.reconnaissance, attack.t1590
// Description: Detects DNS queries for IP lookup services such as "api.ipify.org" originating from a non browser process.
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(QueryName = "www.ip.cn") OR where(QueryName = "l2.io"))) OR ((where(QueryName ICONTAINS "api.2ip.ua") OR where(QueryName ICONTAINS "api.bigdatacloud.net") OR where(QueryName ICONTAINS "api.ipify.org") OR where(QueryName ICONTAINS "bot.whatismyipaddress.com") OR where(QueryName ICONTAINS "canireachthe.net") OR where(QueryName ICONTAINS "checkip.amazonaws.com") OR where(QueryName ICONTAINS "checkip.dyndns.org") OR where(QueryName ICONTAINS "curlmyip.com") OR where(QueryName ICONTAINS "db-ip.com") OR where(QueryName ICONTAINS "edns.ip-api.com") OR where(QueryName ICONTAINS "eth0.me") OR where(QueryName ICONTAINS "freegeoip.app") OR where(QueryName ICONTAINS "geoipy.com") OR where(QueryName ICONTAINS "getip.pro") OR where(QueryName ICONTAINS "icanhazip.com") OR where(QueryName ICONTAINS "ident.me") OR where(QueryName ICONTAINS "ifconfig.io") OR where(QueryName ICONTAINS "ifconfig.me") OR where(QueryName ICONTAINS "ip-api.com") OR where(QueryName ICONTAINS "ip.360.cn") OR where(QueryName ICONTAINS "ip.anysrc.net") OR where(QueryName ICONTAINS "ip.taobao.com") OR where(QueryName ICONTAINS "ip.tyk.nu") OR where(QueryName ICONTAINS "ipaddressworld.com") OR where(QueryName ICONTAINS "ipapi.co") OR where(QueryName ICONTAINS "ipconfig.io") OR where(QueryName ICONTAINS "ipecho.net") OR where(QueryName ICONTAINS "ipinfo.io") OR where(QueryName ICONTAINS "ipip.net") OR where(QueryName ICONTAINS "ipof.in") OR where(QueryName ICONTAINS "ipv4.icanhazip.com") OR where(QueryName ICONTAINS "ipv4bot.whatismyipaddress.com") OR where(QueryName ICONTAINS "ipv6-test.com") OR where(QueryName ICONTAINS "ipwho.is") OR where(QueryName ICONTAINS "jsonip.com") OR where(QueryName ICONTAINS "myexternalip.com") OR where(QueryName ICONTAINS "seeip.org") OR where(QueryName ICONTAINS "wgetip.com") OR where(QueryName ICONTAINS "whatismyip.akamai.com") OR where(QueryName ICONTAINS "whois.pconline.com.cn") OR where(QueryName ICONTAINS "wtfismyip.com")))) AND NOT (((where(Image IENDSWITH "\\brave.exe")) OR ((where(Image = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe") OR where(Image = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe"))) OR ((where(Image ISTARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\")) OR (where(Image IENDSWITH "\\WindowsApps\\MicrosoftEdge.exe")) OR ((where(Image = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe") OR where(Image = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe")))) OR ((where(Image ISTARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\") OR where(Image ISTARTSWITH "C:\\Program Files\\Microsoft\\EdgeCore\\")) AND (where(Image IENDSWITH "\\msedge.exe") OR where(Image IENDSWITH "\\msedgewebview2.exe"))) OR ((where(Image = "C:\\Program Files\\Mozilla Firefox\\firefox.exe") OR where(Image = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe"))) OR ((where(Image = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe") OR where(Image = "C:\\Program Files\\Internet Explorer\\iexplore.exe"))) OR (where(Image IENDSWITH "\\maxthon.exe")) OR (where(Image IENDSWITH "\\opera.exe")) OR (where(Image IENDSWITH "\\safari.exe")) OR (where(Image IENDSWITH "\\seamonkey.exe")) OR (where(Image IENDSWITH "\\vivaldi.exe")) OR (where(Image IENDSWITH "\\whale.exe")))))
