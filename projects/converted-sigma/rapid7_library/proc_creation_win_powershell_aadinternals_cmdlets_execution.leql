// Title: AADInternals PowerShell Cmdlets Execution - ProccessCreation
// ID: c86500e9-a645-4680-98d7-f882c70c1ea3
// Status: test
// Level: high
// Author: Austin Songer (@austinsonger), Nasreddine Bencherchali (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2022-12-23
// Tags: attack.execution, attack.reconnaissance, attack.discovery, attack.credential-access, attack.impact
// Description: Detects ADDInternals Cmdlet execution. A tool for administering Azure AD and Office 365. Which can be abused by threat actors to attack Azure AD or Office 365.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "Add-AADInt") OR where(CommandLine ICONTAINS "ConvertTo-AADInt") OR where(CommandLine ICONTAINS "Disable-AADInt") OR where(CommandLine ICONTAINS "Enable-AADInt") OR where(CommandLine ICONTAINS "Export-AADInt") OR where(CommandLine ICONTAINS "Find-AADInt") OR where(CommandLine ICONTAINS "Get-AADInt") OR where(CommandLine ICONTAINS "Grant-AADInt") OR where(CommandLine ICONTAINS "Initialize-AADInt") OR where(CommandLine ICONTAINS "Install-AADInt") OR where(CommandLine ICONTAINS "Invoke-AADInt") OR where(CommandLine ICONTAINS "Join-AADInt") OR where(CommandLine ICONTAINS "New-AADInt") OR where(CommandLine ICONTAINS "Open-AADInt") OR where(CommandLine ICONTAINS "Read-AADInt") OR where(CommandLine ICONTAINS "Register-AADInt") OR where(CommandLine ICONTAINS "Remove-AADInt") OR where(CommandLine ICONTAINS "Reset-AADInt") OR where(CommandLine ICONTAINS "Resolve-AADInt") OR where(CommandLine ICONTAINS "Restore-AADInt") OR where(CommandLine ICONTAINS "Save-AADInt") OR where(CommandLine ICONTAINS "Search-AADInt") OR where(CommandLine ICONTAINS "Send-AADInt") OR where(CommandLine ICONTAINS "Set-AADInt") OR where(CommandLine ICONTAINS "Start-AADInt") OR where(CommandLine ICONTAINS "Unprotect-AADInt") OR where(CommandLine ICONTAINS "Update-AADInt"))) AND (((where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\powershell_ise.exe") OR where(Image IENDSWITH "\\pwsh.exe"))) OR ((where(OriginalFileName = "PowerShell.Exe") OR where(OriginalFileName = "pwsh.dll")))))
