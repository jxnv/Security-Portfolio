// Title: PUA - AdvancedRun Suspicious Execution
// ID: fa00b701-44c6-4679-994d-5a18afa8a707
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-01-20
// Tags: attack.privilege-escalation, attack.stealth, attack.t1134.002
// Description: Detects the execution of AdvancedRun utility in the context of the TrustedInstaller, SYSTEM, Local Service or Network Service accounts
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "/EXEFilename") OR where(CommandLine ICONTAINS "/CommandLine"))) AND (((where(CommandLine ICONTAINS " /RunAs 8 ") OR where(CommandLine ICONTAINS " /RunAs 4 ") OR where(CommandLine ICONTAINS " /RunAs 10 ") OR where(CommandLine ICONTAINS " /RunAs 11 "))) OR ((where(CommandLine IENDSWITH "/RunAs 8") OR where(CommandLine IENDSWITH "/RunAs 4") OR where(CommandLine IENDSWITH "/RunAs 10") OR where(CommandLine IENDSWITH "/RunAs 11")))))
