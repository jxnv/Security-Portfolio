// Title: NetNTLM Downgrade Attack
// ID: d3abac66-f11c-4ed0-8acb-50cc29c97eed
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), wagga
// Date: 2018-03-20
// Tags: attack.persistence, attack.defense-impairment, attack.t1685, attack.t1112
// Description: Detects NetNTLM downgrade attack
// Converted by: Sigma Universal SIEM/EDR CLI

(where(EventID = "4657") AND (where(ObjectName ICONTAINS "\\REGISTRY\\MACHINE\\SYSTEM") AND where(ObjectName ICONTAINS "ControlSet") AND where(ObjectName ICONTAINS "\\Control\\Lsa")) AND (where(ObjectValueName = "LmCompatibilityLevel") OR where(ObjectValueName = "NtlmMinClientSec") OR where(ObjectValueName = "RestrictSendingNTLMTraffic")))
