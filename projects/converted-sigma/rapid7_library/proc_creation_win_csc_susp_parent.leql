// Title: Csc.EXE Execution Form Potentially Suspicious Parent
// ID: b730a276-6b63-41b8-bcf8-55930c8fc6ee
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2019-02-11
// Tags: attack.execution, attack.stealth, attack.t1059.005, attack.t1059.007, attack.t1218.005, attack.t1027.004
// Description: Detects a potentially suspicious parent of "csc.exe", which could be a sign of payload delivery.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "\\csc.exe")) OR (where(OriginalFileName = "csc.exe"))) AND (((where(ParentImage IENDSWITH "\\cscript.exe") OR where(ParentImage IENDSWITH "\\excel.exe") OR where(ParentImage IENDSWITH "\\mshta.exe") OR where(ParentImage IENDSWITH "\\onenote.exe") OR where(ParentImage IENDSWITH "\\outlook.exe") OR where(ParentImage IENDSWITH "\\powerpnt.exe") OR where(ParentImage IENDSWITH "\\winword.exe") OR where(ParentImage IENDSWITH "\\wscript.exe"))) OR ((where(ParentImage IENDSWITH "\\powershell.exe") OR where(ParentImage IENDSWITH "\\pwsh.exe")) AND (where(ParentCommandLine ICONTAINS "-Encoded ") OR where(ParentCommandLine ICONTAINS "FromBase64String"))) OR ((where(ParentCommandLine /(?:[Pp]rogram[Dd]ata|%(?:[Ll]ocal)?[Aa]pp[Dd]ata%|\\[Aa]pp[Dd]ata\\(?:[Ll]ocal(?:[Ll]ow)?|[Rr]oaming))\\[^\\]{1,256}$/)) OR ((where(ParentCommandLine ICONTAINS ":\\PerfLogs\\") OR where(ParentCommandLine ICONTAINS ":\\Users\\Public\\") OR where(ParentCommandLine ICONTAINS ":\\Windows\\Temp\\") OR where(ParentCommandLine ICONTAINS "\\Temporary Internet"))) OR ((where(ParentCommandLine ICONTAINS ":\\Users\\") AND where(ParentCommandLine ICONTAINS "\\Favorites\\"))) OR ((where(ParentCommandLine ICONTAINS ":\\Users\\") AND where(ParentCommandLine ICONTAINS "\\Favourites\\"))) OR ((where(ParentCommandLine ICONTAINS ":\\Users\\") AND where(ParentCommandLine ICONTAINS "\\Contacts\\"))) OR ((where(ParentCommandLine ICONTAINS ":\\Users\\") AND where(ParentCommandLine ICONTAINS "\\Pictures\\"))))) AND NOT ((((where(ParentImage ISTARTSWITH "C:\\Program Files (x86)\\") OR where(ParentImage ISTARTSWITH "C:\\Program Files\\"))) OR (where(ParentImage = "C:\\Windows\\System32\\sdiagnhost.exe")) OR (where(ParentImage = "C:\\Windows\\System32\\inetsrv\\w3wp.exe")))) AND NOT ((((where(ParentCommandLine ICONTAINS "JwB7ACIAZgBhAGkAbABlAGQAIgA6AHQAcgB1AGUALAAiAG0AcwBnACIAOgAiAEEAbgBzAGkAYgBsAGUAIAByAGUAcQB1AGkAcgBlAHMAIABQAG8AdwBlAHIAUwBoAGUAbABsACAAdgAzAC4AMAAgAG8AcgAgAG4AZQB3AGUAcgAiAH0AJw") OR where(ParentCommandLine ICONTAINS "cAewAiAGYAYQBpAGwAZQBkACIAOgB0AHIAdQBlACwAIgBtAHMAZwAiADoAIgBBAG4AcwBpAGIAbABlACAAcgBlAHEAdQBpAHIAZQBzACAAUABvAHcAZQByAFMAaABlAGwAbAAgAHYAMwAuADAAIABvAHIAIABuAGUAdwBlAHIAIgB9ACcA") OR where(ParentCommandLine ICONTAINS "nAHsAIgBmAGEAaQBsAGUAZAAiADoAdAByAHUAZQAsACIAbQBzAGcAIgA6ACIAQQBuAHMAaQBiAGwAZQAgAHIAZQBxAHUAaQByAGUAcwAgAFAAbwB3AGUAcgBTAGgAZQBsAGwAIAB2ADMALgAwACAAbwByACAAbgBlAHcAZQByACIAfQAnA"))) OR (where(ParentImage = "C:\\ProgramData\\chocolatey\\choco.exe")) OR (where(ParentCommandLine ICONTAINS "\\ProgramData\\Microsoft\\Windows Defender Advanced Threat Protection")))))
