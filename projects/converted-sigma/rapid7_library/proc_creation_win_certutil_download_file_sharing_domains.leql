// Title: Suspicious File Downloaded From File-Sharing Website Via Certutil.EXE
// ID: 42a5f1e7-9603-4f6d-97ae-3f37d130d794
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-15
// Tags: attack.stealth, attack.t1027, attack.command-and-control, attack.t1105
// Description: Detects the execution of certutil with certain flags that allow the utility to download files from file-sharing websites.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "urlcache ") OR where(CommandLine ICONTAINS "verifyctl ") OR where(CommandLine ICONTAINS "URL "))) AND ((where(CommandLine ICONTAINS ".githubusercontent.com") OR where(CommandLine ICONTAINS "0x0.st") OR where(CommandLine ICONTAINS "anonfiles.com") OR where(CommandLine ICONTAINS "bashupload.com") OR where(CommandLine ICONTAINS "cdn.discordapp.com") OR where(CommandLine ICONTAINS "chunk.io") OR where(CommandLine ICONTAINS "ddns.net") OR where(CommandLine ICONTAINS "dl.dropboxusercontent.com") OR where(CommandLine ICONTAINS "ghostbin.co") OR where(CommandLine ICONTAINS "github.com") OR where(CommandLine ICONTAINS "glitch.me") OR where(CommandLine ICONTAINS "gofile.io") OR where(CommandLine ICONTAINS "hastebin.com") OR where(CommandLine ICONTAINS "mediafire.com") OR where(CommandLine ICONTAINS "mega.nz") OR where(CommandLine ICONTAINS "onrender.com") OR where(CommandLine ICONTAINS "pages.dev") OR where(CommandLine ICONTAINS "paste.ee") OR where(CommandLine ICONTAINS "pastebin.com") OR where(CommandLine ICONTAINS "pastebin.pl") OR where(CommandLine ICONTAINS "pastetext.net") OR where(CommandLine ICONTAINS "privatlab.com") OR where(CommandLine ICONTAINS "privatlab.net") OR where(CommandLine ICONTAINS "send.exploit.in") OR where(CommandLine ICONTAINS "sendspace.com") OR where(CommandLine ICONTAINS "storage.googleapis.com") OR where(CommandLine ICONTAINS "storjshare.io") OR where(CommandLine ICONTAINS "supabase.co") OR where(CommandLine ICONTAINS "temp.sh") OR where(CommandLine ICONTAINS "transfer.sh") OR where(CommandLine ICONTAINS "trycloudflare.com") OR where(CommandLine ICONTAINS "ufile.io") OR where(CommandLine ICONTAINS "w3spaces.com") OR where(CommandLine ICONTAINS "workers.dev") OR where(CommandLine ICONTAINS "x0.at"))) AND ((where(Image IENDSWITH "\\certutil.exe")) OR (where(OriginalFileName = "CertUtil.exe"))))
