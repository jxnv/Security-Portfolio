// Title: PowerShell Script With File Upload Capabilities
// ID: d2e3f2f6-7e09-4bf2-bc5d-90186809e7fb
// Status: test
// Level: low
// Author: frack113
// Date: 2022-01-07
// Tags: attack.exfiltration, attack.t1020
// Description: Detects PowerShell scripts leveraging the "Invoke-WebRequest" cmdlet to send data via either "PUT" or "POST" method.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(ScriptBlockText ICONTAINS "Invoke-RestMethod") OR where(ScriptBlockText ICONTAINS "Invoke-WebRequest") OR where(ScriptBlockText ICONTAINS "irm ") OR where(ScriptBlockText ICONTAINS "iwr "))) AND ((where(ScriptBlockText ICONTAINS "-Method \"POST\"") OR where(ScriptBlockText ICONTAINS "-Method \"PUT\"") OR where(ScriptBlockText ICONTAINS "-Method POST") OR where(ScriptBlockText ICONTAINS "-Method PUT") OR where(ScriptBlockText ICONTAINS "-Method 'POST'") OR where(ScriptBlockText ICONTAINS "-Method 'PUT'"))))
