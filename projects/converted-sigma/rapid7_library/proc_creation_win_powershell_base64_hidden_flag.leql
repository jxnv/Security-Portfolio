// Title: Malicious Base64 Encoded PowerShell Keywords in Command Lines
// ID: f26c6093-6f14-4b12-800f-0fcb46f5ffd0
// Status: test
// Level: high
// Author: John Lambert (rule)
// Date: 2019-01-16
// Tags: attack.execution, attack.t1059.001
// Description: Detects base64 encoded strings used in hidden malicious PowerShell command lines
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS "AGkAdABzAGEAZABtAGkAbgAgAC8AdAByAGEAbgBzAGYAZQByA") OR where(CommandLine ICONTAINS "aXRzYWRtaW4gL3RyYW5zZmVy") OR where(CommandLine ICONTAINS "IAaQB0AHMAYQBkAG0AaQBuACAALwB0AHIAYQBuAHMAZgBlAHIA") OR where(CommandLine ICONTAINS "JpdHNhZG1pbiAvdHJhbnNmZX") OR where(CommandLine ICONTAINS "YgBpAHQAcwBhAGQAbQBpAG4AIAAvAHQAcgBhAG4AcwBmAGUAcg") OR where(CommandLine ICONTAINS "Yml0c2FkbWluIC90cmFuc2Zlc") OR where(CommandLine ICONTAINS "AGMAaAB1AG4AawBfAHMAaQB6AGUA") OR where(CommandLine ICONTAINS "JABjAGgAdQBuAGsAXwBzAGkAegBlA") OR where(CommandLine ICONTAINS "JGNodW5rX3Npem") OR where(CommandLine ICONTAINS "QAYwBoAHUAbgBrAF8AcwBpAHoAZQ") OR where(CommandLine ICONTAINS "RjaHVua19zaXpl") OR where(CommandLine ICONTAINS "Y2h1bmtfc2l6Z") OR where(CommandLine ICONTAINS "AE8ALgBDAG8AbQBwAHIAZQBzAHMAaQBvAG4A") OR where(CommandLine ICONTAINS "kATwAuAEMAbwBtAHAAcgBlAHMAcwBpAG8Abg") OR where(CommandLine ICONTAINS "lPLkNvbXByZXNzaW9u") OR where(CommandLine ICONTAINS "SQBPAC4AQwBvAG0AcAByAGUAcwBzAGkAbwBuA") OR where(CommandLine ICONTAINS "SU8uQ29tcHJlc3Npb2") OR where(CommandLine ICONTAINS "Ty5Db21wcmVzc2lvb") OR where(CommandLine ICONTAINS "AE8ALgBNAGUAbQBvAHIAeQBTAHQAcgBlAGEAbQ") OR where(CommandLine ICONTAINS "kATwAuAE0AZQBtAG8AcgB5AFMAdAByAGUAYQBtA") OR where(CommandLine ICONTAINS "lPLk1lbW9yeVN0cmVhb") OR where(CommandLine ICONTAINS "SQBPAC4ATQBlAG0AbwByAHkAUwB0AHIAZQBhAG0A") OR where(CommandLine ICONTAINS "SU8uTWVtb3J5U3RyZWFt") OR where(CommandLine ICONTAINS "Ty5NZW1vcnlTdHJlYW") OR where(CommandLine ICONTAINS "4ARwBlAHQAQwBoAHUAbgBrA") OR where(CommandLine ICONTAINS "5HZXRDaHVua") OR where(CommandLine ICONTAINS "AEcAZQB0AEMAaAB1AG4Aaw") OR where(CommandLine ICONTAINS "LgBHAGUAdABDAGgAdQBuAGsA") OR where(CommandLine ICONTAINS "LkdldENodW5r") OR where(CommandLine ICONTAINS "R2V0Q2h1bm") OR where(CommandLine ICONTAINS "AEgAUgBFAEEARABfAEkATgBGAE8ANgA0A") OR where(CommandLine ICONTAINS "QASABSAEUAQQBEAF8ASQBOAEYATwA2ADQA") OR where(CommandLine ICONTAINS "RIUkVBRF9JTkZPNj") OR where(CommandLine ICONTAINS "SFJFQURfSU5GTzY0") OR where(CommandLine ICONTAINS "VABIAFIARQBBAEQAXwBJAE4ARgBPADYANA") OR where(CommandLine ICONTAINS "VEhSRUFEX0lORk82N") OR where(CommandLine ICONTAINS "AHIAZQBhAHQAZQBSAGUAbQBvAHQAZQBUAGgAcgBlAGEAZA") OR where(CommandLine ICONTAINS "cmVhdGVSZW1vdGVUaHJlYW") OR where(CommandLine ICONTAINS "MAcgBlAGEAdABlAFIAZQBtAG8AdABlAFQAaAByAGUAYQBkA") OR where(CommandLine ICONTAINS "NyZWF0ZVJlbW90ZVRocmVhZ") OR where(CommandLine ICONTAINS "Q3JlYXRlUmVtb3RlVGhyZWFk") OR where(CommandLine ICONTAINS "QwByAGUAYQB0AGUAUgBlAG0AbwB0AGUAVABoAHIAZQBhAGQA") OR where(CommandLine ICONTAINS "0AZQBtAG0AbwB2AGUA") OR where(CommandLine ICONTAINS "1lbW1vdm") OR where(CommandLine ICONTAINS "AGUAbQBtAG8AdgBlA") OR where(CommandLine ICONTAINS "bQBlAG0AbQBvAHYAZQ") OR where(CommandLine ICONTAINS "bWVtbW92Z") OR where(CommandLine ICONTAINS "ZW1tb3Zl"))) AND (where(CommandLine ICONTAINS " hidden ")) AND (((where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe"))) OR ((where(OriginalFileName = "PowerShell.EXE") OR where(OriginalFileName = "pwsh.dll")))))
