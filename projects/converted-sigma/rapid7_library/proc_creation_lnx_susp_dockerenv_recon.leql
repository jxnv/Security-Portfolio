// Title: Docker Container Discovery Via Dockerenv Listing
// ID: 11701de9-d5a5-44aa-8238-84252f131895
// Status: test
// Level: low
// Author: Seth Hanford
// Date: 2023-08-23
// Tags: attack.discovery, attack.t1082
// Description: Detects listing or file reading of ".dockerenv" which can be a sing of potential container discovery
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image IENDSWITH "/cat") OR where(Image IENDSWITH "/dir") OR where(Image IENDSWITH "/find") OR where(Image IENDSWITH "/ls") OR where(Image IENDSWITH "/stat") OR where(Image IENDSWITH "/test") OR where(Image IENDSWITH "grep")) AND where(CommandLine IENDSWITH ".dockerenv"))
