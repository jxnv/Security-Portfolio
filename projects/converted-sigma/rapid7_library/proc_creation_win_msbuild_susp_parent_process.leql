// Title: Suspicious Msbuild Execution By Uncommon Parent Process
// ID: 33be4333-2c6b-44f4-ae28-102cdbde0a31
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-11-17
// Tags: attack.stealth
// Description: Detects suspicious execution of 'Msbuild.exe' by a uncommon parent process
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "\\MSBuild.exe")) OR (where(OriginalFileName = "MSBuild.exe"))) AND NOT (((where(ParentImage IENDSWITH "\\devenv.exe") OR where(ParentImage IENDSWITH "\\cmd.exe") OR where(ParentImage IENDSWITH "\\msbuild.exe") OR where(ParentImage IENDSWITH "\\python.exe") OR where(ParentImage IENDSWITH "\\explorer.exe") OR where(ParentImage IENDSWITH "\\nuget.exe")))))
