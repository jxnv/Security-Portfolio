// Title: Suspicious Installer Package Child Process
// ID: e0cfaecd-602d-41af-988d-f6ccebb2af26
// Status: test
// Level: medium
// Author: Sohan G (D4rkCiph3r)
// Date: 2023-02-18
// Tags: attack.t1059, attack.t1059.007, attack.t1071, attack.t1071.001, attack.execution, attack.command-and-control
// Description: Detects the execution of suspicious child processes from macOS installer package parent process. This includes osascript, JXA, curl and wget amongst other interpreters
// Converted by: Sigma Universal SIEM/EDR CLI

((where(ParentImage IENDSWITH "/package_script_service") OR where(ParentImage IENDSWITH "/installer")) AND (where(Image IENDSWITH "/sh") OR where(Image IENDSWITH "/bash") OR where(Image IENDSWITH "/dash") OR where(Image IENDSWITH "/python") OR where(Image IENDSWITH "/ruby") OR where(Image IENDSWITH "/perl") OR where(Image IENDSWITH "/php") OR where(Image IENDSWITH "/javascript") OR where(Image IENDSWITH "/osascript") OR where(Image IENDSWITH "/tclsh") OR where(Image IENDSWITH "/curl") OR where(Image IENDSWITH "/wget")) AND (where(CommandLine ICONTAINS "preinstall") OR where(CommandLine ICONTAINS "postinstall")))
