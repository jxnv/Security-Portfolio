// Title: ServiceDll Hijack
// ID: 612e47e9-8a59-43a6-b404-f48683f45bd6
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-02-04
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects changes to the "ServiceDLL" value related to a service in the registry.
// This is often used as a method of persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(TargetObject ICONTAINS "\\System\\") AND where(TargetObject ICONTAINS "ControlSet") AND where(TargetObject ICONTAINS "\\Services\\")) AND where(TargetObject IENDSWITH "\\Parameters\\ServiceDll")) AND NOT (((where(Image = "C:\\Windows\\system32\\lsass.exe") AND where(TargetObject IENDSWITH "\\Services\\NTDS\\Parameters\\ServiceDll") AND where(Details = "%%systemroot%%\\system32\\ntdsa.dll")) OR (where(Image = "C:\\Windows\\System32\\poqexec.exe")) OR (where(Details = "C:\\Windows\\system32\\spool\\drivers\\x64\\3\\PrintConfig.dll")) OR (where(Image IENDSWITH "\\regsvr32.exe") AND where(TargetObject IENDSWITH "\\Services\\PrintNotify\\Parameters\\ServiceDll") AND where(Details ISTARTSWITH "C:\\WINDOWS\\System32\\DriverStore\\FileRepository\\") AND where(Details IENDSWITH "\\arm64\\PrintConfig.dll")))) AND NOT ((where(Image IENDSWITH "\\regsvr32.exe") AND where(Details = "C:\\Windows\\System32\\STAgent.dll"))))
