// Title: Suspicious Wordpad Outbound Connections
// ID: 786cdae8-fefb-4eb2-9227-04e34060db01
// Status: test
// Level: medium
// Author: X__Junior (Nextron Systems)
// Date: 2023-07-12
// Tags: attack.command-and-control, attack.stealth
// Description: Detects a network connection initiated by "wordpad.exe" over uncommon destination ports.
// This might indicate potential process injection activity from a beacon or similar mechanisms.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Initiated = "true") AND where(Image IENDSWITH "\\wordpad.exe")) AND NOT (((where(DestinationPort = "80") OR where(DestinationPort = "139") OR where(DestinationPort = "443") OR where(DestinationPort = "445") OR where(DestinationPort = "465") OR where(DestinationPort = "587") OR where(DestinationPort = "993") OR where(DestinationPort = "995")))))
