// Title: Potential Initial Access via DLL Search Order Hijacking
// ID: dbbd9f66-2ed3-4ca2-98a4-6ea985dd1a1c
// Status: test
// Level: medium
// Author: Tim Rauch (rule), Elastic (idea)
// Date: 2022-10-21
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.stealth, attack.t1566, attack.t1566.001, attack.initial-access, attack.t1574, attack.t1574.001
// Description: Detects attempts to create a DLL file to a known desktop application dependencies folder such as Slack, Teams or OneDrive and by an unusual process. This may indicate an attempt to load a malicious module via DLL search order hijacking.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "\\winword.exe") OR where(Image IENDSWITH "\\excel.exe") OR where(Image IENDSWITH "\\powerpnt.exe") OR where(Image IENDSWITH "\\MSACCESS.EXE") OR where(Image IENDSWITH "\\MSPUB.EXE") OR where(Image IENDSWITH "\\fltldr.exe") OR where(Image IENDSWITH "\\cmd.exe") OR where(Image IENDSWITH "\\certutil.exe") OR where(Image IENDSWITH "\\mshta.exe") OR where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\wscript.exe") OR where(Image IENDSWITH "\\curl.exe") OR where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe")) AND where(TargetFilename IENDSWITH ".dll") AND (where(TargetFilename ICONTAINS "\\Users\\") AND where(TargetFilename ICONTAINS "\\AppData\\")) AND (where(TargetFilename ICONTAINS "\\Microsoft\\OneDrive\\") OR where(TargetFilename ICONTAINS "\\Microsoft OneDrive\\") OR where(TargetFilename ICONTAINS "\\Microsoft\\Teams\\") OR where(TargetFilename ICONTAINS "\\Local\\slack\\app-") OR where(TargetFilename ICONTAINS "\\Local\\Programs\\Microsoft VS Code\\"))) AND NOT ((where(Image IENDSWITH "\\cmd.exe") AND (where(TargetFilename ICONTAINS "\\Users\\") AND where(TargetFilename ICONTAINS "\\AppData\\") AND where(TargetFilename ICONTAINS "\\Microsoft\\OneDrive\\") AND where(TargetFilename ICONTAINS "\\api-ms-win-core-")))))
