// Title: Potentially Suspicious File Download From File Sharing Domain Via PowerShell.EXE
// ID: b6e04788-29e1-4557-bb14-77f761848ab8
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-02-23
// Tags: attack.execution
// Description: Detects potentially suspicious file downloads from file sharing domains using PowerShell.exe
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS ".DownloadString(") OR where(CommandLine ICONTAINS ".DownloadFile(") OR where(CommandLine ICONTAINS "Invoke-WebRequest ") OR where(CommandLine ICONTAINS "iwr ") OR where(CommandLine ICONTAINS "wget "))) AND (((where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe"))) OR ((where(OriginalFileName = "PowerShell.EXE") OR where(OriginalFileName = "pwsh.dll")))) AND ((where(CommandLine ICONTAINS "0x0.st") OR where(CommandLine ICONTAINS "anonfiles.com") OR where(CommandLine ICONTAINS "bashupload.com") OR where(CommandLine ICONTAINS "cdn.discordapp.com") OR where(CommandLine ICONTAINS "chunk.io") OR where(CommandLine ICONTAINS "ddns.net") OR where(CommandLine ICONTAINS "dl.dropboxusercontent.com") OR where(CommandLine ICONTAINS "ghostbin.co") OR where(CommandLine ICONTAINS "glitch.me") OR where(CommandLine ICONTAINS "gofile.io") OR where(CommandLine ICONTAINS "hastebin.com") OR where(CommandLine ICONTAINS "mediafire.com") OR where(CommandLine ICONTAINS "mega.nz") OR where(CommandLine ICONTAINS "onrender.com") OR where(CommandLine ICONTAINS "pages.dev") OR where(CommandLine ICONTAINS "paste.ee") OR where(CommandLine ICONTAINS "pastebin.com") OR where(CommandLine ICONTAINS "pastebin.pl") OR where(CommandLine ICONTAINS "pastetext.net") OR where(CommandLine ICONTAINS "pixeldrain.com") OR where(CommandLine ICONTAINS "privatlab.com") OR where(CommandLine ICONTAINS "privatlab.net") OR where(CommandLine ICONTAINS "send.exploit.in") OR where(CommandLine ICONTAINS "sendspace.com") OR where(CommandLine ICONTAINS "storage.googleapis.com") OR where(CommandLine ICONTAINS "storjshare.io") OR where(CommandLine ICONTAINS "supabase.co") OR where(CommandLine ICONTAINS "temp.sh") OR where(CommandLine ICONTAINS "transfer.sh") OR where(CommandLine ICONTAINS "trycloudflare.com") OR where(CommandLine ICONTAINS "ufile.io") OR where(CommandLine ICONTAINS "w3spaces.com") OR where(CommandLine ICONTAINS "workers.dev") OR where(CommandLine ICONTAINS "x0.at"))))
