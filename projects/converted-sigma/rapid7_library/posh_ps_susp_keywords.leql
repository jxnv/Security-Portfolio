// Title: Potential Suspicious PowerShell Keywords
// ID: 1f49f2ab-26bc-48b3-96cc-dcffbc93eadf
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), Perez Diego (@darkquassar), Tuan Le (NCSGroup)
// Date: 2019-02-11
// Tags: attack.execution, attack.t1059.001
// Description: Detects potentially suspicious keywords that could indicate the use of a PowerShell exploitation framework
// Converted by: Sigma Universal SIEM/EDR CLI

((where(ScriptBlockText ICONTAINS "System.Reflection.Assembly.Load($") OR where(ScriptBlockText ICONTAINS "[System.Reflection.Assembly]::Load($") OR where(ScriptBlockText ICONTAINS "[Reflection.Assembly]::Load($") OR where(ScriptBlockText ICONTAINS "System.Reflection.AssemblyName") OR where(ScriptBlockText ICONTAINS "Reflection.Emit.AssemblyBuilderAccess") OR where(ScriptBlockText ICONTAINS "Reflection.Emit.CustomAttributeBuilder") OR where(ScriptBlockText ICONTAINS "Runtime.InteropServices.UnmanagedType") OR where(ScriptBlockText ICONTAINS "Runtime.InteropServices.DllImportAttribute") OR where(ScriptBlockText ICONTAINS "SuspendThread") OR where(ScriptBlockText ICONTAINS "rundll32")))
