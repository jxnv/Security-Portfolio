((where(CommandLine ICONTAINS "https://github.com/carlospolop/PEASS-ng/releases/latest/download/")) OR ((where(CommandLine ICONTAINS " applicationsinfo") OR where(CommandLine ICONTAINS " browserinfo") OR where(CommandLine ICONTAINS " eventsinfo") OR where(CommandLine ICONTAINS " fileanalysis") OR where(CommandLine ICONTAINS " filesinfo") OR where(CommandLine ICONTAINS " processinfo") OR where(CommandLine ICONTAINS " servicesinfo") OR where(CommandLine ICONTAINS " windowscreds"))) OR ((where(ParentCommandLine IENDSWITH " -linpeas")) OR (where(CommandLine IENDSWITH " -linpeas"))) OR ((where(OriginalFileName = "winPEAS.exe")) OR ((where(Image IENDSWITH "\\winPEASany_ofs.exe") OR where(Image IENDSWITH "\\winPEASany.exe") OR where(Image IENDSWITH "\\winPEASx64_ofs.exe") OR where(Image IENDSWITH "\\winPEASx64.exe") OR where(Image IENDSWITH "\\winPEASx86_ofs.exe") OR where(Image IENDSWITH "\\winPEASx86.exe")))))
