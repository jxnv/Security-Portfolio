// Title: Suspicious Shim Database Patching Activity
// ID: bf344fea-d947-4ef4-9192-34d008315d3a
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-08-01
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.011
// Description: Detects installation of new shim databases that try to patch sections of known processes for potential process injection or persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

(where(TargetObject ICONTAINS "\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\AppCompatFlags\\Custom\\") AND (where(TargetObject IENDSWITH "\\csrss.exe") OR where(TargetObject IENDSWITH "\\dllhost.exe") OR where(TargetObject IENDSWITH "\\explorer.exe") OR where(TargetObject IENDSWITH "\\RuntimeBroker.exe") OR where(TargetObject IENDSWITH "\\services.exe") OR where(TargetObject IENDSWITH "\\sihost.exe") OR where(TargetObject IENDSWITH "\\svchost.exe") OR where(TargetObject IENDSWITH "\\taskhostw.exe") OR where(TargetObject IENDSWITH "\\winlogon.exe") OR where(TargetObject IENDSWITH "\\WmiPrvSe.exe")))
