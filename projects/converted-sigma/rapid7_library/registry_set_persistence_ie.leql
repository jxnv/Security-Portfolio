// Title: Modification of IE Registry Settings
// ID: d88d0ab2-e696-4d40-a2ed-9790064e66b3
// Status: test
// Level: low
// Author: frack113
// Date: 2022-01-22
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects modification of the registry settings used for Internet Explorer and other Windows components that use these settings. An attacker can abuse this registry key to add a domain to the trusted sites Zone or insert JavaScript for persistence
// Converted by: Sigma Universal SIEM/EDR CLI

((where(TargetObject ICONTAINS "\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings")) AND NOT (((where(Details = "Binary Data")) OR (where(Details ISTARTSWITH "DWORD")) OR (NOT Details=*) OR ((where(Details = "Cookie:") OR where(Details = "Visited:") OR where(Details = "(Empty)"))) OR ((where(TargetObject ICONTAINS "\\Cache") OR where(TargetObject ICONTAINS "\\ZoneMap") OR where(TargetObject ICONTAINS "\\WpadDecision"))))) AND NOT ((where(TargetObject ICONTAINS "\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Accepted Documents"))))
