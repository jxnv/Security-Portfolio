// Title: Wlrmdr.EXE Uncommon Argument Or Child Process
// ID: 9cfc00b6-bfb7-49ce-9781-ef78503154bb
// Status: experimental
// Level: medium
// Author: frack113, manasmbellani
// Date: 2022-02-16
// Tags: attack.stealth, attack.t1218
// Description: Detects the execution of "Wlrmdr.exe" with the "-u" command line flag which allows anything passed to it to be an argument of the ShellExecute API, which would allow an attacker to execute arbitrary binaries.
// This detection also focuses on any uncommon child processes spawned from "Wlrmdr.exe" as a supplement for those that posses "ParentImage" telemetry.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(ParentImage IENDSWITH "\\wlrmdr.exe")) OR ((((where(CommandLine ICONTAINS "-a ") OR where(CommandLine ICONTAINS "/a "))) AND ((where(CommandLine ICONTAINS "-f ") OR where(CommandLine ICONTAINS "/f "))) AND ((where(CommandLine ICONTAINS "-m ") OR where(CommandLine ICONTAINS "/m "))) AND ((where(CommandLine ICONTAINS "-s ") OR where(CommandLine ICONTAINS "/s "))) AND ((where(CommandLine ICONTAINS "-t ") OR where(CommandLine ICONTAINS "/t "))) AND ((where(CommandLine ICONTAINS "-u ") OR where(CommandLine ICONTAINS "/u "))) AND ((where(Image IENDSWITH "\\wlrmdr.exe")) OR (where(OriginalFileName = "WLRMNDR.EXE")))) AND NOT ((((where(ParentImage = "") OR where(ParentImage = "-"))) OR (NOT ParentImage=*) OR (where(ParentImage = "C:\\Windows\\System32\\winlogon.exe"))))))
