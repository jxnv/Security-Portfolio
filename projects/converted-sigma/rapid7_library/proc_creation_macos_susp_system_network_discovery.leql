// Title: System Network Discovery - macOS
// ID: 58800443-f9fc-4d55-ae0c-98a3966dfb97
// Status: test
// Level: informational
// Author: remotephone, oscd.community
// Date: 2020-10-06
// Tags: attack.discovery, attack.t1016
// Description: Detects enumeration of local network configuration
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(Image IENDSWITH "/arp") OR where(Image IENDSWITH "/ifconfig") OR where(Image IENDSWITH "/netstat") OR where(Image IENDSWITH "/networksetup") OR where(Image IENDSWITH "/socketfilterfw"))) OR (where(Image = "/usr/bin/defaults") AND (where(CommandLine ICONTAINS "/Library/Preferences/com.apple.alf") AND where(CommandLine ICONTAINS "read")))) AND NOT ((where(ParentImage IENDSWITH "/wifivelocityd"))))
