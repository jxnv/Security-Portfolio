// Title: Use Short Name Path in Image
// ID: a96970af-f126-420d-90e1-d37bf25e50e1
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali
// Date: 2022-08-07
// Tags: attack.stealth, attack.t1564.004
// Description: Detect use of the Windows 8.3 short name. Which could be used as a method to avoid Image detection
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image ICONTAINS "~1\\") OR where(Image ICONTAINS "~2\\"))) AND NOT (((((where(Image ICONTAINS "\\AppData\\") AND where(Image ICONTAINS "\\Temp\\"))) OR ((where(Image IENDSWITH "~1\\unzip.exe") OR where(Image IENDSWITH "~1\\7zG.exe")))) OR ((where(ParentImage = "C:\\Windows\\System32\\Dism.exe") OR where(ParentImage = "C:\\Windows\\System32\\cleanmgr.exe"))))) AND NOT ((((where(Product = "InstallShield (R)")) OR (where(Description = "InstallShield (R) Setup Engine")) OR (where(Company = "InstallShield Software Corporation"))) OR (where(ParentImage IENDSWITH "\\thor\\thor64.exe")) OR (where(ParentImage IENDSWITH "\\WebEx\\WebexHost.exe")))))
