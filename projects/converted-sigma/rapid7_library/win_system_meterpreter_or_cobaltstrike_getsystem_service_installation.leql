// Title: Meterpreter or Cobalt Strike Getsystem Service Installation - System
// ID: 843544a7-56e0-4dcc-a44f-5cc266dd97d6
// Status: test
// Level: high
// Author: Teymur Kheirkhabarov, Ecco, Florian Roth (Nextron Systems)
// Date: 2019-10-26
// Tags: attack.privilege-escalation, attack.stealth, attack.t1134.001, attack.t1134.002
// Description: Detects the use of getsystem Meterpreter/Cobalt Strike command by detecting a specific service installation
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Provider_Name = "Service Control Manager") AND where(EventID = "7045")) AND (((where(ImagePath ICONTAINS "/c") AND where(ImagePath ICONTAINS "echo") AND where(ImagePath ICONTAINS "\\pipe\\")) AND (where(ImagePath ICONTAINS "cmd") OR where(ImagePath ICONTAINS "%COMSPEC%"))) OR ((where(ImagePath ICONTAINS "rundll32") AND where(ImagePath ICONTAINS ".dll,a") AND where(ImagePath ICONTAINS "/p:"))) OR (where(ImagePath ISTARTSWITH "\\\\\\\\127.0.0.1\\\\ADMIN$\\"))))
