// Title: Suspicious Scheduled Task Update
// ID: 614cf376-6651-47c4-9dcc-6b9527f749f4
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-05
// Tags: attack.execution, attack.privilege-escalation, attack.persistence, attack.t1053.005
// Description: Detects update to a scheduled task event that contain suspicious keywords.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(TaskContentNew ICONTAINS "regsvr32") OR where(TaskContentNew ICONTAINS "rundll32") OR where(TaskContentNew ICONTAINS "cmd.exe</Command>") OR where(TaskContentNew ICONTAINS "cmd</Command>") OR where(TaskContentNew ICONTAINS "<Arguments>/c ") OR where(TaskContentNew ICONTAINS "<Arguments>/k ") OR where(TaskContentNew ICONTAINS "<Arguments>/r ") OR where(TaskContentNew ICONTAINS "powershell") OR where(TaskContentNew ICONTAINS "pwsh") OR where(TaskContentNew ICONTAINS "mshta") OR where(TaskContentNew ICONTAINS "wscript") OR where(TaskContentNew ICONTAINS "cscript") OR where(TaskContentNew ICONTAINS "certutil") OR where(TaskContentNew ICONTAINS "bitsadmin") OR where(TaskContentNew ICONTAINS "bash.exe") OR where(TaskContentNew ICONTAINS "bash ") OR where(TaskContentNew ICONTAINS "scrcons") OR where(TaskContentNew ICONTAINS "wmic ") OR where(TaskContentNew ICONTAINS "wmic.exe") OR where(TaskContentNew ICONTAINS "forfiles") OR where(TaskContentNew ICONTAINS "scriptrunner") OR where(TaskContentNew ICONTAINS "hh.exe"))) AND (where(EventID = "4702")) AND ((where(TaskContentNew ICONTAINS "\\AppData\\Local\\Temp\\") OR where(TaskContentNew ICONTAINS "\\AppData\\Roaming\\") OR where(TaskContentNew ICONTAINS "\\Users\\Public\\") OR where(TaskContentNew ICONTAINS "\\WINDOWS\\Temp\\") OR where(TaskContentNew ICONTAINS "C:\\Temp\\") OR where(TaskContentNew ICONTAINS "\\Desktop\\") OR where(TaskContentNew ICONTAINS "\\Downloads\\") OR where(TaskContentNew ICONTAINS "\\Temporary Internet") OR where(TaskContentNew ICONTAINS "C:\\ProgramData\\") OR where(TaskContentNew ICONTAINS "C:\\Perflogs\\"))))
