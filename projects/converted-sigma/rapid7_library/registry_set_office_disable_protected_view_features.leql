// Title: Microsoft Office Protected View Disabled
// ID: a5c7a43f-6009-4a8c-80c5-32abf1c53ecc
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-06-08
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects changes to Microsoft Office protected view registry keys with which the attacker disables this feature.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(TargetObject ICONTAINS "\\SOFTWARE\\Microsoft\\Office\\") AND where(TargetObject ICONTAINS "\\Security\\ProtectedView\\"))) AND ((where(Details = "DWORD (0x00000000)") AND (where(TargetObject IENDSWITH "\\enabledatabasefileprotectedview") OR where(TargetObject IENDSWITH "\\enableforeigntextfileprotectedview"))) OR (where(Details = "DWORD (0x00000001)") AND (where(TargetObject IENDSWITH "\\DisableAttachementsInPV") OR where(TargetObject IENDSWITH "\\DisableInternetFilesInPV") OR where(TargetObject IENDSWITH "\\DisableIntranetCheck") OR where(TargetObject IENDSWITH "\\DisableUnsafeLocationsInPV")))))
