// Title: MacOS Scripting Interpreter AppleScript
// ID: 1bc2e6c5-0885-472b-bed6-be5ea8eace55
// Status: test
// Level: medium
// Author: Alejandro Ortuno, oscd.community
// Date: 2020-10-21
// Tags: attack.execution, attack.t1059.002
// Description: Detects execution of AppleScript of the macOS scripting language AppleScript.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image IENDSWITH "/osascript") AND (where(CommandLine ICONTAINS " -e ") OR where(CommandLine ICONTAINS ".scpt") OR where(CommandLine ICONTAINS ".js"))) AND NOT ((where(ParentImage IENDSWITH "opencode") AND (where(CommandLine ICONTAINS "osascript") AND where(CommandLine ICONTAINS " -e ") AND where(CommandLine ICONTAINS "set imageData to the clipboard") AND where(CommandLine ICONTAINS "set fileRef")))))
