// Title: Suspicious Access to Sensitive File Extensions - Zeek
// ID: 286b47ed-f6fe-40b3-b3a8-35129acd43bc
// Status: test
// Level: medium
// Author: Samir Bousseaden, @neu5ron
// Date: 2020-04-02
// Tags: attack.collection
// Description: Detects known sensitive file extensions via Zeek
// Converted by: Sigma Universal SIEM/EDR CLI

((where(name IENDSWITH ".pst") OR where(name IENDSWITH ".ost") OR where(name IENDSWITH ".msg") OR where(name IENDSWITH ".nst") OR where(name IENDSWITH ".oab") OR where(name IENDSWITH ".edb") OR where(name IENDSWITH ".nsf") OR where(name IENDSWITH ".bak") OR where(name IENDSWITH ".dmp") OR where(name IENDSWITH ".kirbi") OR where(name IENDSWITH ".rdp")))
