// Title: File Download with Headless Browser
// ID: 0e8cfe08-02c9-4815-a2f8-0d157b7ed33e
// Status: test
// Level: high
// Author: Sreeman, Florian Roth (Nextron Systems)
// Date: 2022-01-04
// Tags: attack.command-and-control, attack.stealth, attack.t1105, attack.t1564.003
// Description: Detects execution of chromium based browser in headless mode using the "dump-dom" command line to download files
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "\\brave.exe") OR where(Image IENDSWITH "\\chrome.exe") OR where(Image IENDSWITH "\\msedge.exe") OR where(Image IENDSWITH "\\opera.exe") OR where(Image IENDSWITH "\\vivaldi.exe")) AND (where(CommandLine ICONTAINS "--headless") AND where(CommandLine ICONTAINS "dump-dom") AND where(CommandLine ICONTAINS "http"))) AND NOT ((((where(Image ISTARTSWITH "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\") OR where(Image ISTARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\") OR where(Image ISTARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\") OR where(Image ISTARTSWITH "C:\\Program Files\\Microsoft\\Edge\\Application\\") OR where(Image ISTARTSWITH "C:\\Program Files\\Microsoft\\EdgeCore\\") OR where(Image ISTARTSWITH "C:\\Program Files\\Microsoft\\EdgeWebView\\") OR where(Image ISTARTSWITH "C:\\Program Files\\WindowsApps\\Microsoft.MicrosoftEdge")) AND (where(Image IENDSWITH "\\msedge.exe") OR where(Image IENDSWITH "\\msedgewebview2.exe") OR where(Image IENDSWITH "\\MicrosoftEdge.exe")) AND where(CommandLine ICONTAINS "--headless --disable-gpu --disable-extensions --disable-plugins --mute-audio --no-first-run --incognito --aggressive-cache-discard --dump-dom")) OR ((where(Image ICONTAINS "\\AppData\\Local\\Microsoft\\WindowsApps\\") OR where(Image ICONTAINS "\\Windows\\SystemApps\\Microsoft.MicrosoftEdge")) AND (where(Image IENDSWITH "\\msedge.exe") OR where(Image IENDSWITH "\\MicrosoftEdge.exe")) AND where(CommandLine ICONTAINS "--headless --disable-gpu --disable-extensions --disable-plugins --mute-audio --no-first-run --incognito --aggressive-cache-discard --dump-dom")))))
