// Title: Control Panel Items
// ID: 0ba863e6-def5-4e50-9cea-4dd8c7dc46a4
// Status: test
// Level: high
// Author: Kyaw Min Thein, Furkan Caliskan (@caliskanfurkan_)
// Date: 2020-06-22
// Tags: attack.privilege-escalation, attack.execution, attack.stealth, attack.t1218.002, attack.persistence, attack.t1546
// Description: Detects the malicious use of a control panel item
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(CommandLine ICONTAINS "add") AND where(CommandLine ICONTAINS "CurrentVersion\\Control Panel\\CPLs"))) AND ((where(Image IENDSWITH "\\reg.exe")) OR (where(OriginalFileName = "reg.exe")))) OR ((where(CommandLine IENDSWITH ".cpl")) AND NOT ((((where(CommandLine ICONTAINS "regsvr32 ") AND where(CommandLine ICONTAINS " /s ") AND where(CommandLine ICONTAINS "igfxCPL.cpl"))) OR ((where(CommandLine ICONTAINS "\\System32\\") OR where(CommandLine ICONTAINS "%System%") OR where(CommandLine ICONTAINS "|C:\\Windows\\system32|")))))))
