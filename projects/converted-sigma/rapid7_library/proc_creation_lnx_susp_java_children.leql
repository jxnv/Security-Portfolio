// Title: Suspicious Java Children Processes
// ID: d292e0af-9a18-420c-9525-ec0ac3936892
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-03
// Tags: attack.execution, attack.t1059
// Description: Detects java process spawning suspicious children
// Converted by: Sigma Universal SIEM/EDR CLI

(where(ParentImage IENDSWITH "/java") AND (where(CommandLine ICONTAINS "/bin/sh") OR where(CommandLine ICONTAINS "bash") OR where(CommandLine ICONTAINS "dash") OR where(CommandLine ICONTAINS "ksh") OR where(CommandLine ICONTAINS "zsh") OR where(CommandLine ICONTAINS "csh") OR where(CommandLine ICONTAINS "fish") OR where(CommandLine ICONTAINS "curl") OR where(CommandLine ICONTAINS "wget") OR where(CommandLine ICONTAINS "python")))
