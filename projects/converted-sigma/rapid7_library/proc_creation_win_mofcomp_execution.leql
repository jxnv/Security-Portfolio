// Title: Potentially Suspicious Mofcomp Execution
// ID: 1dd05363-104e-4b4a-b963-196a534b03a1
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-12
// Tags: attack.stealth, attack.t1218
// Description: Detects execution of the "mofcomp" utility as a child of a suspicious shell or script running utility or by having a suspicious path in the commandline.
// The "mofcomp" utility parses a file containing MOF statements and adds the classes and class instances defined in the file to the WMI repository.
// Attackers abuse this utility to install malicious MOF scripts
// Converted by: Sigma Universal SIEM/EDR CLI

(((((where(ParentImage IENDSWITH "\\cmd.exe") OR where(ParentImage IENDSWITH "\\powershell.exe") OR where(ParentImage IENDSWITH "\\pwsh.exe") OR where(ParentImage IENDSWITH "\\wsl.exe") OR where(ParentImage IENDSWITH "\\wscript.exe") OR where(ParentImage IENDSWITH "\\cscript.exe"))) OR ((where(CommandLine ICONTAINS "\\AppData\\Local\\Temp") OR where(CommandLine ICONTAINS "\\Contacts\\") OR where(CommandLine ICONTAINS "\\Favorites\\") OR where(CommandLine ICONTAINS "\\Favourites\\") OR where(CommandLine ICONTAINS "\\Music\\") OR where(CommandLine ICONTAINS "\\Pictures\\") OR where(CommandLine ICONTAINS "\\Users\\Public\\") OR where(CommandLine ICONTAINS "\\Videos\\") OR where(CommandLine ICONTAINS "\\WINDOWS\\Temp\\") OR where(CommandLine ICONTAINS "%appdata%") OR where(CommandLine ICONTAINS "%temp%") OR where(CommandLine ICONTAINS "%tmp%")))) AND ((where(Image IENDSWITH "\\mofcomp.exe")) OR (where(OriginalFileName = "mofcomp.exe")))) AND NOT (((where(ParentCommandLine IENDSWITH "\\InstallUtil.exe /Uninstall C:\\Windows\\CCM\\Microsoft.ConfigurationManager.SVProvider.dll") AND where(ParentImage IENDSWITH "\\InstallUtil.exe") AND (where(CommandLine ICONTAINS "C:\\Windows\\TEMP") AND where(CommandLine ICONTAINS ".tmp"))) OR (where(ParentImage = "C:\\Windows\\System32\\wbem\\WmiPrvSE.exe") AND where(CommandLine ICONTAINS "C:\\Windows\\TEMP\\") AND where(CommandLine IENDSWITH ".mof")))) AND NOT ((NOT ParentCommandLine=*)))
