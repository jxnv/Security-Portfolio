// Title: System Control Panel Item Loaded From Uncommon Location
// ID: 2b140a5c-dc02-4bb8-b6b1-8bdb45714cde
// Status: test
// Level: high
// Author: Anish Bogati
// Date: 2024-01-09
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects image load events of system control panel items (.cpl) from uncommon or non-system locations that may indicate DLL sideloading or other abuse techniques.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(ImageLoaded IENDSWITH "\\appwiz.cpl") OR where(ImageLoaded IENDSWITH "\\bthprops.cpl") OR where(ImageLoaded IENDSWITH "\\hdwwiz.cpl"))) AND NOT (((where(ImageLoaded ISTARTSWITH "C:\\Windows\\Prefetch\\") OR where(ImageLoaded ISTARTSWITH "C:\\Windows\\System32\\") OR where(ImageLoaded ISTARTSWITH "C:\\Windows\\SysWOW64\\") OR where(ImageLoaded ISTARTSWITH "C:\\Windows\\WinSxS\\")))))
