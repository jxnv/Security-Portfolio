// Title: Potentially Suspicious Volume Shadow Copy Vsstrace.dll Load
// ID: 48bfd177-7cf2-412b-ad77-baf923489e82
// Status: test
// Level: medium
// Author: frack113
// Date: 2023-02-17
// Tags: attack.impact, attack.t1490
// Description: Detects the image load of VSS DLL by uncommon executables
// Converted by: Sigma Universal SIEM/EDR CLI

((where(ImageLoaded IENDSWITH "\\vsstrace.dll")) AND NOT (((NOT Image=*) OR ((where(Image ISTARTSWITH "C:\\Program Files\\") OR where(Image ISTARTSWITH "C:\\Program Files (x86)\\"))) OR (((where(Image = "C:\\Windows\\explorer.exe") OR where(Image = "C:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe") OR where(Image = "C:\\Windows\\servicing\\TrustedInstaller.exe"))) OR ((where(Image ISTARTSWITH "C:\\Windows\\System32\\") OR where(Image ISTARTSWITH "C:\\Windows\\SysWOW64\\") OR where(Image ISTARTSWITH "C:\\Windows\\Temp\\{") OR where(Image ISTARTSWITH "C:\\Windows\\WinSxS\\") OR where(Image ISTARTSWITH "C:\\ProgramData\\Package Cache\\{")))))) AND NOT ((((where(Image ICONTAINS "\\temp\\is-") AND where(Image ICONTAINS "\\avira_system_speedup.tmp"))) OR (where(Image ISTARTSWITH "C:\\$WinREAgent\\Scratch\\")))))
