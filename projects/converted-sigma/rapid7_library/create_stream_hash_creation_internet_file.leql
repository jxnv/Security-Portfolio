// Title: Creation Of a Suspicious ADS File Outside a Browser Download
// ID: 573df571-a223-43bc-846e-3f98da481eca
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-10-22
// Tags: attack.stealth
// Description: Detects the creation of a suspicious ADS (Alternate Data Stream) file by software other than browsers
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Contents ISTARTSWITH "[ZoneTransfer]  ZoneId=3") AND where(TargetFilename IENDSWITH ":Zone.Identifier") AND (where(TargetFilename ICONTAINS ".exe") OR where(TargetFilename ICONTAINS ".scr") OR where(TargetFilename ICONTAINS ".bat") OR where(TargetFilename ICONTAINS ".cmd") OR where(TargetFilename ICONTAINS ".docx") OR where(TargetFilename ICONTAINS ".hta") OR where(TargetFilename ICONTAINS ".jse") OR where(TargetFilename ICONTAINS ".lnk") OR where(TargetFilename ICONTAINS ".pptx") OR where(TargetFilename ICONTAINS ".ps") OR where(TargetFilename ICONTAINS ".reg") OR where(TargetFilename ICONTAINS ".sct") OR where(TargetFilename ICONTAINS ".vb") OR where(TargetFilename ICONTAINS ".wsc") OR where(TargetFilename ICONTAINS ".wsf") OR where(TargetFilename ICONTAINS ".xlsx"))) AND NOT (((where(Image IENDSWITH "\\brave.exe")) OR ((where(Image = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe") OR where(Image = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe"))) OR ((where(Image ISTARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\")) OR (where(Image IENDSWITH "\\WindowsApps\\MicrosoftEdge.exe")) OR ((where(Image = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe") OR where(Image = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe")))) OR ((where(Image ISTARTSWITH "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\") OR where(Image ISTARTSWITH "C:\\Program Files\\Microsoft\\EdgeCore\\")) AND (where(Image IENDSWITH "\\msedge.exe") OR where(Image IENDSWITH "\\msedgewebview2.exe"))) OR ((where(Image = "C:\\Program Files\\Mozilla Firefox\\firefox.exe") OR where(Image = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe"))) OR ((where(Image = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe") OR where(Image = "C:\\Program Files\\Internet Explorer\\iexplore.exe"))) OR (where(Image IENDSWITH "\\maxthon.exe")) OR (where(Image IENDSWITH "\\opera.exe")) OR (where(Image IENDSWITH "\\safari.exe")) OR (where(Image IENDSWITH "\\seamonkey.exe")) OR (where(Image ISTARTSWITH "C:\\Program Files\\WindowsApps\\Microsoft.ScreenSketch_") AND where(Image IENDSWITH "\\SnippingTool\\SnippingTool.exe") AND where(TargetFilename ISTARTSWITH "C:\\Users\\") AND (where(TargetFilename ICONTAINS "\\AppData\\Local\\Packages\\Microsoft.ScreenSketch_") AND where(TargetFilename ICONTAINS "\\TempState\\Screenshot ")) AND where(TargetFilename IENDSWITH ".png:Zone.Identifier")) OR (where(Image IENDSWITH "\\vivaldi.exe")) OR (where(Image IENDSWITH "\\whale.exe")))))
