// Title: BITS Transfer Job Download From Direct IP
// ID: 90f138c1-f578-4ac3-8c49-eecfd847c8b7
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-11
// Tags: attack.persistence, attack.execution, attack.stealth, attack.t1197
// Description: Detects a BITS transfer job downloading file(s) from a direct IP address.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(EventID = "16403") AND (where(RemoteName ICONTAINS "http://1") OR where(RemoteName ICONTAINS "http://2") OR where(RemoteName ICONTAINS "http://3") OR where(RemoteName ICONTAINS "http://4") OR where(RemoteName ICONTAINS "http://5") OR where(RemoteName ICONTAINS "http://6") OR where(RemoteName ICONTAINS "http://7") OR where(RemoteName ICONTAINS "http://8") OR where(RemoteName ICONTAINS "http://9") OR where(RemoteName ICONTAINS "https://1") OR where(RemoteName ICONTAINS "https://2") OR where(RemoteName ICONTAINS "https://3") OR where(RemoteName ICONTAINS "https://4") OR where(RemoteName ICONTAINS "https://5") OR where(RemoteName ICONTAINS "https://6") OR where(RemoteName ICONTAINS "https://7") OR where(RemoteName ICONTAINS "https://8") OR where(RemoteName ICONTAINS "https://9"))) AND NOT ((((where(RemoteName ICONTAINS "://10.") OR where(RemoteName ICONTAINS "://192.168.") OR where(RemoteName ICONTAINS "://172.16.") OR where(RemoteName ICONTAINS "://172.17.") OR where(RemoteName ICONTAINS "://172.18.") OR where(RemoteName ICONTAINS "://172.19.") OR where(RemoteName ICONTAINS "://172.20.") OR where(RemoteName ICONTAINS "://172.21.") OR where(RemoteName ICONTAINS "://172.22.") OR where(RemoteName ICONTAINS "://172.23.") OR where(RemoteName ICONTAINS "://172.24.") OR where(RemoteName ICONTAINS "://172.25.") OR where(RemoteName ICONTAINS "://172.26.") OR where(RemoteName ICONTAINS "://172.27.") OR where(RemoteName ICONTAINS "://172.28.") OR where(RemoteName ICONTAINS "://172.29.") OR where(RemoteName ICONTAINS "://172.30.") OR where(RemoteName ICONTAINS "://172.31.") OR where(RemoteName ICONTAINS "://127.") OR where(RemoteName ICONTAINS "://169.254."))) OR ((where(RemoteName ICONTAINS "https://7-") OR where(RemoteName ICONTAINS "http://7-"))))))
