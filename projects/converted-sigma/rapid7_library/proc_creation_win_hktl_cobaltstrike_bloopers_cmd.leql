// Title: Operator Bloopers Cobalt Strike Commands
// ID: 647c7b9e-d784-4fda-b9a0-45c565a7b729
// Status: test
// Level: high
// Author: _pete_0, TheDFIRReport
// Date: 2022-05-06
// Tags: attack.execution, attack.t1059.003, stp.1u
// Description: Detects use of Cobalt Strike commands accidentally entered in the CMD shell
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ISTARTSWITH "cmd ") OR where(CommandLine ISTARTSWITH "cmd.exe") OR where(CommandLine ISTARTSWITH "c:\\windows\\system32\\cmd.exe")) AND (where(CommandLine ICONTAINS "psinject") OR where(CommandLine ICONTAINS "spawnas") OR where(CommandLine ICONTAINS "make_token") OR where(CommandLine ICONTAINS "remote-exec") OR where(CommandLine ICONTAINS "rev2self") OR where(CommandLine ICONTAINS "dcsync") OR where(CommandLine ICONTAINS "logonpasswords") OR where(CommandLine ICONTAINS "execute-assembly") OR where(CommandLine ICONTAINS "getsystem"))) AND ((where(OriginalFileName = "Cmd.Exe")) OR (where(Image IENDSWITH "\\cmd.exe"))))
