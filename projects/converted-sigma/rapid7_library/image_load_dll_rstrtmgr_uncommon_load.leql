// Title: Load Of RstrtMgr.DLL By An Uncommon Process
// ID: 3669afd2-9891-4534-a626-e5cf03810a61
// Status: test
// Level: low
// Author: Luc Génaux
// Date: 2023-11-28
// Tags: attack.impact, attack.defense-impairment, attack.t1486, attack.t1685
// Description: Detects the load of RstrtMgr DLL (Restart Manager) by an uncommon process.
// This library has been used during ransomware campaigns to kill processes that would prevent file encryption by locking them (e.g. Conti ransomware, Cactus ransomware). It has also recently been seen used by the BiBi wiper for Windows.
// It could also be used for anti-analysis purposes by shut downing specific processes.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(ImageLoaded IENDSWITH "\\RstrtMgr.dll")) OR (where(OriginalFileName = "RstrtMgr.dll"))) AND NOT (((where(Image ISTARTSWITH "C:\\Windows\\Temp\\")) OR ((where(Image ISTARTSWITH "C:\\$WINDOWS.~BT\\") OR where(Image ISTARTSWITH "C:\\$WinREAgent\\") OR where(Image ISTARTSWITH "C:\\Program Files (x86)\\") OR where(Image ISTARTSWITH "C:\\Program Files\\") OR where(Image ISTARTSWITH "C:\\ProgramData\\") OR where(Image ISTARTSWITH "C:\\Windows\\explorer.exe") OR where(Image ISTARTSWITH "C:\\Windows\\SoftwareDistribution\\") OR where(Image ISTARTSWITH "C:\\Windows\\SysNative\\") OR where(Image ISTARTSWITH "C:\\Windows\\System32\\") OR where(Image ISTARTSWITH "C:\\Windows\\SysWOW64\\") OR where(Image ISTARTSWITH "C:\\Windows\\WinSxS\\") OR where(Image ISTARTSWITH "C:\\WUDownloadCache\\"))) OR (where(Image ISTARTSWITH "C:\\Users\\") AND (where(Image ICONTAINS "\\AppData\\Local\\Temp\\is-") AND where(Image ICONTAINS ".tmp\\")) AND where(Image IENDSWITH ".tmp")))) AND NOT (((where(Image ISTARTSWITH "C:\\Users\\") AND (where(Image IENDSWITH "\\AppData\\Local\\Microsoft\\OneDrive\\OneDrive.exe") OR where(Image IENDSWITH "\\AppData\\Local\\Microsoft\\OneDrive\\OneDriveStandaloneUpdater.exe"))) OR (where(Image ISTARTSWITH "C:\\Users\\") AND where(Image ICONTAINS "\\AppData\\Local\\Microsoft\\OneDrive\\") AND where(Image IENDSWITH "\\OneDrive.Sync.Service.exe")))))
