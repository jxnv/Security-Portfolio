// Title: Suspicious Child Process Of BgInfo.EXE
// ID: 811f459f-9231-45d4-959a-0266c6311987
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-08-16
// Tags: attack.execution, attack.stealth, attack.t1059.005, attack.t1218, attack.t1202
// Description: Detects suspicious child processes of "BgInfo.exe" which could be a sign of potential abuse of the binary to proxy execution via external VBScript
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(Image IENDSWITH "\\calc.exe") OR where(Image IENDSWITH "\\cmd.exe") OR where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\mshta.exe") OR where(Image IENDSWITH "\\notepad.exe") OR where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe") OR where(Image IENDSWITH "\\wscript.exe"))) OR ((where(Image ICONTAINS "\\AppData\\Local\\") OR where(Image ICONTAINS "\\AppData\\Roaming\\") OR where(Image ICONTAINS ":\\Users\\Public\\") OR where(Image ICONTAINS ":\\Temp\\") OR where(Image ICONTAINS ":\\Windows\\Temp\\") OR where(Image ICONTAINS ":\\PerfLogs\\")))) AND ((where(ParentImage IENDSWITH "\\bginfo.exe") OR where(ParentImage IENDSWITH "\\bginfo64.exe"))))
