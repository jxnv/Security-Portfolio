// Tags: attack.defense-impairment, attack.t1685, attack.execution, attack.t1059
// Description: Detects modifications to the Windows Defender configuration settings using PowerShell to add exclusions
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(ScriptBlockText ICONTAINS " -ExclusionPath ") OR where(ScriptBlockText ICONTAINS " -ExclusionExtension ") OR where(ScriptBlockText ICONTAINS " -ExclusionProcess ") OR where(ScriptBlockText ICONTAINS " -ExclusionIpAddress "))) AND ((where(ScriptBlockText ICONTAINS "Add-MpPreference ") OR where(ScriptBlockText ICONTAINS "Set-MpPreference "))))
