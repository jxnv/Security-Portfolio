// Title: System Restore Registry Modification via CommandLine
// ID: 7c06ab9b-b1d2-4ba9-b06e-09491ded20d9
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-03-11
// Tags: attack.impact, attack.t1490
// Description: Detects system restore registry modification via command line, which can be used by adversaries to disable system restore on the computer.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS " add ") OR where(CommandLine ICONTAINS "Set-ItemProperty") OR where(CommandLine ICONTAINS "New-ItemProperty"))) AND ((where(CommandLine ICONTAINS "DisableConfig") OR where(CommandLine ICONTAINS "DisableSR"))) AND ((where(CommandLine ICONTAINS "\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\SystemRestore") OR where(CommandLine ICONTAINS "\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\SystemRestore"))) AND (((where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe") OR where(Image IENDSWITH "\\reg.exe"))) OR ((where(OriginalFileName = "powershell.exe") OR where(OriginalFileName = "pwsh.dll") OR where(OriginalFileName = "reg.exe")))))
