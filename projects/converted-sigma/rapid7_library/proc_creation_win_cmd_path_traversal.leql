// Title: Potential CommandLine Path Traversal Via Cmd.EXE
// ID: 087790e3-3287-436c-bccf-cbd0184a7db1
// Status: test
// Level: high
// Author: xknow @xknow_infosec, Tim Shelton
// Date: 2020-06-11
// Tags: attack.execution, attack.t1059.003
// Description: Detects potential path traversal attempt via cmd.exe. Could indicate possible command/argument confusion/hijacking
// Converted by: Sigma Universal SIEM/EDR CLI

(((((where(ParentCommandLine ICONTAINS "/c") OR where(ParentCommandLine ICONTAINS "/k") OR where(ParentCommandLine ICONTAINS "/r"))) OR ((where(CommandLine ICONTAINS "/c") OR where(CommandLine ICONTAINS "/k") OR where(CommandLine ICONTAINS "/r")))) AND ((where(ParentImage IENDSWITH "\\cmd.exe")) OR (where(Image IENDSWITH "\\cmd.exe")) OR (where(OriginalFileName = "cmd.exe"))) AND ((where(ParentCommandLine = "/../../")) OR (where(CommandLine ICONTAINS "/../../")))) AND NOT ((where(CommandLine ICONTAINS "\\Tasktop\\keycloak\\bin\\/../../jre\\bin\\java"))))
