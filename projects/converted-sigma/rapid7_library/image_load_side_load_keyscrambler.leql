// Title: Potential DLL Sideloading Of KeyScramblerIE.DLL Via KeyScrambler.EXE
// ID: d2451be2-b582-4e15-8701-4196ac180260
// Status: test
// Level: high
// Author: Swachchhanda Shrawan Poudel
// Date: 2024-04-15
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL side loading of "KeyScramblerIE.dll" by "KeyScrambler.exe".
// Various threat actors and malware have been found side loading a masqueraded "KeyScramblerIE.dll" through "KeyScrambler.exe".
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "\\KeyScrambler.exe") OR where(Image IENDSWITH "\\KeyScramblerLogon.exe")) AND where(ImageLoaded IENDSWITH "\\KeyScramblerIE.dll")) AND NOT ((((where(Image ICONTAINS "C:\\Program Files (x86)\\KeyScrambler\\") OR where(Image ICONTAINS "C:\\Program Files\\KeyScrambler\\")) AND (where(ImageLoaded ICONTAINS "C:\\Program Files (x86)\\KeyScrambler\\") OR where(ImageLoaded ICONTAINS "C:\\Program Files\\KeyScrambler\\"))) OR (where(Signature = "QFX Software Corporation") AND where(SignatureStatus = "Valid")))))
