// Title: Uncommon Svchost Parent Process
// ID: 01d2e2a1-5f09-44f7-9fc1-24faa7479b6d
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2017-08-15
// Tags: attack.stealth, attack.t1036.005
// Description: Detects an uncommon svchost parent process
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image IENDSWITH "\\svchost.exe")) AND NOT ((((where(ParentImage IENDSWITH "\\Mrt.exe") OR where(ParentImage IENDSWITH "\\MsMpEng.exe") OR where(ParentImage IENDSWITH "\\ngen.exe") OR where(ParentImage IENDSWITH "\\rpcnet.exe") OR where(ParentImage IENDSWITH "\\services.exe") OR where(ParentImage IENDSWITH "\\TiWorker.exe"))) OR ((where(ParentImage = "-") OR where(ParentImage = ""))) OR (NOT ParentImage=*))))
