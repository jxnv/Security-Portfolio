// Title: Office Macro File Download
// ID: 0e29e3a7-1ad8-40aa-b691-9f82ecd33d66
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-23
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects the creation of a new office macro files on the system via an application (browser, mail client).
// This can help identify potential malicious activity, such as the download of macro-enabled documents that could be used for exploitation.
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(TargetFilename IENDSWITH ".docm") OR where(TargetFilename IENDSWITH ".dotm") OR where(TargetFilename IENDSWITH ".xlsm") OR where(TargetFilename IENDSWITH ".xltm") OR where(TargetFilename IENDSWITH ".potm") OR where(TargetFilename IENDSWITH ".pptm"))) OR ((where(TargetFilename ICONTAINS ".docm:Zone") OR where(TargetFilename ICONTAINS ".dotm:Zone") OR where(TargetFilename ICONTAINS ".xlsm:Zone") OR where(TargetFilename ICONTAINS ".xltm:Zone") OR where(TargetFilename ICONTAINS ".potm:Zone") OR where(TargetFilename ICONTAINS ".pptm:Zone")))) AND ((where(Image IENDSWITH "\\RuntimeBroker.exe") OR where(Image IENDSWITH "\\outlook.exe") OR where(Image IENDSWITH "\\thunderbird.exe") OR where(Image IENDSWITH "\\brave.exe") OR where(Image IENDSWITH "\\chrome.exe") OR where(Image IENDSWITH "\\firefox.exe") OR where(Image IENDSWITH "\\iexplore.exe") OR where(Image IENDSWITH "\\maxthon.exe") OR where(Image IENDSWITH "\\MicrosoftEdge.exe") OR where(Image IENDSWITH "\\msedge.exe") OR where(Image IENDSWITH "\\msedgewebview2.exe") OR where(Image IENDSWITH "\\opera.exe") OR where(Image IENDSWITH "\\safari.exe") OR where(Image IENDSWITH "\\seamonkey.exe") OR where(Image IENDSWITH "\\vivaldi.exe") OR where(Image IENDSWITH "\\whale.exe"))))
