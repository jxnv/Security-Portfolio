// Tags: attack.collection, attack.t1560.001
// Description: An adversary may compress or encrypt data that is collected prior to exfiltration using 3rd party utilities
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS " a ") OR where(CommandLine ICONTAINS " u "))) AND ((where(Description ICONTAINS "7-Zip")) OR ((where(Image IENDSWITH "\\7z.exe") OR where(Image IENDSWITH "\\7zr.exe") OR where(Image IENDSWITH "\\7za.exe"))) OR ((where(OriginalFileName = "7z.exe") OR where(OriginalFileName = "7za.exe") OR where(OriginalFileName = "7zr.exe")))) AND (where(CommandLine ICONTAINS " -p")))
