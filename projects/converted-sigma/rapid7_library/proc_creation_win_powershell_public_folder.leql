// Title: Execution of Powershell Script in Public Folder
// ID: fb9d3ff7-7348-46ab-af8c-b55f5fbf39b4
// Status: test
// Level: high
// Author: Max Altgelt (Nextron Systems)
// Date: 2022-04-06
// Tags: attack.execution, attack.t1059.001
// Description: This rule detects execution of PowerShell scripts located in the "C:\Users\Public" folder
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe")) AND (where(CommandLine ICONTAINS "-f C:\\Users\\Public") OR where(CommandLine ICONTAINS "-f \"C:\\Users\\Public") OR where(CommandLine ICONTAINS "-f %Public%") OR where(CommandLine ICONTAINS "-fi C:\\Users\\Public") OR where(CommandLine ICONTAINS "-fi \"C:\\Users\\Public") OR where(CommandLine ICONTAINS "-fi %Public%") OR where(CommandLine ICONTAINS "-fil C:\\Users\\Public") OR where(CommandLine ICONTAINS "-fil \"C:\\Users\\Public") OR where(CommandLine ICONTAINS "-fil %Public%") OR where(CommandLine ICONTAINS "-file C:\\Users\\Public") OR where(CommandLine ICONTAINS "-file \"C:\\Users\\Public") OR where(CommandLine ICONTAINS "-file %Public%")))
