// Title: BPFDoor Abnormal Process ID or Lock File Accessed
// ID: 808146b2-9332-4d78-9416-d7e47012d83d
// Status: test
// Level: high
// Author: Rafal Piasecki
// Date: 2022-08-10
// Tags: attack.execution, attack.t1106, attack.t1059
// Description: detects BPFDoor .lock and .pid files access in temporary file storage facility
// Converted by: Sigma Universal SIEM/EDR CLI

(where(type = "PATH") AND (where(name = "/var/run/aepmonend.pid") OR where(name = "/var/run/auditd.lock") OR where(name = "/var/run/cma.lock") OR where(name = "/var/run/console-kit.pid") OR where(name = "/var/run/consolekit.pid") OR where(name = "/var/run/daemon.pid") OR where(name = "/var/run/hald-addon.pid") OR where(name = "/var/run/hald-smartd.pid") OR where(name = "/var/run/haldrund.pid") OR where(name = "/var/run/hp-health.pid") OR where(name = "/var/run/hpasmlit.lock") OR where(name = "/var/run/hpasmlited.pid") OR where(name = "/var/run/kdevrund.pid") OR where(name = "/var/run/lldpad.lock") OR where(name = "/var/run/mcelog.pid") OR where(name = "/var/run/system.pid") OR where(name = "/var/run/uvp-srv.pid") OR where(name = "/var/run/vmtoolagt.pid") OR where(name = "/var/run/xinetd.lock")))
