// Title: Potential Suspicious Winget Package Installation
// ID: a3f5c081-e75b-43a0-9f5b-51f26fe5dba2
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.persistence, attack.stealth
// Description: Detects potential suspicious winget package installation from a suspicious source.
// Converted by: Sigma Universal SIEM/EDR CLI

(where(Contents ISTARTSWITH "[ZoneTransfer]  ZoneId=3") AND (where(Contents ICONTAINS "://1") OR where(Contents ICONTAINS "://2") OR where(Contents ICONTAINS "://3") OR where(Contents ICONTAINS "://4") OR where(Contents ICONTAINS "://5") OR where(Contents ICONTAINS "://6") OR where(Contents ICONTAINS "://7") OR where(Contents ICONTAINS "://8") OR where(Contents ICONTAINS "://9")) AND where(TargetFilename IENDSWITH ":Zone.Identifier") AND where(TargetFilename ICONTAINS "\\AppData\\Local\\Temp\\WinGet\\"))
