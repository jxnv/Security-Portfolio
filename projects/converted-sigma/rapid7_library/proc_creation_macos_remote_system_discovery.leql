// Title: Macos Remote System Discovery
// ID: 10227522-8429-47e6-a301-f2b2d014e7ad
// Status: test
// Level: informational
// Author: Alejandro Ortuno, oscd.community
// Date: 2020-10-22
// Tags: attack.discovery, attack.t1018
// Description: Detects the enumeration of other remote systems.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Image IENDSWITH "/arp") AND where(CommandLine ICONTAINS "-a")) OR (where(Image IENDSWITH "/ping") AND (where(CommandLine ICONTAINS " 10.") OR where(CommandLine ICONTAINS " 192.168.") OR where(CommandLine ICONTAINS " 172.16.") OR where(CommandLine ICONTAINS " 172.17.") OR where(CommandLine ICONTAINS " 172.18.") OR where(CommandLine ICONTAINS " 172.19.") OR where(CommandLine ICONTAINS " 172.20.") OR where(CommandLine ICONTAINS " 172.21.") OR where(CommandLine ICONTAINS " 172.22.") OR where(CommandLine ICONTAINS " 172.23.") OR where(CommandLine ICONTAINS " 172.24.") OR where(CommandLine ICONTAINS " 172.25.") OR where(CommandLine ICONTAINS " 172.26.") OR where(CommandLine ICONTAINS " 172.27.") OR where(CommandLine ICONTAINS " 172.28.") OR where(CommandLine ICONTAINS " 172.29.") OR where(CommandLine ICONTAINS " 172.30.") OR where(CommandLine ICONTAINS " 172.31.") OR where(CommandLine ICONTAINS " 127.") OR where(CommandLine ICONTAINS " 169.254."))))
