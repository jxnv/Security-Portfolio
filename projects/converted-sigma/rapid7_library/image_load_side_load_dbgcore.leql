// Title: Potential DLL Sideloading Of DBGCORE.DLL
// ID: 9ca2bf31-0570-44d8-a543-534c47c33ed7
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Wietze Beukema (project and research)
// Date: 2022-10-25
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects DLL sideloading of "dbgcore.dll"
// Converted by: Sigma Universal SIEM/EDR CLI

((where(ImageLoaded IENDSWITH "\\dbgcore.dll")) AND NOT (((where(ImageLoaded ISTARTSWITH "C:\\Program Files (x86)\\") OR where(ImageLoaded ISTARTSWITH "C:\\Program Files\\") OR where(ImageLoaded ISTARTSWITH "C:\\Windows\\SoftwareDistribution\\") OR where(ImageLoaded ISTARTSWITH "C:\\Windows\\System32\\") OR where(ImageLoaded ISTARTSWITH "C:\\Windows\\SystemTemp\\") OR where(ImageLoaded ISTARTSWITH "C:\\Windows\\SysWOW64\\") OR where(ImageLoaded ISTARTSWITH "C:\\Windows\\WinSxS\\")))) AND NOT (((where(ImageLoaded ICONTAINS "opera\\Opera Installer Temp\\opera_package") AND where(ImageLoaded IENDSWITH "\\assistant\\dbgcore.dll")) OR (where(ImageLoaded IENDSWITH "\\Steam\\bin\\cef\\cef.win7x64\\dbgcore.dll")))))
