// Title: Suspicious Processes Spawned by Java.EXE
// ID: 0d34ed8b-1c12-4ff2-828c-16fc860b766d
// Status: test
// Level: high
// Author: Andreas Hunkeler (@Karneades), Florian Roth
// Date: 2021-12-17
// Tags: attack.initial-access, attack.persistence, attack.privilege-escalation
// Description: Detects suspicious processes spawned from a Java host process which could indicate a sign of exploitation (e.g. log4j)
// Converted by: Sigma Universal SIEM/EDR CLI

(where(ParentImage IENDSWITH "\\java.exe") AND (where(Image IENDSWITH "\\AppVLP.exe") OR where(Image IENDSWITH "\\bitsadmin.exe") OR where(Image IENDSWITH "\\certutil.exe") OR where(Image IENDSWITH "\\cscript.exe") OR where(Image IENDSWITH "\\curl.exe") OR where(Image IENDSWITH "\\forfiles.exe") OR where(Image IENDSWITH "\\hh.exe") OR where(Image IENDSWITH "\\mftrace.exe") OR where(Image IENDSWITH "\\mshta.exe") OR where(Image IENDSWITH "\\net.exe") OR where(Image IENDSWITH "\\net1.exe") OR where(Image IENDSWITH "\\query.exe") OR where(Image IENDSWITH "\\reg.exe") OR where(Image IENDSWITH "\\regsvr32.exe") OR where(Image IENDSWITH "\\rundll32.exe") OR where(Image IENDSWITH "\\schtasks.exe") OR where(Image IENDSWITH "\\scrcons.exe") OR where(Image IENDSWITH "\\scriptrunner.exe") OR where(Image IENDSWITH "\\sh.exe") OR where(Image IENDSWITH "\\systeminfo.exe") OR where(Image IENDSWITH "\\whoami.exe") OR where(Image IENDSWITH "\\wmic.exe") OR where(Image IENDSWITH "\\wscript.exe")))
