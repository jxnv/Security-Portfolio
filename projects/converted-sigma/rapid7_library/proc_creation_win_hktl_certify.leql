// Title: HackTool - Certify Execution
// ID: 762f2482-ff21-4970-8939-0aa317a886bb
// Status: test
// Level: high
// Author: pH-T (Nextron Systems)
// Date: 2023-04-17
// Tags: attack.discovery, attack.credential-access, attack.t1649
// Description: Detects Certify a tool for Active Directory certificate abuse based on PE metadata characteristics and common command line arguments.
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "\\Certify.exe")) OR (where(OriginalFileName = "Certify.exe")) OR (where(Description ICONTAINS "Certify"))) OR (((where(CommandLine ICONTAINS ".exe cas ") OR where(CommandLine ICONTAINS ".exe find ") OR where(CommandLine ICONTAINS ".exe pkiobjects ") OR where(CommandLine ICONTAINS ".exe request ") OR where(CommandLine ICONTAINS ".exe download "))) AND ((where(CommandLine ICONTAINS " /vulnerable") OR where(CommandLine ICONTAINS " /template:") OR where(CommandLine ICONTAINS " /altname:") OR where(CommandLine ICONTAINS " /domain:") OR where(CommandLine ICONTAINS " /path:") OR where(CommandLine ICONTAINS " /ca:")))))
