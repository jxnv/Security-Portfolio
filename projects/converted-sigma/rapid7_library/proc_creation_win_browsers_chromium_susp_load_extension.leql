// Title: Suspicious Chromium Browser Instance Executed With Custom Extension
// ID: 27ba3207-dd30-4812-abbf-5d20c57d474e
// Status: test
// Level: high
// Author: Aedan Russell, frack113, X__Junior (Nextron Systems)
// Date: 2022-06-19
// Tags: attack.persistence, attack.t1176.001
// Description: Detects a suspicious process spawning a Chromium based browser process with the 'load-extension' flag to start an instance with a custom extension
// Converted by: Sigma Universal SIEM/EDR CLI

((where(ParentImage IENDSWITH "\\cmd.exe") OR where(ParentImage IENDSWITH "\\cscript.exe") OR where(ParentImage IENDSWITH "\\mshta.exe") OR where(ParentImage IENDSWITH "\\powershell.exe") OR where(ParentImage IENDSWITH "\\pwsh.exe") OR where(ParentImage IENDSWITH "\\regsvr32.exe") OR where(ParentImage IENDSWITH "\\rundll32.exe") OR where(ParentImage IENDSWITH "\\wscript.exe")) AND (where(Image IENDSWITH "\\brave.exe") OR where(Image IENDSWITH "\\chrome.exe") OR where(Image IENDSWITH "\\msedge.exe") OR where(Image IENDSWITH "\\opera.exe") OR where(Image IENDSWITH "\\vivaldi.exe")) AND where(CommandLine ICONTAINS "--load-extension="))
