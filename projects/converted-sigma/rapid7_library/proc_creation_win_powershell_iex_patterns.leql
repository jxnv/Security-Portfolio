// Title: Suspicious PowerShell IEX Execution Patterns
// ID: 09576804-7a05-458e-a817-eb718ca91f54
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-03-24
// Tags: attack.execution, attack.t1059.001
// Description: Detects suspicious ways to run Invoke-Execution using IEX alias
// Converted by: Sigma Universal SIEM/EDR CLI

((((where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe")) AND (where(CommandLine ICONTAINS " | iex;") OR where(CommandLine ICONTAINS " | iex ") OR where(CommandLine ICONTAINS " | iex}") OR where(CommandLine ICONTAINS " | IEX ;") OR where(CommandLine ICONTAINS " | IEX -Error") OR where(CommandLine ICONTAINS " | IEX (new") OR where(CommandLine ICONTAINS ");IEX "))) AND ((where(CommandLine ICONTAINS "::FromBase64String") OR where(CommandLine ICONTAINS ".GetString([System.Convert]::")))) OR ((where(CommandLine ICONTAINS ")|iex;$") OR where(CommandLine ICONTAINS ");iex($") OR where(CommandLine ICONTAINS ");iex $") OR where(CommandLine ICONTAINS " | IEX | ") OR where(CommandLine ICONTAINS " | iex\\\""))))
