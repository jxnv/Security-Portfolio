// Title: HackTool - Bloodhound/Sharphound Execution
// ID: f376c8a7-a2d0-4ddc-aa0c-16c17236d962
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2019-12-20
// Tags: attack.discovery, attack.t1087.001, attack.t1087.002, attack.t1482, attack.t1069.001, attack.t1069.002, attack.execution, attack.t1059.001
// Description: Detects command line parameters used by Bloodhound and Sharphound hack tools
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS " -CollectionMethod All ") OR where(CommandLine ICONTAINS " --CollectionMethods Session ") OR where(CommandLine ICONTAINS " --Loop --Loopduration ") OR where(CommandLine ICONTAINS " --PortScanTimeout ") OR where(CommandLine ICONTAINS ".exe -c All -d ") OR where(CommandLine ICONTAINS "Invoke-Bloodhound") OR where(CommandLine ICONTAINS "Get-BloodHoundData"))) OR ((where(CommandLine ICONTAINS " -JsonFolder ") AND where(CommandLine ICONTAINS " -ZipFileName "))) OR ((where(CommandLine ICONTAINS " DCOnly ") AND where(CommandLine ICONTAINS " --NoSaveCache "))) OR ((where(Product ICONTAINS "SharpHound")) OR (where(Description ICONTAINS "SharpHound")) OR ((where(Company ICONTAINS "SpecterOps") OR where(Company ICONTAINS "evil corp"))) OR ((where(Image ICONTAINS "\\Bloodhound.exe") OR where(Image ICONTAINS "\\SharpHound.exe")))))
