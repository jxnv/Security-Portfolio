// Title: Suspicious Non-Browser Network Communication With Google API
// ID: 7e9cf7b6-e827-11ed-a05b-0242ac120003
// Status: experimental
// Level: medium
// Author: Gavin Knapp
// Date: 2023-05-01
// Tags: attack.command-and-control, attack.t1102
// Description: Detects a non-browser process interacting with the Google API which could indicate the use of a covert C2 such as Google Sheet C2 (GC2-sheet)
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(DestinationHostname ICONTAINS "drive.googleapis.com") OR where(DestinationHostname ICONTAINS "oauth2.googleapis.com") OR where(DestinationHostname ICONTAINS "sheets.googleapis.com") OR where(DestinationHostname ICONTAINS "www.googleapis.com"))) AND NOT (((where(Image = "")) OR (NOT Image=*))) AND NOT (((where(Image IENDSWITH "\\brave.exe")) OR ((where(Image IENDSWITH ":\\Program Files\\Google\\Chrome\\Application\\chrome.exe") OR where(Image IENDSWITH ":\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe"))) OR ((where(Image ICONTAINS ":\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\")) OR ((where(Image IENDSWITH ":\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe") OR where(Image IENDSWITH ":\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe") OR where(Image IENDSWITH "\\WindowsApps\\MicrosoftEdge.exe")))) OR ((where(Image ICONTAINS ":\\Program Files (x86)\\Microsoft\\EdgeCore\\") OR where(Image ICONTAINS ":\\Program Files\\Microsoft\\EdgeCore\\")) AND (where(Image IENDSWITH "\\msedge.exe") OR where(Image IENDSWITH "\\msedgewebview2.exe"))) OR ((where(Image IENDSWITH ":\\Program Files\\Mozilla Firefox\\firefox.exe") OR where(Image IENDSWITH ":\\Program Files (x86)\\Mozilla Firefox\\firefox.exe"))) OR (where(Image ICONTAINS ":\\Program Files\\Google\\Drive File Stream\\") AND where(Image IENDSWITH "\\GoogleDriveFS.exe")) OR (where(Image IENDSWITH "\\GoogleUpdate.exe")) OR ((where(Image IENDSWITH ":\\Program Files (x86)\\Internet Explorer\\iexplore.exe") OR where(Image IENDSWITH ":\\Program Files\\Internet Explorer\\iexplore.exe"))) OR (where(Image IENDSWITH "\\maxthon.exe")) OR (where(Image IENDSWITH "\\opera.exe")) OR (where(Image IENDSWITH "\\outlook.exe")) OR (where(Image IENDSWITH "\\safari.exe")) OR (where(Image IENDSWITH "\\seamonkey.exe")) OR (where(Image IENDSWITH "\\vivaldi.exe")) OR (where(Image IENDSWITH "\\whale.exe")))))
