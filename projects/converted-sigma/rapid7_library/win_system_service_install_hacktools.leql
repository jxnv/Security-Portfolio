// Title: HackTool Service Registration or Execution
// ID: d26ce60c-2151-403c-9a42-49420d87b5e4
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-21
// Tags: attack.execution, attack.t1569.002, attack.s0029
// Description: Detects installation or execution of services
// Converted by: Sigma Universal SIEM/EDR CLI

((where(Provider_Name = "Service Control Manager") AND (where(EventID = "7045") OR where(EventID = "7036"))) AND ((where(ImagePath ICONTAINS "bypass")) OR ((where(ServiceName ICONTAINS "cachedump") OR where(ServiceName ICONTAINS "DumpSvc") OR where(ServiceName ICONTAINS "gsecdump") OR where(ServiceName ICONTAINS "pwdump") OR where(ServiceName ICONTAINS "UACBypassedService") OR where(ServiceName ICONTAINS "WCE SERVICE") OR where(ServiceName ICONTAINS "WCESERVICE") OR where(ServiceName ICONTAINS "winexesvc")))))
