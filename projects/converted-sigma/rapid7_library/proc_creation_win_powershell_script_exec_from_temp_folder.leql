// Title: Potentially Suspicious Powershell Script Execution From Temp Folder
// ID: a6a39bdb-935c-4f0a-ab77-35f4bbf44d33
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), Max Altgelt (Nextron Systems), Tim Shelton
// Date: 2021-07-14
// Tags: attack.execution, attack.t1059.001
// Description: Detects a potentially suspicious powershell script executions from temporary folder
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Image IENDSWITH "\\powershell.exe") OR where(Image IENDSWITH "\\pwsh.exe")) AND (where(CommandLine ICONTAINS "\\Windows\\Temp") OR where(CommandLine ICONTAINS "\\Temporary Internet") OR where(CommandLine ICONTAINS "\\AppData\\Local\\Temp") OR where(CommandLine ICONTAINS "\\AppData\\Roaming\\Temp") OR where(CommandLine ICONTAINS "%TEMP%") OR where(CommandLine ICONTAINS "%TMP%") OR where(CommandLine ICONTAINS "%LocalAppData%\\Temp"))) AND NOT (((where(CommandLine ICONTAINS "\\Windows\\system32\\config\\systemprofile\\AppData\\Local\\Temp\\Amazon\\EC2-Windows\\")) OR ((where(ParentImage = "C:\\Windows\\System32\\Msiexec.exe") OR where(ParentImage = "C:\\Windows\\SysWOW64\\Msiexec.exe")) AND where(Image IENDSWITH "\\powershell.exe") AND (where(CommandLine ICONTAINS "-NoProfile -ExecutionPolicy Bypass -Command") AND where(CommandLine ICONTAINS "AppData\\Local\\Temp\\") AND where(CommandLine ICONTAINS "Install-Chocolatey.ps1"))) OR ((where(CommandLine ICONTAINS " >") OR where(CommandLine ICONTAINS "Out-File") OR where(CommandLine ICONTAINS "ConvertTo-Json"))) OR (where(CommandLine ICONTAINS "-WindowStyle hidden -Verb runAs")))))
