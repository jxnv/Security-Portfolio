// Title: HackTool - KrbRelayUp Execution
// ID: 12827a56-61a4-476a-a9cb-f3068f191073
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-04-26
// Tags: attack.credential-access, attack.t1558.003, attack.lateral-movement, attack.t1550.003
// Description: Detects KrbRelayUp used to perform a universal no-fix local privilege escalation in Windows domain environments where LDAP signing is not enforced
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(CommandLine ICONTAINS " relay ") AND where(CommandLine ICONTAINS " -Domain ") AND where(CommandLine ICONTAINS " -ComputerName "))) OR ((where(CommandLine ICONTAINS " krbscm ") AND where(CommandLine ICONTAINS " -sc "))) OR ((where(CommandLine ICONTAINS " spawn ") AND where(CommandLine ICONTAINS " -d ") AND where(CommandLine ICONTAINS " -cn ") AND where(CommandLine ICONTAINS " -cp "))) OR ((where(Image IENDSWITH "\\KrbRelayUp.exe")) OR (where(OriginalFileName = "KrbRelayUp.exe"))))
