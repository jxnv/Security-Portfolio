// Description: Detects Obfuscated Powershell via COMPRESS OBFUSCATION
// Converted by: Sigma Universal SIEM/EDR CLI

(where(EventID = "4697") AND (where(ServiceFileName ICONTAINS "new-object") AND where(ServiceFileName ICONTAINS "text.encoding]::ascii") AND where(ServiceFileName ICONTAINS "readtoend")) AND (where(ServiceFileName ICONTAINS "system.io.compression.deflatestream") OR where(ServiceFileName ICONTAINS "system.io.streamreader")))
