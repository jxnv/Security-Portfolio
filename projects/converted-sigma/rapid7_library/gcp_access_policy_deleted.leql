// Title: GCP Access Policy Deleted
// ID: 32438676-1dba-4ac7-bf69-b86cba995e05
// Status: test
// Level: medium
// Author: Bryan Lim
// Date: 2024-01-12
// Tags: attack.persistence, attack.privilege-escalation, attack.t1098
// Description: Detects when an access policy that is applied to a GCP cloud resource is deleted.
// An adversary would be able to remove access policies to gain access to a GCP cloud resource.
// Converted by: Sigma Universal SIEM/EDR CLI

((where(data.protoPayload.authorizationInfo.permission = "accesscontextmanager.accessPolicies.delete") OR where(data.protoPayload.authorizationInfo.permission = "accesscontextmanager.accessPolicies.accessLevels.delete") OR where(data.protoPayload.authorizationInfo.permission = "accesscontextmanager.accessPolicies.accessZones.delete") OR where(data.protoPayload.authorizationInfo.permission = "accesscontextmanager.accessPolicies.authorizedOrgsDescs.delete")) AND where(data.protoPayload.authorizationInfo.granted = "true") AND where(data.protoPayload.serviceName = "accesscontextmanager.googleapis.com"))
