// Title: Unusual File Download From File Sharing Websites - File Stream
// ID: ae02ed70-11aa-4a22-b397-c0d0e8f6ea99
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-08-24
// Tags: attack.stealth, attack.s0139, attack.t1564.004
// Description: Detects the download of suspicious file type from a well-known file and paste sharing domain
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(Contents ICONTAINS ".githubusercontent.com") OR where(Contents ICONTAINS "0x0.st") OR where(Contents ICONTAINS "anonfiles.com") OR where(Contents ICONTAINS "bashupload.com") OR where(Contents ICONTAINS "cdn.discordapp.com") OR where(Contents ICONTAINS "chunk.io") OR where(Contents ICONTAINS "ddns.net") OR where(Contents ICONTAINS "dl.dropboxusercontent.com") OR where(Contents ICONTAINS "ghostbin.co") OR where(Contents ICONTAINS "github.com") OR where(Contents ICONTAINS "glitch.me") OR where(Contents ICONTAINS "gofile.io") OR where(Contents ICONTAINS "hastebin.com") OR where(Contents ICONTAINS "mediafire.com") OR where(Contents ICONTAINS "mega.nz") OR where(Contents ICONTAINS "onrender.com") OR where(Contents ICONTAINS "pages.dev") OR where(Contents ICONTAINS "paste.ee") OR where(Contents ICONTAINS "pastebin.com") OR where(Contents ICONTAINS "pastebin.pl") OR where(Contents ICONTAINS "pastetext.net") OR where(Contents ICONTAINS "pixeldrain.com") OR where(Contents ICONTAINS "privatlab.com") OR where(Contents ICONTAINS "privatlab.net") OR where(Contents ICONTAINS "send.exploit.in") OR where(Contents ICONTAINS "sendspace.com") OR where(Contents ICONTAINS "storage.googleapis.com") OR where(Contents ICONTAINS "storjshare.io") OR where(Contents ICONTAINS "supabase.co") OR where(Contents ICONTAINS "temp.sh") OR where(Contents ICONTAINS "transfer.sh") OR where(Contents ICONTAINS "trycloudflare.com") OR where(Contents ICONTAINS "ufile.io") OR where(Contents ICONTAINS "w3spaces.com") OR where(Contents ICONTAINS "workers.dev") OR where(Contents ICONTAINS "x0.at"))) AND ((where(TargetFilename ICONTAINS ".bat:Zone") OR where(TargetFilename ICONTAINS ".cmd:Zone") OR where(TargetFilename ICONTAINS ".ps1:Zone"))))
