// Title: CobaltStrike Named Pipe Patterns
// ID: 85adeb13-4fc9-4e68-8a4a-c7cb2c336eb7
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Christian Burkard (Nextron Systems)
// Date: 2021-07-30
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055, stp.1k
// Description: Detects the creation of a named pipe with a pattern found in CobaltStrike malleable C2 profiles
// Converted by: Sigma Universal SIEM/EDR CLI

(((where(PipeName ISTARTSWITH "\\Winsock2\\CatalogChangeListener-") AND where(PipeName IENDSWITH "-0,")) OR (((where(PipeName ISTARTSWITH "\\DserNamePipe") OR where(PipeName ISTARTSWITH "\\f4c3") OR where(PipeName ISTARTSWITH "\\f53f") OR where(PipeName ISTARTSWITH "\\fullduplex_") OR where(PipeName ISTARTSWITH "\\mojo.5688.8052.183894939787088877") OR where(PipeName ISTARTSWITH "\\mojo.5688.8052.35780273329370473") OR where(PipeName ISTARTSWITH "\\MsFteWds") OR where(PipeName ISTARTSWITH "\\msrpc_") OR where(PipeName ISTARTSWITH "\\mypipe-f") OR where(PipeName ISTARTSWITH "\\mypipe-h") OR where(PipeName ISTARTSWITH "\\ntsvcs") OR where(PipeName ISTARTSWITH "\\PGMessagePipe") OR where(PipeName ISTARTSWITH "\\rpc_") OR where(PipeName ISTARTSWITH "\\scerpc") OR where(PipeName ISTARTSWITH "\\SearchTextHarvester") OR where(PipeName ISTARTSWITH "\\spoolss") OR where(PipeName ISTARTSWITH "\\win_svc") OR where(PipeName ISTARTSWITH "\\win\\msrpc_") OR where(PipeName ISTARTSWITH "\\windows.update.manager") OR where(PipeName ISTARTSWITH "\\wkssvc"))) OR ((where(PipeName = "\\demoagent_11") OR where(PipeName = "\\demoagent_22"))))) AND NOT (((where(PipeName = "\\wkssvc") OR where(PipeName = "\\spoolss") OR where(PipeName = "\\scerpc") OR where(PipeName = "\\ntsvcs") OR where(PipeName = "\\SearchTextHarvester") OR where(PipeName = "\\PGMessagePipe") OR where(PipeName = "\\MsFteWds")))) AND NOT (((where(Image ICONTAINS ":\\Program Files\\Websense\\") OR where(Image ICONTAINS ":\\Program Files (x86)\\Websense\\")) AND (where(PipeName ISTARTSWITH "\\DserNamePipeR") OR where(PipeName ISTARTSWITH "\\DserNamePipeW")))))
