// Title: Potentially Suspicious Mofcomp Execution
// ID: 1dd05363-104e-4b4a-b963-196a534b03a1
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-12
// Tags: attack.stealth, attack.t1218
// Description: Detects execution of the "mofcomp" utility as a child of a suspicious shell or script running utility or by having a suspicious path in the commandline.
// The "mofcomp" utility parses a file containing MOF statements and adds the classes and class instances defined in the file to the WMI repository.
// Attackers abuse this utility to install malicious MOF scripts
// Converted by: Sigma Universal SIEM/EDR CLI

(((((ParentBaseFileName = /.*\\cmd.exe/i or ParentBaseFileName = /.*\\powershell.exe/i or ParentBaseFileName = /.*\\pwsh.exe/i or ParentBaseFileName = /.*\\wsl.exe/i or ParentBaseFileName = /.*\\wscript.exe/i or ParentBaseFileName = /.*\\cscript.exe/i)) or ((CommandLine = /*\\AppData\\Local\\Temp*/i or CommandLine = /*\\Contacts\\*/i or CommandLine = /*\\Favorites\\*/i or CommandLine = /*\\Favourites\\*/i or CommandLine = /*\\Music\\*/i or CommandLine = /*\\Pictures\\*/i or CommandLine = /*\\Users\\Public\\*/i or CommandLine = /*\\Videos\\*/i or CommandLine = /*\\WINDOWS\\Temp\\*/i or CommandLine = /*%appdata%*/i or CommandLine = /*%temp%*/i or CommandLine = /*%tmp%*/i))) and ((ImageFileName = /.*\\mofcomp.exe/i) or (OriginalFilename = "mofcomp.exe"))) and not(((ParentCommandLine = /.*\\InstallUtil.exe /Uninstall C:\\Windows\\CCM\\Microsoft.ConfigurationManager.SVProvider.dll/i and ParentBaseFileName = /.*\\InstallUtil.exe/i and (CommandLine = /*C:\\Windows\\TEMP*/i and CommandLine = /*.tmp*/i)) or (ParentBaseFileName = "C:\\Windows\\System32\\wbem\\WmiPrvSE.exe" and CommandLine = /*C:\\Windows\\TEMP\\*/i and CommandLine = /.*.mof/i))) and not((not(ParentCommandLine = *))))
