// Description: Detects the use of Inveigh a cross-platform .NET IPv4/IPv6 machine-in-the-middle tool
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*\\Inveigh.exe/i) or ((OriginalFilename = "\\Inveigh.exe" or OriginalFilename = "\\Inveigh.dll")) or (Description = "Inveigh") or ((CommandLine = /* -SpooferIP*/i or CommandLine = /* -ReplyToIPs */i or CommandLine = /* -ReplyToDomains */i or CommandLine = /* -ReplyToMACs */i or CommandLine = /* -SnifferIP*/i)))
