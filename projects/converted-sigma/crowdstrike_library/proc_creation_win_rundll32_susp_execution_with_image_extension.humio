// Title: Suspicious Rundll32 Execution With Image Extension
// ID: 4aa6040b-3f28-44e3-a769-9208e5feb5ec
// Status: test
// Level: high
// Author: Hieu Tran
// Date: 2023-03-13
// Tags: attack.stealth, attack.t1218.011
// Description: Detects the execution of Rundll32.exe with DLL files masquerading as image files
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*.bmp*/i or CommandLine = /*.cr2*/i or CommandLine = /*.eps*/i or CommandLine = /*.gif*/i or CommandLine = /*.ico*/i or CommandLine = /*.jpeg*/i or CommandLine = /*.jpg*/i or CommandLine = /*.nef*/i or CommandLine = /*.orf*/i or CommandLine = /*.png*/i or CommandLine = /*.raw*/i or CommandLine = /*.sr2*/i or CommandLine = /*.tif*/i or CommandLine = /*.tiff*/i)) and ((ImageFileName = /.*\\rundll32.exe/i) or (OriginalFilename = "RUNDLL32.exe")))
