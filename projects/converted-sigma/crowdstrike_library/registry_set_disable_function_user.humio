// Title: Disable Internal Tools or Feature in Registry
// ID: e2482f8d-3443-4237-b906-cc145d87a076
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems), CrimpSec
// Date: 2022-03-18
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects registry modifications that change features of internal Windows tools (malware like Agent Tesla uses this technique)
// Converted by: Sigma Universal SIEM/EDR CLI

(((TargetObject = /.*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\ConsentPromptBehaviorAdmin/i or TargetObject = /.*Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\InactivityTimeoutSecs/i or TargetObject = /.*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\shutdownwithoutlogon/i or TargetObject = /.*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\PushNotifications\\ToastEnabled/i or TargetObject = /.*SYSTEM\\CurrentControlSet\\Control\\Storage\\Write Protection/i or TargetObject = /.*SYSTEM\\CurrentControlSet\\Control\\StorageDevicePolicies\\WriteProtect/i) and Details = "DWORD (0x00000000)") or ((TargetObject = /.*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\DisableCMD/i or TargetObject = /.*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\NoControlPanel/i or TargetObject = /.*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\NoRun/i or TargetObject = /.*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\StartMenuLogOff/i or TargetObject = /.*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\DisableChangePassword/i or TargetObject = /.*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\DisableLockWorkstation/i or TargetObject = /.*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\DisableRegistryTools/i or TargetObject = /.*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\DisableTaskmgr/i or TargetObject = /.*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\NoDispBackgroundPage/i or TargetObject = /.*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\NoDispCPL/i or TargetObject = /.*SOFTWARE\\Policies\\Microsoft\\Windows\\Explorer\\DisableNotificationCenter/i or TargetObject = /.*SOFTWARE\\Policies\\Microsoft\\Windows\\System\\DisableCMD/i) and Details = "DWORD (0x00000001)"))
