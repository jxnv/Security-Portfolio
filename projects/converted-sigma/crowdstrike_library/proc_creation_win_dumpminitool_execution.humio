// Title: DumpMinitool Execution
// ID: dee0a7a3-f200-4112-a99b-952196d81e42
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Florian Roth (Nextron Systems)
// Date: 2022-04-06
// Tags: attack.stealth, attack.t1036, attack.t1003.001, attack.credential-access
// Description: Detects the use of "DumpMinitool.exe" a tool that allows the dump of process memory via the use of the "MiniDumpWriteDump"
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /* Full*/i or CommandLine = /* Mini*/i or CommandLine = /* WithHeap*/i)) and (((ImageFileName = /.*\\DumpMinitool.exe/i or ImageFileName = /.*\\DumpMinitool.x86.exe/i or ImageFileName = /.*\\DumpMinitool.arm64.exe/i)) or ((OriginalFilename = "DumpMinitool.exe" or OriginalFilename = "DumpMinitool.x86.exe" or OriginalFilename = "DumpMinitool.arm64.exe"))))
