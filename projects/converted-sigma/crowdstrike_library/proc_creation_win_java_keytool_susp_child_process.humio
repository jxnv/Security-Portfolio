// Title: Suspicious Shells Spawn by Java Utility Keytool
// ID: 90fb5e62-ca1f-4e22-b42e-cc521874c938
// Status: test
// Level: high
// Author: Andreas Hunkeler (@Karneades)
// Date: 2021-12-22
// Tags: attack.initial-access, attack.persistence, attack.privilege-escalation
// Description: Detects suspicious shell spawn from Java utility keytool process (e.g. adselfservice plus exploitation)
// Converted by: Sigma Universal SIEM/EDR CLI

(ParentBaseFileName = /.*\\keytool.exe/i and (ImageFileName = /.*\\cmd.exe/i or ImageFileName = /.*\\sh.exe/i or ImageFileName = /.*\\bash.exe/i or ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i or ImageFileName = /.*\\schtasks.exe/i or ImageFileName = /.*\\certutil.exe/i or ImageFileName = /.*\\whoami.exe/i or ImageFileName = /.*\\bitsadmin.exe/i or ImageFileName = /.*\\wscript.exe/i or ImageFileName = /.*\\cscript.exe/i or ImageFileName = /.*\\scrcons.exe/i or ImageFileName = /.*\\regsvr32.exe/i or ImageFileName = /.*\\hh.exe/i or ImageFileName = /.*\\wmic.exe/i or ImageFileName = /.*\\mshta.exe/i or ImageFileName = /.*\\rundll32.exe/i or ImageFileName = /.*\\forfiles.exe/i or ImageFileName = /.*\\scriptrunner.exe/i or ImageFileName = /.*\\mftrace.exe/i or ImageFileName = /.*\\AppVLP.exe/i or ImageFileName = /.*\\systeminfo.exe/i or ImageFileName = /.*\\reg.exe/i or ImageFileName = /.*\\query.exe/i))
