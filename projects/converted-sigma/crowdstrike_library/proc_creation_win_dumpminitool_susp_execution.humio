((((ImageFileName = /.*\\DumpMinitool.exe/i or ImageFileName = /.*\\DumpMinitool.x86.exe/i or ImageFileName = /.*\\DumpMinitool.arm64.exe/i)) or ((OriginalFilename = "DumpMinitool.exe" or OriginalFilename = "DumpMinitool.x86.exe" or OriginalFilename = "DumpMinitool.arm64.exe"))) and (not(((ImageFileName = /*\\Microsoft Visual Studio\\*/i or ImageFileName = /*\\Extensions\\*/i))) or (CommandLine = /*.txt*/i) or (((CommandLine = /* Full*/i or CommandLine = /* Mini*/i or CommandLine = /* WithHeap*/i)) and not((CommandLine = /*--dumpType*/i)))))
