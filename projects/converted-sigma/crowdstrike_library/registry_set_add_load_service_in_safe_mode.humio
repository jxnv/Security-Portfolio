// Tags: attack.stealth, attack.t1564.001
// Description: Detects the modification of the registry to allow a driver or service to persist in Safe Mode.
// Converted by: Sigma Universal SIEM/EDR CLI

(((TargetObject = /*\\Control\\SafeBoot\\Minimal\\*/i or TargetObject = /*\\Control\\SafeBoot\\Network\\*/i) and TargetObject = /.*\\(Default)/i and Details = "Service") and not(((ImageFileName = "C:\\Hexnode\\Hexnode Agent\\Current\\HexnodeAgent.exe" and (TargetObject = /.*\\Control\\SafeBoot\\Minimal\\Hexnode Updater\\(Default)/i or TargetObject = /.*\\Control\\SafeBoot\\Network\\Hexnode Updater\\(Default)/i or TargetObject = /.*\\Control\\SafeBoot\\Minimal\\Hexnode Agent\\(Default)/i or TargetObject = /.*\\Control\\SafeBoot\\Network\\Hexnode Agent\\(Default)/i) and Details = "Service") or (ImageFileName = /.*\\MBAMInstallerService.exe/i and TargetObject = /.*\\MBAMService\\(Default)/i and Details = "Service") or (ImageFileName = "C:\\WINDOWS\\system32\\msiexec.exe" and (TargetObject = /.*\\Control\\SafeBoot\\Minimal\\SAVService\\(Default)/i or TargetObject = /.*\\Control\\SafeBoot\\Network\\SAVService\\(Default)/i)))))
