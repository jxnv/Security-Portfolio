// Title: Renamed AutoHotkey.EXE Execution
// ID: 0f16d9cf-0616-45c8-8fad-becc11b5a41c
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali
// Date: 2023-02-07
// Tags: attack.stealth
// Description: Detects execution of a renamed autohotkey.exe binary based on PE metadata fields
// Converted by: Sigma Universal SIEM/EDR CLI

(((Product = /*AutoHotkey*/i) or (Description = /*AutoHotkey*/i) or ((OriginalFilename = "AutoHotkey.exe" or OriginalFilename = "AutoHotkey.rc"))) and not((((ImageFileName = /.*\\AutoHotkey.exe/i or ImageFileName = /.*\\AutoHotkey32.exe/i or ImageFileName = /.*\\AutoHotkey32_UIA.exe/i or ImageFileName = /.*\\AutoHotkey64.exe/i or ImageFileName = /.*\\AutoHotkey64_UIA.exe/i or ImageFileName = /.*\\AutoHotkeyA32.exe/i or ImageFileName = /.*\\AutoHotkeyA32_UIA.exe/i or ImageFileName = /.*\\AutoHotkeyU32.exe/i or ImageFileName = /.*\\AutoHotkeyU32_UIA.exe/i or ImageFileName = /.*\\AutoHotkeyU64.exe/i or ImageFileName = /.*\\AutoHotkeyU64_UIA.exe/i)) or (ImageFileName = /*\\AutoHotkey*/i))))
