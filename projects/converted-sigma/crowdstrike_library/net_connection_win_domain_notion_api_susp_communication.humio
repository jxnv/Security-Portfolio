// Title: Potentially Suspicious Network Connection To Notion API
// ID: 7e9cf7b6-e827-11ed-a05b-15959c120003
// Status: test
// Level: low
// Author: Gavin Knapp
// Date: 2023-05-03
// Tags: attack.command-and-control, attack.t1102
// Description: Detects a non-browser process communicating with the Notion API. This could indicate potential use of a covert C2 channel such as "OffensiveNotion C2"
// Converted by: Sigma Universal SIEM/EDR CLI

((DestinationHostname = /*api.notion.com*/i) and not(((ImageFileName = /.*\\brave.exe/i) or ((ImageFileName = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or ImageFileName = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or ((ImageFileName = /C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\.*/i) or (ImageFileName = /.*\\WindowsApps\\MicrosoftEdge.exe/i) or ((ImageFileName = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or ImageFileName = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((ImageFileName = /C:\\Program Files (x86)\\Microsoft\\EdgeCore\\.*/i or ImageFileName = /C:\\Program Files\\Microsoft\\EdgeCore\\.*/i) and (ImageFileName = /.*\\msedge.exe/i or ImageFileName = /.*\\msedgewebview2.exe/i)) or ((ImageFileName = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or ImageFileName = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or ((ImageFileName = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or ImageFileName = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (ImageFileName = /.*\\maxthon.exe/i) or (ImageFileName = /.*\\AppData\\Local\\Programs\\Notion\\Notion.exe/i) or (ImageFileName = /.*\\opera.exe/i) or (ImageFileName = /.*\\safari.exe/i) or (ImageFileName = /.*\\seamonkey.exe/i) or (ImageFileName = /.*\\vivaldi.exe/i) or (ImageFileName = /.*\\whale.exe/i))))
