ileName = /C:\\Program Files (x86)\\Microsoft\\EdgeCore\\.*/i or ImageFileName = /C:\\Program Files\\Microsoft\\EdgeCore\\.*/i) and (ImageFileName = /.*\\msedge.exe/i or ImageFileName = /.*\\msedgewebview2.exe/i)) or ((ImageFileName = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or ImageFileName = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or ((ImageFileName = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or ImageFileName = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (ImageFileName = /.*\\maxthon.exe/i) or (ImageFileName = /.*\\opera.exe/i) or (ImageFileName = /.*\\safari.exe/i) or (ImageFileName = /.*\\seamonkey.exe/i) or (ImageFileName = /.*\\vivaldi.exe/i) or (ImageFileName = /.*\\whale.exe/i))))
