// Title: Suspicious Group And Account Reconnaissance Activity Using Net.EXE
// ID: d95de845-b83c-4a9a-8a6a-4fc802ebf6c0
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), omkar72, @svch0st, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-01-16
// Tags: attack.discovery, attack.t1087.001, attack.t1087.002
// Description: Detects suspicious reconnaissance command line activity on Windows systems using Net.EXE
// Check if the user that executed the commands is suspicious (e.g. service accounts, LOCAL_SYSTEM)
// Converted by: Sigma Universal SIEM/EDR CLI

((((ImageFileName = /.*\\net.exe/i or ImageFileName = /.*\\net1.exe/i)) or ((OriginalFilename = "net.exe" or OriginalFilename = "net1.exe"))) and (((((CommandLine = /*domain admins*/i or CommandLine = /* administrator*/i or CommandLine = /* administrateur*/i or CommandLine = /*enterprise admins*/i or CommandLine = /*Exchange Trusted Subsystem*/i or CommandLine = /*Remote Desktop Users*/i or CommandLine = /*Utilisateurs du Bureau à distance*/i or CommandLine = /*Usuarios de escritorio remoto*/i or CommandLine = /* /do*/i)) and ((CommandLine = /* group */i or CommandLine = /* localgroup */i))) and not((CommandLine = /* /add*/i))) or ((CommandLine = /* /do*/i) and (CommandLine = /* accounts */i))))
