// Title: Potential Persistence Via Notepad++ Plugins
// ID: 54127bd4-f541-4ac3-afdb-ea073f63f692
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-10
// Tags: attack.persistence
// Description: Detects creation of new ".dll" files inside the plugins directory of a notepad++ installation by a process other than "gup.exe". Which could indicates possible persistence
// Converted by: Sigma Universal SIEM/EDR CLI

((TargetFileName = /*\\Notepad++\\plugins\\*/i and TargetFileName = /.*.dll/i) and not(((ImageFileName = /.*\\Notepad++\\updater\\gup.exe/i) or (ImageFileName = /C:\\Users\\.*/i and ImageFileName = /*\\AppData\\Local\\Temp\\*/i and (ImageFileName = /.*\\target.exe/i or ImageFileName = /.*Installer.x64.exe/i)) or (ImageFileName = /*\\npp.*/i and ImageFileName = /.*.exe/i and (TargetFileName = "C:\\Program Files\\Notepad++\\plugins\\NppExport\\NppExport.dll" or TargetFileName = "C:\\Program Files\\Notepad++\\plugins\\mimeTools\\mimeTools.dll" or TargetFileName = "C:\\Program Files\\Notepad++\\plugins\\NppConverter\\NppConverter.dll" or TargetFileName = "C:\\Program Files\\Notepad++\\plugins\\Config\\nppPluginList.dll")))))
