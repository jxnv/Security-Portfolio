// Description: Detects System Information Discovery commands
// Converted by: Sigma Universal SIEM/EDR CLI

((type = "PATH" and (name = "/etc/lsb-release" or name = "/etc/redhat-release" or name = "/etc/issue")) or (type = "EXECVE" and (a0 = "uname" or a0 = "uptime" or a0 = "lsmod" or a0 = "hostname" or a0 = "env")) or (type = "EXECVE" and a0 = "grep" and (a1 = /*vbox*/i or a1 = /*vm*/i or a1 = /*xen*/i or a1 = /*virtio*/i or a1 = /*hv*/i)) or (type = "EXECVE" and a0 = "kmod" and a1 = "list"))
