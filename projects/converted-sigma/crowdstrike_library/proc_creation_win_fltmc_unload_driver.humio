// Title: Filter Driver Unloaded Via Fltmc.EXE
// ID: 4931188c-178e-4ee7-a348-39e8a7a56821
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-13
// Tags: attack.stealth, attack.defense-impairment, attack.t1070, attack.t1685, attack.t1685.001
// Description: Detect filter driver unloading activity via fltmc.exe
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*unload*/i) and ((ImageFileName = /.*\\fltMC.exe/i) or (OriginalFilename = "fltMC.exe"))) and not((((ParentBaseFileName = /*\\AppData\\Local\\Temp\\*/i or ParentBaseFileName = /*:\\Windows\\Temp\\*/i) and ParentBaseFileName = /.*\\endpoint-protection-installer-x64.tmp/i and (CommandLine = /.*unload rtp_filesystem_filter/i or CommandLine = /.*unload rtp_filter/i)) or (ParentBaseFileName = "C:\\Program Files (x86)\\ManageEngine\\uems_agent\\bin\\dcfaservice64.exe" and CommandLine = /.*unload DFMFilter/i))))
