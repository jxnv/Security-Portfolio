// Description: Detects execution of arbitrary DLLs or unsigned code via a ".csproj" files via Dotnet.EXE.
// Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine = /.*.csproj/i or CommandLine = /.*.csproj\"/i or CommandLine = /.*.dll/i or CommandLine = /.*.dll\"/i or CommandLine = /.*.csproj'/i or CommandLine = /.*.dll'/i)) and ((ImageFileName = /.*\\dotnet.exe/i) or (OriginalFilename = ".NET Host"))) and not(((ParentBaseFileName = "C:\\Program Files (x86)\\Notepad++\\notepad++.exe" or ParentBaseFileName = "C:\\Program Files\\Notepad++\\notepad++.exe") and (CommandLine = /*C:\\ProgramData\\CSScriptNpp\\*/i and CommandLine = /*-cscs_path:*/i and CommandLine = /*\\cs-script\\cscs.dll*/i))))
