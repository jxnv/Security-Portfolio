((((ParentBaseFileName = /.*\\java.exe/i or ParentBaseFileName = /.*\\javaw.exe/i) and (ParentBaseFileName = /*-tomcat-*/i or ParentBaseFileName = /*\\tomcat*/i)) or ((ParentBaseFileName = /.*\\java.exe/i or ParentBaseFileName = /.*\\javaw.exe/i) and (CommandLine = /*catalina.jar*/i or CommandLine = /*CATALINA_HOME*/i)) or ((ParentBaseFileName = /.*\\w3wp.exe/i or ParentBaseFileName = /.*\\php-cgi.exe/i or ParentBaseFileName = /.*\\nginx.exe/i or ParentBaseFileName = /.*\\httpd.exe/i or ParentBaseFileName = /.*\\caddy.exe/i or ParentBaseFileName = /.*\\ws_tomcatservice.exe/i))) and (((CommandLine = /*&cd&echo*/i or CommandLine = /*cd /d */i)) or (((ImageFileName = /.*\\dsquery.exe/i or ImageFileName = /.*\\find.exe/i or ImageFileName = /.*\\findstr.exe/i or ImageFileName = /.*\\ipconfig.exe/i or ImageFileName = /.*\\netstat.exe/i or ImageFileName = /.*\\nslookup.exe/i or ImageFileName = /.*\\pathping.exe/i or ImageFileName = /.*\\quser.exe/i or ImageFileName = /.*\\schtasks.exe/i or ImageFileName = /.*\\systeminfo.exe/i or ImageFileName = /.*\\tasklist.exe/i or ImageFileName = /.*\\tracert.exe/i or ImageFileName = /.*\\wevtutil.exe/i or ImageFileName = /.*\\whoami.exe/i)) or ((OriginalFilename = "dsquery.exe" or OriginalFilename = "find.exe" or OriginalFilename = "findstr.exe" or OriginalFilename = "ipconfig.exe" or OriginalFilename = "netstat.exe" or OriginalFilename = "nslookup.exe" or OriginalFilename = "pathping.exe" or OriginalFilename = "quser.exe" or OriginalFilename = "schtasks.exe" or OriginalFilename = "sysinfo.exe" or OriginalFilename = "tasklist.exe" or OriginalFilename = "tracert.exe" or OriginalFilename = "VSSADMIN.EXE" or OriginalFilename = "wevtutil.exe" or OriginalFilename = "whoami.exe"))) or ((CommandLine = /* Test-NetConnection */i or CommandLine = /*dir \\*/i)) or ((OriginalFilename = "net.exe" or OriginalFilename = "net1.exe") and (CommandLine = /* user */i or CommandLine = /* use */i or CommandLine = /* group */i)) or (OriginalFilename = "ping.exe" and CommandLine = /* -n */i) or ((ImageFileName = /.*\\cmd.exe/i or ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i) and (CommandLine = /* -enc */i or CommandLine = /* -EncodedCommand */i or CommandLine = /* -w hidden */i or CommandLine = /* -windowstyle hidden*/i or CommandLine = /*.WebClient).Download*/i)) or (OriginalFilename = "wmic.exe" and CommandLine = /* /node:*/i)))
