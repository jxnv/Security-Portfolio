// Title: Deletion of Volume Shadow Copies via WMI with PowerShell
// ID: 21ff4ca9-f13a-41ad-b828-0077b2af2e40
// Status: test
// Level: high
// Author: Tim Rauch, Elastic (idea)
// Date: 2022-09-20
// Tags: attack.impact, attack.t1490
// Description: Detects deletion of Windows Volume Shadow Copies with PowerShell code and Get-WMIObject. This technique is used by numerous ransomware families such as Sodinokibi/REvil
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*.Delete()*/i or CommandLine = /*Remove-WmiObject*/i or CommandLine = /*rwmi*/i or CommandLine = /*Remove-CimInstance*/i or CommandLine = /*rcim*/i)) and ((CommandLine = /*Get-WmiObject*/i or CommandLine = /*gwmi*/i or CommandLine = /*Get-CimInstance*/i or CommandLine = /*gcim*/i)) and (CommandLine = /*Win32_ShadowCopy*/i))
