// Title: Regsvr32 Execution From Potential Suspicious Location
// ID: 9525dc73-0327-438c-8c04-13c0e037e9da
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-26
// Tags: attack.stealth, attack.t1218.010
// Description: Detects execution of regsvr32 where the DLL is located in a potentially suspicious location.
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*:\\ProgramData\\*/i or CommandLine = /*:\\Temp\\*/i or CommandLine = /*:\\Users\\Public\\*/i or CommandLine = /*:\\Windows\\Temp\\*/i or CommandLine = /*\\AppData\\Local\\Temp\\*/i or CommandLine = /*\\AppData\\Roaming\\*/i)) and ((ImageFileName = /.*\\regsvr32.exe/i) or (OriginalFilename = "REGSVR32.EXE")))
