// Title: Suspicious DLL Loaded via CertOC.EXE
// ID: 84232095-ecca-4015-b0d7-7726507ee793
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-15
// Tags: attack.stealth, attack.t1218
// Description: Detects when a user installs certificates by using CertOC.exe to load the target DLL file.
// Converted by: Sigma Universal SIEM/EDR CLI

((CommandLine = /* -LoadDLL */i) and ((ImageFileName = /.*\\certoc.exe/i) or (OriginalFilename = "CertOC.exe")) and ((CommandLine = /*\\Appdata\\Local\\Temp\\*/i or CommandLine = /*\\Desktop\\*/i or CommandLine = /*\\Downloads\\*/i or CommandLine = /*\\Users\\Public\\*/i or CommandLine = /*C:\\Windows\\Tasks\\*/i or CommandLine = /*C:\\Windows\\Temp\\*/i)))
