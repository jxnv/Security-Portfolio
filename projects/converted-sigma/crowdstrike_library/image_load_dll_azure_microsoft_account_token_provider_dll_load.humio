// Title: Potential Azure Browser SSO Abuse
// ID: 50f852e6-af22-4c78-9ede-42ef36aa3453
// Status: test
// Level: low
// Author: Den Iuzvyk
// Date: 2020-07-15
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects abusing Azure Browser SSO by requesting OAuth 2.0 refresh tokens for an Azure-AD-authenticated Windows user (i.e. the machine is joined to Azure AD and a user logs in with their Azure AD account) wanting to perform SSO authentication in the browser.
// An attacker can use this to authenticate to Azure AD in a browser as that user.
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageLoaded = "C:\\Windows\\System32\\MicrosoftAccountTokenProvider.dll") and not(((ImageFileName = /C:\\Windows\\System32\\.*/i or ImageFileName = /C:\\Windows\\SysWOW64\\.*/i) and ImageFileName = /.*\\BackgroundTaskHost.exe/i)) and not((((ImageFileName = /C:\\Program Files\\Microsoft Visual Studio\\.*/i or ImageFileName = /C:\\Program Files (x86)\\Microsoft Visual Studio\\.*/i) and ImageFileName = /.*\\IDE\\devenv.exe/i) or ((ImageFileName = /C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\.*/i) or (ImageFileName = /.*\\WindowsApps\\MicrosoftEdge.exe/i) or ((ImageFileName = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or ImageFileName = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((ImageFileName = /C:\\Program Files (x86)\\Microsoft\\EdgeCore\\.*/i or ImageFileName = /C:\\Program Files\\Microsoft\\EdgeCore\\.*/i) and (ImageFileName = /.*\\msedge.exe/i or ImageFileName = /.*\\msedgewebview2.exe/i)) or ((ImageFileName = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or ImageFileName = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (not(ImageFileName = *)) or (ImageFileName = /.*\\AppData\\Local\\Microsoft\\OneDrive\\OneDrive.exe/i))))
