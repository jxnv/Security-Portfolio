// Title: Suspicious Appended Extension
// ID: e3f673b3-65d1-4d80-9146-466f8b63fa99
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-07-16
// Tags: attack.impact, attack.t1486
// Description: Detects file renames where the target filename uses an uncommon double extension. Could indicate potential ransomware activity renaming files and adding a custom extension to the encrypted files, such as ".jpg.crypted", ".docx.locky", etc.
// Converted by: Sigma Universal SIEM/EDR CLI

(((SourceFilename = /.*.doc/i or SourceFilename = /.*.docx/i or SourceFilename = /.*.jpeg/i or SourceFilename = /.*.jpg/i or SourceFilename = /.*.lnk/i or SourceFilename = /.*.pdf/i or SourceFilename = /.*.png/i or SourceFilename = /.*.pst/i or SourceFilename = /.*.rtf/i or SourceFilename = /.*.xls/i or SourceFilename = /.*.xlsx/i) and (TargetFileName = /*.doc.*/i or TargetFileName = /*.docx.*/i or TargetFileName = /*.jpeg.*/i or TargetFileName = /*.jpg.*/i or TargetFileName = /*.lnk.*/i or TargetFileName = /*.pdf.*/i or TargetFileName = /*.png.*/i or TargetFileName = /*.pst.*/i or TargetFileName = /*.rtf.*/i or TargetFileName = /*.xls.*/i or TargetFileName = /*.xlsx.*/i)) and not(((TargetFileName = /.*.backup/i or TargetFileName = /.*.bak/i or TargetFileName = /.*.old/i or TargetFileName = /.*.orig/i or TargetFileName = /.*.temp/i or TargetFileName = /.*.tmp/i))) and not((TargetFileName = /*:\\ProgramData\\Anaconda3\\*/i and TargetFileName = /.*.c~/i)))
