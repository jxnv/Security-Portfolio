// Title: .RDP File Created By Uncommon Application
// ID: fccfb43e-09a7-4bd2-8b37-a5a7df33386d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.stealth
// Description: Detects creation of a file with an ".rdp" extension by an application that doesn't commonly create such files.
// Converted by: Sigma Universal SIEM/EDR CLI

(TargetFileName = /.*.rdp/i and (ImageFileName = /.*\\brave.exe/i or ImageFileName = /.*\\CCleaner Browser\\Application\\CCleanerBrowser.exe/i or ImageFileName = /.*\\chromium.exe/i or ImageFileName = /.*\\firefox.exe/i or ImageFileName = /.*\\Google\\Chrome\\Application\\chrome.exe/i or ImageFileName = /.*\\iexplore.exe/i or ImageFileName = /.*\\microsoftedge.exe/i or ImageFileName = /.*\\msedge.exe/i or ImageFileName = /.*\\Opera.exe/i or ImageFileName = /.*\\Vivaldi.exe/i or ImageFileName = /.*\\Whale.exe/i or ImageFileName = /.*\\olk.exe/i or ImageFileName = /.*\\Outlook.exe/i or ImageFileName = /.*\\RuntimeBroker.exe/i or ImageFileName = /.*\\Thunderbird.exe/i or ImageFileName = /.*\\Discord.exe/i or ImageFileName = /.*\\Keybase.exe/i or ImageFileName = /.*\\msteams.exe/i or ImageFileName = /.*\\Slack.exe/i or ImageFileName = /.*\\teams.exe/i))
