// Title: Credential Manager Access By Uncommon Applications
// ID: 407aecb1-e762-4acf-8c7b-d087bcff3bb6
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-11
// Tags: attack.t1003, attack.credential-access
// Description: Detects suspicious processes based on name and location that access the windows credential manager and vault.
// Which can be a sign of credential stealing. Example case would be usage of mimikatz "dpapi::cred" function
// Converted by: Sigma Universal SIEM/EDR CLI

(((FileName = /*\\AppData\\Local\\Microsoft\\Credentials\\*/i or FileName = /*\\AppData\\Roaming\\Microsoft\\Credentials\\*/i or FileName = /*\\AppData\\Local\\Microsoft\\Vault\\*/i or FileName = /*\\ProgramData\\Microsoft\\Vault\\*/i)) and not(((ImageFileName = "C:\\Windows\\explorer.exe") or ((ImageFileName = /C:\\Program Files\\.*/i or ImageFileName = /C:\\Program Files (x86)\\.*/i or ImageFileName = /C:\\Windows\\system32\\.*/i or ImageFileName = /C:\\Windows\\SysWOW64\\.*/i)))))
