// Title: Suspicious Debugger Registration Cmdline
// ID: ae215552-081e-44c7-805f-be16f975c8a2
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), oscd.community, Jonhnathan Ribeiro
// Date: 2019-09-06
// Tags: attack.persistence, attack.privilege-escalation, attack.t1546.008
// Description: Detects the registration of a debugger for a program that is available in the logon screen (sticky key backdoor).
// Converted by: Sigma Universal SIEM/EDR CLI

((CommandLine = /*\\CurrentVersion\\Image File Execution Options\\*/i) and ((CommandLine = /*sethc.exe*/i or CommandLine = /*utilman.exe*/i or CommandLine = /*osk.exe*/i or CommandLine = /*magnify.exe*/i or CommandLine = /*narrator.exe*/i or CommandLine = /*displayswitch.exe*/i or CommandLine = /*atbroker.exe*/i or CommandLine = /*HelpPane.exe*/i)))
