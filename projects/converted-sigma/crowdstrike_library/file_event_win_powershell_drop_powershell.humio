// Title: PowerShell Script Dropped Via PowerShell.EXE
// ID: 576426ad-0131-4001-ae01-be175da0c108
// Status: test
// Level: low
// Author: frack113
// Date: 2023-05-09
// Tags: attack.persistence
// Description: Detects PowerShell creating a PowerShell file (.ps1). While often times this behavior is benign, sometimes it can be a sign of a dropper script trying to achieve persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

(((ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i) and TargetFileName = /.*.ps1/i) and not(((TargetFileName = /C:\\Users\\.*/i and TargetFileName = /*\\AppData\\Local\\Temp\\*/i) or (TargetFileName = /*__PSScriptPolicyTest_*/i) or (TargetFileName = /C:\\Windows\\Temp\\.*/i))))
