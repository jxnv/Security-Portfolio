(((ScriptBlockText = /*.Delete()*/i or ScriptBlockText = /*Remove-WmiObject*/i or ScriptBlockText = /*rwmi*/i or ScriptBlockText = /*Remove-CimInstance*/i or ScriptBlockText = /*rcim*/i)) and ((ScriptBlockText = /*Get-WmiObject*/i or ScriptBlockText = /*gwmi*/i or ScriptBlockText = /*Get-CimInstance*/i or ScriptBlockText = /*gcim*/i)) and (ScriptBlockText = /*Win32_ShadowCopy*/i))
