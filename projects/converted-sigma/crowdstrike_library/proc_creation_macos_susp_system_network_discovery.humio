// Description: Detects enumeration of local network configuration
// Converted by: Sigma Universal SIEM/EDR CLI

((((ImageFileName = /.*/arp/i or ImageFileName = /.*/ifconfig/i or ImageFileName = /.*/netstat/i or ImageFileName = /.*/networksetup/i or ImageFileName = /.*/socketfilterfw/i)) or (ImageFileName = "/usr/bin/defaults" and (CommandLine = /*/Library/Preferences/com.apple.alf*/i and CommandLine = /*read*/i))) and not((ParentBaseFileName = /.*/wifivelocityd/i)))
