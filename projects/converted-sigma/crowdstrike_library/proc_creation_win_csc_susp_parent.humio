// Converted by: Sigma Universal SIEM/EDR CLI

(((ImageFileName = /.*\\csc.exe/i) or (OriginalFilename = "csc.exe")) and (((ParentBaseFileName = /.*\\cscript.exe/i or ParentBaseFileName = /.*\\excel.exe/i or ParentBaseFileName = /.*\\mshta.exe/i or ParentBaseFileName = /.*\\onenote.exe/i or ParentBaseFileName = /.*\\outlook.exe/i or ParentBaseFileName = /.*\\powerpnt.exe/i or ParentBaseFileName = /.*\\winword.exe/i or ParentBaseFileName = /.*\\wscript.exe/i)) or ((ParentBaseFileName = /.*\\powershell.exe/i or ParentBaseFileName = /.*\\pwsh.exe/i) and (ParentCommandLine = /*-Encoded */i or ParentCommandLine = /*FromBase64String*/i)) or ((ParentCommandLine =~ /(?:[Pp]rogram[Dd]ata|%(?:[Ll]ocal)?[Aa]pp[Dd]ata%|\\[Aa]pp[Dd]ata\\(?:[Ll]ocal(?:[Ll]ow)?|[Rr]oaming))\\[^\\]{1,256}$/i) or ((ParentCommandLine = /*:\\PerfLogs\\*/i or ParentCommandLine = /*:\\Users\\Public\\*/i or ParentCommandLine = /*:\\Windows\\Temp\\*/i or ParentCommandLine = /*\\Temporary Internet*/i)) or ((ParentCommandLine = /*:\\Users\\*/i and ParentCommandLine = /*\\Favorites\\*/i)) or ((ParentCommandLine = /*:\\Users\\*/i and ParentCommandLine = /*\\Favourites\\*/i)) or ((ParentCommandLine = /*:\\Users\\*/i and ParentCommandLine = /*\\Contacts\\*/i)) or ((ParentCommandLine = /*:\\Users\\*/i and ParentCommandLine = /*\\Pictures\\*/i)))) and not((((ParentBaseFileName = /C:\\Program Files (x86)\\.*/i or ParentBaseFileName = /C:\\Program Files\\.*/i)) or (ParentBaseFileName = "C:\\Windows\\System32\\sdiagnhost.exe") or (ParentBaseFileName = "C:\\Windows\\System32\\inetsrv\\w3wp.exe"))) and not((((ParentCommandLine = /*JwB7ACIAZgBhAGkAbABlAGQAIgA6AHQAcgB1AGUALAAiAG0AcwBnACIAOgAiAEEAbgBzAGkAYgBsAGUAIAByAGUAcQB1AGkAcgBlAHMAIABQAG8AdwBlAHIAUwBoAGUAbABsACAAdgAzAC4AMAAgAG8AcgAgAG4AZQB3AGUAcgAiAH0AJw*/i or ParentCommandLine = /*cAewAiAGYAYQBpAGwAZQBkACIAOgB0AHIAdQBlACwAIgBtAHMAZwAiADoAIgBBAG4AcwBpAGIAbABlACAAcgBlAHEAdQBpAHIAZQBzACAAUABvAHcAZQByAFMAaABlAGwAbAAgAHYAMwAuADAAIABvAHIAIABuAGUAdwBlAHIAIgB9ACcA*/i or ParentCommandLine = /*nAHsAIgBmAGEAaQBsAGUAZAAiAD