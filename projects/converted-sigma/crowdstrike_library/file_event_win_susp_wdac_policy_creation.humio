// Title: Potentially Suspicious WDAC Policy File Creation
// ID: 1d2de8a6-4803-4fde-b85b-f58f3aa7a705
// Status: experimental
// Level: medium
// Author: X__Junior
// Date: 2025-02-07
// Tags: attack.defense-impairment
// Description: Detects suspicious Windows Defender Application Control (WDAC) policy file creation from abnormal processes that could be abused by attacker to block EDR/AV components while allowing their own malicious code to run on the system.
// Converted by: Sigma Universal SIEM/EDR CLI

((TargetFileName = /*\\Windows\\System32\\CodeIntegrity\\*/i) and not(((((CommandLine = /*ConvertFrom-CIPolicy -XmlFilePath*/i and CommandLine = /*-BinaryFilePath */i)) or (CommandLine = /*CiTool --update-policy*/i) or ((CommandLine = /*Copy-Item -Path*/i and CommandLine = /*-Destination*/i))) or ((ImageFileName = /.*\\Microsoft.ConfigurationManagement.exe/i or ImageFileName = /.*\\WDAC Wizard.exe/i or ImageFileName = /.*C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe/i or ImageFileName = /.*C:\\Program Files\\PowerShell\\7\\pwsh.exe/i or ImageFileName = /.*C:\\Windows\\System32\\dllhost.exe/i or ImageFileName = /.*C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe/i or ImageFileName = /.*C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe/i or ImageFileName = /.*C:\\Windows\\SysWOW64\\dllhost.exe/i or ImageFileName = /.*C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe/i or ImageFileName = /.*C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe/i)) or (ImageFileName = "System") or (ImageFileName = "C:\\Windows\\System32\\wuauclt.exe") or ((ImageFileName = "C:\\Windows\\UUS\\arm64\\wuaucltcore.exe" or ImageFileName = "C:\\Windows\\UUS\\Packages\\Preview\\arm64\\wuaucltcore.exe")))))
