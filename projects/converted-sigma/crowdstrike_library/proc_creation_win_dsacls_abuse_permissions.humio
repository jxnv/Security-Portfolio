// Tags: attack.stealth, attack.t1218
// Description: Detects usage of Dsacls to grant over permissive permissions
// Converted by: Sigma Universal SIEM/EDR CLI

((CommandLine = /* /G */i) and ((ImageFileName = /.*\\dsacls.exe/i) or (OriginalFilename = "DSACLS.EXE")) and ((CommandLine = /*GR*/i or CommandLine = /*GE*/i or CommandLine = /*GW*/i or CommandLine = /*GA*/i or CommandLine = /*WP*/i or CommandLine = /*WD*/i)))
