// Tags: attack.privilege-escalation, attack.defense-impairment, attack.t1484.001
// Description: Detect malicious GPO modifications can be used to implement many other malicious behaviors.
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*GroupPolicyRefreshTimeDC*/i or CommandLine = /*GroupPolicyRefreshTimeOffsetDC*/i or CommandLine = /*GroupPolicyRefreshTime*/i or CommandLine = /*GroupPolicyRefreshTimeOffset*/i or CommandLine = /*EnableSmartScreen*/i or CommandLine = /*ShellSmartScreenLevel*/i)) and (CommandLine = /*\\SOFTWARE\\Policies\\Microsoft\\Windows\\System*/i) and ((ImageFileName = /.*\\reg.exe/i) or (OriginalFilename = "reg.exe")))
