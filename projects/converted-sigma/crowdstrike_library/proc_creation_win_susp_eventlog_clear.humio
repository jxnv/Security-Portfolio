// Title: Suspicious Eventlog Clearing or Configuration Change Activity
// ID: cc36992a-4671-4f21-a91d-6c2b72a2edf5
// Status: stable
// Level: high
// Author: Ecco, Daniil Yugoslavskiy, oscd.community, D3F7A5105, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2019-09-26
// Tags: attack.defense-impairment, attack.t1685.005, attack.t1685.001, car.2016-04-002
// Description: Detects the clearing or configuration tampering of EventLog using utilities such as "wevtutil", "powershell" and "wmic".
// This technique were seen used by threat actors and ransomware strains in order to evade defenses.
// Converted by: Sigma Universal SIEM/EDR CLI

(((((CommandLine = /*clear-log */i or CommandLine = /* cl */i or CommandLine = /*set-log */i or CommandLine = /* sl */i or CommandLine = /*lfn:*/i)) and ((ImageFileName = /.*\\wevtutil.exe/i) or (OriginalFilename = "wevtutil.exe"))) or ((((CommandLine = /*Clear-EventLog */i or CommandLine = /*Remove-EventLog */i or CommandLine = /*Limit-EventLog */i or CommandLine = /*Clear-WinEvent */i)) or ((CommandLine = /*Eventing.Reader.EventLogSession*/i and CommandLine = /*ClearLog*/i)) or ((CommandLine = /*Diagnostics.EventLog*/i and CommandLine = /*Clear*/i))) and ((ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\powershell_ise.exe/i or ImageFileName = /.*\\pwsh.exe/i))) or ((ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\powershell_ise.exe/i or ImageFileName = /.*\\pwsh.exe/i or ImageFileName = /.*\\wmic.exe/i) and CommandLine = /*ClearEventLog*/i)) and not(((ParentBaseFileName = "C:\\Windows\\SysWOW64\\msiexec.exe" or ParentBaseFileName = "C:\\Windows\\System32\\msiexec.exe") and CommandLine = /* sl */i)))
