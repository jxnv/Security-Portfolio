// Title: Suspicious External WebDAV Execution
// ID: 1ae64f96-72b6-48b3-ad3d-e71dff6c6398
// Status: test
// Level: high
// Author: Ahmed Farouk
// Date: 2024-05-10
// Tags: attack.initial-access, attack.resource-development, attack.t1584, attack.t1566
// Description: Detects executables launched from external WebDAV shares using the WebDAV Explorer integration, commonly seen in initial access campaigns.
// Converted by: Sigma Universal SIEM/EDR CLI

((((c-uri = /.*.7z/i or c-uri = /.*.bat/i or c-uri = /.*.dat/i or c-uri = /.*.cmd/i or c-uri = /.*.exe/i or c-uri = /.*.js/i or c-uri = /.*.lnk/i or c-uri = /.*.ps1/i or c-uri = /.*.rar/i or c-uri = /.*.url/i or c-uri = /.*.vbe/i or c-uri = /.*.vbs/i or c-uri = /.*.zip/i)) and (c-useragent = /Microsoft-WebDAV-MiniRedir/.*/i and cs-method = "GET")) and not(((cidr(ip=dst_ip, subnet="127.0.0.0/8") or cidr(ip=dst_ip, subnet="10.0.0.0/8") or cidr(ip=dst_ip, subnet="172.16.0.0/12") or cidr(ip=dst_ip, subnet="192.168.0.0/16") or cidr(ip=dst_ip, subnet="169.254.0.0/16") or cidr(ip=dst_ip, subnet="::1/128") or cidr(ip=dst_ip, subnet="fe80::/10") or cidr(ip=dst_ip, subnet="fc00::/7")))))
