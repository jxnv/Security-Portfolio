// Title: Sdiagnhost Calling Suspicious Child Process
// ID: f3d39c45-de1a-4486-a687-ab126124f744
// Status: test
// Level: high
// Author: Nextron Systems, @Kostastsale
// Date: 2022-06-01
// Tags: attack.stealth, attack.t1036, attack.t1218
// Description: Detects sdiagnhost.exe calling a suspicious child process (e.g. used in exploits for Follina / CVE-2022-30190)
// Converted by: Sigma Universal SIEM/EDR CLI

((ParentBaseFileName = /.*\\sdiagnhost.exe/i and (ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i or ImageFileName = /.*\\cmd.exe/i or ImageFileName = /.*\\mshta.exe/i or ImageFileName = /.*\\cscript.exe/i or ImageFileName = /.*\\wscript.exe/i or ImageFileName = /.*\\taskkill.exe/i or ImageFileName = /.*\\regsvr32.exe/i or ImageFileName = /.*\\rundll32.exe/i or ImageFileName = /.*\\calc.exe/i)) and not(((ImageFileName = /.*\\cmd.exe/i and CommandLine = /*bits*/i) or (ImageFileName = /.*\\powershell.exe/i and (CommandLine = /.*-noprofile -/i or CommandLine = /.*-noprofile/i)))))
