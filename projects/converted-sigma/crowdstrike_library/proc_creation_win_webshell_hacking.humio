((((ParentBaseFileName = /.*\\java.exe/i or ParentBaseFileName = /.*\\javaw.exe/i) and (ParentBaseFileName = /*-tomcat-*/i or ParentBaseFileName = /*\\tomcat*/i)) or ((ParentBaseFileName = /.*\\java.exe/i or ParentBaseFileName = /.*\\javaw.exe/i) and (CommandLine = /*catalina.jar*/i or CommandLine = /*CATALINA_HOME*/i)) or ((ParentBaseFileName = /.*\\caddy.exe/i or ParentBaseFileName = /.*\\httpd.exe/i or ParentBaseFileName = /.*\\nginx.exe/i or ParentBaseFileName = /.*\\php-cgi.exe/i or ParentBaseFileName = /.*\\w3wp.exe/i or ParentBaseFileName = /.*\\ws_tomcatservice.exe/i))) and (((CommandLine = /*rundll32*/i and CommandLine = /*comsvcs*/i)) or ((CommandLine = /* -hp*/i and CommandLine = /* a */i and CommandLine = /* -m*/i)) or ((CommandLine = /*net*/i and CommandLine = /* user */i and CommandLine = /* /add*/i)) or ((CommandLine = /*net*/i and CommandLine = /* localgroup */i and CommandLine = /* administrators */i and CommandLine = /*/add*/i)) or ((ImageFileName = /.*\\ntdsutil.exe/i or ImageFileName = /.*\\ldifde.exe/i or ImageFileName = /.*\\adfind.exe/i or ImageFileName = /.*\\procdump.exe/i or ImageFileName = /.*\\Nanodump.exe/i or ImageFileName = /.*\\vssadmin.exe/i or ImageFileName = /.*\\fsutil.exe/i)) or ((CommandLine = /* -decode */i or CommandLine = /* -NoP */i or CommandLine = /* -W Hidden */i or CommandLine = /* /decode */i or CommandLine = /* /ticket:*/i or CommandLine = /* sekurlsa*/i or CommandLine = /*.dmp full*/i or CommandLine = /*.downloadfile(*/i or CommandLine = /*.downloadstring(*/i or CommandLine = /*FromBase64String*/i or CommandLine = /*process call create*/i or CommandLine = /*reg save */i or CommandLine = /*whoami /priv*/i))))
