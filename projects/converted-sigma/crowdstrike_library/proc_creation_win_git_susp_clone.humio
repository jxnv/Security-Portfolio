// Title: Suspicious Git Clone
// ID: aef9d1f1-7396-4e92-a927-4567c7a495c1
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-03
// Tags: attack.reconnaissance, attack.t1593.003
// Description: Detects execution of "git" in order to clone a remote repository that contain suspicious keywords which might be suspicious
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /* clone */i or CommandLine = /*git-remote-https */i)) and (((ImageFileName = /.*\\git.exe/i or ImageFileName = /.*\\git-remote-https.exe/i)) or (OriginalFilename = "git.exe")) and ((CommandLine = /*exploit*/i or CommandLine = /*Vulns*/i or CommandLine = /*vulnerability*/i or CommandLine = /*RemoteCodeExecution*/i or CommandLine = /*Invoke-*/i or CommandLine = /*CVE-*/i or CommandLine = /*poc-*/i or CommandLine = /*ProofOfConcept*/i or CommandLine = /*proxyshell*/i or CommandLine = /*log4shell*/i or CommandLine = /*eternalblue*/i or CommandLine = /*eternal-blue*/i or CommandLine = /*MS17-*/i)))
