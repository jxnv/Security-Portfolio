// Title: Process Creation Using Sysnative Folder
// ID: 3c1b5fb0-c72f-45ba-abd1-4d4c353144ab
// Status: test
// Level: medium
// Author: Max Altgelt (Nextron Systems)
// Date: 2022-08-23
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects process creation events that use the Sysnative folder (common for CobaltStrike spawns)
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*:\\Windows\\Sysnative\\*/i) or (ImageFileName = /*:\\Windows\\Sysnative\\*/i)) and not(((ImageFileName = /*C:\\Windows\\Microsoft.NET\\Framework64\\v*/i or ImageFileName = /*C:\\Windows\\Microsoft.NET\\Framework\\v*/i or ImageFileName = /*C:\\Windows\\Microsoft.NET\\FrameworkArm\\v*/i or ImageFileName = /*C:\\Windows\\Microsoft.NET\\FrameworkArm64\\v*/i) and ImageFileName = /.*\\ngen.exe/i and CommandLine = /*install*/i)) and not(((CommandLine = /*\"C:\\Windows\\sysnative\\cmd.exe\"*/i and CommandLine = /*\\xampp\\*/i and CommandLine = /*\\catalina_start.bat*/i))))
