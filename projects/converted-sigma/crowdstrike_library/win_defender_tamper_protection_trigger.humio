// Title: Microsoft Defender Tamper Protection Trigger
// ID: 49e5bc24-8b86-49f1-b743-535f332c2856
// Status: stable
// Level: high
// Author: Bhabesh Raj, Nasreddine Bencherchali
// Date: 2021-07-05
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects blocked attempts to change any of Defender's settings such as "Real Time Monitoring" and "Behavior Monitoring"
// Converted by: Sigma Universal SIEM/EDR CLI

(EventID = 5013 and (Value = /.*\\Windows Defender\\DisableAntiSpyware/i or Value = /.*\\Windows Defender\\DisableAntiVirus/i or Value = /.*\\Windows Defender\\Scan\\DisableArchiveScanning/i or Value = /.*\\Windows Defender\\Scan\\DisableScanningNetworkFiles/i or Value = /.*\\Real-Time Protection\\DisableRealtimeMonitoring/i or Value = /.*\\Real-Time Protection\\DisableBehaviorMonitoring/i or Value = /.*\\Real-Time Protection\\DisableIOAVProtection/i or Value = /.*\\Real-Time Protection\\DisableScriptScanning/i))
