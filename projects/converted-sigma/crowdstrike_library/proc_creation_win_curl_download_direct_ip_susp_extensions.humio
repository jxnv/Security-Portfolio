(((CommandLine = /.*.bat/i or CommandLine = /.*.bat\"/i or CommandLine = /.*.dat/i or CommandLine = /.*.dat\"/i or CommandLine = /.*.dll/i or CommandLine = /.*.dll\"/i or CommandLine = /.*.exe/i or CommandLine = /.*.exe\"/i or CommandLine = /.*.gif/i or CommandLine = /.*.gif\"/i or CommandLine = /.*.hta/i or CommandLine = /.*.hta\"/i or CommandLine = /.*.jpeg/i or CommandLine = /.*.jpeg\"/i or CommandLine = /.*.log/i or CommandLine = /.*.log\"/i or CommandLine = /.*.msi/i or CommandLine = /.*.msi\"/i or CommandLine = /.*.png/i or CommandLine = /.*.png\"/i or CommandLine = /.*.ps1/i or CommandLine = /.*.ps1\"/i or CommandLine = /.*.psm1/i or CommandLine = /.*.psm1\"/i or CommandLine = /.*.vbe/i or CommandLine = /.*.vbe\"/i or CommandLine = /.*.vbs/i or CommandLine = /.*.vbs\"/i or CommandLine = /.*.bat'/i or CommandLine = /.*.dat'/i or CommandLine = /.*.dll'/i or CommandLine = /.*.exe'/i or CommandLine = /.*.gif'/i or CommandLine = /.*.hta'/i or CommandLine = /.*.jpeg'/i or CommandLine = /.*.log'/i or CommandLine = /.*.msi'/i or CommandLine = /.*.png'/i or CommandLine = /.*.ps1'/i or CommandLine = /.*.psm1'/i or CommandLine = /.*.vbe'/i or CommandLine = /.*.vbs'/i)) and ((CommandLine = /* -O*/i or CommandLine = /*--remote-name*/i or CommandLine = /*--output*/i)) and (CommandLine = /*http*/i) and ((ImageFileName = /.*\\curl.exe/i) or (OriginalFilename = "curl.exe")) and (CommandLine =~ /://[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}/i))
