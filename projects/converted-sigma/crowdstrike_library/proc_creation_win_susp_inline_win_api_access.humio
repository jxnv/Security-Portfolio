// Title: Potential WinAPI Calls Via CommandLine
// ID: ba3f5c1b-6272-4119-9dbd-0bc8d21c2702
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-06
// Tags: attack.execution, attack.t1106
// Description: Detects the use of WinAPI Functions via the commandline. As seen used by threat actors via the tool winapiexec
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*AddSecurityPackage*/i or CommandLine = /*AdjustTokenPrivileges*/i or CommandLine = /*Advapi32*/i or CommandLine = /*CloseHandle*/i or CommandLine = /*CreateProcessWithToken*/i or CommandLine = /*CreatePseudoConsole*/i or CommandLine = /*CreateRemoteThread*/i or CommandLine = /*CreateThread*/i or CommandLine = /*CreateUserThread*/i or CommandLine = /*DangerousGetHandle*/i or CommandLine = /*DuplicateTokenEx*/i or CommandLine = /*EnumerateSecurityPackages*/i or CommandLine = /*FreeHGlobal*/i or CommandLine = /*FreeLibrary*/i or CommandLine = /*GetDelegateForFunctionPointer*/i or CommandLine = /*GetLogonSessionData*/i or CommandLine = /*GetModuleHandle*/i or CommandLine = /*GetProcAddress*/i or CommandLine = /*GetProcessHandle*/i or CommandLine = /*GetTokenInformation*/i or CommandLine = /*ImpersonateLoggedOnUser*/i or CommandLine = /*kernel32*/i or CommandLine = /*LoadLibrary*/i or CommandLine = /*memcpy*/i or CommandLine = /*MiniDumpWriteDump*/i or CommandLine = /*ntdll*/i or CommandLine = /*OpenDesktop*/i or CommandLine = /*OpenProcess*/i or CommandLine = /*OpenProcessToken*/i or CommandLine = /*OpenThreadToken*/i or CommandLine = /*OpenWindowStation*/i or CommandLine = /*PtrToString*/i or CommandLine = /*QueueUserApc*/i or CommandLine = /*ReadProcessMemory*/i or CommandLine = /*RevertToSelf*/i or CommandLine = /*RtlCreateUserThread*/i or CommandLine = /*secur32*/i or CommandLine = /*SetThreadToken*/i or CommandLine = /*VirtualAlloc*/i or CommandLine = /*VirtualFree*/i or CommandLine = /*VirtualProtect*/i or CommandLine = /*WaitForSingleObject*/i or CommandLine = /*WriteInt32*/i or CommandLine = /*WriteProcessMemory*/i or CommandLine = /*ZeroFreeGlobalAllocUnicode*/i)) and not(((ParentBaseFileName = /.*\\CompatTelRunner.exe/i and (CommandLine = /*FreeHGlobal*/i or CommandLine = /*PtrToString*/i or CommandLine = /*kernel32*/i or CommandLine = /*CloseHandle*/i)) or (ImageFileName = /.*\\MpCmdRun.exe/i and CommandLine = /*GetLoadLibraryWAddress32*/i))))
