// Tags: attack.persistence, attack.privilege-escalation, car.2013-09-005, attack.t1543.003
// Description: Detects uncommon service installation commands by looking at suspicious or uncommon image path values containing references to encoded powershell commands, temporary paths, etc.
// Converted by: Sigma Universal SIEM/EDR CLI

((Provider_Name = "Service Control Manager" and EventID = 7045) and (((ImagePath = /*\\\\\\\\.\\\\pipe*/i or ImagePath = /*\\Users\\Public\\*/i or ImagePath = /*\\Windows\\Temp\\*/i)) or ((ImagePath = /* -e*/i) and ((ImagePath = /* aQBlAHgA*/i or ImagePath = /* aWV4I*/i or ImagePath = /* IAB*/i or ImagePath = /* JAB*/i or ImagePath = /* PAA*/i or ImagePath = /* SQBFAFgA*/i or ImagePath = /* SUVYI*/i)))) and not((ImagePath = /C:\\ProgramData\\Microsoft\\Windows Defender\\Definition Updates\\.*/i)) and not((ImagePath = /C:\\WINDOWS\\TEMP\\thor10-remote\\thor64.exe.*/i)))
