// Tags: attack.exfiltration
// Description: Detects email exfiltration via powershell cmdlets
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i) and (CommandLine = /*Add-PSSnapin*/i and CommandLine = /*Get-Recipient*/i and CommandLine = /*-ExpandProperty*/i and CommandLine = /*EmailAddresses*/i and CommandLine = /*SmtpAddress*/i and CommandLine = /*-hidetableheaders*/i))
