// Tags: attack.stealth
// Description: Detects potentially suspicious child processes of "GoogleUpdate.exe"
// Converted by: Sigma Universal SIEM/EDR CLI

((ParentBaseFileName = /.*\\GoogleUpdate.exe/i) and not(((not(ImageFileName = *)) or ((ImageFileName = /*\\Google*/i) or ((ImageFileName = /.*\\setup.exe/i or ImageFileName = /.*chrome_updater.exe/i or ImageFileName = /.*chrome_installer.exe/i))))))
