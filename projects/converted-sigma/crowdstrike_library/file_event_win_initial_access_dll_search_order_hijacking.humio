// Description: Detects attempts to create a DLL file to a known desktop application dependencies folder such as Slack, Teams or OneDrive and by an unusual process. This may indicate an attempt to load a malicious module via DLL search order hijacking.
// Converted by: Sigma Universal SIEM/EDR CLI

(((ImageFileName = /.*\\winword.exe/i or ImageFileName = /.*\\excel.exe/i or ImageFileName = /.*\\powerpnt.exe/i or ImageFileName = /.*\\MSACCESS.EXE/i or ImageFileName = /.*\\MSPUB.EXE/i or ImageFileName = /.*\\fltldr.exe/i or ImageFileName = /.*\\cmd.exe/i or ImageFileName = /.*\\certutil.exe/i or ImageFileName = /.*\\mshta.exe/i or ImageFileName = /.*\\cscript.exe/i or ImageFileName = /.*\\wscript.exe/i or ImageFileName = /.*\\curl.exe/i or ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i) and TargetFileName = /.*.dll/i and (TargetFileName = /*\\Users\\*/i and TargetFileName = /*\\AppData\\*/i) and (TargetFileName = /*\\Microsoft\\OneDrive\\*/i or TargetFileName = /*\\Microsoft OneDrive\\*/i or TargetFileName = /*\\Microsoft\\Teams\\*/i or TargetFileName = /*\\Local\\slack\\app-*/i or TargetFileName = /*\\Local\\Programs\\Microsoft VS Code\\*/i)) and not((ImageFileName = /.*\\cmd.exe/i and (TargetFileName = /*\\Users\\*/i and TargetFileName = /*\\AppData\\*/i and TargetFileName = /*\\Microsoft\\OneDrive\\*/i and TargetFileName = /*\\api-ms-win-core-*/i))))
