// Tags: attack.persistence, attack.execution, attack.stealth, attack.t1197, attack.s0190, attack.t1036.003
// Description: Detects usage of bitsadmin downloading a file using an URL that contains an IP
// Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine = /*://1*/i or CommandLine = /*://2*/i or CommandLine = /*://3*/i or CommandLine = /*://4*/i or CommandLine = /*://5*/i or CommandLine = /*://6*/i or CommandLine = /*://7*/i or CommandLine = /*://8*/i or CommandLine = /*://9*/i)) and ((CommandLine = /* /transfer */i or CommandLine = /* /create */i or CommandLine = /* /addfile */i)) and ((ImageFileName = /.*\\bitsadmin.exe/i) or (OriginalFilename = "bitsadmin.exe"))) and not((CommandLine = /*://7-*/i)))
