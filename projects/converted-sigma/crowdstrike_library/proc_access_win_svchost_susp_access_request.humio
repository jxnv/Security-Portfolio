// Title: Suspicious Svchost Process Access
// ID: 166e9c50-8cd9-44af-815d-d1f0c0e90dde
// Status: test
// Level: high
// Author: Tim Burrell
// Date: 2020-01-02
// Tags: attack.defense-impairment, attack.t1685.001
// Description: Detects suspicious access to the "svchost" process such as that used by Invoke-Phantom to kill the thread of the Windows event logging service.
// Converted by: Sigma Universal SIEM/EDR CLI

((TargetImage = /.*:\\Windows\\System32\\svchost.exe/i and GrantedAccess = "0x1F3FFF" and CallTrace = /*UNKNOWN*/i) and not((SourceImage = /*:\\Program Files\\Microsoft Visual Studio\\*/i and SourceImage = /.*\\MSBuild\\Current\\Bin\\MSBuild.exe/i and (CallTrace = /*Microsoft.Build.ni.dll*/i or CallTrace = /*System.ni.dll*/i))))
