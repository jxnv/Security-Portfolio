// Title: Whoami.EXE Execution Anomaly
// ID: 8de1cbe8-d6f5-496d-8237-5f44a721c7a0
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2021-08-12
// Tags: attack.discovery, attack.t1033, car.2016-03-001
// Description: Detects the execution of whoami.exe with suspicious parent processes.
// Converted by: Sigma Universal SIEM/EDR CLI

(((ImageFileName = /.*\\whoami.exe/i) or (OriginalFilename = "whoami.exe")) and not((((ParentBaseFileName = /.*\\cmd.exe/i or ParentBaseFileName = /.*\\powershell_ise.exe/i or ParentBaseFileName = /.*\\powershell.exe/i or ParentBaseFileName = /.*\\pwsh.exe/i)) or ((ParentBaseFileName = "" or ParentBaseFileName = "-")) or (not(ParentBaseFileName = *)))) and not((ParentBaseFileName = /.*:\\Program Files\\Microsoft Monitoring Agent\\Agent\\MonitoringHost.exe/i)))
