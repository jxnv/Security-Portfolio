// Title: Legitimate Application Dropped Archive
// ID: 654fcc6d-840d-4844-9b07-2c3300e54a26
// Status: test
// Level: high
// Author: frack113, Florian Roth
// Date: 2022-08-21
// Tags: attack.stealth, attack.t1218
// Description: Detects programs on a Windows system that should not write an archive to disk
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*\\winword.exe/i or ImageFileName = /.*\\excel.exe/i or ImageFileName = /.*\\powerpnt.exe/i or ImageFileName = /.*\\msaccess.exe/i or ImageFileName = /.*\\mspub.exe/i or ImageFileName = /.*\\eqnedt32.exe/i or ImageFileName = /.*\\visio.exe/i or ImageFileName = /.*\\wordpad.exe/i or ImageFileName = /.*\\wordview.exe/i or ImageFileName = /.*\\certutil.exe/i or ImageFileName = /.*\\certoc.exe/i or ImageFileName = /.*\\CertReq.exe/i or ImageFileName = /.*\\Desktopimgdownldr.exe/i or ImageFileName = /.*\\esentutl.exe/i or ImageFileName = /.*\\finger.exe/i or ImageFileName = /.*\\notepad.exe/i or ImageFileName = /.*\\AcroRd32.exe/i or ImageFileName = /.*\\RdrCEF.exe/i or ImageFileName = /.*\\mshta.exe/i or ImageFileName = /.*\\hh.exe/i) and (TargetFileName = /.*.zip/i or TargetFileName = /.*.rar/i or TargetFileName = /.*.7z/i or TargetFileName = /.*.diagcab/i or TargetFileName = /.*.appx/i))
