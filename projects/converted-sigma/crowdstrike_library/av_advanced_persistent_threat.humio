// Title: Antivirus - APT Malware Signature
// ID: 101a1877-2cf4-474d-abfd-7f6ac4788d1a
// Status: experimental
// Level: critical
// Author: Arnim Rupp (Nextron Systems)
// Date: 2026-06-15
// Tags: attack.execution, attack.t1203, attack.command-and-control, attack.t1219.002
// Description: Detects a highly relevant Antivirus alert that reports APT malware.
// This event must not be ignored just because the AV has blocked the malware but investigate, how it came there in the first place.
// Converted by: Sigma Universal SIEM/EDR CLI

(((Signature =~ /APT\d/i or Signature =~ /ATK\d/i or Signature =~ /UNC\d/i or Signature =~ /UAC\d/i)) or ((Signature = /*[APT]*/i or Signature = /*APT_*/i or Signature = /*APT-*/i or Signature = /*BackOrder*/i or Signature = /*BlindingCan*/i or Signature = /*Blizzard*/i or Signature = /*Chollima*/i or Signature = /*Cleaver*/i or Signature = /*Cobra*/i or Signature = /*DarkHotel*/i or Signature = /*Dragon*/i or Signature = /*DTrack*/i or Signature = /*Equation*/i or Signature = /*GiftedCrook*/i or Signature = /*GraphSteel*/i or Signature = /*GreyEnergy*/i or Signature = /*GEnergy*/i or Signature = /*GrimPlant*/i or Signature = /*Hydra*/i or Signature = /*Jackal*/i or Signature = /*Kitten*/i or Signature = /*Kimsuky*/i or Signature = /*Lazar*/i or Signature = /*LightRail*/i or Signature = /*Lotus*/i or Signature = /*Luminous*/i or Signature = /*LumiMoth*/i or Signature = /*Nimbus*/i or Signature = /*Manticore*/i or Signature = /*MiniBike*/i or Signature = /*MiniBrowse*/i or Signature = /*MiniBus*/i or Signature = /*MiniFast*/i or Signature = /*MiniJuke*/i or Signature = /*MiniUpdate*/i or Signature = /*MuddyWater*/i or Signature = /*NukeSped*/i or Signature = /*OilRig*/i or Signature = /*Panda*/i or Signature = /*Sandstorm*/i or Signature = /*SandWorm*/i or Signature = /*Seamonkey*/i or Signature = /*Sleet*/i or Signature = /*SlugResin*/i or Signature = /*SnailResin*/i or Signature = /*Snake*/i or Signature = /*Tempest*/i or Signature = /*Tsunami*/i or Signature = /*Turla*/i or Signature = /*Typhoon*/i or Signature = /*UAC_*/i or Signature = /*UAC-*/i or Signature = /*UNC_*/i or Signature = /*UNC-*/i or Signature = /*VinoSiren*/i or Signature = /*Winnti*/i)))
