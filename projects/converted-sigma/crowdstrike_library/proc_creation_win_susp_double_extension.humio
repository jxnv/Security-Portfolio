// Title: Suspicious Double Extension File Execution
// ID: 1cdd9a09-06c9-4769-99ff-626e2b3991b8
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems), @blu3_team (idea), Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-06-26
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects suspicious use of an .exe extension after a non-executable file extension like .pdf.exe, a set of spaces or underlines to cloak the executable file in spear phishing campaigns
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*      .exe/i or ImageFileName = /.*______.exe/i or ImageFileName = /.*.doc.exe/i or ImageFileName = /.*.doc.js/i or ImageFileName = /.*.docx.exe/i or ImageFileName = /.*.docx.js/i or ImageFileName = /.*.gif.exe/i or ImageFileName = /.*.jpeg.exe/i or ImageFileName = /.*.jpg.exe/i or ImageFileName = /.*.mkv.exe/i or ImageFileName = /.*.mov.exe/i or ImageFileName = /.*.mp3.exe/i or ImageFileName = /.*.mp4.exe/i or ImageFileName = /.*.pdf.exe/i or ImageFileName = /.*.pdf.js/i or ImageFileName = /.*.png.exe/i or ImageFileName = /.*.ppt.exe/i or ImageFileName = /.*.ppt.js/i or ImageFileName = /.*.pptx.exe/i or ImageFileName = /.*.pptx.js/i or ImageFileName = /.*.rtf.exe/i or ImageFileName = /.*.rtf.js/i or ImageFileName = /.*.svg.exe/i or ImageFileName = /.*.txt.exe/i or ImageFileName = /.*.txt.js/i or ImageFileName = /.*.xls.exe/i or ImageFileName = /.*.xls.js/i or ImageFileName = /.*.xlsx.exe/i or ImageFileName = /.*.xlsx.js/i or ImageFileName = /.*⠀⠀⠀⠀⠀⠀.exe/i) and (CommandLine = /*      .exe*/i or CommandLine = /*______.exe*/i or CommandLine = /*.doc.exe*/i or CommandLine = /*.doc.js*/i or CommandLine = /*.docx.exe*/i or CommandLine = /*.docx.js*/i or CommandLine = /*.gif.exe*/i or CommandLine = /*.jpeg.exe*/i or CommandLine = /*.jpg.exe*/i or CommandLine = /*.mkv.exe*/i or CommandLine = /*.mov.exe*/i or CommandLine = /*.mp3.exe*/i or CommandLine = /*.mp4.exe*/i or CommandLine = /*.pdf.exe*/i or CommandLine = /*.pdf.js*/i or CommandLine = /*.png.exe*/i or CommandLine = /*.ppt.exe*/i or CommandLine = /*.ppt.js*/i or CommandLine = /*.pptx.exe*/i or CommandLine = /*.pptx.js*/i or CommandLine = /*.rtf.exe*/i or CommandLine = /*.rtf.js*/i or CommandLine = /*.svg.exe*/i or CommandLine = /*.txt.exe*/i or CommandLine = /*.txt.js*/i or CommandLine = /*.xls.exe*/i or CommandLine = /*.xls.js*/i or CommandLine = /*.xlsx.exe*/i or CommandLine = /*.xlsx.js*/i or CommandLine = /*⠀⠀⠀⠀⠀⠀.exe*/i))
