// Title: MacOS Scripting Interpreter AppleScript
// ID: 1bc2e6c5-0885-472b-bed6-be5ea8eace55
// Status: test
// Level: medium
// Author: Alejandro Ortuno, oscd.community
// Date: 2020-10-21
// Tags: attack.execution, attack.t1059.002
// Description: Detects execution of AppleScript of the macOS scripting language AppleScript.
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*/osascript/i and (CommandLine = /* -e */i or CommandLine = /*.scpt*/i or CommandLine = /*.js*/i)) and not((ParentBaseFileName = /.*opencode/i and (CommandLine = /*osascript*/i and CommandLine = /* -e */i and CommandLine = /*set imageData to the clipboard*/i and CommandLine = /*set fileRef*/i))))
