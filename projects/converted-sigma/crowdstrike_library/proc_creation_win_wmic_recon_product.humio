(((CommandLine = /*Product*/i) and ((ImageFileName = /.*\\wmic.exe/i) or (OriginalFilename = "wmic.exe"))) and not((((CommandLine = /* uninstall*/i or CommandLine = /* install*/i)) or (CommandLine = /*csproduct*/i))))
