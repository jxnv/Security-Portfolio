// Title: Potentially Suspicious Child Process Of Regsvr32
// ID: 6f0947a4-1c5e-4e0d-8ac7-53159b8f23ca
// Status: test
// Level: high
// Author: elhoim, Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-05-05
// Tags: attack.stealth, attack.t1218.010
// Description: Detects potentially suspicious child processes of "regsvr32.exe".
// Converted by: Sigma Universal SIEM/EDR CLI

((ParentBaseFileName = /.*\\regsvr32.exe/i and (ImageFileName = /.*\\calc.exe/i or ImageFileName = /.*\\cscript.exe/i or ImageFileName = /.*\\explorer.exe/i or ImageFileName = /.*\\mshta.exe/i or ImageFileName = /.*\\net.exe/i or ImageFileName = /.*\\net1.exe/i or ImageFileName = /.*\\nltest.exe/i or ImageFileName = /.*\\notepad.exe/i or ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i or ImageFileName = /.*\\reg.exe/i or ImageFileName = /.*\\schtasks.exe/i or ImageFileName = /.*\\werfault.exe/i or ImageFileName = /.*\\wscript.exe/i)) and not((ImageFileName = /.*\\werfault.exe/i and CommandLine = /* -u -p */i)))
