// Tags: attack.discovery, attack.t1482
// Description: Detects DNS server discovery via LDAP query requests from uncommon applications
// Converted by: Sigma Universal SIEM/EDR CLI

((QueryName = /_ldap..*/i) and not(((ImageFileName = /*:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*/i and ImageFileName = /.*\\MsMpEng.exe/i) or ((ImageFileName = /*:\\Program Files\\*/i or ImageFileName = /*:\\Program Files (x86)\\*/i or ImageFileName = /*:\\Windows\\*/i)) or (not(ImageFileName = *)) or (ImageFileName = "<unknown process>"))) and not(((ImageFileName = /C:\\WindowsAzure\\GuestAgent.*/i) or ((ImageFileName = /.*\\chrome.exe/i or ImageFileName = /.*\\firefox.exe/i or ImageFileName = /.*\\opera.exe/i)))))
