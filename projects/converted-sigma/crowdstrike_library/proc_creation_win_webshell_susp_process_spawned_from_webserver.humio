// Title: Suspicious Process By Web Server Process
// ID: 8202070f-edeb-4d31-a010-a26c72ac5600
// Status: test
// Level: high
// Author: Thomas Patzke, Florian Roth (Nextron Systems), Zach Stanford @svch0st, Tim Shelton, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-01-16
// Tags: attack.persistence, attack.initial-access, attack.t1505.003, attack.t1190
// Description: Detects potentially suspicious processes being spawned by a web server process which could be the result of a successfully placed web shell or exploitation
// Converted by: Sigma Universal SIEM/EDR CLI

((((ParentBaseFileName = /.*\\java.exe/i or ParentBaseFileName = /.*\\javaw.exe/i) and (ParentBaseFileName = /*-tomcat-*/i or ParentBaseFileName = /*\\tomcat*/i)) or ((ParentBaseFileName = /.*\\java.exe/i or ParentBaseFileName = /.*\\javaw.exe/i) and (ParentCommandLine = /*CATALINA_HOME*/i or ParentCommandLine = /*catalina.home*/i or ParentCommandLine = /*catalina.jar*/i)) or ((ParentBaseFileName = /.*\\caddy.exe/i or ParentBaseFileName = /.*\\httpd.exe/i or ParentBaseFileName = /.*\\nginx.exe/i or ParentBaseFileName = /.*\\php-cgi.exe/i or ParentBaseFileName = /.*\\php.exe/i or ParentBaseFileName = /.*\\tomcat.exe/i or ParentBaseFileName = /.*\\UMWorkerProcess.exe/i or ParentBaseFileName = /.*\\w3wp.exe/i or ParentBaseFileName = /.*\\ws_TomcatService.exe/i))) and ((ImageFileName = /.*\\arp.exe/i or ImageFileName = /.*\\at.exe/i or ImageFileName = /.*\\bash.exe/i or ImageFileName = /.*\\bitsadmin.exe/i or ImageFileName = /.*\\certutil.exe/i or ImageFileName = /.*\\cmd.exe/i or ImageFileName = /.*\\cscript.exe/i or ImageFileName = /.*\\dsget.exe/i or ImageFileName = /.*\\hostname.exe/i or ImageFileName = /.*\\nbtstat.exe/i or ImageFileName = /.*\\net.exe/i or ImageFileName = /.*\\net1.exe/i or ImageFileName = /.*\\netdom.exe/i or ImageFileName = /.*\\netsh.exe/i or ImageFileName = /.*\\nltest.exe/i or ImageFileName = /.*\\ntdsutil.exe/i or ImageFileName = /.*\\powershell_ise.exe/i or ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i or ImageFileName = /.*\\qprocess.exe/i or ImageFileName = /.*\\query.exe/i or ImageFileName = /.*\\qwinsta.exe/i or ImageFileName = /.*\\reg.exe/i or ImageFileName = /.*\\rundll32.exe/i or ImageFileName = /.*\\sc.exe/i or ImageFileName = /.*\\sh.exe/i or ImageFileName = /.*\\wmic.exe/i or ImageFileName = /.*\\wscript.exe/i or ImageFileName = /.*\\wusa.exe/i)) and not(((ParentBaseFileName = /.*\\java.exe/i and CommandLine = /.*Windows\\system32\\cmd.exe /c C:\\ManageEngine\\ADManager \"Plus\\ES\\bin\\elasticsearch.bat -Enode.name=RMP-NODE1 -pelasticsearch-pid.txt/i) or (ParentBaseFileName = /.*\\java.exe/i and (CommandLine = /*sc query*/i and CommandLine = /*ADManager Plus*/i)))))
