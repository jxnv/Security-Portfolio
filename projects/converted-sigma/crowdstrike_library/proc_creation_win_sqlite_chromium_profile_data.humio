// Title: SQLite Chromium Profile Data DB Access
// ID: 24c77512-782b-448a-8950-eddb0785fc71
// Status: test
// Level: high
// Author: TropChaud
// Date: 2022-12-19
// Tags: attack.credential-access, attack.t1539, attack.t1555.003, attack.collection, attack.t1005
// Description: Detect usage of the "sqlite" binary to query databases in Chromium-based browsers for potential data stealing.
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*\\User Data\\*/i or CommandLine = /*\\Opera Software\\*/i or CommandLine = /*\\ChromiumViewer\\*/i)) and ((CommandLine = /*Login Data*/i or CommandLine = /*Cookies*/i or CommandLine = /*Web Data*/i or CommandLine = /*History*/i or CommandLine = /*Bookmarks*/i)) and ((Product = "SQLite") or ((ImageFileName = /.*\\sqlite.exe/i or ImageFileName = /.*\\sqlite3.exe/i))))
