// Title: Potentially Suspicious Office Document Executed From Trusted Location
// ID: f99abdf0-6283-4e71-bd2b-b5c048a94743
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-21
// Tags: attack.stealth, attack.t1202
// Description: Detects the execution of an Office application that points to a document that is located in a trusted location. Attackers often used this to avoid macro security and execute their malicious code.
// Converted by: Sigma Universal SIEM/EDR CLI

(((((ImageFileName = /.*\\EXCEL.EXE/i or ImageFileName = /.*\\POWERPNT.EXE/i or ImageFileName = /.*\\WINWORD.exe/i)) or ((OriginalFilename = "Excel.exe" or OriginalFilename = "POWERPNT.EXE" or OriginalFilename = "WinWord.exe"))) and ((ParentBaseFileName = /.*\\explorer.exe/i or ParentBaseFileName = /.*\\dopus.exe/i)) and ((CommandLine = /*\\AppData\\Roaming\\Microsoft\\Templates*/i or CommandLine = /*\\AppData\\Roaming\\Microsoft\\Word\\Startup\\*/i or CommandLine = /*\\Microsoft Office\\root\\Templates\\*/i or CommandLine = /*\\Microsoft Office\\Templates\\*/i))) and not(((CommandLine = /.*.dotx/i or CommandLine = /.*.xltx/i or CommandLine = /.*.potx/i))))
