// Title: Suspicious Execution Of Renamed Sysinternals Tools - Registry
// ID: f50f3c09-557d-492d-81db-9064a8d4e211
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-24
// Tags: attack.resource-development, attack.t1588.002
// Description: Detects the creation of the "accepteula" key related to the Sysinternals tools being created from executables with the wrong name (e.g. a renamed Sysinternals tool)
// Converted by: Sigma Universal SIEM/EDR CLI

(((TargetObject = /*\\Active Directory Explorer*/i or TargetObject = /*\\Handle*/i or TargetObject = /*\\LiveKd*/i or TargetObject = /*\\ProcDump*/i or TargetObject = /*\\Process Explorer*/i or TargetObject = /*\\PsExec*/i or TargetObject = /*\\PsLoggedon*/i or TargetObject = /*\\PsLoglist*/i or TargetObject = /*\\PsPasswd*/i or TargetObject = /*\\PsPing*/i or TargetObject = /*\\PsService*/i or TargetObject = /*\\SDelete*/i) and TargetObject = /.*\\EulaAccepted/i) and not(((ImageFileName = /.*\\ADExplorer.exe/i or ImageFileName = /.*\\ADExplorer64.exe/i or ImageFileName = /.*\\ADExplorer64a.exe/i or ImageFileName = /.*\\handle.exe/i or ImageFileName = /.*\\handle64.exe/i or ImageFileName = /.*\\handle64a.exe/i or ImageFileName = /.*\\livekd.exe/i or ImageFileName = /.*\\livekd64.exe/i or ImageFileName = /.*\\procdump.exe/i or ImageFileName = /.*\\procdump64.exe/i or ImageFileName = /.*\\procdump64a.exe/i or ImageFileName = /.*\\procexp.exe/i or ImageFileName = /.*\\procexp64.exe/i or ImageFileName = /.*\\procexp64a.exe/i or ImageFileName = /.*\\PsExec.exe/i or ImageFileName = /.*\\PsExec64.exe/i or ImageFileName = /.*\\PsExec64a.exe/i or ImageFileName = /.*\\PsLoggedon.exe/i or ImageFileName = /.*\\PsLoggedon64.exe/i or ImageFileName = /.*\\psloglist.exe/i or ImageFileName = /.*\\psloglist64.exe/i or ImageFileName = /.*\\psloglist64a.exe/i or ImageFileName = /.*\\pspasswd.exe/i or ImageFileName = /.*\\pspasswd64.exe/i or ImageFileName = /.*\\pspasswd64a.exe/i or ImageFileName = /.*\\PsPing.exe/i or ImageFileName = /.*\\PsPing64.exe/i or ImageFileName = /.*\\PsPing64a.exe/i or ImageFileName = /.*\\PsService.exe/i or ImageFileName = /.*\\PsService64.exe/i or ImageFileName = /.*\\PsService64a.exe/i or ImageFileName = /.*\\sdelete.exe/i))))
