// Title: Suspicious Child Process Of Manage Engine ServiceDesk
// ID: cea2b7ea-792b-405f-95a1-b903ea06458f
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2023-01-18
// Tags: attack.command-and-control, attack.t1102
// Description: Detects suspicious child processes of the "Manage Engine ServiceDesk Plus" Java web service
// Converted by: Sigma Universal SIEM/EDR CLI

(((ParentBaseFileName = /*\\ManageEngine\\ServiceDesk\\*/i and ParentBaseFileName = /*\\java.exe*/i) and (ImageFileName = /.*\\AppVLP.exe/i or ImageFileName = /.*\\bash.exe/i or ImageFileName = /.*\\bitsadmin.exe/i or ImageFileName = /.*\\calc.exe/i or ImageFileName = /.*\\certutil.exe/i or ImageFileName = /.*\\cscript.exe/i or ImageFileName = /.*\\curl.exe/i or ImageFileName = /.*\\forfiles.exe/i or ImageFileName = /.*\\mftrace.exe/i or ImageFileName = /.*\\mshta.exe/i or ImageFileName = /.*\\net.exe/i or ImageFileName = /.*\\net1.exe/i or ImageFileName = /.*\\notepad.exe/i or ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i or ImageFileName = /.*\\query.exe/i or ImageFileName = /.*\\reg.exe/i or ImageFileName = /.*\\schtasks.exe/i or ImageFileName = /.*\\scrcons.exe/i or ImageFileName = /.*\\sh.exe/i or ImageFileName = /.*\\systeminfo.exe/i or ImageFileName = /.*\\whoami.exe/i or ImageFileName = /.*\\wmic.exe/i or ImageFileName = /.*\\wscript.exe/i)) and not(((ImageFileName = /.*\\net.exe/i or ImageFileName = /.*\\net1.exe/i) and CommandLine = /* stop*/i)))
