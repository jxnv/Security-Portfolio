// Title: Always Install Elevated MSI Spawned Cmd And Powershell
// ID: 1e53dd56-8d83-4eb4-a43e-b790a05510aa
// Status: test
// Level: medium
// Author: Teymur Kheirkhabarov (idea), Mangatas Tondang (rule), oscd.community
// Date: 2020-10-13
// Tags: attack.privilege-escalation, attack.t1548.002
// Description: Detects Windows Installer service (msiexec.exe) spawning "cmd" or "powershell"
// Converted by: Sigma Universal SIEM/EDR CLI

((((ImageFileName = /.*\\cmd.exe/i or ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i)) or ((OriginalFilename = "Cmd.Exe" or OriginalFilename = "PowerShell.EXE" or OriginalFilename = "pwsh.dll"))) and ((ParentBaseFileName = /*\\Windows\\Installer\\*/i and ParentBaseFileName = /*msi*/i) and ParentBaseFileName = /.*tmp/i))
