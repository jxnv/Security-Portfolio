// Title: Suspicious Reg Add BitLocker
// ID: 0e0255bf-2548-47b8-9582-c0955c9283f5
// Status: test
// Level: high
// Author: frack113
// Date: 2021-11-15
// Tags: attack.impact, attack.t1486
// Description: Detects suspicious addition to BitLocker related registry keys via the reg.exe utility
// Converted by: Sigma Universal SIEM/EDR CLI

((CommandLine = /*REG*/i and CommandLine = /*ADD*/i and CommandLine = /*\\SOFTWARE\\Policies\\Microsoft\\FVE*/i and CommandLine = /*/v*/i and CommandLine = /*/f*/i) and (CommandLine = /*EnableBDEWithNoTPM*/i or CommandLine = /*UseAdvancedStartup*/i or CommandLine = /*UseTPM*/i or CommandLine = /*UseTPMKey*/i or CommandLine = /*UseTPMKeyPIN*/i or CommandLine = /*RecoveryKeyMessageSource*/i or CommandLine = /*UseTPMPIN*/i or CommandLine = /*RecoveryKeyMessage*/i))
