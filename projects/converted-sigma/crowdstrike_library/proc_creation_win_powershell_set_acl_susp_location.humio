// Title: PowerShell Set-Acl On Windows Folder
// ID: 0944e002-e3f6-4eb5-bf69-3a3067b53d73
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-18
// Tags: attack.stealth
// Description: Detects PowerShell scripts to set the ACL to a file in the Windows folder
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*Set-Acl */i and CommandLine = /*-AclObject */i)) and (((OriginalFilename = "PowerShell.EXE" or OriginalFilename = "pwsh.dll")) or ((ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i))) and ((CommandLine = /*-Path \"C:\\Windows*/i or CommandLine = /*-Path 'C:\\Windows*/i or CommandLine = /*-Path %windir%*/i or CommandLine = /*-Path $env:windir*/i)) and ((CommandLine = /*FullControl*/i or CommandLine = /*Allow*/i)))
