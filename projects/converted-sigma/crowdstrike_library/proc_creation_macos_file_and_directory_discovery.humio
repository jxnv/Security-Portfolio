((ImageFileName = "/usr/bin/file" and CommandLine =~ /(.){200,}/i) or (ImageFileName = "/usr/bin/find") or (ImageFileName = "/usr/bin/mdfind") or (ImageFileName = "/bin/ls" and CommandLine = /*-R*/i) or 1=1)
