// Title: File With Uncommon Extension Created By An Office Application
// ID: c7a74c80-ba5a-486e-9974-ab9e682bc5e4
// Status: test
// Level: high
// Author: Vadim Khrykov (ThreatIntel), Cyb3rEng (Rule), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-08-23
// Tags: attack.t1204.002, attack.execution
// Description: Detects the creation of files with an executable or script extension by an Office application.
// Converted by: Sigma Universal SIEM/EDR CLI

((((ImageFileName = /.*\\excel.exe/i or ImageFileName = /.*\\msaccess.exe/i or ImageFileName = /.*\\mspub.exe/i or ImageFileName = /.*\\powerpnt.exe/i or ImageFileName = /.*\\visio.exe/i or ImageFileName = /.*\\winword.exe/i)) and ((TargetFileName = /.*.bat/i or TargetFileName = /.*.cmd/i or TargetFileName = /.*.com/i or TargetFileName = /.*.dll/i or TargetFileName = /.*.exe/i or TargetFileName = /.*.hta/i or TargetFileName = /.*.ocx/i or TargetFileName = /.*.proj/i or TargetFileName = /.*.ps1/i or TargetFileName = /.*.scf/i or TargetFileName = /.*.scr/i or TargetFileName = /.*.sys/i or TargetFileName = /.*.vbe/i or TargetFileName = /.*.vbs/i or TargetFileName = /.*.wsf/i or TargetFileName = /.*.wsh/i))) and not((TargetFileName = /*\\AppData\\Local\\assembly\\tmp\\*/i and TargetFileName = /.*.dll/i)) and not((((TargetFileName = /*C:\\Users\\*/i and TargetFileName = /*\\AppData\\Local\\Microsoft\\Office\\*/i and TargetFileName = /*\\BackstageInAppNavCache\\*/i) and TargetFileName = /.*.com/i) or (ImageFileName = /.*\\winword.exe/i and TargetFileName = /*\\AppData\\Local\\Temp\\webexdelta\\*/i and (TargetFileName = /.*.dll/i or TargetFileName = /.*.exe/i)) or ((TargetFileName = /*C:\\Users\\*/i and TargetFileName = /*\\AppData\\Local\\Microsoft\\Office\\*/i and TargetFileName = /*\\WebServiceCache\\AllUsers*/i) and TargetFileName = /.*.com/i))))
