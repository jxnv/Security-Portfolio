// Title: Direct Autorun Keys Modification
// ID: 24357373-078f-44ed-9ac4-6d334a668a11
// Status: test
// Level: medium
// Author: Victor Sergeev, Daniil Yugoslavskiy, oscd.community, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2019-10-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects direct modification of autostart extensibility point (ASEP) in registry using reg.exe.
// Converted by: Sigma Universal SIEM/EDR CLI

((CommandLine = /*add*/i) and ((CommandLine = /*\\software\\Microsoft\\Windows\\CurrentVersion\\Run*/i or CommandLine = /*\\software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run*/i or CommandLine = /*\\software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\Run*/i or CommandLine = /*\\software\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon\\Userinit*/i or CommandLine = /*\\software\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon\\Shell*/i or CommandLine = /*\\software\\Microsoft\\Windows NT\\CurrentVersion\\Windows*/i or CommandLine = /*\\system\\CurrentControlSet\\Control\\SafeBoot\\AlternateShell*/i)) and ((ImageFileName = /.*\\reg.exe/i) or (OriginalFilename = "reg.exe")))
