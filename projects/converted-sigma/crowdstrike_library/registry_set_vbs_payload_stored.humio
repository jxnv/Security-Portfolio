((TargetObject = /*Software\\Microsoft\\Windows\\CurrentVersion*/i and (Details = /*vbscript:*/i or Details = /*jscript:*/i or Details = /*mshtml,*/i or Details = /*RunHTMLApplication*/i or Details = /*Execute(*/i or Details = /*CreateObject*/i or Details = /*window.close*/i)) and not(((TargetObject = /*Software\\Microsoft\\Windows\\CurrentVersion\\Run*/i) or (ImageFileName = /.*\\msiexec.exe/i and TargetObject = /*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Installer\\UserData\\*/i and (Details = /*\\Microsoft.NET\\Primary Interop Assemblies\\Microsoft.mshtml.dll*/i or Details = /*<\\Microsoft.mshtml,fileVersion=*/i or Details = /*_mshtml_dll_*/i or Details = /*<\\Microsoft.mshtml,culture=*/i)))))
