// Title: VBA DLL Loaded Via Office Application
// ID: e6ce8457-68b1-485b-9bdd-3c2b5d679aa9
// Status: test
// Level: high
// Author: Antonlovesdnb
// Date: 2020-02-19
// Tags: attack.execution, attack.t1204.002
// Description: Detects VB DLL's loaded by an office application. Which could indicate the presence of VBA Macros.
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*\\excel.exe/i or ImageFileName = /.*\\mspub.exe/i or ImageFileName = /.*\\onenote.exe/i or ImageFileName = /.*\\onenoteim.exe/i or ImageFileName = /.*\\outlook.exe/i or ImageFileName = /.*\\powerpnt.exe/i or ImageFileName = /.*\\winword.exe/i) and (ImageLoaded = /.*\\VBE7.DLL/i or ImageLoaded = /.*\\VBEUI.DLL/i or ImageLoaded = /.*\\VBE7INTL.DLL/i))
