// Title: DotNET Assembly DLL Loaded Via Office Application
// ID: ff0f2b05-09db-4095-b96d-1b75ca24894a
// Status: test
// Level: medium
// Author: Antonlovesdnb
// Date: 2020-02-19
// Tags: attack.execution, attack.t1204.002
// Description: Detects any assembly DLL being loaded by an Office Product
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*\\excel.exe/i or ImageFileName = /.*\\mspub.exe/i or ImageFileName = /.*\\onenote.exe/i or ImageFileName = /.*\\onenoteim.exe/i or ImageFileName = /.*\\outlook.exe/i or ImageFileName = /.*\\powerpnt.exe/i or ImageFileName = /.*\\winword.exe/i) and ImageLoaded = /C:\\Windows\\assembly\\.*/i)
