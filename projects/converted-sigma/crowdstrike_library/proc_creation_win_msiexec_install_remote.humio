// Title: Suspicious Msiexec Quiet Install From Remote Location
// ID: 8150732a-0c9d-4a99-82b9-9efb9b90c40c
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-28
// Tags: attack.stealth, attack.t1218.007
// Description: Detects usage of Msiexec.exe to install packages hosted remotely quietly
// Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine = /*-i*/i or CommandLine = /*/i*/i or CommandLine = /*-package*/i or CommandLine = /*/package*/i or CommandLine = /*-a*/i or CommandLine = /*/a*/i or CommandLine = /*-j*/i or CommandLine = /*/j*/i)) and ((ImageFileName = /.*\\msiexec.exe/i) or (OriginalFilename = "msiexec.exe")) and ((CommandLine = /*-q*/i or CommandLine = /*/q*/i)) and ((CommandLine = /*http*/i or CommandLine = /*\\\\\\\\*/i))) and not(((CommandLine = /*\\AppData\\Local\\Temp\\OpenOffice*/i and CommandLine = /*Installation Files\\openoffice*/i))))
