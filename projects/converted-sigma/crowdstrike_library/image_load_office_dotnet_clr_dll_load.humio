// Title: CLR DLL Loaded Via Office Applications
// ID: d13c43f0-f66b-4279-8b2c-5912077c1780
// Status: test
// Level: medium
// Author: Antonlovesdnb
// Date: 2020-02-19
// Tags: attack.execution, attack.t1204.002
// Description: Detects CLR DLL being loaded by an Office Product
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*\\excel.exe/i or ImageFileName = /.*\\mspub.exe/i or ImageFileName = /.*\\outlook.exe/i or ImageFileName = /.*\\onenote.exe/i or ImageFileName = /.*\\onenoteim.exe/i or ImageFileName = /.*\\powerpnt.exe/i or ImageFileName = /.*\\winword.exe/i) and ImageLoaded = /*\\clr.dll*/i)
