// Title: Hiding Files with Attrib.exe
// ID: 4281cb20-2994-4580-aa63-c8b86d019934
// Status: test
// Level: medium
// Author: Sami Ruohonen
// Date: 2019-01-16
// Tags: attack.stealth, attack.t1564.001
// Description: Detects usage of attrib.exe to hide files from users.
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /* +h */i) and ((ImageFileName = /.*\\attrib.exe/i) or (OriginalFilename = "ATTRIB.EXE"))) and not((CommandLine = /*\\desktop.ini */i)) and not((ParentBaseFileName = /.*\\cmd.exe/i and CommandLine = "+R +H +S +A \\\\\\*.cui" and ParentCommandLine = "C:\\\\WINDOWS\\\\system32\\\\\\*.bat")))
