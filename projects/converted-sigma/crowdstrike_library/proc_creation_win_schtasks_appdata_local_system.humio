// Title: Suspicious Schtasks Execution AppData Folder
// ID: c5c00f49-b3f9-45a6-997e-cfdecc6e1967
// Status: test
// Level: high
// Author: pH-T (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-03-15
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053.005, attack.t1059.001
// Description: Detects the creation of a schtask that executes a file from C:\Users\<USER>\AppData\Local
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*\\schtasks.exe/i and (CommandLine = /*/Create*/i and CommandLine = /*/RU*/i and CommandLine = /*/TR*/i and CommandLine = /*C:\\Users\\*/i and CommandLine = /*\\AppData\\Local\\*/i) and (CommandLine = /*NT AUT*/i or CommandLine = /* SYSTEM */i)) and not(((ParentBaseFileName = /*\\AppData\\Local\\Temp\\*/i and ParentBaseFileName = /*TeamViewer_.exe*/i) and ImageFileName = /.*\\schtasks.exe/i and CommandLine = /*/TN TVInstallRestore*/i)))
