// Description: Detects uninstallation or termination of security products using the WMIC utility
// Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine = /*wmic*/i and CommandLine = /*product */i and CommandLine = /*uninstall*/i) and (CommandLine = /*/nointeractive*/i or CommandLine = /*-nointeractive*/i)) or ((CommandLine = /*wmic*/i and CommandLine = /*caption like */i) and (CommandLine = /*call delete*/i or CommandLine = /*call terminate*/i)) or ((CommandLine = /*process */i and CommandLine = /*where */i and CommandLine = /*delete*/i))) and ((CommandLine = /*%carbon%*/i or CommandLine = /*%cylance%*/i or CommandLine = /*%endpoint%*/i or CommandLine = /*%eset%*/i or CommandLine = /*%malware%*/i or CommandLine = /*%Sophos%*/i or CommandLine = /*%symantec%*/i or CommandLine = /*Antivirus*/i or CommandLine = /*AVG */i or CommandLine = /*Carbon Black*/i or CommandLine = /*CarbonBlack*/i or CommandLine = /*Cb Defense Sensor 64-bit*/i or CommandLine = /*Crowdstrike Sensor*/i or CommandLine = /*Cylance */i or CommandLine = /*Dell Threat Defense*/i or CommandLine = /*DLP Endpoint*/i or CommandLine = /*Endpoint Detection*/i or CommandLine = /*Endpoint Protection*/i or CommandLine = /*Endpoint Security*/i or CommandLine = /*Endpoint Sensor*/i or CommandLine = /*ESET File Security*/i or CommandLine = /*LogRhythm System Monitor Service*/i or CommandLine = /*Malwarebytes*/i or CommandLine = /*McAfee Agent*/i or CommandLine = /*Microsoft Security Client*/i or CommandLine = /*Sophos Anti-Virus*/i or CommandLine = /*Sophos AutoUpdate*/i or CommandLine = /*Sophos Credential Store*/i or CommandLine = /*Sophos Management Console*/i or CommandLine = /*Sophos Management Database*/i or CommandLine = /*Sophos Management Server*/i or CommandLine = /*Sophos Remote Management System*/i or CommandLine = /*Sophos Update Manager*/i or CommandLine = /*Threat Protection*/i or CommandLine = /*VirusScan*/i or CommandLine = /*Webroot SecureAnywhere*/i or CommandLine = /*Windows Defender*/i)))
