// Title: Suspicious Command Patterns In Scheduled Task Creation
// ID: f2c64357-b1d2-41b7-849f-34d2682c0fad
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-23
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects scheduled task creation using "schtasks" that contain potentially suspicious or uncommon commands
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*\\schtasks.exe/i and CommandLine = /*/Create */i) and ((((CommandLine = /*/sc minute */i or CommandLine = /*/ru system */i)) and ((CommandLine = /*cmd /c*/i or CommandLine = /*cmd /k*/i or CommandLine = /*cmd /r*/i or CommandLine = /*cmd.exe /c */i or CommandLine = /*cmd.exe /k */i or CommandLine = /*cmd.exe /r */i))) or ((CommandLine = /* -decode */i or CommandLine = /* -enc */i or CommandLine = /* -w hidden */i or CommandLine = /* bypass */i or CommandLine = /* IEX*/i or CommandLine = /*.DownloadData*/i or CommandLine = /*.DownloadFile*/i or CommandLine = /*.DownloadString*/i or CommandLine = /*/c start /min */i or CommandLine = /*FromBase64String*/i or CommandLine = /*mshta http*/i or CommandLine = /*mshta.exe http*/i)) or (((CommandLine = /*:\\ProgramData\\*/i or CommandLine = /*:\\Temp\\*/i or CommandLine = /*:\\Tmp\\*/i or CommandLine = /*:\\Users\\Public\\*/i or CommandLine = /*:\\Windows\\Temp\\*/i or CommandLine = /*\\AppData\\*/i or CommandLine = /*%AppData%*/i or CommandLine = /*%Temp%*/i or CommandLine = /*%tmp%*/i)) and ((CommandLine = /*cscript*/i or CommandLine = /*curl*/i or CommandLine = /*wscript*/i)))))
