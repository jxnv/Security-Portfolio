// Title: Schtasks From Suspicious Folders
// ID: 8a8379b8-780b-4dbf-b1e9-31c8d112fefb
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-04-15
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects scheduled task creations that have suspicious action command and folder combinations
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*C:\\ProgramData\\*/i or CommandLine = /*%ProgramData%*/i)) and ((CommandLine = /*powershell*/i or CommandLine = /*pwsh*/i or CommandLine = /*cmd /c */i or CommandLine = /*cmd /k */i or CommandLine = /*cmd /r */i or CommandLine = /*cmd.exe /c */i or CommandLine = /*cmd.exe /k */i or CommandLine = /*cmd.exe /r */i)) and (CommandLine = /* /create */i) and ((ImageFileName = /.*\\schtasks.exe/i) or (OriginalFilename = "schtasks.exe")))
