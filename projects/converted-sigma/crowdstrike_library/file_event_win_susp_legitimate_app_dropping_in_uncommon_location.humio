// Tags: attack.stealth, attack.t1218, attack.command-and-control, attack.t1105
// Description: Detects legitimate applications writing any type of file to uncommon or suspicious locations that are not typical for application data storage or execution.
// Adversaries may leverage legitimate applications (Living off the Land Binaries - LOLBins) to drop or download malicious files to uncommon locations on the system to evade detection by security solutions.
// Converted by: Sigma Universal SIEM/EDR CLI

(((ImageFileName = /.*\\eqnedt32.exe/i or ImageFileName = /.*\\wordpad.exe/i or ImageFileName = /.*\\wordview.exe/i or ImageFileName = /.*\\cmdl32.exe/i or ImageFileName = /.*\\certutil.exe/i or ImageFileName = /.*\\certoc.exe/i or ImageFileName = /.*\\CertReq.exe/i or ImageFileName = /.*\\bitsadmin.exe/i or ImageFileName = /.*\\Desktopimgdownldr.exe/i or ImageFileName = /.*\\esentutl.exe/i or ImageFileName = /.*\\expand.exe/i or ImageFileName = /.*\\extrac32.exe/i or ImageFileName = /.*\\replace.exe/i or ImageFileName = /.*\\mshta.exe/i or ImageFileName = /.*\\ftp.exe/i or ImageFileName = /.*\\Ldifde.exe/i or ImageFileName = /.*\\RdrCEF.exe/i or ImageFileName = /.*\\hh.exe/i or ImageFileName = /.*\\finger.exe/i or ImageFileName = /.*\\findstr.exe/i)) and ((TargetFileName = /*:\\Perflogs*/i or TargetFileName = /*:\\ProgramData\\*/i or TargetFileName = /*:\\Temp\\*/i or TargetFileName = /*:\\Users\\Public\\*/i or TargetFileName = /*:\\Windows\\*/i or TargetFileName = /*\\$Recycle.Bin\\*/i or TargetFileName = /*\\AppData\\Local\\*/i or TargetFileName = /*\\AppData\\Roaming\\*/i or TargetFileName = /*\\Contacts\\*/i or TargetFileName = /*\\Desktop\\*/i or TargetFileName = /*\\Favorites\\*/i or TargetFileName = /*\\Favourites\\*/i or TargetFileName = /*\\inetpub\\wwwroot\\*/i or TargetFileName = /*\\Music\\*/i or TargetFileName = /*\\Pictures\\*/i or TargetFileName = /*\\Start Menu\\Programs\\Startup\\*/i or TargetFileName = /*\\Users\\Default\\*/i or TargetFileName = /*\\Videos\\*/i)))
