// Title: HackTool - CrackMapExec Execution
// ID: 42a993dd-bb3e-48c8-b372-4d6684c4106c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-25
// Tags: attack.execution, attack.persistence, attack.privilege-escalation, attack.credential-access, attack.discovery, attack.t1047, attack.t1053, attack.t1059.003, attack.t1059.001, attack.t1110, attack.t1201
// Description: This rule detect common flag combinations used by CrackMapExec in order to detect its use even if the binary has been replaced.
// Converted by: Sigma Universal SIEM/EDR CLI

(((ImageFileName = /.*\\crackmapexec.exe/i) or ((CommandLine = /* --local-auth*/i and CommandLine = /* -u */i and CommandLine = /* -x */i)) or ((CommandLine = /* --local-auth*/i and CommandLine = /* -u */i and CommandLine = /* -p */i and CommandLine = /* -H 'NTHASH'*/i)) or ((CommandLine = /* mssql */i and CommandLine = /* -u */i and CommandLine = /* -p */i and CommandLine = /* -M */i and CommandLine = /* -d */i)) or ((CommandLine = /* smb */i and CommandLine = /* -u */i and CommandLine = /* -H */i and CommandLine = /* -M */i and CommandLine = /* -o */i)) or ((CommandLine = /* smb */i and CommandLine = /* -u */i and CommandLine = /* -p */i and CommandLine = /* --local-auth*/i)) or (CommandLine = /* -M pe_inject */i)) or (((CommandLine = /* --local-auth*/i and CommandLine = /* -u */i and CommandLine = /* -p */i)) and ((CommandLine = /* 10.*/i and CommandLine = /* 192.168.*/i and CommandLine = /*/24 */i))))
