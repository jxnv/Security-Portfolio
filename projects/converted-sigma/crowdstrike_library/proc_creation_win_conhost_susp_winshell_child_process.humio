// Title: Potentially Suspicious Child Processes Spawned by ConHost
// ID: dfa03a09-8b92-4d83-8e74-f72839b1c407
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-02-05
// Tags: attack.stealth, attack.t1202, attack.t1218
// Description: Detects suspicious child processes related to Windows Shell utilities spawned by `conhost.exe`, which could indicate malicious activity using trusted system components.
// Converted by: Sigma Universal SIEM/EDR CLI

((((ImageFileName = /.*\\cmd.exe/i or ImageFileName = /.*\\cscript.exe/i or ImageFileName = /.*\\mshta.exe/i or ImageFileName = /.*\\powershell_ise.exe/i or ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i or ImageFileName = /.*\\regsvr32.exe/i or ImageFileName = /.*\\wscript.exe/i)) or ((OriginalFilename = "cmd.exe" or OriginalFilename = "cscript.exe" or OriginalFilename = "mshta.exe" or OriginalFilename = "powershell_ise.exe" or OriginalFilename = "powershell.exe" or OriginalFilename = "pwsh.dll" or OriginalFilename = "regsvr32.exe" or OriginalFilename = "wscript.exe"))) and (ParentBaseFileName = /.*\\conhost.exe/i))
