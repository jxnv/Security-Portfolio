// Title: BITS Transfer Job Downloading File Potential Suspicious Extension
// ID: b85e5894-9b19-4d86-8c87-a2f3b81f0521
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-03-01
// Tags: attack.persistence, attack.execution, attack.stealth, attack.t1197
// Description: Detects new BITS transfer job saving local files with potential suspicious extensions
// Converted by: Sigma Universal SIEM/EDR CLI

((EventID = 16403 and (LocalName = /.*.bat/i or LocalName = /.*.dll/i or LocalName = /.*.exe/i or LocalName = /.*.hta/i or LocalName = /.*.ps1/i or LocalName = /.*.psd1/i or LocalName = /.*.sh/i or LocalName = /.*.vbe/i or LocalName = /.*.vbs/i)) and not((LocalName = /*\\AppData\\*/i and RemoteName = /*.com*/i)))
