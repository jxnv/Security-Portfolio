// Title: Script Event Consumer Spawning Process
// ID: f6d1dd2f-b8ce-40ca-bc23-062efb686b34
// Status: test
// Level: high
// Author: Sittikorn S
// Date: 2021-06-21
// Tags: attack.execution, attack.t1047
// Description: Detects a suspicious child process of Script Event Consumer (scrcons.exe).
// Converted by: Sigma Universal SIEM/EDR CLI

(ParentBaseFileName = /.*\\scrcons.exe/i and (ImageFileName = /.*\\svchost.exe/i or ImageFileName = /.*\\dllhost.exe/i or ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i or ImageFileName = /.*\\wscript.exe/i or ImageFileName = /.*\\cscript.exe/i or ImageFileName = /.*\\schtasks.exe/i or ImageFileName = /.*\\regsvr32.exe/i or ImageFileName = /.*\\mshta.exe/i or ImageFileName = /.*\\rundll32.exe/i or ImageFileName = /.*\\msiexec.exe/i or ImageFileName = /.*\\msbuild.exe/i))
