// Title: Potentially Suspicious Call To Win32_NTEventlogFile Class
// ID: caf201a9-c2ce-4a26-9c3a-2b9525413711
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-07-13
// Tags: attack.defense-impairment
// Description: Detects usage of the WMI class "Win32_NTEventlogFile" in a potentially suspicious way (delete, backup, change permissions, etc.) from a PowerShell script
// Converted by: Sigma Universal SIEM/EDR CLI

((CommandLine = /*Win32_NTEventlogFile*/i) and ((CommandLine = /*.BackupEventlog(*/i or CommandLine = /*.ChangeSecurityPermissions(*/i or CommandLine = /*.ChangeSecurityPermissionsEx(*/i or CommandLine = /*.ClearEventLog(*/i or CommandLine = /*.Delete(*/i or CommandLine = /*.DeleteEx(*/i or CommandLine = /*.Rename(*/i or CommandLine = /*.TakeOwnerShip(*/i or CommandLine = /*.TakeOwnerShipEx(*/i)))
