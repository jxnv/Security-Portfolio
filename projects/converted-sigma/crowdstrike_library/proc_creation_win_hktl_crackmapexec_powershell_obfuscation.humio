(((CommandLine = /*join*split*/i or CommandLine = /*( $ShellId[1]+$ShellId[13]+'x')*/i or CommandLine = /*( $PSHome[*]+$PSHOME[*]+*/i or CommandLine = /*( $env:Public[13]+$env:Public[5]+'x')*/i or CommandLine = /*( $env:ComSpec[4,*,25]-Join'')*/i or CommandLine = /*[1,3]+'x'-Join'')*/i)) and (((ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i)) or ((OriginalFilename = "PowerShell.EXE" or OriginalFilename = "pwsh.dll"))))
