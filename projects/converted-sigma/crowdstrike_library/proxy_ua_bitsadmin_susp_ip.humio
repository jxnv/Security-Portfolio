// Description: Detects Bitsadmin connections to IP addresses instead of FQDN names
// Converted by: Sigma Universal SIEM/EDR CLI

(c-useragent = /Microsoft BITS/.*/i and (cs-host = /.*1/i or cs-host = /.*2/i or cs-host = /.*3/i or cs-host = /.*4/i or cs-host = /.*5/i or cs-host = /.*6/i or cs-host = /.*7/i or cs-host = /.*8/i or cs-host = /.*9/i))
