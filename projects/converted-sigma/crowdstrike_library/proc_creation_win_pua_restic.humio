// Description: Detects the execution of the Restic backup tool, which can be used for data exfiltration.
// Threat actors may leverage Restic to back up and exfiltrate sensitive data to remote storage locations, including cloud services.
// If not legitimately used in the enterprise environment, its presence may indicate malicious activity.
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*sftp:*/i or CommandLine = /*rest:http*/i or CommandLine = /*s3:s3.*/i or CommandLine = /*s3.http*/i or CommandLine = /*azure:*/i or CommandLine = /* gs:*/i or CommandLine = /*rclone:*/i or CommandLine = /*swift:*/i or CommandLine = /* b2:*/i) and (CommandLine = /* init */i and CommandLine = /* -r */i)) or (((CommandLine = /*--password-file*/i and CommandLine = /*init*/i and CommandLine = /* -r */i)) or ((CommandLine = /*--use-fs-snapshot*/i and CommandLine = /*backup*/i and CommandLine = /* -r */i))))
