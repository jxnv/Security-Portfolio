// Date: 2020-10-19
// Tags: attack.discovery, attack.t1083
// Description: Detects usage of system utilities such as "find", "tree", "findmnt", etc, to discover files, directories and network shares.
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*/file/i and CommandLine =~ /(.){200,}/i) or (ImageFileName = /.*/find/i) or (ImageFileName = /.*/findmnt/i) or (ImageFileName = /.*/mlocate/i) or (ImageFileName = /.*/ls/i and CommandLine = /*-R*/i) or (ImageFileName = /.*/tree/i))
