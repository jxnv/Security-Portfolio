// Title: CobaltStrike Named Pipe Pattern Regex
// ID: 0e7163d4-9e19-4fa7-9be6-000c61aad77a
// Status: test
// Level: critical
// Author: Florian Roth (Nextron Systems)
// Date: 2021-07-30
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects the creation of a named pipe matching a pattern used by CobaltStrike Malleable C2 profiles
// Converted by: Sigma Universal SIEM/EDR CLI

((PipeName =~ /\\mojo\.5688\.8052\.(?:183894939787088877|35780273329370473)[0-9a-f]{2}/i) or (PipeName =~ /\\wkssvc_?[0-9a-f]{2}/i) or (PipeName =~ /\\ntsvcs[0-9a-f]{2}/i) or (PipeName =~ /\\DserNamePipe[0-9a-f]{2}/i) or (PipeName =~ /\\SearchTextHarvester[0-9a-f]{2}/i) or (PipeName =~ /\\mypipe-(?:f|h)[0-9a-f]{2}/i) or (PipeName =~ /\\windows\.update\.manager[0-9a-f]{2,3}/i) or (PipeName =~ /\\ntsvcs_[0-9a-f]{2}/i) or (PipeName =~ /\\scerpc_?[0-9a-f]{2}/i) or (PipeName =~ /\\PGMessagePipe[0-9a-f]{2}/i) or (PipeName =~ /\\MsFteWds[0-9a-f]{2}/i) or (PipeName =~ /\\f4c3[0-9a-f]{2}/i) or (PipeName =~ /\\fullduplex_[0-9a-f]{2}/i) or (PipeName =~ /\\msrpc_[0-9a-f]{4}/i) or (PipeName =~ /\\win\\msrpc_[0-9a-f]{2}/i) or (PipeName =~ /\\f53f[0-9a-f]{2}$/i) or (PipeName =~ /\\rpc_[0-9a-f]{2}/i) or (PipeName =~ /\\spoolss_[0-9a-f]{2}/i) or (PipeName =~ /\\Winsock2\\CatalogChangeListener-[0-9a-f]{3}-0,/i))
