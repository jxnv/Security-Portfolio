// Title: Always Install Elevated Windows Installer
// ID: cd951fdc-4b2f-47f5-ba99-a33bf61e3770
// Status: test
// Level: medium
// Author: Teymur Kheirkhabarov (idea), Mangatas Tondang (rule), oscd.community
// Date: 2020-10-13
// Tags: attack.privilege-escalation, attack.t1548.002
// Description: Detects Windows Installer service (msiexec.exe) trying to install MSI packages with SYSTEM privilege
// Converted by: Sigma Universal SIEM/EDR CLI

((((ImageFileName = /*\\Windows\\Installer\\*/i and ImageFileName = /*msi*/i) and ImageFileName = /.*tmp/i) or (ImageFileName = /.*\\msiexec.exe/i and (IntegrityLevel = "System" or IntegrityLevel = "S-1-16-16384"))) and ((UserName = /*AUTHORI*/i or UserName = /*AUTORI*/i)) and not((((ParentBaseFileName = /C:\\Program Files\\Avast Software\\.*/i or ParentBaseFileName = /C:\\Program Files (x86)\\Avast Software\\.*/i)) or (ParentBaseFileName = /C:\\ProgramData\\Avira\\.*/i) or ((ParentBaseFileName = /C:\\Program Files\\Google\\Update\\.*/i or ParentBaseFileName = /C:\\Program Files (x86)\\Google\\Update\\.*/i)) or (ParentBaseFileName = "C:\\Windows\\System32\\services.exe") or ((CommandLine = /.*\\system32\\msiexec.exe /V/i) or (ParentCommandLine = /.*\\system32\\msiexec.exe /V/i)) or (ParentBaseFileName = /C:\\ProgramData\\Sophos\\.*/i))))
