// Title: Potentially Suspicious GrantedAccess Flags On LSASS
// ID: a18dd26b-6450-46de-8c91-9659150cf088
// Status: test
// Level: medium
// Author: Florian Roth, Roberto Rodriguez, Dimitrios Slamaris, Mark Russinovich, Thomas Patzke, Teymur Kheirkhabarov, Sherif Eldeeb, James Dickenson, Aleksey Potapov, oscd.community
// Date: 2021-11-22
// Tags: attack.credential-access, attack.t1003.001, attack.s0002
// Description: Detects process access requests to LSASS process with potentially suspicious access flags
// Converted by: Sigma Universal SIEM/EDR CLI

(((((GrantedAccess = /.*30/i or GrantedAccess = /.*50/i or GrantedAccess = /.*70/i or GrantedAccess = /.*90/i or GrantedAccess = /.*B0/i or GrantedAccess = /.*D0/i or GrantedAccess = /.*F0/i or GrantedAccess = /.*18/i or GrantedAccess = /.*38/i or GrantedAccess = /.*58/i or GrantedAccess = /.*78/i or GrantedAccess = /.*98/i or GrantedAccess = /.*B8/i or GrantedAccess = /.*D8/i or GrantedAccess = /.*F8/i or GrantedAccess = /.*1A/i or GrantedAccess = /.*3A/i or GrantedAccess = /.*5A/i or GrantedAccess = /.*7A/i or GrantedAccess = /.*9A/i or GrantedAccess = /.*BA/i or GrantedAccess = /.*DA/i or GrantedAccess = /.*FA/i or GrantedAccess = /.*0x14C2/i)) or ((GrantedAccess = /0x100000.*/i or GrantedAccess = /0x1418.*/i or GrantedAccess = /0x1438.*/i or GrantedAccess = /0x143a.*/i or GrantedAccess = /0x1f0fff.*/i or GrantedAccess = /0x1f1fff.*/i or GrantedAccess = /0x1f2fff.*/i or GrantedAccess = /0x1f3fff.*/i or GrantedAccess = /0x40.*/i))) and (TargetImage = /.*\\lsass.exe/i)) and not(((SourceImage = /.*\\explorer.exe/i and GrantedAccess = "0x401") or ((SourceImage = /*:\\Program Files (x86)\\*/i or SourceImage = /*:\\Program Files\\*/i or SourceImage = /*:\\Windows\\System32\\*/i or SourceImage = /*:\\Windows\\SysWOW64\\*/i)) or (SourceImage = /*:\\ProgramData\\Microsoft\\Windows Defender\\*/i and SourceImage = /.*\\MsMpEng.exe/i) or ((CallTrace = /*|?:\\ProgramData\\Microsoft\\Windows Defender\\Definition Updates\\{*/i and CallTrace = /*}\\mpengine.dll+*/i) and GrantedAccess = "0x1418") or ((CallTrace = /*|c:\\program files\\windows defender\\mprtp.dll*/i or CallTrace = /*|c:\\program files\\windows defender\\MpClient.dll*/i)))) and not(((SourceImage = /.*:\\ProgramData\\MALWAREBYTES\\MBAMSERVICE\\ctlrupdate\\mbupdatr.exe/i) or (SourceImage = /.*\\MBAMInstallerService.exe/i and GrantedAccess = "0x40") or ((SourceImage = /.*\\aurora-agent-64.exe/i or SourceImage = /.*\\aurora-agent.exe/i or SourceImage = /.*\\thor.exe/i or SourceImage = /.*\\thor64.exe/i) and GrantedAccess = "0x40") or (SourceImage = /*\\SteamLibrary\\steamapps\\*/i) or ((SourceImage = /.*\\handle.exe/i or SourceImage = /.*\\handle64.exe/i or SourceImage = /.*\\handle64a.exe/i) and GrantedAccess = "0x40") or ((SourceImage = /.*\\PROCEXP64.EXE/i or SourceImage = /.*\\PROCEXP.EXE/i) and GrantedAccess = "0x40") or (SourceImage = /*:\\ProgramData\\VMware\\VMware Tools\\*/i and SourceImage = /.*\\vmtoolsd.exe/i) or (SourceImage = /.*\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe/i) or (SourceImage = /.*\\AppData\\Local\\WebEx\\WebexHost.exe/i and GrantedAccess = "0x401"))))
