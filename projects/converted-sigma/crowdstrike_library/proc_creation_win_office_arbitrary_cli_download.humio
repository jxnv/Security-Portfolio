// Title: Potential Arbitrary File Download Using Office Application
// ID: 4ae3e30b-b03f-43aa-87e3-b622f4048eed
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Beyu Denis, oscd.community
// Date: 2022-05-17
// Tags: attack.stealth, attack.t1202
// Description: Detects potential arbitrary file download using a Microsoft Office application
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*http://*/i or CommandLine = /*https://*/i)) and (((ImageFileName = /.*\\EXCEL.EXE/i or ImageFileName = /.*\\MSOXMLED.EXE/i or ImageFileName = /.*\\POWERPNT.EXE/i or ImageFileName = /.*\\WINWORD.exe/i)) or ((OriginalFilename = "Excel.exe" or OriginalFilename = "msoxmled.exe" or OriginalFilename = "POWERPNT.EXE" or OriginalFilename = "WinWord.exe"))))
