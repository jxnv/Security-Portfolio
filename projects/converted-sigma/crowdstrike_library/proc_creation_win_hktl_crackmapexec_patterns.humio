(((CommandLine = /*tasklist /fi */i and CommandLine = /*Imagename eq lsass.exe*/i) and (CommandLine = /*cmd.exe /c */i or CommandLine = /*cmd.exe /r */i or CommandLine = /*cmd.exe /k */i or CommandLine = /*cmd /c */i or CommandLine = /*cmd /r */i or CommandLine = /*cmd /k */i) and (UserName = /*AUTHORI*/i or UserName = /*AUTORI*/i)) or ((CommandLine = /*do rundll32.exe C:\\windows\\System32\\comsvcs.dll, MiniDump*/i and CommandLine = /*\\Windows\\Temp\\*/i and CommandLine = /* full*/i and CommandLine = /*%%B*/i)) or ((CommandLine = /*tasklist /v /fo csv*/i and CommandLine = /*findstr /i \"lsass\"*/i)))
