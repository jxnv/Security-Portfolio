// Title: LSASS Memory Access by Tool With Dump Keyword In Name
// ID: 9bd012ee-0dff-44d7-84a0-aa698cfd87a3
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-10
// Tags: attack.credential-access, attack.t1003.001, attack.s0002
// Description: Detects LSASS process access requests from a source process with the "dump" keyword in its image name.
// Converted by: Sigma Universal SIEM/EDR CLI

(TargetImage = /.*\\lsass.exe/i and SourceImage = /*dump*/i and (GrantedAccess = /.*10/i or GrantedAccess = /.*30/i or GrantedAccess = /.*50/i or GrantedAccess = /.*70/i or GrantedAccess = /.*90/i or GrantedAccess = /.*B0/i or GrantedAccess = /.*D0/i or GrantedAccess = /.*F0/i or GrantedAccess = /.*18/i or GrantedAccess = /.*38/i or GrantedAccess = /.*58/i or GrantedAccess = /.*78/i or GrantedAccess = /.*98/i or GrantedAccess = /.*B8/i or GrantedAccess = /.*D8/i or GrantedAccess = /.*F8/i or GrantedAccess = /.*1A/i or GrantedAccess = /.*3A/i or GrantedAccess = /.*5A/i or GrantedAccess = /.*7A/i or GrantedAccess = /.*9A/i or GrantedAccess = /.*BA/i or GrantedAccess = /.*DA/i or GrantedAccess = /.*FA/i or GrantedAccess = /.*0x14C2/i or GrantedAccess = /.*FF/i))
