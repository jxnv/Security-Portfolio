// Description: Detects presence of a potentially xor encoded powershell command
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*ForEach*/i or CommandLine = /*for(*/i or CommandLine = /*for */i or CommandLine = /*-join */i or CommandLine = /*-join'*/i or CommandLine = /*-join\"*/i or CommandLine = /*-join`*/i or CommandLine = /*::Join*/i or CommandLine = /*[char]*/i)) and (CommandLine = /*bxor*/i) and (((ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i)) or ((OriginalFilename = "PowerShell.EXE" or OriginalFilename = "pwsh.dll")) or (Description = "Windows PowerShell") or (Product = "PowerShell Core 6")))
