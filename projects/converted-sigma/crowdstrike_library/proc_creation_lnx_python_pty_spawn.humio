// Tags: attack.execution, attack.t1059
// Description: Detects a python process calling to the PTY module in order to spawn a pretty tty which could be indicative of potential reverse shell activity.
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*import pty*/i or CommandLine = /*from pty */i)) and (CommandLine = /*spawn*/i) and (((ImageFileName = /.*/python/i or ImageFileName = /.*/python2/i or ImageFileName = /.*/python3/i)) or ((ImageFileName = /*/python2.*/i or ImageFileName = /*/python3.*/i))))
