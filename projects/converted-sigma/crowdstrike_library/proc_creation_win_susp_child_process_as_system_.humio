// Title: Suspicious Child Process Created as System
// ID: 590a5f4c-6c8c-4f10-8307-89afe9453a9d
// Status: test
// Level: high
// Author: Teymur Kheirkhabarov, Roberto Rodriguez (@Cyb3rWard0g), Open Threat Research (OTR)
// Date: 2019-10-26
// Tags: attack.privilege-escalation, attack.stealth, attack.t1134.002
// Description: Detection of child processes spawned with SYSTEM privileges by parents with LOCAL SERVICE or NETWORK SERVICE accounts
// Converted by: Sigma Universal SIEM/EDR CLI

(((ParentUser = /*AUTHORI*/i or ParentUser = /*AUTORI*/i) and (ParentUser = /.*\\NETWORK SERVICE/i or ParentUser = /.*\\LOCAL SERVICE/i) and (UserName = /*AUTHORI*/i or UserName = /*AUTORI*/i) and (UserName = /.*\\SYSTEM/i or UserName = /.*\\Système/i or UserName = /.*\\СИСТЕМА/i) and (IntegrityLevel = "System" or IntegrityLevel = "S-1-16-16384")) and not((ImageFileName = /.*\\rundll32.exe/i and CommandLine = /*DavSetCookie*/i)))
