// Tags: attack.discovery, attack.t1069.001
// Description: Detects enumeration of local system groups
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*/dscacheutil/i and (CommandLine = /*-q*/i and CommandLine = /*group*/i)) or (ImageFileName = /.*/cat/i and CommandLine = /*/etc/group*/i) or (ImageFileName = /.*/dscl/i and (CommandLine = /*-list*/i and CommandLine = /*/groups*/i)))
