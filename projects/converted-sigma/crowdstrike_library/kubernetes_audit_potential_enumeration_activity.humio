// Converted by: Sigma Universal SIEM/EDR CLI

((responseStatus.code = "ALLOW") and (((requestURI = /*%2fbin%2fash*/i or requestURI = /*%2fbin%2fbash*/i or requestURI = /*%2fbin%2fbusybox*/i or requestURI = /*%2fbin%2fdash*/i or requestURI = /*%2fbin%2fsh*/i or requestURI = /*%2fbin%2fzsh*/i or requestURI = /*/bin/ash*/i or requestURI = /*/bin/bash*/i or requestURI = /*/bin/busybox*/i or requestURI = /*/bin/dash*/i or requestURI = /*/bin/sh*/i or requestURI = /*/bin/zsh*/i or requestURI = /*%2fusr%2fbin%2fcurl*/i or requestURI = /*%2fusr%2fbin%2fkubectl*/i or requestURI = /*%2fusr%2fbin%2fperl*/i or requestURI = /*%2fusr%2fbin%2fpython*/i or requestURI = /*%2fusr%2fbin%2fwget*/i or requestURI = /*/usr/bin/curl*/i or requestURI = /*/usr/bin/kubectl*/i or requestURI = /*/usr/bin/perl*/i or requestURI = /*/usr/bin/python*/i or requestURI = /*/usr/bin/wget*/i)) or ((userAgent = /*access_matrix*/i or userAgent = /*trufflehog*/i or userAgent = /*azurehound*/i or userAgent = /*micro-scanner*/i))))
