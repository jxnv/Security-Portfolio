// Title: Suspicious Modification Of Scheduled Tasks
// ID: 1c0e41cd-21bb-4433-9acc-4a2cd6367b9b
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-28
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects when an attacker tries to modify an already existing scheduled tasks to run from a suspicious location
// Attackers can create a simple looking task in order to avoid detection on creation as it's often the most focused on
// Instead they modify the task after creation to include their malicious payload
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*\\schtasks.exe/i and (CommandLine = /* /Change */i and CommandLine = /* /TN */i)) and ((CommandLine = /*regsvr32*/i or CommandLine = /*rundll32*/i or CommandLine = /*cmd /c */i or CommandLine = /*cmd /k */i or CommandLine = /*cmd /r */i or CommandLine = /*cmd.exe /c */i or CommandLine = /*cmd.exe /k */i or CommandLine = /*cmd.exe /r */i or CommandLine = /*powershell*/i or CommandLine = /*mshta*/i or CommandLine = /*wscript*/i or CommandLine = /*cscript*/i or CommandLine = /*certutil*/i or CommandLine = /*bitsadmin*/i or CommandLine = /*bash.exe*/i or CommandLine = /*bash */i or CommandLine = /*scrcons*/i or CommandLine = /*wmic */i or CommandLine = /*wmic.exe*/i or CommandLine = /*forfiles*/i or CommandLine = /*scriptrunner*/i or CommandLine = /*hh.exe*/i or CommandLine = /*hh */i)) and ((CommandLine = /*\\AppData\\Local\\Temp*/i or CommandLine = /*\\AppData\\Roaming\\*/i or CommandLine = /*\\Users\\Public\\*/i or CommandLine = /*\\WINDOWS\\Temp\\*/i or CommandLine = /*\\Desktop\\*/i or CommandLine = /*\\Downloads\\*/i or CommandLine = /*\\Temporary Internet*/i or CommandLine = /*C:\\ProgramData\\*/i or CommandLine = /*C:\\Perflogs\\*/i or CommandLine = /*%ProgramData%*/i or CommandLine = /*%appdata%*/i or CommandLine = /*%comspec%*/i or CommandLine = /*%localappdata%*/i)))
