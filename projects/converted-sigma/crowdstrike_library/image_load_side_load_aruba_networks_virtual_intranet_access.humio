// Title: Aruba Network Service Potential DLL Sideloading
// ID: 90ae0469-0cee-4509-b67f-e5efcef040f7
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-22
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading activity via the Aruba Networks Virtual Intranet Access "arubanetsvc.exe" process using DLL Search Order Hijacking
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*\\arubanetsvc.exe/i and (ImageLoaded = /.*\\wtsapi32.dll/i or ImageLoaded = /.*\\msvcr100.dll/i or ImageLoaded = /.*\\msvcp100.dll/i or ImageLoaded = /.*\\dbghelp.dll/i or ImageLoaded = /.*\\dbgcore.dll/i or ImageLoaded = /.*\\wininet.dll/i or ImageLoaded = /.*\\iphlpapi.dll/i or ImageLoaded = /.*\\version.dll/i or ImageLoaded = /.*\\cryptsp.dll/i or ImageLoaded = /.*\\cryptbase.dll/i or ImageLoaded = /.*\\wldp.dll/i or ImageLoaded = /.*\\profapi.dll/i or ImageLoaded = /.*\\sspicli.dll/i or ImageLoaded = /.*\\winsta.dll/i or ImageLoaded = /.*\\dpapi.dll/i)) and not(((ImageLoaded = /C:\\Windows\\System32\\.*/i or ImageLoaded = /C:\\Windows\\SysWOW64\\.*/i or ImageLoaded = /C:\\Windows\\WinSxS\\.*/i))))
