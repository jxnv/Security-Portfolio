// Title: Suspicious Schtasks Schedule Types
// ID: 24c8392b-aa3c-46b7-a545-43f71657fe98
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects scheduled task creations or modification on a suspicious schedule type
// Converted by: Sigma Universal SIEM/EDR CLI

((((ImageFileName = /.*\\schtasks.exe/i) or (OriginalFilename = "schtasks.exe")) and ((CommandLine = /* ONLOGON */i or CommandLine = /* ONSTART */i or CommandLine = /* ONCE */i or CommandLine = /* ONIDLE */i))) and not(((CommandLine = /*NT AUT*/i or CommandLine = /* SYSTEM*/i or CommandLine = /*HIGHEST*/i))))
