// Title: PowerShell Core DLL Loaded Via Office Application
// ID: bb2ba6fb-95d4-4a25-89fc-30bb736c021a
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-01
// Tags: attack.stealth
// Description: Detects PowerShell core DLL being loaded by an Office Product
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*\\excel.exe/i or ImageFileName = /.*\\mspub.exe/i or ImageFileName = /.*\\outlook.exe/i or ImageFileName = /.*\\onenote.exe/i or ImageFileName = /.*\\onenoteim.exe/i or ImageFileName = /.*\\powerpnt.exe/i or ImageFileName = /.*\\winword.exe/i) and (ImageLoaded = /*\\System.Management.Automation.Dll*/i or ImageLoaded = /*\\System.Management.Automation.ni.Dll*/i))
