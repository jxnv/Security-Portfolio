// Title: Potentially Suspicious Wuauclt Network Connection
// ID: c649a6c7-cd8c-4a78-9c04-000fc76df954
// Status: test
// Level: medium
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2020-10-12
// Tags: attack.stealth, attack.t1218
// Description: Detects the use of the Windows Update Client binary (wuauclt.exe) to proxy execute code and making network connections.
// One could easily make the DLL spawn a new process and inject to it to proxy the network connection and bypass this rule.
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /*wuauclt*/i and CommandLine = /* /RunHandlerComServer*/i) and not(((CommandLine = "") or (not(CommandLine = *)) or ((cidr(ip=DestinationIp, subnet="127.0.0.0/8") or cidr(ip=DestinationIp, subnet="10.0.0.0/8") or cidr(ip=DestinationIp, subnet="169.254.0.0/16") or cidr(ip=DestinationIp, subnet="172.16.0.0/12") or cidr(ip=DestinationIp, subnet="192.168.0.0/16") or cidr(ip=DestinationIp, subnet="::1/128") or cidr(ip=DestinationIp, subnet="fe80::/10") or cidr(ip=DestinationIp, subnet="fc00::/7"))) or ((cidr(ip=DestinationIp, subnet="20.184.0.0/13") or cidr(ip=DestinationIp, subnet="20.192.0.0/10") or cidr(ip=DestinationIp, subnet="23.79.0.0/16") or cidr(ip=DestinationIp, subnet="51.10.0.0/15") or cidr(ip=DestinationIp, subnet="51.103.0.0/16") or cidr(ip=DestinationIp, subnet="51.104.0.0/15") or cidr(ip=DestinationIp, subnet="52.224.0.0/11"))) or ((CommandLine = /*:\\Windows\\UUS\\Packages\\Preview\\amd64\\updatedeploy.dll /ClassId*/i or CommandLine = /*:\\Windows\\UUS\\amd64\\UpdateDeploy.dll /ClassId*/i)) or ((CommandLine = /*:\\Windows\\WinSxS\\*/i and CommandLine = /*\\UpdateDeploy.dll /ClassId */i)))))
