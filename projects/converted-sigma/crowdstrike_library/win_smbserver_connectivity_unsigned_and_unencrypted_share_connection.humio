// Title: Unsigned or Unencrypted SMB Connection to Share Established
// ID: 8d91f6e4-9f3b-4c21-ae41-2c5b7d9f7a12
// Status: experimental
// Level: medium
// Author: Mohamed Abdelghani
// Date: 2025-10-19
// Tags: attack.lateral-movement, attack.t1021.002
// Description: Detects SMB server connections to shares without signing or encryption enabled.
// This could indicate potential lateral movement activity using unsecured SMB shares.
// Converted by: Sigma Universal SIEM/EDR CLI

(((EventID = 4000 and (ShareName = /*IPC$*/i or ShareName = /*ADMIN$*/i or ShareName = /*C$*/i)) and ((SigningUsed = "false") or (EncyptionUsed = "false"))) and not((((cidr(ip=ClientAddress, subnet="127.0.0.0/8") or cidr(ip=ClientAddress, subnet="169.254.0.0/16") or cidr(ip=ClientAddress, subnet="::1/128") or cidr(ip=ClientAddress, subnet="fe80::/10") or cidr(ip=ClientAddress, subnet="fc00::/7"))) or ((ClientAddress = /*00000000000000000000000000000001*/i or ClientAddress = /*FE80000000000000*/i or ClientAddress = /*FC00000000000000*/i or ClientAddress = /*0200????7F*/i or ClientAddress = /*0200????A9FE*/i)))))
