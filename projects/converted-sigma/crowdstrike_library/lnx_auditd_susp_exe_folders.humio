// Title: Program Executions in Suspicious Folders
// ID: a39d7fa7-3fbd-4dc2-97e1-d87f546b1bbc
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2018-01-23
// Tags: attack.t1587, attack.t1584, attack.resource-development
// Description: Detects program executions in suspicious non-program folders related to malware or hacking activity
// Converted by: Sigma Universal SIEM/EDR CLI

(type = "SYSCALL" and (exe = //tmp/.*/i or exe = //var/www/.*/i or exe = //home/*/public_html/.*/i or exe = //usr/local/apache2/.*/i or exe = //usr/local/httpd/.*/i or exe = //var/apache/.*/i or exe = //srv/www/.*/i or exe = //home/httpd/html/.*/i or exe = //srv/http/.*/i or exe = //usr/share/nginx/html/.*/i or exe = //var/lib/pgsql/data/.*/i or exe = //usr/local/mysql/data/.*/i or exe = //var/lib/mysql/.*/i or exe = //var/vsftpd/.*/i or exe = //etc/bind/.*/i or exe = //var/named/.*/i))
