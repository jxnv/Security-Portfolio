// Tags: attack.execution, attack.t1047
// Description: Detects usage of wmic to start or stop a service
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /* service */i and CommandLine = /* call */i) and (CommandLine = /*stopservice*/i or CommandLine = /*startservice*/i)) and ((OriginalFilename = "wmic.exe") or (ImageFileName = /.*\\WMIC.exe/i)))
