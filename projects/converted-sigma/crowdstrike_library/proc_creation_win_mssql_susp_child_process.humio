// Title: Suspicious Child Process Of SQL Server
// ID: 869b9ca7-9ea2-4a5a-8325-e80e62f75445
// Status: test
// Level: high
// Author: FPT.EagleEye Team, wagga
// Date: 2020-12-11
// Tags: attack.t1505.003, attack.t1190, attack.initial-access, attack.persistence, attack.privilege-escalation
// Description: Detects suspicious child processes of the SQLServer process. This could indicate potential RCE or SQL Injection.
// Converted by: Sigma Universal SIEM/EDR CLI

((ParentBaseFileName = /.*\\sqlservr.exe/i and (ImageFileName = /.*\\bash.exe/i or ImageFileName = /.*\\bitsadmin.exe/i or ImageFileName = /.*\\cmd.exe/i or ImageFileName = /.*\\netstat.exe/i or ImageFileName = /.*\\nltest.exe/i or ImageFileName = /.*\\ping.exe/i or ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i or ImageFileName = /.*\\regsvr32.exe/i or ImageFileName = /.*\\rundll32.exe/i or ImageFileName = /.*\\sh.exe/i or ImageFileName = /.*\\systeminfo.exe/i or ImageFileName = /.*\\tasklist.exe/i or ImageFileName = /.*\\wsl.exe/i)) and not((ParentBaseFileName = /C:\\Program Files\\Microsoft SQL Server\\.*/i and ParentBaseFileName = /.*DATEV_DBENGINE\\MSSQL\\Binn\\sqlservr.exe/i and ImageFileName = "C:\\Windows\\System32\\cmd.exe" and CommandLine = /\"C:\\Windows\\system32\\cmd.exe\" .*/i)))
