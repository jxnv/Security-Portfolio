// Description: Detects findstring commands that include the keyword lsass, which indicates recon actviity for the LSASS process PID
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*lsass*/i) and (((ImageFileName = /.*\\find.exe/i or ImageFileName = /.*\\findstr.exe/i)) or ((OriginalFilename = "FIND.EXE" or OriginalFilename = "FINDSTR.EXE")))) or ((CommandLine = /* /i \"lsass*/i or CommandLine = /* /i lsass.exe*/i or CommandLine = /*findstr \"lsass*/i or CommandLine = /*findstr lsass*/i or CommandLine = /*findstr.exe \"lsass*/i or CommandLine = /*findstr.exe lsass*/i)))
