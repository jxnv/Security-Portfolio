// Title: Potentially Suspicious ODBC Driver Registered
// ID: e4d22291-f3d5-4b78-9a0c-a1fbaf32a6a4
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-23
// Tags: attack.credential-access, attack.persistence, attack.t1003
// Description: Detects the registration of a new ODBC driver where the driver is located in a potentially suspicious location
// Converted by: Sigma Universal SIEM/EDR CLI

(TargetObject = /*\\SOFTWARE\\ODBC\\ODBCINST.INI\\*/i and (TargetObject = /.*\\Driver/i or TargetObject = /.*\\Setup/i) and (Details = /*:\\PerfLogs\\*/i or Details = /*:\\ProgramData\\*/i or Details = /*:\\Temp\\*/i or Details = /*:\\Users\\Public\\*/i or Details = /*:\\Windows\\Registration\\CRMLog*/i or Details = /*:\\Windows\\System32\\com\\dmp\\*/i or Details = /*:\\Windows\\System32\\FxsTmp\\*/i or Details = /*:\\Windows\\System32\\Microsoft\\Crypto\\RSA\\MachineKeys\\*/i or Details = /*:\\Windows\\System32\\spool\\drivers\\color\\*/i or Details = /*:\\Windows\\System32\\spool\\PRINTERS\\*/i or Details = /*:\\Windows\\System32\\spool\\SERVERS\\*/i or Details = /*:\\Windows\\System32\\Tasks_Migrated\\*/i or Details = /*:\\Windows\\System32\\Tasks\\Microsoft\\Windows\\SyncCenter\\*/i or Details = /*:\\Windows\\SysWOW64\\com\\dmp\\*/i or Details = /*:\\Windows\\SysWOW64\\FxsTmp\\*/i or Details = /*:\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\PLA\\System\\*/i or Details = /*:\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\SyncCenter\\*/i or Details = /*:\\Windows\\Tasks\\*/i or Details = /*:\\Windows\\Temp\\*/i or Details = /*:\\Windows\\Tracing\\*/i or Details = /*\\AppData\\Local\\Temp\\*/i or Details = /*\\AppData\\Roaming\\*/i))
