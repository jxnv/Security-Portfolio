// Title: Suspicious File Downloaded From Direct IP Via Certutil.EXE
// ID: 13e6fe51-d478-4c7e-b0f2-6da9b400a829
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-15
// Tags: attack.stealth, attack.t1027, attack.command-and-control, attack.t1105
// Description: Detects the execution of certutil with certain flags that allow the utility to download files from direct IPs.
// Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine = /*urlcache */i or CommandLine = /*verifyctl */i or CommandLine = /*URL */i)) and ((CommandLine = /*://1*/i or CommandLine = /*://2*/i or CommandLine = /*://3*/i or CommandLine = /*://4*/i or CommandLine = /*://5*/i or CommandLine = /*://6*/i or CommandLine = /*://7*/i or CommandLine = /*://8*/i or CommandLine = /*://9*/i)) and ((ImageFileName = /.*\\certutil.exe/i) or (OriginalFilename = "CertUtil.exe"))) and not((CommandLine = /*://7-*/i)))
