// Title: Potential Suspicious Winget Package Installation
// ID: a3f5c081-e75b-43a0-9f5b-51f26fe5dba2
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.persistence, attack.stealth
// Description: Detects potential suspicious winget package installation from a suspicious source.
// Converted by: Sigma Universal SIEM/EDR CLI

(Contents = /[ZoneTransfer]  ZoneId=3.*/i and (Contents = /*://1*/i or Contents = /*://2*/i or Contents = /*://3*/i or Contents = /*://4*/i or Contents = /*://5*/i or Contents = /*://6*/i or Contents = /*://7*/i or Contents = /*://8*/i or Contents = /*://9*/i) and TargetFileName = /.*:Zone.Identifier/i and TargetFileName = /*\\AppData\\Local\\Temp\\WinGet\\*/i)
