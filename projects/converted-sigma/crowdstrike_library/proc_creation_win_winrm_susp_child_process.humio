// Title: Suspicious Processes Spawned by WinRM
// ID: 5cc2cda8-f261-4d88-a2de-e9e193c86716
// Status: test
// Level: high
// Author: Andreas Hunkeler (@Karneades), Markus Neis
// Date: 2021-05-20
// Tags: attack.t1190, attack.initial-access, attack.persistence, attack.privilege-escalation
// Description: Detects suspicious processes including shells spawnd from WinRM host process
// Converted by: Sigma Universal SIEM/EDR CLI

(ParentBaseFileName = /.*\\wsmprovhost.exe/i and (ImageFileName = /.*\\cmd.exe/i or ImageFileName = /.*\\sh.exe/i or ImageFileName = /.*\\bash.exe/i or ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i or ImageFileName = /.*\\wsl.exe/i or ImageFileName = /.*\\schtasks.exe/i or ImageFileName = /.*\\certutil.exe/i or ImageFileName = /.*\\whoami.exe/i or ImageFileName = /.*\\bitsadmin.exe/i))
