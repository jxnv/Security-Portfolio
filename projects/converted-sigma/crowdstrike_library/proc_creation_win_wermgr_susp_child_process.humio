// Title: Suspicious Child Process Of Wermgr.EXE
// ID: 396f6630-f3ac-44e3-bfc8-1b161bc00c4e
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-10-14
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055, attack.t1036
// Description: Detects suspicious Windows Error Reporting manager (wermgr.exe) child process
// Converted by: Sigma Universal SIEM/EDR CLI

((ParentBaseFileName = /.*\\wermgr.exe/i and (ImageFileName = /.*\\cmd.exe/i or ImageFileName = /.*\\cscript.exe/i or ImageFileName = /.*\\ipconfig.exe/i or ImageFileName = /.*\\mshta.exe/i or ImageFileName = /.*\\net.exe/i or ImageFileName = /.*\\net1.exe/i or ImageFileName = /.*\\netstat.exe/i or ImageFileName = /.*\\nslookup.exe/i or ImageFileName = /.*\\powershell_ise.exe/i or ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i or ImageFileName = /.*\\regsvr32.exe/i or ImageFileName = /.*\\rundll32.exe/i or ImageFileName = /.*\\systeminfo.exe/i or ImageFileName = /.*\\whoami.exe/i or ImageFileName = /.*\\wscript.exe/i)) and not((ImageFileName = /.*\\rundll32.exe/i and (CommandLine = /*C:\\Windows\\system32\\WerConCpl.dll*/i and CommandLine = /*LaunchErcApp */i) and (CommandLine = /*-queuereporting*/i or CommandLine = /*-responsepester*/i))))
