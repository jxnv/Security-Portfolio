// Title: HackTool Service Registration or Execution
// ID: d26ce60c-2151-403c-9a42-49420d87b5e4
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-21
// Tags: attack.execution, attack.t1569.002, attack.s0029
// Description: Detects installation or execution of services
// Converted by: Sigma Universal SIEM/EDR CLI

((Provider_Name = "Service Control Manager" and (EventID = 7045 or EventID = 7036)) and ((ImagePath = /*bypass*/i) or ((ServiceName = /*cachedump*/i or ServiceName = /*DumpSvc*/i or ServiceName = /*gsecdump*/i or ServiceName = /*pwdump*/i or ServiceName = /*UACBypassedService*/i or ServiceName = /*WCE SERVICE*/i or ServiceName = /*WCESERVICE*/i or ServiceName = /*winexesvc*/i))))
