// Title: Suspicious MSDT Parent Process
// ID: 7a74da6b-ea76-47db-92cc-874ad90df734
// Status: test
// Level: high
// Author: Nextron Systems
// Date: 2022-06-01
// Tags: attack.stealth, attack.t1036, attack.t1218
// Description: Detects msdt.exe executed by a suspicious parent as seen in CVE-2022-30190 / Follina exploitation
// Converted by: Sigma Universal SIEM/EDR CLI

(((ImageFileName = /.*\\msdt.exe/i) or (OriginalFilename = "msdt.exe")) and ((ParentBaseFileName = /.*\\cmd.exe/i or ParentBaseFileName = /.*\\cscript.exe/i or ParentBaseFileName = /.*\\mshta.exe/i or ParentBaseFileName = /.*\\powershell.exe/i or ParentBaseFileName = /.*\\pwsh.exe/i or ParentBaseFileName = /.*\\regsvr32.exe/i or ParentBaseFileName = /.*\\rundll32.exe/i or ParentBaseFileName = /.*\\schtasks.exe/i or ParentBaseFileName = /.*\\wmic.exe/i or ParentBaseFileName = /.*\\wscript.exe/i or ParentBaseFileName = /.*\\wsl.exe/i)))
