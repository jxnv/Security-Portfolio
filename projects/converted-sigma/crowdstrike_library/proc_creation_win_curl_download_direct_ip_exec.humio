// Title: File Download From IP URL Via Curl.EXE
// ID: 9cc85849-3b02-4cb5-b371-3a1ff54f2218
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-10-18
// Tags: attack.execution
// Description: Detects file downloads directly from IP address URL using curl.exe
// Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine = /* -O*/i or CommandLine = /*--remote-name*/i or CommandLine = /*--output*/i)) and (CommandLine = /*http*/i) and ((ImageFileName = /.*\\curl.exe/i) or (OriginalFilename = "curl.exe")) and (CommandLine =~ /://[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}/i)) and not(((CommandLine = /.*.bat/i or CommandLine = /.*.bat\"/i or CommandLine = /.*.dat/i or CommandLine = /.*.dat\"/i or CommandLine = /.*.dll/i or CommandLine = /.*.dll\"/i or CommandLine = /.*.exe/i or CommandLine = /.*.exe\"/i or CommandLine = /.*.gif/i or CommandLine = /.*.gif\"/i or CommandLine = /.*.hta/i or CommandLine = /.*.hta\"/i or CommandLine = /.*.jpeg/i or CommandLine = /.*.jpeg\"/i or CommandLine = /.*.log/i or CommandLine = /.*.log\"/i or CommandLine = /.*.msi/i or CommandLine = /.*.msi\"/i or CommandLine = /.*.png/i or CommandLine = /.*.png\"/i or CommandLine = /.*.ps1/i or CommandLine = /.*.ps1\"/i or CommandLine = /.*.psm1/i or CommandLine = /.*.psm1\"/i or CommandLine = /.*.vbe/i or CommandLine = /.*.vbe\"/i or CommandLine = /.*.vbs/i or CommandLine = /.*.vbs\"/i or CommandLine = /.*.bat'/i or CommandLine = /.*.dat'/i or CommandLine = /.*.dll'/i or CommandLine = /.*.exe'/i or CommandLine = /.*.gif'/i or CommandLine = /.*.hta'/i or CommandLine = /.*.jpeg'/i or CommandLine = /.*.log'/i or CommandLine = /.*.msi'/i or CommandLine = /.*.png'/i or CommandLine = /.*.ps1'/i or CommandLine = /.*.psm1'/i or CommandLine = /.*.vbe'/i or CommandLine = /.*.vbs'/i))))
