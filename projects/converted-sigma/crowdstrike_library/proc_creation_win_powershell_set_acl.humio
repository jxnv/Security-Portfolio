// Title: PowerShell Script Change Permission Via Set-Acl
// ID: bdeb2cff-af74-4094-8426-724dc937f20a
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-18
// Tags: attack.stealth
// Description: Detects PowerShell execution to set the ACL of a file or a folder
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*Set-Acl */i and CommandLine = /*-AclObject */i and CommandLine = /*-Path */i)) and (((OriginalFilename = "PowerShell.EXE" or OriginalFilename = "pwsh.dll")) or ((ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i))))
