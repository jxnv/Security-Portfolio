// Title: New Root or CA or AuthRoot Certificate to Store
// ID: d223b46b-5621-4037-88fe-fda32eead684
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-04-04
// Tags: attack.impact, attack.t1490
// Description: Detects the addition of new root, CA or AuthRoot certificates to the Windows registry
// Converted by: Sigma Universal SIEM/EDR CLI

((TargetObject = /*\\SOFTWARE\\Microsoft\\SystemCertificates\\Root\\Certificates\\*/i or TargetObject = /*\\SOFTWARE\\Policies\\Microsoft\\SystemCertificates\\Root\\Certificates\\*/i or TargetObject = /*\\SOFTWARE\\Microsoft\\EnterpriseCertificates\\Root\\Certificates\\*/i or TargetObject = /*\\SOFTWARE\\Microsoft\\SystemCertificates\\CA\\Certificates\\*/i or TargetObject = /*\\SOFTWARE\\Policies\\Microsoft\\SystemCertificates\\CA\\Certificates\\*/i or TargetObject = /*\\SOFTWARE\\Microsoft\\EnterpriseCertificates\\CA\\Certificates\\*/i or TargetObject = /*\\SOFTWARE\\Microsoft\\SystemCertificates\\AuthRoot\\Certificates\\*/i or TargetObject = /*\\SOFTWARE\\Policies\\Microsoft\\SystemCertificates\\AuthRoot\\Certificates\\*/i or TargetObject = /*\\SOFTWARE\\Microsoft\\EnterpriseCertificates\\AuthRoot\\Certificates\\*/i) and TargetObject = /.*\\Blob/i and Details = "Binary Data")
