// Tags: attack.command-and-control, attack.t1105
// Description: Detects a network connection initiated by programs or processes running from suspicious or uncommon files system locations.
// Converted by: Sigma Universal SIEM/EDR CLI

((Initiated = "true" and (ImageFileName = /*:\\$Recycle.bin*/i or ImageFileName = /*:\\Perflogs\\*/i or ImageFileName = /*:\\Temp\\*/i or ImageFileName = /*:\\Users\\Default\\*/i or ImageFileName = /*:\\Users\\Public\\*/i or ImageFileName = /*:\\Windows\\Fonts\\*/i or ImageFileName = /*:\\Windows\\IME\\*/i or ImageFileName = /*:\\Windows\\System32\\Tasks\\*/i or ImageFileName = /*:\\Windows\\Tasks\\*/i or ImageFileName = /*\\config\\systemprofile\\*/i or ImageFileName = /*\\Contacts\\*/i or ImageFileName = /*\\Favorites\\*/i or ImageFileName = /*\\Favourites\\*/i or ImageFileName = /*\\Music\\*/i or ImageFileName = /*\\Pictures\\*/i or ImageFileName = /*\\Videos\\*/i or ImageFileName = /*\\Windows\\addins\\*/i)) and not(((DestinationHostname = /.*.githubusercontent.com/i or DestinationHostname = /.*0x0.st/i or DestinationHostname = /.*anonfiles.com/i or DestinationHostname = /.*bashupload.com/i or DestinationHostname = /.*cdn.discordapp.com/i or DestinationHostname = /.*chunk.io/i or DestinationHostname = /.*ddns.net/i or DestinationHostname = /.*dl.dropboxusercontent.com/i or DestinationHostname = /.*ghostbin.co/i or DestinationHostname = /.*github.com/i or DestinationHostname = /.*glitch.me/i or DestinationHostname = /.*gofile.io/i or DestinationHostname = /.*hastebin.com/i or DestinationHostname = /.*mediafire.com/i or DestinationHostname = /.*mega.co.nz/i or DestinationHostname = /.*mega.nz/i or DestinationHostname = /.*onrender.com/i or DestinationHostname = /.*pages.dev/i or DestinationHostname = /.*paste.ee/i or DestinationHostname = /.*pastebin.com/i or DestinationHostname = /.*pastebin.pl/i or DestinationHostname = /.*pastetext.net/i or DestinationHostname = /.*portmap.io/i or DestinationHostname = /.*privatlab.com/i or DestinationHostname = /.*privatlab.net/i or DestinationHostname = /.*send.exploit.in/i or DestinationHostname = /.*sendspace.com/i or DestinationHostname = /.*storage.googleapis.com/i or DestinationHostname = /.*storjshare.io/i or DestinationHostname = /.*supabase.co/i or DestinationHostname = /.*temp.sh/i or DestinationHostname = /.*transfer.sh/i or DestinationHostname = /.*trycloudflare.com/i or DestinationHostname = /.*ufile.io/i or DestinationHostname = /.*w3spaces.com/i or DestinationHostname = /.*workers.dev/i or DestinationHostname = /.*x0.at/i))))
