// Title: Suspicious Git Clone - Linux
// ID: cfec9d29-64ec-4a0f-9ffe-0fdb856d5446
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-03
// Tags: attack.reconnaissance, attack.t1593.003
// Description: Detects execution of "git" in order to clone a remote repository that contain suspicious keywords which might be suspicious
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*/git/i and CommandLine = /* clone */i) and ((CommandLine = /*exploit*/i or CommandLine = /*Vulns*/i or CommandLine = /*vulnerability*/i or CommandLine = /*RCE*/i or CommandLine = /*RemoteCodeExecution*/i or CommandLine = /*Invoke-*/i or CommandLine = /*CVE-*/i or CommandLine = /*poc-*/i or CommandLine = /*ProofOfConcept*/i or CommandLine = /*proxyshell*/i or CommandLine = /*log4shell*/i or CommandLine = /*eternalblue*/i or CommandLine = /*eternal-blue*/i or CommandLine = /*MS17-*/i)))
