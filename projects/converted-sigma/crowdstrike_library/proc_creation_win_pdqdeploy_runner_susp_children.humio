// Title: Potentially Suspicious Execution Of PDQDeployRunner
// ID: 12b8e9f5-96b2-41e1-9a42-8c6779a5c184
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-22
// Tags: attack.execution
// Description: Detects suspicious execution of "PDQDeployRunner" which is part of the PDQDeploy service stack that is responsible for executing commands and packages on a remote machines
// Converted by: Sigma Universal SIEM/EDR CLI

((((ImageFileName = /.*\\bash.exe/i or ImageFileName = /.*\\certutil.exe/i or ImageFileName = /.*\\cmd.exe/i or ImageFileName = /.*\\csc.exe/i or ImageFileName = /.*\\cscript.exe/i or ImageFileName = /.*\\dllhost.exe/i or ImageFileName = /.*\\mshta.exe/i or ImageFileName = /.*\\msiexec.exe/i or ImageFileName = /.*\\regsvr32.exe/i or ImageFileName = /.*\\rundll32.exe/i or ImageFileName = /.*\\scriptrunner.exe/i or ImageFileName = /.*\\wmic.exe/i or ImageFileName = /.*\\wscript.exe/i or ImageFileName = /.*\\wsl.exe/i)) or ((ImageFileName = /*:\\ProgramData\\*/i or ImageFileName = /*:\\Users\\Public\\*/i or ImageFileName = /*:\\Windows\\TEMP\\*/i or ImageFileName = /*\\AppData\\Local\\Temp*/i)) or ((CommandLine = /* -decode */i or CommandLine = /* -enc */i or CommandLine = /* -encodedcommand */i or CommandLine = /* -w hidden*/i or CommandLine = /*DownloadString*/i or CommandLine = /*FromBase64String*/i or CommandLine = /*http*/i or CommandLine = /*iex */i or CommandLine = /*Invoke-*/i))) and (ParentBaseFileName = /*\\PDQDeployRunner-*/i))
