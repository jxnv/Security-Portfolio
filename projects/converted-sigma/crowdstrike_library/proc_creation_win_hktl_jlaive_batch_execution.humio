// Title: HackTool - Jlaive In-Memory Assembly Execution
// ID: 0a99eb3e-1617-41bd-b095-13dc767f3def
// Status: test
// Level: medium
// Author: Jose Luis Sanchez Martinez (@Joseliyo_Jstnk)
// Date: 2022-05-24
// Tags: attack.execution, attack.t1059.003
// Description: Detects the use of Jlaive to execute assemblies in a copied PowerShell
// Converted by: Sigma Universal SIEM/EDR CLI

((ParentBaseFileName = /.*\\cmd.exe/i and ParentCommandLine = /.*.bat/i) and ((ImageFileName = /.*\\xcopy.exe/i and (CommandLine = /*powershell.exe*/i and CommandLine = /*.bat.exe*/i)) or (ImageFileName = /.*\\xcopy.exe/i and (CommandLine = /*pwsh.exe*/i and CommandLine = /*.bat.exe*/i)) or (ImageFileName = /.*\\attrib.exe/i and (CommandLine = /*+s*/i and CommandLine = /*+h*/i and CommandLine = /*.bat.exe*/i))))
