// Title: PowerShell Core DLL Loaded By Non PowerShell Process
// ID: 092bc4b9-3d1d-43b4-a6b4-8c8acd83522f
// Status: test
// Level: medium
// Author: Tom Kern, oscd.community, Natalia Shornikova, Tim Shelton, Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2019-11-14
// Tags: attack.t1059.001, attack.execution
// Description: Detects loading of essential DLLs used by PowerShell by non-PowerShell process.
// Detects behavior similar to meterpreter's "load powershell" extension.
// Converted by: Sigma Universal SIEM/EDR CLI

(((Description = "System.Management.Automation") or (OriginalFilename = "System.Management.Automation.dll") or ((ImageLoaded = /.*\\System.Management.Automation.dll/i or ImageLoaded = /.*\\System.Management.Automation.ni.dll/i))) and not((((ImageFileName = /C:\\Windows\\Microsoft.NET\\Framework\\.*/i or ImageFileName = /C:\\Windows\\Microsoft.NET\\FrameworkArm\\.*/i or ImageFileName = /C:\\Windows\\Microsoft.NET\\FrameworkArm64\\.*/i or ImageFileName = /C:\\Windows\\Microsoft.NET\\Framework64\\.*/i) and ImageFileName = /.*\\mscorsvw.exe/i) or ((ImageFileName = "C:\\Windows\\System32\\dsac.exe" or ImageFileName = "C:\\WINDOWS\\System32\\RemoteFXvGPUDisablement.exe" or ImageFileName = "C:\\Windows\\System32\\runscripthelper.exe" or ImageFileName = "C:\\WINDOWS\\System32\\sdiagnhost.exe" or ImageFileName = "C:\\Windows\\System32\\ServerManager.exe" or ImageFileName = "C:\\Windows\\System32\\SyncAppvPublishingServer.exe" or ImageFileName = "C:\\Windows\\System32\\winrshost.exe" or ImageFileName = "C:\\Windows\\System32\\wsmprovhost.exe" or ImageFileName = "C:\\Windows\\SysWOW64\\winrshost.exe" or ImageFileName = "C:\\Windows\\SysWOW64\\wsmprovhost.exe")) or ((ImageFileName = "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" or ImageFileName = "C:\\Program Files\\PowerShell\\7\\pwsh.exe" or ImageFileName = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or ImageFileName = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" or ImageFileName = "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or ImageFileName = "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")) or ((ImageFileName = /*C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview*/i or ImageFileName = /*\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview*/i) and ImageFileName = /.*\\pwsh.exe/i))) and not(((not(ImageFileName = *)) or (ImageFileName = /C:\\ProgramData\\chocolatey\\choco.exe.*/i) or (ImageFileName = /.*\\Citrix\\ConfigSync\\ConfigSyncRun.exe/i) or (ImageFileName = /C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_.*/i and ImageFileName = /.*\\GetHelp.exe/i) or (ImageFileName = /C:\\Windows\\Temp\\asgard2-agent\\.*/i and (ImageFileName = /.*\\thor64.exe/i or ImageFileName = /.*\\thor.exe/i)) or ((ImageFileName = /C:\\Program Files (x86)\\Microsoft SQL Server Management Studio.*/i or ImageFileName = /C:\\Program Files\\Microsoft SQL Server Management Studio.*/i) and ImageFileName = /.*\\IDE\\Ssms.exe/i) or ((ImageFileName = /C:\\Program Files (x86)\\Microsoft SQL Server\\.*/i or ImageFileName = /C:\\Program Files\\Microsoft SQL Server\\.*/i) and ImageFileName = /.*\\Tools\\Binn\\SQLPS.exe/i) or ((ImageFileName = /C:\\Program Files (x86)\\Microsoft Visual Studio\\.*/i or ImageFileName = /C:\\Program Files\\Microsoft Visual Studio\\.*/i)))))
