// Title: Obfuscated IP Download Activity
// ID: cb5a2333-56cf-4562-8fcb-22ba1bca728d
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2022-08-03
// Tags: attack.discovery
// Description: Detects use of an encoded/obfuscated version of an IP address (hex, octal...) in an URL combined with a download command
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*Invoke-WebRequest*/i or CommandLine = /*iwr */i or CommandLine = /*Invoke-RestMethod*/i or CommandLine = /*irm */i or CommandLine = /*wget */i or CommandLine = /*curl */i or CommandLine = /*DownloadFile*/i or CommandLine = /*DownloadString*/i)) and (((CommandLine = /* 0x*/i or CommandLine = /*//0x*/i or CommandLine = /*.0x*/i or CommandLine = /*.00x*/i)) or ((CommandLine = /*http://%*/i and CommandLine = /*%2e*/i)) or ((CommandLine =~ /https?://[0-9]{1,3}\.[0-9]{1,3}\.0[0-9]{3,4}/i) or (CommandLine =~ /https?://[0-9]{1,3}\.0[0-9]{3,7}/i) or (CommandLine =~ /https?://0[0-9]{3,11}/i) or (CommandLine =~ /https?://(?:0[0-9]{1,11}\.){3}0[0-9]{1,11}/i) or (CommandLine =~ /https?://0[0-9]{1,11}/i) or (CommandLine =~ / [0-7]{7,13}/i))) and not((CommandLine =~ /https?://(?:(?:25[0-5]|(?:2[0-4]|1\d|[1-9])?\d)(?:\.|\b)){4}/i)))
