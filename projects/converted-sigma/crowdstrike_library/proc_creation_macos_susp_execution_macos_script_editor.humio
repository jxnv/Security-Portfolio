// Tags: attack.defense-impairment, attack.t1566, attack.t1566.002, attack.initial-access, attack.t1059, attack.t1059.002, attack.t1204, attack.t1204.001, attack.execution, attack.persistence, attack.t1553
// Description: Detects when the macOS Script Editor utility spawns an unusual child process.
// Converted by: Sigma Universal SIEM/EDR CLI

((((ImageFileName = /.*/curl/i or ImageFileName = /.*/bash/i or ImageFileName = /.*/sh/i or ImageFileName = /.*/zsh/i or ImageFileName = /.*/dash/i or ImageFileName = /.*/fish/i or ImageFileName = /.*/osascript/i or ImageFileName = /.*/mktemp/i or ImageFileName = /.*/chmod/i or ImageFileName = /.*/php/i or ImageFileName = /.*/nohup/i or ImageFileName = /.*/openssl/i or ImageFileName = /.*/plutil/i or ImageFileName = /.*/PlistBuddy/i or ImageFileName = /.*/xattr/i or ImageFileName = /.*/sqlite/i or ImageFileName = /.*/funzip/i or ImageFileName = /.*/popen/i)) or ((ImageFileName = /*python*/i or ImageFileName = /*perl*/i))) and (ParentBaseFileName = /.*/Script Editor/i))
