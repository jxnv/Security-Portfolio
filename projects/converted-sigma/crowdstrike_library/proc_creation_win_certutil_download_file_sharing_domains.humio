// Description: Detects the execution of certutil with certain flags that allow the utility to download files from file-sharing websites.
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*urlcache */i or CommandLine = /*verifyctl */i or CommandLine = /*URL */i)) and ((CommandLine = /*.githubusercontent.com*/i or CommandLine = /*0x0.st*/i or CommandLine = /*anonfiles.com*/i or CommandLine = /*bashupload.com*/i or CommandLine = /*cdn.discordapp.com*/i or CommandLine = /*chunk.io*/i or CommandLine = /*ddns.net*/i or CommandLine = /*dl.dropboxusercontent.com*/i or CommandLine = /*ghostbin.co*/i or CommandLine = /*github.com*/i or CommandLine = /*glitch.me*/i or CommandLine = /*gofile.io*/i or CommandLine = /*hastebin.com*/i or CommandLine = /*mediafire.com*/i or CommandLine = /*mega.nz*/i or CommandLine = /*onrender.com*/i or CommandLine = /*pages.dev*/i or CommandLine = /*paste.ee*/i or CommandLine = /*pastebin.com*/i or CommandLine = /*pastebin.pl*/i or CommandLine = /*pastetext.net*/i or CommandLine = /*privatlab.com*/i or CommandLine = /*privatlab.net*/i or CommandLine = /*send.exploit.in*/i or CommandLine = /*sendspace.com*/i or CommandLine = /*storage.googleapis.com*/i or CommandLine = /*storjshare.io*/i or CommandLine = /*supabase.co*/i or CommandLine = /*temp.sh*/i or CommandLine = /*transfer.sh*/i or CommandLine = /*trycloudflare.com*/i or CommandLine = /*ufile.io*/i or CommandLine = /*w3spaces.com*/i or CommandLine = /*workers.dev*/i or CommandLine = /*x0.at*/i)) and ((ImageFileName = /.*\\certutil.exe/i) or (OriginalFilename = "CertUtil.exe")))
