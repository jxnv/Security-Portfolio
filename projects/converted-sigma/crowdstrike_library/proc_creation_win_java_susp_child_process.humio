// Title: Suspicious Processes Spawned by Java.EXE
// ID: 0d34ed8b-1c12-4ff2-828c-16fc860b766d
// Status: test
// Level: high
// Author: Andreas Hunkeler (@Karneades), Florian Roth
// Date: 2021-12-17
// Tags: attack.initial-access, attack.persistence, attack.privilege-escalation
// Description: Detects suspicious processes spawned from a Java host process which could indicate a sign of exploitation (e.g. log4j)
// Converted by: Sigma Universal SIEM/EDR CLI

(ParentBaseFileName = /.*\\java.exe/i and (ImageFileName = /.*\\AppVLP.exe/i or ImageFileName = /.*\\bitsadmin.exe/i or ImageFileName = /.*\\certutil.exe/i or ImageFileName = /.*\\cscript.exe/i or ImageFileName = /.*\\curl.exe/i or ImageFileName = /.*\\forfiles.exe/i or ImageFileName = /.*\\hh.exe/i or ImageFileName = /.*\\mftrace.exe/i or ImageFileName = /.*\\mshta.exe/i or ImageFileName = /.*\\net.exe/i or ImageFileName = /.*\\net1.exe/i or ImageFileName = /.*\\query.exe/i or ImageFileName = /.*\\reg.exe/i or ImageFileName = /.*\\regsvr32.exe/i or ImageFileName = /.*\\rundll32.exe/i or ImageFileName = /.*\\schtasks.exe/i or ImageFileName = /.*\\scrcons.exe/i or ImageFileName = /.*\\scriptrunner.exe/i or ImageFileName = /.*\\sh.exe/i or ImageFileName = /.*\\systeminfo.exe/i or ImageFileName = /.*\\whoami.exe/i or ImageFileName = /.*\\wmic.exe/i or ImageFileName = /.*\\wscript.exe/i))
