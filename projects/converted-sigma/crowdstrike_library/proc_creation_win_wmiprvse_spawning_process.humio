// Title: WmiPrvSE Spawned A Process
// ID: d21374ff-f574-44a7-9998-4a8c8bf33d7d
// Status: stable
// Level: medium
// Author: Roberto Rodriguez @Cyb3rWard0g
// Date: 2019-08-15
// Tags: attack.execution, attack.t1047
// Description: Detects WmiPrvSE spawning a process
// Converted by: Sigma Universal SIEM/EDR CLI

((ParentBaseFileName = /.*\\WmiPrvSe.exe/i) and not((((LogonId = "0x3e7" or LogonId = "null")) or (not(LogonId = *)) or ((UserName = /*AUTHORI*/i or UserName = /*AUTORI*/i)) or (ImageFileName = /.*\\WerFault.exe/i) or (ImageFileName = /.*\\WmiPrvSE.exe/i))))
