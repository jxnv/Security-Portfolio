((ParentBaseFileName = /.*\\wbem\\WmiPrvSE.exe/i) and (((ImageFileName = /.*\\certutil.exe/i or ImageFileName = /.*\\cscript.exe/i or ImageFileName = /.*\\mshta.exe/i or ImageFileName = /.*\\msiexec.exe/i or ImageFileName = /.*\\regsvr32.exe/i or ImageFileName = /.*\\rundll32.exe/i or ImageFileName = /.*\\verclsid.exe/i or ImageFileName = /.*\\wscript.exe/i)) or (ImageFileName = /.*\\cmd.exe/i and (CommandLine = /*cscript*/i or CommandLine = /*mshta*/i or CommandLine = /*powershell*/i or CommandLine = /*pwsh*/i or CommandLine = /*regsvr32*/i or CommandLine = /*rundll32*/i or CommandLine = /*wscript*/i))) and not(((ImageFileName = /.*\\msiexec.exe/i and CommandLine = /*/i */i) or (ImageFileName = /.*\\WerFault.exe/i) or (ImageFileName = /.*\\WmiPrvSE.exe/i))))
