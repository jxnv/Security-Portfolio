// Title: Potentially Suspicious Execution Of Regasm/Regsvcs From Uncommon Location
// ID: cc368ed0-2411-45dc-a222-510ace303cb2
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-25
// Tags: attack.stealth, attack.t1218.009
// Description: Detects potentially suspicious execution of the Regasm/Regsvcs utilities from a potentially suspicious location
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*\\AppData\\Local\\Temp\\*/i or CommandLine = /*\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\*/i or CommandLine = /*\\PerfLogs\\*/i or CommandLine = /*\\Users\\Public\\*/i or CommandLine = /*\\Windows\\Temp\\*/i)) and (((ImageFileName = /.*\\Regsvcs.exe/i or ImageFileName = /.*\\Regasm.exe/i)) or ((OriginalFilename = "RegSvcs.exe" or OriginalFilename = "RegAsm.exe"))))
