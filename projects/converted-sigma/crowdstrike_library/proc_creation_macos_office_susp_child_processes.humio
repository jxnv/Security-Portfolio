// Title: Suspicious Microsoft Office Child Process - MacOS
// ID: 69483748-1525-4a6c-95ca-90dc8d431b68
// Status: test
// Level: high
// Author: Sohan G (D4rkCiph3r)
// Date: 2023-01-31
// Tags: attack.execution, attack.persistence, attack.t1059.002, attack.t1137.002, attack.t1204.002
// Description: Detects suspicious child processes spawning from microsoft office suite applications such as word or excel. This could indicates malicious macro execution
// Converted by: Sigma Universal SIEM/EDR CLI

((ParentBaseFileName = /*Microsoft Word*/i or ParentBaseFileName = /*Microsoft Excel*/i or ParentBaseFileName = /*Microsoft PowerPoint*/i or ParentBaseFileName = /*Microsoft OneNote*/i) and (ImageFileName = /.*/bash/i or ImageFileName = /.*/curl/i or ImageFileName = /.*/dash/i or ImageFileName = /.*/fish/i or ImageFileName = /.*/osacompile/i or ImageFileName = /.*/osascript/i or ImageFileName = /.*/sh/i or ImageFileName = /.*/zsh/i or ImageFileName = /.*/python/i or ImageFileName = /.*/python3/i or ImageFileName = /.*/wget/i))
