// Title: Linux Package Uninstall
// ID: 95d61234-7f56-465c-6f2d-b562c6fedbc4
// Status: test
// Level: low
// Author: Tuan Le (NCSGroup), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-03-09
// Tags: attack.stealth, attack.t1070
// Description: Detects linux package removal using builtin tools such as "yum", "apt", "apt-get" or "dpkg".
// Converted by: Sigma Universal SIEM/EDR CLI

(((ImageFileName = /.*/apt/i or ImageFileName = /.*/apt-get/i) and (CommandLine = /*remove*/i or CommandLine = /*purge*/i)) or (ImageFileName = /.*/dpkg/i and (CommandLine = /*--remove */i or CommandLine = /* -r */i)) or (ImageFileName = /.*/rpm/i and CommandLine = /* -e */i) or (ImageFileName = /.*/yum/i and (CommandLine = /*erase*/i or CommandLine = /*remove*/i)))
