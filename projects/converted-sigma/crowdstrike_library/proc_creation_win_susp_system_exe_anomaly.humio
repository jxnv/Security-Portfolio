// Title: System File Execution Location Anomaly
// ID: e4a6b256-3e47-40fc-89d2-7a477edd6915
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Patrick Bareiss, Anton Kutepov, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2017-11-27
// Tags: attack.stealth, attack.t1036
// Description: Detects the execution of a Windows system binary that is usually located in the system folder from an uncommon location.
// Converted by: Sigma Universal SIEM/EDR CLI

(((ImageFileName = /.*\\atbroker.exe/i or ImageFileName = /.*\\audiodg.exe/i or ImageFileName = /.*\\bcdedit.exe/i or ImageFileName = /.*\\bitsadmin.exe/i or ImageFileName = /.*\\certreq.exe/i or ImageFileName = /.*\\certutil.exe/i or ImageFileName = /.*\\cmstp.exe/i or ImageFileName = /.*\\conhost.exe/i or ImageFileName = /.*\\consent.exe/i or ImageFileName = /.*\\cscript.exe/i or ImageFileName = /.*\\csrss.exe/i or ImageFileName = /.*\\dashost.exe/i or ImageFileName = /.*\\defrag.exe/i or ImageFileName = /.*\\dfrgui.exe/i or ImageFileName = /.*\\dism.exe/i or ImageFileName = /.*\\dllhost.exe/i or ImageFileName = /.*\\dllhst3g.exe/i or ImageFileName = /.*\\dwm.exe/i or ImageFileName = /.*\\eventvwr.exe/i or ImageFileName = /.*\\fsquirt.exe/i or ImageFileName = /.*\\finger.exe/i or ImageFileName = /.*\\logonui.exe/i or ImageFileName = /.*\\LsaIso.exe/i or ImageFileName = /.*\\lsass.exe/i or ImageFileName = /.*\\lsm.exe/i or ImageFileName = /.*\\msiexec.exe/i or ImageFileName = /.*\\ntoskrnl.exe/i or ImageFileName = /.*\\powershell_ise.exe/i or ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i or ImageFileName = /.*\\regsvr32.exe/i or ImageFileName = /.*\\rundll32.exe/i or ImageFileName = /.*\\runonce.exe/i or ImageFileName = /.*\\RuntimeBroker.exe/i or ImageFileName = /.*\\schtasks.exe/i or ImageFileName = /.*\\services.exe/i or ImageFileName = /.*\\sihost.exe/i or ImageFileName = /.*\\smartscreen.exe/i or ImageFileName = /.*\\smss.exe/i or ImageFileName = /.*\\spoolsv.exe/i or ImageFileName = /.*\\svchost.exe/i or ImageFileName = /.*\\taskhost.exe/i or ImageFileName = /.*\\taskhostw.exe/i or ImageFileName = /.*\\Taskmgr.exe/i or ImageFileName = /.*\\userinit.exe/i or ImageFileName = /.*\\werfault.exe/i or ImageFileName = /.*\\werfaultsecure.exe/i or ImageFileName = /.*\\wininit.exe/i or ImageFileName = /.*\\winlogon.exe/i or ImageFileName = /.*\\winver.exe/i or ImageFileName = /.*\\wlanext.exe/i or ImageFileName = /.*\\wmic.exe/i or ImageFileName = /.*\\wscript.exe/i or ImageFileName = /.*\\wsl.exe/i or ImageFileName = /.*\\wsmprovhost.exe/i)) and not((((ImageFileName = /C:\\$WINDOWS.~BT\\.*/i or ImageFileName = /C:\\$WinREAgent\\.*/i or ImageFileName = /C:\\Windows\\SoftwareDistribution\\.*/i or ImageFileName = /C:\\Windows\\System32\\.*/i or ImageFileName = /C:\\Windows\\SystemTemp\\.*/i or ImageFileName = /C:\\Windows\\SysWOW64\\.*/i or ImageFileName = /C:\\Windows\\uus\\.*/i or ImageFileName = /C:\\Windows\\WinSxS\\.*/i)) or ((ImageFileName = /*C:\\Program Files\\PowerShell\\7\\*/i or ImageFileName = /*C:\\Program Files\\PowerShell\\7-preview\\*/i or ImageFileName = /*C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview*/i or ImageFileName = /*\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview*/i) and ImageFileName = /.*\\pwsh.exe/i) or (ImageFileName = /C:\\Users\\.*/i and ImageFileName = /*\\AppData\\Local\\Microsoft\\WindowsApps\\*/i and ImageFileName = /.*\\wsl.exe/i) or ((ImageFileName = /C:\\Program Files\\WindowsApps\\MicrosoftCorporationII.WindowsSubsystemForLinux.*/i or ImageFileName = /C:\\Program Files\\WSL\\.*/i) and ImageFileName = /.*\\wsl.exe/i))) and not((ImageFileName = /*\\SystemRoot\\System32\\*/i)))
