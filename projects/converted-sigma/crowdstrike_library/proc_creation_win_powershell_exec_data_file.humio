(((CommandLine = /*iex */i or CommandLine = /*Invoke-Expression */i or CommandLine = /*Invoke-Command */i or CommandLine = /*icm */i)) and (CommandLine = /* -raw*/i) and ((CommandLine = /*cat */i or CommandLine = /*get-content */i or CommandLine = /*type */i)))
