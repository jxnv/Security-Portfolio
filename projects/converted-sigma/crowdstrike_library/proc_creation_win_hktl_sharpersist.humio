// Description: Detects the execution of the hacktool SharPersist - used to deploy various different kinds of persistence mechanisms
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /* -t schtask -c */i or CommandLine = /* -t startupfolder -c */i)) or ((CommandLine = /* -t reg -c */i and CommandLine = /* -m add*/i)) or ((CommandLine = /* -t service -c */i and CommandLine = /* -m add*/i)) or ((CommandLine = /* -t schtask -c */i and CommandLine = /* -m add*/i)) or ((ImageFileName = /.*\\SharPersist.exe/i) or (Product = "SharPersist")))
