// Description: Detects the creation of files that look like exports of the local SAM (Security Account Manager)
// Converted by: Sigma Universal SIEM/EDR CLI

(((TargetFileName = /.*\\Temp\\sam/i or TargetFileName = /.*\\sam.sav/i or TargetFileName = /.*\\Intel\\sam/i or TargetFileName = /.*\\sam.hive/i or TargetFileName = /.*\\Perflogs\\sam/i or TargetFileName = /.*\\ProgramData\\sam/i or TargetFileName = /.*\\Users\\Public\\sam/i or TargetFileName = /.*\\AppData\\Local\\sam/i or TargetFileName = /.*\\AppData\\Roaming\\sam/i or TargetFileName = /.*_ShadowSteal.zip/i or TargetFileName = /.*\\Documents\\SAM.export/i or TargetFileName = /.*:\\sam/i)) or ((TargetFileName = /*\\hive_sam_*/i or TargetFileName = /*\\sam.save*/i or TargetFileName = /*\\sam.export*/i or TargetFileName = /*\\~reg_sam.save*/i or TargetFileName = /*\\sam_backup*/i or TargetFileName = /*\\sam.bck*/i or TargetFileName = /*\\sam.backup*/i)))
