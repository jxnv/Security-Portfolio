// Title: VHD Image Download Via Browser
// ID: 8468111a-ef07-4654-903b-b863a80bbc95
// Status: test
// Level: medium
// Author: frack113, Christopher Peacock '@securepeacock', SCYTHE '@scythe_io'
// Date: 2021-10-25
// Tags: attack.resource-development, attack.t1587.001
// Description: Detects creation of ".vhd"/".vhdx" files by browser processes.
// Malware can use mountable Virtual Hard Disk ".vhd" files to encapsulate payloads and evade security controls.
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*\\brave.exe/i or ImageFileName = /.*\\chrome.exe/i or ImageFileName = /.*\\firefox.exe/i or ImageFileName = /.*\\iexplore.exe/i or ImageFileName = /.*\\maxthon.exe/i or ImageFileName = /.*\\MicrosoftEdge.exe/i or ImageFileName = /.*\\msedge.exe/i or ImageFileName = /.*\\msedgewebview2.exe/i or ImageFileName = /.*\\opera.exe/i or ImageFileName = /.*\\safari.exe/i or ImageFileName = /.*\\seamonkey.exe/i or ImageFileName = /.*\\vivaldi.exe/i or ImageFileName = /.*\\whale.exe/i) and TargetFileName = /*.vhd*/i)
