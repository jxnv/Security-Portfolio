// Title: Suspicious Use of PsLogList
// ID: aae1243f-d8af-40d8-ab20-33fc6d0c55bc
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-12-18
// Tags: attack.discovery, attack.t1087, attack.t1087.001, attack.t1087.002
// Description: Detects usage of the PsLogList utility to dump event log in order to extract admin accounts and perform account discovery or delete events logs
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /* security*/i or CommandLine = /* application*/i or CommandLine = /* system*/i)) and ((CommandLine = /* -d*/i or CommandLine = /* -x*/i or CommandLine = /* -s*/i or CommandLine = /* -c*/i or CommandLine = /* -g*/i)) and ((OriginalFilename = "psloglist.exe") or ((ImageFileName = /.*\\psloglist.exe/i or ImageFileName = /.*\\psloglist64.exe/i or ImageFileName = /.*\\psloglist64a.exe/i))))
