// Title: Uncommon Outbound Kerberos Connection - Security
// ID: eca91c7c-9214-47b9-b4c5-cb1d7e4f2350
// Status: test
// Level: medium
// Author: Ilyas Ochkov, oscd.community
// Date: 2019-10-24
// Tags: attack.lateral-movement, attack.credential-access, attack.t1558.003
// Description: Detects uncommon outbound network activity via Kerberos default port indicating possible lateral movement or first stage PrivEsc via delegation.
// Converted by: Sigma Universal SIEM/EDR CLI

((EventID = 5156 and DestPort = 88) and not(((Application = /\\device\\harddiskvolume.*/i or Application = /C:.*/i) and Application = /.*\\Windows\\System32\\lsass.exe/i)) and not((((Application = /\\device\\harddiskvolume.*/i or Application = /C:.*/i) and (Application = /.*\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe/i or Application = /.*\\Program Files\\Google\\Chrome\\Application\\chrome.exe/i)) or ((Application = /\\device\\harddiskvolume.*/i or Application = /C:.*/i) and (Application = /.*\\Program Files (x86)\\Mozilla Firefox\\firefox.exe/i or Application = /.*\\Program Files\\Mozilla Firefox\\firefox.exe/i)) or (Application = /.*\\tomcat\\bin\\tomcat8.exe/i))))
