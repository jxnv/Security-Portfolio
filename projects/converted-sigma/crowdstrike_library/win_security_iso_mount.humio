// Title: ISO Image Mounted
// ID: 0248a7bc-8a9a-4cd8-a57e-3ae8e073a073
// Status: test
// Level: medium
// Author: Syed Hasan (@syedhasan009)
// Date: 2021-05-29
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects the mount of an ISO image on an endpoint
// Converted by: Sigma Universal SIEM/EDR CLI

((EventID = 4663 and ObjectServer = "Security" and ObjectType = "File" and ObjectName = /\\Device\\CdRom.*/i) and not(((ObjectName = "\\Device\\CdRom0\\autorun.ico" or ObjectName = "\\Device\\CdRom0\\setup.exe" or ObjectName = "\\Device\\CdRom0\\setup64.exe"))))
