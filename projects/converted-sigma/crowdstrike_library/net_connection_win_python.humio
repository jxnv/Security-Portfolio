// Description: Detects a Python process initiating a network connection. While this often relates to package installation, it can also indicate a potential malicious script communicating with a C&C server.
// Converted by: Sigma Universal SIEM/EDR CLI

((Initiated = "true" and (ImageFileName = /*\\python*/i and ImageFileName = /*.exe*/i)) and not(((DestinationIp = "127.0.0.1" and SourceIp = "127.0.0.1") or ((CommandLine = /*pip.exe*/i and CommandLine = /*install*/i)))) and not(((ParentBaseFileName = "C:\\ProgramData\\Anaconda3\\Scripts\\conda.exe" and (CommandLine = /*:\\ProgramData\\Anaconda3\\Scripts\\conda-script.py*/i and CommandLine = /*update*/i)) or (ParentBaseFileName = "C:\\ProgramData\\Anaconda3\\python.exe" and CommandLine = /*C:\\ProgramData\\Anaconda3\\Scripts\\jupyter-notebook-script.py*/i))))
