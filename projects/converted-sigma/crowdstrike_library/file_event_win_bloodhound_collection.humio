// Description: Detects default file names outputted by the BloodHound collection tool SharpHound
// Converted by: Sigma Universal SIEM/EDR CLI

(((TargetFileName = /.*BloodHound.zip/i or TargetFileName = /.*_computers.json/i or TargetFileName = /.*_containers.json/i or TargetFileName = /.*_gpos.json/i or TargetFileName = /.*_groups.json/i or TargetFileName = /.*_ous.json/i or TargetFileName = /.*_users.json/i)) and not((ImageFileName = /.*\\svchost.exe/i and TargetFileName = /C:\\Program Files\\WindowsApps\\Microsoft..*/i and TargetFileName = /.*\\pocket_containers.json/i)))
