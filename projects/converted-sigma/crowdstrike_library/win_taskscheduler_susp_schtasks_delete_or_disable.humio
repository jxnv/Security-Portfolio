(((EventID = 141 or EventID = 142) and (TaskName = /*\\Windows\\SystemRestore\\SR*/i or TaskName = /*\\Windows\\Windows Defender\\*/i or TaskName = /*\\Windows\\BitLocker*/i or TaskName = /*\\Windows\\WindowsBackup\\*/i or TaskName = /*\\Windows\\WindowsUpdate\\*/i or TaskName = /*\\Windows\\UpdateOrchestrator\\*/i or TaskName = /*\\Windows\\ExploitGuard*/i)) and not(((UserName = /*AUTHORI*/i or UserName = /*AUTORI*/i))))
