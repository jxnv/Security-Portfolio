// Title: Exports Critical Registry Keys To a File
// ID: 82880171-b475-4201-b811-e9c826cd5eaa
// Status: test
// Level: high
// Author: Oddvar Moe, Sander Wiebing, oscd.community
// Date: 2020-10-12
// Tags: attack.exfiltration, attack.discovery, attack.t1012
// Description: Detects the export of a crital Registry key to a file.
// Converted by: Sigma Universal SIEM/EDR CLI

((CommandLine = /* -E */i) and ((CommandLine = /*hklm*/i or CommandLine = /*hkey_local_machine*/i)) and ((CommandLine = /.*\\system/i or CommandLine = /.*\\sam/i or CommandLine = /.*\\security/i)) and ((ImageFileName = /.*\\regedit.exe/i) or (OriginalFilename = "REGEDIT.EXE")))
