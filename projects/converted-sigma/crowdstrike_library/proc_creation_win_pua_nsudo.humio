(((CommandLine = /*-U:S */i or CommandLine = /*-U:T */i or CommandLine = /*-U:E */i or CommandLine = /*-P:E */i or CommandLine = /*-M:S */i or CommandLine = /*-M:H */i or CommandLine = /*-U=S */i or CommandLine = /*-U=T */i or CommandLine = /*-U=E */i or CommandLine = /*-P=E */i or CommandLine = /*-M=S */i or CommandLine = /*-M=H */i or CommandLine = /*-ShowWindowMode:Hide*/i)) and (((ImageFileName = /.*\\NSudo.exe/i or ImageFileName = /.*\\NSudoLC.exe/i or ImageFileName = /.*\\NSudoLG.exe/i)) or ((OriginalFilename = "NSudo.exe" or OriginalFilename = "NSudoLC.exe" or OriginalFilename = "NSudoLG.exe"))))
