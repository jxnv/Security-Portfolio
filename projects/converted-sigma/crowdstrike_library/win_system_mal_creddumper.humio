// Tags: attack.credential-access, attack.execution, attack.t1003.001, attack.t1003.002, attack.t1003.004, attack.t1003.005, attack.t1003.006, attack.t1569.002, attack.s0005
// Description: Detects well-known credential dumping tools execution via service execution events
// Converted by: Sigma Universal SIEM/EDR CLI

(Provider_Name = "Service Control Manager" and EventID = 7045 and (ImagePath = /*cachedump*/i or ImagePath = /*dumpsvc*/i or ImagePath = /*fgexec*/i or ImagePath = /*gsecdump*/i or ImagePath = /*mimidrv*/i or ImagePath = /*pwdump*/i or ImagePath = /*servpw*/i))
