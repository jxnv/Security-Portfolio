// Title: NTDS.DIT Creation By Uncommon Parent Process
// ID: 4e7050dd-e548-483f-b7d6-527ab4fa784d
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-11
// Tags: attack.credential-access, attack.t1003.003
// Description: Detects creation of a file named "ntds.dit" (Active Directory Database) by an uncommon parent process or directory
// Converted by: Sigma Universal SIEM/EDR CLI

((TargetFileName = /.*\\ntds.dit/i) and (((ParentBaseFileName = /.*\\cscript.exe/i or ParentBaseFileName = /.*\\httpd.exe/i or ParentBaseFileName = /.*\\nginx.exe/i or ParentBaseFileName = /.*\\php-cgi.exe/i or ParentBaseFileName = /.*\\powershell.exe/i or ParentBaseFileName = /.*\\pwsh.exe/i or ParentBaseFileName = /.*\\w3wp.exe/i or ParentBaseFileName = /.*\\wscript.exe/i)) or ((ParentBaseFileName = /*\\apache*/i or ParentBaseFileName = /*\\tomcat*/i or ParentBaseFileName = /*\\AppData\\*/i or ParentBaseFileName = /*\\Temp\\*/i or ParentBaseFileName = /*\\Public\\*/i or ParentBaseFileName = /*\\PerfLogs\\*/i))))
