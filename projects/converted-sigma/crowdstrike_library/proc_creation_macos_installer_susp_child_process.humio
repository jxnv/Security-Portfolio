// Title: Suspicious Installer Package Child Process
// ID: e0cfaecd-602d-41af-988d-f6ccebb2af26
// Status: test
// Level: medium
// Author: Sohan G (D4rkCiph3r)
// Date: 2023-02-18
// Tags: attack.t1059, attack.t1059.007, attack.t1071, attack.t1071.001, attack.execution, attack.command-and-control
// Description: Detects the execution of suspicious child processes from macOS installer package parent process. This includes osascript, JXA, curl and wget amongst other interpreters
// Converted by: Sigma Universal SIEM/EDR CLI

((ParentBaseFileName = /.*/package_script_service/i or ParentBaseFileName = /.*/installer/i) and (ImageFileName = /.*/sh/i or ImageFileName = /.*/bash/i or ImageFileName = /.*/dash/i or ImageFileName = /.*/python/i or ImageFileName = /.*/ruby/i or ImageFileName = /.*/perl/i or ImageFileName = /.*/php/i or ImageFileName = /.*/javascript/i or ImageFileName = /.*/osascript/i or ImageFileName = /.*/tclsh/i or ImageFileName = /.*/curl/i or ImageFileName = /.*/wget/i) and (CommandLine = /*preinstall*/i or CommandLine = /*postinstall*/i))
