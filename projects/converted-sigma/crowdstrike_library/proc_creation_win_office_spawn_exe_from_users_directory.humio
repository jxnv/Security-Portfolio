// Title: Suspicious Binary In User Directory Spawned From Office Application
// ID: aa3a6f94-890e-4e22-b634-ffdfd54792cc
// Status: test
// Level: high
// Author: Jason Lynch
// Date: 2019-04-02
// Tags: attack.execution, attack.t1204.002, attack.g0046, car.2013-05-002
// Description: Detects an executable in the users directory started from one of the Microsoft Office suite applications (Word, Excel, PowerPoint, Publisher, Visio)
// Converted by: Sigma Universal SIEM/EDR CLI

(((ParentBaseFileName = /.*\\WINWORD.EXE/i or ParentBaseFileName = /.*\\EXCEL.EXE/i or ParentBaseFileName = /.*\\POWERPNT.exe/i or ParentBaseFileName = /.*\\MSPUB.exe/i or ParentBaseFileName = /.*\\VISIO.exe/i or ParentBaseFileName = /.*\\MSACCESS.exe/i or ParentBaseFileName = /.*\\EQNEDT32.exe/i) and ImageFileName = /C:\\users\\.*/i and ImageFileName = /.*.exe/i) and not((ImageFileName = /.*\\Teams.exe/i)))
