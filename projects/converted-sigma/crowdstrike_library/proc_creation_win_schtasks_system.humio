// Title: Schtasks Creation Or Modification With SYSTEM Privileges
// ID: 89ca78fd-b37c-4310-b3d3-81a023f83936
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-28
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053.005
// Description: Detects the creation or update of a scheduled task to run with "NT AUTHORITY\SYSTEM" privileges
// Converted by: Sigma Universal SIEM/EDR CLI

(((ImageFileName = /.*\\schtasks.exe/i and (CommandLine = /* /change */i or CommandLine = /* /create */i)) and (CommandLine = /*/ru */i) and ((CommandLine = /*NT AUT*/i or CommandLine = /* SYSTEM */i))) and not((((CommandLine = /*/Create /F /RU System /SC WEEKLY /TN AviraSystemSpeedupVerify /TR */i or CommandLine = /*:\\Program Files (x86)\\Avira\\System Speedup\\setup\\avira_speedup_setup.exe*/i or CommandLine = /*/VERIFY /VERYSILENT /NOSTART /NODOTNET /NORESTART\" /RL HIGHEST*/i)) or ((CommandLine = /*Subscription Heartbeat*/i and CommandLine = /*\\HeartbeatConfig.xml*/i and CommandLine = /*\\Microsoft Shared\\OFFICE*/i)) or (ImageFileName = /.*\\schtasks.exe/i and (CommandLine = /*/TN TVInstallRestore*/i and CommandLine = /*\\TeamViewer_.exe*/i)))))
