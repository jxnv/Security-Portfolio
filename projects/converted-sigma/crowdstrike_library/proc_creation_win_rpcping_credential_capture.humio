// Description: Detects using Rpcping.exe to send a RPC test connection to the target server (-s) and force the NTLM hash to be sent in the process.
// Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine = /*-s*/i or CommandLine = /*/s*/i)) and ((ImageFileName = /.*\\RpcPing.exe/i) or (OriginalFilename = "\\RpcPing.exe"))) and (((CommandLine = /*-t*/i or CommandLine = /*/t*/i) and CommandLine = /*ncacn_np*/i) or ((CommandLine = /*-u*/i or CommandLine = /*/u*/i) and CommandLine = /*NTLM*/i)))
