// Title: Suspicious LNK Double Extension File Created
// ID: 3215aa19-f060-4332-86d5-5602511f3ca8
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), frack113
// Date: 2022-11-07
// Tags: attack.stealth, attack.t1036.007
// Description: Detects the creation of files with an "LNK" as a second extension. This is sometimes used by malware as a method to abuse the fact that Windows hides the "LNK" extension by default.
// Converted by: Sigma Universal SIEM/EDR CLI

((TargetFileName = /.*.lnk/i and (TargetFileName = /*.doc.*/i or TargetFileName = /*.docx.*/i or TargetFileName = /*.jpg.*/i or TargetFileName = /*.pdf.*/i or TargetFileName = /*.ppt.*/i or TargetFileName = /*.pptx.*/i or TargetFileName = /*.xls.*/i or TargetFileName = /*.xlsx.*/i)) and not((TargetFileName = /*\\AppData\\Roaming\\Microsoft\\Windows\\Recent\\*/i)) and not(((ImageFileName = /.*\\excel.exe/i and TargetFileName = /*\\AppData\\Roaming\\Microsoft\\Excel*/i) or (ImageFileName = /.*\\powerpnt.exe/i and TargetFileName = /*\\AppData\\Roaming\\Microsoft\\PowerPoint*/i) or ((ImageFileName = /.*\\excel.exe/i or ImageFileName = /.*\\powerpnt.exe/i or ImageFileName = /.*\\winword.exe/i) and TargetFileName = /*\\AppData\\Roaming\\Microsoft\\Office\\Recent\\*/i) or (ImageFileName = /.*\\winword.exe/i and TargetFileName = /*\\AppData\\Roaming\\Microsoft\\Word*/i))))
