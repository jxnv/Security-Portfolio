// Title: Suspicious Double Extension Files
// ID: b4926b47-a9d7-434c-b3a0-adc3fa0bd13e
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), frack113
// Date: 2022-06-19
// Tags: attack.stealth, attack.t1036.007
// Description: Detects dropped files with double extensions, which is often used by malware as a method to abuse the fact that Windows hide default extensions by default.
// Converted by: Sigma Universal SIEM/EDR CLI

((((TargetFileName = /.*.rar.exe/i or TargetFileName = /.*.zip.exe/i)) or ((TargetFileName = /.*.exe/i or TargetFileName = /.*.iso/i or TargetFileName = /.*.rar/i or TargetFileName = /.*.svg/i or TargetFileName = /.*.zip/i) and (TargetFileName = /*.doc.*/i or TargetFileName = /*.docx.*/i or TargetFileName = /*.gif.*/i or TargetFileName = /*.jpeg.*/i or TargetFileName = /*.jpg.*/i or TargetFileName = /*.mp3.*/i or TargetFileName = /*.mp4.*/i or TargetFileName = /*.pdf.*/i or TargetFileName = /*.png.*/i or TargetFileName = /*.ppt.*/i or TargetFileName = /*.pptx.*/i or TargetFileName = /*.rtf.*/i or TargetFileName = /*.svg.*/i or TargetFileName = /*.txt.*/i or TargetFileName = /*.xls.*/i or TargetFileName = /*.xlsx.*/i))) and not((TargetFileName = //usr/share/icons/.*/i)))
