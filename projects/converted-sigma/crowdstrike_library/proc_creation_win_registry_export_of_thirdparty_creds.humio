(((CommandLine = /*\\Software\\Aerofox\\Foxmail\\V3.1*/i or CommandLine = /*\\Software\\Aerofox\\FoxmailPreview*/i or CommandLine = /*\\Software\\DownloadManager\\Passwords*/i or CommandLine = /*\\Software\\FTPWare\\COREFTP\\Sites*/i or CommandLine = /*\\Software\\IncrediMail\\Identities*/i or CommandLine = /*\\Software\\Martin Prikryl\\WinSCP 2\\Sessions*/i or CommandLine = /*\\Software\\Mobatek\\MobaXterm*/i or CommandLine = /*\\Software\\OpenSSH\\Agent\\Keys*/i or CommandLine = /*\\Software\\OpenVPN-GUI\\configs*/i or CommandLine = /*\\Software\\ORL\\WinVNC3\\Password*/i or CommandLine = /*\\Software\\Qualcomm\\Eudora\\CommandLine*/i or CommandLine = /*\\Software\\RealVNC\\WinVNC4*/i or CommandLine = /*\\Software\\RimArts\\B2\\Settings*/i or CommandLine = /*\\Software\\SimonTatham\\PuTTY\\Sessions*/i or CommandLine = /*\\Software\\SimonTatham\\PuTTY\\SshHostKeys*/i or CommandLine = /*\\Software\\Sota\\FFFTP*/i or CommandLine = /*\\Software\\TightVNC\\Server*/i or CommandLine = /*\\Software\\WOW6432Node\\Radmin\\v3.0\\Server\\Parameters\\Radmin*/i)) and ((CommandLine = /*save*/i or CommandLine = /*export*/i)) and ((ImageFileName = /.*\\reg.exe/i) or (OriginalFilename = "reg.exe")))
