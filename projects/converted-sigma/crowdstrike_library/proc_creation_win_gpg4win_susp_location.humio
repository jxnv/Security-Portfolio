// Title: File Encryption/Decryption Via Gpg4win From Suspicious Locations
// ID: e1e0b7d7-e10b-4ee4-ac49-a4bda05d320d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2022-11-30
// Tags: attack.execution
// Description: Detects usage of Gpg4win to encrypt/decrypt files located in potentially suspicious locations.
// Converted by: Sigma Universal SIEM/EDR CLI

((CommandLine = /*-passphrase*/i) and (((ImageFileName = /.*\\gpg.exe/i or ImageFileName = /.*\\gpg2.exe/i)) or (Product = "GNU Privacy Guard (GnuPG)") or (Description = "GnuPG’s OpenPGP tool")) and ((CommandLine = /*:\\PerfLogs\\*/i or CommandLine = /*:\\Temp\\*/i or CommandLine = /*:\\Users\\Public\\*/i or CommandLine = /*:\\Windows\\Temp\\*/i or CommandLine = /*\\AppData\\Local\\Temp\\*/i or CommandLine = /*\\AppData\\Roaming\\*/i)))
