// Tags: attack.persistence
// Description: Detects the creation of a new PowerShell module ".psm1", ".psd1", ".dll", ".ps1", etc.
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i) and (TargetFileName = /*\\WindowsPowerShell\\Modules\\*/i or TargetFileName = /*\\PowerShell\\7\\Modules\\*/i))
