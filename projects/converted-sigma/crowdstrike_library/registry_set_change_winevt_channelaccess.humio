// Title: Change Winevt Channel Access Permission Via Registry
// ID: 7d9263bd-dc47-4a58-bc92-5474abab390c
// Status: test
// Level: high
// Author: frack113
// Date: 2022-09-17
// Tags: attack.defense-impairment, attack.t1685.001
// Description: Detects tampering with the "ChannelAccess" registry key in order to change access to Windows event channel.
// Converted by: Sigma Universal SIEM/EDR CLI

((TargetObject = /*\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\*/i and TargetObject = /.*\\ChannelAccess/i and (Details = /*(A;;0x1;;;LA)*/i or Details = /*(A;;0x1;;;SY)*/i or Details = /*(A;;0x5;;;BA)*/i)) and not(((ImageFileName = /C:\\Windows\\WinSxS\\.*/i and ImageFileName = /.*\\TiWorker.exe/i) or (ImageFileName = "C:\\Windows\\servicing\\TrustedInstaller.exe"))))
