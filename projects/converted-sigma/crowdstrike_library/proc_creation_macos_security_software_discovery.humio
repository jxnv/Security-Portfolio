// Description: Detects usage of system utilities (only grep for now) to discover security software discovery
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = "/usr/bin/grep") and (((CommandLine = /*nessusd*/i or CommandLine = /*santad*/i or CommandLine = /*CbDefense*/i or CommandLine = /*falcond*/i or CommandLine = /*td-agent*/i or CommandLine = /*packetbeat*/i or CommandLine = /*filebeat*/i or CommandLine = /*auditbeat*/i or CommandLine = /*osqueryd*/i or CommandLine = /*BlockBlock*/i or CommandLine = /*LuLu*/i)) or ((CommandLine = /*Little*/i and CommandLine = /*Snitch*/i))))
