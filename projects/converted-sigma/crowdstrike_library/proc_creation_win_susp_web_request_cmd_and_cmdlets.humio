// Description: Detects the use of various web request commands with commandline tools and Windows PowerShell cmdlets (including aliases) via CommandLine
// Converted by: Sigma Universal SIEM/EDR CLI

((CommandLine = /*[System.Net.WebRequest]::create*/i or CommandLine = /*curl */i or CommandLine = /*Invoke-RestMethod*/i or CommandLine = /*Invoke-WebRequest*/i or CommandLine = /* irm */i or CommandLine = /*iwr */i or CommandLine = /*Resume-BitsTransfer*/i or CommandLine = /*Start-BitsTransfer*/i or CommandLine = /*wget */i or CommandLine = /*WinHttp.WinHttpRequest*/i))
