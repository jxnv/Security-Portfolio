// Title: Download From Suspicious TLD - Blacklist
// ID: 00d0b5ab-1f55-4120-8e83-487c0a7baf19
// Status: test
// Level: low
// Author: Florian Roth (Nextron Systems)
// Date: 2017-11-07
// Tags: attack.initial-access, attack.t1566, attack.execution, attack.t1203, attack.t1204.002
// Description: Detects download of certain file types from hosts in suspicious TLDs
// Converted by: Sigma Universal SIEM/EDR CLI

((c-uri-extension = "exe" or c-uri-extension = "vbs" or c-uri-extension = "bat" or c-uri-extension = "rar" or c-uri-extension = "ps1" or c-uri-extension = "doc" or c-uri-extension = "docm" or c-uri-extension = "xls" or c-uri-extension = "xlsm" or c-uri-extension = "pptm" or c-uri-extension = "rtf" or c-uri-extension = "hta" or c-uri-extension = "dll" or c-uri-extension = "ws" or c-uri-extension = "wsf" or c-uri-extension = "sct" or c-uri-extension = "zip") and (cs-host = /.*.country/i or cs-host = /.*.stream/i or cs-host = /.*.gdn/i or cs-host = /.*.mom/i or cs-host = /.*.xin/i or cs-host = /.*.kim/i or cs-host = /.*.men/i or cs-host = /.*.loan/i or cs-host = /.*.download/i or cs-host = /.*.racing/i or cs-host = /.*.online/i or cs-host = /.*.science/i or cs-host = /.*.ren/i or cs-host = /.*.gb/i or cs-host = /.*.win/i or cs-host = /.*.top/i or cs-host = /.*.review/i or cs-host = /.*.vip/i or cs-host = /.*.party/i or cs-host = /.*.tech/i or cs-host = /.*.xyz/i or cs-host = /.*.date/i or cs-host = /.*.faith/i or cs-host = /.*.zip/i or cs-host = /.*.cricket/i or cs-host = /.*.space/i or cs-host = /.*.info/i or cs-host = /.*.vn/i or cs-host = /.*.cm/i or cs-host = /.*.am/i or cs-host = /.*.cc/i or cs-host = /.*.asia/i or cs-host = /.*.ws/i or cs-host = /.*.tk/i or cs-host = /.*.biz/i or cs-host = /.*.su/i or cs-host = /.*.st/i or cs-host = /.*.ro/i or cs-host = /.*.ge/i or cs-host = /.*.ms/i or cs-host = /.*.pk/i or cs-host = /.*.nu/i or cs-host = /.*.me/i or cs-host = /.*.ph/i or cs-host = /.*.to/i or cs-host = /.*.tt/i or cs-host = /.*.name/i or cs-host = /.*.tv/i or cs-host = /.*.kz/i or cs-host = /.*.tc/i or cs-host = /.*.mobi/i or cs-host = /.*.study/i or cs-host = /.*.click/i or cs-host = /.*.link/i or cs-host = /.*.trade/i or cs-host = /.*.accountant/i or cs-host = /.*.cf/i or cs-host = /.*.gq/i or cs-host = /.*.ml/i or cs-host = /.*.ga/i or cs-host = /.*.pw/i))
