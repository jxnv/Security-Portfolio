// Title: WinSxS Executable File Creation By Non-System Process
// ID: 34746e8c-5fb8-415a-b135-0abc167e912a
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-11
// Tags: attack.execution
// Description: Detects the creation of binaries in the WinSxS folder by non-system processes
// Converted by: Sigma Universal SIEM/EDR CLI

((TargetFileName = /C:\\Windows\\WinSxS\\.*/i and TargetFileName = /.*.exe/i) and not(((ImageFileName = /C:\\Windows\\Systems32\\.*/i or ImageFileName = /C:\\Windows\\SysWOW64\\.*/i or ImageFileName = /C:\\Windows\\WinSxS\\.*/i))))
