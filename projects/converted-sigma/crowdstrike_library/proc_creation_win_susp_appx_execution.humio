// Title: Potentially Suspicious Windows App Activity
// ID: f91ed517-a6ba-471d-9910-b3b4a398c0f3
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-12
// Tags: attack.stealth
// Description: Detects potentially suspicious child process of applications launched from inside the WindowsApps directory. This could be a sign of a rogue ".appx" package installation/execution
// Converted by: Sigma Universal SIEM/EDR CLI

((ParentBaseFileName = /*C:\\Program Files\\WindowsApps\\*/i) and (((CommandLine = /*cmd /c*/i or CommandLine = /*Invoke-*/i or CommandLine = /*Base64*/i)) or ((ImageFileName = /.*\\cmd.exe/i or ImageFileName = /.*\\cscript.exe/i or ImageFileName = /.*\\mshta.exe/i or ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\powershell_ise.exe/i or ImageFileName = /.*\\pwsh.exe/i or ImageFileName = /.*\\regsvr32.exe/i or ImageFileName = /.*\\rundll32.exe/i or ImageFileName = /.*\\wscript.exe/i))) and not(((ParentBaseFileName = /C:\\Program Files\\WindowsApps\\Microsoft.SysinternalsSuite.*/i and ImageFileName = /.*\\cmd.exe/i) or (ParentBaseFileName = /*:\\Program Files\\WindowsApps\\Microsoft.WindowsTerminal*/i and ParentBaseFileName = /.*\\WindowsTerminal.exe/i and (ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\cmd.exe/i or ImageFileName = /.*\\pwsh.exe/i)))))
