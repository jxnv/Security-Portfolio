// Title: Suspicious Mstsc.EXE Execution With Local RDP File
// ID: 6e22722b-dfb1-4508-a911-49ac840b40f8
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects potential RDP connection via Mstsc using a local ".rdp" file located in suspicious locations.
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /.*.rdp/i or CommandLine = /.*.rdp\"/i)) and ((ImageFileName = /.*\\mstsc.exe/i) or (OriginalFilename = "mstsc.exe")) and ((CommandLine = /*:\\Users\\Public\\*/i or CommandLine = /*:\\Windows\\System32\\spool\\drivers\\color*/i or CommandLine = /*:\\Windows\\System32\\Tasks_Migrated */i or CommandLine = /*:\\Windows\\Tasks\\*/i or CommandLine = /*:\\Windows\\Temp\\*/i or CommandLine = /*:\\Windows\\Tracing\\*/i or CommandLine = /*\\AppData\\Local\\Temp\\*/i or CommandLine = /*\\Downloads\\*/i)))
