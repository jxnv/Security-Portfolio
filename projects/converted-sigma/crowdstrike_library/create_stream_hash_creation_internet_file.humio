// Tags: attack.stealth
// Description: Detects the creation of a suspicious ADS (Alternate Data Stream) file by software other than browsers
// Converted by: Sigma Universal SIEM/EDR CLI

((Contents = /[ZoneTransfer]  ZoneId=3.*/i and TargetFileName = /.*:Zone.Identifier/i and (TargetFileName = /*.exe*/i or TargetFileName = /*.scr*/i or TargetFileName = /*.bat*/i or TargetFileName = /*.cmd*/i or TargetFileName = /*.docx*/i or TargetFileName = /*.hta*/i or TargetFileName = /*.jse*/i or TargetFileName = /*.lnk*/i or TargetFileName = /*.pptx*/i or TargetFileName = /*.ps*/i or TargetFileName = /*.reg*/i or TargetFileName = /*.sct*/i or TargetFileName = /*.vb*/i or TargetFileName = /*.wsc*/i or TargetFileName = /*.wsf*/i or TargetFileName = /*.xlsx*/i)) and not(((ImageFileName = /.*\\brave.exe/i) or ((ImageFileName = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or ImageFileName = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or ((ImageFileName = /C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\.*/i) or (ImageFileName = /.*\\WindowsApps\\MicrosoftEdge.exe/i) or ((ImageFileName = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or ImageFileName = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((ImageFileName = /C:\\Program Files (x86)\\Microsoft\\EdgeCore\\.*/i or ImageFileName = /C:\\Program Files\\Microsoft\\EdgeCore\\.*/i) and (ImageFileName = /.*\\msedge.exe/i or ImageFileName = /.*\\msedgewebview2.exe/i)) or ((ImageFileName = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or ImageFileName = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or ((ImageFileName = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or ImageFileName = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (ImageFileName = /.*\\maxthon.exe/i) or (ImageFileName = /.*\\opera.exe/i) or (ImageFileName = /.*\\safari.exe/i) or (ImageFileName = /.*\\seamonkey.exe/i) or (ImageFileName = /C:\\Program Files\\WindowsApps\\Microsoft.ScreenSketch_.*/i and ImageFileName = /.*\\SnippingTool\\SnippingTool.exe/i and TargetFileName = /C:\\Users\\.*/i and (TargetFileName = /*\\AppData\\Local\\Packages\\Microsoft.ScreenSketch_*/i and TargetFileName = /*\\TempState\\Screenshot */i) and TargetFileName = /.*.png:Zone.Identifier/i) or (ImageFileName = /.*\\vivaldi.exe/i) or (ImageFileName = /.*\\whale.exe/i))))
