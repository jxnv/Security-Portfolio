// Title: Sysmon Configuration Error
// ID: 815cd91b-7dbc-4247-841a-d7dd1392b0a8
// Status: test
// Level: high
// Author: frack113
// Date: 2021-06-04
// Tags: attack.stealth, attack.t1564
// Description: Detects when an adversary is trying to hide it's action from Sysmon logging based on error messages
// Converted by: Sigma Universal SIEM/EDR CLI

(((Description = /*Failed to open service configuration with error*/i or Description = /*Failed to connect to the driver to update configuration*/i)) and not((((Description = /*Failed to open service configuration with error 19*/i or Description = /*Failed to open service configuration with error 93*/i)) or ((Description = /*Failed to open service configuration with error*/i and Description = /*Last error: The media is write protected.*/i)) or ((Description = /*Failed to open service configuration with error*/i and Description = /*Last error: Média protégé en écriture.*/i)))))
