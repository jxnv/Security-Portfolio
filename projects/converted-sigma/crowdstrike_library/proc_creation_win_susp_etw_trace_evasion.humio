// Title: ETW Trace Evasion Activity
// ID: a238b5d0-ce2d-4414-a676-7a531b3d13d6
// Status: test
// Level: high
// Author: @neu5ron, Florian Roth (Nextron Systems), Jonhnathan Ribeiro, oscd.community
// Date: 2019-03-22
// Tags: attack.stealth, attack.defense-impairment, attack.t1070, attack.t1685, car.2016-04-002
// Description: Detects command line activity that tries to clear or disable any ETW trace log which could be a sign of logging evasion.
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*cl*/i and CommandLine = /*/Trace*/i)) or ((CommandLine = /*clear-log*/i and CommandLine = /*/Trace*/i)) or ((CommandLine = /*sl*/i and CommandLine = /*/e:false*/i)) or ((CommandLine = /*set-log*/i and CommandLine = /*/e:false*/i)) or ((CommandLine = /*logman*/i and CommandLine = /*update*/i and CommandLine = /*trace*/i and CommandLine = /*--p*/i and CommandLine = /*-ets*/i)) or (CommandLine = /*Remove-EtwTraceProvider*/i) or ((CommandLine = /*Set-EtwTraceProvider*/i and CommandLine = /*0x11*/i)))
