// Title: GAC DLL Loaded Via Office Applications
// ID: 90217a70-13fc-48e4-b3db-0d836c5824ac
// Status: test
// Level: high
// Author: Antonlovesdnb
// Date: 2020-02-19
// Tags: attack.execution, attack.t1204.002
// Description: Detects any GAC DLL being loaded by an Office Product
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*\\excel.exe/i or ImageFileName = /.*\\mspub.exe/i or ImageFileName = /.*\\onenote.exe/i or ImageFileName = /.*\\onenoteim.exe/i or ImageFileName = /.*\\outlook.exe/i or ImageFileName = /.*\\powerpnt.exe/i or ImageFileName = /.*\\winword.exe/i) and ImageLoaded = /C:\\Windows\\Microsoft.NET\\assembly\\GAC_MSIL.*/i)
