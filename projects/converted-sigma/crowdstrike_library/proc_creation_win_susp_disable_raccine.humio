// Title: Raccine Uninstall
// ID: a31eeaed-3fd5-478e-a8ba-e62c6b3f9ecc
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-01-21
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects commands that indicate a Raccine removal from an end system. Raccine is a free ransomware protection tool.
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*taskkill */i and CommandLine = /*RaccineSettings.exe*/i)) or ((CommandLine = /*reg.exe*/i and CommandLine = /*delete*/i and CommandLine = /*Raccine Tray*/i)) or ((CommandLine = /*schtasks*/i and CommandLine = /*/DELETE*/i and CommandLine = /*Raccine Rules Updater*/i)))
