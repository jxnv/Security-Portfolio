// Description: Shadow Copies deletion using operating systems utilities
// Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine = /*shadow*/i and CommandLine = /*delete*/i)) and (((ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i or ImageFileName = /.*\\wmic.exe/i or ImageFileName = /.*\\vssadmin.exe/i or ImageFileName = /.*\\diskshadow.exe/i)) or ((OriginalFilename = "PowerShell.EXE" or OriginalFilename = "pwsh.dll" or OriginalFilename = "wmic.exe" or OriginalFilename = "VSSADMIN.EXE" or OriginalFilename = "diskshadow.exe")))) or (((CommandLine = /*delete*/i and CommandLine = /*catalog*/i and CommandLine = /*quiet*/i)) and ((ImageFileName = /.*\\wbadmin.exe/i) or (OriginalFilename = "WBADMIN.EXE"))) or (((CommandLine = /*resize*/i and CommandLine = /*shadowstorage*/i) and (CommandLine = /*unbounded*/i or CommandLine = /*/MaxSize=*/i)) and ((ImageFileName = /.*\\vssadmin.exe/i) or (OriginalFilename = "VSSADMIN.EXE"))))
