// Title: Rundll32 Internet Connection
// ID: cdc8da7d-c303-42f8-b08c-b4ab47230263
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2017-11-04
// Tags: attack.stealth, attack.t1218.011, attack.execution
// Description: Detects a rundll32 that communicates with public IP addresses
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*\\rundll32.exe/i and Initiated = "true") and not(((CommandLine = /.*\\system32\\PcaSvc.dll,PcaPatchSdbTask/i) or (SourceHostname = /.*.internal.cloudapp.net/i) or ((cidr(ip=DestinationIp, subnet="127.0.0.0/8") or cidr(ip=DestinationIp, subnet="10.0.0.0/8") or cidr(ip=DestinationIp, subnet="172.16.0.0/12") or cidr(ip=DestinationIp, subnet="192.168.0.0/16") or cidr(ip=DestinationIp, subnet="169.254.0.0/16") or cidr(ip=DestinationIp, subnet="::1/128") or cidr(ip=DestinationIp, subnet="fe80::/10") or cidr(ip=DestinationIp, subnet="fc00::/7"))) or ((cidr(ip=DestinationIp, subnet="20.0.0.0/8") or cidr(ip=DestinationIp, subnet="51.103.0.0/16") or cidr(ip=DestinationIp, subnet="51.104.0.0/16") or cidr(ip=DestinationIp, subnet="51.105.0.0/16"))) or (ParentBaseFileName = "C:\\Windows\\System32\\svchost.exe" and DestinationPort = 443))))
