// Title: Local Groups Discovery - Linux
// ID: 676381a6-15ca-4d73-a9c8-6a22e970b90d
// Status: test
// Level: low
// Author: Ömer Günal, Alejandro Ortuno, oscd.community
// Date: 2020-10-11
// Tags: attack.discovery, attack.t1069.001
// Description: Detects enumeration of local system groups. Adversaries may attempt to find local system groups and permission settings
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*/groups/i) or ((ImageFileName = /.*/cat/i or ImageFileName = /.*/ed/i or ImageFileName = /.*/head/i or ImageFileName = /.*/less/i or ImageFileName = /.*/more/i or ImageFileName = /.*/nano/i or ImageFileName = /.*/tail/i or ImageFileName = /.*/vi/i or ImageFileName = /.*/vim/i) and CommandLine = /*/etc/group*/i))
