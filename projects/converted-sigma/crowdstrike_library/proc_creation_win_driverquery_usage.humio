// Title: DriverQuery.EXE Execution
// ID: a20def93-0709-4eae-9bd2-31206e21e6b2
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-19
// Tags: attack.discovery
// Description: Detect usage of the "driverquery" utility. Which can be used to perform reconnaissance on installed drivers
// Converted by: Sigma Universal SIEM/EDR CLI

(((ImageFileName = /.*driverquery.exe/i) or (OriginalFilename = "drvqry.exe")) and not((((ParentBaseFileName = /.*\\cscript.exe/i or ParentBaseFileName = /.*\\mshta.exe/i or ParentBaseFileName = /.*\\regsvr32.exe/i or ParentBaseFileName = /.*\\rundll32.exe/i or ParentBaseFileName = /.*\\wscript.exe/i)) or ((ParentBaseFileName = /*\\AppData\\Local\\*/i or ParentBaseFileName = /*\\Users\\Public\\*/i or ParentBaseFileName = /*\\Windows\\Temp\\*/i)))))
