(((PipeName = /\\Winsock2\\CatalogChangeListener-.*/i and PipeName = /.*-0,/i) or (((PipeName = /\\DserNamePipe.*/i or PipeName = /\\f4c3.*/i or PipeName = /\\f53f.*/i or PipeName = /\\fullduplex_.*/i or PipeName = /\\mojo.5688.8052.183894939787088877.*/i or PipeName = /\\mojo.5688.8052.35780273329370473.*/i or PipeName = /\\MsFteWds.*/i or PipeName = /\\msrpc_.*/i or PipeName = /\\mypipe-f.*/i or PipeName = /\\mypipe-h.*/i or PipeName = /\\ntsvcs.*/i or PipeName = /\\PGMessagePipe.*/i or PipeName = /\\rpc_.*/i or PipeName = /\\scerpc.*/i or PipeName = /\\SearchTextHarvester.*/i or PipeName = /\\spoolss.*/i or PipeName = /\\win_svc.*/i or PipeName = /\\win\\msrpc_.*/i or PipeName = /\\windows.update.manager.*/i or PipeName = /\\wkssvc.*/i)) or ((PipeName = "\\demoagent_11" or PipeName = "\\demoagent_22")))) and not(((PipeName = "\\wkssvc" or PipeName = "\\spoolss" or PipeName = "\\scerpc" or PipeName = "\\ntsvcs" or PipeName = "\\SearchTextHarvester" or PipeName = "\\PGMessagePipe" or PipeName = "\\MsFteWds"))) and not(((ImageFileName = /*:\\Program Files\\Websense\\*/i or ImageFileName = /*:\\Program Files (x86)\\Websense\\*/i) and (PipeName = /\\DserNamePipeR.*/i or PipeName = /\\DserNamePipeW.*/i))))
