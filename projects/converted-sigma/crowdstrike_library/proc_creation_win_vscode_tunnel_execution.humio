// Description: Detects Visual Studio Code tunnel execution. Attackers can abuse this functionality to establish a C2 channel
// Converted by: Sigma Universal SIEM/EDR CLI

((not(OriginalFilename = *) and CommandLine = /.*.exe tunnel/i) or (ParentCommandLine = /.* tunnel/i and ImageFileName = /.*\\cmd.exe/i and (CommandLine = /*/d /c */i and CommandLine = /*\\servers\\Stable-*/i and CommandLine = /*code-server.cmd*/i)) or ((CommandLine = /*.exe tunnel*/i and CommandLine = /*--accept-server-license-terms*/i)))
