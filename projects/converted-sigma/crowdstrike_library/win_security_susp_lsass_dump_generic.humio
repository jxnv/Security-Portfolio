i or ProcessName = /.*\\vmtoolsd.exe/i or ProcessName = /.*\\VsTskMgr.exe/i or ProcessName = /.*\\wininit.exe/i or ProcessName = /.*\\wmiprvse.exe/i or ProcessName = /.*RtkAudUService64/i) and (ProcessName = /*:\\Program Files (x86)\\*/i or ProcessName = /*:\\Program Files\\*/i or ProcessName = /*:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*/i or ProcessName = /*:\\Windows\\SysNative\\*/i or ProcessName = /*:\\Windows\\System32\\*/i or ProcessName = /*:\\Windows\\SysWow64\\*/i or ProcessName = /*:\\Windows\\Temp\\asgard2-agent\\*/i)) or ((ProcessName = /.*:\\Windows\\Sysmon64.exe/i or ProcessName = /.*:\\Windows\\Sysmon64a.exe/i) and AccessList = /*%%4484*/i))) and not(((ProcessName = /.*\\procmon64.exe/i or ProcessName = /.*\\procmon64a.exe/i or ProcessName = /.*\\procmon.exe/i) and AccessList = /*%%4484*/i)))
