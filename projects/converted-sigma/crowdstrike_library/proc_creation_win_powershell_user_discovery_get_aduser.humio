// Title: User Discovery And Export Via Get-ADUser Cmdlet
// ID: 1114e048-b69c-4f41-bc20-657245ae6e3f
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.discovery, attack.t1033
// Description: Detects usage of the Get-ADUser cmdlet to collect user information and output it to a file
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*Get-ADUser */i and CommandLine = /* -Filter \\**/i) and (CommandLine = /* > */i or CommandLine = /* | Select */i or CommandLine = /*Out-File*/i or CommandLine = /*Set-Content*/i or CommandLine = /*Add-Content*/i)) and (((ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i)) or ((OriginalFilename = "PowerShell.EXE" or OriginalFilename = "pwsh.dll"))))
