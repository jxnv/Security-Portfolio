// Title: Windows Defender Configuration Changes
// ID: 801bd44f-ceed-4eb6-887c-11544633c0aa
// Status: stable
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-06
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects suspicious changes to the Windows Defender configuration
// Converted by: Sigma Universal SIEM/EDR CLI

(EventID = 5007 and (NewValue = /*\\Windows Defender\\DisableAntiSpyware */i or NewValue = /*\\Windows Defender\\Scan\\DisableRemovableDriveScanning */i or NewValue = /*\\Windows Defender\\Scan\\DisableScanningMappedNetworkDrivesForFullScan */i or NewValue = /*\\Windows Defender\\SpyNet\\DisableBlockAtFirstSeen */i or NewValue = /*\\Real-Time Protection\\SpyNetReporting */i))
