// Title: Suspicious ShellExec_RunDLL Call Via Ordinal
// ID: 8823e85d-31d8-473e-b7f4-92da070f0fc6
// Status: test
// Level: high
// Author: Swachchhanda Shrawan Poudel
// Date: 2024-12-01
// Tags: attack.stealth, attack.t1218.011
// Description: Detects suspicious call to the "ShellExec_RunDLL" exported function of SHELL32.DLL through the ordinal number to launch other commands.
// Adversary might only use the ordinal number in order to bypass existing detection that alert on usage of ShellExec_RunDLL on CommandLine.
// Converted by: Sigma Universal SIEM/EDR CLI

(((ParentCommandLine = /*SHELL32.DLL*/i) and ((ParentCommandLine = /*#568*/i or ParentCommandLine = /*#570*/i or ParentCommandLine = /*#572*/i or ParentCommandLine = /*#576*/i))) and (((ImageFileName = /.*\\bash.exe/i or ImageFileName = /.*\\bitsadmin.exe/i or ImageFileName = /.*\\cmd.exe/i or ImageFileName = /.*\\cscript.exe/i or ImageFileName = /.*\\curl.exe/i or ImageFileName = /.*\\mshta.exe/i or ImageFileName = /.*\\msiexec.exe/i or ImageFileName = /.*\\msxsl.exe/i or ImageFileName = /.*\\odbcconf.exe/i or ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i or ImageFileName = /.*\\regsvr32.exe/i or ImageFileName = /.*\\schtasks.exe/i or ImageFileName = /.*\\wmic.exe/i or ImageFileName = /.*\\wscript.exe/i)) or (((ParentCommandLine = /*comspec*/i or ParentCommandLine = /*iex*/i or ParentCommandLine = /*Invoke-*/i or ParentCommandLine = /*msiexec*/i or ParentCommandLine = /*odbcconf*/i or ParentCommandLine = /*regsvr32*/i)) or ((ParentCommandLine = /*\\Desktop\\*/i or ParentCommandLine = /*\\ProgramData\\*/i or ParentCommandLine = /*\\Temp\\*/i or ParentCommandLine = /*\\Users\\Public\\*/i)))))
