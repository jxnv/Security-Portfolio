(((((ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i)) or ((OriginalFilename = "PowerShell.EXE" or OriginalFilename = "pwsh.dll"))) and ((CommandLine =~ /\+.*\+.*\+.*\+.*\+.*\+.*\+.*\+.*\+.*\+.*\+.*\+.*\+.*\+/i) or (CommandLine =~ /\{.*\{.*\{.*\{.*\{.*\{.*\{.*\{.*\{.*\{/i) or (CommandLine =~ /\^.*\^.*\^.*\^.*\^/i) or (CommandLine =~ /`.*`.*`.*`.*`/i))) and not(((ParentBaseFileName = "C:\\Program Files\\Amazon\\SSM\\ssm-document-worker.exe") or ((CommandLine = /*new EventSource(\"Microsoft.Windows.Sense.Client.Management\"*/i or CommandLine = /*public static extern bool InstallELAMCertificateInfo(SafeFileHandle handle);*/i)))))
