// Tags: attack.stealth, attack.t1036.003, attack.t1036, attack.t1027.005, attack.t1027
// Description: Detects the use of rcedit to potentially alter executable PE metadata properties, which could conceal efforts to rename system utilities for defense evasion.
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*OriginalFileName*/i or CommandLine = /*CompanyName*/i or CommandLine = /*FileDescription*/i or CommandLine = /*ProductName*/i or CommandLine = /*ProductVersion*/i or CommandLine = /*LegalCopyright*/i)) and (CommandLine = /*--set-*/i) and (((ImageFileName = /.*\\rcedit-x64.exe/i or ImageFileName = /.*\\rcedit-x86.exe/i)) or (Description = "Edit resources of exe") or (Product = "rcedit")))
