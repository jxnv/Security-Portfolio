// Title: Potential Persistence Via Microsoft Office Add-In
// ID: 8e1cb247-6cf6-42fa-b440-3f27d57e9936
// Status: test
// Level: high
// Author: NVISO
// Date: 2020-05-11
// Tags: attack.persistence, attack.t1137.006
// Description: Detects potential persistence activity via startup add-ins that load when Microsoft Office starts (.wll/.xll are simply .dll fit for Word or Excel).
// Converted by: Sigma Universal SIEM/EDR CLI

((TargetFileName = /*\\Microsoft\\Addins\\*/i and (TargetFileName = /.*.xlam/i or TargetFileName = /.*.xla/i or TargetFileName = /.*.ppam/i)) or (TargetFileName = /*\\Microsoft\\Word\\Startup\\*/i and TargetFileName = /.*.wll/i) or (TargetFileName = /*Microsoft\\Excel\\XLSTART\\*/i and TargetFileName = /.*.xlam/i) or (TargetFileName = /*\\Microsoft\\Excel\\Startup\\*/i and TargetFileName = /.*.xll/i))
