// Title: Suspicious ScreenSave Change by Reg.exe
// ID: 0fc35fc3-efe6-4898-8a37-0b233339524f
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-08-19
// Tags: attack.persistence, attack.privilege-escalation, attack.t1546.002
// Description: Adversaries may establish persistence by executing malicious content triggered by user inactivity.
// Screensavers are programs that execute after a configurable time of user inactivity and consist of Portable Executable (PE) files with a .scr file extension
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*\\reg.exe/i and (CommandLine = /*HKEY_CURRENT_USER\\Control Panel\\Desktop*/i or CommandLine = /*HKCU\\Control Panel\\Desktop*/i)) and (((CommandLine = /*/v ScreenSaveActive*/i and CommandLine = /*/t REG_SZ*/i and CommandLine = /*/d 1*/i and CommandLine = /*/f*/i)) or ((CommandLine = /*/v ScreenSaveTimeout*/i and CommandLine = /*/t REG_SZ*/i and CommandLine = /*/d */i and CommandLine = /*/f*/i)) or ((CommandLine = /*/v ScreenSaverIsSecure*/i and CommandLine = /*/t REG_SZ*/i and CommandLine = /*/d 0*/i and CommandLine = /*/f*/i)) or ((CommandLine = /*/v SCRNSAVE.EXE*/i and CommandLine = /*/t REG_SZ*/i and CommandLine = /*/d */i and CommandLine = /*.scr*/i and CommandLine = /*/f*/i))))
