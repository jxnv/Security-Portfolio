(((CommandLine = /*.key*/i or CommandLine = /*.pgp*/i or CommandLine = /*.gpg*/i or CommandLine = /*.ppk*/i or CommandLine = /*.p12*/i or CommandLine = /*.pem*/i or CommandLine = /*.pfx*/i or CommandLine = /*.cer*/i or CommandLine = /*.p7b*/i or CommandLine = /*.asc*/i)) and (((CommandLine = /*dir */i) and ((ImageFileName = /.*\\cmd.exe/i) or (OriginalFilename = "Cmd.Exe"))) or ((CommandLine = /*Get-ChildItem */i) and (((ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i)) or ((OriginalFilename = "PowerShell.EXE" or OriginalFilename = "pwsh.dll")))) or ((ImageFileName = /.*\\findstr.exe/i) or (OriginalFilename = "FINDSTR.EXE"))))
