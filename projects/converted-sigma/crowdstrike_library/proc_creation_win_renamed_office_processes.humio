// Title: Renamed Office Binary Execution
// ID: 0b0cd537-fc77-4e6e-a973-e53495c1083d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-20
// Tags: attack.stealth, attack.t1036.003
// Description: Detects the execution of a renamed office binary
// Converted by: Sigma Universal SIEM/EDR CLI

((((OriginalFilename = "Excel.exe" or OriginalFilename = "MSACCESS.EXE" or OriginalFilename = "MSPUB.EXE" or OriginalFilename = "OneNote.exe" or OriginalFilename = "OneNoteM.exe" or OriginalFilename = "OUTLOOK.EXE" or OriginalFilename = "POWERPNT.EXE" or OriginalFilename = "WinWord.exe" or OriginalFilename = "Olk.exe")) or ((Description = "Microsoft Access" or Description = "Microsoft Excel" or Description = "Microsoft OneNote" or Description = "Microsoft Outlook" or Description = "Microsoft PowerPoint" or Description = "Microsoft Publisher" or Description = "Microsoft Word" or Description = "Sent to OneNote Tool"))) and not(((ImageFileName = /.*\\EXCEL.exe/i or ImageFileName = /.*\\excelcnv.exe/i or ImageFileName = /.*\\MSACCESS.exe/i or ImageFileName = /.*\\MSPUB.EXE/i or ImageFileName = /.*\\ONENOTE.EXE/i or ImageFileName = /.*\\ONENOTEM.EXE/i or ImageFileName = /.*\\OUTLOOK.EXE/i or ImageFileName = /.*\\POWERPNT.EXE/i or ImageFileName = /.*\\WINWORD.exe/i or ImageFileName = /.*\\OLK.EXE/i))))
