// Title: Potentially Suspicious File Download From ZIP TLD
// ID: 0bb4bbeb-fe52-4044-b40c-430a04577ebe
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2023-05-18
// Tags: attack.stealth
// Description: Detects the download of a file with a potentially suspicious extension from a .zip top level domain.
// Converted by: Sigma Universal SIEM/EDR CLI

(Contents = /*.zip/*/i and (TargetFileName = /*.bat:Zone*/i or TargetFileName = /*.dat:Zone*/i or TargetFileName = /*.dll:Zone*/i or TargetFileName = /*.doc:Zone*/i or TargetFileName = /*.docm:Zone*/i or TargetFileName = /*.exe:Zone*/i or TargetFileName = /*.hta:Zone*/i or TargetFileName = /*.pptm:Zone*/i or TargetFileName = /*.ps1:Zone*/i or TargetFileName = /*.rar:Zone*/i or TargetFileName = /*.rtf:Zone*/i or TargetFileName = /*.sct:Zone*/i or TargetFileName = /*.vbe:Zone*/i or TargetFileName = /*.vbs:Zone*/i or TargetFileName = /*.ws:Zone*/i or TargetFileName = /*.wsf:Zone*/i or TargetFileName = /*.xll:Zone*/i or TargetFileName = /*.xls:Zone*/i or TargetFileName = /*.xlsm:Zone*/i or TargetFileName = /*.zip:Zone*/i))
