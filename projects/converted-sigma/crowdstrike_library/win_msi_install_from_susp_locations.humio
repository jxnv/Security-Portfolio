// Title: MSI Installation From Suspicious Locations
// ID: c7c8aa1c-5aff-408e-828b-998e3620b341
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-31
// Tags: attack.execution
// Description: Detects MSI package installation from suspicious locations
// Converted by: Sigma Universal SIEM/EDR CLI

((Provider_Name = "MsiInstaller" and (EventID = 1040 or EventID = 1042) and (Data = /*:\\Windows\\TEMP\\*/i or Data = /*\\\\\\\\*/i or Data = /*\\Desktop\\*/i or Data = /*\\PerfLogs\\*/i or Data = /*\\Users\\Public\\*/i)) and not(((Data = /*C:\\Windows\\TEMP\\UpdHealthTools.msi*/i) or (Data = /*\\AppData\\Local\\Temp\\WinGet\\*/i))))
