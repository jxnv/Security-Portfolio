// Title: Security Software Discovery - Linux
// ID: c9d8b7fd-78e4-44fe-88f6-599135d46d60
// Status: test
// Level: low
// Author: Daniil Yugoslavskiy, oscd.community
// Date: 2020-10-19
// Tags: attack.discovery, attack.t1518.001
// Description: Detects usage of system utilities (only grep and egrep for now) to discover security software discovery
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*/grep/i or ImageFileName = /.*/egrep/i) and (CommandLine = /*nessusd*/i or CommandLine = /*td-agent*/i or CommandLine = /*packetbeat*/i or CommandLine = /*filebeat*/i or CommandLine = /*auditbeat*/i or CommandLine = /*osqueryd*/i or CommandLine = /*cbagentd*/i or CommandLine = /*falcond*/i))
