(((CommandLine = /* -c*/i) and ((OriginalFilename = "python.exe") or ((ImageFileName = /.*python.exe/i or ImageFileName = /.*python3.exe/i or ImageFileName = /.*python2.exe/i)))) and not((((ParentBaseFileName = /C:\\Program Files\\Python.*/i or ParentBaseFileName = /C:\\Program Files (x86)\\Python.*/i) and ParentBaseFileName = /.*\\python.exe/i and ParentCommandLine = /*-E -s -m ensurepip -U --default-pip*/i) or ((ParentBaseFileName = /C:\\Program Files\\Python.*/i or ParentBaseFileName = /C:\\Program Files (x86)\\Python.*/i) and (CommandLine = /*-W ignore::DeprecationWarning*/i and CommandLine = /*['install', '--no-cache-dir', '--no-index', '--find-links',*/i and CommandLine = /*'--upgrade', 'pip'*/i)))) and not((((CommandLine = /*<pip-setuptools-caller>*/i and CommandLine = /*exec(compile(*/i)) or ((ParentBaseFileName = /.*\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe/i) or ((ParentBaseFileName = "C:\\Program Files\\Microsoft VS Code\\Code.exe" or ParentBaseFileName = "C:\\Program Files (x86)\\Microsoft VS Code\\Code.exe"))))))
