// Title: Proxy Execution Via Wuauclt.EXE
// ID: af77cf95-c469-471c-b6a0-946c685c4798
// Status: test
// Level: high
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research), Florian Roth (Nextron Systems), Sreeman, FPT.EagleEye Team
// Date: 2020-10-12
// Tags: attack.stealth, attack.t1218, attack.execution
// Description: Detects the use of the Windows Update Client binary (wuauclt.exe) for proxy execution.
// Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine = /*UpdateDeploymentProvider*/i and CommandLine = /*RunHandlerComServer*/i)) and ((ImageFileName = /.*\\wuauclt.exe/i) or (OriginalFilename = "wuauclt.exe"))) and not(((CommandLine = /* /UpdateDeploymentProvider UpdateDeploymentProvider.dll */i) or ((CommandLine = /*:\\Windows\\UUS\\Packages\\Preview\\amd64\\updatedeploy.dll /ClassId*/i or CommandLine = /*:\\Windows\\UUS\\amd64\\UpdateDeploy.dll /ClassId*/i)) or ((CommandLine = /*:\\Windows\\WinSxS\\*/i and CommandLine = /*\\UpdateDeploy.dll /ClassId */i)) or (CommandLine = /* wuaueng.dll */i))))
