// Title: Network Connection Initiated To AzureWebsites.NET By Non-Browser Process
// ID: 5c80b618-0dbb-46e6-acbb-03d90bcb6d83
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.command-and-control, attack.t1102, attack.t1102.001
// Description: Detects an initiated network connection by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
// Converted by: Sigma Universal SIEM/EDR CLI

((Initiated = "true" and DestinationHostname = /.*azurewebsites.net/i) and not((((ImageFileName = /C:\\Program Files (x86)\\Avant Browser\\.*/i or ImageFileName = /C:\\Program Files\\Avant Browser\\.*/i) and ImageFileName = /.*\\avant.exe/i) or (ImageFileName = /C:\\Program Files\\BraveSoftware\\.*/i and ImageFileName = /.*\\brave.exe/i) or ((ImageFileName = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or ImageFileName = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or (ImageFileName = /C:\\Users\\.*/i and ImageFileName = /.*\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe/i) or ((ImageFileName = /*C:\\Program Files\\Windows Defender Advanced Threat Protection\\*/i or ImageFileName = /*C:\\Program Files\\Windows Defender\\*/i or ImageFileName = /*C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*/i) and (ImageFileName = /.*\\MsMpEng.exe/i or ImageFileName = /.*\\MsSense.exe/i)) or (ImageFileName = /*\\AppData\\Local\\Discord\\*/i and ImageFileName = /.*\\Discord.exe/i) or ((ImageFileName = /C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\.*/i) or (ImageFileName = /.*\\WindowsApps\\MicrosoftEdge.exe/i) or ((ImageFileName = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or ImageFileName = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((ImageFileName = /C:\\Program Files (x86)\\Microsoft\\EdgeCore\\.*/i or ImageFileName = /C:\\Program Files\\Microsoft\\EdgeCore\\.*/i) and (ImageFileName = /.*\\msedge.exe/i or ImageFileName = /.*\\msedgewebview2.exe/i)) or (ImageFileName = "") or ((ImageFileName = /C:\\Program Files\\Falkon\\.*/i or ImageFileName = /C:\\Program Files (x86)\\Falkon\\.*/i) and ImageFileName = /.*\\falkon.exe/i) or ((ImageFileName = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or ImageFileName = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or (ImageFileName = /C:\\Users\\.*/i and ImageFileName = /.*\\AppData\\Local\\Mozilla Firefox\\firefox.exe/i) or (ImageFileName = /*\\AppData\\Local\\Flock\\*/i and ImageFileName = /.*\\Flock.exe/i) or ((ImageFileName = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or ImageFileName = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (ImageFileName = /*\\AppData\\Local\\Maxthon\\*/i and ImageFileName = /.*\\maxthon.exe/i) or (not(ImageFileName = *)) or (ImageFileName = /*\\AppData\\Local\\Programs\\Opera\\*/i and ImageFileName = /.*\\opera.exe/i) or (ImageFileName = /*\\AppData\\Local\\Phoebe\\*/i and ImageFileName = /.*\\Phoebe.exe/i) or ((ImageFileName = /.*C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe/i or ImageFileName = /.*C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe/i)) or ((ImageFileName = /C:\\Program Files (x86)\\QtWeb\\.*/i or ImageFileName = /C:\\Program Files\\QtWeb\\.*/i) and ImageFileName = /.*\\QtWeb.exe/i) or ((ImageFileName = /*C:\\Program Files (x86)\\Safari\\*/i or ImageFileName = /*C:\\Program Files\\Safari\\*/i) and ImageFileName = /.*\\safari.exe/i) or ((ImageFileName = /C:\\Program Files\\SeaMonkey\\.*/i or ImageFileName = /C:\\Program Files (x86)\\SeaMonkey\\.*/i) and ImageFileName = /.*\\seamonkey.exe/i) or ((ImageFileName = /C:\\Program Files\\SlimBrowser\\.*/i or ImageFileName = /C:\\Program Files (x86)\\SlimBrowser\\.*/i) and ImageFileName = /.*\\slimbrowser.exe/i) or (ImageFileName = /*\\AppData\\Local\\Vivaldi\\*/i and ImageFileName = /.*\\vivaldi.exe/i) or ((ImageFileName = /C:\\Program Files\\Naver\\Naver Whale\\.*/i or ImageFileName = /C:\\Program Files (x86)\\Naver\\Naver Whale\\.*/i) and ImageFileName = /.*\\whale.exe/i) or ((ImageFileName = /C:\\Program Files\\Waterfox\\.*/i or ImageFileName = /C:\\Program Files (x86)\\Waterfox\\.*/i) and ImageFileName = /.*\\Waterfox.exe/i))))
