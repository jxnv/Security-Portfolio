// Title: Potential Discovery Activity Using Find - Linux
// ID: 8344c0e5-5783-47cc-9cf9-a0f7fd03e6cf
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-28
// Tags: attack.discovery, attack.t1083
// Description: Detects usage of "find" binary in a suspicious manner to perform discovery
// Converted by: Sigma Universal SIEM/EDR CLI

(ImageFileName = /.*/find/i and (CommandLine = /*-perm -4000*/i or CommandLine = /*-perm -2000*/i or CommandLine = /*-perm 0777*/i or CommandLine = /*-perm -222*/i or CommandLine = /*-perm -o w*/i or CommandLine = /*-perm -o x*/i or CommandLine = /*-perm -u=s*/i or CommandLine = /*-perm -g=s*/i))
