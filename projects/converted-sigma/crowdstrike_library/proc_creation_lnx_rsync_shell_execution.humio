// Description: Detects the use of the "rsync" utility to execute a shell. Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments.
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*/ash */i or CommandLine = /*/bash */i or CommandLine = /*/dash */i or CommandLine = /*/csh */i or CommandLine = /*/sh */i or CommandLine = /*/zsh */i or CommandLine = /*/tcsh */i or CommandLine = /*/ksh */i or CommandLine = /*'ash */i or CommandLine = /*'bash */i or CommandLine = /*'dash */i or CommandLine = /*'csh */i or CommandLine = /*'sh */i or CommandLine = /*'zsh */i or CommandLine = /*'tcsh */i or CommandLine = /*'ksh */i)) and ((ImageFileName = /.*/rsync/i or ImageFileName = /.*/rsyncd/i) and CommandLine = /* -e */i))
