// Title: PUA - Netcat Suspicious Execution
// ID: e31033fc-33f0-4020-9a16-faf9b31cbf08
// Status: test
// Level: high
// Author: frack113, Florian Roth (Nextron Systems)
// Date: 2021-07-21
// Tags: attack.command-and-control, attack.t1095
// Description: Detects execution of Netcat. Adversaries may use a non-application layer protocol for communication between host and C2 server or among infected hosts within a network
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /* -lvp */i or CommandLine = /* -lvnp*/i or CommandLine = /* -l -v -p */i or CommandLine = /* -lv -p */i or CommandLine = /* -l --proxy-type http */i or CommandLine = /* -vnl --exec */i or CommandLine = /* -vnl -e */i or CommandLine = /* --lua-exec */i or CommandLine = /* --sh-exec */i)) or ((ImageFileName = /.*\\nc.exe/i or ImageFileName = /.*\\ncat.exe/i or ImageFileName = /.*\\netcat.exe/i)))
