// Description: Detects a tscon.exe start as LOCAL SYSTEM
// Converted by: Sigma Universal SIEM/EDR CLI

((UserName = /*AUTHORI*/i or UserName = /*AUTORI*/i) and ImageFileName = /.*\\tscon.exe/i)
