// Description: Detects uncommon processes creating remote threads.
// Converted by: Sigma Universal SIEM/EDR CLI

(((SourceImage = /.*\\explorer.exe/i or SourceImage = /.*\\iexplore.exe/i or SourceImage = /.*\\msiexec.exe/i or SourceImage = /.*\\powerpnt.exe/i or SourceImage = /.*\\schtasks.exe/i or SourceImage = /.*\\winlogon.exe/i)) and not(((TargetImage = "") or (SourceImage = "C:\\Windows\\explorer.exe" and (TargetImage = /C:\\Program Files (x86)\\.*/i or TargetImage = /C:\\Program Files\\.*/i or TargetImage = /C:\\Windows\\System32\\.*/i or TargetImage = /C:\\Windows\\SysWOW64\\.*/i)) or (SourceImage = "C:\\Program Files\\Internet Explorer\\iexplore.exe" and (TargetImage = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or TargetImage = "C:\\Windows\\System32\\rundll32.exe")) or (SourceImage = /.*\\msiexec.exe/i and (TargetImage = /*\\AppData\\Local\\*/i or TargetImage = /*C:\\Program Files (x86)\\*/i or TargetImage = /*C:\\Program Files\\*/i or TargetImage = /*C:\\Windows\\Microsoft.NET\\Framework64\\*/i)) or (SourceImage = /.*\\msiexec.exe/i and (TargetImage = "C:\\Windows\\System32\\msiexec.exe" or TargetImage = "C:\\Windows\\SysWOW64\\msiexec.exe")) or (not(TargetImage = *)) or (SourceImage = /.*\\POWERPNT.EXE/i and (TargetImage = /*C:\\Program Files\\Microsoft Office\\*/i or TargetImage = /*C:\\Program Files (x86)\\Microsoft Office\\*/i)) or ((SourceImage = "C:\\Windows\\System32\\schtasks.exe" or SourceImage = "C:\\Windows\\SysWOW64\\schtasks.exe") and TargetImage = "C:\\Windows\\System32\\conhost.exe") or (TargetImage = "System") or (SourceImage = "C:\\Windows\\System32\\winlogon.exe" and (TargetImage = "C:\\Windows\\System32\\services.exe" or TargetImage = "C:\\Windows\\System32\\wininit.exe" or TargetImage = "C:\\Windows\\System32\\csrss.exe" or TargetImage = "C:\\Windows\\System32\\LogonUI.exe" or TargetImage = "C:\\Windows\\System32\\wlrmdr.exe" or TargetImage = "C:\\Windows\\System32\\AtBroker.exe" or TargetImage = "C:\\Windows\\System32\\dwm.exe" or TargetImage = "C:\\Windows\\System32\\fontdrvhost.exe" or TargetImage = "C:\\Windows\\System32\\userinit.exe")) or (SourceImage = "C:\\Windows\\System32\\winlogon.exe" and TargetParentProcessId = 4))) and not(((SourceImage = "C:\\Windows\\explorer.exe" and TargetImage = /.*\\aurora-dashboard.exe/i) or (SourceImage = "C:\\Program Files\\internet explorer\\iexplore.exe" and (SourceCommandLine = /*https://*/i and SourceCommandLine = /*.checkpoint.com/documents/*/i and SourceCommandLine = /*SmartConsole_OLH/*/i and SourceCommandLine = /*default.htm#cshid=*/i)) or (SourceImage = "C:\\Program Files\\internet explorer\\iexplore.exe" and (SourceParentImage = /C:\\Program Files\\.*/i or SourceParentImage = /C:\\Program Files (x86)\\.*/i) and (SourceParentImage = /*\\CheckPoint\\SmartConsole\\*/i and SourceParentImage = /*\\SmartConsole.exe*/i)) or (SourceImage = "C:\\Windows\\explorer.exe" and TargetImage = /.*\\OfficeSetup.exe/i) or (SourceImage = "C:\\Windows\\explorer.exe" and TargetImage = /.*\\AppData\\Local\\Microsoft\\OneDrive\\OneDrive.exe/i) or (SourceImage = /*\\Microsoft Office\\*/i and SourceImage = /.*\\POWERPNT.EXE/i and TargetImage = "C:\\Windows\\System32\\csrss.exe"))))
