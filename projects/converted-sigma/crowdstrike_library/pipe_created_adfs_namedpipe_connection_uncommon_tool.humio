// Title: ADFS Database Named Pipe Connection By Uncommon Tool
// ID: 1ea13e8c-03ea-409b-877d-ce5c3d2c1cb3
// Status: test
// Level: medium
// Author: Roberto Rodriguez @Cyb3rWard0g
// Date: 2021-10-08
// Tags: attack.collection, attack.t1005
// Description: Detects suspicious local connections via a named pipe to the AD FS configuration database (Windows Internal Database).
// Used to access information such as the AD FS configuration settings which contains sensitive information used to sign SAML tokens.
// Converted by: Sigma Universal SIEM/EDR CLI

((PipeName = "\\MICROSOFT##WID\\tsql\\query") and not(((ImageFileName = /.*:\\Windows\\System32\\mmc.exe/i or ImageFileName = /.*:\\Windows\\system32\\svchost.exe/i or ImageFileName = /.*:\\Windows\\System32\\wsmprovhost.exe/i or ImageFileName = /.*:\\Windows\\SysWOW64\\mmc.exe/i or ImageFileName = /.*:\\Windows\\SysWOW64\\wsmprovhost.exe/i or ImageFileName = /.*:\\Windows\\WID\\Binn\\sqlwriter.exe/i or ImageFileName = /.*\\AzureADConnect.exe/i or ImageFileName = /.*\\Microsoft.Identity.Health.Adfs.PshSurrogate.exe/i or ImageFileName = /.*\\Microsoft.IdentityServer.ServiceHost.exe/i or ImageFileName = /.*\\Microsoft.Tri.Sensor.exe/i or ImageFileName = /.*\\sqlservr.exe/i or ImageFileName = /.*\\tssdis.exe/i))))
