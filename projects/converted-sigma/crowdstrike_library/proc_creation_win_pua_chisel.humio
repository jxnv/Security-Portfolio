// Title: PUA - Chisel Tunneling Tool Execution
// ID: 8b0e12da-d3c3-49db-bb4f-256703f380e5
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-09-13
// Tags: attack.command-and-control, attack.t1090.001
// Description: Detects usage of the Chisel tunneling tool via the commandline arguments
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*\\chisel.exe/i) or (((CommandLine = /*exe client */i or CommandLine = /*exe server */i)) and ((CommandLine = /*-socks5*/i or CommandLine = /*-reverse*/i or CommandLine = /* r:*/i or CommandLine = /*:127.0.0.1:*/i or CommandLine = /*-tls-skip-verify */i or CommandLine = /*:socks*/i))))
