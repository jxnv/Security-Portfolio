// Tags: attack.persistence, attack.defense-impairment, attack.t1553.003
// Description: Detects when an attacker register a new SIP provider for persistence and defense evasion
// Converted by: Sigma Universal SIEM/EDR CLI

((((TargetObject = /*\\Dll*/i or TargetObject = /*\\$DLL*/i)) and ((TargetObject = /*\\SOFTWARE\\Microsoft\\Cryptography\\Providers\\*/i or TargetObject = /*\\SOFTWARE\\Microsoft\\Cryptography\\OID\\EncodingType*/i or TargetObject = /*\\SOFTWARE\\WOW6432Node\\Microsoft\\Cryptography\\Providers\\*/i or TargetObject = /*\\SOFTWARE\\WOW6432Node\\Microsoft\\Cryptography\\OID\\EncodingType*/i))) and not((((Details = "WINTRUST.DLL" or Details = "mso.dll")) or (ImageFileName = "C:\\Windows\\System32\\poqexec.exe" and TargetObject = /*\\CryptSIPDll*/i and Details = "C:\\Windows\\System32\\PsfSip.dll"))))
