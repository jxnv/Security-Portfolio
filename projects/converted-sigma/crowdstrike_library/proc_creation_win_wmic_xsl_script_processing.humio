// Description: Detects the execution of WMIC with the "format" flag to potentially load local XSL files.
// Adversaries abuse this functionality to execute arbitrary files while potentially bypassing application whitelisting defenses.
// Extensible Stylesheet Language (XSL) files are commonly used to describe the processing and rendering of data within XML files.
// Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine = /*-format:*/i or CommandLine = /*/format:*/i)) and ((ImageFileName = /.*\\wmic.exe/i) or (OriginalFilename = "wmic.exe") or ((Hashes = /*IMPHASH=1B1A3F43BF37B5BFE60751F2EE2F326E*/i or Hashes = /*IMPHASH=37777A96245A3C74EB217308F3546F4C*/i or Hashes = /*IMPHASH=9D87C9D67CE724033C0B40CC4CA1B206*/i or Hashes = /*IMPHASH=B12619881D79C3ACADF45E752A58554A*/i or Hashes = /*IMPHASH=16A48C3CABF98A9DC1BF02C07FE1EA00*/i)))) and not((((CommandLine = /*Format:List*/i or CommandLine = /*Format:htable*/i or CommandLine = /*Format:hform*/i or CommandLine = /*Format:table*/i or CommandLine = /*Format:mof*/i or CommandLine = /*Format:value*/i or CommandLine = /*Format:rawxml*/i or CommandLine = /*Format:xml*/i or CommandLine = /*Format:csv*/i)) or ((CommandLine = /*://*/i or CommandLine = /*\\\\\\\\*/i)))))
