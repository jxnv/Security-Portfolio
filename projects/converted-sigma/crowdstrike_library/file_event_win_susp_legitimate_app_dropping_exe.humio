// Title: Legitimate Application Dropped Executable
// ID: f0540f7e-2db3-4432-b9e0-3965486744bc
// Status: test
// Level: high
// Author: frack113, Florian Roth (Nextron Systems)
// Date: 2022-08-21
// Tags: attack.stealth, attack.t1218
// Description: Detects LOLBINs and applications that should not legitimately drop executable or executable-equivalent files to disk.
// This may indicate malware staging, process injection, or abuse of a trusted binary for payload delivery.
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*\\eqnedt32.exe/i or ImageFileName = /.*\\wordpad.exe/i or ImageFileName = /.*\\wordview.exe/i or ImageFileName = /.*\\certutil.exe/i or ImageFileName = /.*\\certoc.exe/i or ImageFileName = /.*\\CertReq.exe/i or ImageFileName = /.*\\Desktopimgdownldr.exe/i or ImageFileName = /.*\\esentutl.exe/i or ImageFileName = /.*\\mshta.exe/i or ImageFileName = /.*\\AcroRd32.exe/i or ImageFileName = /.*\\RdrCEF.exe/i or ImageFileName = /.*\\hh.exe/i or ImageFileName = /.*\\finger.exe/i) and (TargetFileName = /.*.com/i or TargetFileName = /.*.dll/i or TargetFileName = /.*.exe/i or TargetFileName = /.*.jar/i or TargetFileName = /.*.ocx/i or TargetFileName = /.*.pyc/i))
