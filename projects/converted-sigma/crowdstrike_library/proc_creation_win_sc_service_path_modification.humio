// Title: Suspicious Service Path Modification
// ID: 138d3531-8793-4f50-a2cd-f291b2863d78
// Status: test
// Level: high
// Author: Victor Sergeev, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-10-21
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects service path modification via the "sc" binary to a suspicious command or path
// Converted by: Sigma Universal SIEM/EDR CLI

(ImageFileName = /.*\\sc.exe/i and (CommandLine = /*config*/i and CommandLine = /*binPath*/i) and (CommandLine = /*powershell*/i or CommandLine = /*cmd */i or CommandLine = /*mshta*/i or CommandLine = /*wscript*/i or CommandLine = /*cscript*/i or CommandLine = /*rundll32*/i or CommandLine = /*svchost*/i or CommandLine = /*dllhost*/i or CommandLine = /*cmd.exe /c*/i or CommandLine = /*cmd.exe /k*/i or CommandLine = /*cmd.exe /r*/i or CommandLine = /*cmd /c*/i or CommandLine = /*cmd /k*/i or CommandLine = /*cmd /r*/i or CommandLine = /*C:\\Users\\Public*/i or CommandLine = /*\\Downloads\\*/i or CommandLine = /*\\Desktop\\*/i or CommandLine = /*\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\*/i or CommandLine = /*C:\\Windows\\TEMP\\*/i or CommandLine = /*\\AppData\\Local\\Temp*/i))
