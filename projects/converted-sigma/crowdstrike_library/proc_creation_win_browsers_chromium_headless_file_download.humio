// Title: File Download with Headless Browser
// ID: 0e8cfe08-02c9-4815-a2f8-0d157b7ed33e
// Status: test
// Level: high
// Author: Sreeman, Florian Roth (Nextron Systems)
// Date: 2022-01-04
// Tags: attack.command-and-control, attack.stealth, attack.t1105, attack.t1564.003
// Description: Detects execution of chromium based browser in headless mode using the "dump-dom" command line to download files
// Converted by: Sigma Universal SIEM/EDR CLI

(((ImageFileName = /.*\\brave.exe/i or ImageFileName = /.*\\chrome.exe/i or ImageFileName = /.*\\msedge.exe/i or ImageFileName = /.*\\opera.exe/i or ImageFileName = /.*\\vivaldi.exe/i) and (CommandLine = /*--headless*/i and CommandLine = /*dump-dom*/i and CommandLine = /*http*/i)) and not((((ImageFileName = /C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\.*/i or ImageFileName = /C:\\Program Files (x86)\\Microsoft\\EdgeCore\\.*/i or ImageFileName = /C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\.*/i or ImageFileName = /C:\\Program Files\\Microsoft\\Edge\\Application\\.*/i or ImageFileName = /C:\\Program Files\\Microsoft\\EdgeCore\\.*/i or ImageFileName = /C:\\Program Files\\Microsoft\\EdgeWebView\\.*/i or ImageFileName = /C:\\Program Files\\WindowsApps\\Microsoft.MicrosoftEdge.*/i) and (ImageFileName = /.*\\msedge.exe/i or ImageFileName = /.*\\msedgewebview2.exe/i or ImageFileName = /.*\\MicrosoftEdge.exe/i) and CommandLine = /*--headless --disable-gpu --disable-extensions --disable-plugins --mute-audio --no-first-run --incognito --aggressive-cache-discard --dump-dom*/i) or ((ImageFileName = /*\\AppData\\Local\\Microsoft\\WindowsApps\\*/i or ImageFileName = /*\\Windows\\SystemApps\\Microsoft.MicrosoftEdge*/i) and (ImageFileName = /.*\\msedge.exe/i or ImageFileName = /.*\\MicrosoftEdge.exe/i) and CommandLine = /*--headless --disable-gpu --disable-extensions --disable-plugins --mute-audio --no-first-run --incognito --aggressive-cache-discard --dump-dom*/i))))
