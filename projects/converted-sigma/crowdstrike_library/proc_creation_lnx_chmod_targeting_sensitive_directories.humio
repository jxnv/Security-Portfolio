// Title: Chmod Targeting Sensitive Directories
// ID: 6419afd1-3742-47a5-a7e6-b50386cd15f8
// Status: test
// Level: medium
// Author: Christopher Peacock @SecurePeacock, SCYTHE @scythe_io
// Date: 2022-06-03
// Tags: attack.defense-impairment, attack.t1222.002
// Description: Detects chmod targeting files in sensitive directory paths on Linux systems.
// Attackers may use chmod to change permissions of files in these directories to maintain persistence, escalate privileges, or disrupt system operations.
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageFileName = /.*/chmod/i and (CommandLine = /*/tmp/*/i or CommandLine = /*/.Library/*/i or CommandLine = /*/etc/*/i or CommandLine = /*/opt/*/i)) and not(((CommandLine = /chmod 700 /tmp/apt-key-gpghome..*/i) or (CommandLine = "chmod 0775 /etc/landscape/") or (CommandLine = /chmod 755 /var/tmp/mkinitramfs.*/i) or (CommandLine = /*/etc/*/i and (ParentCommandLine = /*/var/lib/dpkg/info/*/i and ParentCommandLine = /*.postinst configure*/i)) or (CommandLine = "chmod 644 /etc/apparmor.d/tunables/home.d/ubuntu") or (CommandLine = /*chmod --reference=/etc/shells*/i and ParentCommandLine = /.*/update-shells/i))))
