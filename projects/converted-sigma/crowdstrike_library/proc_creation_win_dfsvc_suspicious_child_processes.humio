// Title: Potentially Suspicious Child Process Of ClickOnce Application
// ID: 67bc0e75-c0a9-4cfc-8754-84a505b63c04
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-12
// Tags: attack.execution, attack.stealth
// Description: Detects potentially suspicious child processes of a ClickOnce deployment application
// Converted by: Sigma Universal SIEM/EDR CLI

(ParentBaseFileName = /*\\AppData\\Local\\Apps\\2.0\\*/i and (ImageFileName = /.*\\calc.exe/i or ImageFileName = /.*\\cmd.exe/i or ImageFileName = /.*\\cscript.exe/i or ImageFileName = /.*\\explorer.exe/i or ImageFileName = /.*\\mshta.exe/i or ImageFileName = /.*\\net.exe/i or ImageFileName = /.*\\net1.exe/i or ImageFileName = /.*\\nltest.exe/i or ImageFileName = /.*\\notepad.exe/i or ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i or ImageFileName = /.*\\reg.exe/i or ImageFileName = /.*\\regsvr32.exe/i or ImageFileName = /.*\\rundll32.exe/i or ImageFileName = /.*\\schtasks.exe/i or ImageFileName = /.*\\werfault.exe/i or ImageFileName = /.*\\wscript.exe/i))
