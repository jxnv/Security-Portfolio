// Title: Suspicious Java Children Processes
// ID: d292e0af-9a18-420c-9525-ec0ac3936892
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-03
// Tags: attack.execution, attack.t1059
// Description: Detects java process spawning suspicious children
// Converted by: Sigma Universal SIEM/EDR CLI

(ParentBaseFileName = /.*/java/i and (CommandLine = /*/bin/sh*/i or CommandLine = /*bash*/i or CommandLine = /*dash*/i or CommandLine = /*ksh*/i or CommandLine = /*zsh*/i or CommandLine = /*csh*/i or CommandLine = /*fish*/i or CommandLine = /*curl*/i or CommandLine = /*wget*/i or CommandLine = /*python*/i))
