// Title: Potentially Suspicious Call To Win32_NTEventlogFile Class - PSScript
// ID: e2812b49-bae0-4b21-b366-7c142eafcde2
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-07-13
// Tags: attack.defense-impairment
// Description: Detects usage of the WMI class "Win32_NTEventlogFile" in a potentially suspicious way (delete, backup, change permissions, etc.) from a PowerShell script
// Converted by: Sigma Universal SIEM/EDR CLI

((ScriptBlockText = /*Win32_NTEventlogFile*/i) and ((ScriptBlockText = /*.BackupEventlog(*/i or ScriptBlockText = /*.ChangeSecurityPermissions(*/i or ScriptBlockText = /*.ChangeSecurityPermissionsEx(*/i or ScriptBlockText = /*.ClearEventLog(*/i or ScriptBlockText = /*.Delete(*/i or ScriptBlockText = /*.DeleteEx(*/i or ScriptBlockText = /*.Rename(*/i or ScriptBlockText = /*.TakeOwnerShip(*/i or ScriptBlockText = /*.TakeOwnerShipEx(*/i)))
