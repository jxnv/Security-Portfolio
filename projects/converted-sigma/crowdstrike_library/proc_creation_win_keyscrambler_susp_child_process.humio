// Description: Detects potentially suspicious child processes of KeyScrambler.exe
// Converted by: Sigma Universal SIEM/EDR CLI

((((ImageFileName = /.*\\cmd.exe/i or ImageFileName = /.*\\cscript.exe/i or ImageFileName = /.*\\mshta.exe/i or ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i or ImageFileName = /.*\\regsvr32.exe/i or ImageFileName = /.*\\rundll32.exe/i or ImageFileName = /.*\\wscript.exe/i)) or ((OriginalFilename = "Cmd.Exe" or OriginalFilename = "cscript.exe" or OriginalFilename = "mshta.exe" or OriginalFilename = "PowerShell.EXE" or OriginalFilename = "pwsh.dll" or OriginalFilename = "regsvr32.exe" or OriginalFilename = "RUNDLL32.EXE" or OriginalFilename = "wscript.exe"))) and (ParentBaseFileName = /.*\\KeyScrambler.exe/i))
