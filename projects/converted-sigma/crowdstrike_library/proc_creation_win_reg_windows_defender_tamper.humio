// Title: Suspicious Windows Defender Registry Key Tampering Via Reg.EXE
// ID: 452bce90-6fb0-43cc-97a5-affc283139b3
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Swachchhanda Shrawan Poudel, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-03-22
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects the usage of "reg.exe" to tamper with different Windows Defender registry keys in order to disable some important features related to protection and detection
// Converted by: Sigma Universal SIEM/EDR CLI

((((ImageFileName = /.*\\reg.exe/i) or (OriginalFilename = "reg.exe")) and ((CommandLine = /*SOFTWARE\\Microsoft\\Windows Defender\\*/i or CommandLine = /*SOFTWARE\\Policies\\Microsoft\\Windows Defender Security Center*/i or CommandLine = /*SOFTWARE\\Policies\\Microsoft\\Windows Defender\\*/i))) and (((CommandLine = /* add */i and CommandLine = /*d 0*/i) and (CommandLine = /*DisallowExploitProtectionOverride*/i or CommandLine = /*EnableControlledFolderAccess*/i or CommandLine = /*MpEnablePus*/i or CommandLine = /*PUAProtection*/i or CommandLine = /*SpynetReporting*/i or CommandLine = /*SubmitSamplesConsent*/i or CommandLine = /*TamperProtection*/i)) or ((CommandLine = /* add */i and CommandLine = /*d 1*/i) and (CommandLine = /*DisableAccess*/i or CommandLine = /*DisableAntiSpyware*/i or CommandLine = /*DisableAntiSpywareRealtimeProtection*/i or CommandLine = /*DisableAntiVirus*/i or CommandLine = /*DisableAntiVirusSignatures*/i or CommandLine = /*DisableArchiveScanning*/i or CommandLine = /*DisableBehaviorMonitoring*/i or CommandLine = /*DisableBlockAtFirstSeen*/i or CommandLine = /*DisableCloudProtection*/i or CommandLine = /*DisableConfig*/i or CommandLine = /*DisableEnhancedNotifications*/i or CommandLine = /*DisableIntrusionPreventionSystem*/i or CommandLine = /*DisableIOAVProtection*/i or CommandLine = /*DisableNetworkProtection*/i or CommandLine = /*DisableOnAccessProtection*/i or CommandLine = /*DisablePrivacyMode*/i or CommandLine = /*DisableRealtimeMonitoring*/i or CommandLine = /*DisableRoutinelyTakingAction*/i or CommandLine = /*DisableScanOnRealtimeEnable*/i or CommandLine = /*DisableScriptScanning*/i or CommandLine = /*DisableSecurityCenter*/i or CommandLine = /*Notification_Suppress*/i or CommandLine = /*SignatureDisableUpdateOnStartupWithoutEngine*/i))))
