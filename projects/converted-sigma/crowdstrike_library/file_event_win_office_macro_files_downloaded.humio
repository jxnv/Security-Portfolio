// Title: Office Macro File Download
// ID: 0e29e3a7-1ad8-40aa-b691-9f82ecd33d66
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-23
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects the creation of a new office macro files on the system via an application (browser, mail client).
// This can help identify potential malicious activity, such as the download of macro-enabled documents that could be used for exploitation.
// Converted by: Sigma Universal SIEM/EDR CLI

((((TargetFileName = /.*.docm/i or TargetFileName = /.*.dotm/i or TargetFileName = /.*.xlsm/i or TargetFileName = /.*.xltm/i or TargetFileName = /.*.potm/i or TargetFileName = /.*.pptm/i)) or ((TargetFileName = /*.docm:Zone*/i or TargetFileName = /*.dotm:Zone*/i or TargetFileName = /*.xlsm:Zone*/i or TargetFileName = /*.xltm:Zone*/i or TargetFileName = /*.potm:Zone*/i or TargetFileName = /*.pptm:Zone*/i))) and ((ImageFileName = /.*\\RuntimeBroker.exe/i or ImageFileName = /.*\\outlook.exe/i or ImageFileName = /.*\\thunderbird.exe/i or ImageFileName = /.*\\brave.exe/i or ImageFileName = /.*\\chrome.exe/i or ImageFileName = /.*\\firefox.exe/i or ImageFileName = /.*\\iexplore.exe/i or ImageFileName = /.*\\maxthon.exe/i or ImageFileName = /.*\\MicrosoftEdge.exe/i or ImageFileName = /.*\\msedge.exe/i or ImageFileName = /.*\\msedgewebview2.exe/i or ImageFileName = /.*\\opera.exe/i or ImageFileName = /.*\\safari.exe/i or ImageFileName = /.*\\seamonkey.exe/i or ImageFileName = /.*\\vivaldi.exe/i or ImageFileName = /.*\\whale.exe/i)))
