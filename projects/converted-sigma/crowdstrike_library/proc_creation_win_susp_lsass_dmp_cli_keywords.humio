// Title: LSASS Dump Keyword In CommandLine
// ID: ffa6861c-4461-4f59-8a41-578c39f3f23e
// Status: test
// Level: high
// Author: E.M. Anhaus, Tony Lambert, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-10-24
// Tags: attack.credential-access, attack.t1003.001
// Description: Detects the presence of the keywords "lsass" and ".dmp" in the commandline, which could indicate a potential attempt to dump or create a dump of the lsass process.
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*lsass.dmp*/i or CommandLine = /*lsass.zip*/i or CommandLine = /*lsass.rar*/i or CommandLine = /*Andrew.dmp*/i or CommandLine = /*Coredump.dmp*/i or CommandLine = /*NotLSASS.zip*/i or CommandLine = /*lsass_2*/i or CommandLine = /*lsassdump*/i or CommandLine = /*lsassdmp*/i)) or ((CommandLine = /*lsass*/i and CommandLine = /*.dmp*/i)) or ((CommandLine = /*SQLDmpr*/i and CommandLine = /*.mdmp*/i)) or ((CommandLine = /*nanodump*/i and CommandLine = /*.dmp*/i)))
