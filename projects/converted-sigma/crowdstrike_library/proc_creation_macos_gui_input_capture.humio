// Title: GUI Input Capture - macOS
// ID: 60f1ce20-484e-41bd-85f4-ac4afec2c541
// Status: test
// Level: low
// Author: remotephone, oscd.community
// Date: 2020-10-13
// Tags: attack.collection, attack.credential-access, attack.t1056.002
// Description: Detects attempts to use system dialog prompts to capture user credentials
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*-e*/i and CommandLine = /*display*/i and CommandLine = /*dialog*/i and CommandLine = /*answer*/i)) and ((CommandLine = /*admin*/i or CommandLine = /*administrator*/i or CommandLine = /*authenticate*/i or CommandLine = /*authentication*/i or CommandLine = /*credentials*/i or CommandLine = /*pass*/i or CommandLine = /*password*/i or CommandLine = /*unlock*/i)) and (ImageFileName = /.*/osascript/i))
