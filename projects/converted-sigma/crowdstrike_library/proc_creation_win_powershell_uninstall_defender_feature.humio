// Title: Suspicious Uninstall of Windows Defender Feature via PowerShell
// ID: c443012c-7928-43bf-ac20-7eda5efe61ad
// Status: experimental
// Level: high
// Author: yxinmiracle
// Date: 2025-08-22
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects the use of PowerShell with Uninstall-WindowsFeature or Remove-WindowsFeature cmdlets to disable or remove the Windows Defender GUI feature, a common technique used by adversaries to evade defenses.
// Converted by: Sigma Universal SIEM/EDR CLI

((CommandLine = /*Windows-Defender*/i) and ((CommandLine = /*Uninstall-WindowsFeature*/i or CommandLine = /*Remove-WindowsFeature*/i)) and (((ImageFileName = /.*\\powershell_ise.exe/i or ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i)) or ((OriginalFilename = "PowerShell_ISE.EXE" or OriginalFilename = "PowerShell.EXE" or OriginalFilename = "pwsh.dll"))))
