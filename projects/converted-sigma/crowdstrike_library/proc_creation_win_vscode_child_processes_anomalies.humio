// Title: Potentially Suspicious Child Process Of VsCode
// ID: 5a3164f2-b373-4152-93cf-090b13c12d27
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-26
// Tags: attack.execution, attack.stealth, attack.t1218, attack.t1202
// Description: Detects uncommon or suspicious child processes spawning from a VsCode "code.exe" process. This could indicate an attempt of persistence via VsCode tasks or terminal profiles.
// Converted by: Sigma Universal SIEM/EDR CLI

((ParentBaseFileName = /.*\\code.exe/i) and (((ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i or ImageFileName = /.*\\cmd.exe/i) and (CommandLine = /*Invoke-Expressions*/i or CommandLine = /*IEX*/i or CommandLine = /*Invoke-Command*/i or CommandLine = /*ICM*/i or CommandLine = /*DownloadString*/i or CommandLine = /*rundll32*/i or CommandLine = /*regsvr32*/i or CommandLine = /*wscript*/i or CommandLine = /*cscript*/i)) or ((ImageFileName = /.*\\calc.exe/i or ImageFileName = /.*\\regsvr32.exe/i or ImageFileName = /.*\\rundll32.exe/i or ImageFileName = /.*\\cscript.exe/i or ImageFileName = /.*\\wscript.exe/i)) or ((ImageFileName = /*:\\Users\\Public\\*/i or ImageFileName = /*:\\Windows\\Temp\\*/i or ImageFileName = /*:\\Temp\\*/i))))
