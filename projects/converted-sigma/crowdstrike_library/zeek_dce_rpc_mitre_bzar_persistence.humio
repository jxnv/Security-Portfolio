((endpoint = "spoolss" and operation = "RpcAddMonitor") or (endpoint = "spoolss" and operation = "RpcAddPrintProcessor") or (endpoint = "IRemoteWinspool" and operation = "RpcAsyncAddMonitor") or (endpoint = "IRemoteWinspool" and operation = "RpcAsyncAddPrintProcessor") or (endpoint = "ISecLogon" and operation = "SeclCreateProcessWithLogonW") or (endpoint = "ISecLogon" and operation = "SeclCreateProcessWithLogonExW"))
