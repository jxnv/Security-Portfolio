// Title: Uncommon  Assistive Technology Applications Execution Via AtBroker.EXE
// ID: f24bcaea-0cd1-11eb-adc1-0242ac120002
// Status: test
// Level: medium
// Author: Mateusz Wydra, oscd.community
// Date: 2020-10-12
// Tags: attack.stealth, attack.t1218
// Description: Detects the start of a non built-in assistive technology applications via "Atbroker.EXE".
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*start*/i) and ((ImageFileName = /.*\\AtBroker.exe/i) or (OriginalFilename = "AtBroker.exe"))) and not(((CommandLine = /*animations*/i or CommandLine = /*audiodescription*/i or CommandLine = /*caretbrowsing*/i or CommandLine = /*caretwidth*/i or CommandLine = /*colorfiltering*/i or CommandLine = /*cursorindicator*/i or CommandLine = /*cursorscheme*/i or CommandLine = /*filterkeys*/i or CommandLine = /*focusborderheight*/i or CommandLine = /*focusborderwidth*/i or CommandLine = /*highcontrast*/i or CommandLine = /*keyboardcues*/i or CommandLine = /*keyboardpref*/i or CommandLine = /*livecaptions*/i or CommandLine = /*magnifierpane*/i or CommandLine = /*messageduration*/i or CommandLine = /*minimumhitradius*/i or CommandLine = /*mousekeys*/i or CommandLine = /*Narrator*/i or CommandLine = /*osk*/i or CommandLine = /*overlappedcontent*/i or CommandLine = /*showsounds*/i or CommandLine = /*soundsentry*/i or CommandLine = /*speechreco*/i or CommandLine = /*stickykeys*/i or CommandLine = /*togglekeys*/i or CommandLine = /*voiceaccess*/i or CommandLine = /*windowarranging*/i or CommandLine = /*windowtracking*/i or CommandLine = /*windowtrackingtimeout*/i or CommandLine = /*windowtrackingzorder*/i))) and not((CommandLine = /*Oracle_JavaAccessBridge*/i)))
