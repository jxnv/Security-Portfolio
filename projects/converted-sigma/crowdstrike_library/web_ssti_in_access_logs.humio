// Title: Server Side Template Injection Strings
// ID: ada3bc4f-f0fd-42b9-ba91-e105e8af7342
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-14
// Tags: attack.stealth, attack.t1221
// Description: Detects SSTI attempts sent via GET requests in access logs
// Converted by: Sigma Universal SIEM/EDR CLI

((cs-method = "GET") and ("={{" or "=%7B%7B" or "=${" or "=$%7B" or "=<%=" or "=%3C%25=" or "=@(" or "freemarker.template.utility.Execute" or ".getClass().forName('javax.script.ScriptEngineManager')" or "T(org.apache.commons.io.IOUtils)") and not((sc-status = 404)))
