(((CommandLine = /* -c */i and CommandLine = /*os.system(*/i) and (CommandLine = /*/bin/bash*/i or CommandLine = /*/bin/dash*/i or CommandLine = /*/bin/fish*/i or CommandLine = /*/bin/sh*/i or CommandLine = /*/bin/zsh*/i)) and (((ImageFileName = /.*/python/i or ImageFileName = /.*/python2/i or ImageFileName = /.*/python3/i)) or ((ImageFileName = /*/python2.*/i or ImageFileName = /*/python3.*/i))))
