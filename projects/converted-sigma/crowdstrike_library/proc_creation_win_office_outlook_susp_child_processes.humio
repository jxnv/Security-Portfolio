// Title: Suspicious Outlook Child Process
// ID: 208748f7-881d-47ac-a29c-07ea84bf691d
// Status: test
// Level: high
// Author: Michael Haag, Florian Roth (Nextron Systems), Markus Neis, Elastic, FPT.EagleEye Team
// Date: 2022-02-28
// Tags: attack.execution, attack.t1204.002
// Description: Detects a suspicious process spawning from an Outlook process.
// Converted by: Sigma Universal SIEM/EDR CLI

(ParentBaseFileName = /.*\\OUTLOOK.EXE/i and (ImageFileName = /.*\\AppVLP.exe/i or ImageFileName = /.*\\bash.exe/i or ImageFileName = /.*\\cmd.exe/i or ImageFileName = /.*\\cscript.exe/i or ImageFileName = /.*\\forfiles.exe/i or ImageFileName = /.*\\hh.exe/i or ImageFileName = /.*\\mftrace.exe/i or ImageFileName = /.*\\msbuild.exe/i or ImageFileName = /.*\\msdt.exe/i or ImageFileName = /.*\\mshta.exe/i or ImageFileName = /.*\\msiexec.exe/i or ImageFileName = /.*\\powershell.exe/i or ImageFileName = /.*\\pwsh.exe/i or ImageFileName = /.*\\regsvr32.exe/i or ImageFileName = /.*\\schtasks.exe/i or ImageFileName = /.*\\scrcons.exe/i or ImageFileName = /.*\\scriptrunner.exe/i or ImageFileName = /.*\\sh.exe/i or ImageFileName = /.*\\svchost.exe/i or ImageFileName = /.*\\wmic.exe/i or ImageFileName = /.*\\wscript.exe/i))
