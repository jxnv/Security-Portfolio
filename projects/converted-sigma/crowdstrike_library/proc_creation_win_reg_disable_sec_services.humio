// Title: Security Service Disabled Via Reg.EXE
// ID: 5e95028c-5229-4214-afae-d653d573d0ec
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), John Lambert (idea), elhoim
// Date: 2021-07-14
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects execution of "reg.exe" to disable security services such as Windows Defender.
// Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine = /*d 4*/i and CommandLine = /*v Start*/i) and (CommandLine = /*\\AppIDSvc*/i or CommandLine = /*\\MsMpSvc*/i or CommandLine = /*\\NisSrv*/i or CommandLine = /*\\SecurityHealthService*/i or CommandLine = /*\\Sense*/i or CommandLine = /*\\UsoSvc*/i or CommandLine = /*\\WdBoot*/i or CommandLine = /*\\WdFilter*/i or CommandLine = /*\\WdNisDrv*/i or CommandLine = /*\\WdNisSvc*/i or CommandLine = /*\\WinDefend*/i or CommandLine = /*\\wscsvc*/i or CommandLine = /*\\wuauserv*/i)) and ((CommandLine = /*reg*/i and CommandLine = /*add*/i)))
