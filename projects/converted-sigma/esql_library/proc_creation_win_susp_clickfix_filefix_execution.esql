// Title: Suspicious ClickFix/FileFix Execution Pattern
// ID: d487ed4a-fd24-436d-a0b2-f4e95f7b2635
// Status: experimental
// Level: high
// Author: montysecurity, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-11-19
// Tags: attack.execution, attack.t1204.001, attack.t1204.004
// Description: Detects suspicious execution patterns where users are tricked into running malicious commands via clipboard manipulation, either through the Windows Run dialog (ClickFix) or File Explorer address bar (FileFix).
// Attackers leverage social engineering campaigns—such as fake CAPTCHA challenges or urgent alerts—encouraging victims to paste clipboard contents, often executing mshta.exe, powershell.exe, or similar commands to infect systems.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%account%" OR process.command_line LIKE "%anti-bot%" OR process.command_line LIKE "%botcheck%" OR process.command_line LIKE "%captcha%" OR process.command_line LIKE "%challenge%" OR process.command_line LIKE "%confirmation%" OR process.command_line LIKE "%fraud%" OR process.command_line LIKE "%human%" OR process.command_line LIKE "%identification%" OR process.command_line LIKE "%identificator%" OR process.command_line LIKE "%identity%" OR process.command_line LIKE "%robot%" OR process.command_line LIKE "%validation%" OR process.command_line LIKE "%verification%" OR process.command_line LIKE "%verify%")) AND (process.parent.executable LIKE "%\\explorer.exe" AND process.command_line LIKE "%#%"))
