// Title: PowerShell Base64 Encoded IEX Cmdlet
// ID: 88f680b8-070e-402c-ae11-d2914f2257f1
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2019-08-23
// Tags: attack.execution, attack.t1059.001
// Description: Detects usage of a base64 encoded "IEX" cmdlet in a process command line
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%SUVYIChb%" OR process.command_line LIKE "%lFWCAoW%" OR process.command_line LIKE "%JRVggKF%" OR process.command_line LIKE "%aWV4IChb%" OR process.command_line LIKE "%lleCAoW%" OR process.command_line LIKE "%pZXggKF%" OR process.command_line LIKE "%aWV4IChOZX%" OR process.command_line LIKE "%lleCAoTmV3%" OR process.command_line LIKE "%pZXggKE5ld%" OR process.command_line LIKE "%SUVYIChOZX%" OR process.command_line LIKE "%lFWCAoTmV3%" OR process.command_line LIKE "%JRVggKE5ld%" OR process.command_line LIKE "%SUVYKF%" OR process.command_line LIKE "%lFWChb%" OR process.command_line LIKE "%JRVgoW%" OR process.command_line LIKE "%aWV4KF%" OR process.command_line LIKE "%lleChb%" OR process.command_line LIKE "%pZXgoW%" OR process.command_line LIKE "%aWV4KE5ld%" OR process.command_line LIKE "%lleChOZX%" OR process.command_line LIKE "%pZXgoTmV3%" OR process.command_line LIKE "%SUVYKE5ld%" OR process.command_line LIKE "%lFWChOZX%" OR process.command_line LIKE "%JRVgoTmV3%" OR process.command_line LIKE "%SUVYKCgn%" OR process.command_line LIKE "%lFWCgoJ%" OR process.command_line LIKE "%JRVgoKC%" OR process.command_line LIKE "%aWV4KCgn%" OR process.command_line LIKE "%lleCgoJ%" OR process.command_line LIKE "%pZXgoKC%")) OR ((process.command_line LIKE "%SQBFAFgAIAAoAFsA%" OR process.command_line LIKE "%kARQBYACAAKABbA%" OR process.command_line LIKE "%JAEUAWAAgACgAWw%" OR process.command_line LIKE "%aQBlAHgAIAAoAFsA%" OR process.command_line LIKE "%kAZQB4ACAAKABbA%" OR process.command_line LIKE "%pAGUAeAAgACgAWw%" OR process.command_line LIKE "%aQBlAHgAIAAoAE4AZQB3A%" OR process.command_line LIKE "%kAZQB4ACAAKABOAGUAdw%" OR process.command_line LIKE "%pAGUAeAAgACgATgBlAHcA%" OR process.command_line LIKE "%SQBFAFgAIAAoAE4AZQB3A%" OR process.command_line LIKE "%kARQBYACAAKABOAGUAdw%" OR process.command_line LIKE "%JAEUAWAAgACgATgBlAHcA%")))
