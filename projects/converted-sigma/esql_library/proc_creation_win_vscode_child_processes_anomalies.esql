// Title: Potentially Suspicious Child Process Of VsCode
// ID: 5a3164f2-b373-4152-93cf-090b13c12d27
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-26
// Tags: attack.execution, attack.stealth, attack.t1218, attack.t1202
// Description: Detects uncommon or suspicious child processes spawning from a VsCode "code.exe" process. This could indicate an attempt of persistence via VsCode tasks or terminal profiles.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.parent.executable LIKE "%\\code.exe") AND (((process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe" OR process.executable LIKE "%\\cmd.exe") AND (process.command_line LIKE "%Invoke-Expressions%" OR process.command_line LIKE "%IEX%" OR process.command_line LIKE "%Invoke-Command%" OR process.command_line LIKE "%ICM%" OR process.command_line LIKE "%DownloadString%" OR process.command_line LIKE "%rundll32%" OR process.command_line LIKE "%regsvr32%" OR process.command_line LIKE "%wscript%" OR process.command_line LIKE "%cscript%")) OR ((process.executable LIKE "%\\calc.exe" OR process.executable LIKE "%\\regsvr32.exe" OR process.executable LIKE "%\\rundll32.exe" OR process.executable LIKE "%\\cscript.exe" OR process.executable LIKE "%\\wscript.exe")) OR ((process.executable LIKE "%:\\Users\\Public\\%" OR process.executable LIKE "%:\\Windows\\Temp\\%" OR process.executable LIKE "%:\\Temp\\%"))))
