// Title: Flush Iptables Ufw Chain
// ID: 3be619f4-d9ec-4ea8-a173-18fdd01996ab
// Status: test
// Level: medium
// Author: Joseliyo Sanchez, @Joseliyo_Jstnk
// Date: 2023-01-18
// Tags: attack.defense-impairment, attack.t1686
// Description: Detect use of iptables to flush all firewall rules, tables and chains and allow all network traffic
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%/iptables" OR process.executable LIKE "%/xtables-legacy-multi" OR process.executable LIKE "%/iptables-legacy-multi" OR process.executable LIKE "%/ip6tables" OR process.executable LIKE "%/ip6tables-legacy-multi")) AND ((process.command_line LIKE "%-F%" OR process.command_line LIKE "%-Z%" OR process.command_line LIKE "%-X%")) AND ((process.command_line LIKE "%ufw-logging-deny%" OR process.command_line LIKE "%ufw-logging-allow%" OR process.command_line LIKE "%ufw6-logging-deny%" OR process.command_line LIKE "%ufw6-logging-allow%")))
