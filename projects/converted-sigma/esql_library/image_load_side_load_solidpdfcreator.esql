// Title: Potential SolidPDFCreator.DLL Sideloading
// ID: a2edbce1-95c8-4291-8676-0d45146862b3
// Status: test
// Level: medium
// Author: X__Junior (Nextron Systems)
// Date: 2023-05-07
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of "SolidPDFCreator.dll"
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((ImageLoaded LIKE "%\\SolidPDFCreator.dll") AND NOT ((process.executable LIKE "%\\SolidPDFCreator.exe" AND (ImageLoaded LIKE "C:\\Program Files (x86)\\SolidDocuments\\SolidPDFCreator\\%" OR ImageLoaded LIKE "C:\\Program Files\\SolidDocuments\\SolidPDFCreator\\%"))))
