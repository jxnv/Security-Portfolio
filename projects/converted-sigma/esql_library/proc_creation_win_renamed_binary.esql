// Title: Potential Defense Evasion Via Binary Rename
// ID: 36480ae1-a1cb-4eaa-a0d6-29801d7e9142
// Status: test
// Level: medium
// Author: Matthew Green @mgreen27, Ecco, James Pemberton @4A616D6573, oscd.community, Andreas Hunkeler (@Karneades)
// Date: 2019-06-15
// Tags: attack.stealth, attack.t1036.003
// Description: Detects the execution of a renamed binary often used by attackers or malware leveraging new Sysmon OriginalFileName datapoint.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.pe.original_file_name == "Cmd.Exe" OR process.pe.original_file_name == "CONHOST.EXE" OR process.pe.original_file_name == "7z.exe" OR process.pe.original_file_name == "7za.exe" OR process.pe.original_file_name == "7zr.exe" OR process.pe.original_file_name == "WinRAR.exe" OR process.pe.original_file_name == "wevtutil.exe" OR process.pe.original_file_name == "net.exe" OR process.pe.original_file_name == "net1.exe" OR process.pe.original_file_name == "netsh.exe" OR process.pe.original_file_name == "InstallUtil.exe")) AND NOT (((process.executable LIKE "%\\cmd.exe" OR process.executable LIKE "%\\conhost.exe" OR process.executable LIKE "%\\7z.exe" OR process.executable LIKE "%\\7za.exe" OR process.executable LIKE "%\\7zr.exe" OR process.executable LIKE "%\\WinRAR.exe" OR process.executable LIKE "%\\wevtutil.exe" OR process.executable LIKE "%\\net.exe" OR process.executable LIKE "%\\net1.exe" OR process.executable LIKE "%\\netsh.exe" OR process.executable LIKE "%\\InstallUtil.exe"))))
