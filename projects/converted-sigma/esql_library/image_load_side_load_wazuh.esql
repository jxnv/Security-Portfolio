// Title: Potential Wazuh Security Platform DLL Sideloading
// ID: db77ce78-7e28-4188-9337-cf30e2b3ba9f
// Status: test
// Level: medium
// Author: X__Junior (Nextron Systems)
// Date: 2023-03-13
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL side loading of DLLs that are part of the Wazuh security platform
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((ImageLoaded LIKE "%\\libwazuhshared.dll" OR ImageLoaded LIKE "%\\libwinpthread-1.dll")) AND NOT (((ImageLoaded LIKE "C:\\Program Files\\%" OR ImageLoaded LIKE "C:\\Program Files (x86)\\%"))) AND NOT (((ImageLoaded LIKE "%\\AppData\\Local\\%" OR ImageLoaded LIKE "%\\ProgramData\\%") AND ImageLoaded LIKE "%\\mingw64\\bin\\libwinpthread-1.dll")))
