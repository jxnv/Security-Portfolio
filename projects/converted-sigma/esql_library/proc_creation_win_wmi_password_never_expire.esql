// Title: Password Set to Never Expire via WMI
// ID: 7864a175-3654-4824-9f0d-f0da18ab27c0
// Status: experimental
// Level: medium
// Author: Daniel Koifman (KoifSec)
// Date: 2025-07-30
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1047, attack.t1098
// Description: Detects the use of wmic.exe to modify user account settings and explicitly disable password expiration.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%useraccount%" AND process.command_line LIKE "% set %" AND process.command_line LIKE "%passwordexpires%" AND process.command_line LIKE "%false%")) AND ((process.executable LIKE "%\\wmic.exe") OR (process.pe.original_file_name == "wmic.exe")))
