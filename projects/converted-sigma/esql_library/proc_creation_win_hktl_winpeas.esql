// Title: HackTool - winPEAS Execution
// ID: 98b53e78-ebaf-46f8-be06-421aafd176d9
// Status: test
// Level: high
// Author: Georg Lauenstein (sure[secure])
// Date: 2022-09-19
// Tags: attack.privilege-escalation, attack.discovery, attack.t1082, attack.t1087, attack.t1046
// Description: WinPEAS is a script that search for possible paths to escalate privileges on Windows hosts. The checks are explained on book.hacktricks.xyz
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.command_line LIKE "%https://github.com/carlospolop/PEASS-ng/releases/latest/download/%") OR ((process.command_line LIKE "% applicationsinfo%" OR process.command_line LIKE "% browserinfo%" OR process.command_line LIKE "% eventsinfo%" OR process.command_line LIKE "% fileanalysis%" OR process.command_line LIKE "% filesinfo%" OR process.command_line LIKE "% processinfo%" OR process.command_line LIKE "% servicesinfo%" OR process.command_line LIKE "% windowscreds%")) OR ((process.parent.command_line LIKE "% -linpeas") OR (process.command_line LIKE "% -linpeas")) OR ((process.pe.original_file_name == "winPEAS.exe") OR ((process.executable LIKE "%\\winPEASany_ofs.exe" OR process.executable LIKE "%\\winPEASany.exe" OR process.executable LIKE "%\\winPEASx64_ofs.exe" OR process.executable LIKE "%\\winPEASx64.exe" OR process.executable LIKE "%\\winPEASx86_ofs.exe" OR process.executable LIKE "%\\winPEASx86.exe"))))
