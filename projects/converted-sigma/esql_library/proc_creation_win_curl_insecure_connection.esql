// Title: Insecure Transfer Via Curl.EXE
// ID: cb9cc1d1-e84e-4bdc-b7ad-c31b1b7908ec
// Status: test
// Level: medium
// Author: X__Junior (Nextron Systems)
// Date: 2023-06-30
// Tags: attack.execution
// Description: Detects execution of "curl.exe" with the "--insecure" flag.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line RLIKE "\\s-k\\s") OR (process.command_line LIKE "%--insecure%")) AND ((process.executable LIKE "%\\curl.exe") OR (process.pe.original_file_name == "curl.exe")))
