// Title: VBScript Payload Stored in Registry
// ID: 46490193-1b22-4c29-bdd6-5bf63907216f
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-03-05
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects VBScript content stored into registry keys as seen being used by UNC2452 group
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((registry.path LIKE "%Software\\Microsoft\\Windows\\CurrentVersion%" AND (registry.data.strings LIKE "%vbscript:%" OR registry.data.strings LIKE "%jscript:%" OR registry.data.strings LIKE "%mshtml,%" OR registry.data.strings LIKE "%RunHTMLApplication%" OR registry.data.strings LIKE "%Execute(%" OR registry.data.strings LIKE "%CreateObject%" OR registry.data.strings LIKE "%window.close%")) AND NOT (((registry.path LIKE "%Software\\Microsoft\\Windows\\CurrentVersion\\Run%") OR (process.executable LIKE "%\\msiexec.exe" AND registry.path LIKE "%\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Installer\\UserData\\%" AND (registry.data.strings LIKE "%\\Microsoft.NET\\Primary Interop Assemblies\\Microsoft.mshtml.dll%" OR registry.data.strings LIKE "%<\\Microsoft.mshtml,fileVersion=%" OR registry.data.strings LIKE "%_mshtml_dll_%" OR registry.data.strings LIKE "%<\\Microsoft.mshtml,culture=%")))))
