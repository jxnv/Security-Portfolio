// Title: Renamed PingCastle Binary Execution
// ID: 2433a154-bb3d-42e4-86c3-a26bdac91c45
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2024-01-11
// Tags: attack.execution, attack.stealth, attack.t1059, attack.t1202
// Description: Detects the execution of a renamed "PingCastle" binary based on the PE metadata fields.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.pe.original_file_name == "PingCastleReporting.exe" OR process.pe.original_file_name == "PingCastleCloud.exe" OR process.pe.original_file_name == "PingCastle.exe")) OR ((process.command_line LIKE "%--scanner aclcheck%" OR process.command_line LIKE "%--scanner antivirus%" OR process.command_line LIKE "%--scanner computerversion%" OR process.command_line LIKE "%--scanner foreignusers%" OR process.command_line LIKE "%--scanner laps_bitlocker%" OR process.command_line LIKE "%--scanner localadmin%" OR process.command_line LIKE "%--scanner nullsession%" OR process.command_line LIKE "%--scanner nullsession-trust%" OR process.command_line LIKE "%--scanner oxidbindings%" OR process.command_line LIKE "%--scanner remote%" OR process.command_line LIKE "%--scanner share%" OR process.command_line LIKE "%--scanner smb%" OR process.command_line LIKE "%--scanner smb3querynetwork%" OR process.command_line LIKE "%--scanner spooler%" OR process.command_line LIKE "%--scanner startup%" OR process.command_line LIKE "%--scanner zerologon%")) OR (process.command_line LIKE "%--no-enum-limit%") OR ((process.command_line LIKE "%--healthcheck%" AND process.command_line LIKE "%--level Full%")) OR ((process.command_line LIKE "%--healthcheck%" AND process.command_line LIKE "%--server %"))) AND NOT (((process.executable LIKE "%\\PingCastleReporting.exe" OR process.executable LIKE "%\\PingCastleCloud.exe" OR process.executable LIKE "%\\PingCastle.exe"))))
