// Title: Suspicious SYSTEM User Process Creation
// ID: 2617e7ed-adb7-40ba-b0f3-8f9945fe6c09
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), David ANDRE (additional keywords)
// Date: 2021-12-20
// Tags: attack.credential-access, attack.privilege-escalation, attack.stealth, attack.t1134, attack.t1003, attack.t1027
// Description: Detects a suspicious process creation as SYSTEM user (suspicious program or command line parameter)
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((IntegrityLevel == "System" OR IntegrityLevel == "S-1-16-16384") AND (user.name LIKE "%AUTHORI%" OR user.name LIKE "%AUTORI%")) AND (((process.executable LIKE "%\\calc.exe" OR process.executable LIKE "%\\cscript.exe" OR process.executable LIKE "%\\forfiles.exe" OR process.executable LIKE "%\\hh.exe" OR process.executable LIKE "%\\mshta.exe" OR process.executable LIKE "%\\ping.exe" OR process.executable LIKE "%\\wscript.exe")) OR (process.command_line RLIKE "net\\s+user\\s+") OR ((process.command_line LIKE "% -NoP %" OR process.command_line LIKE "% -W Hidden %" OR process.command_line LIKE "% -decode %" OR process.command_line LIKE "% /decode %" OR process.command_line LIKE "% /urlcache %" OR process.command_line LIKE "% -urlcache %" OR process.command_line LIKE "% -e* JAB%" OR process.command_line LIKE "% -e* SUVYI%" OR process.command_line LIKE "% -e* SQBFAFgA%" OR process.command_line LIKE "% -e* aWV4I%" OR process.command_line LIKE "% -e* IAB%" OR process.command_line LIKE "% -e* PAA%" OR process.command_line LIKE "% -e* aQBlAHgA%" OR process.command_line LIKE "%vssadmin delete shadows%" OR process.command_line LIKE "%reg SAVE HKLM%" OR process.command_line LIKE "% -ma %" OR process.command_line LIKE "%Microsoft\\Windows\\CurrentVersion\\Run%" OR process.command_line LIKE "%.downloadstring(%" OR process.command_line LIKE "%.downloadfile(%" OR process.command_line LIKE "% /ticket:%" OR process.command_line LIKE "%dpapi::%" OR process.command_line LIKE "%event::clear%" OR process.command_line LIKE "%event::drop%" OR process.command_line LIKE "%id::modify%" OR process.command_line LIKE "%kerberos::%" OR process.command_line LIKE "%lsadump::%" OR process.command_line LIKE "%misc::%" OR process.command_line LIKE "%privilege::%" OR process.command_line LIKE "%rpc::%" OR process.command_line LIKE "%sekurlsa::%" OR process.command_line LIKE "%sid::%" OR process.command_line LIKE "%token::%" OR process.command_line LIKE "%vault::cred%" OR process.command_line LIKE "%vault::list%" OR process.command_line LIKE "% p::d %" OR process.command_line LIKE "%;iex(%" OR process.command_line LIKE "%MiniDump%")))) AND NOT (((process.parent.executable LIKE "%:\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\%") OR ((process.parent.executable LIKE "%:\\Program Files (x86)\\Java\\%" OR process.parent.executable LIKE "%:\\Program Files\\Java\\%") AND process.parent.executable LIKE "%\\bin\\javaws.exe" AND (process.executable LIKE "%:\\Program Files (x86)\\Java\\%" OR process.executable LIKE "%:\\Program Files\\Java\\%") AND process.executable LIKE "%\\bin\\jp2launcher.exe" AND process.command_line LIKE "% -ma %") OR ((process.command_line LIKE "%ping%" AND process.command_line LIKE "%127.0.0.1%" AND process.command_line LIKE "% -n %")) OR (process.executable LIKE "%\\PING.EXE" AND process.parent.command_line LIKE "%\\DismFoDInstall.cmd%"))))
