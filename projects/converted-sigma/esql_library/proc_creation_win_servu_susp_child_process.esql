// Title: Suspicious Serv-U Process Pattern
// ID: 58f4ea09-0fc2-4520-ba18-b85c540b0eaf
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-07-14
// Tags: attack.credential-access, attack.t1555, cve.2021-35211
// Description: Detects a suspicious process pattern which could be a sign of an exploited Serv-U service
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (process.parent.executable LIKE "%\\Serv-U.exe" AND (process.executable LIKE "%\\cmd.exe" OR process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe" OR process.executable LIKE "%\\wscript.exe" OR process.executable LIKE "%\\cscript.exe" OR process.executable LIKE "%\\sh.exe" OR process.executable LIKE "%\\bash.exe" OR process.executable LIKE "%\\schtasks.exe" OR process.executable LIKE "%\\regsvr32.exe" OR process.executable LIKE "%\\wmic.exe" OR process.executable LIKE "%\\mshta.exe" OR process.executable LIKE "%\\rundll32.exe" OR process.executable LIKE "%\\msiexec.exe" OR process.executable LIKE "%\\forfiles.exe" OR process.executable LIKE "%\\scriptrunner.exe"))
