// Title: Suspicious Shim Database Patching Activity
// ID: bf344fea-d947-4ef4-9192-34d008315d3a
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-08-01
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.011
// Description: Detects installation of new shim databases that try to patch sections of known processes for potential process injection or persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (registry.path LIKE "%\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\AppCompatFlags\\Custom\\%" AND (registry.path LIKE "%\\csrss.exe" OR registry.path LIKE "%\\dllhost.exe" OR registry.path LIKE "%\\explorer.exe" OR registry.path LIKE "%\\RuntimeBroker.exe" OR registry.path LIKE "%\\services.exe" OR registry.path LIKE "%\\sihost.exe" OR registry.path LIKE "%\\svchost.exe" OR registry.path LIKE "%\\taskhostw.exe" OR registry.path LIKE "%\\winlogon.exe" OR registry.path LIKE "%\\WmiPrvSe.exe"))
