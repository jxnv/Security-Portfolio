// Title: Powershell Defender Disable Scan Feature
// ID: 1ec65a5f-9473-4f12-97da-622044d6df21
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-03
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects requests to disable Microsoft Defender features using PowerShell commands
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.command_line LIKE "%Add-MpPreference %" OR process.command_line LIKE "%Set-MpPreference %")) AND ((process.command_line LIKE "%DisableArchiveScanning %" OR process.command_line LIKE "%DisableRealtimeMonitoring %" OR process.command_line LIKE "%DisableIOAVProtection %" OR process.command_line LIKE "%DisableBehaviorMonitoring %" OR process.command_line LIKE "%DisableBlockAtFirstSeen %" OR process.command_line LIKE "%DisableCatchupFullScan %" OR process.command_line LIKE "%DisableCatchupQuickScan %")) AND ((process.command_line LIKE "%$true%" OR process.command_line LIKE "% 1 %"))) OR (((process.command_line LIKE "%RABpAHMAYQBiAGwAZQBSAGUAYQBsAHQAaQBtAGUATQBvAG4AaQB0AG8AcgBpAG4AZwAgA%" OR process.command_line LIKE "%QAaQBzAGEAYgBsAGUAUgBlAGEAbAB0AGkAbQBlAE0AbwBuAGkAdABvAHIAaQBuAGcAIA%" OR process.command_line LIKE "%EAGkAcwBhAGIAbABlAFIAZQBhAGwAdABpAG0AZQBNAG8AbgBpAHQAbwByAGkAbgBnACAA%" OR process.command_line LIKE "%RABpAHMAYQBiAGwAZQBJAE8AQQBWAFAAcgBvAHQAZQBjAHQAaQBvAG4AIA%" OR process.command_line LIKE "%QAaQBzAGEAYgBsAGUASQBPAEEAVgBQAHIAbwB0AGUAYwB0AGkAbwBuACAA%" OR process.command_line LIKE "%EAGkAcwBhAGIAbABlAEkATwBBAFYAUAByAG8AdABlAGMAdABpAG8AbgAgA%" OR process.command_line LIKE "%RABpAHMAYQBiAGwAZQBCAGUAaABhAHYAaQBvAHIATQBvAG4AaQB0AG8AcgBpAG4AZwAgA%" OR process.command_line LIKE "%QAaQBzAGEAYgBsAGUAQgBlAGgAYQB2AGkAbwByAE0AbwBuAGkAdABvAHIAaQBuAGcAIA%" OR process.command_line LIKE "%EAGkAcwBhAGIAbABlAEIAZQBoAGEAdgBpAG8AcgBNAG8AbgBpAHQAbwByAGkAbgBnACAA%" OR process.command_line LIKE "%RABpAHMAYQBiAGwAZQBCAGwAbwBjAGsAQQB0AEYAaQByAHMAdABTAGUAZQBuACAA%" OR process.command_line LIKE "%QAaQBzAGEAYgBsAGUAQgBsAG8AYwBrAEEAdABGAGkAcgBzAHQAUwBlAGUAbgAgA%" OR process.command_line LIKE "%EAGkAcwBhAGIAbABlAEIAbABvAGMAawBBAHQARgBpAHIAcwB0AFMAZQBlAG4AIA%" OR process.command_line LIKE "%ZABpAHMAYQBiAGwAZQByAGUAYQBsAHQAaQBtAGUAbQBvAG4AaQB0AG8AcgBpAG4AZwAgA%" OR process.command_line LIKE "%QAaQBzAGEAYgBsAGUAcgBlAGEAbAB0AGkAbQBlAG0AbwBuAGkAdABvAHIAaQBuAGcAIA%" OR process.command_line LIKE "%kAGkAcwBhAGIAbABlAHIAZQBhAGwAdABpAG0AZQBtAG8AbgBpAHQAbwByAGkAbgBnACAA%" OR process.command_line LIKE "%ZABpAHMAYQBiAGwAZQBpAG8AYQB2AHAAcgBvAHQAZQBjAHQAaQBvAG4AIA%" OR process.command_line LIKE "%QAaQBzAGEAYgBsAGUAaQBvAGEAdgBwAHIAbwB0AGUAYwB0AGkAbwBuACAA%" OR process.command_line LIKE "%kAGkAcwBhAGIAbABlAGkAbwBhAHYAcAByAG8AdABlAGMAdABpAG8AbgAgA%" OR process.command_line LIKE "%ZABpAHMAYQBiAGwAZQBiAGUAaABhAHYAaQBvAHIAbQBvAG4AaQB0AG8AcgBpAG4AZwAgA%" OR process.command_line LIKE "%QAaQBzAGEAYgBsAGUAYgBlAGgAYQB2AGkAbwByAG0AbwBuAGkAdABvAHIAaQBuAGcAIA%" OR process.command_line LIKE "%kAGkAcwBhAGIAbABlAGIAZQBoAGEAdgBpAG8AcgBtAG8AbgBpAHQAbwByAGkAbgBnACAA%" OR process.command_line LIKE "%ZABpAHMAYQBiAGwAZQBiAGwAbwBjAGsAYQB0AGYAaQByAHMAdABzAGUAZQBuACAA%" OR process.command_line LIKE "%QAaQBzAGEAYgBsAGUAYgBsAG8AYwBrAGEAdABmAGkAcgBzAHQAcwBlAGUAbgAgA%" OR process.command_line LIKE "%kAGkAcwBhAGIAbABlAGIAbABvAGMAawBhAHQAZgBpAHIAcwB0AHMAZQBlAG4AIA%" OR process.command_line LIKE "%RABpAHMAYQBiAGwAZQBDAGEAdABjAGgAdQBwAEYAdQBsAGwAUwBjAGEAbgA%" OR process.command_line LIKE "%RABpAHMAYQBiAGwAZQBDAGEAdABjAGgAdQBwAFEAdQBpAGMAawBTAGMAYQBuAA%" OR process.command_line LIKE "%RABpAHMAYQBiAGwAZQBBAHIAYwBoAGkAdgBlAFMAYwBhAG4AbgBpAG4AZwA%")) OR ((process.command_line LIKE "%ZGlzYWJsZWFyY2hpdmVzY2FubmluZy%" OR process.command_line LIKE "%Rpc2FibGVhcmNoaXZlc2Nhbm5pbmcg%" OR process.command_line LIKE "%kaXNhYmxlYXJjaGl2ZXNjYW5uaW5nI%" OR process.command_line LIKE "%RGlzYWJsZUFyY2hpdmVTY2FubmluZy%" OR process.command_line LIKE "%Rpc2FibGVBcmNoaXZlU2Nhbm5pbmcg%" OR process.command_line LIKE "%EaXNhYmxlQXJjaGl2ZVNjYW5uaW5nI%" OR process.command_line LIKE "%ZGlzYWJsZWJlaGF2aW9ybW9uaXRvcmluZy%" OR process.command_line LIKE "%Rpc2FibGViZWhhdmlvcm1vbml0b3Jpbmcg%" OR process.command_line LIKE "%kaXNhYmxlYmVoYXZpb3Jtb25pdG9yaW5nI%" OR process.command_line LIKE "%RGlzYWJsZUJlaGF2aW9yTW9uaXRvcmluZy%" OR process.command_line LIKE "%Rpc2FibGVCZWhhdmlvck1vbml0b3Jpbmcg%" OR process.command_line LIKE "%EaXNhYmxlQmVoYXZpb3JNb25pdG9yaW5nI%" OR process.command_line LIKE "%ZGlzYWJsZWJsb2NrYXRmaXJzdHNlZW4g%" OR process.command_line LIKE "%Rpc2FibGVibG9ja2F0Zmlyc3RzZWVuI%" OR process.command_line LIKE "%kaXNhYmxlYmxvY2thdGZpcnN0c2Vlbi%" OR process.command_line LIKE "%RGlzYWJsZUJsb2NrQXRGaXJzdFNlZW4g%" OR process.command_line LIKE "%Rpc2FibGVCbG9ja0F0Rmlyc3RTZWVuI%" OR process.command_line LIKE "%EaXNhYmxlQmxvY2tBdEZpcnN0U2Vlbi%" OR process.command_line LIKE "%ZGlzYWJsZWNhdGNodXBmdWxsc2Nhbi%" OR process.command_line LIKE "%Rpc2FibGVjYXRjaHVwZnVsbHNjYW4g%" OR process.command_line LIKE "%kaXNhYmxlY2F0Y2h1cGZ1bGxzY2FuI%" OR process.command_line LIKE "%RGlzYWJsZUNhdGNodXBGdWxsU2Nhbi%" OR process.command_line LIKE "%Rpc2FibGVDYXRjaHVwRnVsbFNjYW4g%" OR process.command_line LIKE "%EaXNhYmxlQ2F0Y2h1cEZ1bGxTY2FuI%" OR process.command_line LIKE "%ZGlzYWJsZWNhdGNodXBxdWlja3NjYW4g%" OR process.command_line LIKE "%Rpc2FibGVjYXRjaHVwcXVpY2tzY2FuI%" OR process.command_line LIKE "%kaXNhYmxlY2F0Y2h1cHF1aWNrc2Nhbi%" OR process.command_line LIKE "%RGlzYWJsZUNhdGNodXBRdWlja1NjYW4g%" OR process.command_line LIKE "%Rpc2FibGVDYXRjaHVwUXVpY2tTY2FuI%" OR process.command_line LIKE "%EaXNhYmxlQ2F0Y2h1cFF1aWNrU2Nhbi%" OR process.command_line LIKE "%ZGlzYWJsZWlvYXZwcm90ZWN0aW9uI%" OR process.command_line LIKE "%Rpc2FibGVpb2F2cHJvdGVjdGlvbi%" OR process.command_line LIKE "%kaXNhYmxlaW9hdnByb3RlY3Rpb24g%" OR process.command_line LIKE "%RGlzYWJsZUlPQVZQcm90ZWN0aW9uI%" OR process.command_line LIKE "%Rpc2FibGVJT0FWUHJvdGVjdGlvbi%" OR process.command_line LIKE "%EaXNhYmxlSU9BVlByb3RlY3Rpb24g%" OR process.command_line LIKE "%ZGlzYWJsZXJlYWx0aW1lbW9uaXRvcmluZy%" OR process.command_line LIKE "%Rpc2FibGVyZWFsdGltZW1vbml0b3Jpbmcg%" OR process.command_line LIKE "%kaXNhYmxlcmVhbHRpbWVtb25pdG9yaW5nI%" OR process.command_line LIKE "%RGlzYWJsZVJlYWx0aW1lTW9uaXRvcmluZy%" OR process.command_line LIKE "%Rpc2FibGVSZWFsdGltZU1vbml0b3Jpbmcg%" OR process.command_line LIKE "%EaXNhYmxlUmVhbHRpbWVNb25pdG9yaW5nI%"))))
