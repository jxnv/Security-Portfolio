// Title: Potential Persistence Via Netsh Helper DLL - Registry
// ID: c90362e0-2df3-4e61-94fe-b37615814cb1
// Status: test
// Level: medium
// Author: Anish Bogati
// Date: 2023-11-28
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.007
// Description: Detects changes to the Netsh registry key to add a new DLL value. This change might be an indication of a potential persistence attempt by adding a malicious Netsh helper
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((registry.path LIKE "%\\SOFTWARE\\Microsoft\\NetSh%" AND registry.data.strings LIKE "%.dll%") AND NOT ((process.executable == "C:\\Windows\\System32\\poqexec.exe" AND (registry.data.strings == "ipmontr.dll" OR registry.data.strings == "iasmontr.dll" OR registry.data.strings == "ippromon.dll"))))
