// Title: Suspicious MSDT Parent Process
// ID: 7a74da6b-ea76-47db-92cc-874ad90df734
// Status: test
// Level: high
// Author: Nextron Systems
// Date: 2022-06-01
// Tags: attack.stealth, attack.t1036, attack.t1218
// Description: Detects msdt.exe executed by a suspicious parent as seen in CVE-2022-30190 / Follina exploitation
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%\\msdt.exe") OR (process.pe.original_file_name == "msdt.exe")) AND ((process.parent.executable LIKE "%\\cmd.exe" OR process.parent.executable LIKE "%\\cscript.exe" OR process.parent.executable LIKE "%\\mshta.exe" OR process.parent.executable LIKE "%\\powershell.exe" OR process.parent.executable LIKE "%\\pwsh.exe" OR process.parent.executable LIKE "%\\regsvr32.exe" OR process.parent.executable LIKE "%\\rundll32.exe" OR process.parent.executable LIKE "%\\schtasks.exe" OR process.parent.executable LIKE "%\\wmic.exe" OR process.parent.executable LIKE "%\\wscript.exe" OR process.parent.executable LIKE "%\\wsl.exe")))
