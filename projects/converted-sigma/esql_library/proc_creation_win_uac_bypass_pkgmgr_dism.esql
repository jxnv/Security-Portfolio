// Title: UAC Bypass Using PkgMgr and DISM
// ID: a743ceba-c771-4d75-97eb-8a90f7f4844c
// Status: test
// Level: high
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-08-23
// Tags: attack.privilege-escalation, attack.t1548.002
// Description: Detects the pattern of UAC Bypass using pkgmgr.exe and dism.exe (UACMe 23)
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (process.parent.executable LIKE "%\\pkgmgr.exe" AND process.executable LIKE "%\\dism.exe" AND (IntegrityLevel == "High" OR IntegrityLevel == "System" OR IntegrityLevel == "S-1-16-16384" OR IntegrityLevel == "S-1-16-12288"))
