// Title: Renamed ProcDump Execution
// ID: 4a0b2c7e-7cb2-495d-8b63-5f268e7bfd67
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-11-18
// Tags: attack.stealth, attack.t1036.003
// Description: Detects the execution of a renamed ProcDump executable.
// This often done by attackers or malware in order to evade defensive mechanisms.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.pe.original_file_name == "procdump") OR (((process.command_line LIKE "% -ma %" OR process.command_line LIKE "% -mp %")) AND (process.command_line LIKE "% /accepteula%"))) AND NOT (((process.executable LIKE "%\\procdump.exe" OR process.executable LIKE "%\\procdump64.exe" OR process.executable LIKE "%\\procdump64a.exe"))))
