// Title: Python Reverse Shell Execution Via PTY And Socket Modules
// ID: 32e62bc7-3de0-4bb1-90af-532978fe42c0
// Status: test
// Level: high
// Author: @d4ns4n_, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-24
// Tags: attack.execution
// Description: Detects the execution of python with calls to the socket and pty module in order to connect and spawn a potential reverse shell.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (process.executable LIKE "%python%" AND (process.command_line LIKE "% -c %" AND process.command_line LIKE "%import%" AND process.command_line LIKE "%pty%" AND process.command_line LIKE "%socket%" AND process.command_line LIKE "%spawn%" AND process.command_line LIKE "%.connect%"))
