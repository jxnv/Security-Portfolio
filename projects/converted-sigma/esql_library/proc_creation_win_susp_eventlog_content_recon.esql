// Title: Potentially Suspicious EventLog Recon Activity Using Log Query Utilities
// ID: beaa66d6-aa1b-4e3c-80f5-e0145369bfaf
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.credential-access, attack.discovery, attack.t1552, attack.t1087
// Description: Detects execution of different log query utilities and commands to search and dump the content of specific event logs or look for specific event IDs.
// This technique is used by threat actors in order to extract sensitive information from events logs such as usernames, IP addresses, hostnames, etc.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.command_line LIKE "%-InstanceId 462?%" OR process.command_line LIKE "%.eventid -eq 462?%" OR process.command_line LIKE "%.ID -eq 462?%" OR process.command_line LIKE "%EventCode=?462?%" OR process.command_line LIKE "%EventIdentifier=?462?%" OR process.command_line LIKE "%System[EventID=462?]%" OR process.command_line LIKE "%-InstanceId 4778%" OR process.command_line LIKE "%.eventid -eq 4778%" OR process.command_line LIKE "%.ID -eq 4778%" OR process.command_line LIKE "%EventCode=?4778?%" OR process.command_line LIKE "%EventIdentifier=?4778?%" OR process.command_line LIKE "%System[EventID=4778]%" OR process.command_line LIKE "%-InstanceId 25%" OR process.command_line LIKE "%.eventid -eq 25%" OR process.command_line LIKE "%.ID -eq 25%" OR process.command_line LIKE "%EventCode=?25?%" OR process.command_line LIKE "%EventIdentifier=?25?%" OR process.command_line LIKE "%System[EventID=25]%" OR process.command_line LIKE "%-InstanceId 1149%" OR process.command_line LIKE "%.eventid -eq 1149%" OR process.command_line LIKE "%.ID -eq 1149%" OR process.command_line LIKE "%EventCode=?1149?%" OR process.command_line LIKE "%EventIdentifier=?1149?%" OR process.command_line LIKE "%System[EventID=1149]%" OR process.command_line LIKE "%-InstanceId 21%" OR process.command_line LIKE "%.eventid -eq 21%" OR process.command_line LIKE "%.ID -eq 21%" OR process.command_line LIKE "%EventCode=?21?%" OR process.command_line LIKE "%EventIdentifier=?21?%" OR process.command_line LIKE "%System[EventID=21]%" OR process.command_line LIKE "%-InstanceId 22%" OR process.command_line LIKE "%.eventid -eq 22%" OR process.command_line LIKE "%.ID -eq 22%" OR process.command_line LIKE "%EventCode=?22?%" OR process.command_line LIKE "%EventIdentifier=?22?%" OR process.command_line LIKE "%System[EventID=22]%")) OR ((process.command_line LIKE "%Microsoft-Windows-PowerShell%" OR process.command_line LIKE "%Microsoft-Windows-Security-Auditing%" OR process.command_line LIKE "%Microsoft-Windows-TerminalServices-LocalSessionManager%" OR process.command_line LIKE "%Microsoft-Windows-TerminalServices-RemoteConnectionManager%" OR process.command_line LIKE "%Microsoft-Windows-Windows Defender%" OR process.command_line LIKE "%PowerShellCore%" OR process.command_line LIKE "%Security%" OR process.command_line LIKE "%Windows PowerShell%"))) AND (((process.command_line LIKE "%Select%" AND process.command_line LIKE "%Win32_NTLogEvent%")) OR (((process.command_line LIKE "% qe %" OR process.command_line LIKE "% query-events %")) AND ((process.executable LIKE "%\\wevtutil.exe") OR (process.pe.original_file_name == "wevtutil.exe"))) OR ((process.command_line LIKE "% ntevent%") AND ((process.executable LIKE "%\\wmic.exe") OR (process.pe.original_file_name == "wmic.exe"))) OR ((process.command_line LIKE "%Get-WinEvent %" OR process.command_line LIKE "%get-eventlog %"))))
