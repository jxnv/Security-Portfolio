// Title: File Download From Browser Process Via Inline URL
// ID: 94771a71-ba41-4b6e-a757-b531372eaab6
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-11
// Tags: attack.command-and-control, attack.t1105
// Description: Detects execution of a browser process with a URL argument pointing to a file with a potentially interesting extension. This can be abused to download arbitrary files or to hide from the user for example by launching the browser in a minimized state.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.command_line LIKE "%.7z" OR process.command_line LIKE "%.dat" OR process.command_line LIKE "%.dll" OR process.command_line LIKE "%.exe" OR process.command_line LIKE "%.hta" OR process.command_line LIKE "%.ps1" OR process.command_line LIKE "%.psm1" OR process.command_line LIKE "%.txt" OR process.command_line LIKE "%.vbe" OR process.command_line LIKE "%.vbs" OR process.command_line LIKE "%.zip")) OR ((process.command_line LIKE "%.7z\"%" OR process.command_line LIKE "%.dat\"%" OR process.command_line LIKE "%.dll\"%" OR process.command_line LIKE "%.hta\"%" OR process.command_line LIKE "%.ps1\"%" OR process.command_line LIKE "%.psm1\"%" OR process.command_line LIKE "%.txt\"%" OR process.command_line LIKE "%.vbe\"%" OR process.command_line LIKE "%.vbs\"%" OR process.command_line LIKE "%.zip\"%"))) AND (process.command_line LIKE "%http%") AND ((process.executable LIKE "%\\brave.exe" OR process.executable LIKE "%\\chrome.exe" OR process.executable LIKE "%\\msedge.exe" OR process.executable LIKE "%\\opera.exe" OR process.executable LIKE "%\\vivaldi.exe")))
