// Title: Suspicious Windows Defender Registry Key Tampering Via Reg.EXE
// ID: 452bce90-6fb0-43cc-97a5-affc283139b3
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Swachchhanda Shrawan Poudel, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-03-22
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects the usage of "reg.exe" to tamper with different Windows Defender registry keys in order to disable some important features related to protection and detection
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.executable LIKE "%\\reg.exe") OR (process.pe.original_file_name == "reg.exe")) AND ((process.command_line LIKE "%SOFTWARE\\Microsoft\\Windows Defender\\%" OR process.command_line LIKE "%SOFTWARE\\Policies\\Microsoft\\Windows Defender Security Center%" OR process.command_line LIKE "%SOFTWARE\\Policies\\Microsoft\\Windows Defender\\%"))) AND (((process.command_line LIKE "% add %" AND process.command_line LIKE "%d 0%") AND (process.command_line LIKE "%DisallowExploitProtectionOverride%" OR process.command_line LIKE "%EnableControlledFolderAccess%" OR process.command_line LIKE "%MpEnablePus%" OR process.command_line LIKE "%PUAProtection%" OR process.command_line LIKE "%SpynetReporting%" OR process.command_line LIKE "%SubmitSamplesConsent%" OR process.command_line LIKE "%TamperProtection%")) OR ((process.command_line LIKE "% add %" AND process.command_line LIKE "%d 1%") AND (process.command_line LIKE "%DisableAccess%" OR process.command_line LIKE "%DisableAntiSpyware%" OR process.command_line LIKE "%DisableAntiSpywareRealtimeProtection%" OR process.command_line LIKE "%DisableAntiVirus%" OR process.command_line LIKE "%DisableAntiVirusSignatures%" OR process.command_line LIKE "%DisableArchiveScanning%" OR process.command_line LIKE "%DisableBehaviorMonitoring%" OR process.command_line LIKE "%DisableBlockAtFirstSeen%" OR process.command_line LIKE "%DisableCloudProtection%" OR process.command_line LIKE "%DisableConfig%" OR process.command_line LIKE "%DisableEnhancedNotifications%" OR process.command_line LIKE "%DisableIntrusionPreventionSystem%" OR process.command_line LIKE "%DisableIOAVProtection%" OR process.command_line LIKE "%DisableNetworkProtection%" OR process.command_line LIKE "%DisableOnAccessProtection%" OR process.command_line LIKE "%DisablePrivacyMode%" OR process.command_line LIKE "%DisableRealtimeMonitoring%" OR process.command_line LIKE "%DisableRoutinelyTakingAction%" OR process.command_line LIKE "%DisableScanOnRealtimeEnable%" OR process.command_line LIKE "%DisableScriptScanning%" OR process.command_line LIKE "%DisableSecurityCenter%" OR process.command_line LIKE "%Notification_Suppress%" OR process.command_line LIKE "%SignatureDisableUpdateOnStartupWithoutEngine%"))))
