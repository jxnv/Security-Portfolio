// Title: Shell32 DLL Execution in Suspicious Directory
// ID: 32b96012-7892-429e-b26c-ac2bf46066ff
// Status: test
// Level: high
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-11-24
// Tags: attack.execution, attack.stealth, attack.t1218.011
// Description: Detects shell32.dll executing a DLL in a suspicious directory
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%shell32.dll%" AND process.command_line LIKE "%Control_RunDLL%") AND (process.command_line LIKE "%%AppData%%" OR process.command_line LIKE "%%LocalAppData%%" OR process.command_line LIKE "%%Temp%%" OR process.command_line LIKE "%%tmp%%" OR process.command_line LIKE "%\\AppData\\%" OR process.command_line LIKE "%\\Temp\\%" OR process.command_line LIKE "%\\Users\\Public\\%")) AND ((process.executable LIKE "%\\rundll32.exe") OR (process.pe.original_file_name == "RUNDLL32.EXE")))
