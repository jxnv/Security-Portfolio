// Title: Use of W32tm as Timer
// ID: 6da2c9f5-7c53-401b-aacb-92c040ce1215
// Status: test
// Level: high
// Author: frack113
// Date: 2022-09-25
// Tags: attack.discovery, attack.t1124
// Description: When configured with suitable command line arguments, w32tm can act as a delay mechanism
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%/stripchart%" AND process.command_line LIKE "%/computer:%" AND process.command_line LIKE "%/period:%" AND process.command_line LIKE "%/dataonly%" AND process.command_line LIKE "%/samples:%")) AND ((process.executable LIKE "%\\w32tm.exe") OR (process.pe.original_file_name == "w32time.dll")))
