// Title: CobaltStrike Named Pipe Pattern Regex
// ID: 0e7163d4-9e19-4fa7-9be6-000c61aad77a
// Status: test
// Level: critical
// Author: Florian Roth (Nextron Systems)
// Date: 2021-07-30
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects the creation of a named pipe matching a pattern used by CobaltStrike Malleable C2 profiles
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((PipeName RLIKE "\\\\mojo\\.5688\\.8052\\.(?:183894939787088877|35780273329370473)[0-9a-f]{2}") OR (PipeName RLIKE "\\\\wkssvc_?[0-9a-f]{2}") OR (PipeName RLIKE "\\\\ntsvcs[0-9a-f]{2}") OR (PipeName RLIKE "\\\\DserNamePipe[0-9a-f]{2}") OR (PipeName RLIKE "\\\\SearchTextHarvester[0-9a-f]{2}") OR (PipeName RLIKE "\\\\mypipe-(?:f|h)[0-9a-f]{2}") OR (PipeName RLIKE "\\\\windows\\.update\\.manager[0-9a-f]{2,3}") OR (PipeName RLIKE "\\\\ntsvcs_[0-9a-f]{2}") OR (PipeName RLIKE "\\\\scerpc_?[0-9a-f]{2}") OR (PipeName RLIKE "\\\\PGMessagePipe[0-9a-f]{2}") OR (PipeName RLIKE "\\\\MsFteWds[0-9a-f]{2}") OR (PipeName RLIKE "\\\\f4c3[0-9a-f]{2}") OR (PipeName RLIKE "\\\\fullduplex_[0-9a-f]{2}") OR (PipeName RLIKE "\\\\msrpc_[0-9a-f]{4}") OR (PipeName RLIKE "\\\\win\\\\msrpc_[0-9a-f]{2}") OR (PipeName RLIKE "\\\\f53f[0-9a-f]{2}$") OR (PipeName RLIKE "\\\\rpc_[0-9a-f]{2}") OR (PipeName RLIKE "\\\\spoolss_[0-9a-f]{2}") OR (PipeName RLIKE "\\\\Winsock2\\\\CatalogChangeListener-[0-9a-f]{3}-0,"))
