// Title: HackTool - CrackMapExec Process Patterns
// ID: f26307d8-14cd-47e3-a26b-4b4769f24af6
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-12
// Tags: attack.credential-access, attack.t1003.001
// Description: Detects suspicious process patterns found in logs when CrackMapExec is used
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%tasklist /fi %" AND process.command_line LIKE "%Imagename eq lsass.exe%") AND (process.command_line LIKE "%cmd.exe /c %" OR process.command_line LIKE "%cmd.exe /r %" OR process.command_line LIKE "%cmd.exe /k %" OR process.command_line LIKE "%cmd /c %" OR process.command_line LIKE "%cmd /r %" OR process.command_line LIKE "%cmd /k %") AND (user.name LIKE "%AUTHORI%" OR user.name LIKE "%AUTORI%")) OR ((process.command_line LIKE "%do rundll32.exe C:\\windows\\System32\\comsvcs.dll, MiniDump%" AND process.command_line LIKE "%\\Windows\\Temp\\%" AND process.command_line LIKE "% full%" AND process.command_line LIKE "%%%B%")) OR ((process.command_line LIKE "%tasklist /v /fo csv%" AND process.command_line LIKE "%findstr /i \"lsass\"%")))
