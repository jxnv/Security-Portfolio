// Title: File Download Via Bitsadmin To A Suspicious Target Folder
// ID: 2ddef153-167b-4e89-86b6-757a9e65dcac
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-28
// Tags: attack.persistence, attack.execution, attack.stealth, attack.t1197, attack.s0190, attack.t1036.003, attack.command-and-control, attack.t1105
// Description: Detects usage of bitsadmin downloading a file to a suspicious target folder
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "% /transfer %" OR process.command_line LIKE "% /create %" OR process.command_line LIKE "% /addfile %")) AND ((process.command_line LIKE "%:\\Perflogs%" OR process.command_line LIKE "%:\\ProgramData\\%" OR process.command_line LIKE "%:\\Temp\\%" OR process.command_line LIKE "%:\\Users\\Public\\%" OR process.command_line LIKE "%:\\Windows\\%" OR process.command_line LIKE "%\\$Recycle.Bin\\%" OR process.command_line LIKE "%\\AppData\\Local\\%" OR process.command_line LIKE "%\\AppData\\Roaming\\%" OR process.command_line LIKE "%\\Contacts\\%" OR process.command_line LIKE "%\\Desktop\\%" OR process.command_line LIKE "%\\Favorites\\%" OR process.command_line LIKE "%\\Favourites\\%" OR process.command_line LIKE "%\\inetpub\\wwwroot\\%" OR process.command_line LIKE "%\\Music\\%" OR process.command_line LIKE "%\\Pictures\\%" OR process.command_line LIKE "%\\Start Menu\\Programs\\Startup\\%" OR process.command_line LIKE "%\\Users\\Default\\%" OR process.command_line LIKE "%\\Videos\\%" OR process.command_line LIKE "%%ProgramData%%" OR process.command_line LIKE "%%public%%" OR process.command_line LIKE "%%temp%%" OR process.command_line LIKE "%%tmp%%")) AND ((process.executable LIKE "%\\bitsadmin.exe") OR (process.pe.original_file_name == "bitsadmin.exe")))
