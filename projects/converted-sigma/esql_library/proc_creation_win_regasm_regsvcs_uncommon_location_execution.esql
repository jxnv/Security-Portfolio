// Title: Potentially Suspicious Execution Of Regasm/Regsvcs From Uncommon Location
// ID: cc368ed0-2411-45dc-a222-510ace303cb2
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-25
// Tags: attack.stealth, attack.t1218.009
// Description: Detects potentially suspicious execution of the Regasm/Regsvcs utilities from a potentially suspicious location
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%\\AppData\\Local\\Temp\\%" OR process.command_line LIKE "%\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\%" OR process.command_line LIKE "%\\PerfLogs\\%" OR process.command_line LIKE "%\\Users\\Public\\%" OR process.command_line LIKE "%\\Windows\\Temp\\%")) AND (((process.executable LIKE "%\\Regsvcs.exe" OR process.executable LIKE "%\\Regasm.exe")) OR ((process.pe.original_file_name == "RegSvcs.exe" OR process.pe.original_file_name == "RegAsm.exe"))))
