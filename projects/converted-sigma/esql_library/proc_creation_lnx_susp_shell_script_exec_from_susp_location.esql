// Title: Execution Of Script Located In Potentially Suspicious Directory
// ID: 30bcce26-51c5-49f2-99c8-7b59e3af36c7
// Status: test
// Level: medium
// Author: Joseliyo Sanchez, @Joseliyo_Jstnk
// Date: 2023-06-02
// Tags: attack.execution
// Description: Detects executions of scripts located in potentially suspicious locations such as "/tmp" via a shell such as "bash", "sh", etc.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.command_line LIKE "% -c %") AND ((process.executable LIKE "%/bash" OR process.executable LIKE "%/csh" OR process.executable LIKE "%/dash" OR process.executable LIKE "%/fish" OR process.executable LIKE "%/ksh" OR process.executable LIKE "%/sh" OR process.executable LIKE "%/zsh")) AND (process.command_line LIKE "%/tmp/%"))
