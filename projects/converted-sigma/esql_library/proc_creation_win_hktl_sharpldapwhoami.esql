// Title: HackTool - SharpLdapWhoami Execution
// ID: d9367cbb-c2e0-47ce-bdc0-128cb6da898d
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-08-29
// Tags: attack.discovery, attack.t1033, car.2016-03-001
// Description: Detects SharpLdapWhoami, a whoami alternative that queries the LDAP service on a domain controller
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "% /method:ntlm" OR process.command_line LIKE "% /method:kerb" OR process.command_line LIKE "% /method:nego" OR process.command_line LIKE "% /m:nego" OR process.command_line LIKE "% /m:ntlm" OR process.command_line LIKE "% /m:kerb")) OR (process.executable LIKE "%\\SharpLdapWhoami.exe") OR ((process.pe.original_file_name LIKE "%SharpLdapWhoami%") OR (Product == "SharpLdapWhoami")))
