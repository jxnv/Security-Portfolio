// Title: HackTool - Generic Process Access
// ID: d0d2f720-d14f-448d-8242-51ff396a334e
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Swachchhanda Shrawan Poudel
// Date: 2023-11-27
// Tags: attack.credential-access, attack.t1003.001, attack.s0002
// Description: Detects process access requests from hacktool processes based on their default image name
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((SourceImage LIKE "%\\Akagi.exe" OR SourceImage LIKE "%\\Akagi64.exe" OR SourceImage LIKE "%\\atexec_windows.exe" OR SourceImage LIKE "%\\Certify.exe" OR SourceImage LIKE "%\\Certipy.exe" OR SourceImage LIKE "%\\CoercedPotato.exe" OR SourceImage LIKE "%\\crackmapexec.exe" OR SourceImage LIKE "%\\CreateMiniDump.exe" OR SourceImage LIKE "%\\dcomexec_windows.exe" OR SourceImage LIKE "%\\dpapi_windows.exe" OR SourceImage LIKE "%\\findDelegation_windows.exe" OR SourceImage LIKE "%\\GetADUsers_windows.exe" OR SourceImage LIKE "%\\GetNPUsers_windows.exe" OR SourceImage LIKE "%\\getPac_windows.exe" OR SourceImage LIKE "%\\getST_windows.exe" OR SourceImage LIKE "%\\getTGT_windows.exe" OR SourceImage LIKE "%\\GetUserSPNs_windows.exe" OR SourceImage LIKE "%\\gmer.exe" OR SourceImage LIKE "%\\hashcat.exe" OR SourceImage LIKE "%\\htran.exe" OR SourceImage LIKE "%\\ifmap_windows.exe" OR SourceImage LIKE "%\\impersonate.exe" OR SourceImage LIKE "%\\Inveigh.exe" OR SourceImage LIKE "%\\LocalPotato.exe" OR SourceImage LIKE "%\\mimikatz_windows.exe" OR SourceImage LIKE "%\\mimikatz.exe" OR SourceImage LIKE "%\\netview_windows.exe" OR SourceImage LIKE "%\\nmapAnswerMachine_windows.exe" OR SourceImage LIKE "%\\opdump_windows.exe" OR SourceImage LIKE "%\\PasswordDump.exe" OR SourceImage LIKE "%\\Potato.exe" OR SourceImage LIKE "%\\PowerTool.exe" OR SourceImage LIKE "%\\PowerTool64.exe" OR SourceImage LIKE "%\\psexec_windows.exe" OR SourceImage LIKE "%\\PurpleSharp.exe" OR SourceImage LIKE "%\\pypykatz.exe" OR SourceImage LIKE "%\\QuarksPwDump.exe" OR SourceImage LIKE "%\\rdp_check_windows.exe" OR SourceImage LIKE "%\\Rubeus.exe" OR SourceImage LIKE "%\\SafetyKatz.exe" OR SourceImage LIKE "%\\sambaPipe_windows.exe" OR SourceImage LIKE "%\\SelectMyParent.exe" OR SourceImage LIKE "%\\SharpChisel.exe" OR SourceImage LIKE "%\\SharPersist.exe" OR SourceImage LIKE "%\\SharpEvtMute.exe" OR SourceImage LIKE "%\\SharpImpersonation.exe" OR SourceImage LIKE "%\\SharpLDAPmonitor.exe" OR SourceImage LIKE "%\\SharpLdapWhoami.exe" OR SourceImage LIKE "%\\SharpUp.exe" OR SourceImage LIKE "%\\SharpView.exe" OR SourceImage LIKE "%\\smbclient_windows.exe" OR SourceImage LIKE "%\\smbserver_windows.exe" OR SourceImage LIKE "%\\sniff_windows.exe" OR SourceImage LIKE "%\\sniffer_windows.exe" OR SourceImage LIKE "%\\split_windows.exe" OR SourceImage LIKE "%\\SpoolSample.exe" OR SourceImage LIKE "%\\Stracciatella.exe" OR SourceImage LIKE "%\\SysmonEOP.exe" OR SourceImage LIKE "%\\temp\\rot.exe" OR SourceImage LIKE "%\\ticketer_windows.exe" OR SourceImage LIKE "%\\TruffleSnout.exe" OR SourceImage LIKE "%\\winPEASany_ofs.exe" OR SourceImage LIKE "%\\winPEASany.exe" OR SourceImage LIKE "%\\winPEASx64_ofs.exe" OR SourceImage LIKE "%\\winPEASx64.exe" OR SourceImage LIKE "%\\winPEASx86_ofs.exe" OR SourceImage LIKE "%\\winPEASx86.exe" OR SourceImage LIKE "%\\xordump.exe")) OR ((SourceImage LIKE "%\\goldenPac%" OR SourceImage LIKE "%\\just_dce_%" OR SourceImage LIKE "%\\karmaSMB%" OR SourceImage LIKE "%\\kintercept%" OR SourceImage LIKE "%\\LocalPotato%" OR SourceImage LIKE "%\\ntlmrelayx%" OR SourceImage LIKE "%\\rpcdump%" OR SourceImage LIKE "%\\samrdump%" OR SourceImage LIKE "%\\secretsdump%" OR SourceImage LIKE "%\\smbexec%" OR SourceImage LIKE "%\\smbrelayx%" OR SourceImage LIKE "%\\wmiexec%" OR SourceImage LIKE "%\\wmipersist%" OR SourceImage LIKE "%HotPotato%" OR SourceImage LIKE "%Juicy Potato%" OR SourceImage LIKE "%JuicyPotato%" OR SourceImage LIKE "%PetitPotam%" OR SourceImage LIKE "%RottenPotato%")))
