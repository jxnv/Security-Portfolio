// Title: Suspicious Printer Driver Empty Manufacturer
// ID: e0813366-0407-449a-9869-a2db1119dc41
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2020-07-01
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574, cve.2021-1675
// Description: Detects a suspicious printer driver installation with an empty Manufacturer value
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((registry.path LIKE "%\\Control\\Print\\Environments\\Windows x64\\Drivers%" AND registry.path LIKE "%\\Manufacturer%") AND registry.data.strings == "(Empty)") AND NOT (((registry.path LIKE "%\\CutePDF Writer v4.0\\%") OR (registry.path LIKE "%\\Version-3\\PDF24\\%") OR ((registry.path LIKE "%\\VNC Printer (PS)\\%" OR registry.path LIKE "%\\VNC Printer (UD)\\%")))))
