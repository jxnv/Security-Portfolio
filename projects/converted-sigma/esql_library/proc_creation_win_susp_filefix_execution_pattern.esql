// Title: Suspicious FileFix Execution Pattern
// ID: b5b29e4e-31fa-4fdf-b058-296e7a1aa0c2
// Status: experimental
// Level: high
// Author: 0xFustang, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-11-24
// Tags: attack.execution, attack.t1204.004
// Description: Detects suspicious FileFix execution patterns where users are tricked into running malicious commands through browser file upload dialog manipulation.
// This attack typically begins when users visit malicious websites impersonating legitimate services or news platforms,
// which may display fake CAPTCHA challenges or direct instructions to open file explorer and paste clipboard content.
// The clipboard content usually contains commands that download and execute malware, such as information stealing tools.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.parent.executable LIKE "%\\brave.exe" OR process.parent.executable LIKE "%\\chrome.exe" OR process.parent.executable LIKE "%\\firefox.exe" OR process.parent.executable LIKE "%\\msedge.exe") AND process.command_line LIKE "%#%") AND (((process.command_line LIKE "%account%" OR process.command_line LIKE "%anti-bot%" OR process.command_line LIKE "%botcheck%" OR process.command_line LIKE "%captcha%" OR process.command_line LIKE "%challenge%" OR process.command_line LIKE "%confirmation%" OR process.command_line LIKE "%fraud%" OR process.command_line LIKE "%human%" OR process.command_line LIKE "%identification%" OR process.command_line LIKE "%identificator%" OR process.command_line LIKE "%identity%" OR process.command_line LIKE "%robot%" OR process.command_line LIKE "%validation%" OR process.command_line LIKE "%verification%" OR process.command_line LIKE "%verify%")) OR ((process.command_line LIKE "%%comspec%%" OR process.command_line LIKE "%bitsadmin%" OR process.command_line LIKE "%certutil%" OR process.command_line LIKE "%cmd%" OR process.command_line LIKE "%cscript%" OR process.command_line LIKE "%curl%" OR process.command_line LIKE "%finger%" OR process.command_line LIKE "%mshta%" OR process.command_line LIKE "%powershell%" OR process.command_line LIKE "%pwsh%" OR process.command_line LIKE "%regsvr32%" OR process.command_line LIKE "%rundll32%" OR process.command_line LIKE "%schtasks%" OR process.command_line LIKE "%wget%" OR process.command_line LIKE "%wscript%"))))
