// Title: Suspicious Processes Spawned by WinRM
// ID: 5cc2cda8-f261-4d88-a2de-e9e193c86716
// Status: test
// Level: high
// Author: Andreas Hunkeler (@Karneades), Markus Neis
// Date: 2021-05-20
// Tags: attack.t1190, attack.initial-access, attack.persistence, attack.privilege-escalation
// Description: Detects suspicious processes including shells spawnd from WinRM host process
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (process.parent.executable LIKE "%\\wsmprovhost.exe" AND (process.executable LIKE "%\\cmd.exe" OR process.executable LIKE "%\\sh.exe" OR process.executable LIKE "%\\bash.exe" OR process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe" OR process.executable LIKE "%\\wsl.exe" OR process.executable LIKE "%\\schtasks.exe" OR process.executable LIKE "%\\certutil.exe" OR process.executable LIKE "%\\whoami.exe" OR process.executable LIKE "%\\bitsadmin.exe"))
