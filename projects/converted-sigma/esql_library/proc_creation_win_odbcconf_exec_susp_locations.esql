// Title: Odbcconf.EXE Suspicious DLL Location
// ID: 6b65c28e-11f3-46cb-902a-68f2cafaf474
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-22
// Tags: attack.stealth, attack.t1218.008
// Description: Detects execution of "odbcconf" where the path of the DLL being registered is located in a potentially suspicious location.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%:\\PerfLogs\\%" OR process.command_line LIKE "%:\\ProgramData\\%" OR process.command_line LIKE "%:\\Temp\\%" OR process.command_line LIKE "%:\\Users\\Public\\%" OR process.command_line LIKE "%:\\Windows\\Registration\\CRMLog%" OR process.command_line LIKE "%:\\Windows\\System32\\com\\dmp\\%" OR process.command_line LIKE "%:\\Windows\\System32\\FxsTmp\\%" OR process.command_line LIKE "%:\\Windows\\System32\\Microsoft\\Crypto\\RSA\\MachineKeys\\%" OR process.command_line LIKE "%:\\Windows\\System32\\spool\\drivers\\color\\%" OR process.command_line LIKE "%:\\Windows\\System32\\spool\\PRINTERS\\%" OR process.command_line LIKE "%:\\Windows\\System32\\spool\\SERVERS\\%" OR process.command_line LIKE "%:\\Windows\\System32\\Tasks_Migrated\\%" OR process.command_line LIKE "%:\\Windows\\System32\\Tasks\\Microsoft\\Windows\\SyncCenter\\%" OR process.command_line LIKE "%:\\Windows\\SysWOW64\\com\\dmp\\%" OR process.command_line LIKE "%:\\Windows\\SysWOW64\\FxsTmp\\%" OR process.command_line LIKE "%:\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\PLA\\System\\%" OR process.command_line LIKE "%:\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\SyncCenter\\%" OR process.command_line LIKE "%:\\Windows\\Tasks\\%" OR process.command_line LIKE "%:\\Windows\\Temp\\%" OR process.command_line LIKE "%:\\Windows\\Tracing\\%" OR process.command_line LIKE "%\\AppData\\Local\\Temp\\%" OR process.command_line LIKE "%\\AppData\\Roaming\\%")) AND ((process.executable LIKE "%\\odbcconf.exe") OR (process.pe.original_file_name == "odbcconf.exe")))
