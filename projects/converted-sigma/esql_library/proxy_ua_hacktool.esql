// Description: Detects suspicious user agent strings user by hack tools in proxy logs
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((c-useragent LIKE "%(hydra)%" OR c-useragent LIKE "% arachni/%" OR c-useragent LIKE "% BFAC %" OR c-useragent LIKE "% brutus %" OR c-useragent LIKE "% cgichk %" OR c-useragent LIKE "%core-project/1.0%" OR c-useragent LIKE "% crimscanner/%" OR c-useragent LIKE "%datacha0s%" OR c-useragent LIKE "%dirbuster%" OR c-useragent LIKE "%domino hunter%" OR c-useragent LIKE "%dotdotpwn%" OR c-useragent LIKE "%FHScan Core%" OR c-useragent LIKE "%floodgate%" OR c-useragent LIKE "%get-minimal%" OR c-useragent LIKE "%gootkit auto-rooter scanner%" OR c-useragent LIKE "%grendel-scan%" OR c-useragent LIKE "% inspath %" OR c-useragent LIKE "%internet ninja%" OR c-useragent LIKE "%jaascois%" OR c-useragent LIKE "% zmeu %" OR c-useragent LIKE "%masscan%" OR c-useragent LIKE "% metis %" OR c-useragent LIKE "%morfeus fucking scanner%" OR c-useragent LIKE "%n-stealth%" OR c-useragent LIKE "%nsauditor%" OR c-useragent LIKE "%pmafind%" OR c-useragent LIKE "%security scan%" OR c-useragent LIKE "%springenwerk%" OR c-useragent LIKE "%teh forest lobster%" OR c-useragent LIKE "%toata dragostea%" OR c-useragent LIKE "% vega/%" OR c-useragent LIKE "%voideye%" OR c-useragent LIKE "%webshag%" OR c-useragent LIKE "%webvulnscan%" OR c-useragent LIKE "% whcc/%" OR c-useragent LIKE "% Havij%" OR c-useragent LIKE "%absinthe%" OR c-useragent LIKE "%bsqlbf%" OR c-useragent LIKE "%mysqloit%" OR c-useragent LIKE "%pangolin%" OR c-useragent LIKE "%sql power injector%" OR c-useragent LIKE "%sqlmap%" OR c-useragent LIKE "%sqlninja%" OR c-useragent LIKE "%uil2pn%" OR c-useragent LIKE "%ruler%" OR c-useragent LIKE "%Mozilla/5.0 (Windows; U; Windows NT 5.1; pt-PT; rv:1.9.1.2) Gecko/20090729 Firefox/3.5.2 (.NET CLR 3.5.30729)%"))
