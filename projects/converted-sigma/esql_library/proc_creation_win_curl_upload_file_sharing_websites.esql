// Title: Curl File Upload To File Sharing Websites
// ID: e328cc73-f92a-42fb-b3fa-7c2cffda981a
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-03-29
// Tags: attack.exfiltration, attack.t1567.002
// Description: Detects usage of curl to upload files to known file sharing domains, which may indicate data exfiltration.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%0x0.st%" OR process.command_line LIKE "%bashupload.com%" OR process.command_line LIKE "%chunk.io%" OR process.command_line LIKE "%file.io%" OR process.command_line LIKE "%filebin.net%" OR process.command_line LIKE "%pastebin%" OR process.command_line LIKE "%send.firefox.com%" OR process.command_line LIKE "%temp.sh%" OR process.command_line LIKE "%transfer.sh%" OR process.command_line LIKE "%ufile.io%" OR process.command_line LIKE "%uploadfiles.io%" OR process.command_line LIKE "%wetransfer.com%" OR process.command_line LIKE "%x0.at%")) AND (((process.command_line LIKE "% --form%" OR process.command_line LIKE "% --upload-file%" OR process.command_line LIKE "% --data%" OR process.command_line LIKE "% -X POST%" OR process.command_line LIKE "% --request POST %")) OR ((process.command_line RLIKE "\\s-[FTd]\\s" OR process.command_line RLIKE "\\s-sT\\s"))) AND ((process.executable LIKE "%\\curl.exe") OR (process.pe.original_file_name == "curl.exe")))
