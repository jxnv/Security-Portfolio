// Title: Potentially Suspicious AccessMask Requested From LSASS
// ID: 4a1b6da0-d94f-4fc3-98fc-2d9cb9e5ee76
// Status: test
// Level: medium
// Author: Roberto Rodriguez, Teymur Kheirkhabarov, Dimitrios Slamaris, Mark Russinovich, Aleksey Potapov, oscd.community (update)
// Date: 2019-11-01
// Tags: attack.credential-access, car.2019-04-004, attack.t1003.001
// Description: Detects process handle on LSASS process with certain access mask
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((winlog.event_id == 4656 AND ObjectName LIKE "%\\lsass.exe" AND (AccessMask LIKE "%0x40%" OR AccessMask LIKE "%0x1400%" OR AccessMask LIKE "%0x100000%" OR AccessMask LIKE "%0x1410%" OR AccessMask LIKE "%0x1010%" OR AccessMask LIKE "%0x1438%" OR AccessMask LIKE "%0x143a%" OR AccessMask LIKE "%0x1418%" OR AccessMask LIKE "%0x1f0fff%" OR AccessMask LIKE "%0x1f1fff%" OR AccessMask LIKE "%0x1f2fff%" OR AccessMask LIKE "%0x1f3fff%")) OR (winlog.event_id == 4663 AND ObjectName LIKE "%\\lsass.exe" AND (AccessList LIKE "%4484%" OR AccessList LIKE "%4416%"))) AND NOT (((ProcessName LIKE "%:\\Windows\\Temp\\asgard2-agent-sc\\aurora\\%" AND ProcessName LIKE "%\\aurora-agent-64.exe" AND AccessList LIKE "%%%4484%") OR ((ProcessName LIKE "%:\\Users\\%" AND ProcessName LIKE "%\\AppData\\Local\\Temp\\is-%") AND ProcessName LIKE "%\\avira_system_speedup.tmp" AND AccessList LIKE "%%%4484%") OR (ProcessName LIKE "%:\\Windows\\Temp\\%" AND ProcessName LIKE "%\\avira_speedup_setup_update.tmp" AND AccessList LIKE "%%%4484%") OR ((ProcessName LIKE "%:\\Windows\\System32\\taskhostw.exe" OR ProcessName LIKE "%:\\Windows\\System32\\msiexec.exe" OR ProcessName LIKE "%:\\Windows\\CCM\\CcmExec.exe")) OR (ProcessName LIKE "%:\\Program Files%") OR (ProcessName LIKE "%:\\Windows\\SystemTemp\\%" AND ProcessName LIKE "%\\GoogleUpdate.exe" AND AccessList LIKE "%%%4484%") OR (ProcessName LIKE "%\\x64\\SCENARIOENGINE.EXE" AND AccessList LIKE "%%%4484%") OR (ProcessName LIKE "%:\\Windows\\System32\\snmp.exe" AND AccessList LIKE "%%%4484%") OR ((ProcessName LIKE "%\\csrss.exe" OR ProcessName LIKE "%\\GamingServices.exe" OR ProcessName LIKE "%\\lsm.exe" OR ProcessName LIKE "%\\MicrosoftEdgeUpdate.exe" OR ProcessName LIKE "%\\minionhost.exe" OR ProcessName LIKE "%\\MRT.exe" OR ProcessName LIKE "%\\MsMpEng.exe" OR ProcessName LIKE "%\\perfmon.exe" OR ProcessName LIKE "%\\procexp.exe" OR ProcessName LIKE "%\\procexp64.exe" OR ProcessName LIKE "%\\procexp64a.exe" OR ProcessName LIKE "%\\svchost.exe" OR ProcessName LIKE "%\\taskmgr.exe" OR ProcessName LIKE "%\\thor.exe" OR ProcessName LIKE "%\\thor64.exe" OR ProcessName LIKE "%\\vmtoolsd.exe" OR ProcessName LIKE "%\\VsTskMgr.exe" OR ProcessName LIKE "%\\wininit.exe" OR ProcessName LIKE "%\\wmiprvse.exe" OR ProcessName LIKE "%RtkAudUService64") AND (ProcessName LIKE "%:\\Program Files (x86)\\%" OR ProcessName LIKE "%:\\Program Files\\%" OR ProcessName LIKE "%:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\%" OR ProcessName LIKE "%:\\Windows\\SysNative\\%" OR ProcessName LIKE "%:\\Windows\\System32\\%" OR ProcessName LIKE "%:\\Windows\\SysWow64\\%" OR ProcessName LIKE "%:\\Windows\\Temp\\asgard2-agent\\%")) OR ((ProcessName LIKE "%:\\Windows\\Sysmon64.exe" OR ProcessName LIKE "%:\\Windows\\Sysmon64a.exe") AND AccessList LIKE "%%%4484%"))) AND NOT (((ProcessName LIKE "%\\procmon64.exe" OR ProcessName LIKE "%\\procmon64a.exe" OR ProcessName LIKE "%\\procmon.exe") AND AccessList LIKE "%%%4484%")))
