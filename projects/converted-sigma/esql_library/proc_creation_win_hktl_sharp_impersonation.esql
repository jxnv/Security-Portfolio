// Title: HackTool - SharpImpersonation Execution
// ID: f89b08d0-77ad-4728-817b-9b16c5a69c7a
// Status: test
// Level: high
// Author: Sai Prashanth Pulisetti @pulisettis, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-27
// Tags: attack.privilege-escalation, attack.stealth, attack.t1134.001, attack.t1134.003
// Description: Detects execution of the SharpImpersonation tool. Which can be used to manipulate tokens on a Windows computers remotely (PsExec/WmiExec) or interactively
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.command_line LIKE "% user:%" AND process.command_line LIKE "% binary:%")) OR ((process.command_line LIKE "% user:%" AND process.command_line LIKE "% shellcode:%")) OR ((process.command_line LIKE "% technique:CreateProcessAsUserW%" OR process.command_line LIKE "% technique:ImpersonateLoggedOnuser%"))) OR ((process.executable LIKE "%\\SharpImpersonation.exe") OR (process.pe.original_file_name == "SharpImpersonation.exe")))
