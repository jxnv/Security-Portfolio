// Title: Removal of Potential COM Hijacking Registry Keys
// ID: 96f697b0-b499-4e5d-9908-a67bec11cdb6
// Status: test
// Level: medium
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2020-05-02
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects any deletion of entries in ".*\shell\open\command" registry keys.
// These registry keys might have been used for COM hijacking activities by a threat actor or an attacker and the deletion could indicate steps to remove its tracks.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((registry.path LIKE "%\\shell\\open\\command") AND NOT (((process.executable LIKE "%C:\\Windows\\explorer.exe") OR ((process.executable LIKE "C:\\Program Files\\%" OR process.executable LIKE "C:\\Program Files (x86)\\%")) OR ((process.executable == "C:\\Windows\\System32\\msiexec.exe" OR process.executable == "C:\\Windows\\SysWOW64\\msiexec.exe")) OR (process.executable == "C:\\Windows\\System32\\OpenWith.exe") OR (process.executable == "C:\\Windows\\system32\\svchost.exe"))) AND NOT ((((process.executable == "C:\\Program Files (x86)\\Avira\\Antivirus\\" OR process.executable == "C:\\Program Files\\Avira\\Antivirus\\") AND (registry.path LIKE "%\\CLSID\\{305CA226-D286-468e-B848-2B2E8E697B74}\\Shell\\Open\\Command" OR registry.path LIKE "%\\AntiVir.Keyfile\\shell\\open\\command")) OR (process.executable LIKE "%\\reg.exe" AND registry.path LIKE "%\\Discord\\shell\\open\\command") OR (process.executable LIKE "%\\Dropbox.exe" AND registry.path LIKE "%\\Dropbox.%") OR (process.executable LIKE "%C:\\eclipse\\eclipse.exe" AND registry.path LIKE "%_Classes\\eclipse+%") OR (process.executable LIKE "%\\Microsoft\\EdgeUpdate\\Install%") OR (process.executable LIKE "%\\Everything.exe" AND registry.path LIKE "%\\Everything.%") OR (((process.executable LIKE "%AppData\\Local\\Temp%" AND process.executable LIKE "%\\setup.exe%")) OR ((process.executable LIKE "%\\Temp\\is-%" AND process.executable LIKE "%\\target.tmp%"))) OR (process.executable LIKE "C:\\Program Files (x86)\\Java\\%" AND process.executable LIKE "%\\installer.exe" AND registry.path LIKE "%\\Classes\\WOW6432Node\\CLSID\\{4299124F-F2C3-41b4-9C73-9236B2AD0E8F}%") OR (process.executable LIKE "%\\ninite.exe") OR (process.executable LIKE "%peazip%" AND registry.path LIKE "%\\PeaZip.%") OR (process.executable LIKE "%\\Spotify.exe" AND registry.path LIKE "%\\Spotify\\shell\\open\\command") OR ((process.executable LIKE "%\\Temp%" AND process.executable LIKE "%\\TeamViewer%")) OR (process.executable LIKE "C:\\Windows\\Installer\\MSI%") OR (process.executable LIKE "%\\AppData\\Local\\Temp\\Wireshark_uninstaller.exe" AND registry.path LIKE "%\\wireshark-capture-file\\%"))))
