// Title: Linux HackTool Execution
// ID: a015e032-146d-4717-8944-7a1884122111
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Georg Lauenstein (sure[secure])
// Date: 2023-01-03
// Tags: attack.execution, attack.resource-development, attack.t1587
// Description: Detects known hacktool execution based on image name.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%/cobaltstrike%" OR process.executable LIKE "%/teamserver%")) OR ((process.executable LIKE "%/crackmapexec" OR process.executable LIKE "%/havoc" OR process.executable LIKE "%/merlin-agent" OR process.executable LIKE "%/merlinServer-Linux-x64" OR process.executable LIKE "%/msfconsole" OR process.executable LIKE "%/msfvenom" OR process.executable LIKE "%/ps-empire server" OR process.executable LIKE "%/ps-empire" OR process.executable LIKE "%/sliver-client" OR process.executable LIKE "%/sliver-server" OR process.executable LIKE "%/Villain.py")) OR ((process.executable LIKE "%/aircrack-ng" OR process.executable LIKE "%/bloodhound-python" OR process.executable LIKE "%/bpfdos" OR process.executable LIKE "%/ebpfki" OR process.executable LIKE "%/evil-winrm" OR process.executable LIKE "%/hashcat" OR process.executable LIKE "%/hoaxshell.py" OR process.executable LIKE "%/hydra" OR process.executable LIKE "%/john" OR process.executable LIKE "%/ncrack" OR process.executable LIKE "%/nxc-ubuntu-latest" OR process.executable LIKE "%/pidhide" OR process.executable LIKE "%/pspy32" OR process.executable LIKE "%/pspy32s" OR process.executable LIKE "%/pspy64" OR process.executable LIKE "%/pspy64s" OR process.executable LIKE "%/setoolkit" OR process.executable LIKE "%/sqlmap" OR process.executable LIKE "%/writeblocker")) OR (process.executable LIKE "%/linpeas%") OR ((process.executable LIKE "%/autorecon" OR process.executable LIKE "%/httpx" OR process.executable LIKE "%/legion" OR process.executable LIKE "%/naabu" OR process.executable LIKE "%/netdiscover" OR process.executable LIKE "%/nuclei" OR process.executable LIKE "%/recon-ng")) OR (process.executable LIKE "%/sniper%") OR ((process.executable LIKE "%/dirb" OR process.executable LIKE "%/dirbuster" OR process.executable LIKE "%/eyewitness" OR process.executable LIKE "%/feroxbuster" OR process.executable LIKE "%/ffuf" OR process.executable LIKE "%/gobuster" OR process.executable LIKE "%/wfuzz" OR process.executable LIKE "%/whatweb")) OR ((process.executable LIKE "%/joomscan" OR process.executable LIKE "%/nikto" OR process.executable LIKE "%/wpscan")))
