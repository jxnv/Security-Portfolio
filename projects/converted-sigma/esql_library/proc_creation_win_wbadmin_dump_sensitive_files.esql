// Title: Sensitive File Dump Via Wbadmin.EXE
// ID: 8b93a509-1cb8-42e1-97aa-ee24224cdc15
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), frack113
// Date: 2024-05-10
// Tags: attack.credential-access, attack.t1003.003
// Description: Detects the dump of highly sensitive files such as "NTDS.DIT" and "SECURITY" hive.
// Attackers can leverage the "wbadmin" utility in order to dump sensitive files that might contain credential or sensitive information.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%start%" OR process.command_line LIKE "%backup%")) AND ((process.executable LIKE "%\\wbadmin.exe") OR (process.pe.original_file_name == "WBADMIN.EXE")) AND ((process.command_line LIKE "%\\config\\SAM%" OR process.command_line LIKE "%\\config\\SECURITY%" OR process.command_line LIKE "%\\config\\SYSTEM%" OR process.command_line LIKE "%\\Windows\\NTDS\\NTDS.dit%")))
