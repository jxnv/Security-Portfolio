// Title: Suspicious Browser Child Process - MacOS
// ID: 0250638a-2b28-4541-86fc-ea4c558fa0c6
// Status: test
// Level: medium
// Author: Sohan G (D4rkCiph3r)
// Date: 2023-04-05
// Tags: attack.initial-access, attack.execution, attack.t1189, attack.t1203, attack.t1059
// Description: Detects suspicious child processes spawned from browsers. This could be a result of a potential web browser exploitation.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.parent.executable LIKE "%com.apple.WebKit.WebContent%" OR process.parent.executable LIKE "%firefox%" OR process.parent.executable LIKE "%Google Chrome Helper%" OR process.parent.executable LIKE "%Google Chrome%" OR process.parent.executable LIKE "%Microsoft Edge%" OR process.parent.executable LIKE "%Opera%" OR process.parent.executable LIKE "%Safari%" OR process.parent.executable LIKE "%Tor Browser%") AND (process.executable LIKE "%/bash" OR process.executable LIKE "%/curl" OR process.executable LIKE "%/dash" OR process.executable LIKE "%/ksh" OR process.executable LIKE "%/osascript" OR process.executable LIKE "%/perl" OR process.executable LIKE "%/php" OR process.executable LIKE "%/pwsh" OR process.executable LIKE "%/python" OR process.executable LIKE "%/sh" OR process.executable LIKE "%/tcsh" OR process.executable LIKE "%/wget" OR process.executable LIKE "%/zsh")) AND NOT ((((process.parent.executable LIKE "%Google Chrome Helper%" OR process.parent.executable LIKE "%Google Chrome%") AND (process.command_line LIKE "%/Volumes/Google Chrome/Google Chrome.app/Contents/Frameworks/*/Resources/install.sh%" OR process.command_line LIKE "%/Applications/Google Chrome.app/Contents/Frameworks/Google Chrome Framework.framework/*/Resources/keystone_promote_preflight.sh%" OR process.command_line LIKE "%/Applications/Google Chrome.app/Contents/Frameworks/Google Chrome Framework.framework/*/Resources/keystone_promote_postflight.sh%")) OR ((process.parent.executable LIKE "%Google Chrome Helper%" OR process.parent.executable LIKE "%Google Chrome%") AND (process.command_line LIKE "%/Users/%" AND process.command_line LIKE "%/Library/Application Support/Google/Chrome/recovery/%" AND process.command_line LIKE "%/ChromeRecovery%")) OR (process.command_line LIKE "%--defaults-torrc%") OR (process.command_line LIKE "%/Library/Application Support/Microsoft/MAU*/Microsoft AutoUpdate.app/Contents/MacOS/msupdate%") OR (process.parent.executable LIKE "%Microsoft Edge%" AND (process.command_line LIKE "%IOPlatformExpertDevice%" OR process.command_line LIKE "%hw.model%")))) AND NOT (((process.command_line == "") OR (process.command_line IS NULL))))
