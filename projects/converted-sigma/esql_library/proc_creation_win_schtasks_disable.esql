// Title: Disable Important Scheduled Task
// ID: 9ac94dc8-9042-493c-ba45-3b5e7c86b980
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems), X__Junior
// Date: 2021-12-26
// Tags: attack.impact, attack.t1489
// Description: Detects when adversaries stop services or processes by disabling their respective scheduled tasks in order to conduct data destructive activities
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%/disable%" OR process.command_line LIKE "%-disable%")) AND ((process.command_line LIKE "%\\Windows\\BitLocker%" OR process.command_line LIKE "%\\Windows\\ExploitGuard%" OR process.command_line LIKE "%\\Windows\\ExploitGuard\\ExploitGuard MDM policy Refresh%" OR process.command_line LIKE "%\\Windows\\SystemRestore\\SR%" OR process.command_line LIKE "%\\Windows\\UpdateOrchestrator\\%" OR process.command_line LIKE "%\\Windows\\Windows Defender\\%" OR process.command_line LIKE "%\\Windows\\WindowsBackup\\%" OR process.command_line LIKE "%\\Windows\\WindowsUpdate\\%")) AND ((process.executable LIKE "%\\schtasks.exe") OR (process.pe.original_file_name == "schtasks.exe")))
