// Title: Disabled IE Security Features
// ID: fb50eb7a-5ab1-43ae-bcc9-091818cb8424
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2020-06-19
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects command lines that indicate unwanted modifications to registry keys that disable important Internet Explorer security features
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "% -name IEHarden %" AND process.command_line LIKE "% -value 0 %")) OR ((process.command_line LIKE "% -name DEPOff %" AND process.command_line LIKE "% -value 1 %")) OR ((process.command_line LIKE "% -name DisableFirstRunCustomize %" AND process.command_line LIKE "% -value 2 %")))
