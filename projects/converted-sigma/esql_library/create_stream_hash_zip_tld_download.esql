// Title: Potentially Suspicious File Download From ZIP TLD
// ID: 0bb4bbeb-fe52-4044-b40c-430a04577ebe
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2023-05-18
// Tags: attack.stealth
// Description: Detects the download of a file with a potentially suspicious extension from a .zip top level domain.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (Contents LIKE "%.zip/%" AND (file.path LIKE "%.bat:Zone%" OR file.path LIKE "%.dat:Zone%" OR file.path LIKE "%.dll:Zone%" OR file.path LIKE "%.doc:Zone%" OR file.path LIKE "%.docm:Zone%" OR file.path LIKE "%.exe:Zone%" OR file.path LIKE "%.hta:Zone%" OR file.path LIKE "%.pptm:Zone%" OR file.path LIKE "%.ps1:Zone%" OR file.path LIKE "%.rar:Zone%" OR file.path LIKE "%.rtf:Zone%" OR file.path LIKE "%.sct:Zone%" OR file.path LIKE "%.vbe:Zone%" OR file.path LIKE "%.vbs:Zone%" OR file.path LIKE "%.ws:Zone%" OR file.path LIKE "%.wsf:Zone%" OR file.path LIKE "%.xll:Zone%" OR file.path LIKE "%.xls:Zone%" OR file.path LIKE "%.xlsm:Zone%" OR file.path LIKE "%.zip:Zone%"))
