// Title: Suspicious MsiExec Embedding Parent
// ID: 4a2a2c3e-209f-4d01-b513-4155a540b469
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-04-16
// Tags: attack.stealth, attack.t1218.007
// Description: Adversaries may abuse msiexec.exe to proxy the execution of malicious payloads
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe" OR process.executable LIKE "%\\cmd.exe") AND (process.parent.command_line LIKE "%MsiExec.exe%" AND process.parent.command_line LIKE "%-Embedding %")) AND NOT (((process.executable LIKE "%:\\Windows\\System32\\cmd.exe" AND process.command_line LIKE "%C:\\Program Files\\SplunkUniversalForwarder\\bin\\%") OR ((process.command_line LIKE "%\\DismFoDInstall.cmd%") OR ((process.parent.command_line LIKE "%\\MsiExec.exe -Embedding %" AND process.parent.command_line LIKE "%Global\\MSI0000%"))))))
