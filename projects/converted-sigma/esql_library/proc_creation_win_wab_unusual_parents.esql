// Title: Wab/Wabmig Unusual Parent Or Child Processes
// ID: 63d1ccc0-2a43-4f4b-9289-361b308991ff
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-12
// Tags: attack.execution, attack.stealth
// Description: Detects unusual parent or children of the wab.exe (Windows Contacts) and Wabmig.exe (Microsoft Address Book Import Tool) processes as seen being used with bumblebee activity
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.parent.executable LIKE "%\\wab.exe" OR process.parent.executable LIKE "%\\wabmig.exe")) OR ((process.parent.executable LIKE "%\\WmiPrvSE.exe" OR process.parent.executable LIKE "%\\svchost.exe" OR process.parent.executable LIKE "%\\dllhost.exe") AND (process.executable LIKE "%\\wab.exe" OR process.executable LIKE "%\\wabmig.exe")))
