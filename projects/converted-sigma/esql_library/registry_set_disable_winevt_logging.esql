// Title: Disable Windows Event Logging Via Registry
// ID: 2f78da12-f7c7-430b-8b19-a28f269b77a3
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-04
// Tags: attack.defense-impairment, attack.t1685.001
// Description: Detects tampering with the "Enabled" registry key in order to disable Windows logging of a Windows event channel
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((registry.path LIKE "%\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\%" AND registry.path LIKE "%\\Enabled" AND registry.data.strings == "DWORD (0x00000000)") AND NOT (((process.executable LIKE "C:\\Windows\\winsxs\\%" AND process.executable LIKE "%\\TiWorker.exe") OR (process.executable == "C:\\Windows\\System32\\svchost.exe" AND (registry.path LIKE "%\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-FileInfoMinifilter%" OR registry.path LIKE "%\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-ASN1\\%" OR registry.path LIKE "%\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-Kernel-AppCompat\\%" OR registry.path LIKE "%\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-Runtime\\Error\\%" OR registry.path LIKE "%\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-CAPI2/Operational\\%")) OR (process.executable == "C:\\Windows\\servicing\\TrustedInstaller.exe" AND registry.path LIKE "%\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-Compat-Appraiser%") OR (process.executable == "C:\\Windows\\system32\\wevtutil.exe"))) AND NOT (((process.executable == "") OR (process.executable IS NULL))))
