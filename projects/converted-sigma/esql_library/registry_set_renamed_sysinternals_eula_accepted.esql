// Title: Usage of Renamed Sysinternals Tools - RegistrySet
// ID: 8023f872-3f1d-4301-a384-801889917ab4
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-24
// Tags: attack.resource-development, attack.t1588.002
// Description: Detects non-sysinternals tools setting the "accepteula" key which normally is set on sysinternals tool execution
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((registry.path LIKE "%\\PsExec%" OR registry.path LIKE "%\\ProcDump%" OR registry.path LIKE "%\\Handle%" OR registry.path LIKE "%\\LiveKd%" OR registry.path LIKE "%\\Process Explorer%" OR registry.path LIKE "%\\PsLoglist%" OR registry.path LIKE "%\\PsPasswd%" OR registry.path LIKE "%\\Active Directory Explorer%") AND registry.path LIKE "%\\EulaAccepted") AND NOT (((process.executable LIKE "%\\PsExec.exe" OR process.executable LIKE "%\\PsExec64.exe" OR process.executable LIKE "%\\PsExec64a.exe" OR process.executable LIKE "%\\procdump.exe" OR process.executable LIKE "%\\procdump64.exe" OR process.executable LIKE "%\\procdump64a.exe" OR process.executable LIKE "%\\handle.exe" OR process.executable LIKE "%\\handle64.exe" OR process.executable LIKE "%\\handle64a.exe" OR process.executable LIKE "%\\livekd.exe" OR process.executable LIKE "%\\livekd64.exe" OR process.executable LIKE "%\\procexp.exe" OR process.executable LIKE "%\\procexp64.exe" OR process.executable LIKE "%\\procexp64a.exe" OR process.executable LIKE "%\\psloglist.exe" OR process.executable LIKE "%\\psloglist64.exe" OR process.executable LIKE "%\\psloglist64a.exe" OR process.executable LIKE "%\\pspasswd.exe" OR process.executable LIKE "%\\pspasswd64.exe" OR process.executable LIKE "%\\pspasswd64a.exe" OR process.executable LIKE "%\\ADExplorer.exe" OR process.executable LIKE "%\\ADExplorer64.exe" OR process.executable LIKE "%\\ADExplorer64a.exe"))) AND NOT ((process.executable IS NULL)))
