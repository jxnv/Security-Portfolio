// Title: Service Startup Type Change Via Wmic.EXE
// ID: c0514f28-fdae-42df-b886-06e2b2bc5b37
// Status: experimental
// Level: medium
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-04-27
// Tags: attack.execution, attack.defense-impairment, attack.t1047, attack.t1685
// Description: Detects changes to service startup type to 'disabled' or 'manual' using the WMIC command-line utility.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "% service %" AND process.command_line LIKE "%ChangeStartMode%") AND (process.command_line LIKE "%Manual%" OR process.command_line LIKE "%Disabled%")) AND ((process.executable LIKE "%\\WMIC.exe") OR (process.pe.original_file_name == "wmic.exe")))
