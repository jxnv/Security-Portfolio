// Title: Compress Data and Lock With Password for Exfiltration With 7-ZIP
// ID: 9fbf5927-5261-4284-a71d-f681029ea574
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-07-27
// Tags: attack.collection, attack.t1560.001
// Description: An adversary may compress or encrypt data that is collected prior to exfiltration using 3rd party utilities
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "% a %" OR process.command_line LIKE "% u %")) AND ((Description LIKE "%7-Zip%") OR ((process.executable LIKE "%\\7z.exe" OR process.executable LIKE "%\\7zr.exe" OR process.executable LIKE "%\\7za.exe")) OR ((process.pe.original_file_name == "7z.exe" OR process.pe.original_file_name == "7za.exe" OR process.pe.original_file_name == "7zr.exe"))) AND (process.command_line LIKE "% -p%"))
