// Title: Uncommon Connection to Active Directory Web Services
// ID: b3ad3c0f-c949-47a1-a30e-b0491ccae876
// Status: test
// Level: medium
// Author: @kostastsale
// Date: 2024-01-26
// Tags: attack.discovery, attack.t1087
// Description: Detects uncommon network connections to the Active Directory Web Services (ADWS) from processes not typically associated with ADWS management.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((Initiated == True AND destination.port == 9389) AND NOT (((process.executable == "C:\\Windows\\system32\\dsac.exe") OR (process.executable == "C:\\Program Files\\Microsoft Monitoring Agent\\") OR ((process.executable LIKE "C:\\Program Files\\PowerShell\\7\\pwsh.exe%" OR process.executable LIKE "C:\\Program Files\\PowerShell\\7-preview\\pwsh.ex%" OR process.executable LIKE "C:\\Windows\\System32\\WindowsPowerShell\\%" OR process.executable LIKE "C:\\Windows\\SysWOW64\\WindowsPowerShell\\%")))))
