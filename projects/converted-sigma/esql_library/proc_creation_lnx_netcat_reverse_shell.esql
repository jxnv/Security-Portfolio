// Title: Potential Netcat Reverse Shell Execution
// ID: 7f734ed0-4f47-46c0-837f-6ee62505abd9
// Status: test
// Level: high
// Author: @d4ns4n_, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-07
// Tags: attack.execution, attack.t1059
// Description: Detects execution of netcat with the "-e" or "-c" flags followed by common shells, which are commonly used to spawn reverse shells.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "% -c %" OR process.command_line LIKE "% -e %")) AND ((process.executable LIKE "%/nc.openbsd" OR process.executable LIKE "%/nc.traditional" OR process.executable LIKE "%/nc" OR process.executable LIKE "%/ncat" OR process.executable LIKE "%/netcat.openbsd" OR process.executable LIKE "%/netcat.traditional" OR process.executable LIKE "%/netcat")) AND ((process.command_line LIKE "% ash%" OR process.command_line LIKE "% bash%" OR process.command_line LIKE "% bsh%" OR process.command_line LIKE "% csh%" OR process.command_line LIKE "% ksh%" OR process.command_line LIKE "% pdksh%" OR process.command_line LIKE "% sh%" OR process.command_line LIKE "% tcsh%" OR process.command_line LIKE "%/bin/ash%" OR process.command_line LIKE "%/bin/bash%" OR process.command_line LIKE "%/bin/bsh%" OR process.command_line LIKE "%/bin/csh%" OR process.command_line LIKE "%/bin/ksh%" OR process.command_line LIKE "%/bin/pdksh%" OR process.command_line LIKE "%/bin/sh%" OR process.command_line LIKE "%/bin/tcsh%" OR process.command_line LIKE "%/bin/zsh%" OR process.command_line LIKE "%$IFSash%" OR process.command_line LIKE "%$IFSbash%" OR process.command_line LIKE "%$IFSbsh%" OR process.command_line LIKE "%$IFScsh%" OR process.command_line LIKE "%$IFSksh%" OR process.command_line LIKE "%$IFSpdksh%" OR process.command_line LIKE "%$IFSsh%" OR process.command_line LIKE "%$IFStcsh%" OR process.command_line LIKE "%$IFSzsh%")))
