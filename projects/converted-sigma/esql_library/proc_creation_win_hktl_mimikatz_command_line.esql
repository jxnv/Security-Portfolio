// Title: HackTool - Mimikatz Execution
// ID: a642964e-bead-4bed-8910-1bb4d63e3b4d
// Status: test
// Level: high
// Author: Teymur Kheirkhabarov, oscd.community, David ANDRE (additional keywords), Tim Shelton
// Date: 2019-10-22
// Tags: attack.credential-access, attack.t1003.001, attack.t1003.002, attack.t1003.004, attack.t1003.005, attack.t1003.006
// Description: Detection well-known mimikatz command line arguments
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%::aadcookie%" OR process.command_line LIKE "%::detours%" OR process.command_line LIKE "%::memssp%" OR process.command_line LIKE "%::mflt%" OR process.command_line LIKE "%::ncroutemon%" OR process.command_line LIKE "%::ngcsign%" OR process.command_line LIKE "%::printnightmare%" OR process.command_line LIKE "%::skeleton%" OR process.command_line LIKE "%::preshutdown%" OR process.command_line LIKE "%::mstsc%" OR process.command_line LIKE "%::multirdp%")) OR ((process.command_line LIKE "%rpc::%" OR process.command_line LIKE "%token::%" OR process.command_line LIKE "%crypto::%" OR process.command_line LIKE "%dpapi::%" OR process.command_line LIKE "%sekurlsa::%" OR process.command_line LIKE "%kerberos::%" OR process.command_line LIKE "%lsadump::%" OR process.command_line LIKE "%privilege::%" OR process.command_line LIKE "%process::%" OR process.command_line LIKE "%vault::%")) OR ((process.command_line LIKE "%DumpCreds%" OR process.command_line LIKE "%mimikatz%")))
