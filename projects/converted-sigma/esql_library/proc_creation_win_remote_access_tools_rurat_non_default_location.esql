// Title: Remote Access Tool - RURAT Execution From Unusual Location
// ID: e01fa958-6893-41d4-ae03-182477c5e77d
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-19
// Tags: attack.stealth
// Description: Detects execution of Remote Utilities RAT (RURAT) from an unusual location (outside of 'C:\Program Files')
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.executable LIKE "%\\rutserv.exe" OR process.executable LIKE "%\\rfusclient.exe")) OR (Product == "Remote Utilities")) AND NOT (((process.executable LIKE "C:\\Program Files\\Remote Utilities%" OR process.executable LIKE "C:\\Program Files (x86)\\Remote Utilities%"))))
