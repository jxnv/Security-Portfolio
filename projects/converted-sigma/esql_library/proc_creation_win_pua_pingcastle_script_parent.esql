// Title: PUA - PingCastle Execution From Potentially Suspicious Parent
// ID: b37998de-a70b-4f33-b219-ec36bf433dc0
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2024-01-11
// Tags: attack.reconnaissance, attack.t1595
// Description: Detects the execution of PingCastle, a tool designed to quickly assess the Active Directory security level via a script located in a potentially suspicious or uncommon location.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.parent.command_line LIKE "%.bat%" OR process.parent.command_line LIKE "%.chm%" OR process.parent.command_line LIKE "%.cmd%" OR process.parent.command_line LIKE "%.hta%" OR process.parent.command_line LIKE "%.htm%" OR process.parent.command_line LIKE "%.html%" OR process.parent.command_line LIKE "%.js%" OR process.parent.command_line LIKE "%.lnk%" OR process.parent.command_line LIKE "%.ps1%" OR process.parent.command_line LIKE "%.vbe%" OR process.parent.command_line LIKE "%.vbs%" OR process.parent.command_line LIKE "%.wsf%")) OR ((process.parent.command_line LIKE "%:\\Perflogs\\%" OR process.parent.command_line LIKE "%:\\Temp\\%" OR process.parent.command_line LIKE "%:\\Users\\Public\\%" OR process.parent.command_line LIKE "%:\\Windows\\Temp\\%" OR process.parent.command_line LIKE "%\\AppData\\Local\\Temp%" OR process.parent.command_line LIKE "%\\AppData\\Roaming\\%" OR process.parent.command_line LIKE "%\\Temporary Internet%")) OR (((process.parent.command_line LIKE "%:\\Users\\%" AND process.parent.command_line LIKE "%\\Favorites\\%")) OR ((process.parent.command_line LIKE "%:\\Users\\%" AND process.parent.command_line LIKE "%\\Favourites\\%")) OR ((process.parent.command_line LIKE "%:\\Users\\%" AND process.parent.command_line LIKE "%\\Contacts\\%")))) AND ((process.parent.command_line LIKE "%.bat%" OR process.parent.command_line LIKE "%.chm%" OR process.parent.command_line LIKE "%.cmd%" OR process.parent.command_line LIKE "%.hta%" OR process.parent.command_line LIKE "%.htm%" OR process.parent.command_line LIKE "%.html%" OR process.parent.command_line LIKE "%.js%" OR process.parent.command_line LIKE "%.lnk%" OR process.parent.command_line LIKE "%.ps1%" OR process.parent.command_line LIKE "%.vbe%" OR process.parent.command_line LIKE "%.vbs%" OR process.parent.command_line LIKE "%.wsf%")) AND ((process.executable LIKE "%\\PingCastle.exe") OR (process.pe.original_file_name == "PingCastle.exe") OR (Product == "Ping Castle") OR ((process.command_line LIKE "%--scanner aclcheck%" OR process.command_line LIKE "%--scanner antivirus%" OR process.command_line LIKE "%--scanner computerversion%" OR process.command_line LIKE "%--scanner foreignusers%" OR process.command_line LIKE "%--scanner laps_bitlocker%" OR process.command_line LIKE "%--scanner localadmin%" OR process.command_line LIKE "%--scanner nullsession%" OR process.command_line LIKE "%--scanner nullsession-trust%" OR process.command_line LIKE "%--scanner oxidbindings%" OR process.command_line LIKE "%--scanner remote%" OR process.command_line LIKE "%--scanner share%" OR process.command_line LIKE "%--scanner smb%" OR process.command_line LIKE "%--scanner smb3querynetwork%" OR process.command_line LIKE "%--scanner spooler%" OR process.command_line LIKE "%--scanner startup%" OR process.command_line LIKE "%--scanner zerologon%")) OR (process.command_line LIKE "%--no-enum-limit%") OR ((process.command_line LIKE "%--healthcheck%" AND process.command_line LIKE "%--level Full%")) OR ((process.command_line LIKE "%--healthcheck%" AND process.command_line LIKE "%--server %"))))
