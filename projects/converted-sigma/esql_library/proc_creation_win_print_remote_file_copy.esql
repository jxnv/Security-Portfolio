// Title: Abusing Print Executable
// ID: bafac3d6-7de9-4dd9-8874-4a1194b493ed
// Status: test
// Level: medium
// Author: Furkan CALISKAN, @caliskanfurkan_, @oscd_initiative
// Date: 2020-10-05
// Tags: attack.stealth, attack.t1218
// Description: Attackers can use print.exe for remote file copy
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%\\print.exe" AND process.command_line LIKE "print%" AND (process.command_line LIKE "%/D%" AND process.command_line LIKE "%.exe%")) AND NOT ((process.command_line LIKE "%print.exe%")))
