// Title: Remote Access Tool - ScreenConnect Remote Command Execution
// ID: b1f73849-6329-4069-bc8f-78a604bb8b23
// Status: test
// Level: low
// Author: Ali Alwashali
// Date: 2023-10-10
// Tags: attack.execution, attack.t1059.003
// Description: Detects the execution of a system command via the ScreenConnect RMM service.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.command_line LIKE "%\\TEMP\\ScreenConnect\\%") AND ((process.executable LIKE "%\\cmd.exe") OR (process.pe.original_file_name == "Cmd.Exe")) AND (process.parent.executable LIKE "%\\ScreenConnect.ClientService.exe"))
