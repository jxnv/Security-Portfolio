// Title: New Firewall Rule Added In Windows Firewall Exception List For Potential Suspicious Application
// ID: 9e2575e7-2cb9-4da1-adc8-ed94221dca5e
// Status: test
// Level: high
// Author: frack113
// Date: 2023-02-26
// Tags: attack.defense-impairment, attack.t1686.003
// Description: Detects the addition of a new rule to the Windows Firewall exception list for an application located in a potentially suspicious location.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((winlog.event_id == 2004 OR winlog.event_id == 2071 OR winlog.event_id == 2097) AND (ApplicationPath LIKE "%:\\PerfLogs\\%" OR ApplicationPath LIKE "%:\\Temp\\%" OR ApplicationPath LIKE "%:\\Tmp\\%" OR ApplicationPath LIKE "%:\\Users\\Public\\%" OR ApplicationPath LIKE "%:\\Windows\\Tasks\\%" OR ApplicationPath LIKE "%:\\Windows\\Temp\\%" OR ApplicationPath LIKE "%\\AppData\\Local\\Temp\\%")) AND NOT ((Action == 2)))
