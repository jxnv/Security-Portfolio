"%wmms%" OR process.command_line LIKE "%wozyprobackup%" OR process.command_line LIKE "%WPFFontCache_v0400%" OR process.command_line LIKE "%WRSVC%" OR process.command_line LIKE "%wsbexchange%" OR process.command_line LIKE "%WSearch%" OR process.command_line LIKE "%wscsvc%" OR process.command_line LIKE "%Zoolz 2 Service%")) AND (((process.command_line LIKE "% delete %" OR process.command_line LIKE "%.delete()%" OR process.command_line LIKE "% pause %" OR process.command_line LIKE "% stop %" OR process.command_line LIKE "%Stop-Service %" OR process.command_line LIKE "%Remove-Service %")) OR ((process.command_line LIKE "%config%" AND process.command_line LIKE "%start=disabled%"))) AND (((process.pe.original_file_name == "net.exe" OR process.pe.original_file_name == "net1.exe" OR process.pe.original_file_name == "PowerShell_ISE.EXE" OR process.pe.original_file_name == "PowerShell.EXE" OR process.pe.original_file_name == "psservice.exe" OR process.pe.original_file_name == "pwsh.dll" OR process.pe.original_file_name == "sc.exe" OR process.pe.original_file_name == "wmic.exe")) OR ((process.executable LIKE "%\\net.exe" OR process.executable LIKE "%\\net1.exe" OR process.executable LIKE "%\\PowerShell_ISE.EXE" OR process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\PsService.exe" OR process.executable LIKE "%\\PsService64.exe" OR process.executable LIKE "%\\pwsh.exe" OR process.executable LIKE "%\\sc.exe" OR process.executable LIKE "%\\wmic.exe"))))
