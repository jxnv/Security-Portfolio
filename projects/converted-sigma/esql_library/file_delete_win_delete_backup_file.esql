// Title: Backup Files Deleted
// ID: 06125661-3814-4e03-bfa2-1e4411c60ac3
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-01-02
// Tags: attack.impact, attack.t1490
// Description: Detects deletion of files with extensions often used for backup files. Adversaries may delete or remove built-in operating system data and turn off services designed to aid in the recovery of a corrupted system to prevent recovery.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%\\cmd.exe" OR process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe" OR process.executable LIKE "%\\wt.exe" OR process.executable LIKE "%\\rundll32.exe" OR process.executable LIKE "%\\regsvr32.exe") AND (file.path LIKE "%.VHD" OR file.path LIKE "%.bac" OR file.path LIKE "%.bak" OR file.path LIKE "%.wbcat" OR file.path LIKE "%.bkf" OR file.path LIKE "%.set" OR file.path LIKE "%.win" OR file.path LIKE "%.dsk"))
