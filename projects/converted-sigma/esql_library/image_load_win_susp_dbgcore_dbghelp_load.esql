// Title: Suspicious Loading of Dbgcore/Dbghelp DLLs from Uncommon Location
// ID: 416bc4a2-7217-4519-8dc7-c3271817f1d5
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-11-27
// Tags: attack.credential-access, attack.defense-impairment, attack.t1003, attack.t1685
// Description: Detects loading of dbgcore.dll or dbghelp.dll from uncommon locations such as user directories.
// These DLLs contain the MiniDumpWriteDump function, which can be abused for credential dumping purposes or in some cases for evading EDR/AV detection by suspending processes.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((ImageLoaded LIKE "%\\dbgcore.dll" OR ImageLoaded LIKE "%\\dbghelp.dll")) AND ((process.executable LIKE "%:\\Perflogs\\%" OR process.executable LIKE "%:\\Temp\\%" OR process.executable LIKE "%:\\Users\\Public\\%" OR process.executable LIKE "%\\$Recycle.Bin\\%" OR process.executable LIKE "%\\Contacts\\%" OR process.executable LIKE "%\\Documents\\%" OR process.executable LIKE "%\\Favorites\\%" OR process.executable LIKE "%\\Favourites\\%" OR process.executable LIKE "%\\inetpub\\wwwroot\\%" OR process.executable LIKE "%\\Music\\%" OR process.executable LIKE "%\\Pictures\\%" OR process.executable LIKE "%\\Start Menu\\Programs\\Startup\\%" OR process.executable LIKE "%\\Users\\Default\\%" OR process.executable LIKE "%\\Videos\\%")))
