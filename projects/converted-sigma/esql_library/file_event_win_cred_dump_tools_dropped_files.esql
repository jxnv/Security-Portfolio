// Tags: attack.credential-access, attack.t1003.001, attack.t1003.002, attack.t1003.003, attack.t1003.004, attack.t1003.005
// Description: Files with well-known filenames (parts of credential dump software or files produced by them) creation
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((file.path LIKE "%\\fgdump-log%" OR file.path LIKE "%\\kirbi%" OR file.path LIKE "%\\pwdump%" OR file.path LIKE "%\\pwhashes%" OR file.path LIKE "%\\wce_ccache%" OR file.path LIKE "%\\wce_krbtkts%")) OR ((file.path LIKE "%\\cachedump.exe" OR file.path LIKE "%\\cachedump64.exe" OR file.path LIKE "%\\DumpExt.dll" OR file.path LIKE "%\\DumpSvc.exe" OR file.path LIKE "%\\Dumpy.exe" OR file.path LIKE "%\\fgexec.exe" OR file.path LIKE "%\\lsremora.dll" OR file.path LIKE "%\\lsremora64.dll" OR file.path LIKE "%\\NTDS.out" OR file.path LIKE "%\\procdump.exe" OR file.path LIKE "%\\procdump64.exe" OR file.path LIKE "%\\procdump64a.exe" OR file.path LIKE "%\\pstgdump.exe" OR file.path LIKE "%\\pwdump.exe" OR file.path LIKE "%\\SAM.out" OR file.path LIKE "%\\SECURITY.out" OR file.path LIKE "%\\servpw.exe" OR file.path LIKE "%\\servpw64.exe" OR file.path LIKE "%\\SYSTEM.out" OR file.path LIKE "%\\test.pwd" OR file.path LIKE "%\\wceaux.dll")))
