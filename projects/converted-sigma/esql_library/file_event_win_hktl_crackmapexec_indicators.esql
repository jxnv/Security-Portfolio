// Title: HackTool - CrackMapExec File Indicators
// ID: 736ffa74-5f6f-44ca-94ef-1c0df4f51d2a
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-03-11
// Tags: attack.credential-access, attack.t1003.001
// Description: Detects file creation events with filename patterns used by CrackMapExec.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((file.path LIKE "C:\\Windows\\Temp\\%") AND (((file.path RLIKE "\\\\[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.txt$") OR (file.path RLIKE "\\\\[a-zA-Z]{8}\\.tmp$")) OR ((file.path LIKE "%\\temp.ps1" OR file.path LIKE "%\\msol.ps1"))))
