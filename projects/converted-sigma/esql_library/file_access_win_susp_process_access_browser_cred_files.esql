// Title: Suspicious File Access to Browser Credential Storage
// ID: a1dfd976-4852-41d4-9507-dc6590a3ccd0
// Status: experimental
// Level: low
// Author: frack113, X__Junior (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems), Parth-FourCore
// Date: 2025-05-22
// Tags: attack.credential-access, attack.t1555.003, attack.discovery, attack.t1217
// Description: Detects file access to browser credential storage paths by non-browser processes, which may indicate credential access attempts.
// Adversaries may attempt to access browser credential storage to extract sensitive information such as usernames and passwords or cookies.
// This behavior is often commonly observed in credential stealing malware.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((FileName LIKE "%\\Sputnik\\Sputnik%" OR FileName LIKE "%\\MapleStudio\\ChromePlus%" OR FileName LIKE "%\\QIP Surf%" OR FileName LIKE "%\\BlackHawk%" OR FileName LIKE "%\\7Star\\7Star%" OR FileName LIKE "%\\CatalinaGroup\\Citrio%" OR FileName LIKE "%\\Google\\Chrome%" OR FileName LIKE "%\\Coowon\\Coowon%" OR FileName LIKE "%\\CocCoc\\Browser%" OR FileName LIKE "%\\uCozMedia\\Uran%" OR FileName LIKE "%\\Tencent\\QQBrowser%" OR FileName LIKE "%\\Orbitum%" OR FileName LIKE "%\\Slimjet%" OR FileName LIKE "%\\Iridium%" OR FileName LIKE "%\\Vivaldi%" OR FileName LIKE "%\\Chromium%" OR FileName LIKE "%\\GhostBrowser%" OR FileName LIKE "%\\CentBrowser%" OR FileName LIKE "%\\Xvast%" OR FileName LIKE "%\\Chedot%" OR FileName LIKE "%\\SuperBird%" OR FileName LIKE "%\\360Browser\\Browser%" OR FileName LIKE "%\\360Chrome\\Chrome%" OR FileName LIKE "%\\Comodo\\Dragon%" OR FileName LIKE "%\\BraveSoftware\\Brave-Browser%" OR FileName LIKE "%\\Torch%" OR FileName LIKE "%\\UCBrowser\\%" OR FileName LIKE "%\\Blisk%" OR FileName LIKE "%\\Epic Privacy Browser%" OR FileName LIKE "%\\Nichrome%" OR FileName LIKE "%\\Amigo%" OR FileName LIKE "%\\Kometa%" OR FileName LIKE "%\\Xpom%" OR FileName LIKE "%\\Microsoft\\Edge%" OR FileName LIKE "%\\Liebao7Default\\EncryptedStorage%" OR FileName LIKE "%\\AVAST Software\\Browser%" OR FileName LIKE "%\\Kinza%" OR FileName LIKE "%\\Mozilla\\SeaMonkey\\%" OR FileName LIKE "%\\Comodo\\IceDragon\\%" OR FileName LIKE "%\\8pecxstudios\\Cyberfox\\%" OR FileName LIKE "%\\FlashPeak\\SlimBrowser\\%" OR FileName LIKE "%\\Moonchild Productions\\Pale Moon\\%")) AND ((FileName LIKE "%\\Profiles\\%" OR FileName LIKE "%\\User Data%")) AND (((FileName LIKE "%\\Login Data%" OR FileName LIKE "%\\Cookies%" OR FileName LIKE "%\\EncryptedStorage%" OR FileName LIKE "%\\WebCache\\%")) OR ((FileName LIKE "%cert9.db" OR FileName LIKE "%cookies.sqlite" OR FileName LIKE "%formhistory.sqlite" OR FileName LIKE "%key3.db" OR FileName LIKE "%key4.db" OR FileName LIKE "%Login Data.sqlite" OR FileName LIKE "%logins.json" OR FileName LIKE "%places.sqlite")))) AND NOT ((((process.executable LIKE "C:\\Program Files\\%" OR process.executable LIKE "C:\\Program Files (x86)\\%" OR process.executable LIKE "C:\\Windows\\System32\\%" OR process.executable LIKE "C:\\Windows\\SysWOW64\\%")) OR ((process.executable LIKE "%\\Sputnik.exe" OR process.executable LIKE "%\\ChromePlus.exe" OR process.executable LIKE "%\\QIP Surf.exe" OR process.executable LIKE "%\\BlackHawk.exe" OR process.executable LIKE "%\\7Star.exe" OR process.executable LIKE "%\\Sleipnir5.exe" OR process.executable LIKE "%\\Citrio.exe" OR process.executable LIKE "%\\Chrome SxS.exe" OR process.executable LIKE "%\\Chrome.exe" OR process.executable LIKE "%\\Coowon.exe" OR process.executable LIKE "%\\CocCocBrowser.exe" OR process.executable LIKE "%\\Uran.exe" OR process.executable LIKE "%\\QQBrowser.exe" OR process.executable LIKE "%\\Orbitum.exe" OR process.executable LIKE "%\\Slimjet.exe" OR process.executable LIKE "%\\Iridium.exe" OR process.executable LIKE "%\\Vivaldi.exe" OR process.executable LIKE "%\\Chromium.exe" OR process.executable LIKE "%\\GhostBrowser.exe" OR process.executable LIKE "%\\CentBrowser.exe" OR process.executable LIKE "%\\Xvast.exe" OR process.executable LIKE "%\\Chedot.exe" OR process.executable LIKE "%\\SuperBird.exe" OR process.executable LIKE "%\\360Browser.exe" OR process.executable LIKE "%\\360Chrome.exe" OR process.executable LIKE "%\\dragon.exe" OR process.executable LIKE "%\\brave.exe" OR process.executable LIKE "%\\torch.exe" OR process.executable LIKE "%\\UCBrowser.exe" OR process.executable LIKE "%\\BliskBrowser.exe" OR process.executable LIKE "%\\Epic Privacy Browser.exe" OR process.executable LIKE "%\\nichrome.exe" OR process.executable LIKE "%\\AmigoBrowser.exe" OR process.executable LIKE "%\\KometaBrowser.exe" OR process.executable LIKE "%\\XpomBrowser.exe" OR process.executable LIKE "%\\msedge.exe" OR process.executable LIKE "%\\LiebaoBrowser.exe" OR process.executable LIKE "%\\AvastBrowser.exe" OR process.executable LIKE "%\\Kinza.exe" OR process.executable LIKE "%\\seamonkey.exe" OR process.executable LIKE "%\\icedragon.exe" OR process.executable LIKE "%\\cyberfox.exe" OR process.executable LIKE "%\\SlimBrowser.exe" OR process.executable LIKE "%\\palemoon.exe")) OR ((process.executable LIKE "%\\Sputnik\\%" OR process.executable LIKE "%\\MapleStudio\\%" OR process.executable LIKE "%\\QIP Surf\\%" OR process.executable LIKE "%\\BlackHawk\\%" OR process.executable LIKE "%\\7Star\\%" OR process.executable LIKE "%\\Fenrir Inc\\%" OR process.executable LIKE "%\\CatalinaGroup\\%" OR process.executable LIKE "%\\Google\\%" OR process.executable LIKE "%\\Coowon\\%" OR process.executable LIKE "%\\CocCoc\\%" OR process.executable LIKE "%\\uCozMedia\\%" OR process.executable LIKE "%\\Tencent\\%" OR process.executable LIKE "%\\Orbitum\\%" OR process.executable LIKE "%\\Slimjet\\%" OR process.executable LIKE "%\\Iridium\\%" OR process.executable LIKE "%\\Vivaldi\\%" OR process.executable LIKE "%\\Chromium\\%" OR process.executable LIKE "%\\GhostBrowser\\%" OR process.executable LIKE "%\\CentBrowser\\%" OR process.executable LIKE "%\\Xvast\\%" OR process.executable LIKE "%\\Chedot\\%" OR process.executable LIKE "%\\SuperBird\\%" OR process.executable LIKE "%\\360Browser\\%" OR process.executable LIKE "%\\360Chrome\\%" OR process.executable LIKE "%\\Comodo\\%" OR process.executable LIKE "%\\BraveSoftware\\%" OR process.executable LIKE "%\\Torch\\%" OR process.executable LIKE "%\\UCBrowser\\%" OR process.executable LIKE "%\\Blisk\\%" OR process.executable LIKE "%\\Epic Privacy Browser\\%" OR process.executable LIKE "%\\Nichrome\\%" OR process.executable LIKE "%\\Amigo\\%" OR process.executable LIKE "%\\Kometa\\%" OR process.executable LIKE "%\\Xpom\\%" OR process.executable LIKE "%\\Microsoft\\%" OR process.executable LIKE "%\\Liebao7\\%" OR process.executable LIKE "%\\AVAST Software\\%" OR process.executable LIKE "%\\Kinza\\%" OR process.executable LIKE "%\\Mozilla\\%" OR process.executable LIKE "%\\8pecxstudios\\%" OR process.executable LIKE "%\\FlashPeak\\%" OR process.executable LIKE "%\\Moonchild Productions\\%")) OR (process.executable == "System" AND process.parent.executable == "Idle"))) AND NOT (((process.executable LIKE "%\\Microsoft\\Windows Defender\\%" AND (process.executable LIKE "%\\MpCopyAccelerator.exe" OR process.executable LIKE "%\\MsMpEng.exe")) OR (process.parent.executable == "C:\\Windows\\System32\\msiexec.exe") OR (process.executable LIKE "%\\everything.exe") OR ((process.executable LIKE "%\\thor.exe" OR process.executable LIKE "%\\thor64.exe")))))
