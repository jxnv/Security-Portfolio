// Title: Potential Defense Evasion Via Raw Disk Access By Uncommon Tools
// ID: db809f10-56ce-4420-8c86-d6a7d793c79c
// Status: test
// Level: low
// Author: Teymur Kheirkhabarov, oscd.community
// Date: 2019-10-22
// Tags: attack.stealth, attack.t1006
// Description: Detects raw disk access using uncommon tools or tools that are located in suspicious locations (heavy filtering is required), which could indicate possible defense evasion attempts
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (NOT (((Device LIKE "%floppy%") OR ((process.executable LIKE "C:\\$WINDOWS.~BT\\%" OR process.executable LIKE "C:\\Program Files (x86)\\%" OR process.executable LIKE "C:\\Program Files\\%" OR process.executable LIKE "C:\\Windows\\CCM\\%" OR process.executable LIKE "C:\\Windows\\explorer.exe%" OR process.executable LIKE "C:\\Windows\\servicing\\%" OR process.executable LIKE "C:\\Windows\\SoftwareDistribution\\%" OR process.executable LIKE "C:\\Windows\\System32\\%" OR process.executable LIKE "C:\\Windows\\SystemApps\\%" OR process.executable LIKE "C:\\Windows\\SysWOW64\\%" OR process.executable LIKE "C:\\Windows\\uus\\%" OR process.executable LIKE "C:\\Windows\\WinSxS\\%")) OR (process.executable LIKE "C:\\Users\\%" AND (process.executable LIKE "%\\AppData\\%" AND process.executable LIKE "%\\Microsoft\\%")) OR (process.executable IS NULL) OR (process.executable LIKE "C:\\Windows\\Temp\\%" AND (process.executable LIKE "%\\Executables\\SSDUpdate.exe" OR process.executable LIKE "%\\HostMetadata\\NVMEHostmetadata.exe")) OR ((process.executable == "Registry" OR process.executable == "System")) OR (process.executable == "C:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe") OR (process.executable LIKE "C:\\$WinREAgent\\Scratch\\%") OR (process.executable LIKE "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\%" AND (process.executable LIKE "%\\MsMpEng.exe" OR process.executable LIKE "%\\MpDefenderCoreService.exe")))) AND NOT (((process.executable LIKE "C:\\Users\\%" AND process.executable LIKE "%\\AppData\\Local\\Keybase\\upd.exe%") OR (process.executable LIKE "C:\\Users\\%" AND process.executable LIKE "%\\AppData\\Local\\GitHubDesktop\\app-%" AND process.executable LIKE "%\\resources\\app\\git\\mingw64\\bin\\git.exe") OR (process.executable LIKE "C:\\Windows\\Temp\\asgard2-agent\\%" AND process.executable LIKE "%\\thor.exe"))))
