// Title: HackTool - Inveigh Execution
// ID: b99a1518-1ad5-4f65-bc95-1ffff97a8fd0
// Status: test
// Level: critical
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-24
// Tags: attack.credential-access, attack.t1003.001
// Description: Detects the use of Inveigh a cross-platform .NET IPv4/IPv6 machine-in-the-middle tool
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%\\Inveigh.exe") OR ((process.pe.original_file_name == "\\Inveigh.exe" OR process.pe.original_file_name == "\\Inveigh.dll")) OR (Description == "Inveigh") OR ((process.command_line LIKE "% -SpooferIP%" OR process.command_line LIKE "% -ReplyToIPs %" OR process.command_line LIKE "% -ReplyToDomains %" OR process.command_line LIKE "% -ReplyToMACs %" OR process.command_line LIKE "% -SnifferIP%")))
