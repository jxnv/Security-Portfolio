// Title: Browser Execution In Headless Mode
// ID: ef9dcfed-690c-4c5d-a9d1-482cd422225c
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-09-12
// Tags: attack.command-and-control, attack.stealth, attack.t1105, attack.t1564.003
// Description: Detects execution of Chromium based browser in headless mode
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%\\brave.exe" OR process.executable LIKE "%\\chrome.exe" OR process.executable LIKE "%\\msedge.exe" OR process.executable LIKE "%\\opera.exe" OR process.executable LIKE "%\\vivaldi.exe") AND process.command_line LIKE "%--headless%")
