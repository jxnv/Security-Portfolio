// Title: Using SettingSyncHost.exe as LOLBin
// ID: b2ddd389-f676-4ac4-845a-e00781a48e5f
// Status: test
// Level: high
// Author: Anton Kutepov, oscd.community
// Date: 2020-02-05
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.stealth, attack.t1574.008
// Description: Detects using SettingSyncHost.exe to run hijacked binary
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (NOT (((process.executable LIKE "C:\\Windows\\System32\\%" OR process.executable LIKE "C:\\Windows\\SysWOW64\\%"))) AND ((process.parent.command_line LIKE "%cmd.exe /c%" AND process.parent.command_line LIKE "%RoamDiag.cmd%" AND process.parent.command_line LIKE "%-outputpath%")))
