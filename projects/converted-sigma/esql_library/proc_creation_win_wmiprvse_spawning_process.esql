// Title: WmiPrvSE Spawned A Process
// ID: d21374ff-f574-44a7-9998-4a8c8bf33d7d
// Status: stable
// Level: medium
// Author: Roberto Rodriguez @Cyb3rWard0g
// Date: 2019-08-15
// Tags: attack.execution, attack.t1047
// Description: Detects WmiPrvSE spawning a process
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.parent.executable LIKE "%\\WmiPrvSe.exe") AND NOT ((((LogonId == "0x3e7" OR LogonId == "null")) OR (LogonId IS NULL) OR ((user.name LIKE "%AUTHORI%" OR user.name LIKE "%AUTORI%")) OR (process.executable LIKE "%\\WerFault.exe") OR (process.executable LIKE "%\\WmiPrvSE.exe"))))
