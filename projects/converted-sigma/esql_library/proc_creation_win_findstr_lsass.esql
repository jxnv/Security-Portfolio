// Title: LSASS Process Reconnaissance Via Findstr.EXE
// ID: fe63010f-8823-4864-a96b-a7b4a0f7b929
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-08-12
// Tags: attack.credential-access, attack.t1552.006
// Description: Detects findstring commands that include the keyword lsass, which indicates recon actviity for the LSASS process PID
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%lsass%") AND (((process.executable LIKE "%\\find.exe" OR process.executable LIKE "%\\findstr.exe")) OR ((process.pe.original_file_name == "FIND.EXE" OR process.pe.original_file_name == "FINDSTR.EXE")))) OR ((process.command_line LIKE "% /i \"lsass%" OR process.command_line LIKE "% /i lsass.exe%" OR process.command_line LIKE "%findstr \"lsass%" OR process.command_line LIKE "%findstr lsass%" OR process.command_line LIKE "%findstr.exe \"lsass%" OR process.command_line LIKE "%findstr.exe lsass%")))
