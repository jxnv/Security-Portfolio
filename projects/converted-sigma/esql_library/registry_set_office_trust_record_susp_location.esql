// Title: Macro Enabled In A Potentially Suspicious Document
// ID: a166f74e-bf44-409d-b9ba-ea4b2dd8b3cd
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-21
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects registry changes to Office trust records where the path is located in a potentially suspicious location
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((registry.path LIKE "%/AppData/Local/Microsoft/Windows/INetCache/%" OR registry.path LIKE "%/AppData/Local/Temp/%" OR registry.path LIKE "%/PerfLogs/%" OR registry.path LIKE "%C:/Users/Public/%" OR registry.path LIKE "%file:///D:/%" OR registry.path LIKE "%file:///E:/%")) AND (registry.path LIKE "%\\Security\\Trusted Documents\\TrustRecords%"))
