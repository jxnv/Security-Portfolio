// Title: Potential File Extension Spoofing Using Right-to-Left Override
// ID: 979baf41-ca44-4540-9d0c-4fcef3b5a3a4
// Status: test
// Level: high
// Author: Jonathan Peters (Nextron Systems), Florian Roth (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2024-11-17
// Tags: attack.execution, attack.stealth, attack.t1036.002
// Description: Detects suspicious filenames that contain a right-to-left override character and a potentially spoofed file extensions.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((file.path LIKE "%3pm.%" OR file.path LIKE "%4pm.%" OR file.path LIKE "%cod.%" OR file.path LIKE "%fdp.%" OR file.path LIKE "%ftr.%" OR file.path LIKE "%gepj.%" OR file.path LIKE "%gnp.%" OR file.path LIKE "%gpj.%" OR file.path LIKE "%ism.%" OR file.path LIKE "%lmth.%" OR file.path LIKE "%nls.%" OR file.path LIKE "%piz.%" OR file.path LIKE "%slx.%" OR file.path LIKE "%tdo.%" OR file.path LIKE "%vsc.%" OR file.path LIKE "%vwm.%" OR file.path LIKE "%xcod.%" OR file.path LIKE "%xslx.%" OR file.path LIKE "%xtpp.%")) AND ((file.path LIKE "%\\u202e%" OR file.path LIKE "%[U+202E]%" OR file.path LIKE "%‮%")))
