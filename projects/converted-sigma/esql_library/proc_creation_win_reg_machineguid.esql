// Title: Suspicious Query of MachineGUID
// ID: f5240972-3938-4e56-8e4b-e33893176c1f
// Status: test
// Level: low
// Author: frack113
// Date: 2022-01-01
// Tags: attack.discovery, attack.t1082
// Description: Use of reg to get MachineGuid information
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (process.executable LIKE "%\\reg.exe" AND (process.command_line LIKE "%SOFTWARE\\Microsoft\\Cryptography%" AND process.command_line LIKE "%/v %" AND process.command_line LIKE "%MachineGuid%"))
