// Title: Potential SentinelOne Shell Context Menu Scan Command Tampering
// ID: 6c304b02-06e6-402d-8be4-d5833cdf8198
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-03-06
// Tags: attack.persistence
// Description: Detects potentially suspicious changes to the SentinelOne context menu scan command by a process other than SentinelOne.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((registry.path LIKE "%\\shell\\SentinelOneScan\\command\\%") AND NOT ((((process.executable LIKE "%C:\\Program Files\\SentinelOne\\" OR process.executable LIKE "%C:\\Program Files (x86)\\SentinelOne\\")) OR ((registry.data.strings LIKE "C:\\Program Files\\SentinelOne\\Sentinel Agent%" OR registry.data.strings LIKE "C:\\Program Files (x86)\\SentinelOne\\Sentinel Agent%") AND registry.data.strings LIKE "%\\SentinelScanFromContextMenu.exe%"))))
