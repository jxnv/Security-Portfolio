// Title: PUA - AdFind Suspicious Execution
// ID: 9a132afa-654e-11eb-ae93-0242ac130002
// Status: test
// Level: high
// Author: Janantha Marasinghe (https://github.com/blueteam0ps), FPT.EagleEye Team, omkar72, oscd.community
// Date: 2021-02-02
// Tags: attack.discovery, attack.t1018, attack.t1087.002, attack.t1482, attack.t1069.002, stp.1u
// Description: Detects AdFind execution with common flags seen used during attacks
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.command_line LIKE "%domainlist%" OR process.command_line LIKE "%trustdmp%" OR process.command_line LIKE "%dcmodes%" OR process.command_line LIKE "%adinfo%" OR process.command_line LIKE "%-sc dclist%" OR process.command_line LIKE "%computer_pwdnotreqd%" OR process.command_line LIKE "%objectcategory=%" OR process.command_line LIKE "%-subnets -f%" OR process.command_line LIKE "%name=\"Domain Admins\"%" OR process.command_line LIKE "%-sc u:%" OR process.command_line LIKE "%domainncs%" OR process.command_line LIKE "%dompol%" OR process.command_line LIKE "% oudmp %" OR process.command_line LIKE "%subnetdmp%" OR process.command_line LIKE "%gpodmp%" OR process.command_line LIKE "%fspdmp%" OR process.command_line LIKE "%users_noexpire%" OR process.command_line LIKE "%computers_active%" OR process.command_line LIKE "%computers_pwdnotreqd%"))
