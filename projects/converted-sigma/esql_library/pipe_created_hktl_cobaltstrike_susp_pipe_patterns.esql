// Title: CobaltStrike Named Pipe Patterns
// ID: 85adeb13-4fc9-4e68-8a4a-c7cb2c336eb7
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Christian Burkard (Nextron Systems)
// Date: 2021-07-30
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055, stp.1k
// Description: Detects the creation of a named pipe with a pattern found in CobaltStrike malleable C2 profiles
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((PipeName LIKE "\\Winsock2\\CatalogChangeListener-%" AND PipeName LIKE "%-0,") OR (((PipeName LIKE "\\DserNamePipe%" OR PipeName LIKE "\\f4c3%" OR PipeName LIKE "\\f53f%" OR PipeName LIKE "\\fullduplex_%" OR PipeName LIKE "\\mojo.5688.8052.183894939787088877%" OR PipeName LIKE "\\mojo.5688.8052.35780273329370473%" OR PipeName LIKE "\\MsFteWds%" OR PipeName LIKE "\\msrpc_%" OR PipeName LIKE "\\mypipe-f%" OR PipeName LIKE "\\mypipe-h%" OR PipeName LIKE "\\ntsvcs%" OR PipeName LIKE "\\PGMessagePipe%" OR PipeName LIKE "\\rpc_%" OR PipeName LIKE "\\scerpc%" OR PipeName LIKE "\\SearchTextHarvester%" OR PipeName LIKE "\\spoolss%" OR PipeName LIKE "\\win_svc%" OR PipeName LIKE "\\win\\msrpc_%" OR PipeName LIKE "\\windows.update.manager%" OR PipeName LIKE "\\wkssvc%")) OR ((PipeName == "\\demoagent_11" OR PipeName == "\\demoagent_22")))) AND NOT (((PipeName == "\\wkssvc" OR PipeName == "\\spoolss" OR PipeName == "\\scerpc" OR PipeName == "\\ntsvcs" OR PipeName == "\\SearchTextHarvester" OR PipeName == "\\PGMessagePipe" OR PipeName == "\\MsFteWds"))) AND NOT (((process.executable LIKE "%:\\Program Files\\Websense\\%" OR process.executable LIKE "%:\\Program Files (x86)\\Websense\\%") AND (PipeName LIKE "\\DserNamePipeR%" OR PipeName LIKE "\\DserNamePipeW%"))))
