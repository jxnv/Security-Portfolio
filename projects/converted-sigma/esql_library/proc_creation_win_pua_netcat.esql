// Title: PUA - Netcat Suspicious Execution
// ID: e31033fc-33f0-4020-9a16-faf9b31cbf08
// Status: test
// Level: high
// Author: frack113, Florian Roth (Nextron Systems)
// Date: 2021-07-21
// Tags: attack.command-and-control, attack.t1095
// Description: Detects execution of Netcat. Adversaries may use a non-application layer protocol for communication between host and C2 server or among infected hosts within a network
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "% -lvp %" OR process.command_line LIKE "% -lvnp%" OR process.command_line LIKE "% -l -v -p %" OR process.command_line LIKE "% -lv -p %" OR process.command_line LIKE "% -l --proxy-type http %" OR process.command_line LIKE "% -vnl --exec %" OR process.command_line LIKE "% -vnl -e %" OR process.command_line LIKE "% --lua-exec %" OR process.command_line LIKE "% --sh-exec %")) OR ((process.executable LIKE "%\\nc.exe" OR process.executable LIKE "%\\ncat.exe" OR process.executable LIKE "%\\netcat.exe")))
