// Title: Potentially Suspicious Rundll32 Activity
// ID: e593cf51-88db-4ee1-b920-37e89012a3c9
// Status: test
// Level: medium
// Author: juju4, Jonhnathan Ribeiro, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-01-16
// Tags: attack.stealth, attack.t1218.011
// Description: Detects suspicious execution of rundll32, with specific calls to some DLLs with known LOLBIN functionalities
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.command_line LIKE "%javascript:%" AND process.command_line LIKE "%.RegisterXLL%")) OR ((process.command_line LIKE "%url.dll%" AND process.command_line LIKE "%OpenURL%")) OR ((process.command_line LIKE "%url.dll%" AND process.command_line LIKE "%OpenURLA%")) OR ((process.command_line LIKE "%url.dll%" AND process.command_line LIKE "%FileProtocolHandler%")) OR ((process.command_line LIKE "%zipfldr.dll%" AND process.command_line LIKE "%RouteTheCall%")) OR ((process.command_line LIKE "%shell32.dll%" AND process.command_line LIKE "%Control_RunDLL%")) OR ((process.command_line LIKE "%shell32.dll%" AND process.command_line LIKE "%ShellExec_RunDLL%")) OR ((process.command_line LIKE "%mshtml.dll%" AND process.command_line LIKE "%PrintHTML%")) OR ((process.command_line LIKE "%advpack.dll%" AND process.command_line LIKE "%LaunchINFSection%")) OR ((process.command_line LIKE "%advpack.dll%" AND process.command_line LIKE "%RegisterOCX%")) OR ((process.command_line LIKE "%ieadvpack.dll%" AND process.command_line LIKE "%LaunchINFSection%")) OR ((process.command_line LIKE "%ieadvpack.dll%" AND process.command_line LIKE "%RegisterOCX%")) OR ((process.command_line LIKE "%ieframe.dll%" AND process.command_line LIKE "%OpenURL%")) OR ((process.command_line LIKE "%shdocvw.dll%" AND process.command_line LIKE "%OpenURL%")) OR ((process.command_line LIKE "%syssetup.dll%" AND process.command_line LIKE "%SetupInfObjectInstallAction%")) OR ((process.command_line LIKE "%setupapi.dll%" AND process.command_line LIKE "%InstallHinfSection%")) OR ((process.command_line LIKE "%pcwutl.dll%" AND process.command_line LIKE "%LaunchApplication%")) OR ((process.command_line LIKE "%dfshim.dll%" AND process.command_line LIKE "%ShOpenVerbApplication%")) OR ((process.command_line LIKE "%dfshim.dll%" AND process.command_line LIKE "%ShOpenVerbShortcut%")) OR ((process.command_line LIKE "%scrobj.dll%" AND process.command_line LIKE "%GenerateTypeLib%" AND process.command_line LIKE "%http%")) OR ((process.command_line LIKE "%shimgvw.dll%" AND process.command_line LIKE "%ImageView_Fullscreen%" AND process.command_line LIKE "%http%")) OR ((process.command_line LIKE "%comsvcs.dll%" AND process.command_line LIKE "%MiniDump%"))) AND NOT (((process.parent.executable == "C:\\Windows\\System32\\control.exe" AND process.parent.command_line LIKE "%.cpl%" AND (process.command_line LIKE "%Shell32.dll%" AND process.command_line LIKE "%Control_RunDLL%" AND process.command_line LIKE "%.cpl%")) OR (process.command_line LIKE "%shell32.dll,Control_RunDLL desk.cpl,screensaver,@screensaver%") OR (process.parent.executable == "C:\\Windows\\System32\\control.exe" AND process.command_line LIKE "\"C:\\Windows\\system32\\rundll32.exe\" Shell32.dll,Control_RunDLL \"C:\\Windows\\System32\\%" AND process.command_line LIKE "%.cpl\","))))
