// Title: Renamed Office Binary Execution
// ID: 0b0cd537-fc77-4e6e-a973-e53495c1083d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-20
// Tags: attack.stealth, attack.t1036.003
// Description: Detects the execution of a renamed office binary
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.pe.original_file_name == "Excel.exe" OR process.pe.original_file_name == "MSACCESS.EXE" OR process.pe.original_file_name == "MSPUB.EXE" OR process.pe.original_file_name == "OneNote.exe" OR process.pe.original_file_name == "OneNoteM.exe" OR process.pe.original_file_name == "OUTLOOK.EXE" OR process.pe.original_file_name == "POWERPNT.EXE" OR process.pe.original_file_name == "WinWord.exe" OR process.pe.original_file_name == "Olk.exe")) OR ((Description == "Microsoft Access" OR Description == "Microsoft Excel" OR Description == "Microsoft OneNote" OR Description == "Microsoft Outlook" OR Description == "Microsoft PowerPoint" OR Description == "Microsoft Publisher" OR Description == "Microsoft Word" OR Description == "Sent to OneNote Tool"))) AND NOT (((process.executable LIKE "%\\EXCEL.exe" OR process.executable LIKE "%\\excelcnv.exe" OR process.executable LIKE "%\\MSACCESS.exe" OR process.executable LIKE "%\\MSPUB.EXE" OR process.executable LIKE "%\\ONENOTE.EXE" OR process.executable LIKE "%\\ONENOTEM.EXE" OR process.executable LIKE "%\\OUTLOOK.EXE" OR process.executable LIKE "%\\POWERPNT.EXE" OR process.executable LIKE "%\\WINWORD.exe" OR process.executable LIKE "%\\OLK.EXE"))))
