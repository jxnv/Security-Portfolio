// Title: DotNET Assembly DLL Loaded Via Office Application
// ID: ff0f2b05-09db-4095-b96d-1b75ca24894a
// Status: test
// Level: medium
// Author: Antonlovesdnb
// Date: 2020-02-19
// Tags: attack.execution, attack.t1204.002
// Description: Detects any assembly DLL being loaded by an Office Product
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%\\excel.exe" OR process.executable LIKE "%\\mspub.exe" OR process.executable LIKE "%\\onenote.exe" OR process.executable LIKE "%\\onenoteim.exe" OR process.executable LIKE "%\\outlook.exe" OR process.executable LIKE "%\\powerpnt.exe" OR process.executable LIKE "%\\winword.exe") AND ImageLoaded LIKE "C:\\Windows\\assembly\\%")
