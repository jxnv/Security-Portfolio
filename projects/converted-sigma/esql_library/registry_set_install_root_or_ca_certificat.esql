// Title: New Root or CA or AuthRoot Certificate to Store
// ID: d223b46b-5621-4037-88fe-fda32eead684
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-04-04
// Tags: attack.impact, attack.t1490
// Description: Detects the addition of new root, CA or AuthRoot certificates to the Windows registry
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((registry.path LIKE "%\\SOFTWARE\\Microsoft\\SystemCertificates\\Root\\Certificates\\%" OR registry.path LIKE "%\\SOFTWARE\\Policies\\Microsoft\\SystemCertificates\\Root\\Certificates\\%" OR registry.path LIKE "%\\SOFTWARE\\Microsoft\\EnterpriseCertificates\\Root\\Certificates\\%" OR registry.path LIKE "%\\SOFTWARE\\Microsoft\\SystemCertificates\\CA\\Certificates\\%" OR registry.path LIKE "%\\SOFTWARE\\Policies\\Microsoft\\SystemCertificates\\CA\\Certificates\\%" OR registry.path LIKE "%\\SOFTWARE\\Microsoft\\EnterpriseCertificates\\CA\\Certificates\\%" OR registry.path LIKE "%\\SOFTWARE\\Microsoft\\SystemCertificates\\AuthRoot\\Certificates\\%" OR registry.path LIKE "%\\SOFTWARE\\Policies\\Microsoft\\SystemCertificates\\AuthRoot\\Certificates\\%" OR registry.path LIKE "%\\SOFTWARE\\Microsoft\\EnterpriseCertificates\\AuthRoot\\Certificates\\%") AND registry.path LIKE "%\\Blob" AND registry.data.strings == "Binary Data")
