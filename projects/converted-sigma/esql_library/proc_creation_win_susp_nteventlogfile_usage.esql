// Title: Potentially Suspicious Call To Win32_NTEventlogFile Class
// ID: caf201a9-c2ce-4a26-9c3a-2b9525413711
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-07-13
// Tags: attack.defense-impairment
// Description: Detects usage of the WMI class "Win32_NTEventlogFile" in a potentially suspicious way (delete, backup, change permissions, etc.) from a PowerShell script
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.command_line LIKE "%Win32_NTEventlogFile%") AND ((process.command_line LIKE "%.BackupEventlog(%" OR process.command_line LIKE "%.ChangeSecurityPermissions(%" OR process.command_line LIKE "%.ChangeSecurityPermissionsEx(%" OR process.command_line LIKE "%.ClearEventLog(%" OR process.command_line LIKE "%.Delete(%" OR process.command_line LIKE "%.DeleteEx(%" OR process.command_line LIKE "%.Rename(%" OR process.command_line LIKE "%.TakeOwnerShip(%" OR process.command_line LIKE "%.TakeOwnerShipEx(%")))
