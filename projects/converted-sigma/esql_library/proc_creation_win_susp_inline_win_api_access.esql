// Title: Potential WinAPI Calls Via CommandLine
// ID: ba3f5c1b-6272-4119-9dbd-0bc8d21c2702
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-06
// Tags: attack.execution, attack.t1106
// Description: Detects the use of WinAPI Functions via the commandline. As seen used by threat actors via the tool winapiexec
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%AddSecurityPackage%" OR process.command_line LIKE "%AdjustTokenPrivileges%" OR process.command_line LIKE "%Advapi32%" OR process.command_line LIKE "%CloseHandle%" OR process.command_line LIKE "%CreateProcessWithToken%" OR process.command_line LIKE "%CreatePseudoConsole%" OR process.command_line LIKE "%CreateRemoteThread%" OR process.command_line LIKE "%CreateThread%" OR process.command_line LIKE "%CreateUserThread%" OR process.command_line LIKE "%DangerousGetHandle%" OR process.command_line LIKE "%DuplicateTokenEx%" OR process.command_line LIKE "%EnumerateSecurityPackages%" OR process.command_line LIKE "%FreeHGlobal%" OR process.command_line LIKE "%FreeLibrary%" OR process.command_line LIKE "%GetDelegateForFunctionPointer%" OR process.command_line LIKE "%GetLogonSessionData%" OR process.command_line LIKE "%GetModuleHandle%" OR process.command_line LIKE "%GetProcAddress%" OR process.command_line LIKE "%GetProcessHandle%" OR process.command_line LIKE "%GetTokenInformation%" OR process.command_line LIKE "%ImpersonateLoggedOnUser%" OR process.command_line LIKE "%kernel32%" OR process.command_line LIKE "%LoadLibrary%" OR process.command_line LIKE "%memcpy%" OR process.command_line LIKE "%MiniDumpWriteDump%" OR process.command_line LIKE "%ntdll%" OR process.command_line LIKE "%OpenDesktop%" OR process.command_line LIKE "%OpenProcess%" OR process.command_line LIKE "%OpenProcessToken%" OR process.command_line LIKE "%OpenThreadToken%" OR process.command_line LIKE "%OpenWindowStation%" OR process.command_line LIKE "%PtrToString%" OR process.command_line LIKE "%QueueUserApc%" OR process.command_line LIKE "%ReadProcessMemory%" OR process.command_line LIKE "%RevertToSelf%" OR process.command_line LIKE "%RtlCreateUserThread%" OR process.command_line LIKE "%secur32%" OR process.command_line LIKE "%SetThreadToken%" OR process.command_line LIKE "%VirtualAlloc%" OR process.command_line LIKE "%VirtualFree%" OR process.command_line LIKE "%VirtualProtect%" OR process.command_line LIKE "%WaitForSingleObject%" OR process.command_line LIKE "%WriteInt32%" OR process.command_line LIKE "%WriteProcessMemory%" OR process.command_line LIKE "%ZeroFreeGlobalAllocUnicode%")) AND NOT (((process.parent.executable LIKE "%\\CompatTelRunner.exe" AND (process.command_line LIKE "%FreeHGlobal%" OR process.command_line LIKE "%PtrToString%" OR process.command_line LIKE "%kernel32%" OR process.command_line LIKE "%CloseHandle%")) OR (process.executable LIKE "%\\MpCmdRun.exe" AND process.command_line LIKE "%GetLoadLibraryWAddress32%"))))
