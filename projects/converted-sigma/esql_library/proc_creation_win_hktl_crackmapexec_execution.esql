// Title: HackTool - CrackMapExec Execution
// ID: 42a993dd-bb3e-48c8-b372-4d6684c4106c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-25
// Tags: attack.execution, attack.persistence, attack.privilege-escalation, attack.credential-access, attack.discovery, attack.t1047, attack.t1053, attack.t1059.003, attack.t1059.001, attack.t1110, attack.t1201
// Description: This rule detect common flag combinations used by CrackMapExec in order to detect its use even if the binary has been replaced.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%\\crackmapexec.exe") OR ((process.command_line LIKE "% --local-auth%" AND process.command_line LIKE "% -u %" AND process.command_line LIKE "% -x %")) OR ((process.command_line LIKE "% --local-auth%" AND process.command_line LIKE "% -u %" AND process.command_line LIKE "% -p %" AND process.command_line LIKE "% -H 'NTHASH'%")) OR ((process.command_line LIKE "% mssql %" AND process.command_line LIKE "% -u %" AND process.command_line LIKE "% -p %" AND process.command_line LIKE "% -M %" AND process.command_line LIKE "% -d %")) OR ((process.command_line LIKE "% smb %" AND process.command_line LIKE "% -u %" AND process.command_line LIKE "% -H %" AND process.command_line LIKE "% -M %" AND process.command_line LIKE "% -o %")) OR ((process.command_line LIKE "% smb %" AND process.command_line LIKE "% -u %" AND process.command_line LIKE "% -p %" AND process.command_line LIKE "% --local-auth%")) OR (process.command_line LIKE "% -M pe_inject %")) OR (((process.command_line LIKE "% --local-auth%" AND process.command_line LIKE "% -u %" AND process.command_line LIKE "% -p %")) AND ((process.command_line LIKE "% 10.%" AND process.command_line LIKE "% 192.168.%" AND process.command_line LIKE "%/24 %"))))
