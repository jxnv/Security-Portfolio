// Title: Suspicious Service Binary Directory
// ID: 883faa95-175a-4e22-8181-e5761aeb373c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-03-09
// Tags: attack.stealth, attack.t1202
// Description: Detects a service binary running in a suspicious directory
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%\\Users\\Public\\%" OR process.executable LIKE "%\\$Recycle.bin%" OR process.executable LIKE "%\\Users\\All Users\\%" OR process.executable LIKE "%\\Users\\Default\\%" OR process.executable LIKE "%\\Users\\Contacts\\%" OR process.executable LIKE "%\\Users\\Searches\\%" OR process.executable LIKE "%C:\\Perflogs\\%" OR process.executable LIKE "%\\config\\systemprofile\\%" OR process.executable LIKE "%\\Windows\\Fonts\\%" OR process.executable LIKE "%\\Windows\\IME\\%" OR process.executable LIKE "%\\Windows\\addins\\%") AND (process.parent.executable LIKE "%\\services.exe" OR process.parent.executable LIKE "%\\svchost.exe"))
