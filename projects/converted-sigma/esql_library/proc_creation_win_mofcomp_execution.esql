// Title: Potentially Suspicious Mofcomp Execution
// ID: 1dd05363-104e-4b4a-b963-196a534b03a1
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-12
// Tags: attack.stealth, attack.t1218
// Description: Detects execution of the "mofcomp" utility as a child of a suspicious shell or script running utility or by having a suspicious path in the commandline.
// The "mofcomp" utility parses a file containing MOF statements and adds the classes and class instances defined in the file to the WMI repository.
// Attackers abuse this utility to install malicious MOF scripts
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((((process.parent.executable LIKE "%\\cmd.exe" OR process.parent.executable LIKE "%\\powershell.exe" OR process.parent.executable LIKE "%\\pwsh.exe" OR process.parent.executable LIKE "%\\wsl.exe" OR process.parent.executable LIKE "%\\wscript.exe" OR process.parent.executable LIKE "%\\cscript.exe")) OR ((process.command_line LIKE "%\\AppData\\Local\\Temp%" OR process.command_line LIKE "%\\Contacts\\%" OR process.command_line LIKE "%\\Favorites\\%" OR process.command_line LIKE "%\\Favourites\\%" OR process.command_line LIKE "%\\Music\\%" OR process.command_line LIKE "%\\Pictures\\%" OR process.command_line LIKE "%\\Users\\Public\\%" OR process.command_line LIKE "%\\Videos\\%" OR process.command_line LIKE "%\\WINDOWS\\Temp\\%" OR process.command_line LIKE "%%appdata%%" OR process.command_line LIKE "%%temp%%" OR process.command_line LIKE "%%tmp%%"))) AND ((process.executable LIKE "%\\mofcomp.exe") OR (process.pe.original_file_name == "mofcomp.exe"))) AND NOT (((process.parent.command_line LIKE "%\\InstallUtil.exe /Uninstall C:\\Windows\\CCM\\Microsoft.ConfigurationManager.SVProvider.dll" AND process.parent.executable LIKE "%\\InstallUtil.exe" AND (process.command_line LIKE "%C:\\Windows\\TEMP%" AND process.command_line LIKE "%.tmp%")) OR (process.parent.executable == "C:\\Windows\\System32\\wbem\\WmiPrvSE.exe" AND process.command_line LIKE "%C:\\Windows\\TEMP\\%" AND process.command_line LIKE "%.mof"))) AND NOT ((process.parent.command_line IS NULL)))
