// Title: Suspicious Executable File Creation
// ID: 74babdd6-a758-4549-9632-26535279e654
// Status: test
// Level: high
// Author: frack113
// Date: 2022-09-05
// Tags: attack.stealth, attack.t1564
// Description: Detect creation of suspicious executable file names.
// Some strings look for suspicious file extensions, others look for filenames that exploit unquoted service paths.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((file.path LIKE "%:\\$Recycle.Bin.exe" OR file.path LIKE "%:\\Documents and Settings.exe" OR file.path LIKE "%:\\MSOCache.exe" OR file.path LIKE "%:\\PerfLogs.exe" OR file.path LIKE "%:\\Recovery.exe" OR file.path LIKE "%.bat.exe" OR file.path LIKE "%.sys.exe"))
