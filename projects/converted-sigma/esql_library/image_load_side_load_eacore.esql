// Title: Potential EACore.DLL Sideloading
// ID: edd3ddc3-386f-4ba5-9ada-4376b2cfa7b5
// Status: test
// Level: high
// Author: X__Junior (Nextron Systems)
// Date: 2023-08-03
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of "EACore.dll"
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((ImageLoaded LIKE "%\\EACore.dll") AND NOT (((process.executable LIKE "%C:\\Program Files\\Electronic Arts\\EA Desktop\\%" AND process.executable LIKE "%\\EACoreServer.exe%") AND ImageLoaded LIKE "C:\\Program Files\\Electronic Arts\\EA Desktop\\%")))
