// Title: Execution of Suspicious File Type Extension
// ID: c09dad97-1c78-4f71-b127-7edb2b8e491a
// Status: test
// Level: medium
// Author: Max Altgelt (Nextron Systems)
// Date: 2021-12-09
// Tags: attack.stealth
// Description: Detects whether the image specified in a process creation event doesn't refer to an ".exe" (or other known executable extension) file. This can be caused by process ghosting or other unorthodox methods to start a process.
// This rule might require some initial baselining to align with some third party tooling in the user environment.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (NOT (((process.executable LIKE "%.bin" OR process.executable LIKE "%.cgi" OR process.executable LIKE "%.com" OR process.executable LIKE "%.exe" OR process.executable LIKE "%.scr" OR process.executable LIKE "%.tmp"))) AND NOT (((process.executable LIKE "%:\\$Extend\\$Deleted\\%") OR (process.executable LIKE "%:\\Windows\\System32\\DriverStore\\FileRepository\\%") OR ((process.executable == "-" OR process.executable == "")) OR ((process.executable == "System" OR process.executable == "Registry" OR process.executable == "MemCompression" OR process.executable == "vmmem")) OR (process.executable LIKE "%:\\Windows\\Installer\\MSI%") OR (process.executable LIKE "%:\\Config.Msi\\%" AND (process.executable LIKE "%.rbf" OR process.executable LIKE "%.rbs")) OR (process.executable IS NULL) OR ((process.parent.executable LIKE "%:\\Windows\\Temp\\%") OR (process.executable LIKE "%:\\Windows\\Temp\\%")))) AND NOT (((process.parent.executable LIKE "%:\\ProgramData\\Avira\\%") OR (process.parent.executable == "C:\\Windows\\System32\\services.exe" AND process.executable LIKE "%com.docker.service") OR (process.executable LIKE "%:\\Program Files\\Mozilla Firefox\\%") OR (process.executable LIKE "%\\LZMA_EXE") OR ((process.executable LIKE "%:\\Program Files (x86)\\MyQ\\Server\\pcltool.dll" OR process.executable LIKE "%:\\Program Files\\MyQ\\Server\\pcltool.dll")) OR (process.executable LIKE "%NVIDIA\\NvBackend\\%" AND process.executable LIKE "%.dat") OR ((process.executable LIKE "%:\\Program Files (x86)\\WINPAKPRO\\%" OR process.executable LIKE "%:\\Program Files\\WINPAKPRO\\%") AND process.executable LIKE "%.ngn") OR ((process.executable LIKE "%\\AppData\\Local\\Packages\\%" AND process.executable LIKE "%\\LocalState\\rootfs\\%")))))
