// Title: RemCom Service Installation
// ID: 9e36ed87-4986-482e-8e3b-5c23ffff11bf
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-08-07
// Tags: attack.execution, attack.t1569.002
// Description: Detects RemCom service installation and execution events
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((winlog.provider_name == "Service Control Manager" AND winlog.event_id == 7045) AND ((ServiceName == "RemComSvc") OR (ImagePath LIKE "%\\RemComSvc.exe")))
