// Title: MacOS Scripting Interpreter AppleScript
// ID: 1bc2e6c5-0885-472b-bed6-be5ea8eace55
// Status: test
// Level: medium
// Author: Alejandro Ortuno, oscd.community
// Date: 2020-10-21
// Tags: attack.execution, attack.t1059.002
// Description: Detects execution of AppleScript of the macOS scripting language AppleScript.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%/osascript" AND (process.command_line LIKE "% -e %" OR process.command_line LIKE "%.scpt%" OR process.command_line LIKE "%.js%")) AND NOT ((process.parent.executable LIKE "%opencode" AND (process.command_line LIKE "%osascript%" AND process.command_line LIKE "% -e %" AND process.command_line LIKE "%set imageData to the clipboard%" AND process.command_line LIKE "%set fileRef%"))))
