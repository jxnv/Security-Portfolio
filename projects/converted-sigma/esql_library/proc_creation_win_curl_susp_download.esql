// Title: Suspicious Curl.EXE Download
// ID: e218595b-bbe7-4ee5-8a96-f32a24ad3468
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2020-07-03
// Tags: attack.command-and-control, attack.t1105
// Description: Detects a suspicious curl process start on Windows and outputs the requested document to a local file
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%\\curl.exe") OR (Product == "The curl executable")) AND (((process.command_line LIKE "%.dll" OR process.command_line LIKE "%.gif" OR process.command_line LIKE "%.jpeg" OR process.command_line LIKE "%.jpg" OR process.command_line LIKE "%.png" OR process.command_line LIKE "%.temp" OR process.command_line LIKE "%.tmp" OR process.command_line LIKE "%.txt" OR process.command_line LIKE "%.vbe" OR process.command_line LIKE "%.vbs")) OR ((process.command_line LIKE "%%AppData%%" OR process.command_line LIKE "%%Public%%" OR process.command_line LIKE "%%Temp%%" OR process.command_line LIKE "%%tmp%%" OR process.command_line LIKE "%\\AppData\\%" OR process.command_line LIKE "%\\Desktop\\%" OR process.command_line LIKE "%\\Temp\\%" OR process.command_line LIKE "%\\Users\\Public\\%" OR process.command_line LIKE "%C:\\PerfLogs\\%" OR process.command_line LIKE "%C:\\ProgramData\\%" OR process.command_line LIKE "%C:\\Windows\\Temp\\%"))) AND NOT ((process.parent.executable == "C:\\Program Files\\Git\\usr\\bin\\sh.exe" AND process.executable == "C:\\Program Files\\Git\\mingw64\\bin\\curl.exe" AND (process.command_line LIKE "%--silent --show-error --output %" AND process.command_line LIKE "%gfw-httpget-%" AND process.command_line LIKE "%AppData%"))))
