// Title: Suspicious Use of PsLogList
// ID: aae1243f-d8af-40d8-ab20-33fc6d0c55bc
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-12-18
// Tags: attack.discovery, attack.t1087, attack.t1087.001, attack.t1087.002
// Description: Detects usage of the PsLogList utility to dump event log in order to extract admin accounts and perform account discovery or delete events logs
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "% security%" OR process.command_line LIKE "% application%" OR process.command_line LIKE "% system%")) AND ((process.command_line LIKE "% -d%" OR process.command_line LIKE "% -x%" OR process.command_line LIKE "% -s%" OR process.command_line LIKE "% -c%" OR process.command_line LIKE "% -g%")) AND ((process.pe.original_file_name == "psloglist.exe") OR ((process.executable LIKE "%\\psloglist.exe" OR process.executable LIKE "%\\psloglist64.exe" OR process.executable LIKE "%\\psloglist64a.exe"))))
