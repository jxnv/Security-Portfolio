// Title: COM Object Hijacking Via Modification Of Default System CLSID Default Value
// ID: 790317c0-0a36-4a6a-a105-6e576bf99a14
// Status: experimental
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-07-16
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.015
// Description: Detects potential COM object hijacking via modification of default system CLSID.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((registry.path LIKE "%\\{1f486a52-3cb1-48fd-8f50-b8dc300d9f9d}\\%" OR registry.path LIKE "%\\{2155fee3-2419-4373-b102-6843707eb41f}\\%" OR registry.path LIKE "%\\{4590f811-1d3a-11d0-891f-00aa004b2e24}\\%" OR registry.path LIKE "%\\{4de225bf-cf59-4cfc-85f7-68b90f185355}\\%" OR registry.path LIKE "%\\{ddc05a5a-351a-4e06-8eaf-54ec1bc2dcea}\\%" OR registry.path LIKE "%\\{F56F6FDD-AA9D-4618-A949-C1B91AF43B1A}\\%" OR registry.path LIKE "%\\{F82B4EF1-93A9-4DDE-8015-F7950A1A6E31}\\%" OR registry.path LIKE "%\\{7849596a-48ea-486e-8937-a2a3009f31a9}\\%" OR registry.path LIKE "%\\{0b91a74b-ad7c-4a9d-b563-29eef9167172}\\%" OR registry.path LIKE "%\\{603D3801-BD81-11d0-A3A5-00C04FD706EC}\\%" OR registry.path LIKE "%\\{30D49246-D217-465F-B00B-AC9DDD652EB7}\\%" OR registry.path LIKE "%\\{A7A63E5C-3877-4840-8727-C1EA9D7A4D50}\\%" OR registry.path LIKE "%\\{2227A280-3AEA-1069-A2DE-08002B30309D}\\%" OR registry.path LIKE "%\\{2DEA658F-54C1-4227-AF9B-260AB5FC3543}\\%" OR registry.path LIKE "%\\{AA509086-5Ca9-4C25-8F95-589D3C07B48A}\\%")) AND (registry.path LIKE "%\\CLSID\\%" AND (registry.path LIKE "%\\InprocServer32\\(Default)" OR registry.path LIKE "%\\LocalServer32\\(Default)"))) AND (((registry.data.strings LIKE "%:\\Perflogs\\%" OR registry.data.strings LIKE "%\\AppData\\Local\\%" OR registry.data.strings LIKE "%\\Desktop\\%" OR registry.data.strings LIKE "%\\Downloads\\%" OR registry.data.strings LIKE "%\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\%" OR registry.data.strings LIKE "%\\System32\\spool\\drivers\\color\\%" OR registry.data.strings LIKE "%\\Temporary Internet%" OR registry.data.strings LIKE "%\\Users\\Public\\%" OR registry.data.strings LIKE "%\\Windows\\Temp\\%" OR registry.data.strings LIKE "%%appdata%%" OR registry.data.strings LIKE "%%temp%%" OR registry.data.strings LIKE "%%tmp%%")) OR (((registry.data.strings LIKE "%:\\Users\\%" AND registry.data.strings LIKE "%\\Favorites\\%")) OR ((registry.data.strings LIKE "%:\\Users\\%" AND registry.data.strings LIKE "%\\Favourites\\%")) OR ((registry.data.strings LIKE "%:\\Users\\%" AND registry.data.strings LIKE "%\\Contacts\\%")) OR ((registry.data.strings LIKE "%:\\Users\\%" AND registry.data.strings LIKE "%\\Pictures\\%")))))
