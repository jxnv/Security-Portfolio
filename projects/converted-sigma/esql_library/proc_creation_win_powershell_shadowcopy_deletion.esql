// Title: Deletion of Volume Shadow Copies via WMI with PowerShell
// ID: 21ff4ca9-f13a-41ad-b828-0077b2af2e40
// Status: test
// Level: high
// Author: Tim Rauch, Elastic (idea)
// Date: 2022-09-20
// Tags: attack.impact, attack.t1490
// Description: Detects deletion of Windows Volume Shadow Copies with PowerShell code and Get-WMIObject. This technique is used by numerous ransomware families such as Sodinokibi/REvil
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%.Delete()%" OR process.command_line LIKE "%Remove-WmiObject%" OR process.command_line LIKE "%rwmi%" OR process.command_line LIKE "%Remove-CimInstance%" OR process.command_line LIKE "%rcim%")) AND ((process.command_line LIKE "%Get-WmiObject%" OR process.command_line LIKE "%gwmi%" OR process.command_line LIKE "%Get-CimInstance%" OR process.command_line LIKE "%gcim%")) AND (process.command_line LIKE "%Win32_ShadowCopy%"))
