// Title: Suspicious Child Process Of Manage Engine ServiceDesk
// ID: cea2b7ea-792b-405f-95a1-b903ea06458f
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2023-01-18
// Tags: attack.command-and-control, attack.t1102
// Description: Detects suspicious child processes of the "Manage Engine ServiceDesk Plus" Java web service
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.parent.executable LIKE "%\\ManageEngine\\ServiceDesk\\%" AND process.parent.executable LIKE "%\\java.exe%") AND (process.executable LIKE "%\\AppVLP.exe" OR process.executable LIKE "%\\bash.exe" OR process.executable LIKE "%\\bitsadmin.exe" OR process.executable LIKE "%\\calc.exe" OR process.executable LIKE "%\\certutil.exe" OR process.executable LIKE "%\\cscript.exe" OR process.executable LIKE "%\\curl.exe" OR process.executable LIKE "%\\forfiles.exe" OR process.executable LIKE "%\\mftrace.exe" OR process.executable LIKE "%\\mshta.exe" OR process.executable LIKE "%\\net.exe" OR process.executable LIKE "%\\net1.exe" OR process.executable LIKE "%\\notepad.exe" OR process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe" OR process.executable LIKE "%\\query.exe" OR process.executable LIKE "%\\reg.exe" OR process.executable LIKE "%\\schtasks.exe" OR process.executable LIKE "%\\scrcons.exe" OR process.executable LIKE "%\\sh.exe" OR process.executable LIKE "%\\systeminfo.exe" OR process.executable LIKE "%\\whoami.exe" OR process.executable LIKE "%\\wmic.exe" OR process.executable LIKE "%\\wscript.exe")) AND NOT (((process.executable LIKE "%\\net.exe" OR process.executable LIKE "%\\net1.exe") AND process.command_line LIKE "% stop%")))
