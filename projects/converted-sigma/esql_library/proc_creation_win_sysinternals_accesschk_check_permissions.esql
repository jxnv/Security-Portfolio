// Title: Permission Check Via Accesschk.EXE
// ID: c625d754-6a3d-4f65-9c9a-536aea960d37
// Status: test
// Level: medium
// Author: Teymur Kheirkhabarov (idea), Mangatas Tondang, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2020-10-13
// Tags: attack.discovery, attack.t1069.001
// Description: Detects the usage of the "Accesschk" utility, an access and privilege audit tool developed by SysInternal and often being abused by attacker to verify process privileges
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%uwcqv %" OR process.command_line LIKE "%kwsu %" OR process.command_line LIKE "%qwsu %" OR process.command_line LIKE "%uwdqs %")) AND ((Product LIKE "%AccessChk") OR (Description LIKE "%Reports effective permissions%") OR ((process.executable LIKE "%\\accesschk.exe" OR process.executable LIKE "%\\accesschk64.exe" OR process.executable LIKE "%\\accesschk64a.exe")) OR (process.pe.original_file_name == "accesschk.exe")))
