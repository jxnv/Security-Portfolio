// Title: Metasploit SMB Authentication
// ID: 72124974-a68b-4366-b990-d30e0b2a190d
// Status: test
// Level: high
// Author: Chakib Gzenayi (@Chak092), Hosni Mribah
// Date: 2020-05-06
// Tags: attack.lateral-movement, attack.t1021.002
// Description: Alerts on Metasploit host's authentications on the domain.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((winlog.event_id == 4625 OR winlog.event_id == 4624) AND LogonType == 3 AND AuthenticationPackageName == "NTLM" AND WorkstationName RLIKE "^[A-Za-z0-9]{16}$") OR (winlog.event_id == 4776 AND Workstation RLIKE "^[A-Za-z0-9]{16}$"))
