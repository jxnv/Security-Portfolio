// Title: Suspicious PowerShell Parameter Substring
// ID: 36210e0d-5b19-485d-a087-c096088885f0
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Daniel Bohannon (idea), Roberto Rodriguez (Fix)
// Date: 2019-01-16
// Tags: attack.execution, attack.t1059.001
// Description: Detects suspicious PowerShell invocation with a parameter substring
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe") AND (process.command_line LIKE "% -windowstyle h %" OR process.command_line LIKE "% -windowstyl h%" OR process.command_line LIKE "% -windowsty h%" OR process.command_line LIKE "% -windowst h%" OR process.command_line LIKE "% -windows h%" OR process.command_line LIKE "% -windo h%" OR process.command_line LIKE "% -wind h%" OR process.command_line LIKE "% -win h%" OR process.command_line LIKE "% -wi h%" OR process.command_line LIKE "% -win h %" OR process.command_line LIKE "% -win hi %" OR process.command_line LIKE "% -win hid %" OR process.command_line LIKE "% -win hidd %" OR process.command_line LIKE "% -win hidde %" OR process.command_line LIKE "% -NoPr %" OR process.command_line LIKE "% -NoPro %" OR process.command_line LIKE "% -NoProf %" OR process.command_line LIKE "% -NoProfi %" OR process.command_line LIKE "% -NoProfil %" OR process.command_line LIKE "% -nonin %" OR process.command_line LIKE "% -nonint %" OR process.command_line LIKE "% -noninte %" OR process.command_line LIKE "% -noninter %" OR process.command_line LIKE "% -nonintera %" OR process.command_line LIKE "% -noninterac %" OR process.command_line LIKE "% -noninteract %" OR process.command_line LIKE "% -noninteracti %" OR process.command_line LIKE "% -noninteractiv %" OR process.command_line LIKE "% -ec %" OR process.command_line LIKE "% -encodedComman %" OR process.command_line LIKE "% -encodedComma %" OR process.command_line LIKE "% -encodedComm %" OR process.command_line LIKE "% -encodedCom %" OR process.command_line LIKE "% -encodedCo %" OR process.command_line LIKE "% -encodedC %" OR process.command_line LIKE "% -encoded %" OR process.command_line LIKE "% -encode %" OR process.command_line LIKE "% -encod %" OR process.command_line LIKE "% -enco %" OR process.command_line LIKE "% -en %" OR process.command_line LIKE "% -executionpolic %" OR process.command_line LIKE "% -executionpoli %" OR process.command_line LIKE "% -executionpol %" OR process.command_line LIKE "% -executionpo %" OR process.command_line LIKE "% -executionp %" OR process.command_line LIKE "% -execution bypass%" OR process.command_line LIKE "% -executio bypass%" OR process.command_line LIKE "% -executi bypass%" OR process.command_line LIKE "% -execut bypass%" OR process.command_line LIKE "% -execu bypass%" OR process.command_line LIKE "% -exec bypass%" OR process.command_line LIKE "% -exe bypass%" OR process.command_line LIKE "% -ex bypass%" OR process.command_line LIKE "% -ep bypass%" OR process.command_line LIKE "% /windowstyle h %" OR process.command_line LIKE "% /windowstyl h%" OR process.command_line LIKE "% /windowsty h%" OR process.command_line LIKE "% /windowst h%" OR process.command_line LIKE "% /windows h%" OR process.command_line LIKE "% /windo h%" OR process.command_line LIKE "% /wind h%" OR process.command_line LIKE "% /win h%" OR process.command_line LIKE "% /wi h%" OR process.command_line LIKE "% /win h %" OR process.command_line LIKE "% /win hi %" OR process.command_line LIKE "% /win hid %" OR process.command_line LIKE "% /win hidd %" OR process.command_line LIKE "% /win hidde %" OR process.command_line LIKE "% /NoPr %" OR process.command_line LIKE "% /NoPro %" OR process.command_line LIKE "% /NoProf %" OR process.command_line LIKE "% /NoProfi %" OR process.command_line LIKE "% /NoProfil %" OR process.command_line LIKE "% /nonin %" OR process.command_line LIKE "% /nonint %" OR process.command_line LIKE "% /noninte %" OR process.command_line LIKE "% /noninter %" OR process.command_line LIKE "% /nonintera %" OR process.command_line LIKE "% /noninterac %" OR process.command_line LIKE "% /noninteract %" OR process.command_line LIKE "% /noninteracti %" OR process.command_line LIKE "% /noninteractiv %" OR process.command_line LIKE "% /ec %" OR process.command_line LIKE "% /encodedComman %" OR process.command_line LIKE "% /encodedComma %" OR process.command_line LIKE "% /encodedComm %" OR process.command_line LIKE "% /encodedCom %" OR process.command_line LIKE "% /encodedCo %" OR process.command_line LIKE "% /encodedC %" OR process.command_line LIKE "% /encoded %" OR process.command_line LIKE "% /encode %" OR process.command_line LIKE "% /encod %" OR process.command_line LIKE "% /enco %" OR process.command_line LIKE "% /en %" OR process.command_line LIKE "% /executionpolic %" OR process.command_line LIKE "% /executionpoli %" OR process.command_line LIKE "% /executionpol %" OR process.command_line LIKE "% /executionpo %" OR process.command_line LIKE "% /executionp %" OR process.command_line LIKE "% /execution bypass%" OR process.command_line LIKE "% /executio bypass%" OR process.command_line LIKE "% /executi bypass%" OR process.command_line LIKE "% /execut bypass%" OR process.command_line LIKE "% /execu bypass%" OR process.command_line LIKE "% /exec bypass%" OR process.command_line LIKE "% /exe bypass%" OR process.command_line LIKE "% /ex bypass%" OR process.command_line LIKE "% /ep bypass%"))
