// Title: Terminal Service Process Spawn
// ID: 1012f107-b8f1-4271-af30-5aed2de89b39
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2019-05-22
// Tags: attack.initial-access, attack.t1190, attack.lateral-movement, attack.t1210, car.2013-07-002
// Description: Detects a process spawned by the terminal service server process (this could be an indicator for an exploitation of CVE-2019-0708)
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.parent.command_line LIKE "%\\svchost.exe%" AND process.parent.command_line LIKE "%termsvcs%")) AND NOT ((((process.executable LIKE "%\\rdpclip.exe" OR process.executable LIKE "%:\\Windows\\System32\\csrss.exe" OR process.executable LIKE "%:\\Windows\\System32\\wininit.exe" OR process.executable LIKE "%:\\Windows\\System32\\winlogon.exe")) OR (process.executable IS NULL))))
