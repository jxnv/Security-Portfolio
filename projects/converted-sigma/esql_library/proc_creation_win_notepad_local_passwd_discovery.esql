// Title: Notepad Password Files Discovery
// ID: 3b4e950b-a3ea-44d3-877e-432071990709
// Status: experimental
// Level: low
// Author: The DFIR Report
// Date: 2025-02-21
// Tags: attack.discovery, attack.t1083
// Description: Detects the execution of Notepad to open a file that has the string "password" which may indicate unauthorized access to credentials or suspicious activity.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (process.parent.executable LIKE "%\\explorer.exe" AND process.executable LIKE "%\\notepad.exe" AND (process.command_line LIKE "%password*.txt" OR process.command_line LIKE "%password*.csv" OR process.command_line LIKE "%password*.doc" OR process.command_line LIKE "%password*.xls"))
