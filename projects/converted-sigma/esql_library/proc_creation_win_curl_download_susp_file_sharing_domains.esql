// Title: Suspicious File Download From File Sharing Domain Via Curl.EXE
// ID: 56454143-524f-49fb-b1c6-3fb8b1ad41fb
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-05
// Tags: attack.execution
// Description: Detects potentially suspicious file download from file sharing domains using curl.exe
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%.ps1" OR process.command_line LIKE "%.ps1'" OR process.command_line LIKE "%.ps1\"" OR process.command_line LIKE "%.dat" OR process.command_line LIKE "%.dat'" OR process.command_line LIKE "%.dat\"" OR process.command_line LIKE "%.msi" OR process.command_line LIKE "%.msi'" OR process.command_line LIKE "%.msi\"" OR process.command_line LIKE "%.bat" OR process.command_line LIKE "%.bat'" OR process.command_line LIKE "%.bat\"" OR process.command_line LIKE "%.exe" OR process.command_line LIKE "%.exe'" OR process.command_line LIKE "%.exe\"" OR process.command_line LIKE "%.vbs" OR process.command_line LIKE "%.vbs'" OR process.command_line LIKE "%.vbs\"" OR process.command_line LIKE "%.vbe" OR process.command_line LIKE "%.vbe'" OR process.command_line LIKE "%.vbe\"" OR process.command_line LIKE "%.hta" OR process.command_line LIKE "%.hta'" OR process.command_line LIKE "%.hta\"" OR process.command_line LIKE "%.dll" OR process.command_line LIKE "%.dll'" OR process.command_line LIKE "%.dll\"" OR process.command_line LIKE "%.psm1" OR process.command_line LIKE "%.psm1'" OR process.command_line LIKE "%.psm1\"")) AND ((process.command_line LIKE "% -O%" OR process.command_line LIKE "%--remote-name%" OR process.command_line LIKE "%--output%")) AND (process.command_line LIKE "%http%") AND ((process.executable LIKE "%\\curl.exe") OR (process.pe.original_file_name == "curl.exe")) AND ((process.command_line LIKE "%.githubusercontent.com%" OR process.command_line LIKE "%0x0.st%" OR process.command_line LIKE "%anonfiles.com%" OR process.command_line LIKE "%bashupload.com%" OR process.command_line LIKE "%cdn.discordapp.com%" OR process.command_line LIKE "%chunk.io%" OR process.command_line LIKE "%ddns.net%" OR process.command_line LIKE "%dl.dropboxusercontent.com%" OR process.command_line LIKE "%ghostbin.co%" OR process.command_line LIKE "%github.com%" OR process.command_line LIKE "%glitch.me%" OR process.command_line LIKE "%gofile.io%" OR process.command_line LIKE "%hastebin.com%" OR process.command_line LIKE "%mediafire.com%" OR process.command_line LIKE "%mega.nz%" OR process.command_line LIKE "%onrender.com%" OR process.command_line LIKE "%pages.dev%" OR process.command_line LIKE "%paste.ee%" OR process.command_line LIKE "%pastebin.com%" OR process.command_line LIKE "%pastebin.pl%" OR process.command_line LIKE "%pastetext.net%" OR process.command_line LIKE "%pixeldrain.com%" OR process.command_line LIKE "%privatlab.com%" OR process.command_line LIKE "%privatlab.net%" OR process.command_line LIKE "%send.exploit.in%" OR process.command_line LIKE "%sendspace.com%" OR process.command_line LIKE "%storage.googleapis.com%" OR process.command_line LIKE "%storjshare.io%" OR process.command_line LIKE "%supabase.co%" OR process.command_line LIKE "%temp.sh%" OR process.command_line LIKE "%transfer.sh%" OR process.command_line LIKE "%trycloudflare.com%" OR process.command_line LIKE "%ufile.io%" OR process.command_line LIKE "%w3spaces.com%" OR process.command_line LIKE "%workers.dev%" OR process.command_line LIKE "%x0.at%")))
