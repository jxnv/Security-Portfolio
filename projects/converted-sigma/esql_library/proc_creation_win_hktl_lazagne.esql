// Title: HackTool - LaZagne Execution
// ID: c2b86e67-b880-4eec-b045-50bc98ef4844
// Status: experimental
// Level: medium
// Author: Nasreddine Bencherchali, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.credential-access
// Description: Detects the execution of the LaZagne. A utility used to retrieve multiple types of passwords stored on a local computer.
// LaZagne has been leveraged multiple times by threat actors in order to dump credentials.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.executable LIKE "%:\\PerfLogs\\%" OR process.executable LIKE "%:\\ProgramData\\%" OR process.executable LIKE "%:\\Temp\\%" OR process.executable LIKE "%:\\Tmp\\%" OR process.executable LIKE "%:\\Users\\Public\\%" OR process.executable LIKE "%:\\Windows\\Temp\\%" OR process.executable LIKE "%\\$Recycle.bin%" OR process.executable LIKE "%\\AppData\\%" OR process.executable LIKE "%\\Desktop\\%" OR process.executable LIKE "%\\Downloads\\%" OR process.executable LIKE "%\\Favorites\\%" OR process.executable LIKE "%\\Links\\%" OR process.executable LIKE "%\\Music\\%" OR process.executable LIKE "%\\Photos\\%" OR process.executable LIKE "%\\Pictures\\%" OR process.executable LIKE "%\\Saved Games\\%" OR process.executable LIKE "%\\Searches\\%" OR process.executable LIKE "%\\Users\\Contacts\\%" OR process.executable LIKE "%\\Users\\Default\\%" OR process.executable LIKE "%\\Users\\Searches\\%" OR process.executable LIKE "%\\Videos\\%" OR process.executable LIKE "%\\Windows\\addins\\%" OR process.executable LIKE "%\\Windows\\Fonts\\%" OR process.executable LIKE "%\\Windows\\IME\\%") AND (process.command_line LIKE "%.exe all" OR process.command_line LIKE "%.exe browsers" OR process.command_line LIKE "%.exe chats" OR process.command_line LIKE "%.exe databases" OR process.command_line LIKE "%.exe games" OR process.command_line LIKE "%.exe git" OR process.command_line LIKE "%.exe mails" OR process.command_line LIKE "%.exe maven" OR process.command_line LIKE "%.exe memory" OR process.command_line LIKE "%.exe multimedia" OR process.command_line LIKE "%.exe sysadmin" OR process.command_line LIKE "%.exe unused" OR process.command_line LIKE "%.exe wifi" OR process.command_line LIKE "%.exe windows")) OR (process.executable LIKE "%\\lazagne.exe")) OR (((process.command_line LIKE "% all %" OR process.command_line LIKE "% browsers %" OR process.command_line LIKE "% chats %" OR process.command_line LIKE "% databases %" OR process.command_line LIKE "% games %" OR process.command_line LIKE "% mails %" OR process.command_line LIKE "% maven %" OR process.command_line LIKE "% memory %" OR process.command_line LIKE "% multimedia %" OR process.command_line LIKE "% php %" OR process.command_line LIKE "% svn %" OR process.command_line LIKE "% sysadmin %" OR process.command_line LIKE "% unused %" OR process.command_line LIKE "% wifi %")) AND ((process.command_line LIKE "%-1Password%" OR process.command_line LIKE "%-apachedirectorystudio%" OR process.command_line LIKE "%-autologon%" OR process.command_line LIKE "%-ChromiumBased%" OR process.command_line LIKE "%-coreftp%" OR process.command_line LIKE "%-credfiles%" OR process.command_line LIKE "%-credman%" OR process.command_line LIKE "%-cyberduck%" OR process.command_line LIKE "%-dbvis%" OR process.command_line LIKE "%-EyeCon%" OR process.command_line LIKE "%-filezilla%" OR process.command_line LIKE "%-filezillaserver%" OR process.command_line LIKE "%-ftpnavigator%" OR process.command_line LIKE "%-galconfusion%" OR process.command_line LIKE "%-gitforwindows%" OR process.command_line LIKE "%-hashdump%" OR process.command_line LIKE "%-iisapppool%" OR process.command_line LIKE "%-IISCentralCertP%" OR process.command_line LIKE "%-kalypsomedia%" OR process.command_line LIKE "%-keepass%" OR process.command_line LIKE "%-keepassconfig%" OR process.command_line LIKE "%-lsa_secrets%" OR process.command_line LIKE "%-mavenrepositories%" OR process.command_line LIKE "%-memory_dump%" OR process.command_line LIKE "%-Mozilla%" OR process.command_line LIKE "%-mRemoteNG%" OR process.command_line LIKE "%-mscache%" OR process.command_line LIKE "%-opensshforwindows%" OR process.command_line LIKE "%-openvpn%" OR process.command_line LIKE "%-outlook%" OR process.command_line LIKE "%-pidgin%" OR process.command_line LIKE "%-postgresql%" OR process.command_line LIKE "%-psi-im%" OR process.command_line LIKE "%-puttycm%" OR process.command_line LIKE "%-pypykatz%" OR process.command_line LIKE "%-Rclone%" OR process.command_line LIKE "%-rdpmanager%" OR process.command_line LIKE "%-robomongo%" OR process.command_line LIKE "%-roguestale%" OR process.command_line LIKE "%-skype%" OR process.command_line LIKE "%-SQLDeveloper%" OR process.command_line LIKE "%-squirrel%" OR process.command_line LIKE "%-tortoise%" OR process.command_line LIKE "%-turba%" OR process.command_line LIKE "%-UCBrowser%" OR process.command_line LIKE "%-unattended%" OR process.command_line LIKE "%-vault%" OR process.command_line LIKE "%-vaultfiles%" OR process.command_line LIKE "%-vnc%" OR process.command_line LIKE "%-winscp%"))))
