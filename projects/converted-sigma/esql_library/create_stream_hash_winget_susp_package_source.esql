// Title: Potential Suspicious Winget Package Installation
// ID: a3f5c081-e75b-43a0-9f5b-51f26fe5dba2
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.persistence, attack.stealth
// Description: Detects potential suspicious winget package installation from a suspicious source.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (Contents LIKE "[ZoneTransfer]  ZoneId=3%" AND (Contents LIKE "%://1%" OR Contents LIKE "%://2%" OR Contents LIKE "%://3%" OR Contents LIKE "%://4%" OR Contents LIKE "%://5%" OR Contents LIKE "%://6%" OR Contents LIKE "%://7%" OR Contents LIKE "%://8%" OR Contents LIKE "%://9%") AND file.path LIKE "%:Zone.Identifier" AND file.path LIKE "%\\AppData\\Local\\Temp\\WinGet\\%")
