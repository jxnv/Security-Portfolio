// Title: Nslookup PowerShell Download Cradle - ProcessCreation
// ID: 1b3b01c7-84e9-4072-86e5-fc285a41ff23
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-05
// Tags: attack.stealth
// Description: Detects suspicious powershell download cradle using nslookup. This cradle uses nslookup to extract payloads from DNS records
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.parent.executable LIKE "%\\powershell.exe" OR process.parent.executable LIKE "%\\pwsh.exe") AND (process.command_line LIKE "% -q=txt %" OR process.command_line LIKE "% -querytype=txt %")) AND ((process.executable LIKE "%\\nslookup.exe%") OR (process.pe.original_file_name == "\\nslookup.exe")))
