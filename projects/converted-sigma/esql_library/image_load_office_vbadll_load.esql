// Title: VBA DLL Loaded Via Office Application
// ID: e6ce8457-68b1-485b-9bdd-3c2b5d679aa9
// Status: test
// Level: high
// Author: Antonlovesdnb
// Date: 2020-02-19
// Tags: attack.execution, attack.t1204.002
// Description: Detects VB DLL's loaded by an office application. Which could indicate the presence of VBA Macros.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%\\excel.exe" OR process.executable LIKE "%\\mspub.exe" OR process.executable LIKE "%\\onenote.exe" OR process.executable LIKE "%\\onenoteim.exe" OR process.executable LIKE "%\\outlook.exe" OR process.executable LIKE "%\\powerpnt.exe" OR process.executable LIKE "%\\winword.exe") AND (ImageLoaded LIKE "%\\VBE7.DLL" OR ImageLoaded LIKE "%\\VBEUI.DLL" OR ImageLoaded LIKE "%\\VBE7INTL.DLL"))
