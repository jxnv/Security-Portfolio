// Title: Potential Configuration And Service Reconnaissance Via Reg.EXE
// ID: 970007b7-ce32-49d0-a4a4-fbef016950bd
// Status: test
// Level: medium
// Author: Timur Zinniatullin, oscd.community
// Date: 2019-10-21
// Tags: attack.discovery, attack.t1012, attack.t1007
// Description: Detects the usage of "reg.exe" in order to query reconnaissance information from the registry. Adversaries may interact with the Windows registry to gather information about credentials, the system, configuration, and installed software.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.command_line LIKE "%query%") AND ((process.executable LIKE "%\\reg.exe") OR (process.pe.original_file_name == "reg.exe")) AND ((process.command_line LIKE "%currentVersion\\windows%" OR process.command_line LIKE "%winlogon\\%" OR process.command_line LIKE "%currentVersion\\shellServiceObjectDelayLoad%" OR process.command_line LIKE "%currentVersion\\run%" OR process.command_line LIKE "%currentVersion\\policies\\explorer\\run%" OR process.command_line LIKE "%currentcontrolset\\services%")))
