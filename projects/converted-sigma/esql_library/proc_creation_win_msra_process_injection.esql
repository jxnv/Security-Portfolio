// Title: Potential Process Injection Via Msra.EXE
// ID: 744a188b-0415-4792-896f-11ddb0588dbc
// Status: test
// Level: high
// Author: Alexander McDonald
// Date: 2022-06-24
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects potential process injection via Microsoft Remote Asssistance (Msra.exe) by looking at suspicious child processes spawned from the aforementioned process. It has been a target used by many threat actors and used for discovery and persistence tactics
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (process.parent.executable LIKE "%\\msra.exe" AND process.parent.command_line LIKE "%msra.exe" AND (process.executable LIKE "%\\arp.exe" OR process.executable LIKE "%\\cmd.exe" OR process.executable LIKE "%\\net.exe" OR process.executable LIKE "%\\netstat.exe" OR process.executable LIKE "%\\nslookup.exe" OR process.executable LIKE "%\\route.exe" OR process.executable LIKE "%\\schtasks.exe" OR process.executable LIKE "%\\whoami.exe"))
