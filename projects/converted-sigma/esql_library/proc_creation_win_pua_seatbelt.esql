// Title: PUA - Seatbelt Execution
// ID: 38646daa-e78f-4ace-9de0-55547b2d30da
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-18
// Tags: attack.discovery, attack.t1526, attack.t1087, attack.t1083
// Description: Detects the execution of the PUA/Recon tool Seatbelt via PE information of command line parameters
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%\\Seatbelt.exe") OR (process.pe.original_file_name == "Seatbelt.exe") OR (Description == "Seatbelt") OR ((process.command_line LIKE "% DpapiMasterKeys%" OR process.command_line LIKE "% InterestingProcesses%" OR process.command_line LIKE "% InterestingFiles%" OR process.command_line LIKE "% CertificateThumbprints%" OR process.command_line LIKE "% ChromiumBookmarks%" OR process.command_line LIKE "% ChromiumHistory%" OR process.command_line LIKE "% ChromiumPresence%" OR process.command_line LIKE "% CloudCredentials%" OR process.command_line LIKE "% CredEnum%" OR process.command_line LIKE "% CredGuard%" OR process.command_line LIKE "% FirefoxHistory%" OR process.command_line LIKE "% ProcessCreationEvents%"))) OR (((process.command_line LIKE "% -group=misc%" OR process.command_line LIKE "% -group=remote%" OR process.command_line LIKE "% -group=chromium%" OR process.command_line LIKE "% -group=slack%" OR process.command_line LIKE "% -group=system%" OR process.command_line LIKE "% -group=user%" OR process.command_line LIKE "% -group=all%")) AND (process.command_line LIKE "% -outputfile=%")))
