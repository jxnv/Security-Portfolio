// Title: Suspicious Non-Browser Network Communication With Google API
// ID: 7e9cf7b6-e827-11ed-a05b-0242ac120003
// Status: experimental
// Level: medium
// Author: Gavin Knapp
// Date: 2023-05-01
// Tags: attack.command-and-control, attack.t1102
// Description: Detects a non-browser process interacting with the Google API which could indicate the use of a covert C2 such as Google Sheet C2 (GC2-sheet)
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((DestinationHostname LIKE "%drive.googleapis.com%" OR DestinationHostname LIKE "%oauth2.googleapis.com%" OR DestinationHostname LIKE "%sheets.googleapis.com%" OR DestinationHostname LIKE "%www.googleapis.com%")) AND NOT (((process.executable == "") OR (process.executable IS NULL))) AND NOT (((process.executable LIKE "%\\brave.exe") OR ((process.executable LIKE "%:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR process.executable LIKE "%:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((process.executable LIKE "%:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\%") OR ((process.executable LIKE "%:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR process.executable LIKE "%:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe" OR process.executable LIKE "%\\WindowsApps\\MicrosoftEdge.exe"))) OR ((process.executable LIKE "%:\\Program Files (x86)\\Microsoft\\EdgeCore\\%" OR process.executable LIKE "%:\\Program Files\\Microsoft\\EdgeCore\\%") AND (process.executable LIKE "%\\msedge.exe" OR process.executable LIKE "%\\msedgewebview2.exe")) OR ((process.executable LIKE "%:\\Program Files\\Mozilla Firefox\\firefox.exe" OR process.executable LIKE "%:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR (process.executable LIKE "%:\\Program Files\\Google\\Drive File Stream\\%" AND process.executable LIKE "%\\GoogleDriveFS.exe") OR (process.executable LIKE "%\\GoogleUpdate.exe") OR ((process.executable LIKE "%:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR process.executable LIKE "%:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process.executable LIKE "%\\maxthon.exe") OR (process.executable LIKE "%\\opera.exe") OR (process.executable LIKE "%\\outlook.exe") OR (process.executable LIKE "%\\safari.exe") OR (process.executable LIKE "%\\seamonkey.exe") OR (process.executable LIKE "%\\vivaldi.exe") OR (process.executable LIKE "%\\whale.exe"))))
