// Title: Suspicious DLL Loaded via CertOC.EXE
// ID: 84232095-ecca-4015-b0d7-7726507ee793
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-15
// Tags: attack.stealth, attack.t1218
// Description: Detects when a user installs certificates by using CertOC.exe to load the target DLL file.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.command_line LIKE "% -LoadDLL %") AND ((process.executable LIKE "%\\certoc.exe") OR (process.pe.original_file_name == "CertOC.exe")) AND ((process.command_line LIKE "%\\Appdata\\Local\\Temp\\%" OR process.command_line LIKE "%\\Desktop\\%" OR process.command_line LIKE "%\\Downloads\\%" OR process.command_line LIKE "%\\Users\\Public\\%" OR process.command_line LIKE "%C:\\Windows\\Tasks\\%" OR process.command_line LIKE "%C:\\Windows\\Temp\\%")))
