// Title: Potential Homoglyph Attack Using Lookalike Characters
// ID: 32e280f1-8ad4-46ef-9e80-910657611fbc
// Status: test
// Level: medium
// Author: Micah Babinski, @micahbabinski
// Date: 2023-05-07
// Tags: attack.stealth, attack.t1036, attack.t1036.003
// Description: Detects the presence of unicode characters which are homoglyphs, or identical in appearance, to ASCII letter characters.
// This is used as an obfuscation and masquerading techniques. Only "perfect" homoglyphs are included; these are characters that
// are indistinguishable from ASCII characters and thus may make excellent candidates for homoglyph attack characters.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%а%" OR process.command_line LIKE "%е%" OR process.command_line LIKE "%о%" OR process.command_line LIKE "%р%" OR process.command_line LIKE "%с%" OR process.command_line LIKE "%х%" OR process.command_line LIKE "%ѕ%" OR process.command_line LIKE "%і%" OR process.command_line LIKE "%ӏ%" OR process.command_line LIKE "%ј%" OR process.command_line LIKE "%һ%" OR process.command_line LIKE "%ԁ%" OR process.command_line LIKE "%ԛ%" OR process.command_line LIKE "%ԝ%" OR process.command_line LIKE "%ο%")) OR ((process.command_line LIKE "%А%" OR process.command_line LIKE "%В%" OR process.command_line LIKE "%Е%" OR process.command_line LIKE "%К%" OR process.command_line LIKE "%М%" OR process.command_line LIKE "%Н%" OR process.command_line LIKE "%О%" OR process.command_line LIKE "%Р%" OR process.command_line LIKE "%С%" OR process.command_line LIKE "%Т%" OR process.command_line LIKE "%Х%" OR process.command_line LIKE "%Ѕ%" OR process.command_line LIKE "%І%" OR process.command_line LIKE "%Ј%" OR process.command_line LIKE "%Ү%" OR process.command_line LIKE "%Ӏ%" OR process.command_line LIKE "%Ԍ%" OR process.command_line LIKE "%Ԛ%" OR process.command_line LIKE "%Ԝ%" OR process.command_line LIKE "%Α%" OR process.command_line LIKE "%Β%" OR process.command_line LIKE "%Ε%" OR process.command_line LIKE "%Ζ%" OR process.command_line LIKE "%Η%" OR process.command_line LIKE "%Ι%" OR process.command_line LIKE "%Κ%" OR process.command_line LIKE "%Μ%" OR process.command_line LIKE "%Ν%" OR process.command_line LIKE "%Ο%" OR process.command_line LIKE "%Ρ%" OR process.command_line LIKE "%Τ%" OR process.command_line LIKE "%Υ%" OR process.command_line LIKE "%Χ%")))
