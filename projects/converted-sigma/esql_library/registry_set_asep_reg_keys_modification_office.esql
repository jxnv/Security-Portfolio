// Title: Office Autorun Keys Modification
// ID: baecf8fb-edbf-429f-9ade-31fc3f22b970
// Status: test
// Level: medium
// Author: Victor Sergeev, Daniil Yugoslavskiy, Gleb Sukhodolskiy, Timur Zinniatullin, oscd.community, Tim Shelton, frack113 (split)
// Date: 2019-10-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects modification of autostart extensibility point (ASEP) in registry. Adversaries may modify these keys to execute malicious code when Office files are opened.
// There are various legitimate add-ins that also use these keys and this filter list might not be exhaustive.
// Thus, it is recommended to review and tune filters for your environment to reduce false positives before deploying to production.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((registry.path LIKE "%\\Word\\Addins%" OR registry.path LIKE "%\\PowerPoint\\Addins%" OR registry.path LIKE "%\\Outlook\\Addins%" OR registry.path LIKE "%\\Onenote\\Addins%" OR registry.path LIKE "%\\Excel\\Addins%" OR registry.path LIKE "%\\Access\\Addins%" OR registry.path LIKE "%test\\Special\\Perf%")) AND ((registry.path LIKE "%\\Software\\Wow6432Node\\Microsoft\\Office%" OR registry.path LIKE "%\\Software\\Microsoft\\Office%"))) AND NOT (((registry.data.strings == "(Empty)") OR ((process.executable LIKE "C:\\Program Files\\Microsoft Office\\%" OR process.executable LIKE "C:\\Program Files (x86)\\Microsoft Office\\%" OR process.executable LIKE "C:\\PROGRA~2\\MICROS~2\\Office%" OR process.executable LIKE "C:\\Windows\\System32\\msiexec.exe%" OR process.executable LIKE "C:\\Windows\\SysWOW64\\msiexec.exe%" OR process.executable LIKE "C:\\Windows\\System32\\regsvr32.exe%" OR process.executable LIKE "C:\\Windows\\SysWOW64\\regsvr32.exe%") AND (registry.path LIKE "%\\Excel\\Addins\\AdHocReportingExcelClientLib.AdHocReportingExcelClientAddIn.1\\%" OR registry.path LIKE "%\\Excel\\Addins\\ExcelPlugInShell.PowerMapConnect\\%" OR registry.path LIKE "%\\Excel\\Addins\\NativeShim\\%" OR registry.path LIKE "%\\Excel\\Addins\\NativeShim.InquireConnector.1\\%" OR registry.path LIKE "%\\Excel\\Addins\\PowerPivotExcelClientAddIn.NativeEntry.1\\%" OR registry.path LIKE "%\\Outlook\\AddIns\\AccessAddin.DC\\%" OR registry.path LIKE "%\\Outlook\\AddIns\\ColleagueImport.ColleagueImportAddin\\%" OR registry.path LIKE "%\\Outlook\\AddIns\\EvernoteCC.EvernoteContactConnector\\%" OR registry.path LIKE "%\\Outlook\\AddIns\\EvernoteOLRD.Connect\\%" OR registry.path LIKE "%\\Outlook\\Addins\\OneNote.OutlookAddin%" OR registry.path LIKE "%\\Outlook\\Addins\\DriveFSExtensionLib.Connect\\%" OR registry.path LIKE "%\\Outlook\\Addins\\GoogleAppsSync.Connect\\%" OR registry.path LIKE "%\\Outlook\\Addins\\Microsoft.VbaAddinForOutlook.1\\%" OR registry.path LIKE "%\\Outlook\\Addins\\OcOffice.OcForms\\%" OR registry.path LIKE "%\\Outlook\\Addins\\OscAddin.Connect\\%" OR registry.path LIKE "%\\Outlook\\Addins\\OutlookChangeNotifier.Connect\\%" OR registry.path LIKE "%\\Outlook\\Addins\\UCAddin.LyncAddin.1%" OR registry.path LIKE "%\\Outlook\\Addins\\UCAddin.UCAddin.1%" OR registry.path LIKE "%\\Outlook\\Addins\\UmOutlookAddin.FormRegionAddin\\%" OR registry.path LIKE "%AddinTakeNotesService\\FriendlyName%")) OR (registry.data.strings IS NULL) OR ((process.executable LIKE "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\%" OR process.executable LIKE "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\%") AND process.executable LIKE "%\\OfficeClickToRun.exe") OR ((process.executable LIKE "C:\\Program Files\\Common Files\\Microsoft Shared\\VSTO\\%" OR process.executable LIKE "C:\\Program Files (x86)\\Microsoft Shared\\VSTO\\%") AND process.executable LIKE "%\\VSTOInstaller.exe"))) AND NOT ((((process.executable == "C:\\Program Files\\Avast Software\\Avast\\RegSvr.exe" OR process.executable == "C:\\Program Files\\Avast Software\\Avast\\x86\\RegSvr.exe") AND registry.path LIKE "%\\Microsoft\\Office\\Outlook\\Addins\\Avast.AsOutExt\\%") OR ((process.executable == "C:\\Program Files\\AVG\\Antivirus\\RegSvr.exe" OR process.executable == "C:\\Program Files\\AVG\\Antivirus\\x86\\RegSvr.exe") AND registry.path LIKE "%\\Microsoft\\Office\\Outlook\\Addins\\Antivirus.AsOutExt\\%"))))
