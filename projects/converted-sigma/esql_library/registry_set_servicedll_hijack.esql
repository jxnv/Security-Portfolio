// Title: ServiceDll Hijack
// ID: 612e47e9-8a59-43a6-b404-f48683f45bd6
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-02-04
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects changes to the "ServiceDLL" value related to a service in the registry.
// This is often used as a method of persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((registry.path LIKE "%\\System\\%" AND registry.path LIKE "%ControlSet%" AND registry.path LIKE "%\\Services\\%") AND registry.path LIKE "%\\Parameters\\ServiceDll") AND NOT (((process.executable == "C:\\Windows\\system32\\lsass.exe" AND registry.path LIKE "%\\Services\\NTDS\\Parameters\\ServiceDll" AND registry.data.strings == "%%systemroot%%\\system32\\ntdsa.dll") OR (process.executable == "C:\\Windows\\System32\\poqexec.exe") OR (registry.data.strings == "C:\\Windows\\system32\\spool\\drivers\\x64\\3\\PrintConfig.dll") OR (process.executable LIKE "%\\regsvr32.exe" AND registry.path LIKE "%\\Services\\PrintNotify\\Parameters\\ServiceDll" AND registry.data.strings LIKE "C:\\WINDOWS\\System32\\DriverStore\\FileRepository\\%" AND registry.data.strings LIKE "%\\arm64\\PrintConfig.dll"))) AND NOT ((process.executable LIKE "%\\regsvr32.exe" AND registry.data.strings == "C:\\Windows\\System32\\STAgent.dll")))
