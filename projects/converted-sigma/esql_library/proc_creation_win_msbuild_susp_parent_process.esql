// Title: Suspicious Msbuild Execution By Uncommon Parent Process
// ID: 33be4333-2c6b-44f4-ae28-102cdbde0a31
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-11-17
// Tags: attack.stealth
// Description: Detects suspicious execution of 'Msbuild.exe' by a uncommon parent process
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%\\MSBuild.exe") OR (process.pe.original_file_name == "MSBuild.exe")) AND NOT (((process.parent.executable LIKE "%\\devenv.exe" OR process.parent.executable LIKE "%\\cmd.exe" OR process.parent.executable LIKE "%\\msbuild.exe" OR process.parent.executable LIKE "%\\python.exe" OR process.parent.executable LIKE "%\\explorer.exe" OR process.parent.executable LIKE "%\\nuget.exe"))))
