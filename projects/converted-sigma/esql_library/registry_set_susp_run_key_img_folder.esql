// Title: New RUN Key Pointing to Suspicious Folder
// ID: 02ee49e2-e294-4d0f-9278-f5b3212fc588
// Status: experimental
// Level: high
// Author: Florian Roth (Nextron Systems), Markus Neis, Sander Wiebing, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2018-08-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects suspicious new RUN key element pointing to an executable in a suspicious folder
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((registry.path LIKE "%\\Software\\Microsoft\\Windows\\CurrentVersion\\Run%" OR registry.path LIKE "%\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run%" OR registry.path LIKE "%\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\Run%")) AND (((registry.data.strings LIKE "%:\\Perflogs%" OR registry.data.strings LIKE "%:\\ProgramData'%" OR registry.data.strings LIKE "%:\\Windows\\Temp%" OR registry.data.strings LIKE "%:\\Temp%" OR registry.data.strings LIKE "%\\AppData\\Local\\Temp%" OR registry.data.strings LIKE "%\\AppData\\Roaming%" OR registry.data.strings LIKE "%:\\$Recycle.bin%" OR registry.data.strings LIKE "%:\\Users\\Default%" OR registry.data.strings LIKE "%:\\Users\\public%" OR registry.data.strings LIKE "%%temp%%" OR registry.data.strings LIKE "%%tmp%%" OR registry.data.strings LIKE "%%Public%%" OR registry.data.strings LIKE "%%AppData%%")) OR ((registry.data.strings LIKE "%:\\Users\\%") AND ((registry.data.strings LIKE "%\\Favorites%" OR registry.data.strings LIKE "%\\Favourites%" OR registry.data.strings LIKE "%\\Contacts%" OR registry.data.strings LIKE "%\\Music%" OR registry.data.strings LIKE "%\\Pictures%" OR registry.data.strings LIKE "%\\Documents%" OR registry.data.strings LIKE "%\\Photos%")))) AND NOT ((registry.path LIKE "%\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\%" AND process.executable LIKE "C:\\Windows\\SoftwareDistribution\\Download\\%" AND (registry.data.strings LIKE "%rundll32.exe %" AND registry.data.strings LIKE "%C:\\WINDOWS\\system32\\advpack.dll,DelNodeRunDLL32%") AND (registry.data.strings LIKE "%\\AppData\\Local\\Temp\\%" OR registry.data.strings LIKE "%C:\\Windows\\Temp\\%"))) AND NOT (((process.executable LIKE "%C:\\Program Files\\Spotify\\Spotify.exe" OR process.executable LIKE "%C:\\Program Files (x86)\\Spotify\\Spotify.exe" OR process.executable LIKE "%\\AppData\\Roaming\\Spotify\\Spotify.exe") AND registry.path LIKE "%SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\\Spotify" AND registry.data.strings LIKE "%Spotify.exe --autostart --minimized")))
