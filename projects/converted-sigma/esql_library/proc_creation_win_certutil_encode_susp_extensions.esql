// Title: Suspicious File Encoded To Base64 Via Certutil.EXE
// ID: ea0cdc3e-2239-4f26-a947-4e8f8224e464
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-15
// Tags: attack.stealth, attack.t1027
// Description: Detects the execution of certutil with the "encode" flag to encode a file to base64 where the extensions of the file is suspicious
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%-encode%" OR process.command_line LIKE "%/encode%")) AND ((process.command_line LIKE "%.acl%" OR process.command_line LIKE "%.bat%" OR process.command_line LIKE "%.doc%" OR process.command_line LIKE "%.gif%" OR process.command_line LIKE "%.jpeg%" OR process.command_line LIKE "%.jpg%" OR process.command_line LIKE "%.mp3%" OR process.command_line LIKE "%.pdf%" OR process.command_line LIKE "%.png%" OR process.command_line LIKE "%.ppt%" OR process.command_line LIKE "%.tmp%" OR process.command_line LIKE "%.xls%" OR process.command_line LIKE "%.xml%")) AND ((process.executable LIKE "%\\certutil.exe") OR (process.pe.original_file_name == "CertUtil.exe")))
