// Title: ADFS Database Named Pipe Connection By Uncommon Tool
// ID: 1ea13e8c-03ea-409b-877d-ce5c3d2c1cb3
// Status: test
// Level: medium
// Author: Roberto Rodriguez @Cyb3rWard0g
// Date: 2021-10-08
// Tags: attack.collection, attack.t1005
// Description: Detects suspicious local connections via a named pipe to the AD FS configuration database (Windows Internal Database).
// Used to access information such as the AD FS configuration settings which contains sensitive information used to sign SAML tokens.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((PipeName == "\\MICROSOFT##WID\\tsql\\query") AND NOT (((process.executable LIKE "%:\\Windows\\System32\\mmc.exe" OR process.executable LIKE "%:\\Windows\\system32\\svchost.exe" OR process.executable LIKE "%:\\Windows\\System32\\wsmprovhost.exe" OR process.executable LIKE "%:\\Windows\\SysWOW64\\mmc.exe" OR process.executable LIKE "%:\\Windows\\SysWOW64\\wsmprovhost.exe" OR process.executable LIKE "%:\\Windows\\WID\\Binn\\sqlwriter.exe" OR process.executable LIKE "%\\AzureADConnect.exe" OR process.executable LIKE "%\\Microsoft.Identity.Health.Adfs.PshSurrogate.exe" OR process.executable LIKE "%\\Microsoft.IdentityServer.ServiceHost.exe" OR process.executable LIKE "%\\Microsoft.Tri.Sensor.exe" OR process.executable LIKE "%\\sqlservr.exe" OR process.executable LIKE "%\\tssdis.exe"))))
