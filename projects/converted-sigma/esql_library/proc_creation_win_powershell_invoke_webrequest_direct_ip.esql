// Title: Suspicious Invoke-WebRequest Execution With DirectIP
// ID: 1edff897-9146-48d2-9066-52e8d8f80a2f
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-21
// Tags: attack.command-and-control, attack.t1105
// Description: Detects calls to PowerShell with Invoke-WebRequest cmdlet using direct IP access
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%curl %" OR process.command_line LIKE "%Invoke-RestMethod%" OR process.command_line LIKE "%Invoke-WebRequest%" OR process.command_line LIKE "% irm %" OR process.command_line LIKE "%iwr %" OR process.command_line LIKE "%wget %")) AND (((process.executable LIKE "%\\powershell_ise.exe" OR process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe")) OR ((process.pe.original_file_name == "powershell_ise.EXE" OR process.pe.original_file_name == "PowerShell.EXE" OR process.pe.original_file_name == "pwsh.dll"))) AND ((process.command_line LIKE "%://1%" OR process.command_line LIKE "%://2%" OR process.command_line LIKE "%://3%" OR process.command_line LIKE "%://4%" OR process.command_line LIKE "%://5%" OR process.command_line LIKE "%://6%" OR process.command_line LIKE "%://7%" OR process.command_line LIKE "%://8%" OR process.command_line LIKE "%://9%")))
