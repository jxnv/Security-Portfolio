// Title: Monero Crypto Coin Mining Pool Lookup
// ID: b593fd50-7335-4682-a36c-4edcb68e4641
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-10-24
// Tags: attack.impact, attack.t1496, attack.exfiltration, attack.t1567
// Description: Detects suspicious DNS queries to Monero mining pools
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((query LIKE "%pool.minexmr.com%" OR query LIKE "%fr.minexmr.com%" OR query LIKE "%de.minexmr.com%" OR query LIKE "%sg.minexmr.com%" OR query LIKE "%ca.minexmr.com%" OR query LIKE "%us-west.minexmr.com%" OR query LIKE "%pool.supportxmr.com%" OR query LIKE "%mine.c3pool.com%" OR query LIKE "%xmr-eu1.nanopool.org%" OR query LIKE "%xmr-eu2.nanopool.org%" OR query LIKE "%xmr-us-east1.nanopool.org%" OR query LIKE "%xmr-us-west1.nanopool.org%" OR query LIKE "%xmr-asia1.nanopool.org%" OR query LIKE "%xmr-jp1.nanopool.org%" OR query LIKE "%xmr-au1.nanopool.org%" OR query LIKE "%xmr.2miners.com%" OR query LIKE "%xmr.hashcity.org%" OR query LIKE "%xmr.f2pool.com%" OR query LIKE "%xmrpool.eu%" OR query LIKE "%pool.hashvault.pro%"))
