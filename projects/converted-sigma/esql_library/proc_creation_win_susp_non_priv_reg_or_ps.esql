// Title: Non-privileged Usage of Reg or Powershell
// ID: 8f02c935-effe-45b3-8fc9-ef8696a9e41d
// Status: test
// Level: high
// Author: Teymur Kheirkhabarov (idea), Ryan Plas (rule), oscd.community
// Date: 2020-10-05
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Search for usage of reg or Powershell by non-privileged users to modify service configuration in registry
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.command_line LIKE "%reg %" AND process.command_line LIKE "%add%")) OR ((process.command_line LIKE "%powershell%" OR process.command_line LIKE "%set-itemproperty%" OR process.command_line LIKE "% sp %" OR process.command_line LIKE "%new-itemproperty%"))) AND ((IntegrityLevel == "Medium" OR IntegrityLevel == "S-1-16-8192") AND (process.command_line LIKE "%ControlSet%" AND process.command_line LIKE "%Services%") AND (process.command_line LIKE "%ImagePath%" OR process.command_line LIKE "%FailureCommand%" OR process.command_line LIKE "%ServiceDLL%")))
