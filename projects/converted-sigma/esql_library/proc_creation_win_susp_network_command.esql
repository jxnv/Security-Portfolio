// Title: Suspicious Network Command
// ID: a29c1813-ab1f-4dde-b489-330b952e91ae
// Status: test
// Level: low
// Author: frack113, Christopher Peacock '@securepeacock', SCYTHE '@scythe_io'
// Date: 2021-12-07
// Tags: attack.discovery, attack.t1016
// Description: Adversaries may look for details about the network configuration and settings of systems they access or through information discovery of remote systems
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.command_line RLIKE "ipconfig\\s+/all" OR process.command_line RLIKE "netsh\\s+interface show interface" OR process.command_line RLIKE "arp\\s+-a" OR process.command_line RLIKE "nbtstat\\s+-n" OR process.command_line RLIKE "net\\s+config" OR process.command_line RLIKE "route\\s+print"))
