// Title: Bitbucket User Details Export Attempt Detected
// ID: 5259cbf2-0a75-48bf-b57a-c54d6fabaef3
// Status: test
// Level: medium
// Author: Muhammad Faisal (@faisalusuf)
// Date: 2024-02-25
// Tags: attack.collection, attack.reconnaissance, attack.discovery, attack.t1213, attack.t1082, attack.t1591.004
// Description: Detects user data export activity.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (auditType.category == "Users and groups" AND (auditType.action == "User permissions export failed" OR auditType.action == "User permissions export started" OR auditType.action == "User permissions exported"))
