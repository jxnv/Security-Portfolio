// Title: Service Reconnaissance Via Wmic.EXE
// ID: 76f55eaa-d27f-4213-9d45-7b0e4b60bbae
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-14
// Tags: attack.execution, attack.t1047
// Description: An adversary might use WMI to check if a certain remote service is running on a remote device.
// When the test completes, a service information will be displayed on the screen if it exists.
// A common feedback message is that "No instance(s) Available" if the service queried is not running.
// A common error message is "Node - (provided IP or default) ERROR Description =The RPC server is unavailable" if the provided remote host is unreachable
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%service%") AND ((process.executable LIKE "%\\WMIC.exe") OR (process.pe.original_file_name == "wmic.exe"))) AND NOT ((((process.command_line LIKE "%stopservice%" OR process.command_line LIKE "%startservice%")) OR ((process.command_line LIKE "%Change%" OR process.command_line LIKE "%Create%" OR process.command_line LIKE "%Delete%" OR process.command_line LIKE "%PauseService%" OR process.command_line LIKE "%ResumeService%" OR process.command_line LIKE "%SetSecurityDescriptor%" OR process.command_line LIKE "%StartService%" OR process.command_line LIKE "%StopService%" OR process.command_line LIKE "%UserControlService%")))))
