// Title: Potentially Suspicious File Download From File Sharing Domain Via PowerShell.EXE
// ID: b6e04788-29e1-4557-bb14-77f761848ab8
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-02-23
// Tags: attack.execution
// Description: Detects potentially suspicious file downloads from file sharing domains using PowerShell.exe
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%.DownloadString(%" OR process.command_line LIKE "%.DownloadFile(%" OR process.command_line LIKE "%Invoke-WebRequest %" OR process.command_line LIKE "%iwr %" OR process.command_line LIKE "%wget %")) AND (((process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe")) OR ((process.pe.original_file_name == "PowerShell.EXE" OR process.pe.original_file_name == "pwsh.dll"))) AND ((process.command_line LIKE "%0x0.st%" OR process.command_line LIKE "%anonfiles.com%" OR process.command_line LIKE "%bashupload.com%" OR process.command_line LIKE "%cdn.discordapp.com%" OR process.command_line LIKE "%chunk.io%" OR process.command_line LIKE "%ddns.net%" OR process.command_line LIKE "%dl.dropboxusercontent.com%" OR process.command_line LIKE "%ghostbin.co%" OR process.command_line LIKE "%glitch.me%" OR process.command_line LIKE "%gofile.io%" OR process.command_line LIKE "%hastebin.com%" OR process.command_line LIKE "%mediafire.com%" OR process.command_line LIKE "%mega.nz%" OR process.command_line LIKE "%onrender.com%" OR process.command_line LIKE "%pages.dev%" OR process.command_line LIKE "%paste.ee%" OR process.command_line LIKE "%pastebin.com%" OR process.command_line LIKE "%pastebin.pl%" OR process.command_line LIKE "%pastetext.net%" OR process.command_line LIKE "%pixeldrain.com%" OR process.command_line LIKE "%privatlab.com%" OR process.command_line LIKE "%privatlab.net%" OR process.command_line LIKE "%send.exploit.in%" OR process.command_line LIKE "%sendspace.com%" OR process.command_line LIKE "%storage.googleapis.com%" OR process.command_line LIKE "%storjshare.io%" OR process.command_line LIKE "%supabase.co%" OR process.command_line LIKE "%temp.sh%" OR process.command_line LIKE "%transfer.sh%" OR process.command_line LIKE "%trycloudflare.com%" OR process.command_line LIKE "%ufile.io%" OR process.command_line LIKE "%w3spaces.com%" OR process.command_line LIKE "%workers.dev%" OR process.command_line LIKE "%x0.at%")))
