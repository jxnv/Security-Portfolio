// Title: Firewall Configuration Discovery Via Netsh.EXE
// ID: 0e4164da-94bc-450d-a7be-a4b176179f1f
// Status: test
// Level: low
// Author: frack113, Christopher Peacock '@securepeacock', SCYTHE '@scythe_io'
// Date: 2021-12-07
// Tags: attack.discovery, attack.t1016
// Description: Adversaries may look for details about the network configuration and settings of systems they access or through information discovery of remote systems
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%netsh%" AND process.command_line LIKE "%show %" AND process.command_line LIKE "%firewall %") AND (process.command_line LIKE "%config %" OR process.command_line LIKE "%state %" OR process.command_line LIKE "%rule %" OR process.command_line LIKE "%name=all%")) AND ((process.executable LIKE "%\\netsh.exe") OR (process.pe.original_file_name == "netsh.exe")))
