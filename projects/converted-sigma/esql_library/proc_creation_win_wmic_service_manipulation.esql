// Title: Service Started/Stopped Via Wmic.EXE
// ID: 0b7163dc-7eee-4960-af17-c0cd517f92da
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-20
// Tags: attack.execution, attack.t1047
// Description: Detects usage of wmic to start or stop a service
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "% service %" AND process.command_line LIKE "% call %") AND (process.command_line LIKE "%stopservice%" OR process.command_line LIKE "%startservice%")) AND ((process.pe.original_file_name == "wmic.exe") OR (process.executable LIKE "%\\WMIC.exe")))
