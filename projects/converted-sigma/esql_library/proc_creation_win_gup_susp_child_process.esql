// Title: Suspicious Child Process of Notepad++ Updater - GUP.Exe
// ID: bb0e87ce-c89f-4857-84fa-095e4483e9cb
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-02-03
// Tags: attack.collection, attack.credential-access, attack.t1195.002, attack.initial-access, attack.t1557
// Description: Detects suspicious child process creation by the Notepad++ updater process (gup.exe).
// This could indicate potential exploitation of the updater component to deliver unwanted malware.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.parent.executable LIKE "%\\gup.exe") AND (((process.command_line LIKE "%bitsadmin%" OR process.command_line LIKE "%certutil%" OR process.command_line LIKE "%curl%" OR process.command_line LIKE "%finger%" OR process.command_line LIKE "%forfiles%" OR process.command_line LIKE "%regsvr32%" OR process.command_line LIKE "%rundll32%" OR process.command_line LIKE "%wget%")) OR ((process.executable LIKE "%\\cmd.exe" OR process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe" OR process.executable LIKE "%\\cscript.exe" OR process.executable LIKE "%\\wscript.exe" OR process.executable LIKE "%\\mshta.exe"))))
