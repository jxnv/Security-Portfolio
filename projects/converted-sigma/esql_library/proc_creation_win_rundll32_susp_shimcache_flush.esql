// Title: ShimCache Flush
// ID: b0524451-19af-4efa-a46f-562a977f792e
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-02-01
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects actions that clear the local ShimCache and remove forensic evidence
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.command_line LIKE "%rundll32%" AND process.command_line LIKE "%apphelp.dll%")) AND ((process.command_line LIKE "%ShimFlushCache%" OR process.command_line LIKE "%#250%"))) OR (((process.command_line LIKE "%rundll32%" AND process.command_line LIKE "%kernel32.dll%")) AND ((process.command_line LIKE "%BaseFlushAppcompatCache%" OR process.command_line LIKE "%#46%"))))
