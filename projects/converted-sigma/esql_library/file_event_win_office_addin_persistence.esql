// Title: Potential Persistence Via Microsoft Office Add-In
// ID: 8e1cb247-6cf6-42fa-b440-3f27d57e9936
// Status: test
// Level: high
// Author: NVISO
// Date: 2020-05-11
// Tags: attack.persistence, attack.t1137.006
// Description: Detects potential persistence activity via startup add-ins that load when Microsoft Office starts (.wll/.xll are simply .dll fit for Word or Excel).
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((file.path LIKE "%\\Microsoft\\Addins\\%" AND (file.path LIKE "%.xlam" OR file.path LIKE "%.xla" OR file.path LIKE "%.ppam")) OR (file.path LIKE "%\\Microsoft\\Word\\Startup\\%" AND file.path LIKE "%.wll") OR (file.path LIKE "%Microsoft\\Excel\\XLSTART\\%" AND file.path LIKE "%.xlam") OR (file.path LIKE "%\\Microsoft\\Excel\\Startup\\%" AND file.path LIKE "%.xll"))
