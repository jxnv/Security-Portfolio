// Title: Suspicious Git Clone - Linux
// ID: cfec9d29-64ec-4a0f-9ffe-0fdb856d5446
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-03
// Tags: attack.reconnaissance, attack.t1593.003
// Description: Detects execution of "git" in order to clone a remote repository that contain suspicious keywords which might be suspicious
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%/git" AND process.command_line LIKE "% clone %") AND ((process.command_line LIKE "%exploit%" OR process.command_line LIKE "%Vulns%" OR process.command_line LIKE "%vulnerability%" OR process.command_line LIKE "%RCE%" OR process.command_line LIKE "%RemoteCodeExecution%" OR process.command_line LIKE "%Invoke-%" OR process.command_line LIKE "%CVE-%" OR process.command_line LIKE "%poc-%" OR process.command_line LIKE "%ProofOfConcept%" OR process.command_line LIKE "%proxyshell%" OR process.command_line LIKE "%log4shell%" OR process.command_line LIKE "%eternalblue%" OR process.command_line LIKE "%eternal-blue%" OR process.command_line LIKE "%MS17-%")))
