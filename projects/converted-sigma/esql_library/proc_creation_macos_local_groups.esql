// Title: Local Groups Discovery - MacOs
// ID: 89bb1f97-c7b9-40e8-b52b-7d6afbd67276
// Status: test
// Level: informational
// Author: Ömer Günal, Alejandro Ortuno, oscd.community
// Date: 2020-10-11
// Tags: attack.discovery, attack.t1069.001
// Description: Detects enumeration of local system groups
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%/dscacheutil" AND (process.command_line LIKE "%-q%" AND process.command_line LIKE "%group%")) OR (process.executable LIKE "%/cat" AND process.command_line LIKE "%/etc/group%") OR (process.executable LIKE "%/dscl" AND (process.command_line LIKE "%-list%" AND process.command_line LIKE "%/groups%")))
