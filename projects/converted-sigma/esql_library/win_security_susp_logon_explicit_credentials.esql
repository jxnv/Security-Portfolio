// Title: Suspicious Remote Logon with Explicit Credentials
// ID: 941e5c45-cda7-4864-8cea-bbb7458d194a
// Status: test
// Level: medium
// Author: oscd.community, Teymur Kheirkhabarov @HeirhabarovT, Zach Stanford @svch0st, Tim Shelton
// Date: 2020-10-05
// Tags: attack.privilege-escalation, attack.persistence, attack.initial-access, attack.stealth, attack.t1078, attack.lateral-movement
// Description: Detects suspicious processes logging on with explicit credentials
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((winlog.event_id == 4648 AND (ProcessName LIKE "%\\cmd.exe" OR ProcessName LIKE "%\\powershell.exe" OR ProcessName LIKE "%\\pwsh.exe" OR ProcessName LIKE "%\\winrs.exe" OR ProcessName LIKE "%\\wmic.exe" OR ProcessName LIKE "%\\net.exe" OR ProcessName LIKE "%\\net1.exe" OR ProcessName LIKE "%\\reg.exe")) AND NOT (((TargetServerName == "localhost") OR (SubjectUserName LIKE "%$" AND TargetUserName LIKE "%$"))))
