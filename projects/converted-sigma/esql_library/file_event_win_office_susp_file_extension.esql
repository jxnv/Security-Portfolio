// Title: File With Uncommon Extension Created By An Office Application
// ID: c7a74c80-ba5a-486e-9974-ab9e682bc5e4
// Status: test
// Level: high
// Author: Vadim Khrykov (ThreatIntel), Cyb3rEng (Rule), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-08-23
// Tags: attack.t1204.002, attack.execution
// Description: Detects the creation of files with an executable or script extension by an Office application.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.executable LIKE "%\\excel.exe" OR process.executable LIKE "%\\msaccess.exe" OR process.executable LIKE "%\\mspub.exe" OR process.executable LIKE "%\\powerpnt.exe" OR process.executable LIKE "%\\visio.exe" OR process.executable LIKE "%\\winword.exe")) AND ((file.path LIKE "%.bat" OR file.path LIKE "%.cmd" OR file.path LIKE "%.com" OR file.path LIKE "%.dll" OR file.path LIKE "%.exe" OR file.path LIKE "%.hta" OR file.path LIKE "%.ocx" OR file.path LIKE "%.proj" OR file.path LIKE "%.ps1" OR file.path LIKE "%.scf" OR file.path LIKE "%.scr" OR file.path LIKE "%.sys" OR file.path LIKE "%.vbe" OR file.path LIKE "%.vbs" OR file.path LIKE "%.wsf" OR file.path LIKE "%.wsh"))) AND NOT ((file.path LIKE "%\\AppData\\Local\\assembly\\tmp\\%" AND file.path LIKE "%.dll")) AND NOT ((((file.path LIKE "%C:\\Users\\%" AND file.path LIKE "%\\AppData\\Local\\Microsoft\\Office\\%" AND file.path LIKE "%\\BackstageInAppNavCache\\%") AND file.path LIKE "%.com") OR (process.executable LIKE "%\\winword.exe" AND file.path LIKE "%\\AppData\\Local\\Temp\\webexdelta\\%" AND (file.path LIKE "%.dll" OR file.path LIKE "%.exe")) OR ((file.path LIKE "%C:\\Users\\%" AND file.path LIKE "%\\AppData\\Local\\Microsoft\\Office\\%" AND file.path LIKE "%\\WebServiceCache\\AllUsers%") AND file.path LIKE "%.com"))))
