// Title: Potential Suspicious Windows Feature Enabled - ProcCreation
// ID: c740d4cf-a1e9-41de-bb16-8a46a4f57918
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-29
// Tags: attack.stealth
// Description: Detects usage of the built-in PowerShell cmdlet "Enable-WindowsOptionalFeature" used as a Deployment Image Servicing and Management tool.
// Similar to DISM.exe, this cmdlet is used to enumerate, install, uninstall, configure, and update features and packages in Windows images
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%Enable-WindowsOptionalFeature%" AND process.command_line LIKE "%-Online%" AND process.command_line LIKE "%-FeatureName%")) AND ((process.command_line LIKE "%TelnetServer%" OR process.command_line LIKE "%Internet-Explorer-Optional-amd64%" OR process.command_line LIKE "%TFTP%" OR process.command_line LIKE "%SMB1Protocol%" OR process.command_line LIKE "%Client-ProjFS%" OR process.command_line LIKE "%Microsoft-Windows-Subsystem-Linux%")))
