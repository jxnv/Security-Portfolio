// Title: Sysmon Configuration Error
// ID: 815cd91b-7dbc-4247-841a-d7dd1392b0a8
// Status: test
// Level: high
// Author: frack113
// Date: 2021-06-04
// Tags: attack.stealth, attack.t1564
// Description: Detects when an adversary is trying to hide it's action from Sysmon logging based on error messages
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((Description LIKE "%Failed to open service configuration with error%" OR Description LIKE "%Failed to connect to the driver to update configuration%")) AND NOT ((((Description LIKE "%Failed to open service configuration with error 19%" OR Description LIKE "%Failed to open service configuration with error 93%")) OR ((Description LIKE "%Failed to open service configuration with error%" AND Description LIKE "%Last error: The media is write protected.%")) OR ((Description LIKE "%Failed to open service configuration with error%" AND Description LIKE "%Last error: Média protégé en écriture.%")))))
