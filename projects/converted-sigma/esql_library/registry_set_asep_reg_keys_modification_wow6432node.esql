// Title: Wow6432Node CurrentVersion Autorun Keys Modification
// ID: b29aed60-ebd1-442b-9cb5-16a1d0324adb
// Status: test
// Level: medium
// Author: Victor Sergeev, Daniil Yugoslavskiy, Gleb Sukhodolskiy, Timur Zinniatullin, oscd.community, Tim Shelton, frack113 (split)
// Date: 2019-10-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects modification of autostart extensibility point (ASEP) in registry.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((registry.path LIKE "%\\SOFTWARE\\Wow6432Node\\Microsoft\\Windows\\CurrentVersion%") AND ((registry.path LIKE "%\\ShellServiceObjectDelayLoad%" OR registry.path LIKE "%\\Run\\%" OR registry.path LIKE "%\\RunOnce\\%" OR registry.path LIKE "%\\RunOnceEx\\%" OR registry.path LIKE "%\\RunServices\\%" OR registry.path LIKE "%\\RunServicesOnce\\%" OR registry.path LIKE "%\\Explorer\\ShellServiceObjects%" OR registry.path LIKE "%\\Explorer\\ShellIconOverlayIdentifiers%" OR registry.path LIKE "%\\Explorer\\ShellExecuteHooks%" OR registry.path LIKE "%\\Explorer\\SharedTaskScheduler%" OR registry.path LIKE "%\\Explorer\\Browser Helper Objects%"))) AND NOT ((((process.executable LIKE "%C:\\Program Files (x86)\\Microsoft\\EdgeUpdate\\Install\\{%" AND process.executable LIKE "%\\setup.exe%")) OR (registry.data.strings == "(Empty)") OR (registry.data.strings LIKE "\"C:\\ProgramData\\Package Cache\\{d21a4f20-968a-4b0c-bf04-a38da5f06e41}\\windowsdesktop-runtime-%") OR (process.executable == "C:\\WINDOWS\\system32\\msiexec.exe" AND registry.path LIKE "%\\SOFTWARE\\Wow6432Node\\Microsoft\\Windows\\CurrentVersion\\Run\\%") OR (registry.data.strings IS NULL) OR (process.executable LIKE "C:\\Windows\\Installer\\MSI%" AND registry.path LIKE "%\\Explorer\\Browser Helper Objects%") OR ((process.executable LIKE "C:\\ProgramData\\Package Cache%" OR process.executable LIKE "C:\\Windows\\Temp\\%") AND (process.executable LIKE "%\\winsdksetup.exe%" OR process.executable LIKE "%\\windowsdesktop-runtime-%" OR process.executable LIKE "%\\AspNetCoreSharedFrameworkBundle-%") AND registry.data.strings LIKE "% /burn.runonce") OR (process.executable LIKE "%\\VC_redist.x64.exe" AND registry.data.strings LIKE "%}\\VC_redist.x64.exe\" /burn.runonce"))) AND NOT (((process.executable LIKE "%\\instup.exe" AND registry.path LIKE "%\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\AvRepair" AND registry.data.strings LIKE "%instup.exe\" /instop:repair /wait") OR (process.executable LIKE "%\\instup.exe" AND (registry.path LIKE "%\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Explorer\\ShellIconOverlayIdentifiers\\00avg\\(Default)" OR registry.path LIKE "%\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Explorer\\ShellIconOverlayIdentifiers\\00asw\\(Default)") AND (registry.data.strings == "{472083B1-C522-11CF-8763-00608CC02F24}" OR registry.data.strings == "{472083B0-C522-11CF-8763-00608CC02F24}")) OR (registry.data.strings LIKE "%\\Avira.OE.Setup.Bundle.exe\" /burn.runonce" AND process.executable LIKE "%\\Avira.OE.Setup.Bundle.exe") OR (registry.path LIKE "%\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run\\Discord" AND registry.data.strings LIKE "%Discord.exe --checkInstall") OR (process.executable LIKE "%\\windowsdesktop-runtime-%" AND (registry.path LIKE "%\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\{e2d1ae32-dd1d-4ad7-a298-10e42e7840fc}" OR registry.path LIKE "%\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\{7037b699-7382-448c-89a7-4765961d2537}") AND registry.data.strings LIKE "\"C:\\ProgramData\\Package Cache\\%" AND registry.data.strings LIKE "%.exe\" /burn.runonce") OR ((registry.data.strings LIKE "%-A251-47B7-93E1-CDD82E34AF8B}") OR (registry.data.strings == "grpconv -o") OR ((registry.data.strings LIKE "%C:\\Program Files%" AND registry.data.strings LIKE "%\\Dropbox\\Client\\Dropbox.exe%" AND registry.data.strings LIKE "% /systemstartup%"))) OR (registry.path LIKE "%\\Explorer\\Browser Helper Objects\\{92EF2EAD-A7CE-4424-B0DB-499CF856608E}\\NoExplorer") OR (process.executable == "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\OfficeClickToRun.exe" AND registry.path LIKE "%\\Office\\ClickToRun\\REGISTRY\\MACHINE\\Software\\Wow6432Node\\%") OR ((process.executable == "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe" OR process.executable == "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe") AND registry.path LIKE "%\\Explorer\\Browser Helper Objects\\{31D09BA0-12F5-4CCE-BE8A-2923E76605DA}\\%") OR ((process.executable LIKE "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\%" OR process.executable LIKE "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\%") AND process.executable LIKE "%\\OfficeClickToRun.exe"))))
