// Title: Arbitrary File Download Via GfxDownloadWrapper.EXE
// ID: eee00933-a761-4cd0-be70-c42fe91731e7
// Status: test
// Level: medium
// Author: Victor Sergeev, oscd.community
// Date: 2020-10-09
// Tags: attack.command-and-control, attack.t1105
// Description: Detects execution of GfxDownloadWrapper.exe with a URL as an argument to download file.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%\\GfxDownloadWrapper.exe" AND (process.command_line LIKE "%http://%" OR process.command_line LIKE "%https://%")) AND NOT ((process.command_line LIKE "%https://gameplayapi.intel.com/%")))
