// Title: Access To Potentially Sensitive Sysvol Files By Uncommon Applications
// ID: d51694fe-484a-46ac-92d6-969e76d60d10
// Status: test
// Level: medium
// Author: frack113
// Date: 2023-12-21
// Tags: attack.credential-access, attack.t1552.006
// Description: Detects file access requests to potentially sensitive files hosted on the Windows Sysvol share.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((FileName LIKE "\\\\%" AND (FileName LIKE "%\\sysvol\\%" AND FileName LIKE "%\\Policies\\%") AND (FileName LIKE "%audit.csv" OR FileName LIKE "%Files.xml" OR FileName LIKE "%GptTmpl.inf" OR FileName LIKE "%groups.xml" OR FileName LIKE "%Registry.pol" OR FileName LIKE "%Registry.xml" OR FileName LIKE "%scheduledtasks.xml" OR FileName LIKE "%scripts.ini" OR FileName LIKE "%services.xml")) AND NOT (((process.executable == "C:\\Windows\\explorer.exe") OR ((process.executable LIKE "C:\\Program Files (x86)\\%" OR process.executable LIKE "C:\\Program Files\\%" OR process.executable LIKE "C:\\Windows\\system32\\%" OR process.executable LIKE "C:\\Windows\\SysWOW64\\%")))))
