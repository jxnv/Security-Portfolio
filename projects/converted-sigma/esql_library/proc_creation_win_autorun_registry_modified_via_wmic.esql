// Title: Suspicious Autorun Registry Modified via WMI
// ID: c80e66d8-1780-48a9-b412-46663fd21ac0
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-02-17
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1547.001, attack.t1047
// Description: Detects suspicious activity where the WMIC process is used to create an autorun registry entry via reg.exe, which is often indicative of persistence mechanisms employed by malware.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.command_line LIKE "%reg%" AND process.command_line LIKE "% add %") AND (process.command_line LIKE "%\\Software\\Microsoft\\Windows\\CurrentVersion\\Run%" OR process.command_line LIKE "%\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run%" OR process.command_line LIKE "%\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\Run%")) AND ((process.executable LIKE "%\\wmic.exe") OR (process.pe.original_file_name == "wmic.exe") OR (process.parent.executable LIKE "%\\wmiprvse.exe"))) AND (((process.command_line LIKE "%:\\Perflogs%" OR process.command_line LIKE "%:\\ProgramData'%" OR process.command_line LIKE "%:\\Windows\\Temp%" OR process.command_line LIKE "%:\\Temp%" OR process.command_line LIKE "%\\AppData\\Local\\Temp%" OR process.command_line LIKE "%\\AppData\\Roaming%" OR process.command_line LIKE "%:\\$Recycle.bin%" OR process.command_line LIKE "%:\\Users\\Default%" OR process.command_line LIKE "%:\\Users\\public%" OR process.command_line LIKE "%%temp%%" OR process.command_line LIKE "%%tmp%%" OR process.command_line LIKE "%%Public%%" OR process.command_line LIKE "%%AppData%%")) OR ((process.command_line LIKE "%:\\Users\\%") AND ((process.command_line LIKE "%\\Favorites%" OR process.command_line LIKE "%\\Favourites%" OR process.command_line LIKE "%\\Contacts%" OR process.command_line LIKE "%\\Music%" OR process.command_line LIKE "%\\Pictures%" OR process.command_line LIKE "%\\Documents%" OR process.command_line LIKE "%\\Photos%")))))
