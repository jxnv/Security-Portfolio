// Title: .RDP File Created By Uncommon Application
// ID: fccfb43e-09a7-4bd2-8b37-a5a7df33386d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.stealth
// Description: Detects creation of a file with an ".rdp" extension by an application that doesn't commonly create such files.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (file.path LIKE "%.rdp" AND (process.executable LIKE "%\\brave.exe" OR process.executable LIKE "%\\CCleaner Browser\\Application\\CCleanerBrowser.exe" OR process.executable LIKE "%\\chromium.exe" OR process.executable LIKE "%\\firefox.exe" OR process.executable LIKE "%\\Google\\Chrome\\Application\\chrome.exe" OR process.executable LIKE "%\\iexplore.exe" OR process.executable LIKE "%\\microsoftedge.exe" OR process.executable LIKE "%\\msedge.exe" OR process.executable LIKE "%\\Opera.exe" OR process.executable LIKE "%\\Vivaldi.exe" OR process.executable LIKE "%\\Whale.exe" OR process.executable LIKE "%\\olk.exe" OR process.executable LIKE "%\\Outlook.exe" OR process.executable LIKE "%\\RuntimeBroker.exe" OR process.executable LIKE "%\\Thunderbird.exe" OR process.executable LIKE "%\\Discord.exe" OR process.executable LIKE "%\\Keybase.exe" OR process.executable LIKE "%\\msteams.exe" OR process.executable LIKE "%\\Slack.exe" OR process.executable LIKE "%\\teams.exe"))
