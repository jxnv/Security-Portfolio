// Title: Hiding Files with Attrib.exe
// ID: 4281cb20-2994-4580-aa63-c8b86d019934
// Status: test
// Level: medium
// Author: Sami Ruohonen
// Date: 2019-01-16
// Tags: attack.stealth, attack.t1564.001
// Description: Detects usage of attrib.exe to hide files from users.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "% +h %") AND ((process.executable LIKE "%\\attrib.exe") OR (process.pe.original_file_name == "ATTRIB.EXE"))) AND NOT ((process.command_line LIKE "%\\desktop.ini %")) AND NOT ((process.parent.executable LIKE "%\\cmd.exe" AND process.command_line == "+R +H +S +A \\\\\\*.cui" AND process.parent.command_line == "C:\\\\WINDOWS\\\\system32\\\\\\*.bat")))
