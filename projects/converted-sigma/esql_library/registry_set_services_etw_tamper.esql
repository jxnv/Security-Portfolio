// Title: ETW Logging Disabled For SCM
// ID: 4f281b83-0200-4b34-bf35-d24687ea57c2
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-09
// Tags: attack.persistence, attack.defense-impairment, attack.t1112, attack.t1685
// Description: Detects changes to the "TracingDisabled" key in order to disable ETW logging for services.exe (SCM)
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (registry.path LIKE "%Software\\Microsoft\\Windows NT\\CurrentVersion\\Tracing\\SCM\\Regular\\TracingDisabled" AND registry.data.strings == "DWORD (0x00000001)")
