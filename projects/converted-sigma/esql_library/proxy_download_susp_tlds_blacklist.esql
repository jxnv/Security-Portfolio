// Title: Download From Suspicious TLD - Blacklist
// ID: 00d0b5ab-1f55-4120-8e83-487c0a7baf19
// Status: test
// Level: low
// Author: Florian Roth (Nextron Systems)
// Date: 2017-11-07
// Tags: attack.initial-access, attack.t1566, attack.execution, attack.t1203, attack.t1204.002
// Description: Detects download of certain file types from hosts in suspicious TLDs
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((c-uri-extension == "exe" OR c-uri-extension == "vbs" OR c-uri-extension == "bat" OR c-uri-extension == "rar" OR c-uri-extension == "ps1" OR c-uri-extension == "doc" OR c-uri-extension == "docm" OR c-uri-extension == "xls" OR c-uri-extension == "xlsm" OR c-uri-extension == "pptm" OR c-uri-extension == "rtf" OR c-uri-extension == "hta" OR c-uri-extension == "dll" OR c-uri-extension == "ws" OR c-uri-extension == "wsf" OR c-uri-extension == "sct" OR c-uri-extension == "zip") AND (cs-host LIKE "%.country" OR cs-host LIKE "%.stream" OR cs-host LIKE "%.gdn" OR cs-host LIKE "%.mom" OR cs-host LIKE "%.xin" OR cs-host LIKE "%.kim" OR cs-host LIKE "%.men" OR cs-host LIKE "%.loan" OR cs-host LIKE "%.download" OR cs-host LIKE "%.racing" OR cs-host LIKE "%.online" OR cs-host LIKE "%.science" OR cs-host LIKE "%.ren" OR cs-host LIKE "%.gb" OR cs-host LIKE "%.win" OR cs-host LIKE "%.top" OR cs-host LIKE "%.review" OR cs-host LIKE "%.vip" OR cs-host LIKE "%.party" OR cs-host LIKE "%.tech" OR cs-host LIKE "%.xyz" OR cs-host LIKE "%.date" OR cs-host LIKE "%.faith" OR cs-host LIKE "%.zip" OR cs-host LIKE "%.cricket" OR cs-host LIKE "%.space" OR cs-host LIKE "%.info" OR cs-host LIKE "%.vn" OR cs-host LIKE "%.cm" OR cs-host LIKE "%.am" OR cs-host LIKE "%.cc" OR cs-host LIKE "%.asia" OR cs-host LIKE "%.ws" OR cs-host LIKE "%.tk" OR cs-host LIKE "%.biz" OR cs-host LIKE "%.su" OR cs-host LIKE "%.st" OR cs-host LIKE "%.ro" OR cs-host LIKE "%.ge" OR cs-host LIKE "%.ms" OR cs-host LIKE "%.pk" OR cs-host LIKE "%.nu" OR cs-host LIKE "%.me" OR cs-host LIKE "%.ph" OR cs-host LIKE "%.to" OR cs-host LIKE "%.tt" OR cs-host LIKE "%.name" OR cs-host LIKE "%.tv" OR cs-host LIKE "%.kz" OR cs-host LIKE "%.tc" OR cs-host LIKE "%.mobi" OR cs-host LIKE "%.study" OR cs-host LIKE "%.click" OR cs-host LIKE "%.link" OR cs-host LIKE "%.trade" OR cs-host LIKE "%.accountant" OR cs-host LIKE "%.cf" OR cs-host LIKE "%.gq" OR cs-host LIKE "%.ml" OR cs-host LIKE "%.ga" OR cs-host LIKE "%.pw"))
