// Title: Webshell Detection With Command Line Keywords
// ID: bed2a484-9348-4143-8a8a-b801c979301c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Jonhnathan Ribeiro, Anton Kutepov, oscd.community, Chad Hudson, Matt Anderson
// Date: 2017-01-01
// Tags: attack.persistence, attack.discovery, attack.t1505.003, attack.t1018, attack.t1033, attack.t1087
// Description: Detects certain command line parameters often used during reconnaissance activity via web shells
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.parent.executable LIKE "%\\java.exe" OR process.parent.executable LIKE "%\\javaw.exe") AND (process.parent.executable LIKE "%-tomcat-%" OR process.parent.executable LIKE "%\\tomcat%")) OR ((process.parent.executable LIKE "%\\java.exe" OR process.parent.executable LIKE "%\\javaw.exe") AND (process.command_line LIKE "%catalina.jar%" OR process.command_line LIKE "%CATALINA_HOME%")) OR ((process.parent.executable LIKE "%\\w3wp.exe" OR process.parent.executable LIKE "%\\php-cgi.exe" OR process.parent.executable LIKE "%\\nginx.exe" OR process.parent.executable LIKE "%\\httpd.exe" OR process.parent.executable LIKE "%\\caddy.exe" OR process.parent.executable LIKE "%\\ws_tomcatservice.exe"))) AND (((process.command_line LIKE "%&cd&echo%" OR process.command_line LIKE "%cd /d %")) OR (((process.executable LIKE "%\\dsquery.exe" OR process.executable LIKE "%\\find.exe" OR process.executable LIKE "%\\findstr.exe" OR process.executable LIKE "%\\ipconfig.exe" OR process.executable LIKE "%\\netstat.exe" OR process.executable LIKE "%\\nslookup.exe" OR process.executable LIKE "%\\pathping.exe" OR process.executable LIKE "%\\quser.exe" OR process.executable LIKE "%\\schtasks.exe" OR process.executable LIKE "%\\systeminfo.exe" OR process.executable LIKE "%\\tasklist.exe" OR process.executable LIKE "%\\tracert.exe" OR process.executable LIKE "%\\wevtutil.exe" OR process.executable LIKE "%\\whoami.exe")) OR ((process.pe.original_file_name == "dsquery.exe" OR process.pe.original_file_name == "find.exe" OR process.pe.original_file_name == "findstr.exe" OR process.pe.original_file_name == "ipconfig.exe" OR process.pe.original_file_name == "netstat.exe" OR process.pe.original_file_name == "nslookup.exe" OR process.pe.original_file_name == "pathping.exe" OR process.pe.original_file_name == "quser.exe" OR process.pe.original_file_name == "schtasks.exe" OR process.pe.original_file_name == "sysinfo.exe" OR process.pe.original_file_name == "tasklist.exe" OR process.pe.original_file_name == "tracert.exe" OR process.pe.original_file_name == "VSSADMIN.EXE" OR process.pe.original_file_name == "wevtutil.exe" OR process.pe.original_file_name == "whoami.exe"))) OR ((process.command_line LIKE "% Test-NetConnection %" OR process.command_line LIKE "%dir \\%")) OR ((process.pe.original_file_name == "net.exe" OR process.pe.original_file_name == "net1.exe") AND (process.command_line LIKE "% user %" OR process.command_line LIKE "% use %" OR process.command_line LIKE "% group %")) OR (process.pe.original_file_name == "ping.exe" AND process.command_line LIKE "% -n %") OR ((process.executable LIKE "%\\cmd.exe" OR process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe") AND (process.command_line LIKE "% -enc %" OR process.command_line LIKE "% -EncodedCommand %" OR process.command_line LIKE "% -w hidden %" OR process.command_line LIKE "% -windowstyle hidden%" OR process.command_line LIKE "%.WebClient).Download%")) OR (process.pe.original_file_name == "wmic.exe" AND process.command_line LIKE "% /node:%")))
