// Title: Suspicious File Download From IP Via Wget.EXE - Paths
// ID: 40aa399c-7b02-4715-8e5f-73572b493f33
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-02-23
// Tags: attack.execution
// Description: Detects potentially suspicious file downloads directly from IP addresses and stored in suspicious locations using Wget.exe
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line RLIKE "\\s-O\\s") OR (process.command_line LIKE "%--output-document%")) AND (process.command_line LIKE "%http%") AND ((process.executable LIKE "%\\wget.exe") OR (process.pe.original_file_name == "wget.exe")) AND (process.command_line RLIKE "://[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}") AND (((process.command_line LIKE "%:\\PerfLogs\\%" OR process.command_line LIKE "%:\\Temp\\%" OR process.command_line LIKE "%:\\Users\\Public\\%" OR process.command_line LIKE "%:\\Windows\\Help\\%" OR process.command_line LIKE "%:\\Windows\\Temp\\%" OR process.command_line LIKE "%\\Temporary Internet%")) OR ((process.command_line LIKE "%:\\Users\\%" AND process.command_line LIKE "%\\Favorites\\%")) OR ((process.command_line LIKE "%:\\Users\\%" AND process.command_line LIKE "%\\Favourites\\%")) OR ((process.command_line LIKE "%:\\Users\\%" AND process.command_line LIKE "%\\Contacts\\%")) OR ((process.command_line LIKE "%:\\Users\\%" AND process.command_line LIKE "%\\Pictures\\%"))))
