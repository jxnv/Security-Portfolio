// Title: LSASS Access From Potentially White-Listed Processes
// ID: 4be8b654-0c01-4c9d-a10c-6b28467fc651
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-10
// Tags: attack.credential-access, attack.t1003.001, attack.s0002
// Description: Detects a possible process memory dump that uses a white-listed filename like TrolleyExpress.exe as a way to dump the LSASS process memory without Microsoft Defender interference
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (TargetImage LIKE "%\\lsass.exe" AND (SourceImage LIKE "%\\TrolleyExpress.exe" OR SourceImage LIKE "%\\ProcessDump.exe" OR SourceImage LIKE "%\\dump64.exe") AND (GrantedAccess LIKE "%10" OR GrantedAccess LIKE "%30" OR GrantedAccess LIKE "%50" OR GrantedAccess LIKE "%70" OR GrantedAccess LIKE "%90" OR GrantedAccess LIKE "%B0" OR GrantedAccess LIKE "%D0" OR GrantedAccess LIKE "%F0" OR GrantedAccess LIKE "%18" OR GrantedAccess LIKE "%38" OR GrantedAccess LIKE "%58" OR GrantedAccess LIKE "%78" OR GrantedAccess LIKE "%98" OR GrantedAccess LIKE "%B8" OR GrantedAccess LIKE "%D8" OR GrantedAccess LIKE "%F8" OR GrantedAccess LIKE "%1A" OR GrantedAccess LIKE "%3A" OR GrantedAccess LIKE "%5A" OR GrantedAccess LIKE "%7A" OR GrantedAccess LIKE "%9A" OR GrantedAccess LIKE "%BA" OR GrantedAccess LIKE "%DA" OR GrantedAccess LIKE "%FA" OR GrantedAccess LIKE "%0x14C2" OR GrantedAccess LIKE "%FF"))
