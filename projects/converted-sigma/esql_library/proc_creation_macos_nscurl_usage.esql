// Title: File Download Via Nscurl - MacOS
// ID: 6d8a7cf1-8085-423b-b87d-7e880faabbdf
// Status: test
// Level: medium
// Author: Daniel Cortez
// Date: 2024-06-04
// Tags: attack.command-and-control, attack.t1105
// Description: Detects the execution of the nscurl utility in order to download files.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (process.executable LIKE "%/nscurl" AND (process.command_line LIKE "%--download %" OR process.command_line LIKE "%--download-directory %" OR process.command_line LIKE "%--output %" OR process.command_line LIKE "%-dir %" OR process.command_line LIKE "%-dl %" OR process.command_line LIKE "%-ld%" OR process.command_line LIKE "%-o %"))
