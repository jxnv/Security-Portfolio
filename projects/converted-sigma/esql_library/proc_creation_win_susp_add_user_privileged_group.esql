// Title: User Added To Highly Privileged Group
// ID: 10fb649c-3600-4d37-b1e6-56ea90bb7e09
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-02-23
// Tags: attack.privilege-escalation, attack.persistence, attack.t1098
// Description: Detects addition of users to highly privileged groups via "Net" or "Add-LocalGroupMember".
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%Group Policy Creator Owners%" OR process.command_line LIKE "%Schema Admins%")) AND (((process.command_line LIKE "%localgroup %" AND process.command_line LIKE "% /add%")) OR ((process.command_line LIKE "%Add-LocalGroupMember %" AND process.command_line LIKE "% -Group %"))))
