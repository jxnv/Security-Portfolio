// Title: Potentially Suspicious GrantedAccess Flags On LSASS
// ID: a18dd26b-6450-46de-8c91-9659150cf088
// Status: test
// Level: medium
// Author: Florian Roth, Roberto Rodriguez, Dimitrios Slamaris, Mark Russinovich, Thomas Patzke, Teymur Kheirkhabarov, Sherif Eldeeb, James Dickenson, Aleksey Potapov, oscd.community
// Date: 2021-11-22
// Tags: attack.credential-access, attack.t1003.001, attack.s0002
// Description: Detects process access requests to LSASS process with potentially suspicious access flags
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((((GrantedAccess LIKE "%30" OR GrantedAccess LIKE "%50" OR GrantedAccess LIKE "%70" OR GrantedAccess LIKE "%90" OR GrantedAccess LIKE "%B0" OR GrantedAccess LIKE "%D0" OR GrantedAccess LIKE "%F0" OR GrantedAccess LIKE "%18" OR GrantedAccess LIKE "%38" OR GrantedAccess LIKE "%58" OR GrantedAccess LIKE "%78" OR GrantedAccess LIKE "%98" OR GrantedAccess LIKE "%B8" OR GrantedAccess LIKE "%D8" OR GrantedAccess LIKE "%F8" OR GrantedAccess LIKE "%1A" OR GrantedAccess LIKE "%3A" OR GrantedAccess LIKE "%5A" OR GrantedAccess LIKE "%7A" OR GrantedAccess LIKE "%9A" OR GrantedAccess LIKE "%BA" OR GrantedAccess LIKE "%DA" OR GrantedAccess LIKE "%FA" OR GrantedAccess LIKE "%0x14C2")) OR ((GrantedAccess LIKE "0x100000%" OR GrantedAccess LIKE "0x1418%" OR GrantedAccess LIKE "0x1438%" OR GrantedAccess LIKE "0x143a%" OR GrantedAccess LIKE "0x1f0fff%" OR GrantedAccess LIKE "0x1f1fff%" OR GrantedAccess LIKE "0x1f2fff%" OR GrantedAccess LIKE "0x1f3fff%" OR GrantedAccess LIKE "0x40%"))) AND (TargetImage LIKE "%\\lsass.exe")) AND NOT (((SourceImage LIKE "%\\explorer.exe" AND GrantedAccess == "0x401") OR ((SourceImage LIKE "%:\\Program Files (x86)\\%" OR SourceImage LIKE "%:\\Program Files\\%" OR SourceImage LIKE "%:\\Windows\\System32\\%" OR SourceImage LIKE "%:\\Windows\\SysWOW64\\%")) OR (SourceImage LIKE "%:\\ProgramData\\Microsoft\\Windows Defender\\%" AND SourceImage LIKE "%\\MsMpEng.exe") OR ((CallTrace LIKE "%|?:\\ProgramData\\Microsoft\\Windows Defender\\Definition Updates\\{%" AND CallTrace LIKE "%}\\mpengine.dll+%") AND GrantedAccess == "0x1418") OR ((CallTrace LIKE "%|c:\\program files\\windows defender\\mprtp.dll%" OR CallTrace LIKE "%|c:\\program files\\windows defender\\MpClient.dll%")))) AND NOT (((SourceImage LIKE "%:\\ProgramData\\MALWAREBYTES\\MBAMSERVICE\\ctlrupdate\\mbupdatr.exe") OR (SourceImage LIKE "%\\MBAMInstallerService.exe" AND GrantedAccess == "0x40") OR ((SourceImage LIKE "%\\aurora-agent-64.exe" OR SourceImage LIKE "%\\aurora-agent.exe" OR SourceImage LIKE "%\\thor.exe" OR SourceImage LIKE "%\\thor64.exe") AND GrantedAccess == "0x40") OR (SourceImage LIKE "%\\SteamLibrary\\steamapps\\%") OR ((SourceImage LIKE "%\\handle.exe" OR SourceImage LIKE "%\\handle64.exe" OR SourceImage LIKE "%\\handle64a.exe") AND GrantedAccess == "0x40") OR ((SourceImage LIKE "%\\PROCEXP64.EXE" OR SourceImage LIKE "%\\PROCEXP.EXE") AND GrantedAccess == "0x40") OR (SourceImage LIKE "%:\\ProgramData\\VMware\\VMware Tools\\%" AND SourceImage LIKE "%\\vmtoolsd.exe") OR (SourceImage LIKE "%\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe") OR (SourceImage LIKE "%\\AppData\\Local\\WebEx\\WebexHost.exe" AND GrantedAccess == "0x401"))))
