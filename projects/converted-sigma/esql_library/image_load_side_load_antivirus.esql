// Title: Potential Antivirus Software DLL Sideloading
// ID: 552b6b65-df37-4d3e-a258-f2fc4771ae54
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Wietze Beukema (project and research)
// Date: 2022-08-17
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of DLLs that are part of antivirus software suchas McAfee, Symantec...etc
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((ImageLoaded LIKE "%\\log.dll") AND NOT ((((ImageLoaded == "C:\\Program Files\\AVAST Software\\Avast\\log.dll" OR ImageLoaded == "C:\\Program Files (x86)\\AVAST Software\\Avast\\log.dll")) OR ((ImageLoaded == "C:\\Program Files\\AVG\\Antivirus\\log.dll" OR ImageLoaded == "C:\\Program Files (x86)\\AVG\\Antivirus\\log.dll")) OR ((ImageLoaded LIKE "C:\\Program Files\\Bitdefender Antivirus Free\\%" OR ImageLoaded LIKE "C:\\Program Files (x86)\\Bitdefender Antivirus Free\\%")) OR (ImageLoaded LIKE "C:\\Program Files\\Canon\\MyPrinter\\%") OR (process.executable == "C:\\Program Files\\Dell\\SARemediation\\audit\\TelemetryUtility.exe" AND (ImageLoaded == "C:\\Program Files\\Dell\\SARemediation\\plugin\\log.dll" OR ImageLoaded == "C:\\Program Files\\Dell\\SARemediation\\audit\\log.dll"))))) OR ((ImageLoaded LIKE "%\\qrt.dll") AND NOT (((ImageLoaded LIKE "C:\\Program Files\\F-Secure\\Anti-Virus\\%" OR ImageLoaded LIKE "C:\\Program Files (x86)\\F-Secure\\Anti-Virus\\%")))) OR (((ImageLoaded LIKE "%\\ashldres.dll" OR ImageLoaded LIKE "%\\lockdown.dll" OR ImageLoaded LIKE "%\\vsodscpl.dll")) AND NOT (((ImageLoaded LIKE "C:\\Program Files\\McAfee\\%" OR ImageLoaded LIKE "C:\\Program Files (x86)\\McAfee\\%")))) OR ((ImageLoaded LIKE "%\\vftrace.dll") AND NOT (((ImageLoaded LIKE "C:\\Program Files\\CyberArk\\Endpoint Privilege Manager\\Agent\\x32\\%" OR ImageLoaded LIKE "C:\\Program Files (x86)\\CyberArk\\Endpoint Privilege Manager\\Agent\\x32\\%")))) OR ((ImageLoaded LIKE "%\\wsc.dll") AND NOT ((((ImageLoaded LIKE "C:\\program Files\\AVAST Software\\Avast\\%" OR ImageLoaded LIKE "C:\\program Files (x86)\\AVAST Software\\Avast\\%")) OR ((ImageLoaded LIKE "C:\\Program Files\\AVG\\Antivirus\\%" OR ImageLoaded LIKE "C:\\Program Files (x86)\\AVG\\Antivirus\\%"))))) OR ((ImageLoaded LIKE "%\\tmdbglog.dll") AND NOT (((ImageLoaded LIKE "C:\\program Files\\Trend Micro\\Titanium\\%" OR ImageLoaded LIKE "C:\\program Files (x86)\\Trend Micro\\Titanium\\%")))) OR ((ImageLoaded LIKE "%\\DLPPREM32.dll") AND NOT (((ImageLoaded LIKE "C:\\program Files\\ESET%" OR ImageLoaded LIKE "C:\\program Files (x86)\\ESET%")))))
