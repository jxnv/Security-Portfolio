// Title: Allow RDP Remote Assistance Feature
// ID: 37b437cf-3fc5-4c8e-9c94-1d7c9aff842b
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-08-19
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detect enable rdp feature to allow specific user to rdp connect on the targeted machine
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (registry.path LIKE "%System\\CurrentControlSet\\Control\\Terminal Server\\fAllowToGetHelp" AND registry.data.strings == "DWORD (0x00000001)")
