// Title: Uncommon File Creation By Mysql Daemon Process
// ID: c61daa90-3c1e-4f18-af62-8f288b5c9aaf
// Status: test
// Level: high
// Author: Joseph Kamau
// Date: 2024-05-27
// Tags: attack.stealth
// Description: Detects the creation of files with scripting or executable extensions by Mysql daemon.
// Which could be an indicator of "User Defined Functions" abuse to download malware.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%\\mysqld.exe" OR process.executable LIKE "%\\mysqld-nt.exe") AND (file.path LIKE "%.bat" OR file.path LIKE "%.dat" OR file.path LIKE "%.dll" OR file.path LIKE "%.exe" OR file.path LIKE "%.ps1" OR file.path LIKE "%.psm1" OR file.path LIKE "%.vbe" OR file.path LIKE "%.vbs"))
