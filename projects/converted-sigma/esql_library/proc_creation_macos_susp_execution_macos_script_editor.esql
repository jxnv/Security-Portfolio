// Title: Suspicious Execution via macOS Script Editor
// ID: 6e4dcdd1-e48b-42f7-b2d8-3b413fc58cb4
// Status: test
// Level: medium
// Author: Tim Rauch (rule), Elastic (idea)
// Date: 2022-10-21
// Tags: attack.defense-impairment, attack.t1566, attack.t1566.002, attack.initial-access, attack.t1059, attack.t1059.002, attack.t1204, attack.t1204.001, attack.execution, attack.persistence, attack.t1553
// Description: Detects when the macOS Script Editor utility spawns an unusual child process.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.executable LIKE "%/curl" OR process.executable LIKE "%/bash" OR process.executable LIKE "%/sh" OR process.executable LIKE "%/zsh" OR process.executable LIKE "%/dash" OR process.executable LIKE "%/fish" OR process.executable LIKE "%/osascript" OR process.executable LIKE "%/mktemp" OR process.executable LIKE "%/chmod" OR process.executable LIKE "%/php" OR process.executable LIKE "%/nohup" OR process.executable LIKE "%/openssl" OR process.executable LIKE "%/plutil" OR process.executable LIKE "%/PlistBuddy" OR process.executable LIKE "%/xattr" OR process.executable LIKE "%/sqlite" OR process.executable LIKE "%/funzip" OR process.executable LIKE "%/popen")) OR ((process.executable LIKE "%python%" OR process.executable LIKE "%perl%"))) AND (process.parent.executable LIKE "%/Script Editor"))
