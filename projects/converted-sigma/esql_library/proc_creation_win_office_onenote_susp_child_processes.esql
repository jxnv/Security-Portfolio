// Title: Suspicious Microsoft OneNote Child Process
// ID: c27515df-97a9-4162-8a60-dc0eeb51b775
// Status: test
// Level: high
// Author: Tim Rauch (Nextron Systems), Nasreddine Bencherchali (Nextron Systems), Elastic (idea)
// Date: 2022-10-21
// Tags: attack.t1566, attack.t1566.001, attack.initial-access
// Description: Detects suspicious child processes of the Microsoft OneNote application. This may indicate an attempt to execute malicious embedded objects from a .one file.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.parent.executable LIKE "%\\onenote.exe") AND ((process.executable LIKE "%\\explorer.exe" AND (process.command_line LIKE "%.hta%" OR process.command_line LIKE "%.vb%" OR process.command_line LIKE "%.wsh%" OR process.command_line LIKE "%.js%" OR process.command_line LIKE "%.ps%" OR process.command_line LIKE "%.scr%" OR process.command_line LIKE "%.pif%" OR process.command_line LIKE "%.bat%" OR process.command_line LIKE "%.cmd%")) OR (((process.pe.original_file_name == "bitsadmin.exe" OR process.pe.original_file_name == "CertOC.exe" OR process.pe.original_file_name == "CertUtil.exe" OR process.pe.original_file_name == "Cmd.Exe" OR process.pe.original_file_name == "CMSTP.EXE" OR process.pe.original_file_name == "cscript.exe" OR process.pe.original_file_name == "curl.exe" OR process.pe.original_file_name == "HH.exe" OR process.pe.original_file_name == "IEExec.exe" OR process.pe.original_file_name == "InstallUtil.exe" OR process.pe.original_file_name == "javaw.exe" OR process.pe.original_file_name == "Microsoft.Workflow.Compiler.exe" OR process.pe.original_file_name == "msdt.exe" OR process.pe.original_file_name == "MSHTA.EXE" OR process.pe.original_file_name == "msiexec.exe" OR process.pe.original_file_name == "Msxsl.exe" OR process.pe.original_file_name == "odbcconf.exe" OR process.pe.original_file_name == "pcalua.exe" OR process.pe.original_file_name == "PowerShell.EXE" OR process.pe.original_file_name == "RegAsm.exe" OR process.pe.original_file_name == "RegSvcs.exe" OR process.pe.original_file_name == "REGSVR32.exe" OR process.pe.original_file_name == "RUNDLL32.exe" OR process.pe.original_file_name == "schtasks.exe" OR process.pe.original_file_name == "ScriptRunner.exe" OR process.pe.original_file_name == "wmic.exe" OR process.pe.original_file_name == "WorkFolders.exe" OR process.pe.original_file_name == "wscript.exe")) OR ((process.executable LIKE "%\\AppVLP.exe" OR process.executable LIKE "%\\bash.exe" OR process.executable LIKE "%\\bitsadmin.exe" OR process.executable LIKE "%\\certoc.exe" OR process.executable LIKE "%\\certutil.exe" OR process.executable LIKE "%\\cmd.exe" OR process.executable LIKE "%\\cmstp.exe" OR process.executable LIKE "%\\control.exe" OR process.executable LIKE "%\\cscript.exe" OR process.executable LIKE "%\\curl.exe" OR process.executable LIKE "%\\forfiles.exe" OR process.executable LIKE "%\\hh.exe" OR process.executable LIKE "%\\ieexec.exe" OR process.executable LIKE "%\\installutil.exe" OR process.executable LIKE "%\\javaw.exe" OR process.executable LIKE "%\\mftrace.exe" OR process.executable LIKE "%\\Microsoft.Workflow.Compiler.exe" OR process.executable LIKE "%\\msbuild.exe" OR process.executable LIKE "%\\msdt.exe" OR process.executable LIKE "%\\mshta.exe" OR process.executable LIKE "%\\msidb.exe" OR process.executable LIKE "%\\msiexec.exe" OR process.executable LIKE "%\\msxsl.exe" OR process.executable LIKE "%\\odbcconf.exe" OR process.executable LIKE "%\\pcalua.exe" OR process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe" OR process.executable LIKE "%\\regasm.exe" OR process.executable LIKE "%\\regsvcs.exe" OR process.executable LIKE "%\\regsvr32.exe" OR process.executable LIKE "%\\rundll32.exe" OR process.executable LIKE "%\\schtasks.exe" OR process.executable LIKE "%\\scrcons.exe" OR process.executable LIKE "%\\scriptrunner.exe" OR process.executable LIKE "%\\sh.exe" OR process.executable LIKE "%\\svchost.exe" OR process.executable LIKE "%\\verclsid.exe" OR process.executable LIKE "%\\wmic.exe" OR process.executable LIKE "%\\workfolders.exe" OR process.executable LIKE "%\\wscript.exe"))) OR ((process.executable LIKE "%\\AppData\\%" OR process.executable LIKE "%\\Users\\Public\\%" OR process.executable LIKE "%\\ProgramData\\%" OR process.executable LIKE "%\\Windows\\Tasks\\%" OR process.executable LIKE "%\\Windows\\Temp\\%" OR process.executable LIKE "%\\Windows\\System32\\Tasks\\%"))) AND NOT (((process.executable LIKE "%\\AppData\\Local\\Microsoft\\OneDrive\\%" AND process.executable LIKE "%\\FileCoAuth.exe" AND process.command_line LIKE "%-Embedding") OR (process.executable LIKE "%\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe" AND process.command_line LIKE "%-Embedding"))))
