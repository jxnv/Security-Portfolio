// Title: Load Of RstrtMgr.DLL By An Uncommon Process
// ID: 3669afd2-9891-4534-a626-e5cf03810a61
// Status: test
// Level: low
// Author: Luc Génaux
// Date: 2023-11-28
// Tags: attack.impact, attack.defense-impairment, attack.t1486, attack.t1685
// Description: Detects the load of RstrtMgr DLL (Restart Manager) by an uncommon process.
// This library has been used during ransomware campaigns to kill processes that would prevent file encryption by locking them (e.g. Conti ransomware, Cactus ransomware). It has also recently been seen used by the BiBi wiper for Windows.
// It could also be used for anti-analysis purposes by shut downing specific processes.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((ImageLoaded LIKE "%\\RstrtMgr.dll") OR (process.pe.original_file_name == "RstrtMgr.dll")) AND NOT (((process.executable LIKE "C:\\Windows\\Temp\\%") OR ((process.executable LIKE "C:\\$WINDOWS.~BT\\%" OR process.executable LIKE "C:\\$WinREAgent\\%" OR process.executable LIKE "C:\\Program Files (x86)\\%" OR process.executable LIKE "C:\\Program Files\\%" OR process.executable LIKE "C:\\ProgramData\\%" OR process.executable LIKE "C:\\Windows\\explorer.exe%" OR process.executable LIKE "C:\\Windows\\SoftwareDistribution\\%" OR process.executable LIKE "C:\\Windows\\SysNative\\%" OR process.executable LIKE "C:\\Windows\\System32\\%" OR process.executable LIKE "C:\\Windows\\SysWOW64\\%" OR process.executable LIKE "C:\\Windows\\WinSxS\\%" OR process.executable LIKE "C:\\WUDownloadCache\\%")) OR (process.executable LIKE "C:\\Users\\%" AND (process.executable LIKE "%\\AppData\\Local\\Temp\\is-%" AND process.executable LIKE "%.tmp\\%") AND process.executable LIKE "%.tmp"))) AND NOT (((process.executable LIKE "C:\\Users\\%" AND (process.executable LIKE "%\\AppData\\Local\\Microsoft\\OneDrive\\OneDrive.exe" OR process.executable LIKE "%\\AppData\\Local\\Microsoft\\OneDrive\\OneDriveStandaloneUpdater.exe")) OR (process.executable LIKE "C:\\Users\\%" AND process.executable LIKE "%\\AppData\\Local\\Microsoft\\OneDrive\\%" AND process.executable LIKE "%\\OneDrive.Sync.Service.exe"))))
