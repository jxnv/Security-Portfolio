// Title: Suspicious Mshta.EXE Execution Patterns
// ID: e32f92d1-523e-49c3-9374-bdb13b46a3ba
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-07-17
// Tags: attack.execution, attack.t1106
// Description: Detects suspicious mshta process execution patterns
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.executable LIKE "%\\mshta.exe") OR (process.pe.original_file_name == "MSHTA.EXE")) AND ((process.parent.executable LIKE "%\\cmd.exe" OR process.parent.executable LIKE "%\\cscript.exe" OR process.parent.executable LIKE "%\\powershell.exe" OR process.parent.executable LIKE "%\\pwsh.exe" OR process.parent.executable LIKE "%\\regsvr32.exe" OR process.parent.executable LIKE "%\\rundll32.exe" OR process.parent.executable LIKE "%\\wscript.exe") AND (process.command_line LIKE "%\\AppData\\Local\\%" OR process.command_line LIKE "%C:\\ProgramData\\%" OR process.command_line LIKE "%C:\\Users\\Public\\%" OR process.command_line LIKE "%C:\\Windows\\Temp\\%"))) OR (((process.executable LIKE "%\\mshta.exe") OR (process.pe.original_file_name == "MSHTA.EXE")) AND NOT ((((process.executable LIKE "C:\\Windows\\System32\\%" OR process.executable LIKE "C:\\Windows\\SysWOW64\\%")) OR ((process.command_line LIKE "%.htm%" OR process.command_line LIKE "%.hta%")) OR ((process.command_line LIKE "%mshta.exe" OR process.command_line LIKE "%mshta"))))))
