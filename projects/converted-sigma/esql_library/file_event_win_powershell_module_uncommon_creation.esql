// Title: PowerShell Module File Created By Non-PowerShell Process
// ID: e3845023-ca9a-4024-b2b2-5422156d5527
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-09
// Tags: attack.persistence
// Description: Detects the creation of a new PowerShell module ".psm1", ".psd1", ".dll", ".ps1", etc. by a non-PowerShell process
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((file.path LIKE "%\\WindowsPowerShell\\Modules\\%" OR file.path LIKE "%\\PowerShell\\7\\Modules\\%")) AND NOT ((((process.executable == "C:\\Windows\\System32\\msiexec.exe" OR process.executable == "C:\\Windows\\SysWOW64\\msiexec.exe")) OR ((process.executable LIKE "%:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" OR process.executable LIKE "%:\\Program Files\\PowerShell\\7\\pwsh.exe" OR process.executable LIKE "%:\\Windows\\System32\\poqexec.exe" OR process.executable LIKE "%:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" OR process.executable LIKE "%:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" OR process.executable LIKE "%:\\Windows\\SysWOW64\\poqexec.exe" OR process.executable LIKE "%:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" OR process.executable LIKE "%:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")))))
