// Title: Suspicious Binary In User Directory Spawned From Office Application
// ID: aa3a6f94-890e-4e22-b634-ffdfd54792cc
// Status: test
// Level: high
// Author: Jason Lynch
// Date: 2019-04-02
// Tags: attack.execution, attack.t1204.002, attack.g0046, car.2013-05-002
// Description: Detects an executable in the users directory started from one of the Microsoft Office suite applications (Word, Excel, PowerPoint, Publisher, Visio)
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.parent.executable LIKE "%\\WINWORD.EXE" OR process.parent.executable LIKE "%\\EXCEL.EXE" OR process.parent.executable LIKE "%\\POWERPNT.exe" OR process.parent.executable LIKE "%\\MSPUB.exe" OR process.parent.executable LIKE "%\\VISIO.exe" OR process.parent.executable LIKE "%\\MSACCESS.exe" OR process.parent.executable LIKE "%\\EQNEDT32.exe") AND process.executable LIKE "C:\\users\\%" AND process.executable LIKE "%.exe") AND NOT ((process.executable LIKE "%\\Teams.exe")))
