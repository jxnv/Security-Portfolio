// Title: Shell Execution Of Process Located In Tmp Directory
// ID: 2fade0b6-7423-4835-9d4f-335b39b83867
// Status: test
// Level: high
// Author: Joseliyo Sanchez, @Joseliyo_Jstnk
// Date: 2023-06-02
// Tags: attack.execution
// Description: Detects execution of shells from a parent process located in a temporary (/tmp) directory
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (process.parent.executable LIKE "/tmp/%" AND (process.executable LIKE "%/bash" OR process.executable LIKE "%/csh" OR process.executable LIKE "%/dash" OR process.executable LIKE "%/fish" OR process.executable LIKE "%/ksh" OR process.executable LIKE "%/sh" OR process.executable LIKE "%/zsh"))
