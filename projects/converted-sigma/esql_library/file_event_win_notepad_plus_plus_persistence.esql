// Title: Potential Persistence Via Notepad++ Plugins
// ID: 54127bd4-f541-4ac3-afdb-ea073f63f692
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-10
// Tags: attack.persistence
// Description: Detects creation of new ".dll" files inside the plugins directory of a notepad++ installation by a process other than "gup.exe". Which could indicates possible persistence
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((file.path LIKE "%\\Notepad++\\plugins\\%" AND file.path LIKE "%.dll") AND NOT (((process.executable LIKE "%\\Notepad++\\updater\\gup.exe") OR (process.executable LIKE "C:\\Users\\%" AND process.executable LIKE "%\\AppData\\Local\\Temp\\%" AND (process.executable LIKE "%\\target.exe" OR process.executable LIKE "%Installer.x64.exe")) OR (process.executable LIKE "%\\npp.%" AND process.executable LIKE "%.exe" AND (file.path == "C:\\Program Files\\Notepad++\\plugins\\NppExport\\NppExport.dll" OR file.path == "C:\\Program Files\\Notepad++\\plugins\\mimeTools\\mimeTools.dll" OR file.path == "C:\\Program Files\\Notepad++\\plugins\\NppConverter\\NppConverter.dll" OR file.path == "C:\\Program Files\\Notepad++\\plugins\\Config\\nppPluginList.dll")))))
