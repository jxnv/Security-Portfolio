IKE "%\\ShareEnum.exe" OR process.executable LIKE "%\\ShareEnum64.exe" OR process.executable LIKE "%\\shellRunas.exe" OR process.executable LIKE "%\\sigcheck.exe" OR process.executable LIKE "%\\sigcheck64.exe" OR process.executable LIKE "%\\streams.exe" OR process.executable LIKE "%\\streams64.exe" OR process.executable LIKE "%\\strings.exe" OR process.executable LIKE "%\\strings64.exe" OR process.executable LIKE "%\\sync.exe" OR process.executable LIKE "%\\sync64.exe" OR process.executable LIKE "%\\Sysmon.exe" OR process.executable LIKE "%\\Sysmon64.exe" OR process.executable LIKE "%\\tcpvcon.exe" OR process.executable LIKE "%\\tcpvcon64.exe" OR process.executable LIKE "%\\tcpview.exe" OR process.executable LIKE "%\\tcpview64.exe" OR process.executable LIKE "%\\Testlimit.exe" OR process.executable LIKE "%\\Testlimit64.exe" OR process.executable LIKE "%\\vmmap.exe" OR process.executable LIKE "%\\vmmap64.exe" OR process.executable LIKE "%\\Volumeid.exe" OR process.executable LIKE "%\\Volumeid64.exe" OR process.executable LIKE "%\\whois.exe" OR process.executable LIKE "%\\whois64.exe" OR process.executable LIKE "%\\Winobj.exe" OR process.executable LIKE "%\\Winobj64.exe" OR process.executable LIKE "%\\ZoomIt.exe" OR process.executable LIKE "%\\ZoomIt64.exe"))) AND NOT ((((Company IS NULL) OR (Product IS NULL)) OR (((Company == "Sysinternals - www.sysinternals.com" OR Company == "Sysinternals")) OR (Product LIKE "Sysinternals%")))))
