// Title: Potential Binary Impersonating Sysinternals Tools
// ID: 7cce6fc8-a07f-4d84-a53e-96e1879843c9
// Status: test
// Level: medium
// Author: frack113, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2021-12-20
// Tags: attack.execution, attack.stealth, attack.t1218, attack.t1202, attack.t1036.005
// Description: Detects binaries that use the same name as legitimate sysinternals tools to evade detection.
// This rule looks for the execution of binaries that are named similarly to Sysinternals tools.
// Adversary may rename their malicious tools as legitimate Sysinternals tools to evade detection.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.executable LIKE "%\\accesschk64a.exe" OR process.executable LIKE "%\\ADExplorer64a.exe" OR process.executable LIKE "%\\ADInsight64a.exe" OR process.executable LIKE "%\\adrestore64a.exe" OR process.executable LIKE "%\\Autologon64a.exe" OR process.executable LIKE "%\\Autoruns64a.exe" OR process.executable LIKE "%\\autorunsc64a.exe" OR process.executable LIKE "%\\Clockres64a.exe" OR process.executable LIKE "%\\Contig64a.exe" OR process.executable LIKE "%\\Coreinfo64a.exe" OR process.executable LIKE "%\\Dbgview64a.exe" OR process.executable LIKE "%\\disk2vhd64a.exe" OR process.executable LIKE "%\\diskext64a.exe" OR process.executable LIKE "%\\DiskView64a.exe" OR process.executable LIKE "%\\du64a.exe" OR process.executable LIKE "%\\FindLinks64a.exe" OR process.executable LIKE "%\\handle64a.exe" OR process.executable LIKE "%\\hex2dec64a.exe" OR process.executable LIKE "%\\junction64a.exe" OR process.executable LIKE "%\\LoadOrd64a.exe" OR process.executable LIKE "%\\LoadOrdC64a.exe" OR process.executable LIKE "%\\logonsessions64a.exe" OR process.executable LIKE "%\\movefile64a.exe" OR process.executable LIKE "%\\notmyfault64a.exe" OR process.executable LIKE "%\\notmyfaultc64a.exe" OR process.executable LIKE "%\\pendmoves64a.exe" OR process.executable LIKE "%\\pipelist64a.exe" OR process.executable LIKE "%\\procdump64a.exe" OR process.executable LIKE "%\\procexp64a.exe" OR process.executable LIKE "%\\Procmon64a.exe" OR process.executable LIKE "%\\PsExec64a.exe" OR process.executable LIKE "%\\psfile64a.exe" OR process.executable LIKE "%\\PsGetsid64a.exe" OR process.executable LIKE "%\\PsInfo64a.exe" OR process.executable LIKE "%\\pskill64a.exe" OR process.executable LIKE "%\\psloglist64a.exe" OR process.executable LIKE "%\\pspasswd64a.exe" OR process.executable LIKE "%\\psping64a.exe" OR process.executable LIKE "%\\PsService64a.exe" OR process.executable LIKE "%\\pssuspend64a.exe" OR process.executable LIKE "%\\RAMMap64a.exe" OR process.executable LIKE "%\\RegDelNull64a.exe" OR process.executable LIKE "%\\ru64a.exe" OR process.executable LIKE "%\\sdelete64a.exe" OR process.executable LIKE "%\\sigcheck64a.exe" OR process.executable LIKE "%\\streams64a.exe" OR process.executable LIKE "%\\strings64a.exe" OR process.executable LIKE "%\\sync64a.exe" OR process.executable LIKE "%\\Sysmon64a.exe" OR process.executable LIKE "%\\tcpvcon64a.exe" OR process.executable LIKE "%\\tcpview64a.exe" OR process.executable LIKE "%\\vmmap64a.exe" OR process.executable LIKE "%\\whois64a.exe" OR process.executable LIKE "%\\Winobj64a.exe" OR process.executable LIKE "%\\ZoomIt64a.exe")) OR ((process.executable LIKE "%\\accesschk.exe" OR process.executable LIKE "%\\accesschk64.exe" OR process.executable LIKE "%\\AccessEnum.exe" OR process.executable LIKE "%\\ADExplorer.exe" OR process.executable LIKE "%\\ADExplorer64.exe" OR process.executable LIKE "%\\ADInsight.exe" OR process.executable LIKE "%\\ADInsight64.exe" OR process.executable LIKE "%\\adrestore.exe" OR process.executable LIKE "%\\adrestore64.exe" OR process.executable LIKE "%\\Autologon.exe" OR process.executable LIKE "%\\Autologon64.exe" OR process.executable LIKE "%\\Autoruns.exe" OR process.executable LIKE "%\\Autoruns64.exe" OR process.executable LIKE "%\\autorunsc.exe" OR process.executable LIKE "%\\autorunsc64.exe" OR process.executable LIKE "%\\Bginfo.exe" OR process.executable LIKE "%\\Bginfo64.exe" OR process.executable LIKE "%\\Cacheset.exe" OR process.executable LIKE "%\\Cacheset64.exe" OR process.executable LIKE "%\\Clockres.exe" OR process.executable LIKE "%\\Clockres64.exe" OR process.executable LIKE "%\\Contig.exe" OR process.executable LIKE "%\\Contig64.exe" OR process.executable LIKE "%\\Coreinfo.exe" OR process.executable LIKE "%\\Coreinfo64.exe" OR process.executable LIKE "%\\CPUSTRES.EXE" OR process.executable LIKE "%\\CPUSTRES64.EXE" OR process.executable LIKE "%\\ctrl2cap.exe" OR process.executable LIKE "%\\Dbgview.exe" OR process.executable LIKE "