// Title: Suspicious Execution Of Renamed Sysinternals Tools - Registry
// ID: f50f3c09-557d-492d-81db-9064a8d4e211
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-24
// Tags: attack.resource-development, attack.t1588.002
// Description: Detects the creation of the "accepteula" key related to the Sysinternals tools being created from executables with the wrong name (e.g. a renamed Sysinternals tool)
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((registry.path LIKE "%\\Active Directory Explorer%" OR registry.path LIKE "%\\Handle%" OR registry.path LIKE "%\\LiveKd%" OR registry.path LIKE "%\\ProcDump%" OR registry.path LIKE "%\\Process Explorer%" OR registry.path LIKE "%\\PsExec%" OR registry.path LIKE "%\\PsLoggedon%" OR registry.path LIKE "%\\PsLoglist%" OR registry.path LIKE "%\\PsPasswd%" OR registry.path LIKE "%\\PsPing%" OR registry.path LIKE "%\\PsService%" OR registry.path LIKE "%\\SDelete%") AND registry.path LIKE "%\\EulaAccepted") AND NOT (((process.executable LIKE "%\\ADExplorer.exe" OR process.executable LIKE "%\\ADExplorer64.exe" OR process.executable LIKE "%\\ADExplorer64a.exe" OR process.executable LIKE "%\\handle.exe" OR process.executable LIKE "%\\handle64.exe" OR process.executable LIKE "%\\handle64a.exe" OR process.executable LIKE "%\\livekd.exe" OR process.executable LIKE "%\\livekd64.exe" OR process.executable LIKE "%\\procdump.exe" OR process.executable LIKE "%\\procdump64.exe" OR process.executable LIKE "%\\procdump64a.exe" OR process.executable LIKE "%\\procexp.exe" OR process.executable LIKE "%\\procexp64.exe" OR process.executable LIKE "%\\procexp64a.exe" OR process.executable LIKE "%\\PsExec.exe" OR process.executable LIKE "%\\PsExec64.exe" OR process.executable LIKE "%\\PsExec64a.exe" OR process.executable LIKE "%\\PsLoggedon.exe" OR process.executable LIKE "%\\PsLoggedon64.exe" OR process.executable LIKE "%\\psloglist.exe" OR process.executable LIKE "%\\psloglist64.exe" OR process.executable LIKE "%\\psloglist64a.exe" OR process.executable LIKE "%\\pspasswd.exe" OR process.executable LIKE "%\\pspasswd64.exe" OR process.executable LIKE "%\\pspasswd64a.exe" OR process.executable LIKE "%\\PsPing.exe" OR process.executable LIKE "%\\PsPing64.exe" OR process.executable LIKE "%\\PsPing64a.exe" OR process.executable LIKE "%\\PsService.exe" OR process.executable LIKE "%\\PsService64.exe" OR process.executable LIKE "%\\PsService64a.exe" OR process.executable LIKE "%\\sdelete.exe"))))
