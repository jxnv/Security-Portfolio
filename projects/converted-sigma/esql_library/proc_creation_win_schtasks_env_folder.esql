// Title: Schedule Task Creation From Env Variable Or Potentially Suspicious Path Via Schtasks.EXE
// ID: 81325ce1-be01-4250-944f-b4789644556f
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-21
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects Schtask creations that point to a suspicious folder or an environment variable often used by malware
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((((process.command_line LIKE "%:\\Perflogs%" OR process.command_line LIKE "%:\\Users\\All Users\\%" OR process.command_line LIKE "%:\\Users\\Default\\%" OR process.command_line LIKE "%:\\Users\\Public%" OR process.command_line LIKE "%:\\Windows\\Temp%" OR process.command_line LIKE "%\\AppData\\Local\\%" OR process.command_line LIKE "%\\AppData\\Roaming\\%" OR process.command_line LIKE "%%AppData%%" OR process.command_line LIKE "%%Public%%")) AND (process.executable LIKE "%\\schtasks.exe" AND process.command_line LIKE "% /create %")) OR ((process.parent.command_line LIKE "%\\svchost.exe -k netsvcs -p -s Schedule") AND ((process.command_line LIKE "%:\\Perflogs%" OR process.command_line LIKE "%:\\Windows\\Temp%" OR process.command_line LIKE "%\\Users\\Public%" OR process.command_line LIKE "%%Public%%")))) AND NOT ((((process.command_line LIKE "%/Create /Xml %" AND process.command_line LIKE "%\\Temp\\.CR.%" AND process.command_line LIKE "%\\Avira_Security_Installation.xml%")) OR ((process.command_line LIKE "%/Create /F /TN%" AND process.command_line LIKE "%/Xml %" AND process.command_line LIKE "%\\Temp\\%" AND process.command_line LIKE "%Avira_%") AND (process.command_line LIKE "%.tmp\\UpdateFallbackTask.xml%" OR process.command_line LIKE "%.tmp\\WatchdogServiceControlManagerTimeout.xml%" OR process.command_line LIKE "%.tmp\\SystrayAutostart.xml%" OR process.command_line LIKE "%.tmp\\MaintenanceTask.xml%")) OR ((process.command_line LIKE "%\\Temp\\%" AND process.command_line LIKE "%/Create /TN \"klcp_update\" /XML %" AND process.command_line LIKE "%\\klcp_update_task.xml%")) OR ((process.parent.command_line LIKE "%unattended.ini%") OR (process.command_line LIKE "%update_task.xml%")) OR (process.command_line LIKE "%/Create /TN TVInstallRestore /TR%"))))
