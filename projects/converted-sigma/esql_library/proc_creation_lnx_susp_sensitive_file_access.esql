// Title: Potential Suspicious Change To Sensitive/Critical Files
// ID: 86157017-c2b1-4d4a-8c33-93b8e67e4af4
// Status: test
// Level: medium
// Author: @d4ns4n_ (Wuerth-Phoenix)
// Date: 2023-05-30
// Tags: attack.impact, attack.t1565.001
// Description: Detects changes of sensitive and critical files. Monitors files that you don't expect to change without planning on Linux system.
// These files include, but are not limited to, system configuration files, authentication files, and critical application files.
// Attackers often target these files to maintain persistence, escalate privileges, or disrupt system operations.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.executable LIKE "%/cat" OR process.executable LIKE "%/echo" OR process.executable LIKE "%/grep" OR process.executable LIKE "%/head" OR process.executable LIKE "%/more" OR process.executable LIKE "%/tail") AND process.command_line LIKE "%>%") OR ((process.executable LIKE "%/emacs" OR process.executable LIKE "%/nano" OR process.executable LIKE "%/sed" OR process.executable LIKE "%/vi" OR process.executable LIKE "%/vim"))) AND ((process.command_line LIKE "%/bin/login%" OR process.command_line LIKE "%/bin/passwd%" OR process.command_line LIKE "%/boot/%" OR process.command_line LIKE "%/etc/*.conf%" OR process.command_line LIKE "%/etc/cron.%" OR process.command_line LIKE "%/etc/crontab%" OR process.command_line LIKE "%/etc/hosts%" OR process.command_line LIKE "%/etc/init.d%" OR process.command_line LIKE "%/etc/sudoers%" OR process.command_line LIKE "%/opt/bin/%" OR process.command_line LIKE "%/sbin%" OR process.command_line LIKE "%/usr/bin/%" OR process.command_line LIKE "%/usr/local/bin/%")) AND NOT (1=1))
