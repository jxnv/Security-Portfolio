)) AND NOT ((((process.executable LIKE "C:\\Program Files (x86)\\Avant Browser\\%" OR process.executable LIKE "C:\\Program Files\\Avant Browser\\%") AND process.executable LIKE "%\\avant.exe") OR (process.executable LIKE "%\\brave.exe" AND process.executable LIKE "C:\\Program Files\\BraveSoftware\\%") OR ((process.executable == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR process.executable == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((process.executable LIKE "%\\MsMpEng.exe" OR process.executable LIKE "%\\MsSense.exe")) OR ((process.executable LIKE "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\%") OR (process.executable LIKE "%\\WindowsApps\\MicrosoftEdge.exe") OR ((process.executable == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR process.executable == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process.executable LIKE "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\%" OR process.executable LIKE "C:\\Program Files\\Microsoft\\EdgeCore\\%") AND (process.executable LIKE "%\\msedge.exe" OR process.executable LIKE "%\\msedgewebview2.exe")) OR ((process.executable LIKE "C:\\Program Files\\Falkon\\%" OR process.executable LIKE "C:\\Program Files (x86)\\Falkon\\%") AND process.executable LIKE "%\\falkon.exe") OR ((process.executable == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR process.executable == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR (process.executable LIKE "%\\AppData\\Local\\Flock\\%" AND process.executable LIKE "%\\Flock.exe") OR ((process.executable == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR process.executable == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process.executable LIKE "%\\AppData\\Local\\Maxthon\\%" AND process.executable LIKE "%\\maxthon.exe") OR (process.executable LIKE "%\\AppData\\Local\\Programs\\midori-ng\\%" AND process.executable LIKE "%\\Midori Next Generati