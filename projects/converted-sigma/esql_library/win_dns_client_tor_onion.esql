// Title: Query Tor Onion Address - DNS Client
// ID: 8384bd26-bde6-4da9-8e5d-4174a7a47ca2
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-02-20
// Tags: attack.command-and-control, attack.t1090.003
// Description: Detects DNS resolution of an .onion address related to Tor routing networks
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (winlog.event_id == 3008 AND (QueryName LIKE "%.hiddenservice.net" OR QueryName LIKE "%.onion.ca" OR QueryName LIKE "%.onion.cab" OR QueryName LIKE "%.onion.casa" OR QueryName LIKE "%.onion.city" OR QueryName LIKE "%.onion.direct" OR QueryName LIKE "%.onion.dog" OR QueryName LIKE "%.onion.glass" OR QueryName LIKE "%.onion.gq" OR QueryName LIKE "%.onion.guide" OR QueryName LIKE "%.onion.in.net" OR QueryName LIKE "%.onion.ink" OR QueryName LIKE "%.onion.it" OR QueryName LIKE "%.onion.link" OR QueryName LIKE "%.onion.lt" OR QueryName LIKE "%.onion.lu" OR QueryName LIKE "%.onion.ly" OR QueryName LIKE "%.onion.mn" OR QueryName LIKE "%.onion.network" OR QueryName LIKE "%.onion.nu" OR QueryName LIKE "%.onion.pet" OR QueryName LIKE "%.onion.plus" OR QueryName LIKE "%.onion.pt" OR QueryName LIKE "%.onion.pw" OR QueryName LIKE "%.onion.rip" OR QueryName LIKE "%.onion.sh" OR QueryName LIKE "%.onion.si" OR QueryName LIKE "%.onion.to" OR QueryName LIKE "%.onion.top" OR QueryName LIKE "%.onion.ws" OR QueryName LIKE "%.onion" OR QueryName LIKE "%.s1.tor-gateways.de" OR QueryName LIKE "%.s2.tor-gateways.de" OR QueryName LIKE "%.s3.tor-gateways.de" OR QueryName LIKE "%.s4.tor-gateways.de" OR QueryName LIKE "%.s5.tor-gateways.de" OR QueryName LIKE "%.t2w.pw" OR QueryName LIKE "%.tor2web.ae.org" OR QueryName LIKE "%.tor2web.blutmagie.de" OR QueryName LIKE "%.tor2web.com" OR QueryName LIKE "%.tor2web.fi" OR QueryName LIKE "%.tor2web.io" OR QueryName LIKE "%.tor2web.org" OR QueryName LIKE "%.tor2web.xyz" OR QueryName LIKE "%.torlink.co"))
