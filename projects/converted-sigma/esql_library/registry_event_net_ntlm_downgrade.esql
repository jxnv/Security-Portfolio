// Title: NetNTLM Downgrade Attack - Registry
// ID: d67572a0-e2ec-45d6-b8db-c100d14b8ef2
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), wagga, Nasreddine Bencherchali (Splunk STRT)
// Date: 2018-03-20
// Tags: attack.persistence, attack.defense-impairment, attack.t1685, attack.t1112
// Description: Detects NetNTLM downgrade attack
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((registry.path LIKE "%SYSTEM\\%" AND registry.path LIKE "%ControlSet%" AND registry.path LIKE "%\\Control\\Lsa%")) AND ((registry.path LIKE "%\\lmcompatibilitylevel" AND (registry.data.strings == "DWORD (0x00000000)" OR registry.data.strings == "DWORD (0x00000001)" OR registry.data.strings == "DWORD (0x00000002)")) OR (registry.path LIKE "%\\NtlmMinClientSec" AND (registry.data.strings == "DWORD (0x00000000)" OR registry.data.strings == "DWORD (0x00000010)" OR registry.data.strings == "DWORD (0x00000020)" OR registry.data.strings == "DWORD (0x00000030)")) OR (registry.path LIKE "%\\RestrictSendingNTLMTraffic")))
