// Title: Suspicious ZipExec Execution
// ID: 90dcf730-1b71-4ae7-9ffc-6fcf62bd0132
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-11-07
// Tags: attack.execution, attack.stealth, attack.t1218, attack.t1202
// Description: ZipExec is a Proof-of-Concept (POC) tool to wrap binary-based tools into a password-protected zip file.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%/generic:Microsoft_Windows_Shell_ZipFolder:filename=%" AND process.command_line LIKE "%.zip%" AND process.command_line LIKE "%/pass:%" AND process.command_line LIKE "%/user:%")) OR ((process.command_line LIKE "%/delete%" AND process.command_line LIKE "%Microsoft_Windows_Shell_ZipFolder:filename=%" AND process.command_line LIKE "%.zip%")))
