// Title: Potential Base64 Decoded From Images
// ID: 09a910bf-f71f-4737-9c40-88880ba5913d
// Status: test
// Level: high
// Author: Joseliyo Sanchez, @Joseliyo_Jstnk
// Date: 2023-12-20
// Tags: attack.stealth, attack.t1140
// Description: Detects the use of tail to extract bytes at an offset from an image and then decode the base64 value to create a new file with the decoded content. The detected execution is a bash one-liner.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%base64%" AND process.command_line LIKE "%-d%" AND process.command_line LIKE "%>%")) AND ((process.command_line LIKE "%.avif%" OR process.command_line LIKE "%.gif%" OR process.command_line LIKE "%.jfif%" OR process.command_line LIKE "%.jpeg%" OR process.command_line LIKE "%.jpg%" OR process.command_line LIKE "%.pjp%" OR process.command_line LIKE "%.pjpeg%" OR process.command_line LIKE "%.png%" OR process.command_line LIKE "%.svg%" OR process.command_line LIKE "%.webp%")) AND (process.executable LIKE "%/bash") AND ((process.command_line LIKE "%tail%" AND process.command_line LIKE "%-c%")))
