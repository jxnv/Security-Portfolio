// Title: Uncommon Userinit Child Process
// ID: 0a98a10c-685d-4ab0-bddc-b6bdd1d48458
// Status: test
// Level: high
// Author: Tom Ueltschi (@c_APT_ure), Tim Shelton
// Date: 2019-01-12
// Tags: attack.privilege-escalation, attack.t1037.001, attack.persistence
// Description: Detects uncommon "userinit.exe" child processes, which could be a sign of uncommon shells or login scripts used for persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.parent.executable LIKE "%\\userinit.exe") AND NOT ((process.executable LIKE "%:\\WINDOWS\\explorer.exe")) AND NOT ((((process.executable LIKE "%:\\Program Files (x86)\\Citrix\\HDX\\bin\\cmstart.exe" OR process.executable LIKE "%:\\Program Files (x86)\\Citrix\\HDX\\bin\\icast.exe" OR process.executable LIKE "%:\\Program Files (x86)\\Citrix\\System32\\icast.exe" OR process.executable LIKE "%:\\Program Files\\Citrix\\HDX\\bin\\cmstart.exe" OR process.executable LIKE "%:\\Program Files\\Citrix\\HDX\\bin\\icast.exe" OR process.executable LIKE "%:\\Program Files\\Citrix\\System32\\icast.exe")) OR (process.executable IS NULL) OR ((process.command_line LIKE "%netlogon.bat%" OR process.command_line LIKE "%UsrLogon.cmd%")) OR ((process.executable LIKE "%:\\Windows\\System32\\proquota.exe" OR process.executable LIKE "%:\\Windows\\SysWOW64\\proquota.exe")) OR (process.command_line == "PowerShell.exe"))))
