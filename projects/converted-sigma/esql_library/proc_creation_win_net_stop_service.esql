// Title: Stop Windows Service Via Net.EXE
// ID: 88872991-7445-4a22-90b2-a3adadb0e827
// Status: test
// Level: low
// Author: Jakob Weinzettl, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-03-05
// Tags: attack.impact, attack.t1489
// Description: Detects the stopping of a Windows service via the "net" utility.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.command_line LIKE "% stop %") AND (((process.pe.original_file_name == "net.exe" OR process.pe.original_file_name == "net1.exe")) OR ((process.executable LIKE "%\\net.exe" OR process.executable LIKE "%\\net1.exe"))))
