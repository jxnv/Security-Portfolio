// Title: Operator Bloopers Cobalt Strike Commands
// ID: 647c7b9e-d784-4fda-b9a0-45c565a7b729
// Status: test
// Level: high
// Author: _pete_0, TheDFIRReport
// Date: 2022-05-06
// Tags: attack.execution, attack.t1059.003, stp.1u
// Description: Detects use of Cobalt Strike commands accidentally entered in the CMD shell
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "cmd %" OR process.command_line LIKE "cmd.exe%" OR process.command_line LIKE "c:\\windows\\system32\\cmd.exe%") AND (process.command_line LIKE "%psinject%" OR process.command_line LIKE "%spawnas%" OR process.command_line LIKE "%make_token%" OR process.command_line LIKE "%remote-exec%" OR process.command_line LIKE "%rev2self%" OR process.command_line LIKE "%dcsync%" OR process.command_line LIKE "%logonpasswords%" OR process.command_line LIKE "%execute-assembly%" OR process.command_line LIKE "%getsystem%")) AND ((process.pe.original_file_name == "Cmd.Exe") OR (process.executable LIKE "%\\cmd.exe")))
