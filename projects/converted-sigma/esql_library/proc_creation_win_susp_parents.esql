// Title: Suspicious Process Parents
// ID: cbec226f-63d9-4eca-9f52-dfb6652f24df
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-21
// Tags: attack.stealth, attack.t1036
// Description: Detects suspicious parent processes that should not have any children or should only have a single possible child program
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.parent.executable LIKE "%\\minesweeper.exe" OR process.parent.executable LIKE "%\\winver.exe" OR process.parent.executable LIKE "%\\bitsadmin.exe")) OR (((process.parent.executable LIKE "%\\csrss.exe" OR process.parent.executable LIKE "%\\certutil.exe" OR process.parent.executable LIKE "%\\eventvwr.exe" OR process.parent.executable LIKE "%\\calc.exe" OR process.parent.executable LIKE "%\\notepad.exe")) AND NOT (((process.executable IS NULL) OR ((process.executable LIKE "%\\WerFault.exe" OR process.executable LIKE "%\\wermgr.exe" OR process.executable LIKE "%\\conhost.exe" OR process.executable LIKE "%\\mmc.exe" OR process.executable LIKE "%\\win32calc.exe" OR process.executable LIKE "%\\notepad.exe"))))))
