// Title: File Download From IP URL Via Curl.EXE
// ID: 9cc85849-3b02-4cb5-b371-3a1ff54f2218
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-10-18
// Tags: attack.execution
// Description: Detects file downloads directly from IP address URL using curl.exe
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.command_line LIKE "% -O%" OR process.command_line LIKE "%--remote-name%" OR process.command_line LIKE "%--output%")) AND (process.command_line LIKE "%http%") AND ((process.executable LIKE "%\\curl.exe") OR (process.pe.original_file_name == "curl.exe")) AND (process.command_line RLIKE "://[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}")) AND NOT (((process.command_line LIKE "%.bat" OR process.command_line LIKE "%.bat\"" OR process.command_line LIKE "%.dat" OR process.command_line LIKE "%.dat\"" OR process.command_line LIKE "%.dll" OR process.command_line LIKE "%.dll\"" OR process.command_line LIKE "%.exe" OR process.command_line LIKE "%.exe\"" OR process.command_line LIKE "%.gif" OR process.command_line LIKE "%.gif\"" OR process.command_line LIKE "%.hta" OR process.command_line LIKE "%.hta\"" OR process.command_line LIKE "%.jpeg" OR process.command_line LIKE "%.jpeg\"" OR process.command_line LIKE "%.log" OR process.command_line LIKE "%.log\"" OR process.command_line LIKE "%.msi" OR process.command_line LIKE "%.msi\"" OR process.command_line LIKE "%.png" OR process.command_line LIKE "%.png\"" OR process.command_line LIKE "%.ps1" OR process.command_line LIKE "%.ps1\"" OR process.command_line LIKE "%.psm1" OR process.command_line LIKE "%.psm1\"" OR process.command_line LIKE "%.vbe" OR process.command_line LIKE "%.vbe\"" OR process.command_line LIKE "%.vbs" OR process.command_line LIKE "%.vbs\"" OR process.command_line LIKE "%.bat'" OR process.command_line LIKE "%.dat'" OR process.command_line LIKE "%.dll'" OR process.command_line LIKE "%.exe'" OR process.command_line LIKE "%.gif'" OR process.command_line LIKE "%.hta'" OR process.command_line LIKE "%.jpeg'" OR process.command_line LIKE "%.log'" OR process.command_line LIKE "%.msi'" OR process.command_line LIKE "%.png'" OR process.command_line LIKE "%.ps1'" OR process.command_line LIKE "%.psm1'" OR process.command_line LIKE "%.vbe'" OR process.command_line LIKE "%.vbs'"))))
