// Title: Regsvr32 DLL Execution With Uncommon Extension
// ID: 50919691-7302-437f-8e10-1fe088afa145
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2019-07-17
// Tags: attack.privilege-escalation, attack.persistence, attack.stealth, attack.t1574, attack.execution
// Description: Detects a "regsvr32" execution where the DLL doesn't contain a common file extension.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%\\regsvr32.exe") OR (process.pe.original_file_name == "REGSVR32.EXE")) AND NOT (((process.command_line == "") OR ((process.command_line LIKE "%.ax%" OR process.command_line LIKE "%.cpl%" OR process.command_line LIKE "%.dll%" OR process.command_line LIKE "%.ocx%")) OR (process.command_line IS NULL))) AND NOT (((process.command_line LIKE "%.bav%") OR (process.command_line LIKE "%.ppl%"))))
