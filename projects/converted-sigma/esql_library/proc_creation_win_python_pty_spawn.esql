// Title: Python Spawning Pretty TTY on Windows
// ID: 480e7e51-e797-47e3-8d72-ebfce65b6d8d
// Status: test
// Level: high
// Author: Nextron Systems
// Date: 2022-06-03
// Tags: attack.execution, attack.t1059
// Description: Detects python spawning a pretty tty
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%python.exe" OR process.executable LIKE "%python3.exe" OR process.executable LIKE "%python2.exe")) AND (((process.command_line LIKE "%import pty%" AND process.command_line LIKE "%.spawn(%")) OR (process.command_line LIKE "%from pty import spawn%")))
