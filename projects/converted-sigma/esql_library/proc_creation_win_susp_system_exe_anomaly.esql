// Title: System File Execution Location Anomaly
// ID: e4a6b256-3e47-40fc-89d2-7a477edd6915
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Patrick Bareiss, Anton Kutepov, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2017-11-27
// Tags: attack.stealth, attack.t1036
// Description: Detects the execution of a Windows system binary that is usually located in the system folder from an uncommon location.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%\\atbroker.exe" OR process.executable LIKE "%\\audiodg.exe" OR process.executable LIKE "%\\bcdedit.exe" OR process.executable LIKE "%\\bitsadmin.exe" OR process.executable LIKE "%\\certreq.exe" OR process.executable LIKE "%\\certutil.exe" OR process.executable LIKE "%\\cmstp.exe" OR process.executable LIKE "%\\conhost.exe" OR process.executable LIKE "%\\consent.exe" OR process.executable LIKE "%\\cscript.exe" OR process.executable LIKE "%\\csrss.exe" OR process.executable LIKE "%\\dashost.exe" OR process.executable LIKE "%\\defrag.exe" OR process.executable LIKE "%\\dfrgui.exe" OR process.executable LIKE "%\\dism.exe" OR process.executable LIKE "%\\dllhost.exe" OR process.executable LIKE "%\\dllhst3g.exe" OR process.executable LIKE "%\\dwm.exe" OR process.executable LIKE "%\\eventvwr.exe" OR process.executable LIKE "%\\fsquirt.exe" OR process.executable LIKE "%\\finger.exe" OR process.executable LIKE "%\\logonui.exe" OR process.executable LIKE "%\\LsaIso.exe" OR process.executable LIKE "%\\lsass.exe" OR process.executable LIKE "%\\lsm.exe" OR process.executable LIKE "%\\msiexec.exe" OR process.executable LIKE "%\\ntoskrnl.exe" OR process.executable LIKE "%\\powershell_ise.exe" OR process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe" OR process.executable LIKE "%\\regsvr32.exe" OR process.executable LIKE "%\\rundll32.exe" OR process.executable LIKE "%\\runonce.exe" OR process.executable LIKE "%\\RuntimeBroker.exe" OR process.executable LIKE "%\\schtasks.exe" OR process.executable LIKE "%\\services.exe" OR process.executable LIKE "%\\sihost.exe" OR process.executable LIKE "%\\smartscreen.exe" OR process.executable LIKE "%\\smss.exe" OR process.executable LIKE "%\\spoolsv.exe" OR process.executable LIKE "%\\svchost.exe" OR process.executable LIKE "%\\taskhost.exe" OR process.executable LIKE "%\\taskhostw.exe" OR process.executable LIKE "%\\Taskmgr.exe" OR process.executable LIKE "%\\userinit.exe" OR process.executable LIKE "%\\werfault.exe" OR process.executable LIKE "%\\werfaultsecure.exe" OR process.executable LIKE "%\\wininit.exe" OR process.executable LIKE "%\\winlogon.exe" OR process.executable LIKE "%\\winver.exe" OR process.executable LIKE "%\\wlanext.exe" OR process.executable LIKE "%\\wmic.exe" OR process.executable LIKE "%\\wscript.exe" OR process.executable LIKE "%\\wsl.exe" OR process.executable LIKE "%\\wsmprovhost.exe")) AND NOT ((((process.executable LIKE "C:\\$WINDOWS.~BT\\%" OR process.executable LIKE "C:\\$WinREAgent\\%" OR process.executable LIKE "C:\\Windows\\SoftwareDistribution\\%" OR process.executable LIKE "C:\\Windows\\System32\\%" OR process.executable LIKE "C:\\Windows\\SystemTemp\\%" OR process.executable LIKE "C:\\Windows\\SysWOW64\\%" OR process.executable LIKE "C:\\Windows\\uus\\%" OR process.executable LIKE "C:\\Windows\\WinSxS\\%")) OR ((process.executable LIKE "%C:\\Program Files\\PowerShell\\7\\%" OR process.executable LIKE "%C:\\Program Files\\PowerShell\\7-preview\\%" OR process.executable LIKE "%C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview%" OR process.executable LIKE "%\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview%") AND process.executable LIKE "%\\pwsh.exe") OR (process.executable LIKE "C:\\Users\\%" AND process.executable LIKE "%\\AppData\\Local\\Microsoft\\WindowsApps\\%" AND process.executable LIKE "%\\wsl.exe") OR ((process.executable LIKE "C:\\Program Files\\WindowsApps\\MicrosoftCorporationII.WindowsSubsystemForLinux%" OR process.executable LIKE "C:\\Program Files\\WSL\\%") AND process.executable LIKE "%\\wsl.exe"))) AND NOT ((process.executable LIKE "%\\SystemRoot\\System32\\%")))
