// Title: HackTool - Impacket Tools Execution
// ID: 4627c6ae-6899-46e2-aa0c-6ebcb1becd19
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-07-24
// Tags: attack.collection, attack.execution, attack.credential-access, attack.t1557.001
// Description: Detects the execution of different compiled Windows binaries of the impacket toolset (based on names or part of their names - could lead to false positives)
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%\\goldenPac%" OR process.executable LIKE "%\\karmaSMB%" OR process.executable LIKE "%\\kintercept%" OR process.executable LIKE "%\\ntlmrelayx%" OR process.executable LIKE "%\\rpcdump%" OR process.executable LIKE "%\\samrdump%" OR process.executable LIKE "%\\secretsdump%" OR process.executable LIKE "%\\smbexec%" OR process.executable LIKE "%\\smbrelayx%" OR process.executable LIKE "%\\wmiexec%" OR process.executable LIKE "%\\wmipersist%")) OR ((process.executable LIKE "%\\atexec_windows.exe" OR process.executable LIKE "%\\dcomexec_windows.exe" OR process.executable LIKE "%\\dpapi_windows.exe" OR process.executable LIKE "%\\findDelegation_windows.exe" OR process.executable LIKE "%\\GetADUsers_windows.exe" OR process.executable LIKE "%\\GetNPUsers_windows.exe" OR process.executable LIKE "%\\getPac_windows.exe" OR process.executable LIKE "%\\getST_windows.exe" OR process.executable LIKE "%\\getTGT_windows.exe" OR process.executable LIKE "%\\GetUserSPNs_windows.exe" OR process.executable LIKE "%\\ifmap_windows.exe" OR process.executable LIKE "%\\mimikatz_windows.exe" OR process.executable LIKE "%\\netview_windows.exe" OR process.executable LIKE "%\\nmapAnswerMachine_windows.exe" OR process.executable LIKE "%\\opdump_windows.exe" OR process.executable LIKE "%\\psexec_windows.exe" OR process.executable LIKE "%\\rdp_check_windows.exe" OR process.executable LIKE "%\\sambaPipe_windows.exe" OR process.executable LIKE "%\\smbclient_windows.exe" OR process.executable LIKE "%\\smbserver_windows.exe" OR process.executable LIKE "%\\sniff_windows.exe" OR process.executable LIKE "%\\sniffer_windows.exe" OR process.executable LIKE "%\\split_windows.exe" OR process.executable LIKE "%\\ticketer_windows.exe")))
