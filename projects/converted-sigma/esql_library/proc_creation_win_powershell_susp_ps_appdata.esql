// Title: PowerShell Script Run in AppData
// ID: ac175779-025a-4f12-98b0-acdaeb77ea85
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), Jonhnathan Ribeiro, oscd.community
// Date: 2019-01-09
// Tags: attack.execution, attack.t1059.001
// Description: Detects a suspicious command line execution that invokes PowerShell with reference to an AppData folder
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%powershell.exe%" OR process.command_line LIKE "%\\powershell%" OR process.command_line LIKE "%\\pwsh%" OR process.command_line LIKE "%pwsh.exe%")) AND ((process.command_line LIKE "%/c %" AND process.command_line LIKE "%\\AppData\\%") AND (process.command_line LIKE "%Local\\%" OR process.command_line LIKE "%Roaming\\%")))
