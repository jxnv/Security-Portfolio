// Title: Disable Or Stop Services
// ID: de25eeb8-3655-4643-ac3a-b662d3f26b6b
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-15
// Tags: attack.defense-impairment, attack.t1685, attack.impact, attack.t1489
// Description: Detects the usage of utilities such as 'systemctl', 'service'...etc to stop or disable tools and services on Linux systems.
// Attackers may stop or disable security tools and services to evade detection, maintain persistence, or disrupt system operations.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%/service" OR process.executable LIKE "%/systemctl" OR process.executable LIKE "%/chkconfig") AND (process.command_line LIKE "% stop %" OR process.command_line LIKE "% disable %")) AND NOT (((process.executable LIKE "%/systemctl" AND (process.command_line LIKE "%--no-reload disable snap-snapd-%" OR process.command_line LIKE "% stop snap-snapd-%")) OR (process.executable LIKE "%/systemctl" AND process.parent.command_line LIKE "%tmp.ci/preinst upgrade%" AND (process.command_line LIKE "% stop %" AND process.command_line LIKE "%ssh.%")) OR (process.parent.command_line LIKE "%/dpkg/info/ubuntu-pro-client.prerm upgrade%" AND process.executable LIKE "%/systemctl"))) AND NOT ((process.executable LIKE "%/systemctl" AND process.command_line LIKE "%snap.amazon-ssm-agent.amazon-ssm-agent.service")))
