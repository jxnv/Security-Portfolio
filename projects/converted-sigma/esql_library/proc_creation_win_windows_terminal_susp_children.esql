// Title: Suspicious WindowsTerminal Child Processes
// ID: 8de89e52-f6e1-4b5b-afd1-41ecfa300d48
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-25
// Tags: attack.execution, attack.persistence
// Description: Detects suspicious children spawned via the Windows Terminal application which could be a sign of persistence via WindowsTerminal (see references section)
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.parent.executable LIKE "%\\WindowsTerminal.exe" OR process.parent.executable LIKE "%\\wt.exe")) AND (((process.executable LIKE "%\\rundll32.exe" OR process.executable LIKE "%\\regsvr32.exe" OR process.executable LIKE "%\\certutil.exe" OR process.executable LIKE "%\\cscript.exe" OR process.executable LIKE "%\\wscript.exe" OR process.executable LIKE "%\\csc.exe")) OR ((process.executable LIKE "%C:\\Users\\Public\\%" OR process.executable LIKE "%\\Downloads\\%" OR process.executable LIKE "%\\Desktop\\%" OR process.executable LIKE "%\\AppData\\Local\\Temp\\%" OR process.executable LIKE "%\\Windows\\TEMP\\%")) OR ((process.command_line LIKE "% iex %" OR process.command_line LIKE "% icm%" OR process.command_line LIKE "%Invoke-%" OR process.command_line LIKE "%Import-Module %" OR process.command_line LIKE "%ipmo %" OR process.command_line LIKE "%DownloadString(%" OR process.command_line LIKE "% /c %" OR process.command_line LIKE "% /k %" OR process.command_line LIKE "% /r %")))) AND NOT ((((process.command_line LIKE "%Import-Module%" AND process.command_line LIKE "%Microsoft.VisualStudio.DevShell.dll%" AND process.command_line LIKE "%Enter-VsDevShell%")) OR ((process.command_line LIKE "%\\AppData\\Local\\Packages\\Microsoft.WindowsTerminal_%" AND process.command_line LIKE "%\\LocalState\\settings.json%")) OR ((process.command_line LIKE "%C:\\Program Files\\Microsoft Visual Studio\\%" AND process.command_line LIKE "%\\Common7\\Tools\\VsDevCmd.bat%")))))
