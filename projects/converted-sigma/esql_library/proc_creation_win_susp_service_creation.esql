// Title: Suspicious New Service Creation
// ID: 17a1be64-8d88-40bf-b5ff-a4f7a50ebcc8
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-14
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects creation of a new service via "sc" command or the powershell "new-service" cmdlet with suspicious binary paths
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.command_line LIKE "%New-Service%" AND process.command_line LIKE "%-BinaryPathName%")) OR (process.executable LIKE "%\\sc.exe" AND (process.command_line LIKE "%create%" AND process.command_line LIKE "%binPath=%"))) AND ((process.command_line LIKE "%powershell%" OR process.command_line LIKE "%mshta%" OR process.command_line LIKE "%wscript%" OR process.command_line LIKE "%cscript%" OR process.command_line LIKE "%svchost%" OR process.command_line LIKE "%dllhost%" OR process.command_line LIKE "%cmd %" OR process.command_line LIKE "%cmd.exe /c%" OR process.command_line LIKE "%cmd.exe /k%" OR process.command_line LIKE "%cmd.exe /r%" OR process.command_line LIKE "%rundll32%" OR process.command_line LIKE "%C:\\Users\\Public%" OR process.command_line LIKE "%\\Downloads\\%" OR process.command_line LIKE "%\\Desktop\\%" OR process.command_line LIKE "%\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\%" OR process.command_line LIKE "%C:\\Windows\\TEMP\\%" OR process.command_line LIKE "%\\AppData\\Local\\Temp%")))
