// Title: New Connection Initiated To Potential Dead Drop Resolver Domain
// ID: 297ae038-edc2-4b2e-bb3e-7c5fc94dd5c7
// Status: test
// Level: high
// Author: Sorina Ionescu, X__Junior (Nextron Systems)
// Date: 2022-08-17
// Tags: attack.command-and-control, attack.t1102, attack.t1102.001
// Description: Detects an executable, which is not an internet browser or known application, initiating network connections to legit popular websites, which were seen to be used as dead drop resolvers in previous attacks.
// In this context attackers leverage known websites such as "facebook", "youtube", etc. In order to pass through undetected.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((Initiated == "true" AND (DestinationHostname LIKE "%.t.me" OR DestinationHostname LIKE "%0x0.st" OR DestinationHostname LIKE "%4shared.com" OR DestinationHostname LIKE "%abuse.ch" OR DestinationHostname LIKE "%anonfiles.com" OR DestinationHostname LIKE "%bashupload.com" OR DestinationHostname LIKE "%cdn.discordapp.com" OR DestinationHostname LIKE "%chunk.io" OR DestinationHostname LIKE "%cloudflare.com" OR DestinationHostname LIKE "%ddns.net" OR DestinationHostname LIKE "%discord.com" OR DestinationHostname LIKE "%docs.google.com" OR DestinationHostname LIKE "%drive.google.com" OR DestinationHostname LIKE "%dropbox.com" OR DestinationHostname LIKE "%dropmefiles.com" OR DestinationHostname LIKE "%facebook.com" OR DestinationHostname LIKE "%feeds.rapidfeeds.com" OR DestinationHostname LIKE "%fotolog.com" OR DestinationHostname LIKE "%ghostbin.co/" OR DestinationHostname LIKE "%githubusercontent.com" OR DestinationHostname LIKE "%gofile.io" OR DestinationHostname LIKE "%hastebin.com" OR DestinationHostname LIKE "%imgur.com" OR DestinationHostname LIKE "%livejournal.com" OR DestinationHostname LIKE "%mediafire.com" OR DestinationHostname LIKE "%mega.co.nz" OR DestinationHostname LIKE "%mega.nz" OR DestinationHostname LIKE "%onedrive.com" OR DestinationHostname LIKE "%pages.dev" OR DestinationHostname LIKE "%paste.ee" OR DestinationHostname LIKE "%pastebin.com" OR DestinationHostname LIKE "%pastebin.pl" OR DestinationHostname LIKE "%pastetext.net" OR DestinationHostname LIKE "%pixeldrain.com" OR DestinationHostname LIKE "%privatlab.com" OR DestinationHostname LIKE "%privatlab.net" OR DestinationHostname LIKE "%reddit.com" OR DestinationHostname LIKE "%send.exploit.in" OR DestinationHostname LIKE "%sendspace.com" OR DestinationHostname LIKE "%steamcommunity.com" OR DestinationHostname LIKE "%storage.googleapis.com" OR DestinationHostname LIKE "%technet.microsoft.com" OR DestinationHostname LIKE "%temp.sh" OR DestinationHostname LIKE "%transfer.sh" OR DestinationHostname LIKE "%trycloudflare.com" OR DestinationHostname LIKE "%twitter.com" OR DestinationHostname LIKE "%ufile.io" OR DestinationHostname LIKE "%vimeo.com" OR DestinationHostname LIKE "%w3spaces.com" OR DestinationHostname LIKE "%wetransfer.com" OR DestinationHostname LIKE "%workers.dev" OR DestinationHostname LIKE "%x0.at" OR DestinationHostname LIKE "%youtube.com")) AND NOT ((((process.executable LIKE "C:\\Program Files (x86)\\Avant Browser\\%" OR process.executable LIKE "C:\\Program Files\\Avant Browser\\%") AND process.executable LIKE "%\\avant.exe") OR (process.executable LIKE "C:\\Program Files\\BraveSoftware\\%" AND process.executable LIKE "%\\brave.exe") OR ((process.executable == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR process.executable == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR (process.executable LIKE "C:\\Users\\%" AND process.executable LIKE "%\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe") OR ((process.executable LIKE "%C:\\Program Files\\Windows Defender Advanced Threat Protection\\%" OR process.executable LIKE "%C:\\Program Files\\Windows Defender\\%" OR process.executable LIKE "%C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\%") AND (process.executable LIKE "%\\MsMpEng.exe" OR process.executable LIKE "%\\MsSense.exe")) OR (process.executable LIKE "%\\AppData\\Local\\Discord\\%" AND process.executable LIKE "%\\Discord.exe" AND (DestinationHostname LIKE "%discord.com" OR DestinationHostname LIKE "%cdn.discordapp.com")) OR ((process.executable LIKE "C:\\Program Files (x86)\\Dropbox\\Client\\%" OR process.executable LIKE "C:\\Program Files\\Dropbox\\Client\\%") AND (process.executable LIKE "%\\Dropbox.exe" OR process.executable LIKE "%\\DropboxInstaller.exe") AND DestinationHostname LIKE "%dropbox.com") OR ((process.executable LIKE "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\%") OR (process.executable LIKE "%\\WindowsApps\\MicrosoftEdge.exe") OR ((process.executable == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR process.executable == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process.executable LIKE "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\%" OR process.executable LIKE "C:\\Program Files\\Microsoft\\EdgeCore\\%") AND (process.executable LIKE "%\\msedge.exe" OR process.executable LIKE "%\\msedgewebview2.exe")) OR (process.executable == "") OR ((process.executable LIKE "C:\\Program Files\\Falkon\\%" OR process.executable LIKE "C:\\Program Files (x86)\\Falkon\\%") AND process.executable LIKE "%\\falkon.exe") OR ((process.executable == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR process.executable == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR (process.executable LIKE "C:\\Users\\%" AND process.executable LIKE "%\\AppData\\Local\\Mozilla Firefox\\firefox.exe") OR (process.executable LIKE "%\\AppData\\Local\\Flock\\%" AND process.executable LIKE "%\\Flock.exe") OR ((process.executable LIKE "%C:\\Program Files\\Google\\Drive File Stream\\%" OR process.executable LIKE "%C:\\Program Files (x86)\\Google\\Drive File Stream\\%") AND process.executable LIKE "%GoogleDriveFS.exe" AND DestinationHostname LIKE "%drive.google.com") OR ((process.executable == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR process.executable == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process.executable LIKE "%\\AppData\\Local\\Maxthon\\%" AND process.executable LIKE "%\\maxthon.exe") OR ((process.executable LIKE "%\\MEGAsync.exe" OR process.executable LIKE "%\\MEGAsyncSetup32_*RC.exe" OR process.executable LIKE "%\\MEGAsyncSetup32.exe" OR process.executable LIKE "%\\MEGAsyncSetup64.exe" OR process.executable LIKE "%\\MEGAupdater.exe") AND (DestinationHostname LIKE "%mega.co.nz" OR DestinationHostname LIKE "%mega.nz")) OR (process.executable LIKE "%\\AppData\\Local\\Programs\\midori-ng\\%" AND process.executable LIKE "%\\Midori Next Generation.exe") OR (process.executable IS NULL) OR (process.executable LIKE "%\\AppData\\Local\\Microsoft\\OneDrive\\%" AND process.executable LIKE "%\\OneDrive.exe" AND DestinationHostname LIKE "%onedrive.com") OR (process.executable LIKE "%\\AppData\\Local\\Programs\\Opera\\%" AND process.executable LIKE "%\\opera.exe") OR (process.executable LIKE "%\\AppData\\Local\\Phoebe\\%" AND process.executable LIKE "%\\Phoebe.exe") OR ((process.executable LIKE "%C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe" OR process.executable LIKE "%C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe")) OR ((process.executable LIKE "C:\\Program Files (x86)\\QtWeb\\%" OR process.executable LIKE "C:\\Program Files\\QtWeb\\%") AND process.executable LIKE "%\\QtWeb.exe") OR ((process.executable LIKE "%C:\\Program Files (x86)\\Safari\\%" OR process.executable LIKE "%C:\\Program Files\\Safari\\%") AND process.executable LIKE "%\\safari.exe") OR ((process.executable LIKE "C:\\Program Files\\SeaMonkey\\%" OR process.executable LIKE "C:\\Program Files (x86)\\SeaMonkey\\%") AND process.executable LIKE "%\\seamonkey.exe") OR ((process.executable LIKE "C:\\Program Files\\SlimBrowser\\%" OR process.executable LIKE "C:\\Program Files (x86)\\SlimBrowser\\%") AND process.executable LIKE "%\\slimbrowser.exe") OR (process.executable LIKE "%\\AppData\\Roaming\\Telegram Desktop\\%" AND process.executable LIKE "%\\Telegram.exe" AND DestinationHostname LIKE "%.t.me") OR (process.executable LIKE "%\\AppData\\Local\\Vivaldi\\%" AND process.executable LIKE "%\\vivaldi.exe") OR ((process.executable LIKE "C:\\Program Files\\Naver\\Naver Whale\\%" OR process.executable LIKE "C:\\Program Files (x86)\\Naver\\Naver Whale\\%") AND process.executable LIKE "%\\whale.exe") OR ((process.executable LIKE "C:\\Program Files\\Waterfox\\%" OR process.executable LIKE "C:\\Program Files (x86)\\Waterfox\\%") AND process.executable LIKE "%\\Waterfox.exe") OR ((process.executable LIKE "C:\\Program Files (x86)\\WindowsApps\\%" OR process.executable LIKE "C:\\Program Files\\WindowsApps\\%") AND process.executable LIKE "%\\WhatsApp.exe" AND DestinationHostname LIKE "%facebook.com"))))
