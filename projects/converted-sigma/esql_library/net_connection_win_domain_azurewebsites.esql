// Title: Network Connection Initiated To AzureWebsites.NET By Non-Browser Process
// ID: 5c80b618-0dbb-46e6-acbb-03d90bcb6d83
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.command-and-control, attack.t1102, attack.t1102.001
// Description: Detects an initiated network connection by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((Initiated == "true" AND DestinationHostname LIKE "%azurewebsites.net") AND NOT ((((process.executable LIKE "C:\\Program Files (x86)\\Avant Browser\\%" OR process.executable LIKE "C:\\Program Files\\Avant Browser\\%") AND process.executable LIKE "%\\avant.exe") OR (process.executable LIKE "C:\\Program Files\\BraveSoftware\\%" AND process.executable LIKE "%\\brave.exe") OR ((process.executable == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR process.executable == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR (process.executable LIKE "C:\\Users\\%" AND process.executable LIKE "%\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe") OR ((process.executable LIKE "%C:\\Program Files\\Windows Defender Advanced Threat Protection\\%" OR process.executable LIKE "%C:\\Program Files\\Windows Defender\\%" OR process.executable LIKE "%C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\%") AND (process.executable LIKE "%\\MsMpEng.exe" OR process.executable LIKE "%\\MsSense.exe")) OR (process.executable LIKE "%\\AppData\\Local\\Discord\\%" AND process.executable LIKE "%\\Discord.exe") OR ((process.executable LIKE "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\%") OR (process.executable LIKE "%\\WindowsApps\\MicrosoftEdge.exe") OR ((process.executable == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR process.executable == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process.executable LIKE "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\%" OR process.executable LIKE "C:\\Program Files\\Microsoft\\EdgeCore\\%") AND (process.executable LIKE "%\\msedge.exe" OR process.executable LIKE "%\\msedgewebview2.exe")) OR (process.executable == "") OR ((process.executable LIKE "C:\\Program Files\\Falkon\\%" OR process.executable LIKE "C:\\Program Files (x86)\\Falkon\\%") AND process.executable LIKE "%\\falkon.exe") OR ((process.executable == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR process.executable == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR (process.executable LIKE "C:\\Users\\%" AND process.executable LIKE "%\\AppData\\Local\\Mozilla Firefox\\firefox.exe") OR (process.executable LIKE "%\\AppData\\Local\\Flock\\%" AND process.executable LIKE "%\\Flock.exe") OR ((process.executable == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR process.executable == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process.executable LIKE "%\\AppData\\Local\\Maxthon\\%" AND process.executable LIKE "%\\maxthon.exe") OR (process.executable IS NULL) OR (process.executable LIKE "%\\AppData\\Local\\Programs\\Opera\\%" AND process.executable LIKE "%\\opera.exe") OR (process.executable LIKE "%\\AppData\\Local\\Phoebe\\%" AND process.executable LIKE "%\\Phoebe.exe") OR ((process.executable LIKE "%C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe" OR process.executable LIKE "%C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe")) OR ((process.executable LIKE "C:\\Program Files (x86)\\QtWeb\\%" OR process.executable LIKE "C:\\Program Files\\QtWeb\\%") AND process.executable LIKE "%\\QtWeb.exe") OR ((process.executable LIKE "%C:\\Program Files (x86)\\Safari\\%" OR process.executable LIKE "%C:\\Program Files\\Safari\\%") AND process.executable LIKE "%\\safari.exe") OR ((process.executable LIKE "C:\\Program Files\\SeaMonkey\\%" OR process.executable LIKE "C:\\Program Files (x86)\\SeaMonkey\\%") AND process.executable LIKE "%\\seamonkey.exe") OR ((process.executable LIKE "C:\\Program Files\\SlimBrowser\\%" OR process.executable LIKE "C:\\Program Files (x86)\\SlimBrowser\\%") AND process.executable LIKE "%\\slimbrowser.exe") OR (process.executable LIKE "%\\AppData\\Local\\Vivaldi\\%" AND process.executable LIKE "%\\vivaldi.exe") OR ((process.executable LIKE "C:\\Program Files\\Naver\\Naver Whale\\%" OR process.executable LIKE "C:\\Program Files (x86)\\Naver\\Naver Whale\\%") AND process.executable LIKE "%\\whale.exe") OR ((process.executable LIKE "C:\\Program Files\\Waterfox\\%" OR process.executable LIKE "C:\\Program Files (x86)\\Waterfox\\%") AND process.executable LIKE "%\\Waterfox.exe"))))
