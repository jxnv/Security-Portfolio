// Title: Wlrmdr.EXE Uncommon Argument Or Child Process
// ID: 9cfc00b6-bfb7-49ce-9781-ef78503154bb
// Status: experimental
// Level: medium
// Author: frack113, manasmbellani
// Date: 2022-02-16
// Tags: attack.stealth, attack.t1218
// Description: Detects the execution of "Wlrmdr.exe" with the "-u" command line flag which allows anything passed to it to be an argument of the ShellExecute API, which would allow an attacker to execute arbitrary binaries.
// This detection also focuses on any uncommon child processes spawned from "Wlrmdr.exe" as a supplement for those that posses "ParentImage" telemetry.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.parent.executable LIKE "%\\wlrmdr.exe") OR ((((process.command_line LIKE "%-a %" OR process.command_line LIKE "%/a %")) AND ((process.command_line LIKE "%-f %" OR process.command_line LIKE "%/f %")) AND ((process.command_line LIKE "%-m %" OR process.command_line LIKE "%/m %")) AND ((process.command_line LIKE "%-s %" OR process.command_line LIKE "%/s %")) AND ((process.command_line LIKE "%-t %" OR process.command_line LIKE "%/t %")) AND ((process.command_line LIKE "%-u %" OR process.command_line LIKE "%/u %")) AND ((process.executable LIKE "%\\wlrmdr.exe") OR (process.pe.original_file_name == "WLRMNDR.EXE"))) AND NOT ((((process.parent.executable == "" OR process.parent.executable == "-")) OR (process.parent.executable IS NULL) OR (process.parent.executable == "C:\\Windows\\System32\\winlogon.exe")))))
