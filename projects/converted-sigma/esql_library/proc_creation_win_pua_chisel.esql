// Title: PUA - Chisel Tunneling Tool Execution
// ID: 8b0e12da-d3c3-49db-bb4f-256703f380e5
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-09-13
// Tags: attack.command-and-control, attack.t1090.001
// Description: Detects usage of the Chisel tunneling tool via the commandline arguments
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%\\chisel.exe") OR (((process.command_line LIKE "%exe client %" OR process.command_line LIKE "%exe server %")) AND ((process.command_line LIKE "%-socks5%" OR process.command_line LIKE "%-reverse%" OR process.command_line LIKE "% r:%" OR process.command_line LIKE "%:127.0.0.1:%" OR process.command_line LIKE "%-tls-skip-verify %" OR process.command_line LIKE "%:socks%"))))
