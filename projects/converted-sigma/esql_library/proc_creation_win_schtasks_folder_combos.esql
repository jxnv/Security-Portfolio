// Title: Schtasks From Suspicious Folders
// ID: 8a8379b8-780b-4dbf-b1e9-31c8d112fefb
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-04-15
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects scheduled task creations that have suspicious action command and folder combinations
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%C:\\ProgramData\\%" OR process.command_line LIKE "%%ProgramData%%")) AND ((process.command_line LIKE "%powershell%" OR process.command_line LIKE "%pwsh%" OR process.command_line LIKE "%cmd /c %" OR process.command_line LIKE "%cmd /k %" OR process.command_line LIKE "%cmd /r %" OR process.command_line LIKE "%cmd.exe /c %" OR process.command_line LIKE "%cmd.exe /k %" OR process.command_line LIKE "%cmd.exe /r %")) AND (process.command_line LIKE "% /create %") AND ((process.executable LIKE "%\\schtasks.exe") OR (process.pe.original_file_name == "schtasks.exe")))
