// Title: Potential Tampering With Security Products Via WMIC
// ID: 847d5ff3-8a31-4737-a970-aeae8fe21765
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-01-30
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects uninstallation or termination of security products using the WMIC utility
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.command_line LIKE "%wmic%" AND process.command_line LIKE "%product %" AND process.command_line LIKE "%uninstall%") AND (process.command_line LIKE "%/nointeractive%" OR process.command_line LIKE "%-nointeractive%")) OR ((process.command_line LIKE "%wmic%" AND process.command_line LIKE "%caption like %") AND (process.command_line LIKE "%call delete%" OR process.command_line LIKE "%call terminate%")) OR ((process.command_line LIKE "%process %" AND process.command_line LIKE "%where %" AND process.command_line LIKE "%delete%"))) AND ((process.command_line LIKE "%%carbon%%" OR process.command_line LIKE "%%cylance%%" OR process.command_line LIKE "%%endpoint%%" OR process.command_line LIKE "%%eset%%" OR process.command_line LIKE "%%malware%%" OR process.command_line LIKE "%%Sophos%%" OR process.command_line LIKE "%%symantec%%" OR process.command_line LIKE "%Antivirus%" OR process.command_line LIKE "%AVG %" OR process.command_line LIKE "%Carbon Black%" OR process.command_line LIKE "%CarbonBlack%" OR process.command_line LIKE "%Cb Defense Sensor 64-bit%" OR process.command_line LIKE "%Crowdstrike Sensor%" OR process.command_line LIKE "%Cylance %" OR process.command_line LIKE "%Dell Threat Defense%" OR process.command_line LIKE "%DLP Endpoint%" OR process.command_line LIKE "%Endpoint Detection%" OR process.command_line LIKE "%Endpoint Protection%" OR process.command_line LIKE "%Endpoint Security%" OR process.command_line LIKE "%Endpoint Sensor%" OR process.command_line LIKE "%ESET File Security%" OR process.command_line LIKE "%LogRhythm System Monitor Service%" OR process.command_line LIKE "%Malwarebytes%" OR process.command_line LIKE "%McAfee Agent%" OR process.command_line LIKE "%Microsoft Security Client%" OR process.command_line LIKE "%Sophos Anti-Virus%" OR process.command_line LIKE "%Sophos AutoUpdate%" OR process.command_line LIKE "%Sophos Credential Store%" OR process.command_line LIKE "%Sophos Management Console%" OR process.command_line LIKE "%Sophos Management Database%" OR process.command_line LIKE "%Sophos Management Server%" OR process.command_line LIKE "%Sophos Remote Management System%" OR process.command_line LIKE "%Sophos Update Manager%" OR process.command_line LIKE "%Threat Protection%" OR process.command_line LIKE "%VirusScan%" OR process.command_line LIKE "%Webroot SecureAnywhere%" OR process.command_line LIKE "%Windows Defender%")))
