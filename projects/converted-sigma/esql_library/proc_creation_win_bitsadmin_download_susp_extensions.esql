// Title: File With Suspicious Extension Downloaded Via Bitsadmin
// ID: 5b80a791-ad9b-4b75-bcc1-ad4e1e89c200
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-28
// Tags: attack.persistence, attack.execution, attack.stealth, attack.t1197, attack.s0190, attack.t1036.003, attack.command-and-control, attack.t1105
// Description: Detects usage of bitsadmin downloading a file with a suspicious extension
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%.7z%" OR process.command_line LIKE "%.asax%" OR process.command_line LIKE "%.ashx%" OR process.command_line LIKE "%.asmx%" OR process.command_line LIKE "%.asp%" OR process.command_line LIKE "%.aspx%" OR process.command_line LIKE "%.bat%" OR process.command_line LIKE "%.cfm%" OR process.command_line LIKE "%.cgi%" OR process.command_line LIKE "%.chm%" OR process.command_line LIKE "%.cmd%" OR process.command_line LIKE "%.dll%" OR process.command_line LIKE "%.gif%" OR process.command_line LIKE "%.jpeg%" OR process.command_line LIKE "%.jpg%" OR process.command_line LIKE "%.jsp%" OR process.command_line LIKE "%.jspx%" OR process.command_line LIKE "%.log%" OR process.command_line LIKE "%.png%" OR process.command_line LIKE "%.ps1%" OR process.command_line LIKE "%.psm1%" OR process.command_line LIKE "%.rar%" OR process.command_line LIKE "%.scf%" OR process.command_line LIKE "%.sct%" OR process.command_line LIKE "%.txt%" OR process.command_line LIKE "%.vbe%" OR process.command_line LIKE "%.vbs%" OR process.command_line LIKE "%.war%" OR process.command_line LIKE "%.wsf%" OR process.command_line LIKE "%.wsh%" OR process.command_line LIKE "%.xll%" OR process.command_line LIKE "%.zip%")) AND ((process.command_line LIKE "% /transfer %" OR process.command_line LIKE "% /create %" OR process.command_line LIKE "% /addfile %")) AND ((process.executable LIKE "%\\bitsadmin.exe") OR (process.pe.original_file_name == "bitsadmin.exe")))
