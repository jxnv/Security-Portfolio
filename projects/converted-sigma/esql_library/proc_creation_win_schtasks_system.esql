// Title: Schtasks Creation Or Modification With SYSTEM Privileges
// ID: 89ca78fd-b37c-4310-b3d3-81a023f83936
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-28
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053.005
// Description: Detects the creation or update of a scheduled task to run with "NT AUTHORITY\SYSTEM" privileges
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%\\schtasks.exe" AND (process.command_line LIKE "% /change %" OR process.command_line LIKE "% /create %")) AND (process.command_line LIKE "%/ru %") AND ((process.command_line LIKE "%NT AUT%" OR process.command_line LIKE "% SYSTEM %"))) AND NOT ((((process.command_line LIKE "%/Create /F /RU System /SC WEEKLY /TN AviraSystemSpeedupVerify /TR %" OR process.command_line LIKE "%:\\Program Files (x86)\\Avira\\System Speedup\\setup\\avira_speedup_setup.exe%" OR process.command_line LIKE "%/VERIFY /VERYSILENT /NOSTART /NODOTNET /NORESTART\" /RL HIGHEST%")) OR ((process.command_line LIKE "%Subscription Heartbeat%" AND process.command_line LIKE "%\\HeartbeatConfig.xml%" AND process.command_line LIKE "%\\Microsoft Shared\\OFFICE%")) OR (process.executable LIKE "%\\schtasks.exe" AND (process.command_line LIKE "%/TN TVInstallRestore%" AND process.command_line LIKE "%\\TeamViewer_.exe%")))))
