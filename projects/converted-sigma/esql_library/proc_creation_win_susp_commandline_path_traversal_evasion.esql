// Title: Potential Command Line Path Traversal Evasion Attempt
// ID: 1327381e-6ab0-4f38-b583-4c1b8346a56b
// Status: test
// Level: medium
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-10-26
// Tags: attack.stealth, attack.t1036
// Description: Detects potential evasion or obfuscation attempts using bogus path traversal via the commandline
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%\\Windows\\%" AND (process.command_line LIKE "%\\..\\Windows\\%" OR process.command_line LIKE "%\\..\\System32\\%" OR process.command_line LIKE "%\\..\\..\\%")) OR (process.command_line LIKE "%.exe\\..\\%")) AND NOT (((process.command_line LIKE "%\\Citrix\\Virtual Smart Card\\Citrix.Authentication.VirtualSmartcard.Launcher.exe\\..\\%") OR (process.command_line LIKE "%\\Google\\Drive\\googledrivesync.exe\\..\\%"))))
