// Title: PUA - Restic Backup Tool Execution
// ID: 6ddff2e8-ea1a-45d0-8938-93dfc1d67ae7
// Status: experimental
// Level: high
// Author: Nounou Mbeiri, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-10-17
// Tags: attack.exfiltration, attack.t1048, attack.t1567.002
// Description: Detects the execution of the Restic backup tool, which can be used for data exfiltration.
// Threat actors may leverage Restic to back up and exfiltrate sensitive data to remote storage locations, including cloud services.
// If not legitimately used in the enterprise environment, its presence may indicate malicious activity.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%sftp:%" OR process.command_line LIKE "%rest:http%" OR process.command_line LIKE "%s3:s3.%" OR process.command_line LIKE "%s3.http%" OR process.command_line LIKE "%azure:%" OR process.command_line LIKE "% gs:%" OR process.command_line LIKE "%rclone:%" OR process.command_line LIKE "%swift:%" OR process.command_line LIKE "% b2:%") AND (process.command_line LIKE "% init %" AND process.command_line LIKE "% -r %")) OR (((process.command_line LIKE "%--password-file%" AND process.command_line LIKE "%init%" AND process.command_line LIKE "% -r %")) OR ((process.command_line LIKE "%--use-fs-snapshot%" AND process.command_line LIKE "%backup%" AND process.command_line LIKE "% -r %"))))
