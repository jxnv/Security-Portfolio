// Title: Microsoft Office DLL Sideload
// ID: 829a3bdf-34da-4051-9cf4-8ed221a8ae4f
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Wietze Beukema (project and research)
// Date: 2022-08-17
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects DLL sideloading of DLLs that are part of Microsoft Office from non standard location
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((ImageLoaded LIKE "%\\outllib.dll") AND NOT (((ImageLoaded LIKE "C:\\Program Files\\Microsoft Office\\OFFICE%" OR ImageLoaded LIKE "C:\\Program Files (x86)\\Microsoft Office\\OFFICE%" OR ImageLoaded LIKE "C:\\Program Files\\Microsoft Office\\Root\\OFFICE%" OR ImageLoaded LIKE "C:\\Program Files (x86)\\Microsoft Office\\Root\\OFFICE%"))))
