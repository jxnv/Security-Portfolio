// Title: Suspicious ASPX File Drop by Exchange
// ID: bd1212e5-78da-431e-95fa-c58e3237a8e6
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), MSTI (query, idea)
// Date: 2022-10-01
// Tags: attack.persistence, attack.t1505.003
// Description: Detects suspicious file type dropped by an Exchange component in IIS into a suspicious folder
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%\\w3wp.exe" AND process.command_line LIKE "%MSExchange%" AND (file.path LIKE "%FrontEnd\\HttpProxy\\%" OR file.path LIKE "%\\inetpub\\wwwroot\\aspnet_client\\%")) AND ((file.path LIKE "%.aspx" OR file.path LIKE "%.asp" OR file.path LIKE "%.ashx")))
