// Title: PowerShell AppLocker Policy Discovery Via Get-AppLockerPolicy
// ID: f14b1e99-5e53-4598-98dc-6f20ad7b35e0
// Status: experimental
// Level: low
// Author: Tom3306
// Date: 2026-08-19
// Tags: attack.discovery, attack.t1518.001
// Description: Detects AppLocker policy enumeration attempts via PowerShell using the Get-AppLockerPolicy cmdlet and an policy scope of either Effective, LDAP, or Local.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.command_line LIKE "%Get-AppLockerPolicy%") AND ((process.command_line LIKE "% -Effective%" OR process.command_line LIKE "% -Ldap %" OR process.command_line LIKE "% -Local%")) AND (((process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe")) OR ((process.pe.original_file_name == "PowerShell.EXE" OR process.pe.original_file_name == "pwsh.dll"))))
