// Title: Potential DLL Sideloading Of DbgModel.DLL
// ID: fef394cd-f44d-4040-9b18-95d92fe278c0
// Status: test
// Level: medium
// Author: Gary Lobermier
// Date: 2024-07-11
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of "DbgModel.dll"
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((ImageLoaded LIKE "%\\dbgmodel.dll") AND NOT (((ImageLoaded LIKE "C:\\Windows\\System32\\%" OR ImageLoaded LIKE "C:\\Windows\\SysWOW64\\%" OR ImageLoaded LIKE "C:\\Windows\\WinSxS\\%"))) AND NOT (((ImageLoaded LIKE "C:\\Program Files\\WindowsApps\\Microsoft.WinDbg_%") OR ((ImageLoaded LIKE "C:\\Program Files (x86)\\Windows Kits\\%" OR ImageLoaded LIKE "C:\\Program Files\\Windows Kits\\%")))))
