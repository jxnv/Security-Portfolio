// Description: Detects actions caused by the RedMimicry Winnti playbook a automated breach emulations utility
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%\\rundll32.exe" OR process.executable LIKE "%\\cmd.exe") AND (process.command_line LIKE "%gthread-3.6.dll%" OR process.command_line LIKE "%\\Windows\\Temp\\tmp.bat%" OR process.command_line LIKE "%sigcmm-2.4.dll%"))
