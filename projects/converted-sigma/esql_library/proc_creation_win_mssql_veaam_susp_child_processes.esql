// Title: Suspicious Child Process Of Veeam Dabatase
// ID: d55b793d-f847-4eea-b59a-5ab09908ac90
// Status: test
// Level: critical
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-04
// Tags: attack.initial-access, attack.persistence, attack.privilege-escalation
// Description: Detects suspicious child processes of the Veeam service process. This could indicate potential RCE or SQL Injection.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.parent.executable LIKE "%\\sqlservr.exe" AND process.parent.command_line LIKE "%VEEAMSQL%") AND (((process.executable LIKE "%\\cmd.exe" OR process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe" OR process.executable LIKE "%\\wsl.exe" OR process.executable LIKE "%\\wt.exe") AND (process.command_line LIKE "%-ex %" OR process.command_line LIKE "%bypass%" OR process.command_line LIKE "%cscript%" OR process.command_line LIKE "%DownloadString%" OR process.command_line LIKE "%http://%" OR process.command_line LIKE "%https://%" OR process.command_line LIKE "%mshta%" OR process.command_line LIKE "%regsvr32%" OR process.command_line LIKE "%rundll32%" OR process.command_line LIKE "%wscript%" OR process.command_line LIKE "%copy %")) OR ((process.executable LIKE "%\\net.exe" OR process.executable LIKE "%\\net1.exe" OR process.executable LIKE "%\\netstat.exe" OR process.executable LIKE "%\\nltest.exe" OR process.executable LIKE "%\\ping.exe" OR process.executable LIKE "%\\tasklist.exe" OR process.executable LIKE "%\\whoami.exe"))))
