// Title: Microsoft Office Protected View Disabled
// ID: a5c7a43f-6009-4a8c-80c5-32abf1c53ecc
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-06-08
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects changes to Microsoft Office protected view registry keys with which the attacker disables this feature.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((registry.path LIKE "%\\SOFTWARE\\Microsoft\\Office\\%" AND registry.path LIKE "%\\Security\\ProtectedView\\%")) AND ((registry.data.strings == "DWORD (0x00000000)" AND (registry.path LIKE "%\\enabledatabasefileprotectedview" OR registry.path LIKE "%\\enableforeigntextfileprotectedview")) OR (registry.data.strings == "DWORD (0x00000001)" AND (registry.path LIKE "%\\DisableAttachementsInPV" OR registry.path LIKE "%\\DisableInternetFilesInPV" OR registry.path LIKE "%\\DisableIntranetCheck" OR registry.path LIKE "%\\DisableUnsafeLocationsInPV"))))
