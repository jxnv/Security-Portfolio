// Title: Potential AMSI Bypass Via .NET Reflection
// ID: 30edb182-aa75-42c0-b0a9-e998bb29067c
// Status: test
// Level: high
// Author: Markus Neis, @Kostastsale
// Date: 2018-08-17
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects Request to "amsiInitFailed" that can be used to disable AMSI Scanning
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%System.Management.Automation.AmsiUtils%" AND process.command_line LIKE "%amsiInitFailed%")) OR ((process.command_line LIKE "%[Ref].Assembly.GetType%" AND process.command_line LIKE "%SetValue($null,$true)%" AND process.command_line LIKE "%NonPublic,Static%")))
