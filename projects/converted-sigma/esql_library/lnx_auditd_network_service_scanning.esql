// Title: Linux Network Service Scanning - Auditd
// ID: 3761e026-f259-44e6-8826-719ed8079408
// Status: test
// Level: low
// Author: Alejandro Ortuno, oscd.community
// Date: 2020-10-21
// Tags: attack.discovery, attack.t1046
// Description: Detects enumeration of local or remote network services.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (type == "SYSCALL" AND (exe LIKE "%/telnet" OR exe LIKE "%/nmap" OR exe LIKE "%/netcat" OR exe LIKE "%/nc" OR exe LIKE "%/ncat" OR exe LIKE "%/nc.openbsd") AND key == "network_connect_4")
