// Title: Process Execution From A Potentially Suspicious Folder
// ID: 3dfd06d2-eaf4-4532-9555-68aca59f57c4
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Tim Shelton
// Date: 2019-01-16
// Tags: attack.stealth, attack.t1036
// Description: Detects a potentially suspicious execution from an uncommon folder.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%:\\Perflogs\\%" OR process.executable LIKE "%:\\Users\\All Users\\%" OR process.executable LIKE "%:\\Users\\Default\\%" OR process.executable LIKE "%:\\Users\\NetworkService\\%" OR process.executable LIKE "%:\\Windows\\addins\\%" OR process.executable LIKE "%:\\Windows\\debug\\%" OR process.executable LIKE "%:\\Windows\\Fonts\\%" OR process.executable LIKE "%:\\Windows\\Help\\%" OR process.executable LIKE "%:\\Windows\\IME\\%" OR process.executable LIKE "%:\\Windows\\Media\\%" OR process.executable LIKE "%:\\Windows\\repair\\%" OR process.executable LIKE "%:\\Windows\\security\\%" OR process.executable LIKE "%:\\Windows\\System32\\Tasks\\%" OR process.executable LIKE "%:\\Windows\\Tasks\\%" OR process.executable LIKE "%$Recycle.bin%" OR process.executable LIKE "%\\config\\systemprofile\\%" OR process.executable LIKE "%\\Intel\\Logs\\%" OR process.executable LIKE "%\\RSA\\MachineKeys\\%")) AND NOT (((process.executable LIKE "C:\\Windows\\SysWOW64\\config\\systemprofile\\Citrix\\UpdaterBinaries\\%" AND process.executable LIKE "%\\CitrixReceiverUpdater.exe") OR (process.executable LIKE "C:\\Users\\Public\\IBM\\ClientSolutions\\Start_Programs\\%"))))
