// Title: Suspicious DNS Query for IP Lookup Service APIs
// ID: ec82e2a5-81ea-4211-a1f8-37a0286df2c2
// Status: test
// Level: medium
// Author: Brandon George (blog post), Thomas Patzke
// Date: 2021-07-08
// Tags: attack.reconnaissance, attack.t1590
// Description: Detects DNS queries for IP lookup services such as "api.ipify.org" originating from a non browser process.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((QueryName == "www.ip.cn" OR QueryName == "l2.io")) OR ((QueryName LIKE "%api.2ip.ua%" OR QueryName LIKE "%api.bigdatacloud.net%" OR QueryName LIKE "%api.ipify.org%" OR QueryName LIKE "%bot.whatismyipaddress.com%" OR QueryName LIKE "%canireachthe.net%" OR QueryName LIKE "%checkip.amazonaws.com%" OR QueryName LIKE "%checkip.dyndns.org%" OR QueryName LIKE "%curlmyip.com%" OR QueryName LIKE "%db-ip.com%" OR QueryName LIKE "%edns.ip-api.com%" OR QueryName LIKE "%eth0.me%" OR QueryName LIKE "%freegeoip.app%" OR QueryName LIKE "%geoipy.com%" OR QueryName LIKE "%getip.pro%" OR QueryName LIKE "%icanhazip.com%" OR QueryName LIKE "%ident.me%" OR QueryName LIKE "%ifconfig.io%" OR QueryName LIKE "%ifconfig.me%" OR QueryName LIKE "%ip-api.com%" OR QueryName LIKE "%ip.360.cn%" OR QueryName LIKE "%ip.anysrc.net%" OR QueryName LIKE "%ip.taobao.com%" OR QueryName LIKE "%ip.tyk.nu%" OR QueryName LIKE "%ipaddressworld.com%" OR QueryName LIKE "%ipapi.co%" OR QueryName LIKE "%ipconfig.io%" OR QueryName LIKE "%ipecho.net%" OR QueryName LIKE "%ipinfo.io%" OR QueryName LIKE "%ipip.net%" OR QueryName LIKE "%ipof.in%" OR QueryName LIKE "%ipv4.icanhazip.com%" OR QueryName LIKE "%ipv4bot.whatismyipaddress.com%" OR QueryName LIKE "%ipv6-test.com%" OR QueryName LIKE "%ipwho.is%" OR QueryName LIKE "%jsonip.com%" OR QueryName LIKE "%myexternalip.com%" OR QueryName LIKE "%seeip.org%" OR QueryName LIKE "%wgetip.com%" OR QueryName LIKE "%whatismyip.akamai.com%" OR QueryName LIKE "%whois.pconline.com.cn%" OR QueryName LIKE "%wtfismyip.com%"))) AND NOT (((process.executable LIKE "%\\brave.exe") OR ((process.executable == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR process.executable == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((process.executable LIKE "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\%") OR (process.executable LIKE "%\\WindowsApps\\MicrosoftEdge.exe") OR ((process.executable == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR process.executable == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process.executable LIKE "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\%" OR process.executable LIKE "C:\\Program Files\\Microsoft\\EdgeCore\\%") AND (process.executable LIKE "%\\msedge.exe" OR process.executable LIKE "%\\msedgewebview2.exe")) OR ((process.executable == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR process.executable == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR ((process.executable == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR process.executable == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process.executable LIKE "%\\maxthon.exe") OR (process.executable LIKE "%\\opera.exe") OR (process.executable LIKE "%\\safari.exe") OR (process.executable LIKE "%\\seamonkey.exe") OR (process.executable LIKE "%\\vivaldi.exe") OR (process.executable LIKE "%\\whale.exe"))))
