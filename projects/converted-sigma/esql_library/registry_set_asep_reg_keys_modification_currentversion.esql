// Description: Detects modification of autostart extensibility point (ASEP) in registry.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((registry.path LIKE "%\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion%") AND ((registry.path LIKE "%\\ShellServiceObjectDelayLoad%" OR registry.path LIKE "%\\Run\\%" OR registry.path LIKE "%\\RunOnce\\%" OR registry.path LIKE "%\\RunOnceEx\\%" OR registry.path LIKE "%\\RunServices\\%" OR registry.path LIKE "%\\RunServicesOnce\\%" OR registry.path LIKE "%\\Policies\\System\\Shell%" OR registry.path LIKE "%\\Policies\\Explorer\\Run%" OR registry.path LIKE "%\\Group Policy\\Scripts\\Startup%" OR registry.path LIKE "%\\Group Policy\\Scripts\\Shutdown%" OR registry.path LIKE "%\\Group Policy\\Scripts\\Logon%" OR registry.path LIKE "%\\Group Policy\\Scripts\\Logoff%" OR registry.path LIKE "%\\Explorer\\ShellServiceObjects%" OR registry.path LIKE "%\\Explorer\\ShellIconOverlayIdentifiers%" OR registry.path LIKE "%\\Explorer\\ShellExecuteHooks%" OR registry.path LIKE "%\\Explorer\\SharedTaskScheduler%" OR registry.path LIKE "%\\Explorer\\Browser Helper Objects%" OR registry.path LIKE "%\\Authentication\\PLAP Providers%" OR registry.path LIKE "%\\Authentication\\Credential Providers%" OR registry.path LIKE "%\\Authentication\\Credential Provider Filters%"))) AND NOT (((process.executable == "C:\\Windows\\system32\\userinit.exe" AND registry.data.strings == "ctfmon.exe /n") OR (process.executable == "C:\\Program Files\\Windows Defender\\MsMpEng.exe") OR ((process.executable LIKE "C:\\Program Files (x86)\\Microsoft\\EdgeUpdate\\Install\\%" OR process.executable LIKE "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\%" OR process.executable LIKE "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe%")) OR ((registry.data.strings == "(Empty)") OR (registry.path LIKE "%\\NgcFirst\\ConsecutiveSwitchCount") OR ((process.executable LIKE "%\\AppData\\Local\\Microsoft\\OneDrive\\Update\\OneDriveSetup.exe" OR process.executable LIKE "%\\AppData\\Roaming\\Spotify\\Spotify.exe" OR process.executable LIKE "%\\AppData\\Local\\WebEx\\WebexHost.exe")) OR ((process.executable == "C:\\WINDOWS\\system32\\devicecensus.exe" OR process.executable == "C:\\Windows\\system32\\winsat.exe" OR process.executable == "C:\\Program Files\\Microsoft OneDrive\\StandaloneUpdater\\OneDriveSetup.exe" OR process.executable == "C:\\Program Files (x86)\\Microsoft OneDrive\\StandaloneUpdater\\OneDriveSetup.exe" OR process.executable == "C:\\Program Files\\Microsoft OneDrive\\Update\\OneDriveSetup.exe" OR process.executable == "C:\\Program Files (x86)\\Microsoft OneDrive\\Update\\OneDriveSetup.exe" OR process.executable == "C:\\Program Files\\Microsoft Office\\root\\integration\\Addons\\OneDriveSetup.exe" OR process.executable == "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\Addons\\OneDriveSetup.exe" OR process.executable == "C:\\Program Files\\KeePass Password Safe 2\\ShInstUtil.exe" OR process.executable == "C:\\Program Files\\Everything\\Everything.exe" OR process.executable == "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe" OR process.executable == "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe"))) OR (process.executable == "C:\\Windows\\system32\\LogonUI.exe" AND (registry.path LIKE "%\\Authentication\\Credential Providers\\{D6886603-9D2F-4EB2-B667-1971041FA96B}\\%" OR registry.path LIKE "%\\Authentication\\Credential Providers\\{BEC09223-B018-416D-A0AC-523971B639F5}\\%" OR registry.path LIKE "%\\Authentication\\Credential Providers\\{8AF662BF-65A0-4D0A-A540-A338A999D36F}\\%" OR registry.path LIKE "%\\Authentication\\Credential Providers\\{27FBDB57-B613-4AF2-9D7E-4FA7A66C21AD}\\%")) OR (registry.data.strings IS NULL) OR (process.executable LIKE "%\\Microsoft\\Teams\\current\\Teams.exe" AND registry.data.strings LIKE "%\\Microsoft\\Teams\\Update.exe --processStart %"))) AND NOT ((((process.executable == "C:\\Program Files\\AVG\\Antivirus\\avgToolsSvc.exe" OR process.executable == "C:\\Program Files (x86)\\AVG\\Antivirus\\avgToolsSvc.exe") AND registry.path LIKE "%\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\StartupApproved\\Run\\%" AND registry.data.strings == "Binary Data") OR ((process.executable LIKE "%C:\\Program Files\\AVG\\Antivirus\\Setup\\%" OR process.executable LIKE "%C:\\Program Files (x86)\\AVG\\Antivirus\\Setup\\%" OR process.executable LIKE "%\\instup.exe%") AND (registry.data.strings == "\"C:\\Program Files\\AVG\\Antivirus\\AvLaunch.exe\" /gui" OR registry.data.strings == "\"C:\\Program Files (x86)\\AVG\\Antivirus\\AvLaunch.exe\" /gui" OR registry.data.strings == "{472083B0-C522-11CF-8763-00608CC02F24}" OR registry.data.strings == "{472083B1-C522-11CF-8763-00608CC02F24}")) OR ((process.executable LIKE "%C:\\Program Files\\Avast Software\\Avast\\Setup\\%" OR process.executable LIKE "%C:\\Program Files (x86)\\Avast Software\\Avast\\Setup\\%" OR process.executable LIKE "%\\instup.exe%") AND (registry.data.strings == "\"C:\\Program Files\\Avast Software\\Avast\\AvLaunch.exe\" /gui" OR registry.data.strings == "\"C:\\Program Files (x86)\\Avast Software\\Avast\\AvLaunch.exe\" /gui")) OR ((process.executable LIKE "%\\aurora-agent-64.exe" OR process.executable LIKE "%\\aurora-agent.exe") AND registry.path LIKE "%\\Microsoft\\Windows\\CurrentVersion\\Run\\aurora-dashboard" AND registry.data.strings == "C:\\Program Files\\Aurora-Agent\\tools\\aurora-dashboard.exe") OR (registry.path LIKE "%\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\\Discord" AND registry.data.strings LIKE "%\\Discord\\Update.exe --processStart Discord.exe") OR (process.executable == "C:\\Windows\\system32\\regsvr32.exe" AND registry.path LIKE "%DropboxExt%" AND registry.data.strings LIKE "%A251-47B7-93E1-CDD82E34AF8B}") OR (registry.path LIKE "%\\Microsoft\\Windows\\CurrentVersion\\Run\\Everything" AND registry.data.strings LIKE "%\\Everything\\Everything.exe\" -startup") OR (registry.path LIKE "%\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\\GoogleDriveFS" AND registry.data.strings LIKE "C:\\Program Files\\Google\\Drive File Stream\\%" AND registry.data.strings LIKE "%\\GoogleDriveFS.exe%") OR (registry.path LIKE "%GoogleDrive%" AND (registry.data.strings == "{CFE8B367-77A7-41D7-9C90-75D16D7DC6B6}" OR registry.data.strings == "{A8E52322-8734-481D-A7E2-27B309EF8D56}" OR registry.data.strings == "{C973DA94-CBDF-4E77-81D1-E5B794FBD146}" OR registry.data.strings == "{51EF1569-67EE-4AD6-9646-E726C3FFC8A2}")) OR (registry.path LIKE "%\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\\Greenshot" AND registry.data.strings == "C:\\Program Files\\Greenshot\\Greenshot.exe") OR (registry.path LIKE "%\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\\iTunesHelper" AND registry.data.strings == "\"C:\\Program Files\\iTunes\\iTunesHelper.exe\"") OR ((process.executable LIKE "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\%" OR process.executable LIKE "C:\\Program Files (x86)\\Common Files\\Microsoft Shared\\ClickToRun\\%") AND process.executable LIKE "%\\OfficeClickToRun.exe") OR ((registry.data.strings LIKE "C:\\Windows\\system32\\cmd.exe /q /c rmdir /s /q \"C:\\Users\\%" OR registry.data.strings LIKE "C:\\Windows\\system32\\cmd.exe /q /c del /q \"C:\\Users\\%") AND registry.data.strings LIKE "%\\AppData\\Local\\Microsoft\\OneDrive\\%") OR (registry.path LIKE "%\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\\Opera Browser Assistant" AND registry.data.strings == "C:\\Program Files\\Opera\\assistant\\browser_assistant.exe") OR (registry.path LIKE "%\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\\Opera Stable" AND (registry.data.strings == "C:\\Program Files\\Opera\\launcher.exe" OR registry.data.strings == "C:\\Program Files (x86)\\Opera\\launcher.exe")) OR (registry.path LIKE "%\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\{%" AND (registry.data.strings LIKE "%\\AppData\\Local\\Package Cache\\{%" AND registry.data.strings LIKE "%}\\python-%") AND registry.data.strings LIKE "%.exe\" /burn.runonce") OR (process.executable LIKE "%\\Microsoft\\Teams\\current\\Teams.exe" AND registry.data.strings LIKE "%\\Microsoft\\Teams\\Update.exe --processStart%") OR (registry.path LIKE "%\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\zoommsirepair" AND registry.data.strings == "\"C:\\Program Files\\Zoom\\bin\\installer.exe\" /repair"))))
