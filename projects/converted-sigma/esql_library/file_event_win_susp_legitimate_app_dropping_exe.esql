// Title: Legitimate Application Dropped Executable
// ID: f0540f7e-2db3-4432-b9e0-3965486744bc
// Status: test
// Level: high
// Author: frack113, Florian Roth (Nextron Systems)
// Date: 2022-08-21
// Tags: attack.stealth, attack.t1218
// Description: Detects LOLBINs and applications that should not legitimately drop executable or executable-equivalent files to disk.
// This may indicate malware staging, process injection, or abuse of a trusted binary for payload delivery.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%\\eqnedt32.exe" OR process.executable LIKE "%\\wordpad.exe" OR process.executable LIKE "%\\wordview.exe" OR process.executable LIKE "%\\certutil.exe" OR process.executable LIKE "%\\certoc.exe" OR process.executable LIKE "%\\CertReq.exe" OR process.executable LIKE "%\\Desktopimgdownldr.exe" OR process.executable LIKE "%\\esentutl.exe" OR process.executable LIKE "%\\mshta.exe" OR process.executable LIKE "%\\AcroRd32.exe" OR process.executable LIKE "%\\RdrCEF.exe" OR process.executable LIKE "%\\hh.exe" OR process.executable LIKE "%\\finger.exe") AND (file.path LIKE "%.com" OR file.path LIKE "%.dll" OR file.path LIKE "%.exe" OR file.path LIKE "%.jar" OR file.path LIKE "%.ocx" OR file.path LIKE "%.pyc"))
