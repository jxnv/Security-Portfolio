// Title: Powershell Base64 Encoded MpPreference Cmdlet
// ID: c6fb44c6-71f5-49e6-9462-1425d328aee3
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-04
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects base64 encoded "MpPreference" PowerShell cmdlet code that tries to modifies or tamper with Windows Defender AV
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%QWRkLU1wUHJlZmVyZW5jZS%" OR process.command_line LIKE "%FkZC1NcFByZWZlcmVuY2Ug%" OR process.command_line LIKE "%BZGQtTXBQcmVmZXJlbmNlI%" OR process.command_line LIKE "%U2V0LU1wUHJlZmVyZW5jZS%" OR process.command_line LIKE "%NldC1NcFByZWZlcmVuY2Ug%" OR process.command_line LIKE "%TZXQtTXBQcmVmZXJlbmNlI%" OR process.command_line LIKE "%YWRkLW1wcHJlZmVyZW5jZS%" OR process.command_line LIKE "%FkZC1tcHByZWZlcmVuY2Ug%" OR process.command_line LIKE "%hZGQtbXBwcmVmZXJlbmNlI%" OR process.command_line LIKE "%c2V0LW1wcHJlZmVyZW5jZS%" OR process.command_line LIKE "%NldC1tcHByZWZlcmVuY2Ug%" OR process.command_line LIKE "%zZXQtbXBwcmVmZXJlbmNlI%")) OR ((process.command_line LIKE "%QQBkAGQALQBNAHAAUAByAGUAZgBlAHIAZQBuAGMAZQAgA%" OR process.command_line LIKE "%EAZABkAC0ATQBwAFAAcgBlAGYAZQByAGUAbgBjAGUAIA%" OR process.command_line LIKE "%BAGQAZAAtAE0AcABQAHIAZQBmAGUAcgBlAG4AYwBlACAA%" OR process.command_line LIKE "%UwBlAHQALQBNAHAAUAByAGUAZgBlAHIAZQBuAGMAZQAgA%" OR process.command_line LIKE "%MAZQB0AC0ATQBwAFAAcgBlAGYAZQByAGUAbgBjAGUAIA%" OR process.command_line LIKE "%TAGUAdAAtAE0AcABQAHIAZQBmAGUAcgBlAG4AYwBlACAA%" OR process.command_line LIKE "%YQBkAGQALQBtAHAAcAByAGUAZgBlAHIAZQBuAGMAZQAgA%" OR process.command_line LIKE "%EAZABkAC0AbQBwAHAAcgBlAGYAZQByAGUAbgBjAGUAIA%" OR process.command_line LIKE "%hAGQAZAAtAG0AcABwAHIAZQBmAGUAcgBlAG4AYwBlACAA%" OR process.command_line LIKE "%cwBlAHQALQBtAHAAcAByAGUAZgBlAHIAZQBuAGMAZQAgA%" OR process.command_line LIKE "%MAZQB0AC0AbQBwAHAAcgBlAGYAZQByAGUAbgBjAGUAIA%" OR process.command_line LIKE "%zAGUAdAAtAG0AcABwAHIAZQBmAGUAcgBlAG4AYwBlACAA%")))
