// Title: Scheduled TaskCache Change by Uncommon Program
// ID: 4720b7df-40c3-48fd-bbdf-fd4b3c464f0d
// Status: test
// Level: high
// Author: Syed Hasan (@syedhasan009)
// Date: 2021-06-18
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053, attack.t1053.005
// Description: Monitor the creation of a new key under 'TaskCache' when a new scheduled task is registered by a process that is not svchost.exe, which is suspicious
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((registry.path LIKE "%SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Schedule\\TaskCache\\%") AND NOT (((registry.data.strings == "(Empty)") OR (process.executable == "C:\\Windows\\explorer.exe" AND registry.path LIKE "%\\Microsoft\\Windows NT\\CurrentVersion\\Schedule\\TaskCache\\Tree\\Microsoft\\Windows\\PLA\\Server Manager Performance Monitor\\%") OR (process.executable LIKE "%C:\\Windows\\System32\\MoUsoCoreWorker.exe") OR (process.executable == "C:\\Windows\\System32\\msiexec.exe") OR (process.executable LIKE "C:\\Windows\\Microsoft.NET\\Framework%" AND process.executable LIKE "%\\ngen.exe" AND (registry.path LIKE "%\\Microsoft\\Windows NT\\CurrentVersion\\Schedule\\TaskCache\\Tasks\\{B66B135D-DA06-4FC4-95F8-7458E1D10129}%" OR registry.path LIKE "%\\Microsoft\\Windows NT\\CurrentVersion\\Schedule\\TaskCache\\Tree\\Microsoft\\Windows\\.NET Framework\\.NET Framework NGEN%")) OR (registry.data.strings IS NULL) OR ((process.executable == "C:\\Program Files\\Microsoft Office\\root\\Integration\\Integrator.exe" OR process.executable == "C:\\Program Files (x86)\\Microsoft Office\\root\\Integration\\Integrator.exe" OR process.executable == "C:\\Program Files\\Common Files\\microsoft shared\\ClickToRun\\OfficeC2RClient.exe" OR process.executable == "C:\\Program Files (x86)\\Common Files\\microsoft shared\\ClickToRun\\OfficeC2RClient.exe")) OR ((registry.path LIKE "%Microsoft\\Windows\\UpdateOrchestrator%" OR registry.path LIKE "%Microsoft\\Windows\\SoftwareProtectionPlatform\\SvcRestartTask\\Index%" OR registry.path LIKE "%Microsoft\\Windows\\Flighting\\OneSettings\\RefreshCache\\Index%")) OR (process.executable == "C:\\Windows\\System32\\RuntimeBroker.exe") OR (process.executable LIKE "%C:\\Windows\\System32\\services.exe") OR (process.executable == "C:\\WINDOWS\\system32\\svchost.exe") OR (process.executable == "System") OR (process.executable LIKE "C:\\Windows\\%" AND process.executable LIKE "%\\TiWorker.exe"))) AND NOT ((((process.executable == "C:\\Program Files (x86)\\Dropbox\\Update\\DropboxUpdate.exe" OR process.executable == "C:\\Program Files\\Dropbox\\Update\\DropboxUpdate.exe")) OR ((process.executable LIKE "%C:\\Program Files (x86)\\Microsoft\\EdgeUpdate\\MicrosoftEdgeUpdate.exe" OR process.executable LIKE "%C:\\Program Files\\Microsoft\\EdgeUpdate\\MicrosoftEdgeUpdate.exe")) OR ((process.executable LIKE "%C:\\Program Files (x86)\\Microsoft OneDrive\\OneDrive.exe" OR process.executable LIKE "%C:\\Program Files\\Microsoft OneDrive\\OneDrive.exe")))))
