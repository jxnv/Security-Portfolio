// Title: Network Connection Initiated From Process Located In Potentially Suspicious Or Uncommon Location
// ID: 7b434893-c57d-4f41-908d-6a17bf1ae98f
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2017-03-19
// Tags: attack.command-and-control, attack.t1105
// Description: Detects a network connection initiated by programs or processes running from suspicious or uncommon files system locations.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((Initiated == "true" AND (process.executable LIKE "%:\\$Recycle.bin%" OR process.executable LIKE "%:\\Perflogs\\%" OR process.executable LIKE "%:\\Temp\\%" OR process.executable LIKE "%:\\Users\\Default\\%" OR process.executable LIKE "%:\\Users\\Public\\%" OR process.executable LIKE "%:\\Windows\\Fonts\\%" OR process.executable LIKE "%:\\Windows\\IME\\%" OR process.executable LIKE "%:\\Windows\\System32\\Tasks\\%" OR process.executable LIKE "%:\\Windows\\Tasks\\%" OR process.executable LIKE "%\\config\\systemprofile\\%" OR process.executable LIKE "%\\Contacts\\%" OR process.executable LIKE "%\\Favorites\\%" OR process.executable LIKE "%\\Favourites\\%" OR process.executable LIKE "%\\Music\\%" OR process.executable LIKE "%\\Pictures\\%" OR process.executable LIKE "%\\Videos\\%" OR process.executable LIKE "%\\Windows\\addins\\%")) AND NOT (((DestinationHostname LIKE "%.githubusercontent.com" OR DestinationHostname LIKE "%0x0.st" OR DestinationHostname LIKE "%anonfiles.com" OR DestinationHostname LIKE "%bashupload.com" OR DestinationHostname LIKE "%cdn.discordapp.com" OR DestinationHostname LIKE "%chunk.io" OR DestinationHostname LIKE "%ddns.net" OR DestinationHostname LIKE "%dl.dropboxusercontent.com" OR DestinationHostname LIKE "%ghostbin.co" OR DestinationHostname LIKE "%github.com" OR DestinationHostname LIKE "%glitch.me" OR DestinationHostname LIKE "%gofile.io" OR DestinationHostname LIKE "%hastebin.com" OR DestinationHostname LIKE "%mediafire.com" OR DestinationHostname LIKE "%mega.co.nz" OR DestinationHostname LIKE "%mega.nz" OR DestinationHostname LIKE "%onrender.com" OR DestinationHostname LIKE "%pages.dev" OR DestinationHostname LIKE "%paste.ee" OR DestinationHostname LIKE "%pastebin.com" OR DestinationHostname LIKE "%pastebin.pl" OR DestinationHostname LIKE "%pastetext.net" OR DestinationHostname LIKE "%portmap.io" OR DestinationHostname LIKE "%privatlab.com" OR DestinationHostname LIKE "%privatlab.net" OR DestinationHostname LIKE "%send.exploit.in" OR DestinationHostname LIKE "%sendspace.com" OR DestinationHostname LIKE "%storage.googleapis.com" OR DestinationHostname LIKE "%storjshare.io" OR DestinationHostname LIKE "%supabase.co" OR DestinationHostname LIKE "%temp.sh" OR DestinationHostname LIKE "%transfer.sh" OR DestinationHostname LIKE "%trycloudflare.com" OR DestinationHostname LIKE "%ufile.io" OR DestinationHostname LIKE "%w3spaces.com" OR DestinationHostname LIKE "%workers.dev" OR DestinationHostname LIKE "%x0.at"))))
