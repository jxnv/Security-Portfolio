// Title: Enumeration for 3rd Party Creds From CLI
// ID: 87a476dc-0079-4583-a985-dee7a20a03de
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-20
// Tags: attack.credential-access, attack.t1552.002
// Description: Detects processes that query known 3rd party registry keys that holds credentials via commandline
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%\\Software\\Aerofox\\Foxmail\\V3.1%" OR process.command_line LIKE "%\\Software\\Aerofox\\FoxmailPreview%" OR process.command_line LIKE "%\\Software\\DownloadManager\\Passwords%" OR process.command_line LIKE "%\\Software\\FTPWare\\COREFTP\\Sites%" OR process.command_line LIKE "%\\Software\\IncrediMail\\Identities%" OR process.command_line LIKE "%\\Software\\Martin Prikryl\\WinSCP 2\\Sessions%" OR process.command_line LIKE "%\\Software\\Mobatek\\MobaXterm\\%" OR process.command_line LIKE "%\\Software\\OpenSSH\\Agent\\Keys%" OR process.command_line LIKE "%\\Software\\OpenVPN-GUI\\configs%" OR process.command_line LIKE "%\\Software\\ORL\\WinVNC3\\Password%" OR process.command_line LIKE "%\\Software\\Qualcomm\\Eudora\\CommandLine%" OR process.command_line LIKE "%\\Software\\RealVNC\\WinVNC4%" OR process.command_line LIKE "%\\Software\\RimArts\\B2\\Settings%" OR process.command_line LIKE "%\\Software\\SimonTatham\\PuTTY\\Sessions%" OR process.command_line LIKE "%\\Software\\SimonTatham\\PuTTY\\SshHostKeys\\%" OR process.command_line LIKE "%\\Software\\Sota\\FFFTP%" OR process.command_line LIKE "%\\Software\\TightVNC\\Server%" OR process.command_line LIKE "%\\Software\\WOW6432Node\\Radmin\\v3.0\\Server\\Parameters\\Radmin%")) AND NOT ((process.executable LIKE "%reg.exe" AND (process.command_line LIKE "%export%" OR process.command_line LIKE "%save%"))))
