// Title: AD Privileged Users or Groups Reconnaissance
// ID: 35ba1d85-724d-42a3-889f-2e2362bcaf23
// Status: test
// Level: high
// Author: Samir Bousseaden
// Date: 2019-04-03
// Tags: attack.discovery, attack.t1087.002
// Description: Detect priv users or groups recon based on 4661 eventid and known privileged users or groups SIDs
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((winlog.event_id == 4661 AND (ObjectType == "SAM_USER" OR ObjectType == "SAM_GROUP")) AND (((ObjectName LIKE "%-512" OR ObjectName LIKE "%-502" OR ObjectName LIKE "%-500" OR ObjectName LIKE "%-505" OR ObjectName LIKE "%-519" OR ObjectName LIKE "%-520" OR ObjectName LIKE "%-544" OR ObjectName LIKE "%-551" OR ObjectName LIKE "%-555")) OR (ObjectName LIKE "%admin%")) AND NOT ((SubjectUserName LIKE "%$")))
