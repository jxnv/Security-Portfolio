// Title: Registry Export of Third-Party Credentials
// ID: cc1abf27-78a3-4ac5-a51c-f3070b1d8e40
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-05-22
// Tags: attack.credential-access, attack.t1552.002
// Description: Detects the use of reg.exe to export registry paths associated with third-party credentials.
// Credential stealers have been known to use this technique to extract sensitive information from the registry.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%\\Software\\Aerofox\\Foxmail\\V3.1%" OR process.command_line LIKE "%\\Software\\Aerofox\\FoxmailPreview%" OR process.command_line LIKE "%\\Software\\DownloadManager\\Passwords%" OR process.command_line LIKE "%\\Software\\FTPWare\\COREFTP\\Sites%" OR process.command_line LIKE "%\\Software\\IncrediMail\\Identities%" OR process.command_line LIKE "%\\Software\\Martin Prikryl\\WinSCP 2\\Sessions%" OR process.command_line LIKE "%\\Software\\Mobatek\\MobaXterm%" OR process.command_line LIKE "%\\Software\\OpenSSH\\Agent\\Keys%" OR process.command_line LIKE "%\\Software\\OpenVPN-GUI\\configs%" OR process.command_line LIKE "%\\Software\\ORL\\WinVNC3\\Password%" OR process.command_line LIKE "%\\Software\\Qualcomm\\Eudora\\CommandLine%" OR process.command_line LIKE "%\\Software\\RealVNC\\WinVNC4%" OR process.command_line LIKE "%\\Software\\RimArts\\B2\\Settings%" OR process.command_line LIKE "%\\Software\\SimonTatham\\PuTTY\\Sessions%" OR process.command_line LIKE "%\\Software\\SimonTatham\\PuTTY\\SshHostKeys%" OR process.command_line LIKE "%\\Software\\Sota\\FFFTP%" OR process.command_line LIKE "%\\Software\\TightVNC\\Server%" OR process.command_line LIKE "%\\Software\\WOW6432Node\\Radmin\\v3.0\\Server\\Parameters\\Radmin%")) AND ((process.command_line LIKE "%save%" OR process.command_line LIKE "%export%")) AND ((process.executable LIKE "%\\reg.exe") OR (process.pe.original_file_name == "reg.exe")))
