// Title: Webshell Hacking Activity Patterns
// ID: 4ebc877f-4612-45cb-b3a5-8e3834db36c9
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-17
// Tags: attack.persistence, attack.discovery, attack.t1505.003, attack.t1018, attack.t1033, attack.t1087
// Description: Detects certain parent child patterns found in cases in which a web shell is used to perform certain credential dumping or exfiltration activities on a compromised system
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.parent.executable LIKE "%\\java.exe" OR process.parent.executable LIKE "%\\javaw.exe") AND (process.parent.executable LIKE "%-tomcat-%" OR process.parent.executable LIKE "%\\tomcat%")) OR ((process.parent.executable LIKE "%\\java.exe" OR process.parent.executable LIKE "%\\javaw.exe") AND (process.command_line LIKE "%catalina.jar%" OR process.command_line LIKE "%CATALINA_HOME%")) OR ((process.parent.executable LIKE "%\\caddy.exe" OR process.parent.executable LIKE "%\\httpd.exe" OR process.parent.executable LIKE "%\\nginx.exe" OR process.parent.executable LIKE "%\\php-cgi.exe" OR process.parent.executable LIKE "%\\w3wp.exe" OR process.parent.executable LIKE "%\\ws_tomcatservice.exe"))) AND (((process.command_line LIKE "%rundll32%" AND process.command_line LIKE "%comsvcs%")) OR ((process.command_line LIKE "% -hp%" AND process.command_line LIKE "% a %" AND process.command_line LIKE "% -m%")) OR ((process.command_line LIKE "%net%" AND process.command_line LIKE "% user %" AND process.command_line LIKE "% /add%")) OR ((process.command_line LIKE "%net%" AND process.command_line LIKE "% localgroup %" AND process.command_line LIKE "% administrators %" AND process.command_line LIKE "%/add%")) OR ((process.executable LIKE "%\\ntdsutil.exe" OR process.executable LIKE "%\\ldifde.exe" OR process.executable LIKE "%\\adfind.exe" OR process.executable LIKE "%\\procdump.exe" OR process.executable LIKE "%\\Nanodump.exe" OR process.executable LIKE "%\\vssadmin.exe" OR process.executable LIKE "%\\fsutil.exe")) OR ((process.command_line LIKE "% -decode %" OR process.command_line LIKE "% -NoP %" OR process.command_line LIKE "% -W Hidden %" OR process.command_line LIKE "% /decode %" OR process.command_line LIKE "% /ticket:%" OR process.command_line LIKE "% sekurlsa%" OR process.command_line LIKE "%.dmp full%" OR process.command_line LIKE "%.downloadfile(%" OR process.command_line LIKE "%.downloadstring(%" OR process.command_line LIKE "%FromBase64String%" OR process.command_line LIKE "%process call create%" OR process.command_line LIKE "%reg save %" OR process.command_line LIKE "%whoami /priv%"))))
