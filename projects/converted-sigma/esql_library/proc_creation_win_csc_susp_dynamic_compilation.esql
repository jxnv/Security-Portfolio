// Title: Dynamic .NET Compilation Via Csc.EXE
// ID: dcaa3f04-70c3-427a-80b4-b870d73c94c4
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2019-08-24
// Tags: attack.stealth, attack.t1027.004
// Description: Detects execution of "csc.exe" to compile .NET code. Attackers often leverage this to compile code on the fly and use it in other stages.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%\\csc.exe") AND (((process.command_line LIKE "%:\\Perflogs\\%" OR process.command_line LIKE "%:\\Users\\Public\\%" OR process.command_line LIKE "%\\AppData\\Local\\Temp\\%" OR process.command_line LIKE "%\\Temporary Internet%" OR process.command_line LIKE "%\\Windows\\Temp\\%")) OR (((process.command_line LIKE "%:\\Users\\%" AND process.command_line LIKE "%\\Favorites\\%")) OR ((process.command_line LIKE "%:\\Users\\%" AND process.command_line LIKE "%\\Favourites\\%")) OR ((process.command_line LIKE "%:\\Users\\%" AND process.command_line LIKE "%\\Contacts\\%")) OR ((process.command_line LIKE "%:\\Users\\%" AND process.command_line LIKE "%\\Pictures\\%"))) OR (process.command_line RLIKE "(?:[Pp]rogram[Dd]ata|%(?:[Ll]ocal)?[Aa]pp[Dd]ata%|\\\\[Aa]pp[Dd]ata\\\\(?:[Ll]ocal(?:[Ll]ow)?|[Rr]oaming))\\\\[^\\\\]{1,256}$")) AND NOT ((((process.parent.executable LIKE "C:\\Program Files (x86)\\%" OR process.parent.executable LIKE "C:\\Program Files\\%")) OR (process.parent.executable == "C:\\Windows\\System32\\sdiagnhost.exe") OR (process.parent.executable == "C:\\Windows\\System32\\inetsrv\\w3wp.exe"))) AND NOT ((((process.parent.command_line LIKE "%JwB7ACIAZgBhAGkAbABlAGQAIgA6AHQAcgB1AGUALAAiAG0AcwBnACIAOgAiAEEAbgBzAGkAYgBsAGUAIAByAGUAcQB1AGkAcgBlAHMAIABQAG8AdwBlAHIAUwBoAGUAbABsACAAdgAzAC4AMAAgAG8AcgAgAG4AZQB3AGUAcgAiAH0AJw%" OR process.parent.command_line LIKE "%cAewAiAGYAYQBpAGwAZQBkACIAOgB0AHIAdQBlACwAIgBtAHMAZwAiADoAIgBBAG4AcwBpAGIAbABlACAAcgBlAHEAdQBpAHIAZQBzACAAUABvAHcAZQByAFMAaABlAGwAbAAgAHYAMwAuADAAIABvAHIAIABuAGUAdwBlAHIAIgB9ACcA%" OR process.parent.command_line LIKE "%nAHsAIgBmAGEAaQBsAGUAZAAiADoAdAByAHUAZQAsACIAbQBzAGcAIgA6ACIAQQBuAHMAaQBiAGwAZQAgAHIAZQBxAHUAaQByAGUAcwAgAFAAbwB3AGUAcgBTAGgAZQBsAGwAIAB2ADMALgAwACAAbwByACAAbgBlAHcAZQByACIAfQAnA%")) OR ((process.parent.executable == "C:\\ProgramData\\chocolatey\\choco.exe" OR process.parent.executable == "C:\\ProgramData\\chocolatey\\tools\\shimgen.exe")) OR (process.parent.command_line LIKE "%\\ProgramData\\Microsoft\\Windows Defender Advanced Threat Protection%"))))
