// Title: Suspicious GUP Usage
// ID: 0a4f6091-223b-41f6-8743-f322ec84930b
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2019-02-06
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects execution of the Notepad++ updater in a suspicious directory, which is often used in DLL side-loading attacks
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%\\GUP.exe") AND NOT ((((process.executable LIKE "%\\Program Files\\Notepad++\\updater\\GUP.exe" OR process.executable LIKE "%\\Program Files (x86)\\Notepad++\\updater\\GUP.exe")) OR (process.executable LIKE "%\\Users\\%" AND (process.executable LIKE "%\\AppData\\Local\\Notepad++\\updater\\GUP.exe" OR process.executable LIKE "%\\AppData\\Roaming\\Notepad++\\updater\\GUP.exe")))))
