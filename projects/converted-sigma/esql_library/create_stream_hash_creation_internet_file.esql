// Title: Creation Of a Suspicious ADS File Outside a Browser Download
// ID: 573df571-a223-43bc-846e-3f98da481eca
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-10-22
// Tags: attack.stealth
// Description: Detects the creation of a suspicious ADS (Alternate Data Stream) file by software other than browsers
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((Contents LIKE "[ZoneTransfer]  ZoneId=3%" AND file.path LIKE "%:Zone.Identifier" AND (file.path LIKE "%.exe%" OR file.path LIKE "%.scr%" OR file.path LIKE "%.bat%" OR file.path LIKE "%.cmd%" OR file.path LIKE "%.docx%" OR file.path LIKE "%.hta%" OR file.path LIKE "%.jse%" OR file.path LIKE "%.lnk%" OR file.path LIKE "%.pptx%" OR file.path LIKE "%.ps%" OR file.path LIKE "%.reg%" OR file.path LIKE "%.sct%" OR file.path LIKE "%.vb%" OR file.path LIKE "%.wsc%" OR file.path LIKE "%.wsf%" OR file.path LIKE "%.xlsx%")) AND NOT (((process.executable LIKE "%\\brave.exe") OR ((process.executable == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR process.executable == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((process.executable LIKE "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\%") OR (process.executable LIKE "%\\WindowsApps\\MicrosoftEdge.exe") OR ((process.executable == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR process.executable == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process.executable LIKE "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\%" OR process.executable LIKE "C:\\Program Files\\Microsoft\\EdgeCore\\%") AND (process.executable LIKE "%\\msedge.exe" OR process.executable LIKE "%\\msedgewebview2.exe")) OR ((process.executable == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR process.executable == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR ((process.executable == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR process.executable == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process.executable LIKE "%\\maxthon.exe") OR (process.executable LIKE "%\\opera.exe") OR (process.executable LIKE "%\\safari.exe") OR (process.executable LIKE "%\\seamonkey.exe") OR (process.executable LIKE "C:\\Program Files\\WindowsApps\\Microsoft.ScreenSketch_%" AND process.executable LIKE "%\\SnippingTool\\SnippingTool.exe" AND file.path LIKE "C:\\Users\\%" AND (file.path LIKE "%\\AppData\\Local\\Packages\\Microsoft.ScreenSketch_%" AND file.path LIKE "%\\TempState\\Screenshot %") AND file.path LIKE "%.png:Zone.Identifier") OR (process.executable LIKE "%\\vivaldi.exe") OR (process.executable LIKE "%\\whale.exe"))))
