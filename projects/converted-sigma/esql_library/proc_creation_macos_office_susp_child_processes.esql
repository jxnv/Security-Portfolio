// Title: Suspicious Microsoft Office Child Process - MacOS
// ID: 69483748-1525-4a6c-95ca-90dc8d431b68
// Status: test
// Level: high
// Author: Sohan G (D4rkCiph3r)
// Date: 2023-01-31
// Tags: attack.execution, attack.persistence, attack.t1059.002, attack.t1137.002, attack.t1204.002
// Description: Detects suspicious child processes spawning from microsoft office suite applications such as word or excel. This could indicates malicious macro execution
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.parent.executable LIKE "%Microsoft Word%" OR process.parent.executable LIKE "%Microsoft Excel%" OR process.parent.executable LIKE "%Microsoft PowerPoint%" OR process.parent.executable LIKE "%Microsoft OneNote%") AND (process.executable LIKE "%/bash" OR process.executable LIKE "%/curl" OR process.executable LIKE "%/dash" OR process.executable LIKE "%/fish" OR process.executable LIKE "%/osacompile" OR process.executable LIKE "%/osascript" OR process.executable LIKE "%/sh" OR process.executable LIKE "%/zsh" OR process.executable LIKE "%/python" OR process.executable LIKE "%/python3" OR process.executable LIKE "%/wget"))
