// Title: DNS Query To AzureWebsites.NET By Non-Browser Process
// ID: e043f529-8514-4205-8ab0-7f7d2927b400
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects a DNS query by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((QueryName LIKE "%azurewebsites.net") AND NOT ((((process.executable LIKE "C:\\Program Files (x86)\\Avant Browser\\%" OR process.executable LIKE "C:\\Program Files\\Avant Browser\\%") AND process.executable LIKE "%\\avant.exe") OR (process.executable LIKE "%\\brave.exe" AND process.executable LIKE "C:\\Program Files\\BraveSoftware\\%") OR ((process.executable == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR process.executable == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((process.executable LIKE "%\\MsMpEng.exe" OR process.executable LIKE "%\\MsSense.exe")) OR ((process.executable LIKE "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\%") OR (process.executable LIKE "%\\WindowsApps\\MicrosoftEdge.exe") OR ((process.executable == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR process.executable == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process.executable LIKE "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\%" OR process.executable LIKE "C:\\Program Files\\Microsoft\\EdgeCore\\%") AND (process.executable LIKE "%\\msedge.exe" OR process.executable LIKE "%\\msedgewebview2.exe")) OR ((process.executable LIKE "C:\\Program Files\\Falkon\\%" OR process.executable LIKE "C:\\Program Files (x86)\\Falkon\\%") AND process.executable LIKE "%\\falkon.exe") OR ((process.executable == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR process.executable == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR (process.executable LIKE "%\\AppData\\Local\\Flock\\%" AND process.executable LIKE "%\\Flock.exe") OR ((process.executable == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR process.executable == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process.executable LIKE "%\\AppData\\Local\\Maxthon\\%" AND process.executable LIKE "%\\maxthon.exe") OR (process.executable LIKE "%\\AppData\\Local\\Programs\\midori-ng\\%" AND process.executable LIKE "%\\Midori Next Generation.exe") OR (process.executable LIKE "%\\AppData\\Local\\Programs\\Opera\\%" AND process.executable LIKE "%\\opera.exe") OR (process.executable LIKE "%\\AppData\\Local\\Phoebe\\%" AND process.executable LIKE "%\\Phoebe.exe") OR (process.executable LIKE "%\\safari.exe") OR ((process.executable LIKE "C:\\Program Files\\SeaMonkey\\%" OR process.executable LIKE "C:\\Program Files (x86)\\SeaMonkey\\%") AND process.executable LIKE "%\\seamonkey.exe") OR ((process.executable LIKE "C:\\Program Files\\SlimBrowser\\%" OR process.executable LIKE "C:\\Program Files (x86)\\SlimBrowser\\%") AND process.executable LIKE "%\\slimbrowser.exe") OR (process.executable LIKE "%\\Tor Browser\\%") OR (process.executable LIKE "%\\AppData\\Local\\Vivaldi\\%" AND process.executable LIKE "%\\vivaldi.exe") OR ((process.executable LIKE "C:\\Program Files\\Naver\\Naver Whale\\%" OR process.executable LIKE "C:\\Program Files (x86)\\Naver\\Naver Whale\\%") AND process.executable LIKE "%\\whale.exe") OR ((process.executable LIKE "C:\\Program Files\\Waterfox\\%" OR process.executable LIKE "C:\\Program Files (x86)\\Waterfox\\%") AND process.executable LIKE "%\\Waterfox.exe"))))
