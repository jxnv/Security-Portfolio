// Title: Obfuscated IP Via CLI
// ID: 56d19cb4-6414-4769-9644-1ed35ffbb148
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2022-08-03
// Tags: attack.discovery
// Description: Detects usage of an encoded/obfuscated version of an IP address (hex, octal, etc.) via command line
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%\\ping.exe" OR process.executable LIKE "%\\arp.exe")) AND (((process.command_line LIKE "% 0x%" OR process.command_line LIKE "%//0x%" OR process.command_line LIKE "%.0x%" OR process.command_line LIKE "%.00x%")) OR ((process.command_line LIKE "%http://%%" AND process.command_line LIKE "%%2e%")) OR ((process.command_line RLIKE "https?://[0-9]{1,3}\\.[0-9]{1,3}\\.0[0-9]{3,4}") OR (process.command_line RLIKE "https?://[0-9]{1,3}\\.0[0-9]{3,7}") OR (process.command_line RLIKE "https?://0[0-9]{3,11}") OR (process.command_line RLIKE "https?://(?:0[0-9]{1,11}\\.){3}0[0-9]{1,11}") OR (process.command_line RLIKE "https?://0[0-9]{1,11}") OR (process.command_line RLIKE " [0-7]{7,13}"))) AND NOT ((process.command_line RLIKE "https?://(?:(?:25[0-5]|(?:2[0-4]|1\\d|[1-9])?\\d)(?:\\.|\\b)){4}")))
