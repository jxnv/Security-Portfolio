// Title: Execute Code with Pester.bat
// ID: 59e938ff-0d6d-4dc3-b13f-36cc28734d4e
// Status: test
// Level: medium
// Author: Julia Fomina, oscd.community
// Date: 2020-10-08
// Tags: attack.execution, attack.stealth, attack.t1059.001, attack.t1216
// Description: Detects code execution via Pester.bat (Pester - Powershell Modulte for testing)
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe") AND (process.command_line LIKE "%Pester%" AND process.command_line LIKE "%Get-Help%")) OR ((process.executable LIKE "%\\cmd.exe" AND (process.command_line LIKE "%pester%" AND process.command_line LIKE "%;%")) AND ((process.command_line LIKE "%help%" OR process.command_line LIKE "%\\?%"))))
