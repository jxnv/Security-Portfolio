// Title: Invoke-Obfuscation Via Stdin - System
// ID: 487c7524-f892-4054-b263-8a0ace63fc25
// Status: test
// Level: high
// Author: Nikita Nazarov, oscd.community
// Date: 2020-10-12
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via Stdin in Scripts
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (winlog.provider_name == "Service Control Manager" AND winlog.event_id == 7045 AND (ImagePath LIKE "%set%" AND ImagePath LIKE "%&&%") AND (ImagePath LIKE "%environment%" OR ImagePath LIKE "%invoke%" OR ImagePath LIKE "%input%"))
