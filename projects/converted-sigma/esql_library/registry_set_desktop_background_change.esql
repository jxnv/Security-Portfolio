// Title: Potentially Suspicious Desktop Background Change Via Registry
// ID: 85b88e05-dadc-430b-8a9e-53ff1cd30aae
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Stephen Lincoln @slincoln-aiq (AttackIQ)
// Date: 2023-12-21
// Tags: attack.persistence, attack.impact, attack.defense-impairment, attack.t1112, attack.t1491.001
// Description: Detects registry value settings that would replace the user's desktop background.
// This is a common technique used by malware to change the desktop background to a ransom note or other image.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((registry.path LIKE "%Control Panel\\Desktop%" OR registry.path LIKE "%CurrentVersion\\Policies\\ActiveDesktop%" OR registry.path LIKE "%CurrentVersion\\Policies\\System%")) AND ((registry.path LIKE "%NoChangingWallpaper" AND registry.data.strings == "DWORD (0x00000001)") OR (registry.path LIKE "%\\Wallpaper") OR (registry.path LIKE "%\\WallpaperStyle" AND registry.data.strings == "2")) AND NOT (((registry.path LIKE "%\\Control Panel\\Desktop\\Wallpaper" AND registry.data.strings == "(Empty)") OR (process.executable LIKE "%C:\\Windows\\Explorer.EXE") OR (process.executable LIKE "%\\svchost.exe"))) AND NOT (((process.executable == "C:\\Program Files\\Amazon\\EC2Launch\\EC2Launch.exe" OR process.executable == "C:\\Program Files (x86)\\Amazon\\EC2Launch\\EC2Launch.exe") AND registry.path LIKE "%\\Control Panel\\Desktop\\Wallpaper")))
