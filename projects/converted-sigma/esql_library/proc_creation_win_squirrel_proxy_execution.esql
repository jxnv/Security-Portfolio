// Title: Process Proxy Execution Via Squirrel.EXE
// ID: 45239e6a-b035-4aaf-b339-8ad379fcb67e
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Karneades / Markus Neis, Jonhnathan Ribeiro, oscd.community
// Date: 2022-06-09
// Tags: attack.execution, attack.stealth, attack.t1218
// Description: Detects the usage of the "Squirrel.exe" binary to execute arbitrary processes. This binary is part of multiple Electron based software installations (Slack, Teams, Discord, etc.)
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.command_line LIKE "%--processStart%" OR process.command_line LIKE "%--processStartAndWait%" OR process.command_line LIKE "%--createShortcut%")) AND ((process.executable LIKE "%\\squirrel.exe" OR process.executable LIKE "%\\update.exe"))) AND NOT ((((process.command_line LIKE "%:\\Users\\%" AND process.command_line LIKE "%\\AppData\\Local\\Discord\\Update.exe%" AND process.command_line LIKE "%Discord.exe%") AND (process.command_line LIKE "%--createShortcut%" OR process.command_line LIKE "%--processStart%")) OR ((process.command_line LIKE "%:\\Users\\%" AND process.command_line LIKE "%\\AppData\\Local\\GitHubDesktop\\Update.exe%" AND process.command_line LIKE "%GitHubDesktop.exe%") AND (process.command_line LIKE "%--createShortcut%" OR process.command_line LIKE "%--processStartAndWait%")) OR ((process.command_line LIKE "%:\\Users\\%" AND process.command_line LIKE "%\\AppData\\Local\\Microsoft\\Teams\\Update.exe%" AND process.command_line LIKE "%Teams.exe%") AND (process.command_line LIKE "%--processStart%" OR process.command_line LIKE "%--createShortcut%")) OR ((process.command_line LIKE "%:\\Users\\%" AND process.command_line LIKE "%\\AppData\\Local\\yammerdesktop\\Update.exe%" AND process.command_line LIKE "%Yammer.exe%") AND (process.command_line LIKE "%--processStart%" OR process.command_line LIKE "%--createShortcut%")))))
