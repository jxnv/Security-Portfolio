// Title: Suspicious Double Extension File Execution
// ID: 1cdd9a09-06c9-4769-99ff-626e2b3991b8
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems), @blu3_team (idea), Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-06-26
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects suspicious use of an .exe extension after a non-executable file extension like .pdf.exe, a set of spaces or underlines to cloak the executable file in spear phishing campaigns
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%      .exe" OR process.executable LIKE "%______.exe" OR process.executable LIKE "%.doc.exe" OR process.executable LIKE "%.doc.js" OR process.executable LIKE "%.docx.exe" OR process.executable LIKE "%.docx.js" OR process.executable LIKE "%.gif.exe" OR process.executable LIKE "%.jpeg.exe" OR process.executable LIKE "%.jpg.exe" OR process.executable LIKE "%.mkv.exe" OR process.executable LIKE "%.mov.exe" OR process.executable LIKE "%.mp3.exe" OR process.executable LIKE "%.mp4.exe" OR process.executable LIKE "%.pdf.exe" OR process.executable LIKE "%.pdf.js" OR process.executable LIKE "%.png.exe" OR process.executable LIKE "%.ppt.exe" OR process.executable LIKE "%.ppt.js" OR process.executable LIKE "%.pptx.exe" OR process.executable LIKE "%.pptx.js" OR process.executable LIKE "%.rtf.exe" OR process.executable LIKE "%.rtf.js" OR process.executable LIKE "%.svg.exe" OR process.executable LIKE "%.txt.exe" OR process.executable LIKE "%.txt.js" OR process.executable LIKE "%.xls.exe" OR process.executable LIKE "%.xls.js" OR process.executable LIKE "%.xlsx.exe" OR process.executable LIKE "%.xlsx.js" OR process.executable LIKE "%⠀⠀⠀⠀⠀⠀.exe") AND (process.command_line LIKE "%      .exe%" OR process.command_line LIKE "%______.exe%" OR process.command_line LIKE "%.doc.exe%" OR process.command_line LIKE "%.doc.js%" OR process.command_line LIKE "%.docx.exe%" OR process.command_line LIKE "%.docx.js%" OR process.command_line LIKE "%.gif.exe%" OR process.command_line LIKE "%.jpeg.exe%" OR process.command_line LIKE "%.jpg.exe%" OR process.command_line LIKE "%.mkv.exe%" OR process.command_line LIKE "%.mov.exe%" OR process.command_line LIKE "%.mp3.exe%" OR process.command_line LIKE "%.mp4.exe%" OR process.command_line LIKE "%.pdf.exe%" OR process.command_line LIKE "%.pdf.js%" OR process.command_line LIKE "%.png.exe%" OR process.command_line LIKE "%.ppt.exe%" OR process.command_line LIKE "%.ppt.js%" OR process.command_line LIKE "%.pptx.exe%" OR process.command_line LIKE "%.pptx.js%" OR process.command_line LIKE "%.rtf.exe%" OR process.command_line LIKE "%.rtf.js%" OR process.command_line LIKE "%.svg.exe%" OR process.command_line LIKE "%.txt.exe%" OR process.command_line LIKE "%.txt.js%" OR process.command_line LIKE "%.xls.exe%" OR process.command_line LIKE "%.xls.js%" OR process.command_line LIKE "%.xlsx.exe%" OR process.command_line LIKE "%.xlsx.js%" OR process.command_line LIKE "%⠀⠀⠀⠀⠀⠀.exe%"))
