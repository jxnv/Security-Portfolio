// Title: Suspicious WSMAN Provider Image Loads
// ID: ad1f4bb9-8dfb-4765-adb6-2a7cfb6c0f94
// Status: test
// Level: medium
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2020-06-24
// Tags: attack.execution, attack.t1059.001, attack.lateral-movement, attack.t1021.003
// Description: Detects signs of potential use of the WSMAN provider from uncommon processes locally and remote execution.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((((ImageLoaded LIKE "%\\WsmSvc.dll" OR ImageLoaded LIKE "%\\WsmAuto.dll" OR ImageLoaded LIKE "%\\Microsoft.WSMan.Management.ni.dll")) OR ((process.pe.original_file_name == "WsmSvc.dll" OR process.pe.original_file_name == "WSMANAUTOMATION.DLL" OR process.pe.original_file_name == "Microsoft.WSMan.Management.dll"))) OR (process.executable LIKE "%\\svchost.exe" AND process.pe.original_file_name == "WsmWmiPl.dll")) AND NOT (((process.executable LIKE "C:\\Program Files\\Citrix\\%") OR ((process.executable == "C:\\Program Files (x86)\\PowerShell\\6\\pwsh.exe" OR process.executable == "C:\\Program Files (x86)\\PowerShell\\7\\pwsh.exe" OR process.executable == "C:\\Program Files\\PowerShell\\6\\pwsh.exe" OR process.executable == "C:\\Program Files\\PowerShell\\7\\pwsh.exe" OR process.executable == "C:\\Windows\\System32\\sdiagnhost.exe" OR process.executable == "C:\\Windows\\System32\\services.exe" OR process.executable == "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" OR process.executable == "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe")) OR (process.executable LIKE "C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_%" AND process.executable LIKE "%\\GetHelp.exe") OR (process.executable LIKE "%\\mmc.exe") OR ((process.executable LIKE "C:\\Windows\\Microsoft.NET\\Framework64\\v%" OR process.executable LIKE "C:\\Windows\\Microsoft.NET\\Framework\\v%" OR process.executable LIKE "C:\\Windows\\Microsoft.NET\\FrameworkArm\\v%" OR process.executable LIKE "C:\\Windows\\Microsoft.NET\\FrameworkArm64\\v%") AND process.executable LIKE "%\\mscorsvw.exe") OR (process.executable LIKE "C:\\Windows\\Temp\\asgard2-agent\\%") OR ((process.command_line LIKE "%svchost.exe -k netsvcs -p -s BITS%" OR process.command_line LIKE "%svchost.exe -k GraphicsPerfSvcGroup -s GraphicsPerfSvc%" OR process.command_line LIKE "%svchost.exe -k NetworkService -p -s Wecsvc%" OR process.command_line LIKE "%svchost.exe -k netsvcs%")) OR ((process.executable == "C:\\Windows\\System32\\Configure-SMRemoting.exe" OR process.executable == "C:\\Windows\\System32\\ServerManager.exe")) OR (process.executable LIKE "C:\\$WINDOWS.~BT\\Sources\\%"))) AND NOT (((process.executable LIKE "%\\svchost.exe") AND (process.command_line IS NULL))))
