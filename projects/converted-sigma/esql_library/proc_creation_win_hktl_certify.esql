// Title: HackTool - Certify Execution
// ID: 762f2482-ff21-4970-8939-0aa317a886bb
// Status: test
// Level: high
// Author: pH-T (Nextron Systems)
// Date: 2023-04-17
// Tags: attack.discovery, attack.credential-access, attack.t1649
// Description: Detects Certify a tool for Active Directory certificate abuse based on PE metadata characteristics and common command line arguments.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%\\Certify.exe") OR (process.pe.original_file_name == "Certify.exe") OR (Description LIKE "%Certify%")) OR (((process.command_line LIKE "%.exe cas %" OR process.command_line LIKE "%.exe find %" OR process.command_line LIKE "%.exe pkiobjects %" OR process.command_line LIKE "%.exe request %" OR process.command_line LIKE "%.exe download %")) AND ((process.command_line LIKE "% /vulnerable%" OR process.command_line LIKE "% /template:%" OR process.command_line LIKE "% /altname:%" OR process.command_line LIKE "% /domain:%" OR process.command_line LIKE "% /path:%" OR process.command_line LIKE "% /ca:%"))))
