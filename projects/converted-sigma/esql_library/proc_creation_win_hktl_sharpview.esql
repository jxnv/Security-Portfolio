et%" OR process.command_line LIKE "%Get-DomainSubnet%" OR process.command_line LIKE "%Get-DomainTrust%" OR process.command_line LIKE "%Get-DomainUserEvent%" OR process.command_line LIKE "%Get-ForestDomain%" OR process.command_line LIKE "%Get-ForestGlobalCatalog%" OR process.command_line LIKE "%Get-ForestTrust%" OR process.command_line LIKE "%Get-GptTmpl%" OR process.command_line LIKE "%Get-GroupsXML%" OR process.command_line LIKE "%Get-LastLoggedOn%" OR process.command_line LIKE "%Get-LoggedOnLocal%" OR process.command_line LIKE "%Get-NetComputer%" OR process.command_line LIKE "%Get-NetDomain%" OR process.command_line LIKE "%Get-NetFileServer%" OR process.command_line LIKE "%Get-NetForest%" OR process.command_line LIKE "%Get-NetGPO%" OR process.command_line LIKE "%Get-NetGroupMember%" OR process.command_line LIKE "%Get-NetLocalGroup%" OR process.command_line LIKE "%Get-NetLoggedon%" OR process.command_line LIKE "%Get-NetOU%" OR process.command_line LIKE "%Get-NetProcess%" OR process.command_line LIKE "%Get-NetRDPSession%" OR process.command_line LIKE "%Get-NetSession%" OR process.command_line LIKE "%Get-NetShare%" OR process.command_line LIKE "%Get-NetSite%" OR process.command_line LIKE "%Get-NetSubnet%" OR process.command_line LIKE "%Get-NetUser%" OR process.command_line LIKE "%Get-PathAcl%" OR process.command_line LIKE "%Get-PrincipalContext%" OR process.command_line LIKE "%Get-RegistryMountedDrive%" OR process.command_line LIKE "%Get-RegLoggedOn%" OR process.command_line LIKE "%Get-WMIRegCachedRDPConnection%" OR process.command_line LIKE "%Get-WMIRegLastLoggedOn%" OR process.command_line LIKE "%Get-WMIRegMountedDrive%" OR process.command_line LIKE "%Get-WMIRegProxy%" OR process.command_line LIKE "%Invoke-ACLScanner%" OR process.command_line LIKE "%Invoke-CheckLocalAdminAccess%" OR process.command_line LIKE "%Invoke-Kerberoast%" OR process.command_line LIKE "%Invoke-MapDomainTrust%" OR process.command_line LIKE "%Invoke-RevertToSelf%" OR process.command_line LIKE "%Invoke-Sharefinder%" OR process.command_line LIKE "%Invoke-UserImpersonation%" OR process.command_line LIKE "%Remove-DomainObjectAcl%" OR process.command_line LIKE "%Remove-RemoteConnection%" OR process.command_line LIKE "%Request-SPNTicket%" OR process.command_line LIKE "%Set-DomainObject%" OR process.command_line LIKE "%Test-AdminAccess%")))
