// Title: Potentially Suspicious WDAC Policy File Creation
// ID: 1d2de8a6-4803-4fde-b85b-f58f3aa7a705
// Status: experimental
// Level: medium
// Author: X__Junior
// Date: 2025-02-07
// Tags: attack.defense-impairment
// Description: Detects suspicious Windows Defender Application Control (WDAC) policy file creation from abnormal processes that could be abused by attacker to block EDR/AV components while allowing their own malicious code to run on the system.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((file.path LIKE "%\\Windows\\System32\\CodeIntegrity\\%") AND NOT (((((process.command_line LIKE "%ConvertFrom-CIPolicy -XmlFilePath%" AND process.command_line LIKE "%-BinaryFilePath %")) OR (process.command_line LIKE "%CiTool --update-policy%") OR ((process.command_line LIKE "%Copy-Item -Path%" AND process.command_line LIKE "%-Destination%"))) OR ((process.executable LIKE "%\\Microsoft.ConfigurationManagement.exe" OR process.executable LIKE "%\\WDAC Wizard.exe" OR process.executable LIKE "%C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" OR process.executable LIKE "%C:\\Program Files\\PowerShell\\7\\pwsh.exe" OR process.executable LIKE "%C:\\Windows\\System32\\dllhost.exe" OR process.executable LIKE "%C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" OR process.executable LIKE "%C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" OR process.executable LIKE "%C:\\Windows\\SysWOW64\\dllhost.exe" OR process.executable LIKE "%C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" OR process.executable LIKE "%C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")) OR (process.executable == "System") OR (process.executable == "C:\\Windows\\System32\\wuauclt.exe") OR ((process.executable == "C:\\Windows\\UUS\\arm64\\wuaucltcore.exe" OR process.executable == "C:\\Windows\\UUS\\Packages\\Preview\\arm64\\wuaucltcore.exe")))))
