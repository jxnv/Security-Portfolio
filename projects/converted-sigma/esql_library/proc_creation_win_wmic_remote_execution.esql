// Title: WMIC Remote Command Execution
// ID: 7773b877-5abb-4a3e-b9c9-fd0369b59b00
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-14
// Tags: attack.execution, attack.t1047
// Description: Detects the execution of WMIC to query information on a remote system
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.command_line LIKE "%/node:%" OR process.command_line LIKE "%-node:%")) AND ((process.executable LIKE "%\\WMIC.exe") OR (process.pe.original_file_name == "wmic.exe"))) AND NOT (((process.command_line LIKE "%localhost%" OR process.command_line LIKE "%127.0.0.1%"))))
