// Title: Sensitive File Recovery From Backup Via Wbadmin.EXE
// ID: 84972c80-251c-4c3a-9079-4f00aad93938
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), frack113
// Date: 2024-05-10
// Tags: attack.credential-access, attack.t1003.003
// Description: Detects the dump of highly sensitive files such as "NTDS.DIT" and "SECURITY" hive.
// Attackers can leverage the "wbadmin" utility in order to dump sensitive files that might contain credential or sensitive information.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "% recovery%" AND process.command_line LIKE "%recoveryTarget%" AND process.command_line LIKE "%itemtype:File%") AND (process.command_line LIKE "%\\config\\SAM%" OR process.command_line LIKE "%\\config\\SECURITY%" OR process.command_line LIKE "%\\config\\SYSTEM%" OR process.command_line LIKE "%\\Windows\\NTDS\\NTDS.dit%")) AND ((process.executable LIKE "%\\wbadmin.exe") OR (process.pe.original_file_name == "WBADMIN.EXE")))
