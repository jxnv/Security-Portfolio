// Title: Malicious Base64 Encoded PowerShell Keywords in Command Lines
// ID: f26c6093-6f14-4b12-800f-0fcb46f5ffd0
// Status: test
// Level: high
// Author: John Lambert (rule)
// Date: 2019-01-16
// Tags: attack.execution, attack.t1059.001
// Description: Detects base64 encoded strings used in hidden malicious PowerShell command lines
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%AGkAdABzAGEAZABtAGkAbgAgAC8AdAByAGEAbgBzAGYAZQByA%" OR process.command_line LIKE "%aXRzYWRtaW4gL3RyYW5zZmVy%" OR process.command_line LIKE "%IAaQB0AHMAYQBkAG0AaQBuACAALwB0AHIAYQBuAHMAZgBlAHIA%" OR process.command_line LIKE "%JpdHNhZG1pbiAvdHJhbnNmZX%" OR process.command_line LIKE "%YgBpAHQAcwBhAGQAbQBpAG4AIAAvAHQAcgBhAG4AcwBmAGUAcg%" OR process.command_line LIKE "%Yml0c2FkbWluIC90cmFuc2Zlc%" OR process.command_line LIKE "%AGMAaAB1AG4AawBfAHMAaQB6AGUA%" OR process.command_line LIKE "%JABjAGgAdQBuAGsAXwBzAGkAegBlA%" OR process.command_line LIKE "%JGNodW5rX3Npem%" OR process.command_line LIKE "%QAYwBoAHUAbgBrAF8AcwBpAHoAZQ%" OR process.command_line LIKE "%RjaHVua19zaXpl%" OR process.command_line LIKE "%Y2h1bmtfc2l6Z%" OR process.command_line LIKE "%AE8ALgBDAG8AbQBwAHIAZQBzAHMAaQBvAG4A%" OR process.command_line LIKE "%kATwAuAEMAbwBtAHAAcgBlAHMAcwBpAG8Abg%" OR process.command_line LIKE "%lPLkNvbXByZXNzaW9u%" OR process.command_line LIKE "%SQBPAC4AQwBvAG0AcAByAGUAcwBzAGkAbwBuA%" OR process.command_line LIKE "%SU8uQ29tcHJlc3Npb2%" OR process.command_line LIKE "%Ty5Db21wcmVzc2lvb%" OR process.command_line LIKE "%AE8ALgBNAGUAbQBvAHIAeQBTAHQAcgBlAGEAbQ%" OR process.command_line LIKE "%kATwAuAE0AZQBtAG8AcgB5AFMAdAByAGUAYQBtA%" OR process.command_line LIKE "%lPLk1lbW9yeVN0cmVhb%" OR process.command_line LIKE "%SQBPAC4ATQBlAG0AbwByAHkAUwB0AHIAZQBhAG0A%" OR process.command_line LIKE "%SU8uTWVtb3J5U3RyZWFt%" OR process.command_line LIKE "%Ty5NZW1vcnlTdHJlYW%" OR process.command_line LIKE "%4ARwBlAHQAQwBoAHUAbgBrA%" OR process.command_line LIKE "%5HZXRDaHVua%" OR process.command_line LIKE "%AEcAZQB0AEMAaAB1AG4Aaw%" OR process.command_line LIKE "%LgBHAGUAdABDAGgAdQBuAGsA%" OR process.command_line LIKE "%LkdldENodW5r%" OR process.command_line LIKE "%R2V0Q2h1bm%" OR process.command_line LIKE "%AEgAUgBFAEEARABfAEkATgBGAE8ANgA0A%" OR process.command_line LIKE "%QASABSAEUAQQBEAF8ASQBOAEYATwA2ADQA%" OR process.command_line LIKE "%RIUkVBRF9JTkZPNj%" OR process.command_line LIKE "%SFJFQURfSU5GTzY0%" OR process.command_line LIKE "%VABIAFIARQBBAEQAXwBJAE4ARgBPADYANA%" OR process.command_line LIKE "%VEhSRUFEX0lORk82N%" OR process.command_line LIKE "%AHIAZQBhAHQAZQBSAGUAbQBvAHQAZQBUAGgAcgBlAGEAZA%" OR process.command_line LIKE "%cmVhdGVSZW1vdGVUaHJlYW%" OR process.command_line LIKE "%MAcgBlAGEAdABlAFIAZQBtAG8AdABlAFQAaAByAGUAYQBkA%" OR process.command_line LIKE "%NyZWF0ZVJlbW90ZVRocmVhZ%" OR process.command_line LIKE "%Q3JlYXRlUmVtb3RlVGhyZWFk%" OR process.command_line LIKE "%QwByAGUAYQB0AGUAUgBlAG0AbwB0AGUAVABoAHIAZQBhAGQA%" OR process.command_line LIKE "%0AZQBtAG0AbwB2AGUA%" OR process.command_line LIKE "%1lbW1vdm%" OR process.command_line LIKE "%AGUAbQBtAG8AdgBlA%" OR process.command_line LIKE "%bQBlAG0AbQBvAHYAZQ%" OR process.command_line LIKE "%bWVtbW92Z%" OR process.command_line LIKE "%ZW1tb3Zl%")) AND (process.command_line LIKE "% hidden %") AND (((process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe")) OR ((process.pe.original_file_name == "PowerShell.EXE" OR process.pe.original_file_name == "pwsh.dll"))))
