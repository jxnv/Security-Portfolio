// Title: Download from Suspicious Dyndns Hosts
// ID: 195c1119-ef07-4909-bb12-e66f5e07bf3c
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2017-11-08
// Tags: attack.command-and-control, attack.t1105, attack.t1568
// Description: Detects download of certain file types from hosts with dynamic DNS names (selected list)
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((c-uri-extension == "exe" OR c-uri-extension == "vbs" OR c-uri-extension == "bat" OR c-uri-extension == "rar" OR c-uri-extension == "ps1" OR c-uri-extension == "doc" OR c-uri-extension == "docm" OR c-uri-extension == "xls" OR c-uri-extension == "xlsm" OR c-uri-extension == "pptm" OR c-uri-extension == "rtf" OR c-uri-extension == "hta" OR c-uri-extension == "dll" OR c-uri-extension == "ws" OR c-uri-extension == "wsf" OR c-uri-extension == "sct" OR c-uri-extension == "zip") AND (cs-host LIKE "%.hopto.org" OR cs-host LIKE "%.no-ip.org" OR cs-host LIKE "%.no-ip.info" OR cs-host LIKE "%.no-ip.biz" OR cs-host LIKE "%.no-ip.com" OR cs-host LIKE "%.noip.com" OR cs-host LIKE "%.ddns.name" OR cs-host LIKE "%.myftp.org" OR cs-host LIKE "%.myftp.biz" OR cs-host LIKE "%.serveblog.net" OR cs-host LIKE "%.servebeer.com" OR cs-host LIKE "%.servemp3.com" OR cs-host LIKE "%.serveftp.com" OR cs-host LIKE "%.servequake.com" OR cs-host LIKE "%.servehalflife.com" OR cs-host LIKE "%.servehttp.com" OR cs-host LIKE "%.servegame.com" OR cs-host LIKE "%.servepics.com" OR cs-host LIKE "%.myvnc.com" OR cs-host LIKE "%.ignorelist.com" OR cs-host LIKE "%.jkub.com" OR cs-host LIKE "%.dlinkddns.com" OR cs-host LIKE "%.jumpingcrab.com" OR cs-host LIKE "%.ddns.info" OR cs-host LIKE "%.mooo.com" OR cs-host LIKE "%.dns-dns.com" OR cs-host LIKE "%.strangled.net" OR cs-host LIKE "%.adultdns.net" OR cs-host LIKE "%.craftx.biz" OR cs-host LIKE "%.ddns01.com" OR cs-host LIKE "%.dns53.biz" OR cs-host LIKE "%.dnsapi.info" OR cs-host LIKE "%.dnsd.info" OR cs-host LIKE "%.dnsdynamic.com" OR cs-host LIKE "%.dnsdynamic.net" OR cs-host LIKE "%.dnsget.org" OR cs-host LIKE "%.fe100.net" OR cs-host LIKE "%.flashserv.net" OR cs-host LIKE "%.ftp21.net" OR cs-host LIKE "%.http01.com" OR cs-host LIKE "%.http80.info" OR cs-host LIKE "%.https443.com" OR cs-host LIKE "%.imap01.com" OR cs-host LIKE "%.kadm5.com" OR cs-host LIKE "%.mysq1.net" OR cs-host LIKE "%.ns360.info" OR cs-host LIKE "%.ntdll.net" OR cs-host LIKE "%.ole32.com" OR cs-host LIKE "%.proxy8080.com" OR cs-host LIKE "%.sql01.com" OR cs-host LIKE "%.ssh01.com" OR cs-host LIKE "%.ssh22.net" OR cs-host LIKE "%.tempors.com" OR cs-host LIKE "%.tftpd.net" OR cs-host LIKE "%.ttl60.com" OR cs-host LIKE "%.ttl60.org" OR cs-host LIKE "%.user32.com" OR cs-host LIKE "%.voip01.com" OR cs-host LIKE "%.wow64.net" OR cs-host LIKE "%.x64.me" OR cs-host LIKE "%.xns01.com" OR cs-host LIKE "%.dyndns.org" OR cs-host LIKE "%.dyndns.info" OR cs-host LIKE "%.dyndns.tv" OR cs-host LIKE "%.dyndns-at-home.com" OR cs-host LIKE "%.dnsomatic.com" OR cs-host LIKE "%.zapto.org" OR cs-host LIKE "%.webhop.net" OR cs-host LIKE "%.25u.com" OR cs-host LIKE "%.slyip.net"))
