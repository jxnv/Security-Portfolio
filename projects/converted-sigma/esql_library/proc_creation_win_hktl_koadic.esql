// Title: HackTool - Koadic Execution
// ID: 5cddf373-ef00-4112-ad72-960ac29bac34
// Status: test
// Level: high
// Author: wagga, Jonhnathan Ribeiro, oscd.community
// Date: 2020-01-12
// Tags: attack.execution, attack.t1059.003, attack.t1059.005, attack.t1059.007
// Description: Detects command line parameters used by Koadic hack tool
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%/q%" AND process.command_line LIKE "%/c%" AND process.command_line LIKE "%chcp%")) AND ((process.executable LIKE "%\\cmd.exe") OR (process.pe.original_file_name == "Cmd.Exe")))
