// Title: Suspicious Modification Of Scheduled Tasks
// ID: 1c0e41cd-21bb-4433-9acc-4a2cd6367b9b
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-28
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects when an attacker tries to modify an already existing scheduled tasks to run from a suspicious location
// Attackers can create a simple looking task in order to avoid detection on creation as it's often the most focused on
// Instead they modify the task after creation to include their malicious payload
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%\\schtasks.exe" AND (process.command_line LIKE "% /Change %" AND process.command_line LIKE "% /TN %")) AND ((process.command_line LIKE "%regsvr32%" OR process.command_line LIKE "%rundll32%" OR process.command_line LIKE "%cmd /c %" OR process.command_line LIKE "%cmd /k %" OR process.command_line LIKE "%cmd /r %" OR process.command_line LIKE "%cmd.exe /c %" OR process.command_line LIKE "%cmd.exe /k %" OR process.command_line LIKE "%cmd.exe /r %" OR process.command_line LIKE "%powershell%" OR process.command_line LIKE "%mshta%" OR process.command_line LIKE "%wscript%" OR process.command_line LIKE "%cscript%" OR process.command_line LIKE "%certutil%" OR process.command_line LIKE "%bitsadmin%" OR process.command_line LIKE "%bash.exe%" OR process.command_line LIKE "%bash %" OR process.command_line LIKE "%scrcons%" OR process.command_line LIKE "%wmic %" OR process.command_line LIKE "%wmic.exe%" OR process.command_line LIKE "%forfiles%" OR process.command_line LIKE "%scriptrunner%" OR process.command_line LIKE "%hh.exe%" OR process.command_line LIKE "%hh %")) AND ((process.command_line LIKE "%\\AppData\\Local\\Temp%" OR process.command_line LIKE "%\\AppData\\Roaming\\%" OR process.command_line LIKE "%\\Users\\Public\\%" OR process.command_line LIKE "%\\WINDOWS\\Temp\\%" OR process.command_line LIKE "%\\Desktop\\%" OR process.command_line LIKE "%\\Downloads\\%" OR process.command_line LIKE "%\\Temporary Internet%" OR process.command_line LIKE "%C:\\ProgramData\\%" OR process.command_line LIKE "%C:\\Perflogs\\%" OR process.command_line LIKE "%%ProgramData%%" OR process.command_line LIKE "%%appdata%%" OR process.command_line LIKE "%%comspec%%" OR process.command_line LIKE "%%localappdata%%")))
