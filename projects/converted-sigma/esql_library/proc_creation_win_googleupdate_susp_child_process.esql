// Title: Potentially Suspicious GoogleUpdate Child Process
// ID: 84b1ecf9-6eff-4004-bafb-bae5c0e251b2
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-15
// Tags: attack.stealth
// Description: Detects potentially suspicious child processes of "GoogleUpdate.exe"
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.parent.executable LIKE "%\\GoogleUpdate.exe") AND NOT (((process.executable IS NULL) OR ((process.executable LIKE "%\\Google%") OR ((process.executable LIKE "%\\setup.exe" OR process.executable LIKE "%chrome_updater.exe" OR process.executable LIKE "%chrome_installer.exe"))))))
