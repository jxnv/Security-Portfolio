// Title: Potentially Suspicious Network Connection To Notion API
// ID: 7e9cf7b6-e827-11ed-a05b-15959c120003
// Status: test
// Level: low
// Author: Gavin Knapp
// Date: 2023-05-03
// Tags: attack.command-and-control, attack.t1102
// Description: Detects a non-browser process communicating with the Notion API. This could indicate potential use of a covert C2 channel such as "OffensiveNotion C2"
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((DestinationHostname LIKE "%api.notion.com%") AND NOT (((process.executable LIKE "%\\brave.exe") OR ((process.executable == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR process.executable == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((process.executable LIKE "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\%") OR (process.executable LIKE "%\\WindowsApps\\MicrosoftEdge.exe") OR ((process.executable == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR process.executable == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process.executable LIKE "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\%" OR process.executable LIKE "C:\\Program Files\\Microsoft\\EdgeCore\\%") AND (process.executable LIKE "%\\msedge.exe" OR process.executable LIKE "%\\msedgewebview2.exe")) OR ((process.executable == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR process.executable == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR ((process.executable == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR process.executable == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process.executable LIKE "%\\maxthon.exe") OR (process.executable LIKE "%\\AppData\\Local\\Programs\\Notion\\Notion.exe") OR (process.executable LIKE "%\\opera.exe") OR (process.executable LIKE "%\\safari.exe") OR (process.executable LIKE "%\\seamonkey.exe") OR (process.executable LIKE "%\\vivaldi.exe") OR (process.executable LIKE "%\\whale.exe"))))
