// Title: Remote Access Tool Services Have Been Installed - System
// ID: 1a31b18a-f00c-4061-9900-f735b96c99fc
// Status: test
// Level: medium
// Author: Connor Martin, Nasreddine Bencherchali
// Date: 2022-12-23
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1543.003, attack.t1569.002
// Description: Detects service installation of different remote access tools software. These software are often abused by threat actors to perform
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (winlog.provider_name == "Service Control Manager" AND (winlog.event_id == 7045 OR winlog.event_id == 7036) AND (ServiceName LIKE "%AmmyyAdmin%" OR ServiceName LIKE "%Atera%" OR ServiceName LIKE "%BASupportExpressSrvcUpdater%" OR ServiceName LIKE "%BASupportExpressStandaloneService%" OR ServiceName LIKE "%chromoting%" OR ServiceName LIKE "%GoToAssist%" OR ServiceName LIKE "%GoToMyPC%" OR ServiceName LIKE "%jumpcloud%" OR ServiceName LIKE "%LMIGuardianSvc%" OR ServiceName LIKE "%LogMeIn%" OR ServiceName LIKE "%monblanking%" OR ServiceName LIKE "%Parsec%" OR ServiceName LIKE "%RManService%" OR ServiceName LIKE "%RPCPerformanceService%" OR ServiceName LIKE "%RPCService%" OR ServiceName LIKE "%SplashtopRemoteService%" OR ServiceName LIKE "%SSUService%" OR ServiceName LIKE "%TeamViewer%" OR ServiceName LIKE "%TightVNC%" OR ServiceName LIKE "%vncserver%" OR ServiceName LIKE "%Zoho%"))
