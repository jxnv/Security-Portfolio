// Title: Suspicious Access to Sensitive File Extensions - Zeek
// ID: 286b47ed-f6fe-40b3-b3a8-35129acd43bc
// Status: test
// Level: medium
// Author: Samir Bousseaden, @neu5ron
// Date: 2020-04-02
// Tags: attack.collection
// Description: Detects known sensitive file extensions via Zeek
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((name LIKE "%.pst" OR name LIKE "%.ost" OR name LIKE "%.msg" OR name LIKE "%.nst" OR name LIKE "%.oab" OR name LIKE "%.edb" OR name LIKE "%.nsf" OR name LIKE "%.bak" OR name LIKE "%.dmp" OR name LIKE "%.kirbi" OR name LIKE "%.rdp"))
