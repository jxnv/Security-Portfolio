// Title: Office Macro File Creation From Suspicious Process
// ID: b1c50487-1967-4315-a026-6491686d860e
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-23
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects the creation of a office macro file from a a suspicious process
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.executable LIKE "%\\cscript.exe" OR process.executable LIKE "%\\mshta.exe" OR process.executable LIKE "%\\regsvr32.exe" OR process.executable LIKE "%\\rundll32.exe" OR process.executable LIKE "%\\wscript.exe")) OR ((process.parent.executable LIKE "%\\cscript.exe" OR process.parent.executable LIKE "%\\mshta.exe" OR process.parent.executable LIKE "%\\regsvr32.exe" OR process.parent.executable LIKE "%\\rundll32.exe" OR process.parent.executable LIKE "%\\wscript.exe"))) AND ((file.path LIKE "%.docm" OR file.path LIKE "%.dotm" OR file.path LIKE "%.xlsm" OR file.path LIKE "%.xltm" OR file.path LIKE "%.potm" OR file.path LIKE "%.pptm")))
