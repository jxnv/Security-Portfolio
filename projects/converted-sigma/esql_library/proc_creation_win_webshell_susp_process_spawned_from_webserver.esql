// Title: Suspicious Process By Web Server Process
// ID: 8202070f-edeb-4d31-a010-a26c72ac5600
// Status: test
// Level: high
// Author: Thomas Patzke, Florian Roth (Nextron Systems), Zach Stanford @svch0st, Tim Shelton, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-01-16
// Tags: attack.persistence, attack.initial-access, attack.t1505.003, attack.t1190
// Description: Detects potentially suspicious processes being spawned by a web server process which could be the result of a successfully placed web shell or exploitation
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.parent.executable LIKE "%\\java.exe" OR process.parent.executable LIKE "%\\javaw.exe") AND (process.parent.executable LIKE "%-tomcat-%" OR process.parent.executable LIKE "%\\tomcat%")) OR ((process.parent.executable LIKE "%\\java.exe" OR process.parent.executable LIKE "%\\javaw.exe") AND (process.parent.command_line LIKE "%CATALINA_HOME%" OR process.parent.command_line LIKE "%catalina.home%" OR process.parent.command_line LIKE "%catalina.jar%")) OR ((process.parent.executable LIKE "%\\caddy.exe" OR process.parent.executable LIKE "%\\httpd.exe" OR process.parent.executable LIKE "%\\nginx.exe" OR process.parent.executable LIKE "%\\php-cgi.exe" OR process.parent.executable LIKE "%\\php.exe" OR process.parent.executable LIKE "%\\tomcat.exe" OR process.parent.executable LIKE "%\\UMWorkerProcess.exe" OR process.parent.executable LIKE "%\\w3wp.exe" OR process.parent.executable LIKE "%\\ws_TomcatService.exe"))) AND ((process.executable LIKE "%\\arp.exe" OR process.executable LIKE "%\\at.exe" OR process.executable LIKE "%\\bash.exe" OR process.executable LIKE "%\\bitsadmin.exe" OR process.executable LIKE "%\\certutil.exe" OR process.executable LIKE "%\\cmd.exe" OR process.executable LIKE "%\\cscript.exe" OR process.executable LIKE "%\\dsget.exe" OR process.executable LIKE "%\\hostname.exe" OR process.executable LIKE "%\\nbtstat.exe" OR process.executable LIKE "%\\net.exe" OR process.executable LIKE "%\\net1.exe" OR process.executable LIKE "%\\netdom.exe" OR process.executable LIKE "%\\netsh.exe" OR process.executable LIKE "%\\nltest.exe" OR process.executable LIKE "%\\ntdsutil.exe" OR process.executable LIKE "%\\powershell_ise.exe" OR process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe" OR process.executable LIKE "%\\qprocess.exe" OR process.executable LIKE "%\\query.exe" OR process.executable LIKE "%\\qwinsta.exe" OR process.executable LIKE "%\\reg.exe" OR process.executable LIKE "%\\rundll32.exe" OR process.executable LIKE "%\\sc.exe" OR process.executable LIKE "%\\sh.exe" OR process.executable LIKE "%\\wmic.exe" OR process.executable LIKE "%\\wscript.exe" OR process.executable LIKE "%\\wusa.exe")) AND NOT (((process.parent.executable LIKE "%\\java.exe" AND process.command_line LIKE "%Windows\\system32\\cmd.exe /c C:\\ManageEngine\\ADManager \"Plus\\ES\\bin\\elasticsearch.bat -Enode.name=RMP-NODE1 -pelasticsearch-pid.txt") OR (process.parent.executable LIKE "%\\java.exe" AND (process.command_line LIKE "%sc query%" AND process.command_line LIKE "%ADManager Plus%")))))
