// Title: Windows Filtering Platform Blocked Connection From EDR Agent Binary
// ID: bacf58c6-e199-4040-a94f-95dea0f1e45a
// Status: test
// Level: high
// Author: @gott_cyber
// Date: 2024-01-08
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects a Windows Filtering Platform (WFP) blocked connection event involving common Endpoint Detection and Response (EDR) agents.
// Adversaries may use WFP filters to prevent Endpoint Detection and Response (EDR) agents from reporting security events.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (winlog.event_id == 5157 AND (Application LIKE "%\\AmSvc.exe" OR Application LIKE "%\\cb.exe" OR Application LIKE "%\\CETASvc.exe" OR Application LIKE "%\\CNTAoSMgr.exe" OR Application LIKE "%\\CrAmTray.exe" OR Application LIKE "%\\CrsSvc.exe" OR Application LIKE "%\\CSFalconContainer.exe" OR Application LIKE "%\\CSFalconService.exe" OR Application LIKE "%\\CybereasonAV.exe" OR Application LIKE "%\\CylanceSvc.exe" OR Application LIKE "%\\cyserver.exe" OR Application LIKE "%\\CyveraService.exe" OR Application LIKE "%\\CyvrFsFlt.exe" OR Application LIKE "%\\EIConnector.exe" OR Application LIKE "%\\elastic-agent.exe" OR Application LIKE "%\\elastic-endpoint.exe" OR Application LIKE "%\\EndpointBasecamp.exe" OR Application LIKE "%\\ExecutionPreventionSvc.exe" OR Application LIKE "%\\filebeat.exe" OR Application LIKE "%\\fortiedr.exe" OR Application LIKE "%\\hmpalert.exe" OR Application LIKE "%\\hurukai.exe" OR Application LIKE "%\\LogProcessorService.exe" OR Application LIKE "%\\mcsagent.exe" OR Application LIKE "%\\mcsclient.exe" OR Application LIKE "%\\MsMpEng.exe" OR Application LIKE "%\\MsSense.exe" OR Application LIKE "%\\Ntrtscan.exe" OR Application LIKE "%\\PccNTMon.exe" OR Application LIKE "%\\QualysAgent.exe" OR Application LIKE "%\\RepMgr.exe" OR Application LIKE "%\\RepUtils.exe" OR Application LIKE "%\\RepUx.exe" OR Application LIKE "%\\RepWAV.exe" OR Application LIKE "%\\RepWSC.exe" OR Application LIKE "%\\sedservice.exe" OR Application LIKE "%\\SenseCncProxy.exe" OR Application LIKE "%\\SenseIR.exe" OR Application LIKE "%\\SenseNdr.exe" OR Application LIKE "%\\SenseSampleUploader.exe" OR Application LIKE "%\\SentinelAgent.exe" OR Application LIKE "%\\SentinelAgentWorker.exe" OR Application LIKE "%\\SentinelBrowserNativeHost.exe" OR Application LIKE "%\\SentinelHelperService.exe" OR Application LIKE "%\\SentinelServiceHost.exe" OR Application LIKE "%\\SentinelStaticEngine.exe" OR Application LIKE "%\\SentinelStaticEngineScanner.exe" OR Application LIKE "%\\sfc.exe" OR Application LIKE "%\\sophos ui.exe" OR Application LIKE "%\\sophosfilescanner.exe" OR Application LIKE "%\\sophosfs.exe" OR Application LIKE "%\\sophoshealth.exe" OR Application LIKE "%\\sophosips.exe" OR Application LIKE "%\\sophosLivequeryservice.exe" OR Application LIKE "%\\sophosnetfilter.exe" OR Application LIKE "%\\sophosntpservice.exe" OR Application LIKE "%\\sophososquery.exe" OR Application LIKE "%\\sspservice.exe" OR Application LIKE "%\\TaniumClient.exe" OR Application LIKE "%\\TaniumCX.exe" OR Application LIKE "%\\TaniumDetectEngine.exe" OR Application LIKE "%\\TMBMSRV.exe" OR Application LIKE "%\\TmCCSF.exe" OR Application LIKE "%\\TmListen.exe" OR Application LIKE "%\\TmWSCSvc.exe" OR Application LIKE "%\\Traps.exe" OR Application LIKE "%\\winlogbeat.exe" OR Application LIKE "%\\WSCommunicator.exe" OR Application LIKE "%\\xagt.exe"))
