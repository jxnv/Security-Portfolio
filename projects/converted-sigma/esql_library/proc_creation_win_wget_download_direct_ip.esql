// Title: Suspicious File Download From IP Via Wget.EXE
// ID: 17f0c0a8-8bd5-4ee0-8c5f-a342c0199f35
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-07-27
// Tags: attack.execution
// Description: Detects potentially suspicious file downloads directly from IP addresses using Wget.exe
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%.ps1" OR process.command_line LIKE "%.ps1'" OR process.command_line LIKE "%.ps1\"" OR process.command_line LIKE "%.dat" OR process.command_line LIKE "%.dat'" OR process.command_line LIKE "%.dat\"" OR process.command_line LIKE "%.msi" OR process.command_line LIKE "%.msi'" OR process.command_line LIKE "%.msi\"" OR process.command_line LIKE "%.bat" OR process.command_line LIKE "%.bat'" OR process.command_line LIKE "%.bat\"" OR process.command_line LIKE "%.exe" OR process.command_line LIKE "%.exe'" OR process.command_line LIKE "%.exe\"" OR process.command_line LIKE "%.vbs" OR process.command_line LIKE "%.vbs'" OR process.command_line LIKE "%.vbs\"" OR process.command_line LIKE "%.vbe" OR process.command_line LIKE "%.vbe'" OR process.command_line LIKE "%.vbe\"" OR process.command_line LIKE "%.hta" OR process.command_line LIKE "%.hta'" OR process.command_line LIKE "%.hta\"" OR process.command_line LIKE "%.dll" OR process.command_line LIKE "%.dll'" OR process.command_line LIKE "%.dll\"" OR process.command_line LIKE "%.psm1" OR process.command_line LIKE "%.psm1'" OR process.command_line LIKE "%.psm1\"")) AND ((process.command_line RLIKE "\\s-O\\s") OR (process.command_line LIKE "%--output-document%")) AND (process.command_line LIKE "%http%") AND ((process.executable LIKE "%\\wget.exe") OR (process.pe.original_file_name == "wget.exe")) AND (process.command_line RLIKE "://[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}"))
