// Title: Suspicious Service Path Modification
// ID: 138d3531-8793-4f50-a2cd-f291b2863d78
// Status: test
// Level: high
// Author: Victor Sergeev, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-10-21
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects service path modification via the "sc" binary to a suspicious command or path
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (process.executable LIKE "%\\sc.exe" AND (process.command_line LIKE "%config%" AND process.command_line LIKE "%binPath%") AND (process.command_line LIKE "%powershell%" OR process.command_line LIKE "%cmd %" OR process.command_line LIKE "%mshta%" OR process.command_line LIKE "%wscript%" OR process.command_line LIKE "%cscript%" OR process.command_line LIKE "%rundll32%" OR process.command_line LIKE "%svchost%" OR process.command_line LIKE "%dllhost%" OR process.command_line LIKE "%cmd.exe /c%" OR process.command_line LIKE "%cmd.exe /k%" OR process.command_line LIKE "%cmd.exe /r%" OR process.command_line LIKE "%cmd /c%" OR process.command_line LIKE "%cmd /k%" OR process.command_line LIKE "%cmd /r%" OR process.command_line LIKE "%C:\\Users\\Public%" OR process.command_line LIKE "%\\Downloads\\%" OR process.command_line LIKE "%\\Desktop\\%" OR process.command_line LIKE "%\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\%" OR process.command_line LIKE "%C:\\Windows\\TEMP\\%" OR process.command_line LIKE "%\\AppData\\Local\\Temp%"))
