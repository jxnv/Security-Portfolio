// Title: Suspicious Installer Package Child Process
// ID: e0cfaecd-602d-41af-988d-f6ccebb2af26
// Status: test
// Level: medium
// Author: Sohan G (D4rkCiph3r)
// Date: 2023-02-18
// Tags: attack.t1059, attack.t1059.007, attack.t1071, attack.t1071.001, attack.execution, attack.command-and-control
// Description: Detects the execution of suspicious child processes from macOS installer package parent process. This includes osascript, JXA, curl and wget amongst other interpreters
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.parent.executable LIKE "%/package_script_service" OR process.parent.executable LIKE "%/installer") AND (process.executable LIKE "%/sh" OR process.executable LIKE "%/bash" OR process.executable LIKE "%/dash" OR process.executable LIKE "%/python" OR process.executable LIKE "%/ruby" OR process.executable LIKE "%/perl" OR process.executable LIKE "%/php" OR process.executable LIKE "%/javascript" OR process.executable LIKE "%/osascript" OR process.executable LIKE "%/tclsh" OR process.executable LIKE "%/curl" OR process.executable LIKE "%/wget") AND (process.command_line LIKE "%preinstall%" OR process.command_line LIKE "%postinstall%"))
