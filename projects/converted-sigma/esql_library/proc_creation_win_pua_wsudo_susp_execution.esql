// Title: PUA - Wsudo Suspicious Execution
// ID: bdeeabc9-ff2a-4a51-be59-bb253aac7891
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-02
// Tags: attack.execution, attack.privilege-escalation, attack.t1059
// Description: Detects usage of wsudo (Windows Sudo Utility). Which is a tool that let the user execute programs with different permissions (System, Trusted Installer, Administrator...etc)
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%-u System%" OR process.command_line LIKE "%-uSystem%" OR process.command_line LIKE "%-u TrustedInstaller%" OR process.command_line LIKE "%-uTrustedInstaller%" OR process.command_line LIKE "% --ti %")) OR ((process.executable LIKE "%\\wsudo.exe") OR (process.pe.original_file_name == "wsudo.exe") OR (Description == "Windows sudo utility") OR (process.parent.executable LIKE "%\\wsudo-bridge.exe")))
