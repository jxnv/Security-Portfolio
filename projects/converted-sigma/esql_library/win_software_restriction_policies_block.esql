// Title: Restricted Software Access By SRP
// ID: b4c8da4a-1c12-46b0-8a2b-0a8521d03442
// Status: test
// Level: high
// Author: frack113
// Date: 2023-01-12
// Tags: attack.lateral-movement, attack.execution, attack.t1072
// Description: Detects restricted access to applications by the Software Restriction Policies (SRP) policy
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (winlog.provider_name == "Microsoft-Windows-SoftwareRestrictionPolicies" AND (winlog.event_id == 865 OR winlog.event_id == 866 OR winlog.event_id == 867 OR winlog.event_id == 868 OR winlog.event_id == 882))
