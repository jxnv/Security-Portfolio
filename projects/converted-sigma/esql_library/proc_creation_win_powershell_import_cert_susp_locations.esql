// Title: Root Certificate Installed From Susp Locations
// ID: 5f6a601c-2ecb-498b-9c33-660362323afa
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.defense-impairment, attack.t1553.004
// Description: Adversaries may install a root certificate on a compromised system to avoid warnings when connecting to adversary controlled web servers.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.command_line LIKE "%Import-Certificate%" AND process.command_line LIKE "% -FilePath %" AND process.command_line LIKE "%Cert:\\LocalMachine\\Root%") AND (process.command_line LIKE "%\\AppData\\Local\\Temp\\%" OR process.command_line LIKE "%:\\Windows\\TEMP\\%" OR process.command_line LIKE "%\\Desktop\\%" OR process.command_line LIKE "%\\Downloads\\%" OR process.command_line LIKE "%\\Perflogs\\%" OR process.command_line LIKE "%:\\Users\\Public\\%"))
