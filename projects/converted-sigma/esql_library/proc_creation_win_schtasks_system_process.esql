// Title: Scheduled Task Creation Masquerading as System Processes
// ID: 9f8573c9-22b4-40e3-89c1-72bc2b8d49ab
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-02-05
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.stealth, attack.t1053.005, attack.t1036.004, attack.t1036.005
// Description: Detects the creation of scheduled tasks that involve system processes, which may indicate malicious actors masquerading as or abusing these processes to execute payloads or maintain persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.command_line LIKE "% /create %" AND (process.command_line LIKE "% audiodg%" OR process.command_line LIKE "% conhost%" OR process.command_line LIKE "% dwm.exe%" OR process.command_line LIKE "% explorer%" OR process.command_line LIKE "% lsass%" OR process.command_line LIKE "% lsm%" OR process.command_line LIKE "% mmc%" OR process.command_line LIKE "% msiexec%" OR process.command_line LIKE "% regsvr32%" OR process.command_line LIKE "% rundll32%" OR process.command_line LIKE "% services%" OR process.command_line LIKE "% spoolsv%" OR process.command_line LIKE "% svchost%" OR process.command_line LIKE "% taskeng%" OR process.command_line LIKE "% taskhost%" OR process.command_line LIKE "% wininit%" OR process.command_line LIKE "% winlogon%")) AND ((process.executable LIKE "%\\schtasks.exe") OR (process.pe.original_file_name == "schtasks.exe")))
