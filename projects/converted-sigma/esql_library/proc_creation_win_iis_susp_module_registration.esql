// Title: Suspicious IIS Module Registration
// ID: 043c4b8b-3a54-4780-9682-081cb6b8185c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Microsoft (idea)
// Date: 2022-08-04
// Tags: attack.persistence, attack.t1505.004
// Description: Detects a suspicious IIS module registration as described in Microsoft threat report on IIS backdoors
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.parent.executable LIKE "%\\w3wp.exe") AND ((process.command_line LIKE "%appcmd.exe add module%") OR (process.command_line LIKE "% system.enterpriseservices.internal.publish%" AND process.executable LIKE "%\\powershell.exe") OR ((process.command_line LIKE "%gacutil%" AND process.command_line LIKE "% /I%"))))
