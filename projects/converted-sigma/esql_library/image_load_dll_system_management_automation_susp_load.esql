// Title: PowerShell Core DLL Loaded By Non PowerShell Process
// ID: 092bc4b9-3d1d-43b4-a6b4-8c8acd83522f
// Status: test
// Level: medium
// Author: Tom Kern, oscd.community, Natalia Shornikova, Tim Shelton, Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2019-11-14
// Tags: attack.t1059.001, attack.execution
// Description: Detects loading of essential DLLs used by PowerShell by non-PowerShell process.
// Detects behavior similar to meterpreter's "load powershell" extension.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((Description == "System.Management.Automation") OR (process.pe.original_file_name == "System.Management.Automation.dll") OR ((ImageLoaded LIKE "%\\System.Management.Automation.dll" OR ImageLoaded LIKE "%\\System.Management.Automation.ni.dll"))) AND NOT ((((process.executable LIKE "C:\\Windows\\Microsoft.NET\\Framework\\%" OR process.executable LIKE "C:\\Windows\\Microsoft.NET\\FrameworkArm\\%" OR process.executable LIKE "C:\\Windows\\Microsoft.NET\\FrameworkArm64\\%" OR process.executable LIKE "C:\\Windows\\Microsoft.NET\\Framework64\\%") AND process.executable LIKE "%\\mscorsvw.exe") OR ((process.executable == "C:\\Windows\\System32\\dsac.exe" OR process.executable == "C:\\WINDOWS\\System32\\RemoteFXvGPUDisablement.exe" OR process.executable == "C:\\Windows\\System32\\runscripthelper.exe" OR process.executable == "C:\\WINDOWS\\System32\\sdiagnhost.exe" OR process.executable == "C:\\Windows\\System32\\ServerManager.exe" OR process.executable == "C:\\Windows\\System32\\SyncAppvPublishingServer.exe" OR process.executable == "C:\\Windows\\System32\\winrshost.exe" OR process.executable == "C:\\Windows\\System32\\wsmprovhost.exe" OR process.executable == "C:\\Windows\\SysWOW64\\winrshost.exe" OR process.executable == "C:\\Windows\\SysWOW64\\wsmprovhost.exe")) OR ((process.executable == "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" OR process.executable == "C:\\Program Files\\PowerShell\\7\\pwsh.exe" OR process.executable == "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" OR process.executable == "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" OR process.executable == "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" OR process.executable == "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")) OR ((process.executable LIKE "%C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview%" OR process.executable LIKE "%\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview%") AND process.executable LIKE "%\\pwsh.exe"))) AND NOT (((process.executable IS NULL) OR (process.executable LIKE "C:\\ProgramData\\chocolatey\\choco.exe%") OR (process.executable LIKE "%\\Citrix\\ConfigSync\\ConfigSyncRun.exe") OR (process.executable LIKE "C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_%" AND process.executable LIKE "%\\GetHelp.exe") OR (process.executable LIKE "C:\\Windows\\Temp\\asgard2-agent\\%" AND (process.executable LIKE "%\\thor64.exe" OR process.executable LIKE "%\\thor.exe")) OR ((process.executable LIKE "C:\\Program Files (x86)\\Microsoft SQL Server Management Studio%" OR process.executable LIKE "C:\\Program Files\\Microsoft SQL Server Management Studio%") AND process.executable LIKE "%\\IDE\\Ssms.exe") OR ((process.executable LIKE "C:\\Program Files (x86)\\Microsoft SQL Server\\%" OR process.executable LIKE "C:\\Program Files\\Microsoft SQL Server\\%") AND process.executable LIKE "%\\Tools\\Binn\\SQLPS.exe") OR ((process.executable LIKE "C:\\Program Files (x86)\\Microsoft Visual Studio\\%" OR process.executable LIKE "C:\\Program Files\\Microsoft Visual Studio\\%")))))
