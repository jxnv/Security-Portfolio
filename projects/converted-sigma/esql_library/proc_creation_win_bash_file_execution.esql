// Title: Indirect Command Execution From Script File Via Bash.EXE
// ID: 2d22a514-e024-4428-9dba-41505bd63a5b
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-08-15
// Tags: attack.stealth, attack.t1202
// Description: Detects execution of Microsoft bash launcher without any flags to execute the content of a bash script directly.
// This can be used to potentially bypass defenses and execute Linux or Windows-based binaries directly via bash.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.executable LIKE "%:\\Windows\\System32\\bash.exe" OR process.executable LIKE "%:\\Windows\\SysWOW64\\bash.exe")) OR (process.pe.original_file_name == "Bash.exe")) AND NOT ((((process.command_line LIKE "%bash.exe -%" OR process.command_line LIKE "%bash -%")) OR (process.command_line == "") OR (process.command_line IS NULL) OR ((process.command_line == "bash.exe" OR process.command_line == "bash")))))
