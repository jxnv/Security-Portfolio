// Title: Suspicious Mstsc.EXE Execution With Local RDP File
// ID: 6e22722b-dfb1-4508-a911-49ac840b40f8
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects potential RDP connection via Mstsc using a local ".rdp" file located in suspicious locations.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%.rdp" OR process.command_line LIKE "%.rdp\"")) AND ((process.executable LIKE "%\\mstsc.exe") OR (process.pe.original_file_name == "mstsc.exe")) AND ((process.command_line LIKE "%:\\Users\\Public\\%" OR process.command_line LIKE "%:\\Windows\\System32\\spool\\drivers\\color%" OR process.command_line LIKE "%:\\Windows\\System32\\Tasks_Migrated %" OR process.command_line LIKE "%:\\Windows\\Tasks\\%" OR process.command_line LIKE "%:\\Windows\\Temp\\%" OR process.command_line LIKE "%:\\Windows\\Tracing\\%" OR process.command_line LIKE "%\\AppData\\Local\\Temp\\%" OR process.command_line LIKE "%\\Downloads\\%")))
