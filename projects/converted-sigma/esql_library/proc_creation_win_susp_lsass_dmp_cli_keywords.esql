// Title: LSASS Dump Keyword In CommandLine
// ID: ffa6861c-4461-4f59-8a41-578c39f3f23e
// Status: test
// Level: high
// Author: E.M. Anhaus, Tony Lambert, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-10-24
// Tags: attack.credential-access, attack.t1003.001
// Description: Detects the presence of the keywords "lsass" and ".dmp" in the commandline, which could indicate a potential attempt to dump or create a dump of the lsass process.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%lsass.dmp%" OR process.command_line LIKE "%lsass.zip%" OR process.command_line LIKE "%lsass.rar%" OR process.command_line LIKE "%Andrew.dmp%" OR process.command_line LIKE "%Coredump.dmp%" OR process.command_line LIKE "%NotLSASS.zip%" OR process.command_line LIKE "%lsass_2%" OR process.command_line LIKE "%lsassdump%" OR process.command_line LIKE "%lsassdmp%")) OR ((process.command_line LIKE "%lsass%" AND process.command_line LIKE "%.dmp%")) OR ((process.command_line LIKE "%SQLDmpr%" AND process.command_line LIKE "%.mdmp%")) OR ((process.command_line LIKE "%nanodump%" AND process.command_line LIKE "%.dmp%")))
