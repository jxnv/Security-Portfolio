// Title: DNS TOR Proxies
// ID: a8322756-015c-42e7-afb1-436e85ed3ff5
// Status: test
// Level: medium
// Author: Saw Winn Naung , Azure-Sentinel
// Date: 2021-08-15
// Tags: attack.exfiltration, attack.t1048
// Description: Identifies IPs performing DNS lookups associated with common Tor proxies.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((query LIKE "%.hiddenservice.net" OR query LIKE "%.onion.ca" OR query LIKE "%.onion.cab" OR query LIKE "%.onion.casa" OR query LIKE "%.onion.city" OR query LIKE "%.onion.direct" OR query LIKE "%.onion.dog" OR query LIKE "%.onion.glass" OR query LIKE "%.onion.gq" OR query LIKE "%.onion.guide" OR query LIKE "%.onion.in.net" OR query LIKE "%.onion.ink" OR query LIKE "%.onion.it" OR query LIKE "%.onion.link" OR query LIKE "%.onion.lt" OR query LIKE "%.onion.lu" OR query LIKE "%.onion.ly" OR query LIKE "%.onion.mn" OR query LIKE "%.onion.network" OR query LIKE "%.onion.nu" OR query LIKE "%.onion.pet" OR query LIKE "%.onion.plus" OR query LIKE "%.onion.pt" OR query LIKE "%.onion.pw" OR query LIKE "%.onion.rip" OR query LIKE "%.onion.sh" OR query LIKE "%.onion.si" OR query LIKE "%.onion.to" OR query LIKE "%.onion.top" OR query LIKE "%.onion.ws" OR query LIKE "%.onion" OR query LIKE "%.s1.tor-gateways.de" OR query LIKE "%.s2.tor-gateways.de" OR query LIKE "%.s3.tor-gateways.de" OR query LIKE "%.s4.tor-gateways.de" OR query LIKE "%.s5.tor-gateways.de" OR query LIKE "%.t2w.pw" OR query LIKE "%.tor2web.ae.org" OR query LIKE "%.tor2web.blutmagie.de" OR query LIKE "%.tor2web.com" OR query LIKE "%.tor2web.fi" OR query LIKE "%.tor2web.io" OR query LIKE "%.tor2web.org" OR query LIKE "%.tor2web.xyz" OR query LIKE "%.torlink.co"))
