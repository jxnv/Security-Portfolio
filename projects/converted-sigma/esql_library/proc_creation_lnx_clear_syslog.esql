// Title: Syslog Clearing or Removal Via System Utilities
// ID: 3fcc9b35-39e4-44c0-a2ad-9e82b6902b31
// Status: test
// Level: high
// Author: Max Altgelt (Nextron Systems), Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research), MSTIC
// Date: 2021-10-15
// Tags: attack.defense-impairment, attack.t1685.006
// Description: Detects specific commands commonly used to remove or empty the syslog. Which is a technique often used by attacker as a method to hide their tracks
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%/var/log/syslog%") AND ((process.executable LIKE "%/cp" AND process.command_line LIKE "%/dev/null%") OR (process.executable LIKE "%/ln" AND (process.command_line LIKE "%/dev/null %" AND process.command_line LIKE "%/var/log/syslog%") AND (process.command_line LIKE "%-sf %" OR process.command_line LIKE "%-sfn %" OR process.command_line LIKE "%-sfT %")) OR (process.executable LIKE "%/mv") OR (process.executable LIKE "%/rm" AND (process.command_line LIKE "% -r %" OR process.command_line LIKE "% -f %" OR process.command_line LIKE "% -rf %" OR process.command_line LIKE "%/var/log/syslog%")) OR (process.executable LIKE "%/shred" AND process.command_line LIKE "%-u %") OR (process.executable LIKE "%/truncate" AND (process.command_line LIKE "%0 %" AND process.command_line LIKE "%/var/log/syslog%") AND (process.command_line LIKE "%-s %" OR process.command_line LIKE "%-c %" OR process.command_line LIKE "%--size%")) OR (process.executable LIKE "%/unlink"))) OR (((process.command_line LIKE "%journalctl --vacuum%" OR process.command_line LIKE "%journalctl --rotate%")) OR ((process.command_line LIKE "% > /var/log/syslog%" OR process.command_line LIKE "% >/var/log/syslog%" OR process.command_line LIKE "% >| /var/log/syslog%" OR process.command_line LIKE "%: > /var/log/syslog%" OR process.command_line LIKE "%:> /var/log/syslog%" OR process.command_line LIKE "%:>/var/log/syslog%" OR process.command_line LIKE "%>|/var/log/syslog%"))))
