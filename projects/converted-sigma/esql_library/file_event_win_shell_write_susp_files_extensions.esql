// Title: Windows Binaries Write Suspicious Extensions
// ID: b8fd0e93-ff58-4cbd-8f48-1c114e342e62
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-12
// Tags: attack.stealth, attack.t1036
// Description: Detects Windows executables that write files with suspicious extensions
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.executable LIKE "%\\csrss.exe" OR process.executable LIKE "%\\lsass.exe" OR process.executable LIKE "%\\RuntimeBroker.exe" OR process.executable LIKE "%\\sihost.exe" OR process.executable LIKE "%\\smss.exe" OR process.executable LIKE "%\\wininit.exe" OR process.executable LIKE "%\\winlogon.exe") AND (file.path LIKE "%.bat" OR file.path LIKE "%.dll" OR file.path LIKE "%.exe" OR file.path LIKE "%.hta" OR file.path LIKE "%.iso" OR file.path LIKE "%.ps1" OR file.path LIKE "%.txt" OR file.path LIKE "%.vbe" OR file.path LIKE "%.vbs")) OR ((process.executable LIKE "%\\dllhost.exe" OR process.executable LIKE "%\\rundll32.exe" OR process.executable LIKE "%\\svchost.exe") AND (file.path LIKE "%.bat" OR file.path LIKE "%.hta" OR file.path LIKE "%.iso" OR file.path LIKE "%.ps1" OR file.path LIKE "%.vbe" OR file.path LIKE "%.vbs"))) AND NOT (((process.executable == "C:\\Windows\\System32\\dllhost.exe" AND (file.path LIKE "%:\\Users\\%" AND file.path LIKE "%\\AppData\\Local\\Temp\\__PSScriptPolicyTest_%") AND file.path LIKE "%.ps1") OR (process.executable == "C:\\Windows\\system32\\svchost.exe" AND (file.path LIKE "%C:\\Program Files\\WindowsApps\\Clipchamp%" AND file.path LIKE "%.ps1%")) OR ((process.executable == "C:\\Windows\\system32\\svchost.exe" OR process.executable == "C:\\Windows\\SysWOW64\\svchost.exe") AND (file.path LIKE "C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview%" OR file.path LIKE "C:\\Program Files (x86)\\WindowsApps\\Microsoft.PowerShellPreview%") AND file.path LIKE "%.ps1") OR (process.executable == "C:\\Windows\\system32\\svchost.exe" AND (file.path LIKE "%C:\\Windows\\System32\\GroupPolicy\\DataStore\\%" AND file.path LIKE "%\\sysvol\\%" AND file.path LIKE "%\\Policies\\%" AND file.path LIKE "%\\Machine\\Scripts\\Startup\\%") AND (file.path LIKE "%.ps1" OR file.path LIKE "%.bat")))))
