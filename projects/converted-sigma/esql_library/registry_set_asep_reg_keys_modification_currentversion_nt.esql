// Title: CurrentVersion NT Autorun Keys Modification
// ID: cbf93e5d-ca6c-4722-8bea-e9119007c248
// Status: test
// Level: medium
// Author: Victor Sergeev, Daniil Yugoslavskiy, Gleb Sukhodolskiy, Timur Zinniatullin, oscd.community, Tim Shelton, frack113 (split)
// Date: 2019-10-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects modification of autostart extensibility point (ASEP) in registry.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((registry.path LIKE "%\\Winlogon\\VmApplet%" OR registry.path LIKE "%\\Winlogon\\Userinit%" OR registry.path LIKE "%\\Winlogon\\Taskman%" OR registry.path LIKE "%\\Winlogon\\Shell%" OR registry.path LIKE "%\\Winlogon\\GpExtensions%" OR registry.path LIKE "%\\Winlogon\\AppSetup%" OR registry.path LIKE "%\\Winlogon\\AlternateShells\\AvailableShells%" OR registry.path LIKE "%\\Windows\\IconServiceLib%" OR registry.path LIKE "%\\Windows\\Appinit_Dlls%" OR registry.path LIKE "%\\Image File Execution Options%" OR registry.path LIKE "%\\Font Drivers%" OR registry.path LIKE "%\\Drivers32%" OR registry.path LIKE "%\\Windows\\Run%" OR registry.path LIKE "%\\Windows\\Load%")) AND (registry.path LIKE "%\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion%")) AND NOT (((registry.data.strings == "(Empty)") OR (registry.path LIKE "%\\Image File Execution Options\\%" AND (registry.path LIKE "%\\DisableExceptionChainValidation" OR registry.path LIKE "%\\MitigationOptions")) OR (registry.data.strings IS NULL) OR (process.executable == "C:\\Windows\\System32\\poqexec.exe") OR (process.executable == "C:\\Windows\\System32\\RuntimeBroker.exe" AND registry.path LIKE "%\\runtimebroker.exe\\Microsoft.Windows.ShellExperienceHost%") OR (process.executable == "C:\\Windows\\system32\\svchost.exe" AND (registry.path LIKE "%\\Winlogon\\GPExtensions\\{827D319E-6EAC-11D2-A4EA-00C04F79F83A}\\PreviousPolicyAreas%" OR registry.path LIKE "%\\Winlogon\\GPExtensions\\{827D319E-6EAC-11D2-A4EA-00C04F79F83A}\\MaxNoGPOListChangesInterval%") AND (registry.data.strings == "DWORD (0x00000001)" OR registry.data.strings == "DWORD (0x00000009)" OR registry.data.strings == "DWORD (0x000003c0)")))) AND NOT ((((process.executable LIKE "C:\\Program Files (x86)\\Avira\\Antivirus\\avguard.exe%" OR process.executable LIKE "C:\\Program Files\\Avira\\Antivirus\\avguard.exe%") AND registry.path LIKE "%SOFTWARE\\WOW6432Node\\Avira\\Antivirus\\Overwrite_Keys\\HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon\\%" AND (registry.path LIKE "%\\userinit\\UseAsDefault" OR registry.path LIKE "%\\shell\\UseAsDefault") AND (registry.data.strings == "explorer.exe" OR registry.data.strings == "C:\\Windows\\system32\\userinit.exe,")) OR (process.executable LIKE "C:\\Program Files (x86)\\Microsoft\\Temp\\%" AND process.executable LIKE "%\\MicrosoftEdgeUpdate.exe") OR (((registry.path LIKE "%\\ClickToRunStore\\HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\%" OR registry.path LIKE "%\\ClickToRun\\REGISTRY\\MACHINE\\Software\\Microsoft\\Windows NT\\CurrentVersion\\%")) OR ((process.executable == "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe" OR process.executable == "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe"))) OR (process.executable LIKE "C:\\Windows\\Microsoft.NET\\Framework%" AND process.executable LIKE "%\\ngen.exe") OR ((process.executable LIKE "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\%" OR process.executable LIKE "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\%") AND process.executable LIKE "%\\OfficeClickToRun.exe") OR (process.executable LIKE "%\\AppData\\Local\\Microsoft\\OneDrive\\StandaloneUpdater\\OneDriveSetup.exe" AND registry.path LIKE "%\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\Delete Cached Update Binary" AND registry.data.strings LIKE "C:\\Windows\\system32\\cmd.exe /q /c del /q \"C:\\Users\\%" AND registry.data.strings LIKE "%\\AppData\\Local\\Microsoft\\OneDrive\\Update\\OneDriveSetup.exe\""))))
