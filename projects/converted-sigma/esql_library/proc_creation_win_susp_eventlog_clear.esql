// Title: Suspicious Eventlog Clearing or Configuration Change Activity
// ID: cc36992a-4671-4f21-a91d-6c2b72a2edf5
// Status: stable
// Level: high
// Author: Ecco, Daniil Yugoslavskiy, oscd.community, D3F7A5105, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2019-09-26
// Tags: attack.defense-impairment, attack.t1685.005, attack.t1685.001, car.2016-04-002
// Description: Detects the clearing or configuration tampering of EventLog using utilities such as "wevtutil", "powershell" and "wmic".
// This technique were seen used by threat actors and ransomware strains in order to evade defenses.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((((process.command_line LIKE "%clear-log %" OR process.command_line LIKE "% cl %" OR process.command_line LIKE "%set-log %" OR process.command_line LIKE "% sl %" OR process.command_line LIKE "%lfn:%")) AND ((process.executable LIKE "%\\wevtutil.exe") OR (process.pe.original_file_name == "wevtutil.exe"))) OR ((((process.command_line LIKE "%Clear-EventLog %" OR process.command_line LIKE "%Remove-EventLog %" OR process.command_line LIKE "%Limit-EventLog %" OR process.command_line LIKE "%Clear-WinEvent %")) OR ((process.command_line LIKE "%Eventing.Reader.EventLogSession%" AND process.command_line LIKE "%ClearLog%")) OR ((process.command_line LIKE "%Diagnostics.EventLog%" AND process.command_line LIKE "%Clear%"))) AND ((process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\powershell_ise.exe" OR process.executable LIKE "%\\pwsh.exe"))) OR ((process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\powershell_ise.exe" OR process.executable LIKE "%\\pwsh.exe" OR process.executable LIKE "%\\wmic.exe") AND process.command_line LIKE "%ClearEventLog%")) AND NOT (((process.parent.executable == "C:\\Windows\\SysWOW64\\msiexec.exe" OR process.parent.executable == "C:\\Windows\\System32\\msiexec.exe") AND process.command_line LIKE "% sl %")))
