// Title: Modify User Shell Folders Startup Value
// ID: 9c226817-8dc9-46c2-a58d-66655aafd7dc
// Status: test
// Level: high
// Author: frack113, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2022-10-01
// Tags: attack.persistence, attack.privilege-escalation, attack.t1547.001
// Description: Detect modification of the User Shell Folders registry values for Startup or Common Startup which could indicate persistence attempts.
// Attackers may modify User Shell Folders registry keys to point to malicious executables or scripts that will be executed during startup.
// This technique is often used to maintain persistence on a compromised system by ensuring that the malicious payload is executed automatically.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((registry.path LIKE "%SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\User Shell Folders%" OR registry.path LIKE "%SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Shell Folders%") AND (registry.path LIKE "%\\Common Startup" OR registry.path LIKE "%\\Startup")) AND NOT (((registry.data.strings IS NULL) OR ((registry.data.strings LIKE "%C:\\ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\\Startup%" OR registry.data.strings LIKE "%%ProgramData%\\Microsoft\\Windows\\Start Menu\\Programs\\Startup%")) OR ((registry.data.strings LIKE "%%USERPROFILE%\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\Startup%" OR registry.data.strings LIKE "%%%USERPROFILE%%\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\Startup%")) OR ((registry.data.strings LIKE "%C:\\Users\\%" AND registry.data.strings LIKE "%\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\Startup%")))))
