// Title: Suspicious Control Panel DLL Load
// ID: d7eb979b-c2b5-4a6f-a3a7-c87ce6763819
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2017-04-15
// Tags: attack.stealth, attack.t1218.011
// Description: Detects suspicious Rundll32 execution from control.exe as used by Equation Group and Exploit Kits
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.executable LIKE "%\\rundll32.exe") OR (process.pe.original_file_name == "RUNDLL32.EXE")) AND (process.parent.executable LIKE "%\\System32\\control.exe")) AND NOT ((process.command_line LIKE "%Shell32.dll%")))
