// Title: Potential Persistence Via Visual Studio Tools for Office
// ID: 9d15044a-7cfe-4d23-8085-6ebc11df7685
// Status: test
// Level: medium
// Author: Bhabesh Raj
// Date: 2021-01-10
// Tags: attack.t1137.006, attack.persistence
// Description: Detects persistence via Visual Studio Tools for Office (VSTO) add-ins in Office applications.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((registry.path LIKE "%\\Software\\Microsoft\\Office\\Outlook\\Addins\\%" OR registry.path LIKE "%\\Software\\Microsoft\\Office\\Word\\Addins\\%" OR registry.path LIKE "%\\Software\\Microsoft\\Office\\Excel\\Addins\\%" OR registry.path LIKE "%\\Software\\Microsoft\\Office\\Powerpoint\\Addins\\%" OR registry.path LIKE "%\\Software\\Microsoft\\VSTO\\Security\\Inclusion\\%")) AND NOT ((((process.executable == "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe" OR process.executable == "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe")) OR ((process.executable LIKE "C:\\Program Files\\Microsoft Office\\OFFICE%" OR process.executable LIKE "C:\\Program Files (x86)\\Microsoft Office\\OFFICE%" OR process.executable LIKE "C:\\Program Files\\Microsoft Office\\Root\\OFFICE%" OR process.executable LIKE "C:\\Program Files (x86)\\Microsoft Office\\Root\\OFFICE%" OR process.executable LIKE "C:\\PROGRA~2\\MICROS~2\\Office%") AND (process.executable LIKE "%\\excel.exe" OR process.executable LIKE "%\\Integrator.exe" OR process.executable LIKE "%\\OneNote.exe" OR process.executable LIKE "%\\outlook.exe" OR process.executable LIKE "%\\powerpnt.exe" OR process.executable LIKE "%\\Teams.exe" OR process.executable LIKE "%\\visio.exe" OR process.executable LIKE "%\\winword.exe")) OR ((process.executable LIKE "C:\\Program Files\\Common Files (x86)\\Microsoft Shared\\ClickToRun\\%" OR process.executable LIKE "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\%") AND process.executable LIKE "%\\OfficeClickToRun.exe") OR ((process.executable == "C:\\Windows\\System32\\msiexec.exe" OR process.executable == "C:\\Windows\\SysWOW64\\msiexec.exe" OR process.executable == "C:\\Windows\\System32\\regsvr32.exe" OR process.executable == "C:\\Windows\\SysWOW64\\regsvr32.exe")) OR ((process.executable LIKE "C:\\Program Files\\Common Files\\Microsoft Shared\\VSTO\\%" OR process.executable LIKE "C:\\Program Files (x86)\\Microsoft Shared\\VSTO\\%") AND process.executable LIKE "%\\VSTOInstaller.exe"))) AND NOT ((((process.executable == "C:\\Program Files\\Avast Software\\Avast\\RegSvr.exe" OR process.executable == "C:\\Program Files (x86)\\Avast Software\\Avast\\RegSvr.exe") AND registry.path LIKE "%\\Microsoft\\Office\\Outlook\\Addins\\Avast.AsOutExt\\%") OR ((process.executable == "C:\\Program Files\\AVG\\Antivirus\\RegSvr.exe" OR process.executable == "C:\\Program Files (x86)\\AVG\\Antivirus\\RegSvr.exe") AND registry.path LIKE "%\\Microsoft\\Office\\Outlook\\Addins\\Antivirus.AsOutExt\\%"))))
