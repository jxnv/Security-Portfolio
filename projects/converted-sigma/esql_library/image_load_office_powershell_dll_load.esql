// Title: PowerShell Core DLL Loaded Via Office Application
// ID: bb2ba6fb-95d4-4a25-89fc-30bb736c021a
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-01
// Tags: attack.stealth
// Description: Detects PowerShell core DLL being loaded by an Office Product
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%\\excel.exe" OR process.executable LIKE "%\\mspub.exe" OR process.executable LIKE "%\\outlook.exe" OR process.executable LIKE "%\\onenote.exe" OR process.executable LIKE "%\\onenoteim.exe" OR process.executable LIKE "%\\powerpnt.exe" OR process.executable LIKE "%\\winword.exe") AND (ImageLoaded LIKE "%\\System.Management.Automation.Dll%" OR ImageLoaded LIKE "%\\System.Management.Automation.ni.Dll%"))
