// Title: Office Macro File Download
// ID: 0e29e3a7-1ad8-40aa-b691-9f82ecd33d66
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-23
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects the creation of a new office macro files on the system via an application (browser, mail client).
// This can help identify potential malicious activity, such as the download of macro-enabled documents that could be used for exploitation.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((file.path LIKE "%.docm" OR file.path LIKE "%.dotm" OR file.path LIKE "%.xlsm" OR file.path LIKE "%.xltm" OR file.path LIKE "%.potm" OR file.path LIKE "%.pptm")) OR ((file.path LIKE "%.docm:Zone%" OR file.path LIKE "%.dotm:Zone%" OR file.path LIKE "%.xlsm:Zone%" OR file.path LIKE "%.xltm:Zone%" OR file.path LIKE "%.potm:Zone%" OR file.path LIKE "%.pptm:Zone%"))) AND ((process.executable LIKE "%\\RuntimeBroker.exe" OR process.executable LIKE "%\\outlook.exe" OR process.executable LIKE "%\\thunderbird.exe" OR process.executable LIKE "%\\brave.exe" OR process.executable LIKE "%\\chrome.exe" OR process.executable LIKE "%\\firefox.exe" OR process.executable LIKE "%\\iexplore.exe" OR process.executable LIKE "%\\maxthon.exe" OR process.executable LIKE "%\\MicrosoftEdge.exe" OR process.executable LIKE "%\\msedge.exe" OR process.executable LIKE "%\\msedgewebview2.exe" OR process.executable LIKE "%\\opera.exe" OR process.executable LIKE "%\\safari.exe" OR process.executable LIKE "%\\seamonkey.exe" OR process.executable LIKE "%\\vivaldi.exe" OR process.executable LIKE "%\\whale.exe")))
