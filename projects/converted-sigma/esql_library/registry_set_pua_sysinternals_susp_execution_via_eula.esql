// Title: PUA - Sysinternals Tools Execution - Registry
// ID: c7da8edc-49ae-45a2-9e61-9fd860e4e73d
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-24
// Tags: attack.resource-development, attack.t1588.002
// Description: Detects the execution of some potentially unwanted tools such as PsExec, Procdump, etc. (part of the Sysinternals suite) via the creation of the "accepteula" registry key.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((registry.path LIKE "%\\Active Directory Explorer%" OR registry.path LIKE "%\\Handle%" OR registry.path LIKE "%\\LiveKd%" OR registry.path LIKE "%\\Process Explorer%" OR registry.path LIKE "%\\ProcDump%" OR registry.path LIKE "%\\PsExec%" OR registry.path LIKE "%\\PsLoglist%" OR registry.path LIKE "%\\PsPasswd%" OR registry.path LIKE "%\\SDelete%" OR registry.path LIKE "%\\Sysinternals%") AND registry.path LIKE "%\\EulaAccepted")
