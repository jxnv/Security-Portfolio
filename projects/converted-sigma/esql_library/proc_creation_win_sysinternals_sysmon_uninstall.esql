// Title: Uninstall Sysinternals Sysmon
// ID: 6a5f68d1-c4b5-46b9-94ee-5324892ea939
// Status: test
// Level: high
// Author: frack113
// Date: 2022-01-12
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects the removal of Sysmon, which could be a potential attempt at defense evasion
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%-u%" OR process.command_line LIKE "%/u%")) AND (((process.executable LIKE "%\\Sysmon64.exe" OR process.executable LIKE "%\\Sysmon64a.exe" OR process.executable LIKE "%\\Sysmon.exe")) OR (Description == "System activity monitor")))
