// Title: User Added to Local Administrators Group
// ID: ad720b90-25ad-43ff-9b5e-5c841facc8e5
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-12
// Tags: attack.privilege-escalation, attack.persistence, attack.t1098
// Description: Detects addition of users to the local administrator group via "Net" or "Add-LocalGroupMember".
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "% administrators %" OR process.command_line LIKE "% administrateur%")) AND (((process.command_line LIKE "%localgroup %" AND process.command_line LIKE "% /add%")) OR ((process.command_line LIKE "%Add-LocalGroupMember %" AND process.command_line LIKE "% -Group %"))))
