// Title: Rare Remote Thread Creation By Uncommon Source Image
// ID: 02d1d718-dd13-41af-989d-ea85c7fab93f
// Status: test
// Level: high
// Author: Perez Diego (@darkquassar), oscd.community
// Date: 2019-10-27
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects uncommon processes creating remote threads.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((SourceImage LIKE "%\\bash.exe" OR SourceImage LIKE "%\\cscript.exe" OR SourceImage LIKE "%\\cvtres.exe" OR SourceImage LIKE "%\\defrag.exe" OR SourceImage LIKE "%\\dialer.exe" OR SourceImage LIKE "%\\dnx.exe" OR SourceImage LIKE "%\\esentutl.exe" OR SourceImage LIKE "%\\excel.exe" OR SourceImage LIKE "%\\expand.exe" OR SourceImage LIKE "%\\find.exe" OR SourceImage LIKE "%\\findstr.exe" OR SourceImage LIKE "%\\forfiles.exe" OR SourceImage LIKE "%\\gpupdate.exe" OR SourceImage LIKE "%\\hh.exe" OR SourceImage LIKE "%\\installutil.exe" OR SourceImage LIKE "%\\lync.exe" OR SourceImage LIKE "%\\makecab.exe" OR SourceImage LIKE "%\\mDNSResponder.exe" OR SourceImage LIKE "%\\monitoringhost.exe" OR SourceImage LIKE "%\\msbuild.exe" OR SourceImage LIKE "%\\mshta.exe" OR SourceImage LIKE "%\\mspaint.exe" OR SourceImage LIKE "%\\outlook.exe" OR SourceImage LIKE "%\\ping.exe" OR SourceImage LIKE "%\\provtool.exe" OR SourceImage LIKE "%\\python.exe" OR SourceImage LIKE "%\\regsvr32.exe" OR SourceImage LIKE "%\\robocopy.exe" OR SourceImage LIKE "%\\runonce.exe" OR SourceImage LIKE "%\\sapcimc.exe" OR SourceImage LIKE "%\\smartscreen.exe" OR SourceImage LIKE "%\\spoolsv.exe" OR SourceImage LIKE "%\\tstheme.exe" OR SourceImage LIKE "%\\userinit.exe" OR SourceImage LIKE "%\\vssadmin.exe" OR SourceImage LIKE "%\\vssvc.exe" OR SourceImage LIKE "%\\w3wp.exe" OR SourceImage LIKE "%\\winscp.exe" OR SourceImage LIKE "%\\winword.exe" OR SourceImage LIKE "%\\wmic.exe" OR SourceImage LIKE "%\\wscript.exe")) AND NOT ((((SourceImage == "C:\\Windows\\System32\\Defrag.exe" OR SourceImage == "C:\\Windows\\System32\\makecab.exe") AND TargetImage == "C:\\Windows\\System32\\conhost.exe") OR ((SourceImage LIKE "C:\\Program Files\\Microsoft Office\\%" OR SourceImage LIKE "C:\\Program Files (x86)\\Microsoft Office\\%") AND TargetImage == "System") OR (SourceImage == "C:\\Windows\\System32\\provtool.exe" AND TargetImage == "C:\\Windows\\System32\\svchost.exe") OR (SourceImage == "C:\\Windows\\System32\\provtool.exe" AND TargetImage == "System") OR (SourceImage == "C:\\Windows\\System32\\userinit.exe" AND TargetImage == "C:\\Windows\\explorer.exe") OR (SourceImage LIKE "%\\WINWORD.EXE" AND (TargetImage LIKE "C:\\Program Files (x86)\\%" OR TargetImage LIKE "C:\\Program Files\\%")))) AND NOT ((SourceImage LIKE "%\\SysWOW64\\explorer.exe" AND (TargetImage == "C:\\Program Files (x86)\\VMware\\VMware Tools\\vmtoolsd.exe" OR TargetImage == "C:\\Program Files\\VMware\\VMware Tools\\vmtoolsd.exe"))))
