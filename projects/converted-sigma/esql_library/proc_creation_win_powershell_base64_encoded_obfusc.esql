// Title: Suspicious Obfuscated PowerShell Code
// ID: 8d01b53f-456f-48ee-90f6-bc28e67d4e35
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-07-11
// Tags: attack.stealth
// Description: Detects suspicious UTF16 and base64 encoded and often obfuscated PowerShell code often used in command lines
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.command_line LIKE "%IAAtAGIAeABvAHIAIAAwAHgA%" OR process.command_line LIKE "%AALQBiAHgAbwByACAAMAB4A%" OR process.command_line LIKE "%gAC0AYgB4AG8AcgAgADAAeA%" OR process.command_line LIKE "%AC4ASQBuAHYAbwBrAGUAKAApACAAfAAg%" OR process.command_line LIKE "%AuAEkAbgB2AG8AawBlACgAKQAgAHwAI%" OR process.command_line LIKE "%ALgBJAG4AdgBvAGsAZQAoACkAIAB8AC%" OR process.command_line LIKE "%AHsAMQB9AHsAMAB9ACIAIAAtAGYAI%" OR process.command_line LIKE "%B7ADEAfQB7ADAAfQAiACAALQBmAC%" OR process.command_line LIKE "%AewAxAH0AewAwAH0AIgAgAC0AZgAg%" OR process.command_line LIKE "%AHsAMAB9AHsAMwB9ACIAIAAtAGYAI%" OR process.command_line LIKE "%B7ADAAfQB7ADMAfQAiACAALQBmAC%" OR process.command_line LIKE "%AewAwAH0AewAzAH0AIgAgAC0AZgAg%" OR process.command_line LIKE "%AHsAMgB9AHsAMAB9ACIAIAAtAGYAI%" OR process.command_line LIKE "%B7ADIAfQB7ADAAfQAiACAALQBmAC%" OR process.command_line LIKE "%AewAyAH0AewAwAH0AIgAgAC0AZgAg%" OR process.command_line LIKE "%AHsAMQB9AHsAMAB9ACcAIAAtAGYAI%" OR process.command_line LIKE "%B7ADEAfQB7ADAAfQAnACAALQBmAC%" OR process.command_line LIKE "%AewAxAH0AewAwAH0AJwAgAC0AZgAg%" OR process.command_line LIKE "%AHsAMAB9AHsAMwB9ACcAIAAtAGYAI%" OR process.command_line LIKE "%B7ADAAfQB7ADMAfQAnACAALQBmAC%" OR process.command_line LIKE "%AewAwAH0AewAzAH0AJwAgAC0AZgAg%" OR process.command_line LIKE "%AHsAMgB9AHsAMAB9ACcAIAAtAGYAI%" OR process.command_line LIKE "%B7ADIAfQB7ADAAfQAnACAALQBmAC%" OR process.command_line LIKE "%AewAyAH0AewAwAH0AJwAgAC0AZgAg%"))
