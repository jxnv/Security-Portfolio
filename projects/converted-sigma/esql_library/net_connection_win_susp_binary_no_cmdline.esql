// Title: Suspicious Network Connection Binary No CommandLine
// ID: 20384606-a124-4fec-acbb-8bd373728613
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-07-03
// Tags: attack.stealth
// Description: Detects suspicious network connections made by a well-known Windows binary run with no command line parameters
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((Initiated == "true" AND (process.executable LIKE "%\\regsvr32.exe" OR process.executable LIKE "%\\rundll32.exe" OR process.executable LIKE "%\\dllhost.exe") AND (process.command_line LIKE "%\\regsvr32.exe" OR process.command_line LIKE "%\\rundll32.exe" OR process.command_line LIKE "%\\dllhost.exe")) AND NOT (((process.command_line == "") OR (process.command_line IS NULL))))
