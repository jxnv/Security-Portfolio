// Title: Potential Defense Evasion Via Rename Of Highly Relevant Binaries
// ID: 0ba1da6d-b6ce-4366-828c-18826c9de23e
// Status: test
// Level: high
// Author: Matthew Green - @mgreen27, Florian Roth (Nextron Systems), frack113
// Date: 2019-06-15
// Tags: attack.stealth, attack.t1036.003, car.2013-05-009
// Description: Detects the execution of a renamed binary often used by attackers or malware leveraging new Sysmon OriginalFileName datapoint.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((Description == "Execute processes remotely") OR (Product == "Sysinternals PsExec") OR ((Description LIKE "Windows PowerShell%" OR Description LIKE "pwsh%")) OR ((process.pe.original_file_name == "certutil.exe" OR process.pe.original_file_name == "cmstp.exe" OR process.pe.original_file_name == "cscript.exe" OR process.pe.original_file_name == "IE4UINIT.EXE" OR process.pe.original_file_name == "finger.exe" OR process.pe.original_file_name == "mshta.exe" OR process.pe.original_file_name == "msiexec.exe" OR process.pe.original_file_name == "msxsl.exe" OR process.pe.original_file_name == "powershell_ise.exe" OR process.pe.original_file_name == "powershell.exe" OR process.pe.original_file_name == "psexec.c" OR process.pe.original_file_name == "psexec.exe" OR process.pe.original_file_name == "psexesvc.exe" OR process.pe.original_file_name == "pwsh.dll" OR process.pe.original_file_name == "reg.exe" OR process.pe.original_file_name == "regsvr32.exe" OR process.pe.original_file_name == "rundll32.exe" OR process.pe.original_file_name == "WerMgr" OR process.pe.original_file_name == "wmic.exe" OR process.pe.original_file_name == "wscript.exe"))) AND NOT (((process.executable LIKE "%\\certutil.exe" OR process.executable LIKE "%\\cmstp.exe" OR process.executable LIKE "%\\cscript.exe" OR process.executable LIKE "%\\ie4uinit.exe" OR process.executable LIKE "%\\finger.exe" OR process.executable LIKE "%\\mshta.exe" OR process.executable LIKE "%\\msiexec.exe" OR process.executable LIKE "%\\msxsl.exe" OR process.executable LIKE "%\\powershell_ise.exe" OR process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\psexec.exe" OR process.executable LIKE "%\\psexec64.exe" OR process.executable LIKE "%\\psexec64a.exe" OR process.executable LIKE "%\\PSEXESVC.exe" OR process.executable LIKE "%\\pwsh.exe" OR process.executable LIKE "%\\reg.exe" OR process.executable LIKE "%\\regsvr32.exe" OR process.executable LIKE "%\\rundll32.exe" OR process.executable LIKE "%\\wermgr.exe" OR process.executable LIKE "%\\wmic.exe" OR process.executable LIKE "%\\wscript.exe"))))
