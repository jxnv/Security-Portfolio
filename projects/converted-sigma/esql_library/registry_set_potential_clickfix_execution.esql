// Title: Potential ClickFix Execution Pattern - Registry
// ID: f5fe36cf-f1ec-4c23-903d-09a3110f6bbb
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-03-25
// Tags: attack.execution, attack.t1204.001
// Description: Detects potential ClickFix malware execution patterns by monitoring registry modifications in RunMRU keys containing HTTP/HTTPS links.
// ClickFix is known to be distributed through phishing campaigns and uses techniques like clipboard hijacking and fake CAPTCHA pages.
// Through the fakecaptcha pages, the adversary tricks users into opening the Run dialog box and pasting clipboard-hijacked content,
// such as one-liners that execute remotely hosted malicious files or scripts.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((registry.data.strings LIKE "%http://%" OR registry.data.strings LIKE "%https://%")) AND (registry.path LIKE "%\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\RunMRU\\%") AND (((registry.data.strings LIKE "%account%" OR registry.data.strings LIKE "%anti-bot%" OR registry.data.strings LIKE "%botcheck%" OR registry.data.strings LIKE "%captcha%" OR registry.data.strings LIKE "%challenge%" OR registry.data.strings LIKE "%confirmation%" OR registry.data.strings LIKE "%fraud%" OR registry.data.strings LIKE "%human%" OR registry.data.strings LIKE "%identification%" OR registry.data.strings LIKE "%identificator%" OR registry.data.strings LIKE "%identity%" OR registry.data.strings LIKE "%robot%" OR registry.data.strings LIKE "%validation%" OR registry.data.strings LIKE "%verification%" OR registry.data.strings LIKE "%verify%")) OR ((registry.data.strings LIKE "%%comspec%%" OR registry.data.strings LIKE "%bitsadmin%" OR registry.data.strings LIKE "%certutil%" OR registry.data.strings LIKE "%cmd%" OR registry.data.strings LIKE "%cscript%" OR registry.data.strings LIKE "%curl%" OR registry.data.strings LIKE "%finger%" OR registry.data.strings LIKE "%mshta%" OR registry.data.strings LIKE "%powershell%" OR registry.data.strings LIKE "%pwsh%" OR registry.data.strings LIKE "%regsvr32%" OR registry.data.strings LIKE "%rundll32%" OR registry.data.strings LIKE "%schtasks%" OR registry.data.strings LIKE "%wget%" OR registry.data.strings LIKE "%wscript%"))))
