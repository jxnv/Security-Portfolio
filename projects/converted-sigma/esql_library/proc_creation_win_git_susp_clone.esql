// Title: Suspicious Git Clone
// ID: aef9d1f1-7396-4e92-a927-4567c7a495c1
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-03
// Tags: attack.reconnaissance, attack.t1593.003
// Description: Detects execution of "git" in order to clone a remote repository that contain suspicious keywords which might be suspicious
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "% clone %" OR process.command_line LIKE "%git-remote-https %")) AND (((process.executable LIKE "%\\git.exe" OR process.executable LIKE "%\\git-remote-https.exe")) OR (process.pe.original_file_name == "git.exe")) AND ((process.command_line LIKE "%exploit%" OR process.command_line LIKE "%Vulns%" OR process.command_line LIKE "%vulnerability%" OR process.command_line LIKE "%RemoteCodeExecution%" OR process.command_line LIKE "%Invoke-%" OR process.command_line LIKE "%CVE-%" OR process.command_line LIKE "%poc-%" OR process.command_line LIKE "%ProofOfConcept%" OR process.command_line LIKE "%proxyshell%" OR process.command_line LIKE "%log4shell%" OR process.command_line LIKE "%eternalblue%" OR process.command_line LIKE "%eternal-blue%" OR process.command_line LIKE "%MS17-%")))
