// Title: VMToolsd Suspicious Child Process
// ID: 5687f942-867b-4578-ade7-1e341c46e99a
// Status: test
// Level: high
// Author: bohops, Bhabesh Raj
// Date: 2021-10-08
// Tags: attack.execution, attack.persistence, attack.t1059
// Description: Detects suspicious child process creations of VMware Tools process which may indicate persistence setup
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((((process.executable LIKE "%\\cmd.exe" OR process.executable LIKE "%\\cscript.exe" OR process.executable LIKE "%\\mshta.exe" OR process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe" OR process.executable LIKE "%\\regsvr32.exe" OR process.executable LIKE "%\\rundll32.exe" OR process.executable LIKE "%\\wscript.exe")) OR ((process.pe.original_file_name == "Cmd.Exe" OR process.pe.original_file_name == "cscript.exe" OR process.pe.original_file_name == "MSHTA.EXE" OR process.pe.original_file_name == "PowerShell.EXE" OR process.pe.original_file_name == "pwsh.dll" OR process.pe.original_file_name == "REGSVR32.EXE" OR process.pe.original_file_name == "RUNDLL32.EXE" OR process.pe.original_file_name == "wscript.exe"))) AND (process.parent.executable LIKE "%\\vmtoolsd.exe")) AND NOT (((process.executable LIKE "%\\cmd.exe" AND process.command_line == "") OR (process.executable LIKE "%\\cmd.exe" AND process.command_line IS NULL) OR (process.executable LIKE "%\\cmd.exe" AND (process.command_line LIKE "%\\VMware\\VMware Tools\\poweron-vm-default.bat%" OR process.command_line LIKE "%\\VMware\\VMware Tools\\poweroff-vm-default.bat%" OR process.command_line LIKE "%\\VMware\\VMware Tools\\resume-vm-default.bat%" OR process.command_line LIKE "%\\VMware\\VMware Tools\\suspend-vm-default.bat%")))))
