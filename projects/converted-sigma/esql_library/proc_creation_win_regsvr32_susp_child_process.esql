// Title: Potentially Suspicious Child Process Of Regsvr32
// ID: 6f0947a4-1c5e-4e0d-8ac7-53159b8f23ca
// Status: test
// Level: high
// Author: elhoim, Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-05-05
// Tags: attack.stealth, attack.t1218.010
// Description: Detects potentially suspicious child processes of "regsvr32.exe".
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.parent.executable LIKE "%\\regsvr32.exe" AND (process.executable LIKE "%\\calc.exe" OR process.executable LIKE "%\\cscript.exe" OR process.executable LIKE "%\\explorer.exe" OR process.executable LIKE "%\\mshta.exe" OR process.executable LIKE "%\\net.exe" OR process.executable LIKE "%\\net1.exe" OR process.executable LIKE "%\\nltest.exe" OR process.executable LIKE "%\\notepad.exe" OR process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe" OR process.executable LIKE "%\\reg.exe" OR process.executable LIKE "%\\schtasks.exe" OR process.executable LIKE "%\\werfault.exe" OR process.executable LIKE "%\\wscript.exe")) AND NOT ((process.executable LIKE "%\\werfault.exe" AND process.command_line LIKE "% -u -p %")))
