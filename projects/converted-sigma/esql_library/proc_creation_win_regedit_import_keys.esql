// Title: Imports Registry Key From a File
// ID: 73bba97f-a82d-42ce-b315-9182e76c57b1
// Status: test
// Level: medium
// Author: Oddvar Moe, Sander Wiebing, oscd.community
// Date: 2020-10-07
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects the import of the specified file to the registry with regedit.exe.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.command_line LIKE "% /i %" OR process.command_line LIKE "% /s %" OR process.command_line LIKE "%.reg%")) AND ((process.executable LIKE "%\\regedit.exe") OR (process.pe.original_file_name == "REGEDIT.EXE"))) AND NOT ((((process.command_line LIKE "% -e %" OR process.command_line LIKE "% -a %" OR process.command_line LIKE "% -c %")) AND (process.command_line RLIKE ":[^ \\\\]"))))
