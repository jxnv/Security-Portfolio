// Title: Audio Capture via PowerShell
// ID: 932fb0d8-692b-4b0f-a26e-5643a50fe7d6
// Status: test
// Level: medium
// Author: E.M. Anhaus (originally from Atomic Blue Detections, Endgame), oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-10-24
// Tags: attack.collection, attack.t1123
// Description: Detects audio capture via PowerShell Cmdlet.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.command_line LIKE "%WindowsAudioDevice-Powershell-Cmdlet%" OR process.command_line LIKE "%Toggle-AudioDevice%" OR process.command_line LIKE "%Get-AudioDevice %" OR process.command_line LIKE "%Set-AudioDevice %" OR process.command_line LIKE "%Write-AudioDevice %"))
