// Title: Unusual Parent Process For Cmd.EXE
// ID: 4b991083-3d0e-44ce-8fc4-b254025d8d4b
// Status: test
// Level: medium
// Author: Tim Rauch, Elastic (idea)
// Date: 2022-09-21
// Tags: attack.execution, attack.t1059
// Description: Detects suspicious parent process for cmd.exe
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (process.executable LIKE "%\\cmd.exe" AND (process.parent.executable LIKE "%\\csrss.exe" OR process.parent.executable LIKE "%\\ctfmon.exe" OR process.parent.executable LIKE "%\\dllhost.exe" OR process.parent.executable LIKE "%\\epad.exe" OR process.parent.executable LIKE "%\\FlashPlayerUpdateService.exe" OR process.parent.executable LIKE "%\\GoogleUpdate.exe" OR process.parent.executable LIKE "%\\jucheck.exe" OR process.parent.executable LIKE "%\\jusched.exe" OR process.parent.executable LIKE "%\\LogonUI.exe" OR process.parent.executable LIKE "%\\lsass.exe" OR process.parent.executable LIKE "%\\regsvr32.exe" OR process.parent.executable LIKE "%\\SearchIndexer.exe" OR process.parent.executable LIKE "%\\SearchProtocolHost.exe" OR process.parent.executable LIKE "%\\SIHClient.exe" OR process.parent.executable LIKE "%\\sihost.exe" OR process.parent.executable LIKE "%\\slui.exe" OR process.parent.executable LIKE "%\\spoolsv.exe" OR process.parent.executable LIKE "%\\sppsvc.exe" OR process.parent.executable LIKE "%\\taskhostw.exe" OR process.parent.executable LIKE "%\\unsecapp.exe" OR process.parent.executable LIKE "%\\WerFault.exe" OR process.parent.executable LIKE "%\\wermgr.exe" OR process.parent.executable LIKE "%\\wlanext.exe" OR process.parent.executable LIKE "%\\WUDFHost.exe"))
