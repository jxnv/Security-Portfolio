// Title: Rundll32 Execution With Uncommon DLL Extension
// ID: c3a99af4-35a9-4668-879e-c09aeb4f2bdf
// Status: test
// Level: medium
// Author: Tim Shelton, Florian Roth (Nextron Systems), Yassine Oukessou
// Date: 2022-01-13
// Tags: attack.stealth, attack.t1218.011
// Description: Detects the execution of rundll32 with a command line that doesn't contain a common extension
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%\\rundll32.exe") OR (process.pe.original_file_name == "RUNDLL32.EXE")) AND NOT (((process.command_line == "") OR (((process.command_line LIKE "%.cpl %" OR process.command_line LIKE "%.cpl,%" OR process.command_line LIKE "%.cpl\"%" OR process.command_line LIKE "%.cpl'%" OR process.command_line LIKE "%.dll %" OR process.command_line LIKE "%.dll,%" OR process.command_line LIKE "%.dll\"%" OR process.command_line LIKE "%.dll'%" OR process.command_line LIKE "%.inf %" OR process.command_line LIKE "%.inf,%" OR process.command_line LIKE "%.inf\"%" OR process.command_line LIKE "%.inf'%")) OR ((process.command_line LIKE "%.cpl" OR process.command_line LIKE "%.dll" OR process.command_line LIKE "%.inf"))) OR (process.command_line LIKE "% -localserver %") OR (process.command_line IS NULL) OR (process.parent.executable LIKE "%\\msiexec.exe" AND (process.command_line LIKE "%:\\Windows\\Installer\\%" AND process.command_line LIKE "%.tmp%" AND process.command_line LIKE "%zzzzInvokeManagedCustomActionOutOfProc%")))) AND NOT (((process.parent.command_line LIKE "%:\\Users\\%" AND process.parent.command_line LIKE "%\\AppData\\Local\\Microsoft\\EdgeUpdate\\Install\\{%" AND process.parent.command_line LIKE "%\\EDGEMITMP_%" AND process.parent.command_line LIKE "%.tmp\\setup.exe%" AND process.parent.command_line LIKE "%--install-archive=%" AND process.parent.command_line LIKE "%--previous-version=%" AND process.parent.command_line LIKE "%--msedgewebview --verbose-logging --do-not-launch-msedge --user-level%"))))
