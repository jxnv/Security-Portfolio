// Title: Invoke-Obfuscation VAR++ LAUNCHER OBFUSCATION
// ID: e9f55347-2928-4c06-88e5-1a7f8169942e
// Status: test
// Level: high
// Author: Timur Zinniatullin, oscd.community
// Date: 2020-10-13
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via VAR++ LAUNCHER
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.command_line LIKE "%&&set%" AND process.command_line LIKE "%cmd%" AND process.command_line LIKE "%/c%" AND process.command_line LIKE "%-f%") AND (process.command_line LIKE "%{0}%" OR process.command_line LIKE "%{1}%" OR process.command_line LIKE "%{2}%" OR process.command_line LIKE "%{3}%" OR process.command_line LIKE "%{4}%" OR process.command_line LIKE "%{5}%"))
