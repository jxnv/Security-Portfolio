// Title: Suspicious File Download From IP Via Curl.EXE
// ID: 5cb299fc-5fb1-4d07-b989-0644c68b6043
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-07-27
// Tags: attack.execution
// Description: Detects potentially suspicious file downloads directly from IP addresses using curl.exe
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "%.bat" OR process.command_line LIKE "%.bat\"" OR process.command_line LIKE "%.dat" OR process.command_line LIKE "%.dat\"" OR process.command_line LIKE "%.dll" OR process.command_line LIKE "%.dll\"" OR process.command_line LIKE "%.exe" OR process.command_line LIKE "%.exe\"" OR process.command_line LIKE "%.gif" OR process.command_line LIKE "%.gif\"" OR process.command_line LIKE "%.hta" OR process.command_line LIKE "%.hta\"" OR process.command_line LIKE "%.jpeg" OR process.command_line LIKE "%.jpeg\"" OR process.command_line LIKE "%.log" OR process.command_line LIKE "%.log\"" OR process.command_line LIKE "%.msi" OR process.command_line LIKE "%.msi\"" OR process.command_line LIKE "%.png" OR process.command_line LIKE "%.png\"" OR process.command_line LIKE "%.ps1" OR process.command_line LIKE "%.ps1\"" OR process.command_line LIKE "%.psm1" OR process.command_line LIKE "%.psm1\"" OR process.command_line LIKE "%.vbe" OR process.command_line LIKE "%.vbe\"" OR process.command_line LIKE "%.vbs" OR process.command_line LIKE "%.vbs\"" OR process.command_line LIKE "%.bat'" OR process.command_line LIKE "%.dat'" OR process.command_line LIKE "%.dll'" OR process.command_line LIKE "%.exe'" OR process.command_line LIKE "%.gif'" OR process.command_line LIKE "%.hta'" OR process.command_line LIKE "%.jpeg'" OR process.command_line LIKE "%.log'" OR process.command_line LIKE "%.msi'" OR process.command_line LIKE "%.png'" OR process.command_line LIKE "%.ps1'" OR process.command_line LIKE "%.psm1'" OR process.command_line LIKE "%.vbe'" OR process.command_line LIKE "%.vbs'")) AND ((process.command_line LIKE "% -O%" OR process.command_line LIKE "%--remote-name%" OR process.command_line LIKE "%--output%")) AND (process.command_line LIKE "%http%") AND ((process.executable LIKE "%\\curl.exe") OR (process.pe.original_file_name == "curl.exe")) AND (process.command_line RLIKE "://[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}"))
