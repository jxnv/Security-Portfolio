// Title: DumpMinitool Execution
// ID: dee0a7a3-f200-4112-a99b-952196d81e42
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Florian Roth (Nextron Systems)
// Date: 2022-04-06
// Tags: attack.stealth, attack.t1036, attack.t1003.001, attack.credential-access
// Description: Detects the use of "DumpMinitool.exe" a tool that allows the dump of process memory via the use of the "MiniDumpWriteDump"
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.command_line LIKE "% Full%" OR process.command_line LIKE "% Mini%" OR process.command_line LIKE "% WithHeap%")) AND (((process.executable LIKE "%\\DumpMinitool.exe" OR process.executable LIKE "%\\DumpMinitool.x86.exe" OR process.executable LIKE "%\\DumpMinitool.arm64.exe")) OR ((process.pe.original_file_name == "DumpMinitool.exe" OR process.pe.original_file_name == "DumpMinitool.x86.exe" OR process.pe.original_file_name == "DumpMinitool.arm64.exe"))))
