// Title: HackTool - Certipy Execution
// ID: 6938366d-8954-4ddc-baff-c830b3ba8fcd
// Status: test
// Level: high
// Author: pH-T (Nextron Systems), Sittikorn Sangrattanapitak
// Date: 2023-04-17
// Tags: attack.discovery, attack.credential-access, attack.t1649
// Description: Detects Certipy execution, a tool for Active Directory Certificate Services enumeration and abuse based on PE metadata characteristics and common command line arguments.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%\\Certipy.exe") OR (process.pe.original_file_name == "Certipy.exe") OR (Description LIKE "%Certipy%")) OR (((process.command_line LIKE "% account %" OR process.command_line LIKE "% auth %" OR process.command_line LIKE "% cert %" OR process.command_line LIKE "% find %" OR process.command_line LIKE "% forge %" OR process.command_line LIKE "% ptt %" OR process.command_line LIKE "% relay %" OR process.command_line LIKE "% req %" OR process.command_line LIKE "% shadow %" OR process.command_line LIKE "% template %")) AND ((process.command_line LIKE "% -bloodhound%" OR process.command_line LIKE "% -ca-pfx %" OR process.command_line LIKE "% -dc-ip %" OR process.command_line LIKE "% -kirbi%" OR process.command_line LIKE "% -old-bloodhound%" OR process.command_line LIKE "% -pfx %" OR process.command_line LIKE "% -target%" OR process.command_line LIKE "% -template%" OR process.command_line LIKE "% -username %" OR process.command_line LIKE "% -vulnerable%" OR process.command_line LIKE "%auth -pfx%" OR process.command_line LIKE "%shadow auto%" OR process.command_line LIKE "%shadow list%"))))
