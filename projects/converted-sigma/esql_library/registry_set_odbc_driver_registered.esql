// Title: New ODBC Driver Registered
// ID: 3390fbef-c98d-4bdd-a863-d65ed7c610dd
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-23
// Tags: attack.persistence
// Description: Detects the registration of a new ODBC driver.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((registry.path LIKE "%\\SOFTWARE\\ODBC\\ODBCINST.INI\\%" AND registry.path LIKE "%\\Driver") AND NOT ((registry.path LIKE "%\\SQL Server\\%" AND registry.data.strings == "%WINDIR%\\System32\\SQLSRV32.dll")) AND NOT (((registry.path LIKE "%\\Microsoft Access %" AND registry.data.strings LIKE "C:\\Progra%" AND registry.data.strings LIKE "%\\ACEODBC.DLL") OR (registry.path LIKE "%\\Microsoft Excel Driver%" AND registry.data.strings LIKE "C:\\Progra%" AND registry.data.strings LIKE "%\\ACEODBC.DLL"))))
