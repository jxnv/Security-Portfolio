// Title: Potential Binary Or Script Dropper Via PowerShell
// ID: 7047d730-036f-4f40-b9d8-1c63e36d5e62
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-03-17
// Tags: attack.persistence
// Description: Detects PowerShell creating a binary executable or a script file.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\powershell_ise.exe" OR process.executable LIKE "%\\pwsh.exe") AND (file.path LIKE "%.bat" OR file.path LIKE "%.chm" OR file.path LIKE "%.cmd" OR file.path LIKE "%.com" OR file.path LIKE "%.dll" OR file.path LIKE "%.exe" OR file.path LIKE "%.hta" OR file.path LIKE "%.jar" OR file.path LIKE "%.js" OR file.path LIKE "%.ocx" OR file.path LIKE "%.scr" OR file.path LIKE "%.sys" OR file.path LIKE "%.vbe" OR file.path LIKE "%.vbs" OR file.path LIKE "%.wsf")) AND NOT (((file.path LIKE "C:\\Program Files\\PackageManagement\\ProviderAssemblies\\nuget\\%" AND file.path LIKE "%\\Microsoft.PackageManagement.NuGetProvider.dll") OR ((file.path LIKE "C:\\Windows\\Temp\\%" OR file.path LIKE "C:\\Windows\\SystemTemp\\%") AND (file.path LIKE "%.dll" OR file.path LIKE "%.exe")) OR (file.path LIKE "C:\\Users\\%" AND file.path LIKE "%\\WindowsPowerShell\\Modules\\%" AND file.path LIKE "%.dll") OR (file.path LIKE "C:\\Users\\%" AND file.path LIKE "%\\AppData\\Local\\Temp\\%" AND (file.path LIKE "%.dll" OR file.path LIKE "%.exe")))))
