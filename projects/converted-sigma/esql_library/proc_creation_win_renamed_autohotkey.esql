// Title: Renamed AutoHotkey.EXE Execution
// ID: 0f16d9cf-0616-45c8-8fad-becc11b5a41c
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali
// Date: 2023-02-07
// Tags: attack.stealth
// Description: Detects execution of a renamed autohotkey.exe binary based on PE metadata fields
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((Product LIKE "%AutoHotkey%") OR (Description LIKE "%AutoHotkey%") OR ((process.pe.original_file_name == "AutoHotkey.exe" OR process.pe.original_file_name == "AutoHotkey.rc"))) AND NOT ((((process.executable LIKE "%\\AutoHotkey.exe" OR process.executable LIKE "%\\AutoHotkey32.exe" OR process.executable LIKE "%\\AutoHotkey32_UIA.exe" OR process.executable LIKE "%\\AutoHotkey64.exe" OR process.executable LIKE "%\\AutoHotkey64_UIA.exe" OR process.executable LIKE "%\\AutoHotkeyA32.exe" OR process.executable LIKE "%\\AutoHotkeyA32_UIA.exe" OR process.executable LIKE "%\\AutoHotkeyU32.exe" OR process.executable LIKE "%\\AutoHotkeyU32_UIA.exe" OR process.executable LIKE "%\\AutoHotkeyU64.exe" OR process.executable LIKE "%\\AutoHotkeyU64_UIA.exe")) OR (process.executable LIKE "%\\AutoHotkey%"))))
