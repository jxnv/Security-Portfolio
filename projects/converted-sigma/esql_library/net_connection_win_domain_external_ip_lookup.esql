// Title: Suspicious Network Connection to IP Lookup Service APIs
// ID: edf3485d-dac4-4d50-90e4-b0e5813f7e60
// Status: test
// Level: medium
// Author: Janantha Marasinghe, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-24
// Tags: attack.discovery, attack.t1016
// Description: Detects external IP address lookups by non-browser processes via services such as "api.ipify.org". This could be indicative of potential post compromise internet test activity.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((DestinationHostname == "www.ip.cn" OR DestinationHostname == "l2.io")) OR ((DestinationHostname LIKE "%api.2ip.ua%" OR DestinationHostname LIKE "%api.bigdatacloud.net%" OR DestinationHostname LIKE "%api.ipify.org%" OR DestinationHostname LIKE "%bot.whatismyipaddress.com%" OR DestinationHostname LIKE "%canireachthe.net%" OR DestinationHostname LIKE "%checkip.amazonaws.com%" OR DestinationHostname LIKE "%checkip.dyndns.org%" OR DestinationHostname LIKE "%curlmyip.com%" OR DestinationHostname LIKE "%db-ip.com%" OR DestinationHostname LIKE "%edns.ip-api.com%" OR DestinationHostname LIKE "%eth0.me%" OR DestinationHostname LIKE "%freegeoip.app%" OR DestinationHostname LIKE "%geoipy.com%" OR DestinationHostname LIKE "%getip.pro%" OR DestinationHostname LIKE "%icanhazip.com%" OR DestinationHostname LIKE "%ident.me%" OR DestinationHostname LIKE "%ifconfig.io%" OR DestinationHostname LIKE "%ifconfig.me%" OR DestinationHostname LIKE "%ip-api.com%" OR DestinationHostname LIKE "%ip.360.cn%" OR DestinationHostname LIKE "%ip.anysrc.net%" OR DestinationHostname LIKE "%ip.taobao.com%" OR DestinationHostname LIKE "%ip.tyk.nu%" OR DestinationHostname LIKE "%ipaddressworld.com%" OR DestinationHostname LIKE "%ipapi.co%" OR DestinationHostname LIKE "%ipconfig.io%" OR DestinationHostname LIKE "%ipecho.net%" OR DestinationHostname LIKE "%ipinfo.io%" OR DestinationHostname LIKE "%ipip.net%" OR DestinationHostname LIKE "%ipof.in%" OR DestinationHostname LIKE "%ipv4.icanhazip.com%" OR DestinationHostname LIKE "%ipv4bot.whatismyipaddress.com%" OR DestinationHostname LIKE "%ipv6-test.com%" OR DestinationHostname LIKE "%ipwho.is%" OR DestinationHostname LIKE "%jsonip.com%" OR DestinationHostname LIKE "%myexternalip.com%" OR DestinationHostname LIKE "%seeip.org%" OR DestinationHostname LIKE "%wgetip.com%" OR DestinationHostname LIKE "%whatismyip.akamai.com%" OR DestinationHostname LIKE "%whois.pconline.com.cn%" OR DestinationHostname LIKE "%wtfismyip.com%"))) AND NOT (((process.executable LIKE "%\\brave.exe") OR ((process.executable == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR process.executable == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((process.executable LIKE "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\%") OR (process.executable LIKE "%\\WindowsApps\\MicrosoftEdge.exe") OR ((process.executable == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR process.executable == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process.executable LIKE "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\%" OR process.executable LIKE "C:\\Program Files\\Microsoft\\EdgeCore\\%") AND (process.executable LIKE "%\\msedge.exe" OR process.executable LIKE "%\\msedgewebview2.exe")) OR ((process.executable == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR process.executable == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR ((process.executable == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR process.executable == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process.executable LIKE "%\\maxthon.exe") OR (process.executable LIKE "%\\opera.exe") OR (process.executable LIKE "%\\safari.exe") OR (process.executable LIKE "%\\seamonkey.exe") OR (process.executable LIKE "%\\vivaldi.exe") OR (process.executable LIKE "%\\whale.exe"))))
