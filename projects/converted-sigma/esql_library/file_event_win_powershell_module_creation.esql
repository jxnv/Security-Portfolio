// Title: PowerShell Module File Created
// ID: e36941d0-c0f0-443f-bc6f-cb2952eb69ea
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-09
// Tags: attack.persistence
// Description: Detects the creation of a new PowerShell module ".psm1", ".psd1", ".dll", ".ps1", etc.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe") AND (file.path LIKE "%\\WindowsPowerShell\\Modules\\%" OR file.path LIKE "%\\PowerShell\\7\\Modules\\%"))
