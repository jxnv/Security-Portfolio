// Title: Script Interpreter Execution From Suspicious Folder
// ID: 1228c958-e64e-4e71-92ad-7d429f4138ba
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-02-08
// Tags: attack.execution, attack.t1059
// Description: Detects suspicious script execution from suspicious directories or folders accessible by environment variables that may indicate malware activity.
// Script interpreters (cscript, wscript, mshta, powershell) executing from folders like Temp, Public, or user profile directories may suggest attempts to evade detection or execute malicious scripts.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.command_line LIKE "% -ep bypass %" OR process.command_line LIKE "% -ExecutionPolicy bypass %" OR process.command_line LIKE "% -w hidden %" OR process.command_line LIKE "%/e:javascript %" OR process.command_line LIKE "%/e:Jscript %" OR process.command_line LIKE "%/e:vbscript %")) OR ((process.executable LIKE "%\\cscript.exe" OR process.executable LIKE "%\\mshta.exe" OR process.executable LIKE "%\\wscript.exe")) OR ((process.pe.original_file_name == "cscript.exe" OR process.pe.original_file_name == "mshta.exe" OR process.pe.original_file_name == "wscript.exe"))) AND (((process.command_line LIKE "%:\\Perflogs\\%" OR process.command_line LIKE "%:\\Users\\Public\\%" OR process.command_line LIKE "%\\%Public%%" OR process.command_line LIKE "%\\AppData\\Local\\Temp%" OR process.command_line LIKE "%\\AppData\\Roaming\\Temp%" OR process.command_line LIKE "%\\Temporary Internet%" OR process.command_line LIKE "%\\Windows\\Temp%" OR process.command_line LIKE "%\\Start Menu\\Programs\\Startup\\%" OR process.command_line LIKE "%%TEMP%%" OR process.command_line LIKE "%%TMP%%" OR process.command_line LIKE "%%LocalAppData%\\Temp%")) OR (((process.command_line LIKE "%:\\Users\\%" AND process.command_line LIKE "%\\Favorites\\%")) OR ((process.command_line LIKE "%:\\Users\\%" AND process.command_line LIKE "%\\Favourites\\%")) OR ((process.command_line LIKE "%:\\Users\\%" AND process.command_line LIKE "%\\Contacts\\%")) OR ((process.command_line LIKE "%:\\Users\\%" AND process.command_line LIKE "%\\Documents\\%")) OR ((process.command_line LIKE "%:\\Users\\%" AND process.command_line LIKE "%\\Music\\%")) OR ((process.command_line LIKE "%:\\Users\\%" AND process.command_line LIKE "%\\Pictures\\%")) OR ((process.command_line LIKE "%:\\Users\\%" AND process.command_line LIKE "%\\Videos\\%")))) AND NOT (((process.parent.executable == "C:\\Windows\\System32\\Msiexec.exe" OR process.parent.executable == "C:\\Windows\\SysWOW64\\Msiexec.exe") AND process.executable LIKE "%\\powershell.exe" AND (process.command_line LIKE "%-NoProfile -ExecutionPolicy Bypass -Command%" AND process.command_line LIKE "%AppData\\Local\\Temp\\%" AND process.command_line LIKE "%Install-Chocolatey.ps1%"))))
