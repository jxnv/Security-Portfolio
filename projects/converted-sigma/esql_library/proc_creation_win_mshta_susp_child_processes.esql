// Title: Suspicious MSHTA Child Process
// ID: 03cc0c25-389f-4bf8-b48d-11878079f1ca
// Status: test
// Level: high
// Author: Michael Haag
// Date: 2019-01-16
// Tags: attack.stealth, attack.t1218.005, car.2013-02-003, car.2013-03-001, car.2014-04-003
// Description: Detects a suspicious process spawning from an "mshta.exe" process, which could be indicative of a malicious HTA script execution
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.executable LIKE "%\\cmd.exe" OR process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe" OR process.executable LIKE "%\\wscript.exe" OR process.executable LIKE "%\\cscript.exe" OR process.executable LIKE "%\\sh.exe" OR process.executable LIKE "%\\bash.exe" OR process.executable LIKE "%\\reg.exe" OR process.executable LIKE "%\\regsvr32.exe" OR process.executable LIKE "%\\bitsadmin.exe")) OR ((process.pe.original_file_name == "Cmd.Exe" OR process.pe.original_file_name == "PowerShell.EXE" OR process.pe.original_file_name == "pwsh.dll" OR process.pe.original_file_name == "wscript.exe" OR process.pe.original_file_name == "cscript.exe" OR process.pe.original_file_name == "Bash.exe" OR process.pe.original_file_name == "reg.exe" OR process.pe.original_file_name == "REGSVR32.EXE" OR process.pe.original_file_name == "bitsadmin.exe"))) AND (process.parent.executable LIKE "%\\mshta.exe"))
