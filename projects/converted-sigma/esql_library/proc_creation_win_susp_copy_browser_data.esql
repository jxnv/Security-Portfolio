// Title: Potential Browser Data Stealing
// ID: 47147b5b-9e17-4d76-b8d2-7bac24c5ce1b
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-23
// Tags: attack.credential-access, attack.t1555.003
// Description: Adversaries may acquire credentials from web browsers by reading files specific to the target browser.
// Web browsers commonly save credentials such as website usernames and passwords so that they do not need to be entered manually in the future.
// Web browsers typically store the credentials in an encrypted format within a credential store.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.command_line LIKE "%copy-item%" OR process.command_line LIKE "%copy %" OR process.command_line LIKE "%cpi %" OR process.command_line LIKE "% cp %" OR process.command_line LIKE "%move %" OR process.command_line LIKE "%move-item%" OR process.command_line LIKE "% mi %" OR process.command_line LIKE "% mv %")) OR ((process.executable LIKE "%\\esentutl.exe" OR process.executable LIKE "%\\xcopy.exe" OR process.executable LIKE "%\\robocopy.exe")) OR ((process.pe.original_file_name == "esentutl.exe" OR process.pe.original_file_name == "XCOPY.EXE" OR process.pe.original_file_name == "robocopy.exe"))) AND ((process.command_line LIKE "%\\Amigo\\User Data%" OR process.command_line LIKE "%\\BraveSoftware\\Brave-Browser\\User Data%" OR process.command_line LIKE "%\\CentBrowser\\User Data%" OR process.command_line LIKE "%\\Chromium\\User Data%" OR process.command_line LIKE "%\\CocCoc\\Browser\\User Data%" OR process.command_line LIKE "%\\Comodo\\Dragon\\User Data%" OR process.command_line LIKE "%\\Elements Browser\\User Data%" OR process.command_line LIKE "%\\Epic Privacy Browser\\User Data%" OR process.command_line LIKE "%\\Google\\Chrome Beta\\User Data%" OR process.command_line LIKE "%\\Google\\Chrome SxS\\User Data%" OR process.command_line LIKE "%\\Google\\Chrome\\User Data\\%" OR process.command_line LIKE "%\\Kometa\\User Data%" OR process.command_line LIKE "%\\Maxthon5\\Users%" OR process.command_line LIKE "%\\Microsoft\\Edge\\User Data%" OR process.command_line LIKE "%\\Mozilla\\Firefox\\Profiles%" OR process.command_line LIKE "%\\Nichrome\\User Data%" OR process.command_line LIKE "%\\Opera Software\\Opera GX Stable\\%" OR process.command_line LIKE "%\\Opera Software\\Opera Neon\\User Data%" OR process.command_line LIKE "%\\Opera Software\\Opera Stable\\%" OR process.command_line LIKE "%\\Orbitum\\User Data%" OR process.command_line LIKE "%\\QIP Surf\\User Data%" OR process.command_line LIKE "%\\Sputnik\\User Data%" OR process.command_line LIKE "%\\Torch\\User Data%" OR process.command_line LIKE "%\\uCozMedia\\Uran\\User Data%" OR process.command_line LIKE "%\\Vivaldi\\User Data%")))
