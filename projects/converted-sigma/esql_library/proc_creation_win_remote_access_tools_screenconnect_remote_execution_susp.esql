// Title: Remote Access Tool - ScreenConnect Potential Suspicious Remote Command Execution
// ID: 7b582f1a-b318-4c6a-bf4e-66fe49bf55a5
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems), @Kostastsale
// Date: 2022-02-25
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects potentially suspicious child processes launched via the ScreenConnect client service.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((process.parent.command_line LIKE "%:\\Windows\\TEMP\\ScreenConnect\\%" AND process.parent.command_line LIKE "%run.cmd%") AND (process.executable LIKE "%\\bitsadmin.exe" OR process.executable LIKE "%\\cmd.exe" OR process.executable LIKE "%\\curl.exe" OR process.executable LIKE "%\\dllhost.exe" OR process.executable LIKE "%\\net.exe" OR process.executable LIKE "%\\nltest.exe" OR process.executable LIKE "%\\powershell.exe" OR process.executable LIKE "%\\pwsh.exe" OR process.executable LIKE "%\\rundll32.exe" OR process.executable LIKE "%\\wevtutil.exe"))
