"%crypto-pools.org" OR query LIKE "%monero.net" OR query LIKE "%backup-pool.com" OR query LIKE "%mooo.com" OR query LIKE "%freeyy.me" OR query LIKE "%cryptonight.net" OR query LIKE "%shscrypto.net")) AND NOT ((((answers == "127.0.0.1" OR answers == "0.0.0.0")) OR (rejected == "true"))))
