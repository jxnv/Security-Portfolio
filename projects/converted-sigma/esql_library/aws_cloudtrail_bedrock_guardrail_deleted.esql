// Title: AWS Bedrock Guardrail Deleted
// ID: 59b70e4d-dd17-44a9-b740-acf07ae3eb6a
// Status: experimental
// Level: medium
// Author: Marco Pedrinazzi (@pedrinazziM) (InTheCyber)
// Date: 2026-07-10
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects deletion of an Amazon Bedrock guardrail, which may indicate attempts to remove
// model safety controls and allow unsafe or unauthorized model responses.
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (eventName == "DeleteGuardrail" AND eventSource == "bedrock.amazonaws.com")
