// Title: DriverQuery.EXE Execution
// ID: a20def93-0709-4eae-9bd2-31206e21e6b2
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-19
// Tags: attack.discovery
// Description: Detect usage of the "driverquery" utility. Which can be used to perform reconnaissance on installed drivers
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE (((process.executable LIKE "%driverquery.exe") OR (process.pe.original_file_name == "drvqry.exe")) AND NOT ((((process.parent.executable LIKE "%\\cscript.exe" OR process.parent.executable LIKE "%\\mshta.exe" OR process.parent.executable LIKE "%\\regsvr32.exe" OR process.parent.executable LIKE "%\\rundll32.exe" OR process.parent.executable LIKE "%\\wscript.exe")) OR ((process.parent.executable LIKE "%\\AppData\\Local\\%" OR process.parent.executable LIKE "%\\Users\\Public\\%" OR process.parent.executable LIKE "%\\Windows\\Temp\\%")))))
