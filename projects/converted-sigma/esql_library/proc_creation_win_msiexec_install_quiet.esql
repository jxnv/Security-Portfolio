// Title: Msiexec Quiet Installation
// ID: 79a87aa6-e4bd-42fc-a5bb-5e6fbdcd62f5
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-01-16
// Tags: attack.stealth, attack.t1218.007
// Description: Adversaries may abuse msiexec.exe to proxy execution of malicious payloads.
// Msiexec.exe is the command-line utility for the Windows Installer and is thus commonly associated with executing installation packages (.msi)
// Converted by: Sigma Universal SIEM/EDR CLI

FROM logs-* | WHERE ((((process.command_line LIKE "%-i%" OR process.command_line LIKE "%/i%" OR process.command_line LIKE "%-package%" OR process.command_line LIKE "%/package%" OR process.command_line LIKE "%-a%" OR process.command_line LIKE "%/a%" OR process.command_line LIKE "%-j%" OR process.command_line LIKE "%/j%")) AND ((process.executable LIKE "%\\msiexec.exe") OR (process.pe.original_file_name == "msiexec.exe")) AND ((process.command_line LIKE "%-q%" OR process.command_line LIKE "%/q%"))) AND NOT (((process.parent.executable == "C:\\Windows\\CCM\\Ccm32BitLauncher.exe" AND (IntegrityLevel == "System" OR IntegrityLevel == "S-1-16-16384")) OR (process.parent.executable LIKE "C:\\Windows\\Temp\\%"))) AND NOT (((process.parent.executable LIKE "C:\\Users\\%" AND process.parent.executable LIKE "%\\AppData\\Local\\Temp\\%") OR (process.parent.executable LIKE "%C:\\Windows\\System32\\wsl.exe" AND process.executable LIKE "%C:\\Windows\\System32\\msiexec.exe"))))
