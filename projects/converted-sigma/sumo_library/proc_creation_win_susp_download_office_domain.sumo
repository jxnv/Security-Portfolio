// Title: Suspicious Download from Office Domain
// ID: 00d49ed5-4491-4271-a8db-650a4ef6f8c1
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-12-27
// Tags: attack.command-and-control, attack.resource-development, attack.t1105, attack.t1608
// Description: Detects suspicious ways to download files from Microsoft domains that are used to store attachments in Emails or OneNote documents
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*https://attachment.outlook.live.net/owa/*" or CommandLine matches "*https://onenoteonlinesync.onenote.com/onenoteonlinesync/*")) and (((Image matches "*\\curl.exe" or Image matches "*\\wget.exe")) or ((CommandLine matches "*Invoke-WebRequest*" or CommandLine matches "*iwr *" or CommandLine matches "*curl *" or CommandLine matches "*wget *" or CommandLine matches "*Start-BitsTransfer*" or CommandLine matches "*.DownloadFile(*" or CommandLine matches "*.DownloadString(*"))))
