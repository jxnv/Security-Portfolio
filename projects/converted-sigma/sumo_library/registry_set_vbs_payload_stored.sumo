// Title: VBScript Payload Stored in Registry
// ID: 46490193-1b22-4c29-bdd6-5bf63907216f
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-03-05
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects VBScript content stored into registry keys as seen being used by UNC2452 group
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((TargetObject matches "*Software\\Microsoft\\Windows\\CurrentVersion*" and (Details matches "*vbscript:*" or Details matches "*jscript:*" or Details matches "*mshtml,*" or Details matches "*RunHTMLApplication*" or Details matches "*Execute(*" or Details matches "*CreateObject*" or Details matches "*window.close*")) and !(((TargetObject matches "*Software\\Microsoft\\Windows\\CurrentVersion\\Run*") or (Image matches "*\\msiexec.exe" and TargetObject matches "*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Installer\\UserData\\*" and (Details matches "*\\Microsoft.NET\\Primary Interop Assemblies\\Microsoft.mshtml.dll*" or Details matches "*<\\Microsoft.mshtml,fileVersion=*" or Details matches "*_mshtml_dll_*" or Details matches "*<\\Microsoft.mshtml,culture=*")))))
