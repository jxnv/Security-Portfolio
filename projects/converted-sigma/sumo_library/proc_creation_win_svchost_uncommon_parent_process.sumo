// Title: Uncommon Svchost Parent Process
// ID: 01d2e2a1-5f09-44f7-9fc1-24faa7479b6d
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2017-08-15
// Tags: attack.stealth, attack.t1036.005
// Description: Detects an uncommon svchost parent process
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\svchost.exe") and !((((ParentImage matches "*\\Mrt.exe" or ParentImage matches "*\\MsMpEng.exe" or ParentImage matches "*\\ngen.exe" or ParentImage matches "*\\rpcnet.exe" or ParentImage matches "*\\services.exe" or ParentImage matches "*\\TiWorker.exe")) or ((ParentImage = "-" or ParentImage = "")) or (isNull(ParentImage)))))
