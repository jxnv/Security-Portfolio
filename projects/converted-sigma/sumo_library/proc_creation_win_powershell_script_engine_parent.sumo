// Title: Suspicious PowerShell Invocation From Script Engines
// ID: 95eadcb2-92e4-4ed1-9031-92547773a6db
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2019-01-16
// Tags: attack.execution, attack.t1059.001
// Description: Detects suspicious powershell invocations from interpreters or unusual programs
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((ParentImage matches "*\\wscript.exe" or ParentImage matches "*\\cscript.exe") and (Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe")) and !((CurrentDirectory matches "*\\Health Service State\\*")))
