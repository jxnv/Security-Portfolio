// Title: File With Uncommon Extension Created By An Office Application
// ID: c7a74c80-ba5a-486e-9974-ab9e682bc5e4
// Status: test
// Level: high
// Author: Vadim Khrykov (ThreatIntel), Cyb3rEng (Rule), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-08-23
// Tags: attack.t1204.002, attack.execution
// Description: Detects the creation of files with an executable or script extension by an Office application.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((Image matches "*\\excel.exe" or Image matches "*\\msaccess.exe" or Image matches "*\\mspub.exe" or Image matches "*\\powerpnt.exe" or Image matches "*\\visio.exe" or Image matches "*\\winword.exe")) and ((TargetFilename matches "*.bat" or TargetFilename matches "*.cmd" or TargetFilename matches "*.com" or TargetFilename matches "*.dll" or TargetFilename matches "*.exe" or TargetFilename matches "*.hta" or TargetFilename matches "*.ocx" or TargetFilename matches "*.proj" or TargetFilename matches "*.ps1" or TargetFilename matches "*.scf" or TargetFilename matches "*.scr" or TargetFilename matches "*.sys" or TargetFilename matches "*.vbe" or TargetFilename matches "*.vbs" or TargetFilename matches "*.wsf" or TargetFilename matches "*.wsh"))) and !((TargetFilename matches "*\\AppData\\Local\\assembly\\tmp\\*" and TargetFilename matches "*.dll")) and !((((TargetFilename matches "*C:\\Users\\*" and TargetFilename matches "*\\AppData\\Local\\Microsoft\\Office\\*" and TargetFilename matches "*\\BackstageInAppNavCache\\*") and TargetFilename matches "*.com") or (Image matches "*\\winword.exe" and TargetFilename matches "*\\AppData\\Local\\Temp\\webexdelta\\*" and (TargetFilename matches "*.dll" or TargetFilename matches "*.exe")) or ((TargetFilename matches "*C:\\Users\\*" and TargetFilename matches "*\\AppData\\Local\\Microsoft\\Office\\*" and TargetFilename matches "*\\WebServiceCache\\AllUsers*") and TargetFilename matches "*.com"))))
