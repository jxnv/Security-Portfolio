// Title: Creation Of a Suspicious ADS File Outside a Browser Download
// ID: 573df571-a223-43bc-846e-3f98da481eca
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-10-22
// Tags: attack.stealth
// Description: Detects the creation of a suspicious ADS (Alternate Data Stream) file by software other than browsers
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Contents matches "[ZoneTransfer]  ZoneId=3*" and TargetFilename matches "*:Zone.Identifier" and (TargetFilename matches "*.exe*" or TargetFilename matches "*.scr*" or TargetFilename matches "*.bat*" or TargetFilename matches "*.cmd*" or TargetFilename matches "*.docx*" or TargetFilename matches "*.hta*" or TargetFilename matches "*.jse*" or TargetFilename matches "*.lnk*" or TargetFilename matches "*.pptx*" or TargetFilename matches "*.ps*" or TargetFilename matches "*.reg*" or TargetFilename matches "*.sct*" or TargetFilename matches "*.vb*" or TargetFilename matches "*.wsc*" or TargetFilename matches "*.wsf*" or TargetFilename matches "*.xlsx*")) and !(((Image matches "*\\brave.exe") or ((Image = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or Image = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or ((Image matches "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*") or (Image matches "*\\WindowsApps\\MicrosoftEdge.exe") or ((Image = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or Image = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((Image matches "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\*" or Image matches "C:\\Program Files\\Microsoft\\EdgeCore\\*") and (Image matches "*\\msedge.exe" or Image matches "*\\msedgewebview2.exe")) or ((Image = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or Image = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or ((Image = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or Image = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (Image matches "*\\maxthon.exe") or (Image matches "*\\opera.exe") or (Image matches "*\\safari.exe") or (Image matches "*\\seamonkey.exe") or (Image matches "C:\\Program Files\\WindowsApps\\Microsoft.ScreenSketch_*" and Image matches "*\\SnippingTool\\SnippingTool.exe" and TargetFilename matches "C:\\Users\\*" and (TargetFilename matches "*\\AppData\\Local\\Packages\\Microsoft.ScreenSketch_*" and TargetFilename matches "*\\TempState\\Screenshot *") and TargetFilename matches "*.png:Zone.Identifier") or (Image matches "*\\vivaldi.exe") or (Image matches "*\\whale.exe"))))
