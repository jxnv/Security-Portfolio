// Title: Suspicious Java Children Processes
// ID: d292e0af-9a18-420c-9525-ec0ac3936892
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-03
// Tags: attack.execution, attack.t1059
// Description: Detects java process spawning suspicious children
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (ParentImage matches "*/java" and (CommandLine matches "*/bin/sh*" or CommandLine matches "*bash*" or CommandLine matches "*dash*" or CommandLine matches "*ksh*" or CommandLine matches "*zsh*" or CommandLine matches "*csh*" or CommandLine matches "*fish*" or CommandLine matches "*curl*" or CommandLine matches "*wget*" or CommandLine matches "*python*"))
