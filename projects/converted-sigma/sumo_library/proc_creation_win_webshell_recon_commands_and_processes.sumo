// Title: Webshell Detection With Command Line Keywords
// ID: bed2a484-9348-4143-8a8a-b801c979301c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Jonhnathan Ribeiro, Anton Kutepov, oscd.community, Chad Hudson, Matt Anderson
// Date: 2017-01-01
// Tags: attack.persistence, attack.discovery, attack.t1505.003, attack.t1018, attack.t1033, attack.t1087
// Description: Detects certain command line parameters often used during reconnaissance activity via web shells
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((ParentImage matches "*\\java.exe" or ParentImage matches "*\\javaw.exe") and (ParentImage matches "*-tomcat-*" or ParentImage matches "*\\tomcat*")) or ((ParentImage matches "*\\java.exe" or ParentImage matches "*\\javaw.exe") and (CommandLine matches "*catalina.jar*" or CommandLine matches "*CATALINA_HOME*")) or ((ParentImage matches "*\\w3wp.exe" or ParentImage matches "*\\php-cgi.exe" or ParentImage matches "*\\nginx.exe" or ParentImage matches "*\\httpd.exe" or ParentImage matches "*\\caddy.exe" or ParentImage matches "*\\ws_tomcatservice.exe"))) and (((CommandLine matches "*&cd&echo*" or CommandLine matches "*cd /d *")) or (((Image matches "*\\dsquery.exe" or Image matches "*\\find.exe" or Image matches "*\\findstr.exe" or Image matches "*\\ipconfig.exe" or Image matches "*\\netstat.exe" or Image matches "*\\nslookup.exe" or Image matches "*\\pathping.exe" or Image matches "*\\quser.exe" or Image matches "*\\schtasks.exe" or Image matches "*\\systeminfo.exe" or Image matches "*\\tasklist.exe" or Image matches "*\\tracert.exe" or Image matches "*\\wevtutil.exe" or Image matches "*\\whoami.exe")) or ((OriginalFileName = "dsquery.exe" or OriginalFileName = "find.exe" or OriginalFileName = "findstr.exe" or OriginalFileName = "ipconfig.exe" or OriginalFileName = "netstat.exe" or OriginalFileName = "nslookup.exe" or OriginalFileName = "pathping.exe" or OriginalFileName = "quser.exe" or OriginalFileName = "schtasks.exe" or OriginalFileName = "sysinfo.exe" or OriginalFileName = "tasklist.exe" or OriginalFileName = "tracert.exe" or OriginalFileName = "VSSADMIN.EXE" or OriginalFileName = "wevtutil.exe" or OriginalFileName = "whoami.exe"))) or ((CommandLine matches "* Test-NetConnection *" or CommandLine matches "*dir \\*")) or ((OriginalFileName = "net.exe" or OriginalFileName = "net1.exe") and (CommandLine matches "* user *" or CommandLine matches "* use *" or CommandLine matches "* group *")) or (OriginalFileName = "ping.exe" and CommandLine matches "* -n *") or ((Image matches "*\\cmd.exe" or Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe") and (CommandLine matches "* -enc *" or CommandLine matches "* -EncodedCommand *" or CommandLine matches "* -w hidden *" or CommandLine matches "* -windowstyle hidden*" or CommandLine matches "*.WebClient).Download*")) or (OriginalFileName = "wmic.exe" and CommandLine matches "* /node:*")))
