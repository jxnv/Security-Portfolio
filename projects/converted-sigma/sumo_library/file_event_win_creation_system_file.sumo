// Title: Files With System Process Name In Unsuspected Locations
// ID: d5866ddf-ce8f-4aea-b28e-d96485a20d3d
// Status: test
// Level: medium
// Author: Sander Wiebing, Tim Shelton, Nasreddine Bencherchali (Nextron Systems)
// Date: 2020-05-26
// Tags: attack.stealth, attack.t1036.005
// Description: Detects the creation of an executable with a system process name in folders other than the system ones (System32, SysWOW64, etc.).
// It is highly recommended to perform an initial baseline before using this rule in production.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((TargetFilename matches "*\\AtBroker.exe" or TargetFilename matches "*\\audiodg.exe" or TargetFilename matches "*\\backgroundTaskHost.exe" or TargetFilename matches "*\\bcdedit.exe" or TargetFilename matches "*\\bitsadmin.exe" or TargetFilename matches "*\\cmdl32.exe" or TargetFilename matches "*\\cmstp.exe" or TargetFilename matches "*\\conhost.exe" or TargetFilename matches "*\\csrss.exe" or TargetFilename matches "*\\dasHost.exe" or TargetFilename matches "*\\dfrgui.exe" or TargetFilename matches "*\\dllhost.exe" or TargetFilename matches "*\\dwm.exe" or TargetFilename matches "*\\eventcreate.exe" or TargetFilename matches "*\\eventvwr.exe" or TargetFilename matches "*\\explorer.exe" or TargetFilename matches "*\\extrac32.exe" or TargetFilename matches "*\\fontdrvhost.exe" or TargetFilename matches "*\\fsquirt.exe" or TargetFilename matches "*\\ipconfig.exe" or TargetFilename matches "*\\iscsicli.exe" or TargetFilename matches "*\\iscsicpl.exe" or TargetFilename matches "*\\logman.exe" or TargetFilename matches "*\\LogonUI.exe" or TargetFilename matches "*\\LsaIso.exe" or TargetFilename matches "*\\lsass.exe" or TargetFilename matches "*\\lsm.exe" or TargetFilename matches "*\\msiexec.exe" or TargetFilename matches "*\\msinfo32.exe" or TargetFilename matches "*\\mstsc.exe" or TargetFilename matches "*\\nbtstat.exe" or TargetFilename matches "*\\odbcconf.exe" or TargetFilename matches "*\\powershell.exe" or TargetFilename matches "*\\pwsh.exe" or TargetFilename matches "*\\regini.exe" or TargetFilename matches "*\\regsvr32.exe" or TargetFilename matches "*\\rundll32.exe" or TargetFilename matches "*\\RuntimeBroker.exe" or TargetFilename matches "*\\schtasks.exe" or TargetFilename matches "*\\SearchFilterHost.exe" or TargetFilename matches "*\\SearchIndexer.exe" or TargetFilename matches "*\\SearchProtocolHost.exe" or TargetFilename matches "*\\SecurityHealthService.exe" or TargetFilename matches "*\\SecurityHealthSystray.exe" or TargetFilename matches "*\\services.exe" or TargetFilename matches "*\\ShellAppRuntime.exe" or TargetFilename matches "*\\sihost.exe" or TargetFilename matches "*\\smartscreen.exe" or TargetFilename matches "*\\smss.exe" or TargetFilename matches "*\\spoolsv.exe" or TargetFilename matches "*\\svchost.exe" or TargetFilename matches "*\\SystemSettingsBroker.exe" or TargetFilename matches "*\\taskhost.exe" or TargetFilename matches "*\\taskhostw.exe" or TargetFilename matches "*\\Taskmgr.exe" or TargetFilename matches "*\\TiWorker.exe" or TargetFilename matches "*\\vssadmin.exe" or TargetFilename matches "*\\w32tm.exe" or TargetFilename matches "*\\WerFault.exe" or TargetFilename matches "*\\WerFaultSecure.exe" or TargetFilename matches "*\\wermgr.exe" or TargetFilename matches "*\\wevtutil.exe" or TargetFilename matches "*\\wininit.exe" or TargetFilename matches "*\\winlogon.exe" or TargetFilename matches "*\\winrshost.exe" or TargetFilename matches "*\\WinRTNetMUAHostServer.exe" or TargetFilename matches "*\\wlanext.exe" or TargetFilename matches "*\\wlrmdr.exe" or TargetFilename matches "*\\WmiPrvSE.exe" or TargetFilename matches "*\\wslhost.exe" or TargetFilename matches "*\\WSReset.exe" or TargetFilename matches "*\\WUDFHost.exe" or TargetFilename matches "*\\WWAHost.exe")) and !(((TargetFilename matches "*C:\\Windows\\explorer.exe") or ((TargetFilename matches "*C:\\$WINDOWS.~BT\\*" or TargetFilename matches "*C:\\$WinREAgent\\*" or TargetFilename matches "*C:\\Windows\\SoftwareDistribution\\*" or TargetFilename matches "*C:\\Windows\\System32\\*" or TargetFilename matches "*C:\\Windows\\SysWOW64\\*" or TargetFilename matches "*C:\\Windows\\WinSxS\\*" or TargetFilename matches "*C:\\Windows\\uus\\*")) or (TargetFilename matches "*C:\\Windows\\System32\\SecurityHealth\\*" and TargetFilename matches "*\\SecurityHealthSystray.exe" and Image matches "*\\SecurityHealthSetup.exe") or ((Image matches "*C:\\WINDOWS\\system32\\msiexec.exe" or Image matches "*C:\\WINDOWS\\SysWOW64\\msiexec.exe") and (TargetFilename matches "C:\\Program Files\\PowerShell\\7\\pwsh.exe*" or TargetFilename matches "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe*" or TargetFilename matches "C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview\\*")) or ((Image matches "*C:\\Windows\\system32\\svchost.exe" or Image matches "*C:\\Windows\\SysWOW64\\svchost.exe") and (TargetFilename matches "*C:\\Program Files\\WindowsApps\\*" or TargetFilename matches "*C:\\Program Files (x86)\\WindowsApps\\*" or TargetFilename matches "*\\AppData\\Local\\Microsoft\\WindowsApps\\*")) or ((Image matches "*\\TiWorker.exe" or Image matches "*\\wuaucltcore.exe") and TargetFilename matches "C:\\Windows\\Temp\\*") or ((Image = "C:\\Windows\\System32\\wuauclt.exe" or Image = "C:\\Windows\\SysWOW64\\wuauclt.exe" or Image = "C:\\Windows\\UUS\\arm64\\wuaucltcore.exe")))) and !(((TargetFilename = "C:\\Program Files\\WSL\\wslhost.exe") or ((TargetFilename matches "*C:\\Program Files\\WindowsApps\\MicrosoftCorporationII.WindowsSubsystemForLinux_*" and TargetFilename matches "*\\wslhost.exe*")) or ((TargetFilename matches "*C:\\Users\\*" and TargetFilename matches "*\\AppData\\Local\\Microsoft\\WindowsApps\\*" and TargetFilename matches "*\\wslhost.exe*")))))
