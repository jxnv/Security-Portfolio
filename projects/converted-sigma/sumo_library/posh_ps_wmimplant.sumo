_sourceCategory=* | where ((ScriptBlockText matches "*WMImplant*" or ScriptBlockText matches "* change_user *" or ScriptBlockText matches "* gen_cli *" or ScriptBlockText matches "* command_exec *" or ScriptBlockText matches "* disable_wdigest *" or ScriptBlockText matches "* disable_winrm *" or ScriptBlockText matches "* enable_wdigest *" or ScriptBlockText matches "* enable_winrm *" or ScriptBlockText matches "* registry_mod *" or ScriptBlockText matches "* remote_posh *" or ScriptBlockText matches "* sched_job *" or ScriptBlockText matches "* service_mod *" or ScriptBlockText matches "* process_kill *" or ScriptBlockText matches "* active_users *" or ScriptBlockText matches "* basic_info *" or ScriptBlockText matches "* power_off *" or ScriptBlockText matches "* vacant_system *" or ScriptBlockText matches "* logon_events *"))
