// Title: Network Communication Initiated To File Sharing Domains From Process Located In Suspicious Folder
// ID: e0f8ab85-0ac9-423b-a73a-81b3c7b1aa97
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2018-08-30
// Tags: attack.command-and-control, attack.t1105
// Description: Detects executables located in potentially suspicious directories initiating network connections towards file sharing domains.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Initiated = "true" and (DestinationHostname matches "*.githubusercontent.com" or DestinationHostname matches "*0x0.st" or DestinationHostname matches "*anonfiles.com" or DestinationHostname matches "*bashupload.com" or DestinationHostname matches "*cdn.discordapp.com" or DestinationHostname matches "*chunk.io" or DestinationHostname matches "*ddns.net" or DestinationHostname matches "*dl.dropboxusercontent.com" or DestinationHostname matches "*ghostbin.co" or DestinationHostname matches "*github.com" or DestinationHostname matches "*glitch.me" or DestinationHostname matches "*gofile.io" or DestinationHostname matches "*hastebin.com" or DestinationHostname matches "*mediafire.com" or DestinationHostname matches "*mega.co.nz" or DestinationHostname matches "*mega.nz" or DestinationHostname matches "*onrender.com" or DestinationHostname matches "*pages.dev" or DestinationHostname matches "*paste.ee" or DestinationHostname matches "*pastebin.com" or DestinationHostname matches "*pastebin.pl" or DestinationHostname matches "*pastetext.net" or DestinationHostname matches "*pixeldrain.com" or DestinationHostname matches "*privatlab.com" or DestinationHostname matches "*privatlab.net" or DestinationHostname matches "*send.exploit.in" or DestinationHostname matches "*sendspace.com" or DestinationHostname matches "*storage.googleapis.com" or DestinationHostname matches "*storjshare.io" or DestinationHostname matches "*supabase.co" or DestinationHostname matches "*temp.sh" or DestinationHostname matches "*transfer.sh" or DestinationHostname matches "*trycloudflare.com" or DestinationHostname matches "*ufile.io" or DestinationHostname matches "*w3spaces.com" or DestinationHostname matches "*workers.dev" or DestinationHostname matches "*x0.at")) and ((Image matches "*:\\$Recycle.bin*" or Image matches "*:\\Perflogs\\*" or Image matches "*:\\Temp\\*" or Image matches "*:\\Users\\Default\\*" or Image matches "*:\\Users\\Public\\*" or Image matches "*:\\Windows\\Fonts\\*" or Image matches "*:\\Windows\\IME\\*" or Image matches "*:\\Windows\\System32\\Tasks\\*" or Image matches "*:\\Windows\\Tasks\\*" or Image matches "*:\\Windows\\Temp\\*" or Image matches "*\\AppData\\Temp\\*" or Image matches "*\\config\\systemprofile\\*" or Image matches "*\\Windows\\addins\\*")))
