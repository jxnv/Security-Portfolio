// Title: Suspicious ScreenSave Change by Reg.exe
// ID: 0fc35fc3-efe6-4898-8a37-0b233339524f
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-08-19
// Tags: attack.persistence, attack.privilege-escalation, attack.t1546.002
// Description: Adversaries may establish persistence by executing malicious content triggered by user inactivity.
// Screensavers are programs that execute after a configurable time of user inactivity and consist of Portable Executable (PE) files with a .scr file extension
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\reg.exe" and (CommandLine matches "*HKEY_CURRENT_USER\\Control Panel\\Desktop*" or CommandLine matches "*HKCU\\Control Panel\\Desktop*")) and (((CommandLine matches "*/v ScreenSaveActive*" and CommandLine matches "*/t REG_SZ*" and CommandLine matches "*/d 1*" and CommandLine matches "*/f*")) or ((CommandLine matches "*/v ScreenSaveTimeout*" and CommandLine matches "*/t REG_SZ*" and CommandLine matches "*/d *" and CommandLine matches "*/f*")) or ((CommandLine matches "*/v ScreenSaverIsSecure*" and CommandLine matches "*/t REG_SZ*" and CommandLine matches "*/d 0*" and CommandLine matches "*/f*")) or ((CommandLine matches "*/v SCRNSAVE.EXE*" and CommandLine matches "*/t REG_SZ*" and CommandLine matches "*/d *" and CommandLine matches "*.scr*" and CommandLine matches "*/f*"))))
