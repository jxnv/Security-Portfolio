// Title: Macro Enabled In A Potentially Suspicious Document
// ID: a166f74e-bf44-409d-b9ba-ea4b2dd8b3cd
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-21
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects registry changes to Office trust records where the path is located in a potentially suspicious location
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((TargetObject matches "*/AppData/Local/Microsoft/Windows/INetCache/*" or TargetObject matches "*/AppData/Local/Temp/*" or TargetObject matches "*/PerfLogs/*" or TargetObject matches "*C:/Users/Public/*" or TargetObject matches "*file:///D:/*" or TargetObject matches "*file:///E:/*")) and (TargetObject matches "*\\Security\\Trusted Documents\\TrustRecords*"))
