// Title: Access To Crypto Currency Wallets By Uncommon Applications
// ID: f41b0311-44f9-44f0-816d-dd45e39d4bc8
// Status: test
// Level: medium
// Author: X__Junior (Nextron Systems)
// Date: 2024-07-29
// Tags: attack.t1003, attack.credential-access
// Description: Detects file access requests to crypto currency files by uncommon processes.
// Could indicate potential attempt of crypto currency wallet stealing.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((FileName matches "*\\AppData\\Roaming\\Ethereum\\keystore\\*" or FileName matches "*\\AppData\\Roaming\\EthereumClassic\\keystore\\*" or FileName matches "*\\AppData\\Roaming\\monero\\wallets\\*")) or ((FileName matches "*\\AppData\\Roaming\\Bitcoin\\wallet.dat" or FileName matches "*\\AppData\\Roaming\\BitcoinABC\\wallet.dat" or FileName matches "*\\AppData\\Roaming\\BitcoinSV\\wallet.dat" or FileName matches "*\\AppData\\Roaming\\DashCore\\wallet.dat" or FileName matches "*\\AppData\\Roaming\\DogeCoin\\wallet.dat" or FileName matches "*\\AppData\\Roaming\\Litecoin\\wallet.dat" or FileName matches "*\\AppData\\Roaming\\Ripple\\wallet.dat" or FileName matches "*\\AppData\\Roaming\\Zcash\\wallet.dat"))) and !((((Image matches "C:\\Program Files (x86)\\*" or Image matches "C:\\Program Files\\*" or Image matches "C:\\Windows\\system32\\*" or Image matches "C:\\Windows\\SysWOW64\\*")) or (Image = "System"))) and !((Image matches "C:\\ProgramData\\Microsoft\\Windows Defender\\*" and (Image matches "*\\MpCopyAccelerator.exe" or Image matches "*\\MsMpEng.exe"))))
