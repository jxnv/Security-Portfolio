// Title: Potential Tampering With Security Products Via WMIC
// ID: 847d5ff3-8a31-4737-a970-aeae8fe21765
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-01-30
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects uninstallation or termination of security products using the WMIC utility
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((CommandLine matches "*wmic*" and CommandLine matches "*product *" and CommandLine matches "*uninstall*") and (CommandLine matches "*/nointeractive*" or CommandLine matches "*-nointeractive*")) or ((CommandLine matches "*wmic*" and CommandLine matches "*caption like *") and (CommandLine matches "*call delete*" or CommandLine matches "*call terminate*")) or ((CommandLine matches "*process *" and CommandLine matches "*where *" and CommandLine matches "*delete*"))) and ((CommandLine matches "*%carbon%*" or CommandLine matches "*%cylance%*" or CommandLine matches "*%endpoint%*" or CommandLine matches "*%eset%*" or CommandLine matches "*%malware%*" or CommandLine matches "*%Sophos%*" or CommandLine matches "*%symantec%*" or CommandLine matches "*Antivirus*" or CommandLine matches "*AVG *" or CommandLine matches "*Carbon Black*" or CommandLine matches "*CarbonBlack*" or CommandLine matches "*Cb Defense Sensor 64-bit*" or CommandLine matches "*Crowdstrike Sensor*" or CommandLine matches "*Cylance *" or CommandLine matches "*Dell Threat Defense*" or CommandLine matches "*DLP Endpoint*" or CommandLine matches "*Endpoint Detection*" or CommandLine matches "*Endpoint Protection*" or CommandLine matches "*Endpoint Security*" or CommandLine matches "*Endpoint Sensor*" or CommandLine matches "*ESET File Security*" or CommandLine matches "*LogRhythm System Monitor Service*" or CommandLine matches "*Malwarebytes*" or CommandLine matches "*McAfee Agent*" or CommandLine matches "*Microsoft Security Client*" or CommandLine matches "*Sophos Anti-Virus*" or CommandLine matches "*Sophos AutoUpdate*" or CommandLine matches "*Sophos Credential Store*" or CommandLine matches "*Sophos Management Console*" or CommandLine matches "*Sophos Management Database*" or CommandLine matches "*Sophos Management Server*" or CommandLine matches "*Sophos Remote Management System*" or CommandLine matches "*Sophos Update Manager*" or CommandLine matches "*Threat Protection*" or CommandLine matches "*VirusScan*" or CommandLine matches "*Webroot SecureAnywhere*" or CommandLine matches "*Windows Defender*")))
