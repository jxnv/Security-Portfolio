// Title: Suspicious PowerShell Parameter Substring
// ID: 36210e0d-5b19-485d-a087-c096088885f0
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Daniel Bohannon (idea), Roberto Rodriguez (Fix)
// Date: 2019-01-16
// Tags: attack.execution, attack.t1059.001
// Description: Detects suspicious PowerShell invocation with a parameter substring
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe") and (CommandLine matches "* -windowstyle h *" or CommandLine matches "* -windowstyl h*" or CommandLine matches "* -windowsty h*" or CommandLine matches "* -windowst h*" or CommandLine matches "* -windows h*" or CommandLine matches "* -windo h*" or CommandLine matches "* -wind h*" or CommandLine matches "* -win h*" or CommandLine matches "* -wi h*" or CommandLine matches "* -win h *" or CommandLine matches "* -win hi *" or CommandLine matches "* -win hid *" or CommandLine matches "* -win hidd *" or CommandLine matches "* -win hidde *" or CommandLine matches "* -NoPr *" or CommandLine matches "* -NoPro *" or CommandLine matches "* -NoProf *" or CommandLine matches "* -NoProfi *" or CommandLine matches "* -NoProfil *" or CommandLine matches "* -nonin *" or CommandLine matches "* -nonint *" or CommandLine matches "* -noninte *" or CommandLine matches "* -noninter *" or CommandLine matches "* -nonintera *" or CommandLine matches "* -noninterac *" or CommandLine matches "* -noninteract *" or CommandLine matches "* -noninteracti *" or CommandLine matches "* -noninteractiv *" or CommandLine matches "* -ec *" or CommandLine matches "* -encodedComman *" or CommandLine matches "* -encodedComma *" or CommandLine matches "* -encodedComm *" or CommandLine matches "* -encodedCom *" or CommandLine matches "* -encodedCo *" or CommandLine matches "* -encodedC *" or CommandLine matches "* -encoded *" or CommandLine matches "* -encode *" or CommandLine matches "* -encod *" or CommandLine matches "* -enco *" or CommandLine matches "* -en *" or CommandLine matches "* -executionpolic *" or CommandLine matches "* -executionpoli *" or CommandLine matches "* -executionpol *" or CommandLine matches "* -executionpo *" or CommandLine matches "* -executionp *" or CommandLine matches "* -execution bypass*" or CommandLine matches "* -executio bypass*" or CommandLine matches "* -executi bypass*" or CommandLine matches "* -execut bypass*" or CommandLine matches "* -execu bypass*" or CommandLine matches "* -exec bypass*" or CommandLine matches "* -exe bypass*" or CommandLine matches "* -ex bypass*" or CommandLine matches "* -ep bypass*" or CommandLine matches "* /windowstyle h *" or CommandLine matches "* /windowstyl h*" or CommandLine matches "* /windowsty h*" or CommandLine matches "* /windowst h*" or CommandLine matches "* /windows h*" or CommandLine matches "* /windo h*" or CommandLine matches "* /wind h*" or CommandLine matches "* /win h*" or CommandLine matches "* /wi h*" or CommandLine matches "* /win h *" or CommandLine matches "* /win hi *" or CommandLine matches "* /win hid *" or CommandLine matches "* /win hidd *" or CommandLine matches "* /win hidde *" or CommandLine matches "* /NoPr *" or CommandLine matches "* /NoPro *" or CommandLine matches "* /NoProf *" or CommandLine matches "* /NoProfi *" or CommandLine matches "* /NoProfil *" or CommandLine matches "* /nonin *" or CommandLine matches "* /nonint *" or CommandLine matches "* /noninte *" or CommandLine matches "* /noninter *" or CommandLine matches "* /nonintera *" or CommandLine matches "* /noninterac *" or CommandLine matches "* /noninteract *" or CommandLine matches "* /noninteracti *" or CommandLine matches "* /noninteractiv *" or CommandLine matches "* /ec *" or CommandLine matches "* /encodedComman *" or CommandLine matches "* /encodedComma *" or CommandLine matches "* /encodedComm *" or CommandLine matches "* /encodedCom *" or CommandLine matches "* /encodedCo *" or CommandLine matches "* /encodedC *" or CommandLine matches "* /encoded *" or CommandLine matches "* /encode *" or CommandLine matches "* /encod *" or CommandLine matches "* /enco *" or CommandLine matches "* /en *" or CommandLine matches "* /executionpolic *" or CommandLine matches "* /executionpoli *" or CommandLine matches "* /executionpol *" or CommandLine matches "* /executionpo *" or CommandLine matches "* /executionp *" or CommandLine matches "* /execution bypass*" or CommandLine matches "* /executio bypass*" or CommandLine matches "* /executi bypass*" or CommandLine matches "* /execut bypass*" or CommandLine matches "* /execu bypass*" or CommandLine matches "* /exec bypass*" or CommandLine matches "* /exe bypass*" or CommandLine matches "* /ex bypass*" or CommandLine matches "* /ep bypass*"))
