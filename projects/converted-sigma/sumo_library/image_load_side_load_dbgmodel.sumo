// Title: Potential DLL Sideloading Of DbgModel.DLL
// ID: fef394cd-f44d-4040-9b18-95d92fe278c0
// Status: test
// Level: medium
// Author: Gary Lobermier
// Date: 2024-07-11
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of "DbgModel.dll"
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((ImageLoaded matches "*\\dbgmodel.dll") and !(((ImageLoaded matches "C:\\Windows\\System32\\*" or ImageLoaded matches "C:\\Windows\\SysWOW64\\*" or ImageLoaded matches "C:\\Windows\\WinSxS\\*"))) and !(((ImageLoaded matches "C:\\Program Files\\WindowsApps\\Microsoft.WinDbg_*") or ((ImageLoaded matches "C:\\Program Files (x86)\\Windows Kits\\*" or ImageLoaded matches "C:\\Program Files\\Windows Kits\\*")))))
