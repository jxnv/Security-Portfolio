// Title: Compress Data and Lock With Password for Exfiltration With 7-ZIP
// ID: 9fbf5927-5261-4284-a71d-f681029ea574
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-07-27
// Tags: attack.collection, attack.t1560.001
// Description: An adversary may compress or encrypt data that is collected prior to exfiltration using 3rd party utilities
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "* a *" or CommandLine matches "* u *")) and ((Description matches "*7-Zip*") or ((Image matches "*\\7z.exe" or Image matches "*\\7zr.exe" or Image matches "*\\7za.exe")) or ((OriginalFileName = "7z.exe" or OriginalFileName = "7za.exe" or OriginalFileName = "7zr.exe"))) and (CommandLine matches "* -p*"))
