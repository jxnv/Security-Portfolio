// Title: BITS Transfer Job Download From Direct IP
// ID: 90f138c1-f578-4ac3-8c49-eecfd847c8b7
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-11
// Tags: attack.persistence, attack.execution, attack.stealth, attack.t1197
// Description: Detects a BITS transfer job downloading file(s) from a direct IP address.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((EventID = "16403" and (RemoteName matches "*http://1*" or RemoteName matches "*http://2*" or RemoteName matches "*http://3*" or RemoteName matches "*http://4*" or RemoteName matches "*http://5*" or RemoteName matches "*http://6*" or RemoteName matches "*http://7*" or RemoteName matches "*http://8*" or RemoteName matches "*http://9*" or RemoteName matches "*https://1*" or RemoteName matches "*https://2*" or RemoteName matches "*https://3*" or RemoteName matches "*https://4*" or RemoteName matches "*https://5*" or RemoteName matches "*https://6*" or RemoteName matches "*https://7*" or RemoteName matches "*https://8*" or RemoteName matches "*https://9*")) and !((((RemoteName matches "*://10.*" or RemoteName matches "*://192.168.*" or RemoteName matches "*://172.16.*" or RemoteName matches "*://172.17.*" or RemoteName matches "*://172.18.*" or RemoteName matches "*://172.19.*" or RemoteName matches "*://172.20.*" or RemoteName matches "*://172.21.*" or RemoteName matches "*://172.22.*" or RemoteName matches "*://172.23.*" or RemoteName matches "*://172.24.*" or RemoteName matches "*://172.25.*" or RemoteName matches "*://172.26.*" or RemoteName matches "*://172.27.*" or RemoteName matches "*://172.28.*" or RemoteName matches "*://172.29.*" or RemoteName matches "*://172.30.*" or RemoteName matches "*://172.31.*" or RemoteName matches "*://127.*" or RemoteName matches "*://169.254.*")) or ((RemoteName matches "*https://7-*" or RemoteName matches "*http://7-*")))))
