// Title: Reg Add Suspicious Paths
// ID: b7e2a8d4-74bb-4b78-adc9-3f92af2d4829
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-19
// Tags: attack.persistence, attack.defense-impairment, attack.t1112, attack.t1685
// Description: Detects when an adversary uses the reg.exe utility to add or modify new keys or subkeys
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*\\AppDataLow\\Software\\Microsoft\\*" or CommandLine matches "*\\Policies\\Microsoft\\Windows\\OOBE*" or CommandLine matches "*\\Policies\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon*" or CommandLine matches "*\\SOFTWARE\\Microsoft\\Windows NT\\Currentversion\\Winlogon*" or CommandLine matches "*\\CurrentControlSet\\Control\\SecurityProviders\\WDigest*" or CommandLine matches "*\\Microsoft\\Windows Defender\\*")) and ((Image matches "*\\reg.exe") or (OriginalFileName = "reg.exe")))
