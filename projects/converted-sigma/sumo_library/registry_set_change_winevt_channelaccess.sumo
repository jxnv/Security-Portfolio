// Title: Change Winevt Channel Access Permission Via Registry
// ID: 7d9263bd-dc47-4a58-bc92-5474abab390c
// Status: test
// Level: high
// Author: frack113
// Date: 2022-09-17
// Tags: attack.defense-impairment, attack.t1685.001
// Description: Detects tampering with the "ChannelAccess" registry key in order to change access to Windows event channel.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((TargetObject matches "*\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\*" and TargetObject matches "*\\ChannelAccess" and (Details matches "*(A;;0x1;;;LA)*" or Details matches "*(A;;0x1;;;SY)*" or Details matches "*(A;;0x5;;;BA)*")) and !(((Image matches "C:\\Windows\\WinSxS\\*" and Image matches "*\\TiWorker.exe") or (Image = "C:\\Windows\\servicing\\TrustedInstaller.exe"))))
