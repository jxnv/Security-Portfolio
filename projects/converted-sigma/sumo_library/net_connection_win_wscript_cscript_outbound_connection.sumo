// Title: Outbound Network Connection Initiated By Script Interpreter
// ID: 992a6cae-db6a-43c8-9cec-76d7195c96fc
// Status: test
// Level: high
// Author: frack113, Florian Roth (Nextron Systems)
// Date: 2022-08-28
// Tags: attack.command-and-control, attack.t1105
// Description: Detects a script interpreter wscript/cscript opening a network connection to a non-local network. Adversaries may use script to download malicious payloads.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Initiated = "true" and (Image matches "*\\wscript.exe" or Image matches "*\\cscript.exe")) and !((((cidrMatch(DestinationIp, "127.0.0.0/8") or cidrMatch(DestinationIp, "10.0.0.0/8") or cidrMatch(DestinationIp, "172.16.0.0/12") or cidrMatch(DestinationIp, "192.168.0.0/16") or cidrMatch(DestinationIp, "169.254.0.0/16") or cidrMatch(DestinationIp, "::1/128") or cidrMatch(DestinationIp, "fe80::/10") or cidrMatch(DestinationIp, "fc00::/7"))) or (cidrMatch(DestinationIp, "20.0.0.0/11")))))
