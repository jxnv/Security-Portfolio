// Title: Uncommon  Assistive Technology Applications Execution Via AtBroker.EXE
// ID: f24bcaea-0cd1-11eb-adc1-0242ac120002
// Status: test
// Level: medium
// Author: Mateusz Wydra, oscd.community
// Date: 2020-10-12
// Tags: attack.stealth, attack.t1218
// Description: Detects the start of a non built-in assistive technology applications via "Atbroker.EXE".
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*start*") and ((Image matches "*\\AtBroker.exe") or (OriginalFileName = "AtBroker.exe"))) and !(((CommandLine matches "*animations*" or CommandLine matches "*audiodescription*" or CommandLine matches "*caretbrowsing*" or CommandLine matches "*caretwidth*" or CommandLine matches "*colorfiltering*" or CommandLine matches "*cursorindicator*" or CommandLine matches "*cursorscheme*" or CommandLine matches "*filterkeys*" or CommandLine matches "*focusborderheight*" or CommandLine matches "*focusborderwidth*" or CommandLine matches "*highcontrast*" or CommandLine matches "*keyboardcues*" or CommandLine matches "*keyboardpref*" or CommandLine matches "*livecaptions*" or CommandLine matches "*magnifierpane*" or CommandLine matches "*messageduration*" or CommandLine matches "*minimumhitradius*" or CommandLine matches "*mousekeys*" or CommandLine matches "*Narrator*" or CommandLine matches "*osk*" or CommandLine matches "*overlappedcontent*" or CommandLine matches "*showsounds*" or CommandLine matches "*soundsentry*" or CommandLine matches "*speechreco*" or CommandLine matches "*stickykeys*" or CommandLine matches "*togglekeys*" or CommandLine matches "*voiceaccess*" or CommandLine matches "*windowarranging*" or CommandLine matches "*windowtracking*" or CommandLine matches "*windowtrackingtimeout*" or CommandLine matches "*windowtrackingzorder*"))) and !((CommandLine matches "*Oracle_JavaAccessBridge*")))
