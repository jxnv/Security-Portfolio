// Title: DNS Server Discovery Via LDAP Query
// ID: a21bcd7e-38ec-49ad-b69a-9ea17e69509e
// Status: test
// Level: low
// Author: frack113
// Date: 2022-08-20
// Tags: attack.discovery, attack.t1482
// Description: Detects DNS server discovery via LDAP query requests from uncommon applications
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((QueryName matches "_ldap.*") and !(((Image matches "*:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*" and Image matches "*\\MsMpEng.exe") or ((Image matches "*:\\Program Files\\*" or Image matches "*:\\Program Files (x86)\\*" or Image matches "*:\\Windows\\*")) or (isNull(Image)) or (Image = "<unknown process>"))) and !(((Image matches "C:\\WindowsAzure\\GuestAgent*") or ((Image matches "*\\chrome.exe" or Image matches "*\\firefox.exe" or Image matches "*\\opera.exe")))))
