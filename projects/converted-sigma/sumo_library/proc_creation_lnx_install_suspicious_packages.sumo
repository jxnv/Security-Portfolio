// Title: Suspicious Package Installed - Linux
// ID: 700fb7e8-2981-401c-8430-be58e189e741
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-03
// Tags: attack.defense-impairment, attack.t1553.004
// Description: Detects installation of suspicious packages using system installation utilities
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((Image matches "*/apt" or Image matches "*/apt-get") and CommandLine matches "*install*") or (Image matches "*/dpkg" and (CommandLine matches "*--install*" or CommandLine matches "*-i*")) or (Image matches "*/rpm" and CommandLine matches "*-i*") or (Image matches "*/yum" and (CommandLine matches "*localinstall*" or CommandLine matches "*install*"))) and ((CommandLine matches "*nmap*" or CommandLine matches "* nc*" or CommandLine matches "*netcat*" or CommandLine matches "*wireshark*" or CommandLine matches "*tshark*" or CommandLine matches "*openconnect*" or CommandLine matches "*proxychains*" or CommandLine matches "*socat*")))
