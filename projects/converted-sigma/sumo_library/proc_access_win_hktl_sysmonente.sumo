// Title: HackTool - SysmonEnte Execution
// ID: d29ada0f-af45-4f27-8f32-f7b77c3dbc4e
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-09-07
// Tags: attack.defense-impairment, attack.t1685.001
// Description: Detects the use of SysmonEnte, a tool to attack the integrity of Sysmon
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((TargetImage matches "*:\\Windows\\Sysmon.exe*" or TargetImage matches "*:\\Windows\\Sysmon64.exe*" or TargetImage matches "*:\\Windows\\Sysmon64a.exe*") and GrantedAccess = "0x1400") and !((((SourceImage matches "*:\\Program Files (x86)\\*" or SourceImage matches "*:\\Program Files\\*" or SourceImage matches "*:\\Windows\\System32\\*" or SourceImage matches "*:\\Windows\\SysWOW64\\*")) or (SourceImage matches "*:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*" and SourceImage matches "*\\MsMpEng.exe")))) or (CallTrace = "Ente"))
