// Title: DotNet CLR DLL Loaded By Scripting Applications
// ID: 4508a70e-97ef-4300-b62b-ff27992990ea
// Status: test
// Level: high
// Author: omkar72, oscd.community
// Date: 2020-10-14
// Tags: attack.execution, attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects .NET CLR DLLs being loaded by scripting applications such as wscript or cscript. This could be an indication of potential suspicious execution.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\cmstp.exe" or Image matches "*\\cscript.exe" or Image matches "*\\mshta.exe" or Image matches "*\\msxsl.exe" or Image matches "*\\regsvr32.exe" or Image matches "*\\wmic.exe" or Image matches "*\\wscript.exe") and (ImageLoaded matches "*\\clr.dll" or ImageLoaded matches "*\\mscoree.dll" or ImageLoaded matches "*\\mscorlib.dll"))
