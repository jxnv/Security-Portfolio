// Title: CurrentVersion NT Autorun Keys Modification
// ID: cbf93e5d-ca6c-4722-8bea-e9119007c248
// Status: test
// Level: medium
// Author: Victor Sergeev, Daniil Yugoslavskiy, Gleb Sukhodolskiy, Timur Zinniatullin, oscd.community, Tim Shelton, frack113 (split)
// Date: 2019-10-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects modification of autostart extensibility point (ASEP) in registry.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((TargetObject matches "*\\Winlogon\\VmApplet*" or TargetObject matches "*\\Winlogon\\Userinit*" or TargetObject matches "*\\Winlogon\\Taskman*" or TargetObject matches "*\\Winlogon\\Shell*" or TargetObject matches "*\\Winlogon\\GpExtensions*" or TargetObject matches "*\\Winlogon\\AppSetup*" or TargetObject matches "*\\Winlogon\\AlternateShells\\AvailableShells*" or TargetObject matches "*\\Windows\\IconServiceLib*" or TargetObject matches "*\\Windows\\Appinit_Dlls*" or TargetObject matches "*\\Image File Execution Options*" or TargetObject matches "*\\Font Drivers*" or TargetObject matches "*\\Drivers32*" or TargetObject matches "*\\Windows\\Run*" or TargetObject matches "*\\Windows\\Load*")) and (TargetObject matches "*\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion*")) and !(((Details = "(Empty)") or (TargetObject matches "*\\Image File Execution Options\\*" and (TargetObject matches "*\\DisableExceptionChainValidation" or TargetObject matches "*\\MitigationOptions")) or (isNull(Details)) or (Image = "C:\\Windows\\System32\\poqexec.exe") or (Image = "C:\\Windows\\System32\\RuntimeBroker.exe" and TargetObject matches "*\\runtimebroker.exe\\Microsoft.Windows.ShellExperienceHost*") or (Image = "C:\\Windows\\system32\\svchost.exe" and (TargetObject matches "*\\Winlogon\\GPExtensions\\{827D319E-6EAC-11D2-A4EA-00C04F79F83A}\\PreviousPolicyAreas*" or TargetObject matches "*\\Winlogon\\GPExtensions\\{827D319E-6EAC-11D2-A4EA-00C04F79F83A}\\MaxNoGPOListChangesInterval*") and (Details = "DWORD (0x00000001)" or Details = "DWORD (0x00000009)" or Details = "DWORD (0x000003c0)")))) and !((((Image matches "C:\\Program Files (x86)\\Avira\\Antivirus\\avguard.exe*" or Image matches "C:\\Program Files\\Avira\\Antivirus\\avguard.exe*") and TargetObject matches "*SOFTWARE\\WOW6432Node\\Avira\\Antivirus\\Overwrite_Keys\\HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon\\*" and (TargetObject matches "*\\userinit\\UseAsDefault" or TargetObject matches "*\\shell\\UseAsDefault") and (Details = "explorer.exe" or Details = "C:\\Windows\\system32\\userinit.exe,")) or (Image matches "C:\\Program Files (x86)\\Microsoft\\Temp\\*" and Image matches "*\\MicrosoftEdgeUpdate.exe") or (((TargetObject matches "*\\ClickToRunStore\\HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\*" or TargetObject matches "*\\ClickToRun\\REGISTRY\\MACHINE\\Software\\Microsoft\\Windows NT\\CurrentVersion\\*")) or ((Image = "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe" or Image = "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe"))) or (Image matches "C:\\Windows\\Microsoft.NET\\Framework*" and Image matches "*\\ngen.exe") or ((Image matches "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\*" or Image matches "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\*") and Image matches "*\\OfficeClickToRun.exe") or (Image matches "*\\AppData\\Local\\Microsoft\\OneDrive\\StandaloneUpdater\\OneDriveSetup.exe" and TargetObject matches "*\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\Delete Cached Update Binary" and Details matches "C:\\Windows\\system32\\cmd.exe /q /c del /q \"C:\\Users\\*" and Details matches "*\\AppData\\Local\\Microsoft\\OneDrive\\Update\\OneDriveSetup.exe\""))))
