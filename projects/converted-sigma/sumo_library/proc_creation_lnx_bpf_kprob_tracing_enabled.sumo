// Title: Enable BPF Kprobes Tracing
// ID: 7692f583-bd30-4008-8615-75dab3f08a99
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-25
// Tags: attack.execution, attack.stealth
// Description: Detects common command used to enable bpf kprobes tracing
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((CommandLine matches "*echo 1 >*" and CommandLine matches "*/sys/kernel/debug/tracing/events/kprobes/*") and (CommandLine matches "*/myprobe/enable*" or CommandLine matches "*/myretprobe/enable*"))
