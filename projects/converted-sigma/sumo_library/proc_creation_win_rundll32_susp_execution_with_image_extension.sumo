// Title: Suspicious Rundll32 Execution With Image Extension
// ID: 4aa6040b-3f28-44e3-a769-9208e5feb5ec
// Status: test
// Level: high
// Author: Hieu Tran
// Date: 2023-03-13
// Tags: attack.stealth, attack.t1218.011
// Description: Detects the execution of Rundll32.exe with DLL files masquerading as image files
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*.bmp*" or CommandLine matches "*.cr2*" or CommandLine matches "*.eps*" or CommandLine matches "*.gif*" or CommandLine matches "*.ico*" or CommandLine matches "*.jpeg*" or CommandLine matches "*.jpg*" or CommandLine matches "*.nef*" or CommandLine matches "*.orf*" or CommandLine matches "*.png*" or CommandLine matches "*.raw*" or CommandLine matches "*.sr2*" or CommandLine matches "*.tif*" or CommandLine matches "*.tiff*")) and ((Image matches "*\\rundll32.exe") or (OriginalFileName = "RUNDLL32.exe")))
