// Title: Invoke-Obfuscation STDIN+ Launcher - System
// ID: 72862bf2-0eb1-11eb-adc1-0242ac120002
// Status: test
// Level: high
// Author: Jonathan Cheong, oscd.community
// Date: 2020-10-15
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated use of stdin to execute PowerShell
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Provider_Name = "Service Control Manager" and EventID = "7045" and (ImagePath matches "*cmd*" and ImagePath matches "*powershell*") and (ImagePath matches "*/c*" or ImagePath matches "*/r*")) and ((ImagePath matches "*noexit*") or ((ImagePath matches "*input*" and ImagePath matches "*$*"))))
