// Title: Suspicious Obfuscated PowerShell Code
// ID: 8d01b53f-456f-48ee-90f6-bc28e67d4e35
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-07-11
// Tags: attack.stealth
// Description: Detects suspicious UTF16 and base64 encoded and often obfuscated PowerShell code often used in command lines
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((CommandLine matches "*IAAtAGIAeABvAHIAIAAwAHgA*" or CommandLine matches "*AALQBiAHgAbwByACAAMAB4A*" or CommandLine matches "*gAC0AYgB4AG8AcgAgADAAeA*" or CommandLine matches "*AC4ASQBuAHYAbwBrAGUAKAApACAAfAAg*" or CommandLine matches "*AuAEkAbgB2AG8AawBlACgAKQAgAHwAI*" or CommandLine matches "*ALgBJAG4AdgBvAGsAZQAoACkAIAB8AC*" or CommandLine matches "*AHsAMQB9AHsAMAB9ACIAIAAtAGYAI*" or CommandLine matches "*B7ADEAfQB7ADAAfQAiACAALQBmAC*" or CommandLine matches "*AewAxAH0AewAwAH0AIgAgAC0AZgAg*" or CommandLine matches "*AHsAMAB9AHsAMwB9ACIAIAAtAGYAI*" or CommandLine matches "*B7ADAAfQB7ADMAfQAiACAALQBmAC*" or CommandLine matches "*AewAwAH0AewAzAH0AIgAgAC0AZgAg*" or CommandLine matches "*AHsAMgB9AHsAMAB9ACIAIAAtAGYAI*" or CommandLine matches "*B7ADIAfQB7ADAAfQAiACAALQBmAC*" or CommandLine matches "*AewAyAH0AewAwAH0AIgAgAC0AZgAg*" or CommandLine matches "*AHsAMQB9AHsAMAB9ACcAIAAtAGYAI*" or CommandLine matches "*B7ADEAfQB7ADAAfQAnACAALQBmAC*" or CommandLine matches "*AewAxAH0AewAwAH0AJwAgAC0AZgAg*" or CommandLine matches "*AHsAMAB9AHsAMwB9ACcAIAAtAGYAI*" or CommandLine matches "*B7ADAAfQB7ADMAfQAnACAALQBmAC*" or CommandLine matches "*AewAwAH0AewAzAH0AJwAgAC0AZgAg*" or CommandLine matches "*AHsAMgB9AHsAMAB9ACcAIAAtAGYAI*" or CommandLine matches "*B7ADIAfQB7ADAAfQAnACAALQBmAC*" or CommandLine matches "*AewAyAH0AewAwAH0AJwAgAC0AZgAg*"))
