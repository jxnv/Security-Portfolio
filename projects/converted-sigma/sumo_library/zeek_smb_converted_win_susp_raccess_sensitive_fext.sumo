// Title: Suspicious Access to Sensitive File Extensions - Zeek
// ID: 286b47ed-f6fe-40b3-b3a8-35129acd43bc
// Status: test
// Level: medium
// Author: Samir Bousseaden, @neu5ron
// Date: 2020-04-02
// Tags: attack.collection
// Description: Detects known sensitive file extensions via Zeek
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((name matches "*.pst" or name matches "*.ost" or name matches "*.msg" or name matches "*.nst" or name matches "*.oab" or name matches "*.edb" or name matches "*.nsf" or name matches "*.bak" or name matches "*.dmp" or name matches "*.kirbi" or name matches "*.rdp"))
