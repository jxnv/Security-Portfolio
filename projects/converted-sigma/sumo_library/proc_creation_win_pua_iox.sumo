// Title: PUA- IOX Tunneling Tool Execution
// ID: d7654f02-e04b-4934-9838-65c46f187ebc
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-10-08
// Tags: attack.command-and-control, attack.t1090
// Description: Detects the use of IOX - a tool for port forwarding and intranet proxy purposes
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\iox.exe") or ((CommandLine matches "*.exe fwd -l *" or CommandLine matches "*.exe fwd -r *" or CommandLine matches "*.exe proxy -l *" or CommandLine matches "*.exe proxy -r *")) or ((Hashes matches "*MD5=9DB2D314DD3F704A02051EF5EA210993*" or Hashes matches "*SHA1=039130337E28A6623ECF9A0A3DA7D92C5964D8DD*" or Hashes matches "*SHA256=C6CF82919B809967D9D90EA73772A8AA1C1EB3BC59252D977500F64F1A0D6731*")))
