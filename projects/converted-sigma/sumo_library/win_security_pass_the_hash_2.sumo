_sourceCategory=* | where (((EventID = "4624" and SubjectUserSid = "S-1-0-0" and LogonType = "3" and LogonProcessName = "NtLmSsp" and KeyLength = "0") or (EventID = "4624" and LogonType = "9" and LogonProcessName = "seclogo")) and !((TargetUserName = "ANONYMOUS LOGON")))
