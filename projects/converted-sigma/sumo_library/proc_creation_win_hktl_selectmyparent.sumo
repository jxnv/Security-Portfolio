// Title: HackTool - PPID Spoofing SelectMyParent Tool Execution
// ID: 52ff7941-8211-46f9-84f8-9903efb7077d
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-07-23
// Tags: attack.privilege-escalation, attack.stealth, attack.t1134.004
// Description: Detects the use of parent process ID spoofing tools like Didier Stevens tool SelectMyParent
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\SelectMyParent.exe") or ((CommandLine matches "*PPID-spoof*" or CommandLine matches "*ppid_spoof*" or CommandLine matches "*spoof-ppid*" or CommandLine matches "*spoof_ppid*" or CommandLine matches "*ppidspoof*" or CommandLine matches "*spoofppid*" or CommandLine matches "*spoofedppid*" or CommandLine matches "* -spawnto *")) or ((OriginalFileName matches "*PPID-spoof*" or OriginalFileName matches "*ppid_spoof*" or OriginalFileName matches "*spoof-ppid*" or OriginalFileName matches "*spoof_ppid*" or OriginalFileName matches "*ppidspoof*" or OriginalFileName matches "*spoofppid*" or OriginalFileName matches "*spoofedppid*")) or (Description = "SelectMyParent") or ((Hashes matches "*IMPHASH=04D974875BD225F00902B4CAD9AF3FBC*" or Hashes matches "*IMPHASH=A782AF154C9E743DDF3F3EB2B8F3D16E*" or Hashes matches "*IMPHASH=89059503D7FBF470E68F7E63313DA3AD*" or Hashes matches "*IMPHASH=CA28337632625C8281AB8A130B3D6BAD*")))
