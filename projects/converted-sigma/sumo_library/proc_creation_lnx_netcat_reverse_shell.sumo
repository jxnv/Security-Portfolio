// Title: Potential Netcat Reverse Shell Execution
// ID: 7f734ed0-4f47-46c0-837f-6ee62505abd9
// Status: test
// Level: high
// Author: @d4ns4n_, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-07
// Tags: attack.execution, attack.t1059
// Description: Detects execution of netcat with the "-e" or "-c" flags followed by common shells, which are commonly used to spawn reverse shells.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "* -c *" or CommandLine matches "* -e *")) and ((Image matches "*/nc.openbsd" or Image matches "*/nc.traditional" or Image matches "*/nc" or Image matches "*/ncat" or Image matches "*/netcat.openbsd" or Image matches "*/netcat.traditional" or Image matches "*/netcat")) and ((CommandLine matches "* ash*" or CommandLine matches "* bash*" or CommandLine matches "* bsh*" or CommandLine matches "* csh*" or CommandLine matches "* ksh*" or CommandLine matches "* pdksh*" or CommandLine matches "* sh*" or CommandLine matches "* tcsh*" or CommandLine matches "*/bin/ash*" or CommandLine matches "*/bin/bash*" or CommandLine matches "*/bin/bsh*" or CommandLine matches "*/bin/csh*" or CommandLine matches "*/bin/ksh*" or CommandLine matches "*/bin/pdksh*" or CommandLine matches "*/bin/sh*" or CommandLine matches "*/bin/tcsh*" or CommandLine matches "*/bin/zsh*" or CommandLine matches "*$IFSash*" or CommandLine matches "*$IFSbash*" or CommandLine matches "*$IFSbsh*" or CommandLine matches "*$IFScsh*" or CommandLine matches "*$IFSksh*" or CommandLine matches "*$IFSpdksh*" or CommandLine matches "*$IFSsh*" or CommandLine matches "*$IFStcsh*" or CommandLine matches "*$IFSzsh*")))
