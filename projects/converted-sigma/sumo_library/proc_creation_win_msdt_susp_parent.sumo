// Title: Suspicious MSDT Parent Process
// ID: 7a74da6b-ea76-47db-92cc-874ad90df734
// Status: test
// Level: high
// Author: Nextron Systems
// Date: 2022-06-01
// Tags: attack.stealth, attack.t1036, attack.t1218
// Description: Detects msdt.exe executed by a suspicious parent as seen in CVE-2022-30190 / Follina exploitation
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*\\msdt.exe") or (OriginalFileName = "msdt.exe")) and ((ParentImage matches "*\\cmd.exe" or ParentImage matches "*\\cscript.exe" or ParentImage matches "*\\mshta.exe" or ParentImage matches "*\\powershell.exe" or ParentImage matches "*\\pwsh.exe" or ParentImage matches "*\\regsvr32.exe" or ParentImage matches "*\\rundll32.exe" or ParentImage matches "*\\schtasks.exe" or ParentImage matches "*\\wmic.exe" or ParentImage matches "*\\wscript.exe" or ParentImage matches "*\\wsl.exe")))
