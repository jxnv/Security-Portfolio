// Title: Tamper Windows Defender - ScriptBlockLogging
// ID: 14c71865-6cd3-44ae-adaa-1db923fae5f2
// Status: test
// Level: high
// Author: frack113, elhoim, Tim Shelton (fps, alias support), Swachchhanda Shrawan Poudel, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-16
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects PowerShell scripts attempting to disable scheduled scanning and other parts of Windows Defender ATP or set default actions to allow.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((ScriptBlockText matches "*-dbaf $true*" or ScriptBlockText matches "*-dbaf 1*" or ScriptBlockText matches "*-dbm $true*" or ScriptBlockText matches "*-dbm 1*" or ScriptBlockText matches "*-dips $true*" or ScriptBlockText matches "*-dips 1*" or ScriptBlockText matches "*-DisableArchiveScanning $true*" or ScriptBlockText matches "*-DisableArchiveScanning 1*" or ScriptBlockText matches "*-DisableBehaviorMonitoring $true*" or ScriptBlockText matches "*-DisableBehaviorMonitoring 1*" or ScriptBlockText matches "*-DisableBlockAtFirstSeen $true*" or ScriptBlockText matches "*-DisableBlockAtFirstSeen 1*" or ScriptBlockText matches "*-DisableCatchupFullScan $true*" or ScriptBlockText matches "*-DisableCatchupFullScan 1*" or ScriptBlockText matches "*-DisableCatchupQuickScan $true*" or ScriptBlockText matches "*-DisableCatchupQuickScan 1*" or ScriptBlockText matches "*-DisableIntrusionPreventionSystem $true*" or ScriptBlockText matches "*-DisableIntrusionPreventionSystem 1*" or ScriptBlockText matches "*-DisableIOAVProtection $true*" or ScriptBlockText matches "*-DisableIOAVProtection 1*" or ScriptBlockText matches "*-DisableRealtimeMonitoring $true*" or ScriptBlockText matches "*-DisableRealtimeMonitoring 1*" or ScriptBlockText matches "*-DisableRemovableDriveScanning $true*" or ScriptBlockText matches "*-DisableRemovableDriveScanning 1*" or ScriptBlockText matches "*-DisableScanningMappedNetworkDrivesForFullScan $true*" or ScriptBlockText matches "*-DisableScanningMappedNetworkDrivesForFullScan 1*" or ScriptBlockText matches "*-DisableScanningNetworkFiles $true*" or ScriptBlockText matches "*-DisableScanningNetworkFiles 1*" or ScriptBlockText matches "*-DisableScriptScanning $true*" or ScriptBlockText matches "*-DisableScriptScanning 1*" or ScriptBlockText matches "*-MAPSReporting $false*" or ScriptBlockText matches "*-MAPSReporting 0*" or ScriptBlockText matches "*-drdsc $true*" or ScriptBlockText matches "*-drdsc 1*" or ScriptBlockText matches "*-drtm $true*" or ScriptBlockText matches "*-drtm 1*" or ScriptBlockText matches "*-dscrptsc $true*" or ScriptBlockText matches "*-dscrptsc 1*" or ScriptBlockText matches "*-dsmndf $true*" or ScriptBlockText matches "*-dsmndf 1*" or ScriptBlockText matches "*-dsnf $true*" or ScriptBlockText matches "*-dsnf 1*" or ScriptBlockText matches "*-dss $true*" or ScriptBlockText matches "*-dss 1*")) and (ScriptBlockText matches "*Set-MpPreference*")) or ((ScriptBlockText matches "*Set-MpPreference*") and ((ScriptBlockText matches "*HighThreatDefaultAction Allow*" or ScriptBlockText matches "*htdefac Allow*" or ScriptBlockText matches "*LowThreatDefaultAction Allow*" or ScriptBlockText matches "*ltdefac Allow*" or ScriptBlockText matches "*ModerateThreatDefaultAction Allow*" or ScriptBlockText matches "*mtdefac Allow*" or ScriptBlockText matches "*SevereThreatDefaultAction Allow*" or ScriptBlockText matches "*stdefac Allow*"))))
