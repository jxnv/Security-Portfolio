// Title: Root Certificate Installed From Susp Locations
// ID: 5f6a601c-2ecb-498b-9c33-660362323afa
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.defense-impairment, attack.t1553.004
// Description: Adversaries may install a root certificate on a compromised system to avoid warnings when connecting to adversary controlled web servers.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((CommandLine matches "*Import-Certificate*" and CommandLine matches "* -FilePath *" and CommandLine matches "*Cert:\\LocalMachine\\Root*") and (CommandLine matches "*\\AppData\\Local\\Temp\\*" or CommandLine matches "*:\\Windows\\TEMP\\*" or CommandLine matches "*\\Desktop\\*" or CommandLine matches "*\\Downloads\\*" or CommandLine matches "*\\Perflogs\\*" or CommandLine matches "*:\\Users\\Public\\*"))
