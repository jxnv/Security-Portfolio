// Title: New Kernel Driver Via SC.EXE
// ID: 431a1fdb-4799-4f3b-91c3-a683b003fc49
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-14
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects creation of a new service (kernel driver) with the type "kernel"
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\sc.exe" and (CommandLine matches "*create*" or CommandLine matches "*config*") and (CommandLine matches "*binPath*" and CommandLine matches "*type*" and CommandLine matches "*kernel*")) and !((((CommandLine matches "*create netprotection_network_filter*" and CommandLine matches "*type= kernel start= *" and CommandLine matches "*binPath= System32\\drivers\\netprotection_network_filter*" and CommandLine matches "*DisplayName= netprotection_network_filter*" and CommandLine matches "*group= PNP_TDI tag= yes*")) or ((CommandLine matches "*create avelam binpath=C:\\Windows\\system32\\drivers\\avelam.sys*" and CommandLine matches "*type=kernel start=boot error=critical group=Early-Launch*")))))
