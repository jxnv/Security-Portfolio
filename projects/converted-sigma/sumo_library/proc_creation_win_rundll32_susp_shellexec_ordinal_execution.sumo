// Title: Suspicious ShellExec_RunDLL Call Via Ordinal
// ID: 8823e85d-31d8-473e-b7f4-92da070f0fc6
// Status: test
// Level: high
// Author: Swachchhanda Shrawan Poudel
// Date: 2024-12-01
// Tags: attack.stealth, attack.t1218.011
// Description: Detects suspicious call to the "ShellExec_RunDLL" exported function of SHELL32.DLL through the ordinal number to launch other commands.
// Adversary might only use the ordinal number in order to bypass existing detection that alert on usage of ShellExec_RunDLL on CommandLine.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((ParentCommandLine matches "*SHELL32.DLL*") and ((ParentCommandLine matches "*#568*" or ParentCommandLine matches "*#570*" or ParentCommandLine matches "*#572*" or ParentCommandLine matches "*#576*"))) and (((Image matches "*\\bash.exe" or Image matches "*\\bitsadmin.exe" or Image matches "*\\cmd.exe" or Image matches "*\\cscript.exe" or Image matches "*\\curl.exe" or Image matches "*\\mshta.exe" or Image matches "*\\msiexec.exe" or Image matches "*\\msxsl.exe" or Image matches "*\\odbcconf.exe" or Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\regsvr32.exe" or Image matches "*\\schtasks.exe" or Image matches "*\\wmic.exe" or Image matches "*\\wscript.exe")) or (((ParentCommandLine matches "*comspec*" or ParentCommandLine matches "*iex*" or ParentCommandLine matches "*Invoke-*" or ParentCommandLine matches "*msiexec*" or ParentCommandLine matches "*odbcconf*" or ParentCommandLine matches "*regsvr32*")) or ((ParentCommandLine matches "*\\Desktop\\*" or ParentCommandLine matches "*\\ProgramData\\*" or ParentCommandLine matches "*\\Temp\\*" or ParentCommandLine matches "*\\Users\\Public\\*")))))
