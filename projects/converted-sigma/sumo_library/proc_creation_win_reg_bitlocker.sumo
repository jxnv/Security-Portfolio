// Title: Suspicious Reg Add BitLocker
// ID: 0e0255bf-2548-47b8-9582-c0955c9283f5
// Status: test
// Level: high
// Author: frack113
// Date: 2021-11-15
// Tags: attack.impact, attack.t1486
// Description: Detects suspicious addition to BitLocker related registry keys via the reg.exe utility
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((CommandLine matches "*REG*" and CommandLine matches "*ADD*" and CommandLine matches "*\\SOFTWARE\\Policies\\Microsoft\\FVE*" and CommandLine matches "*/v*" and CommandLine matches "*/f*") and (CommandLine matches "*EnableBDEWithNoTPM*" or CommandLine matches "*UseAdvancedStartup*" or CommandLine matches "*UseTPM*" or CommandLine matches "*UseTPMKey*" or CommandLine matches "*UseTPMKeyPIN*" or CommandLine matches "*RecoveryKeyMessageSource*" or CommandLine matches "*UseTPMPIN*" or CommandLine matches "*RecoveryKeyMessage*"))
