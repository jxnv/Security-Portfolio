// Title: Windows Firewall Disabled via PowerShell
// ID: 12f6b752-042d-483e-bf9c-915a6d06ad75
// Status: test
// Level: medium
// Author: Tim Rauch, Elastic (idea)
// Date: 2022-09-14
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects attempts to disable the Windows Firewall using PowerShell
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*Set-NetFirewallProfile *" and CommandLine matches "* -Enabled *" and CommandLine matches "* False*")) and (((Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\powershell_ise.exe")) or ((OriginalFileName = "PowerShell.EXE" or OriginalFileName = "pwsh.dll"))) and ((CommandLine matches "* -All *" or CommandLine matches "*Public*" or CommandLine matches "*Domain*" or CommandLine matches "*Private*")))
