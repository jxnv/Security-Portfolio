// Title: Suspicious Processes Spawned by Java.EXE
// ID: 0d34ed8b-1c12-4ff2-828c-16fc860b766d
// Status: test
// Level: high
// Author: Andreas Hunkeler (@Karneades), Florian Roth
// Date: 2021-12-17
// Tags: attack.initial-access, attack.persistence, attack.privilege-escalation
// Description: Detects suspicious processes spawned from a Java host process which could indicate a sign of exploitation (e.g. log4j)
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (ParentImage matches "*\\java.exe" and (Image matches "*\\AppVLP.exe" or Image matches "*\\bitsadmin.exe" or Image matches "*\\certutil.exe" or Image matches "*\\cscript.exe" or Image matches "*\\curl.exe" or Image matches "*\\forfiles.exe" or Image matches "*\\hh.exe" or Image matches "*\\mftrace.exe" or Image matches "*\\mshta.exe" or Image matches "*\\net.exe" or Image matches "*\\net1.exe" or Image matches "*\\query.exe" or Image matches "*\\reg.exe" or Image matches "*\\regsvr32.exe" or Image matches "*\\rundll32.exe" or Image matches "*\\schtasks.exe" or Image matches "*\\scrcons.exe" or Image matches "*\\scriptrunner.exe" or Image matches "*\\sh.exe" or Image matches "*\\systeminfo.exe" or Image matches "*\\whoami.exe" or Image matches "*\\wmic.exe" or Image matches "*\\wscript.exe"))
