// Title: Remote Access Tool - ScreenConnect Potential Suspicious Remote Command Execution
// ID: 7b582f1a-b318-4c6a-bf4e-66fe49bf55a5
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems), @Kostastsale
// Date: 2022-02-25
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects potentially suspicious child processes launched via the ScreenConnect client service.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((ParentCommandLine matches "*:\\Windows\\TEMP\\ScreenConnect\\*" and ParentCommandLine matches "*run.cmd*") and (Image matches "*\\bitsadmin.exe" or Image matches "*\\cmd.exe" or Image matches "*\\curl.exe" or Image matches "*\\dllhost.exe" or Image matches "*\\net.exe" or Image matches "*\\nltest.exe" or Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\rundll32.exe" or Image matches "*\\wevtutil.exe"))
