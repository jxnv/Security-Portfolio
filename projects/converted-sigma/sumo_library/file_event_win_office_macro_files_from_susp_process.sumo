// Title: Office Macro File Creation From Suspicious Process
// ID: b1c50487-1967-4315-a026-6491686d860e
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-23
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects the creation of a office macro file from a a suspicious process
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((Image matches "*\\cscript.exe" or Image matches "*\\mshta.exe" or Image matches "*\\regsvr32.exe" or Image matches "*\\rundll32.exe" or Image matches "*\\wscript.exe")) or ((ParentImage matches "*\\cscript.exe" or ParentImage matches "*\\mshta.exe" or ParentImage matches "*\\regsvr32.exe" or ParentImage matches "*\\rundll32.exe" or ParentImage matches "*\\wscript.exe"))) and ((TargetFilename matches "*.docm" or TargetFilename matches "*.dotm" or TargetFilename matches "*.xlsm" or TargetFilename matches "*.xltm" or TargetFilename matches "*.potm" or TargetFilename matches "*.pptm")))
