// Title: PUA - Seatbelt Execution
// ID: 38646daa-e78f-4ace-9de0-55547b2d30da
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-18
// Tags: attack.discovery, attack.t1526, attack.t1087, attack.t1083
// Description: Detects the execution of the PUA/Recon tool Seatbelt via PE information of command line parameters
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*\\Seatbelt.exe") or (OriginalFileName = "Seatbelt.exe") or (Description = "Seatbelt") or ((CommandLine matches "* DpapiMasterKeys*" or CommandLine matches "* InterestingProcesses*" or CommandLine matches "* InterestingFiles*" or CommandLine matches "* CertificateThumbprints*" or CommandLine matches "* ChromiumBookmarks*" or CommandLine matches "* ChromiumHistory*" or CommandLine matches "* ChromiumPresence*" or CommandLine matches "* CloudCredentials*" or CommandLine matches "* CredEnum*" or CommandLine matches "* CredGuard*" or CommandLine matches "* FirefoxHistory*" or CommandLine matches "* ProcessCreationEvents*"))) or (((CommandLine matches "* -group=misc*" or CommandLine matches "* -group=remote*" or CommandLine matches "* -group=chromium*" or CommandLine matches "* -group=slack*" or CommandLine matches "* -group=system*" or CommandLine matches "* -group=user*" or CommandLine matches "* -group=all*")) and (CommandLine matches "* -outputfile=*")))
