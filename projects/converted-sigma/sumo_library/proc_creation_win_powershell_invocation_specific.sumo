// Title: Suspicious PowerShell Invocations - Specific - ProcessCreation
// ID: 536e2947-3729-478c-9903-745aaffe60d2
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-05
// Tags: attack.stealth
// Description: Detects suspicious PowerShell invocation command parameters
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((CommandLine matches "*-nop*" and CommandLine matches "* -w *" and CommandLine matches "*hidden*" and CommandLine matches "* -c *" and CommandLine matches "*[Convert]::FromBase64String*")) or ((CommandLine matches "* -w *" and CommandLine matches "*hidden*" and CommandLine matches "*-ep*" and CommandLine matches "*bypass*" and CommandLine matches "*-Enc*")) or ((CommandLine matches "* -w *" and CommandLine matches "*hidden*" and CommandLine matches "*-noni*" and CommandLine matches "*-nop*" and CommandLine matches "* -c *" and CommandLine matches "*iex*" and CommandLine matches "*New-Object*")) or ((CommandLine matches "*iex*" and CommandLine matches "*New-Object*" and CommandLine matches "*Net.WebClient*" and CommandLine matches "*.Download*")) or ((CommandLine matches "*powershell*" and CommandLine matches "*reg*" and CommandLine matches "*add*" and CommandLine matches "*\\software\\*")) or ((CommandLine matches "*bypass*" and CommandLine matches "*-noprofile*" and CommandLine matches "*-windowstyle*" and CommandLine matches "*hidden*" and CommandLine matches "*new-object*" and CommandLine matches "*system.net.webclient*" and CommandLine matches "*.download*"))) and !(((CommandLine matches "*(New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1*" or CommandLine matches "*Write-ChocolateyWarning*"))))
