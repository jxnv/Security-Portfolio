// Title: .RDP File Created By Uncommon Application
// ID: fccfb43e-09a7-4bd2-8b37-a5a7df33386d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.stealth
// Description: Detects creation of a file with an ".rdp" extension by an application that doesn't commonly create such files.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (TargetFilename matches "*.rdp" and (Image matches "*\\brave.exe" or Image matches "*\\CCleaner Browser\\Application\\CCleanerBrowser.exe" or Image matches "*\\chromium.exe" or Image matches "*\\firefox.exe" or Image matches "*\\Google\\Chrome\\Application\\chrome.exe" or Image matches "*\\iexplore.exe" or Image matches "*\\microsoftedge.exe" or Image matches "*\\msedge.exe" or Image matches "*\\Opera.exe" or Image matches "*\\Vivaldi.exe" or Image matches "*\\Whale.exe" or Image matches "*\\olk.exe" or Image matches "*\\Outlook.exe" or Image matches "*\\RuntimeBroker.exe" or Image matches "*\\Thunderbird.exe" or Image matches "*\\Discord.exe" or Image matches "*\\Keybase.exe" or Image matches "*\\msteams.exe" or Image matches "*\\Slack.exe" or Image matches "*\\teams.exe"))
