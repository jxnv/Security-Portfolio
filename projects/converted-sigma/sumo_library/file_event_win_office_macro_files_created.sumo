// Title: Office Macro File Creation
// ID: 91174a41-dc8f-401b-be89-7bfc140612a0
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-23
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects the creation of a new office macro files on the systems
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((TargetFilename matches "*.docm" or TargetFilename matches "*.dotm" or TargetFilename matches "*.xlsm" or TargetFilename matches "*.xltm" or TargetFilename matches "*.potm" or TargetFilename matches "*.pptm")) and !(((Image matches "C:\\Program Files\\Microsoft Office\\*" or Image matches "C:\\Program Files (x86)\\Microsoft Office\\*") and (Image matches "*\\WINWORD.EXE" or Image matches "*\\EXCEL.EXE" or Image matches "*\\POWERPNT.EXE") and TargetFilename matches "*\\~$*")))
