// Title: HackTool - Potential Impacket Lateral Movement Activity
// ID: 10c14723-61c7-4c75-92ca-9af245723ad2
// Status: stable
// Level: high
// Author: Ecco, oscd.community, Jonhnathan Ribeiro, Tim Rauch
// Date: 2019-09-03
// Tags: attack.execution, attack.t1047, attack.lateral-movement, attack.t1021.003
// Description: Detects wmiexec/dcomexec/atexec/smbexec from Impacket framework
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((ParentCommandLine matches "*svchost.exe -k netsvcs*" or ParentCommandLine matches "*taskeng.exe*") and (CommandLine matches "*cmd.exe*" and CommandLine matches "*/C*" and CommandLine matches "*Windows\\Temp\\*" and CommandLine matches "*&1*")) or ((ParentImage matches "*\\wmiprvse.exe" or ParentImage matches "*\\mmc.exe" or ParentImage matches "*\\explorer.exe" or ParentImage matches "*\\services.exe") and (CommandLine matches "*cmd.exe*" and CommandLine matches "*/Q*" and CommandLine matches "*/c*" and CommandLine matches "*\\\\\\\\127.0.0.1\\\\*" and CommandLine matches "*&1*")))
