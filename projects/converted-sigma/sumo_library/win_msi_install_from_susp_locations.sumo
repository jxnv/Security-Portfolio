// Title: MSI Installation From Suspicious Locations
// ID: c7c8aa1c-5aff-408e-828b-998e3620b341
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-31
// Tags: attack.execution
// Description: Detects MSI package installation from suspicious locations
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Provider_Name = "MsiInstaller" and (EventID = "1040" or EventID = "1042") and (Data matches "*:\\Windows\\TEMP\\*" or Data matches "*\\\\\\\\*" or Data matches "*\\Desktop\\*" or Data matches "*\\PerfLogs\\*" or Data matches "*\\Users\\Public\\*")) and !(((Data matches "*C:\\Windows\\TEMP\\UpdHealthTools.msi*") or (Data matches "*\\AppData\\Local\\Temp\\WinGet\\*"))))
