// Title: Network Connection Initiated To AzureWebsites.NET By Non-Browser Process
// ID: 5c80b618-0dbb-46e6-acbb-03d90bcb6d83
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.command-and-control, attack.t1102, attack.t1102.001
// Description: Detects an initiated network connection by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Initiated = "true" and DestinationHostname matches "*azurewebsites.net") and !((((Image matches "C:\\Program Files (x86)\\Avant Browser\\*" or Image matches "C:\\Program Files\\Avant Browser\\*") and Image matches "*\\avant.exe") or (Image matches "C:\\Program Files\\BraveSoftware\\*" and Image matches "*\\brave.exe") or ((Image = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or Image = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or (Image matches "C:\\Users\\*" and Image matches "*\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe") or ((Image matches "*C:\\Program Files\\Windows Defender Advanced Threat Protection\\*" or Image matches "*C:\\Program Files\\Windows Defender\\*" or Image matches "*C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*") and (Image matches "*\\MsMpEng.exe" or Image matches "*\\MsSense.exe")) or (Image matches "*\\AppData\\Local\\Discord\\*" and Image matches "*\\Discord.exe") or ((Image matches "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*") or (Image matches "*\\WindowsApps\\MicrosoftEdge.exe") or ((Image = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or Image = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((Image matches "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\*" or Image matches "C:\\Program Files\\Microsoft\\EdgeCore\\*") and (Image matches "*\\msedge.exe" or Image matches "*\\msedgewebview2.exe")) or (Image = "") or ((Image matches "C:\\Program Files\\Falkon\\*" or Image matches "C:\\Program Files (x86)\\Falkon\\*") and Image matches "*\\falkon.exe") or ((Image = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or Image = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or (Image matches "C:\\Users\\*" and Image matches "*\\AppData\\Local\\Mozilla Firefox\\firefox.exe") or (Image matches "*\\AppData\\Local\\Flock\\*" and Image matches "*\\Flock.exe") or ((Image = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or Image = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (Image matches "*\\AppData\\Local\\Maxthon\\*" and Image matches "*\\maxthon.exe") or (isNull(Image)) or (Image matches "*\\AppData\\Local\\Programs\\Opera\\*" and Image matches "*\\opera.exe") or (Image matches "*\\AppData\\Local\\Phoebe\\*" and Image matches "*\\Phoebe.exe") or ((Image matches "*C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe" or Image matches "*C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe")) or ((Image matches "C:\\Program Files (x86)\\QtWeb\\*" or Image matches "C:\\Program Files\\QtWeb\\*") and Image matches "*\\QtWeb.exe") or ((Image matches "*C:\\Program Files (x86)\\Safari\\*" or Image matches "*C:\\Program Files\\Safari\\*") and Image matches "*\\safari.exe") or ((Image matches "C:\\Program Files\\SeaMonkey\\*" or Image matches "C:\\Program Files (x86)\\SeaMonkey\\*") and Image matches "*\\seamonkey.exe") or ((Image matches "C:\\Program Files\\SlimBrowser\\*" or Image matches "C:\\Program Files (x86)\\SlimBrowser\\*") and Image matches "*\\slimbrowser.exe") or (Image matches "*\\AppData\\Local\\Vivaldi\\*" and Image matches "*\\vivaldi.exe") or ((Image matches "C:\\Program Files\\Naver\\Naver Whale\\*" or Image matches "C:\\Program Files (x86)\\Naver\\Naver Whale\\*") and Image matches "*\\whale.exe") or ((Image matches "C:\\Program Files\\Waterfox\\*" or Image matches "C:\\Program Files (x86)\\Waterfox\\*") and Image matches "*\\Waterfox.exe"))))
