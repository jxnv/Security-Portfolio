// Title: Potential SAM Database Dump
// ID: 4e87b8e2-2ee9-4b2a-a715-4727d297ece0
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-11
// Tags: attack.credential-access, attack.t1003.002
// Description: Detects the creation of files that look like exports of the local SAM (Security Account Manager)
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((TargetFilename matches "*\\Temp\\sam" or TargetFilename matches "*\\sam.sav" or TargetFilename matches "*\\Intel\\sam" or TargetFilename matches "*\\sam.hive" or TargetFilename matches "*\\Perflogs\\sam" or TargetFilename matches "*\\ProgramData\\sam" or TargetFilename matches "*\\Users\\Public\\sam" or TargetFilename matches "*\\AppData\\Local\\sam" or TargetFilename matches "*\\AppData\\Roaming\\sam" or TargetFilename matches "*_ShadowSteal.zip" or TargetFilename matches "*\\Documents\\SAM.export" or TargetFilename matches "*:\\sam")) or ((TargetFilename matches "*\\hive_sam_*" or TargetFilename matches "*\\sam.save*" or TargetFilename matches "*\\sam.export*" or TargetFilename matches "*\\~reg_sam.save*" or TargetFilename matches "*\\sam_backup*" or TargetFilename matches "*\\sam.bck*" or TargetFilename matches "*\\sam.backup*")))
