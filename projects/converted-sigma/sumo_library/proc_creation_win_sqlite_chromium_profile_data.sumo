// Title: SQLite Chromium Profile Data DB Access
// ID: 24c77512-782b-448a-8950-eddb0785fc71
// Status: test
// Level: high
// Author: TropChaud
// Date: 2022-12-19
// Tags: attack.credential-access, attack.t1539, attack.t1555.003, attack.collection, attack.t1005
// Description: Detect usage of the "sqlite" binary to query databases in Chromium-based browsers for potential data stealing.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*\\User Data\\*" or CommandLine matches "*\\Opera Software\\*" or CommandLine matches "*\\ChromiumViewer\\*")) and ((CommandLine matches "*Login Data*" or CommandLine matches "*Cookies*" or CommandLine matches "*Web Data*" or CommandLine matches "*History*" or CommandLine matches "*Bookmarks*")) and ((Product = "SQLite") or ((Image matches "*\\sqlite.exe" or Image matches "*\\sqlite3.exe"))))
