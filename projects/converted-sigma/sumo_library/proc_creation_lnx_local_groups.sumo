// Title: Local Groups Discovery - Linux
// ID: 676381a6-15ca-4d73-a9c8-6a22e970b90d
// Status: test
// Level: low
// Author: Ömer Günal, Alejandro Ortuno, oscd.community
// Date: 2020-10-11
// Tags: attack.discovery, attack.t1069.001
// Description: Detects enumeration of local system groups. Adversaries may attempt to find local system groups and permission settings
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*/groups") or ((Image matches "*/cat" or Image matches "*/ed" or Image matches "*/head" or Image matches "*/less" or Image matches "*/more" or Image matches "*/nano" or Image matches "*/tail" or Image matches "*/vi" or Image matches "*/vim") and CommandLine matches "*/etc/group*"))
