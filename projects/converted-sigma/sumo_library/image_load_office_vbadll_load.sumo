// Title: VBA DLL Loaded Via Office Application
// ID: e6ce8457-68b1-485b-9bdd-3c2b5d679aa9
// Status: test
// Level: high
// Author: Antonlovesdnb
// Date: 2020-02-19
// Tags: attack.execution, attack.t1204.002
// Description: Detects VB DLL's loaded by an office application. Which could indicate the presence of VBA Macros.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\excel.exe" or Image matches "*\\mspub.exe" or Image matches "*\\onenote.exe" or Image matches "*\\onenoteim.exe" or Image matches "*\\outlook.exe" or Image matches "*\\powerpnt.exe" or Image matches "*\\winword.exe") and (ImageLoaded matches "*\\VBE7.DLL" or ImageLoaded matches "*\\VBEUI.DLL" or ImageLoaded matches "*\\VBE7INTL.DLL"))
