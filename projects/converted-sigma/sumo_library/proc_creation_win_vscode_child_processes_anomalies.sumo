// Title: Potentially Suspicious Child Process Of VsCode
// ID: 5a3164f2-b373-4152-93cf-090b13c12d27
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-26
// Tags: attack.execution, attack.stealth, attack.t1218, attack.t1202
// Description: Detects uncommon or suspicious child processes spawning from a VsCode "code.exe" process. This could indicate an attempt of persistence via VsCode tasks or terminal profiles.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((ParentImage matches "*\\code.exe") and (((Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\cmd.exe") and (CommandLine matches "*Invoke-Expressions*" or CommandLine matches "*IEX*" or CommandLine matches "*Invoke-Command*" or CommandLine matches "*ICM*" or CommandLine matches "*DownloadString*" or CommandLine matches "*rundll32*" or CommandLine matches "*regsvr32*" or CommandLine matches "*wscript*" or CommandLine matches "*cscript*")) or ((Image matches "*\\calc.exe" or Image matches "*\\regsvr32.exe" or Image matches "*\\rundll32.exe" or Image matches "*\\cscript.exe" or Image matches "*\\wscript.exe")) or ((Image matches "*:\\Users\\Public\\*" or Image matches "*:\\Windows\\Temp\\*" or Image matches "*:\\Temp\\*"))))
