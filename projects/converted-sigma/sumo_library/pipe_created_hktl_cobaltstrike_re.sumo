// Title: CobaltStrike Named Pipe Pattern Regex
// ID: 0e7163d4-9e19-4fa7-9be6-000c61aad77a
// Status: test
// Level: critical
// Author: Florian Roth (Nextron Systems)
// Date: 2021-07-30
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects the creation of a named pipe matching a pattern used by CobaltStrike Malleable C2 profiles
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((PipeName matches /\\mojo\.5688\.8052\.(?:183894939787088877|35780273329370473)[0-9a-f]{2}/) or (PipeName matches /\\wkssvc_?[0-9a-f]{2}/) or (PipeName matches /\\ntsvcs[0-9a-f]{2}/) or (PipeName matches /\\DserNamePipe[0-9a-f]{2}/) or (PipeName matches /\\SearchTextHarvester[0-9a-f]{2}/) or (PipeName matches /\\mypipe-(?:f|h)[0-9a-f]{2}/) or (PipeName matches /\\windows\.update\.manager[0-9a-f]{2,3}/) or (PipeName matches /\\ntsvcs_[0-9a-f]{2}/) or (PipeName matches /\\scerpc_?[0-9a-f]{2}/) or (PipeName matches /\\PGMessagePipe[0-9a-f]{2}/) or (PipeName matches /\\MsFteWds[0-9a-f]{2}/) or (PipeName matches /\\f4c3[0-9a-f]{2}/) or (PipeName matches /\\fullduplex_[0-9a-f]{2}/) or (PipeName matches /\\msrpc_[0-9a-f]{4}/) or (PipeName matches /\\win\\msrpc_[0-9a-f]{2}/) or (PipeName matches /\\f53f[0-9a-f]{2}$/) or (PipeName matches /\\rpc_[0-9a-f]{2}/) or (PipeName matches /\\spoolss_[0-9a-f]{2}/) or (PipeName matches /\\Winsock2\\CatalogChangeListener-[0-9a-f]{3}-0,/))
