// Title: Antivirus - APT Malware Signature
// ID: 101a1877-2cf4-474d-abfd-7f6ac4788d1a
// Status: experimental
// Level: critical
// Author: Arnim Rupp (Nextron Systems)
// Date: 2026-06-15
// Tags: attack.execution, attack.t1203, attack.command-and-control, attack.t1219.002
// Description: Detects a highly relevant Antivirus alert that reports APT malware.
// This event must not be ignored just because the AV has blocked the malware but investigate, how it came there in the first place.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Signature matches /APT\d/ or Signature matches /ATK\d/ or Signature matches /UNC\d/ or Signature matches /UAC\d/)) or ((Signature matches "*[APT]*" or Signature matches "*APT_*" or Signature matches "*APT-*" or Signature matches "*BackOrder*" or Signature matches "*BlindingCan*" or Signature matches "*Blizzard*" or Signature matches "*Chollima*" or Signature matches "*Cleaver*" or Signature matches "*Cobra*" or Signature matches "*DarkHotel*" or Signature matches "*Dragon*" or Signature matches "*DTrack*" or Signature matches "*Equation*" or Signature matches "*GiftedCrook*" or Signature matches "*GraphSteel*" or Signature matches "*GreyEnergy*" or Signature matches "*GEnergy*" or Signature matches "*GrimPlant*" or Signature matches "*Hydra*" or Signature matches "*Jackal*" or Signature matches "*Kitten*" or Signature matches "*Kimsuky*" or Signature matches "*Lazar*" or Signature matches "*LightRail*" or Signature matches "*Lotus*" or Signature matches "*Luminous*" or Signature matches "*LumiMoth*" or Signature matches "*Nimbus*" or Signature matches "*Manticore*" or Signature matches "*MiniBike*" or Signature matches "*MiniBrowse*" or Signature matches "*MiniBus*" or Signature matches "*MiniFast*" or Signature matches "*MiniJuke*" or Signature matches "*MiniUpdate*" or Signature matches "*MuddyWater*" or Signature matches "*NukeSped*" or Signature matches "*OilRig*" or Signature matches "*Panda*" or Signature matches "*Sandstorm*" or Signature matches "*SandWorm*" or Signature matches "*Seamonkey*" or Signature matches "*Sleet*" or Signature matches "*SlugResin*" or Signature matches "*SnailResin*" or Signature matches "*Snake*" or Signature matches "*Tempest*" or Signature matches "*Tsunami*" or Signature matches "*Turla*" or Signature matches "*Typhoon*" or Signature matches "*UAC_*" or Signature matches "*UAC-*" or Signature matches "*UNC_*" or Signature matches "*UNC-*" or Signature matches "*VinoSiren*" or Signature matches "*Winnti*")))
