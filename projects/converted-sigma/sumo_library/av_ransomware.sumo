// Title: Antivirus - Ransomware Signature
// ID: 4c6ca276-d4d0-4a8c-9e4c-d69832f8671f
// Status: test
// Level: critical
// Author: Florian Roth (Nextron Systems), Arnim Rupp
// Date: 2022-05-12
// Tags: attack.t1486, attack.impact
// Description: Detects a highly relevant Antivirus alert that reports ransomware.
// This event must not be ignored just because the AV has blocked the malware but investigate, how it came there in the first place.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Signature matches "*Babuk*" or Signature matches "*Babyk*" or Signature matches "*BlackWorm*" or Signature matches "*Chaos*" or Signature matches "*Cobra*" or Signature matches "*ContiCrypt*" or Signature matches "*Crypter*" or Signature matches "*Cryptes*" or Signature matches "*Cryptor*" or Signature matches "*CylanCrypt*" or Signature matches "*DelShad*" or Signature matches "*Destructor*" or Signature matches "*Filecoder*" or Signature matches "*GandCrab*" or Signature matches "*GrandCrab*" or Signature matches "*Haperlock*" or Signature matches "*Hiddentear*" or Signature matches "*HydraCrypt*" or Signature matches "*Krypt*" or Signature matches "*Lockbit*" or Signature matches "*Locker*" or Signature matches "*Mallox*" or Signature matches "*Medusa*" or Signature matches "*Phobos*" or Signature matches "*Ransom*" or Signature matches "*Rook*" or Signature matches "*Ryuk*" or Signature matches "*Ryzerlo*" or Signature matches "*Stopcrypt*" or Signature matches "*Tescrypt*" or Signature matches "*TeslaCrypt*" or Signature matches "*WannaCry*" or Signature matches "*Xorist*"))
