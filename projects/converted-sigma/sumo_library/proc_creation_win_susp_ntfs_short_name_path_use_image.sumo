// Title: Use Short Name Path in Image
// ID: a96970af-f126-420d-90e1-d37bf25e50e1
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali
// Date: 2022-08-07
// Tags: attack.stealth, attack.t1564.004
// Description: Detect use of the Windows 8.3 short name. Which could be used as a method to avoid Image detection
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*~1\\*" or Image matches "*~2\\*")) and !(((((Image matches "*\\AppData\\*" and Image matches "*\\Temp\\*")) or ((Image matches "*~1\\unzip.exe" or Image matches "*~1\\7zG.exe"))) or ((ParentImage = "C:\\Windows\\System32\\Dism.exe" or ParentImage = "C:\\Windows\\System32\\cleanmgr.exe")))) and !((((Product = "InstallShield (R)") or (Description = "InstallShield (R) Setup Engine") or (Company = "InstallShield Software Corporation")) or (ParentImage matches "*\\thor\\thor64.exe") or (ParentImage matches "*\\WebEx\\WebexHost.exe"))))
