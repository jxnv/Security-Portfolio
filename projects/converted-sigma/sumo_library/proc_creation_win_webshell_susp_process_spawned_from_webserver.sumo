// Title: Suspicious Process By Web Server Process
// ID: 8202070f-edeb-4d31-a010-a26c72ac5600
// Status: test
// Level: high
// Author: Thomas Patzke, Florian Roth (Nextron Systems), Zach Stanford @svch0st, Tim Shelton, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-01-16
// Tags: attack.persistence, attack.initial-access, attack.t1505.003, attack.t1190
// Description: Detects potentially suspicious processes being spawned by a web server process which could be the result of a successfully placed web shell or exploitation
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((ParentImage matches "*\\java.exe" or ParentImage matches "*\\javaw.exe") and (ParentImage matches "*-tomcat-*" or ParentImage matches "*\\tomcat*")) or ((ParentImage matches "*\\java.exe" or ParentImage matches "*\\javaw.exe") and (ParentCommandLine matches "*CATALINA_HOME*" or ParentCommandLine matches "*catalina.home*" or ParentCommandLine matches "*catalina.jar*")) or ((ParentImage matches "*\\caddy.exe" or ParentImage matches "*\\httpd.exe" or ParentImage matches "*\\nginx.exe" or ParentImage matches "*\\php-cgi.exe" or ParentImage matches "*\\php.exe" or ParentImage matches "*\\tomcat.exe" or ParentImage matches "*\\UMWorkerProcess.exe" or ParentImage matches "*\\w3wp.exe" or ParentImage matches "*\\ws_TomcatService.exe"))) and ((Image matches "*\\arp.exe" or Image matches "*\\at.exe" or Image matches "*\\bash.exe" or Image matches "*\\bitsadmin.exe" or Image matches "*\\certutil.exe" or Image matches "*\\cmd.exe" or Image matches "*\\cscript.exe" or Image matches "*\\dsget.exe" or Image matches "*\\hostname.exe" or Image matches "*\\nbtstat.exe" or Image matches "*\\net.exe" or Image matches "*\\net1.exe" or Image matches "*\\netdom.exe" or Image matches "*\\netsh.exe" or Image matches "*\\nltest.exe" or Image matches "*\\ntdsutil.exe" or Image matches "*\\powershell_ise.exe" or Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\qprocess.exe" or Image matches "*\\query.exe" or Image matches "*\\qwinsta.exe" or Image matches "*\\reg.exe" or Image matches "*\\rundll32.exe" or Image matches "*\\sc.exe" or Image matches "*\\sh.exe" or Image matches "*\\wmic.exe" or Image matches "*\\wscript.exe" or Image matches "*\\wusa.exe")) and !(((ParentImage matches "*\\java.exe" and CommandLine matches "*Windows\\system32\\cmd.exe /c C:\\ManageEngine\\ADManager \"Plus\\ES\\bin\\elasticsearch.bat -Enode.name=RMP-NODE1 -pelasticsearch-pid.txt") or (ParentImage matches "*\\java.exe" and (CommandLine matches "*sc query*" and CommandLine matches "*ADManager Plus*")))))
