// Title: PUA - Sysinternals Tools Execution - Registry
// ID: c7da8edc-49ae-45a2-9e61-9fd860e4e73d
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-24
// Tags: attack.resource-development, attack.t1588.002
// Description: Detects the execution of some potentially unwanted tools such as PsExec, Procdump, etc. (part of the Sysinternals suite) via the creation of the "accepteula" registry key.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((TargetObject matches "*\\Active Directory Explorer*" or TargetObject matches "*\\Handle*" or TargetObject matches "*\\LiveKd*" or TargetObject matches "*\\Process Explorer*" or TargetObject matches "*\\ProcDump*" or TargetObject matches "*\\PsExec*" or TargetObject matches "*\\PsLoglist*" or TargetObject matches "*\\PsPasswd*" or TargetObject matches "*\\SDelete*" or TargetObject matches "*\\Sysinternals*") and TargetObject matches "*\\EulaAccepted")
