// Title: Rundll32 Registered COM Objects
// ID: f1edd233-30b5-4823-9e6a-c4171b24d316
// Status: test
// Level: high
// Author: frack113
// Date: 2022-02-13
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.015
// Description: load malicious registered COM objects
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*-sta *" or CommandLine matches "*-localserver *") and (CommandLine matches "*{*" and CommandLine matches "*}*")) and ((Image matches "*\\rundll32.exe") or (OriginalFileName = "RUNDLL32.EXE")))
