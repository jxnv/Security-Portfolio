// Title: Suspicious File Download From IP Via Wget.EXE
// ID: 17f0c0a8-8bd5-4ee0-8c5f-a342c0199f35
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-07-27
// Tags: attack.execution
// Description: Detects potentially suspicious file downloads directly from IP addresses using Wget.exe
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*.ps1" or CommandLine matches "*.ps1'" or CommandLine matches "*.ps1\"" or CommandLine matches "*.dat" or CommandLine matches "*.dat'" or CommandLine matches "*.dat\"" or CommandLine matches "*.msi" or CommandLine matches "*.msi'" or CommandLine matches "*.msi\"" or CommandLine matches "*.bat" or CommandLine matches "*.bat'" or CommandLine matches "*.bat\"" or CommandLine matches "*.exe" or CommandLine matches "*.exe'" or CommandLine matches "*.exe\"" or CommandLine matches "*.vbs" or CommandLine matches "*.vbs'" or CommandLine matches "*.vbs\"" or CommandLine matches "*.vbe" or CommandLine matches "*.vbe'" or CommandLine matches "*.vbe\"" or CommandLine matches "*.hta" or CommandLine matches "*.hta'" or CommandLine matches "*.hta\"" or CommandLine matches "*.dll" or CommandLine matches "*.dll'" or CommandLine matches "*.dll\"" or CommandLine matches "*.psm1" or CommandLine matches "*.psm1'" or CommandLine matches "*.psm1\"")) and ((CommandLine matches /\s-O\s/) or (CommandLine matches "*--output-document*")) and (CommandLine matches "*http*") and ((Image matches "*\\wget.exe") or (OriginalFileName = "wget.exe")) and (CommandLine matches /://[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}/))
