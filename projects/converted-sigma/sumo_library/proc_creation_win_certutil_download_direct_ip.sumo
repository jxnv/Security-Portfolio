// Title: Suspicious File Downloaded From Direct IP Via Certutil.EXE
// ID: 13e6fe51-d478-4c7e-b0f2-6da9b400a829
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-15
// Tags: attack.stealth, attack.t1027, attack.command-and-control, attack.t1105
// Description: Detects the execution of certutil with certain flags that allow the utility to download files from direct IPs.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((CommandLine matches "*urlcache *" or CommandLine matches "*verifyctl *" or CommandLine matches "*URL *")) and ((CommandLine matches "*://1*" or CommandLine matches "*://2*" or CommandLine matches "*://3*" or CommandLine matches "*://4*" or CommandLine matches "*://5*" or CommandLine matches "*://6*" or CommandLine matches "*://7*" or CommandLine matches "*://8*" or CommandLine matches "*://9*")) and ((Image matches "*\\certutil.exe") or (OriginalFileName = "CertUtil.exe"))) and !((CommandLine matches "*://7-*")))
