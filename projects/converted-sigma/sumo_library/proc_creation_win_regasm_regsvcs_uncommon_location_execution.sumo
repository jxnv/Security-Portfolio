// Title: Potentially Suspicious Execution Of Regasm/Regsvcs From Uncommon Location
// ID: cc368ed0-2411-45dc-a222-510ace303cb2
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-25
// Tags: attack.stealth, attack.t1218.009
// Description: Detects potentially suspicious execution of the Regasm/Regsvcs utilities from a potentially suspicious location
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*\\AppData\\Local\\Temp\\*" or CommandLine matches "*\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\*" or CommandLine matches "*\\PerfLogs\\*" or CommandLine matches "*\\Users\\Public\\*" or CommandLine matches "*\\Windows\\Temp\\*")) and (((Image matches "*\\Regsvcs.exe" or Image matches "*\\Regasm.exe")) or ((OriginalFileName = "RegSvcs.exe" or OriginalFileName = "RegAsm.exe"))))
