_sourceCategory=* | where ((Image matches "*\\tapinstall.exe") and !((((Image matches "*:\\Program Files\\Avast Software\\SecureLine VPN\\*" or Image matches "*:\\Program Files (x86)\\Avast Software\\SecureLine VPN\\*")) or (Image matches "*:\\Program Files\\OpenVPN Connect\\drivers\\tap\\*") or (Image matches "*:\\Program Files (x86)\\Proton Technologies\\ProtonVPNTap\\installer\\*"))))
