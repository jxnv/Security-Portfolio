// Title: Antivirus - Web Shell Detection Signature
// ID: fdf135a2-9241-4f96-a114-bb404948f736
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Arnim Rupp
// Date: 2018-09-09
// Tags: attack.persistence, attack.t1505.003
// Description: Detects a highly relevant Antivirus alert that reports a web shell.
// It's highly recommended to tune this rule to the specific strings used by your anti virus solution by downloading a big WebShell repository from e.g. github and checking the matches.
// This event must not be ignored just because the AV has blocked the malware but investigate, how it came there in the first place.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Signature matches "ASP.*" or Signature matches "IIS/BackDoor*" or Signature matches "JAVA/Backdoor*" or Signature matches "JSP.*" or Signature matches "Perl.*" or Signature matches "PHP.*" or Signature matches "Troj/ASP*" or Signature matches "Troj/JSP*" or Signature matches "Troj/PHP*" or Signature matches "VBS/Uxor*")) or ((Signature matches "*ASP_*" or Signature matches "*ASP:*" or Signature matches "*ASP.Agent*" or Signature matches "*ASP/*" or Signature matches "*Aspdoor*" or Signature matches "*ASPXSpy*" or Signature matches "*Backdoor.ASP*" or Signature matches "*Backdoor.Java*" or Signature matches "*Backdoor.JSP*" or Signature matches "*Backdoor.PHP*" or Signature matches "*Backdoor.VBS*" or Signature matches "*Backdoor/ASP*" or Signature matches "*Backdoor/Java*" or Signature matches "*Backdoor/JSP*" or Signature matches "*Backdoor/PHP*" or Signature matches "*Backdoor/VBS*" or Signature matches "*C99shell*" or Signature matches "*Chopper*" or Signature matches "*filebrowser*" or Signature matches "*JSP_*" or Signature matches "*JSP:*" or Signature matches "*JSP.Agent*" or Signature matches "*JSP/*" or Signature matches "*Perl:*" or Signature matches "*Perl/*" or Signature matches "*PHP_*" or Signature matches "*PHP:*" or Signature matches "*PHP.Agent*" or Signature matches "*PHP/*" or Signature matches "*PHPShell*" or Signature matches "*PShlSpy*" or Signature matches "*SinoChoper*" or Signature matches "*Trojan.ASP*" or Signature matches "*Trojan.JSP*" or Signature matches "*Trojan.PHP*" or Signature matches "*Trojan.VBS*" or Signature matches "*VBS.Agent*" or Signature matches "*VBS/Agent*" or Signature matches "*Webshell*")))
