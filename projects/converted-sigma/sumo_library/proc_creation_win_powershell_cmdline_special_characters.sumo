// Title: Potential PowerShell Command Line Obfuscation
// ID: d7bcd677-645d-4691-a8d4-7a5602b780d1
// Status: test
// Level: high
// Author: Teymur Kheirkhabarov (idea), Vasiliy Burov (rule), oscd.community, Tim Shelton (fp)
// Date: 2020-10-15
// Tags: attack.execution, attack.stealth, attack.t1027, attack.t1059.001
// Description: Detects the PowerShell command lines with special characters
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((((Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe")) or ((OriginalFileName = "PowerShell.EXE" or OriginalFileName = "pwsh.dll"))) and ((CommandLine matches /\+.*\+.*\+.*\+.*\+.*\+.*\+.*\+.*\+.*\+.*\+.*\+.*\+.*\+/) or (CommandLine matches /\{.*\{.*\{.*\{.*\{.*\{.*\{.*\{.*\{.*\{/) or (CommandLine matches /\^.*\^.*\^.*\^.*\^/) or (CommandLine matches /`.*`.*`.*`.*`/))) and !(((ParentImage = "C:\\Program Files\\Amazon\\SSM\\ssm-document-worker.exe") or ((CommandLine matches "*new EventSource(\"Microsoft.Windows.Sense.Client.Management\"*" or CommandLine matches "*public static extern bool InstallELAMCertificateInfo(SafeFileHandle handle);*")))))
