// Title: Use NTFS Short Name in Image
// ID: 3ef5605c-9eb9-47b0-9a71-b727e6aa5c3b
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-06
// Tags: attack.stealth, attack.t1564.004
// Description: Detect use of the Windows 8.3 short name. Which could be used as a method to avoid Image based detection
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*~1.bat*" or Image matches "*~1.dll*" or Image matches "*~1.exe*" or Image matches "*~1.hta*" or Image matches "*~1.js*" or Image matches "*~1.msi*" or Image matches "*~1.ps1*" or Image matches "*~1.tmp*" or Image matches "*~1.vbe*" or Image matches "*~1.vbs*" or Image matches "*~2.bat*" or Image matches "*~2.dll*" or Image matches "*~2.exe*" or Image matches "*~2.hta*" or Image matches "*~2.js*" or Image matches "*~2.msi*" or Image matches "*~2.ps1*" or Image matches "*~2.tmp*" or Image matches "*~2.vbe*" or Image matches "*~2.vbs*")) and !((ParentImage = "C:\\Windows\\explorer.exe")) and !(((ParentImage matches "*\\thor\\thor64.exe") or (Image matches "*\\VCREDI~1.EXE") or (ParentImage matches "*\\WebEx\\WebexHost.exe") or (Image = "C:\\PROGRA~1\\WinZip\\WZPREL~1.EXE"))))
