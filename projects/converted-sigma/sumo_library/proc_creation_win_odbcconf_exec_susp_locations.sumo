// Title: Odbcconf.EXE Suspicious DLL Location
// ID: 6b65c28e-11f3-46cb-902a-68f2cafaf474
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-22
// Tags: attack.stealth, attack.t1218.008
// Description: Detects execution of "odbcconf" where the path of the DLL being registered is located in a potentially suspicious location.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*:\\PerfLogs\\*" or CommandLine matches "*:\\ProgramData\\*" or CommandLine matches "*:\\Temp\\*" or CommandLine matches "*:\\Users\\Public\\*" or CommandLine matches "*:\\Windows\\Registration\\CRMLog*" or CommandLine matches "*:\\Windows\\System32\\com\\dmp\\*" or CommandLine matches "*:\\Windows\\System32\\FxsTmp\\*" or CommandLine matches "*:\\Windows\\System32\\Microsoft\\Crypto\\RSA\\MachineKeys\\*" or CommandLine matches "*:\\Windows\\System32\\spool\\drivers\\color\\*" or CommandLine matches "*:\\Windows\\System32\\spool\\PRINTERS\\*" or CommandLine matches "*:\\Windows\\System32\\spool\\SERVERS\\*" or CommandLine matches "*:\\Windows\\System32\\Tasks_Migrated\\*" or CommandLine matches "*:\\Windows\\System32\\Tasks\\Microsoft\\Windows\\SyncCenter\\*" or CommandLine matches "*:\\Windows\\SysWOW64\\com\\dmp\\*" or CommandLine matches "*:\\Windows\\SysWOW64\\FxsTmp\\*" or CommandLine matches "*:\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\PLA\\System\\*" or CommandLine matches "*:\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\SyncCenter\\*" or CommandLine matches "*:\\Windows\\Tasks\\*" or CommandLine matches "*:\\Windows\\Temp\\*" or CommandLine matches "*:\\Windows\\Tracing\\*" or CommandLine matches "*\\AppData\\Local\\Temp\\*" or CommandLine matches "*\\AppData\\Roaming\\*")) and ((Image matches "*\\odbcconf.exe") or (OriginalFileName = "odbcconf.exe")))
