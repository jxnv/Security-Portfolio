// Title: Renamed Microsoft Teams Execution
// ID: 88f46b67-14d4-4f45-ac2c-d66984f22191
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-07-12
// Tags: attack.stealth
// Description: Detects the execution of a renamed Microsoft Teams binary.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((OriginalFileName = "msteams.exe" or OriginalFileName = "teams.exe")) and !(((Image matches "*\\msteams.exe" or Image matches "*\\teams.exe"))))
