// Title: NTDS.DIT Creation By Uncommon Parent Process
// ID: 4e7050dd-e548-483f-b7d6-527ab4fa784d
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-11
// Tags: attack.credential-access, attack.t1003.003
// Description: Detects creation of a file named "ntds.dit" (Active Directory Database) by an uncommon parent process or directory
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((TargetFilename matches "*\\ntds.dit") and (((ParentImage matches "*\\cscript.exe" or ParentImage matches "*\\httpd.exe" or ParentImage matches "*\\nginx.exe" or ParentImage matches "*\\php-cgi.exe" or ParentImage matches "*\\powershell.exe" or ParentImage matches "*\\pwsh.exe" or ParentImage matches "*\\w3wp.exe" or ParentImage matches "*\\wscript.exe")) or ((ParentImage matches "*\\apache*" or ParentImage matches "*\\tomcat*" or ParentImage matches "*\\AppData\\*" or ParentImage matches "*\\Temp\\*" or ParentImage matches "*\\Public\\*" or ParentImage matches "*\\PerfLogs\\*"))))
