// Title: RDP Connection Allowed Via Netsh.EXE
// ID: 01aeb693-138d-49d2-9403-c4f52d7d3d62
// Status: test
// Level: high
// Author: Sander Wiebing
// Date: 2020-05-23
// Tags: attack.defense-impairment, attack.t1686.003
// Description: Detects usage of the netsh command to open and allow connections to port 3389 (RDP). As seen used by Sarwent Malware
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*firewall *" and CommandLine matches "*add *" and CommandLine matches "*tcp *" and CommandLine matches "*3389*") and (CommandLine matches "*portopening*" or CommandLine matches "*allow*")) and ((Image matches "*\\netsh.exe") or (OriginalFileName = "netsh.exe")))
