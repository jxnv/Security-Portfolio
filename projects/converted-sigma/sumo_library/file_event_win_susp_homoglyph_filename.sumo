// Title: Potential Homoglyph Attack Using Lookalike Characters in Filename
// ID: 4f1707b1-b50b-45b4-b5a2-3978b5a5d0d6
// Status: test
// Level: medium
// Author: Micah Babinski, @micahbabinski
// Date: 2023-05-08
// Tags: attack.stealth, attack.t1036, attack.t1036.003
// Description: Detects the presence of unicode characters which are homoglyphs, or identical in appearance, to ASCII letter characters.
// This is used as an obfuscation and masquerading techniques. Only "perfect" homoglyphs are included; these are characters that
// are indistinguishable from ASCII characters and thus may make excellent candidates for homoglyph attack characters.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((TargetFilename matches "*а*" or TargetFilename matches "*е*" or TargetFilename matches "*о*" or TargetFilename matches "*р*" or TargetFilename matches "*с*" or TargetFilename matches "*х*" or TargetFilename matches "*ѕ*" or TargetFilename matches "*і*" or TargetFilename matches "*ӏ*" or TargetFilename matches "*ј*" or TargetFilename matches "*һ*" or TargetFilename matches "*ԁ*" or TargetFilename matches "*ԛ*" or TargetFilename matches "*ԝ*" or TargetFilename matches "*ο*")) or ((TargetFilename matches "*А*" or TargetFilename matches "*В*" or TargetFilename matches "*Е*" or TargetFilename matches "*К*" or TargetFilename matches "*М*" or TargetFilename matches "*Н*" or TargetFilename matches "*О*" or TargetFilename matches "*Р*" or TargetFilename matches "*С*" or TargetFilename matches "*Т*" or TargetFilename matches "*Х*" or TargetFilename matches "*Ѕ*" or TargetFilename matches "*І*" or TargetFilename matches "*Ј*" or TargetFilename matches "*Ү*" or TargetFilename matches "*Ӏ*" or TargetFilename matches "*Ԍ*" or TargetFilename matches "*Ԛ*" or TargetFilename matches "*Ԝ*" or TargetFilename matches "*Α*" or TargetFilename matches "*Β*" or TargetFilename matches "*Ε*" or TargetFilename matches "*Ζ*" or TargetFilename matches "*Η*" or TargetFilename matches "*Ι*" or TargetFilename matches "*Κ*" or TargetFilename matches "*Μ*" or TargetFilename matches "*Ν*" or TargetFilename matches "*Ο*" or TargetFilename matches "*Ρ*" or TargetFilename matches "*Τ*" or TargetFilename matches "*Υ*" or TargetFilename matches "*Χ*")))
