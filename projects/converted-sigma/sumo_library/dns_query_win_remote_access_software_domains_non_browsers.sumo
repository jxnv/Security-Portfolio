// Title: DNS Query To Remote Access Software Domain From Non-Browser App
// ID: 4d07b1f4-cb00-4470-b9f8-b0191d48ff52
// Status: test
// Level: medium
// Author: frack113, Connor Martin
// Date: 2022-07-11
// Tags: attack.command-and-control, attack.t1219.002
// Description: An adversary may use legitimate desktop support and remote access software, such as Team Viewer, Go2Assist, LogMein, AmmyyAdmin, etc, to establish an interactive command and control channel to target systems within networks.
// These services are commonly used as legitimate technical support software, and may be allowed by application control within a target environment.
// Remote access tools like VNC, Ammyy, and Teamviewer are used frequently when compared with other legitimate software commonly used by adversaries. (Citation: Symantec Living off the Land)
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((QueryName matches "*agent.jumpcloud.com" or QueryName matches "*agentreporting.atera.com" or QueryName matches "*ammyy.com" or QueryName matches "*api.parsec.app" or QueryName matches "*api.playanext.com" or QueryName matches "*api.splashtop.com" or QueryName matches "*app.atera.com" or QueryName matches "*assist.zoho.com" or QueryName matches "*authentication.logmeininc.com" or QueryName matches "*beyondtrustcloud.com" or QueryName matches "*cdn.kaseya.net" or QueryName matches "*client.teamviewer.com" or QueryName matches "*comserver.corporate.beanywhere.com" or QueryName matches "*control.connectwise.com" or QueryName matches "*downloads.zohocdn.com" or QueryName matches "*dwservice.net" or QueryName matches "*express.gotoassist.com" or QueryName matches "*getgo.com" or QueryName matches "*getscreen.me" or QueryName matches "*integratedchat.teamviewer.com" or QueryName matches "*join.zoho.com" or QueryName matches "*kickstart.jumpcloud.com" or QueryName matches "*license.bomgar.com" or QueryName matches "*logmein-gateway.com" or QueryName matches "*logmein.com" or QueryName matches "*logmeincdn.http.internapcdn.net" or QueryName matches "*n-able.com" or QueryName matches "*net.anydesk.com" or QueryName matches "*netsupportsoftware.com" or QueryName matches "*parsecusercontent.com" or QueryName matches "*pubsub.atera.com" or QueryName matches "*relay.kaseya.net" or QueryName matches "*relay.screenconnect.com" or QueryName matches "*relay.splashtop.com" or QueryName matches "*remoteassistance.support.services.microsoft.com" or QueryName matches "*remotedesktop-pa.googleapis.com" or QueryName matches "*remoteutilities.com" or QueryName matches "*secure.logmeinrescue.com" or QueryName matches "*services.vnc.com" or QueryName matches "*static.remotepc.com" or QueryName matches "*swi-rc.com" or QueryName matches "*swi-tc.com" or QueryName matches "*tailscale.com" or QueryName matches "*telemetry.servers.qetqo.com" or QueryName matches "*tmate.io" or QueryName matches "*twingate.com" or QueryName matches "*zohoassist.com")) or (QueryName matches "*.rustdesk.com" and QueryName matches "rs-*")) and !((((Image matches "C:\\Program Files (x86)\\Avant Browser\\*" or Image matches "C:\\Program Files\\Avant Browser\\*") and Image matches "*\\avant.exe") or (Image matches "*\\brave.exe" and Image matches "C:\\Program Files\\BraveSoftware\\*") or ((Image = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or Image = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or ((Image matches "*\\MsMpEng.exe" or Image matches "*\\MsSense.exe")) or ((Image matches "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*") or (Image matches "*\\WindowsApps\\MicrosoftEdge.exe") or ((Image = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or Image = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((Image matches "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\*" or Image matches "C:\\Program Files\\Microsoft\\EdgeCore\\*") and (Image matches "*\\msedge.exe" or Image matches "*\\msedgewebview2.exe")) or ((Image matches "C:\\Program Files\\Falkon\\*" or Image matches "C:\\Program Files (x86)\\Falkon\\*") and Image matches "*\\falkon.exe") or ((Image = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or Image = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or (Image matches "*\\AppData\\Local\\Flock\\*" and Image matches "*\\Flock.exe") or ((Image = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or Image = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (Image matches "*\\AppData\\Local\\Maxthon\\*" and Image matches "*\\maxthon.exe") or (Image matches "*\\AppData\\Local\\Programs\\midori-ng\\*" and Image matches "*\\Midori Next Generation.exe") or (Image matches "*\\AppData\\Local\\Programs\\Opera\\*" and Image matches "*\\opera.exe") or (Image matches "*\\AppData\\Local\\Phoebe\\*" and Image matches "*\\Phoebe.exe") or (Image matches "*\\safari.exe") or ((Image matches "C:\\Program Files\\SeaMonkey\\*" or Image matches "C:\\Program Files (x86)\\SeaMonkey\\*") and Image matches "*\\seamonkey.exe") or ((Image matches "C:\\Program Files\\SlimBrowser\\*" or Image matches "C:\\Program Files (x86)\\SlimBrowser\\*") and Image matches "*\\slimbrowser.exe") or (Image matches "*\\Tor Browser\\*") or (Image matches "*\\AppData\\Local\\Vivaldi\\*" and Image matches "*\\vivaldi.exe") or ((Image matches "C:\\Program Files\\Naver\\Naver Whale\\*" or Image matches "C:\\Program Files (x86)\\Naver\\Naver Whale\\*") and Image matches "*\\whale.exe") or ((Image matches "C:\\Program Files\\Waterfox\\*" or Image matches "C:\\Program Files (x86)\\Waterfox\\*") and Image matches "*\\Waterfox.exe"))))
