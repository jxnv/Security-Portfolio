// Title: HackTool - Certipy Execution
// ID: 6938366d-8954-4ddc-baff-c830b3ba8fcd
// Status: test
// Level: high
// Author: pH-T (Nextron Systems), Sittikorn Sangrattanapitak
// Date: 2023-04-17
// Tags: attack.discovery, attack.credential-access, attack.t1649
// Description: Detects Certipy execution, a tool for Active Directory Certificate Services enumeration and abuse based on PE metadata characteristics and common command line arguments.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*\\Certipy.exe") or (OriginalFileName = "Certipy.exe") or (Description matches "*Certipy*")) or (((CommandLine matches "* account *" or CommandLine matches "* auth *" or CommandLine matches "* cert *" or CommandLine matches "* find *" or CommandLine matches "* forge *" or CommandLine matches "* ptt *" or CommandLine matches "* relay *" or CommandLine matches "* req *" or CommandLine matches "* shadow *" or CommandLine matches "* template *")) and ((CommandLine matches "* -bloodhound*" or CommandLine matches "* -ca-pfx *" or CommandLine matches "* -dc-ip *" or CommandLine matches "* -kirbi*" or CommandLine matches "* -old-bloodhound*" or CommandLine matches "* -pfx *" or CommandLine matches "* -target*" or CommandLine matches "* -template*" or CommandLine matches "* -username *" or CommandLine matches "* -vulnerable*" or CommandLine matches "*auth -pfx*" or CommandLine matches "*shadow auto*" or CommandLine matches "*shadow list*"))))
