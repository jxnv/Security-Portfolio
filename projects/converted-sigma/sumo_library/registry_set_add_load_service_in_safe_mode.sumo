// Title: Registry Persistence via Service in Safe Mode
// ID: 1547e27c-3974-43e2-a7d7-7f484fb928ec
// Status: test
// Level: high
// Author: frack113
// Date: 2022-04-04
// Tags: attack.stealth, attack.t1564.001
// Description: Detects the modification of the registry to allow a driver or service to persist in Safe Mode.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((TargetObject matches "*\\Control\\SafeBoot\\Minimal\\*" or TargetObject matches "*\\Control\\SafeBoot\\Network\\*") and TargetObject matches "*\\(Default)" and Details = "Service") and !(((Image = "C:\\Hexnode\\Hexnode Agent\\Current\\HexnodeAgent.exe" and (TargetObject matches "*\\Control\\SafeBoot\\Minimal\\Hexnode Updater\\(Default)" or TargetObject matches "*\\Control\\SafeBoot\\Network\\Hexnode Updater\\(Default)" or TargetObject matches "*\\Control\\SafeBoot\\Minimal\\Hexnode Agent\\(Default)" or TargetObject matches "*\\Control\\SafeBoot\\Network\\Hexnode Agent\\(Default)") and Details = "Service") or (Image matches "*\\MBAMInstallerService.exe" and TargetObject matches "*\\MBAMService\\(Default)" and Details = "Service") or (Image = "C:\\WINDOWS\\system32\\msiexec.exe" and (TargetObject matches "*\\Control\\SafeBoot\\Minimal\\SAVService\\(Default)" or TargetObject matches "*\\Control\\SafeBoot\\Network\\SAVService\\(Default)")))))
