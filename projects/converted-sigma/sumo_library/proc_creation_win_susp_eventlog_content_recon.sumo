// Title: Potentially Suspicious EventLog Recon Activity Using Log Query Utilities
// ID: beaa66d6-aa1b-4e3c-80f5-e0145369bfaf
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.credential-access, attack.discovery, attack.t1552, attack.t1087
// Description: Detects execution of different log query utilities and commands to search and dump the content of specific event logs or look for specific event IDs.
// This technique is used by threat actors in order to extract sensitive information from events logs such as usernames, IP addresses, hostnames, etc.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((CommandLine matches "*-InstanceId 462?*" or CommandLine matches "*.eventid -eq 462?*" or CommandLine matches "*.ID -eq 462?*" or CommandLine matches "*EventCode=?462?*" or CommandLine matches "*EventIdentifier=?462?*" or CommandLine matches "*System[EventID=462?]*" or CommandLine matches "*-InstanceId 4778*" or CommandLine matches "*.eventid -eq 4778*" or CommandLine matches "*.ID -eq 4778*" or CommandLine matches "*EventCode=?4778?*" or CommandLine matches "*EventIdentifier=?4778?*" or CommandLine matches "*System[EventID=4778]*" or CommandLine matches "*-InstanceId 25*" or CommandLine matches "*.eventid -eq 25*" or CommandLine matches "*.ID -eq 25*" or CommandLine matches "*EventCode=?25?*" or CommandLine matches "*EventIdentifier=?25?*" or CommandLine matches "*System[EventID=25]*" or CommandLine matches "*-InstanceId 1149*" or CommandLine matches "*.eventid -eq 1149*" or CommandLine matches "*.ID -eq 1149*" or CommandLine matches "*EventCode=?1149?*" or CommandLine matches "*EventIdentifier=?1149?*" or CommandLine matches "*System[EventID=1149]*" or CommandLine matches "*-InstanceId 21*" or CommandLine matches "*.eventid -eq 21*" or CommandLine matches "*.ID -eq 21*" or CommandLine matches "*EventCode=?21?*" or CommandLine matches "*EventIdentifier=?21?*" or CommandLine matches "*System[EventID=21]*" or CommandLine matches "*-InstanceId 22*" or CommandLine matches "*.eventid -eq 22*" or CommandLine matches "*.ID -eq 22*" or CommandLine matches "*EventCode=?22?*" or CommandLine matches "*EventIdentifier=?22?*" or CommandLine matches "*System[EventID=22]*")) or ((CommandLine matches "*Microsoft-Windows-PowerShell*" or CommandLine matches "*Microsoft-Windows-Security-Auditing*" or CommandLine matches "*Microsoft-Windows-TerminalServices-LocalSessionManager*" or CommandLine matches "*Microsoft-Windows-TerminalServices-RemoteConnectionManager*" or CommandLine matches "*Microsoft-Windows-Windows Defender*" or CommandLine matches "*PowerShellCore*" or CommandLine matches "*Security*" or CommandLine matches "*Windows PowerShell*"))) and (((CommandLine matches "*Select*" and CommandLine matches "*Win32_NTLogEvent*")) or (((CommandLine matches "* qe *" or CommandLine matches "* query-events *")) and ((Image matches "*\\wevtutil.exe") or (OriginalFileName = "wevtutil.exe"))) or ((CommandLine matches "* ntevent*") and ((Image matches "*\\wmic.exe") or (OriginalFileName = "wmic.exe"))) or ((CommandLine matches "*Get-WinEvent *" or CommandLine matches "*get-eventlog *"))))
