// Title: Suspicious Child Process Of Wermgr.EXE
// ID: 396f6630-f3ac-44e3-bfc8-1b161bc00c4e
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-10-14
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055, attack.t1036
// Description: Detects suspicious Windows Error Reporting manager (wermgr.exe) child process
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((ParentImage matches "*\\wermgr.exe" and (Image matches "*\\cmd.exe" or Image matches "*\\cscript.exe" or Image matches "*\\ipconfig.exe" or Image matches "*\\mshta.exe" or Image matches "*\\net.exe" or Image matches "*\\net1.exe" or Image matches "*\\netstat.exe" or Image matches "*\\nslookup.exe" or Image matches "*\\powershell_ise.exe" or Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\regsvr32.exe" or Image matches "*\\rundll32.exe" or Image matches "*\\systeminfo.exe" or Image matches "*\\whoami.exe" or Image matches "*\\wscript.exe")) and !((Image matches "*\\rundll32.exe" and (CommandLine matches "*C:\\Windows\\system32\\WerConCpl.dll*" and CommandLine matches "*LaunchErcApp *") and (CommandLine matches "*-queuereporting*" or CommandLine matches "*-responsepester*"))))
