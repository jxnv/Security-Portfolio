// Title: Important Scheduled Task Deleted or Disabled
// ID: 9e3cb244-bdb8-4632-8c90-6079c8f4f16d
// Status: test
// Level: high
// Author: frack113
// Date: 2023-01-13
// Tags: attack.impact, attack.t1489
// Description: Detects when adversaries try to stop system services or processes by deleting or disabling their respective scheduled tasks in order to conduct data destructive activities
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((EventID = "141" or EventID = "142") and (TaskName matches "*\\Windows\\SystemRestore\\SR*" or TaskName matches "*\\Windows\\Windows Defender\\*" or TaskName matches "*\\Windows\\BitLocker*" or TaskName matches "*\\Windows\\WindowsBackup\\*" or TaskName matches "*\\Windows\\WindowsUpdate\\*" or TaskName matches "*\\Windows\\UpdateOrchestrator\\*" or TaskName matches "*\\Windows\\ExploitGuard*")) and !(((UserName matches "*AUTHORI*" or UserName matches "*AUTORI*"))))
