// Title: Access of Sudoers File Content
// ID: 0f79c4d2-4e1f-4683-9c36-b5469a665e06
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-06-20
// Tags: attack.reconnaissance, attack.t1592.004
// Description: Detects the execution of a text-based file access or inspection utilities to read the content of /etc/sudoers in order to potentially list all users that have sudo rights.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*/cat" or Image matches "*/ed" or Image matches "*/egrep" or Image matches "*/emacs" or Image matches "*/fgrep" or Image matches "*/grep" or Image matches "*/head" or Image matches "*/less" or Image matches "*/more" or Image matches "*/nano" or Image matches "*/tail") and CommandLine matches "* /etc/sudoers*")
