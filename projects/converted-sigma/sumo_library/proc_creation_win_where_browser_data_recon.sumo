// Tags: attack.discovery, attack.t1217
// Description: Adversaries may enumerate browser bookmarks to learn more about compromised hosts.
// Browser bookmarks may reveal personal information about users (ex: banking sites, interests, social media, etc.) as well as details about
// internal network resources such as servers, tools/dashboards, or other related infrastructure.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*\\where.exe") or (OriginalFileName = "where.exe")) and ((CommandLine matches "*places.sqlite*" or CommandLine matches "*cookies.sqlite*" or CommandLine matches "*formhistory.sqlite*" or CommandLine matches "*logins.json*" or CommandLine matches "*key4.db*" or CommandLine matches "*key3.db*" or CommandLine matches "*sessionstore.jsonlz4*" or CommandLine matches "*History*" or CommandLine matches "*Bookmarks*" or CommandLine matches "*Cookies*" or CommandLine matches "*Login Data*")))
