// Title: BloodHound Collection Files
// ID: 02773bed-83bf-469f-b7ff-e676e7d78bab
// Status: test
// Level: high
// Author: C.J. May
// Date: 2022-08-09
// Tags: attack.discovery, attack.t1087.001, attack.t1087.002, attack.t1482, attack.t1069.001, attack.t1069.002, attack.execution, attack.t1059.001
// Description: Detects default file names outputted by the BloodHound collection tool SharpHound
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((TargetFilename matches "*BloodHound.zip" or TargetFilename matches "*_computers.json" or TargetFilename matches "*_containers.json" or TargetFilename matches "*_gpos.json" or TargetFilename matches "*_groups.json" or TargetFilename matches "*_ous.json" or TargetFilename matches "*_users.json")) and !((Image matches "*\\svchost.exe" and TargetFilename matches "C:\\Program Files\\WindowsApps\\Microsoft.*" and TargetFilename matches "*\\pocket_containers.json")))
