// Title: Potential Binary Or Script Dropper Via PowerShell
// ID: 7047d730-036f-4f40-b9d8-1c63e36d5e62
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-03-17
// Tags: attack.persistence
// Description: Detects PowerShell creating a binary executable or a script file.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*\\powershell.exe" or Image matches "*\\powershell_ise.exe" or Image matches "*\\pwsh.exe") and (TargetFilename matches "*.bat" or TargetFilename matches "*.chm" or TargetFilename matches "*.cmd" or TargetFilename matches "*.com" or TargetFilename matches "*.dll" or TargetFilename matches "*.exe" or TargetFilename matches "*.hta" or TargetFilename matches "*.jar" or TargetFilename matches "*.js" or TargetFilename matches "*.ocx" or TargetFilename matches "*.scr" or TargetFilename matches "*.sys" or TargetFilename matches "*.vbe" or TargetFilename matches "*.vbs" or TargetFilename matches "*.wsf")) and !(((TargetFilename matches "C:\\Program Files\\PackageManagement\\ProviderAssemblies\\nuget\\*" and TargetFilename matches "*\\Microsoft.PackageManagement.NuGetProvider.dll") or ((TargetFilename matches "C:\\Windows\\Temp\\*" or TargetFilename matches "C:\\Windows\\SystemTemp\\*") and (TargetFilename matches "*.dll" or TargetFilename matches "*.exe")) or (TargetFilename matches "C:\\Users\\*" and TargetFilename matches "*\\WindowsPowerShell\\Modules\\*" and TargetFilename matches "*.dll") or (TargetFilename matches "C:\\Users\\*" and TargetFilename matches "*\\AppData\\Local\\Temp\\*" and (TargetFilename matches "*.dll" or TargetFilename matches "*.exe")))))
