// Title: BITS Transfer Job Download From File Sharing Domains
// ID: d635249d-86b5-4dad-a8c7-d7272b788586
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-06-28
// Tags: attack.persistence, attack.execution, attack.stealth, attack.t1197
// Description: Detects BITS transfer job downloading files from a file sharing domain.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (EventID = "16403" and (RemoteName matches "*.githubusercontent.com*" or RemoteName matches "*0x0.st*" or RemoteName matches "*anonfiles.com*" or RemoteName matches "*bashupload.com*" or RemoteName matches "*cdn.discordapp.com*" or RemoteName matches "*chunk.io*" or RemoteName matches "*ddns.net*" or RemoteName matches "*dl.dropboxusercontent.com*" or RemoteName matches "*ghostbin.co*" or RemoteName matches "*github.com*" or RemoteName matches "*glitch.me*" or RemoteName matches "*gofile.io*" or RemoteName matches "*hastebin.com*" or RemoteName matches "*mediafire.com*" or RemoteName matches "*mega.nz*" or RemoteName matches "*onrender.com*" or RemoteName matches "*pages.dev*" or RemoteName matches "*paste.ee*" or RemoteName matches "*pastebin.com*" or RemoteName matches "*pastebin.pl*" or RemoteName matches "*pastetext.net*" or RemoteName matches "*pixeldrain.com*" or RemoteName matches "*privatlab.com*" or RemoteName matches "*privatlab.net*" or RemoteName matches "*send.exploit.in*" or RemoteName matches "*sendspace.com*" or RemoteName matches "*storage.googleapis.com*" or RemoteName matches "*storjshare.io*" or RemoteName matches "*supabase.co*" or RemoteName matches "*temp.sh*" or RemoteName matches "*transfer.sh*" or RemoteName matches "*trycloudflare.com*" or RemoteName matches "*ufile.io*" or RemoteName matches "*w3spaces.com*" or RemoteName matches "*workers.dev*" or RemoteName matches "*x0.at*"))
