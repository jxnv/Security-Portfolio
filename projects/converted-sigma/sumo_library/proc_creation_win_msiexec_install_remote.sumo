// Title: Suspicious Msiexec Quiet Install From Remote Location
// ID: 8150732a-0c9d-4a99-82b9-9efb9b90c40c
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-28
// Tags: attack.stealth, attack.t1218.007
// Description: Detects usage of Msiexec.exe to install packages hosted remotely quietly
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((CommandLine matches "*-i*" or CommandLine matches "*/i*" or CommandLine matches "*-package*" or CommandLine matches "*/package*" or CommandLine matches "*-a*" or CommandLine matches "*/a*" or CommandLine matches "*-j*" or CommandLine matches "*/j*")) and ((Image matches "*\\msiexec.exe") or (OriginalFileName = "msiexec.exe")) and ((CommandLine matches "*-q*" or CommandLine matches "*/q*")) and ((CommandLine matches "*http*" or CommandLine matches "*\\\\\\\\*"))) and !(((CommandLine matches "*\\AppData\\Local\\Temp\\OpenOffice*" and CommandLine matches "*Installation Files\\openoffice*"))))
