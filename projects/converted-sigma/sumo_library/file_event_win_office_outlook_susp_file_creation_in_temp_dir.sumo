// Title: Suspicious File Created in Outlook Temporary Directory
// ID: fabb0e80-030c-4e3e-a104-d09676991ac3
// Status: experimental
// Level: high
// Author: Florian Roth (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-07-22
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects the creation of files with suspicious file extensions in the temporary directory that Outlook uses when opening attachments.
// This can be used to detect spear-phishing campaigns that use suspicious files as attachments, which may contain malicious code.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((TargetFilename matches "*.cpl" or TargetFilename matches "*.hta" or TargetFilename matches "*.iso" or TargetFilename matches "*.rdp" or TargetFilename matches "*.svg" or TargetFilename matches "*.vba" or TargetFilename matches "*.vbe" or TargetFilename matches "*.vbs")) and (((TargetFilename matches "*\\AppData\\Local\\Packages\\Microsoft.Outlook_*" or TargetFilename matches "*\\AppData\\Local\\Microsoft\\Olk\\Attachments\\*")) or ((TargetFilename matches "*\\AppData\\Local\\Microsoft\\Windows\\*" and TargetFilename matches "*\\Content.Outlook\\*"))))
