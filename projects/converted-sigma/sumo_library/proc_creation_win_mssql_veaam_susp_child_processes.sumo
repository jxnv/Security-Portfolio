// Title: Suspicious Child Process Of Veeam Dabatase
// ID: d55b793d-f847-4eea-b59a-5ab09908ac90
// Status: test
// Level: critical
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-04
// Tags: attack.initial-access, attack.persistence, attack.privilege-escalation
// Description: Detects suspicious child processes of the Veeam service process. This could indicate potential RCE or SQL Injection.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((ParentImage matches "*\\sqlservr.exe" and ParentCommandLine matches "*VEEAMSQL*") and (((Image matches "*\\cmd.exe" or Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\wsl.exe" or Image matches "*\\wt.exe") and (CommandLine matches "*-ex *" or CommandLine matches "*bypass*" or CommandLine matches "*cscript*" or CommandLine matches "*DownloadString*" or CommandLine matches "*http://*" or CommandLine matches "*https://*" or CommandLine matches "*mshta*" or CommandLine matches "*regsvr32*" or CommandLine matches "*rundll32*" or CommandLine matches "*wscript*" or CommandLine matches "*copy *")) or ((Image matches "*\\net.exe" or Image matches "*\\net1.exe" or Image matches "*\\netstat.exe" or Image matches "*\\nltest.exe" or Image matches "*\\ping.exe" or Image matches "*\\tasklist.exe" or Image matches "*\\whoami.exe"))))
