// Title: Scheduled TaskCache Change by Uncommon Program
// ID: 4720b7df-40c3-48fd-bbdf-fd4b3c464f0d
// Status: test
// Level: high
// Author: Syed Hasan (@syedhasan009)
// Date: 2021-06-18
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053, attack.t1053.005
// Description: Monitor the creation of a new key under 'TaskCache' when a new scheduled task is registered by a process that is not svchost.exe, which is suspicious
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((TargetObject matches "*SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Schedule\\TaskCache\\*") and !(((Details = "(Empty)") or (Image = "C:\\Windows\\explorer.exe" and TargetObject matches "*\\Microsoft\\Windows NT\\CurrentVersion\\Schedule\\TaskCache\\Tree\\Microsoft\\Windows\\PLA\\Server Manager Performance Monitor\\*") or (Image matches "*C:\\Windows\\System32\\MoUsoCoreWorker.exe") or (Image = "C:\\Windows\\System32\\msiexec.exe") or (Image matches "C:\\Windows\\Microsoft.NET\\Framework*" and Image matches "*\\ngen.exe" and (TargetObject matches "*\\Microsoft\\Windows NT\\CurrentVersion\\Schedule\\TaskCache\\Tasks\\{B66B135D-DA06-4FC4-95F8-7458E1D10129}*" or TargetObject matches "*\\Microsoft\\Windows NT\\CurrentVersion\\Schedule\\TaskCache\\Tree\\Microsoft\\Windows\\.NET Framework\\.NET Framework NGEN*")) or (isNull(Details)) or ((Image = "C:\\Program Files\\Microsoft Office\\root\\Integration\\Integrator.exe" or Image = "C:\\Program Files (x86)\\Microsoft Office\\root\\Integration\\Integrator.exe" or Image = "C:\\Program Files\\Common Files\\microsoft shared\\ClickToRun\\OfficeC2RClient.exe" or Image = "C:\\Program Files (x86)\\Common Files\\microsoft shared\\ClickToRun\\OfficeC2RClient.exe")) or ((TargetObject matches "*Microsoft\\Windows\\UpdateOrchestrator*" or TargetObject matches "*Microsoft\\Windows\\SoftwareProtectionPlatform\\SvcRestartTask\\Index*" or TargetObject matches "*Microsoft\\Windows\\Flighting\\OneSettings\\RefreshCache\\Index*")) or (Image = "C:\\Windows\\System32\\RuntimeBroker.exe") or (Image matches "*C:\\Windows\\System32\\services.exe") or (Image = "C:\\WINDOWS\\system32\\svchost.exe") or (Image = "System") or (Image matches "C:\\Windows\\*" and Image matches "*\\TiWorker.exe"))) and !((((Image = "C:\\Program Files (x86)\\Dropbox\\Update\\DropboxUpdate.exe" or Image = "C:\\Program Files\\Dropbox\\Update\\DropboxUpdate.exe")) or ((Image matches "*C:\\Program Files (x86)\\Microsoft\\EdgeUpdate\\MicrosoftEdgeUpdate.exe" or Image matches "*C:\\Program Files\\Microsoft\\EdgeUpdate\\MicrosoftEdgeUpdate.exe")) or ((Image matches "*C:\\Program Files (x86)\\Microsoft OneDrive\\OneDrive.exe" or Image matches "*C:\\Program Files\\Microsoft OneDrive\\OneDrive.exe")))))
