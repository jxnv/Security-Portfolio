// Title: PUA - NirCmd Execution
// ID: 4e2ed651-1906-4a59-a78a-18220fca1b22
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-24
// Tags: attack.execution, attack.t1569.002, attack.s0029
// Description: Detects the use of NirCmd tool for command execution, which could be the result of legitimate administrative activity
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((CommandLine matches "* execmd *" or CommandLine matches "*.exe script *" or CommandLine matches "*.exe shexec *" or CommandLine matches "* runinteractive *")) or ((Image matches "*\\NirCmd.exe") or (OriginalFileName = "NirCmd.exe"))) or (((CommandLine matches "* exec *" or CommandLine matches "* exec2 *")) and ((CommandLine matches "* show *" or CommandLine matches "* hide *"))))
