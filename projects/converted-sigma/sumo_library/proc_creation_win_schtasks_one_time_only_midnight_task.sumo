// Title: Uncommon One Time Only Scheduled Task At 00:00
// ID: 970823b7-273b-460a-8afc-3a6811998529
// Status: test
// Level: high
// Author: pH-T (Nextron Systems)
// Date: 2022-07-15
// Tags: attack.execution, attack.persistence, attack.privilege-escalation, attack.t1053.005
// Description: Detects scheduled task creation events that include suspicious actions, and is run once at 00:00
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*wscript*" or CommandLine matches "*vbscript*" or CommandLine matches "*cscript*" or CommandLine matches "*wmic *" or CommandLine matches "*wmic.exe*" or CommandLine matches "*regsvr32.exe*" or CommandLine matches "*powershell*" or CommandLine matches "*\\AppData\\*")) and ((Image matches "*\\schtasks.exe*") or (OriginalFileName = "schtasks.exe")) and ((CommandLine matches "*once*" and CommandLine matches "*00:00*")))
