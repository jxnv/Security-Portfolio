// Title: Wlrmdr.EXE Uncommon Argument Or Child Process
// ID: 9cfc00b6-bfb7-49ce-9781-ef78503154bb
// Status: experimental
// Level: medium
// Author: frack113, manasmbellani
// Date: 2022-02-16
// Tags: attack.stealth, attack.t1218
// Description: Detects the execution of "Wlrmdr.exe" with the "-u" command line flag which allows anything passed to it to be an argument of the ShellExecute API, which would allow an attacker to execute arbitrary binaries.
// This detection also focuses on any uncommon child processes spawned from "Wlrmdr.exe" as a supplement for those that posses "ParentImage" telemetry.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((ParentImage matches "*\\wlrmdr.exe") or ((((CommandLine matches "*-a *" or CommandLine matches "*/a *")) and ((CommandLine matches "*-f *" or CommandLine matches "*/f *")) and ((CommandLine matches "*-m *" or CommandLine matches "*/m *")) and ((CommandLine matches "*-s *" or CommandLine matches "*/s *")) and ((CommandLine matches "*-t *" or CommandLine matches "*/t *")) and ((CommandLine matches "*-u *" or CommandLine matches "*/u *")) and ((Image matches "*\\wlrmdr.exe") or (OriginalFileName = "WLRMNDR.EXE"))) and !((((ParentImage = "" or ParentImage = "-")) or (isNull(ParentImage)) or (ParentImage = "C:\\Windows\\System32\\winlogon.exe")))))
