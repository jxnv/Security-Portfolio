// Title: Suspicious Schtasks Schedule Types
// ID: 24c8392b-aa3c-46b7-a545-43f71657fe98
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects scheduled task creations or modification on a suspicious schedule type
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((Image matches "*\\schtasks.exe") or (OriginalFileName = "schtasks.exe")) and ((CommandLine matches "* ONLOGON *" or CommandLine matches "* ONSTART *" or CommandLine matches "* ONCE *" or CommandLine matches "* ONIDLE *"))) and !(((CommandLine matches "*NT AUT*" or CommandLine matches "* SYSTEM*" or CommandLine matches "*HIGHEST*"))))
