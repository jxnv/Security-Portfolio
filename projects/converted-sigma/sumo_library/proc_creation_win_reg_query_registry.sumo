// Title: Potential Configuration And Service Reconnaissance Via Reg.EXE
// ID: 970007b7-ce32-49d0-a4a4-fbef016950bd
// Status: test
// Level: medium
// Author: Timur Zinniatullin, oscd.community
// Date: 2019-10-21
// Tags: attack.discovery, attack.t1012, attack.t1007
// Description: Detects the usage of "reg.exe" in order to query reconnaissance information from the registry. Adversaries may interact with the Windows registry to gather information about credentials, the system, configuration, and installed software.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((CommandLine matches "*query*") and ((Image matches "*\\reg.exe") or (OriginalFileName = "reg.exe")) and ((CommandLine matches "*currentVersion\\windows*" or CommandLine matches "*winlogon\\*" or CommandLine matches "*currentVersion\\shellServiceObjectDelayLoad*" or CommandLine matches "*currentVersion\\run*" or CommandLine matches "*currentVersion\\policies\\explorer\\run*" or CommandLine matches "*currentcontrolset\\services*")))
