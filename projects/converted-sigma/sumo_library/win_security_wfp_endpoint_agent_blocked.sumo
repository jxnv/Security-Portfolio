// Title: Windows Filtering Platform Blocked Connection From EDR Agent Binary
// ID: bacf58c6-e199-4040-a94f-95dea0f1e45a
// Status: test
// Level: high
// Author: @gott_cyber
// Date: 2024-01-08
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects a Windows Filtering Platform (WFP) blocked connection event involving common Endpoint Detection and Response (EDR) agents.
// Adversaries may use WFP filters to prevent Endpoint Detection and Response (EDR) agents from reporting security events.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (EventID = "5157" and (Application matches "*\\AmSvc.exe" or Application matches "*\\cb.exe" or Application matches "*\\CETASvc.exe" or Application matches "*\\CNTAoSMgr.exe" or Application matches "*\\CrAmTray.exe" or Application matches "*\\CrsSvc.exe" or Application matches "*\\CSFalconContainer.exe" or Application matches "*\\CSFalconService.exe" or Application matches "*\\CybereasonAV.exe" or Application matches "*\\CylanceSvc.exe" or Application matches "*\\cyserver.exe" or Application matches "*\\CyveraService.exe" or Application matches "*\\CyvrFsFlt.exe" or Application matches "*\\EIConnector.exe" or Application matches "*\\elastic-agent.exe" or Application matches "*\\elastic-endpoint.exe" or Application matches "*\\EndpointBasecamp.exe" or Application matches "*\\ExecutionPreventionSvc.exe" or Application matches "*\\filebeat.exe" or Application matches "*\\fortiedr.exe" or Application matches "*\\hmpalert.exe" or Application matches "*\\hurukai.exe" or Application matches "*\\LogProcessorService.exe" or Application matches "*\\mcsagent.exe" or Application matches "*\\mcsclient.exe" or Application matches "*\\MsMpEng.exe" or Application matches "*\\MsSense.exe" or Application matches "*\\Ntrtscan.exe" or Application matches "*\\PccNTMon.exe" or Application matches "*\\QualysAgent.exe" or Application matches "*\\RepMgr.exe" or Application matches "*\\RepUtils.exe" or Application matches "*\\RepUx.exe" or Application matches "*\\RepWAV.exe" or Application matches "*\\RepWSC.exe" or Application matches "*\\sedservice.exe" or Application matches "*\\SenseCncProxy.exe" or Application matches "*\\SenseIR.exe" or Application matches "*\\SenseNdr.exe" or Application matches "*\\SenseSampleUploader.exe" or Application matches "*\\SentinelAgent.exe" or Application matches "*\\SentinelAgentWorker.exe" or Application matches "*\\SentinelBrowserNativeHost.exe" or Application matches "*\\SentinelHelperService.exe" or Application matches "*\\Se