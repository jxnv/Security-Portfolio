// Title: Office Macro File Download
// ID: 0e29e3a7-1ad8-40aa-b691-9f82ecd33d66
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-23
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects the creation of a new office macro files on the system via an application (browser, mail client).
// This can help identify potential malicious activity, such as the download of macro-enabled documents that could be used for exploitation.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((TargetFilename matches "*.docm" or TargetFilename matches "*.dotm" or TargetFilename matches "*.xlsm" or TargetFilename matches "*.xltm" or TargetFilename matches "*.potm" or TargetFilename matches "*.pptm")) or ((TargetFilename matches "*.docm:Zone*" or TargetFilename matches "*.dotm:Zone*" or TargetFilename matches "*.xlsm:Zone*" or TargetFilename matches "*.xltm:Zone*" or TargetFilename matches "*.potm:Zone*" or TargetFilename matches "*.pptm:Zone*"))) and ((Image matches "*\\RuntimeBroker.exe" or Image matches "*\\outlook.exe" or Image matches "*\\thunderbird.exe" or Image matches "*\\brave.exe" or Image matches "*\\chrome.exe" or Image matches "*\\firefox.exe" or Image matches "*\\iexplore.exe" or Image matches "*\\maxthon.exe" or Image matches "*\\MicrosoftEdge.exe" or Image matches "*\\msedge.exe" or Image matches "*\\msedgewebview2.exe" or Image matches "*\\opera.exe" or Image matches "*\\safari.exe" or Image matches "*\\seamonkey.exe" or Image matches "*\\vivaldi.exe" or Image matches "*\\whale.exe")))
