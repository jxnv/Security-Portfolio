_sourceCategory=* | where (((TargetObject matches "*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion*") and ((TargetObject matches "*\\ShellServiceObjectDelayLoad*" or TargetObject matches "*\\Run\\*" or TargetObject matches "*\\RunOnce\\*" or TargetObject matches "*\\RunOnceEx\\*" or TargetObject matches "*\\RunServices\\*" or TargetObject matches "*\\RunServicesOnce\\*" or TargetObject matches "*\\Policies\\System\\Shell*" or TargetObject matches "*\\Policies\\Explorer\\Run*" or TargetObject matches "*\\Group Policy\\Scripts\\Startup*" or TargetObject matches "*\\Group Policy\\Scripts\\Shutdown*" or TargetObject matches "*\\Group Policy\\Scripts\\Logon*" or TargetObject matches "*\\Group Policy\\Scripts\\Logoff*" or TargetObject matches "*\\Explorer\\ShellServiceObjects*" or TargetObject matches "*\\Explorer\\ShellIconOverlayIdentifiers*" or TargetObject matches "*\\Explorer\\ShellExecuteHooks*" or TargetObject matches "*\\Explorer\\SharedTaskScheduler*" or TargetObject matches "*\\Explorer\\Browser Helper Objects*" or TargetObject matches "*\\Authentication\\PLAP Providers*" or TargetObject matches "*\\Authentication\\Credential Providers*" or TargetObject matches "*\\Authentication\\Credential Provider Filters*"))) and !(((Image = "C:\\Windows\\system32\\userinit.exe" and Details = "ctfmon.exe /n") or (Image = "C:\\Program Files\\Windows Defender\\MsMpEng.exe") or ((Image matches "C:\\Program Files (x86)\\Microsoft\\EdgeUpdate\\Install\\*" or Image matches "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\*" or Image matches "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe*")) or ((Details = "(Empty)") or (TargetObject matches "*\\NgcFirst\\ConsecutiveSwitchCount") or ((Image matches "*\\AppData\\Local\\Microsoft\\OneDrive\\Update\\OneDriveSetup.exe" or Image matches "*\\AppData\\Roaming\\Spotify\\Spotify.exe" or Image matches "*\\AppData\\Local\\WebEx\\WebexHost.exe")) or ((Image = "C:\\WINDOWS\\system32\\devicecensus.exe" or Image = "C:\\Windows\\system32\\winsat.exe" or Image = "C:\\Program Files\\Microsoft OneDrive\\StandaloneUpdater\\OneDriveSetup.exe" or Image = "C:\\Program Files (x86)\\Microsoft OneDrive\\StandaloneUpdater\\OneDriveSetup.exe" or Image = "C:\\Program Files\\Microsoft OneDrive\\Update\\OneDriveSetup.exe" or Image = "C:\\Program Files (x86)\\Microsoft OneDrive\\Update\\OneDriveSetup.exe" or Image = "C:\\Program Files\\Microsoft Office\\root\\integration\\Addons\\OneDriveSetup.exe" or Image = "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\Addons\\OneDriveSetup.exe" or Image = "C:\\Program Files\\KeePass Password Safe 2\\ShInstUtil.exe" or Image = "C:\\Program Files\\Everything\\Everything.exe" or Image = "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe" or Image = "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe"))) or (Image = "C:\\Windows\\system32\\LogonUI.exe" and (TargetObject matches "*\\Authentication\\Credential Providers\\{D6886603-9D2F-4EB2-B667-1971041FA96B}\\*" or TargetObject matches "*\\Authentication\\Credential Providers\\{BEC09223-B018-416D-A0AC-523971B639F5}\\*" or TargetObject matches "*\\Authentication\\Credential Providers\\{8AF662BF-65A0-4D0A-A540-A338A999D36F}\\*" or TargetObject matches "*\\Authentication\\Credential Providers\\{27FBDB57-B613-4AF2-9D7E-4FA7A66C21AD}\\*")) or (isNull(Details)) or (Image matches "*\\Microsoft\\Teams\\current\\Teams.exe" and Details matches "*\\Microsoft\\Teams\\Update.exe --processStart *"))) and !((((Image = "C:\\Program Files\\AVG\\Antivirus\\avgToolsSvc.exe" or Image = "C:\\Program Files (x86)\\AVG\\Antivirus\\avgToolsSvc.exe") and TargetObject matches "*\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\StartupApproved\\Run\\*" and Details = "Binary Data") or ((Image matches "*C:\\Program Files\\AVG\\Antivirus\\Setup\\*" or Image matches "*C:\\Program Files (x86)\\AVG\\Antivirus\\Setup\\*" or Image matches "*\\instup.exe*") and (Details = "\"C:\\Program Files\\AVG\\Antivirus\\AvLaunch.exe\" /gui" or Details = "\"C:\\Program Files (x86)\\AVG\\Antivirus\\AvLaunch.exe\" /gui" or Details = "{472083B0-C522-11CF-8763-00608CC02F24}" or Details = "{472083B1-C522-11CF-8763-00608CC02F24}")) or ((Image matches "*C:\\Program Files\\Avast Software\\Avast\\Setup\\*" or Image matches "*C:\\Program Files (x86)\\Avast Software\\Avast\\Setup\\*" or Image matches "*\\instup.exe*") and (Details = "\"C:\\Program Files\\Avast Software\\Avast\\AvLaunch.exe\" /gui" or Details = "\"C:\\Program Files (x86)\\Avast Software\\Avast\\AvLaunch.exe\" /gui")) or ((Image matches "*\\aurora-agent-64.exe" or Image matches "*\\aurora-agent.exe") and TargetObject matches "*\\Microsoft\\Windows\\CurrentVersion\\Run\\aurora-dashboard" and Details = "C:\\Program Files\\Aurora-Agent\\tools\\aurora-dashboard.exe") or (TargetObject matches "*\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\\Discord" and Details matches "*\\Discord\\Update.exe --processStart Discord.exe") or (Image = "C:\\Windows\\system32\\regsvr32.exe" and TargetObject matches "*DropboxExt*" and Details matches "*A251-47B7-93E1-CDD82E34AF8B}") or (TargetObject matches "*\\Microsoft\\Windows\\CurrentVersion\\Run\\Everything" and Details matches "*\\Everything\\Everything.exe\" -startup") or (TargetObject matches "*\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\\GoogleDriveFS" and Details matches "C:\\Program Files\\Google\\Drive File Stream\\*" and Details matches "*\\GoogleDriveFS.exe*") or (TargetObject matches "*GoogleDrive*" and (Details = "{CFE8B367-77A7-41D7-9C90-75D16D7DC6B6}" or Details = "{A8E52322-8734-481D-A7E2-27B309EF8D56}" or Details = "{C973DA94-CBDF-4E77-81D1-E5B794FBD146}" or Details = "{51EF1569-67EE-4AD6-9646-E726C3FFC8A2}")) or (TargetObject matches "*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\\Greenshot" and Details = "C:\\Program Files\\Greenshot\\Greenshot.exe") or (TargetObject matches "*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\\iTunesHelper" and Details = "\"C:\\Program Files\\iTunes\\iTunesHelper.exe\"") or ((Image matches "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\*" or Image matches "C:\\Program Files (x86)\\Common Files\\Microsoft Shared\\ClickToRun\\*") and Image matches "*\\OfficeClickToRun.exe") or ((Details matches "C:\\Windows\\system32\\cmd.exe /q /c rmdir /s /q \"C:\\Users\\*" or Details matches "C:\\Windows\\system32\\cmd.exe /q /c del /q \"C:\\Users\\*") and Details matches "*\\AppData\\Local\\Microsoft\\OneDrive\\*") or (TargetObject matches "*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\\Opera Browser Assistant" and Details = "C:\\Program Files\\Opera\\assistant\\browser_assistant.exe") or (TargetObject matches "*\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\\Opera Stable" and (Details = "C:\\Program Files\\Opera\\launcher.exe" or Details = "C:\\Program Files (x86)\\Opera\\launcher.exe")) or (TargetObject matches "*\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\{*" and (Details matches "*\\AppData\\Local\\Package Cache\\{*" and Details matches "*}\\python-*") and Details matches "*.exe\" /burn.runonce") or (Image matches "*\\Microsoft\\Teams\\current\\Teams.exe" and Details matches "*\\Microsoft\\Teams\\Update.exe --processStart*") or (TargetObject matches "*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\zoommsirepair" and Details = "\"C:\\Program Files\\Zoom\\bin\\installer.exe\" /repair"))))
