// Title: Potential Discovery Activity Using Find - Linux
// ID: 8344c0e5-5783-47cc-9cf9-a0f7fd03e6cf
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-28
// Tags: attack.discovery, attack.t1083
// Description: Detects usage of "find" binary in a suspicious manner to perform discovery
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (Image matches "*/find" and (CommandLine matches "*-perm -4000*" or CommandLine matches "*-perm -2000*" or CommandLine matches "*-perm 0777*" or CommandLine matches "*-perm -222*" or CommandLine matches "*-perm -o w*" or CommandLine matches "*-perm -o x*" or CommandLine matches "*-perm -u=s*" or CommandLine matches "*-perm -g=s*"))
