// Title: Suspicious Modification Of Scheduled Tasks
// ID: 1c0e41cd-21bb-4433-9acc-4a2cd6367b9b
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-28
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects when an attacker tries to modify an already existing scheduled tasks to run from a suspicious location
// Attackers can create a simple looking task in order to avoid detection on creation as it's often the most focused on
// Instead they modify the task after creation to include their malicious payload
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\schtasks.exe" and (CommandLine matches "* /Change *" and CommandLine matches "* /TN *")) and ((CommandLine matches "*regsvr32*" or CommandLine matches "*rundll32*" or CommandLine matches "*cmd /c *" or CommandLine matches "*cmd /k *" or CommandLine matches "*cmd /r *" or CommandLine matches "*cmd.exe /c *" or CommandLine matches "*cmd.exe /k *" or CommandLine matches "*cmd.exe /r *" or CommandLine matches "*powershell*" or CommandLine matches "*mshta*" or CommandLine matches "*wscript*" or CommandLine matches "*cscript*" or CommandLine matches "*certutil*" or CommandLine matches "*bitsadmin*" or CommandLine matches "*bash.exe*" or CommandLine matches "*bash *" or CommandLine matches "*scrcons*" or CommandLine matches "*wmic *" or CommandLine matches "*wmic.exe*" or CommandLine matches "*forfiles*" or CommandLine matches "*scriptrunner*" or CommandLine matches "*hh.exe*" or CommandLine matches "*hh *")) and ((CommandLine matches "*\\AppData\\Local\\Temp*" or CommandLine matches "*\\AppData\\Roaming\\*" or CommandLine matches "*\\Users\\Public\\*" or CommandLine matches "*\\WINDOWS\\Temp\\*" or CommandLine matches "*\\Desktop\\*" or CommandLine matches "*\\Downloads\\*" or CommandLine matches "*\\Temporary Internet*" or CommandLine matches "*C:\\ProgramData\\*" or CommandLine matches "*C:\\Perflogs\\*" or CommandLine matches "*%ProgramData%*" or CommandLine matches "*%appdata%*" or CommandLine matches "*%comspec%*" or CommandLine matches "*%localappdata%*")))
