// Title: Potentially Suspicious Rundll32 Activity
// ID: e593cf51-88db-4ee1-b920-37e89012a3c9
// Status: test
// Level: medium
// Author: juju4, Jonhnathan Ribeiro, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-01-16
// Tags: attack.stealth, attack.t1218.011
// Description: Detects suspicious execution of rundll32, with specific calls to some DLLs with known LOLBIN functionalities
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((CommandLine matches "*javascript:*" and CommandLine matches "*.RegisterXLL*")) or ((CommandLine matches "*url.dll*" and CommandLine matches "*OpenURL*")) or ((CommandLine matches "*url.dll*" and CommandLine matches "*OpenURLA*")) or ((CommandLine matches "*url.dll*" and CommandLine matches "*FileProtocolHandler*")) or ((CommandLine matches "*zipfldr.dll*" and CommandLine matches "*RouteTheCall*")) or ((CommandLine matches "*shell32.dll*" and CommandLine matches "*Control_RunDLL*")) or ((CommandLine matches "*shell32.dll*" and CommandLine matches "*ShellExec_RunDLL*")) or ((CommandLine matches "*mshtml.dll*" and CommandLine matches "*PrintHTML*")) or ((CommandLine matches "*advpack.dll*" and CommandLine matches "*LaunchINFSection*")) or ((CommandLine matches "*advpack.dll*" and CommandLine matches "*RegisterOCX*")) or ((CommandLine matches "*ieadvpack.dll*" and CommandLine matches "*LaunchINFSection*")) or ((CommandLine matches "*ieadvpack.dll*" and CommandLine matches "*RegisterOCX*")) or ((CommandLine matches "*ieframe.dll*" and CommandLine matches "*OpenURL*")) or ((CommandLine matches "*shdocvw.dll*" and CommandLine matches "*OpenURL*")) or ((CommandLine matches "*syssetup.dll*" and CommandLine matches "*SetupInfObjectInstallAction*")) or ((CommandLine matches "*setupapi.dll*" and CommandLine matches "*InstallHinfSection*")) or ((CommandLine matches "*pcwutl.dll*" and CommandLine matches "*LaunchApplication*")) or ((CommandLine matches "*dfshim.dll*" and CommandLine matches "*ShOpenVerbApplication*")) or ((CommandLine matches "*dfshim.dll*" and CommandLine matches "*ShOpenVerbShortcut*")) or ((CommandLine matches "*scrobj.dll*" and CommandLine matches "*GenerateTypeLib*" and CommandLine matches "*http*")) or ((CommandLine matches "*shimgvw.dll*" and CommandLine matches "*ImageView_Fullscreen*" and CommandLine matches "*http*")) or ((CommandLine matches "*comsvcs.dll*" and CommandLine matches "*MiniDump*"))) and !(((ParentImage = "C:\\Windows\\System32\\control.exe" and ParentCommandLine matches "*.cpl*" and (CommandLine matches "*Shell32.dll*" and CommandLine matches "*Control_RunDLL*" and CommandLine matches "*.cpl*")) or (CommandLine matches "*shell32.dll,Control_RunDLL desk.cpl,screensaver,@screensaver*") or (ParentImage = "C:\\Windows\\System32\\control.exe" and CommandLine matches "\"C:\\Windows\\system32\\rundll32.exe\" Shell32.dll,Control_RunDLL \"C:\\Windows\\System32\\*" and CommandLine matches "*.cpl\","))))
