// Title: Invoke-Obfuscation Via Stdin - System
// ID: 487c7524-f892-4054-b263-8a0ace63fc25
// Status: test
// Level: high
// Author: Nikita Nazarov, oscd.community
// Date: 2020-10-12
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via Stdin in Scripts
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (Provider_Name = "Service Control Manager" and EventID = "7045" and (ImagePath matches "*set*" and ImagePath matches "*&&*") and (ImagePath matches "*environment*" or ImagePath matches "*invoke*" or ImagePath matches "*input*"))
