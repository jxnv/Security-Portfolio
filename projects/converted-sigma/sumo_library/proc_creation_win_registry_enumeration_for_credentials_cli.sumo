// Title: Enumeration for 3rd Party Creds From CLI
// ID: 87a476dc-0079-4583-a985-dee7a20a03de
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-20
// Tags: attack.credential-access, attack.t1552.002
// Description: Detects processes that query known 3rd party registry keys that holds credentials via commandline
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*\\Software\\Aerofox\\Foxmail\\V3.1*" or CommandLine matches "*\\Software\\Aerofox\\FoxmailPreview*" or CommandLine matches "*\\Software\\DownloadManager\\Passwords*" or CommandLine matches "*\\Software\\FTPWare\\COREFTP\\Sites*" or CommandLine matches "*\\Software\\IncrediMail\\Identities*" or CommandLine matches "*\\Software\\Martin Prikryl\\WinSCP 2\\Sessions*" or CommandLine matches "*\\Software\\Mobatek\\MobaXterm\\*" or CommandLine matches "*\\Software\\OpenSSH\\Agent\\Keys*" or CommandLine matches "*\\Software\\OpenVPN-GUI\\configs*" or CommandLine matches "*\\Software\\ORL\\WinVNC3\\Password*" or CommandLine matches "*\\Software\\Qualcomm\\Eudora\\CommandLine*" or CommandLine matches "*\\Software\\RealVNC\\WinVNC4*" or CommandLine matches "*\\Software\\RimArts\\B2\\Settings*" or CommandLine matches "*\\Software\\SimonTatham\\PuTTY\\Sessions*" or CommandLine matches "*\\Software\\SimonTatham\\PuTTY\\SshHostKeys\\*" or CommandLine matches "*\\Software\\Sota\\FFFTP*" or CommandLine matches "*\\Software\\TightVNC\\Server*" or CommandLine matches "*\\Software\\WOW6432Node\\Radmin\\v3.0\\Server\\Parameters\\Radmin*")) and !((Image matches "*reg.exe" and (CommandLine matches "*export*" or CommandLine matches "*save*"))))
