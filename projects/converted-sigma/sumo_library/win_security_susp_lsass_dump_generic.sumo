// Title: Potentially Suspicious AccessMask Requested From LSASS
// ID: 4a1b6da0-d94f-4fc3-98fc-2d9cb9e5ee76
// Status: test
// Level: medium
// Author: Roberto Rodriguez, Teymur Kheirkhabarov, Dimitrios Slamaris, Mark Russinovich, Aleksey Potapov, oscd.community (update)
// Date: 2019-11-01
// Tags: attack.credential-access, car.2019-04-004, attack.t1003.001
// Description: Detects process handle on LSASS process with certain access mask
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((EventID = "4656" and ObjectName matches "*\\lsass.exe" and (AccessMask matches "*0x40*" or AccessMask matches "*0x1400*" or AccessMask matches "*0x100000*" or AccessMask matches "*0x1410*" or AccessMask matches "*0x1010*" or AccessMask matches "*0x1438*" or AccessMask matches "*0x143a*" or AccessMask matches "*0x1418*" or AccessMask matches "*0x1f0fff*" or AccessMask matches "*0x1f1fff*" or AccessMask matches "*0x1f2fff*" or AccessMask matches "*0x1f3fff*")) or (EventID = "4663" and ObjectName matches "*\\lsass.exe" and (AccessList matches "*4484*" or AccessList matches "*4416*"))) and !(((ProcessName matches "*:\\Windows\\Temp\\asgard2-agent-sc\\aurora\\*" and ProcessName matches "*\\aurora-agent-64.exe" and AccessList matches "*%%4484*") or ((ProcessName matches "*:\\Users\\*" and ProcessName matches "*\\AppData\\Local\\Temp\\is-*") and ProcessName matches "*\\avira_system_speedup.tmp" and AccessList matches "*%%4484*") or (ProcessName matches "*:\\Windows\\Temp\\*" and ProcessName matches "*\\avira_speedup_setup_update.tmp" and AccessList matches "*%%4484*") or ((ProcessName matches "*:\\Windows\\System32\\taskhostw.exe" or ProcessName matches "*:\\Windows\\System32\\msiexec.exe" or ProcessName matches "*:\\Windows\\CCM\\CcmExec.exe")) or (ProcessName matches "*:\\Program Files*") or (ProcessName matches "*:\\Windows\\SystemTemp\\*" and ProcessName matches "*\\GoogleUpdate.exe" and AccessList matches "*%%4484*") or (ProcessName matches "*\\x64\\SCENARIOENGINE.EXE" and AccessList matches "*%%4484*") or (ProcessName matches "*:\\Windows\\System32\\snmp.exe" and AccessList matches "*%%4484*") or ((ProcessName matches "*\\csrss.exe" or ProcessName matches "*\\GamingServices.exe" or ProcessName matches "*\\lsm.exe" or ProcessName matches "*\\MicrosoftEdgeUpdate.exe" or ProcessName matches "*\\minionhost.exe" or ProcessName matches "*\\MRT.exe" or ProcessName matches "*\\MsMpEng.exe" or ProcessName matches "*\\perfmon.exe" or ProcessName matches "*\\procexp.exe" or ProcessName matches "*\\procexp64.exe" or ProcessName matches "*\\procexp64a.exe" or ProcessName matches "*\\svchost.exe" or ProcessName matches "*\\taskmgr.exe" or ProcessName matches "*\\thor.exe" or ProcessName matches "*\\thor64.exe" or ProcessName matches "*\\vmtoolsd.exe" or ProcessName matches "*\\VsTskMgr.exe" or ProcessName matches "*\\wininit.exe" or ProcessName matches "*\\wmiprvse.exe" or ProcessName matches "*RtkAudUService64") and (ProcessName matches "*:\\Program Files (x86)\\*" or ProcessName matches "*:\\Program Files\\*" or ProcessName matches "*:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*" or ProcessName matches "*:\\Windows\\SysNative\\*" or ProcessName matches "*:\\Windows\\System32\\*" or ProcessName matches "*:\\Windows\\SysWow64\\*" or ProcessName matches "*:\\Windows\\Temp\\asgard2-agent\\*")) or ((ProcessName matches "*:\\Windows\\Sysmon64.exe" or ProcessName matches "*:\\Windows\\Sysmon64a.exe") and AccessList matches "*%%4484*"))) and !(((ProcessName matches "*\\procmon64.exe" or ProcessName matches "*\\procmon64a.exe" or ProcessName matches "*\\procmon.exe") and AccessList matches "*%%4484*")))
