// Title: Potential Browser Data Stealing
// ID: 47147b5b-9e17-4d76-b8d2-7bac24c5ce1b
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-23
// Tags: attack.credential-access, attack.t1555.003
// Description: Adversaries may acquire credentials from web browsers by reading files specific to the target browser.
// Web browsers commonly save credentials such as website usernames and passwords so that they do not need to be entered manually in the future.
// Web browsers typically store the credentials in an encrypted format within a credential store.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((CommandLine matches "*copy-item*" or CommandLine matches "*copy *" or CommandLine matches "*cpi *" or CommandLine matches "* cp *" or CommandLine matches "*move *" or CommandLine matches "*move-item*" or CommandLine matches "* mi *" or CommandLine matches "* mv *")) or ((Image matches "*\\esentutl.exe" or Image matches "*\\xcopy.exe" or Image matches "*\\robocopy.exe")) or ((OriginalFileName = "esentutl.exe" or OriginalFileName = "XCOPY.EXE" or OriginalFileName = "robocopy.exe"))) and ((CommandLine matches "*\\Amigo\\User Data*" or CommandLine matches "*\\BraveSoftware\\Brave-Browser\\User Data*" or CommandLine matches "*\\CentBrowser\\User Data*" or CommandLine matches "*\\Chromium\\User Data*" or CommandLine matches "*\\CocCoc\\Browser\\User Data*" or CommandLine matches "*\\Comodo\\Dragon\\User Data*" or CommandLine matches "*\\Elements Browser\\User Data*" or CommandLine matches "*\\Epic Privacy Browser\\User Data*" or CommandLine matches "*\\Google\\Chrome Beta\\User Data*" or CommandLine matches "*\\Google\\Chrome SxS\\User Data*" or CommandLine matches "*\\Google\\Chrome\\User Data\\*" or CommandLine matches "*\\Kometa\\User Data*" or CommandLine matches "*\\Maxthon5\\Users*" or CommandLine matches "*\\Microsoft\\Edge\\User Data*" or CommandLine matches "*\\Mozilla\\Firefox\\Profiles*" or CommandLine matches "*\\Nichrome\\User Data*" or CommandLine matches "*\\Opera Software\\Opera GX Stable\\*" or CommandLine matches "*\\Opera Software\\Opera Neon\\User Data*" or CommandLine matches "*\\Opera Software\\Opera Stable\\*" or CommandLine matches "*\\Orbitum\\User Data*" or CommandLine matches "*\\QIP Surf\\User Data*" or CommandLine matches "*\\Sputnik\\User Data*" or CommandLine matches "*\\Torch\\User Data*" or CommandLine matches "*\\uCozMedia\\Uran\\User Data*" or CommandLine matches "*\\Vivaldi\\User Data*")))
