// Title: DriverQuery.EXE Execution
// ID: a20def93-0709-4eae-9bd2-31206e21e6b2
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-19
// Tags: attack.discovery
// Description: Detect usage of the "driverquery" utility. Which can be used to perform reconnaissance on installed drivers
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*driverquery.exe") or (OriginalFileName = "drvqry.exe")) and !((((ParentImage matches "*\\cscript.exe" or ParentImage matches "*\\mshta.exe" or ParentImage matches "*\\regsvr32.exe" or ParentImage matches "*\\rundll32.exe" or ParentImage matches "*\\wscript.exe")) or ((ParentImage matches "*\\AppData\\Local\\*" or ParentImage matches "*\\Users\\Public\\*" or ParentImage matches "*\\Windows\\Temp\\*")))))
