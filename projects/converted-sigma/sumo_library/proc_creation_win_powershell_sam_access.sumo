// Title: PowerShell SAM Copy
// ID: 1af57a4b-460a-4738-9034-db68b880c665
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-07-29
// Tags: attack.credential-access, attack.t1003.002
// Description: Detects suspicious PowerShell scripts accessing SAM hives
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*\\HarddiskVolumeShadowCopy*" and CommandLine matches "*System32\\config\\sam*")) and ((CommandLine matches "*Copy-Item*" or CommandLine matches "*cp $_.*" or CommandLine matches "*cpi $_.*" or CommandLine matches "*copy $_.*" or CommandLine matches "*.File]::Copy(*")))
