// Title: Potential Suspicious Winget Package Installation
// ID: a3f5c081-e75b-43a0-9f5b-51f26fe5dba2
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.persistence, attack.stealth
// Description: Detects potential suspicious winget package installation from a suspicious source.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (Contents matches "[ZoneTransfer]  ZoneId=3*" and (Contents matches "*://1*" or Contents matches "*://2*" or Contents matches "*://3*" or Contents matches "*://4*" or Contents matches "*://5*" or Contents matches "*://6*" or Contents matches "*://7*" or Contents matches "*://8*" or Contents matches "*://9*") and TargetFilename matches "*:Zone.Identifier" and TargetFilename matches "*\\AppData\\Local\\Temp\\WinGet\\*")
