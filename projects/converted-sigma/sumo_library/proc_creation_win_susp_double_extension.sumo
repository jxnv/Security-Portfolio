// Title: Suspicious Double Extension File Execution
// ID: 1cdd9a09-06c9-4769-99ff-626e2b3991b8
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems), @blu3_team (idea), Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-06-26
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects suspicious use of an .exe extension after a non-executable file extension like .pdf.exe, a set of spaces or underlines to cloak the executable file in spear phishing campaigns
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*      .exe" or Image matches "*______.exe" or Image matches "*.doc.exe" or Image matches "*.doc.js" or Image matches "*.docx.exe" or Image matches "*.docx.js" or Image matches "*.gif.exe" or Image matches "*.jpeg.exe" or Image matches "*.jpg.exe" or Image matches "*.mkv.exe" or Image matches "*.mov.exe" or Image matches "*.mp3.exe" or Image matches "*.mp4.exe" or Image matches "*.pdf.exe" or Image matches "*.pdf.js" or Image matches "*.png.exe" or Image matches "*.ppt.exe" or Image matches "*.ppt.js" or Image matches "*.pptx.exe" or Image matches "*.pptx.js" or Image matches "*.rtf.exe" or Image matches "*.rtf.js" or Image matches "*.svg.exe" or Image matches "*.txt.exe" or Image matches "*.txt.js" or Image matches "*.xls.exe" or Image matches "*.xls.js" or Image matches "*.xlsx.exe" or Image matches "*.xlsx.js" or Image matches "*⠀⠀⠀⠀⠀⠀.exe") and (CommandLine matches "*      .exe*" or CommandLine matches "*______.exe*" or CommandLine matches "*.doc.exe*" or CommandLine matches "*.doc.js*" or CommandLine matches "*.docx.exe*" or CommandLine matches "*.docx.js*" or CommandLine matches "*.gif.exe*" or CommandLine matches "*.jpeg.exe*" or CommandLine matches "*.jpg.exe*" or CommandLine matches "*.mkv.exe*" or CommandLine matches "*.mov.exe*" or CommandLine matches "*.mp3.exe*" or CommandLine matches "*.mp4.exe*" or CommandLine matches "*.pdf.exe*" or CommandLine matches "*.pdf.js*" or CommandLine matches "*.png.exe*" or CommandLine matches "*.ppt.exe*" or CommandLine matches "*.ppt.js*" or CommandLine matches "*.pptx.exe*" or CommandLine matches "*.pptx.js*" or CommandLine matches "*.rtf.exe*" or CommandLine matches "*.rtf.js*" or CommandLine matches "*.svg.exe*" or CommandLine matches "*.txt.exe*" or CommandLine matches "*.txt.js*" or CommandLine matches "*.xls.exe*" or CommandLine matches "*.xls.js*" or CommandLine matches "*.xlsx.exe*" or CommandLine matches "*.xlsx.js*" or CommandLine matches "*⠀⠀⠀⠀⠀⠀.exe*"))
