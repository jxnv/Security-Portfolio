// Title: Control Panel Items
// ID: 0ba863e6-def5-4e50-9cea-4dd8c7dc46a4
// Status: test
// Level: high
// Author: Kyaw Min Thein, Furkan Caliskan (@caliskanfurkan_)
// Date: 2020-06-22
// Tags: attack.privilege-escalation, attack.execution, attack.stealth, attack.t1218.002, attack.persistence, attack.t1546
// Description: Detects the malicious use of a control panel item
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((CommandLine matches "*add*" and CommandLine matches "*CurrentVersion\\Control Panel\\CPLs*")) and ((Image matches "*\\reg.exe") or (OriginalFileName = "reg.exe"))) or ((CommandLine matches "*.cpl") and !((((CommandLine matches "*regsvr32 *" and CommandLine matches "* /s *" and CommandLine matches "*igfxCPL.cpl*")) or ((CommandLine matches "*\\System32\\*" or CommandLine matches "*%System%*" or CommandLine matches "*|C:\\Windows\\system32|*"))))))
