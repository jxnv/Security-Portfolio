// Title: Suspicious Program Names
// ID: efdd8dd5-cee8-4e59-9390-7d4d5e4dd6f6
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-11
// Tags: attack.execution, attack.t1059
// Description: Detects suspicious patterns in program names or folders that are often found in malicious samples or hacktools
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*inject.ps1*" or CommandLine matches "*Invoke-CVE*" or CommandLine matches "*pupy.ps1*" or CommandLine matches "*payload.ps1*" or CommandLine matches "*beacon.ps1*" or CommandLine matches "*PowerView.ps1*" or CommandLine matches "*bypass.ps1*" or CommandLine matches "*obfuscated.ps1*" or CommandLine matches "*obfusc.ps1*" or CommandLine matches "*obfus.ps1*" or CommandLine matches "*obfs.ps1*" or CommandLine matches "*evil.ps1*" or CommandLine matches "*MiniDogz.ps1*" or CommandLine matches "*_enc.ps1*" or CommandLine matches "*\\shell.ps1*" or CommandLine matches "*\\rshell.ps1*" or CommandLine matches "*revshell.ps1*" or CommandLine matches "*\\av.ps1*" or CommandLine matches "*\\av_test.ps1*" or CommandLine matches "*adrecon.ps1*" or CommandLine matches "*mimikatz.ps1*" or CommandLine matches "*\\PowerUp_*" or CommandLine matches "*powerup.ps1*" or CommandLine matches "*\\Temp\\a.ps1*" or CommandLine matches "*\\Temp\\p.ps1*" or CommandLine matches "*\\Temp\\1.ps1*" or CommandLine matches "*Hound.ps1*" or CommandLine matches "*encode.ps1*" or CommandLine matches "*powercat.ps1*")) or (((Image matches "*\\CVE-202*" or Image matches "*\\CVE202*")) or ((Image matches "*\\poc.exe" or Image matches "*\\artifact.exe" or Image matches "*\\artifact64.exe" or Image matches "*\\artifact_protected.exe" or Image matches "*\\artifact32.exe" or Image matches "*\\artifact32big.exe" or Image matches "*obfuscated.exe" or Image matches "*obfusc.exe" or Image matches "*\\meterpreter"))))
