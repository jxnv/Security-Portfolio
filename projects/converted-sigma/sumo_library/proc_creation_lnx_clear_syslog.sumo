// Title: Syslog Clearing or Removal Via System Utilities
// ID: 3fcc9b35-39e4-44c0-a2ad-9e82b6902b31
// Status: test
// Level: high
// Author: Max Altgelt (Nextron Systems), Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research), MSTIC
// Date: 2021-10-15
// Tags: attack.defense-impairment, attack.t1685.006
// Description: Detects specific commands commonly used to remove or empty the syslog. Which is a technique often used by attacker as a method to hide their tracks
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*/var/log/syslog*") and ((Image matches "*/cp" and CommandLine matches "*/dev/null*") or (Image matches "*/ln" and (CommandLine matches "*/dev/null *" and CommandLine matches "*/var/log/syslog*") and (CommandLine matches "*-sf *" or CommandLine matches "*-sfn *" or CommandLine matches "*-sfT *")) or (Image matches "*/mv") or (Image matches "*/rm" and (CommandLine matches "* -r *" or CommandLine matches "* -f *" or CommandLine matches "* -rf *" or CommandLine matches "*/var/log/syslog*")) or (Image matches "*/shred" and CommandLine matches "*-u *") or (Image matches "*/truncate" and (CommandLine matches "*0 *" and CommandLine matches "*/var/log/syslog*") and (CommandLine matches "*-s *" or CommandLine matches "*-c *" or CommandLine matches "*--size*")) or (Image matches "*/unlink"))) or (((CommandLine matches "*journalctl --vacuum*" or CommandLine matches "*journalctl --rotate*")) or ((CommandLine matches "* > /var/log/syslog*" or CommandLine matches "* >/var/log/syslog*" or CommandLine matches "* >| /var/log/syslog*" or CommandLine matches "*: > /var/log/syslog*" or CommandLine matches "*:> /var/log/syslog*" or CommandLine matches "*:>/var/log/syslog*" or CommandLine matches "*>|/var/log/syslog*"))))
