// Title: Obfuscated IP Via CLI
// ID: 56d19cb4-6414-4769-9644-1ed35ffbb148
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2022-08-03
// Tags: attack.discovery
// Description: Detects usage of an encoded/obfuscated version of an IP address (hex, octal, etc.) via command line
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*\\ping.exe" or Image matches "*\\arp.exe")) and (((CommandLine matches "* 0x*" or CommandLine matches "*//0x*" or CommandLine matches "*.0x*" or CommandLine matches "*.00x*")) or ((CommandLine matches "*http://%*" and CommandLine matches "*%2e*")) or ((CommandLine matches /https?://[0-9]{1,3}\.[0-9]{1,3}\.0[0-9]{3,4}/) or (CommandLine matches /https?://[0-9]{1,3}\.0[0-9]{3,7}/) or (CommandLine matches /https?://0[0-9]{3,11}/) or (CommandLine matches /https?://(?:0[0-9]{1,11}\.){3}0[0-9]{1,11}/) or (CommandLine matches /https?://0[0-9]{1,11}/) or (CommandLine matches / [0-7]{7,13}/))) and !((CommandLine matches /https?://(?:(?:25[0-5]|(?:2[0-4]|1\d|[1-9])?\d)(?:\.|\b)){4}/)))
