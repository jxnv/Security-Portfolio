// Title: Potential Persistence Via Visual Studio Tools for Office
// ID: 9d15044a-7cfe-4d23-8085-6ebc11df7685
// Status: test
// Level: medium
// Author: Bhabesh Raj
// Date: 2021-01-10
// Tags: attack.t1137.006, attack.persistence
// Description: Detects persistence via Visual Studio Tools for Office (VSTO) add-ins in Office applications.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((TargetObject matches "*\\Software\\Microsoft\\Office\\Outlook\\Addins\\*" or TargetObject matches "*\\Software\\Microsoft\\Office\\Word\\Addins\\*" or TargetObject matches "*\\Software\\Microsoft\\Office\\Excel\\Addins\\*" or TargetObject matches "*\\Software\\Microsoft\\Office\\Powerpoint\\Addins\\*" or TargetObject matches "*\\Software\\Microsoft\\VSTO\\Security\\Inclusion\\*")) and !((((Image = "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe" or Image = "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe")) or ((Image matches "C:\\Program Files\\Microsoft Office\\OFFICE*" or Image matches "C:\\Program Files (x86)\\Microsoft Office\\OFFICE*" or Image matches "C:\\Program Files\\Microsoft Office\\Root\\OFFICE*" or Image matches "C:\\Program Files (x86)\\Microsoft Office\\Root\\OFFICE*" or Image matches "C:\\PROGRA~2\\MICROS~2\\Office*") and (Image matches "*\\excel.exe" or Image matches "*\\Integrator.exe" or Image matches "*\\OneNote.exe" or Image matches "*\\outlook.exe" or Image matches "*\\powerpnt.exe" or Image matches "*\\Teams.exe" or Image matches "*\\visio.exe" or Image matches "*\\winword.exe")) or ((Image matches "C:\\Program Files\\Common Files (x86)\\Microsoft Shared\\ClickToRun\\*" or Image matches "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\*") and Image matches "*\\OfficeClickToRun.exe") or ((Image = "C:\\Windows\\System32\\msiexec.exe" or Image = "C:\\Windows\\SysWOW64\\msiexec.exe" or Image = "C:\\Windows\\System32\\regsvr32.exe" or Image = "C:\\Windows\\SysWOW64\\regsvr32.exe")) or ((Image matches "C:\\Program Files\\Common Files\\Microsoft Shared\\VSTO\\*" or Image matches "C:\\Program Files (x86)\\Microsoft Shared\\VSTO\\*") and Image matches "*\\VSTOInstaller.exe"))) and !((((Image = "C:\\Program Files\\Avast Software\\Avast\\RegSvr.exe" or Image = "C:\\Program Files (x86)\\Avast Software\\Avast\\RegSvr.exe") and TargetObject matches "*\\Microsoft\\Office\\Outlook\\Addins\\Avast.AsOutExt\\*") or ((Image = "C:\\Program Files\\AVG\\Antivirus\\RegSvr.exe" or Image = "C:\\Program Files (x86)\\AVG\\Antivirus\\RegSvr.exe") and TargetObject matches "*\\Microsoft\\Office\\Outlook\\Addins\\Antivirus.AsOutExt\\*"))))
