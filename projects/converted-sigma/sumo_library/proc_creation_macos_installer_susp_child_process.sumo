// Title: Suspicious Installer Package Child Process
// ID: e0cfaecd-602d-41af-988d-f6ccebb2af26
// Status: test
// Level: medium
// Author: Sohan G (D4rkCiph3r)
// Date: 2023-02-18
// Tags: attack.t1059, attack.t1059.007, attack.t1071, attack.t1071.001, attack.execution, attack.command-and-control
// Description: Detects the execution of suspicious child processes from macOS installer package parent process. This includes osascript, JXA, curl and wget amongst other interpreters
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((ParentImage matches "*/package_script_service" or ParentImage matches "*/installer") and (Image matches "*/sh" or Image matches "*/bash" or Image matches "*/dash" or Image matches "*/python" or Image matches "*/ruby" or Image matches "*/perl" or Image matches "*/php" or Image matches "*/javascript" or Image matches "*/osascript" or Image matches "*/tclsh" or Image matches "*/curl" or Image matches "*/wget") and (CommandLine matches "*preinstall*" or CommandLine matches "*postinstall*"))
