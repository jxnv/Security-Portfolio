// Title: Suspicious File Created by ArcSOC.exe
// ID: e890acee-d488-420e-8f20-d9b19b3c3d43
// Status: experimental
// Level: high
// Author: Micah Babinski
// Date: 2025-11-25
// Tags: attack.command-and-control, attack.persistence, attack.initial-access, attack.execution, attack.stealth, attack.t1127, attack.t1105, attack.t1133
// Description: Detects instances where the ArcGIS Server process ArcSOC.exe, which hosts REST services running on an ArcGIS
// server, creates a file with suspicious file type, indicating that it may be an executable, script file,
// or otherwise unusual.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (Image matches "*\\ArcSOC.exe" and (TargetFilename matches "*.ahk" or TargetFilename matches "*.aspx" or TargetFilename matches "*.au3" or TargetFilename matches "*.bat" or TargetFilename matches "*.cmd" or TargetFilename matches "*.dll" or TargetFilename matches "*.exe" or TargetFilename matches "*.hta" or TargetFilename matches "*.js" or TargetFilename matches "*.ps1" or TargetFilename matches "*.py" or TargetFilename matches "*.vbe" or TargetFilename matches "*.vbs" or TargetFilename matches "*.wsf"))
