// Title: Potential Antivirus Software DLL Sideloading
// ID: 552b6b65-df37-4d3e-a258-f2fc4771ae54
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Wietze Beukema (project and research)
// Date: 2022-08-17
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of DLLs that are part of antivirus software suchas McAfee, Symantec...etc
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((ImageLoaded matches "*\\log.dll") and !((((ImageLoaded = "C:\\Program Files\\AVAST Software\\Avast\\log.dll" or ImageLoaded = "C:\\Program Files (x86)\\AVAST Software\\Avast\\log.dll")) or ((ImageLoaded = "C:\\Program Files\\AVG\\Antivirus\\log.dll" or ImageLoaded = "C:\\Program Files (x86)\\AVG\\Antivirus\\log.dll")) or ((ImageLoaded matches "C:\\Program Files\\Bitdefender Antivirus Free\\*" or ImageLoaded matches "C:\\Program Files (x86)\\Bitdefender Antivirus Free\\*")) or (ImageLoaded matches "C:\\Program Files\\Canon\\MyPrinter\\*") or (Image = "C:\\Program Files\\Dell\\SARemediation\\audit\\TelemetryUtility.exe" and (ImageLoaded = "C:\\Program Files\\Dell\\SARemediation\\plugin\\log.dll" or ImageLoaded = "C:\\Program Files\\Dell\\SARemediation\\audit\\log.dll"))))) or ((ImageLoaded matches "*\\qrt.dll") and !(((ImageLoaded matches "C:\\Program Files\\F-Secure\\Anti-Virus\\*" or ImageLoaded matches "C:\\Program Files (x86)\\F-Secure\\Anti-Virus\\*")))) or (((ImageLoaded matches "*\\ashldres.dll" or ImageLoaded matches "*\\lockdown.dll" or ImageLoaded matches "*\\vsodscpl.dll")) and !(((ImageLoaded matches "C:\\Program Files\\McAfee\\*" or ImageLoaded matches "C:\\Program Files (x86)\\McAfee\\*")))) or ((ImageLoaded matches "*\\vftrace.dll") and !(((ImageLoaded matches "C:\\Program Files\\CyberArk\\Endpoint Privilege Manager\\Agent\\x32\\*" or ImageLoaded matches "C:\\Program Files (x86)\\CyberArk\\Endpoint Privilege Manager\\Agent\\x32\\*")))) or ((ImageLoaded matches "*\\wsc.dll") and !((((ImageLoaded matches "C:\\program Files\\AVAST Software\\Avast\\*" or ImageLoaded matches "C:\\program Files (x86)\\AVAST Software\\Avast\\*")) or ((ImageLoaded matches "C:\\Program Files\\AVG\\Antivirus\\*" or ImageLoaded matches "C:\\Program Files (x86)\\AVG\\Antivirus\\*"))))) or ((ImageLoaded matches "*\\tmdbglog.dll") and !(((ImageLoaded matches "C:\\program Files\\Trend Micro\\Titanium\\*" or ImageLoaded matches "C:\\program Files (x86)\\Trend Micro\\Titanium\\*")))) or ((ImageLoaded matches "*\\DLPPREM32.dll") and !(((ImageLoaded matches "C:\\program Files\\ESET*" or ImageLoaded matches "C:\\program Files (x86)\\ESET*")))))
