// Title: Disable Windows Defender AV Security Monitoring
// ID: a7ee1722-c3c5-aeff-3212-c777e4733217
// Status: test
// Level: high
// Author: ok @securonix invrep-de, oscd.community, frack113
// Date: 2020-10-12
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects attackers attempting to disable Windows Defender using Powershell
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((((Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe")) or ((OriginalFileName = "PowerShell.EXE" or OriginalFileName = "pwsh.dll"))) and ((CommandLine matches "*-DisableBehaviorMonitoring $true*" or CommandLine matches "*-DisableRuntimeMonitoring $true*"))) or (((Image matches "*\\sc.exe") or (OriginalFileName = "sc.exe")) and (((CommandLine matches "*delete*" and CommandLine matches "*WinDefend*")) or ((CommandLine matches "*config*" and CommandLine matches "*WinDefend*" and CommandLine matches "*start=disabled*")) or ((CommandLine matches "*stop*" and CommandLine matches "*WinDefend*")))))
