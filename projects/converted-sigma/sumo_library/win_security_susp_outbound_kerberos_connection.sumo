// Title: Uncommon Outbound Kerberos Connection - Security
// ID: eca91c7c-9214-47b9-b4c5-cb1d7e4f2350
// Status: test
// Level: medium
// Author: Ilyas Ochkov, oscd.community
// Date: 2019-10-24
// Tags: attack.lateral-movement, attack.credential-access, attack.t1558.003
// Description: Detects uncommon outbound network activity via Kerberos default port indicating possible lateral movement or first stage PrivEsc via delegation.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((EventID = "5156" and DestPort = "88") and !(((Application matches "\\device\\harddiskvolume*" or Application matches "C:*") and Application matches "*\\Windows\\System32\\lsass.exe")) and !((((Application matches "\\device\\harddiskvolume*" or Application matches "C:*") and (Application matches "*\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe" or Application matches "*\\Program Files\\Google\\Chrome\\Application\\chrome.exe")) or ((Application matches "\\device\\harddiskvolume*" or Application matches "C:*") and (Application matches "*\\Program Files (x86)\\Mozilla Firefox\\firefox.exe" or Application matches "*\\Program Files\\Mozilla Firefox\\firefox.exe")) or (Application matches "*\\tomcat\\bin\\tomcat8.exe"))))
