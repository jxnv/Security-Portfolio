// Title: Antivirus - Hacktool Signature
// ID: fa0c05b6-8ad3-468d-8231-c1cbccb64fba
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems), Arnim Rupp
// Date: 2021-08-16
// Tags: attack.execution, attack.t1204
// Description: Detects a highly relevant Antivirus alert that reports a hack tool or other attack tool.
// This event must not be ignored just because the AV has blocked the malware but investigate, how it came there in the first place.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Signature matches "ATK/*" or Signature matches "Exploit.Script.CVE*" or Signature matches "HKTL*" or Signature matches "HTOOL*" or Signature matches "PWS.*" or Signature matches "PWSX*" or Signature matches "SecurityTool*")) or ((Signature matches "*Adfind*" or Signature matches "*BloodH*" or Signature matches "*BloodyAD*" or Signature matches "*Brutel*" or Signature matches "*BruteR*" or Signature matches "*Cobalt*" or Signature matches "*COBEACON*" or Signature matches "*Cometer*" or Signature matches "*DumpCreds*" or Signature matches "*EDRfreeze*" or Signature matches "*FastReverseProxy*" or Signature matches "*Hacktool*" or Signature matches "*Havoc*" or Signature matches "*Impacket*" or Signature matches "*Keylogger*" or Signature matches "*Koadic*" or Signature matches "*Mimikatz*" or Signature matches "*Nighthawk*" or Signature matches "*PentestPowerShell*" or Signature matches "*Potato*" or Signature matches "*PowerSploit*" or Signature matches "*PowerSSH*" or Signature matches "*PshlSpy*" or Signature matches "*PSWTool*" or Signature matches "*PWCrack*" or Signature matches "*PWDump*" or Signature matches "*Responder*" or Signature matches "*Rozena*" or Signature matches "*Rusthound*" or Signature matches "*Sbelt*" or Signature matches "*Seatbelt*" or Signature matches "*SecurityTool*" or Signature matches "*SharpDump*" or Signature matches "*SharpHound*" or Signature matches "*Shellcode*" or Signature matches "*Sliver*" or Signature matches "*Snaffler*" or Signature matches "*SOAPHound*" or Signature matches "*Splinter*" or Signature matches "*Stowaway*" or Signature matches "*Swrort*" or Signature matches "*Trojan.Hound*" or Signature matches "*TurtleLoader*" or Signature matches "*Undefend*" or Signature matches "*Undfnd*")))
