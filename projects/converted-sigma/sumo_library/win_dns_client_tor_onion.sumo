// Title: Query Tor Onion Address - DNS Client
// ID: 8384bd26-bde6-4da9-8e5d-4174a7a47ca2
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-02-20
// Tags: attack.command-and-control, attack.t1090.003
// Description: Detects DNS resolution of an .onion address related to Tor routing networks
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (EventID = "3008" and (QueryName matches "*.hiddenservice.net" or QueryName matches "*.onion.ca" or QueryName matches "*.onion.cab" or QueryName matches "*.onion.casa" or QueryName matches "*.onion.city" or QueryName matches "*.onion.direct" or QueryName matches "*.onion.dog" or QueryName matches "*.onion.glass" or QueryName matches "*.onion.gq" or QueryName matches "*.onion.guide" or QueryName matches "*.onion.in.net" or QueryName matches "*.onion.ink" or QueryName matches "*.onion.it" or QueryName matches "*.onion.link" or QueryName matches "*.onion.lt" or QueryName matches "*.onion.lu" or QueryName matches "*.onion.ly" or QueryName matches "*.onion.mn" or QueryName matches "*.onion.network" or QueryName matches "*.onion.nu" or QueryName matches "*.onion.pet" or QueryName matches "*.onion.plus" or QueryName matches "*.onion.pt" or QueryName matches "*.onion.pw" or QueryName matches "*.onion.rip" or QueryName matches "*.onion.sh" or QueryName matches "*.onion.si" or QueryName matches "*.onion.to" or QueryName matches "*.onion.top" or QueryName matches "*.onion.ws" or QueryName matches "*.onion" or QueryName matches "*.s1.tor-gateways.de" or QueryName matches "*.s2.tor-gateways.de" or QueryName matches "*.s3.tor-gateways.de" or QueryName matches "*.s4.tor-gateways.de" or QueryName matches "*.s5.tor-gateways.de" or QueryName matches "*.t2w.pw" or QueryName matches "*.tor2web.ae.org" or QueryName matches "*.tor2web.blutmagie.de" or QueryName matches "*.tor2web.com" or QueryName matches "*.tor2web.fi" or QueryName matches "*.tor2web.io" or QueryName matches "*.tor2web.org" or QueryName matches "*.tor2web.xyz" or QueryName matches "*.torlink.co"))
