// Title: Shell32 DLL Execution in Suspicious Directory
// ID: 32b96012-7892-429e-b26c-ac2bf46066ff
// Status: test
// Level: high
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-11-24
// Tags: attack.execution, attack.stealth, attack.t1218.011
// Description: Detects shell32.dll executing a DLL in a suspicious directory
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*shell32.dll*" and CommandLine matches "*Control_RunDLL*") and (CommandLine matches "*%AppData%*" or CommandLine matches "*%LocalAppData%*" or CommandLine matches "*%Temp%*" or CommandLine matches "*%tmp%*" or CommandLine matches "*\\AppData\\*" or CommandLine matches "*\\Temp\\*" or CommandLine matches "*\\Users\\Public\\*")) and ((Image matches "*\\rundll32.exe") or (OriginalFileName = "RUNDLL32.EXE")))
