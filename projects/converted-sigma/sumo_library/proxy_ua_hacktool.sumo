// Title: Hack Tool User Agent
// ID: c42a3073-30fb-48ae-8c99-c23ada84b103
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2017-07-08
// Tags: attack.initial-access, attack.t1190, attack.credential-access, attack.t1110
// Description: Detects suspicious user agent strings user by hack tools in proxy logs
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((c-useragent matches "*(hydra)*" or c-useragent matches "* arachni/*" or c-useragent matches "* BFAC *" or c-useragent matches "* brutus *" or c-useragent matches "* cgichk *" or c-useragent matches "*core-project/1.0*" or c-useragent matches "* crimscanner/*" or c-useragent matches "*datacha0s*" or c-useragent matches "*dirbuster*" or c-useragent matches "*domino hunter*" or c-useragent matches "*dotdotpwn*" or c-useragent matches "*FHScan Core*" or c-useragent matches "*floodgate*" or c-useragent matches "*get-minimal*" or c-useragent matches "*gootkit auto-rooter scanner*" or c-useragent matches "*grendel-scan*" or c-useragent matches "* inspath *" or c-useragent matches "*internet ninja*" or c-useragent matches "*jaascois*" or c-useragent matches "* zmeu *" or c-useragent matches "*masscan*" or c-useragent matches "* metis *" or c-useragent matches "*morfeus fucking scanner*" or c-useragent matches "*n-stealth*" or c-useragent matches "*nsauditor*" or c-useragent matches "*pmafind*" or c-useragent matches "*security scan*" or c-useragent matches "*springenwerk*" or c-useragent matches "*teh forest lobster*" or c-useragent matches "*toata dragostea*" or c-useragent matches "* vega/*" or c-useragent matches "*voideye*" or c-useragent matches "*webshag*" or c-useragent matches "*webvulnscan*" or c-useragent matches "* whcc/*" or c-useragent matches "* Havij*" or c-useragent matches "*absinthe*" or c-useragent matches "*bsqlbf*" or c-useragent matches "*mysqloit*" or c-useragent matches "*pangolin*" or c-useragent matches "*sql power injector*" or c-useragent matches "*sqlmap*" or c-useragent matches "*sqlninja*" or c-useragent matches "*uil2pn*" or c-useragent matches "*ruler*" or c-useragent matches "*Mozilla/5.0 (Windows; U; Windows NT 5.1; pt-PT; rv:1.9.1.2) Gecko/20090729 Firefox/3.5.2 (.NET CLR 3.5.30729)*"))
