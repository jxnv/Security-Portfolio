// Title: Suspicious Command Patterns In Scheduled Task Creation
// ID: f2c64357-b1d2-41b7-849f-34d2682c0fad
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-23
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects scheduled task creation using "schtasks" that contain potentially suspicious or uncommon commands
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\schtasks.exe" and CommandLine matches "*/Create *") and ((((CommandLine matches "*/sc minute *" or CommandLine matches "*/ru system *")) and ((CommandLine matches "*cmd /c*" or CommandLine matches "*cmd /k*" or CommandLine matches "*cmd /r*" or CommandLine matches "*cmd.exe /c *" or CommandLine matches "*cmd.exe /k *" or CommandLine matches "*cmd.exe /r *"))) or ((CommandLine matches "* -decode *" or CommandLine matches "* -enc *" or CommandLine matches "* -w hidden *" or CommandLine matches "* bypass *" or CommandLine matches "* IEX*" or CommandLine matches "*.DownloadData*" or CommandLine matches "*.DownloadFile*" or CommandLine matches "*.DownloadString*" or CommandLine matches "*/c start /min *" or CommandLine matches "*FromBase64String*" or CommandLine matches "*mshta http*" or CommandLine matches "*mshta.exe http*")) or (((CommandLine matches "*:\\ProgramData\\*" or CommandLine matches "*:\\Temp\\*" or CommandLine matches "*:\\Tmp\\*" or CommandLine matches "*:\\Users\\Public\\*" or CommandLine matches "*:\\Windows\\Temp\\*" or CommandLine matches "*\\AppData\\*" or CommandLine matches "*%AppData%*" or CommandLine matches "*%Temp%*" or CommandLine matches "*%tmp%*")) and ((CommandLine matches "*cscript*" or CommandLine matches "*curl*" or CommandLine matches "*wscript*")))))
