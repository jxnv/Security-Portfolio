// Title: Chromium Browser Headless Execution To Mockbin Like Site
// ID: 1c526788-0abe-4713-862f-b520da5e5316
// Status: test
// Level: high
// Author: X__Junior (Nextron Systems)
// Date: 2023-09-11
// Tags: attack.execution
// Description: Detects the execution of a Chromium based browser process with the "headless" flag and a URL pointing to the mockbin.org service (which can be used to exfiltrate data).
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((CommandLine matches "*--headless*") and ((Image matches "*\\brave.exe" or Image matches "*\\chrome.exe" or Image matches "*\\msedge.exe" or Image matches "*\\opera.exe" or Image matches "*\\vivaldi.exe")) and ((CommandLine matches "*://run.mocky*" or CommandLine matches "*://mockbin*")))
