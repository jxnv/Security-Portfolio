// Title: Unusual Parent Process For Cmd.EXE
// ID: 4b991083-3d0e-44ce-8fc4-b254025d8d4b
// Status: test
// Level: medium
// Author: Tim Rauch, Elastic (idea)
// Date: 2022-09-21
// Tags: attack.execution, attack.t1059
// Description: Detects suspicious parent process for cmd.exe
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (Image matches "*\\cmd.exe" and (ParentImage matches "*\\csrss.exe" or ParentImage matches "*\\ctfmon.exe" or ParentImage matches "*\\dllhost.exe" or ParentImage matches "*\\epad.exe" or ParentImage matches "*\\FlashPlayerUpdateService.exe" or ParentImage matches "*\\GoogleUpdate.exe" or ParentImage matches "*\\jucheck.exe" or ParentImage matches "*\\jusched.exe" or ParentImage matches "*\\LogonUI.exe" or ParentImage matches "*\\lsass.exe" or ParentImage matches "*\\regsvr32.exe" or ParentImage matches "*\\SearchIndexer.exe" or ParentImage matches "*\\SearchProtocolHost.exe" or ParentImage matches "*\\SIHClient.exe" or ParentImage matches "*\\sihost.exe" or ParentImage matches "*\\slui.exe" or ParentImage matches "*\\spoolsv.exe" or ParentImage matches "*\\sppsvc.exe" or ParentImage matches "*\\taskhostw.exe" or ParentImage matches "*\\unsecapp.exe" or ParentImage matches "*\\WerFault.exe" or ParentImage matches "*\\wermgr.exe" or ParentImage matches "*\\wlanext.exe" or ParentImage matches "*\\WUDFHost.exe"))
