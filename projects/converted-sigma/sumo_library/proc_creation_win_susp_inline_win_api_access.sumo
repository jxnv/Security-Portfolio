// Title: Potential WinAPI Calls Via CommandLine
// ID: ba3f5c1b-6272-4119-9dbd-0bc8d21c2702
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-06
// Tags: attack.execution, attack.t1106
// Description: Detects the use of WinAPI Functions via the commandline. As seen used by threat actors via the tool winapiexec
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*AddSecurityPackage*" or CommandLine matches "*AdjustTokenPrivileges*" or CommandLine matches "*Advapi32*" or CommandLine matches "*CloseHandle*" or CommandLine matches "*CreateProcessWithToken*" or CommandLine matches "*CreatePseudoConsole*" or CommandLine matches "*CreateRemoteThread*" or CommandLine matches "*CreateThread*" or CommandLine matches "*CreateUserThread*" or CommandLine matches "*DangerousGetHandle*" or CommandLine matches "*DuplicateTokenEx*" or CommandLine matches "*EnumerateSecurityPackages*" or CommandLine matches "*FreeHGlobal*" or CommandLine matches "*FreeLibrary*" or CommandLine matches "*GetDelegateForFunctionPointer*" or CommandLine matches "*GetLogonSessionData*" or CommandLine matches "*GetModuleHandle*" or CommandLine matches "*GetProcAddress*" or CommandLine matches "*GetProcessHandle*" or CommandLine matches "*GetTokenInformation*" or CommandLine matches "*ImpersonateLoggedOnUser*" or CommandLine matches "*kernel32*" or CommandLine matches "*LoadLibrary*" or CommandLine matches "*memcpy*" or CommandLine matches "*MiniDumpWriteDump*" or CommandLine matches "*ntdll*" or CommandLine matches "*OpenDesktop*" or CommandLine matches "*OpenProcess*" or CommandLine matches "*OpenProcessToken*" or CommandLine matches "*OpenThreadToken*" or CommandLine matches "*OpenWindowStation*" or CommandLine matches "*PtrToString*" or CommandLine matches "*QueueUserApc*" or CommandLine matches "*ReadProcessMemory*" or CommandLine matches "*RevertToSelf*" or CommandLine matches "*RtlCreateUserThread*" or CommandLine matches "*secur32*" or CommandLine matches "*SetThreadToken*" or CommandLine matches "*VirtualAlloc*" or CommandLine matches "*VirtualFree*" or CommandLine matches "*VirtualProtect*" or CommandLine matches "*WaitForSingleObject*" or CommandLine matches "*WriteInt32*" or CommandLine matches "*WriteProcessMemory*" or CommandLine matches "*ZeroFreeGlobalAllocUnicode*")) and !(((ParentImage matches "*\\CompatTelRunner.exe" and (CommandLine matches "*FreeHGlobal*" or CommandLine matches "*PtrToString*" or CommandLine matches "*kernel32*" or CommandLine matches "*CloseHandle*")) or (Image matches "*\\MpCmdRun.exe" and CommandLine matches "*GetLoadLibraryWAddress32*"))))
