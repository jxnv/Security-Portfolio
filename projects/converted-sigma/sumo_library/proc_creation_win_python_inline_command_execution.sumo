// Title: Python Inline Command Execution
// ID: 899133d5-4d7c-4a7f-94ee-27355c879d90
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-02
// Tags: attack.execution, attack.t1059
// Description: Detects execution of python using the "-c" flag. This is could be used as a way to launch a reverse shell or execute live python code.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "* -c*") and ((OriginalFileName = "python.exe") or ((Image matches "*python.exe" or Image matches "*python3.exe" or Image matches "*python2.exe")))) and !((((ParentImage matches "C:\\Program Files\\Python*" or ParentImage matches "C:\\Program Files (x86)\\Python*") and ParentImage matches "*\\python.exe" and ParentCommandLine matches "*-E -s -m ensurepip -U --default-pip*") or ((ParentImage matches "C:\\Program Files\\Python*" or ParentImage matches "C:\\Program Files (x86)\\Python*") and (CommandLine matches "*-W ignore::DeprecationWarning*" and CommandLine matches "*['install', '--no-cache-dir', '--no-index', '--find-links',*" and CommandLine matches "*'--upgrade', 'pip'*")))) and !((((CommandLine matches "*<pip-setuptools-caller>*" and CommandLine matches "*exec(compile(*")) or ((ParentImage matches "*\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe") or ((ParentImage = "C:\\Program Files\\Microsoft VS Code\\Code.exe" or ParentImage = "C:\\Program Files (x86)\\Microsoft VS Code\\Code.exe"))))))
