// Title: Potential Command Line Path Traversal Evasion Attempt
// ID: 1327381e-6ab0-4f38-b583-4c1b8346a56b
// Status: test
// Level: medium
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-10-26
// Tags: attack.stealth, attack.t1036
// Description: Detects potential evasion or obfuscation attempts using bogus path traversal via the commandline
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*\\Windows\\*" and (CommandLine matches "*\\..\\Windows\\*" or CommandLine matches "*\\..\\System32\\*" or CommandLine matches "*\\..\\..\\*")) or (CommandLine matches "*.exe\\..\\*")) and !(((CommandLine matches "*\\Citrix\\Virtual Smart Card\\Citrix.Authentication.VirtualSmartcard.Launcher.exe\\..\\*") or (CommandLine matches "*\\Google\\Drive\\googledrivesync.exe\\..\\*"))))
