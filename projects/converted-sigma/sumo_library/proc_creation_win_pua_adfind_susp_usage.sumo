// Title: PUA - AdFind Suspicious Execution
// ID: 9a132afa-654e-11eb-ae93-0242ac130002
// Status: test
// Level: high
// Author: Janantha Marasinghe (https://github.com/blueteam0ps), FPT.EagleEye Team, omkar72, oscd.community
// Date: 2021-02-02
// Tags: attack.discovery, attack.t1018, attack.t1087.002, attack.t1482, attack.t1069.002, stp.1u
// Description: Detects AdFind execution with common flags seen used during attacks
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((CommandLine matches "*domainlist*" or CommandLine matches "*trustdmp*" or CommandLine matches "*dcmodes*" or CommandLine matches "*adinfo*" or CommandLine matches "*-sc dclist*" or CommandLine matches "*computer_pwdnotreqd*" or CommandLine matches "*objectcategory=*" or CommandLine matches "*-subnets -f*" or CommandLine matches "*name=\"Domain Admins\"*" or CommandLine matches "*-sc u:*" or CommandLine matches "*domainncs*" or CommandLine matches "*dompol*" or CommandLine matches "* oudmp *" or CommandLine matches "*subnetdmp*" or CommandLine matches "*gpodmp*" or CommandLine matches "*fspdmp*" or CommandLine matches "*users_noexpire*" or CommandLine matches "*computers_active*" or CommandLine matches "*computers_pwdnotreqd*"))
