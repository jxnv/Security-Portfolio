// Title: Potential Direct Syscall of NtOpenProcess
// ID: 3f3f3506-1895-401b-9cc3-e86b16e630d0
// Status: test
// Level: medium
// Author: Christian Burkard (Nextron Systems), Tim Shelton (FP)
// Date: 2021-07-28
// Tags: attack.execution, attack.t1106
// Description: Detects potential calls to NtOpenProcess directly from NTDLL.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((CallTrace matches "UNKNOWN*") and !((((SourceImage matches "*:\\Program Files (x86)\\*" or SourceImage matches "*:\\Program Files\\*" or SourceImage matches "*:\\Windows\\System32\\*" or SourceImage matches "*:\\Windows\\SysWOW64\\*" or SourceImage matches "*:\\Windows\\WinSxS\\*") and (TargetImage matches "*:\\Program Files (x86)\\*" or TargetImage matches "*:\\Program Files\\*" or TargetImage matches "*:\\Windows\\System32\\*" or TargetImage matches "*:\\Windows\\SysWOW64\\*" or TargetImage matches "*:\\Windows\\WinSxS\\*")) or (Provider_Name = "Microsoft-Windows-Kernel-Audit-API-Calls") or (TargetImage matches "*vcredist_x64.exe" and SourceImage matches "*vcredist_x64.exe"))) and !(((SourceImage matches "*:\\Program Files\\Adobe\\Acrobat DC\\Acrobat\\*" and SourceImage matches "*\\AcroCEF.exe" and TargetImage matches "*:\\Program Files\\Adobe\\Acrobat DC\\Acrobat\\*" and TargetImage matches "*\\AcroCEF.exe") or (SourceImage matches "*AmazonSSMAgentSetup.exe" and TargetImage matches "*AmazonSSMAgentSetup.exe") or (SourceImage matches "*:\\Windows\\Explorer.EXE" and TargetImage matches "*:\\Program Files\\Cylance\\Desktop\\CylanceUI.exe") or (TargetImage matches "*\\AppData\\Local\\Discord\\*" and TargetImage matches "*\\Discord.exe") or (TargetImage matches "*\\Evernote\\Evernote.exe") or (TargetImage matches "*\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe" and SourceImage matches "*\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe") or (TargetImage matches "*:\\Windows\\system32\\systeminfo.exe" and SourceImage matches "*setup64.exe") or (SourceImage matches "*\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe" and TargetImage matches "*\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe") or (SourceImage matches "*\\AppData\\Local\\yammerdesktop\\app-*" and SourceImage matches "*\\Yammer.exe" and TargetImage matches "*\\AppData\\Local\\yammerdesktop\\app-*" and TargetImage matches "*\\Yammer.exe" and GrantedAccess = "0x1000"))))
