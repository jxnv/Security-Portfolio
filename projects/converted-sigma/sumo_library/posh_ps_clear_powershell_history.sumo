// Title: Clear PowerShell History - PowerShell
// ID: 26b692dc-1722-49b2-b496-a8258aa6371d
// Status: test
// Level: medium
// Author: Ilyas Ochkov, Jonhnathan Ribeiro, Daniil Yugoslavskiy, oscd.community
// Date: 2022-01-25
// Tags: attack.stealth, attack.t1070.003
// Description: Detects keywords that could indicate clearing PowerShell history
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((ScriptBlockText matches "*Set-PSReadlineOption*" and ScriptBlockText matches "*–HistorySaveStyle*" and ScriptBlockText matches "*SaveNothing*")) or ((ScriptBlockText matches "*Set-PSReadlineOption*" and ScriptBlockText matches "*-HistorySaveStyle*" and ScriptBlockText matches "*SaveNothing*"))) or (((ScriptBlockText matches "*del*" or ScriptBlockText matches "*Remove-Item*" or ScriptBlockText matches "*rm*")) and (ScriptBlockText matches "*(Get-PSReadlineOption).HistorySavePath*")))
