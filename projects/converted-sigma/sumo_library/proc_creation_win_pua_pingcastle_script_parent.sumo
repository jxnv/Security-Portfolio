// Title: PUA - PingCastle Execution From Potentially Suspicious Parent
// ID: b37998de-a70b-4f33-b219-ec36bf433dc0
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2024-01-11
// Tags: attack.reconnaissance, attack.t1595
// Description: Detects the execution of PingCastle, a tool designed to quickly assess the Active Directory security level via a script located in a potentially suspicious or uncommon location.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((ParentCommandLine matches "*.bat*" or ParentCommandLine matches "*.chm*" or ParentCommandLine matches "*.cmd*" or ParentCommandLine matches "*.hta*" or ParentCommandLine matches "*.htm*" or ParentCommandLine matches "*.html*" or ParentCommandLine matches "*.js*" or ParentCommandLine matches "*.lnk*" or ParentCommandLine matches "*.ps1*" or ParentCommandLine matches "*.vbe*" or ParentCommandLine matches "*.vbs*" or ParentCommandLine matches "*.wsf*")) or ((ParentCommandLine matches "*:\\Perflogs\\*" or ParentCommandLine matches "*:\\Temp\\*" or ParentCommandLine matches "*:\\Users\\Public\\*" or ParentCommandLine matches "*:\\Windows\\Temp\\*" or ParentCommandLine matches "*\\AppData\\Local\\Temp*" or ParentCommandLine matches "*\\AppData\\Roaming\\*" or ParentCommandLine matches "*\\Temporary Internet*")) or (((ParentCommandLine matches "*:\\Users\\*" and ParentCommandLine matches "*\\Favorites\\*")) or ((ParentCommandLine matches "*:\\Users\\*" and ParentCommandLine matches "*\\Favourites\\*")) or ((ParentCommandLine matches "*:\\Users\\*" and ParentCommandLine matches "*\\Contacts\\*")))) and ((ParentCommandLine matches "*.bat*" or ParentCommandLine matches "*.chm*" or ParentCommandLine matches "*.cmd*" or ParentCommandLine matches "*.hta*" or ParentCommandLine matches "*.htm*" or ParentCommandLine matches "*.html*" or ParentCommandLine matches "*.js*" or ParentCommandLine matches "*.lnk*" or ParentCommandLine matches "*.ps1*" or ParentCommandLine matches "*.vbe*" or ParentCommandLine matches "*.vbs*" or ParentCommandLine matches "*.wsf*")) and ((Image matches "*\\PingCastle.exe") or (OriginalFileName = "PingCastle.exe") or (Product = "Ping Castle") or ((CommandLine matches "*--scanner aclcheck*" or CommandLine matches "*--scanner antivirus*" or CommandLine matches "*--scanner computerversion*" or CommandLine matches "*--scanner foreignusers*" or CommandLine matches "*--scanner laps_bitlocker*" or CommandLine matches "*--scanner localadmin*" or CommandLine matches "*--scanner nullsession*" or CommandLine matches "*--scanner nullsession-trust*" or CommandLine matches "*--scanner oxidbindings*" or CommandLine matches "*--scanner remote*" or CommandLine matches "*--scanner share*" or CommandLine matches "*--scanner smb*" or CommandLine matches "*--scanner smb3querynetwork*" or CommandLine matches "*--scanner spooler*" or CommandLine matches "*--scanner startup*" or CommandLine matches "*--scanner zerologon*")) or (CommandLine matches "*--no-enum-limit*") or ((CommandLine matches "*--healthcheck*" and CommandLine matches "*--level Full*")) or ((CommandLine matches "*--healthcheck*" and CommandLine matches "*--server *"))))
