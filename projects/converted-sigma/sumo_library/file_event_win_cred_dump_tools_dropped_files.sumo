_sourceCategory=* | where (((TargetFilename matches "*\\fgdump-log*" or TargetFilename matches "*\\kirbi*" or TargetFilename matches "*\\pwdump*" or TargetFilename matches "*\\pwhashes*" or TargetFilename matches "*\\wce_ccache*" or TargetFilename matches "*\\wce_krbtkts*")) or ((TargetFilename matches "*\\cachedump.exe" or TargetFilename matches "*\\cachedump64.exe" or TargetFilename matches "*\\DumpExt.dll" or TargetFilename matches "*\\DumpSvc.exe" or TargetFilename matches "*\\Dumpy.exe" or TargetFilename matches "*\\fgexec.exe" or TargetFilename matches "*\\lsremora.dll" or TargetFilename matches "*\\lsremora64.dll" or TargetFilename matches "*\\NTDS.out" or TargetFilename matches "*\\procdump.exe" or TargetFilename matches "*\\procdump64.exe" or TargetFilename matches "*\\procdump64a.exe" or TargetFilename matches "*\\pstgdump.exe" or TargetFilename matches "*\\pwdump.exe" or TargetFilename matches "*\\SAM.out" or TargetFilename matches "*\\SECURITY.out" or TargetFilename matches "*\\servpw.exe" or TargetFilename matches "*\\servpw64.exe" or TargetFilename matches "*\\SYSTEM.out" or TargetFilename matches "*\\test.pwd" or TargetFilename matches "*\\wceaux.dll")))
