// Title: Deletion of Volume Shadow Copies via WMI with PowerShell - PS Script
// ID: c1337eb8-921a-4b59-855b-4ba188ddcc42
// Status: test
// Level: high
// Author: Tim Rauch, frack113
// Date: 2022-09-20
// Tags: attack.impact, attack.t1490
// Description: Detects deletion of Windows Volume Shadow Copies with PowerShell code and Get-WMIObject. This technique is used by numerous ransomware families such as Sodinokibi/REvil
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((ScriptBlockText matches "*.Delete()*" or ScriptBlockText matches "*Remove-WmiObject*" or ScriptBlockText matches "*rwmi*" or ScriptBlockText matches "*Remove-CimInstance*" or ScriptBlockText matches "*rcim*")) and ((ScriptBlockText matches "*Get-WmiObject*" or ScriptBlockText matches "*gwmi*" or ScriptBlockText matches "*Get-CimInstance*" or ScriptBlockText matches "*gcim*")) and (ScriptBlockText matches "*Win32_ShadowCopy*"))
