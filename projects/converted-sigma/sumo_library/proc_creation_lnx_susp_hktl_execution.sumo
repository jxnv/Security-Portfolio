// Title: Linux HackTool Execution
// ID: a015e032-146d-4717-8944-7a1884122111
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Georg Lauenstein (sure[secure])
// Date: 2023-01-03
// Tags: attack.execution, attack.resource-development, attack.t1587
// Description: Detects known hacktool execution based on image name.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*/cobaltstrike*" or Image matches "*/teamserver*")) or ((Image matches "*/crackmapexec" or Image matches "*/havoc" or Image matches "*/merlin-agent" or Image matches "*/merlinServer-Linux-x64" or Image matches "*/msfconsole" or Image matches "*/msfvenom" or Image matches "*/ps-empire server" or Image matches "*/ps-empire" or Image matches "*/sliver-client" or Image matches "*/sliver-server" or Image matches "*/Villain.py")) or ((Image matches "*/aircrack-ng" or Image matches "*/bloodhound-python" or Image matches "*/bpfdos" or Image matches "*/ebpfki" or Image matches "*/evil-winrm" or Image matches "*/hashcat" or Image matches "*/hoaxshell.py" or Image matches "*/hydra" or Image matches "*/john" or Image matches "*/ncrack" or Image matches "*/nxc-ubuntu-latest" or Image matches "*/pidhide" or Image matches "*/pspy32" or Image matches "*/pspy32s" or Image matches "*/pspy64" or Image matches "*/pspy64s" or Image matches "*/setoolkit" or Image matches "*/sqlmap" or Image matches "*/writeblocker")) or (Image matches "*/linpeas*") or ((Image matches "*/autorecon" or Image matches "*/httpx" or Image matches "*/legion" or Image matches "*/naabu" or Image matches "*/netdiscover" or Image matches "*/nuclei" or Image matches "*/recon-ng")) or (Image matches "*/sniper*") or ((Image matches "*/dirb" or Image matches "*/dirbuster" or Image matches "*/eyewitness" or Image matches "*/feroxbuster" or Image matches "*/ffuf" or Image matches "*/gobuster" or Image matches "*/wfuzz" or Image matches "*/whatweb")) or ((Image matches "*/joomscan" or Image matches "*/nikto" or Image matches "*/wpscan")))
