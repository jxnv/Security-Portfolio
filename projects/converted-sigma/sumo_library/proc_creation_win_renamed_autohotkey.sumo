// Title: Renamed AutoHotkey.EXE Execution
// ID: 0f16d9cf-0616-45c8-8fad-becc11b5a41c
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali
// Date: 2023-02-07
// Tags: attack.stealth
// Description: Detects execution of a renamed autohotkey.exe binary based on PE metadata fields
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Product matches "*AutoHotkey*") or (Description matches "*AutoHotkey*") or ((OriginalFileName = "AutoHotkey.exe" or OriginalFileName = "AutoHotkey.rc"))) and !((((Image matches "*\\AutoHotkey.exe" or Image matches "*\\AutoHotkey32.exe" or Image matches "*\\AutoHotkey32_UIA.exe" or Image matches "*\\AutoHotkey64.exe" or Image matches "*\\AutoHotkey64_UIA.exe" or Image matches "*\\AutoHotkeyA32.exe" or Image matches "*\\AutoHotkeyA32_UIA.exe" or Image matches "*\\AutoHotkeyU32.exe" or Image matches "*\\AutoHotkeyU32_UIA.exe" or Image matches "*\\AutoHotkeyU64.exe" or Image matches "*\\AutoHotkeyU64_UIA.exe")) or (Image matches "*\\AutoHotkey*"))))
