// Title: PowerShell Base64 Encoded Invoke Keyword
// ID: 6385697e-9f1b-40bd-8817-f4a91f40508e
// Status: test
// Level: high
// Author: pH-T (Nextron Systems), Harjot Singh, @cyb3rjy0t
// Date: 2022-05-20
// Tags: attack.execution, attack.stealth, attack.t1059.001, attack.t1027
// Description: Detects UTF-8 and UTF-16 Base64 encoded powershell 'Invoke-' calls
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((CommandLine matches "* -e*") and ((CommandLine matches "*SQBuAHYAbwBrAGUALQ*" or CommandLine matches "*kAbgB2AG8AawBlAC0A*" or CommandLine matches "*JAG4AdgBvAGsAZQAtA*" or CommandLine matches "*SW52b2tlL*" or CommandLine matches "*ludm9rZS*" or CommandLine matches "*JbnZva2Ut*")) and (((Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe")) or ((OriginalFileName = "PowerShell.EXE" or OriginalFileName = "pwsh.dll"))))
