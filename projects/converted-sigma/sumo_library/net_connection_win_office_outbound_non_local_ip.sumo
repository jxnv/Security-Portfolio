// Title: Office Application Initiated Network Connection To Non-Local IP
// ID: 75e33ce3-ae32-4dcc-9aa8-a2a3029d6f84
// Status: test
// Level: medium
// Author: Christopher Peacock '@securepeacock', SCYTHE '@scythe_io', Florian Roth (Nextron Systems), Tim Shelton, Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-11-10
// Tags: attack.execution, attack.t1203
// Description: Detects an office application (Word, Excel, PowerPoint)  that initiate a network connection to a non-private IP addresses.
// This rule aims to detect traffic similar to one seen exploited in CVE-2021-42292.
// This rule will require an initial baseline and tuning that is specific to your organization.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*\\excel.exe" or Image matches "*\\outlook.exe" or Image matches "*\\powerpnt.exe" or Image matches "*\\winword.exe" or Image matches "*\\wordview.exe") and Initiated = "true") and !(((DestinationHostname matches "*.deploy.static.akamaitechnologies.com" and DestinationPort = "443" and Protocol = "tcp") or ((cidrMatch(DestinationIp, "127.0.0.0/8") or cidrMatch(DestinationIp, "10.0.0.0/8") or cidrMatch(DestinationIp, "172.16.0.0/12") or cidrMatch(DestinationIp, "192.168.0.0/16") or cidrMatch(DestinationIp, "169.254.0.0/16") or cidrMatch(DestinationIp, "::1/128") or cidrMatch(DestinationIp, "fe80::/10") or cidrMatch(DestinationIp, "fc00::/7"))) or ((cidrMatch(DestinationIp, "13.107.4.0/22") or cidrMatch(DestinationIp, "13.107.6.152/31") or cidrMatch(DestinationIp, "13.107.18.10/31") or cidrMatch(DestinationIp, "13.107.42.0/23") or cidrMatch(DestinationIp, "13.107.128.0/22") or cidrMatch(DestinationIp, "23.35.224.0/20") or cidrMatch(DestinationIp, "23.53.40.0/22") or cidrMatch(DestinationIp, "23.103.160.0/20") or cidrMatch(DestinationIp, "23.216.76.0/22") or cidrMatch(DestinationIp, "40.96.0.0/13") or cidrMatch(DestinationIp, "40.104.0.0/15") or cidrMatch(DestinationIp, "52.96.0.0/14") or cidrMatch(DestinationIp, "131.253.33.215/32") or cidrMatch(DestinationIp, "132.245.0.0/16") or cidrMatch(DestinationIp, "150.171.32.0/22") or cidrMatch(DestinationIp, "204.79.197.215/32") or cidrMatch(DestinationIp, "2603:1006::/40") or cidrMatch(DestinationIp, "2603:1016::/36") or cidrMatch(DestinationIp, "2603:1026::/36") or cidrMatch(DestinationIp, "2603:1036::/36") or cidrMatch(DestinationIp, "2603:1046::/36") or cidrMatch(DestinationIp, "2603:1056::/36") or cidrMatch(DestinationIp, "2620:1ec:4::152/128") or cidrMatch(DestinationIp, "2620:1ec:4::153/128") or cidrMatch(DestinationIp, "2620:1ec:c::10/128") or cidrMatch(DestinationIp, "2620:1ec:c::11/128") or cidrMatch(DestinationIp, "2620:1ec:d::10/128") or cidrMatch(DestinationIp, "2620:1e