// Title: DNS Query To AzureWebsites.NET By Non-Browser Process
// ID: e043f529-8514-4205-8ab0-7f7d2927b400
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects a DNS query by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((QueryName matches "*azurewebsites.net") and !((((Image matches "C:\\Program Files (x86)\\Avant Browser\\*" or Image matches "C:\\Program Files\\Avant Browser\\*") and Image matches "*\\avant.exe") or (Image matches "*\\brave.exe" and Image matches "C:\\Program Files\\BraveSoftware\\*") or ((Image = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or Image = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or ((Image matches "*\\MsMpEng.exe" or Image matches "*\\MsSense.exe")) or ((Image matches "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*") or (Image matches "*\\WindowsApps\\MicrosoftEdge.exe") or ((Image = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or Image = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((Image matches "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\*" or Image matches "C:\\Program Files\\Microsoft\\EdgeCore\\*") and (Image matches "*\\msedge.exe" or Image matches "*\\msedgewebview2.exe")) or ((Image matches "C:\\Program Files\\Falkon\\*" or Image matches "C:\\Program Files (x86)\\Falkon\\*") and Image matches "*\\falkon.exe") or ((Image = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or Image = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or (Image matches "*\\AppData\\Local\\Flock\\*" and Image matches "*\\Flock.exe") or ((Image = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or Image = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (Image matches "*\\AppData\\Local\\Maxthon\\*" and Image matches "*\\maxthon.exe") or (Image matches "*\\AppData\\Local\\Programs\\midori-ng\\*" and Image matches "*\\Midori Next Generation.exe") or (Image matches "*\\AppData\\Local\\Programs\\Opera\\*" and Image matches "*\\opera.exe") or (Image matches "*\\AppData\\Local\\Phoebe\\*" and Image matches "*\\Phoebe.exe") or (Image matches "*\\safari.exe") or ((Image matches "C:\\Program Files\\SeaMonkey\\*" or Image matches "C:\\Program Files (x86)\\SeaMonkey\\*") and Image matches "*\\seamonkey.exe") or ((Image matches "C:\\Program Files\\SlimBrowser\\*" or Image matches "C:\\Program Files (x86)\\SlimBrowser\\*") and Image matches "*\\slimbrowser.exe") or (Image matches "*\\Tor Browser\\*") or (Image matches "*\\AppData\\Local\\Vivaldi\\*" and Image matches "*\\vivaldi.exe") or ((Image matches "C:\\Program Files\\Naver\\Naver Whale\\*" or Image matches "C:\\Program Files (x86)\\Naver\\Naver Whale\\*") and Image matches "*\\whale.exe") or ((Image matches "C:\\Program Files\\Waterfox\\*" or Image matches "C:\\Program Files (x86)\\Waterfox\\*") and Image matches "*\\Waterfox.exe"))))
