// Title: Print History File Contents
// ID: d7821ff1-4527-4e33-9f84-d0d57fa2fb66
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-06-20
// Tags: attack.reconnaissance, attack.t1592.004
// Description: Detects events in which someone prints the contents of history files to the commandline or redirects it to a file for reconnaissance
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*/cat" or Image matches "*/head" or Image matches "*/tail" or Image matches "*/more")) and (((CommandLine matches "*/.bash_history*" or CommandLine matches "*/.zsh_history*")) or ((CommandLine matches "*_history" or CommandLine matches "*.history" or CommandLine matches "*zhistory"))))
