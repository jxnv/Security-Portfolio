// Tags: attack.collection, attack.t1119
// Description: Once established within a system or network, an adversary may use automated techniques for collecting internal data.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((ScriptBlockText matches "*Get-ChildItem*" and ScriptBlockText matches "* -Recurse *" and ScriptBlockText matches "* -Include *")) and ((ScriptBlockText matches "*.doc*" or ScriptBlockText matches "*.docx*" or ScriptBlockText matches "*.xls*" or ScriptBlockText matches "*.xlsx*" or ScriptBlockText matches "*.ppt*" or ScriptBlockText matches "*.pptx*" or ScriptBlockText matches "*.rtf*" or ScriptBlockText matches "*.pdf*" or ScriptBlockText matches "*.txt*")))
