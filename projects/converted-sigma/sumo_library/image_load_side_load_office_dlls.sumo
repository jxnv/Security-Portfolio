// Title: Microsoft Office DLL Sideload
// ID: 829a3bdf-34da-4051-9cf4-8ed221a8ae4f
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Wietze Beukema (project and research)
// Date: 2022-08-17
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects DLL sideloading of DLLs that are part of Microsoft Office from non standard location
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((ImageLoaded matches "*\\outllib.dll") and !(((ImageLoaded matches "C:\\Program Files\\Microsoft Office\\OFFICE*" or ImageLoaded matches "C:\\Program Files (x86)\\Microsoft Office\\OFFICE*" or ImageLoaded matches "C:\\Program Files\\Microsoft Office\\Root\\OFFICE*" or ImageLoaded matches "C:\\Program Files (x86)\\Microsoft Office\\Root\\OFFICE*"))))
