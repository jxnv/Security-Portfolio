// Title: Suspicious New Service Creation
// ID: 17a1be64-8d88-40bf-b5ff-a4f7a50ebcc8
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-14
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects creation of a new service via "sc" command or the powershell "new-service" cmdlet with suspicious binary paths
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((CommandLine matches "*New-Service*" and CommandLine matches "*-BinaryPathName*")) or (Image matches "*\\sc.exe" and (CommandLine matches "*create*" and CommandLine matches "*binPath=*"))) and ((CommandLine matches "*powershell*" or CommandLine matches "*mshta*" or CommandLine matches "*wscript*" or CommandLine matches "*cscript*" or CommandLine matches "*svchost*" or CommandLine matches "*dllhost*" or CommandLine matches "*cmd *" or CommandLine matches "*cmd.exe /c*" or CommandLine matches "*cmd.exe /k*" or CommandLine matches "*cmd.exe /r*" or CommandLine matches "*rundll32*" or CommandLine matches "*C:\\Users\\Public*" or CommandLine matches "*\\Downloads\\*" or CommandLine matches "*\\Desktop\\*" or CommandLine matches "*\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\*" or CommandLine matches "*C:\\Windows\\TEMP\\*" or CommandLine matches "*\\AppData\\Local\\Temp*")))
