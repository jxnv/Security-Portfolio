// Title: Suspicious PowerShell In Registry Run Keys
// ID: 8d85cf08-bf97-4260-ba49-986a2a65129c
// Status: test
// Level: medium
// Author: frack113, Florian Roth (Nextron Systems)
// Date: 2022-03-17
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects potential PowerShell commands or code within registry run keys
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((TargetObject matches "*\\Software\\Microsoft\\Windows\\CurrentVersion\\Run*" or TargetObject matches "*\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run*" or TargetObject matches "*\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\Run*") and (Details matches "*powershell*" or Details matches "*pwsh *" or Details matches "*FromBase64String*" or Details matches "*.DownloadFile(*" or Details matches "*.DownloadString(*" or Details matches "* -w hidden *" or Details matches "* -w 1 *" or Details matches "*-windowstyle hidden*" or Details matches "*-window hidden*" or Details matches "* -nop *" or Details matches "* -encodedcommand *" or Details matches "*-ExecutionPolicy Bypass*" or Details matches "*Invoke-Expression*" or Details matches "*IEX (*" or Details matches "*Invoke-Command*" or Details matches "*ICM -*" or Details matches "*Invoke-WebRequest*" or Details matches "*IWR *" or Details matches "*Invoke-RestMethod*" or Details matches "*IRM *" or Details matches "* -noni *" or Details matches "* -noninteractive *"))
