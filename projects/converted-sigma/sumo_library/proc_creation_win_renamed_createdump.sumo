// Title: Renamed CreateDump Utility Execution
// ID: 1a1ed54a-2ba4-4221-94d5-01dee560d71e
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-09-20
// Tags: attack.stealth, attack.t1036, attack.t1003.001, attack.credential-access
// Description: Detects uses of a renamed legitimate createdump.exe LOLOBIN utility to dump process memory
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((((CommandLine matches "* -u *" and CommandLine matches "* -f *" and CommandLine matches "*.dmp*")) or ((CommandLine matches "* --full *" and CommandLine matches "* --name *" and CommandLine matches "*.dmp*"))) or (OriginalFileName = "FX_VER_INTERNALNAME_STR")) and !((Image matches "*\\createdump.exe")))
