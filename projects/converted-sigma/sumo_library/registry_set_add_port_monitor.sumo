// Title: Add Port Monitor Persistence in Registry
// ID: 944e8941-f6f6-4ee8-ac05-1c224e923c0e
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-12-30
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.010
// Description: Adversaries may use port monitors to run an attacker supplied DLL during system boot for persistence or privilege escalation.
// A port monitor can be set through the AddMonitor API call to set a DLL to be loaded at startup.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((TargetObject matches "*\\Control\\Print\\Monitors\\*" and Details matches "*.dll") and !(((Image = "C:\\Windows\\System32\\spoolsv.exe" and TargetObject matches "*\\Control\\Print\\Monitors\\CutePDF Writer Monitor v4.0\\Driver*" and Details = "cpwmon64_v40.dll" and (User matches "*AUTHORI*" or User matches "*AUTORI*")) or (TargetObject matches "*\\Control\\Print\\Monitors\\MONVNC\\Driver*") or ((TargetObject matches "*Control\\Print\\Environments\\*" and TargetObject matches "*\\Drivers\\*" and TargetObject matches "*\\VNC Printer*")))))
