// Title: HackTool - LaZagne Execution
// ID: c2b86e67-b880-4eec-b045-50bc98ef4844
// Status: experimental
// Level: medium
// Author: Nasreddine Bencherchali, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.credential-access
// Description: Detects the execution of the LaZagne. A utility used to retrieve multiple types of passwords stored on a local computer.
// LaZagne has been leveraged multiple times by threat actors in order to dump credentials.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((Image matches "*:\\PerfLogs\\*" or Image matches "*:\\ProgramData\\*" or Image matches "*:\\Temp\\*" or Image matches "*:\\Tmp\\*" or Image matches "*:\\Users\\Public\\*" or Image matches "*:\\Windows\\Temp\\*" or Image matches "*\\$Recycle.bin*" or Image matches "*\\AppData\\*" or Image matches "*\\Desktop\\*" or Image matches "*\\Downloads\\*" or Image matches "*\\Favorites\\*" or Image matches "*\\Links\\*" or Image matches "*\\Music\\*" or Image matches "*\\Photos\\*" or Image matches "*\\Pictures\\*" or Image matches "*\\Saved Games\\*" or Image matches "*\\Searches\\*" or Image matches "*\\Users\\Contacts\\*" or Image matches "*\\Users\\Default\\*" or Image matches "*\\Users\\Searches\\*" or Image matches "*\\Videos\\*" or Image matches "*\\Windows\\addins\\*" or Image matches "*\\Windows\\Fonts\\*" or Image matches "*\\Windows\\IME\\*") and (CommandLine matches "*.exe all" or CommandLine matches "*.exe browsers" or CommandLine matches "*.exe chats" or CommandLine matches "*.exe databases" or CommandLine matches "*.exe games" or CommandLine matches "*.exe git" or CommandLine matches "*.exe mails" or CommandLine matches "*.exe maven" or CommandLine matches "*.exe memory" or CommandLine matches "*.exe multimedia" or CommandLine matches "*.exe sysadmin" or CommandLine matches "*.exe unused" or CommandLine matches "*.exe wifi" or CommandLine matches "*.exe windows")) or (Image matches "*\\lazagne.exe")) or (((CommandLine matches "* all *" or CommandLine matches "* browsers *" or CommandLine matches "* chats *" or CommandLine matches "* databases *" or CommandLine matches "* games *" or CommandLine matches "* mails *" or CommandLine matches "* maven *" or CommandLine matches "* memory *" or CommandLine matches "* multimedia *" or CommandLine matches "* php *" or CommandLine matches "* svn *" or CommandLine matches "* sysadmin *" or CommandLine matches "* unused *" or CommandLine matches "* wifi *")) and ((CommandLine matches "*-1Password*" or CommandLine matches "*-apachedirectorystudio*" or CommandLine matches "*-autologon*" or CommandLine matches "*-ChromiumBased*" or CommandLine matches "*-coreftp*" or CommandLine matches "*-credfiles*" or CommandLine matches "*-credman*" or CommandLine matches "*-cyberduck*" or CommandLine matches "*-dbvis*" or CommandLine matches "*-EyeCon*" or CommandLine matches "*-filezilla*" or CommandLine matches "*-filezillaserver*" or CommandLine matches "*-ftpnavigator*" or CommandLine matches "*-galconfusion*" or CommandLine matches "*-gitforwindows*" or CommandLine matches "*-hashdump*" or CommandLine matches "*-iisapppool*" or CommandLine matches "*-IISCentralCertP*" or CommandLine matches "*-kalypsomedia*" or CommandLine matches "*-keepass*" or CommandLine matches "*-keepassconfig*" or CommandLine matches "*-lsa_secrets*" or CommandLine matches "*-mavenrepositories*" or CommandLine matches "*-memory_dump*" or CommandLine matches "*-Mozilla*" or CommandLine matches "*-mRemoteNG*" or CommandLine matches "*-mscache*" or CommandLine matches "*-opensshforwindows*" or CommandLine matches "*-openvpn*" or CommandLine matches "*-outlook*" or CommandLine matches "*-pidgin*" or CommandLine matches "*-postgresql*" or CommandLine matches "*-psi-im*" or CommandLine matches "*-puttycm*" or CommandLine matches "*-pypykatz*" or CommandLine matches "*-Rclone*" or CommandLine matches "*-rdpmanager*" or CommandLine matches "*-robomongo*" or CommandLine matches "*-roguestale*" or CommandLine matches "*-skype*" or CommandLine matches "*-SQLDeveloper*" or CommandLine matches "*-squirrel*" or CommandLine matches "*-tortoise*" or CommandLine matches "*-turba*" or CommandLine matches "*-UCBrowser*" or CommandLine matches "*-unattended*" or CommandLine matches "*-vault*" or CommandLine matches "*-vaultfiles*" or CommandLine matches "*-vnc*" or CommandLine matches "*-winscp*"))))
