// Title: Process Creation Using Sysnative Folder
// ID: 3c1b5fb0-c72f-45ba-abd1-4d4c353144ab
// Status: test
// Level: medium
// Author: Max Altgelt (Nextron Systems)
// Date: 2022-08-23
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects process creation events that use the Sysnative folder (common for CobaltStrike spawns)
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*:\\Windows\\Sysnative\\*") or (Image matches "*:\\Windows\\Sysnative\\*")) and !(((Image matches "*C:\\Windows\\Microsoft.NET\\Framework64\\v*" or Image matches "*C:\\Windows\\Microsoft.NET\\Framework\\v*" or Image matches "*C:\\Windows\\Microsoft.NET\\FrameworkArm\\v*" or Image matches "*C:\\Windows\\Microsoft.NET\\FrameworkArm64\\v*") and Image matches "*\\ngen.exe" and CommandLine matches "*install*")) and !(((CommandLine matches "*\"C:\\Windows\\sysnative\\cmd.exe\"*" and CommandLine matches "*\\xampp\\*" and CommandLine matches "*\\catalina_start.bat*"))))
