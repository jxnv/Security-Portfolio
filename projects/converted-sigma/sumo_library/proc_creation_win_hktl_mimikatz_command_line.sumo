// Title: HackTool - Mimikatz Execution
// ID: a642964e-bead-4bed-8910-1bb4d63e3b4d
// Status: test
// Level: high
// Author: Teymur Kheirkhabarov, oscd.community, David ANDRE (additional keywords), Tim Shelton
// Date: 2019-10-22
// Tags: attack.credential-access, attack.t1003.001, attack.t1003.002, attack.t1003.004, attack.t1003.005, attack.t1003.006
// Description: Detection well-known mimikatz command line arguments
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*::aadcookie*" or CommandLine matches "*::detours*" or CommandLine matches "*::memssp*" or CommandLine matches "*::mflt*" or CommandLine matches "*::ncroutemon*" or CommandLine matches "*::ngcsign*" or CommandLine matches "*::printnightmare*" or CommandLine matches "*::skeleton*" or CommandLine matches "*::preshutdown*" or CommandLine matches "*::mstsc*" or CommandLine matches "*::multirdp*")) or ((CommandLine matches "*rpc::*" or CommandLine matches "*token::*" or CommandLine matches "*crypto::*" or CommandLine matches "*dpapi::*" or CommandLine matches "*sekurlsa::*" or CommandLine matches "*kerberos::*" or CommandLine matches "*lsadump::*" or CommandLine matches "*privilege::*" or CommandLine matches "*process::*" or CommandLine matches "*vault::*")) or ((CommandLine matches "*DumpCreds*" or CommandLine matches "*mimikatz*")))
