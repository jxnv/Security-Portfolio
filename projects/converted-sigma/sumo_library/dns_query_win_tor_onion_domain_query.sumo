// Title: DNS Query Tor .Onion Address - Sysmon
// ID: b55ca2a3-7cff-4dda-8bdd-c7bfa63bf544
// Status: test
// Level: high
// Author: frack113
// Date: 2022-02-20
// Tags: attack.command-and-control, attack.t1090.003
// Description: Detects DNS queries to an ".onion" address related to Tor routing networks
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((QueryName matches "*.hiddenservice.net" or QueryName matches "*.onion.ca" or QueryName matches "*.onion.cab" or QueryName matches "*.onion.casa" or QueryName matches "*.onion.city" or QueryName matches "*.onion.direct" or QueryName matches "*.onion.dog" or QueryName matches "*.onion.glass" or QueryName matches "*.onion.gq" or QueryName matches "*.onion.ink" or QueryName matches "*.onion.it" or QueryName matches "*.onion.link" or QueryName matches "*.onion.lt" or QueryName matches "*.onion.lu" or QueryName matches "*.onion.nu" or QueryName matches "*.onion.pet" or QueryName matches "*.onion.plus" or QueryName matches "*.onion.rip" or QueryName matches "*.onion.sh" or QueryName matches "*.onion.to" or QueryName matches "*.onion.top" or QueryName matches "*.onion" or QueryName matches "*.s1.tor-gateways.de" or QueryName matches "*.s2.tor-gateways.de" or QueryName matches "*.s3.tor-gateways.de" or QueryName matches "*.s4.tor-gateways.de" or QueryName matches "*.s5.tor-gateways.de" or QueryName matches "*.t2w.pw" or QueryName matches "*.tor2web.ae.org" or QueryName matches "*.tor2web.blutmagie.de" or QueryName matches "*.tor2web.com" or QueryName matches "*.tor2web.fi" or QueryName matches "*.tor2web.io" or QueryName matches "*.tor2web.org" or QueryName matches "*.tor2web.xyz" or QueryName matches "*.torlink.co"))
