rShellUdp*" or ScriptBlockText matches "*Invoke-Prasadhak*" or ScriptBlockText matches "*Invoke-PSGcat*" or ScriptBlockText matches "*Invoke-PsGcatAgent*" or ScriptBlockText matches "*Invoke-SessionGopher*" or ScriptBlockText matches "*Invoke-SSIDExfil*" or ScriptBlockText matches "*LoggedKeys*" or ScriptBlockText matches "*Nishang*" or ScriptBlockText matches "*NotAllNameSpaces*" or ScriptBlockText matches "*Out-CHM*" or ScriptBlockText matches "*OUT-DNSTXT*" or ScriptBlockText matches "*Out-HTA*" or ScriptBlockText matches "*Out-RundllCommand*" or ScriptBlockText matches "*Out-SCF*" or ScriptBlockText matches "*Out-SCT*" or ScriptBlockText matches "*Out-Shortcut*" or ScriptBlockText matches "*Out-WebQuery*" or ScriptBlockText matches "*Out-Word*" or ScriptBlockText matches "*Parse_Keys*" or ScriptBlockText matches "*Password-List*" or ScriptBlockText matches "*Powerpreter*" or ScriptBlockText matches "*Remove-Persistence*" or ScriptBlockText matches "*Remove-PoshRat*" or ScriptBlockText matches "*Remove-Update*" or ScriptBlockText matches "*Run-EXEonRemote*" or ScriptBlockText matches "*Set-DCShadowPermissions*" or ScriptBlockText matches "*Set-RemotePSRemoting*" or ScriptBlockText matches "*Set-RemoteWMI*" or ScriptBlockText matches "*Shellcode32*" or ScriptBlockText matches "*Shellcode64*" or ScriptBlockText matches "*StringtoBase64*" or ScriptBlockText matches "*TexttoExe*"))
