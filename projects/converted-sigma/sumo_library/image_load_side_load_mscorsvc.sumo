// Level: medium
// Author: Wietze Beukema
// Date: 2024-07-11
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of "mscorsvc.dll".
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((ImageLoaded matches "*\\mscorsvc.dll") and !(((ImageLoaded matches "C:\\Windows\\Microsoft.NET\\Framework\\*" or ImageLoaded matches "C:\\Windows\\Microsoft.NET\\Framework64\\*" or ImageLoaded matches "C:\\Windows\\Microsoft.NET\\FrameworkArm\\*" or ImageLoaded matches "C:\\Windows\\Microsoft.NET\\FrameworkArm64\\*" or ImageLoaded matches "C:\\Windows\\WinSxS\\*"))))
