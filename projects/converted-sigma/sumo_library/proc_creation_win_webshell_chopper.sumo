// Title: Chopper Webshell Process Pattern
// ID: fa3c117a-bc0d-416e-a31b-0c0e80653efb
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), MSTI (query)
// Date: 2022-10-01
// Tags: attack.persistence, attack.discovery, attack.t1505.003, attack.t1018, attack.t1033, attack.t1087
// Description: Detects patterns found in process executions cause by China Chopper like tiny (ASPX) webshells
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*&ipconfig&echo*" or CommandLine matches "*&quser&echo*" or CommandLine matches "*&whoami&echo*" or CommandLine matches "*&c:&echo*" or CommandLine matches "*&cd&echo*" or CommandLine matches "*&dir&echo*" or CommandLine matches "*&echo [E]*" or CommandLine matches "*&echo [S]*")) and ((Image matches "*\\w3wp.exe") or (ParentImage matches "*\\w3wp.exe")))
