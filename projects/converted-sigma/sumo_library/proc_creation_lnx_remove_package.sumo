// Title: Linux Package Uninstall
// ID: 95d61234-7f56-465c-6f2d-b562c6fedbc4
// Status: test
// Level: low
// Author: Tuan Le (NCSGroup), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-03-09
// Tags: attack.stealth, attack.t1070
// Description: Detects linux package removal using builtin tools such as "yum", "apt", "apt-get" or "dpkg".
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*/apt" or Image matches "*/apt-get") and (CommandLine matches "*remove*" or CommandLine matches "*purge*")) or (Image matches "*/dpkg" and (CommandLine matches "*--remove *" or CommandLine matches "* -r *")) or (Image matches "*/rpm" and CommandLine matches "* -e *") or (Image matches "*/yum" and (CommandLine matches "*erase*" or CommandLine matches "*remove*")))
