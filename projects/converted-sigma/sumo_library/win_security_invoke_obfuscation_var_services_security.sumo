// Title: Invoke-Obfuscation VAR+ Launcher - Security
// ID: dcf2db1f-f091-425b-a821-c05875b8925a
// Status: test
// Level: high
// Author: Jonathan Cheong, oscd.community
// Date: 2020-10-15
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated use of Environment Variables to execute PowerShell
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (EventID = "4697" and (ServiceFileName matches "*cmd*" and ServiceFileName matches "*\"set*" and ServiceFileName matches "*-f*") and (ServiceFileName matches "*/c*" or ServiceFileName matches "*/r*"))
