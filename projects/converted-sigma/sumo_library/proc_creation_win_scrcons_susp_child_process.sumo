// Title: Script Event Consumer Spawning Process
// ID: f6d1dd2f-b8ce-40ca-bc23-062efb686b34
// Status: test
// Level: high
// Author: Sittikorn S
// Date: 2021-06-21
// Tags: attack.execution, attack.t1047
// Description: Detects a suspicious child process of Script Event Consumer (scrcons.exe).
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (ParentImage matches "*\\scrcons.exe" and (Image matches "*\\svchost.exe" or Image matches "*\\dllhost.exe" or Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\wscript.exe" or Image matches "*\\cscript.exe" or Image matches "*\\schtasks.exe" or Image matches "*\\regsvr32.exe" or Image matches "*\\mshta.exe" or Image matches "*\\rundll32.exe" or Image matches "*\\msiexec.exe" or Image matches "*\\msbuild.exe"))
