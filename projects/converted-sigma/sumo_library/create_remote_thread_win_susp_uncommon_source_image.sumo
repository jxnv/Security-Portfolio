// Title: Remote Thread Creation By Uncommon Source Image
// ID: 66d31e5f-52d6-40a4-9615-002d3789a119
// Status: test
// Level: medium
// Author: Perez Diego (@darkquassar), oscd.community
// Date: 2019-10-27
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects uncommon processes creating remote threads.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((SourceImage matches "*\\explorer.exe" or SourceImage matches "*\\iexplore.exe" or SourceImage matches "*\\msiexec.exe" or SourceImage matches "*\\powerpnt.exe" or SourceImage matches "*\\schtasks.exe" or SourceImage matches "*\\winlogon.exe")) and !(((TargetImage = "") or (SourceImage = "C:\\Windows\\explorer.exe" and (TargetImage matches "C:\\Program Files (x86)\\*" or TargetImage matches "C:\\Program Files\\*" or TargetImage matches "C:\\Windows\\System32\\*" or TargetImage matches "C:\\Windows\\SysWOW64\\*")) or (SourceImage = "C:\\Program Files\\Internet Explorer\\iexplore.exe" and (TargetImage = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or TargetImage = "C:\\Windows\\System32\\rundll32.exe")) or (SourceImage matches "*\\msiexec.exe" and (TargetImage matches "*\\AppData\\Local\\*" or TargetImage matches "*C:\\Program Files (x86)\\*" or TargetImage matches "*C:\\Program Files\\*" or TargetImage matches "*C:\\Windows\\Microsoft.NET\\Framework64\\*")) or (SourceImage matches "*\\msiexec.exe" and (TargetImage = "C:\\Windows\\System32\\msiexec.exe" or TargetImage = "C:\\Windows\\SysWOW64\\msiexec.exe")) or (isNull(TargetImage)) or (SourceImage matches "*\\POWERPNT.EXE" and (TargetImage matches "*C:\\Program Files\\Microsoft Office\\*" or TargetImage matches "*C:\\Program Files (x86)\\Microsoft Office\\*")) or ((SourceImage = "C:\\Windows\\System32\\schtasks.exe" or SourceImage = "C:\\Windows\\SysWOW64\\schtasks.exe") and TargetImage = "C:\\Windows\\System32\\conhost.exe") or (TargetImage = "System") or (SourceImage = "C:\\Windows\\System32\\winlogon.exe" and (TargetImage = "C:\\Windows\\System32\\services.exe" or TargetImage = "C:\\Windows\\System32\\wininit.exe" or TargetImage = "C:\\Windows\\System32\\csrss.exe" or TargetImage = "C:\\Windows\\System32\\LogonUI.exe" or TargetImage = "C:\\Windows\\System32\\wlrmdr.exe" or TargetImage = "C:\\Windows\\System32\\AtBroker.exe" or TargetImage = "C:\\Windows\\System32\\dwm.exe" or TargetImage = "C:\\Windows\\System32\\fontdrvhost.exe" or TargetImage = "C:\\Windows\\System32\\userinit.exe")) or (SourceImage = "C:\\Windows\\System32\\winlogon.exe" and TargetParentProcessId = "4"))) and !(((SourceImage = "C:\\Windows\\explorer.exe" and TargetImage matches "*\\aurora-dashboard.exe") or (SourceImage = "C:\\Program Files\\internet explorer\\iexplore.exe" and (SourceCommandLine matches "*https://*" and SourceCommandLine matches "*.checkpoint.com/documents/*" and SourceCommandLine matches "*SmartConsole_OLH/*" and SourceCommandLine matches "*default.htm#cshid=*")) or (SourceImage = "C:\\Program Files\\internet explorer\\iexplore.exe" and (SourceParentImage matches "C:\\Program Files\\*" or SourceParentImage matches "C:\\Program Files (x86)\\*") and (SourceParentImage matches "*\\CheckPoint\\SmartConsole\\*" and SourceParentImage matches "*\\SmartConsole.exe*")) or (SourceImage = "C:\\Windows\\explorer.exe" and TargetImage matches "*\\OfficeSetup.exe") or (SourceImage = "C:\\Windows\\explorer.exe" and TargetImage matches "*\\AppData\\Local\\Microsoft\\OneDrive\\OneDrive.exe") or (SourceImage matches "*\\Microsoft Office\\*" and SourceImage matches "*\\POWERPNT.EXE" and TargetImage = "C:\\Windows\\System32\\csrss.exe"))))
