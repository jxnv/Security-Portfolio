// Title: Suspicious Service Installation Script
// ID: 70f00d10-60b2-4f34-b9a0-dc3df3fe762a
// Status: test
// Level: high
// Author: pH-T (Nextron Systems)
// Date: 2022-03-18
// Tags: attack.persistence, attack.privilege-escalation, car.2013-09-005, attack.t1543.003
// Description: Detects suspicious service installation scripts
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((ImagePath matches "*cscript*" or ImagePath matches "*mshta*" or ImagePath matches "*powershell*" or ImagePath matches "*pwsh*" or ImagePath matches "*regsvr32*" or ImagePath matches "*rundll32*" or ImagePath matches "*wscript*")) and ((ImagePath matches "* -c *" or ImagePath matches "* -r *" or ImagePath matches "* -k *")) and (Provider_Name = "Service Control Manager" and EventID = "7045"))
