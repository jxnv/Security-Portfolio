// Title: HackTool - Inveigh Execution
// ID: b99a1518-1ad5-4f65-bc95-1ffff97a8fd0
// Status: test
// Level: critical
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-24
// Tags: attack.credential-access, attack.t1003.001
// Description: Detects the use of Inveigh a cross-platform .NET IPv4/IPv6 machine-in-the-middle tool
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\Inveigh.exe") or ((OriginalFileName = "\\Inveigh.exe" or OriginalFileName = "\\Inveigh.dll")) or (Description = "Inveigh") or ((CommandLine matches "* -SpooferIP*" or CommandLine matches "* -ReplyToIPs *" or CommandLine matches "* -ReplyToDomains *" or CommandLine matches "* -ReplyToMACs *" or CommandLine matches "* -SnifferIP*")))
