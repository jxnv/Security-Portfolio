// Title: Suspicious Workstation Locking via Rundll32
// ID: 3b5b0213-0460-4e3f-8937-3abf98ff7dcc
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-06-04
// Tags: attack.stealth
// Description: Detects a suspicious call to the user32.dll function that locks the user workstation
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((CommandLine matches "*user32.dll,*") and ((Image matches "*\\rundll32.exe") or (OriginalFileName = "RUNDLL32.EXE")) and (ParentImage matches "*\\cmd.exe") and (CommandLine matches "*LockWorkStation*"))
