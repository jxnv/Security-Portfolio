// Title: Potential SMB Relay Attack Tool Execution
// ID: 5589ab4f-a767-433c-961d-c91f3f704db1
// Status: test
// Level: critical
// Author: Florian Roth (Nextron Systems)
// Date: 2021-07-24
// Tags: attack.collection, attack.execution, attack.credential-access, attack.t1557.001
// Description: Detects different hacktools used for relay attacks on Windows for privilege escalation
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*.exe -c \"{*" and CommandLine matches "*}\" -z") or ((Image matches "*PetitPotam*" or Image matches "*RottenPotato*" or Image matches "*HotPotato*" or Image matches "*JuicyPotato*" or Image matches "*\\just_dce_*" or Image matches "*Juicy Potato*" or Image matches "*\\temp\\rot.exe*" or Image matches "*\\Potato.exe*" or Image matches "*\\SpoolSample.exe*" or Image matches "*\\Responder.exe*" or Image matches "*\\smbrelayx*" or Image matches "*\\ntlmrelayx*" or Image matches "*\\LocalPotato*")) or ((CommandLine matches "*Invoke-Tater*" or CommandLine matches "* smbrelay*" or CommandLine matches "* ntlmrelay*" or CommandLine matches "*cme smb *" or CommandLine matches "* /ntlm:NTLMhash *" or CommandLine matches "*Invoke-PetitPotam*" or CommandLine matches "*.exe -t * -p *"))) and !(((Image matches "*HotPotatoes6*" or Image matches "*HotPotatoes7*" or Image matches "*HotPotatoes *"))))
