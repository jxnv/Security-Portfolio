// Title: Potentially Suspicious Desktop Background Change Using Reg.EXE
// ID: 8cbc9475-8d05-4e27-9c32-df960716c701
// Status: test
// Level: medium
// Author: Stephen Lincoln @slincoln-aiq (AttackIQ)
// Date: 2023-12-21
// Tags: attack.persistence, attack.impact, attack.defense-impairment, attack.t1112, attack.t1491.001
// Description: Detects the execution of "reg.exe" to alter registry keys that would replace the user's desktop background.
// This is a common technique used by malware to change the desktop background to a ransom note or other image.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*add*") and ((Image matches "*\\reg.exe") or (OriginalFileName = "reg.exe"))) and ((CommandLine matches "*Control Panel\\Desktop*" or CommandLine matches "*CurrentVersion\\Policies\\ActiveDesktop*" or CommandLine matches "*CurrentVersion\\Policies\\System*")) and (((CommandLine matches "*/v NoChangingWallpaper*" and CommandLine matches "*/d 1*")) or ((CommandLine matches "*/v Wallpaper*" and CommandLine matches "*/t REG_SZ*")) or ((CommandLine matches "*/v WallpaperStyle*" and CommandLine matches "*/d 2*"))))
