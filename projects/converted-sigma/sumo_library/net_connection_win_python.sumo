// Title: Python Initiated Connection
// ID: bef0bc5a-b9ae-425d-85c6-7b2d705980c6
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-12-10
// Tags: attack.discovery, attack.t1046
// Description: Detects a Python process initiating a network connection. While this often relates to package installation, it can also indicate a potential malicious script communicating with a C&C server.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Initiated = "true" and (Image matches "*\\python*" and Image matches "*.exe*")) and !(((DestinationIp = "127.0.0.1" and SourceIp = "127.0.0.1") or ((CommandLine matches "*pip.exe*" and CommandLine matches "*install*")))) and !(((ParentImage = "C:\\ProgramData\\Anaconda3\\Scripts\\conda.exe" and (CommandLine matches "*:\\ProgramData\\Anaconda3\\Scripts\\conda-script.py*" and CommandLine matches "*update*")) or (ParentImage = "C:\\ProgramData\\Anaconda3\\python.exe" and CommandLine matches "*C:\\ProgramData\\Anaconda3\\Scripts\\jupyter-notebook-script.py*"))))
