// Title: System Network Discovery - Linux
// ID: e7bd1cfa-b446-4c88-8afb-403bcd79e3fa
// Status: test
// Level: informational
// Author: Ömer Günal and remotephone, oscd.community
// Date: 2020-10-06
// Tags: attack.discovery, attack.t1016
// Description: Detects enumeration of local network configuration
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((CommandLine matches "*/etc/resolv.conf*") or ((Image matches "*/firewall-cmd" or Image matches "*/ufw" or Image matches "*/iptables" or Image matches "*/netstat" or Image matches "*/ss" or Image matches "*/ip" or Image matches "*/ifconfig" or Image matches "*/systemd-resolve" or Image matches "*/route")))
