// Title: LSASS Process Reconnaissance Via Findstr.EXE
// ID: fe63010f-8823-4864-a96b-a7b4a0f7b929
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-08-12
// Tags: attack.credential-access, attack.t1552.006
// Description: Detects findstring commands that include the keyword lsass, which indicates recon actviity for the LSASS process PID
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*lsass*") and (((Image matches "*\\find.exe" or Image matches "*\\findstr.exe")) or ((OriginalFileName = "FIND.EXE" or OriginalFileName = "FINDSTR.EXE")))) or ((CommandLine matches "* /i \"lsass*" or CommandLine matches "* /i lsass.exe*" or CommandLine matches "*findstr \"lsass*" or CommandLine matches "*findstr lsass*" or CommandLine matches "*findstr.exe \"lsass*" or CommandLine matches "*findstr.exe lsass*")))
