// Title: Suspicious Powercfg Execution To Change Lock Screen Timeout
// ID: f8d6a15e-4bc8-4c27-8e5d-2b10f0b73e5b
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-11-18
// Tags: attack.stealth
// Description: Detects suspicious execution of 'Powercfg.exe' to change lock screen timeout
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*\\powercfg.exe") or (OriginalFileName = "PowerCfg.exe")) and (((CommandLine matches "*/setacvalueindex *" and CommandLine matches "*SCHEME_CURRENT*" and CommandLine matches "*SUB_VIDEO*" and CommandLine matches "*VIDEOCONLOCK*")) or ((CommandLine matches "*-change *" and CommandLine matches "*-standby-timeout-*"))))
