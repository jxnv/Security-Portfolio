// Title: Import PowerShell Modules From Suspicious Directories - ProcCreation
// ID: c31364f7-8be6-4b77-8483-dd2b5a7b69a3
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-10
// Tags: attack.execution, attack.t1059.001
// Description: Detects powershell scripts that import modules from suspicious directories
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((CommandLine matches "*Import-Module \"$Env:Temp\\*" or CommandLine matches "*Import-Module '$Env:Temp\\*" or CommandLine matches "*Import-Module $Env:Temp\\*" or CommandLine matches "*Import-Module \"$Env:Appdata\\*" or CommandLine matches "*Import-Module '$Env:Appdata\\*" or CommandLine matches "*Import-Module $Env:Appdata\\*" or CommandLine matches "*Import-Module C:\\Users\\Public\\*" or CommandLine matches "*ipmo \"$Env:Temp\\*" or CommandLine matches "*ipmo '$Env:Temp\\*" or CommandLine matches "*ipmo $Env:Temp\\*" or CommandLine matches "*ipmo \"$Env:Appdata\\*" or CommandLine matches "*ipmo '$Env:Appdata\\*" or CommandLine matches "*ipmo $Env:Appdata\\*" or CommandLine matches "*ipmo C:\\Users\\Public\\*"))
