// Title: Potential Persistence Using DebugPath
// ID: df4dc653-1029-47ba-8231-3c44238cc0ae
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-07-27
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.015
// Description: Detects potential persistence using Appx DebugPath
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((TargetObject matches "*Classes\\ActivatableClasses\\Package\\Microsoft.*" and TargetObject matches "*\\DebugPath") or (TargetObject matches "*\\Software\\Microsoft\\Windows\\CurrentVersion\\PackagedAppXDebug\\Microsoft.*" and TargetObject matches "*\\(Default)"))
