// Title: Potential Persistence Via App Paths Default Property
// ID: 707e097c-e20f-4f67-8807-1f72ff4500d6
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-10
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.012
// Description: Detects changes to the "Default" property for keys located in the \Software\Microsoft\Windows\CurrentVersion\App Paths\ registry. Which might be used as a method of persistence
// The entries found under App Paths are used primarily for the following purposes.
// First, to map an application's executable file name to that file's fully qualified path.
// Second, to prepend information to the PATH environment variable on a per-application, per-process basis.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (TargetObject matches "*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths*" and (TargetObject matches "*(Default)" or TargetObject matches "*Path") and (Details matches "*\\Users\\Public*" or Details matches "*\\AppData\\Local\\Temp\\*" or Details matches "*\\Windows\\Temp\\*" or Details matches "*\\Desktop\\*" or Details matches "*\\Downloads\\*" or Details matches "*%temp%*" or Details matches "*%tmp%*" or Details matches "*iex*" or Details matches "*Invoke-*" or Details matches "*rundll32*" or Details matches "*regsvr32*" or Details matches "*mshta*" or Details matches "*cscript*" or Details matches "*wscript*" or Details matches "*.bat*" or Details matches "*.hta*" or Details matches "*.dll*" or Details matches "*.ps1*"))
