// Title: Suspicious File Access to Browser Credential Storage
// ID: a1dfd976-4852-41d4-9507-dc6590a3ccd0
// Status: experimental
// Level: low
// Author: frack113, X__Junior (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems), Parth-FourCore
// Date: 2025-05-22
// Tags: attack.credential-access, attack.t1555.003, attack.discovery, attack.t1217
// Description: Detects file access to browser credential storage paths by non-browser processes, which may indicate credential access attempts.
// Adversaries may attempt to access browser credential storage to extract sensitive information such as usernames and passwords or cookies.
// This behavior is often commonly observed in credential stealing malware.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((FileName matches "*\\Sputnik\\Sputnik*" or FileName matches "*\\MapleStudio\\ChromePlus*" or FileName matches "*\\QIP Surf*" or FileName matches "*\\BlackHawk*" or FileName matches "*\\7Star\\7Star*" or FileName matches "*\\CatalinaGroup\\Citrio*" or FileName matches "*\\Google\\Chrome*" or FileName matches "*\\Coowon\\Coowon*" or FileName matches "*\\CocCoc\\Browser*" or FileName matches "*\\uCozMedia\\Uran*" or FileName matches "*\\Tencent\\QQBrowser*" or FileName matches "*\\Orbitum*" or FileName matches "*\\Slimjet*" or FileName matches "*\\Iridium*" or FileName matches "*\\Vivaldi*" or FileName matches "*\\Chromium*" or FileName matches "*\\GhostBrowser*" or FileName matches "*\\CentBrowser*" or FileName matches "*\\Xvast*" or FileName matches "*\\Chedot*" or FileName matches "*\\SuperBird*" or FileName matches "*\\360Browser\\Browser*" or FileName matches "*\\360Chrome\\Chrome*" or FileName matches "*\\Comodo\\Dragon*" or FileName matches "*\\BraveSoftware\\Brave-Browser*" or FileName matches "*\\Torch*" or FileName matches "*\\UCBrowser\\*" or FileName matches "*\\Blisk*" or FileName matches "*\\Epic Privacy Browser*" or FileName matches "*\\Nichrome*" or FileName matches "*\\Amigo*" or FileName matches "*\\Kometa*" or FileName matches "*\\Xpom*" or FileName matches "*\\Microsoft\\Edge*" or FileName matches "*\\Liebao7Default\\EncryptedStorage*" or FileName matches "*\\AVAST Software\\Browser*" or FileName matches "*\\Kinza*" or FileName matches "*\\Mozilla\\SeaMonkey\\*" or FileName matches "*\\Comodo\\IceDragon\\*" or FileName matches "*\\8pecxstudios\\Cyberfox\\*" or FileName matches "*\\FlashPeak\\SlimBrowser\\*" or FileName matches "*\\Moonchild Productions\\Pale Moon\\*")) and ((FileName matches "*\\Profiles\\*" or FileName matches "*\\User Data*")) and (((FileName matches "*\\Login Data*" or FileName matches "*\\Cookies*" or FileName matches "*\\EncryptedStorage*" or FileName matches "*\\WebCache\\*")) or ((FileName matches "*cert9.db" or FileName matches "*cookies.sqlite" or FileName matches "*formhistory.sqlite" or FileName matches "*key3.db" or FileName matches "*key4.db" or FileName matches "*Login Data.sqlite" or FileName matches "*logins.json" or FileName matches "*places.sqlite")))) and !((((Image matches "C:\\Program Files\\*" or Image matches "C:\\Program Files (x86)\\*" or Image matches "C:\\Windows\\System32\\*" or Image matches "C:\\Windows\\SysWOW64\\*")) or ((Image matches "*\\Sputnik.exe" or Image matches "*\\ChromePlus.exe" or Image matches "*\\QIP Surf.exe" or Image matches "*\\BlackHawk.exe" or Image matches "*\\7Star.exe" or Image matches "*\\Sleipnir5.exe" or Image matches "*\\Citrio.exe" or Image matches "*\\Chrome SxS.exe" or Image matches "*\\Chrome.exe" or Image matches "*\\Coowon.exe" or Image matches "*\\CocCocBrowser.exe" or Image matches "*\\Uran.exe" or Image matches "*\\QQBrowser.exe" or Image matches "*\\Orbitum.exe" or Image matches "*\\Slimjet.exe" or Image matches "*\\Iridium.exe" or Image matches "*\\Vivaldi.exe" or Image matches "*\\Chromium.exe" or Image matches "*\\GhostBrowser.exe" or Image matches "*\\CentBrowser.exe" or Image matches "*\\Xvast.exe" or Image matches "*\\Chedot.exe" or Image matches "*\\SuperBird.exe" or Image matches "*\\360Browser.exe" or Image matches "*\\360Chrome.exe" or Image matches "*\\dragon.exe" or Image matches "*\\brave.exe" or Image matches "*\\torch.exe" or Image matches "*\\UCBrowser.exe" or Image matches "*\\BliskBrowser.exe" or Image matches "*\\Epic Privacy Browser.exe" or Image matches "*\\nichrome.exe" or Image matches "*\\AmigoBrowser.exe" or Image matches "*\\KometaBrowser.exe" or Image matches "*\\XpomBrowser.exe" or Image matches "*\\msedge.exe" or Image matches "*\\LiebaoBrowser.exe" or Image matches "*\\AvastBrowser.exe" or Image matches "*\\Kinza.exe" or Image matches "*\\seamonkey.exe" or Image matches "*\\icedragon.exe" or Image matches "*\\cyberfox.exe" or Image matches "*\\SlimBrowser.exe" or Image matches "*\\palemoon.exe")) or ((Image matches "*\\Sputnik\\*" or Image matches "*\\MapleStudio\\*" or Image matches "*\\QIP Surf\\*" or Image matches "*\\BlackHawk\\*" or Image matches "*\\7Star\\*" or Image matches "*\\Fenrir Inc\\*" or Image matches "*\\CatalinaGroup\\*" or Image matches "*\\Google\\*" or Image matches "*\\Coowon\\*" or Image matches "*\\CocCoc\\*" or Image matches "*\\uCozMedia\\*" or Image matches "*\\Tencent\\*" or Image matches "*\\Orbitum\\*" or Image matches "*\\Slimjet\\*" or Image matches "*\\Iridium\\*" or Image matches "*\\Vivaldi\\*" or Image matches "*\\Chromium\\*" or Image matches "*\\GhostBrowser\\*" or Image matches "*\\CentBrowser\\*" or Image matches "*\\Xvast\\*" or Image matches "*\\Chedot\\*" or Image matches "*\\SuperBird\\*" or Image matches "*\\360Browser\\*" or Image matches "*\\360Chrome\\*" or Image matches "*\\Comodo\\*" or Image matches "*\\BraveSoftware\\*" or Image matches "*\\Torch\\*" or Image matches "*\\UCBrowser\\*" or Image matches "*\\Blisk\\*" or Image matches "*\\Epic Privacy Browser\\*" or Image matches "*\\Nichrome\\*" or Image matches "*\\Amigo\\*" or Image matches "*\\Kometa\\*" or Image matches "*\\Xpom\\*" or Image matches "*\\Microsoft\\*" or Image matches "*\\Liebao7\\*" or Image matches "*\\AVAST Software\\*" or Image matches "*\\Kinza\\*" or Image matches "*\\Mozilla\\*" or Image matches "*\\8pecxstudios\\*" or Image matches "*\\FlashPeak\\*" or Image matches "*\\Moonchild Productions\\*")) or (Image = "System" and ParentImage = "Idle"))) and !(((Image matches "*\\Microsoft\\Windows Defender\\*" and (Image matches "*\\MpCopyAccelerator.exe" or Image matches "*\\MsMpEng.exe")) or (ParentImage = "C:\\Windows\\System32\\msiexec.exe") or (Image matches "*\\everything.exe") or ((Image matches "*\\thor.exe" or Image matches "*\\thor64.exe")))))
