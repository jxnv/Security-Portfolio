// Title: Potentially Suspicious Child Process Of ClickOnce Application
// ID: 67bc0e75-c0a9-4cfc-8754-84a505b63c04
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-12
// Tags: attack.execution, attack.stealth
// Description: Detects potentially suspicious child processes of a ClickOnce deployment application
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (ParentImage matches "*\\AppData\\Local\\Apps\\2.0\\*" and (Image matches "*\\calc.exe" or Image matches "*\\cmd.exe" or Image matches "*\\cscript.exe" or Image matches "*\\explorer.exe" or Image matches "*\\mshta.exe" or Image matches "*\\net.exe" or Image matches "*\\net1.exe" or Image matches "*\\nltest.exe" or Image matches "*\\notepad.exe" or Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\reg.exe" or Image matches "*\\regsvr32.exe" or Image matches "*\\rundll32.exe" or Image matches "*\\schtasks.exe" or Image matches "*\\werfault.exe" or Image matches "*\\wscript.exe"))
