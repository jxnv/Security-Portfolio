// Title: Uncommon New Firewall Rule Added In Windows Firewall Exception List
// ID: cde0a575-7d3d-4a49-9817-b8004a7bf105
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-02-19
// Tags: attack.defense-impairment, attack.t1686.003
// Description: Detects when a rule has been added to the Windows Firewall exception list
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((EventID = "2004" or EventID = "2071" or EventID = "2097")) and !(((Action = "2") or ((ApplicationPath matches "*C:\\PerfLogs\\*" or ApplicationPath matches "*C:\\Temp\\*" or ApplicationPath matches "*C:\\Tmp\\*" or ApplicationPath matches "*C:\\Users\\Public\\*" or ApplicationPath matches "*C:\\Windows\\Tasks\\*" or ApplicationPath matches "*C:\\Windows\\Temp\\*" or ApplicationPath matches "*\\AppData\\Local\\Temp\\*")) or (ApplicationPath matches "C:\\Windows\\ehome\\*" and ModifyingApplication = "C:\\Windows\\System32\\oobe\\Setup.exe") or ((ApplicationPath matches "C:\\Program Files (x86)\\*" or ApplicationPath matches "C:\\Program Files\\*" or ApplicationPath matches "C:\\Windows\\System32\\*" or ApplicationPath matches "C:\\Windows\\SysWOW64\\*" or ApplicationPath matches "C:\\Windows\\WinSxS\\*")) or (isNull(ApplicationPath)) or (ApplicationPath = "SYSTEM" and (ModifyingApplication = "C:\\Windows\\System32\\dllhost.exe" or ModifyingApplication = "C:\\Windows\\System32\\oobe\\Setup.exe" or ModifyingApplication = "C:\\Windows\\System32\\svchost.exe")) or (ModifyingApplication matches "C:\\Windows\\WinSxS\\*" and ModifyingApplication matches "*\\TiWorker.exe"))) and !(((((ModifyingApplication matches "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*" or ModifyingApplication matches "C:\\Program Files\\Windows Defender\\*") and ModifyingApplication matches "*\\MsMpEng.exe") or ((ApplicationPath matches "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*" or ApplicationPath matches "C:\\Program Files\\Windows Defender\\*") and ApplicationPath matches "*\\MsMpEng.exe")) or ((ModifyingApplication = "C:\\Windows\\System32\\svchost.exe" or ModifyingApplication = "C:\\Windows\\System32\\dllhost.exe") and ApplicationPath = "") or (ApplicationPath matches "C:\\Windows\\SystemApps\\*" and ModifyingApplication = "C:\\Windows\\System32\\svchost.exe"))))
