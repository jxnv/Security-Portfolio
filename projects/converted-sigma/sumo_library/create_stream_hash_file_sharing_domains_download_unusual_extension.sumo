// Title: Unusual File Download From File Sharing Websites - File Stream
// ID: ae02ed70-11aa-4a22-b397-c0d0e8f6ea99
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-08-24
// Tags: attack.stealth, attack.s0139, attack.t1564.004
// Description: Detects the download of suspicious file type from a well-known file and paste sharing domain
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Contents matches "*.githubusercontent.com*" or Contents matches "*0x0.st*" or Contents matches "*anonfiles.com*" or Contents matches "*bashupload.com*" or Contents matches "*cdn.discordapp.com*" or Contents matches "*chunk.io*" or Contents matches "*ddns.net*" or Contents matches "*dl.dropboxusercontent.com*" or Contents matches "*ghostbin.co*" or Contents matches "*github.com*" or Contents matches "*glitch.me*" or Contents matches "*gofile.io*" or Contents matches "*hastebin.com*" or Contents matches "*mediafire.com*" or Contents matches "*mega.nz*" or Contents matches "*onrender.com*" or Contents matches "*pages.dev*" or Contents matches "*paste.ee*" or Contents matches "*pastebin.com*" or Contents matches "*pastebin.pl*" or Contents matches "*pastetext.net*" or Contents matches "*pixeldrain.com*" or Contents matches "*privatlab.com*" or Contents matches "*privatlab.net*" or Contents matches "*send.exploit.in*" or Contents matches "*sendspace.com*" or Contents matches "*storage.googleapis.com*" or Contents matches "*storjshare.io*" or Contents matches "*supabase.co*" or Contents matches "*temp.sh*" or Contents matches "*transfer.sh*" or Contents matches "*trycloudflare.com*" or Contents matches "*ufile.io*" or Contents matches "*w3spaces.com*" or Contents matches "*workers.dev*" or Contents matches "*x0.at*")) and ((TargetFilename matches "*.bat:Zone*" or TargetFilename matches "*.cmd:Zone*" or TargetFilename matches "*.ps1:Zone*")))
