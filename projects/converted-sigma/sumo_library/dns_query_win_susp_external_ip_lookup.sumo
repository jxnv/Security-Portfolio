// Title: Suspicious DNS Query for IP Lookup Service APIs
// ID: ec82e2a5-81ea-4211-a1f8-37a0286df2c2
// Status: test
// Level: medium
// Author: Brandon George (blog post), Thomas Patzke
// Date: 2021-07-08
// Tags: attack.reconnaissance, attack.t1590
// Description: Detects DNS queries for IP lookup services such as "api.ipify.org" originating from a non browser process.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((QueryName = "www.ip.cn" or QueryName = "l2.io")) or ((QueryName matches "*api.2ip.ua*" or QueryName matches "*api.bigdatacloud.net*" or QueryName matches "*api.ipify.org*" or QueryName matches "*bot.whatismyipaddress.com*" or QueryName matches "*canireachthe.net*" or QueryName matches "*checkip.amazonaws.com*" or QueryName matches "*checkip.dyndns.org*" or QueryName matches "*curlmyip.com*" or QueryName matches "*db-ip.com*" or QueryName matches "*edns.ip-api.com*" or QueryName matches "*eth0.me*" or QueryName matches "*freegeoip.app*" or QueryName matches "*geoipy.com*" or QueryName matches "*getip.pro*" or QueryName matches "*icanhazip.com*" or QueryName matches "*ident.me*" or QueryName matches "*ifconfig.io*" or QueryName matches "*ifconfig.me*" or QueryName matches "*ip-api.com*" or QueryName matches "*ip.360.cn*" or QueryName matches "*ip.anysrc.net*" or QueryName matches "*ip.taobao.com*" or QueryName matches "*ip.tyk.nu*" or QueryName matches "*ipaddressworld.com*" or QueryName matches "*ipapi.co*" or QueryName matches "*ipconfig.io*" or QueryName matches "*ipecho.net*" or QueryName matches "*ipinfo.io*" or QueryName matches "*ipip.net*" or QueryName matches "*ipof.in*" or QueryName matches "*ipv4.icanhazip.com*" or QueryName matches "*ipv4bot.whatismyipaddress.com*" or QueryName matches "*ipv6-test.com*" or QueryName matches "*ipwho.is*" or QueryName matches "*jsonip.com*" or QueryName matches "*myexternalip.com*" or QueryName matches "*seeip.org*" or QueryName matches "*wgetip.com*" or QueryName matches "*whatismyip.akamai.com*" or QueryName matches "*whois.pconline.com.cn*" or QueryName matches "*wtfismyip.com*"))) and !(((Image matches "*\\brave.exe") or ((Image = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or Image = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or ((Image matches "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*") or (Image matches "*\\WindowsApps\\MicrosoftEdge.exe") or ((Image = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or Image = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((Image matches "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\*" or Image matches "C:\\Program Files\\Microsoft\\EdgeCore\\*") and (Image matches "*\\msedge.exe" or Image matches "*\\msedgewebview2.exe")) or ((Image = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or Image = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or ((Image = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or Image = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (Image matches "*\\maxthon.exe") or (Image matches "*\\opera.exe") or (Image matches "*\\safari.exe") or (Image matches "*\\seamonkey.exe") or (Image matches "*\\vivaldi.exe") or (Image matches "*\\whale.exe"))))
