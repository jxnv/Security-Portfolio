// Title: Invoke-Obfuscation VAR++ LAUNCHER OBFUSCATION
// ID: e9f55347-2928-4c06-88e5-1a7f8169942e
// Status: test
// Level: high
// Author: Timur Zinniatullin, oscd.community
// Date: 2020-10-13
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via VAR++ LAUNCHER
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((CommandLine matches "*&&set*" and CommandLine matches "*cmd*" and CommandLine matches "*/c*" and CommandLine matches "*-f*") and (CommandLine matches "*{0}*" or CommandLine matches "*{1}*" or CommandLine matches "*{2}*" or CommandLine matches "*{3}*" or CommandLine matches "*{4}*" or CommandLine matches "*{5}*"))
