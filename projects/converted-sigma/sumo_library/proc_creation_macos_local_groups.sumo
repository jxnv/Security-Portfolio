// Title: Local Groups Discovery - MacOs
// ID: 89bb1f97-c7b9-40e8-b52b-7d6afbd67276
// Status: test
// Level: informational
// Author: Ömer Günal, Alejandro Ortuno, oscd.community
// Date: 2020-10-11
// Tags: attack.discovery, attack.t1069.001
// Description: Detects enumeration of local system groups
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*/dscacheutil" and (CommandLine matches "*-q*" and CommandLine matches "*group*")) or (Image matches "*/cat" and CommandLine matches "*/etc/group*") or (Image matches "*/dscl" and (CommandLine matches "*-list*" and CommandLine matches "*/groups*")))
