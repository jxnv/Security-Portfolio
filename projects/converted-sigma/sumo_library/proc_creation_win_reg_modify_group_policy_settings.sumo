// Title: Modify Group Policy Settings
// ID: ada4b0c4-758b-46ac-9033-9004613a150d
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-08-19
// Tags: attack.privilege-escalation, attack.defense-impairment, attack.t1484.001
// Description: Detect malicious GPO modifications can be used to implement many other malicious behaviors.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*GroupPolicyRefreshTimeDC*" or CommandLine matches "*GroupPolicyRefreshTimeOffsetDC*" or CommandLine matches "*GroupPolicyRefreshTime*" or CommandLine matches "*GroupPolicyRefreshTimeOffset*" or CommandLine matches "*EnableSmartScreen*" or CommandLine matches "*ShellSmartScreenLevel*")) and (CommandLine matches "*\\SOFTWARE\\Policies\\Microsoft\\Windows\\System*") and ((Image matches "*\\reg.exe") or (OriginalFileName = "reg.exe")))
