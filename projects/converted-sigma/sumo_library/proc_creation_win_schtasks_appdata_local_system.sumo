// Title: Suspicious Schtasks Execution AppData Folder
// ID: c5c00f49-b3f9-45a6-997e-cfdecc6e1967
// Status: test
// Level: high
// Author: pH-T (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-03-15
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053.005, attack.t1059.001
// Description: Detects the creation of a schtask that executes a file from C:\Users\<USER>\AppData\Local
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\schtasks.exe" and (CommandLine matches "*/Create*" and CommandLine matches "*/RU*" and CommandLine matches "*/TR*" and CommandLine matches "*C:\\Users\\*" and CommandLine matches "*\\AppData\\Local\\*") and (CommandLine matches "*NT AUT*" or CommandLine matches "* SYSTEM *")) and !(((ParentImage matches "*\\AppData\\Local\\Temp\\*" and ParentImage matches "*TeamViewer_.exe*") and Image matches "*\\schtasks.exe" and CommandLine matches "*/TN TVInstallRestore*")))
