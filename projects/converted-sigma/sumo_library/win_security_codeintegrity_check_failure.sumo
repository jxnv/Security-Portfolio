// Title: Failed Code Integrity Checks
// ID: 470ec5fa-7b4e-4071-b200-4c753100f49b
// Status: stable
// Level: informational
// Author: Thomas Patzke
// Date: 2019-12-03
// Tags: attack.stealth, attack.t1027.001
// Description: Detects code integrity failures such as missing page hashes or corrupted drivers due unauthorized modification. This could be a sign of tampered binaries.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((EventID = "5038" or EventID = "6281")) and !((((param1 matches "*\\CSFalconServiceUninstallTool_*" or param1 matches "*\\Program Files\\CrowdStrike\\*" or param1 matches "*\\System32\\drivers\\CrowdStrike\\*" or param1 matches "*\\Windows\\System32\\ScriptControl64_*")) or (param1 matches "*\\Program Files\\Sophos\\*"))))
