// Title: Potential Suspicious Windows Feature Enabled - ProcCreation
// ID: c740d4cf-a1e9-41de-bb16-8a46a4f57918
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-29
// Tags: attack.stealth
// Description: Detects usage of the built-in PowerShell cmdlet "Enable-WindowsOptionalFeature" used as a Deployment Image Servicing and Management tool.
// Similar to DISM.exe, this cmdlet is used to enumerate, install, uninstall, configure, and update features and packages in Windows images
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*Enable-WindowsOptionalFeature*" and CommandLine matches "*-Online*" and CommandLine matches "*-FeatureName*")) and ((CommandLine matches "*TelnetServer*" or CommandLine matches "*Internet-Explorer-Optional-amd64*" or CommandLine matches "*TFTP*" or CommandLine matches "*SMB1Protocol*" or CommandLine matches "*Client-ProjFS*" or CommandLine matches "*Microsoft-Windows-Subsystem-Linux*")))
