// Title: Vim GTFOBin Abuse - Linux
// ID: 7ab8f73a-fcff-428b-84aa-6a5ff7877dea
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Luc Génaux
// Date: 2022-12-28
// Tags: attack.execution, attack.discovery, attack.t1059, attack.t1083
// Description: Detects the use of "vim" and it's siblings commands to execute a shell or proxy commands.
// Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*:!/*" or CommandLine matches "*:!$*" or CommandLine matches "*:!..*" or CommandLine matches "*:lua *" or CommandLine matches "*:py *" or CommandLine matches "*:shell*" or CommandLine matches "*/bin/bash*" or CommandLine matches "*/bin/dash*" or CommandLine matches "*/bin/fish*" or CommandLine matches "*/bin/sh*" or CommandLine matches "*/bin/csh*" or CommandLine matches "*/bin/ksh*" or CommandLine matches "*/bin/zsh*" or CommandLine matches "*/bin/tmux*")) and ((Image matches "*/rvim" or Image matches "*/vi" or Image matches "*/vim" or Image matches "*/vimdiff") and (CommandLine matches "* --cmd *" or CommandLine matches "* -c*")))
