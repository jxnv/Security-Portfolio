// Title: Invoke-Obfuscation VAR++ LAUNCHER OBFUSCATION - System
// ID: 14bcba49-a428-42d9-b943-e2ce0f0f7ae6
// Status: test
// Level: high
// Author: Timur Zinniatullin, oscd.community
// Date: 2020-10-13
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via VAR++ LAUNCHER
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (Provider_Name = "Service Control Manager" and EventID = "7045" and (ImagePath matches "*&&set*" and ImagePath matches "*cmd*" and ImagePath matches "*/c*" and ImagePath matches "*-f*") and (ImagePath matches "*{0}*" or ImagePath matches "*{1}*" or ImagePath matches "*{2}*" or ImagePath matches "*{3}*" or ImagePath matches "*{4}*" or ImagePath matches "*{5}*"))
