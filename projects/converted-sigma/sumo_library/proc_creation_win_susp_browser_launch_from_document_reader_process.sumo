// Title: Potential Suspicious Browser Launch From Document Reader Process
// ID: 1193d960-2369-499f-a158-7b50a31df682
// Status: test
// Level: medium
// Author: Joseph Kamau
// Date: 2024-05-27
// Tags: attack.execution, attack.t1204.002
// Description: Detects when a browser process or browser tab is launched from an application that handles document files such as Adobe, Microsoft Office, etc. And connects to a web application over http(s), this could indicate a possible phishing attempt.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((ParentImage matches "*Acrobat Reader*" or ParentImage matches "*Microsoft Office*" or ParentImage matches "*PDF Reader*") and (Image matches "*\\brave.exe" or Image matches "*\\chrome.exe" or Image matches "*\\firefox.exe" or Image matches "*\\msedge.exe" or Image matches "*\\opera.exe" or Image matches "*\\maxthon.exe" or Image matches "*\\seamonkey.exe" or Image matches "*\\vivaldi.exe") and CommandLine matches "*http*") and !((CommandLine matches "*https://go.microsoft.com/fwlink/*")) and !(((CommandLine matches "*http://ad.foxitsoftware.com/adlog.php?*" or CommandLine matches "*https://globe-map.foxitservice.com/go.php?do=redirect*"))))
