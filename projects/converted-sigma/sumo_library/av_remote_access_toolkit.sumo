// Title: Antivirus - Remote Access Tools Signature
// ID: 97233998-3838-4581-88c6-f1d19d3993fb
// Status: experimental
// Level: critical
// Author: Arnim Rupp (Nextron Systems)
// Date: 2026-06-15
// Tags: attack.execution, attack.t1203, attack.command-and-control, attack.t1219.002
// Description: Detects a highly relevant Antivirus alert that reports a remote access tool.
// This event must not be ignored just because the AV has blocked the malware but investigate, how it came there in the first place.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Signature matches "*AgentB*" or Signature matches "*AgentTesla*" or Signature matches "*AMRat*" or Signature matches "*Ammyy*" or Signature matches "*AsyncRAT*" or Signature matches "*Bandook*" or Signature matches "*Bitrat*" or Signature matches "*Bladabindi*" or Signature matches "*Connectwise*" or Signature matches "*CyberGate*" or Signature matches "*DarkComet*" or Signature matches "*DCrat*" or Signature matches "*Delf*" or Signature matches "*DokStorm*" or Signature matches "*Egairtigado*" or Signature matches "*Gh0st*" or Signature matches "*Gorat*" or Signature matches "*GodRat*" or Signature matches "*Jalapeno*" or Signature matches "*LummaC2*" or Signature matches "*Minirat*" or Signature matches "*Netwire*" or Signature matches "*NanoCore*" or Signature matches "*NJRat*" or Signature matches "*Paralax*" or Signature matches "*PlugX*" or Signature matches "*Pulsar*" or Signature matches "*Quasar*" or Signature matches "*Remcos*" or Signature matches "*Ravartar*" or Signature matches "*RemoteAdmin*" or Signature matches "*RemoteTool*" or Signature matches "*revengeRAT*" or Signature matches "*rokRAT*" or Signature matches "*salatstealer*" or Signature matches "*Salgorea*" or Signature matches "*SmokedHam*" or Signature matches "*TigerRat*" or Signature matches "*Tzeebot*" or Signature matches "*WarZone*" or Signature matches "*VenomRAT*" or Signature matches "*Vidar*" or Signature matches "*Wirenet*" or Signature matches "*XWorm*" or Signature matches "*Zapchast*" or Signature matches "*Zegost*"))
