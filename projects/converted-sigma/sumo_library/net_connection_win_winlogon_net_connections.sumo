// Title: Outbound Network Connection To Public IP Via Winlogon
// ID: 7610a4ea-c06d-495f-a2ac-0a696abcfd3b
// Status: test
// Level: medium
// Author: Christopher Peacock @securepeacock, SCYTHE @scythe_io
// Date: 2023-04-28
// Tags: attack.execution, attack.command-and-control, attack.stealth, attack.t1218.011
// Description: Detects a "winlogon.exe" process that initiate network communications with public IP addresses
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\winlogon.exe" and Initiated = "true") and !(((cidrMatch(DestinationIp, "127.0.0.0/8") or cidrMatch(DestinationIp, "10.0.0.0/8") or cidrMatch(DestinationIp, "172.16.0.0/12") or cidrMatch(DestinationIp, "192.168.0.0/16") or cidrMatch(DestinationIp, "169.254.0.0/16") or cidrMatch(DestinationIp, "::1/128") or cidrMatch(DestinationIp, "fe80::/10") or cidrMatch(DestinationIp, "fc00::/7")))))
