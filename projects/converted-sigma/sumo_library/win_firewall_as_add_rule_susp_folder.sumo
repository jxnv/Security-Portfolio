// Title: New Firewall Rule Added In Windows Firewall Exception List For Potential Suspicious Application
// ID: 9e2575e7-2cb9-4da1-adc8-ed94221dca5e
// Status: test
// Level: high
// Author: frack113
// Date: 2023-02-26
// Tags: attack.defense-impairment, attack.t1686.003
// Description: Detects the addition of a new rule to the Windows Firewall exception list for an application located in a potentially suspicious location.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((EventID = "2004" or EventID = "2071" or EventID = "2097") and (ApplicationPath matches "*:\\PerfLogs\\*" or ApplicationPath matches "*:\\Temp\\*" or ApplicationPath matches "*:\\Tmp\\*" or ApplicationPath matches "*:\\Users\\Public\\*" or ApplicationPath matches "*:\\Windows\\Tasks\\*" or ApplicationPath matches "*:\\Windows\\Temp\\*" or ApplicationPath matches "*\\AppData\\Local\\Temp\\*")) and !((Action = "2")))
