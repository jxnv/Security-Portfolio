// Title: File In Suspicious Location Encoded To Base64 Via Certutil.EXE
// ID: 82a6714f-4899-4f16-9c1e-9a333544d4c3
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-15
// Tags: attack.stealth, attack.t1027
// Description: Detects the execution of certutil with the "encode" flag to encode a file to base64 where the files are located in potentially suspicious locations
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*-encode*" or CommandLine matches "*/encode*")) and ((CommandLine matches "*\\AppData\\Roaming\\*" or CommandLine matches "*\\Desktop\\*" or CommandLine matches "*\\Local\\Temp\\*" or CommandLine matches "*\\PerfLogs\\*" or CommandLine matches "*\\Users\\Public\\*" or CommandLine matches "*\\Windows\\Temp\\*" or CommandLine matches "*$Recycle.Bin*")) and ((Image matches "*\\certutil.exe") or (OriginalFileName = "CertUtil.exe")))
