// Title: Renamed Visual Studio Code Tunnel Execution
// ID: 2cf29f11-e356-4f61-98c0-1bdb9393d6da
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-09-28
// Tags: attack.command-and-control, attack.t1071.001, attack.t1219
// Description: Detects renamed Visual Studio Code tunnel execution. Attackers can abuse this functionality to establish a C2 channel
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((isNull(OriginalFileName) and CommandLine matches "*.exe tunnel") or ((CommandLine matches "*.exe tunnel*" and CommandLine matches "*--accept-server-license-terms*")) or ((CommandLine matches "*tunnel *" and CommandLine matches "*service*" and CommandLine matches "*internal-run*" and CommandLine matches "*tunnel-service.log*"))) and !(((Image matches "*\\code-tunnel.exe" or Image matches "*\\code.exe")))) or ((ParentCommandLine matches "* tunnel" and Image matches "*\\cmd.exe" and (CommandLine matches "*/d /c *" and CommandLine matches "*\\servers\\Stable-*" and CommandLine matches "*code-server.cmd*")) and !(((ParentImage matches "*\\code-tunnel.exe" or ParentImage matches "*\\code.exe")))))
