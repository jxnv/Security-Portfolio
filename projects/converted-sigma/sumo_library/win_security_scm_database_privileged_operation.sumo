// Title: SCM Database Privileged Operation
// ID: dae8171c-5ec6-4396-b210-8466585b53e9
// Status: test
// Level: medium
// Author: Roberto Rodriguez @Cyb3rWard0g, Tim Shelton
// Date: 2019-08-15
// Tags: attack.privilege-escalation, attack.t1548
// Description: Detects non-system users performing privileged operation os the SCM database
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((EventID = "4674" and ObjectType = "SC_MANAGER OBJECT" and ObjectName = "servicesactive" and PrivilegeList = "SeTakeOwnershipPrivilege") and !((SubjectLogonId = "0x3e4" and ProcessName matches "*:\\Windows\\System32\\services.exe")))
