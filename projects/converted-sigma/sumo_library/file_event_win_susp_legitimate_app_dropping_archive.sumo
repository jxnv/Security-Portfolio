// Title: Legitimate Application Dropped Archive
// ID: 654fcc6d-840d-4844-9b07-2c3300e54a26
// Status: test
// Level: high
// Author: frack113, Florian Roth
// Date: 2022-08-21
// Tags: attack.stealth, attack.t1218
// Description: Detects programs on a Windows system that should not write an archive to disk
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\winword.exe" or Image matches "*\\excel.exe" or Image matches "*\\powerpnt.exe" or Image matches "*\\msaccess.exe" or Image matches "*\\mspub.exe" or Image matches "*\\eqnedt32.exe" or Image matches "*\\visio.exe" or Image matches "*\\wordpad.exe" or Image matches "*\\wordview.exe" or Image matches "*\\certutil.exe" or Image matches "*\\certoc.exe" or Image matches "*\\CertReq.exe" or Image matches "*\\Desktopimgdownldr.exe" or Image matches "*\\esentutl.exe" or Image matches "*\\finger.exe" or Image matches "*\\notepad.exe" or Image matches "*\\AcroRd32.exe" or Image matches "*\\RdrCEF.exe" or Image matches "*\\mshta.exe" or Image matches "*\\hh.exe") and (TargetFilename matches "*.zip" or TargetFilename matches "*.rar" or TargetFilename matches "*.7z" or TargetFilename matches "*.diagcab" or TargetFilename matches "*.appx"))
