// Title: Suspicious Child Process Of SQL Server
// ID: 869b9ca7-9ea2-4a5a-8325-e80e62f75445
// Status: test
// Level: high
// Author: FPT.EagleEye Team, wagga
// Date: 2020-12-11
// Tags: attack.t1505.003, attack.t1190, attack.initial-access, attack.persistence, attack.privilege-escalation
// Description: Detects suspicious child processes of the SQLServer process. This could indicate potential RCE or SQL Injection.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((ParentImage matches "*\\sqlservr.exe" and (Image matches "*\\bash.exe" or Image matches "*\\bitsadmin.exe" or Image matches "*\\cmd.exe" or Image matches "*\\netstat.exe" or Image matches "*\\nltest.exe" or Image matches "*\\ping.exe" or Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\regsvr32.exe" or Image matches "*\\rundll32.exe" or Image matches "*\\sh.exe" or Image matches "*\\systeminfo.exe" or Image matches "*\\tasklist.exe" or Image matches "*\\wsl.exe")) and !((ParentImage matches "C:\\Program Files\\Microsoft SQL Server\\*" and ParentImage matches "*DATEV_DBENGINE\\MSSQL\\Binn\\sqlservr.exe" and Image = "C:\\Windows\\System32\\cmd.exe" and CommandLine matches "\"C:\\Windows\\system32\\cmd.exe\" *")))
