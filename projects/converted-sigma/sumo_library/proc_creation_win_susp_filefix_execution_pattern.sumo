// Title: Suspicious FileFix Execution Pattern
// ID: b5b29e4e-31fa-4fdf-b058-296e7a1aa0c2
// Status: experimental
// Level: high
// Author: 0xFustang, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-11-24
// Tags: attack.execution, attack.t1204.004
// Description: Detects suspicious FileFix execution patterns where users are tricked into running malicious commands through browser file upload dialog manipulation.
// This attack typically begins when users visit malicious websites impersonating legitimate services or news platforms,
// which may display fake CAPTCHA challenges or direct instructions to open file explorer and paste clipboard content.
// The clipboard content usually contains commands that download and execute malware, such as information stealing tools.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((ParentImage matches "*\\brave.exe" or ParentImage matches "*\\chrome.exe" or ParentImage matches "*\\firefox.exe" or ParentImage matches "*\\msedge.exe") and CommandLine matches "*#*") and (((CommandLine matches "*account*" or CommandLine matches "*anti-bot*" or CommandLine matches "*botcheck*" or CommandLine matches "*captcha*" or CommandLine matches "*challenge*" or CommandLine matches "*confirmation*" or CommandLine matches "*fraud*" or CommandLine matches "*human*" or CommandLine matches "*identification*" or CommandLine matches "*identificator*" or CommandLine matches "*identity*" or CommandLine matches "*robot*" or CommandLine matches "*validation*" or CommandLine matches "*verification*" or CommandLine matches "*verify*")) or ((CommandLine matches "*%comspec%*" or CommandLine matches "*bitsadmin*" or CommandLine matches "*certutil*" or CommandLine matches "*cmd*" or CommandLine matches "*cscript*" or CommandLine matches "*curl*" or CommandLine matches "*finger*" or CommandLine matches "*mshta*" or CommandLine matches "*powershell*" or CommandLine matches "*pwsh*" or CommandLine matches "*regsvr32*" or CommandLine matches "*rundll32*" or CommandLine matches "*schtasks*" or CommandLine matches "*wget*" or CommandLine matches "*wscript*"))))
