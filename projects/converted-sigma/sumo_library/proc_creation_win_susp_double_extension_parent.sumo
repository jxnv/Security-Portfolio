// Title: Suspicious Parent Double Extension File Execution
// ID: 5e6a80c8-2d45-4633-9ef4-fa2671a39c5c
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-06
// Tags: attack.stealth, attack.t1036.007
// Description: Detect execution of suspicious double extension files in ParentCommandLine
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((ParentImage matches "*.doc.lnk" or ParentImage matches "*.docx.lnk" or ParentImage matches "*.xls.lnk" or ParentImage matches "*.xlsx.lnk" or ParentImage matches "*.ppt.lnk" or ParentImage matches "*.pptx.lnk" or ParentImage matches "*.rtf.lnk" or ParentImage matches "*.pdf.lnk" or ParentImage matches "*.txt.lnk" or ParentImage matches "*.doc.js" or ParentImage matches "*.docx.js" or ParentImage matches "*.xls.js" or ParentImage matches "*.xlsx.js" or ParentImage matches "*.ppt.js" or ParentImage matches "*.pptx.js" or ParentImage matches "*.rtf.js" or ParentImage matches "*.pdf.js" or ParentImage matches "*.txt.js")) or ((ParentCommandLine matches "*.doc.lnk*" or ParentCommandLine matches "*.docx.lnk*" or ParentCommandLine matches "*.xls.lnk*" or ParentCommandLine matches "*.xlsx.lnk*" or ParentCommandLine matches "*.ppt.lnk*" or ParentCommandLine matches "*.pptx.lnk*" or ParentCommandLine matches "*.rtf.lnk*" or ParentCommandLine matches "*.pdf.lnk*" or ParentCommandLine matches "*.txt.lnk*" or ParentCommandLine matches "*.doc.js*" or ParentCommandLine matches "*.docx.js*" or ParentCommandLine matches "*.xls.js*" or ParentCommandLine matches "*.xlsx.js*" or ParentCommandLine matches "*.ppt.js*" or ParentCommandLine matches "*.pptx.js*" or ParentCommandLine matches "*.rtf.js*" or ParentCommandLine matches "*.pdf.js*" or ParentCommandLine matches "*.txt.js*")))
