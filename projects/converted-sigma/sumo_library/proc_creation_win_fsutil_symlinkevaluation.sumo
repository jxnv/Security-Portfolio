// Title: Potentially Suspicious NTFS Symlink Behavior Modification
// ID: c0b2768a-dd06-4671-8339-b16ca8d1f27f
// Status: test
// Level: medium
// Author: frack113, The DFIR Report
// Date: 2022-03-02
// Tags: attack.execution, attack.defense-impairment, attack.t1059, attack.t1222.001
// Description: Detects the modification of NTFS symbolic link behavior using fsutil, which could be used to enable remote to local or remote to remote symlinks for potential attacks.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*fsutil*" and CommandLine matches "*behavior*" and CommandLine matches "*set*" and CommandLine matches "*SymlinkEvaluation*")) and (((Image matches "*\\cmd.exe" or Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe")) or ((OriginalFileName = "Cmd.Exe" or OriginalFileName = "PowerShell.EXE" or OriginalFileName = "pwsh.dll"))) and ((CommandLine matches "*R2L:1*" or CommandLine matches "*R2R:1*" or CommandLine matches "*L2L:1*")))
