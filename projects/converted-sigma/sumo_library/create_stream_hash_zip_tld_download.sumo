// Title: Potentially Suspicious File Download From ZIP TLD
// ID: 0bb4bbeb-fe52-4044-b40c-430a04577ebe
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2023-05-18
// Tags: attack.stealth
// Description: Detects the download of a file with a potentially suspicious extension from a .zip top level domain.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (Contents matches "*.zip/*" and (TargetFilename matches "*.bat:Zone*" or TargetFilename matches "*.dat:Zone*" or TargetFilename matches "*.dll:Zone*" or TargetFilename matches "*.doc:Zone*" or TargetFilename matches "*.docm:Zone*" or TargetFilename matches "*.exe:Zone*" or TargetFilename matches "*.hta:Zone*" or TargetFilename matches "*.pptm:Zone*" or TargetFilename matches "*.ps1:Zone*" or TargetFilename matches "*.rar:Zone*" or TargetFilename matches "*.rtf:Zone*" or TargetFilename matches "*.sct:Zone*" or TargetFilename matches "*.vbe:Zone*" or TargetFilename matches "*.vbs:Zone*" or TargetFilename matches "*.ws:Zone*" or TargetFilename matches "*.wsf:Zone*" or TargetFilename matches "*.xll:Zone*" or TargetFilename matches "*.xls:Zone*" or TargetFilename matches "*.xlsm:Zone*" or TargetFilename matches "*.zip:Zone*"))
