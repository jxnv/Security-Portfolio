// Title: Suspicious File Download From File Sharing Domain Via Curl.EXE
// ID: 56454143-524f-49fb-b1c6-3fb8b1ad41fb
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-05
// Tags: attack.execution
// Description: Detects potentially suspicious file download from file sharing domains using curl.exe
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*.ps1" or CommandLine matches "*.ps1'" or CommandLine matches "*.ps1\"" or CommandLine matches "*.dat" or CommandLine matches "*.dat'" or CommandLine matches "*.dat\"" or CommandLine matches "*.msi" or CommandLine matches "*.msi'" or CommandLine matches "*.msi\"" or CommandLine matches "*.bat" or CommandLine matches "*.bat'" or CommandLine matches "*.bat\"" or CommandLine matches "*.exe" or CommandLine matches "*.exe'" or CommandLine matches "*.exe\"" or CommandLine matches "*.vbs" or CommandLine matches "*.vbs'" or CommandLine matches "*.vbs\"" or CommandLine matches "*.vbe" or CommandLine matches "*.vbe'" or CommandLine matches "*.vbe\"" or CommandLine matches "*.hta" or CommandLine matches "*.hta'" or CommandLine matches "*.hta\"" or CommandLine matches "*.dll" or CommandLine matches "*.dll'" or CommandLine matches "*.dll\"" or CommandLine matches "*.psm1" or CommandLine matches "*.psm1'" or CommandLine matches "*.psm1\"")) and ((CommandLine matches "* -O*" or CommandLine matches "*--remote-name*" or CommandLine matches "*--output*")) and (CommandLine matches "*http*") and ((Image matches "*\\curl.exe") or (OriginalFileName = "curl.exe")) and ((CommandLine matches "*.githubusercontent.com*" or CommandLine matches "*0x0.st*" or CommandLine matches "*anonfiles.com*" or CommandLine matches "*bashupload.com*" or CommandLine matches "*cdn.discordapp.com*" or CommandLine matches "*chunk.io*" or CommandLine matches "*ddns.net*" or CommandLine matches "*dl.dropboxusercontent.com*" or CommandLine matches "*ghostbin.co*" or CommandLine matches "*github.com*" or CommandLine matches "*glitch.me*" or CommandLine matches "*gofile.io*" or CommandLine matches "*hastebin.com*" or CommandLine matches "*mediafire.com*" or CommandLine matches "*mega.nz*" or CommandLine matches "*onrender.com*" or CommandLine matches "*pages.dev*" or CommandLine matches "*paste.ee*" or CommandLine matches "*pastebin.com*" or CommandLine matches "*pastebin.pl*" or CommandLine matches "*pastetext.net*" or CommandLine matches "*pixeldrain.com*" or CommandLine matches "*privatlab.com*" or CommandLine matches "*privatlab.net*" or CommandLine matches "*send.exploit.in*" or CommandLine matches "*sendspace.com*" or CommandLine matches "*storage.googleapis.com*" or CommandLine matches "*storjshare.io*" or CommandLine matches "*supabase.co*" or CommandLine matches "*temp.sh*" or CommandLine matches "*transfer.sh*" or CommandLine matches "*trycloudflare.com*" or CommandLine matches "*ufile.io*" or CommandLine matches "*w3spaces.com*" or CommandLine matches "*workers.dev*" or CommandLine matches "*x0.at*")))
