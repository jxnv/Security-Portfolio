// Title: Remote Access Tool Services Have Been Installed - Security
// ID: c8b00925-926c-47e3-beea-298fd563728e
// Status: test
// Level: medium
// Author: Connor Martin, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-23
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1543.003, attack.t1569.002
// Description: Detects service installation of different remote access tools software. These software are often abused by threat actors to perform
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (EventID = "4697" and (ServiceName matches "*AmmyyAdmin*" or ServiceName matches "*AnyDesk*" or ServiceName matches "*Atera*" or ServiceName matches "*BASupportExpressSrvcUpdater*" or ServiceName matches "*BASupportExpressStandaloneService*" or ServiceName matches "*chromoting*" or ServiceName matches "*GoToAssist*" or ServiceName matches "*GoToMyPC*" or ServiceName matches "*jumpcloud*" or ServiceName matches "*LMIGuardianSvc*" or ServiceName matches "*LogMeIn*" or ServiceName matches "*monblanking*" or ServiceName matches "*Parsec*" or ServiceName matches "*RManService*" or ServiceName matches "*RPCPerformanceService*" or ServiceName matches "*RPCService*" or ServiceName matches "*SplashtopRemoteService*" or ServiceName matches "*SSUService*" or ServiceName matches "*TeamViewer*" or ServiceName matches "*TightVNC*" or ServiceName matches "*vncserver*" or ServiceName matches "*Zoho*"))
