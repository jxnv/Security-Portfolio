// Title: WmiPrvSE Spawned A Process
// ID: d21374ff-f574-44a7-9998-4a8c8bf33d7d
// Status: stable
// Level: medium
// Author: Roberto Rodriguez @Cyb3rWard0g
// Date: 2019-08-15
// Tags: attack.execution, attack.t1047
// Description: Detects WmiPrvSE spawning a process
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((ParentImage matches "*\\WmiPrvSe.exe") and !((((LogonId = "0x3e7" or LogonId = "null")) or (isNull(LogonId)) or ((User matches "*AUTHORI*" or User matches "*AUTORI*")) or (Image matches "*\\WerFault.exe") or (Image matches "*\\WmiPrvSE.exe"))))
