// Title: ETW Trace Evasion Activity
// ID: a238b5d0-ce2d-4414-a676-7a531b3d13d6
// Status: test
// Level: high
// Author: @neu5ron, Florian Roth (Nextron Systems), Jonhnathan Ribeiro, oscd.community
// Date: 2019-03-22
// Tags: attack.stealth, attack.defense-impairment, attack.t1070, attack.t1685, car.2016-04-002
// Description: Detects command line activity that tries to clear or disable any ETW trace log which could be a sign of logging evasion.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*cl*" and CommandLine matches "*/Trace*")) or ((CommandLine matches "*clear-log*" and CommandLine matches "*/Trace*")) or ((CommandLine matches "*sl*" and CommandLine matches "*/e:false*")) or ((CommandLine matches "*set-log*" and CommandLine matches "*/e:false*")) or ((CommandLine matches "*logman*" and CommandLine matches "*update*" and CommandLine matches "*trace*" and CommandLine matches "*--p*" and CommandLine matches "*-ets*")) or (CommandLine matches "*Remove-EtwTraceProvider*") or ((CommandLine matches "*Set-EtwTraceProvider*" and CommandLine matches "*0x11*")))
