// Title: Suspicious Electron Application Child Processes
// ID: f26eb764-fd89-464b-85e2-dc4a8e6e77b8
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-21
// Tags: attack.execution
// Description: Detects suspicious child processes of electron apps (teams, discord, slack, etc.). This could be a potential sign of ".asar" file tampering (See reference section for more information) or binary execution proxy through specific CLI arguments (see related rule)
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((ParentImage matches "*\\chrome.exe" or ParentImage matches "*\\discord.exe" or ParentImage matches "*\\GitHubDesktop.exe" or ParentImage matches "*\\keybase.exe" or ParentImage matches "*\\msedge.exe" or ParentImage matches "*\\msedgewebview2.exe" or ParentImage matches "*\\msteams.exe" or ParentImage matches "*\\slack.exe" or ParentImage matches "*\\teams.exe")) and (((Image matches "*\\cmd.exe" or Image matches "*\\cscript.exe" or Image matches "*\\mshta.exe" or Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\regsvr32.exe" or Image matches "*\\whoami.exe" or Image matches "*\\wscript.exe")) or ((Image matches "*:\\ProgramData\\*" or Image matches "*:\\Temp\\*" or Image matches "*\\AppData\\Local\\Temp\\*" or Image matches "*\\Users\\Public\\*" or Image matches "*\\Windows\\Temp\\*"))) and !((ParentImage matches "*\\Discord.exe" and Image matches "*\\cmd.exe" and CommandLine matches "*\\NVSMI\\nvidia-smi.exe*")))
