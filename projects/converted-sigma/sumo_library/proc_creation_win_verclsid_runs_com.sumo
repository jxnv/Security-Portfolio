// Title: Verclsid.exe Runs COM Object
// ID: d06be4b9-8045-428b-a567-740a26d9db25
// Status: test
// Level: medium
// Author: Victor Sergeev, oscd.community
// Date: 2020-10-09
// Tags: attack.stealth, attack.t1218
// Description: Detects when verclsid.exe is used to run COM object via GUID
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((CommandLine matches "*/S*" and CommandLine matches "*/C*")) and ((Image matches "*\\verclsid.exe") or (OriginalFileName = "verclsid.exe"))) and !((ParentImage matches "*C:\\Windows\\System32\\RuntimeBroker.exe" and (CommandLine matches "*verclsid.exe\" /S /C {*" and CommandLine matches "*} /I {*"))))
