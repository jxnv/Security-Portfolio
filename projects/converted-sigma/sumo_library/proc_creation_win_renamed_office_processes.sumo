// Title: Renamed Office Binary Execution
// ID: 0b0cd537-fc77-4e6e-a973-e53495c1083d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-20
// Tags: attack.stealth, attack.t1036.003
// Description: Detects the execution of a renamed office binary
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((OriginalFileName = "Excel.exe" or OriginalFileName = "MSACCESS.EXE" or OriginalFileName = "MSPUB.EXE" or OriginalFileName = "OneNote.exe" or OriginalFileName = "OneNoteM.exe" or OriginalFileName = "OUTLOOK.EXE" or OriginalFileName = "POWERPNT.EXE" or OriginalFileName = "WinWord.exe" or OriginalFileName = "Olk.exe")) or ((Description = "Microsoft Access" or Description = "Microsoft Excel" or Description = "Microsoft OneNote" or Description = "Microsoft Outlook" or Description = "Microsoft PowerPoint" or Description = "Microsoft Publisher" or Description = "Microsoft Word" or Description = "Sent to OneNote Tool"))) and !(((Image matches "*\\EXCEL.exe" or Image matches "*\\excelcnv.exe" or Image matches "*\\MSACCESS.exe" or Image matches "*\\MSPUB.EXE" or Image matches "*\\ONENOTE.EXE" or Image matches "*\\ONENOTEM.EXE" or Image matches "*\\OUTLOOK.EXE" or Image matches "*\\POWERPNT.EXE" or Image matches "*\\WINWORD.exe" or Image matches "*\\OLK.EXE"))))
