// Title: FileFix - Command Evidence in TypedPaths
// ID: 4fee3d51-8069-4a4c-a0f7-924fcaff2c70
// Status: experimental
// Level: high
// Author: Alfie Champion (delivr.to), Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-07-05
// Tags: attack.execution, attack.t1204.004
// Description: Detects commonly-used chained commands and strings in the most recent 'url' value of the 'TypedPaths' key, which could be indicative of a user being targeted by the FileFix technique.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((TargetObject matches "*\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\TypedPaths\\url1" and (Details matches "*#*" and Details matches "*http*")) and (((Details matches "*account*" or Details matches "*anti-bot*" or Details matches "*botcheck*" or Details matches "*captcha*" or Details matches "*challenge*" or Details matches "*confirmation*" or Details matches "*fraud*" or Details matches "*human*" or Details matches "*identification*" or Details matches "*identificator*" or Details matches "*identity*" or Details matches "*robot*" or Details matches "*validation*" or Details matches "*verification*" or Details matches "*verify*")) or ((Details matches "*%comspec%*" or Details matches "*bitsadmin*" or Details matches "*certutil*" or Details matches "*cmd*" or Details matches "*cscript*" or Details matches "*curl*" or Details matches "*finger*" or Details matches "*mshta*" or Details matches "*powershell*" or Details matches "*pwsh*" or Details matches "*regsvr32*" or Details matches "*rundll32*" or Details matches "*schtasks*" or Details matches "*wget*" or Details matches "*wscript*"))))
