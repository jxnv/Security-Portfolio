// Title: Suspicious File Write to SharePoint Layouts Directory
// ID: 1f0489be-b496-4ddf-b3a9-5900f2044e9c
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-07-24
// Tags: attack.initial-access, attack.t1190, attack.persistence, attack.t1505.003
// Description: Detects suspicious file writes to SharePoint layouts directory which could indicate webshell activity or post-exploitation.
// This behavior has been observed in the exploitation of SharePoint vulnerabilities such as CVE-2025-49704, CVE-2025-49706 or CVE-2025-53770.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\cmd.exe" or Image matches "*\\powershell_ise.exe" or Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\w3wp.exe") and (TargetFilename matches "C:\\Program Files\\Common Files\\Microsoft Shared\\Web Server Extensions\\*" or TargetFilename matches "C:\\Program Files (x86)\\Common Files\\Microsoft Shared\\Web Server Extensions\\*") and (TargetFilename matches "*\\15\\TEMPLATE\\LAYOUTS\\*" or TargetFilename matches "*\\16\\TEMPLATE\\LAYOUTS\\*") and (TargetFilename matches "*.asax" or TargetFilename matches "*.ascx" or TargetFilename matches "*.ashx" or TargetFilename matches "*.asmx" or TargetFilename matches "*.asp" or TargetFilename matches "*.aspx" or TargetFilename matches "*.bat" or TargetFilename matches "*.cmd" or TargetFilename matches "*.cer" or TargetFilename matches "*.config" or TargetFilename matches "*.hta" or TargetFilename matches "*.js" or TargetFilename matches "*.jsp" or TargetFilename matches "*.jspx" or TargetFilename matches "*.php" or TargetFilename matches "*.ps1" or TargetFilename matches "*.vbs"))
