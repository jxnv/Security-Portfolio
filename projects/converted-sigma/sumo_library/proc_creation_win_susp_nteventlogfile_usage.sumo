// Title: Potentially Suspicious Call To Win32_NTEventlogFile Class
// ID: caf201a9-c2ce-4a26-9c3a-2b9525413711
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-07-13
// Tags: attack.defense-impairment
// Description: Detects usage of the WMI class "Win32_NTEventlogFile" in a potentially suspicious way (delete, backup, change permissions, etc.) from a PowerShell script
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((CommandLine matches "*Win32_NTEventlogFile*") and ((CommandLine matches "*.BackupEventlog(*" or CommandLine matches "*.ChangeSecurityPermissions(*" or CommandLine matches "*.ChangeSecurityPermissionsEx(*" or CommandLine matches "*.ClearEventLog(*" or CommandLine matches "*.Delete(*" or CommandLine matches "*.DeleteEx(*" or CommandLine matches "*.Rename(*" or CommandLine matches "*.TakeOwnerShip(*" or CommandLine matches "*.TakeOwnerShipEx(*")))
