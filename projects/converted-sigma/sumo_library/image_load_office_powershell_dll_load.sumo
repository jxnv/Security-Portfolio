// Title: PowerShell Core DLL Loaded Via Office Application
// ID: bb2ba6fb-95d4-4a25-89fc-30bb736c021a
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-01
// Tags: attack.stealth
// Description: Detects PowerShell core DLL being loaded by an Office Product
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\excel.exe" or Image matches "*\\mspub.exe" or Image matches "*\\outlook.exe" or Image matches "*\\onenote.exe" or Image matches "*\\onenoteim.exe" or Image matches "*\\powerpnt.exe" or Image matches "*\\winword.exe") and (ImageLoaded matches "*\\System.Management.Automation.Dll*" or ImageLoaded matches "*\\System.Management.Automation.ni.Dll*"))
