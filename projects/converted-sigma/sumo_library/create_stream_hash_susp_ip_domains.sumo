// Title: Unusual File Download from Direct IP Address
// ID: 025bd229-fd1f-4fdb-97ab-20006e1a5368
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Florian Roth (Nextron Systems)
// Date: 2022-09-07
// Tags: attack.stealth, attack.t1564.004
// Description: Detects the download of suspicious file type from URLs with IP
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (Contents matches /http[s]?://[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}/ and (TargetFilename matches "*.ps1:Zone*" or TargetFilename matches "*.bat:Zone*" or TargetFilename matches "*.exe:Zone*" or TargetFilename matches "*.vbe:Zone*" or TargetFilename matches "*.vbs:Zone*" or TargetFilename matches "*.dll:Zone*" or TargetFilename matches "*.one:Zone*" or TargetFilename matches "*.cmd:Zone*" or TargetFilename matches "*.hta:Zone*" or TargetFilename matches "*.xll:Zone*" or TargetFilename matches "*.lnk:Zone*"))
