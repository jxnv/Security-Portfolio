// Title: Elevated System Shell Spawned From Uncommon Parent Location
// ID: 178e615d-e666-498b-9630-9ed363038101
// Status: test
// Level: medium
// Author: frack113, Tim Shelton (update fp)
// Date: 2022-12-05
// Tags: attack.privilege-escalation, attack.execution, attack.t1059
// Description: Detects when a shell program such as the Windows command prompt or PowerShell is launched with system privileges from a uncommon parent location.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((((Image matches "*\\powershell.exe" or Image matches "*\\powershell_ise.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\cmd.exe")) or ((OriginalFileName = "PowerShell.EXE" or OriginalFileName = "powershell_ise.EXE" or OriginalFileName = "pwsh.dll" or OriginalFileName = "Cmd.Exe"))) and ((User matches "*AUTHORI*" or User matches "*AUTORI*") and LogonId = "0x3e7")) and !((((ParentImage matches "*:\\Program Files (x86)\\*" or ParentImage matches "*:\\Program Files\\*" or ParentImage matches "*:\\ProgramData\\*" or ParentImage matches "*:\\Windows\\System32\\*" or ParentImage matches "*:\\Windows\\SysWOW64\\*" or ParentImage matches "*:\\Windows\\Temp\\*" or ParentImage matches "*:\\Windows\\WinSxS\\*")) or ((ParentImage = "" or ParentImage = "-")) or (isNull(ParentImage)))) and !(((CommandLine matches "*:\\WINDOWS\\system32\\cmd.exe /c \"*" and CurrentDirectory matches "*:\\WINDOWS\\Temp\\asgard2-agent\\*") or (ParentImage matches "*:\\IBM\\SpectrumProtect\\webserver\\scripts\\*" and CommandLine matches "*:\\IBM\\SpectrumProtect\\webserver\\scripts\\*") or (ParentImage matches "*:\\ManageEngine\\ADManager Plus\\pgsql\\bin\\postgres.exe" and Image matches "*\\cmd.exe"))))
