// Title: Potentially Suspicious Execution Of PDQDeployRunner
// ID: 12b8e9f5-96b2-41e1-9a42-8c6779a5c184
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-22
// Tags: attack.execution
// Description: Detects suspicious execution of "PDQDeployRunner" which is part of the PDQDeploy service stack that is responsible for executing commands and packages on a remote machines
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((Image matches "*\\bash.exe" or Image matches "*\\certutil.exe" or Image matches "*\\cmd.exe" or Image matches "*\\csc.exe" or Image matches "*\\cscript.exe" or Image matches "*\\dllhost.exe" or Image matches "*\\mshta.exe" or Image matches "*\\msiexec.exe" or Image matches "*\\regsvr32.exe" or Image matches "*\\rundll32.exe" or Image matches "*\\scriptrunner.exe" or Image matches "*\\wmic.exe" or Image matches "*\\wscript.exe" or Image matches "*\\wsl.exe")) or ((Image matches "*:\\ProgramData\\*" or Image matches "*:\\Users\\Public\\*" or Image matches "*:\\Windows\\TEMP\\*" or Image matches "*\\AppData\\Local\\Temp*")) or ((CommandLine matches "* -decode *" or CommandLine matches "* -enc *" or CommandLine matches "* -encodedcommand *" or CommandLine matches "* -w hidden*" or CommandLine matches "*DownloadString*" or CommandLine matches "*FromBase64String*" or CommandLine matches "*http*" or CommandLine matches "*iex *" or CommandLine matches "*Invoke-*"))) and (ParentImage matches "*\\PDQDeployRunner-*"))
