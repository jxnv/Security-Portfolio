_sourceCategory=* | where ((TargetFilename matches "*:\\windows\\temp\\sam.tmp" or TargetFilename matches "*:\\windows\\temp\\sec.tmp" or TargetFilename matches "*:\\windows\\temp\\sys.tmp"))
