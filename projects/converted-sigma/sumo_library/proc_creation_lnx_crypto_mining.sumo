// Title: Linux Crypto Mining Indicators
// ID: 9069ea3c-b213-4c52-be13-86506a227ab1
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-10-26
// Tags: attack.impact, attack.t1496
// Description: Detects command line parameters or strings often used by crypto miners
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((CommandLine matches "* --cpu-priority=*" or CommandLine matches "*--donate-level=0*" or CommandLine matches "* -o pool.*" or CommandLine matches "* --nicehash*" or CommandLine matches "* --algo=rx/0 *" or CommandLine matches "*stratum+tcp://*" or CommandLine matches "*stratum+udp://*" or CommandLine matches "*sh -c /sbin/modprobe msr allow_writes=on*" or CommandLine matches "*LS1kb25hdGUtbGV2ZWw9*" or CommandLine matches "*0tZG9uYXRlLWxldmVsP*" or CommandLine matches "*tLWRvbmF0ZS1sZXZlbD*" or CommandLine matches "*c3RyYXR1bSt0Y3A6Ly*" or CommandLine matches "*N0cmF0dW0rdGNwOi8v*" or CommandLine matches "*zdHJhdHVtK3RjcDovL*" or CommandLine matches "*c3RyYXR1bSt1ZHA6Ly*" or CommandLine matches "*N0cmF0dW0rdWRwOi8v*" or CommandLine matches "*zdHJhdHVtK3VkcDovL*"))
