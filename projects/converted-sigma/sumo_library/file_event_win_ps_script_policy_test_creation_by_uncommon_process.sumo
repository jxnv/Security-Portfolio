// Title: PSScriptPolicyTest Creation By Uncommon Process
// ID: 1027d292-dd87-4a1a-8701-2abe04d7783c
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-01
// Tags: attack.stealth
// Description: Detects the creation of the "PSScriptPolicyTest" PowerShell script by an uncommon process. This file is usually generated by Microsoft Powershell to test against Applocker.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((TargetFilename matches "*__PSScriptPolicyTest_*") and !((((Image = "C:\\Windows\\System32\\dsac.exe" or Image = "C:\\Windows\\System32\\sdiagnhost.exe" or Image = "C:\\Windows\\System32\\ServerManager.exe" or Image = "C:\\Windows\\System32\\wsmprovhost.exe" or Image = "C:\\Windows\\SysWOW64\\sdiagnhost.exe")) or ((Image = "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" or Image = "C:\\Program Files\\PowerShell\\7\\pwsh.exe" or Image = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or Image = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" or Image = "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or Image = "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")) or ((Image matches "*C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview*" or Image matches "*\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview*") and Image matches "*\\pwsh.exe"))) and !((Image matches "C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_*" and Image matches "*\\GetHelp.exe")))
