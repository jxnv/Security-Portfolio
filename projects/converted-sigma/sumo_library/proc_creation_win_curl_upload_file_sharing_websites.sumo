// Title: Curl File Upload To File Sharing Websites
// ID: e328cc73-f92a-42fb-b3fa-7c2cffda981a
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-03-29
// Tags: attack.exfiltration, attack.t1567.002
// Description: Detects usage of curl to upload files to known file sharing domains, which may indicate data exfiltration.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*0x0.st*" or CommandLine matches "*bashupload.com*" or CommandLine matches "*chunk.io*" or CommandLine matches "*file.io*" or CommandLine matches "*filebin.net*" or CommandLine matches "*pastebin*" or CommandLine matches "*send.firefox.com*" or CommandLine matches "*temp.sh*" or CommandLine matches "*transfer.sh*" or CommandLine matches "*ufile.io*" or CommandLine matches "*uploadfiles.io*" or CommandLine matches "*wetransfer.com*" or CommandLine matches "*x0.at*")) and (((CommandLine matches "* --form*" or CommandLine matches "* --upload-file*" or CommandLine matches "* --data*" or CommandLine matches "* -X POST*" or CommandLine matches "* --request POST *")) or ((CommandLine matches /\s-[FTd]\s/ or CommandLine matches /\s-sT\s/))) and ((Image matches "*\\curl.exe") or (OriginalFileName = "curl.exe")))
