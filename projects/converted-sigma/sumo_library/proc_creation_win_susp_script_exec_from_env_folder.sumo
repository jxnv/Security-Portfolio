// Title: Script Interpreter Execution From Suspicious Folder
// ID: 1228c958-e64e-4e71-92ad-7d429f4138ba
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-02-08
// Tags: attack.execution, attack.t1059
// Description: Detects suspicious script execution from suspicious directories or folders accessible by environment variables that may indicate malware activity.
// Script interpreters (cscript, wscript, mshta, powershell) executing from folders like Temp, Public, or user profile directories may suggest attempts to evade detection or execute malicious scripts.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((CommandLine matches "* -ep bypass *" or CommandLine matches "* -ExecutionPolicy bypass *" or CommandLine matches "* -w hidden *" or CommandLine matches "*/e:javascript *" or CommandLine matches "*/e:Jscript *" or CommandLine matches "*/e:vbscript *")) or ((Image matches "*\\cscript.exe" or Image matches "*\\mshta.exe" or Image matches "*\\wscript.exe")) or ((OriginalFileName = "cscript.exe" or OriginalFileName = "mshta.exe" or OriginalFileName = "wscript.exe"))) and (((CommandLine matches "*:\\Perflogs\\*" or CommandLine matches "*:\\Users\\Public\\*" or CommandLine matches "*\\%Public%*" or CommandLine matches "*\\AppData\\Local\\Temp*" or CommandLine matches "*\\AppData\\Roaming\\Temp*" or CommandLine matches "*\\Temporary Internet*" or CommandLine matches "*\\Windows\\Temp*" or CommandLine matches "*\\Start Menu\\Programs\\Startup\\*" or CommandLine matches "*%TEMP%*" or CommandLine matches "*%TMP%*" or CommandLine matches "*%LocalAppData%\\Temp*")) or (((CommandLine matches "*:\\Users\\*" and CommandLine matches "*\\Favorites\\*")) or ((CommandLine matches "*:\\Users\\*" and CommandLine matches "*\\Favourites\\*")) or ((CommandLine matches "*:\\Users\\*" and CommandLine matches "*\\Contacts\\*")) or ((CommandLine matches "*:\\Users\\*" and CommandLine matches "*\\Documents\\*")) or ((CommandLine matches "*:\\Users\\*" and CommandLine matches "*\\Music\\*")) or ((CommandLine matches "*:\\Users\\*" and CommandLine matches "*\\Pictures\\*")) or ((CommandLine matches "*:\\Users\\*" and CommandLine matches "*\\Videos\\*")))) and !(((ParentImage = "C:\\Windows\\System32\\Msiexec.exe" or ParentImage = "C:\\Windows\\SysWOW64\\Msiexec.exe") and Image matches "*\\powershell.exe" and (CommandLine matches "*-NoProfile -ExecutionPolicy Bypass -Command*" and CommandLine matches "*AppData\\Local\\Temp\\*" and CommandLine matches "*Install-Chocolatey.ps1*"))))
