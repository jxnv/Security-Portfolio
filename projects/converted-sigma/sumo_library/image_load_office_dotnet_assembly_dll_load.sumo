// Title: DotNET Assembly DLL Loaded Via Office Application
// ID: ff0f2b05-09db-4095-b96d-1b75ca24894a
// Status: test
// Level: medium
// Author: Antonlovesdnb
// Date: 2020-02-19
// Tags: attack.execution, attack.t1204.002
// Description: Detects any assembly DLL being loaded by an Office Product
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\excel.exe" or Image matches "*\\mspub.exe" or Image matches "*\\onenote.exe" or Image matches "*\\onenoteim.exe" or Image matches "*\\outlook.exe" or Image matches "*\\powerpnt.exe" or Image matches "*\\winword.exe") and ImageLoaded matches "C:\\Windows\\assembly\\*")
