// Title: Suspicious WSMAN Provider Image Loads
// ID: ad1f4bb9-8dfb-4765-adb6-2a7cfb6c0f94
// Status: test
// Level: medium
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2020-06-24
// Tags: attack.execution, attack.t1059.001, attack.lateral-movement, attack.t1021.003
// Description: Detects signs of potential use of the WSMAN provider from uncommon processes locally and remote execution.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((((ImageLoaded matches "*\\WsmSvc.dll" or ImageLoaded matches "*\\WsmAuto.dll" or ImageLoaded matches "*\\Microsoft.WSMan.Management.ni.dll")) or ((OriginalFileName = "WsmSvc.dll" or OriginalFileName = "WSMANAUTOMATION.DLL" or OriginalFileName = "Microsoft.WSMan.Management.dll"))) or (Image matches "*\\svchost.exe" and OriginalFileName = "WsmWmiPl.dll")) and !(((Image matches "C:\\Program Files\\Citrix\\*") or ((Image = "C:\\Program Files (x86)\\PowerShell\\6\\pwsh.exe" or Image = "C:\\Program Files (x86)\\PowerShell\\7\\pwsh.exe" or Image = "C:\\Program Files\\PowerShell\\6\\pwsh.exe" or Image = "C:\\Program Files\\PowerShell\\7\\pwsh.exe" or Image = "C:\\Windows\\System32\\sdiagnhost.exe" or Image = "C:\\Windows\\System32\\services.exe" or Image = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or Image = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe")) or (Image matches "C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_*" and Image matches "*\\GetHelp.exe") or (Image matches "*\\mmc.exe") or ((Image matches "C:\\Windows\\Microsoft.NET\\Framework64\\v*" or Image matches "C:\\Windows\\Microsoft.NET\\Framework\\v*" or Image matches "C:\\Windows\\Microsoft.NET\\FrameworkArm\\v*" or Image matches "C:\\Windows\\Microsoft.NET\\FrameworkArm64\\v*") and Image matches "*\\mscorsvw.exe") or (Image matches "C:\\Windows\\Temp\\asgard2-agent\\*") or ((CommandLine matches "*svchost.exe -k netsvcs -p -s BITS*" or CommandLine matches "*svchost.exe -k GraphicsPerfSvcGroup -s GraphicsPerfSvc*" or CommandLine matches "*svchost.exe -k NetworkService -p -s Wecsvc*" or CommandLine matches "*svchost.exe -k netsvcs*")) or ((Image = "C:\\Windows\\System32\\Configure-SMRemoting.exe" or Image = "C:\\Windows\\System32\\ServerManager.exe")) or (Image matches "C:\\$WINDOWS.~BT\\Sources\\*"))) and !(((Image matches "*\\svchost.exe") and (isNull(CommandLine)))))
