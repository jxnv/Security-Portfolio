// Title: Copying Sensitive Files with Credential Data
// ID: e7be6119-fc37-43f0-ad4f-1f3f99be2f9f
// Status: test
// Level: high
// Author: Teymur Kheirkhabarov, Daniil Yugoslavskiy, oscd.community
// Date: 2019-10-22
// Tags: attack.credential-access, attack.t1003.002, attack.t1003.003, car.2013-07-001, attack.s0404
// Description: Files with well-known filenames (sensitive files with credential data) copying
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((CommandLine matches "*vss*" or CommandLine matches "* /m *" or CommandLine matches "* /y *")) and ((Image matches "*\\esentutl.exe") or (OriginalFileName = "\\esentutl.exe"))) or ((CommandLine matches "*\\config\\RegBack\\sam*" or CommandLine matches "*\\config\\RegBack\\security*" or CommandLine matches "*\\config\\RegBack\\system*" or CommandLine matches "*\\config\\sam*" or CommandLine matches "*\\config\\security*" or CommandLine matches "*\\config\\system *" or CommandLine matches "*\\repair\\sam*" or CommandLine matches "*\\repair\\security*" or CommandLine matches "*\\repair\\system*" or CommandLine matches "*\\windows\\ntds\\ntds.dit*")))
