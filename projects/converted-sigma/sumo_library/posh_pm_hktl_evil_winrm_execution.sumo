// Title: HackTool - Evil-WinRm Execution - PowerShell Module
// ID: 9fe55ea2-4cd6-4491-8a54-dd6871651b51
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-02-25
// Tags: attack.lateral-movement
// Description: Detects the execution of Evil-WinRM via PowerShell Module logs by leveraging the hardcoded strings inside the utility.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((ContextInfo matches "*:\\Windows\\System32\\wsmprovhost.exe*" or ContextInfo matches "*:\\Windows\\SysWOW64\\wsmprovhost.exe*")) and (((Payload matches "*value=\"(get-location).path*" or Payload matches "*value=\"(get-item*).length*" or Payload matches "*Invoke-Binary *" or Payload matches "*Donut-Loader -process_id*-donutfile*" or Payload matches "*Bypass-4MSI*" or Payload matches "*IEX ([System.Text.Encoding]::ASCII.GetString([System.Convert]::FromBase64String($a))).replace('???','')*")) or ((Payload matches "*$servicios = Get-ItemProperty \"registry::HKLM\\System\\CurrentControlSet\\Services\\\"*" and Payload matches "*Where-Object {$_.imagepath -notmatch \"system\" -and $_.imagepath -ne $null } | Select-Object pschildname,imagepath*")) or ((Payload matches "*$a +=  \\\"$($_.FullName.Replace('\\\\','/'))/\\\"}else{  $a += \\\"$($_.FullName.Replace('\\\\', '/'))\\\" }*" and Payload matches "*$a=@();$*"))))
