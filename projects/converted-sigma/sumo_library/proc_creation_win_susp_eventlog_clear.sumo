// Title: Suspicious Eventlog Clearing or Configuration Change Activity
// ID: cc36992a-4671-4f21-a91d-6c2b72a2edf5
// Status: stable
// Level: high
// Author: Ecco, Daniil Yugoslavskiy, oscd.community, D3F7A5105, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2019-09-26
// Tags: attack.defense-impairment, attack.t1685.005, attack.t1685.001, car.2016-04-002
// Description: Detects the clearing or configuration tampering of EventLog using utilities such as "wevtutil", "powershell" and "wmic".
// This technique were seen used by threat actors and ransomware strains in order to evade defenses.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((((CommandLine matches "*clear-log *" or CommandLine matches "* cl *" or CommandLine matches "*set-log *" or CommandLine matches "* sl *" or CommandLine matches "*lfn:*")) and ((Image matches "*\\wevtutil.exe") or (OriginalFileName = "wevtutil.exe"))) or ((((CommandLine matches "*Clear-EventLog *" or CommandLine matches "*Remove-EventLog *" or CommandLine matches "*Limit-EventLog *" or CommandLine matches "*Clear-WinEvent *")) or ((CommandLine matches "*Eventing.Reader.EventLogSession*" and CommandLine matches "*ClearLog*")) or ((CommandLine matches "*Diagnostics.EventLog*" and CommandLine matches "*Clear*"))) and ((Image matches "*\\powershell.exe" or Image matches "*\\powershell_ise.exe" or Image matches "*\\pwsh.exe"))) or ((Image matches "*\\powershell.exe" or Image matches "*\\powershell_ise.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\wmic.exe") and CommandLine matches "*ClearEventLog*")) and !(((ParentImage = "C:\\Windows\\SysWOW64\\msiexec.exe" or ParentImage = "C:\\Windows\\System32\\msiexec.exe") and CommandLine matches "* sl *")))
