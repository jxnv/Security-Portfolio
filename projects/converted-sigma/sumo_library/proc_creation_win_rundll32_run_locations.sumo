// Title: Suspicious Process Start Locations
// ID: 15b75071-74cc-47e0-b4c6-b43744a62a2b
// Status: test
// Level: medium
// Author: juju4, Jonhnathan Ribeiro, oscd.community
// Date: 2019-01-16
// Tags: attack.stealth, attack.t1036, car.2013-05-002
// Description: Detects suspicious process run from unusual locations
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*:\\RECYCLER\\*" or Image matches "*:\\SystemVolumeInformation\\*")) or ((Image matches "C:\\Windows\\Tasks\\*" or Image matches "C:\\Windows\\debug\\*" or Image matches "C:\\Windows\\fonts\\*" or Image matches "C:\\Windows\\help\\*" or Image matches "C:\\Windows\\drivers\\*" or Image matches "C:\\Windows\\addins\\*" or Image matches "C:\\Windows\\cursors\\*" or Image matches "C:\\Windows\\system32\\tasks\\*")))
