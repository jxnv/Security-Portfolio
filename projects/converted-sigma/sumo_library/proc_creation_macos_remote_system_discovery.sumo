// Title: Macos Remote System Discovery
// ID: 10227522-8429-47e6-a301-f2b2d014e7ad
// Status: test
// Level: informational
// Author: Alejandro Ortuno, oscd.community
// Date: 2020-10-22
// Tags: attack.discovery, attack.t1018
// Description: Detects the enumeration of other remote systems.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*/arp" and CommandLine matches "*-a*") or (Image matches "*/ping" and (CommandLine matches "* 10.*" or CommandLine matches "* 192.168.*" or CommandLine matches "* 172.16.*" or CommandLine matches "* 172.17.*" or CommandLine matches "* 172.18.*" or CommandLine matches "* 172.19.*" or CommandLine matches "* 172.20.*" or CommandLine matches "* 172.21.*" or CommandLine matches "* 172.22.*" or CommandLine matches "* 172.23.*" or CommandLine matches "* 172.24.*" or CommandLine matches "* 172.25.*" or CommandLine matches "* 172.26.*" or CommandLine matches "* 172.27.*" or CommandLine matches "* 172.28.*" or CommandLine matches "* 172.29.*" or CommandLine matches "* 172.30.*" or CommandLine matches "* 172.31.*" or CommandLine matches "* 127.*" or CommandLine matches "* 169.254.*")))
