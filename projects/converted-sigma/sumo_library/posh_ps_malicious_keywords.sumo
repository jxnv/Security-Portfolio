// Title: Malicious PowerShell Keywords
// ID: f62176f3-8128-4faa-bf6c-83261322e5eb
// Status: test
// Level: medium
// Author: Sean Metcalf (source), Florian Roth (Nextron Systems)
// Date: 2017-03-05
// Tags: attack.execution, attack.t1059.001
// Description: Detects keywords from well-known PowerShell exploitation frameworks
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((ScriptBlockText matches "*AdjustTokenPrivileges*" or ScriptBlockText matches "*IMAGE_NT_OPTIONAL_HDR64_MAGIC*" or ScriptBlockText matches "*Metasploit*" or ScriptBlockText matches "*Microsoft.Win32.UnsafeNativeMethods*" or ScriptBlockText matches "*Mimikatz*" or ScriptBlockText matches "*MiniDumpWriteDump*" or ScriptBlockText matches "*PAGE_EXECUTE_READ*" or ScriptBlockText matches "*ReadProcessMemory.Invoke*" or ScriptBlockText matches "*SE_PRIVILEGE_ENABLED*" or ScriptBlockText matches "*SECURITY_DELEGATION*" or ScriptBlockText matches "*TOKEN_ADJUST_PRIVILEGES*" or ScriptBlockText matches "*TOKEN_ALL_ACCESS*" or ScriptBlockText matches "*TOKEN_ASSIGN_PRIMARY*" or ScriptBlockText matches "*TOKEN_DUPLICATE*" or ScriptBlockText matches "*TOKEN_ELEVATION*" or ScriptBlockText matches "*TOKEN_IMPERSONATE*" or ScriptBlockText matches "*TOKEN_INFORMATION_CLASS*" or ScriptBlockText matches "*TOKEN_PRIVILEGES*" or ScriptBlockText matches "*TOKEN_QUERY*"))
