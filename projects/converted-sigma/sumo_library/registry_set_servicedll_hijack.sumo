// Title: ServiceDll Hijack
// ID: 612e47e9-8a59-43a6-b404-f48683f45bd6
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-02-04
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects changes to the "ServiceDLL" value related to a service in the registry.
// This is often used as a method of persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((TargetObject matches "*\\System\\*" and TargetObject matches "*ControlSet*" and TargetObject matches "*\\Services\\*") and TargetObject matches "*\\Parameters\\ServiceDll") and !(((Image = "C:\\Windows\\system32\\lsass.exe" and TargetObject matches "*\\Services\\NTDS\\Parameters\\ServiceDll" and Details = "%%systemroot%%\\system32\\ntdsa.dll") or (Image = "C:\\Windows\\System32\\poqexec.exe") or (Details = "C:\\Windows\\system32\\spool\\drivers\\x64\\3\\PrintConfig.dll") or (Image matches "*\\regsvr32.exe" and TargetObject matches "*\\Services\\PrintNotify\\Parameters\\ServiceDll" and Details matches "C:\\WINDOWS\\System32\\DriverStore\\FileRepository\\*" and Details matches "*\\arm64\\PrintConfig.dll"))) and !((Image matches "*\\regsvr32.exe" and Details = "C:\\Windows\\System32\\STAgent.dll")))
