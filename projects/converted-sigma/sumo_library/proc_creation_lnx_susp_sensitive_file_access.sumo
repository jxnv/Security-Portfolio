// Title: Potential Suspicious Change To Sensitive/Critical Files
// ID: 86157017-c2b1-4d4a-8c33-93b8e67e4af4
// Status: test
// Level: medium
// Author: @d4ns4n_ (Wuerth-Phoenix)
// Date: 2023-05-30
// Tags: attack.impact, attack.t1565.001
// Description: Detects changes of sensitive and critical files. Monitors files that you don't expect to change without planning on Linux system.
// These files include, but are not limited to, system configuration files, authentication files, and critical application files.
// Attackers often target these files to maintain persistence, escalate privileges, or disrupt system operations.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((Image matches "*/cat" or Image matches "*/echo" or Image matches "*/grep" or Image matches "*/head" or Image matches "*/more" or Image matches "*/tail") and CommandLine matches "*>*") or ((Image matches "*/emacs" or Image matches "*/nano" or Image matches "*/sed" or Image matches "*/vi" or Image matches "*/vim"))) and ((CommandLine matches "*/bin/login*" or CommandLine matches "*/bin/passwd*" or CommandLine matches "*/boot/*" or CommandLine matches "*/etc/*.conf*" or CommandLine matches "*/etc/cron.*" or CommandLine matches "*/etc/crontab*" or CommandLine matches "*/etc/hosts*" or CommandLine matches "*/etc/init.d*" or CommandLine matches "*/etc/sudoers*" or CommandLine matches "*/opt/bin/*" or CommandLine matches "*/sbin*" or CommandLine matches "*/usr/bin/*" or CommandLine matches "*/usr/local/bin/*")) and !(1=1))
