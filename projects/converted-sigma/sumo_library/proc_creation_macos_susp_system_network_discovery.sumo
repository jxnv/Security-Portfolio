// Title: System Network Discovery - macOS
// ID: 58800443-f9fc-4d55-ae0c-98a3966dfb97
// Status: test
// Level: informational
// Author: remotephone, oscd.community
// Date: 2020-10-06
// Tags: attack.discovery, attack.t1016
// Description: Detects enumeration of local network configuration
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((Image matches "*/arp" or Image matches "*/ifconfig" or Image matches "*/netstat" or Image matches "*/networksetup" or Image matches "*/socketfilterfw")) or (Image = "/usr/bin/defaults" and (CommandLine matches "*/Library/Preferences/com.apple.alf*" and CommandLine matches "*read*"))) and !((ParentImage matches "*/wifivelocityd")))
