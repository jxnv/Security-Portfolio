// Title: Suspicious Shells Spawn by Java Utility Keytool
// ID: 90fb5e62-ca1f-4e22-b42e-cc521874c938
// Status: test
// Level: high
// Author: Andreas Hunkeler (@Karneades)
// Date: 2021-12-22
// Tags: attack.initial-access, attack.persistence, attack.privilege-escalation
// Description: Detects suspicious shell spawn from Java utility keytool process (e.g. adselfservice plus exploitation)
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (ParentImage matches "*\\keytool.exe" and (Image matches "*\\cmd.exe" or Image matches "*\\sh.exe" or Image matches "*\\bash.exe" or Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\schtasks.exe" or Image matches "*\\certutil.exe" or Image matches "*\\whoami.exe" or Image matches "*\\bitsadmin.exe" or Image matches "*\\wscript.exe" or Image matches "*\\cscript.exe" or Image matches "*\\scrcons.exe" or Image matches "*\\regsvr32.exe" or Image matches "*\\hh.exe" or Image matches "*\\wmic.exe" or Image matches "*\\mshta.exe" or Image matches "*\\rundll32.exe" or Image matches "*\\forfiles.exe" or Image matches "*\\scriptrunner.exe" or Image matches "*\\mftrace.exe" or Image matches "*\\AppVLP.exe" or Image matches "*\\systeminfo.exe" or Image matches "*\\reg.exe" or Image matches "*\\query.exe"))
