// Title: Potential CobaltStrike Process Patterns
// ID: f35c5d71-b489-4e22-a115-f003df287317
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-07-27
// Tags: attack.execution, attack.t1059
// Description: Detects potential process patterns related to Cobalt Strike beacon activity
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((ParentCommandLine matches "*cmd.exe /C echo*" and ParentCommandLine matches "* > \\\\\\\\.\\\\pipe*") and CommandLine matches "*conhost.exe 0xffffffff -ForceV1") or (ParentCommandLine matches "*/C whoami" and CommandLine matches "*conhost.exe 0xffffffff -ForceV1") or (CommandLine matches "*cmd.exe /C whoami" and ParentImage matches "C:\\Temp\\*") or ((ParentImage matches "*\\runonce.exe" or ParentImage matches "*\\dllhost.exe") and (CommandLine matches "*cmd.exe /c echo*" and CommandLine matches "*> \\\\\\\\.\\\\pipe*")))
