// Title: Potential PowerShell Obfuscation Via Reversed Commands
// ID: b6b49cd1-34d6-4ead-b1bf-176e9edba9a4
// Status: test
// Level: high
// Author: Teymur Kheirkhabarov (idea), Vasiliy Burov (rule), oscd.community, Tim Shelton
// Date: 2020-10-11
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects the presence of reversed PowerShell commands in the CommandLine. This is often used as a method of obfuscation by attackers
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((CommandLine matches "*hctac*" or CommandLine matches "*kaerb*" or CommandLine matches "*dnammoc*" or CommandLine matches "*ekovn*" or CommandLine matches "*eliFd*" or CommandLine matches "*rahc*" or CommandLine matches "*etirw*" or CommandLine matches "*golon*" or CommandLine matches "*tninon*" or CommandLine matches "*eddih*" or CommandLine matches "*tpircS*" or CommandLine matches "*ssecorp*" or CommandLine matches "*llehsrewop*" or CommandLine matches "*esnopser*" or CommandLine matches "*daolnwod*" or CommandLine matches "*tneilCbeW*" or CommandLine matches "*tneilc*" or CommandLine matches "*ptth*" or CommandLine matches "*elifotevas*" or CommandLine matches "*46esab*" or CommandLine matches "*htaPpmeTteG*" or CommandLine matches "*tcejbO*" or CommandLine matches "*maerts*" or CommandLine matches "*hcaerof*" or CommandLine matches "*retupmoc*")) and (((Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe")) or ((OriginalFileName = "PowerShell.EXE" or OriginalFileName = "pwsh.dll")))) and !(((CommandLine matches "* -EncodedCommand *" or CommandLine matches "* -enc *"))))
