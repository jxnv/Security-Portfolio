// Title: Suspicious Remote Logon with Explicit Credentials
// ID: 941e5c45-cda7-4864-8cea-bbb7458d194a
// Status: test
// Level: medium
// Author: oscd.community, Teymur Kheirkhabarov @HeirhabarovT, Zach Stanford @svch0st, Tim Shelton
// Date: 2020-10-05
// Tags: attack.privilege-escalation, attack.persistence, attack.initial-access, attack.stealth, attack.t1078, attack.lateral-movement
// Description: Detects suspicious processes logging on with explicit credentials
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((EventID = "4648" and (ProcessName matches "*\\cmd.exe" or ProcessName matches "*\\powershell.exe" or ProcessName matches "*\\pwsh.exe" or ProcessName matches "*\\winrs.exe" or ProcessName matches "*\\wmic.exe" or ProcessName matches "*\\net.exe" or ProcessName matches "*\\net1.exe" or ProcessName matches "*\\reg.exe")) and !(((TargetServerName = "localhost") or (SubjectUserName matches "*$" and TargetUserName matches "*$"))))
