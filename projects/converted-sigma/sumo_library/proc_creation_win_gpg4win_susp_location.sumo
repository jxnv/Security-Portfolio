// Title: File Encryption/Decryption Via Gpg4win From Suspicious Locations
// ID: e1e0b7d7-e10b-4ee4-ac49-a4bda05d320d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2022-11-30
// Tags: attack.execution
// Description: Detects usage of Gpg4win to encrypt/decrypt files located in potentially suspicious locations.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((CommandLine matches "*-passphrase*") and (((Image matches "*\\gpg.exe" or Image matches "*\\gpg2.exe")) or (Product = "GNU Privacy Guard (GnuPG)") or (Description = "GnuPG’s OpenPGP tool")) and ((CommandLine matches "*:\\PerfLogs\\*" or CommandLine matches "*:\\Temp\\*" or CommandLine matches "*:\\Users\\Public\\*" or CommandLine matches "*:\\Windows\\Temp\\*" or CommandLine matches "*\\AppData\\Local\\Temp\\*" or CommandLine matches "*\\AppData\\Roaming\\*")))
