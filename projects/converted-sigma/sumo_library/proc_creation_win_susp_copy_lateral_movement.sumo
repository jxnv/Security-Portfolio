// Title: Copy From Or To Admin Share Or Sysvol Folder
// ID: 855bc8b5-2ae8-402e-a9ed-b889e6df1900
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), oscd.community, Teymur Kheirkhabarov @HeirhabarovT, Zach Stanford @svch0st, Nasreddine Bencherchali
// Date: 2019-12-30
// Tags: attack.lateral-movement, attack.collection, attack.exfiltration, attack.t1039, attack.t1048, attack.t1021.002
// Description: Detects a copy command or a copy utility execution to or from an Admin share or remote
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*\\\\\\\\*\\\\*$*" or CommandLine matches "*\\Sysvol\\*")) and ((((Image matches "*\\robocopy.exe" or Image matches "*\\xcopy.exe")) or ((OriginalFileName = "robocopy.exe" or OriginalFileName = "XCOPY.EXE"))) or ((CommandLine matches "*copy*") and ((Image matches "*\\cmd.exe") or (OriginalFileName = "Cmd.Exe"))) or (((CommandLine matches "*copy-item*" or CommandLine matches "*copy *" or CommandLine matches "*cpi *" or CommandLine matches "* cp *" or CommandLine matches "*move *" or CommandLine matches "* move-item*" or CommandLine matches "* mi *" or CommandLine matches "* mv *")) and (((Image matches "*\\powershell_ise.exe*" or Image matches "*\\powershell.exe*" or Image matches "*\\pwsh.exe*")) or ((OriginalFileName = "powershell_ise.exe" or OriginalFileName = "PowerShell.EXE" or OriginalFileName = "pwsh.dll"))))))
