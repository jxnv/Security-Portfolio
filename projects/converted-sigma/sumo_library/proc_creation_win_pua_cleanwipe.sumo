// Title: PUA - CleanWipe Execution
// ID: f44800ac-38ec-471f-936e-3fa7d9c53100
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-12-18
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects the use of CleanWipe a tool usually used to delete Symantec antivirus.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\SepRemovalToolNative_x64.exe") or (Image matches "*\\CATClean.exe" and CommandLine matches "*--uninstall*") or (Image matches "*\\NetInstaller.exe" and CommandLine matches "*-r*") or (Image matches "*\\WFPUnins.exe" and (CommandLine matches "*/uninstall*" and CommandLine matches "*/enterprise*")))
