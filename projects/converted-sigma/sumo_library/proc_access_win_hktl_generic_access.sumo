// Title: HackTool - Generic Process Access
// ID: d0d2f720-d14f-448d-8242-51ff396a334e
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Swachchhanda Shrawan Poudel
// Date: 2023-11-27
// Tags: attack.credential-access, attack.t1003.001, attack.s0002
// Description: Detects process access requests from hacktool processes based on their default image name
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((SourceImage matches "*\\Akagi.exe" or SourceImage matches "*\\Akagi64.exe" or SourceImage matches "*\\atexec_windows.exe" or SourceImage matches "*\\Certify.exe" or SourceImage matches "*\\Certipy.exe" or SourceImage matches "*\\CoercedPotato.exe" or SourceImage matches "*\\crackmapexec.exe" or SourceImage matches "*\\CreateMiniDump.exe" or SourceImage matches "*\\dcomexec_windows.exe" or SourceImage matches "*\\dpapi_windows.exe" or SourceImage matches "*\\findDelegation_windows.exe" or SourceImage matches "*\\GetADUsers_windows.exe" or SourceImage matches "*\\GetNPUsers_windows.exe" or SourceImage matches "*\\getPac_windows.exe" or SourceImage matches "*\\getST_windows.exe" or SourceImage matches "*\\getTGT_windows.exe" or SourceImage matches "*\\GetUserSPNs_windows.exe" or SourceImage matches "*\\gmer.exe" or SourceImage matches "*\\hashcat.exe" or SourceImage matches "*\\htran.exe" or SourceImage matches "*\\ifmap_windows.exe" or SourceImage matches "*\\impersonate.exe" or SourceImage matches "*\\Inveigh.exe" or SourceImage matches "*\\LocalPotato.exe" or SourceImage matches "*\\mimikatz_windows.exe" or SourceImage matches "*\\mimikatz.exe" or SourceImage matches "*\\netview_windows.exe" or SourceImage matches "*\\nmapAnswerMachine_windows.exe" or SourceImage matches "*\\opdump_windows.exe" or SourceImage matches "*\\PasswordDump.exe" or SourceImage matches "*\\Potato.exe" or SourceImage matches "*\\PowerTool.exe" or SourceImage matches "*\\PowerTool64.exe" or SourceImage matches "*\\psexec_windows.exe" or SourceImage matches "*\\PurpleSharp.exe" or SourceImage matches "*\\pypykatz.exe" or SourceImage matches "*\\QuarksPwDump.exe" or SourceImage matches "*\\rdp_check_windows.exe" or SourceImage matches "*\\Rubeus.exe" or SourceImage matches "*\\SafetyKatz.exe" or SourceImage matches "*\\sambaPipe_windows.exe" or SourceImage matches "*\\SelectMyParent.exe" or SourceImage matches "*\\SharpChisel.exe" or SourceImage matches "*\\SharPersist.exe" or SourceImage matches "*\\SharpEvtMute.exe" or SourceImage matches "*\\SharpImpersonation.exe" or SourceImage matches "*\\SharpLDAPmonitor.exe" or SourceImage matches "*\\SharpLdapWhoami.exe" or SourceImage matches "*\\SharpUp.exe" or SourceImage matches "*\\SharpView.exe" or SourceImage matches "*\\smbclient_windows.exe" or SourceImage matches "*\\smbserver_windows.exe" or SourceImage matches "*\\sniff_windows.exe" or SourceImage matches "*\\sniffer_windows.exe" or SourceImage matches "*\\split_windows.exe" or SourceImage matches "*\\SpoolSample.exe" or SourceImage matches "*\\Stracciatella.exe" or SourceImage matches "*\\SysmonEOP.exe" or SourceImage matches "*\\temp\\rot.exe" or SourceImage matches "*\\ticketer_windows.exe" or SourceImage matches "*\\TruffleSnout.exe" or SourceImage matches "*\\winPEASany_ofs.exe" or SourceImage matches "*\\winPEASany.exe" or SourceImage matches "*\\winPEASx64_ofs.exe" or SourceImage matches "*\\winPEASx64.exe" or SourceImage matches "*\\winPEASx86_ofs.exe" or SourceImage matches "*\\winPEASx86.exe" or SourceImage matches "*\\xordump.exe")) or ((SourceImage matches "*\\goldenPac*" or SourceImage matches "*\\just_dce_*" or SourceImage matches "*\\karmaSMB*" or SourceImage matches "*\\kintercept*" or SourceImage matches "*\\LocalPotato*" or SourceImage matches "*\\ntlmrelayx*" or SourceImage matches "*\\rpcdump*" or SourceImage matches "*\\samrdump*" or SourceImage matches "*\\secretsdump*" or SourceImage matches "*\\smbexec*" or SourceImage matches "*\\smbrelayx*" or SourceImage matches "*\\wmiexec*" or SourceImage matches "*\\wmipersist*" or SourceImage matches "*HotPotato*" or SourceImage matches "*Juicy Potato*" or SourceImage matches "*JuicyPotato*" or SourceImage matches "*PetitPotam*" or SourceImage matches "*RottenPotato*")))
