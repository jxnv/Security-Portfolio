// Title: Usage of Renamed Sysinternals Tools - RegistrySet
// ID: 8023f872-3f1d-4301-a384-801889917ab4
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-24
// Tags: attack.resource-development, attack.t1588.002
// Description: Detects non-sysinternals tools setting the "accepteula" key which normally is set on sysinternals tool execution
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((TargetObject matches "*\\PsExec*" or TargetObject matches "*\\ProcDump*" or TargetObject matches "*\\Handle*" or TargetObject matches "*\\LiveKd*" or TargetObject matches "*\\Process Explorer*" or TargetObject matches "*\\PsLoglist*" or TargetObject matches "*\\PsPasswd*" or TargetObject matches "*\\Active Directory Explorer*") and TargetObject matches "*\\EulaAccepted") and !(((Image matches "*\\PsExec.exe" or Image matches "*\\PsExec64.exe" or Image matches "*\\PsExec64a.exe" or Image matches "*\\procdump.exe" or Image matches "*\\procdump64.exe" or Image matches "*\\procdump64a.exe" or Image matches "*\\handle.exe" or Image matches "*\\handle64.exe" or Image matches "*\\handle64a.exe" or Image matches "*\\livekd.exe" or Image matches "*\\livekd64.exe" or Image matches "*\\procexp.exe" or Image matches "*\\procexp64.exe" or Image matches "*\\procexp64a.exe" or Image matches "*\\psloglist.exe" or Image matches "*\\psloglist64.exe" or Image matches "*\\psloglist64a.exe" or Image matches "*\\pspasswd.exe" or Image matches "*\\pspasswd64.exe" or Image matches "*\\pspasswd64a.exe" or Image matches "*\\ADExplorer.exe" or Image matches "*\\ADExplorer64.exe" or Image matches "*\\ADExplorer64a.exe"))) and !((isNull(Image))))
