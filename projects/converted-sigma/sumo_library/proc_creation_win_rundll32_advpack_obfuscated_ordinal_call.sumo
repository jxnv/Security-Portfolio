// Title: Suspicious Advpack Call Via Rundll32.EXE
// ID: a1473adb-5338-4a20-b4c3-126763e2d3d3
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-17
// Tags: attack.stealth
// Description: Detects execution of "rundll32" calling "advpack.dll" with potential obfuscated ordinal calls in order to leverage the "RegisterOCX" function
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((CommandLine matches "*advpack*") and (((CommandLine matches "*#+*" and CommandLine matches "*12*")) or (CommandLine matches "*#-*")) and ((Image matches "*\\rundll32.exe") or (OriginalFileName = "RUNDLL32.EXE") or (CommandLine matches "*rundll32*")))
