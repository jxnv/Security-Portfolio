// Title: Execution of Powershell Script in Public Folder
// ID: fb9d3ff7-7348-46ab-af8c-b55f5fbf39b4
// Status: test
// Level: high
// Author: Max Altgelt (Nextron Systems)
// Date: 2022-04-06
// Tags: attack.execution, attack.t1059.001
// Description: This rule detects execution of PowerShell scripts located in the "C:\Users\Public" folder
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe") and (CommandLine matches "*-f C:\\Users\\Public*" or CommandLine matches "*-f \"C:\\Users\\Public*" or CommandLine matches "*-f %Public%*" or CommandLine matches "*-fi C:\\Users\\Public*" or CommandLine matches "*-fi \"C:\\Users\\Public*" or CommandLine matches "*-fi %Public%*" or CommandLine matches "*-fil C:\\Users\\Public*" or CommandLine matches "*-fil \"C:\\Users\\Public*" or CommandLine matches "*-fil %Public%*" or CommandLine matches "*-file C:\\Users\\Public*" or CommandLine matches "*-file \"C:\\Users\\Public*" or CommandLine matches "*-file %Public%*"))
