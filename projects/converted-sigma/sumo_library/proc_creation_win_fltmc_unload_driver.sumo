// Title: Filter Driver Unloaded Via Fltmc.EXE
// ID: 4931188c-178e-4ee7-a348-39e8a7a56821
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-13
// Tags: attack.stealth, attack.defense-impairment, attack.t1070, attack.t1685, attack.t1685.001
// Description: Detect filter driver unloading activity via fltmc.exe
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*unload*") and ((Image matches "*\\fltMC.exe") or (OriginalFileName = "fltMC.exe"))) and !((((ParentImage matches "*\\AppData\\Local\\Temp\\*" or ParentImage matches "*:\\Windows\\Temp\\*") and ParentImage matches "*\\endpoint-protection-installer-x64.tmp" and (CommandLine matches "*unload rtp_filesystem_filter" or CommandLine matches "*unload rtp_filter")) or (ParentImage = "C:\\Program Files (x86)\\ManageEngine\\uems_agent\\bin\\dcfaservice64.exe" and CommandLine matches "*unload DFMFilter"))))
