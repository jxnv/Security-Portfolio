// Title: ShimCache Flush
// ID: b0524451-19af-4efa-a46f-562a977f792e
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-02-01
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects actions that clear the local ShimCache and remove forensic evidence
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((CommandLine matches "*rundll32*" and CommandLine matches "*apphelp.dll*")) and ((CommandLine matches "*ShimFlushCache*" or CommandLine matches "*#250*"))) or (((CommandLine matches "*rundll32*" and CommandLine matches "*kernel32.dll*")) and ((CommandLine matches "*BaseFlushAppcompatCache*" or CommandLine matches "*#46*"))))
