// Title: Potentially Suspicious GrantedAccess Flags On LSASS
// ID: a18dd26b-6450-46de-8c91-9659150cf088
// Status: test
// Level: medium
// Author: Florian Roth, Roberto Rodriguez, Dimitrios Slamaris, Mark Russinovich, Thomas Patzke, Teymur Kheirkhabarov, Sherif Eldeeb, James Dickenson, Aleksey Potapov, oscd.community
// Date: 2021-11-22
// Tags: attack.credential-access, attack.t1003.001, attack.s0002
// Description: Detects process access requests to LSASS process with potentially suspicious access flags
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((((GrantedAccess matches "*30" or GrantedAccess matches "*50" or GrantedAccess matches "*70" or GrantedAccess matches "*90" or GrantedAccess matches "*B0" or GrantedAccess matches "*D0" or GrantedAccess matches "*F0" or GrantedAccess matches "*18" or GrantedAccess matches "*38" or GrantedAccess matches "*58" or GrantedAccess matches "*78" or GrantedAccess matches "*98" or GrantedAccess matches "*B8" or GrantedAccess matches "*D8" or GrantedAccess matches "*F8" or GrantedAccess matches "*1A" or GrantedAccess matches "*3A" or GrantedAccess matches "*5A" or GrantedAccess matches "*7A" or GrantedAccess matches "*9A" or GrantedAccess matches "*BA" or GrantedAccess matches "*DA" or GrantedAccess matches "*FA" or GrantedAccess matches "*0x14C2")) or ((GrantedAccess matches "0x100000*" or GrantedAccess matches "0x1418*" or GrantedAccess matches "0x1438*" or GrantedAccess matches "0x143a*" or GrantedAccess matches "0x1f0fff*" or GrantedAccess matches "0x1f1fff*" or GrantedAccess matches "0x1f2fff*" or GrantedAccess matches "0x1f3fff*" or GrantedAccess matches "0x40*"))) and (TargetImage matches "*\\lsass.exe")) and !(((SourceImage matches "*\\explorer.exe" and GrantedAccess = "0x401") or ((SourceImage matches "*:\\Program Files (x86)\\*" or SourceImage matches "*:\\Program Files\\*" or SourceImage matches "*:\\Windows\\System32\\*" or SourceImage matches "*:\\Windows\\SysWOW64\\*")) or (SourceImage matches "*:\\ProgramData\\Microsoft\\Windows Defender\\*" and SourceImage matches "*\\MsMpEng.exe") or ((CallTrace matches "*|?:\\ProgramData\\Microsoft\\Windows Defender\\Definition Updates\\{*" and CallTrace matches "*}\\mpengine.dll+*") and GrantedAccess = "0x1418") or ((CallTrace matches "*|c:\\program files\\windows defender\\mprtp.dll*" or CallTrace matches "*|c:\\program files\\windows defender\\MpClient.dll*")))) and !(((SourceImage matches "*:\\ProgramData\\MALWAREBYTES\\MBAMSERVICE\\ctlrupdate\\mbupdatr.exe") or (SourceImage matches "*\\MBAMInstallerService.exe" and GrantedAccess = "0x40") or ((SourceImage matches "*\\aurora-agent-64.exe" or SourceImage matches "*\\aurora-agent.exe" or SourceImage matches "*\\thor.exe" or SourceImage matches "*\\thor64.exe") and GrantedAccess = "0x40") or (SourceImage matches "*\\SteamLibrary\\steamapps\\*") or ((SourceImage matches "*\\handle.exe" or SourceImage matches "*\\handle64.exe" or SourceImage matches "*\\handle64a.exe") and GrantedAccess = "0x40") or ((SourceImage matches "*\\PROCEXP64.EXE" or SourceImage matches "*\\PROCEXP.EXE") and GrantedAccess = "0x40") or (SourceImage matches "*:\\ProgramData\\VMware\\VMware Tools\\*" and SourceImage matches "*\\vmtoolsd.exe") or (SourceImage matches "*\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe") or (SourceImage matches "*\\AppData\\Local\\WebEx\\WebexHost.exe" and GrantedAccess = "0x401"))))
