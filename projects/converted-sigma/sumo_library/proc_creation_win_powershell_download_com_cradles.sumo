// Title: Potential COM Objects Download Cradles Usage - Process Creation
// ID: 02b64f1b-3f33-4e67-aede-ef3b0a5a8fcf
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-12-25
// Tags: attack.command-and-control, attack.t1105
// Description: Detects usage of COM objects that can be abused to download files in PowerShell by CLSID
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((CommandLine matches "*[Type]::GetTypeFromCLSID(*") and ((CommandLine matches "*0002DF01-0000-0000-C000-000000000046*" or CommandLine matches "*F6D90F16-9C73-11D3-B32E-00C04F990BB4*" or CommandLine matches "*F5078F35-C551-11D3-89B9-0000F81FE221*" or CommandLine matches "*88d96a0a-f192-11d4-a65f-0040963251e5*" or CommandLine matches "*AFBA6B42-5692-48EA-8141-DC517DCF0EF1*" or CommandLine matches "*AFB40FFD-B609-40A3-9828-F88BBE11E4E3*" or CommandLine matches "*88d96a0b-f192-11d4-a65f-0040963251e5*" or CommandLine matches "*2087c2f4-2cef-4953-a8ab-66779b670495*" or CommandLine matches "*000209FF-0000-0000-C000-000000000046*" or CommandLine matches "*00024500-0000-0000-C000-000000000046*")))
