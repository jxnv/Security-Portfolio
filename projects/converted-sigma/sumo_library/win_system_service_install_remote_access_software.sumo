// Title: Remote Access Tool Services Have Been Installed - System
// ID: 1a31b18a-f00c-4061-9900-f735b96c99fc
// Status: test
// Level: medium
// Author: Connor Martin, Nasreddine Bencherchali
// Date: 2022-12-23
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1543.003, attack.t1569.002
// Description: Detects service installation of different remote access tools software. These software are often abused by threat actors to perform
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (Provider_Name = "Service Control Manager" and (EventID = "7045" or EventID = "7036") and (ServiceName matches "*AmmyyAdmin*" or ServiceName matches "*Atera*" or ServiceName matches "*BASupportExpressSrvcUpdater*" or ServiceName matches "*BASupportExpressStandaloneService*" or ServiceName matches "*chromoting*" or ServiceName matches "*GoToAssist*" or ServiceName matches "*GoToMyPC*" or ServiceName matches "*jumpcloud*" or ServiceName matches "*LMIGuardianSvc*" or ServiceName matches "*LogMeIn*" or ServiceName matches "*monblanking*" or ServiceName matches "*Parsec*" or ServiceName matches "*RManService*" or ServiceName matches "*RPCPerformanceService*" or ServiceName matches "*RPCService*" or ServiceName matches "*SplashtopRemoteService*" or ServiceName matches "*SSUService*" or ServiceName matches "*TeamViewer*" or ServiceName matches "*TightVNC*" or ServiceName matches "*vncserver*" or ServiceName matches "*Zoho*"))
