// Title: Suspicious DLL Loaded via CertOC.EXE
// ID: 84232095-ecca-4015-b0d7-7726507ee793
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-15
// Tags: attack.stealth, attack.t1218
// Description: Detects when a user installs certificates by using CertOC.exe to load the target DLL file.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((CommandLine matches "* -LoadDLL *") and ((Image matches "*\\certoc.exe") or (OriginalFileName = "CertOC.exe")) and ((CommandLine matches "*\\Appdata\\Local\\Temp\\*" or CommandLine matches "*\\Desktop\\*" or CommandLine matches "*\\Downloads\\*" or CommandLine matches "*\\Users\\Public\\*" or CommandLine matches "*C:\\Windows\\Tasks\\*" or CommandLine matches "*C:\\Windows\\Temp\\*")))
