// Title: Potential Suspicious Windows Feature Enabled
// ID: 55c925c1-7195-426b-a136-a9396800e29b
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-09-10
// Tags: attack.stealth
// Description: Detects usage of the built-in PowerShell cmdlet "Enable-WindowsOptionalFeature" used as a Deployment Image Servicing and Management tool.
// Similar to DISM.exe, this cmdlet is used to enumerate, install, uninstall, configure, and update features and packages in Windows images
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((ScriptBlockText matches "*Enable-WindowsOptionalFeature*" and ScriptBlockText matches "*-Online*" and ScriptBlockText matches "*-FeatureName*")) and ((ScriptBlockText matches "*TelnetServer*" or ScriptBlockText matches "*Internet-Explorer-Optional-amd64*" or ScriptBlockText matches "*TFTP*" or ScriptBlockText matches "*SMB1Protocol*" or ScriptBlockText matches "*Client-ProjFS*" or ScriptBlockText matches "*Microsoft-Windows-Subsystem-Linux*")))
