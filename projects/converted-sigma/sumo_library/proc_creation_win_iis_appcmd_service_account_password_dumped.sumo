// Title: Microsoft IIS Service Account Password Dumped
// ID: 2d3cdeec-c0db-45b4-aa86-082f7eb75701
// Status: test
// Level: high
// Author: Tim Rauch, Janantha Marasinghe, Elastic (original idea)
// Date: 2022-11-08
// Tags: attack.credential-access, attack.t1003
// Description: Detects the Internet Information Services (IIS) command-line tool, AppCmd, being used to list passwords
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*list *") and ((Image matches "*\\appcmd.exe") or (OriginalFileName = "appcmd.exe"))) and (((CommandLine matches "* /config*" or CommandLine matches "* /xml*" or CommandLine matches "* -config*" or CommandLine matches "* -xml*")) or (((CommandLine matches "* /@t*" or CommandLine matches "* /text*" or CommandLine matches "* /show*" or CommandLine matches "* -@t*" or CommandLine matches "* -text*" or CommandLine matches "* -show*")) and ((CommandLine matches "*:\\**" or CommandLine matches "*password*")))))
