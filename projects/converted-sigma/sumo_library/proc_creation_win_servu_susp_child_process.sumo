// Title: Suspicious Serv-U Process Pattern
// ID: 58f4ea09-0fc2-4520-ba18-b85c540b0eaf
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-07-14
// Tags: attack.credential-access, attack.t1555, cve.2021-35211
// Description: Detects a suspicious process pattern which could be a sign of an exploited Serv-U service
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (ParentImage matches "*\\Serv-U.exe" and (Image matches "*\\cmd.exe" or Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\wscript.exe" or Image matches "*\\cscript.exe" or Image matches "*\\sh.exe" or Image matches "*\\bash.exe" or Image matches "*\\schtasks.exe" or Image matches "*\\regsvr32.exe" or Image matches "*\\wmic.exe" or Image matches "*\\mshta.exe" or Image matches "*\\rundll32.exe" or Image matches "*\\msiexec.exe" or Image matches "*\\forfiles.exe" or Image matches "*\\scriptrunner.exe"))
