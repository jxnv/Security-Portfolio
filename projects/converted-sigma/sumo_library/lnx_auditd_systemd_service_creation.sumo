// Title: Systemd Service Creation
// ID: 1bac86ba-41aa-4f62-9d6b-405eac99b485
// Status: test
// Level: medium
// Author: Pawel Mazur
// Date: 2022-02-03
// Tags: attack.privilege-escalation, attack.persistence, attack.t1543.002
// Description: Detects a creation of systemd services which could be used by adversaries to execute malicious code.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((type = "PATH" and nametype = "CREATE") and (((name matches "/usr/lib/systemd/system/*" or name matches "/etc/systemd/system/*")) or (name matches "*/.config/systemd/user/*")))
