// Title: Execute From Alternate Data Streams
// ID: 7f43c430-5001-4f8b-aaa9-c3b88f18fa5c
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-09-01
// Tags: attack.stealth, attack.t1564.004
// Description: Detects execution from an Alternate Data Stream (ADS). Adversaries may use NTFS file attributes to hide their malicious data in order to evade detection
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((CommandLine matches "*txt:*") and (((CommandLine matches "*esentutl *" and CommandLine matches "* /y *" and CommandLine matches "* /d *" and CommandLine matches "* /o *")) or ((CommandLine matches "*makecab *" and CommandLine matches "*.cab*")) or ((CommandLine matches "*reg *" and CommandLine matches "* export *")) or ((CommandLine matches "*regedit *" and CommandLine matches "* /E *")) or ((CommandLine matches "*type *" and CommandLine matches "* > *"))))
