// Title: Local Network Connection Initiated By Script Interpreter
// ID: 08249dc0-a28d-4555-8ba5-9255a198e08c
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-08-28
// Tags: attack.command-and-control, attack.t1105
// Description: Detects a script interpreter (Wscript/Cscript) initiating a local network connection to download or execute a script hosted on a shared folder.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (Initiated = "true" and (Image matches "*\\wscript.exe" or Image matches "*\\cscript.exe") and (cidrMatch(DestinationIp, "127.0.0.0/8") or cidrMatch(DestinationIp, "10.0.0.0/8") or cidrMatch(DestinationIp, "172.16.0.0/12") or cidrMatch(DestinationIp, "192.168.0.0/16") or cidrMatch(DestinationIp, "169.254.0.0/16") or cidrMatch(DestinationIp, "::1/128") or cidrMatch(DestinationIp, "fe80::/10") or cidrMatch(DestinationIp, "fc00::/7")))
