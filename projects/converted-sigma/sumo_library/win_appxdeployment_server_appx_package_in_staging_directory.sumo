// Title: AppX Located in Known Staging Directory Added to Deployment Pipeline
// ID: 5cdeaf3d-1489-477c-95ab-c318559fc051
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-11
// Tags: attack.stealth
// Description: Detects an appx package that was added to the pipeline of the "to be processed" packages that is located in a known folder often used as a staging directory.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((EventID = "854") and (((Path matches "*:\\PerfLogs\\*" or Path matches "*:\\Users\\Public\\*" or Path matches "*:\\Windows\\Temp\\*" or Path matches "*\\AppdData\\Local\\Temp\\*" or Path matches "*\\Desktop\\*" or Path matches "*\\Downloads\\*")) or ((Path matches "*:/Perflogs/*" or Path matches "*:/Users/Public/*" or Path matches "*:/Windows/Temp/*" or Path matches "*/AppdData/Local/Temp/*" or Path matches "*/Desktop/*" or Path matches "*/Downloads/*"))))
