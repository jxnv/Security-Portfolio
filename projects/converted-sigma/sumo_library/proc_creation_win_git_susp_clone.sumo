// Title: Suspicious Git Clone
// ID: aef9d1f1-7396-4e92-a927-4567c7a495c1
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-03
// Tags: attack.reconnaissance, attack.t1593.003
// Description: Detects execution of "git" in order to clone a remote repository that contain suspicious keywords which might be suspicious
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "* clone *" or CommandLine matches "*git-remote-https *")) and (((Image matches "*\\git.exe" or Image matches "*\\git-remote-https.exe")) or (OriginalFileName = "git.exe")) and ((CommandLine matches "*exploit*" or CommandLine matches "*Vulns*" or CommandLine matches "*vulnerability*" or CommandLine matches "*RemoteCodeExecution*" or CommandLine matches "*Invoke-*" or CommandLine matches "*CVE-*" or CommandLine matches "*poc-*" or CommandLine matches "*ProofOfConcept*" or CommandLine matches "*proxyshell*" or CommandLine matches "*log4shell*" or CommandLine matches "*eternalblue*" or CommandLine matches "*eternal-blue*" or CommandLine matches "*MS17-*")))
