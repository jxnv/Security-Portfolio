// Title: Potential Arbitrary File Download Using Office Application
// ID: 4ae3e30b-b03f-43aa-87e3-b622f4048eed
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Beyu Denis, oscd.community
// Date: 2022-05-17
// Tags: attack.stealth, attack.t1202
// Description: Detects potential arbitrary file download using a Microsoft Office application
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*http://*" or CommandLine matches "*https://*")) and (((Image matches "*\\EXCEL.EXE" or Image matches "*\\MSOXMLED.EXE" or Image matches "*\\POWERPNT.EXE" or Image matches "*\\WINWORD.exe")) or ((OriginalFileName = "Excel.exe" or OriginalFileName = "msoxmled.exe" or OriginalFileName = "POWERPNT.EXE" or OriginalFileName = "WinWord.exe"))))
