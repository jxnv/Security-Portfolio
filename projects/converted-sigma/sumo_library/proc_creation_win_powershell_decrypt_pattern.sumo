// Title: PowerShell Execution With Potential Decryption Capabilities
// ID: 434c08ba-8406-4d15-8b24-782cb071a691
// Status: test
// Level: high
// Author: X__Junior (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-30
// Tags: attack.execution
// Description: Detects PowerShell commands that decrypt an ".LNK" "file to drop the next stage of the malware.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*Get-ChildItem *" or CommandLine matches "*dir *" or CommandLine matches "*gci *" or CommandLine matches "*ls *")) and ((CommandLine matches "*Get-Content *" or CommandLine matches "*gc *" or CommandLine matches "*cat *" or CommandLine matches "*type *" or CommandLine matches "*ReadAllBytes*")) and (((CommandLine matches "* ^| *" and CommandLine matches "*\\*.lnk*" and CommandLine matches "*-Recurse*" and CommandLine matches "*-Skip *")) or ((CommandLine matches "* -ExpandProperty *" and CommandLine matches "*\\*.lnk*" and CommandLine matches "*WriteAllBytes*" and CommandLine matches "* .length *"))) and ((Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe") and (OriginalFileName = "PowerShell.EXE" or OriginalFileName = "pwsh.dll")))
