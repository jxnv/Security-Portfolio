// Title: Suspicious RunAs-Like Flag Combination
// ID: 50d66fb0-03f8-4da0-8add-84e77d12a020
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-11-11
// Tags: attack.privilege-escalation
// Description: Detects suspicious command line flags that let the user set a target user and command as e.g. seen in PsExec-like tools
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "* -c cmd*" or CommandLine matches "* -c \"cmd*" or CommandLine matches "* -c powershell*" or CommandLine matches "* -c \"powershell*" or CommandLine matches "* --command cmd*" or CommandLine matches "* --command powershell*" or CommandLine matches "* -c whoami*" or CommandLine matches "* -c wscript*" or CommandLine matches "* -c cscript*")) and ((CommandLine matches "* -u system *" or CommandLine matches "* --user system *" or CommandLine matches "* -u NT*" or CommandLine matches "* -u \"NT*" or CommandLine matches "* -u 'NT*" or CommandLine matches "* --system *" or CommandLine matches "* -u administrator *")))
