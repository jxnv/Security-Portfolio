// Title: HackTool - SharPersist Execution
// ID: 26488ad0-f9fd-4536-876f-52fea846a2e4
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-09-15
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053
// Description: Detects the execution of the hacktool SharPersist - used to deploy various different kinds of persistence mechanisms
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "* -t schtask -c *" or CommandLine matches "* -t startupfolder -c *")) or ((CommandLine matches "* -t reg -c *" and CommandLine matches "* -m add*")) or ((CommandLine matches "* -t service -c *" and CommandLine matches "* -m add*")) or ((CommandLine matches "* -t schtask -c *" and CommandLine matches "* -m add*")) or ((Image matches "*\\SharPersist.exe") or (Product = "SharPersist")))
