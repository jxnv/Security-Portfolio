// Title: Renamed AdFind Execution
// ID: df55196f-f105-44d3-a675-e9dfb6cc2f2b
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-08-21
// Tags: attack.discovery, attack.t1018, attack.t1087.002, attack.t1482, attack.t1069.002
// Description: Detects the use of a renamed Adfind.exe. AdFind continues to be seen across majority of breaches. It is used to domain trust discovery to plan out subsequent steps in the attack chain.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((CommandLine matches "*domainlist*" or CommandLine matches "*trustdmp*" or CommandLine matches "*dcmodes*" or CommandLine matches "*adinfo*" or CommandLine matches "* dclist *" or CommandLine matches "*computer_pwdnotreqd*" or CommandLine matches "*objectcategory=*" or CommandLine matches "*-subnets -f*" or CommandLine matches "*name=\"Domain Admins\"*" or CommandLine matches "*-sc u:*" or CommandLine matches "*domainncs*" or CommandLine matches "*dompol*" or CommandLine matches "* oudmp *" or CommandLine matches "*subnetdmp*" or CommandLine matches "*gpodmp*" or CommandLine matches "*fspdmp*" or CommandLine matches "*users_noexpire*" or CommandLine matches "*computers_active*" or CommandLine matches "*computers_pwdnotreqd*")) or ((Hashes matches "*IMPHASH=BCA5675746D13A1F246E2DA3C2217492*" or Hashes matches "*IMPHASH=53E117A96057EAF19C41380D0E87F1C2*" or Hashes matches "*IMPHASH=d144de8117df2beceaba2201ad304764*" or Hashes matches "*IMPHASH=12ce1c0f3f5837ecc18a3782408fa975*" or Hashes matches "*IMPHASH=4fbf3f084fbbb2470b80b2013134df35*" or Hashes matches "*IMPHASH=49b639b4acbecc49d72a01f357aa4930*" or Hashes matches "*IMPHASH=680dad9e300346e05a85023965867201*" or Hashes matches "*IMPHASH=21aa085d54992511b9f115355e468782*")) or (OriginalFileName = "AdFind.exe")) and !((Image matches "*\\AdFind.exe")))
