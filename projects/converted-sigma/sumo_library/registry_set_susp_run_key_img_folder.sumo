// Title: New RUN Key Pointing to Suspicious Folder
// ID: 02ee49e2-e294-4d0f-9278-f5b3212fc588
// Status: experimental
// Level: high
// Author: Florian Roth (Nextron Systems), Markus Neis, Sander Wiebing, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2018-08-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects suspicious new RUN key element pointing to an executable in a suspicious folder
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((TargetObject matches "*\\Software\\Microsoft\\Windows\\CurrentVersion\\Run*" or TargetObject matches "*\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run*" or TargetObject matches "*\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\Run*")) and (((Details matches "*:\\Perflogs*" or Details matches "*:\\ProgramData'*" or Details matches "*:\\Windows\\Temp*" or Details matches "*:\\Temp*" or Details matches "*\\AppData\\Local\\Temp*" or Details matches "*\\AppData\\Roaming*" or Details matches "*:\\$Recycle.bin*" or Details matches "*:\\Users\\Default*" or Details matches "*:\\Users\\public*" or Details matches "*%temp%*" or Details matches "*%tmp%*" or Details matches "*%Public%*" or Details matches "*%AppData%*")) or ((Details matches "*:\\Users\\*") and ((Details matches "*\\Favorites*" or Details matches "*\\Favourites*" or Details matches "*\\Contacts*" or Details matches "*\\Music*" or Details matches "*\\Pictures*" or Details matches "*\\Documents*" or Details matches "*\\Photos*")))) and !((TargetObject matches "*\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\*" and Image matches "C:\\Windows\\SoftwareDistribution\\Download\\*" and (Details matches "*rundll32.exe *" and Details matches "*C:\\WINDOWS\\system32\\advpack.dll,DelNodeRunDLL32*") and (Details matches "*\\AppData\\Local\\Temp\\*" or Details matches "*C:\\Windows\\Temp\\*"))) and !(((Image matches "*C:\\Program Files\\Spotify\\Spotify.exe" or Image matches "*C:\\Program Files (x86)\\Spotify\\Spotify.exe" or Image matches "*\\AppData\\Roaming\\Spotify\\Spotify.exe") and TargetObject matches "*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\\Spotify" and Details matches "*Spotify.exe --autostart --minimized")))
