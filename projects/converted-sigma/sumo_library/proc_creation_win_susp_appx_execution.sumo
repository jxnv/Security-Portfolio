// Title: Potentially Suspicious Windows App Activity
// ID: f91ed517-a6ba-471d-9910-b3b4a398c0f3
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-12
// Tags: attack.stealth
// Description: Detects potentially suspicious child process of applications launched from inside the WindowsApps directory. This could be a sign of a rogue ".appx" package installation/execution
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((ParentImage matches "*C:\\Program Files\\WindowsApps\\*") and (((CommandLine matches "*cmd /c*" or CommandLine matches "*Invoke-*" or CommandLine matches "*Base64*")) or ((Image matches "*\\cmd.exe" or Image matches "*\\cscript.exe" or Image matches "*\\mshta.exe" or Image matches "*\\powershell.exe" or Image matches "*\\powershell_ise.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\regsvr32.exe" or Image matches "*\\rundll32.exe" or Image matches "*\\wscript.exe"))) and !(((ParentImage matches "C:\\Program Files\\WindowsApps\\Microsoft.SysinternalsSuite*" and Image matches "*\\cmd.exe") or (ParentImage matches "*:\\Program Files\\WindowsApps\\Microsoft.WindowsTerminal*" and ParentImage matches "*\\WindowsTerminal.exe" and (Image matches "*\\powershell.exe" or Image matches "*\\cmd.exe" or Image matches "*\\pwsh.exe")))))
