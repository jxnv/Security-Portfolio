// Title: Suspicious SYSTEM User Process Creation
// ID: 2617e7ed-adb7-40ba-b0f3-8f9945fe6c09
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), David ANDRE (additional keywords)
// Date: 2021-12-20
// Tags: attack.credential-access, attack.privilege-escalation, attack.stealth, attack.t1134, attack.t1003, attack.t1027
// Description: Detects a suspicious process creation as SYSTEM user (suspicious program or command line parameter)
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((IntegrityLevel = "System" or IntegrityLevel = "S-1-16-16384") and (User matches "*AUTHORI*" or User matches "*AUTORI*")) and (((Image matches "*\\calc.exe" or Image matches "*\\cscript.exe" or Image matches "*\\forfiles.exe" or Image matches "*\\hh.exe" or Image matches "*\\mshta.exe" or Image matches "*\\ping.exe" or Image matches "*\\wscript.exe")) or (CommandLine matches /net\s+user\s+/) or ((CommandLine matches "* -NoP *" or CommandLine matches "* -W Hidden *" or CommandLine matches "* -decode *" or CommandLine matches "* /decode *" or CommandLine matches "* /urlcache *" or CommandLine matches "* -urlcache *" or CommandLine matches "* -e* JAB*" or CommandLine matches "* -e* SUVYI*" or CommandLine matches "* -e* SQBFAFgA*" or CommandLine matches "* -e* aWV4I*" or CommandLine matches "* -e* IAB*" or CommandLine matches "* -e* PAA*" or CommandLine matches "* -e* aQBlAHgA*" or CommandLine matches "*vssadmin delete shadows*" or CommandLine matches "*reg SAVE HKLM*" or CommandLine matches "* -ma *" or CommandLine matches "*Microsoft\\Windows\\CurrentVersion\\Run*" or CommandLine matches "*.downloadstring(*" or CommandLine matches "*.downloadfile(*" or CommandLine matches "* /ticket:*" or CommandLine matches "*dpapi::*" or CommandLine matches "*event::clear*" or CommandLine matches "*event::drop*" or CommandLine matches "*id::modify*" or CommandLine matches "*kerberos::*" or CommandLine matches "*lsadump::*" or CommandLine matches "*misc::*" or CommandLine matches "*privilege::*" or CommandLine matches "*rpc::*" or CommandLine matches "*sekurlsa::*" or CommandLine matches "*sid::*" or CommandLine matches "*token::*" or CommandLine matches "*vault::cred*" or CommandLine matches "*vault::list*" or CommandLine matches "* p::d *" or CommandLine matches "*;iex(*" or CommandLine matches "*MiniDump*")))) and !(((ParentImage matches "*:\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\*") or ((ParentImage matches "*:\\Program Files (x86)\\Java\\*" or ParentImage matches "*:\\Program Files\\Java\\*") and ParentImage matches "*\\bin\\javaws.exe" and (Image matches "*:\\Program Files (x86)\\Java\\*" or Image matches "*:\\Program Files\\Java\\*") and Image matches "*\\bin\\jp2launcher.exe" and CommandLine matches "* -ma *") or ((CommandLine matches "*ping*" and CommandLine matches "*127.0.0.1*" and CommandLine matches "* -n *")) or (Image matches "*\\PING.EXE" and ParentCommandLine matches "*\\DismFoDInstall.cmd*"))))
