// Title: Potentially Suspicious ODBC Driver Registered
// ID: e4d22291-f3d5-4b78-9a0c-a1fbaf32a6a4
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-23
// Tags: attack.credential-access, attack.persistence, attack.t1003
// Description: Detects the registration of a new ODBC driver where the driver is located in a potentially suspicious location
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (TargetObject matches "*\\SOFTWARE\\ODBC\\ODBCINST.INI\\*" and (TargetObject matches "*\\Driver" or TargetObject matches "*\\Setup") and (Details matches "*:\\PerfLogs\\*" or Details matches "*:\\ProgramData\\*" or Details matches "*:\\Temp\\*" or Details matches "*:\\Users\\Public\\*" or Details matches "*:\\Windows\\Registration\\CRMLog*" or Details matches "*:\\Windows\\System32\\com\\dmp\\*" or Details matches "*:\\Windows\\System32\\FxsTmp\\*" or Details matches "*:\\Windows\\System32\\Microsoft\\Crypto\\RSA\\MachineKeys\\*" or Details matches "*:\\Windows\\System32\\spool\\drivers\\color\\*" or Details matches "*:\\Windows\\System32\\spool\\PRINTERS\\*" or Details matches "*:\\Windows\\System32\\spool\\SERVERS\\*" or Details matches "*:\\Windows\\System32\\Tasks_Migrated\\*" or Details matches "*:\\Windows\\System32\\Tasks\\Microsoft\\Windows\\SyncCenter\\*" or Details matches "*:\\Windows\\SysWOW64\\com\\dmp\\*" or Details matches "*:\\Windows\\SysWOW64\\FxsTmp\\*" or Details matches "*:\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\PLA\\System\\*" or Details matches "*:\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\SyncCenter\\*" or Details matches "*:\\Windows\\Tasks\\*" or Details matches "*:\\Windows\\Temp\\*" or Details matches "*:\\Windows\\Tracing\\*" or Details matches "*\\AppData\\Local\\Temp\\*" or Details matches "*\\AppData\\Roaming\\*"))
