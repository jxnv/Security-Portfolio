// Title: Office Autorun Keys Modification
// ID: baecf8fb-edbf-429f-9ade-31fc3f22b970
// Status: test
// Level: medium
// Author: Victor Sergeev, Daniil Yugoslavskiy, Gleb Sukhodolskiy, Timur Zinniatullin, oscd.community, Tim Shelton, frack113 (split)
// Date: 2019-10-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects modification of autostart extensibility point (ASEP) in registry. Adversaries may modify these keys to execute malicious code when Office files are opened.
// There are various legitimate add-ins that also use these keys and this filter list might not be exhaustive.
// Thus, it is recommended to review and tune filters for your environment to reduce false positives before deploying to production.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((TargetObject matches "*\\Word\\Addins*" or TargetObject matches "*\\PowerPoint\\Addins*" or TargetObject matches "*\\Outlook\\Addins*" or TargetObject matches "*\\Onenote\\Addins*" or TargetObject matches "*\\Excel\\Addins*" or TargetObject matches "*\\Access\\Addins*" or TargetObject matches "*test\\Special\\Perf*")) and ((TargetObject matches "*\\Software\\Wow6432Node\\Microsoft\\Office*" or TargetObject matches "*\\Software\\Microsoft\\Office*"))) and !(((Details = "(Empty)") or ((Image matches "C:\\Program Files\\Microsoft Office\\*" or Image matches "C:\\Program Files (x86)\\Microsoft Office\\*" or Image matches "C:\\PROGRA~2\\MICROS~2\\Office*" or Image matches "C:\\Windows\\System32\\msiexec.exe*" or Image matches "C:\\Windows\\SysWOW64\\msiexec.exe*" or Image matches "C:\\Windows\\System32\\regsvr32.exe*" or Image matches "C:\\Windows\\SysWOW64\\regsvr32.exe*") and (TargetObject matches "*\\Excel\\Addins\\AdHocReportingExcelClientLib.AdHocReportingExcelClientAddIn.1\\*" or TargetObject matches "*\\Excel\\Addins\\ExcelPlugInShell.PowerMapConnect\\*" or TargetObject matches "*\\Excel\\Addins\\NativeShim\\*" or TargetObject matches "*\\Excel\\Addins\\NativeShim.InquireConnector.1\\*" or TargetObject matches "*\\Excel\\Addins\\PowerPivotExcelClientAddIn.NativeEntry.1\\*" or TargetObject matches "*\\Outlook\\AddIns\\AccessAddin.DC\\*" or TargetObject matches "*\\Outlook\\AddIns\\ColleagueImport.ColleagueImportAddin\\*" or TargetObject matches "*\\Outlook\\AddIns\\EvernoteCC.EvernoteContactConnector\\*" or TargetObject matches "*\\Outlook\\AddIns\\EvernoteOLRD.Connect\\*" or TargetObject matches "*\\Outlook\\Addins\\OneNote.OutlookAddin*" or TargetObject matches "*\\Outlook\\Addins\\DriveFSExtensionLib.Connect\\*" or TargetObject matches "*\\Outlook\\Addins\\GoogleAppsSync.Connect\\*" or TargetObject matches "*\\Outlook\\Addins\\Microsoft.VbaAddinForOutlook.1\\*" or TargetObject matches "*\\Outlook\\Addins\\OcOffice.OcForms\\*" or TargetObject matches "*\\Outlook\\Addins\\OscAddin.Connect\\*" or TargetObject matches "*\\Outlook\\Addins\\OutlookChangeNotifier.Connect\\*" or TargetObject matches "*\\Outlook\\Addins\\UCAddin.LyncAddin.1*" or TargetObject matches "*\\Outlook\\Addins\\UCAddin.UCAddin.1*" or TargetObject matches "*\\Outlook\\Addins\\UmOutlookAddin.FormRegionAddin\\*" or TargetObject matches "*AddinTakeNotesService\\FriendlyName*")) or (isNull(Details)) or ((Image matches "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\*" or Image matches "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\*") and Image matches "*\\OfficeClickToRun.exe") or ((Image matches "C:\\Program Files\\Common Files\\Microsoft Shared\\VSTO\\*" or Image matches "C:\\Program Files (x86)\\Microsoft Shared\\VSTO\\*") and Image matches "*\\VSTOInstaller.exe"))) and !((((Image = "C:\\Program Files\\Avast Software\\Avast\\RegSvr.exe" or Image = "C:\\Program Files\\Avast Software\\Avast\\x86\\RegSvr.exe") and TargetObject matches "*\\Microsoft\\Office\\Outlook\\Addins\\Avast.AsOutExt\\*") or ((Image = "C:\\Program Files\\AVG\\Antivirus\\RegSvr.exe" or Image = "C:\\Program Files\\AVG\\Antivirus\\x86\\RegSvr.exe") and TargetObject matches "*\\Microsoft\\Office\\Outlook\\Addins\\Antivirus.AsOutExt\\*"))))
