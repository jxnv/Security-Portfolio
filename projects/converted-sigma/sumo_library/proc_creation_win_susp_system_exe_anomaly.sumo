// Title: System File Execution Location Anomaly
// ID: e4a6b256-3e47-40fc-89d2-7a477edd6915
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Patrick Bareiss, Anton Kutepov, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2017-11-27
// Tags: attack.stealth, attack.t1036
// Description: Detects the execution of a Windows system binary that is usually located in the system folder from an uncommon location.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*\\atbroker.exe" or Image matches "*\\audiodg.exe" or Image matches "*\\bcdedit.exe" or Image matches "*\\bitsadmin.exe" or Image matches "*\\certreq.exe" or Image matches "*\\certutil.exe" or Image matches "*\\cmstp.exe" or Image matches "*\\conhost.exe" or Image matches "*\\consent.exe" or Image matches "*\\cscript.exe" or Image matches "*\\csrss.exe" or Image matches "*\\dashost.exe" or Image matches "*\\defrag.exe" or Image matches "*\\dfrgui.exe" or Image matches "*\\dism.exe" or Image matches "*\\dllhost.exe" or Image matches "*\\dllhst3g.exe" or Image matches "*\\dwm.exe" or Image matches "*\\eventvwr.exe" or Image matches "*\\fsquirt.exe" or Image matches "*\\finger.exe" or Image matches "*\\logonui.exe" or Image matches "*\\LsaIso.exe" or Image matches "*\\lsass.exe" or Image matches "*\\lsm.exe" or Image matches "*\\msiexec.exe" or Image matches "*\\ntoskrnl.exe" or Image matches "*\\powershell_ise.exe" or Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\regsvr32.exe" or Image matches "*\\rundll32.exe" or Image matches "*\\runonce.exe" or Image matches "*\\RuntimeBroker.exe" or Image matches "*\\schtasks.exe" or Image matches "*\\services.exe" or Image matches "*\\sihost.exe" or Image matches "*\\smartscreen.exe" or Image matches "*\\smss.exe" or Image matches "*\\spoolsv.exe" or Image matches "*\\svchost.exe" or Image matches "*\\taskhost.exe" or Image matches "*\\taskhostw.exe" or Image matches "*\\Taskmgr.exe" or Image matches "*\\userinit.exe" or Image matches "*\\werfault.exe" or Image matches "*\\werfaultsecure.exe" or Image matches "*\\wininit.exe" or Image matches "*\\winlogon.exe" or Image matches "*\\winver.exe" or Image matches "*\\wlanext.exe" or Image matches "*\\wmic.exe" or Image matches "*\\wscript.exe" or Image matches "*\\wsl.exe" or Image matches "*\\wsmprovhost.exe")) and !((((Image matches "C:\\$WINDOWS.~BT\\*" or Image matches "C:\\$WinREAgent\\*" or Image matches "C:\\Windows\\SoftwareDistribution\\*" or Image matches "C:\\Windows\\System32\\*" or Image matches "C:\\Windows\\SystemTemp\\*" or Image matches "C:\\Windows\\SysWOW64\\*" or Image matches "C:\\Windows\\uus\\*" or Image matches "C:\\Windows\\WinSxS\\*")) or ((Image matches "*C:\\Program Files\\PowerShell\\7\\*" or Image matches "*C:\\Program Files\\PowerShell\\7-preview\\*" or Image matches "*C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview*" or Image matches "*\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview*") and Image matches "*\\pwsh.exe") or (Image matches "C:\\Users\\*" and Image matches "*\\AppData\\Local\\Microsoft\\WindowsApps\\*" and Image matches "*\\wsl.exe") or ((Image matches "C:\\Program Files\\WindowsApps\\MicrosoftCorporationII.WindowsSubsystemForLinux*" or Image matches "C:\\Program Files\\WSL\\*") and Image matches "*\\wsl.exe"))) and !((Image matches "*\\SystemRoot\\System32\\*")))
