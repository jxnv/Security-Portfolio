// Title: HackTool - CrackMapExec PowerShell Obfuscation
// ID: 6f8b3439-a203-45dc-a88b-abf57ea15ccf
// Status: test
// Level: high
// Author: Thomas Patzke
// Date: 2020-05-22
// Tags: attack.execution, attack.stealth, attack.t1059.001, attack.t1027.005
// Description: The CrachMapExec pentesting framework implements a PowerShell obfuscation with some static strings detected by this rule.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*join*split*" or CommandLine matches "*( $ShellId[1]+$ShellId[13]+'x')*" or CommandLine matches "*( $PSHome[*]+$PSHOME[*]+*" or CommandLine matches "*( $env:Public[13]+$env:Public[5]+'x')*" or CommandLine matches "*( $env:ComSpec[4,*,25]-Join'')*" or CommandLine matches "*[1,3]+'x'-Join'')*")) and (((Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe")) or ((OriginalFileName = "PowerShell.EXE" or OriginalFileName = "pwsh.dll"))))
