// Title: Powershell Defender Disable Scan Feature
// ID: 1ec65a5f-9473-4f12-97da-622044d6df21
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-03
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects requests to disable Microsoft Defender features using PowerShell commands
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((CommandLine matches "*Add-MpPreference *" or CommandLine matches "*Set-MpPreference *")) and ((CommandLine matches "*DisableArchiveScanning *" or CommandLine matches "*DisableRealtimeMonitoring *" or CommandLine matches "*DisableIOAVProtection *" or CommandLine matches "*DisableBehaviorMonitoring *" or CommandLine matches "*DisableBlockAtFirstSeen *" or CommandLine matches "*DisableCatchupFullScan *" or CommandLine matches "*DisableCatchupQuickScan *")) and ((CommandLine matches "*$true*" or CommandLine matches "* 1 *"))) or (((CommandLine matches "*RABpAHMAYQBiAGwAZQBSAGUAYQBsAHQAaQBtAGUATQBvAG4AaQB0AG8AcgBpAG4AZwAgA*" or CommandLine matches "*QAaQBzAGEAYgBsAGUAUgBlAGEAbAB0AGkAbQBlAE0AbwBuAGkAdABvAHIAaQBuAGcAIA*" or CommandLine matches "*EAGkAcwBhAGIAbABlAFIAZQBhAGwAdABpAG0AZQBNAG8AbgBpAHQAbwByAGkAbgBnACAA*" or CommandLine matches "*RABpAHMAYQBiAGwAZQBJAE8AQQBWAFAAcgBvAHQAZQBjAHQAaQBvAG4AIA*" or CommandLine matches "*QAaQBzAGEAYgBsAGUASQBPAEEAVgBQAHIAbwB0AGUAYwB0AGkAbwBuACAA*" or CommandLine matches "*EAGkAcwBhAGIAbABlAEkATwBBAFYAUAByAG8AdABlAGMAdABpAG8AbgAgA*" or CommandLine matches "*RABpAHMAYQBiAGwAZQBCAGUAaABhAHYAaQBvAHIATQBvAG4AaQB0AG8AcgBpAG4AZwAgA*" or CommandLine matches "*QAaQBzAGEAYgBsAGUAQgBlAGgAYQB2AGkAbwByAE0AbwBuAGkAdABvAHIAaQBuAGcAIA*" or CommandLine matches "*EAGkAcwBhAGIAbABlAEIAZQBoAGEAdgBpAG8AcgBNAG8AbgBpAHQAbwByAGkAbgBnACAA*" or CommandLine matches "*RABpAHMAYQBiAGwAZQBCAGwAbwBjAGsAQQB0AEYAaQByAHMAdABTAGUAZQBuACAA*" or CommandLine matches "*QAaQBzAGEAYgBsAGUAQgBsAG8AYwBrAEEAdABGAGkAcgBzAHQAUwBlAGUAbgAgA*" or CommandLine matches "*EAGkAcwBhAGIAbABlAEIAbABvAGMAawBBAHQARgBpAHIAcwB0AFMAZQBlAG4AIA*" or CommandLine matches "*ZABpAHMAYQBiAGwAZQByAGUAYQBsAHQAaQBtAGUAbQBvAG4AaQB0AG8AcgBpAG4AZwAgA*" or CommandLine matches "*QAaQBzAGEAYgBsAGUAcgBlAGEAbAB0AGkAbQBlAG0AbwBuAGkAdABvAHIAaQBuAGcAIA*" or CommandLine matches "*kAGkAcwBhAGIAbABlAHIAZQBhAGwAdABpAG0AZQBtAG8AbgBpAHQAbwByAGkAbgBnACAA*" or CommandLine matches "*ZABpAHMAYQBi