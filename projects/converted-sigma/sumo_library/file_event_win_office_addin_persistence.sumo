// Title: Potential Persistence Via Microsoft Office Add-In
// ID: 8e1cb247-6cf6-42fa-b440-3f27d57e9936
// Status: test
// Level: high
// Author: NVISO
// Date: 2020-05-11
// Tags: attack.persistence, attack.t1137.006
// Description: Detects potential persistence activity via startup add-ins that load when Microsoft Office starts (.wll/.xll are simply .dll fit for Word or Excel).
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((TargetFilename matches "*\\Microsoft\\Addins\\*" and (TargetFilename matches "*.xlam" or TargetFilename matches "*.xla" or TargetFilename matches "*.ppam")) or (TargetFilename matches "*\\Microsoft\\Word\\Startup\\*" and TargetFilename matches "*.wll") or (TargetFilename matches "*Microsoft\\Excel\\XLSTART\\*" and TargetFilename matches "*.xlam") or (TargetFilename matches "*\\Microsoft\\Excel\\Startup\\*" and TargetFilename matches "*.xll"))
