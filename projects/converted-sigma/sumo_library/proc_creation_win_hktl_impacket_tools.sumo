// Title: HackTool - Impacket Tools Execution
// ID: 4627c6ae-6899-46e2-aa0c-6ebcb1becd19
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-07-24
// Tags: attack.collection, attack.execution, attack.credential-access, attack.t1557.001
// Description: Detects the execution of different compiled Windows binaries of the impacket toolset (based on names or part of their names - could lead to false positives)
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*\\goldenPac*" or Image matches "*\\karmaSMB*" or Image matches "*\\kintercept*" or Image matches "*\\ntlmrelayx*" or Image matches "*\\rpcdump*" or Image matches "*\\samrdump*" or Image matches "*\\secretsdump*" or Image matches "*\\smbexec*" or Image matches "*\\smbrelayx*" or Image matches "*\\wmiexec*" or Image matches "*\\wmipersist*")) or ((Image matches "*\\atexec_windows.exe" or Image matches "*\\dcomexec_windows.exe" or Image matches "*\\dpapi_windows.exe" or Image matches "*\\findDelegation_windows.exe" or Image matches "*\\GetADUsers_windows.exe" or Image matches "*\\GetNPUsers_windows.exe" or Image matches "*\\getPac_windows.exe" or Image matches "*\\getST_windows.exe" or Image matches "*\\getTGT_windows.exe" or Image matches "*\\GetUserSPNs_windows.exe" or Image matches "*\\ifmap_windows.exe" or Image matches "*\\mimikatz_windows.exe" or Image matches "*\\netview_windows.exe" or Image matches "*\\nmapAnswerMachine_windows.exe" or Image matches "*\\opdump_windows.exe" or Image matches "*\\psexec_windows.exe" or Image matches "*\\rdp_check_windows.exe" or Image matches "*\\sambaPipe_windows.exe" or Image matches "*\\smbclient_windows.exe" or Image matches "*\\smbserver_windows.exe" or Image matches "*\\sniff_windows.exe" or Image matches "*\\sniffer_windows.exe" or Image matches "*\\split_windows.exe" or Image matches "*\\ticketer_windows.exe")))
