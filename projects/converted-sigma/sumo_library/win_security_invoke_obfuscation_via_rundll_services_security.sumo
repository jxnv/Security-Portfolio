// Title: Invoke-Obfuscation RUNDLL LAUNCHER - Security
// ID: f241cf1b-3a6b-4e1a-b4f9-133c00dd95ca
// Status: test
// Level: medium
// Author: Timur Zinniatullin, oscd.community
// Date: 2020-10-18
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via RUNDLL LAUNCHER
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (EventID = "4697" and (ServiceFileName matches "*rundll32.exe*" and ServiceFileName matches "*shell32.dll*" and ServiceFileName matches "*shellexec_rundll*" and ServiceFileName matches "*powershell*"))
