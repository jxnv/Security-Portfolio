// Title: Potential Dropper Script Execution Via WScript/CScript/MSHTA
// ID: cea72823-df4d-4567-950c-0b579eaf0846
// Status: test
// Level: medium
// Author: Margaritis Dimitrios (idea), Florian Roth (Nextron Systems), oscd.community, Nasreddine Bencherchali (Nextron Systems), Dave Johnson
// Date: 2019-01-16
// Tags: attack.execution, attack.t1059.005, attack.t1059.007
// Description: Detects wscript/cscript/mshta executions of scripts located in user directories
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*\\wscript.exe" or Image matches "*\\cscript.exe" or Image matches "*\\mshta.exe")) and ((CommandLine matches "*.hta*" or CommandLine matches "*.js*" or CommandLine matches "*.jse*" or CommandLine matches "*.vba*" or CommandLine matches "*.vbe*" or CommandLine matches "*.vbs*" or CommandLine matches "*.wsf*" or CommandLine matches "*.wsh*")) and ((CommandLine matches "*:\\Perflogs\\*" or CommandLine matches "*:\\Temp\\*" or CommandLine matches "*:\\Tmp\\*" or CommandLine matches "*:\\Users\\Public\\*" or CommandLine matches "*:\\Windows\\Temp\\*" or CommandLine matches "*\\AppData\\Local\\Temp\\*" or CommandLine matches "*\\AppData\\Roaming\\Temp\\*" or CommandLine matches "*\\Start Menu\\Programs\\Startup\\*" or CommandLine matches "*\\Temporary Internet*" or CommandLine matches "*\\Windows\\Temp*" or CommandLine matches "*%LocalAppData%\\Temp\\*" or CommandLine matches "*%TEMP%*" or CommandLine matches "*%TMP%*")))
