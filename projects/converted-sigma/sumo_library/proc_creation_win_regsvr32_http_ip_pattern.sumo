// Title: Potentially Suspicious Regsvr32 HTTP IP Pattern
// ID: 2dd2c217-bf68-437a-b57c-fe9fd01d5de8
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-01-11
// Tags: attack.stealth, attack.t1218.010
// Description: Detects regsvr32 execution to download and install DLLs located remotely where the address is an IP address.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*\\regsvr32.exe") or (OriginalFileName = "REGSVR32.EXE")) and ((CommandLine matches "* /i:http://1*" or CommandLine matches "* /i:http://2*" or CommandLine matches "* /i:http://3*" or CommandLine matches "* /i:http://4*" or CommandLine matches "* /i:http://5*" or CommandLine matches "* /i:http://6*" or CommandLine matches "* /i:http://7*" or CommandLine matches "* /i:http://8*" or CommandLine matches "* /i:http://9*" or CommandLine matches "* /i:https://1*" or CommandLine matches "* /i:https://2*" or CommandLine matches "* /i:https://3*" or CommandLine matches "* /i:https://4*" or CommandLine matches "* /i:https://5*" or CommandLine matches "* /i:https://6*" or CommandLine matches "* /i:https://7*" or CommandLine matches "* /i:https://8*" or CommandLine matches "* /i:https://9*" or CommandLine matches "* -i:http://1*" or CommandLine matches "* -i:http://2*" or CommandLine matches "* -i:http://3*" or CommandLine matches "* -i:http://4*" or CommandLine matches "* -i:http://5*" or CommandLine matches "* -i:http://6*" or CommandLine matches "* -i:http://7*" or CommandLine matches "* -i:http://8*" or CommandLine matches "* -i:http://9*" or CommandLine matches "* -i:https://1*" or CommandLine matches "* -i:https://2*" or CommandLine matches "* -i:https://3*" or CommandLine matches "* -i:https://4*" or CommandLine matches "* -i:https://5*" or CommandLine matches "* -i:https://6*" or CommandLine matches "* -i:https://7*" or CommandLine matches "* -i:https://8*" or CommandLine matches "* -i:https://9*")))
