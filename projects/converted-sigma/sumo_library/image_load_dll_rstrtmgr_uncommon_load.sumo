// Title: Load Of RstrtMgr.DLL By An Uncommon Process
// ID: 3669afd2-9891-4534-a626-e5cf03810a61
// Status: test
// Level: low
// Author: Luc Génaux
// Date: 2023-11-28
// Tags: attack.impact, attack.defense-impairment, attack.t1486, attack.t1685
// Description: Detects the load of RstrtMgr DLL (Restart Manager) by an uncommon process.
// This library has been used during ransomware campaigns to kill processes that would prevent file encryption by locking them (e.g. Conti ransomware, Cactus ransomware). It has also recently been seen used by the BiBi wiper for Windows.
// It could also be used for anti-analysis purposes by shut downing specific processes.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((ImageLoaded matches "*\\RstrtMgr.dll") or (OriginalFileName = "RstrtMgr.dll")) and !(((Image matches "C:\\Windows\\Temp\\*") or ((Image matches "C:\\$WINDOWS.~BT\\*" or Image matches "C:\\$WinREAgent\\*" or Image matches "C:\\Program Files (x86)\\*" or Image matches "C:\\Program Files\\*" or Image matches "C:\\ProgramData\\*" or Image matches "C:\\Windows\\explorer.exe*" or Image matches "C:\\Windows\\SoftwareDistribution\\*" or Image matches "C:\\Windows\\SysNative\\*" or Image matches "C:\\Windows\\System32\\*" or Image matches "C:\\Windows\\SysWOW64\\*" or Image matches "C:\\Windows\\WinSxS\\*" or Image matches "C:\\WUDownloadCache\\*")) or (Image matches "C:\\Users\\*" and (Image matches "*\\AppData\\Local\\Temp\\is-*" and Image matches "*.tmp\\*") and Image matches "*.tmp"))) and !(((Image matches "C:\\Users\\*" and (Image matches "*\\AppData\\Local\\Microsoft\\OneDrive\\OneDrive.exe" or Image matches "*\\AppData\\Local\\Microsoft\\OneDrive\\OneDriveStandaloneUpdater.exe")) or (Image matches "C:\\Users\\*" and Image matches "*\\AppData\\Local\\Microsoft\\OneDrive\\*" and Image matches "*\\OneDrive.Sync.Service.exe"))))
