// Title: Potentially Suspicious Child Processes Spawned by ConHost
// ID: dfa03a09-8b92-4d83-8e74-f72839b1c407
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-02-05
// Tags: attack.stealth, attack.t1202, attack.t1218
// Description: Detects suspicious child processes related to Windows Shell utilities spawned by `conhost.exe`, which could indicate malicious activity using trusted system components.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((Image matches "*\\cmd.exe" or Image matches "*\\cscript.exe" or Image matches "*\\mshta.exe" or Image matches "*\\powershell_ise.exe" or Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\regsvr32.exe" or Image matches "*\\wscript.exe")) or ((OriginalFileName = "cmd.exe" or OriginalFileName = "cscript.exe" or OriginalFileName = "mshta.exe" or OriginalFileName = "powershell_ise.exe" or OriginalFileName = "powershell.exe" or OriginalFileName = "pwsh.dll" or OriginalFileName = "regsvr32.exe" or OriginalFileName = "wscript.exe"))) and (ParentImage matches "*\\conhost.exe"))
