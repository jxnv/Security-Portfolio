// Title: Suspicious PowerShell Invocations - Generic - PowerShell Module
// ID: bbb80e91-5746-4fbe-8898-122e2cafdbf4
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2017-03-12
// Tags: attack.execution, attack.t1059.001
// Description: Detects suspicious PowerShell invocation command parameters
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((ContextInfo matches "* -enc *" or ContextInfo matches "* -EncodedCommand *" or ContextInfo matches "* -ec *")) and ((ContextInfo matches "* -w hidden *" or ContextInfo matches "* -window hidden *" or ContextInfo matches "* -windowstyle hidden *" or ContextInfo matches "* -w 1 *")) and ((ContextInfo matches "* -noni *" or ContextInfo matches "* -noninteractive *")))
