// Title: Backup Files Deleted
// ID: 06125661-3814-4e03-bfa2-1e4411c60ac3
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-01-02
// Tags: attack.impact, attack.t1490
// Description: Detects deletion of files with extensions often used for backup files. Adversaries may delete or remove built-in operating system data and turn off services designed to aid in the recovery of a corrupted system to prevent recovery.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\cmd.exe" or Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\wt.exe" or Image matches "*\\rundll32.exe" or Image matches "*\\regsvr32.exe") and (TargetFilename matches "*.VHD" or TargetFilename matches "*.bac" or TargetFilename matches "*.bak" or TargetFilename matches "*.wbcat" or TargetFilename matches "*.bkf" or TargetFilename matches "*.set" or TargetFilename matches "*.win" or TargetFilename matches "*.dsk"))
