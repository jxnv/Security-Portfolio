// Title: MSSQL Server Failed Logon From External Network
// ID: ebfe73c2-5bc9-4ed9-aaa8-8b54b2b4777d
// Status: test
// Level: medium
// Author: j4son
// Date: 2023-10-11
// Tags: attack.credential-access, attack.t1110
// Description: Detects failed logon attempts from clients with external network IP to an MSSQL server. This can be a sign of a bruteforce attack.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Provider_Name matches "*MSSQL*" and EventID = "18456") and !(((Data matches "*CLIENT: 10.*" or Data matches "*CLIENT: 172.16.*" or Data matches "*CLIENT: 172.17.*" or Data matches "*CLIENT: 172.18.*" or Data matches "*CLIENT: 172.19.*" or Data matches "*CLIENT: 172.20.*" or Data matches "*CLIENT: 172.21.*" or Data matches "*CLIENT: 172.22.*" or Data matches "*CLIENT: 172.23.*" or Data matches "*CLIENT: 172.24.*" or Data matches "*CLIENT: 172.25.*" or Data matches "*CLIENT: 172.26.*" or Data matches "*CLIENT: 172.27.*" or Data matches "*CLIENT: 172.28.*" or Data matches "*CLIENT: 172.29.*" or Data matches "*CLIENT: 172.30.*" or Data matches "*CLIENT: 172.31.*" or Data matches "*CLIENT: 192.168.*" or Data matches "*CLIENT: 127.*" or Data matches "*CLIENT: 169.254.*" or Data matches "*CLIENT: <local machine>*"))))
