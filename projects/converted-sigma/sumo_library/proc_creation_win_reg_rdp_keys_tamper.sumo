// Title: Potential Tampering With RDP Related Registry Keys Via Reg.EXE
// ID: 0d5675be-bc88-4172-86d3-1e96a4476536
// Status: test
// Level: high
// Author: pH-T (Nextron Systems), @Kostastsale, TheDFIRReport
// Date: 2022-02-12
// Tags: attack.persistence, attack.lateral-movement, attack.defense-impairment, attack.t1021.001, attack.t1112
// Description: Detects the execution of "reg.exe" for enabling/disabling the RDP service on the host by tampering with the 'CurrentControlSet\Control\Terminal Server' values
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((CommandLine matches "* add *" and CommandLine matches "*\\CurrentControlSet\\Control\\Terminal Server*" and CommandLine matches "*REG_DWORD*" and CommandLine matches "* /f*")) and ((Image matches "*\\reg.exe") or (OriginalFileName = "reg.exe"))) and (((CommandLine matches "*Licensing Core*" and CommandLine matches "*EnableConcurrentSessions*")) or ((CommandLine matches "*AllowTSConnections*" or CommandLine matches "*fDenyTSConnections*" or CommandLine matches "*fEnableWinStation*" or CommandLine matches "*fSingleSessionPerUser*" or CommandLine matches "*IdleWinStationPoolCount*" or CommandLine matches "*MaxInstanceCount*" or CommandLine matches "*SecurityLayer*" or CommandLine matches "*TSAdvertise*" or CommandLine matches "*TSAppCompat*" or CommandLine matches "*TSEnabled*" or CommandLine matches "*TSUserEnabled*" or CommandLine matches "*WinStations\\RDP-Tcp*"))) and !(((CommandLine matches "*SecurityLayer*" and CommandLine matches "*02*"))))
