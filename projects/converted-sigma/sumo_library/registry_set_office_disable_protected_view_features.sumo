// Title: Microsoft Office Protected View Disabled
// ID: a5c7a43f-6009-4a8c-80c5-32abf1c53ecc
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-06-08
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects changes to Microsoft Office protected view registry keys with which the attacker disables this feature.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((TargetObject matches "*\\SOFTWARE\\Microsoft\\Office\\*" and TargetObject matches "*\\Security\\ProtectedView\\*")) and ((Details = "DWORD (0x00000000)" and (TargetObject matches "*\\enabledatabasefileprotectedview" or TargetObject matches "*\\enableforeigntextfileprotectedview")) or (Details = "DWORD (0x00000001)" and (TargetObject matches "*\\DisableAttachementsInPV" or TargetObject matches "*\\DisableInternetFilesInPV" or TargetObject matches "*\\DisableIntranetCheck" or TargetObject matches "*\\DisableUnsafeLocationsInPV"))))
