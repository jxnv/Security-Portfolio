// Title: Potential Data Exfiltration Via Audio File
// ID: e4f93c99-396f-47c8-bb0f-201b1fa69034
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-16
// Tags: attack.exfiltration
// Description: Detects potential exfiltration attempt via audio file using PowerShell
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((ScriptBlockText matches "*[System.Math]::*" and ScriptBlockText matches "*[IO.FileMode]::*" and ScriptBlockText matches "*BinaryWriter*")) and ((ScriptBlockText matches "*0x52*" and ScriptBlockText matches "*0x49*" and ScriptBlockText matches "*0x46*" and ScriptBlockText matches "*0x57*" and ScriptBlockText matches "*0x41*" and ScriptBlockText matches "*0x56*" and ScriptBlockText matches "*0x45*" and ScriptBlockText matches "*0xAC*")))
