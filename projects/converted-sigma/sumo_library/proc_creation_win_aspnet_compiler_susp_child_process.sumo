// Title: Suspicious Child Process of AspNetCompiler
// ID: 9ccba514-7cb6-4c5c-b377-700758f2f120
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-08-14
// Tags: attack.execution, attack.stealth, attack.t1127
// Description: Detects potentially suspicious child processes of "aspnet_compiler.exe".
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((Image matches "*\\calc.exe" or Image matches "*\\notepad.exe")) or ((Image matches "*\\Users\\Public\\*" or Image matches "*\\AppData\\Local\\Temp\\*" or Image matches "*\\AppData\\Local\\Roaming\\*" or Image matches "*:\\Temp\\*" or Image matches "*:\\Windows\\Temp\\*" or Image matches "*:\\Windows\\System32\\Tasks\\*" or Image matches "*:\\Windows\\Tasks\\*"))) and (ParentImage matches "*\\aspnet_compiler.exe"))
