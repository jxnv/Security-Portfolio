// Title: PUA - Chisel Tunneling Tool Execution
// ID: 8b0e12da-d3c3-49db-bb4f-256703f380e5
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-09-13
// Tags: attack.command-and-control, attack.t1090.001
// Description: Detects usage of the Chisel tunneling tool via the commandline arguments
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\chisel.exe") or (((CommandLine matches "*exe client *" or CommandLine matches "*exe server *")) and ((CommandLine matches "*-socks5*" or CommandLine matches "*-reverse*" or CommandLine matches "* r:*" or CommandLine matches "*:127.0.0.1:*" or CommandLine matches "*-tls-skip-verify *" or CommandLine matches "*:socks*"))))
