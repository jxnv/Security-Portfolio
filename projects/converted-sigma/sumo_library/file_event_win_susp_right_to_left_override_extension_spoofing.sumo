// Title: Potential File Extension Spoofing Using Right-to-Left Override
// ID: 979baf41-ca44-4540-9d0c-4fcef3b5a3a4
// Status: test
// Level: high
// Author: Jonathan Peters (Nextron Systems), Florian Roth (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2024-11-17
// Tags: attack.execution, attack.stealth, attack.t1036.002
// Description: Detects suspicious filenames that contain a right-to-left override character and a potentially spoofed file extensions.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((TargetFilename matches "*3pm.*" or TargetFilename matches "*4pm.*" or TargetFilename matches "*cod.*" or TargetFilename matches "*fdp.*" or TargetFilename matches "*ftr.*" or TargetFilename matches "*gepj.*" or TargetFilename matches "*gnp.*" or TargetFilename matches "*gpj.*" or TargetFilename matches "*ism.*" or TargetFilename matches "*lmth.*" or TargetFilename matches "*nls.*" or TargetFilename matches "*piz.*" or TargetFilename matches "*slx.*" or TargetFilename matches "*tdo.*" or TargetFilename matches "*vsc.*" or TargetFilename matches "*vwm.*" or TargetFilename matches "*xcod.*" or TargetFilename matches "*xslx.*" or TargetFilename matches "*xtpp.*")) and ((TargetFilename matches "*\\u202e*" or TargetFilename matches "*[U+202E]*" or TargetFilename matches "*‮*")))
