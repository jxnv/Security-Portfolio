// Title: AADInternals PowerShell Cmdlets Execution - ProccessCreation
// ID: c86500e9-a645-4680-98d7-f882c70c1ea3
// Status: test
// Level: high
// Author: Austin Songer (@austinsonger), Nasreddine Bencherchali (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2022-12-23
// Tags: attack.execution, attack.reconnaissance, attack.discovery, attack.credential-access, attack.impact
// Description: Detects ADDInternals Cmdlet execution. A tool for administering Azure AD and Office 365. Which can be abused by threat actors to attack Azure AD or Office 365.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*Add-AADInt*" or CommandLine matches "*ConvertTo-AADInt*" or CommandLine matches "*Disable-AADInt*" or CommandLine matches "*Enable-AADInt*" or CommandLine matches "*Export-AADInt*" or CommandLine matches "*Find-AADInt*" or CommandLine matches "*Get-AADInt*" or CommandLine matches "*Grant-AADInt*" or CommandLine matches "*Initialize-AADInt*" or CommandLine matches "*Install-AADInt*" or CommandLine matches "*Invoke-AADInt*" or CommandLine matches "*Join-AADInt*" or CommandLine matches "*New-AADInt*" or CommandLine matches "*Open-AADInt*" or CommandLine matches "*Read-AADInt*" or CommandLine matches "*Register-AADInt*" or CommandLine matches "*Remove-AADInt*" or CommandLine matches "*Reset-AADInt*" or CommandLine matches "*Resolve-AADInt*" or CommandLine matches "*Restore-AADInt*" or CommandLine matches "*Save-AADInt*" or CommandLine matches "*Search-AADInt*" or CommandLine matches "*Send-AADInt*" or CommandLine matches "*Set-AADInt*" or CommandLine matches "*Start-AADInt*" or CommandLine matches "*Unprotect-AADInt*" or CommandLine matches "*Update-AADInt*")) and (((Image matches "*\\powershell.exe" or Image matches "*\\powershell_ise.exe" or Image matches "*\\pwsh.exe")) or ((OriginalFileName = "PowerShell.Exe" or OriginalFileName = "pwsh.dll"))))
