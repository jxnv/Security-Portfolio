// Title: Flush Iptables Ufw Chain
// ID: 3be619f4-d9ec-4ea8-a173-18fdd01996ab
// Status: test
// Level: medium
// Author: Joseliyo Sanchez, @Joseliyo_Jstnk
// Date: 2023-01-18
// Tags: attack.defense-impairment, attack.t1686
// Description: Detect use of iptables to flush all firewall rules, tables and chains and allow all network traffic
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*/iptables" or Image matches "*/xtables-legacy-multi" or Image matches "*/iptables-legacy-multi" or Image matches "*/ip6tables" or Image matches "*/ip6tables-legacy-multi")) and ((CommandLine matches "*-F*" or CommandLine matches "*-Z*" or CommandLine matches "*-X*")) and ((CommandLine matches "*ufw-logging-deny*" or CommandLine matches "*ufw-logging-allow*" or CommandLine matches "*ufw6-logging-deny*" or CommandLine matches "*ufw6-logging-allow*")))
