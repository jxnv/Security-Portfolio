// Title: HackTool - Rubeus Execution - ScriptBlock
// ID: 3245cd30-e015-40ff-a31d-5cadd5f377ec
// Status: test
// Level: high
// Author: Christian Burkard (Nextron Systems), Florian Roth (Nextron Systems)
// Date: 2023-04-27
// Tags: attack.credential-access, attack.t1003, attack.t1558.003, attack.lateral-movement, attack.t1550.003
// Description: Detects the execution of the hacktool Rubeus using specific command line flags
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((ScriptBlockText matches "*asreproast *" or ScriptBlockText matches "*dump /service:krbtgt *" or ScriptBlockText matches "*dump /luid:0x*" or ScriptBlockText matches "*kerberoast *" or ScriptBlockText matches "*createnetonly /program:*" or ScriptBlockText matches "*ptt /ticket:*" or ScriptBlockText matches "*/impersonateuser:*" or ScriptBlockText matches "*renew /ticket:*" or ScriptBlockText matches "*asktgt /user:*" or ScriptBlockText matches "*harvest /interval:*" or ScriptBlockText matches "*s4u /user:*" or ScriptBlockText matches "*s4u /ticket:*" or ScriptBlockText matches "*hash /password:*" or ScriptBlockText matches "*golden /aes256:*" or ScriptBlockText matches "*silver /user:*"))
