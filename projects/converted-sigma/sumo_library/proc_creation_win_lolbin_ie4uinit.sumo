// Title: Ie4uinit Lolbin Use From Invalid Path
// ID: d3bf399f-b0cf-4250-8bb4-dfc192ab81dc
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-05-07
// Tags: attack.stealth, attack.t1218
// Description: Detect use of ie4uinit.exe to execute commands from a specially prepared ie4uinit.inf file from a directory other than the usual directories
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*\\ie4uinit.exe") or (OriginalFileName = "IE4UINIT.EXE")) and !((((CurrentDirectory = "c:\\windows\\system32\\" or CurrentDirectory = "c:\\windows\\sysWOW64\\")) or (isNull(CurrentDirectory)))))
