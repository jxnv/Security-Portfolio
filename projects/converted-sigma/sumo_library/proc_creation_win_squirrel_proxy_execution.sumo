// Title: Process Proxy Execution Via Squirrel.EXE
// ID: 45239e6a-b035-4aaf-b339-8ad379fcb67e
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Karneades / Markus Neis, Jonhnathan Ribeiro, oscd.community
// Date: 2022-06-09
// Tags: attack.execution, attack.stealth, attack.t1218
// Description: Detects the usage of the "Squirrel.exe" binary to execute arbitrary processes. This binary is part of multiple Electron based software installations (Slack, Teams, Discord, etc.)
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((CommandLine matches "*--processStart*" or CommandLine matches "*--processStartAndWait*" or CommandLine matches "*--createShortcut*")) and ((Image matches "*\\squirrel.exe" or Image matches "*\\update.exe"))) and !((((CommandLine matches "*:\\Users\\*" and CommandLine matches "*\\AppData\\Local\\Discord\\Update.exe*" and CommandLine matches "*Discord.exe*") and (CommandLine matches "*--createShortcut*" or CommandLine matches "*--processStart*")) or ((CommandLine matches "*:\\Users\\*" and CommandLine matches "*\\AppData\\Local\\GitHubDesktop\\Update.exe*" and CommandLine matches "*GitHubDesktop.exe*") and (CommandLine matches "*--createShortcut*" or CommandLine matches "*--processStartAndWait*")) or ((CommandLine matches "*:\\Users\\*" and CommandLine matches "*\\AppData\\Local\\Microsoft\\Teams\\Update.exe*" and CommandLine matches "*Teams.exe*") and (CommandLine matches "*--processStart*" or CommandLine matches "*--createShortcut*")) or ((CommandLine matches "*:\\Users\\*" and CommandLine matches "*\\AppData\\Local\\yammerdesktop\\Update.exe*" and CommandLine matches "*Yammer.exe*") and (CommandLine matches "*--processStart*" or CommandLine matches "*--createShortcut*")))))
