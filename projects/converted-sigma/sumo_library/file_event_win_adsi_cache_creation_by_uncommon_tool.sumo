// Title: ADSI-Cache File Creation By Uncommon Tool
// ID: 75bf09fa-1dd7-4d18-9af9-dd9e492562eb
// Status: test
// Level: medium
// Author: xknow @xknow_infosec, Tim Shelton
// Date: 2019-03-24
// Tags: attack.t1001.003, attack.command-and-control
// Description: Detects the creation of an "Active Directory Schema Cache File" (.sch) file by an uncommon tool.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((TargetFilename matches "*\\Local\\Microsoft\\Windows\\SchCache\\*" and TargetFilename matches "*.sch") and !(((((Image matches "*:\\Program Files\\Cylance\\Desktop\\CylanceSvc.exe" or Image matches "*:\\Windows\\CCM\\CcmExec.exe" or Image matches "*:\\windows\\system32\\dllhost.exe" or Image matches "*:\\Windows\\system32\\dsac.exe" or Image matches "*:\\Windows\\system32\\efsui.exe" or Image matches "*:\\windows\\system32\\mmc.exe" or Image matches "*:\\windows\\system32\\svchost.exe" or Image matches "*:\\Windows\\System32\\wbem\\WmiPrvSE.exe" or Image matches "*:\\windows\\system32\\WindowsPowerShell\\v1.0\\powershell.exe")) or ((Image matches "*:\\Windows\\ccmsetup\\autoupgrade\\ccmsetup*" or Image matches "*:\\Program Files\\SentinelOne\\Sentinel Agent*"))) or ((Image matches "*:\\Program Files\\*" and Image matches "*\\Microsoft Office*") and Image matches "*\\OUTLOOK.EXE"))) and !(((Image matches "*:\\Program Files\\Citrix\\Receiver StoreFront\\Services\\DefaultDomainServices\\Citrix.DeliveryServices.DomainServices.ServiceHost.exe") or (Image matches "*\\LANDesk\\LDCLient\\ldapwhoami.exe"))))
