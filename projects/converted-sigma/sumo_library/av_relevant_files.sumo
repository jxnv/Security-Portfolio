// Title: Antivirus - Relevant File Paths Alerts Signature
// ID: c9a88268-0047-4824-ba6e-4d81ce0b907c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Arnim Rupp
// Date: 2018-09-09
// Tags: attack.resource-development, attack.t1588
// Description: Detects an Antivirus alert in a highly relevant file path or with a relevant file name.
// This event must not be ignored just because the AV has blocked the malware but investigate, how it came there in the first place.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Filename matches "*.asax" or Filename matches "*.ashx" or Filename matches "*.asmx" or Filename matches "*.asp" or Filename matches "*.aspx" or Filename matches "*.bat" or Filename matches "*.cfm" or Filename matches "*.cgi" or Filename matches "*.chm" or Filename matches "*.cmd" or Filename matches "*.dat" or Filename matches "*.ear" or Filename matches "*.gif" or Filename matches "*.hta" or Filename matches "*.jpeg" or Filename matches "*.jpg" or Filename matches "*.jsp" or Filename matches "*.jspx" or Filename matches "*.lnk" or Filename matches "*.msc" or Filename matches "*.php" or Filename matches "*.pl" or Filename matches "*.png" or Filename matches "*.ps1" or Filename matches "*.psm1" or Filename matches "*.py" or Filename matches "*.pyc" or Filename matches "*.rb" or Filename matches "*.scf" or Filename matches "*.sct" or Filename matches "*.sh" or Filename matches "*.svg" or Filename matches "*.txt" or Filename matches "*.vbe" or Filename matches "*.vbs" or Filename matches "*.war" or Filename matches "*.wll" or Filename matches "*.wsf" or Filename matches "*.wsh" or Filename matches "*.xll" or Filename matches "*.xml")) or ((Filename matches "*:\\PerfLogs\\*" or Filename matches "*:\\Temp\\*" or Filename matches "*:\\Users\\Default\\*" or Filename matches "*:\\Users\\Public\\*" or Filename matches "*:\\Windows\\*" or Filename matches "*/www/*" or Filename matches "*\\inetpub\\*" or Filename matches "*\\tsclient\\*" or Filename matches "*apache*" or Filename matches "*nginx*" or Filename matches "*tomcat*" or Filename matches "*weblogic*")))
