// Title: Silence.EDA Detection
// ID: 3ceb2083-a27f-449a-be33-14ec1b7cc973
// Status: test
// Level: critical
// Author: Alina Stepchenkova, Group-IB, oscd.community
// Date: 2019-11-01
// Tags: attack.execution, attack.t1059.001, attack.command-and-control, attack.t1071.004, attack.t1572, attack.impact, attack.t1529, attack.g0091, attack.s0363
// Description: Detects Silence EmpireDNSAgent as described in the Group-IP report
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((ScriptBlockText matches "*System.Diagnostics.Process*" and ScriptBlockText matches "*Stop-Computer*" and ScriptBlockText matches "*Restart-Computer*" and ScriptBlockText matches "*Exception in execution*" and ScriptBlockText matches "*$cmdargs*" and ScriptBlockText matches "*Close-Dnscat2Tunnel*")) and ((ScriptBlockText matches "*set type=$LookupType`nserver*" and ScriptBlockText matches "*$Command | nslookup 2>&1 | Out-String*" and ScriptBlockText matches "*New-RandomDNSField*" and ScriptBlockText matches "*[Convert]::ToString($SYNOptions, 16)*" and ScriptBlockText matches "*$Session.Dead = $True*" and ScriptBlockText matches "*$Session[\"Driver\"] -eq*")))
