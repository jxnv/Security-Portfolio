// Title: Interactive Bash Suspicious Children
// ID: ea3ecad2-db86-4a89-ad0b-132a10d2db55
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-14
// Tags: attack.execution, attack.stealth, attack.t1059.004, attack.t1036
// Description: Detects suspicious interactive bash as a parent to rather uncommon child processes
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((ParentCommandLine = "bash -i") and (((CommandLine matches "*-c import *" or CommandLine matches "*base64*" or CommandLine matches "*pty.spawn*")) or ((Image matches "*whoami" or Image matches "*iptables" or Image matches "*/ncat" or Image matches "*/nc" or Image matches "*/netcat"))))
