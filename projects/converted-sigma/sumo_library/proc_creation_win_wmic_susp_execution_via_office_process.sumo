// Title: Suspicious WMIC Execution Via Office Process
// ID: e1693bc8-7168-4eab-8718-cdcaa68a1738
// Status: test
// Level: high
// Author: Vadim Khrykov, Cyb3rEng
// Date: 2021-08-23
// Tags: attack.stealth, attack.t1204.002, attack.t1047, attack.t1218.010, attack.execution
// Description: Office application called wmic to proxye execution through a LOLBIN process. This is often used to break suspicious parent-child chain (Office app spawns LOLBin).
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((ParentImage matches "*\\WINWORD.EXE" or ParentImage matches "*\\EXCEL.EXE" or ParentImage matches "*\\POWERPNT.exe" or ParentImage matches "*\\MSPUB.exe" or ParentImage matches "*\\VISIO.exe" or ParentImage matches "*\\MSACCESS.EXE" or ParentImage matches "*\\EQNEDT32.EXE" or ParentImage matches "*\\ONENOTE.EXE" or ParentImage matches "*\\wordpad.exe" or ParentImage matches "*\\wordview.exe")) and ((CommandLine matches "*process*" and CommandLine matches "*create*" and CommandLine matches "*call*") and (CommandLine matches "*regsvr32*" or CommandLine matches "*rundll32*" or CommandLine matches "*msiexec*" or CommandLine matches "*mshta*" or CommandLine matches "*verclsid*" or CommandLine matches "*wscript*" or CommandLine matches "*cscript*")) and ((Image matches "*\\wbem\\WMIC.exe") or (OriginalFileName = "wmic.exe")))
