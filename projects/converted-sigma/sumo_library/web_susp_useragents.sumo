// Title: Suspicious User-Agents Related To Recon Tools
// ID: 19aa4f58-94ca-45ff-bc34-92e533c0994a
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Tim Shelton
// Date: 2022-07-19
// Tags: attack.initial-access, attack.t1190
// Description: Detects known suspicious (default) user-agents related to scanning/recon tools
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((cs-user-agent matches "*commix/*" or cs-user-agent matches "*feroxbuster/*" or cs-user-agent matches "*Fuzz Faster U Fool*" or cs-user-agent matches "*GIS - AppSec Team - Project Vision*" or cs-user-agent matches "*gobuster/*" or cs-user-agent matches "*Nikto/*" or cs-user-agent matches "*Nmap Scripting Engine*" or cs-user-agent matches "*Recon-ng/v*" or cs-user-agent matches "*sqlmap/*" or cs-user-agent matches "*WhatWeb/*" or cs-user-agent matches "*Wfuzz/*" or cs-user-agent matches "*WPScan v*" or cs-user-agent matches "*zgrab/*"))
