// Title: Remote AppX Package Downloaded from File Sharing or CDN Domain
// ID: 8b48ad89-10d8-4382-a546-50588c410f0d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-11
// Tags: attack.stealth
// Description: Detects an appx package that was added to the pipeline of the "to be processed" packages which was downloaded from a file sharing or CDN domain.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (EventID = "854" and (Path matches "*.githubusercontent.com*" or Path matches "*0x0.st*" or Path matches "*anonfiles.com*" or Path matches "*bashupload.com*" or Path matches "*cdn.discordapp.com*" or Path matches "*chunk.io*" or Path matches "*ddns.net*" or Path matches "*dl.dropboxusercontent.com*" or Path matches "*ghostbin.co*" or Path matches "*github.com*" or Path matches "*glitch.me*" or Path matches "*gofile.io*" or Path matches "*hastebin.com*" or Path matches "*mediafire.com*" or Path matches "*mega.nz*" or Path matches "*onrender.com*" or Path matches "*pages.dev*" or Path matches "*paste.ee*" or Path matches "*pastebin.com*" or Path matches "*pastebin.pl*" or Path matches "*pastetext.net*" or Path matches "*privatlab.com*" or Path matches "*privatlab.net*" or Path matches "*send.exploit.in*" or Path matches "*sendspace.com*" or Path matches "*storage.googleapis.com*" or Path matches "*storjshare.io*" or Path matches "*supabase.co*" or Path matches "*temp.sh*" or Path matches "*transfer.sh*" or Path matches "*trycloudflare.com*" or Path matches "*ufile.io*" or Path matches "*w3spaces.com*" or Path matches "*workers.dev*" or Path matches "*x0.at*"))
