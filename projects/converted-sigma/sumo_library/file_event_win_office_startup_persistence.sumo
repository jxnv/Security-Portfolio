// Title: Potential Persistence Via Microsoft Office Startup Folder
// ID: 0e20c89d-2264-44ae-8238-aeeaba609ece
// Status: test
// Level: high
// Author: Max Altgelt (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-02
// Tags: attack.persistence, attack.t1137
// Description: Detects creation of Microsoft Office files inside of one of the default startup folders in order to achieve persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((((TargetFilename matches "*.doc" or TargetFilename matches "*.docm" or TargetFilename matches "*.docx" or TargetFilename matches "*.dot" or TargetFilename matches "*.dotm" or TargetFilename matches "*.rtf")) and ((TargetFilename matches "*\\Microsoft\\Word\\STARTUP*") or ((TargetFilename matches "*\\Office*" and TargetFilename matches "*\\Program Files*" and TargetFilename matches "*\\STARTUP*")))) or (((TargetFilename matches "*.xls" or TargetFilename matches "*.xlsm" or TargetFilename matches "*.xlsx" or TargetFilename matches "*.xlt" or TargetFilename matches "*.xltm")) and ((TargetFilename matches "*\\Microsoft\\Excel\\XLSTART*") or ((TargetFilename matches "*\\Office*" and TargetFilename matches "*\\Program Files*" and TargetFilename matches "*\\XLSTART*"))))) and !(((Image matches "*\\WINWORD.exe" or Image matches "*\\EXCEL.exe"))))
