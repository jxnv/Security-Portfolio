// Title: System Network Connections Discovery Via Net.EXE
// ID: 1c67a717-32ba-409b-a45d-0fb704a73a81
// Status: test
// Level: low
// Author: frack113
// Date: 2021-12-10
// Tags: attack.discovery, attack.t1049
// Description: Adversaries may attempt to get a listing of network connections to or from the compromised system they are currently accessing or from remote systems by querying for information over the network.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((CommandLine matches "* use" or CommandLine matches "* sessions")) or ((CommandLine matches "* use *" or CommandLine matches "* sessions *"))) and (((Image matches "*\\net.exe" or Image matches "*\\net1.exe")) or ((OriginalFileName = "net.exe" or OriginalFileName = "net1.exe"))))
