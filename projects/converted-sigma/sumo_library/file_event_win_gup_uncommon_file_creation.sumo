// Title: Uncommon File Created by Notepad++ Updater Gup.EXE
// ID: 3b8f4c92-6a51-4d7e-9c3a-8e2d1f5a7b09
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-02-03
// Tags: attack.collection, attack.credential-access, attack.t1195.002, attack.initial-access, attack.t1557
// Description: Detects when the Notepad++ updater (gup.exe) creates files in suspicious or uncommon locations.
// This could indicate potential exploitation of the updater component to deliver unwanted malware or unwarranted files.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\gup.exe") and !((((TargetFilename matches "C:\\Program Files\\Notepad++\\*" or TargetFilename matches "C:\\Program Files (x86)\\Notepad++\\*")) or (((TargetFilename matches "*\\plugins\\JsonTools\\testfiles\\*" or TargetFilename matches "*\\Notepad++\\plugins\\ComparePlugin\\*")) or ((TargetFilename matches "*npp.*" and TargetFilename matches "*.portable.*" and TargetFilename matches "*\\plugins\\*"))) or (TargetFilename matches "C:\\$Recycle.Bin\\S-1-5-21*") or (TargetFilename matches "C:\\Users\\*" and (TargetFilename matches "*\\AppData\\Local\\Temp\\*" and TargetFilename matches "*.zip*")) or (TargetFilename matches "C:\\Users\\*" and (TargetFilename matches "*\\AppData\\Local\\Temp\\*" and TargetFilename matches "*npp.*" and TargetFilename matches "*.Installer.*" and TargetFilename matches "*.exe*")))))
