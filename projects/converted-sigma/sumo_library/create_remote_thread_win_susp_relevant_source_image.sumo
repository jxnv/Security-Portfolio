// Title: Rare Remote Thread Creation By Uncommon Source Image
// ID: 02d1d718-dd13-41af-989d-ea85c7fab93f
// Status: test
// Level: high
// Author: Perez Diego (@darkquassar), oscd.community
// Date: 2019-10-27
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects uncommon processes creating remote threads.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((SourceImage matches "*\\bash.exe" or SourceImage matches "*\\cscript.exe" or SourceImage matches "*\\cvtres.exe" or SourceImage matches "*\\defrag.exe" or SourceImage matches "*\\dialer.exe" or SourceImage matches "*\\dnx.exe" or SourceImage matches "*\\esentutl.exe" or SourceImage matches "*\\excel.exe" or SourceImage matches "*\\expand.exe" or SourceImage matches "*\\find.exe" or SourceImage matches "*\\findstr.exe" or SourceImage matches "*\\forfiles.exe" or SourceImage matches "*\\gpupdate.exe" or SourceImage matches "*\\hh.exe" or SourceImage matches "*\\installutil.exe" or SourceImage matches "*\\lync.exe" or SourceImage matches "*\\makecab.exe" or SourceImage matches "*\\mDNSResponder.exe" or SourceImage matches "*\\monitoringhost.exe" or SourceImage matches "*\\msbuild.exe" or SourceImage matches "*\\mshta.exe" or SourceImage matches "*\\mspaint.exe" or SourceImage matches "*\\outlook.exe" or SourceImage matches "*\\ping.exe" or SourceImage matches "*\\provtool.exe" or SourceImage matches "*\\python.exe" or SourceImage matches "*\\regsvr32.exe" or SourceImage matches "*\\robocopy.exe" or SourceImage matches "*\\runonce.exe" or SourceImage matches "*\\sapcimc.exe" or SourceImage matches "*\\smartscreen.exe" or SourceImage matches "*\\spoolsv.exe" or SourceImage matches "*\\tstheme.exe" or SourceImage matches "*\\userinit.exe" or SourceImage matches "*\\vssadmin.exe" or SourceImage matches "*\\vssvc.exe" or SourceImage matches "*\\w3wp.exe" or SourceImage matches "*\\winscp.exe" or SourceImage matches "*\\winword.exe" or SourceImage matches "*\\wmic.exe" or SourceImage matches "*\\wscript.exe")) and !((((SourceImage = "C:\\Windows\\System32\\Defrag.exe" or SourceImage = "C:\\Windows\\System32\\makecab.exe") and TargetImage = "C:\\Windows\\System32\\conhost.exe") or ((SourceImage matches "C:\\Program Files\\Microsoft Office\\*" or SourceImage matches "C:\\Program Files (x86)\\Microsoft Office\\*") and TargetImage = "System") or (SourceImage = "C:\\Windows\\System32\\provtool.exe" and TargetImage = "C:\\Windows\\System32\\svchost.exe") or (SourceImage = "C:\\Windows\\System32\\provtool.exe" and TargetImage = "System") or (SourceImage = "C:\\Windows\\System32\\userinit.exe" and TargetImage = "C:\\Windows\\explorer.exe") or (SourceImage matches "*\\WINWORD.EXE" and (TargetImage matches "C:\\Program Files (x86)\\*" or TargetImage matches "C:\\Program Files\\*")))) and !((SourceImage matches "*\\SysWOW64\\explorer.exe" and (TargetImage = "C:\\Program Files (x86)\\VMware\\VMware Tools\\vmtoolsd.exe" or TargetImage = "C:\\Program Files\\VMware\\VMware Tools\\vmtoolsd.exe"))))
