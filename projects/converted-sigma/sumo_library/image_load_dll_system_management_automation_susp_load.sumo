// Title: PowerShell Core DLL Loaded By Non PowerShell Process
// ID: 092bc4b9-3d1d-43b4-a6b4-8c8acd83522f
// Status: test
// Level: medium
// Author: Tom Kern, oscd.community, Natalia Shornikova, Tim Shelton, Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2019-11-14
// Tags: attack.t1059.001, attack.execution
// Description: Detects loading of essential DLLs used by PowerShell by non-PowerShell process.
// Detects behavior similar to meterpreter's "load powershell" extension.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Description = "System.Management.Automation") or (OriginalFileName = "System.Management.Automation.dll") or ((ImageLoaded matches "*\\System.Management.Automation.dll" or ImageLoaded matches "*\\System.Management.Automation.ni.dll"))) and !((((Image matches "C:\\Windows\\Microsoft.NET\\Framework\\*" or Image matches "C:\\Windows\\Microsoft.NET\\FrameworkArm\\*" or Image matches "C:\\Windows\\Microsoft.NET\\FrameworkArm64\\*" or Image matches "C:\\Windows\\Microsoft.NET\\Framework64\\*") and Image matches "*\\mscorsvw.exe") or ((Image = "C:\\Windows\\System32\\dsac.exe" or Image = "C:\\WINDOWS\\System32\\RemoteFXvGPUDisablement.exe" or Image = "C:\\Windows\\System32\\runscripthelper.exe" or Image = "C:\\WINDOWS\\System32\\sdiagnhost.exe" or Image = "C:\\Windows\\System32\\ServerManager.exe" or Image = "C:\\Windows\\System32\\SyncAppvPublishingServer.exe" or Image = "C:\\Windows\\System32\\winrshost.exe" or Image = "C:\\Windows\\System32\\wsmprovhost.exe" or Image = "C:\\Windows\\SysWOW64\\winrshost.exe" or Image = "C:\\Windows\\SysWOW64\\wsmprovhost.exe")) or ((Image = "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" or Image = "C:\\Program Files\\PowerShell\\7\\pwsh.exe" or Image = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or Image = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" or Image = "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or Image = "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")) or ((Image matches "*C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview*" or Image matches "*\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview*") and Image matches "*\\pwsh.exe"))) and !(((isNull(Image)) or (Image matches "C:\\ProgramData\\chocolatey\\choco.exe*") or (Image matches "*\\Citrix\\ConfigSync\\ConfigSyncRun.exe") or (Image matches "C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_*" and Image matches "*\\GetHelp.exe") or (Image matches "C:\\Windows\\Temp\\asgard2-agent\\*" and (Image matches "*\\thor64.exe" or Image matches "*\\thor.exe")) or ((Image matches "C:\\Program Files (x86)\\Microsoft SQL Server Management Studio*" or Image matches "C:\\Program Files\\Microsoft SQL Server Management Studio*") and Image matches "*\\IDE\\Ssms.exe") or ((Image matches "C:\\Program Files (x86)\\Microsoft SQL Server\\*" or Image matches "C:\\Program Files\\Microsoft SQL Server\\*") and Image matches "*\\Tools\\Binn\\SQLPS.exe") or ((Image matches "C:\\Program Files (x86)\\Microsoft Visual Studio\\*" or Image matches "C:\\Program Files\\Microsoft Visual Studio\\*")))))
