// Title: Potential Persistence Attempt Via Run Keys Using Reg.EXE
// ID: de587dce-915e-4218-aac4-835ca6af6f70
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2021-06-28
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects suspicious command line reg.exe tool adding key to RUN key in Registry
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (Image matches "*\\reg.exe" and (CommandLine matches "*reg*" and CommandLine matches "* add *") and (CommandLine matches "*Software\\Microsoft\\Windows\\CurrentVersion\\Run*" or CommandLine matches "*\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run*" or CommandLine matches "*\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\Run*"))
