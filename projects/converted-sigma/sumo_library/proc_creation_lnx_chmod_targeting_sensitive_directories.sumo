// Title: Chmod Targeting Sensitive Directories
// ID: 6419afd1-3742-47a5-a7e6-b50386cd15f8
// Status: test
// Level: medium
// Author: Christopher Peacock @SecurePeacock, SCYTHE @scythe_io
// Date: 2022-06-03
// Tags: attack.defense-impairment, attack.t1222.002
// Description: Detects chmod targeting files in sensitive directory paths on Linux systems.
// Attackers may use chmod to change permissions of files in these directories to maintain persistence, escalate privileges, or disrupt system operations.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*/chmod" and (CommandLine matches "*/tmp/*" or CommandLine matches "*/.Library/*" or CommandLine matches "*/etc/*" or CommandLine matches "*/opt/*")) and !(((CommandLine matches "chmod 700 /tmp/apt-key-gpghome.*") or (CommandLine = "chmod 0775 /etc/landscape/") or (CommandLine matches "chmod 755 /var/tmp/mkinitramfs*") or (CommandLine matches "*/etc/*" and (ParentCommandLine matches "*/var/lib/dpkg/info/*" and ParentCommandLine matches "*.postinst configure*")) or (CommandLine = "chmod 644 /etc/apparmor.d/tunables/home.d/ubuntu") or (CommandLine matches "*chmod --reference=/etc/shells*" and ParentCommandLine matches "*/update-shells"))))
