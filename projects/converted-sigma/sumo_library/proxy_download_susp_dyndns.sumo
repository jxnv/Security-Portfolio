// Title: Download from Suspicious Dyndns Hosts
// ID: 195c1119-ef07-4909-bb12-e66f5e07bf3c
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2017-11-08
// Tags: attack.command-and-control, attack.t1105, attack.t1568
// Description: Detects download of certain file types from hosts with dynamic DNS names (selected list)
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((c-uri-extension = "exe" or c-uri-extension = "vbs" or c-uri-extension = "bat" or c-uri-extension = "rar" or c-uri-extension = "ps1" or c-uri-extension = "doc" or c-uri-extension = "docm" or c-uri-extension = "xls" or c-uri-extension = "xlsm" or c-uri-extension = "pptm" or c-uri-extension = "rtf" or c-uri-extension = "hta" or c-uri-extension = "dll" or c-uri-extension = "ws" or c-uri-extension = "wsf" or c-uri-extension = "sct" or c-uri-extension = "zip") and (cs-host matches "*.hopto.org" or cs-host matches "*.no-ip.org" or cs-host matches "*.no-ip.info" or cs-host matches "*.no-ip.biz" or cs-host matches "*.no-ip.com" or cs-host matches "*.noip.com" or cs-host matches "*.ddns.name" or cs-host matches "*.myftp.org" or cs-host matches "*.myftp.biz" or cs-host matches "*.serveblog.net" or cs-host matches "*.servebeer.com" or cs-host matches "*.servemp3.com" or cs-host matches "*.serveftp.com" or cs-host matches "*.servequake.com" or cs-host matches "*.servehalflife.com" or cs-host matches "*.servehttp.com" or cs-host matches "*.servegame.com" or cs-host matches "*.servepics.com" or cs-host matches "*.myvnc.com" or cs-host matches "*.ignorelist.com" or cs-host matches "*.jkub.com" or cs-host matches "*.dlinkddns.com" or cs-host matches "*.jumpingcrab.com" or cs-host matches "*.ddns.info" or cs-host matches "*.mooo.com" or cs-host matches "*.dns-dns.com" or cs-host matches "*.strangled.net" or cs-host matches "*.adultdns.net" or cs-host matches "*.craftx.biz" or cs-host matches "*.ddns01.com" or cs-host matches "*.dns53.biz" or cs-host matches "*.dnsapi.info" or cs-host matches "*.dnsd.info" or cs-host matches "*.dnsdynamic.com" or cs-host matches "*.dnsdynamic.net" or cs-host matches "*.dnsget.org" or cs-host matches "*.fe100.net" or cs-host matches "*.flashserv.net" or cs-host matches "*.ftp21.net" or cs-host matches "*.http01.com" or cs-host matches "*.http80.info" or cs-host matches "*.https443.com" or cs-host matches "*.imap01.com" or cs-host matches "*.kadm5.com" or cs-host matches "*.mysq1.net" or cs-host matches "*.ns360.info" or cs-host matches "*.ntdll.net" or cs-host matches "*.ole32.com" or cs-host matches "*.proxy8080.com" or cs-host matches "*.sql01.com" or cs-host matches "*.ssh01.com" or cs-host matches "*.ssh22.net" or cs-host matches "*.tempors.com" or cs-host matches "*.tftpd.net" or cs-host matches "*.ttl60.com" or cs-host matches "*.ttl60.org" or cs-host matches "*.user32.com" or cs-host matches "*.voip01.com" or cs-host matches "*.wow64.net" or cs-host matches "*.x64.me" or cs-host matches "*.xns01.com" or cs-host matches "*.dyndns.org" or cs-host matches "*.dyndns.info" or cs-host matches "*.dyndns.tv" or cs-host matches "*.dyndns-at-home.com" or cs-host matches "*.dnsomatic.com" or cs-host matches "*.zapto.org" or cs-host matches "*.webhop.net" or cs-host matches "*.25u.com" or cs-host matches "*.slyip.net"))
