// Title: PowerShell Base64 Encoded WMI Classes
// ID: 1816994b-42e1-4fb1-afd2-134d88184f71
// Status: test
// Level: high
// Author: Christian Burkard (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-30
// Tags: attack.execution, attack.stealth, attack.t1059.001, attack.t1027
// Description: Detects calls to base64 encoded WMI class such as "Win32_ShadowCopy", "Win32_ScheduledJob", etc.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe")) or ((OriginalFileName = "PowerShell.EXE" or OriginalFileName = "pwsh.dll"))) and (((CommandLine matches "*VwBpAG4AMwAyAF8ATABvAGcAZwBlAGQATwBuAFUAcwBlAHIA*" or CommandLine matches "*cAaQBuADMAMgBfAEwAbwBnAGcAZQBkAE8AbgBVAHMAZQByA*" or CommandLine matches "*XAGkAbgAzADIAXwBMAG8AZwBnAGUAZABPAG4AVQBzAGUAcg*" or CommandLine matches "*V2luMzJfTG9nZ2VkT25Vc2Vy*" or CommandLine matches "*dpbjMyX0xvZ2dlZE9uVXNlc*" or CommandLine matches "*XaW4zMl9Mb2dnZWRPblVzZX*")) or ((CommandLine matches "*VwBpAG4AMwAyAF8AUAByAG8AYwBlAHMAcw*" or CommandLine matches "*cAaQBuADMAMgBfAFAAcgBvAGMAZQBzAHMA*" or CommandLine matches "*XAGkAbgAzADIAXwBQAHIAbwBjAGUAcwBzA*" or CommandLine matches "*V2luMzJfUHJvY2Vzc*" or CommandLine matches "*dpbjMyX1Byb2Nlc3*" or CommandLine matches "*XaW4zMl9Qcm9jZXNz*")) or ((CommandLine matches "*VwBpAG4AMwAyAF8AUwBjAGgAZQBkAHUAbABlAGQASgBvAGIA*" or CommandLine matches "*cAaQBuADMAMgBfAFMAYwBoAGUAZAB1AGwAZQBkAEoAbwBiA*" or CommandLine matches "*XAGkAbgAzADIAXwBTAGMAaABlAGQAdQBsAGUAZABKAG8AYg*" or CommandLine matches "*V2luMzJfU2NoZWR1bGVkSm9i*" or CommandLine matches "*dpbjMyX1NjaGVkdWxlZEpvY*" or CommandLine matches "*XaW4zMl9TY2hlZHVsZWRKb2*")) or ((CommandLine matches "*VwBpAG4AMwAyAF8AUwBoAGEAZABvAHcAYwBvAHAAeQ*" or CommandLine matches "*cAaQBuADMAMgBfAFMAaABhAGQAbwB3AGMAbwBwAHkA*" or CommandLine matches "*XAGkAbgAzADIAXwBTAGgAYQBkAG8AdwBjAG8AcAB5A*" or CommandLine matches "*V2luMzJfU2hhZG93Y29we*" or CommandLine matches "*dpbjMyX1NoYWRvd2NvcH*" or CommandLine matches "*XaW4zMl9TaGFkb3djb3B5*")) or ((CommandLine matches "*VwBpAG4AMwAyAF8AVQBzAGUAcgBBAGMAYwBvAHUAbgB0A*" or CommandLine matches "*cAaQBuADMAMgBfAFUAcwBlAHIAQQBjAGMAbwB1AG4AdA*" or CommandLine matches "*XAGkAbgAzADIAXwBVAHMAZQByAEEAYwBjAG8AdQBuAHQA*" or CommandLine matches "*V2luMzJfVXNlckFjY291bn*" or CommandLine matches "*dpbjMyX1VzZXJBY2NvdW50*" or CommandLine matches "*XaW4zMl9Vc2VyQWNjb3Vud*"))))
