_sourceCategory=* | where ((query matches "*.hiddenservice.net" or query matches "*.onion.ca" or query matches "*.onion.cab" or query matches "*.onion.casa" or query matches "*.onion.city" or query matches "*.onion.direct" or query matches "*.onion.dog" or query matches "*.onion.glass" or query matches "*.onion.gq" or query matches "*.onion.guide" or query matches "*.onion.in.net" or query matches "*.onion.ink" or query matches "*.onion.it" or query matches "*.onion.link" or query matches "*.onion.lt" or query matches "*.onion.lu" or query matches "*.onion.ly" or query matches "*.onion.mn" or query matches "*.onion.network" or query matches "*.onion.nu" or query matches "*.onion.pet" or query matches "*.onion.plus" or query matches "*.onion.pt" or query matches "*.onion.pw" or query matches "*.onion.rip" or query matches "*.onion.sh" or query matches "*.onion.si" or query matches "*.onion.to" or query matches "*.onion.top" or query matches "*.onion.ws" or query matches "*.onion" or query matches "*.s1.tor-gateways.de" or query matches "*.s2.tor-gateways.de" or query matches "*.s3.tor-gateways.de" or query matches "*.s4.tor-gateways.de" or query matches "*.s5.tor-gateways.de" or query matches "*.t2w.pw" or query matches "*.tor2web.ae.org" or query matches "*.tor2web.blutmagie.de" or query matches "*.tor2web.com" or query matches "*.tor2web.fi" or query matches "*.tor2web.io" or query matches "*.tor2web.org" or query matches "*.tor2web.xyz" or query matches "*.torlink.co"))
