// Title: Monero Crypto Coin Mining Pool Lookup
// ID: b593fd50-7335-4682-a36c-4edcb68e4641
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-10-24
// Tags: attack.impact, attack.t1496, attack.exfiltration, attack.t1567
// Description: Detects suspicious DNS queries to Monero mining pools
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((query matches "*pool.minexmr.com*" or query matches "*fr.minexmr.com*" or query matches "*de.minexmr.com*" or query matches "*sg.minexmr.com*" or query matches "*ca.minexmr.com*" or query matches "*us-west.minexmr.com*" or query matches "*pool.supportxmr.com*" or query matches "*mine.c3pool.com*" or query matches "*xmr-eu1.nanopool.org*" or query matches "*xmr-eu2.nanopool.org*" or query matches "*xmr-us-east1.nanopool.org*" or query matches "*xmr-us-west1.nanopool.org*" or query matches "*xmr-asia1.nanopool.org*" or query matches "*xmr-jp1.nanopool.org*" or query matches "*xmr-au1.nanopool.org*" or query matches "*xmr.2miners.com*" or query matches "*xmr.hashcity.org*" or query matches "*xmr.f2pool.com*" or query matches "*xmrpool.eu*" or query matches "*pool.hashvault.pro*"))
