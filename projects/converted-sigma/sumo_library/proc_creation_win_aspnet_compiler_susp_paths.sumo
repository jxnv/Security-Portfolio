// Title: Potentially Suspicious ASP.NET Compilation Via AspNetCompiler
// ID: 9f50fe98-fe5c-4a2d-86c7-fad7f63ed622
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-08-14
// Tags: attack.execution, attack.stealth, attack.t1127
// Description: Detects execution of "aspnet_compiler.exe" with potentially suspicious paths for compilation.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*:\\Windows\\Microsoft.NET\\Framework\\*" or Image matches "*:\\Windows\\Microsoft.NET\\Framework64\\*" or Image matches "*:\\Windows\\Microsoft.NET\\FrameworkArm\\*" or Image matches "*:\\Windows\\Microsoft.NET\\FrameworkArm64\\*") and Image matches "*\\aspnet_compiler.exe" and (CommandLine matches "*\\Users\\Public\\*" or CommandLine matches "*\\AppData\\Local\\Temp\\*" or CommandLine matches "*\\AppData\\Local\\Roaming\\*" or CommandLine matches "*:\\Temp\\*" or CommandLine matches "*:\\Windows\\Temp\\*" or CommandLine matches "*:\\Windows\\System32\\Tasks\\*" or CommandLine matches "*:\\Windows\\Tasks\\*"))
