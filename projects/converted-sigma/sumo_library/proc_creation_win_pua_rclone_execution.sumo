// Title: PUA - Rclone Execution
// ID: e37db05d-d1f9-49c8-b464-cee1a4b11638
// Status: test
// Level: high
// Author: Bhabesh Raj, Sittikorn S, Aaron Greetham (@beardofbinary) - NCC Group
// Date: 2021-05-10
// Tags: attack.exfiltration, attack.t1567.002
// Description: Detects execution of RClone utility for exfiltration as used by various ransomwares strains like REvil, Conti, FiveHands, etc
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*--config *" and CommandLine matches "*--no-check-certificate *" and CommandLine matches "* copy *")) or (((CommandLine matches "*pass*" or CommandLine matches "*user*" or CommandLine matches "*copy*" or CommandLine matches "*sync*" or CommandLine matches "*config*" or CommandLine matches "*lsd*" or CommandLine matches "*remote*" or CommandLine matches "*ls*" or CommandLine matches "*mega*" or CommandLine matches "*pcloud*" or CommandLine matches "*ftp*" or CommandLine matches "*ignore-existing*" or CommandLine matches "*auto-confirm*" or CommandLine matches "*transfers*" or CommandLine matches "*multi-thread-streams*" or CommandLine matches "*no-check-certificate *")) and ((Image matches "*\\rclone.exe") or (Description = "Rsync for cloud storage"))))
