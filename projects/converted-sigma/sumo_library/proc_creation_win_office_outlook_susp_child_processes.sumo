// Title: Suspicious Outlook Child Process
// ID: 208748f7-881d-47ac-a29c-07ea84bf691d
// Status: test
// Level: high
// Author: Michael Haag, Florian Roth (Nextron Systems), Markus Neis, Elastic, FPT.EagleEye Team
// Date: 2022-02-28
// Tags: attack.execution, attack.t1204.002
// Description: Detects a suspicious process spawning from an Outlook process.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (ParentImage matches "*\\OUTLOOK.EXE" and (Image matches "*\\AppVLP.exe" or Image matches "*\\bash.exe" or Image matches "*\\cmd.exe" or Image matches "*\\cscript.exe" or Image matches "*\\forfiles.exe" or Image matches "*\\hh.exe" or Image matches "*\\mftrace.exe" or Image matches "*\\msbuild.exe" or Image matches "*\\msdt.exe" or Image matches "*\\mshta.exe" or Image matches "*\\msiexec.exe" or Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\regsvr32.exe" or Image matches "*\\schtasks.exe" or Image matches "*\\scrcons.exe" or Image matches "*\\scriptrunner.exe" or Image matches "*\\sh.exe" or Image matches "*\\svchost.exe" or Image matches "*\\wmic.exe" or Image matches "*\\wscript.exe"))
