// Title: MacOS Scripting Interpreter AppleScript
// ID: 1bc2e6c5-0885-472b-bed6-be5ea8eace55
// Status: test
// Level: medium
// Author: Alejandro Ortuno, oscd.community
// Date: 2020-10-21
// Tags: attack.execution, attack.t1059.002
// Description: Detects execution of AppleScript of the macOS scripting language AppleScript.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*/osascript" and (CommandLine matches "* -e *" or CommandLine matches "*.scpt*" or CommandLine matches "*.js*")) and !((ParentImage matches "*opencode" and (CommandLine matches "*osascript*" and CommandLine matches "* -e *" and CommandLine matches "*set imageData to the clipboard*" and CommandLine matches "*set fileRef*"))))
