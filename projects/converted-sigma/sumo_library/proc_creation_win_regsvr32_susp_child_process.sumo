// Title: Potentially Suspicious Child Process Of Regsvr32
// ID: 6f0947a4-1c5e-4e0d-8ac7-53159b8f23ca
// Status: test
// Level: high
// Author: elhoim, Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-05-05
// Tags: attack.stealth, attack.t1218.010
// Description: Detects potentially suspicious child processes of "regsvr32.exe".
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((ParentImage matches "*\\regsvr32.exe" and (Image matches "*\\calc.exe" or Image matches "*\\cscript.exe" or Image matches "*\\explorer.exe" or Image matches "*\\mshta.exe" or Image matches "*\\net.exe" or Image matches "*\\net1.exe" or Image matches "*\\nltest.exe" or Image matches "*\\notepad.exe" or Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe" or Image matches "*\\reg.exe" or Image matches "*\\schtasks.exe" or Image matches "*\\werfault.exe" or Image matches "*\\wscript.exe")) and !((Image matches "*\\werfault.exe" and CommandLine matches "* -u -p *")))
