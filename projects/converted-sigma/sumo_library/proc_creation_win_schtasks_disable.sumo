// Title: Disable Important Scheduled Task
// ID: 9ac94dc8-9042-493c-ba45-3b5e7c86b980
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems), X__Junior
// Date: 2021-12-26
// Tags: attack.impact, attack.t1489
// Description: Detects when adversaries stop services or processes by disabling their respective scheduled tasks in order to conduct data destructive activities
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*/disable*" or CommandLine matches "*-disable*")) and ((CommandLine matches "*\\Windows\\BitLocker*" or CommandLine matches "*\\Windows\\ExploitGuard*" or CommandLine matches "*\\Windows\\ExploitGuard\\ExploitGuard MDM policy Refresh*" or CommandLine matches "*\\Windows\\SystemRestore\\SR*" or CommandLine matches "*\\Windows\\UpdateOrchestrator\\*" or CommandLine matches "*\\Windows\\Windows Defender\\*" or CommandLine matches "*\\Windows\\WindowsBackup\\*" or CommandLine matches "*\\Windows\\WindowsUpdate\\*")) and ((Image matches "*\\schtasks.exe") or (OriginalFileName = "schtasks.exe")))
