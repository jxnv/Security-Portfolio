// Title: Potential DLL Sideloading Of DBGCORE.DLL
// ID: 9ca2bf31-0570-44d8-a543-534c47c33ed7
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Wietze Beukema (project and research)
// Date: 2022-10-25
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects DLL sideloading of "dbgcore.dll"
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((ImageLoaded matches "*\\dbgcore.dll") and !(((ImageLoaded matches "C:\\Program Files (x86)\\*" or ImageLoaded matches "C:\\Program Files\\*" or ImageLoaded matches "C:\\Windows\\SoftwareDistribution\\*" or ImageLoaded matches "C:\\Windows\\System32\\*" or ImageLoaded matches "C:\\Windows\\SystemTemp\\*" or ImageLoaded matches "C:\\Windows\\SysWOW64\\*" or ImageLoaded matches "C:\\Windows\\WinSxS\\*"))) and !(((ImageLoaded matches "*opera\\Opera Installer Temp\\opera_package*" and ImageLoaded matches "*\\assistant\\dbgcore.dll") or (ImageLoaded matches "*\\Steam\\bin\\cef\\cef.win7x64\\dbgcore.dll"))))
