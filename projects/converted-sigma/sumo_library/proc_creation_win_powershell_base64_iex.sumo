// Title: PowerShell Base64 Encoded IEX Cmdlet
// ID: 88f680b8-070e-402c-ae11-d2914f2257f1
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2019-08-23
// Tags: attack.execution, attack.t1059.001
// Description: Detects usage of a base64 encoded "IEX" cmdlet in a process command line
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*SUVYIChb*" or CommandLine matches "*lFWCAoW*" or CommandLine matches "*JRVggKF*" or CommandLine matches "*aWV4IChb*" or CommandLine matches "*lleCAoW*" or CommandLine matches "*pZXggKF*" or CommandLine matches "*aWV4IChOZX*" or CommandLine matches "*lleCAoTmV3*" or CommandLine matches "*pZXggKE5ld*" or CommandLine matches "*SUVYIChOZX*" or CommandLine matches "*lFWCAoTmV3*" or CommandLine matches "*JRVggKE5ld*" or CommandLine matches "*SUVYKF*" or CommandLine matches "*lFWChb*" or CommandLine matches "*JRVgoW*" or CommandLine matches "*aWV4KF*" or CommandLine matches "*lleChb*" or CommandLine matches "*pZXgoW*" or CommandLine matches "*aWV4KE5ld*" or CommandLine matches "*lleChOZX*" or CommandLine matches "*pZXgoTmV3*" or CommandLine matches "*SUVYKE5ld*" or CommandLine matches "*lFWChOZX*" or CommandLine matches "*JRVgoTmV3*" or CommandLine matches "*SUVYKCgn*" or CommandLine matches "*lFWCgoJ*" or CommandLine matches "*JRVgoKC*" or CommandLine matches "*aWV4KCgn*" or CommandLine matches "*lleCgoJ*" or CommandLine matches "*pZXgoKC*")) or ((CommandLine matches "*SQBFAFgAIAAoAFsA*" or CommandLine matches "*kARQBYACAAKABbA*" or CommandLine matches "*JAEUAWAAgACgAWw*" or CommandLine matches "*aQBlAHgAIAAoAFsA*" or CommandLine matches "*kAZQB4ACAAKABbA*" or CommandLine matches "*pAGUAeAAgACgAWw*" or CommandLine matches "*aQBlAHgAIAAoAE4AZQB3A*" or CommandLine matches "*kAZQB4ACAAKABOAGUAdw*" or CommandLine matches "*pAGUAeAAgACgATgBlAHcA*" or CommandLine matches "*SQBFAFgAIAAoAE4AZQB3A*" or CommandLine matches "*kARQBYACAAKABOAGUAdw*" or CommandLine matches "*JAEUAWAAgACgATgBlAHcA*")))
