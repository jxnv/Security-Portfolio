// Title: Tamper Windows Defender - PSClassic
// ID: ec19ebab-72dc-40e1-9728-4c0b805d722c
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-06-07
// Tags: attack.defense-impairment, attack.t1685
// Description: Attempting to disable scheduled scanning and other parts of Windows Defender ATP or set default actions to allow.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Data matches "*Set-MpPreference*") and (((Data matches "*HighThreatDefaultAction Allow*" or Data matches "*htdefac Allow*" or Data matches "*LowThreatDefaultAction Allow*" or Data matches "*ltdefac Allow*" or Data matches "*ModerateThreatDefaultAction Allow*" or Data matches "*mtdefac Allow*" or Data matches "*SevereThreatDefaultAction Allow*" or Data matches "*stdefac Allow*")) or ((Data matches "*-dbaf $true*" or Data matches "*-dbaf 1*" or Data matches "*-dbm $true*" or Data matches "*-dbm 1*" or Data matches "*-dips $true*" or Data matches "*-dips 1*" or Data matches "*-DisableArchiveScanning $true*" or Data matches "*-DisableArchiveScanning 1*" or Data matches "*-DisableBehaviorMonitoring $true*" or Data matches "*-DisableBehaviorMonitoring 1*" or Data matches "*-DisableBlockAtFirstSeen $true*" or Data matches "*-DisableBlockAtFirstSeen 1*" or Data matches "*-DisableCatchupFullScan $true*" or Data matches "*-DisableCatchupFullScan 1*" or Data matches "*-DisableCatchupQuickScan $true*" or Data matches "*-DisableCatchupQuickScan 1*" or Data matches "*-DisableIntrusionPreventionSystem $true*" or Data matches "*-DisableIntrusionPreventionSystem 1*" or Data matches "*-DisableIOAVProtection $true*" or Data matches "*-DisableIOAVProtection 1*" or Data matches "*-DisableRealtimeMonitoring $true*" or Data matches "*-DisableRealtimeMonitoring 1*" or Data matches "*-DisableRemovableDriveScanning $true*" or Data matches "*-DisableRemovableDriveScanning 1*" or Data matches "*-DisableScanningMappedNetworkDrivesForFullScan $true*" or Data matches "*-DisableScanningMappedNetworkDrivesForFullScan 1*" or Data matches "*-DisableScanningNetworkFiles $true*" or Data matches "*-DisableScanningNetworkFiles 1*" or Data matches "*-DisableScriptScanning $true*" or Data matches "*-DisableScriptScanning 1*" or Data matches "*-MAPSReporting $false*" or Data matches "*-MAPSReporting 0*" or Data matches "*-drdsc $true*" or Data matches "*-drdsc 1*" or Data matches "*-drtm $true*" or Data matches "*-drtm 1*" or Data matches "*-dscrptsc $true*" or Data matches "*-dscrptsc 1*" or Data matches "*-dsmndf $true*" or Data matches "*-dsmndf 1*" or Data matches "*-dsnf $true*" or Data matches "*-dsnf 1*" or Data matches "*-dss $true*" or Data matches "*-dss 1*"))))
