// Title: CobaltStrike Named Pipe Patterns
// ID: 85adeb13-4fc9-4e68-8a4a-c7cb2c336eb7
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Christian Burkard (Nextron Systems)
// Date: 2021-07-30
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055, stp.1k
// Description: Detects the creation of a named pipe with a pattern found in CobaltStrike malleable C2 profiles
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((PipeName matches "\\Winsock2\\CatalogChangeListener-*" and PipeName matches "*-0,") or (((PipeName matches "\\DserNamePipe*" or PipeName matches "\\f4c3*" or PipeName matches "\\f53f*" or PipeName matches "\\fullduplex_*" or PipeName matches "\\mojo.5688.8052.183894939787088877*" or PipeName matches "\\mojo.5688.8052.35780273329370473*" or PipeName matches "\\MsFteWds*" or PipeName matches "\\msrpc_*" or PipeName matches "\\mypipe-f*" or PipeName matches "\\mypipe-h*" or PipeName matches "\\ntsvcs*" or PipeName matches "\\PGMessagePipe*" or PipeName matches "\\rpc_*" or PipeName matches "\\scerpc*" or PipeName matches "\\SearchTextHarvester*" or PipeName matches "\\spoolss*" or PipeName matches "\\win_svc*" or PipeName matches "\\win\\msrpc_*" or PipeName matches "\\windows.update.manager*" or PipeName matches "\\wkssvc*")) or ((PipeName = "\\demoagent_11" or PipeName = "\\demoagent_22")))) and !(((PipeName = "\\wkssvc" or PipeName = "\\spoolss" or PipeName = "\\scerpc" or PipeName = "\\ntsvcs" or PipeName = "\\SearchTextHarvester" or PipeName = "\\PGMessagePipe" or PipeName = "\\MsFteWds"))) and !(((Image matches "*:\\Program Files\\Websense\\*" or Image matches "*:\\Program Files (x86)\\Websense\\*") and (PipeName matches "\\DserNamePipeR*" or PipeName matches "\\DserNamePipeW*"))))
