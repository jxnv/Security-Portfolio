// Title: Suspicious External WebDAV Execution
// ID: 1ae64f96-72b6-48b3-ad3d-e71dff6c6398
// Status: test
// Level: high
// Author: Ahmed Farouk
// Date: 2024-05-10
// Tags: attack.initial-access, attack.resource-development, attack.t1584, attack.t1566
// Description: Detects executables launched from external WebDAV shares using the WebDAV Explorer integration, commonly seen in initial access campaigns.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((c-uri matches "*.7z" or c-uri matches "*.bat" or c-uri matches "*.dat" or c-uri matches "*.cmd" or c-uri matches "*.exe" or c-uri matches "*.js" or c-uri matches "*.lnk" or c-uri matches "*.ps1" or c-uri matches "*.rar" or c-uri matches "*.url" or c-uri matches "*.vbe" or c-uri matches "*.vbs" or c-uri matches "*.zip")) and (c-useragent matches "Microsoft-WebDAV-MiniRedir/*" and cs-method = "GET")) and !(((cidrMatch(dst_ip, "127.0.0.0/8") or cidrMatch(dst_ip, "10.0.0.0/8") or cidrMatch(dst_ip, "172.16.0.0/12") or cidrMatch(dst_ip, "192.168.0.0/16") or cidrMatch(dst_ip, "169.254.0.0/16") or cidrMatch(dst_ip, "::1/128") or cidrMatch(dst_ip, "fe80::/10") or cidrMatch(dst_ip, "fc00::/7")))))
