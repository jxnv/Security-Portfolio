// Title: Suspicious Use of PsLogList
// ID: aae1243f-d8af-40d8-ab20-33fc6d0c55bc
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-12-18
// Tags: attack.discovery, attack.t1087, attack.t1087.001, attack.t1087.002
// Description: Detects usage of the PsLogList utility to dump event log in order to extract admin accounts and perform account discovery or delete events logs
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "* security*" or CommandLine matches "* application*" or CommandLine matches "* system*")) and ((CommandLine matches "* -d*" or CommandLine matches "* -x*" or CommandLine matches "* -s*" or CommandLine matches "* -c*" or CommandLine matches "* -g*")) and ((OriginalFileName = "psloglist.exe") or ((Image matches "*\\psloglist.exe" or Image matches "*\\psloglist64.exe" or Image matches "*\\psloglist64a.exe"))))
