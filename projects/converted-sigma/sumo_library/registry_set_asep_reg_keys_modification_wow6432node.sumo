// Title: Wow6432Node CurrentVersion Autorun Keys Modification
// ID: b29aed60-ebd1-442b-9cb5-16a1d0324adb
// Status: test
// Level: medium
// Author: Victor Sergeev, Daniil Yugoslavskiy, Gleb Sukhodolskiy, Timur Zinniatullin, oscd.community, Tim Shelton, frack113 (split)
// Date: 2019-10-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects modification of autostart extensibility point (ASEP) in registry.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((TargetObject matches "*\\SOFTWARE\\Wow6432Node\\Microsoft\\Windows\\CurrentVersion*") and ((TargetObject matches "*\\ShellServiceObjectDelayLoad*" or TargetObject matches "*\\Run\\*" or TargetObject matches "*\\RunOnce\\*" or TargetObject matches "*\\RunOnceEx\\*" or TargetObject matches "*\\RunServices\\*" or TargetObject matches "*\\RunServicesOnce\\*" or TargetObject matches "*\\Explorer\\ShellServiceObjects*" or TargetObject matches "*\\Explorer\\ShellIconOverlayIdentifiers*" or TargetObject matches "*\\Explorer\\ShellExecuteHooks*" or TargetObject matches "*\\Explorer\\SharedTaskScheduler*" or TargetObject matches "*\\Explorer\\Browser Helper Objects*"))) and !((((Image matches "*C:\\Program Files (x86)\\Microsoft\\EdgeUpdate\\Install\\{*" and Image matches "*\\setup.exe*")) or (Details = "(Empty)") or (Details matches "\"C:\\ProgramData\\Package Cache\\{d21a4f20-968a-4b0c-bf04-a38da5f06e41}\\windowsdesktop-runtime-*") or (Image = "C:\\WINDOWS\\system32\\msiexec.exe" and TargetObject matches "*\\SOFTWARE\\Wow6432Node\\Microsoft\\Windows\\CurrentVersion\\Run\\*") or (isNull(Details)) or (Image matches "C:\\Windows\\Installer\\MSI*" and TargetObject matches "*\\Explorer\\Browser Helper Objects*") or ((Image matches "C:\\ProgramData\\Package Cache*" or Image matches "C:\\Windows\\Temp\\*") and (Image matches "*\\winsdksetup.exe*" or Image matches "*\\windowsdesktop-runtime-*" or Image matches "*\\AspNetCoreSharedFrameworkBundle-*") and Details matches "* /burn.runonce") or (Image matches "*\\VC_redist.x64.exe" and Details matches "*}\\VC_redist.x64.exe\" /burn.runonce"))) and !(((Image matches "*\\instup.exe" and TargetObject matches "*\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\AvRepair" and Details matches "*instup.exe\" /instop:repair /wait") or (Image matches "*\\instup.exe" and (TargetObject matches "*\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Explorer\\ShellIconOverlayIdentifiers\\00avg\\(Default)" or TargetObject matches "*\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Explorer\\ShellIconOverlayIdentifiers\\00asw\\(Default)") and (Details = "{472083B1-C522-11CF-8763-00608CC02F24}" or Details = "{472083B0-C522-11CF-8763-00608CC02F24}")) or (Details matches "*\\Avira.OE.Setup.Bundle.exe\" /burn.runonce" and Image matches "*\\Avira.OE.Setup.Bundle.exe") or (TargetObject matches "*\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run\\Discord" and Details matches "*Discord.exe --checkInstall") or (Image matches "*\\windowsdesktop-runtime-*" and (TargetObject matches "*\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\{e2d1ae32-dd1d-4ad7-a298-10e42e7840fc}" or TargetObject matches "*\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\{7037b699-7382-448c-89a7-4765961d2537}") and Details matches "\"C:\\ProgramData\\Package Cache\\*" and Details matches "*.exe\" /burn.runonce") or ((Details matches "*-A251-47B7-93E1-CDD82E34AF8B}") or (Details = "grpconv -o") or ((Details matches "*C:\\Program Files*" and Details matches "*\\Dropbox\\Client\\Dropbox.exe*" and Details matches "* /systemstartup*"))) or (TargetObject matches "*\\Explorer\\Browser Helper Objects\\{92EF2EAD-A7CE-4424-B0DB-499CF856608E}\\NoExplorer") or (Image = "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\OfficeClickToRun.exe" and TargetObject matches "*\\Office\\ClickToRun\\REGISTRY\\MACHINE\\Software\\Wow6432Node\\*") or ((Image = "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe" or Image = "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe") and TargetObject matches "*\\Explorer\\Browser Helper Objects\\{31D09BA0-12F5-4CCE-BE8A-2923E76605DA}\\*") or ((Image matches "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\*" or Image matches "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\*") and Image matches "*\\OfficeClickToRun.exe"))))
