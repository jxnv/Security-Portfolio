// Title: Suspicious Network Connection to IP Lookup Service APIs
// ID: edf3485d-dac4-4d50-90e4-b0e5813f7e60
// Status: test
// Level: medium
// Author: Janantha Marasinghe, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-24
// Tags: attack.discovery, attack.t1016
// Description: Detects external IP address lookups by non-browser processes via services such as "api.ipify.org". This could be indicative of potential post compromise internet test activity.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((DestinationHostname = "www.ip.cn" or DestinationHostname = "l2.io")) or ((DestinationHostname matches "*api.2ip.ua*" or DestinationHostname matches "*api.bigdatacloud.net*" or DestinationHostname matches "*api.ipify.org*" or DestinationHostname matches "*bot.whatismyipaddress.com*" or DestinationHostname matches "*canireachthe.net*" or DestinationHostname matches "*checkip.amazonaws.com*" or DestinationHostname matches "*checkip.dyndns.org*" or DestinationHostname matches "*curlmyip.com*" or DestinationHostname matches "*db-ip.com*" or DestinationHostname matches "*edns.ip-api.com*" or DestinationHostname matches "*eth0.me*" or DestinationHostname matches "*freegeoip.app*" or DestinationHostname matches "*geoipy.com*" or DestinationHostname matches "*getip.pro*" or DestinationHostname matches "*icanhazip.com*" or DestinationHostname matches "*ident.me*" or DestinationHostname matches "*ifconfig.io*" or DestinationHostname matches "*ifconfig.me*" or DestinationHostname matches "*ip-api.com*" or DestinationHostname matches "*ip.360.cn*" or DestinationHostname matches "*ip.anysrc.net*" or DestinationHostname matches "*ip.taobao.com*" or DestinationHostname matches "*ip.tyk.nu*" or DestinationHostname matches "*ipaddressworld.com*" or DestinationHostname matches "*ipapi.co*" or DestinationHostname matches "*ipconfig.io*" or DestinationHostname matches "*ipecho.net*" or DestinationHostname matches "*ipinfo.io*" or DestinationHostname matches "*ipip.net*" or DestinationHostname matches "*ipof.in*" or DestinationHostname matches "*ipv4.icanhazip.com*" or DestinationHostname matches "*ipv4bot.whatismyipaddress.com*" or DestinationHostname matches "*ipv6-test.com*" or DestinationHostname matches "*ipwho.is*" or DestinationHostname matches "*jsonip.com*" or DestinationHostname matches "*myexternalip.com*" or DestinationHostname matches "*seeip.org*" or DestinationHostname matches "*wgetip.com*" or DestinationHostname matches "*whatismyip.akamai.com*" or DestinationHostname matches "*whois.pconline.com.cn*" or DestinationHostname matches "*wtfismyip.com*"))) and !(((Image matches "*\\brave.exe") or ((Image = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or Image = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or ((Image matches "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*") or (Image matches "*\\WindowsApps\\MicrosoftEdge.exe") or ((Image = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or Image = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((Image matches "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\*" or Image matches "C:\\Program Files\\Microsoft\\EdgeCore\\*") and (Image matches "*\\msedge.exe" or Image matches "*\\msedgewebview2.exe")) or ((Image = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or Image = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or ((Image = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or Image = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (Image matches "*\\maxthon.exe") or (Image matches "*\\opera.exe") or (Image matches "*\\safari.exe") or (Image matches "*\\seamonkey.exe") or (Image matches "*\\vivaldi.exe") or (Image matches "*\\whale.exe"))))
