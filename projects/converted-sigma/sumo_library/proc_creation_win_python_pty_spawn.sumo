// Title: Python Spawning Pretty TTY on Windows
// ID: 480e7e51-e797-47e3-8d72-ebfce65b6d8d
// Status: test
// Level: high
// Author: Nextron Systems
// Date: 2022-06-03
// Tags: attack.execution, attack.t1059
// Description: Detects python spawning a pretty tty
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*python.exe" or Image matches "*python3.exe" or Image matches "*python2.exe")) and (((CommandLine matches "*import pty*" and CommandLine matches "*.spawn(*")) or (CommandLine matches "*from pty import spawn*")))
