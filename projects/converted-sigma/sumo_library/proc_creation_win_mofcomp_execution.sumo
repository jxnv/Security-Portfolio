// Title: Potentially Suspicious Mofcomp Execution
// ID: 1dd05363-104e-4b4a-b963-196a534b03a1
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-12
// Tags: attack.stealth, attack.t1218
// Description: Detects execution of the "mofcomp" utility as a child of a suspicious shell or script running utility or by having a suspicious path in the commandline.
// The "mofcomp" utility parses a file containing MOF statements and adds the classes and class instances defined in the file to the WMI repository.
// Attackers abuse this utility to install malicious MOF scripts
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((((ParentImage matches "*\\cmd.exe" or ParentImage matches "*\\powershell.exe" or ParentImage matches "*\\pwsh.exe" or ParentImage matches "*\\wsl.exe" or ParentImage matches "*\\wscript.exe" or ParentImage matches "*\\cscript.exe")) or ((CommandLine matches "*\\AppData\\Local\\Temp*" or CommandLine matches "*\\Contacts\\*" or CommandLine matches "*\\Favorites\\*" or CommandLine matches "*\\Favourites\\*" or CommandLine matches "*\\Music\\*" or CommandLine matches "*\\Pictures\\*" or CommandLine matches "*\\Users\\Public\\*" or CommandLine matches "*\\Videos\\*" or CommandLine matches "*\\WINDOWS\\Temp\\*" or CommandLine matches "*%appdata%*" or CommandLine matches "*%temp%*" or CommandLine matches "*%tmp%*"))) and ((Image matches "*\\mofcomp.exe") or (OriginalFileName = "mofcomp.exe"))) and !(((ParentCommandLine matches "*\\InstallUtil.exe /Uninstall C:\\Windows\\CCM\\Microsoft.ConfigurationManager.SVProvider.dll" and ParentImage matches "*\\InstallUtil.exe" and (CommandLine matches "*C:\\Windows\\TEMP*" and CommandLine matches "*.tmp*")) or (ParentImage = "C:\\Windows\\System32\\wbem\\WmiPrvSE.exe" and CommandLine matches "*C:\\Windows\\TEMP\\*" and CommandLine matches "*.mof"))) and !((isNull(ParentCommandLine))))
