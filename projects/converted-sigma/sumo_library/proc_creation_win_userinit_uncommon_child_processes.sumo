// Title: Uncommon Userinit Child Process
// ID: 0a98a10c-685d-4ab0-bddc-b6bdd1d48458
// Status: test
// Level: high
// Author: Tom Ueltschi (@c_APT_ure), Tim Shelton
// Date: 2019-01-12
// Tags: attack.privilege-escalation, attack.t1037.001, attack.persistence
// Description: Detects uncommon "userinit.exe" child processes, which could be a sign of uncommon shells or login scripts used for persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((ParentImage matches "*\\userinit.exe") and !((Image matches "*:\\WINDOWS\\explorer.exe")) and !((((Image matches "*:\\Program Files (x86)\\Citrix\\HDX\\bin\\cmstart.exe" or Image matches "*:\\Program Files (x86)\\Citrix\\HDX\\bin\\icast.exe" or Image matches "*:\\Program Files (x86)\\Citrix\\System32\\icast.exe" or Image matches "*:\\Program Files\\Citrix\\HDX\\bin\\cmstart.exe" or Image matches "*:\\Program Files\\Citrix\\HDX\\bin\\icast.exe" or Image matches "*:\\Program Files\\Citrix\\System32\\icast.exe")) or (isNull(Image)) or ((CommandLine matches "*netlogon.bat*" or CommandLine matches "*UsrLogon.cmd*")) or ((Image matches "*:\\Windows\\System32\\proquota.exe" or Image matches "*:\\Windows\\SysWOW64\\proquota.exe")) or (CommandLine = "PowerShell.exe"))))
