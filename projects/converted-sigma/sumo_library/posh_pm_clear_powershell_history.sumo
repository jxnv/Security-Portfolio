// Title: Clear PowerShell History - PowerShell Module
// ID: f99276ad-d122-4989-a09a-d00904a5f9d2
// Status: test
// Level: medium
// Author: Ilyas Ochkov, Jonhnathan Ribeiro, Daniil Yugoslavskiy, oscd.community
// Date: 2019-10-25
// Tags: attack.stealth, attack.t1070.003
// Description: Detects keywords that could indicate clearing PowerShell history
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((Payload matches "*Set-PSReadlineOption*" and Payload matches "*–HistorySaveStyle*" and Payload matches "*SaveNothing*")) or ((Payload matches "*Set-PSReadlineOption*" and Payload matches "*-HistorySaveStyle*" and Payload matches "*SaveNothing*"))) or (((Payload matches "*del*" or Payload matches "*Remove-Item*" or Payload matches "*rm*")) and (Payload matches "*(Get-PSReadlineOption).HistorySavePath*")))
