// Title: Suspicious Group And Account Reconnaissance Activity Using Net.EXE
// ID: d95de845-b83c-4a9a-8a6a-4fc802ebf6c0
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), omkar72, @svch0st, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-01-16
// Tags: attack.discovery, attack.t1087.001, attack.t1087.002
// Description: Detects suspicious reconnaissance command line activity on Windows systems using Net.EXE
// Check if the user that executed the commands is suspicious (e.g. service accounts, LOCAL_SYSTEM)
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((Image matches "*\\net.exe" or Image matches "*\\net1.exe")) or ((OriginalFileName = "net.exe" or OriginalFileName = "net1.exe"))) and (((((CommandLine matches "*domain admins*" or CommandLine matches "* administrator*" or CommandLine matches "* administrateur*" or CommandLine matches "*enterprise admins*" or CommandLine matches "*Exchange Trusted Subsystem*" or CommandLine matches "*Remote Desktop Users*" or CommandLine matches "*Utilisateurs du Bureau à distance*" or CommandLine matches "*Usuarios de escritorio remoto*" or CommandLine matches "* /do*")) and ((CommandLine matches "* group *" or CommandLine matches "* localgroup *"))) and !((CommandLine matches "* /add*"))) or ((CommandLine matches "* /do*") and (CommandLine matches "* accounts *"))))
