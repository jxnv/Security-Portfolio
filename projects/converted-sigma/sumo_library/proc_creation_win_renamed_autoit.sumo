// Title: Renamed AutoIt Execution
// ID: f4264e47-f522-4c38-a420-04525d5b880f
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2023-06-04
// Tags: attack.stealth, attack.t1027
// Description: Detects the execution of a renamed AutoIt2.exe or AutoIt3.exe.
// AutoIt is a scripting language and automation tool for Windows systems. While primarily used for legitimate automation tasks, it can be misused in cyber attacks.
// Attackers can leverage AutoIt to create and distribute malware, including keyloggers, spyware, and botnets. A renamed AutoIt executable is particularly suspicious.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((CommandLine matches "* /AutoIt3ExecuteScript*" or CommandLine matches "* /ErrorStdOut*")) or ((Hashes matches "*IMPHASH=FDC554B3A8683918D731685855683DDF*" or Hashes matches "*IMPHASH=CD30A61B60B3D60CECDB034C8C83C290*" or Hashes matches "*IMPHASH=F8A00C72F2D667D2EDBB234D0C0AE000*")) or ((OriginalFileName = "AutoIt3.exe" or OriginalFileName = "AutoIt2.exe" or OriginalFileName = "AutoIt.exe"))) and !(((Image matches "*\\AutoIt.exe" or Image matches "*\\AutoIt2.exe" or Image matches "*\\AutoIt3_x64.exe" or Image matches "*\\AutoIt3.exe"))))
