// Title: Suspicious Scheduled Task Update
// ID: 614cf376-6651-47c4-9dcc-6b9527f749f4
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-05
// Tags: attack.execution, attack.privilege-escalation, attack.persistence, attack.t1053.005
// Description: Detects update to a scheduled task event that contain suspicious keywords.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((TaskContentNew matches "*regsvr32*" or TaskContentNew matches "*rundll32*" or TaskContentNew matches "*cmd.exe</Command>*" or TaskContentNew matches "*cmd</Command>*" or TaskContentNew matches "*<Arguments>/c *" or TaskContentNew matches "*<Arguments>/k *" or TaskContentNew matches "*<Arguments>/r *" or TaskContentNew matches "*powershell*" or TaskContentNew matches "*pwsh*" or TaskContentNew matches "*mshta*" or TaskContentNew matches "*wscript*" or TaskContentNew matches "*cscript*" or TaskContentNew matches "*certutil*" or TaskContentNew matches "*bitsadmin*" or TaskContentNew matches "*bash.exe*" or TaskContentNew matches "*bash *" or TaskContentNew matches "*scrcons*" or TaskContentNew matches "*wmic *" or TaskContentNew matches "*wmic.exe*" or TaskContentNew matches "*forfiles*" or TaskContentNew matches "*scriptrunner*" or TaskContentNew matches "*hh.exe*")) and (EventID = "4702") and ((TaskContentNew matches "*\\AppData\\Local\\Temp\\*" or TaskContentNew matches "*\\AppData\\Roaming\\*" or TaskContentNew matches "*\\Users\\Public\\*" or TaskContentNew matches "*\\WINDOWS\\Temp\\*" or TaskContentNew matches "*C:\\Temp\\*" or TaskContentNew matches "*\\Desktop\\*" or TaskContentNew matches "*\\Downloads\\*" or TaskContentNew matches "*\\Temporary Internet*" or TaskContentNew matches "*C:\\ProgramData\\*" or TaskContentNew matches "*C:\\Perflogs\\*")))
