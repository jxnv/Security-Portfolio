// Title: New Connection Initiated To Potential Dead Drop Resolver Domain
// ID: 297ae038-edc2-4b2e-bb3e-7c5fc94dd5c7
// Status: test
// Level: high
// Author: Sorina Ionescu, X__Junior (Nextron Systems)
// Date: 2022-08-17
// Tags: attack.command-and-control, attack.t1102, attack.t1102.001
// Description: Detects an executable, which is not an internet browser or known application, initiating network connections to legit popular websites, which were seen to be used as dead drop resolvers in previous attacks.
// In this context attackers leverage known websites such as "facebook", "youtube", etc. In order to pass through undetected.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Initiated = "true" and (DestinationHostname matches "*.t.me" or DestinationHostname matches "*0x0.st" or DestinationHostname matches "*4shared.com" or DestinationHostname matches "*abuse.ch" or DestinationHostname matches "*anonfiles.com" or DestinationHostname matches "*bashupload.com" or DestinationHostname matches "*cdn.discordapp.com" or DestinationHostname matches "*chunk.io" or DestinationHostname matches "*cloudflare.com" or DestinationHostname matches "*ddns.net" or DestinationHostname matches "*discord.com" or DestinationHostname matches "*docs.google.com" or DestinationHostname matches "*drive.google.com" or DestinationHostname matches "*dropbox.com" or DestinationHostname matches "*dropmefiles.com" or DestinationHostname matches "*facebook.com" or DestinationHostname matches "*feeds.rapidfeeds.com" or DestinationHostname matches "*fotolog.com" or DestinationHostname matches "*ghostbin.co/" or DestinationHostname matches "*githubusercontent.com" or DestinationHostname matches "*gofile.io" or DestinationHostname matches "*hastebin.com" or DestinationHostname matches "*imgur.com" or DestinationHostname matches "*livejournal.com" or DestinationHostname matches "*mediafire.com" or DestinationHostname matches "*mega.co.nz" or DestinationHostname matches "*mega.nz" or DestinationHostname matches "*onedrive.com" or DestinationHostname matches "*pages.dev" or DestinationHostname matches "*paste.ee" or DestinationHostname matches "*pastebin.com" or DestinationHostname matches "*pastebin.pl" or DestinationHostname matches "*pastetext.net" or DestinationHostname matches "*pixeldrain.com" or DestinationHostname matches "*privatlab.com" or DestinationHostname matches "*privatlab.net" or DestinationHostname matches "*reddit.com" or DestinationHostname matches "*send.exploit.in" or DestinationHostname matches "*sendspace.com" or DestinationHostname matches "*steamcommunity.com" or DestinationHostname matches "*storage.googleapis.com" or DestinationHostname matches "*technet.microsoft.com" or DestinationHostname matches "*temp.sh" or DestinationHostname matches "*transfer.sh" or DestinationHostname matches "*trycloudflare.com" or DestinationHostname matches "*twitter.com" or DestinationHostname matches "*ufile.io" or DestinationHostname matches "*vimeo.com" or DestinationHostname matches "*w3spaces.com" or DestinationHostname matches "*wetransfer.com" or DestinationHostname matches "*workers.dev" or DestinationHostname matches "*x0.at" or DestinationHostname matches "*youtube.com")) and !((((Image matches "C:\\Program Files (x86)\\Avant Browser\\*" or Image matches "C:\\Program Files\\Avant Browser\\*") and Image matches "*\\avant.exe") or (Image matches "C:\\Program Files\\BraveSoftware\\*" and Image matches "*\\brave.exe") or ((Image = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or Image = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or (Image matches "C:\\Users\\*" and Image matches "*\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe") or ((Image matches "*C:\\Program Files\\Windows Defender Advanced Threat Protection\\*" or Image matches "*C:\\Program Files\\Windows Defender\\*" or Image matches "*C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*") and (Image matches "*\\MsMpEng.exe" or Image matches "*\\MsSense.exe")) or (Image matches "*\\AppData\\Local\\Discord\\*" and Image matches "*\\Discord.exe" and (DestinationHostname matches "*discord.com" or DestinationHostname matches "*cdn.discordapp.com")) or ((Image matches "C:\\Program Files (x86)\\Dropbox\\Client\\*" or Image matches "C:\\Program Files\\Dropbox\\Client\\*") and (Image matches "*\\Dropbox.exe" or Image matches "*\\DropboxInstaller.exe") and DestinationHostname matches "*dropbox.com") or ((Image matches "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*") or (Image matches "*\\WindowsApps\\MicrosoftEdge.exe") or ((Image = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or Image = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((Image matches "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\*" or Image matches "C:\\Program Files\\Microsoft\\EdgeCore\\*") and (Image matches "*\\msedge.exe" or Image matches "*\\msedgewebview2.exe")) or (Image = "") or ((Image matches "C:\\Program Files\\Falkon\\*" or Image matches "C:\\Program Files (x86)\\Falkon\\*") and Image matches "*\\falkon.exe") or ((Image = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or Image = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or (Image matches "C:\\Users\\*" and Image matches "*\\AppData\\Local\\Mozilla Firefox\\firefox.exe") or (Image matches "*\\AppData\\Local\\Flock\\*" and Image matches "*\\Flock.exe") or ((Image matches "*C:\\Program Files\\Google\\Drive File Stream\\*" or Image matches "*C:\\Program Files (x86)\\Google\\Drive File Stream\\*") and Image matches "*GoogleDriveFS.exe" and DestinationHostname matches "*drive.google.com") or ((Image = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or Image = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (Image matches "*\\AppData\\Local\\Maxthon\\*" and Image matches "*\\maxthon.exe") or ((Image matches "*\\MEGAsync.exe" or Image matches "*\\MEGAsyncSetup32_*RC.exe" or Image matches "*\\MEGAsyncSetup32.exe" or Image matches "*\\MEGAsyncSetup64.exe" or Image matches "*\\MEGAupdater.exe") and (DestinationHostname matches "*mega.co.nz" or DestinationHostname matches "*mega.nz")) or (Image matches "*\\AppData\\Local\\Programs\\midori-ng\\*" and Image matches "*\\Midori Next Generation.exe") or (isNull(Image)) or (Image matches "*\\AppData\\Local\\Microsoft\\OneDrive\\*" and Image matches "*\\OneDrive.exe" and DestinationHostname matches "*onedrive.com") or (Image matches "*\\AppData\\Local\\Programs\\Opera\\*" and Image matches "*\\opera.exe") or (Image matches "*\\AppData\\Local\\Phoebe\\*" and Image matches "*\\Phoebe.exe") or ((Image matches "*C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe" or Image matches "*C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe")) or ((Image matches "C:\\Program Files (x86)\\QtWeb\\*" or Image matches "C:\\Program Files\\QtWeb\\*") and Image matches "*\\QtWeb.exe") or ((Image matches "*C:\\Program Files (x86)\\Safari\\*" or Image matches "*C:\\Program Files\\Safari\\*") and Image matches "*\\safari.exe") or ((Image matches "C:\\Program Files\\SeaMonkey\\*" or Image matches "C:\\Program Files (x86)\\SeaMonkey\\*") and Image matches "*\\seamonkey.exe") or ((Image matches "C:\\Program Files\\SlimBrowser\\*" or Image matches "C:\\Program Files (x86)\\SlimBrowser\\*") and Image matches "*\\slimbrowser.exe") or (Image matches "*\\AppData\\Roaming\\Telegram Desktop\\*" and Image matches "*\\Telegram.exe" and DestinationHostname matches "*.t.me") or (Image matches "*\\AppData\\Local\\Vivaldi\\*" and Image matches "*\\vivaldi.exe") or ((Image matches "C:\\Program Files\\Naver\\Naver Whale\\*" or Image matches "C:\\Program Files (x86)\\Naver\\Naver Whale\\*") and Image matches "*\\whale.exe") or ((Image matches "C:\\Program Files\\Waterfox\\*" or Image matches "C:\\Program Files (x86)\\Waterfox\\*") and Image matches "*\\Waterfox.exe") or ((Image matches "C:\\Program Files (x86)\\WindowsApps\\*" or Image matches "C:\\Program Files\\WindowsApps\\*") and Image matches "*\\WhatsApp.exe" and DestinationHostname matches "*facebook.com"))))
