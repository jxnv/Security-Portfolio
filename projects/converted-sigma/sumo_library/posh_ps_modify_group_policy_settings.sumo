// Title: Modify Group Policy Settings - ScriptBlockLogging
// ID: b7216a7d-687e-4c8d-82b1-3080b2ad961f
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-08-19
// Tags: attack.privilege-escalation, attack.defense-impairment, attack.t1484.001
// Description: Detect malicious GPO modifications can be used to implement many other malicious behaviors.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((ScriptBlockText matches "*GroupPolicyRefreshTimeDC*" or ScriptBlockText matches "*GroupPolicyRefreshTimeOffsetDC*" or ScriptBlockText matches "*GroupPolicyRefreshTime*" or ScriptBlockText matches "*GroupPolicyRefreshTimeOffset*" or ScriptBlockText matches "*EnableSmartScreen*" or ScriptBlockText matches "*ShellSmartScreenLevel*")) and (ScriptBlockText matches "*\\SOFTWARE\\Policies\\Microsoft\\Windows\\System*"))
