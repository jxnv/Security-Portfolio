// Title: Download From Suspicious TLD - Blacklist
// ID: 00d0b5ab-1f55-4120-8e83-487c0a7baf19
// Status: test
// Level: low
// Author: Florian Roth (Nextron Systems)
// Date: 2017-11-07
// Tags: attack.initial-access, attack.t1566, attack.execution, attack.t1203, attack.t1204.002
// Description: Detects download of certain file types from hosts in suspicious TLDs
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((c-uri-extension = "exe" or c-uri-extension = "vbs" or c-uri-extension = "bat" or c-uri-extension = "rar" or c-uri-extension = "ps1" or c-uri-extension = "doc" or c-uri-extension = "docm" or c-uri-extension = "xls" or c-uri-extension = "xlsm" or c-uri-extension = "pptm" or c-uri-extension = "rtf" or c-uri-extension = "hta" or c-uri-extension = "dll" or c-uri-extension = "ws" or c-uri-extension = "wsf" or c-uri-extension = "sct" or c-uri-extension = "zip") and (cs-host matches "*.country" or cs-host matches "*.stream" or cs-host matches "*.gdn" or cs-host matches "*.mom" or cs-host matches "*.xin" or cs-host matches "*.kim" or cs-host matches "*.men" or cs-host matches "*.loan" or cs-host matches "*.download" or cs-host matches "*.racing" or cs-host matches "*.online" or cs-host matches "*.science" or cs-host matches "*.ren" or cs-host matches "*.gb" or cs-host matches "*.win" or cs-host matches "*.top" or cs-host matches "*.review" or cs-host matches "*.vip" or cs-host matches "*.party" or cs-host matches "*.tech" or cs-host matches "*.xyz" or cs-host matches "*.date" or cs-host matches "*.faith" or cs-host matches "*.zip" or cs-host matches "*.cricket" or cs-host matches "*.space" or cs-host matches "*.info" or cs-host matches "*.vn" or cs-host matches "*.cm" or cs-host matches "*.am" or cs-host matches "*.cc" or cs-host matches "*.asia" or cs-host matches "*.ws" or cs-host matches "*.tk" or cs-host matches "*.biz" or cs-host matches "*.su" or cs-host matches "*.st" or cs-host matches "*.ro" or cs-host matches "*.ge" or cs-host matches "*.ms" or cs-host matches "*.pk" or cs-host matches "*.nu" or cs-host matches "*.me" or cs-host matches "*.ph" or cs-host matches "*.to" or cs-host matches "*.tt" or cs-host matches "*.name" or cs-host matches "*.tv" or cs-host matches "*.kz" or cs-host matches "*.tc" or cs-host matches "*.mobi" or cs-host matches "*.study" or cs-host matches "*.click" or cs-host matches "*.link" or cs-host matches "*.trade" or cs-host matches "*.accountant" or cs-host matches "*.cf" or cs-host matches "*.gq" or cs-host matches "*.ml" or cs-host matches "*.ga" or cs-host matches "*.pw"))
