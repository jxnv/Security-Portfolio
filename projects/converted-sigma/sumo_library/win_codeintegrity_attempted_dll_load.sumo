// Title: CodeIntegrity - Unmet Signing Level Requirements By File Under Validation
// ID: f8931561-97f5-4c46-907f-0a4a592e47a7
// Status: experimental
// Level: low
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-20
// Tags: attack.execution
// Description: Detects attempted file load events that did not meet the signing level requirements. It often means the file's signature is revoked or a signature with the Lifetime Signing EKU has expired.
// This event is best correlated with EID 3089 to determine the error of the validation.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((EventID = "3033" or EventID = "3034")) and !((FileNameBuffer matches "*\\Windows\\assembly\\GAC\\*" and ProcessNameBuffer matches "*\\mscorsvw.exe" and ProcessNameBuffer matches "*\\Windows\\Microsoft.NET\\*" and RequestedPolicy = "8")) and !(((FileNameBuffer matches "*\\Windows\\System32\\DriverStore\\FileRepository\\*" and FileNameBuffer matches "*\\igd10iumd64.dll" and RequestedPolicy = "7") or ((FileNameBuffer matches "*\\Program Files\\Avast Software\\Avast\\aswAMSI.dll" or FileNameBuffer matches "*\\Program Files (x86)\\Avast Software\\Avast\\aswAMSI.dll") and (RequestedPolicy = "8" or RequestedPolicy = "12")) or (FileNameBuffer matches "*\\Program Files\\Bonjour\\mdnsNSP.dll" and (ProcessNameBuffer matches "*\\Windows\\System32\\svchost.exe" or ProcessNameBuffer matches "*\\Windows\\System32\\SIHClient.exe") and (RequestedPolicy = "8" or RequestedPolicy = "12")) or (FileNameBuffer matches "*\\Program Files\\comodo\\comodo internet security\\amsiprovider_x64.dll") or (FileNameBuffer matches "*\\Program Files\\DTrace\\dtrace.dll" and ProcessNameBuffer matches "*\\Windows\\System32\\svchost.exe" and RequestedPolicy = "12") or (FileNameBuffer matches "*\\Windows\\System32\\nvspcap64.dll" and (ProcessNameBuffer matches "*\\AppData\\Local\\Keybase\\Gui\\Keybase.exe" or ProcessNameBuffer matches "*\\Microsoft\\Teams\\stage\\Teams.exe") and RequestedPolicy = "8") or (FileNameBuffer matches "*\\Program Files\\ESET\\ESET Security\\eamsi.dll") or ((FileNameBuffer matches "*\\Mozilla Firefox\\mozavcodec.dll" or FileNameBuffer matches "*\\Mozilla Firefox\\mozavutil.dll") and ProcessNameBuffer matches "*\\Mozilla Firefox\\firefox.exe" and RequestedPolicy = "8") or (FileNameBuffer matches "*\\Program Files\\Google\\Drive File Stream\\*" and FileNameBuffer matches "*\\crashpad_handler.exe" and ProcessNameBuffer matches "*\\Windows\\ImmersiveControlPanel\\SystemSettings.exe" and RequestedPolicy = "8") or (((ProcessNameBuffer matches "*\\Kaspersky Lab\\*" and ProcessNameBuffer matches "*\\avp.exe*")) or ((FileNameBuffer matches "*\\Kaspersky Lab\\*" and FileNameBuffer matches "*\\antimalware_provider.dll*"))) or ((FileNameBuffer matches "*\\Program Files\\McAfee\\Endpoint Security\\Threat Prevention\\MfeAmsiProvider.dll" or FileNameBuffer matches "*\\Program Files\\McAfee\\MfeAV\\AMSIExt.dll")) or (FileNameBuffer matches "*\\Program Files\\National Instruments\\Shared\\mDNS Responder\\nimdnsNSP.dll ") or (FileNameBuffer matches "*\\Microsoft Office\\root\\vfs\\ProgramFilesCommonX64\\Microsoft Shared\\OFFICE*" and FileNameBuffer matches "*\\MSOXMLMF.DLL" and RequestedPolicy = "7") or (ProcessNameBuffer matches "*\\Program Files\\Microsoft Office\\root\\vfs\\ProgramFilesCommonX64\\Microsoft Shared\\Office*" and FileNameBuffer matches "*\\Windows\\System32\\*" and RequestedPolicy = "8") or (FileNameBuffer matches "*\\National Instruments\\Shared\\mDNS Responder\\*") or ((FileNameBuffer matches "*\\Program Files\\SentinelOne\\Sentinel Agent*") or (ProcessNameBuffer matches "*\\Program Files\\SentinelOne\\Sentinel Agent*")) or (FileNameBuffer matches "*\\Windows\\System32\\nvspcap64.dll" and ProcessNameBuffer matches "*\\AppData\\Local\\slack\\app-*" and ProcessNameBuffer matches "*\\slack.exe" and RequestedPolicy = "8") or (FileNameBuffer matches "*\\Trend Micro\\Client Server Security Agent\\perficrcperfmonmgr.dll" and RequestedPolicy = "8"))))
