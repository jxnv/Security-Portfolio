// Title: Suspicious Environment Variable Has Been Registered
// ID: 966315ef-c5e1-4767-ba25-fce9c8de3660
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-20
// Tags: attack.persistence, attack.stealth
// Description: Detects the creation of user-specific or system-wide environment variables via the registry. Which contains suspicious commands and strings
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((Details = "powershell" or Details = "pwsh")) or ((Details matches "*\\AppData\\Local\\Temp\\*" or Details matches "*C:\\Users\\Public\\*" or Details matches "*TVqQAAMAAAAEAAAA*" or Details matches "*TVpQAAIAAAAEAA8A*" or Details matches "*TVqAAAEAAAAEABAA*" or Details matches "*TVoAAAAAAAAAAAAA*" or Details matches "*TVpTAQEAAAAEAAAA*" or Details matches "*SW52b2tlL*" or Details matches "*ludm9rZS*" or Details matches "*JbnZva2Ut*" or Details matches "*SQBuAHYAbwBrAGUALQ*" or Details matches "*kAbgB2AG8AawBlAC0A*" or Details matches "*JAG4AdgBvAGsAZQAtA*")) or ((Details matches "SUVY*" or Details matches "SQBFAF*" or Details matches "SQBuAH*" or Details matches "cwBhA*" or Details matches "aWV4*" or Details matches "aQBlA*" or Details matches "R2V0*" or Details matches "dmFy*" or Details matches "dgBhA*" or Details matches "dXNpbm*" or Details matches "H4sIA*" or Details matches "Y21k*" or Details matches "cABhAH*" or Details matches "Qzpc*" or Details matches "Yzpc*"))) and (TargetObject matches "*\\Environment\\*"))
