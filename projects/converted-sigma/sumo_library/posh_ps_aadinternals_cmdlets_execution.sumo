// Status: test
// Level: high
// Author: Austin Songer (@austinsonger), Nasreddine Bencherchali (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2022-12-23
// Tags: attack.execution, attack.reconnaissance, attack.discovery, attack.credential-access, attack.impact
// Description: Detects ADDInternals Cmdlet execution. A tool for administering Azure AD and Office 365. Which can be abused by threat actors to attack Azure AD or Office 365.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((ScriptBlockText matches "*Add-AADInt*" or ScriptBlockText matches "*ConvertTo-AADInt*" or ScriptBlockText matches "*Disable-AADInt*" or ScriptBlockText matches "*Enable-AADInt*" or ScriptBlockText matches "*Export-AADInt*" or ScriptBlockText matches "*Find-AADInt*" or ScriptBlockText matches "*Get-AADInt*" or ScriptBlockText matches "*Grant-AADInt*" or ScriptBlockText matches "*Initialize-AADInt*" or ScriptBlockText matches "*Install-AADInt*" or ScriptBlockText matches "*Invoke-AADInt*" or ScriptBlockText matches "*Join-AADInt*" or ScriptBlockText matches "*New-AADInt*" or ScriptBlockText matches "*Open-AADInt*" or ScriptBlockText matches "*Read-AADInt*" or ScriptBlockText matches "*Register-AADInt*" or ScriptBlockText matches "*Remove-AADInt*" or ScriptBlockText matches "*Reset-AADInt*" or ScriptBlockText matches "*Resolve-AADInt*" or ScriptBlockText matches "*Restore-AADInt*" or ScriptBlockText matches "*Save-AADInt*" or ScriptBlockText matches "*Search-AADInt*" or ScriptBlockText matches "*Send-AADInt*" or ScriptBlockText matches "*Set-AADInt*" or ScriptBlockText matches "*Start-AADInt*" or ScriptBlockText matches "*Unprotect-AADInt*" or ScriptBlockText matches "*Update-AADInt*"))
