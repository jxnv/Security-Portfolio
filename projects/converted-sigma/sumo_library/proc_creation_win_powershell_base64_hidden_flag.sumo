// Title: Malicious Base64 Encoded PowerShell Keywords in Command Lines
// ID: f26c6093-6f14-4b12-800f-0fcb46f5ffd0
// Status: test
// Level: high
// Author: John Lambert (rule)
// Date: 2019-01-16
// Tags: attack.execution, attack.t1059.001
// Description: Detects base64 encoded strings used in hidden malicious PowerShell command lines
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((CommandLine matches "*AGkAdABzAGEAZABtAGkAbgAgAC8AdAByAGEAbgBzAGYAZQByA*" or CommandLine matches "*aXRzYWRtaW4gL3RyYW5zZmVy*" or CommandLine matches "*IAaQB0AHMAYQBkAG0AaQBuACAALwB0AHIAYQBuAHMAZgBlAHIA*" or CommandLine matches "*JpdHNhZG1pbiAvdHJhbnNmZX*" or CommandLine matches "*YgBpAHQAcwBhAGQAbQBpAG4AIAAvAHQAcgBhAG4AcwBmAGUAcg*" or CommandLine matches "*Yml0c2FkbWluIC90cmFuc2Zlc*" or CommandLine matches "*AGMAaAB1AG4AawBfAHMAaQB6AGUA*" or CommandLine matches "*JABjAGgAdQBuAGsAXwBzAGkAegBlA*" or CommandLine matches "*JGNodW5rX3Npem*" or CommandLine matches "*QAYwBoAHUAbgBrAF8AcwBpAHoAZQ*" or CommandLine matches "*RjaHVua19zaXpl*" or CommandLine matches "*Y2h1bmtfc2l6Z*" or CommandLine matches "*AE8ALgBDAG8AbQBwAHIAZQBzAHMAaQBvAG4A*" or CommandLine matches "*kATwAuAEMAbwBtAHAAcgBlAHMAcwBpAG8Abg*" or CommandLine matches "*lPLkNvbXByZXNzaW9u*" or CommandLine matches "*SQBPAC4AQwBvAG0AcAByAGUAcwBzAGkAbwBuA*" or CommandLine matches "*SU8uQ29tcHJlc3Npb2*" or CommandLine matches "*Ty5Db21wcmVzc2lvb*" or CommandLine matches "*AE8ALgBNAGUAbQBvAHIAeQBTAHQAcgBlAGEAbQ*" or CommandLine matches "*kATwAuAE0AZQBtAG8AcgB5AFMAdAByAGUAYQBtA*" or CommandLine matches "*lPLk1lbW9yeVN0cmVhb*" or CommandLine matches "*SQBPAC4ATQBlAG0AbwByAHkAUwB0AHIAZQBhAG0A*" or CommandLine matches "*SU8uTWVtb3J5U3RyZWFt*" or CommandLine matches "*Ty5NZW1vcnlTdHJlYW*" or CommandLine matches "*4ARwBlAHQAQwBoAHUAbgBrA*" or CommandLine matches "*5HZXRDaHVua*" or CommandLine matches "*AEcAZQB0AEMAaAB1AG4Aaw*" or CommandLine matches "*LgBHAGUAdABDAGgAdQBuAGsA*" or CommandLine matches "*LkdldENodW5r*" or CommandLine matches "*R2V0Q2h1bm*" or CommandLine matches "*AEgAUgBFAEEARABfAEkATgBGAE8ANgA0A*" or CommandLine matches "*QASABSAEUAQQBEAF8ASQBOAEYATwA2ADQA*" or CommandLine matches "*RIUkVBRF9JTkZPNj*" or CommandLine matches "*SFJFQURfSU5GTzY0*" or CommandLine matches "*VABIAFIARQBBAEQAXwBJAE4ARgBPADYANA*" or CommandLine matches "*VEhSRUFEX0lORk82N*" or CommandLine matches "*AHIAZQBhAHQAZQBSAGUAbQBvAHQAZQBUAGgAcgBlAGEAZA*" or CommandLine matches "*cmVhdGVSZW1vdGVUaHJlYW*" or CommandLine matches "*MAcgBlAGEAdABlAFIAZQBtAG8AdABlAFQAaAByAGUAYQBkA*" or CommandLine matches "*NyZWF0ZVJlbW90ZVRocmVhZ*" or CommandLine matches "*Q3JlYXRlUmVtb3RlVGhyZWFk*" or CommandLine matches "*QwByAGUAYQB0AGUAUgBlAG0AbwB0AGUAVABoAHIAZQBhAGQA*" or CommandLine matches "*0AZQBtAG0AbwB2AGUA*" or CommandLine matches "*1lbW1vdm*" or CommandLine matches "*AGUAbQBtAG8AdgBlA*" or CommandLine matches "*bQBlAG0AbQBvAHYAZQ*" or CommandLine matches "*bWVtbW92Z*" or CommandLine matches "*ZW1tb3Zl*")) and (CommandLine matches "* hidden *") and (((Image matches "*\\powershell.exe" or Image matches "*\\pwsh.exe")) or ((OriginalFileName = "PowerShell.EXE" or OriginalFileName = "pwsh.dll"))))
