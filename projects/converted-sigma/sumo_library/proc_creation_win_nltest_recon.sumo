// Title: Potential Recon Activity Via Nltest.EXE
// ID: 5cc90652-4cbd-4241-aa3b-4b462fa5a248
// Status: test
// Level: medium
// Author: Craig Young, oscd.community, Georg Lauenstein
// Date: 2021-07-24
// Tags: attack.discovery, attack.t1016, attack.t1482
// Description: Detects nltest commands that can be used for information discovery
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (((Image matches "*\\nltest.exe") or (OriginalFileName = "nltestrk.exe")) and (((CommandLine matches "*server*" and CommandLine matches "*query*")) or ((CommandLine matches "*/user*" or CommandLine matches "*all_trusts*" or CommandLine matches "*dclist:*" or CommandLine matches "*dnsgetdc:*" or CommandLine matches "*domain_trusts*" or CommandLine matches "*dsgetdc:*" or CommandLine matches "*parentdomain*" or CommandLine matches "*trusted_domains*"))))
