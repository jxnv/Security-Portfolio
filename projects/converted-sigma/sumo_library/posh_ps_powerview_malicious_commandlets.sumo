// Title: PowerView PowerShell Cmdlets - ScriptBlock
// ID: dcd74b95-3f36-4ed9-9598-0490951643aa
// Status: test
// Level: high
// Author: Bhabesh Raj
// Date: 2021-05-18
// Tags: attack.execution, attack.t1059.001
// Description: Detects Cmdlet names from PowerView of the PowerSploit exploitation framework.
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((ScriptBlockText matches "*Export-PowerViewCSV*" or ScriptBlockText matches "*Find-DomainLocalGroupMember*" or ScriptBlockText matches "*Find-DomainObjectPropertyOutlier*" or ScriptBlockText matches "*Find-DomainProcess*" or ScriptBlockText matches "*Find-DomainShare*" or ScriptBlockText matches "*Find-DomainUserEvent*" or ScriptBlockText matches "*Find-DomainUserLocation*" or ScriptBlockText matches "*Find-ForeignGroup*" or ScriptBlockText matches "*Find-ForeignUser*" or ScriptBlockText matches "*Find-GPOComputerAdmin*" or ScriptBlockText matches "*Find-GPOLocation*" or ScriptBlockText matches "*Find-InterestingDomain*" or ScriptBlockText matches "*Find-InterestingFile*" or ScriptBlockText matches "*Find-LocalAdminAccess*" or ScriptBlockText matches "*Find-ManagedSecurityGroups*" or ScriptBlockText matches "*Get-CachedRDPConnection*" or ScriptBlockText matches "*Get-DFSshare*" or ScriptBlockText matches "*Get-DomainDFSShare*" or ScriptBlockText matches "*Get-DomainDNSRecord*" or ScriptBlockText matches "*Get-DomainDNSZone*" or ScriptBlockText matches "*Get-DomainFileServer*" or ScriptBlockText matches "*Get-DomainGPOComputerLocalGroupMapping*" or ScriptBlockText matches "*Get-DomainGPOLocalGroup*" or ScriptBlockText matches "*Get-DomainGPOUserLocalGroupMapping*" or ScriptBlockText matches "*Get-LastLoggedOn*" or ScriptBlockText matches "*Get-LoggedOnLocal*" or ScriptBlockText matches "*Get-NetFileServer*" or ScriptBlockText matches "*Get-NetForest*" or ScriptBlockText matches "*Get-NetGPOGroup*" or ScriptBlockText matches "*Get-NetProcess*" or ScriptBlockText matches "*Get-NetRDPSession*" or ScriptBlockText matches "*Get-RegistryMountedDrive*" or ScriptBlockText matches "*Get-RegLoggedOn*" or ScriptBlockText matches "*Get-WMIRegCachedRDPConnection*" or ScriptBlockText matches "*Get-WMIRegLastLoggedOn*" or ScriptBlockText matches "*Get-WMIRegMountedDrive*" or ScriptBlockText matches "*Get-WMIRegProxy*" or ScriptBlockText matches "*Invoke-ACLScanner*" or ScriptBlockText matches "*Invoke-CheckLocalAdminAccess*" or ScriptBlockText matches "*Invoke-EnumerateLocalAdmin*" or ScriptBlockText matches "*Invoke-EventHunter*" or ScriptBlockText matches "*Invoke-FileFinder*" or ScriptBlockText matches "*Invoke-Kerberoast*" or ScriptBlockText matches "*Invoke-MapDomainTrust*" or ScriptBlockText matches "*Invoke-ProcessHunter*" or ScriptBlockText matches "*Invoke-RevertToSelf*" or ScriptBlockText matches "*Invoke-ShareFinder*" or ScriptBlockText matches "*Invoke-UserHunter*" or ScriptBlockText matches "*Invoke-UserImpersonation*" or ScriptBlockText matches "*Remove-RemoteConnection*" or ScriptBlockText matches "*Request-SPNTicket*" or ScriptBlockText matches "*Resolve-IPAddress*"))
