// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via VAR++ LAUNCHER
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where (EventID = "4697" and (ServiceFileName matches "*&&set*" and ServiceFileName matches "*cmd*" and ServiceFileName matches "*/c*" and ServiceFileName matches "*-f*") and (ServiceFileName matches "*{0}*" or ServiceFileName matches "*{1}*" or ServiceFileName matches "*{2}*" or ServiceFileName matches "*{3}*" or ServiceFileName matches "*{4}*" or ServiceFileName matches "*{5}*"))
