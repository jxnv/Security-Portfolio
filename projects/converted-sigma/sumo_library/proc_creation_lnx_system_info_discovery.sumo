// Title: System Information Discovery
// ID: 42df45e7-e6e9-43b5-8f26-bec5b39cc239
// Status: stable
// Level: informational
// Author: Ömer Günal, oscd.community
// Date: 2020-10-08
// Tags: attack.discovery, attack.t1082
// Description: Detects system information discovery commands
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*/uname" or Image matches "*/hostname" or Image matches "*/uptime" or Image matches "*/lspci" or Image matches "*/dmidecode" or Image matches "*/lscpu" or Image matches "*/lsmod"))
