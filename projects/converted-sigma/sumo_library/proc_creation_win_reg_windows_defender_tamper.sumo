// Title: Suspicious Windows Defender Registry Key Tampering Via Reg.EXE
// ID: 452bce90-6fb0-43cc-97a5-affc283139b3
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Swachchhanda Shrawan Poudel, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-03-22
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects the usage of "reg.exe" to tamper with different Windows Defender registry keys in order to disable some important features related to protection and detection
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((((Image matches "*\\reg.exe") or (OriginalFileName = "reg.exe")) and ((CommandLine matches "*SOFTWARE\\Microsoft\\Windows Defender\\*" or CommandLine matches "*SOFTWARE\\Policies\\Microsoft\\Windows Defender Security Center*" or CommandLine matches "*SOFTWARE\\Policies\\Microsoft\\Windows Defender\\*"))) and (((CommandLine matches "* add *" and CommandLine matches "*d 0*") and (CommandLine matches "*DisallowExploitProtectionOverride*" or CommandLine matches "*EnableControlledFolderAccess*" or CommandLine matches "*MpEnablePus*" or CommandLine matches "*PUAProtection*" or CommandLine matches "*SpynetReporting*" or CommandLine matches "*SubmitSamplesConsent*" or CommandLine matches "*TamperProtection*")) or ((CommandLine matches "* add *" and CommandLine matches "*d 1*") and (CommandLine matches "*DisableAccess*" or CommandLine matches "*DisableAntiSpyware*" or CommandLine matches "*DisableAntiSpywareRealtimeProtection*" or CommandLine matches "*DisableAntiVirus*" or CommandLine matches "*DisableAntiVirusSignatures*" or CommandLine matches "*DisableArchiveScanning*" or CommandLine matches "*DisableBehaviorMonitoring*" or CommandLine matches "*DisableBlockAtFirstSeen*" or CommandLine matches "*DisableCloudProtection*" or CommandLine matches "*DisableConfig*" or CommandLine matches "*DisableEnhancedNotifications*" or CommandLine matches "*DisableIntrusionPreventionSystem*" or CommandLine matches "*DisableIOAVProtection*" or CommandLine matches "*DisableNetworkProtection*" or CommandLine matches "*DisableOnAccessProtection*" or CommandLine matches "*DisablePrivacyMode*" or CommandLine matches "*DisableRealtimeMonitoring*" or CommandLine matches "*DisableRoutinelyTakingAction*" or CommandLine matches "*DisableScanOnRealtimeEnable*" or CommandLine matches "*DisableScriptScanning*" or CommandLine matches "*DisableSecurityCenter*" or CommandLine matches "*Notification_Suppress*" or CommandLine matches "*SignatureDisableUpdateOnStartupWithoutEngine*"))))
