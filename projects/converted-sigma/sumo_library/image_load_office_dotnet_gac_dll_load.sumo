// Title: GAC DLL Loaded Via Office Applications
// ID: 90217a70-13fc-48e4-b3db-0d836c5824ac
// Status: test
// Level: high
// Author: Antonlovesdnb
// Date: 2020-02-19
// Tags: attack.execution, attack.t1204.002
// Description: Detects any GAC DLL being loaded by an Office Product
// Converted by: Sigma Universal SIEM/EDR CLI

_sourceCategory=* | where ((Image matches "*\\excel.exe" or Image matches "*\\mspub.exe" or Image matches "*\\onenote.exe" or Image matches "*\\onenoteim.exe" or Image matches "*\\outlook.exe" or Image matches "*\\powerpnt.exe" or Image matches "*\\winword.exe") and ImageLoaded matches "C:\\Windows\\Microsoft.NET\\assembly\\GAC_MSIL*")
