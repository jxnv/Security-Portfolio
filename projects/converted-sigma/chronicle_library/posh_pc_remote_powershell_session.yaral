rule 60167e5c_84b2_4c95_a7ac_86281f27c445 {
  meta:
    title = "Remote PowerShell Session (PS Classic)"
    description = "Detects remote PowerShell sessions"
    author = "Roberto Rodriguez @Cyb3rWard0g"
    severity = "LOW"

  events:
    (($e.Data = /.*HostName=ServerRemoteHost.*/ nocase and $e.Data = /.*wsmprovhost.exe.*/ nocase))

  condition:
    $e
}
