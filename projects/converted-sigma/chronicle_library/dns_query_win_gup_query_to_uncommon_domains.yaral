// Title: Notepad++ Updater DNS Query to Uncommon Domains
// ID: 2074e137-1b73-4e2d-88ba-5a3407dbdce0
// Status: experimental
// Level: medium
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-02-02
// Tags: attack.collection, attack.credential-access, attack.t1195.002, attack.initial-access, attack.t1557
// Description: Detects when the Notepad++ updater (gup.exe) makes DNS queries to domains that are not part of the known legitimate update infrastructure.
// This could indicate potential exploitation of the updater mechanism or suspicious network activity that warrants further investigation.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 2074e137_1b73_4e2d_88ba_5a3407dbdce0 {
  meta:
    title = "Notepad++ Updater DNS Query to Uncommon Domains"
    description = "Detects when the Notepad++ updater (gup.exe) makes DNS queries to domains that are not part of the known legitimate update infrastructure. This could indicate potential exploitation of the updater mechanism or suspicious network activity that warrants further investigation."
    author = "Swachchhanda Shrawan Poudel (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.target.process.file.full_path = /.*\\gup.exe$/ nocase) and not(($e.QueryName = "notepad-plus-plus.org")) and not(((($e.QueryName = /.*.githubusercontent.com$/ nocase) or ($e.QueryName = "github.com")) or ($e.QueryName = /.*.googleapis.com$/ nocase) or ($e.QueryName = /.*.sourceforge.net$/ nocase) or (($e.QueryName = /.*.azurewebsites.net$/ nocase or $e.QueryName = /.*block.opendns.com$/ nocase or $e.QueryName = /.*gateway.zscalerthree.net$/ nocase)))))

  condition:
    $e
}
