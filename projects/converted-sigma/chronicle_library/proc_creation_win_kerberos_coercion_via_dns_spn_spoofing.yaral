// Title: Attempts of Kerberos Coercion Via DNS SPN Spoofing
// ID: 0ed99dda-6a35-11ef-8c99-0242ac120002
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-06-20
// Tags: attack.collection, attack.credential-access, attack.persistence, attack.privilege-escalation, attack.t1557.001, attack.t1187
// Description: Detects the presence of "UWhRC....AAYBAAAA" pattern in command line.
// The pattern "1UWhRCAAAAA..BAAAA" is a base64-encoded signature that corresponds to a marshaled CREDENTIAL_TARGET_INFORMATION structure.
// Attackers can use this technique to coerce authentication from victim systems to attacker-controlled hosts.
// It is one of the strong indicators of a Kerberos coercion attack, where adversaries manipulate DNS records
// to spoof Service Principal Names (SPNs) and redirect authentication requests like in CVE-2025-33073.
// If you see this pattern in the command line, it is likely an attempt to add spoofed Service Principal Names (SPNs) to DNS records,
// or checking for the presence of such records through the `nslookup` command.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 0ed99dda_6a35_11ef_8c99_0242ac120002 {
  meta:
    title = "Attempts of Kerberos Coercion Via DNS SPN Spoofing"
    description = "Detects the presence of "UWhRC....AAYBAAAA" pattern in command line. The pattern "1UWhRCAAAAA..BAAAA" is a base64-encoded signature that corresponds to a marshaled CREDENTIAL_TARGET_INFORMATION structure. Attackers can use this technique to coerce authentication from victim systems to attacker-controlled hosts. It is one of the strong indicators of a Kerberos coercion attack, where adversaries manipulate DNS records to spoof Service Principal Names (SPNs) and redirect authentication requests like in CVE-2025-33073. If you see this pattern in the command line, it is likely an attempt to add spoofed Service Principal Names (SPNs) to DNS records, or checking for the presence of such records through the `nslookup` command."
    author = "Swachchhanda Shrawan Poudel (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.command_line = /.*UWhRCA.*/ nocase and $e.target.process.command_line = /.*BAAAA.*/ nocase))

  condition:
    $e
}
