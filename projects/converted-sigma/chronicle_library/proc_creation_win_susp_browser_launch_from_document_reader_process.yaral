// Title: Potential Suspicious Browser Launch From Document Reader Process
// ID: 1193d960-2369-499f-a158-7b50a31df682
// Status: test
// Level: medium
// Author: Joseph Kamau
// Date: 2024-05-27
// Tags: attack.execution, attack.t1204.002
// Description: Detects when a browser process or browser tab is launched from an application that handles document files such as Adobe, Microsoft Office, etc. And connects to a web application over http(s), this could indicate a possible phishing attempt.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 1193d960_2369_499f_a158_7b50a31df682 {
  meta:
    title = "Potential Suspicious Browser Launch From Document Reader Process"
    description = "Detects when a browser process or browser tab is launched from an application that handles document files such as Adobe, Microsoft Office, etc. And connects to a web application over http(s), this could indicate a possible phishing attempt."
    author = "Joseph Kamau"
    severity = "MEDIUM"

  events:
    ((($e.principal.process.file.full_path = /.*Acrobat Reader.*/ nocase or $e.principal.process.file.full_path = /.*Microsoft Office.*/ nocase or $e.principal.process.file.full_path = /.*PDF Reader.*/ nocase) and ($e.target.process.file.full_path = /.*\\brave.exe$/ nocase or $e.target.process.file.full_path = /.*\\chrome.exe$/ nocase or $e.target.process.file.full_path = /.*\\firefox.exe$/ nocase or $e.target.process.file.full_path = /.*\\msedge.exe$/ nocase or $e.target.process.file.full_path = /.*\\opera.exe$/ nocase or $e.target.process.file.full_path = /.*\\maxthon.exe$/ nocase or $e.target.process.file.full_path = /.*\\seamonkey.exe$/ nocase or $e.target.process.file.full_path = /.*\\vivaldi.exe$/ nocase) and $e.target.process.command_line = /.*http.*/ nocase) and not(($e.target.process.command_line = /.*https://go.microsoft.com/fwlink/.*/ nocase)) and not((($e.target.process.command_line = /.*http://ad.foxitsoftware.com/adlog.php?.*/ nocase or $e.target.process.command_line = /.*https://globe-map.foxitservice.com/go.php?do=redirect.*/ nocase))))

  condition:
    $e
}
