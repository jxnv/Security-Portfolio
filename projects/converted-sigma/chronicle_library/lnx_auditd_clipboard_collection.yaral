// Title: Clipboard Collection with Xclip Tool - Auditd
// ID: 214e7e6c-f21b-47ff-bb6f-551b2d143fcf
// Status: test
// Level: low
// Author: Pawel Mazur
// Date: 2021-09-24
// Tags: attack.collection, attack.t1115
// Description: Detects attempts to collect data stored in the clipboard from users with the usage of xclip tool.
// Xclip has to be installed.
// Highly recommended using rule on servers, due to high usage of clipboard utilities on user workstations.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 214e7e6c_f21b_47ff_bb6f_551b2d143fcf {
  meta:
    title = "Clipboard Collection with Xclip Tool - Auditd"
    description = "Detects attempts to collect data stored in the clipboard from users with the usage of xclip tool. Xclip has to be installed. Highly recommended using rule on servers, due to high usage of clipboard utilities on user workstations."
    author = "Pawel Mazur"
    severity = "LOW"

  events:
    ($e.type = "EXECVE" and $e.a0 = "xclip" and ($e.a1 = "-selection" or $e.a1 = "-sel") and ($e.a2 = "clipboard" or $e.a2 = "clip") and $e.a3 = "-o")

  condition:
    $e
}
