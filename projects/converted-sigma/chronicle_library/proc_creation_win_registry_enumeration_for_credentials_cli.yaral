// Title: Enumeration for 3rd Party Creds From CLI
// ID: 87a476dc-0079-4583-a985-dee7a20a03de
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-20
// Tags: attack.credential-access, attack.t1552.002
// Description: Detects processes that query known 3rd party registry keys that holds credentials via commandline
// Converted by: Sigma Universal SIEM/EDR CLI

rule 87a476dc_0079_4583_a985_dee7a20a03de {
  meta:
    title = "Enumeration for 3rd Party Creds From CLI"
    description = "Detects processes that query known 3rd party registry keys that holds credentials via commandline"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*\\Software\\Aerofox\\Foxmail\\V3.1.*/ nocase or $e.target.process.command_line = /.*\\Software\\Aerofox\\FoxmailPreview.*/ nocase or $e.target.process.command_line = /.*\\Software\\DownloadManager\\Passwords.*/ nocase or $e.target.process.command_line = /.*\\Software\\FTPWare\\COREFTP\\Sites.*/ nocase or $e.target.process.command_line = /.*\\Software\\IncrediMail\\Identities.*/ nocase or $e.target.process.command_line = /.*\\Software\\Martin Prikryl\\WinSCP 2\\Sessions.*/ nocase or $e.target.process.command_line = /.*\\Software\\Mobatek\\MobaXterm\\.*/ nocase or $e.target.process.command_line = /.*\\Software\\OpenSSH\\Agent\\Keys.*/ nocase or $e.target.process.command_line = /.*\\Software\\OpenVPN-GUI\\configs.*/ nocase or $e.target.process.command_line = /.*\\Software\\ORL\\WinVNC3\\Password.*/ nocase or $e.target.process.command_line = /.*\\Software\\Qualcomm\\Eudora\\CommandLine.*/ nocase or $e.target.process.command_line = /.*\\Software\\RealVNC\\WinVNC4.*/ nocase or $e.target.process.command_line = /.*\\Software\\RimArts\\B2\\Settings.*/ nocase or $e.target.process.command_line = /.*\\Software\\SimonTatham\\PuTTY\\Sessions.*/ nocase or $e.target.process.command_line = /.*\\Software\\SimonTatham\\PuTTY\\SshHostKeys\\.*/ nocase or $e.target.process.command_line = /.*\\Software\\Sota\\FFFTP.*/ nocase or $e.target.process.command_line = /.*\\Software\\TightVNC\\Server.*/ nocase or $e.target.process.command_line = /.*\\Software\\WOW6432Node\\Radmin\\v3.0\\Server\\Parameters\\Radmin.*/ nocase)) and not(($e.target.process.file.full_path = /.*reg.exe$/ nocase and ($e.target.process.command_line = /.*export.*/ nocase or $e.target.process.command_line = /.*save.*/ nocase))))

  condition:
    $e
}
