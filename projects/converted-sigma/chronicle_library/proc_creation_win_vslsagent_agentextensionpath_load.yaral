// Title: Suspicious Vsls-Agent Command With AgentExtensionPath Load
// ID: 43103702-5886-11ed-9b6a-0242ac120002
// Status: test
// Level: medium
// Author: bohops
// Date: 2022-10-30
// Tags: attack.stealth, attack.t1218
// Description: Detects Microsoft Visual Studio vsls-agent.exe lolbin execution with a suspicious library load using the --agentExtensionPath parameter
// Converted by: Sigma Universal SIEM/EDR CLI

rule 43103702_5886_11ed_9b6a_0242ac120002 {
  meta:
    title = "Suspicious Vsls-Agent Command With AgentExtensionPath Load"
    description = "Detects Microsoft Visual Studio vsls-agent.exe lolbin execution with a suspicious library load using the --agentExtensionPath parameter"
    author = "bohops"
    severity = "MEDIUM"

  events:
    (($e.target.process.file.full_path = /.*\\vsls-agent.exe$/ nocase and $e.target.process.command_line = /.*--agentExtensionPath.*/ nocase) and not(($e.target.process.command_line = /.*Microsoft.VisualStudio.LiveShare.Agent..*/ nocase)))

  condition:
    $e
}
