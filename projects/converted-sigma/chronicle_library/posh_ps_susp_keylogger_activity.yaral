// Title: Potential Keylogger Activity
// ID: 965e2db9-eddb-4cf6-a986-7a967df651e4
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-04
// Tags: attack.collection, attack.credential-access, attack.t1056.001
// Description: Detects PowerShell scripts that contains reference to keystroke capturing functions
// Converted by: Sigma Universal SIEM/EDR CLI

rule 965e2db9_eddb_4cf6_a986_7a967df651e4 {
  meta:
    title = "Potential Keylogger Activity"
    description = "Detects PowerShell scripts that contains reference to keystroke capturing functions"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ($e.ScriptBlockText = /.*[Windows.Input.Keyboard]::IsKeyDown([System.Windows.Input.Key]::.*/ nocase)

  condition:
    $e
}
