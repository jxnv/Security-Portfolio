// Title: User Added To Admin Group Via DseditGroup
// ID: 5d0fdb62-f225-42fb-8402-3dfe64da468a
// Status: test
// Level: medium
// Author: Sohan G (D4rkCiph3r)
// Date: 2023-08-22
// Tags: attack.persistence, attack.initial-access, attack.privilege-escalation, attack.stealth, attack.t1078.003
// Description: Detects attempts to create and/or add an account to the admin group, thus granting admin privileges.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 5d0fdb62_f225_42fb_8402_3dfe64da468a {
  meta:
    title = "User Added To Admin Group Via DseditGroup"
    description = "Detects attempts to create and/or add an account to the admin group, thus granting admin privileges."
    author = "Sohan G (D4rkCiph3r)"
    severity = "MEDIUM"

  events:
    ($e.target.process.file.full_path = /.*/dseditgroup$/ nocase and ($e.target.process.command_line = /.* -o edit .*/ nocase and $e.target.process.command_line = /.* -a .*/ nocase and $e.target.process.command_line = /.* -t user.*/ nocase and $e.target.process.command_line = /.*admin.*/ nocase))

  condition:
    $e
}
