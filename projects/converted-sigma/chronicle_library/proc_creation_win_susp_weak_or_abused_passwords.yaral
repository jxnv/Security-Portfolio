// Title: Weak or Abused Passwords In CLI
// ID: 91edcfb1-2529-4ac2-9ecc-7617f895c7e4
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-14
// Tags: attack.execution, attack.stealth
// Description: Detects weak passwords or often abused passwords (seen used by threat actors) via the CLI.
// An example would be a threat actor creating a new user via the net command and providing the password inline
// Converted by: Sigma Universal SIEM/EDR CLI

rule 91edcfb1_2529_4ac2_9ecc_7617f895c7e4 {
  meta:
    title = "Weak or Abused Passwords In CLI"
    description = "Detects weak passwords or often abused passwords (seen used by threat actors) via the CLI. An example would be a threat actor creating a new user via the net command and providing the password inline"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.target.process.command_line = /.*123456789.*/ nocase or $e.target.process.command_line = /.*123123qwE.*/ nocase or $e.target.process.command_line = /.*Asd123.aaaa.*/ nocase or $e.target.process.command_line = /.*Decryptme.*/ nocase or $e.target.process.command_line = /.*P@ssw0rd!.*/ nocase or $e.target.process.command_line = /.*Pass8080.*/ nocase or $e.target.process.command_line = /.*password123.*/ nocase or $e.target.process.command_line = /.*test@202.*/ nocase))

  condition:
    $e
}
