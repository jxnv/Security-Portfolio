// Title: Arbitrary File Download Via PresentationHost.EXE
// ID: b124ddf4-778d-418e-907f-6dd3fc0d31cd
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-19
// Tags: attack.execution, attack.stealth, attack.t1218
// Description: Detects usage of "PresentationHost" which is a utility that runs ".xbap" (Browser Applications) files to download arbitrary files
// Converted by: Sigma Universal SIEM/EDR CLI

rule b124ddf4_778d_418e_907f_6dd3fc0d31cd {
  meta:
    title = "Arbitrary File Download Via PresentationHost.EXE"
    description = "Detects usage of "PresentationHost" which is a utility that runs ".xbap" (Browser Applications) files to download arbitrary files"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*http://.*/ nocase or $e.target.process.command_line = /.*https://.*/ nocase or $e.target.process.command_line = /.*ftp://.*/ nocase)) and (($e.target.process.file.full_path = /.*\\presentationhost.exe$/ nocase) or ($e.target.process.file.name = "PresentationHost.exe")))

  condition:
    $e
}
