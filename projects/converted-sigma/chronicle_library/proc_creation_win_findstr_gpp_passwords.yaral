// Title: Findstr GPP Passwords
// ID: 91a2c315-9ee6-4052-a853-6f6a8238f90d
// Status: test
// Level: high
// Author: frack113
// Date: 2021-12-27
// Tags: attack.credential-access, attack.t1552.006
// Description: Look for the encrypted cpassword value within Group Policy Preference files on the Domain Controller. This value can be decrypted with gpp-decrypt.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 91a2c315_9ee6_4052_a853_6f6a8238f90d {
  meta:
    title = "Findstr GPP Passwords"
    description = "Look for the encrypted cpassword value within Group Policy Preference files on the Domain Controller. This value can be decrypted with gpp-decrypt."
    author = "frack113"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*cpassword.*/ nocase and $e.target.process.command_line = /.*\\sysvol\\.*/ nocase and $e.target.process.command_line = /.*.xml.*/ nocase)) and ((($e.target.process.file.full_path = /.*\\find.exe$/ nocase or $e.target.process.file.full_path = /.*\\findstr.exe$/ nocase)) or (($e.target.process.file.name = "FIND.EXE" or $e.target.process.file.name = "FINDSTR.EXE"))))

  condition:
    $e
}
