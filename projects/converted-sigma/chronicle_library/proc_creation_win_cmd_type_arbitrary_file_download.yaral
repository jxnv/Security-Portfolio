// Title: Potential Download/Upload Activity Using Type Command
// ID: aa0b3a82-eacc-4ec3-9150-b5a9a3e3f82f
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-14
// Tags: attack.command-and-control, attack.t1105
// Description: Detects usage of the "type" command to download/upload data from WebDAV server
// Converted by: Sigma Universal SIEM/EDR CLI

rule aa0b3a82_eacc_4ec3_9150_b5a9a3e3f82f {
  meta:
    title = "Potential Download/Upload Activity Using Type Command"
    description = "Detects usage of the "type" command to download/upload data from WebDAV server"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*type \\\\\\\\.*/ nocase and $e.target.process.command_line = /.* > .*/ nocase)) or (($e.target.process.command_line = /.*type .*/ nocase and $e.target.process.command_line = /.* > \\\\\\\\.*/ nocase)))

  condition:
    $e
}
