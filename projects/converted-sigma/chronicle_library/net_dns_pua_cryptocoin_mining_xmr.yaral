// Title: Monero Crypto Coin Mining Pool Lookup
// ID: b593fd50-7335-4682-a36c-4edcb68e4641
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-10-24
// Tags: attack.impact, attack.t1496, attack.exfiltration, attack.t1567
// Description: Detects suspicious DNS queries to Monero mining pools
// Converted by: Sigma Universal SIEM/EDR CLI

rule b593fd50_7335_4682_a36c_4edcb68e4641 {
  meta:
    title = "Monero Crypto Coin Mining Pool Lookup"
    description = "Detects suspicious DNS queries to Monero mining pools"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.query = /.*pool.minexmr.com.*/ nocase or $e.query = /.*fr.minexmr.com.*/ nocase or $e.query = /.*de.minexmr.com.*/ nocase or $e.query = /.*sg.minexmr.com.*/ nocase or $e.query = /.*ca.minexmr.com.*/ nocase or $e.query = /.*us-west.minexmr.com.*/ nocase or $e.query = /.*pool.supportxmr.com.*/ nocase or $e.query = /.*mine.c3pool.com.*/ nocase or $e.query = /.*xmr-eu1.nanopool.org.*/ nocase or $e.query = /.*xmr-eu2.nanopool.org.*/ nocase or $e.query = /.*xmr-us-east1.nanopool.org.*/ nocase or $e.query = /.*xmr-us-west1.nanopool.org.*/ nocase or $e.query = /.*xmr-asia1.nanopool.org.*/ nocase or $e.query = /.*xmr-jp1.nanopool.org.*/ nocase or $e.query = /.*xmr-au1.nanopool.org.*/ nocase or $e.query = /.*xmr.2miners.com.*/ nocase or $e.query = /.*xmr.hashcity.org.*/ nocase or $e.query = /.*xmr.f2pool.com.*/ nocase or $e.query = /.*xmrpool.eu.*/ nocase or $e.query = /.*pool.hashvault.pro.*/ nocase))

  condition:
    $e
}
