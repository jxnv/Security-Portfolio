// Title: Registry Disable System Restore
// ID: 5de03871-5d46-4539-a82d-3aa992a69a83
// Status: test
// Level: high
// Author: frack113
// Date: 2022-04-04
// Tags: attack.impact, attack.t1490
// Description: Detects the modification of the registry to disable a system restore on the computer
// Converted by: Sigma Universal SIEM/EDR CLI

rule 5de03871_5d46_4539_a82d_3aa992a69a83 {
  meta:
    title = "Registry Disable System Restore"
    description = "Detects the modification of the registry to disable a system restore on the computer"
    author = "frack113"
    severity = "HIGH"

  events:
    (($e.TargetObject = /.*\\Policies\\Microsoft\\Windows NT\\SystemRestore.*/ nocase or $e.TargetObject = /.*\\Microsoft\\Windows NT\\CurrentVersion\\SystemRestore.*/ nocase) and ($e.TargetObject = /.*DisableConfig$/ nocase or $e.TargetObject = /.*DisableSR$/ nocase) and $e.Details = "DWORD (0x00000001)")

  condition:
    $e
}
