// Title: Rundll32 Internet Connection
// ID: cdc8da7d-c303-42f8-b08c-b4ab47230263
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2017-11-04
// Tags: attack.stealth, attack.t1218.011, attack.execution
// Description: Detects a rundll32 that communicates with public IP addresses
// Converted by: Sigma Universal SIEM/EDR CLI

rule cdc8da7d_c303_42f8_b08c_b4ab47230263 {
  meta:
    title = "Rundll32 Internet Connection"
    description = "Detects a rundll32 that communicates with public IP addresses"
    author = "Florian Roth (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase and $e.Initiated = "true") and not((($e.target.process.command_line = /.*\\system32\\PcaSvc.dll,PcaPatchSdbTask$/ nocase) or ($e.SourceHostname = /.*.internal.cloudapp.net$/ nocase) or ((net.ip_in_range_cidr($e.target.ip, "127.0.0.0/8") or net.ip_in_range_cidr($e.target.ip, "10.0.0.0/8") or net.ip_in_range_cidr($e.target.ip, "172.16.0.0/12") or net.ip_in_range_cidr($e.target.ip, "192.168.0.0/16") or net.ip_in_range_cidr($e.target.ip, "169.254.0.0/16") or net.ip_in_range_cidr($e.target.ip, "::1/128") or net.ip_in_range_cidr($e.target.ip, "fe80::/10") or net.ip_in_range_cidr($e.target.ip, "fc00::/7"))) or ((net.ip_in_range_cidr($e.target.ip, "20.0.0.0/8") or net.ip_in_range_cidr($e.target.ip, "51.103.0.0/16") or net.ip_in_range_cidr($e.target.ip, "51.104.0.0/16") or net.ip_in_range_cidr($e.target.ip, "51.105.0.0/16"))) or ($e.principal.process.file.full_path = "C:\\Windows\\System32\\svchost.exe" and $e.target.port = 443))))

  condition:
    $e
}
