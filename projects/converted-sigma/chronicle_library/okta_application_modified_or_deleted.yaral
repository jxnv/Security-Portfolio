rule 7899144b_e416_4c28_b0b5_ab8f9e0a541d {
  meta:
    title = "Okta Application Modified or Deleted"
    description = "Detects when an application is modified or deleted."
    author = "Austin Songer @austinsonger"
    severity = "MEDIUM"

  events:
    (($e.eventType = "application.lifecycle.update" or $e.eventType = "application.lifecycle.delete"))

  condition:
    $e
}
