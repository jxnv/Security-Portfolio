// Title: Windows WebDAV User Agent
// ID: e09aed7a-09e0-4c9a-90dd-f0d52507347e
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2018-04-06
// Tags: attack.command-and-control, attack.t1071.001
// Description: Detects WebDav DownloadCradle
// Converted by: Sigma Universal SIEM/EDR CLI

rule e09aed7a_09e0_4c9a_90dd_f0d52507347e {
  meta:
    title = "Windows WebDAV User Agent"
    description = "Detects WebDav DownloadCradle"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    ($e.c-useragent = /^Microsoft-WebDAV-MiniRedir/.*/ nocase and $e.cs-method = "GET")

  condition:
    $e
}
