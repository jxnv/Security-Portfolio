rule b6e2a2e3_2d30_43b1_a4ea_071e36595690 {
  meta:
    title = "Space After Filename - macOS"
    description = "Detects attempts to masquerade as legitimate files by adding a space to the end of the filename."
    author = "remotephone"
    severity = "LOW"

  events:
    (($e.target.process.command_line = /.* $/ nocase) or ($e.target.process.file.full_path = /.* $/ nocase))

  condition:
    $e
}
