// Title: Desktop.INI Created by Uncommon Process
// ID: 81315b50-6b60-4d8f-9928-3466e1022515
// Status: test
// Level: medium
// Author: Maxime Thiebaut (@0xThiebaut), Tim Shelton (HAWK.IO)
// Date: 2020-03-19
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.009
// Description: Detects unusual processes accessing desktop.ini, which can be leveraged to alter how Explorer displays a folder's content (i.e. renaming files) without changing them on disk.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 81315b50_6b60_4d8f_9928_3466e1022515 {
  meta:
    title = "Desktop.INI Created by Uncommon Process"
    description = "Detects unusual processes accessing desktop.ini, which can be leveraged to alter how Explorer displays a folder's content (i.e. renaming files) without changing them on disk."
    author = "Maxime Thiebaut (@0xThiebaut), Tim Shelton (HAWK.IO)"
    severity = "MEDIUM"

  events:
    (($e.target.file.full_path = /.*\\desktop.ini$/ nocase) and not(((($e.target.process.file.full_path = /^C:\\Windows\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files (x86)\\.*/ nocase)) or ($e.target.file.full_path = /^C:\\$WINDOWS.~BT\\NewOS\\.*/ nocase))) and not((($e.target.process.file.full_path = /^C:\\Users\\.*/ nocase and $e.target.process.file.full_path = /.*\\AppData\\Local\\JetBrains\\Toolbox\\bin\\7z.exe$/ nocase and $e.target.file.full_path = /.*\\JetBrains\\apps\\.*/ nocase) or ($e.target.process.file.full_path = /^C:\\Users\\.*/ nocase and $e.target.process.file.full_path = /.*\\AppData\\Local\\Microsoft\\OneDrive\\.*/ nocase))))

  condition:
    $e
}
