// Title: Suspicious Screensaver Binary File Creation
// ID: 97aa2e88-555c-450d-85a6-229bcd87efb8
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-12-29
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.002
// Description: Adversaries may establish persistence by executing malicious content triggered by user inactivity.
// Screensavers are programs that execute after a configurable time of user inactivity and consist of Portable Executable (PE) files with a .scr file extension
// Converted by: Sigma Universal SIEM/EDR CLI

rule 97aa2e88_555c_450d_85a6_229bcd87efb8 {
  meta:
    title = "Suspicious Screensaver Binary File Creation"
    description = "Adversaries may establish persistence by executing malicious content triggered by user inactivity. Screensavers are programs that execute after a configurable time of user inactivity and consist of Portable Executable (PE) files with a .scr file extension"
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.target.file.full_path = /.*.scr$/ nocase) and not(((($e.target.process.file.full_path = /.*\\Kindle.exe$/ nocase or $e.target.process.file.full_path = /.*\\Bin\\ccSvcHst.exe$/ nocase)) or ($e.target.process.file.full_path = /.*\\TiWorker.exe$/ nocase and $e.target.file.full_path = /.*\\uwfservicingscr.scr$/ nocase))))

  condition:
    $e
}
