// Title: Registry Entries For Azorult Malware
// ID: f7f9ab88-7557-4a69-b30e-0a8f91b3a0e7
// Status: test
// Level: critical
// Author: Trent Liffick
// Date: 2020-05-08
// Tags: attack.persistence, attack.execution, attack.defense-impairment, attack.t1112
// Description: Detects the presence of a registry key created during Azorult execution
// Converted by: Sigma Universal SIEM/EDR CLI

rule f7f9ab88_7557_4a69_b30e_0a8f91b3a0e7 {
  meta:
    title = "Registry Entries For Azorult Malware"
    description = "Detects the presence of a registry key created during Azorult execution"
    author = "Trent Liffick"
    severity = "CRITICAL"

  events:
    (($e.EventID = 12 or $e.EventID = 13) and $e.TargetObject = /.*SYSTEM\\.*/ nocase and $e.TargetObject = /.*\\services\\localNETService$/ nocase)

  condition:
    $e
}
