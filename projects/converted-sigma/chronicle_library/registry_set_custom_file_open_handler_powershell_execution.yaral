// Title: Custom File Open Handler Executes PowerShell
// ID: 7530b96f-ad8e-431d-a04d-ac85cc461fdc
// Status: test
// Level: high
// Author: CD_R0M_
// Date: 2022-06-11
// Tags: attack.stealth, attack.t1202
// Description: Detects the abuse of custom file open handler, executing powershell
// Converted by: Sigma Universal SIEM/EDR CLI

rule 7530b96f_ad8e_431d_a04d_ac85cc461fdc {
  meta:
    title = "Custom File Open Handler Executes PowerShell"
    description = "Detects the abuse of custom file open handler, executing powershell"
    author = "CD_R0M_"
    severity = "HIGH"

  events:
    ($e.TargetObject = /.*shell\\open\\command\\.*/ nocase and ($e.Details = /.*powershell.*/ nocase and $e.Details = /.*-command.*/ nocase))

  condition:
    $e
}
