rule 730fc21b_eaff_474b_ad23_90fd265d4988 {
  meta:
    title = "Psexec Execution"
    description = "Detects user accept agreement execution in psexec commandline"
    author = "omkar72"
    severity = "MEDIUM"

  events:
    (($e.target.process.file.full_path = /.*\\psexec.exe$/ nocase) or ($e.target.process.file.name = "psexec.c"))

  condition:
    $e
}
