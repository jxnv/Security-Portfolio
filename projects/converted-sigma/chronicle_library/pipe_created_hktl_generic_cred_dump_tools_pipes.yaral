rule 961d0ba2_3eea_4303_a930_2cf78bbfcc5e {
  meta:
    title = "HackTool - Credential Dumping Tools Named Pipe Created"
    description = "Detects well-known credential dumping tools execution via specific named pipe creation"
    author = "Teymur Kheirkhabarov, oscd.community"
    severity = "CRITICAL"

  events:
    (($e.PipeName = /.*\\cachedump.*/ nocase or $e.PipeName = /.*\\lsadump.*/ nocase or $e.PipeName = /.*\\wceservicepipe.*/ nocase))

  condition:
    $e
}
