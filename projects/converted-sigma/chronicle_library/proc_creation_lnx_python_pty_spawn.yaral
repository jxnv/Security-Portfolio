// Title: Python Spawning Pretty TTY Via PTY Module
// ID: c4042d54-110d-45dd-a0e1-05c47822c937
// Status: test
// Level: medium
// Author: Nextron Systems
// Date: 2022-06-03
// Tags: attack.execution, attack.t1059
// Description: Detects a python process calling to the PTY module in order to spawn a pretty tty which could be indicative of potential reverse shell activity.
// Converted by: Sigma Universal SIEM/EDR CLI

rule c4042d54_110d_45dd_a0e1_05c47822c937 {
  meta:
    title = "Python Spawning Pretty TTY Via PTY Module"
    description = "Detects a python process calling to the PTY module in order to spawn a pretty tty which could be indicative of potential reverse shell activity."
    author = "Nextron Systems"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*import pty.*/ nocase or $e.target.process.command_line = /.*from pty .*/ nocase)) and ($e.target.process.command_line = /.*spawn.*/ nocase) and ((($e.target.process.file.full_path = /.*/python$/ nocase or $e.target.process.file.full_path = /.*/python2$/ nocase or $e.target.process.file.full_path = /.*/python3$/ nocase)) or (($e.target.process.file.full_path = /.*/python2..*/ nocase or $e.target.process.file.full_path = /.*/python3..*/ nocase))))

  condition:
    $e
}
