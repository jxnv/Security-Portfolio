// Title: Office Macro File Creation
// ID: 91174a41-dc8f-401b-be89-7bfc140612a0
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-23
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects the creation of a new office macro files on the systems
// Converted by: Sigma Universal SIEM/EDR CLI

rule 91174a41_dc8f_401b_be89_7bfc140612a0 {
  meta:
    title = "Office Macro File Creation"
    description = "Detects the creation of a new office macro files on the systems"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "LOW"

  events:
    ((($e.target.file.full_path = /.*.docm$/ nocase or $e.target.file.full_path = /.*.dotm$/ nocase or $e.target.file.full_path = /.*.xlsm$/ nocase or $e.target.file.full_path = /.*.xltm$/ nocase or $e.target.file.full_path = /.*.potm$/ nocase or $e.target.file.full_path = /.*.pptm$/ nocase)) and not((($e.target.process.file.full_path = /^C:\\Program Files\\Microsoft Office\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files (x86)\\Microsoft Office\\.*/ nocase) and ($e.target.process.file.full_path = /.*\\WINWORD.EXE$/ nocase or $e.target.process.file.full_path = /.*\\EXCEL.EXE$/ nocase or $e.target.process.file.full_path = /.*\\POWERPNT.EXE$/ nocase) and $e.target.file.full_path = /.*\\~$.*/ nocase)))

  condition:
    $e
}
