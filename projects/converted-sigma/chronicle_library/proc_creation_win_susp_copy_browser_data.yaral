// Title: Potential Browser Data Stealing
// ID: 47147b5b-9e17-4d76-b8d2-7bac24c5ce1b
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-23
// Tags: attack.credential-access, attack.t1555.003
// Description: Adversaries may acquire credentials from web browsers by reading files specific to the target browser.
// Web browsers commonly save credentials such as website usernames and passwords so that they do not need to be entered manually in the future.
// Web browsers typically store the credentials in an encrypted format within a credential store.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 47147b5b_9e17_4d76_b8d2_7bac24c5ce1b {
  meta:
    title = "Potential Browser Data Stealing"
    description = "Adversaries may acquire credentials from web browsers by reading files specific to the target browser. Web browsers commonly save credentials such as website usernames and passwords so that they do not need to be entered manually in the future. Web browsers typically store the credentials in an encrypted format within a credential store."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (((($e.target.process.command_line = /.*copy-item.*/ nocase or $e.target.process.command_line = /.*copy .*/ nocase or $e.target.process.command_line = /.*cpi .*/ nocase or $e.target.process.command_line = /.* cp .*/ nocase or $e.target.process.command_line = /.*move .*/ nocase or $e.target.process.command_line = /.*move-item.*/ nocase or $e.target.process.command_line = /.* mi .*/ nocase or $e.target.process.command_line = /.* mv .*/ nocase)) or (($e.target.process.file.full_path = /.*\\esentutl.exe$/ nocase or $e.target.process.file.full_path = /.*\\xcopy.exe$/ nocase or $e.target.process.file.full_path = /.*\\robocopy.exe$/ nocase)) or (($e.target.process.file.name = "esentutl.exe" or $e.target.process.file.name = "XCOPY.EXE" or $e.target.process.file.name = "robocopy.exe"))) and (($e.target.process.command_line = /.*\\Amigo\\User Data.*/ nocase or $e.target.process.command_line = /.*\\BraveSoftware\\Brave-Browser\\User Data.*/ nocase or $e.target.process.command_line = /.*\\CentBrowser\\User Data.*/ nocase or $e.target.process.command_line = /.*\\Chromium\\User Data.*/ nocase or $e.target.process.command_line = /.*\\CocCoc\\Browser\\User Data.*/ nocase or $e.target.process.command_line = /.*\\Comodo\\Dragon\\User Data.*/ nocase or $e.target.process.command_line = /.*\\Elements Browser\\User Data.*/ nocase or $e.target.process.command_line = /.*\\Epic Privacy Browser\\User Data.*/ nocase or $e.target.process.command_line = /.*\\Google\\Chrome Beta\\User Data.*/ nocase or $e.target.process.command_line = /.*\\Google\\Chrome SxS\\User Data.*/ nocase or $e.target.process.command_line = /.*\\Google\\Chrome\\User Data\\.*/ nocase or $e.target.process.command_line = /.*\\Kometa\\User Data.*/ nocase or $e.target.process.command_line = /.*\\Maxthon5\\Users.*/ nocase or $e.target.process.command_line = /.*\\Microsoft\\Edge\\User Data.*/ nocase or $e.target.process.command_line = /.*\\Mozilla\\Firefox\\Profiles.*/ nocase or $e.target.process.command_line = /.*\\Nichrome\\User Data.*/ nocase or $e.target.process.command_line = /.*\\Opera Software\\Opera GX Stable\\.*/ nocase or $e.target.process.command_line = /.*\\Opera Software\\Opera Neon\\User Data.*/ nocase or $e.target.process.command_line = /.*\\Opera Software\\Opera Stable\\.*/ nocase or $e.target.process.command_line = /.*\\Orbitum\\User Data.*/ nocase or $e.target.process.command_line = /.*\\QIP Surf\\User Data.*/ nocase or $e.target.process.command_line = /.*\\Sputnik\\User Data.*/ nocase or $e.target.process.command_line = /.*\\Torch\\User Data.*/ nocase or $e.target.process.command_line = /.*\\uCozMedia\\Uran\\User Data.*/ nocase or $e.target.process.command_line = /.*\\Vivaldi\\User Data.*/ nocase)))

  condition:
    $e
}
