// Title: Suspicious File Write to SharePoint Layouts Directory
// ID: 1f0489be-b496-4ddf-b3a9-5900f2044e9c
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-07-24
// Tags: attack.initial-access, attack.t1190, attack.persistence, attack.t1505.003
// Description: Detects suspicious file writes to SharePoint layouts directory which could indicate webshell activity or post-exploitation.
// This behavior has been observed in the exploitation of SharePoint vulnerabilities such as CVE-2025-49704, CVE-2025-49706 or CVE-2025-53770.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 1f0489be_b496_4ddf_b3a9_5900f2044e9c {
  meta:
    title = "Suspicious File Write to SharePoint Layouts Directory"
    description = "Detects suspicious file writes to SharePoint layouts directory which could indicate webshell activity or post-exploitation. This behavior has been observed in the exploitation of SharePoint vulnerabilities such as CVE-2025-49704, CVE-2025-49706 or CVE-2025-53770."
    author = "Swachchhanda Shrawan Poudel (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.file.full_path = /.*\\cmd.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell_ise.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase or $e.target.process.file.full_path = /.*\\w3wp.exe$/ nocase) and ($e.target.file.full_path = /^C:\\Program Files\\Common Files\\Microsoft Shared\\Web Server Extensions\\.*/ nocase or $e.target.file.full_path = /^C:\\Program Files (x86)\\Common Files\\Microsoft Shared\\Web Server Extensions\\.*/ nocase) and ($e.target.file.full_path = /.*\\15\\TEMPLATE\\LAYOUTS\\.*/ nocase or $e.target.file.full_path = /.*\\16\\TEMPLATE\\LAYOUTS\\.*/ nocase) and ($e.target.file.full_path = /.*.asax$/ nocase or $e.target.file.full_path = /.*.ascx$/ nocase or $e.target.file.full_path = /.*.ashx$/ nocase or $e.target.file.full_path = /.*.asmx$/ nocase or $e.target.file.full_path = /.*.asp$/ nocase or $e.target.file.full_path = /.*.aspx$/ nocase or $e.target.file.full_path = /.*.bat$/ nocase or $e.target.file.full_path = /.*.cmd$/ nocase or $e.target.file.full_path = /.*.cer$/ nocase or $e.target.file.full_path = /.*.config$/ nocase or $e.target.file.full_path = /.*.hta$/ nocase or $e.target.file.full_path = /.*.js$/ nocase or $e.target.file.full_path = /.*.jsp$/ nocase or $e.target.file.full_path = /.*.jspx$/ nocase or $e.target.file.full_path = /.*.php$/ nocase or $e.target.file.full_path = /.*.ps1$/ nocase or $e.target.file.full_path = /.*.vbs$/ nocase))

  condition:
    $e
}
