// Title: HackTool - SharpUp PrivEsc Tool Execution
// ID: c484e533-ee16-4a93-b6ac-f0ea4868b2f1
// Status: test
// Level: critical
// Author: Florian Roth (Nextron Systems)
// Date: 2022-08-20
// Tags: attack.persistence, attack.privilege-escalation, attack.discovery, attack.execution, attack.stealth, attack.t1615, attack.t1569.002, attack.t1574.005
// Description: Detects the use of SharpUp, a tool for local privilege escalation
// Converted by: Sigma Universal SIEM/EDR CLI

rule c484e533_ee16_4a93_b6ac_f0ea4868b2f1 {
  meta:
    title = "HackTool - SharpUp PrivEsc Tool Execution"
    description = "Detects the use of SharpUp, a tool for local privilege escalation"
    author = "Florian Roth (Nextron Systems)"
    severity = "CRITICAL"

  events:
    (($e.target.process.file.full_path = /.*\\SharpUp.exe$/ nocase) or ($e.Description = "SharpUp") or (($e.target.process.command_line = /.*HijackablePaths.*/ nocase or $e.target.process.command_line = /.*UnquotedServicePath.*/ nocase or $e.target.process.command_line = /.*ProcessDLLHijack.*/ nocase or $e.target.process.command_line = /.*ModifiableServiceBinaries.*/ nocase or $e.target.process.command_line = /.*ModifiableScheduledTask.*/ nocase or $e.target.process.command_line = /.*DomainGPPPassword.*/ nocase or $e.target.process.command_line = /.*CachedGPPPassword.*/ nocase)))

  condition:
    $e
}
