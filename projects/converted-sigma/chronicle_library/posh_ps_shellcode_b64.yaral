// Title: PowerShell ShellCode
// ID: 16b37b70-6fcf-4814-a092-c36bd3aafcbd
// Status: test
// Level: high
// Author: David Ledbetter (shellcode), Florian Roth (Nextron Systems)
// Date: 2018-11-17
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055, attack.execution, attack.t1059.001
// Description: Detects Base64 encoded Shellcode
// Converted by: Sigma Universal SIEM/EDR CLI

rule 16b37b70_6fcf_4814_a092_c36bd3aafcbd {
  meta:
    title = "PowerShell ShellCode"
    description = "Detects Base64 encoded Shellcode"
    author = "David Ledbetter (shellcode), Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.ScriptBlockText = /.*OiCAAAAYInlM.*/ nocase or $e.ScriptBlockText = /.*OiJAAAAYInlM.*/ nocase))

  condition:
    $e
}
