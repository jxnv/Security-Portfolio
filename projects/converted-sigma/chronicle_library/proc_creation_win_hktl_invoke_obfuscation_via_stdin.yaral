rule 9c14c9fa_1a63_4a64_8e57_d19280559490 {
  meta:
    title = "Invoke-Obfuscation Via Stdin"
    description = "Detects Obfuscated Powershell via Stdin in Scripts"
    author = "Nikita Nazarov, oscd.community"
    severity = "HIGH"

  events:
    ($e.target.process.command_line = /(?i)(?:set).*&&\s?set.*(?:environment|invoke|\$\{?input).*&&.*"/ nocase)

  condition:
    $e
}
