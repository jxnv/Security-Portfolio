rule c4ff1eac_84ad_44dd_a6fb_d56a92fc43a9 {
  meta:
    title = "ProcessHacker Privilege Elevation"
    description = "Detects a ProcessHacker tool that elevated privileges to a very high level"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    ($e.Provider_Name = "Service Control Manager" and $e.EventID = 7045 and $e.ServiceName = /^ProcessHacker.*/ nocase and $e.AccountName = "LocalSystem")

  condition:
    $e
}
