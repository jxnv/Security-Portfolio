// Title: ClickOnce Trust Prompt Tampering
// ID: ac9159cc-c364-4304-8f0a-d63fc1a0aabb
// Status: test
// Level: medium
// Author: @SerkinValery, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-12
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects changes to the ClickOnce trust prompt registry key in order to enable an installation from different locations such as the Internet.
// Converted by: Sigma Universal SIEM/EDR CLI

rule ac9159cc_c364_4304_8f0a_d63fc1a0aabb {
  meta:
    title = "ClickOnce Trust Prompt Tampering"
    description = "Detects changes to the ClickOnce trust prompt registry key in order to enable an installation from different locations such as the Internet."
    author = "@SerkinValery, Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ($e.TargetObject = /.*\\SOFTWARE\\MICROSOFT\\.NETFramework\\Security\\TrustManager\\PromptingLevel\\.*/ nocase and ($e.TargetObject = /.*\\Internet$/ nocase or $e.TargetObject = /.*\\LocalIntranet$/ nocase or $e.TargetObject = /.*\\MyComputer$/ nocase or $e.TargetObject = /.*\\TrustedSites$/ nocase or $e.TargetObject = /.*\\UntrustedSites$/ nocase) and $e.Details = "Enabled")

  condition:
    $e
}
