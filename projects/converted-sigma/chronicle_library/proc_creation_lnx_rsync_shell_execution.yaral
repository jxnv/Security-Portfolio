// Title: Shell Execution via Rsync - Linux
// ID: e2326866-609f-4015-aea9-7ec634e8aa04
// Status: experimental
// Level: high
// Author: Li Ling, Andy Parkidomo, Robert Rakowski, Blake Hartstein (Bloomberg L.P.), Florian Roth
// Date: 2024-09-02
// Tags: attack.execution, attack.t1059
// Description: Detects the use of the "rsync" utility to execute a shell. Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments.
// Converted by: Sigma Universal SIEM/EDR CLI

rule e2326866_609f_4015_aea9_7ec634e8aa04 {
  meta:
    title = "Shell Execution via Rsync - Linux"
    description = "Detects the use of the "rsync" utility to execute a shell. Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments."
    author = "Li Ling, Andy Parkidomo, Robert Rakowski, Blake Hartstein (Bloomberg L.P.), Florian Roth"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*/ash .*/ nocase or $e.target.process.command_line = /.*/bash .*/ nocase or $e.target.process.command_line = /.*/dash .*/ nocase or $e.target.process.command_line = /.*/csh .*/ nocase or $e.target.process.command_line = /.*/sh .*/ nocase or $e.target.process.command_line = /.*/zsh .*/ nocase or $e.target.process.command_line = /.*/tcsh .*/ nocase or $e.target.process.command_line = /.*/ksh .*/ nocase or $e.target.process.command_line = /.*'ash .*/ nocase or $e.target.process.command_line = /.*'bash .*/ nocase or $e.target.process.command_line = /.*'dash .*/ nocase or $e.target.process.command_line = /.*'csh .*/ nocase or $e.target.process.command_line = /.*'sh .*/ nocase or $e.target.process.command_line = /.*'zsh .*/ nocase or $e.target.process.command_line = /.*'tcsh .*/ nocase or $e.target.process.command_line = /.*'ksh .*/ nocase)) and (($e.target.process.file.full_path = /.*/rsync$/ nocase or $e.target.process.file.full_path = /.*/rsyncd$/ nocase) and $e.target.process.command_line = /.* -e .*/ nocase))

  condition:
    $e
}
