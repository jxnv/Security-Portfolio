// Title: Import PowerShell Modules From Suspicious Directories
// ID: 21f9162c-5f5d-4b01-89a8-b705bd7d10ab
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-07
// Tags: attack.execution, attack.t1059.001
// Description: Detects powershell scripts that import modules from suspicious directories
// Converted by: Sigma Universal SIEM/EDR CLI

rule 21f9162c_5f5d_4b01_89a8_b705bd7d10ab {
  meta:
    title = "Import PowerShell Modules From Suspicious Directories"
    description = "Detects powershell scripts that import modules from suspicious directories"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.ScriptBlockText = /.*Import-Module \"$Env:Temp\\.*/ nocase or $e.ScriptBlockText = /.*Import-Module '$Env:Temp\\.*/ nocase or $e.ScriptBlockText = /.*Import-Module $Env:Temp\\.*/ nocase or $e.ScriptBlockText = /.*Import-Module \"$Env:Appdata\\.*/ nocase or $e.ScriptBlockText = /.*Import-Module '$Env:Appdata\\.*/ nocase or $e.ScriptBlockText = /.*Import-Module $Env:Appdata\\.*/ nocase or $e.ScriptBlockText = /.*Import-Module C:\\Users\\Public\\.*/ nocase or $e.ScriptBlockText = /.*ipmo \"$Env:Temp\\.*/ nocase or $e.ScriptBlockText = /.*ipmo '$Env:Temp\\.*/ nocase or $e.ScriptBlockText = /.*ipmo $Env:Temp\\.*/ nocase or $e.ScriptBlockText = /.*ipmo \"$Env:Appdata\\.*/ nocase or $e.ScriptBlockText = /.*ipmo '$Env:Appdata\\.*/ nocase or $e.ScriptBlockText = /.*ipmo $Env:Appdata\\.*/ nocase or $e.ScriptBlockText = /.*ipmo C:\\Users\\Public\\.*/ nocase))

  condition:
    $e
}
