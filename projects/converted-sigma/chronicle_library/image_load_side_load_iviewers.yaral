// Date: 2023-03-21
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of "iviewers.dll" (OLE/COM Object Interface Viewer)
// Converted by: Sigma Universal SIEM/EDR CLI

rule 4c21b805_4dd7_469f_b47d_7383a8fcb437 {
  meta:
    title = "Potential Iviewers.DLL Sideloading"
    description = "Detects potential DLL sideloading of "iviewers.dll" (OLE/COM Object Interface Viewer)"
    author = "X__Junior (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.ImageLoaded = /.*\\iviewers.dll$/ nocase) and not((($e.ImageLoaded = /^C:\\Program Files (x86)\\Windows Kits\\.*/ nocase or $e.ImageLoaded = /^C:\\Program Files\\Windows Kits\\.*/ nocase))))

  condition:
    $e
}
