// Title: Suspicious Execution via macOS Script Editor
// ID: 6e4dcdd1-e48b-42f7-b2d8-3b413fc58cb4
// Status: test
// Level: medium
// Author: Tim Rauch (rule), Elastic (idea)
// Date: 2022-10-21
// Tags: attack.defense-impairment, attack.t1566, attack.t1566.002, attack.initial-access, attack.t1059, attack.t1059.002, attack.t1204, attack.t1204.001, attack.execution, attack.persistence, attack.t1553
// Description: Detects when the macOS Script Editor utility spawns an unusual child process.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 6e4dcdd1_e48b_42f7_b2d8_3b413fc58cb4 {
  meta:
    title = "Suspicious Execution via macOS Script Editor"
    description = "Detects when the macOS Script Editor utility spawns an unusual child process."
    author = "Tim Rauch (rule), Elastic (idea)"
    severity = "MEDIUM"

  events:
    (((($e.target.process.file.full_path = /.*/curl$/ nocase or $e.target.process.file.full_path = /.*/bash$/ nocase or $e.target.process.file.full_path = /.*/sh$/ nocase or $e.target.process.file.full_path = /.*/zsh$/ nocase or $e.target.process.file.full_path = /.*/dash$/ nocase or $e.target.process.file.full_path = /.*/fish$/ nocase or $e.target.process.file.full_path = /.*/osascript$/ nocase or $e.target.process.file.full_path = /.*/mktemp$/ nocase or $e.target.process.file.full_path = /.*/chmod$/ nocase or $e.target.process.file.full_path = /.*/php$/ nocase or $e.target.process.file.full_path = /.*/nohup$/ nocase or $e.target.process.file.full_path = /.*/openssl$/ nocase or $e.target.process.file.full_path = /.*/plutil$/ nocase or $e.target.process.file.full_path = /.*/PlistBuddy$/ nocase or $e.target.process.file.full_path = /.*/xattr$/ nocase or $e.target.process.file.full_path = /.*/sqlite$/ nocase or $e.target.process.file.full_path = /.*/funzip$/ nocase or $e.target.process.file.full_path = /.*/popen$/ nocase)) or (($e.target.process.file.full_path = /.*python.*/ nocase or $e.target.process.file.full_path = /.*perl.*/ nocase))) and ($e.principal.process.file.full_path = /.*/Script Editor$/ nocase))

  condition:
    $e
}
