// Title: Execute From Alternate Data Streams
// ID: 7f43c430-5001-4f8b-aaa9-c3b88f18fa5c
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-09-01
// Tags: attack.stealth, attack.t1564.004
// Description: Detects execution from an Alternate Data Stream (ADS). Adversaries may use NTFS file attributes to hide their malicious data in order to evade detection
// Converted by: Sigma Universal SIEM/EDR CLI

rule 7f43c430_5001_4f8b_aaa9_c3b88f18fa5c {
  meta:
    title = "Execute From Alternate Data Streams"
    description = "Detects execution from an Alternate Data Stream (ADS). Adversaries may use NTFS file attributes to hide their malicious data in order to evade detection"
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.target.process.command_line = /.*txt:.*/ nocase) and ((($e.target.process.command_line = /.*esentutl .*/ nocase and $e.target.process.command_line = /.* /y .*/ nocase and $e.target.process.command_line = /.* /d .*/ nocase and $e.target.process.command_line = /.* /o .*/ nocase)) or (($e.target.process.command_line = /.*makecab .*/ nocase and $e.target.process.command_line = /.*.cab.*/ nocase)) or (($e.target.process.command_line = /.*reg .*/ nocase and $e.target.process.command_line = /.* export .*/ nocase)) or (($e.target.process.command_line = /.*regedit .*/ nocase and $e.target.process.command_line = /.* /E .*/ nocase)) or (($e.target.process.command_line = /.*type .*/ nocase and $e.target.process.command_line = /.* > .*/ nocase))))

  condition:
    $e
}
