// Title: Potential Excel.EXE DCOM Lateral Movement Via ActivateMicrosoftApp
// ID: 551d9c1f-816c-445b-a7a6-7a3864720d60
// Status: test
// Level: high
// Author: Aaron Stratton
// Date: 2023-11-13
// Tags: attack.t1021.003, attack.lateral-movement
// Description: Detects suspicious child processes of Excel which could be an indicator of lateral movement leveraging the "ActivateMicrosoftApp" Excel DCOM object.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 551d9c1f_816c_445b_a7a6_7a3864720d60 {
  meta:
    title = "Potential Excel.EXE DCOM Lateral Movement Via ActivateMicrosoftApp"
    description = "Detects suspicious child processes of Excel which could be an indicator of lateral movement leveraging the "ActivateMicrosoftApp" Excel DCOM object."
    author = "Aaron Stratton"
    severity = "HIGH"

  events:
    (((($e.target.process.file.name = "foxprow.exe" or $e.target.process.file.name = "schdplus.exe" or $e.target.process.file.name = "winproj.exe")) or (($e.target.process.file.full_path = /.*\\foxprow.exe$/ nocase or $e.target.process.file.full_path = /.*\\schdplus.exe$/ nocase or $e.target.process.file.full_path = /.*\\winproj.exe$/ nocase))) and ($e.principal.process.file.full_path = /.*\\excel.exe$/ nocase))

  condition:
    $e
}
