// Title: Invoke-Obfuscation RUNDLL LAUNCHER - PowerShell
// ID: e6cb92b4-b470-4eb8-8a9d-d63e8583aae0
// Status: test
// Level: medium
// Author: Timur Zinniatullin, oscd.community
// Date: 2020-10-18
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via RUNDLL LAUNCHER
// Converted by: Sigma Universal SIEM/EDR CLI

rule e6cb92b4_b470_4eb8_8a9d_d63e8583aae0 {
  meta:
    title = "Invoke-Obfuscation RUNDLL LAUNCHER - PowerShell"
    description = "Detects Obfuscated Powershell via RUNDLL LAUNCHER"
    author = "Timur Zinniatullin, oscd.community"
    severity = "MEDIUM"

  events:
    (($e.ScriptBlockText = /.*rundll32.exe.*/ nocase and $e.ScriptBlockText = /.*shell32.dll.*/ nocase and $e.ScriptBlockText = /.*shellexec_rundll.*/ nocase and $e.ScriptBlockText = /.*powershell.*/ nocase))

  condition:
    $e
}
