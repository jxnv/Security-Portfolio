// Title: Potential Arbitrary Command Execution Using Msdt.EXE
// ID: 258fc8ce-8352-443a-9120-8a11e4857fa5
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-05-29
// Tags: attack.stealth, attack.t1202
// Description: Detects processes leveraging the "ms-msdt" handler or the "msdt.exe" binary to execute arbitrary commands as seen in the follina (CVE-2022-30190) vulnerability
// Converted by: Sigma Universal SIEM/EDR CLI

rule 258fc8ce_8352_443a_9120_8a11e4857fa5 {
  meta:
    title = "Potential Arbitrary Command Execution Using Msdt.EXE"
    description = "Detects processes leveraging the "ms-msdt" handler or the "msdt.exe" binary to execute arbitrary commands as seen in the follina (CVE-2022-30190) vulnerability"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.file.full_path = /.*\\msdt.exe$/ nocase) or ($e.target.process.file.name = "msdt.exe")) and (($e.target.process.command_line = /.*IT_BrowseForFile=.*/ nocase) or (($e.target.process.command_line = /.* PCWDiagnostic.*/ nocase) and ($e.target.process.command_line = /.* -af .*/ nocase))))

  condition:
    $e
}
