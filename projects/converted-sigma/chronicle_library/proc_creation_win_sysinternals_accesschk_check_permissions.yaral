// Title: Permission Check Via Accesschk.EXE
// ID: c625d754-6a3d-4f65-9c9a-536aea960d37
// Status: test
// Level: medium
// Author: Teymur Kheirkhabarov (idea), Mangatas Tondang, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2020-10-13
// Tags: attack.discovery, attack.t1069.001
// Description: Detects the usage of the "Accesschk" utility, an access and privilege audit tool developed by SysInternal and often being abused by attacker to verify process privileges
// Converted by: Sigma Universal SIEM/EDR CLI

rule c625d754_6a3d_4f65_9c9a_536aea960d37 {
  meta:
    title = "Permission Check Via Accesschk.EXE"
    description = "Detects the usage of the "Accesschk" utility, an access and privilege audit tool developed by SysInternal and often being abused by attacker to verify process privileges"
    author = "Teymur Kheirkhabarov (idea), Mangatas Tondang, oscd.community, Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*uwcqv .*/ nocase or $e.target.process.command_line = /.*kwsu .*/ nocase or $e.target.process.command_line = /.*qwsu .*/ nocase or $e.target.process.command_line = /.*uwdqs .*/ nocase)) and (($e.Product = /.*AccessChk$/ nocase) or ($e.Description = /.*Reports effective permissions.*/ nocase) or (($e.target.process.file.full_path = /.*\\accesschk.exe$/ nocase or $e.target.process.file.full_path = /.*\\accesschk64.exe$/ nocase or $e.target.process.file.full_path = /.*\\accesschk64a.exe$/ nocase)) or ($e.target.process.file.name = "accesschk.exe")))

  condition:
    $e
}
