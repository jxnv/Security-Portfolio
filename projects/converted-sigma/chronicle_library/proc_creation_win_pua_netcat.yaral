// Title: PUA - Netcat Suspicious Execution
// ID: e31033fc-33f0-4020-9a16-faf9b31cbf08
// Status: test
// Level: high
// Author: frack113, Florian Roth (Nextron Systems)
// Date: 2021-07-21
// Tags: attack.command-and-control, attack.t1095
// Description: Detects execution of Netcat. Adversaries may use a non-application layer protocol for communication between host and C2 server or among infected hosts within a network
// Converted by: Sigma Universal SIEM/EDR CLI

rule e31033fc_33f0_4020_9a16_faf9b31cbf08 {
  meta:
    title = "PUA - Netcat Suspicious Execution"
    description = "Detects execution of Netcat. Adversaries may use a non-application layer protocol for communication between host and C2 server or among infected hosts within a network"
    author = "frack113, Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.* -lvp .*/ nocase or $e.target.process.command_line = /.* -lvnp.*/ nocase or $e.target.process.command_line = /.* -l -v -p .*/ nocase or $e.target.process.command_line = /.* -lv -p .*/ nocase or $e.target.process.command_line = /.* -l --proxy-type http .*/ nocase or $e.target.process.command_line = /.* -vnl --exec .*/ nocase or $e.target.process.command_line = /.* -vnl -e .*/ nocase or $e.target.process.command_line = /.* --lua-exec .*/ nocase or $e.target.process.command_line = /.* --sh-exec .*/ nocase)) or (($e.target.process.file.full_path = /.*\\nc.exe$/ nocase or $e.target.process.file.full_path = /.*\\ncat.exe$/ nocase or $e.target.process.file.full_path = /.*\\netcat.exe$/ nocase)))

  condition:
    $e
}
