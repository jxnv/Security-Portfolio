 /.*static.remotepc.com$/ nocase or $e.QueryName = /.*swi-rc.com$/ nocase or $e.QueryName = /.*swi-tc.com$/ nocase or $e.QueryName = /.*tailscale.com$/ nocase or $e.QueryName = /.*telemetry.servers.qetqo.com$/ nocase or $e.QueryName = /.*tmate.io$/ nocase or $e.QueryName = /.*twingate.com$/ nocase or $e.QueryName = /.*zohoassist.com$/ nocase)) or ($e.QueryName = /.*.rustdesk.com$/ nocase and $e.QueryName = /^rs-.*/ nocase)) and not(((($e.target.process.file.full_path = /^C:\\Program Files (x86)\\Avant Browser\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\Avant Browser\\.*/ nocase) and $e.target.process.file.full_path = /.*\\avant.exe$/ nocase) or ($e.target.process.file.full_path = /.*\\brave.exe$/ nocase and $e.target.process.file.full_path = /^C:\\Program Files\\BraveSoftware\\.*/ nocase) or (($e.target.process.file.full_path = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or $e.target.process.file.full_path = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or (($e.target.process.file.full_path = /.*\\MsMpEng.exe$/ nocase or $e.target.process.file.full_path = /.*\\MsSense.exe$/ nocase)) or (($e.target.process.file.full_path = /^C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\.*/ nocase) or ($e.target.process.file.full_path = /.*\\WindowsApps\\MicrosoftEdge.exe$/ nocase) or (($e.target.process.file.full_path = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or $e.target.process.file.full_path = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or (($e.target.process.file.full_path = /^C:\\Program Files (x86)\\Microsoft\\EdgeCore\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\Microsoft\\EdgeCore\\.*/ nocase) and ($e.target.process.file.full_path = /.*\\msedge.exe$/ nocase or $e.target.process.file.full_path = /.*\\msedgewebview2.exe$/ nocase)) or (($e.target.process.file.full_path = /^C:\\Program Files\\Falkon\\.*/ nocase or $e.target