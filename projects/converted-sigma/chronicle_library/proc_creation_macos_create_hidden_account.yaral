// Title: Hidden User Creation
// ID: b22a5b36-2431-493a-8be1-0bae56c28ef3
// Status: test
// Level: medium
// Author: Daniil Yugoslavskiy, oscd.community
// Date: 2020-10-10
// Tags: attack.stealth, attack.t1564.002
// Description: Detects creation of a hidden user account on macOS (UserID < 500) or with IsHidden option
// Converted by: Sigma Universal SIEM/EDR CLI

rule b22a5b36_2431_493a_8be1_0bae56c28ef3 {
  meta:
    title = "Hidden User Creation"
    description = "Detects creation of a hidden user account on macOS (UserID < 500) or with IsHidden option"
    author = "Daniil Yugoslavskiy, oscd.community"
    severity = "MEDIUM"

  events:
    ((($e.target.process.file.full_path = /.*/dscl$/ nocase and $e.target.process.command_line = /.*create.*/ nocase) and ($e.target.process.command_line = /.*UniqueID.*/ nocase and $e.target.process.command_line = /([0-9]|[1-9][0-9]|[1-4][0-9]{2})/ nocase)) or (($e.target.process.file.full_path = /.*/dscl$/ nocase and $e.target.process.command_line = /.*create.*/ nocase) and (($e.target.process.command_line = /.*IsHidden.*/ nocase) and (($e.target.process.command_line = /.*true.*/ nocase or $e.target.process.command_line = /.*yes.*/ nocase or $e.target.process.command_line = /.*1.*/ nocase)))))

  condition:
    $e
}
