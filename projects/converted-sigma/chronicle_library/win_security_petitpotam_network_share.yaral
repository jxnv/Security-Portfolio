rule 1ce8c8a3_2723_48ed_8246_906ac91061a6 {
  meta:
    title = "Possible PetitPotam Coerce Authentication Attempt"
    description = "Detect PetitPotam coerced authentication activity."
    author = "Mauricio Velazco, Michael Haag"
    severity = "HIGH"

  events:
    ($e.EventID = 5145 and $e.ShareName = /^\\\\\\\\.*/ nocase and $e.ShareName = /.*\\IPC$$/ nocase and $e.RelativeTargetName = "lsarpc" and $e.SubjectUserName = "ANONYMOUS LOGON")

  condition:
    $e
}
