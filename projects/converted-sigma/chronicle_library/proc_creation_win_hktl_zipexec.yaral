// Title: Suspicious ZipExec Execution
// ID: 90dcf730-1b71-4ae7-9ffc-6fcf62bd0132
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-11-07
// Tags: attack.execution, attack.stealth, attack.t1218, attack.t1202
// Description: ZipExec is a Proof-of-Concept (POC) tool to wrap binary-based tools into a password-protected zip file.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 90dcf730_1b71_4ae7_9ffc_6fcf62bd0132 {
  meta:
    title = "Suspicious ZipExec Execution"
    description = "ZipExec is a Proof-of-Concept (POC) tool to wrap binary-based tools into a password-protected zip file."
    author = "frack113"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*/generic:Microsoft_Windows_Shell_ZipFolder:filename=.*/ nocase and $e.target.process.command_line = /.*.zip.*/ nocase and $e.target.process.command_line = /.*/pass:.*/ nocase and $e.target.process.command_line = /.*/user:.*/ nocase)) or (($e.target.process.command_line = /.*/delete.*/ nocase and $e.target.process.command_line = /.*Microsoft_Windows_Shell_ZipFolder:filename=.*/ nocase and $e.target.process.command_line = /.*.zip.*/ nocase)))

  condition:
    $e
}
