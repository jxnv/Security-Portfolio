// Description: Detects well-known credential dumping tools execution via service execution events
// Converted by: Sigma Universal SIEM/EDR CLI

rule 4976aa50_8f41_45c6_8b15_ab3fc10e79ed {
  meta:
    title = "Credential Dumping Tools Service Execution - System"
    description = "Detects well-known credential dumping tools execution via service execution events"
    author = "Florian Roth (Nextron Systems), Teymur Kheirkhabarov, Daniil Yugoslavskiy, oscd.community"
    severity = "HIGH"

  events:
    ($e.Provider_Name = "Service Control Manager" and $e.EventID = 7045 and ($e.ImagePath = /.*cachedump.*/ nocase or $e.ImagePath = /.*dumpsvc.*/ nocase or $e.ImagePath = /.*fgexec.*/ nocase or $e.ImagePath = /.*gsecdump.*/ nocase or $e.ImagePath = /.*mimidrv.*/ nocase or $e.ImagePath = /.*pwdump.*/ nocase or $e.ImagePath = /.*servpw.*/ nocase))

  condition:
    $e
}
