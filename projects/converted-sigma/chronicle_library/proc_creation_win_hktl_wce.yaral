    ((($e.Hashes = /.*IMPHASH=136F0A8572C058A96436C82E541E4C41.*/ nocase or $e.Hashes = /.*IMPHASH=589657C64DDE88533186C39F82FA1F50.*/ nocase or $e.Hashes = /.*IMPHASH=6BFE09EFCB4FFDE061EBDBAFC4DB84CF.*/ nocase or $e.Hashes = /.*IMPHASH=7D490037BF450877E6D0287BDCFF8D2E.*/ nocase or $e.Hashes = /.*IMPHASH=8AB93B061287C79F3088C5BC7E7D97ED.*/ nocase or $e.Hashes = /.*IMPHASH=A53A02B997935FD8EEDCB5F7ABAB9B9F.*/ nocase or $e.Hashes = /.*IMPHASH=BA434A7A729EEC20E136CA4C32D6C740.*/ nocase or $e.Hashes = /.*IMPHASH=BD1D1547DA13C0FCB6C15E86217D5EB8.*/ nocase or $e.Hashes = /.*IMPHASH=E96A73C7BF33A464C510EDE582318BF2.*/ nocase)) or (($e.target.process.file.full_path = /.*\\WCE.exe$/ nocase or $e.target.process.file.full_path = /.*\\WCE64.exe$/ nocase)))

