rule 7aa7009a_28b9_4344_8c1f_159489a390df {
  meta:
    title = "HackTool - Windows Credential Editor (WCE) Execution"
    description = "Detects the use of Windows Credential Editor (WCE), a popular post-exploitation tool used to extract plaintext passwords, hash, PIN code and Kerberos tickets from memory. It is often used by threat actors for credential dumping and lateral movement within compromised networks."
    author = "Florian Roth (Nextron Systems)"
    severity = "CRITICAL"

