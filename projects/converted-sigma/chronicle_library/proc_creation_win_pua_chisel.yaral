// Title: PUA - Chisel Tunneling Tool Execution
// ID: 8b0e12da-d3c3-49db-bb4f-256703f380e5
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-09-13
// Tags: attack.command-and-control, attack.t1090.001
// Description: Detects usage of the Chisel tunneling tool via the commandline arguments
// Converted by: Sigma Universal SIEM/EDR CLI

rule 8b0e12da_d3c3_49db_bb4f_256703f380e5 {
  meta:
    title = "PUA - Chisel Tunneling Tool Execution"
    description = "Detects usage of the Chisel tunneling tool via the commandline arguments"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.file.full_path = /.*\\chisel.exe$/ nocase) or ((($e.target.process.command_line = /.*exe client .*/ nocase or $e.target.process.command_line = /.*exe server .*/ nocase)) and (($e.target.process.command_line = /.*-socks5.*/ nocase or $e.target.process.command_line = /.*-reverse.*/ nocase or $e.target.process.command_line = /.* r:.*/ nocase or $e.target.process.command_line = /.*:127.0.0.1:.*/ nocase or $e.target.process.command_line = /.*-tls-skip-verify .*/ nocase or $e.target.process.command_line = /.*:socks.*/ nocase))))

  condition:
    $e
}
