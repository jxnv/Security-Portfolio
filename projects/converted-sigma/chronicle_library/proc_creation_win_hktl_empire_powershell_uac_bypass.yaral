rule 3268b746_88d8_4cd3_bffc_30077d02c787 {
  meta:
    title = "HackTool - Empire PowerShell UAC Bypass"
    description = "Detects some Empire PowerShell UAC bypass methods"
    author = "Ecco"
    severity = "CRITICAL"

  events:
    (($e.target.process.command_line = /.* -NoP -NonI -w Hidden -c $x=$((gp HKCU:Software\\Microsoft\\Windows Update).Update).*/ nocase or $e.target.process.command_line = /.* -NoP -NonI -c $x=$((gp HKCU:Software\\Microsoft\\Windows Update).Update);.*/ nocase))

  condition:
    $e
}
