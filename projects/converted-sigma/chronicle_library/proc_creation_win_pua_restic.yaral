// Title: PUA - Restic Backup Tool Execution
// ID: 6ddff2e8-ea1a-45d0-8938-93dfc1d67ae7
// Status: experimental
// Level: high
// Author: Nounou Mbeiri, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-10-17
// Tags: attack.exfiltration, attack.t1048, attack.t1567.002
// Description: Detects the execution of the Restic backup tool, which can be used for data exfiltration.
// Threat actors may leverage Restic to back up and exfiltrate sensitive data to remote storage locations, including cloud services.
// If not legitimately used in the enterprise environment, its presence may indicate malicious activity.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 6ddff2e8_ea1a_45d0_8938_93dfc1d67ae7 {
  meta:
    title = "PUA - Restic Backup Tool Execution"
    description = "Detects the execution of the Restic backup tool, which can be used for data exfiltration. Threat actors may leverage Restic to back up and exfiltrate sensitive data to remote storage locations, including cloud services. If not legitimately used in the enterprise environment, its presence may indicate malicious activity."
    author = "Nounou Mbeiri, Swachchhanda Shrawan Poudel (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*sftp:.*/ nocase or $e.target.process.command_line = /.*rest:http.*/ nocase or $e.target.process.command_line = /.*s3:s3..*/ nocase or $e.target.process.command_line = /.*s3.http.*/ nocase or $e.target.process.command_line = /.*azure:.*/ nocase or $e.target.process.command_line = /.* gs:.*/ nocase or $e.target.process.command_line = /.*rclone:.*/ nocase or $e.target.process.command_line = /.*swift:.*/ nocase or $e.target.process.command_line = /.* b2:.*/ nocase) and ($e.target.process.command_line = /.* init .*/ nocase and $e.target.process.command_line = /.* -r .*/ nocase)) or ((($e.target.process.command_line = /.*--password-file.*/ nocase and $e.target.process.command_line = /.*init.*/ nocase and $e.target.process.command_line = /.* -r .*/ nocase)) or (($e.target.process.command_line = /.*--use-fs-snapshot.*/ nocase and $e.target.process.command_line = /.*backup.*/ nocase and $e.target.process.command_line = /.* -r .*/ nocase))))

  condition:
    $e
}
