// Title: HackTool - CrackMapExec File Indicators
// ID: 736ffa74-5f6f-44ca-94ef-1c0df4f51d2a
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-03-11
// Tags: attack.credential-access, attack.t1003.001
// Description: Detects file creation events with filename patterns used by CrackMapExec.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 736ffa74_5f6f_44ca_94ef_1c0df4f51d2a {
  meta:
    title = "HackTool - CrackMapExec File Indicators"
    description = "Detects file creation events with filename patterns used by CrackMapExec."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.file.full_path = /^C:\\Windows\\Temp\\.*/ nocase) and ((($e.target.file.full_path = /\\[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\.txt$/ nocase) or ($e.target.file.full_path = /\\[a-zA-Z]{8}\.tmp$/ nocase)) or (($e.target.file.full_path = /.*\\temp.ps1$/ nocase or $e.target.file.full_path = /.*\\msol.ps1$/ nocase))))

  condition:
    $e
}
