// Title: Transferring Files with Credential Data via Network Shares
// ID: 910ab938-668b-401b-b08c-b596e80fdca5
// Status: test
// Level: medium
// Author: Teymur Kheirkhabarov, oscd.community
// Date: 2019-10-22
// Tags: attack.credential-access, attack.t1003.002, attack.t1003.001, attack.t1003.003
// Description: Transferring files with well-known filenames (sensitive files with credential data) using network shares
// Converted by: Sigma Universal SIEM/EDR CLI

rule 910ab938_668b_401b_b08c_b596e80fdca5 {
  meta:
    title = "Transferring Files with Credential Data via Network Shares"
    description = "Transferring files with well-known filenames (sensitive files with credential data) using network shares"
    author = "Teymur Kheirkhabarov, oscd.community"
    severity = "MEDIUM"

  events:
    (($e.EventID = 5145) and ((($e.RelativeTargetName = /.*\\mimidrv.*/ nocase or $e.RelativeTargetName = /.*\\lsass.*/ nocase or $e.RelativeTargetName = /.*\\windows\\minidump\\.*/ nocase or $e.RelativeTargetName = /.*\\hiberfil.*/ nocase or $e.RelativeTargetName = /.*\\sqldmpr.*/ nocase)) or (($e.RelativeTargetName = "Windows\\NTDS\\ntds.dit" or $e.RelativeTargetName = "Windows\\System32\\config\\SAM" or $e.RelativeTargetName = "Windows\\System32\\config\\SECURITY" or $e.RelativeTargetName = "Windows\\System32\\config\\SYSTEM"))))

  condition:
    $e
}
