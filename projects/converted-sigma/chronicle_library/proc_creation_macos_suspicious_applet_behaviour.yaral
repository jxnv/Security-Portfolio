// Title: Osacompile Execution By Potentially Suspicious Applet/Osascript
// ID: a753a6af-3126-426d-8bd0-26ebbcb92254
// Status: test
// Level: medium
// Author: Sohan G (D4rkCiph3r), Red Canary (Idea)
// Date: 2023-04-03
// Tags: attack.execution, attack.t1059.002
// Description: Detects potential suspicious applet or osascript executing "osacompile".
// Converted by: Sigma Universal SIEM/EDR CLI

rule a753a6af_3126_426d_8bd0_26ebbcb92254 {
  meta:
    title = "Osacompile Execution By Potentially Suspicious Applet/Osascript"
    description = "Detects potential suspicious applet or osascript executing "osacompile"."
    author = "Sohan G (D4rkCiph3r), Red Canary (Idea)"
    severity = "MEDIUM"

  events:
    (($e.principal.process.file.full_path = /.*/applet$/ nocase or $e.principal.process.file.full_path = /.*/osascript$/ nocase) and $e.target.process.command_line = /.*osacompile.*/ nocase)

  condition:
    $e
}
