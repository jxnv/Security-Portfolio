// Title: Disable Microsoft Defender Firewall via Registry
// ID: 974515da-6cc5-4c95-ae65-f97f9150ec7f
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-01-09
// Tags: attack.defense-impairment, attack.t1686.003
// Description: Adversaries may disable or modify system firewalls in order to bypass controls limiting network usage
// Converted by: Sigma Universal SIEM/EDR CLI

rule 974515da_6cc5_4c95_ae65_f97f9150ec7f {
  meta:
    title = "Disable Microsoft Defender Firewall via Registry"
    description = "Adversaries may disable or modify system firewalls in order to bypass controls limiting network usage"
    author = "frack113"
    severity = "MEDIUM"

  events:
    ($e.TargetObject = /.*\\Services\\SharedAccess\\Parameters\\FirewallPolicy\\.*/ nocase and $e.TargetObject = /.*\\EnableFirewall$/ nocase and $e.Details = "DWORD (0x00000000)")

  condition:
    $e
}
