// Title: Eventlog Cleared
// ID: a62b37e0-45d3-48d9-a517-90c1a1b0186b
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2017-01-10
// Tags: attack.defense-impairment, attack.t1685.005, car.2016-04-002
// Description: One of the Windows Eventlogs has been cleared. e.g. caused by "wevtutil cl" command execution
// Converted by: Sigma Universal SIEM/EDR CLI

rule a62b37e0_45d3_48d9_a517_90c1a1b0186b {
  meta:
    title = "Eventlog Cleared"
    description = "One of the Windows Eventlogs has been cleared. e.g. caused by "wevtutil cl" command execution"
    author = "Florian Roth (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.EventID = 104 and $e.Provider_Name = "Microsoft-Windows-Eventlog") and not((($e.Channel = "Microsoft-Windows-PowerShell/Operational" or $e.Channel = "Microsoft-Windows-Sysmon/Operational" or $e.Channel = "PowerShellCore/Operational" or $e.Channel = "Security" or $e.Channel = "System" or $e.Channel = "Windows PowerShell"))))

  condition:
    $e
}
