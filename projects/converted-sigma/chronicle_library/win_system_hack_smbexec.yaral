rule 52a85084_6989_40c3_8f32_091e12e13f09 {
  meta:
    title = "smbexec.py Service Installation"
    description = "Detects the use of smbexec.py tool by detecting a specific service installation"
    author = "Omer Faruk Celik"
    severity = "HIGH"

  events:
    (($e.Provider_Name = "Service Control Manager" and $e.EventID = 7045) and ((($e.ImagePath = /.*.bat & del .*/ nocase or $e.ImagePath = /.*__output 2^>^&1 >.*/ nocase)) or ($e.ServiceName = "BTOBTO")))

  condition:
    $e
}
