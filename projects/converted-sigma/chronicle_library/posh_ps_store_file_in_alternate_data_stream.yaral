rule a699b30e_d010_46c8_bbd1_ee2e26765fe9 {
  meta:
    title = "Powershell Store File In Alternate Data Stream"
    description = "Storing files in Alternate Data Stream (ADS) similar to Astaroth malware."
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.ScriptBlockText = /.*Start-Process.*/ nocase and $e.ScriptBlockText = /.*-FilePath \"$env:comspec\" .*/ nocase and $e.ScriptBlockText = /.*-ArgumentList .*/ nocase and $e.ScriptBlockText = /.*>.*/ nocase))

  condition:
    $e
}
