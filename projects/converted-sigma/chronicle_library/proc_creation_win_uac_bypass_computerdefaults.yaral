// Title: UAC Bypass Tools Using ComputerDefaults
// ID: 3c05e90d-7eba-4324-9972-5d7f711a60a8
// Status: test
// Level: high
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-08-31
// Tags: attack.privilege-escalation, attack.t1548.002
// Description: Detects tools such as UACMe used to bypass UAC with computerdefaults.exe (UACMe 59)
// Converted by: Sigma Universal SIEM/EDR CLI

rule 3c05e90d_7eba_4324_9972_5d7f711a60a8 {
  meta:
    title = "UAC Bypass Tools Using ComputerDefaults"
    description = "Detects tools such as UACMe used to bypass UAC with computerdefaults.exe (UACMe 59)"
    author = "Christian Burkard (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.IntegrityLevel = "High" or $e.IntegrityLevel = "System" or $e.IntegrityLevel = "S-1-16-16384" or $e.IntegrityLevel = "S-1-16-12288") and $e.target.process.file.full_path = "C:\\Windows\\System32\\ComputerDefaults.exe") and not((($e.principal.process.file.full_path = /.*:\\Windows\\System32.*/ nocase or $e.principal.process.file.full_path = /.*:\\Program Files.*/ nocase))))

  condition:
    $e
}
