rule 32d56ea1_417f_44ff_822b_882873f5f43b {
  meta:
    title = "Impacket PsExec Execution"
    description = "Detects execution of Impacket's psexec.py."
    author = "Bhabesh Raj"
    severity = "HIGH"

  events:
    ($e.EventID = 5145 and $e.ShareName = "\\\\\\\\\\*\\\\IPC$" and ($e.RelativeTargetName = /.*RemCom_stdin.*/ nocase or $e.RelativeTargetName = /.*RemCom_stdout.*/ nocase or $e.RelativeTargetName = /.*RemCom_stderr.*/ nocase))

  condition:
    $e
}
