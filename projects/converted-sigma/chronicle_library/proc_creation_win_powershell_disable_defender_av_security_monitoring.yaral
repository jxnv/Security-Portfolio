// Title: Disable Windows Defender AV Security Monitoring
// ID: a7ee1722-c3c5-aeff-3212-c777e4733217
// Status: test
// Level: high
// Author: ok @securonix invrep-de, oscd.community, frack113
// Date: 2020-10-12
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects attackers attempting to disable Windows Defender using Powershell
// Converted by: Sigma Universal SIEM/EDR CLI

rule a7ee1722_c3c5_aeff_3212_c777e4733217 {
  meta:
    title = "Disable Windows Defender AV Security Monitoring"
    description = "Detects attackers attempting to disable Windows Defender using Powershell"
    author = "ok @securonix invrep-de, oscd.community, frack113"
    severity = "HIGH"

  events:
    ((((($e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase)) or (($e.target.process.file.name = "PowerShell.EXE" or $e.target.process.file.name = "pwsh.dll"))) and (($e.target.process.command_line = /.*-DisableBehaviorMonitoring $true.*/ nocase or $e.target.process.command_line = /.*-DisableRuntimeMonitoring $true.*/ nocase))) or ((($e.target.process.file.full_path = /.*\\sc.exe$/ nocase) or ($e.target.process.file.name = "sc.exe")) and ((($e.target.process.command_line = /.*delete.*/ nocase and $e.target.process.command_line = /.*WinDefend.*/ nocase)) or (($e.target.process.command_line = /.*config.*/ nocase and $e.target.process.command_line = /.*WinDefend.*/ nocase and $e.target.process.command_line = /.*start=disabled.*/ nocase)) or (($e.target.process.command_line = /.*stop.*/ nocase and $e.target.process.command_line = /.*WinDefend.*/ nocase)))))

  condition:
    $e
}
