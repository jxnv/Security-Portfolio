rule afd12fed_b0ec_45c9_a13d_aa86625dac81 {
  meta:
    title = "Create Volume Shadow Copy with Powershell"
    description = "Adversaries may attempt to access or create a copy of the Active Directory domain database in order to steal credential information"
    author = "frack113"
    severity = "HIGH"

  events:
    (($e.ScriptBlockText = /.*Win32_ShadowCopy.*/ nocase and $e.ScriptBlockText = /.*).Create(.*/ nocase and $e.ScriptBlockText = /.*ClientAccessible.*/ nocase))

  condition:
    $e
}
