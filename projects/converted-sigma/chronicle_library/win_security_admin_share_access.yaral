rule 098d7118_55bc_4912_a836_dc6483a8d150 {
  meta:
    title = "Access To ADMIN$ Network Share"
    description = "Detects access to ADMIN$ network share"
    author = "Florian Roth (Nextron Systems)"
    severity = "LOW"

  events:
    (($e.EventID = 5140 and $e.ShareName = "Admin$") and not(($e.SubjectUserName = /.*$$/ nocase)))

  condition:
    $e
}
