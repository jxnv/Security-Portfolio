// Title: Suspicious Space Characters in TypedPaths Registry Path - FileFix
// ID: 8f2a5c3d-9e4b-4a7c-8d1f-2e5a6b9c3d7e
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-11-04
// Tags: attack.execution, attack.stealth, attack.t1204.004, attack.t1027.010
// Description: Detects the occurrence of numerous space characters in TypedPaths registry paths, which may indicate execution via phishing lures using file-fix techniques to hide malicious commands.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 8f2a5c3d_9e4b_4a7c_8d1f_2e5a6b9c3d7e {
  meta:
    title = "Suspicious Space Characters in TypedPaths Registry Path - FileFix"
    description = "Detects the occurrence of numerous space characters in TypedPaths registry paths, which may indicate execution via phishing lures using file-fix techniques to hide malicious commands."
    author = "Swachchhanda Shrawan Poudel (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.TargetObject = /.*\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\TypedPaths\\url1$/ nocase and $e.Details = /.*#.*/ nocase) and (($e.Details = /.*            .*/ nocase or $e.Details = /.*            .*/ nocase or $e.Details = /.*            .*/ nocase or $e.Details = /.*            .*/ nocase or $e.Details = /.*            .*/ nocase or $e.Details = /.*            .*/ nocase or $e.Details = /.*            .*/ nocase or $e.Details = /.*            .*/ nocase or $e.Details = /.*            .*/ nocase or $e.Details = /.*            .*/ nocase or $e.Details = /.*            .*/ nocase or $e.Details = /.*            .*/ nocase or $e.Details = /.*            .*/ nocase)))

  condition:
    $e
}
