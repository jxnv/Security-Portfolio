rule 6b369ced_4b1d_48f1_b427_fdc0de0790bd {
  meta:
    title = "Suspicious Diantz Alternate Data Stream Execution"
    description = "Compress target file into a cab file stored in the Alternate Data Stream (ADS) of the target file."
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.target.process.command_line = /.*diantz.exe.*/ nocase and $e.target.process.command_line = /.*.cab.*/ nocase) and $e.target.process.command_line = /:[^\\]/ nocase)

  condition:
