// Title: PowerShell Dynamic Module Invocation Via ExportedCommands Array Index
// ID: 0c3ebe9f-df09-4e00-be0f-73d4ca8d62f6
// Status: experimental
// Level: high
// Author: Norbert Jaśniewicz (AlphaSOC), Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-10-06
// Tags: attack.execution, attack.stealth, attack.t1027.010, attack.t1059.001
// Description: Detects PowerShell processes invoked with obfuscated command lines that enumerate Microsoft.PowerShell.Utility
// exported commands and invoke cmdlets indirectly by array index. This technique is used to evade
// detections that look for explicit strings such as Invoke-RestMethod or Invoke-Expression.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 0c3ebe9f_df09_4e00_be0f_73d4ca8d62f6 {
  meta:
    title = "PowerShell Dynamic Module Invocation Via ExportedCommands Array Index"
    description = "Detects PowerShell processes invoked with obfuscated command lines that enumerate Microsoft.PowerShell.Utility exported commands and invoke cmdlets indirectly by array index. This technique is used to evade detections that look for explicit strings such as Invoke-RestMethod or Invoke-Expression."
    author = "Norbert Jaśniewicz (AlphaSOC), Swachchhanda Shrawan Poudel (Nextron Systems)"
    severity = "HIGH"

  events:
    (((($e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase)) or (($e.target.process.file.name = "powershell.exe" or $e.target.process.file.name = "pwsh.dll"))) and ($e.target.process.command_line = /.*[*].*/ nocase) and (($e.target.process.command_line = /.*Get-Module .*/ nocase or $e.target.process.command_line = /.*gmo .*/ nocase) and ($e.target.process.command_line = /.*ListAvailable.*/ nocase and $e.target.process.command_line = /.*Microsoft.PowerShell.Utility.*/ nocase and $e.target.process.command_line = /.*ExportedCommands.*/ nocase and $e.target.process.command_line = /.*Values.*/ nocase)))

  condition:
    $e
}
