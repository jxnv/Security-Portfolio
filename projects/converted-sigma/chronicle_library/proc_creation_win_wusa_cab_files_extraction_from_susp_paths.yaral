// Title: Cab File Extraction Via Wusa.EXE From Potentially Suspicious Paths
// ID: c74c0390-3e20-41fd-a69a-128f0275a5ea
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-05
// Tags: attack.execution
// Description: Detects the execution of the "wusa.exe" (Windows Update Standalone Installer) utility to extract ".cab" files using the "/extract" argument from potentially suspicious paths.
// Converted by: Sigma Universal SIEM/EDR CLI

rule c74c0390_3e20_41fd_a69a_128f0275a5ea {
  meta:
    title = "Cab File Extraction Via Wusa.EXE From Potentially Suspicious Paths"
    description = "Detects the execution of the "wusa.exe" (Windows Update Standalone Installer) utility to extract ".cab" files using the "/extract" argument from potentially suspicious paths."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*:\\PerfLogs\\.*/ nocase or $e.target.process.command_line = /.*:\\Users\\Public\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\Temp\\.*/ nocase or $e.target.process.command_line = /.*\\Appdata\\Local\\Temp\\.*/ nocase)) and ($e.target.process.file.full_path = /.*\\wusa.exe$/ nocase and $e.target.process.command_line = /.*/extract:.*/ nocase))

  condition:
    $e
}
