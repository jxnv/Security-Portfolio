// Title: RDP Connection Allowed Via Netsh.EXE
// ID: 01aeb693-138d-49d2-9403-c4f52d7d3d62
// Status: test
// Level: high
// Author: Sander Wiebing
// Date: 2020-05-23
// Tags: attack.defense-impairment, attack.t1686.003
// Description: Detects usage of the netsh command to open and allow connections to port 3389 (RDP). As seen used by Sarwent Malware
// Converted by: Sigma Universal SIEM/EDR CLI

rule 01aeb693_138d_49d2_9403_c4f52d7d3d62 {
  meta:
    title = "RDP Connection Allowed Via Netsh.EXE"
    description = "Detects usage of the netsh command to open and allow connections to port 3389 (RDP). As seen used by Sarwent Malware"
    author = "Sander Wiebing"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*firewall .*/ nocase and $e.target.process.command_line = /.*add .*/ nocase and $e.target.process.command_line = /.*tcp .*/ nocase and $e.target.process.command_line = /.*3389.*/ nocase) and ($e.target.process.command_line = /.*portopening.*/ nocase or $e.target.process.command_line = /.*allow.*/ nocase)) and (($e.target.process.file.full_path = /.*\\netsh.exe$/ nocase) or ($e.target.process.file.name = "netsh.exe")))

  condition:
    $e
}
