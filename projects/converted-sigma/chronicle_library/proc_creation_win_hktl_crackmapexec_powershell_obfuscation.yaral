// Title: HackTool - CrackMapExec PowerShell Obfuscation
// ID: 6f8b3439-a203-45dc-a88b-abf57ea15ccf
// Status: test
// Level: high
// Author: Thomas Patzke
// Date: 2020-05-22
// Tags: attack.execution, attack.stealth, attack.t1059.001, attack.t1027.005
// Description: The CrachMapExec pentesting framework implements a PowerShell obfuscation with some static strings detected by this rule.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 6f8b3439_a203_45dc_a88b_abf57ea15ccf {
  meta:
    title = "HackTool - CrackMapExec PowerShell Obfuscation"
    description = "The CrachMapExec pentesting framework implements a PowerShell obfuscation with some static strings detected by this rule."
    author = "Thomas Patzke"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*join*split.*/ nocase or $e.target.process.command_line = /.*( $ShellId[1]+$ShellId[13]+'x').*/ nocase or $e.target.process.command_line = /.*( $PSHome[*]+$PSHOME[*]+.*/ nocase or $e.target.process.command_line = /.*( $env:Public[13]+$env:Public[5]+'x').*/ nocase or $e.target.process.command_line = /.*( $env:ComSpec[4,*,25]-Join'').*/ nocase or $e.target.process.command_line = /.*[1,3]+'x'-Join'').*/ nocase)) and ((($e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase)) or (($e.target.process.file.name = "PowerShell.EXE" or $e.target.process.file.name = "pwsh.dll"))))

  condition:
    $e
}
