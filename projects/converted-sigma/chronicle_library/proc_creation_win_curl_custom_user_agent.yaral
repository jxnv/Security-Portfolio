// Title: Curl Web Request With Potential Custom User-Agent
// ID: 85de1f22-d189-44e4-8239-dc276b45379b
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-07-27
// Tags: attack.execution
// Description: Detects execution of "curl.exe" with a potential custom "User-Agent". Attackers can leverage this to download or exfiltrate data via "curl" to a domain that only accept specific "User-Agent" strings
// Converted by: Sigma Universal SIEM/EDR CLI

rule 85de1f22_d189_44e4_8239_dc276b45379b {
  meta:
    title = "Curl Web Request With Potential Custom User-Agent"
    description = "Detects execution of "curl.exe" with a potential custom "User-Agent". Attackers can leverage this to download or exfiltrate data via "curl" to a domain that only accept specific "User-Agent" strings"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.file.full_path = /.*\\curl.exe$/ nocase) or ($e.target.process.file.name = "curl.exe")) and (($e.target.process.command_line = /\s-H\s/ nocase) or ($e.target.process.command_line = /.*--header.*/ nocase)) and ($e.target.process.command_line = /.*User-Agent:.*/ nocase))

  condition:
    $e
}
