rule 6bba49bf_7f8c_47d6_a1bb_6b4dece4640e {
  meta:
    title = "Suspicious RASdial Activity"
    description = "Detects suspicious process related to rasdial.exe"
    author = "juju4"
    severity = "MEDIUM"

  events:
    ($e.target.process.file.full_path = /.*rasdial.exe$/ nocase)

  condition:
    $e
}
