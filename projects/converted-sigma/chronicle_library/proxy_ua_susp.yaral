// Title: Suspicious User Agent
// ID: 7195a772-4b3f-43a4-a210-6a003d65caa1
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2017-07-08
// Tags: attack.command-and-control, attack.t1071.001
// Description: Detects suspicious malformed user agent strings in proxy logs
// Converted by: Sigma Universal SIEM/EDR CLI

rule 7195a772_4b3f_43a4_a210_6a003d65caa1 {
  meta:
    title = "Suspicious User Agent"
    description = "Detects suspicious malformed user agent strings in proxy logs"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (((($e.c-useragent = /^user-agent.*/ nocase or $e.c-useragent = /^Mozilla/3.0 .*/ nocase or $e.c-useragent = /^Mozilla/2.0 .*/ nocase or $e.c-useragent = /^Mozilla/1.0 .*/ nocase or $e.c-useragent = /^Mozilla .*/ nocase or $e.c-useragent = /^ Mozilla/.*/ nocase or $e.c-useragent = /^Mozila/.*/ nocase or $e.c-useragent = /^Mozilla/4.0 (compatible; MSIE 6.0; MS Web Services Client Protocol.*/ nocase)) or (($e.c-useragent = /.* (compatible;MSIE .*/ nocase or $e.c-useragent = /.*.0;Windows NT .*/ nocase or $e.c-useragent = /.*loader.*/ nocase)) or (($e.c-useragent = "_" or $e.c-useragent = "CertUtil URL Agent" or $e.c-useragent = "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:60.0)" or $e.c-useragent = "Mozilla/5.0 (Windows NT 6.3; WOW64; rv:28.0) Gecko/20100101 Firefox/28.0" or $e.c-useragent = "HTTPS" or $e.c-useragent = "Erbium-UA-4ce7c27cb4be9d32e333bf032c88235a" or $e.c-useragent = "x" or $e.c-useragent = "xxx"))) and not((($e.c-useragent = "Mozilla/3.0 * Acrobat *") or (($e.cs-host = /.*.acrobat.com$/ nocase or $e.cs-host = /.*.adobe.com$/ nocase or $e.cs-host = /.*.adobe.io$/ nocase)))))

  condition:
    $e
}
