// Title: COM Hijacking via TreatAs
// ID: dc5c24af-6995-49b2-86eb-a9ff62199e82
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-08-28
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.015
// Description: Detect modification of TreatAs key to enable "rundll32.exe -sta" command
// Converted by: Sigma Universal SIEM/EDR CLI

rule dc5c24af_6995_49b2_86eb_a9ff62199e82 {
  meta:
    title = "COM Hijacking via TreatAs"
    description = "Detect modification of TreatAs key to enable "rundll32.exe -sta" command"
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.TargetObject = /.*TreatAs\\(Default)$/ nocase) and not(((($e.target.process.file.full_path = "C:\\Windows\\system32\\msiexec.exe" or $e.target.process.file.full_path = "C:\\Windows\\SysWOW64\\msiexec.exe")) or ($e.target.process.file.full_path = /^C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\.*/ nocase and $e.target.process.file.full_path = /.*\\OfficeClickToRun.exe$/ nocase) or (($e.target.process.file.full_path = "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe" or $e.target.process.file.full_path = "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe")) or ($e.target.process.file.full_path = "C:\\Windows\\system32\\svchost.exe"))))

  condition:
    $e
}
