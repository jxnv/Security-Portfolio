// Title: Sensitive File Dump Via Wbadmin.EXE
// ID: 8b93a509-1cb8-42e1-97aa-ee24224cdc15
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), frack113
// Date: 2024-05-10
// Tags: attack.credential-access, attack.t1003.003
// Description: Detects the dump of highly sensitive files such as "NTDS.DIT" and "SECURITY" hive.
// Attackers can leverage the "wbadmin" utility in order to dump sensitive files that might contain credential or sensitive information.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 8b93a509_1cb8_42e1_97aa_ee24224cdc15 {
  meta:
    title = "Sensitive File Dump Via Wbadmin.EXE"
    description = "Detects the dump of highly sensitive files such as "NTDS.DIT" and "SECURITY" hive. Attackers can leverage the "wbadmin" utility in order to dump sensitive files that might contain credential or sensitive information."
    author = "Nasreddine Bencherchali (Nextron Systems), frack113"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*start.*/ nocase or $e.target.process.command_line = /.*backup.*/ nocase)) and (($e.target.process.file.full_path = /.*\\wbadmin.exe$/ nocase) or ($e.target.process.file.name = "WBADMIN.EXE")) and (($e.target.process.command_line = /.*\\config\\SAM.*/ nocase or $e.target.process.command_line = /.*\\config\\SECURITY.*/ nocase or $e.target.process.command_line = /.*\\config\\SYSTEM.*/ nocase or $e.target.process.command_line = /.*\\Windows\\NTDS\\NTDS.dit.*/ nocase)))

  condition:
    $e
}
