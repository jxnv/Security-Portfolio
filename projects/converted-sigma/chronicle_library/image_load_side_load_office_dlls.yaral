// Title: Microsoft Office DLL Sideload
// ID: 829a3bdf-34da-4051-9cf4-8ed221a8ae4f
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Wietze Beukema (project and research)
// Date: 2022-08-17
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects DLL sideloading of DLLs that are part of Microsoft Office from non standard location
// Converted by: Sigma Universal SIEM/EDR CLI

rule 829a3bdf_34da_4051_9cf4_8ed221a8ae4f {
  meta:
    title = "Microsoft Office DLL Sideload"
    description = "Detects DLL sideloading of DLLs that are part of Microsoft Office from non standard location"
    author = "Nasreddine Bencherchali (Nextron Systems), Wietze Beukema (project and research)"
    severity = "HIGH"

  events:
    (($e.ImageLoaded = /.*\\outllib.dll$/ nocase) and not((($e.ImageLoaded = /^C:\\Program Files\\Microsoft Office\\OFFICE.*/ nocase or $e.ImageLoaded = /^C:\\Program Files (x86)\\Microsoft Office\\OFFICE.*/ nocase or $e.ImageLoaded = /^C:\\Program Files\\Microsoft Office\\Root\\OFFICE.*/ nocase or $e.ImageLoaded = /^C:\\Program Files (x86)\\Microsoft Office\\Root\\OFFICE.*/ nocase))))

  condition:
    $e
}
