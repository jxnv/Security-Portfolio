// Title: Audio Capture via SoundRecorder
// ID: 83865853-59aa-449e-9600-74b9d89a6d6e
// Status: test
// Level: medium
// Author: E.M. Anhaus (originally from Atomic Blue Detections, Endgame), oscd.community
// Date: 2019-10-24
// Tags: attack.collection, attack.t1123
// Description: Detect attacker collecting audio via SoundRecorder application.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 83865853_59aa_449e_9600_74b9d89a6d6e {
  meta:
    title = "Audio Capture via SoundRecorder"
    description = "Detect attacker collecting audio via SoundRecorder application."
    author = "E.M. Anhaus (originally from Atomic Blue Detections, Endgame), oscd.community"
    severity = "MEDIUM"

  events:
    ($e.target.process.file.full_path = /.*\\SoundRecorder.exe$/ nocase and $e.target.process.command_line = /.*/FILE.*/ nocase)

  condition:
    $e
}
