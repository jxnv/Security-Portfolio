rule 487c7524_f892_4054_b263_8a0ace63fc25 {
  meta:
    title = "Invoke-Obfuscation Via Stdin - System"
    description = "Detects Obfuscated Powershell via Stdin in Scripts"
    author = "Nikita Nazarov, oscd.community"
    severity = "HIGH"

  events:
    ($e.Provider_Name = "Service Control Manager" and $e.EventID = 7045 and ($e.ImagePath = /.*set.*/ nocase and $e.ImagePath = /.*&&.*/ nocase) and ($e.ImagePath = /.*environment.*/ nocase or $e.ImagePath = /.*invoke.*/ nocase or $e.ImagePath = /.*input.*/ nocase))

  condition:
    $e
}
