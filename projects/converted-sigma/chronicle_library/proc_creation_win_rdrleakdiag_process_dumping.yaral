// Title: Process Memory Dump via RdrLeakDiag.EXE
// ID: edadb1e5-5919-4e4c-8462-a9e643b02c4b
// Status: test
// Level: high
// Author: Cedric MAURUGEON, Florian Roth (Nextron Systems), Swachchhanda Shrawan Poudel, Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-09-24
// Tags: attack.credential-access, attack.t1003.001
// Description: Detects the use of the Microsoft Windows Resource Leak Diagnostic tool "rdrleakdiag.exe" to dump process memory
// Converted by: Sigma Universal SIEM/EDR CLI

rule edadb1e5_5919_4e4c_8462_a9e643b02c4b {
  meta:
    title = "Process Memory Dump via RdrLeakDiag.EXE"
    description = "Detects the use of the Microsoft Windows Resource Leak Diagnostic tool "rdrleakdiag.exe" to dump process memory"
    author = "Cedric MAURUGEON, Florian Roth (Nextron Systems), Swachchhanda Shrawan Poudel, Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*/memdmp.*/ nocase or $e.target.process.command_line = /.*-memdmp.*/ nocase or $e.target.process.command_line = /.*fullmemdmp.*/ nocase)) and (($e.target.process.command_line = /.* /o .*/ nocase or $e.target.process.command_line = /.* /p .*/ nocase)) and (($e.target.process.file.full_path = /.*\\rdrleakdiag.exe$/ nocase) or ($e.target.process.file.name = "RdrLeakDiag.exe")))

  condition:
    $e
}
