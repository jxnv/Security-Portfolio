// Title: UAC Bypass via Sdclt
// ID: 5b872a46-3b90-45c1-8419-f675db8053aa
// Status: test
// Level: high
// Author: Omer Yampel, Christian Burkard (Nextron Systems)
// Date: 2017-03-17
// Tags: attack.privilege-escalation, attack.t1548.002, car.2019-04-001
// Description: Detects the pattern of UAC Bypass using registry key manipulation of sdclt.exe (e.g. UACMe 53)
// Converted by: Sigma Universal SIEM/EDR CLI

rule 5b872a46_3b90_45c1_8419_f675db8053aa {
  meta:
    title = "UAC Bypass via Sdclt"
    description = "Detects the pattern of UAC Bypass using registry key manipulation of sdclt.exe (e.g. UACMe 53)"
    author = "Omer Yampel, Christian Burkard (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.TargetObject = /.*Software\\Classes\\exefile\\shell\\runas\\command\\isolatedCommand$/ nocase) or ($e.TargetObject = /.*Software\\Classes\\Folder\\shell\\open\\command\\SymbolicLinkValue$/ nocase and $e.Details = /-1[0-9]{3}\\Software\\Classes\\/ nocase))

  condition:
    $e
}
