// Status: test
// Level: high
// Author: wagga, Jonhnathan Ribeiro, oscd.community
// Date: 2020-01-12
// Tags: attack.execution, attack.t1059.003, attack.t1059.005, attack.t1059.007
// Description: Detects command line parameters used by Koadic hack tool
// Converted by: Sigma Universal SIEM/EDR CLI

rule 5cddf373_ef00_4112_ad72_960ac29bac34 {
  meta:
    title = "HackTool - Koadic Execution"
    description = "Detects command line parameters used by Koadic hack tool"
    author = "wagga, Jonhnathan Ribeiro, oscd.community"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*/q.*/ nocase and $e.target.process.command_line = /.*/c.*/ nocase and $e.target.process.command_line = /.*chcp.*/ nocase)) and (($e.target.process.file.full_path = /.*\\cmd.exe$/ nocase) or ($e.target.process.file.name = "Cmd.Exe")))

  condition:
    $e
}
