// Title: Capture Credentials with Rpcping.exe
// ID: 93671f99-04eb-4ab4-a161-70d446a84003
// Status: test
// Level: medium
// Author: Julia Fomina, oscd.community
// Date: 2020-10-09
// Tags: attack.credential-access, attack.t1003
// Description: Detects using Rpcping.exe to send a RPC test connection to the target server (-s) and force the NTLM hash to be sent in the process.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 93671f99_04eb_4ab4_a161_70d446a84003 {
  meta:
    title = "Capture Credentials with Rpcping.exe"
    description = "Detects using Rpcping.exe to send a RPC test connection to the target server (-s) and force the NTLM hash to be sent in the process."
    author = "Julia Fomina, oscd.community"
    severity = "MEDIUM"

  events:
    (((($e.target.process.command_line = /.*-s.*/ nocase or $e.target.process.command_line = /.*/s.*/ nocase)) and (($e.target.process.file.full_path = /.*\\RpcPing.exe$/ nocase) or ($e.target.process.file.name = "\\RpcPing.exe"))) and ((($e.target.process.command_line = /.*-t.*/ nocase or $e.target.process.command_line = /.*/t.*/ nocase) and $e.target.process.command_line = /.*ncacn_np.*/ nocase) or (($e.target.process.command_line = /.*-u.*/ nocase or $e.target.process.command_line = /.*/u.*/ nocase) and $e.target.process.command_line = /.*NTLM.*/ nocase)))

  condition:
    $e
}
