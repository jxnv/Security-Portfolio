// Title: Service StartupType Change Via PowerShell Set-Service
// ID: 62b20d44-1546-4e61-afce-8e175eb9473c
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-03-04
// Tags: attack.execution, attack.defense-impairment, attack.t1685
// Description: Detects the use of the PowerShell "Set-Service" cmdlet to change the startup type of a service to "disabled" or "manual"
// Converted by: Sigma Universal SIEM/EDR CLI

rule 62b20d44_1546_4e61_afce_8e175eb9473c {
  meta:
    title = "Service StartupType Change Via PowerShell Set-Service"
    description = "Detects the use of the PowerShell "Set-Service" cmdlet to change the startup type of a service to "disabled" or "manual""
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*Set-Service.*/ nocase and $e.target.process.command_line = /.*-StartupType.*/ nocase) and ($e.target.process.command_line = /.*Disabled.*/ nocase or $e.target.process.command_line = /.*Manual.*/ nocase)) and (($e.target.process.file.full_path = /.*\\powershell.exe$/ nocase) or ($e.target.process.file.name = "PowerShell.EXE")))

  condition:
    $e
}
