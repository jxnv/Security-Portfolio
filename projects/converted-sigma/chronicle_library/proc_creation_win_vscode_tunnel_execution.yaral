// Title: Visual Studio Code Tunnel Execution
// ID: 90d6bd71-dffb-4989-8d86-a827fedd6624
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), citron_ninja
// Date: 2023-10-25
// Tags: attack.command-and-control, attack.t1071.001, attack.t1219
// Description: Detects Visual Studio Code tunnel execution. Attackers can abuse this functionality to establish a C2 channel
// Converted by: Sigma Universal SIEM/EDR CLI

rule 90d6bd71_dffb_4989_8d86_a827fedd6624 {
  meta:
    title = "Visual Studio Code Tunnel Execution"
    description = "Detects Visual Studio Code tunnel execution. Attackers can abuse this functionality to establish a C2 channel"
    author = "Nasreddine Bencherchali (Nextron Systems), citron_ninja"
    severity = "MEDIUM"

  events:
    ((not ($e.target.process.file.name = /.*/) and $e.target.process.command_line = /.*.exe tunnel$/ nocase) or ($e.principal.process.command_line = /.* tunnel$/ nocase and $e.target.process.file.full_path = /.*\\cmd.exe$/ nocase and ($e.target.process.command_line = /.*/d /c .*/ nocase and $e.target.process.command_line = /.*\\servers\\Stable-.*/ nocase and $e.target.process.command_line = /.*code-server.cmd.*/ nocase)) or (($e.target.process.command_line = /.*.exe tunnel.*/ nocase and $e.target.process.command_line = /.*--accept-server-license-terms.*/ nocase)))

  condition:
    $e
}
