rule 028c7842_4243_41cd_be6f_12f3cf1a26c7 {
  meta:
    title = "AD Object WriteDAC Access"
    description = "Detects WRITE_DAC access to a domain object"
    author = "Roberto Rodriguez @Cyb3rWard0g"
    severity = "CRITICAL"

  events:
    ($e.EventID = 4662 and $e.ObjectServer = "DS" and $e.AccessMask = "0x40000" and ($e.ObjectType = "19195a5b-6da0-11d0-afd3-00c04fd930c9" or $e.ObjectType = "domainDNS"))

  condition:
    $e
}
