// Title: Taskmgr as LOCAL_SYSTEM
// ID: 9fff585c-c33e-4a86-b3cd-39312079a65f
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2018-03-18
// Tags: attack.stealth, attack.t1036
// Description: Detects the creation of taskmgr.exe process in context of LOCAL_SYSTEM
// Converted by: Sigma Universal SIEM/EDR CLI

rule 9fff585c_c33e_4a86_b3cd_39312079a65f {
  meta:
    title = "Taskmgr as LOCAL_SYSTEM"
    description = "Detects the creation of taskmgr.exe process in context of LOCAL_SYSTEM"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.user.userid = /.*AUTHORI.*/ nocase or $e.target.user.userid = /.*AUTORI.*/ nocase) and $e.target.process.file.full_path = /.*\\taskmgr.exe$/ nocase)

  condition:
    $e
}
