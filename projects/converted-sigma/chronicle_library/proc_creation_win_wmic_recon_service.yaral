// Title: Service Reconnaissance Via Wmic.EXE
// ID: 76f55eaa-d27f-4213-9d45-7b0e4b60bbae
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-14
// Tags: attack.execution, attack.t1047
// Description: An adversary might use WMI to check if a certain remote service is running on a remote device.
// When the test completes, a service information will be displayed on the screen if it exists.
// A common feedback message is that "No instance(s) Available" if the service queried is not running.
// A common error message is "Node - (provided IP or default) ERROR Description =The RPC server is unavailable" if the provided remote host is unreachable
// Converted by: Sigma Universal SIEM/EDR CLI

rule 76f55eaa_d27f_4213_9d45_7b0e4b60bbae {
  meta:
    title = "Service Reconnaissance Via Wmic.EXE"
    description = "An adversary might use WMI to check if a certain remote service is running on a remote device. When the test completes, a service information will be displayed on the screen if it exists. A common feedback message is that "No instance(s) Available" if the service queried is not running. A common error message is "Node - (provided IP or default) ERROR Description =The RPC server is unavailable" if the provided remote host is unreachable"
    author = "frack113, Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*service.*/ nocase) and (($e.target.process.file.full_path = /.*\\WMIC.exe$/ nocase) or ($e.target.process.file.name = "wmic.exe"))) and not(((($e.target.process.command_line = /.*stopservice.*/ nocase or $e.target.process.command_line = /.*startservice.*/ nocase)) or (($e.target.process.command_line = /.*Change.*/ nocase or $e.target.process.command_line = /.*Create.*/ nocase or $e.target.process.command_line = /.*Delete.*/ nocase or $e.target.process.command_line = /.*PauseService.*/ nocase or $e.target.process.command_line = /.*ResumeService.*/ nocase or $e.target.process.command_line = /.*SetSecurityDescriptor.*/ nocase or $e.target.process.command_line = /.*StartService.*/ nocase or $e.target.process.command_line = /.*StopService.*/ nocase or $e.target.process.command_line = /.*UserControlService.*/ nocase)))))

  condition:
    $e
}
