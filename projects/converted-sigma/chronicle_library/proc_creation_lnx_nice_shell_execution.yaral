// Title: Shell Execution via Nice - Linux
// ID: 093d68c7-762a-42f4-9f46-95e79142571a
// Status: test
// Level: high
// Author: Li Ling, Andy Parkidomo, Robert Rakowski, Blake Hartstein (Bloomberg L.P.)
// Date: 2024-09-02
// Tags: attack.discovery, attack.t1083
// Description: Detects the use of the "nice" utility to execute a shell. Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 093d68c7_762a_42f4_9f46_95e79142571a {
  meta:
    title = "Shell Execution via Nice - Linux"
    description = "Detects the use of the "nice" utility to execute a shell. Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments."
    author = "Li Ling, Andy Parkidomo, Robert Rakowski, Blake Hartstein (Bloomberg L.P.)"
    severity = "HIGH"

  events:
    ($e.target.process.file.full_path = /.*/nice$/ nocase and ($e.target.process.command_line = /.*/bin/bash$/ nocase or $e.target.process.command_line = /.*/bin/dash$/ nocase or $e.target.process.command_line = /.*/bin/fish$/ nocase or $e.target.process.command_line = /.*/bin/sh$/ nocase or $e.target.process.command_line = /.*/bin/zsh$/ nocase))

  condition:
    $e
}
