// Title: HackTool - SharpLdapWhoami Execution
// ID: d9367cbb-c2e0-47ce-bdc0-128cb6da898d
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-08-29
// Tags: attack.discovery, attack.t1033, car.2016-03-001
// Description: Detects SharpLdapWhoami, a whoami alternative that queries the LDAP service on a domain controller
// Converted by: Sigma Universal SIEM/EDR CLI

rule d9367cbb_c2e0_47ce_bdc0_128cb6da898d {
  meta:
    title = "HackTool - SharpLdapWhoami Execution"
    description = "Detects SharpLdapWhoami, a whoami alternative that queries the LDAP service on a domain controller"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.* /method:ntlm$/ nocase or $e.target.process.command_line = /.* /method:kerb$/ nocase or $e.target.process.command_line = /.* /method:nego$/ nocase or $e.target.process.command_line = /.* /m:nego$/ nocase or $e.target.process.command_line = /.* /m:ntlm$/ nocase or $e.target.process.command_line = /.* /m:kerb$/ nocase)) or ($e.target.process.file.full_path = /.*\\SharpLdapWhoami.exe$/ nocase) or (($e.target.process.file.name = /.*SharpLdapWhoami.*/ nocase) or ($e.Product = "SharpLdapWhoami")))

  condition:
    $e
}
