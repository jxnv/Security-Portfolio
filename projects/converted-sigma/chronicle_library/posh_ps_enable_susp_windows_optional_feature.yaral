// Title: Potential Suspicious Windows Feature Enabled
// ID: 55c925c1-7195-426b-a136-a9396800e29b
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-09-10
// Tags: attack.stealth
// Description: Detects usage of the built-in PowerShell cmdlet "Enable-WindowsOptionalFeature" used as a Deployment Image Servicing and Management tool.
// Similar to DISM.exe, this cmdlet is used to enumerate, install, uninstall, configure, and update features and packages in Windows images
// Converted by: Sigma Universal SIEM/EDR CLI

rule 55c925c1_7195_426b_a136_a9396800e29b {
  meta:
    title = "Potential Suspicious Windows Feature Enabled"
    description = "Detects usage of the built-in PowerShell cmdlet "Enable-WindowsOptionalFeature" used as a Deployment Image Servicing and Management tool. Similar to DISM.exe, this cmdlet is used to enumerate, install, uninstall, configure, and update features and packages in Windows images"
    author = "frack113"
    severity = "MEDIUM"

  events:
    ((($e.ScriptBlockText = /.*Enable-WindowsOptionalFeature.*/ nocase and $e.ScriptBlockText = /.*-Online.*/ nocase and $e.ScriptBlockText = /.*-FeatureName.*/ nocase)) and (($e.ScriptBlockText = /.*TelnetServer.*/ nocase or $e.ScriptBlockText = /.*Internet-Explorer-Optional-amd64.*/ nocase or $e.ScriptBlockText = /.*TFTP.*/ nocase or $e.ScriptBlockText = /.*SMB1Protocol.*/ nocase or $e.ScriptBlockText = /.*Client-ProjFS.*/ nocase or $e.ScriptBlockText = /.*Microsoft-Windows-Subsystem-Linux.*/ nocase)))

  condition:
    $e
}
