// Title: Potential PSFactoryBuffer COM Hijacking
// ID: 243380fa-11eb-4141-af92-e14925e77c1b
// Status: test
// Level: high
// Author: BlackBerry Threat Research and Intelligence Team - @Joseliyo_Jstnk
// Date: 2023-06-07
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.015
// Description: Detects changes to the PSFactory COM InProcServer32 registry. This technique was used by RomCom to create persistence storing a malicious DLL.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 243380fa_11eb_4141_af92_e14925e77c1b {
  meta:
    title = "Potential PSFactoryBuffer COM Hijacking"
    description = "Detects changes to the PSFactory COM InProcServer32 registry. This technique was used by RomCom to create persistence storing a malicious DLL."
    author = "BlackBerry Threat Research and Intelligence Team - @Joseliyo_Jstnk"
    severity = "HIGH"

  events:
    (($e.TargetObject = /.*\\CLSID\\{c90250f3-4d7d-4991-9b69-a5c5bc1c2ae6}\\InProcServer32\\(Default)$/ nocase) and not((($e.Details = "%windir%\\System32\\ActXPrxy.dll" or $e.Details = "C:\\Windows\\System32\\ActXPrxy.dll"))))

  condition:
    $e
}
