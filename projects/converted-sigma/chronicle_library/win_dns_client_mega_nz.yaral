rule 66474410_b883_415f_9f8d_75345a0a66a6 {
  meta:
    title = "DNS Query To MEGA Hosting Website - DNS Client"
    description = "Detects DNS queries for subdomains related to MEGA sharing website"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ($e.EventID = 3008 and $e.QueryName = /.*userstorage.mega.co.nz.*/ nocase)

  condition:
    $e
}
