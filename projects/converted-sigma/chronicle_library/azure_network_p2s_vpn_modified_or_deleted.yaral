// Title: Azure Point-to-site VPN Modified or Deleted
// ID: d9557b75-267b-4b43-922f-a775e2d1f792
// Status: test
// Level: medium
// Author: Austin Songer @austinsonger
// Date: 2021-08-08
// Tags: attack.impact
// Description: Identifies when a Point-to-site VPN is Modified or Deleted.
// Converted by: Sigma Universal SIEM/EDR CLI

rule d9557b75_267b_4b43_922f_a775e2d1f792 {
  meta:
    title = "Azure Point-to-site VPN Modified or Deleted"
    description = "Identifies when a Point-to-site VPN is Modified or Deleted."
    author = "Austin Songer @austinsonger"
    severity = "MEDIUM"

  events:
    (($e.operationName = "MICROSOFT.NETWORK/P2SVPNGATEWAYS/WRITE" or $e.operationName = "MICROSOFT.NETWORK/P2SVPNGATEWAYS/DELETE" or $e.operationName = "MICROSOFT.NETWORK/P2SVPNGATEWAYS/RESET/ACTION" or $e.operationName = "MICROSOFT.NETWORK/P2SVPNGATEWAYS/GENERATEVPNPROFILE/ACTION" or $e.operationName = "MICROSOFT.NETWORK/P2SVPNGATEWAYS/DISCONNECTP2SVPNCONNECTIONS/ACTION" or $e.operationName = "MICROSOFT.NETWORK/P2SVPNGATEWAYS/PROVIDERS/MICROSOFT.INSIGHTS/DIAGNOSTICSETTINGS/WRITE"))

  condition:
    $e
}
