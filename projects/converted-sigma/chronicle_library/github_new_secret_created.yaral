rule f9405037_bc97_4eb7_baba_167dad399b83 {
  meta:
    title = "Github New Secret Created"
    description = "Detects when a user creates action secret for the organization, environment, codespaces or repository."
    author = "Muhammad Faisal (@faisalusuf)"
    severity = "LOW"

  events:
    (($e.action = "codespaces.create_an_org_secret" or $e.action = "environment.create_actions_secret" or $e.action = "org.create_actions_secret" or $e.action = "repo.create_actions_secret"))

  condition:
    $e
}
