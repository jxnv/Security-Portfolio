// Title: Active Directory Computers Enumeration With Get-AdComputer
// ID: 36bed6b2-e9a0-4fff-beeb-413a92b86138
// Status: test
// Level: low
// Author: frack113
// Date: 2022-03-17
// Tags: attack.discovery, attack.t1018, attack.t1087.002
// Description: Detects usage of the "Get-AdComputer" to enumerate Computers or properties within Active Directory.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 36bed6b2_e9a0_4fff_beeb_413a92b86138 {
  meta:
    title = "Active Directory Computers Enumeration With Get-AdComputer"
    description = "Detects usage of the "Get-AdComputer" to enumerate Computers or properties within Active Directory."
    author = "frack113"
    severity = "LOW"

  events:
    (($e.ScriptBlockText = /.*Get-AdComputer .*/ nocase) and (($e.ScriptBlockText = /.*-Filter .*/ nocase or $e.ScriptBlockText = /.*-LDAPFilter .*/ nocase or $e.ScriptBlockText = /.*-Properties .*/ nocase)))

  condition:
    $e
}
