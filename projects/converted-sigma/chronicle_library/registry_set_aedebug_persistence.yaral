// Title: Add Debugger Entry To AeDebug For Persistence
// ID: 092af964-4233-4373-b4ba-d86ea2890288
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-21
// Tags: attack.persistence
// Description: Detects when an attacker adds a new "Debugger" value to the "AeDebug" key in order to achieve persistence which will get invoked when an application crashes
// Converted by: Sigma Universal SIEM/EDR CLI

rule 092af964_4233_4373_b4ba_d86ea2890288 {
  meta:
    title = "Add Debugger Entry To AeDebug For Persistence"
    description = "Detects when an attacker adds a new "Debugger" value to the "AeDebug" key in order to achieve persistence which will get invoked when an application crashes"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.TargetObject = /.*\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\AeDebug\\Debugger.*/ nocase and $e.Details = /.*.dll$/ nocase) and not(($e.Details = "\"C:\\WINDOWS\\system32\\vsjitdebugger.exe\" -p %ld -e %ld -j 0x%p")))

  condition:
    $e
}
