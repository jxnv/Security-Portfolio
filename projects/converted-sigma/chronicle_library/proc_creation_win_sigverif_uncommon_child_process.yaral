// Title: Uncommon Sigverif.EXE Child Process
// ID: 7d4aaec2-08ed-4430-8b96-28420e030e04
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-19
// Tags: attack.stealth, attack.t1216
// Description: Detects uncommon child processes spawning from "sigverif.exe", which could indicate potential abuse of the latter as a living of the land binary in order to proxy execution.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 7d4aaec2_08ed_4430_8b96_28420e030e04 {
  meta:
    title = "Uncommon Sigverif.EXE Child Process"
    description = "Detects uncommon child processes spawning from "sigverif.exe", which could indicate potential abuse of the latter as a living of the land binary in order to proxy execution."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.principal.process.file.full_path = /.*\\sigverif.exe$/ nocase) and not((($e.target.process.file.full_path = "C:\\Windows\\System32\\WerFault.exe" or $e.target.process.file.full_path = "C:\\Windows\\SysWOW64\\WerFault.exe"))))

  condition:
    $e
}
