// Title: Control Panel Items
// ID: 0ba863e6-def5-4e50-9cea-4dd8c7dc46a4
// Status: test
// Level: high
// Author: Kyaw Min Thein, Furkan Caliskan (@caliskanfurkan_)
// Date: 2020-06-22
// Tags: attack.privilege-escalation, attack.execution, attack.stealth, attack.t1218.002, attack.persistence, attack.t1546
// Description: Detects the malicious use of a control panel item
// Converted by: Sigma Universal SIEM/EDR CLI

rule 0ba863e6_def5_4e50_9cea_4dd8c7dc46a4 {
  meta:
    title = "Control Panel Items"
    description = "Detects the malicious use of a control panel item"
    author = "Kyaw Min Thein, Furkan Caliskan (@caliskanfurkan_)"
    severity = "HIGH"

  events:
    (((($e.target.process.command_line = /.*add.*/ nocase and $e.target.process.command_line = /.*CurrentVersion\\Control Panel\\CPLs.*/ nocase)) and (($e.target.process.file.full_path = /.*\\reg.exe$/ nocase) or ($e.target.process.file.name = "reg.exe"))) or (($e.target.process.command_line = /.*.cpl$/ nocase) and not(((($e.target.process.command_line = /.*regsvr32 .*/ nocase and $e.target.process.command_line = /.* /s .*/ nocase and $e.target.process.command_line = /.*igfxCPL.cpl.*/ nocase)) or (($e.target.process.command_line = /.*\\System32\\.*/ nocase or $e.target.process.command_line = /.*%System%.*/ nocase or $e.target.process.command_line = /.*|C:\\Windows\\system32|.*/ nocase))))))

  condition:
    $e
}
