// Tags: attack.stealth, attack.t1027.009
// Description: Detects TOKEN OBFUSCATION technique from Invoke-Obfuscation
// Converted by: Sigma Universal SIEM/EDR CLI

rule deb9b646_a508_44ee_b7c9_d8965921c6b6 {
  meta:
    title = "Powershell Token Obfuscation - Process Creation"
    description = "Detects TOKEN OBFUSCATION technique from Invoke-Obfuscation"
    author = "frack113"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /\w+`(?:\w+|-|.)`[\w+|\s]/ nocase) or ($e.target.process.command_line = /"(?:\{\d\})+"\s*-f/ nocase) or ($e.target.process.command_line = /(?i)\$\{`?e`?n`?v`?:`?p`?a`?t`?h`?\}/ nocase)) and not(($e.target.process.command_line = /.*${env:path}.*/ nocase)))

  condition:
    $e
}
