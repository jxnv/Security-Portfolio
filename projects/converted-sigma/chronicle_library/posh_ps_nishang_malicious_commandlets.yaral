criptBlockText = /.*Invoke-MimikatzWDigestDowngrade.*/ nocase or $e.ScriptBlockText = /.*Invoke-NetworkRelay.*/ nocase or $e.ScriptBlockText = /.*Invoke-PowerShellIcmp.*/ nocase or $e.ScriptBlockText = /.*Invoke-PowerShellUdp.*/ nocase or $e.ScriptBlockText = /.*Invoke-Prasadhak.*/ nocase or $e.ScriptBlockText = /.*Invoke-PSGcat.*/ nocase or $e.ScriptBlockText = /.*Invoke-PsGcatAgent.*/ nocase or $e.ScriptBlockText = /.*Invoke-SessionGopher.*/ nocase or $e.ScriptBlockText = /.*Invoke-SSIDExfil.*/ nocase or $e.ScriptBlockText = /.*LoggedKeys.*/ nocase or $e.ScriptBlockText = /.*Nishang.*/ nocase or $e.ScriptBlockText = /.*NotAllNameSpaces.*/ nocase or $e.ScriptBlockText = /.*Out-CHM.*/ nocase or $e.ScriptBlockText = /.*OUT-DNSTXT.*/ nocase or $e.ScriptBlockText = /.*Out-HTA.*/ nocase or $e.ScriptBlockText = /.*Out-RundllCommand.*/ nocase or $e.ScriptBlockText = /.*Out-SCF.*/ nocase or $e.ScriptBlockText = /.*Out-SCT.*/ nocase or $e.ScriptBlockText = /.*Out-Shortcut.*/ nocase or $e.ScriptBlockText = /.*Out-WebQuery.*/ nocase or $e.ScriptBlockText = /.*Out-Word.*/ nocase or $e.ScriptBlockText = /.*Parse_Keys.*/ nocase or $e.ScriptBlockText = /.*Password-List.*/ nocase or $e.ScriptBlockText = /.*Powerpreter.*/ nocase or $e.ScriptBlockText = /.*Remove-Persistence.*/ nocase or $e.ScriptBlockText = /.*Remove-PoshRat.*/ nocase or $e.ScriptBlockText = /.*Remove-Update.*/ nocase or $e.ScriptBlockText = /.*Run-EXEonRemote.*/ nocase or $e.ScriptBlockText = /.*Set-DCShadowPermissions.*/ nocase or $e.ScriptBlockText = /.*Set-RemotePSRemoting.*/ nocase or $e.ScriptBlockText = /.*Set-RemoteWMI.*/ nocase or $e.ScriptBlockText = /.*Shellcode32.*/ nocase or $e.ScriptBlockText = /.*Shellcode64.*/ nocase or $e.ScriptBlockText = /.*StringtoBase64.*/ nocase or $e.ScriptBlockText = /.*TexttoExe.*/ nocase))

