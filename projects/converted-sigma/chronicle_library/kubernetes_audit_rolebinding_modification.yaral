// Title: Kubernetes Rolebinding Modification
// ID: 10b97915-ec8d-455f-a815-9a78926585f6
// Status: test
// Level: medium
// Author: kelnage
// Date: 2024-07-11
// Tags: attack.privilege-escalation
// Description: Detects when a Kubernetes Rolebinding is created or modified.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 10b97915_ec8d_455f_a815_9a78926585f6 {
  meta:
    title = "Kubernetes Rolebinding Modification"
    description = "Detects when a Kubernetes Rolebinding is created or modified."
    author = "kelnage"
    severity = "MEDIUM"

  events:
    ($e.objectRef.apiGroup = "rbac.authorization.k8s.io" and ($e.objectRef.resource = "clusterrolebindings" or $e.objectRef.resource = "rolebindings") and ($e.verb = "create" or $e.verb = "delete" or $e.verb = "patch" or $e.verb = "replace" or $e.verb = "update"))

  condition:
    $e
}
