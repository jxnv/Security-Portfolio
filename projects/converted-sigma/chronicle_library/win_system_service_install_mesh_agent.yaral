// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-11-28
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects a Mesh Agent service installation. Mesh Agent is used to remotely manage computers
// Converted by: Sigma Universal SIEM/EDR CLI

rule e0d1ad53_c7eb_48ec_a87a_72393cc6cedc {
  meta:
    title = "Mesh Agent Service Installation"
    description = "Detects a Mesh Agent service installation. Mesh Agent is used to remotely manage computers"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.Provider_Name = "Service Control Manager" and $e.EventID = 7045) and (($e.ImagePath = /.*MeshAgent.exe.*/ nocase) or ($e.ServiceName = /.*Mesh Agent.*/ nocase)))

  condition:
    $e
}
