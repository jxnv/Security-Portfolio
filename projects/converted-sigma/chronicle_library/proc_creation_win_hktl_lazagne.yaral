// Title: HackTool - LaZagne Execution
// ID: c2b86e67-b880-4eec-b045-50bc98ef4844
// Status: experimental
// Level: medium
// Author: Nasreddine Bencherchali, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.credential-access
// Description: Detects the execution of the LaZagne. A utility used to retrieve multiple types of passwords stored on a local computer.
// LaZagne has been leveraged multiple times by threat actors in order to dump credentials.
// Converted by: Sigma Universal SIEM/EDR CLI

rule c2b86e67_b880_4eec_b045_50bc98ef4844 {
  meta:
    title = "HackTool - LaZagne Execution"
    description = "Detects the execution of the LaZagne. A utility used to retrieve multiple types of passwords stored on a local computer. LaZagne has been leveraged multiple times by threat actors in order to dump credentials."
    author = "Nasreddine Bencherchali, Swachchhanda Shrawan Poudel (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (((($e.target.process.file.full_path = /.*:\\PerfLogs\\.*/ nocase or $e.target.process.file.full_path = /.*:\\ProgramData\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Temp\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Tmp\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Users\\Public\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\Temp\\.*/ nocase or $e.target.process.file.full_path = /.*\\$Recycle.bin.*/ nocase or $e.target.process.file.full_path = /.*\\AppData\\.*/ nocase or $e.target.process.file.full_path = /.*\\Desktop\\.*/ nocase or $e.target.process.file.full_path = /.*\\Downloads\\.*/ nocase or $e.target.process.file.full_path = /.*\\Favorites\\.*/ nocase or $e.target.process.file.full_path = /.*\\Links\\.*/ nocase or $e.target.process.file.full_path = /.*\\Music\\.*/ nocase or $e.target.process.file.full_path = /.*\\Photos\\.*/ nocase or $e.target.process.file.full_path = /.*\\Pictures\\.*/ nocase or $e.target.process.file.full_path = /.*\\Saved Games\\.*/ nocase or $e.target.process.file.full_path = /.*\\Searches\\.*/ nocase or $e.target.process.file.full_path = /.*\\Users\\Contacts\\.*/ nocase or $e.target.process.file.full_path = /.*\\Users\\Default\\.*/ nocase or $e.target.process.file.full_path = /.*\\Users\\Searches\\.*/ nocase or $e.target.process.file.full_path = /.*\\Videos\\.*/ nocase or $e.target.process.file.full_path = /.*\\Windows\\addins\\.*/ nocase or $e.target.process.file.full_path = /.*\\Windows\\Fonts\\.*/ nocase or $e.target.process.file.full_path = /.*\\Windows\\IME\\.*/ nocase) and ($e.target.process.command_line = /.*.exe all$/ nocase or $e.target.process.command_line = /.*.exe browsers$/ nocase or $e.target.process.command_line = /.*.exe chats$/ nocase or $e.target.process.command_line = /.*.exe databases$/ nocase or $e.target.process.command_line = /.*.exe games$/ nocase or $e.target.process.command_line = /.*.exe git$/ nocase or $e.target.process.command_line = /.*.exe mails$/ nocase or $e.target.process.command_line = /.*.exe maven$/ nocase or $e.target.process.command_line = /.*.exe memory$/ nocase or $e.target.process.command_line = /.*.exe multimedia$/ nocase or $e.target.process.command_line = /.*.exe sysadmin$/ nocase or $e.target.process.command_line = /.*.exe unused$/ nocase or $e.target.process.command_line = /.*.exe wifi$/ nocase or $e.target.process.command_line = /.*.exe windows$/ nocase)) or ($e.target.process.file.full_path = /.*\\lazagne.exe$/ nocase)) or ((($e.target.process.command_line = /.* all .*/ nocase or $e.target.process.command_line = /.* browsers .*/ nocase or $e.target.process.command_line = /.* chats .*/ nocase or $e.target.process.command_line = /.* databases .*/ nocase or $e.target.process.command_line = /.* games .*/ nocase or $e.target.process.command_line = /.* mails .*/ nocase or $e.target.process.command_line = /.* maven .*/ nocase or $e.target.process.command_line = /.* memory .*/ nocase or $e.target.process.command_line = /.* multimedia .*/ nocase or $e.target.process.command_line = /.* php .*/ nocase or $e.target.process.command_line = /.* svn .*/ nocase or $e.target.process.command_line = /.* sysadmin .*/ nocase or $e.target.process.command_line = /.* unused .*/ nocase or $e.target.process.command_line = /.* wifi .*/ nocase)) and (($e.target.process.command_line = /.*-1Password.*/ nocase or $e.target.process.command_line = /.*-apachedirectorystudio.*/ nocase or $e.target.process.command_line = /.*-autologon.*/ nocase or $e.target.process.command_line = /.*-ChromiumBased.*/ nocase or $e.target.process.command_line = /.*-coreftp.*/ nocase or $e.target.process.command_line = /.*-credfiles.*/ nocase or $e.target.process.command_line = /.*-credman.*/ nocase or $e.target.process.command_line = /.*-cyberduck.*/ nocase or $e.target.process.command_line = /.*-dbvis.*/ nocase or $e.target.process.command_line = /.*-EyeCon.*/ nocase or $e.target.process.command_line = /.*-filezilla.*/ nocase or $e.target.process.command_line = /.*-filezillaserver.*/ nocase or $e.target.process.command_line = /.*-ftpnavigator.*/ nocase or $e.target.process.command_line = /.*-galconfusion.*/ nocase or $e.target.process.command_line = /.*-gitforwindows.*/ nocase or $e.target.process.command_line = /.*-hashdump.*/ nocase or $e.target.process.command_line = /.*-iisapppool.*/ nocase or $e.target.process.command_line = /.*-IISCentralCertP.*/ nocase or $e.target.process.command_line = /.*-kalypsomedia.*/ nocase or $e.target.process.command_line = /.*-keepass.*/ nocase or $e.target.process.command_line = /.*-keepassconfig.*/ nocase or $e.target.process.command_line = /.*-lsa_secrets.*/ nocase or $e.target.process.command_line = /.*-mavenrepositories.*/ nocase or $e.target.process.command_line = /.*-memory_dump.*/ nocase or $e.target.process.command_line = /.*-Mozilla.*/ nocase or $e.target.process.command_line = /.*-mRemoteNG.*/ nocase or $e.target.process.command_line = /.*-mscache.*/ nocase or $e.target.process.command_line = /.*-opensshforwindows.*/ nocase or $e.target.process.command_line = /.*-openvpn.*/ nocase or $e.target.process.command_line = /.*-outlook.*/ nocase or $e.target.process.command_line = /.*-pidgin.*/ nocase or $e.target.process.command_line = /.*-postgresql.*/ nocase or $e.target.process.command_line = /.*-psi-im.*/ nocase or $e.target.process.command_line = /.*-puttycm.*/ nocase or $e.target.process.command_line = /.*-pypykatz.*/ nocase or $e.target.process.command_line = /.*-Rclone.*/ nocase or $e.target.process.command_line = /.*-rdpmanager.*/ nocase or $e.target.process.command_line = /.*-robomongo.*/ nocase or $e.target.process.command_line = /.*-roguestale.*/ nocase or $e.target.process.command_line = /.*-skype.*/ nocase or $e.target.process.command_line = /.*-SQLDeveloper.*/ nocase or $e.target.process.command_line = /.*-squirrel.*/ nocase or $e.target.process.command_line = /.*-tortoise.*/ nocase or $e.target.process.command_line = /.*-turba.*/ nocase or $e.target.process.command_line = /.*-UCBrowser.*/ nocase or $e.target.process.command_line = /.*-unattended.*/ nocase or $e.target.process.command_line = /.*-vault.*/ nocase or $e.target.process.command_line = /.*-vaultfiles.*/ nocase or $e.target.process.command_line = /.*-vnc.*/ nocase or $e.target.process.command_line = /.*-winscp.*/ nocase))))

  condition:
