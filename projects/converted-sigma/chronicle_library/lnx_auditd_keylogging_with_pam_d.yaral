// Status: test
// Level: high
// Author: Pawel Mazur
// Date: 2021-05-24
// Tags: attack.collection, attack.credential-access, attack.t1003, attack.t1056.001
// Description: Detect attempt to enable auditing of TTY input
// Converted by: Sigma Universal SIEM/EDR CLI

rule 49aae26c_450e_448b_911d_b3c13d178dfc {
  meta:
    title = "Linux Keylogging with Pam.d"
    description = "Detect attempt to enable auditing of TTY input"
    author = "Pawel Mazur"
    severity = "HIGH"

  events:
    (($e.type = "PATH" and ($e.name = "/etc/pam.d/system-auth" or $e.name = "/etc/pam.d/password-auth")) or (($e.type = "TTY" or $e.type = "USER_TTY")))

  condition:
    $e
}
