// Title: ESXi Syslog Configuration Change Via ESXCLI
// ID: 38eb1dbb-011f-40b1-a126-cf03a0210563
// Status: test
// Level: medium
// Author: Cedric Maurugeon
// Date: 2023-09-04
// Tags: attack.execution, attack.defense-impairment, attack.t1685, attack.t1690, attack.t1059.012
// Description: Detects changes to the ESXi syslog configuration via "esxcli"
// Converted by: Sigma Universal SIEM/EDR CLI

rule 38eb1dbb_011f_40b1_a126_cf03a0210563 {
  meta:
    title = "ESXi Syslog Configuration Change Via ESXCLI"
    description = "Detects changes to the ESXi syslog configuration via "esxcli""
    author = "Cedric Maurugeon"
    severity = "MEDIUM"

  events:
    ($e.target.process.file.full_path = /.*/esxcli$/ nocase and ($e.target.process.command_line = /.*system.*/ nocase and $e.target.process.command_line = /.*syslog.*/ nocase and $e.target.process.command_line = /.*config.*/ nocase) and $e.target.process.command_line = /.* set.*/ nocase)

  condition:
    $e
}
