// Title: Suspicious Microsoft Office Child Process
// ID: 438025f9-5856-4663-83f7-52f878a70a50
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Markus Neis, FPT.EagleEye Team, Vadim Khrykov, Cyb3rEng, Michael Haag, Christopher Peacock @securepeacock, @scythe_io
// Date: 2018-04-06
// Tags: attack.execution, attack.stealth, attack.t1047, attack.t1204.002, attack.t1218.010
// Description: Detects a suspicious process spawning from one of the Microsoft Office suite products (Word, Excel, PowerPoint, Publisher, Visio, etc.)
// Converted by: Sigma Universal SIEM/EDR CLI

rule 438025f9_5856_4663_83f7_52f878a70a50 {
  meta:
    title = "Suspicious Microsoft Office Child Process"
    description = "Detects a suspicious process spawning from one of the Microsoft Office suite products (Word, Excel, PowerPoint, Publisher, Visio, etc.)"
    author = "Florian Roth (Nextron Systems), Markus Neis, FPT.EagleEye Team, Vadim Khrykov, Cyb3rEng, Michael Haag, Christopher Peacock @securepeacock, @scythe_io"
    severity = "HIGH"

  events:
    ((($e.principal.process.file.full_path = /.*\\EQNEDT32.EXE$/ nocase or $e.principal.process.file.full_path = /.*\\EXCEL.EXE$/ nocase or $e.principal.process.file.full_path = /.*\\MSACCESS.EXE$/ nocase or $e.principal.process.file.full_path = /.*\\MSPUB.exe$/ nocase or $e.principal.process.file.full_path = /.*\\ONENOTE.EXE$/ nocase or $e.principal.process.file.full_path = /.*\\POWERPNT.exe$/ nocase or $e.principal.process.file.full_path = /.*\\VISIO.exe$/ nocase or $e.principal.process.file.full_path = /.*\\WINWORD.EXE$/ nocase or $e.principal.process.file.full_path = /.*\\wordpad.exe$/ nocase or $e.principal.process.file.full_path = /.*\\wordview.exe$/ nocase)) and (((($e.target.process.file.name = "bitsadmin.exe" or $e.target.process.file.name = "CertOC.exe" or $e.target.process.file.name = "CertUtil.exe" or $e.target.process.file.name = "Cmd.Exe" or $e.target.process.file.name = "CMSTP.EXE" or $e.target.process.file.name = "cscript.exe" or $e.target.process.file.name = "curl.exe" or $e.target.process.file.name = "HH.exe" or $e.target.process.file.name = "IEExec.exe" or $e.target.process.file.name = "InstallUtil.exe" or $e.target.process.file.name = "javaw.exe" or $e.target.process.file.name = "Microsoft.Workflow.Compiler.exe" or $e.target.process.file.name = "msdt.exe" or $e.target.process.file.name = "MSHTA.EXE" or $e.target.process.file.name = "msiexec.exe" or $e.target.process.file.name = "Msxsl.exe" or $e.target.process.file.name = "odbcconf.exe" or $e.target.process.file.name = "pcalua.exe" or $e.target.process.file.name = "PowerShell.EXE" or $e.target.process.file.name = "RegAsm.exe" or $e.target.process.file.name = "RegSvcs.exe" or $e.target.process.file.name = "REGSVR32.exe" or $e.target.process.file.name = "RUNDLL32.exe" or $e.target.process.file.name = "schtasks.exe" or $e.target.process.file.name = "ScriptRunner.exe" or $e.target.process.file.name = "wmic.exe" or $e.target.process.file.name = "WorkFolders.exe" or $e.target.process.file.name = "wscript.exe")) or (($e.target.process.file.full_path = /.*\\AppVLP.exe$/ nocase or $e.target.process.file.full_path = /.*\\bash.exe$/ nocase or $e.target.process.file.full_path = /.*\\bitsadmin.exe$/ nocase or $e.target.process.file.full_path = /.*\\certoc.exe$/ nocase or $e.target.process.file.full_path = /.*\\certutil.exe$/ nocase or $e.target.process.file.full_path = /.*\\cmd.exe$/ nocase or $e.target.process.file.full_path = /.*\\cmstp.exe$/ nocase or $e.target.process.file.full_path = /.*\\control.exe$/ nocase or $e.target.process.file.full_path = /.*\\cscript.exe$/ nocase or $e.target.process.file.full_path = /.*\\curl.exe$/ nocase or $e.target.process.file.full_path = /.*\\forfiles.exe$/ nocase or $e.target.process.file.full_path = /.*\\hh.exe$/ nocase or $e.target.process.file.full_path = /.*\\ieexec.exe$/ nocase or $e.target.process.file.full_path = /.*\\installutil.exe$/ nocase or $e.target.process.file.full_path = /.*\\javaw.exe$/ nocase or $e.target.process.file.full_path = /.*\\mftrace.exe$/ nocase or $e.target.process.file.full_path = /.*\\Microsoft.Workflow.Compiler.exe$/ nocase or $e.target.process.file.full_path = /.*\\msbuild.exe$/ nocase or $e.target.process.file.full_path = /.*\\msdt.exe$/ nocase or $e.target.process.file.full_path = /.*\\mshta.exe$/ nocase or $e.target.process.file.full_path = /.*\\msidb.exe$/ nocase or $e.target.process.file.full_path = /.*\\msiexec.exe$/ nocase or $e.target.process.file.full_path = /.*\\msxsl.exe$/ nocase or $e.target.process.file.full_path = /.*\\odbcconf.exe$/ nocase or $e.target.process.file.full_path = /.*\\pcalua.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase or $e.target.process.file.full_path = /.*\\regasm.exe$/ nocase or $e.target.process.file.full_path = /.*\\regsvcs.exe$/ nocase or $e.target.process.file.full_path = /.*\\regsvr32.exe$/ nocase or $e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase or $e.target.process.file.full_path = /.*\\schtasks.exe$/ nocase or $e.target.process.file.full_path = /.*\\scrcons.exe$/ nocase or $e.target.process.file.full_path = /.*\\scriptrunner.exe$/ nocase or $e.target.process.file.full_path = /.*\\sh.exe$/ nocase or $e.target.process.file.full_path = /.*\\svchost.exe$/ nocase or $e.target.process.file.full_path = /.*\\verclsid.exe$/ nocase or $e.target.process.file.full_path = /.*\\wmic.exe$/ nocase or $e.target.process.file.full_path = /.*\\workfolders.exe$/ nocase or $e.target.process.file.full_path = /.*\\wscript.exe$/ nocase))) or (($e.target.process.file.full_path = /.*\\AppData\\.*/ nocase or $e.target.process.file.full_path = /.*\\Users\\Public\\.*/ nocase or $e.target.process.file.full_path = /.*\\ProgramData\\.*/ nocase or $e.target.process.file.full_path = /.*\\Windows\\Tasks\\.*/ nocase or $e.target.process.file.full_path = /.*\\Windows\\Temp\\.*/ nocase or $e.target.process.file.full_path = /.*\\Windows\\System32\\Tasks\\.*/ nocase))))

  condition:
    $e
}
