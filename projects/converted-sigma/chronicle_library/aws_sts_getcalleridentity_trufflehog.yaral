// Title: AWS STS GetCallerIdentity Enumeration Via TruffleHog
// ID: 9b1b8e9b-0a5d-4af1-9d2f-4c4b6e7c2c9d
// Status: experimental
// Level: medium
// Author: Adan Alvarez @adanalvarez
// Date: 2025-10-12
// Tags: attack.discovery, attack.t1087.004
// Description: Detects the use of TruffleHog for AWS credential validation by identifying GetCallerIdentity API calls where the userAgent indicates TruffleHog.
// Threat actors leverage TruffleHog to enumerate and validate exposed AWS keys.
// Successful exploitation allows threat actors to confirm the validity of compromised AWS credentials, facilitating further unauthorized access and actions within the AWS environment.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 9b1b8e9b_0a5d_4af1_9d2f_4c4b6e7c2c9d {
  meta:
    title = "AWS STS GetCallerIdentity Enumeration Via TruffleHog"
    description = "Detects the use of TruffleHog for AWS credential validation by identifying GetCallerIdentity API calls where the userAgent indicates TruffleHog. Threat actors leverage TruffleHog to enumerate and validate exposed AWS keys. Successful exploitation allows threat actors to confirm the validity of compromised AWS credentials, facilitating further unauthorized access and actions within the AWS environment."
    author = "Adan Alvarez @adanalvarez"
    severity = "MEDIUM"

  events:
    ($e.eventSource = "sts.amazonaws.com" and $e.eventName = "GetCallerIdentity" and $e.userAgent = /.*TruffleHog.*/ nocase)

  condition:
    $e
}
