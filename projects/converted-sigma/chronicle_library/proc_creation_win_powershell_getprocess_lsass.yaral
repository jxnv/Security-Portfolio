// Title: PowerShell Get-Process LSASS
// ID: b2815d0d-7481-4bf0-9b6c-a4c48a94b349
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-04-23
// Tags: attack.credential-access, attack.t1552.004
// Description: Detects a "Get-Process" cmdlet and it's aliases on lsass process, which is in almost all cases a sign of malicious activity
// Converted by: Sigma Universal SIEM/EDR CLI

rule b2815d0d_7481_4bf0_9b6c_a4c48a94b349 {
  meta:
    title = "PowerShell Get-Process LSASS"
    description = "Detects a "Get-Process" cmdlet and it's aliases on lsass process, which is in almost all cases a sign of malicious activity"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.command_line = /.*Get-Process lsas.*/ nocase or $e.target.process.command_line = /.*ps lsas.*/ nocase or $e.target.process.command_line = /.*gps lsas.*/ nocase))

  condition:
    $e
}
