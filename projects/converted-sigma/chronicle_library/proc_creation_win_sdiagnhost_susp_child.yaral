// Title: Sdiagnhost Calling Suspicious Child Process
// ID: f3d39c45-de1a-4486-a687-ab126124f744
// Status: test
// Level: high
// Author: Nextron Systems, @Kostastsale
// Date: 2022-06-01
// Tags: attack.stealth, attack.t1036, attack.t1218
// Description: Detects sdiagnhost.exe calling a suspicious child process (e.g. used in exploits for Follina / CVE-2022-30190)
// Converted by: Sigma Universal SIEM/EDR CLI

rule f3d39c45_de1a_4486_a687_ab126124f744 {
  meta:
    title = "Sdiagnhost Calling Suspicious Child Process"
    description = "Detects sdiagnhost.exe calling a suspicious child process (e.g. used in exploits for Follina / CVE-2022-30190)"
    author = "Nextron Systems, @Kostastsale"
    severity = "HIGH"

  events:
    (($e.principal.process.file.full_path = /.*\\sdiagnhost.exe$/ nocase and ($e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase or $e.target.process.file.full_path = /.*\\cmd.exe$/ nocase or $e.target.process.file.full_path = /.*\\mshta.exe$/ nocase or $e.target.process.file.full_path = /.*\\cscript.exe$/ nocase or $e.target.process.file.full_path = /.*\\wscript.exe$/ nocase or $e.target.process.file.full_path = /.*\\taskkill.exe$/ nocase or $e.target.process.file.full_path = /.*\\regsvr32.exe$/ nocase or $e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase or $e.target.process.file.full_path = /.*\\calc.exe$/ nocase)) and not((($e.target.process.file.full_path = /.*\\cmd.exe$/ nocase and $e.target.process.command_line = /.*bits.*/ nocase) or ($e.target.process.file.full_path = /.*\\powershell.exe$/ nocase and ($e.target.process.command_line = /.*-noprofile -$/ nocase or $e.target.process.command_line = /.*-noprofile$/ nocase)))))

  condition:
    $e
}
