// Title: New Kernel Driver Via SC.EXE
// ID: 431a1fdb-4799-4f3b-91c3-a683b003fc49
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-14
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects creation of a new service (kernel driver) with the type "kernel"
// Converted by: Sigma Universal SIEM/EDR CLI

rule 431a1fdb_4799_4f3b_91c3_a683b003fc49 {
  meta:
    title = "New Kernel Driver Via SC.EXE"
    description = "Detects creation of a new service (kernel driver) with the type "kernel""
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.target.process.file.full_path = /.*\\sc.exe$/ nocase and ($e.target.process.command_line = /.*create.*/ nocase or $e.target.process.command_line = /.*config.*/ nocase) and ($e.target.process.command_line = /.*binPath.*/ nocase and $e.target.process.command_line = /.*type.*/ nocase and $e.target.process.command_line = /.*kernel.*/ nocase)) and not(((($e.target.process.command_line = /.*create netprotection_network_filter.*/ nocase and $e.target.process.command_line = /.*type= kernel start= .*/ nocase and $e.target.process.command_line = /.*binPath= System32\\drivers\\netprotection_network_filter.*/ nocase and $e.target.process.command_line = /.*DisplayName= netprotection_network_filter.*/ nocase and $e.target.process.command_line = /.*group= PNP_TDI tag= yes.*/ nocase)) or (($e.target.process.command_line = /.*create avelam binpath=C:\\Windows\\system32\\drivers\\avelam.sys.*/ nocase and $e.target.process.command_line = /.*type=kernel start=boot error=critical group=Early-Launch.*/ nocase)))))

  condition:
    $e
}
