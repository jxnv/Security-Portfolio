// Title: Windows Credential Guard Related Registry Value Deleted - Registry
// ID: d645ef86-2396-48a1-a2b6-b629ca3f57ff
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-12-26
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects attempts to disable Windows Credential Guard by deleting registry values. Credential Guard uses virtualization-based security to isolate secrets so that only privileged system software can access them.
// Adversaries may disable Credential Guard to gain access to sensitive credentials stored in the system, such as NTLM hashes and Kerberos tickets, which can be used for lateral movement and privilege escalation.
// Converted by: Sigma Universal SIEM/EDR CLI

rule d645ef86_2396_48a1_a2b6_b629ca3f57ff {
  meta:
    title = "Windows Credential Guard Related Registry Value Deleted - Registry"
    description = "Detects attempts to disable Windows Credential Guard by deleting registry values. Credential Guard uses virtualization-based security to isolate secrets so that only privileged system software can access them. Adversaries may disable Credential Guard to gain access to sensitive credentials stored in the system, such as NTLM hashes and Kerberos tickets, which can be used for lateral movement and privilege escalation."
    author = "Swachchhanda Shrawan Poudel (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.TargetObject = /.*\\DeviceGuard\\EnableVirtualizationBasedSecurity$/ nocase or $e.TargetObject = /.*\\DeviceGuard\\LsaCfgFlags$/ nocase or $e.TargetObject = /.*\\DeviceGuard\\RequirePlatformSecurityFeatures$/ nocase or $e.TargetObject = /.*\\Lsa\\LsaCfgFlags$/ nocase))

  condition:
    $e
}
