// Title: Linux Shell Pipe to Shell
// ID: 880973f3-9708-491c-a77b-2a35a1921158
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-14
// Tags: attack.stealth, attack.t1140
// Description: Detects suspicious process command line that starts with a shell that executes something and finally gets piped into another shell
// Converted by: Sigma Universal SIEM/EDR CLI

rule 880973f3_9708_491c_a77b_2a35a1921158 {
  meta:
    title = "Linux Shell Pipe to Shell"
    description = "Detects suspicious process command line that starts with a shell that executes something and finally gets piped into another shell"
    author = "Florian Roth (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /^sh -c .*/ nocase or $e.target.process.command_line = /^bash -c .*/ nocase)) and ((($e.target.process.command_line = /.*| bash .*/ nocase or $e.target.process.command_line = /.*| sh .*/ nocase or $e.target.process.command_line = /.*|bash .*/ nocase or $e.target.process.command_line = /.*|sh .*/ nocase)) or (($e.target.process.command_line = /.*| bash$/ nocase or $e.target.process.command_line = /.*| sh$/ nocase or $e.target.process.command_line = /.*|bash$/ nocase or $e.target.process.command_line = /.* |sh$/ nocase))))

  condition:
    $e
}
