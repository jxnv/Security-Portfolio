// Title: Potentially Suspicious Child Process Of VsCode
// ID: 5a3164f2-b373-4152-93cf-090b13c12d27
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-26
// Tags: attack.execution, attack.stealth, attack.t1218, attack.t1202
// Description: Detects uncommon or suspicious child processes spawning from a VsCode "code.exe" process. This could indicate an attempt of persistence via VsCode tasks or terminal profiles.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 5a3164f2_b373_4152_93cf_090b13c12d27 {
  meta:
    title = "Potentially Suspicious Child Process Of VsCode"
    description = "Detects uncommon or suspicious child processes spawning from a VsCode "code.exe" process. This could indicate an attempt of persistence via VsCode tasks or terminal profiles."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.principal.process.file.full_path = /.*\\code.exe$/ nocase) and ((($e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase or $e.target.process.file.full_path = /.*\\cmd.exe$/ nocase) and ($e.target.process.command_line = /.*Invoke-Expressions.*/ nocase or $e.target.process.command_line = /.*IEX.*/ nocase or $e.target.process.command_line = /.*Invoke-Command.*/ nocase or $e.target.process.command_line = /.*ICM.*/ nocase or $e.target.process.command_line = /.*DownloadString.*/ nocase or $e.target.process.command_line = /.*rundll32.*/ nocase or $e.target.process.command_line = /.*regsvr32.*/ nocase or $e.target.process.command_line = /.*wscript.*/ nocase or $e.target.process.command_line = /.*cscript.*/ nocase)) or (($e.target.process.file.full_path = /.*\\calc.exe$/ nocase or $e.target.process.file.full_path = /.*\\regsvr32.exe$/ nocase or $e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase or $e.target.process.file.full_path = /.*\\cscript.exe$/ nocase or $e.target.process.file.full_path = /.*\\wscript.exe$/ nocase)) or (($e.target.process.file.full_path = /.*:\\Users\\Public\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\Temp\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Temp\\.*/ nocase))))

  condition:
    $e
}
