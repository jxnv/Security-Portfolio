rule 4db60cc0_36fb_42b7_9b58_a5b53019fb74 {
  meta:
    title = "AWS CloudTrail Important Change"
    description = "Detects disabling, deleting and updating of a Trail"
    author = "vitaliy0x1"
    severity = "MEDIUM"

  events:
    ($e.eventSource = "cloudtrail.amazonaws.com" and ($e.eventName = "StopLogging" or $e.eventName = "UpdateTrail" or $e.eventName = "DeleteTrail"))

  condition:
    $e
}
