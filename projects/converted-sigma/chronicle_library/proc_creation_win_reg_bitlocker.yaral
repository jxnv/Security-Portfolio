// Title: Suspicious Reg Add BitLocker
// ID: 0e0255bf-2548-47b8-9582-c0955c9283f5
// Status: test
// Level: high
// Author: frack113
// Date: 2021-11-15
// Tags: attack.impact, attack.t1486
// Description: Detects suspicious addition to BitLocker related registry keys via the reg.exe utility
// Converted by: Sigma Universal SIEM/EDR CLI

rule 0e0255bf_2548_47b8_9582_c0955c9283f5 {
  meta:
    title = "Suspicious Reg Add BitLocker"
    description = "Detects suspicious addition to BitLocker related registry keys via the reg.exe utility"
    author = "frack113"
    severity = "HIGH"

  events:
    (($e.target.process.command_line = /.*REG.*/ nocase and $e.target.process.command_line = /.*ADD.*/ nocase and $e.target.process.command_line = /.*\\SOFTWARE\\Policies\\Microsoft\\FVE.*/ nocase and $e.target.process.command_line = /.*/v.*/ nocase and $e.target.process.command_line = /.*/f.*/ nocase) and ($e.target.process.command_line = /.*EnableBDEWithNoTPM.*/ nocase or $e.target.process.command_line = /.*UseAdvancedStartup.*/ nocase or $e.target.process.command_line = /.*UseTPM.*/ nocase or $e.target.process.command_line = /.*UseTPMKey.*/ nocase or $e.target.process.command_line = /.*UseTPMKeyPIN.*/ nocase or $e.target.process.command_line = /.*RecoveryKeyMessageSource.*/ nocase or $e.target.process.command_line = /.*UseTPMPIN.*/ nocase or $e.target.process.command_line = /.*RecoveryKeyMessage.*/ nocase))

  condition:
    $e
}
