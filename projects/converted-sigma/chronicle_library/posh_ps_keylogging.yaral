// Title: Powershell Keylogging
// ID: 34f90d3c-c297-49e9-b26d-911b05a4866c
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-07-30
// Tags: attack.credential-access, attack.collection, attack.t1056.001
// Description: Adversaries may log user keystrokes to intercept credentials as the user types them.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 34f90d3c_c297_49e9_b26d_911b05a4866c {
  meta:
    title = "Powershell Keylogging"
    description = "Adversaries may log user keystrokes to intercept credentials as the user types them."
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.ScriptBlockText = /.*Get-Keystrokes.*/ nocase) or (($e.ScriptBlockText = /.*Get-ProcAddress user32.dll GetAsyncKeyState.*/ nocase and $e.ScriptBlockText = /.*Get-ProcAddress user32.dll GetForegroundWindow.*/ nocase)))

  condition:
    $e
}
