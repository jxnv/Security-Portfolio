// Title: PowerShell Download Pattern
// ID: 3b6ab547-8ec2-4991-b9d2-2b06702a48d7
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), oscd.community, Jonhnathan Ribeiro
// Date: 2019-01-16
// Tags: attack.execution, attack.t1059.001
// Description: Detects a Powershell process that contains download commands in its command line string
// Converted by: Sigma Universal SIEM/EDR CLI

rule 3b6ab547_8ec2_4991_b9d2_2b06702a48d7 {
  meta:
    title = "PowerShell Download Pattern"
    description = "Detects a Powershell process that contains download commands in its command line string"
    author = "Florian Roth (Nextron Systems), oscd.community, Jonhnathan Ribeiro"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*new-object.*/ nocase and $e.target.process.command_line = /.*net.webclient)..*/ nocase and $e.target.process.command_line = /.*download.*/ nocase) and ($e.target.process.command_line = /.*string(.*/ nocase or $e.target.process.command_line = /.*file(.*/ nocase)) and ((($e.target.process.file.full_path = /.*\\powershell_ise.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase)) or (($e.target.process.file.name = "PowerShell_ISE.EXE" or $e.target.process.file.name = "PowerShell.EXE" or $e.target.process.file.name = "pwsh.dll"))))

  condition:
    $e
}
