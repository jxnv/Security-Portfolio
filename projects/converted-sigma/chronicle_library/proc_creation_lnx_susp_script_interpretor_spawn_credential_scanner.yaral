// Title: Script Interpreter Spawning Credential Scanner - Linux
// ID: f0025a69-e1b7-4dda-a53c-db21fa2d4071
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-11-25
// Tags: attack.credential-access, attack.t1552, attack.execution, attack.collection, attack.t1005, attack.t1059.004
// Description: Detects a script interpreter process (like node.js or bun) spawning a known credential scanning tool (e.g., trufflehog, gitleaks).
// This behavior is indicative of an attempt to find and steal secrets, as seen in the "Shai-Hulud: The Second Coming" campaign.
// Converted by: Sigma Universal SIEM/EDR CLI

rule f0025a69_e1b7_4dda_a53c_db21fa2d4071 {
  meta:
    title = "Script Interpreter Spawning Credential Scanner - Linux"
    description = "Detects a script interpreter process (like node.js or bun) spawning a known credential scanning tool (e.g., trufflehog, gitleaks). This behavior is indicative of an attempt to find and steal secrets, as seen in the "Shai-Hulud: The Second Coming" campaign."
    author = "Swachchhanda Shrawan Poudel (Nextron Systems)"
    severity = "HIGH"

  events:
    (((($e.target.process.file.full_path = /.*/trufflehog$/ nocase or $e.target.process.file.full_path = /.*/gitleaks$/ nocase)) or (($e.target.process.command_line = /.*trufflehog.*/ nocase or $e.target.process.command_line = /.*gitleaks.*/ nocase))) and (($e.principal.process.file.full_path = /.*/node$/ nocase or $e.principal.process.file.full_path = /.*/bun$/ nocase)))

  condition:
    $e
}
