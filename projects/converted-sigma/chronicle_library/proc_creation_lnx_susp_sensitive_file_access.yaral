// Title: Potential Suspicious Change To Sensitive/Critical Files
// ID: 86157017-c2b1-4d4a-8c33-93b8e67e4af4
// Status: test
// Level: medium
// Author: @d4ns4n_ (Wuerth-Phoenix)
// Date: 2023-05-30
// Tags: attack.impact, attack.t1565.001
// Description: Detects changes of sensitive and critical files. Monitors files that you don't expect to change without planning on Linux system.
// These files include, but are not limited to, system configuration files, authentication files, and critical application files.
// Attackers often target these files to maintain persistence, escalate privileges, or disrupt system operations.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 86157017_c2b1_4d4a_8c33_93b8e67e4af4 {
  meta:
    title = "Potential Suspicious Change To Sensitive/Critical Files"
    description = "Detects changes of sensitive and critical files. Monitors files that you don't expect to change without planning on Linux system. These files include, but are not limited to, system configuration files, authentication files, and critical application files. Attackers often target these files to maintain persistence, escalate privileges, or disrupt system operations."
    author = "@d4ns4n_ (Wuerth-Phoenix)"
    severity = "MEDIUM"

  events:
    (((($e.target.process.file.full_path = /.*/cat$/ nocase or $e.target.process.file.full_path = /.*/echo$/ nocase or $e.target.process.file.full_path = /.*/grep$/ nocase or $e.target.process.file.full_path = /.*/head$/ nocase or $e.target.process.file.full_path = /.*/more$/ nocase or $e.target.process.file.full_path = /.*/tail$/ nocase) and $e.target.process.command_line = /.*>.*/ nocase) or (($e.target.process.file.full_path = /.*/emacs$/ nocase or $e.target.process.file.full_path = /.*/nano$/ nocase or $e.target.process.file.full_path = /.*/sed$/ nocase or $e.target.process.file.full_path = /.*/vi$/ nocase or $e.target.process.file.full_path = /.*/vim$/ nocase))) and (($e.target.process.command_line = /.*/bin/login.*/ nocase or $e.target.process.command_line = /.*/bin/passwd.*/ nocase or $e.target.process.command_line = /.*/boot/.*/ nocase or $e.target.process.command_line = /.*/etc/*.conf.*/ nocase or $e.target.process.command_line = /.*/etc/cron..*/ nocase or $e.target.process.command_line = /.*/etc/crontab.*/ nocase or $e.target.process.command_line = /.*/etc/hosts.*/ nocase or $e.target.process.command_line = /.*/etc/init.d.*/ nocase or $e.target.process.command_line = /.*/etc/sudoers.*/ nocase or $e.target.process.command_line = /.*/opt/bin/.*/ nocase or $e.target.process.command_line = /.*/sbin.*/ nocase or $e.target.process.command_line = /.*/usr/bin/.*/ nocase or $e.target.process.command_line = /.*/usr/local/bin/.*/ nocase)) and not(1=1))

  condition:
    $e
}
