// Title: Application Termination Attempt via Wmic.EXE
// ID: 49d9671b-0a0a-4c09-8280-d215bfd30662
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-09-11
// Tags: attack.execution, attack.t1047
// Description: Detects an attempt to terminate a process via "wmic" with the "call terminate" flag. Adversaries may
// use wmic to terminate security products or other applications on the compromised host. This event is
// triggered on on attempt and process creation can be either successful or unsuccessful.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 49d9671b_0a0a_4c09_8280_d215bfd30662 {
  meta:
    title = "Application Termination Attempt via Wmic.EXE"
    description = "Detects an attempt to terminate a process via "wmic" with the "call terminate" flag. Adversaries may use wmic to terminate security products or other applications on the compromised host. This event is triggered on on attempt and process creation can be either successful or unsuccessful."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*call.*/ nocase and $e.target.process.command_line = /.*terminate.*/ nocase)) and (($e.target.process.file.full_path = /.*\\WMIC.exe$/ nocase) or ($e.target.process.file.name = "wmic.exe")))

  condition:
    $e
}
