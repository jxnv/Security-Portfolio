// Title: Scheduled Task Creation Masquerading as System Processes
// ID: 9f8573c9-22b4-40e3-89c1-72bc2b8d49ab
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-02-05
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.stealth, attack.t1053.005, attack.t1036.004, attack.t1036.005
// Description: Detects the creation of scheduled tasks that involve system processes, which may indicate malicious actors masquerading as or abusing these processes to execute payloads or maintain persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 9f8573c9_22b4_40e3_89c1_72bc2b8d49ab {
  meta:
    title = "Scheduled Task Creation Masquerading as System Processes"
    description = "Detects the creation of scheduled tasks that involve system processes, which may indicate malicious actors masquerading as or abusing these processes to execute payloads or maintain persistence."
    author = "Swachchhanda Shrawan Poudel (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.command_line = /.* /create .*/ nocase and ($e.target.process.command_line = /.* audiodg.*/ nocase or $e.target.process.command_line = /.* conhost.*/ nocase or $e.target.process.command_line = /.* dwm.exe.*/ nocase or $e.target.process.command_line = /.* explorer.*/ nocase or $e.target.process.command_line = /.* lsass.*/ nocase or $e.target.process.command_line = /.* lsm.*/ nocase or $e.target.process.command_line = /.* mmc.*/ nocase or $e.target.process.command_line = /.* msiexec.*/ nocase or $e.target.process.command_line = /.* regsvr32.*/ nocase or $e.target.process.command_line = /.* rundll32.*/ nocase or $e.target.process.command_line = /.* services.*/ nocase or $e.target.process.command_line = /.* spoolsv.*/ nocase or $e.target.process.command_line = /.* svchost.*/ nocase or $e.target.process.command_line = /.* taskeng.*/ nocase or $e.target.process.command_line = /.* taskhost.*/ nocase or $e.target.process.command_line = /.* wininit.*/ nocase or $e.target.process.command_line = /.* winlogon.*/ nocase)) and (($e.target.process.file.full_path = /.*\\schtasks.exe$/ nocase) or ($e.target.process.file.name = "schtasks.exe")))

  condition:
    $e
}
