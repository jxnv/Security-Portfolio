// Title: Suspicious Uninstall of Windows Defender Feature via PowerShell
// ID: c443012c-7928-43bf-ac20-7eda5efe61ad
// Status: experimental
// Level: high
// Author: yxinmiracle
// Date: 2025-08-22
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects the use of PowerShell with Uninstall-WindowsFeature or Remove-WindowsFeature cmdlets to disable or remove the Windows Defender GUI feature, a common technique used by adversaries to evade defenses.
// Converted by: Sigma Universal SIEM/EDR CLI

rule c443012c_7928_43bf_ac20_7eda5efe61ad {
  meta:
    title = "Suspicious Uninstall of Windows Defender Feature via PowerShell"
    description = "Detects the use of PowerShell with Uninstall-WindowsFeature or Remove-WindowsFeature cmdlets to disable or remove the Windows Defender GUI feature, a common technique used by adversaries to evade defenses."
    author = "yxinmiracle"
    severity = "HIGH"

  events:
    (($e.target.process.command_line = /.*Windows-Defender.*/ nocase) and (($e.target.process.command_line = /.*Uninstall-WindowsFeature.*/ nocase or $e.target.process.command_line = /.*Remove-WindowsFeature.*/ nocase)) and ((($e.target.process.file.full_path = /.*\\powershell_ise.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase)) or (($e.target.process.file.name = "PowerShell_ISE.EXE" or $e.target.process.file.name = "PowerShell.EXE" or $e.target.process.file.name = "pwsh.dll"))))

  condition:
    $e
}
