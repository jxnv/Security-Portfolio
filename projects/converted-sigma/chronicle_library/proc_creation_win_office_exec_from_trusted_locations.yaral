// Title: Potentially Suspicious Office Document Executed From Trusted Location
// ID: f99abdf0-6283-4e71-bd2b-b5c048a94743
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-21
// Tags: attack.stealth, attack.t1202
// Description: Detects the execution of an Office application that points to a document that is located in a trusted location. Attackers often used this to avoid macro security and execute their malicious code.
// Converted by: Sigma Universal SIEM/EDR CLI

rule f99abdf0_6283_4e71_bd2b_b5c048a94743 {
  meta:
    title = "Potentially Suspicious Office Document Executed From Trusted Location"
    description = "Detects the execution of an Office application that points to a document that is located in a trusted location. Attackers often used this to avoid macro security and execute their malicious code."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ((((($e.target.process.file.full_path = /.*\\EXCEL.EXE$/ nocase or $e.target.process.file.full_path = /.*\\POWERPNT.EXE$/ nocase or $e.target.process.file.full_path = /.*\\WINWORD.exe$/ nocase)) or (($e.target.process.file.name = "Excel.exe" or $e.target.process.file.name = "POWERPNT.EXE" or $e.target.process.file.name = "WinWord.exe"))) and (($e.principal.process.file.full_path = /.*\\explorer.exe$/ nocase or $e.principal.process.file.full_path = /.*\\dopus.exe$/ nocase)) and (($e.target.process.command_line = /.*\\AppData\\Roaming\\Microsoft\\Templates.*/ nocase or $e.target.process.command_line = /.*\\AppData\\Roaming\\Microsoft\\Word\\Startup\\.*/ nocase or $e.target.process.command_line = /.*\\Microsoft Office\\root\\Templates\\.*/ nocase or $e.target.process.command_line = /.*\\Microsoft Office\\Templates\\.*/ nocase))) and not((($e.target.process.command_line = /.*.dotx$/ nocase or $e.target.process.command_line = /.*.xltx$/ nocase or $e.target.process.command_line = /.*.potx$/ nocase))))

  condition:
    $e
}
