// Title: Data Export From MSSQL Table Via BCP.EXE
// ID: c615d676-f655-46b9-b913-78729021e5d7
// Status: test
// Level: medium
// Author: Omar Khaled (@beacon_exe), MahirAli Khan (in/mahiralikhan), Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-08-20
// Tags: attack.execution, attack.exfiltration, attack.t1048
// Description: Detects the execution of the BCP utility in order to export data from the database.
// Attackers were seen saving their malware to a database column or table and then later extracting it via "bcp.exe" into a file.
// Converted by: Sigma Universal SIEM/EDR CLI

rule c615d676_f655_46b9_b913_78729021e5d7 {
  meta:
    title = "Data Export From MSSQL Table Via BCP.EXE"
    description = "Detects the execution of the BCP utility in order to export data from the database. Attackers were seen saving their malware to a database column or table and then later extracting it via "bcp.exe" into a file."
    author = "Omar Khaled (@beacon_exe), MahirAli Khan (in/mahiralikhan), Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.* out .*/ nocase or $e.target.process.command_line = /.* queryout .*/ nocase)) and (($e.target.process.file.full_path = /.*\\bcp.exe$/ nocase) or ($e.target.process.file.name = "BCP.exe")))

  condition:
    $e
}
