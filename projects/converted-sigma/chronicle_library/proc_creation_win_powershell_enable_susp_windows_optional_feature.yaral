// Title: Potential Suspicious Windows Feature Enabled - ProcCreation
// ID: c740d4cf-a1e9-41de-bb16-8a46a4f57918
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-29
// Tags: attack.stealth
// Description: Detects usage of the built-in PowerShell cmdlet "Enable-WindowsOptionalFeature" used as a Deployment Image Servicing and Management tool.
// Similar to DISM.exe, this cmdlet is used to enumerate, install, uninstall, configure, and update features and packages in Windows images
// Converted by: Sigma Universal SIEM/EDR CLI

rule c740d4cf_a1e9_41de_bb16_8a46a4f57918 {
  meta:
    title = "Potential Suspicious Windows Feature Enabled - ProcCreation"
    description = "Detects usage of the built-in PowerShell cmdlet "Enable-WindowsOptionalFeature" used as a Deployment Image Servicing and Management tool. Similar to DISM.exe, this cmdlet is used to enumerate, install, uninstall, configure, and update features and packages in Windows images"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*Enable-WindowsOptionalFeature.*/ nocase and $e.target.process.command_line = /.*-Online.*/ nocase and $e.target.process.command_line = /.*-FeatureName.*/ nocase)) and (($e.target.process.command_line = /.*TelnetServer.*/ nocase or $e.target.process.command_line = /.*Internet-Explorer-Optional-amd64.*/ nocase or $e.target.process.command_line = /.*TFTP.*/ nocase or $e.target.process.command_line = /.*SMB1Protocol.*/ nocase or $e.target.process.command_line = /.*Client-ProjFS.*/ nocase or $e.target.process.command_line = /.*Microsoft-Windows-Subsystem-Linux.*/ nocase)))

  condition:
    $e
}
