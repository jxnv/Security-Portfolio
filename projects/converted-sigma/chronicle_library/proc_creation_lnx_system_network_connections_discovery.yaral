// Title: System Network Connections Discovery - Linux
// ID: 4c519226-f0cd-4471-bd2f-6fbb2bb68a79
// Status: test
// Level: low
// Author: Daniil Yugoslavskiy, oscd.community
// Date: 2020-10-19
// Tags: attack.discovery, attack.t1049
// Description: Detects usage of system utilities to discover system network connections
// Converted by: Sigma Universal SIEM/EDR CLI

rule 4c519226_f0cd_4471_bd2f_6fbb2bb68a79 {
  meta:
    title = "System Network Connections Discovery - Linux"
    description = "Detects usage of system utilities to discover system network connections"
    author = "Daniil Yugoslavskiy, oscd.community"
    severity = "LOW"

  events:
    ((($e.target.process.file.full_path = /.*/who$/ nocase or $e.target.process.file.full_path = /.*/w$/ nocase or $e.target.process.file.full_path = /.*/last$/ nocase or $e.target.process.file.full_path = /.*/lsof$/ nocase or $e.target.process.file.full_path = /.*/netstat$/ nocase)) and not(($e.principal.process.command_line = /.*/usr/bin/landscape-sysinfo.*/ nocase and $e.target.process.file.full_path = /.*/who$/ nocase)))

  condition:
    $e
}
