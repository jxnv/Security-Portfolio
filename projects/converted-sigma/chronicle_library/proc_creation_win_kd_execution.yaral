// Title: Windows Kernel Debugger Execution
// ID: 27ee9438-90dc-4bef-904b-d3ef927f5e7e
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-15
// Tags: attack.privilege-escalation, attack.stealth
// Description: Detects execution of the Windows Kernel Debugger "kd.exe".
// Converted by: Sigma Universal SIEM/EDR CLI

rule 27ee9438_90dc_4bef_904b_d3ef927f5e7e {
  meta:
    title = "Windows Kernel Debugger Execution"
    description = "Detects execution of the Windows Kernel Debugger "kd.exe"."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.target.process.file.full_path = /.*\\kd.exe$/ nocase) or ($e.target.process.file.name = "kd.exe"))

  condition:
    $e
}
