// Title: Potential Initial Access via DLL Search Order Hijacking
// ID: dbbd9f66-2ed3-4ca2-98a4-6ea985dd1a1c
// Status: test
// Level: medium
// Author: Tim Rauch (rule), Elastic (idea)
// Date: 2022-10-21
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.stealth, attack.t1566, attack.t1566.001, attack.initial-access, attack.t1574, attack.t1574.001
// Description: Detects attempts to create a DLL file to a known desktop application dependencies folder such as Slack, Teams or OneDrive and by an unusual process. This may indicate an attempt to load a malicious module via DLL search order hijacking.
// Converted by: Sigma Universal SIEM/EDR CLI

rule dbbd9f66_2ed3_4ca2_98a4_6ea985dd1a1c {
  meta:
    title = "Potential Initial Access via DLL Search Order Hijacking"
    description = "Detects attempts to create a DLL file to a known desktop application dependencies folder such as Slack, Teams or OneDrive and by an unusual process. This may indicate an attempt to load a malicious module via DLL search order hijacking."
    author = "Tim Rauch (rule), Elastic (idea)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.file.full_path = /.*\\winword.exe$/ nocase or $e.target.process.file.full_path = /.*\\excel.exe$/ nocase or $e.target.process.file.full_path = /.*\\powerpnt.exe$/ nocase or $e.target.process.file.full_path = /.*\\MSACCESS.EXE$/ nocase or $e.target.process.file.full_path = /.*\\MSPUB.EXE$/ nocase or $e.target.process.file.full_path = /.*\\fltldr.exe$/ nocase or $e.target.process.file.full_path = /.*\\cmd.exe$/ nocase or $e.target.process.file.full_path = /.*\\certutil.exe$/ nocase or $e.target.process.file.full_path = /.*\\mshta.exe$/ nocase or $e.target.process.file.full_path = /.*\\cscript.exe$/ nocase or $e.target.process.file.full_path = /.*\\wscript.exe$/ nocase or $e.target.process.file.full_path = /.*\\curl.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase) and $e.target.file.full_path = /.*.dll$/ nocase and ($e.target.file.full_path = /.*\\Users\\.*/ nocase and $e.target.file.full_path = /.*\\AppData\\.*/ nocase) and ($e.target.file.full_path = /.*\\Microsoft\\OneDrive\\.*/ nocase or $e.target.file.full_path = /.*\\Microsoft OneDrive\\.*/ nocase or $e.target.file.full_path = /.*\\Microsoft\\Teams\\.*/ nocase or $e.target.file.full_path = /.*\\Local\\slack\\app-.*/ nocase or $e.target.file.full_path = /.*\\Local\\Programs\\Microsoft VS Code\\.*/ nocase)) and not(($e.target.process.file.full_path = /.*\\cmd.exe$/ nocase and ($e.target.file.full_path = /.*\\Users\\.*/ nocase and $e.target.file.full_path = /.*\\AppData\\.*/ nocase and $e.target.file.full_path = /.*\\Microsoft\\OneDrive\\.*/ nocase and $e.target.file.full_path = /.*\\api-ms-win-core-.*/ nocase))))

  condition:
    $e
}
