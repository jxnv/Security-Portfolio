// Title: Potential PHP Reverse Shell
// ID: c6714a24-d7d5-4283-a36b-3ffd091d5f7e
// Status: test
// Level: high
// Author: @d4ns4n_
// Date: 2023-04-07
// Tags: attack.execution
// Description: Detects usage of the PHP CLI with the "-r" flag which allows it to run inline PHP code. The rule looks for calls to the "fsockopen" function which allows the creation of sockets.
// Attackers often leverage this in combination with functions such as "exec" or "fopen" to initiate a reverse shell connection.
// Converted by: Sigma Universal SIEM/EDR CLI

rule c6714a24_d7d5_4283_a36b_3ffd091d5f7e {
  meta:
    title = "Potential PHP Reverse Shell"
    description = "Detects usage of the PHP CLI with the "-r" flag which allows it to run inline PHP code. The rule looks for calls to the "fsockopen" function which allows the creation of sockets. Attackers often leverage this in combination with functions such as "exec" or "fopen" to initiate a reverse shell connection."
    author = "@d4ns4n_"
    severity = "HIGH"

  events:
    ($e.target.process.file.full_path = /.*/php.*/ nocase and ($e.target.process.command_line = /.* -r .*/ nocase and $e.target.process.command_line = /.*fsockopen.*/ nocase) and ($e.target.process.command_line = /.*ash.*/ nocase or $e.target.process.command_line = /.*bash.*/ nocase or $e.target.process.command_line = /.*bsh.*/ nocase or $e.target.process.command_line = /.*csh.*/ nocase or $e.target.process.command_line = /.*ksh.*/ nocase or $e.target.process.command_line = /.*pdksh.*/ nocase or $e.target.process.command_line = /.*sh.*/ nocase or $e.target.process.command_line = /.*tcsh.*/ nocase or $e.target.process.command_line = /.*zsh.*/ nocase))

  condition:
    $e
}
