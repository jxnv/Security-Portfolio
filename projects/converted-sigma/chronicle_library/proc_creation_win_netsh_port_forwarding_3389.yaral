// Title: RDP Port Forwarding Rule Added Via Netsh.EXE
// ID: 782d6f3e-4c5d-4b8c-92a3-1d05fed72e63
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), oscd.community
// Date: 2019-01-29
// Tags: attack.lateral-movement, attack.command-and-control, attack.t1090
// Description: Detects the execution of netsh to configure a port forwarding of port 3389 (RDP) rule
// Converted by: Sigma Universal SIEM/EDR CLI

rule 782d6f3e_4c5d_4b8c_92a3_1d05fed72e63 {
  meta:
    title = "RDP Port Forwarding Rule Added Via Netsh.EXE"
    description = "Detects the execution of netsh to configure a port forwarding of port 3389 (RDP) rule"
    author = "Florian Roth (Nextron Systems), oscd.community"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.* i.*/ nocase and $e.target.process.command_line = /.* p.*/ nocase and $e.target.process.command_line = /.*=3389.*/ nocase and $e.target.process.command_line = /.* c.*/ nocase)) and (($e.target.process.file.full_path = /.*\\netsh.exe$/ nocase) or ($e.target.process.file.name = "netsh.exe")))

  condition:
    $e
}
