// Title: Compress Data and Lock With Password for Exfiltration With 7-ZIP
// ID: 9fbf5927-5261-4284-a71d-f681029ea574
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-07-27
// Tags: attack.collection, attack.t1560.001
// Description: An adversary may compress or encrypt data that is collected prior to exfiltration using 3rd party utilities
// Converted by: Sigma Universal SIEM/EDR CLI

rule 9fbf5927_5261_4284_a71d_f681029ea574 {
  meta:
    title = "Compress Data and Lock With Password for Exfiltration With 7-ZIP"
    description = "An adversary may compress or encrypt data that is collected prior to exfiltration using 3rd party utilities"
    author = "frack113"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.* a .*/ nocase or $e.target.process.command_line = /.* u .*/ nocase)) and (($e.Description = /.*7-Zip.*/ nocase) or (($e.target.process.file.full_path = /.*\\7z.exe$/ nocase or $e.target.process.file.full_path = /.*\\7zr.exe$/ nocase or $e.target.process.file.full_path = /.*\\7za.exe$/ nocase)) or (($e.target.process.file.name = "7z.exe" or $e.target.process.file.name = "7za.exe" or $e.target.process.file.name = "7zr.exe"))) and ($e.target.process.command_line = /.* -p.*/ nocase))

  condition:
    $e
}
