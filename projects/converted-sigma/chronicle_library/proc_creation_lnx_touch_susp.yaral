// Title: Touch Suspicious Service File
// ID: 31545105-3444-4584-bebf-c466353230d2
// Status: test
// Level: medium
// Author: Joseliyo Sanchez, @Joseliyo_Jstnk
// Date: 2023-01-11
// Tags: attack.stealth, attack.t1070.006
// Description: Detects usage of the "touch" process in service file.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 31545105_3444_4584_bebf_c466353230d2 {
  meta:
    title = "Touch Suspicious Service File"
    description = "Detects usage of the "touch" process in service file."
    author = "Joseliyo Sanchez, @Joseliyo_Jstnk"
    severity = "MEDIUM"

  events:
    ($e.target.process.file.full_path = /.*/touch$/ nocase and $e.target.process.command_line = /.* -t .*/ nocase and $e.target.process.command_line = /.*.service$/ nocase)

  condition:
    $e
}
