// Title: CodeIntegrity - Unmet WHQL Requirements For Loaded Kernel Module
// ID: 2f8cd7a0-9d5a-4f62-9f8b-2c951aa0dd1f
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-06
// Tags: attack.privilege-escalation
// Description: Detects loaded kernel modules that did not meet the WHQL signing requirements.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 2f8cd7a0_9d5a_4f62_9f8b_2c951aa0dd1f {
  meta:
    title = "CodeIntegrity - Unmet WHQL Requirements For Loaded Kernel Module"
    description = "Detects loaded kernel modules that did not meet the WHQL signing requirements."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.EventID = 3082 or $e.EventID = 3083)) and not((($e.FileNameBuffer = "system32\\drivers\\vsock.sys" or $e.FileNameBuffer = "System32\\drivers\\vmci.sys"))))

  condition:
    $e
}
