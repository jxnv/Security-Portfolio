rule 33d50d03_20ec_4b74_a74e_1e65a38af1c0 {
  meta:
    title = "AWS EKS Cluster Created or Deleted"
    description = "Identifies when an EKS cluster is created or deleted."
    author = "Austin Songer"
    severity = "LOW"

  events:
    ($e.eventSource = "eks.amazonaws.com" and ($e.eventName = "CreateCluster" or $e.eventName = "DeleteCluster"))

  condition:
    $e
}
