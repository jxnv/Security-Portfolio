// Title: Invoke-Obfuscation STDIN+ Launcher - System
// ID: 72862bf2-0eb1-11eb-adc1-0242ac120002
// Status: test
// Level: high
// Author: Jonathan Cheong, oscd.community
// Date: 2020-10-15
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated use of stdin to execute PowerShell
// Converted by: Sigma Universal SIEM/EDR CLI

rule 72862bf2_0eb1_11eb_adc1_0242ac120002 {
  meta:
    title = "Invoke-Obfuscation STDIN+ Launcher - System"
    description = "Detects Obfuscated use of stdin to execute PowerShell"
    author = "Jonathan Cheong, oscd.community"
    severity = "HIGH"

  events:
    (($e.Provider_Name = "Service Control Manager" and $e.EventID = 7045 and ($e.ImagePath = /.*cmd.*/ nocase and $e.ImagePath = /.*powershell.*/ nocase) and ($e.ImagePath = /.*/c.*/ nocase or $e.ImagePath = /.*/r.*/ nocase)) and (($e.ImagePath = /.*noexit.*/ nocase) or (($e.ImagePath = /.*input.*/ nocase and $e.ImagePath = /.*$.*/ nocase))))

  condition:
    $e
}
