// Title: Response File Execution Via Odbcconf.EXE
// ID: 5f03babb-12db-4eec-8c82-7b4cb5580868
// Status: test
// Level: medium
// Author: Kirill Kiryanov, Beyu Denis, Daniil Yugoslavskiy, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-22
// Tags: attack.stealth, attack.t1218.008
// Description: Detects execution of "odbcconf" with the "-f" flag in order to load a response file which might contain a malicious action.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 5f03babb_12db_4eec_8c82_7b4cb5580868 {
  meta:
    title = "Response File Execution Via Odbcconf.EXE"
    description = "Detects execution of "odbcconf" with the "-f" flag in order to load a response file which might contain a malicious action."
    author = "Kirill Kiryanov, Beyu Denis, Daniil Yugoslavskiy, oscd.community, Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.target.process.command_line = /.* -f .*/ nocase) and (($e.target.process.file.full_path = /.*\\odbcconf.exe$/ nocase) or ($e.target.process.file.name = "odbcconf.exe")) and ($e.target.process.command_line = /.*.rsp.*/ nocase))

  condition:
    $e
}
