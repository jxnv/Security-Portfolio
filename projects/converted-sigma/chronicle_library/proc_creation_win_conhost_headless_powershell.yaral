// Title: Powershell Executed From Headless ConHost Process
// ID: 056c7317-9a09-4bd4-9067-d051312752ea
// Status: test
// Level: medium
// Author: Matt Anderson (Huntress)
// Date: 2024-07-23
// Tags: attack.execution, attack.stealth, attack.t1059.001, attack.t1059.003, attack.t1564.003
// Description: Detects the use of powershell commands from headless ConHost window.
// The "--headless" flag hides the windows from the user upon execution.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 056c7317_9a09_4bd4_9067_d051312752ea {
  meta:
    title = "Powershell Executed From Headless ConHost Process"
    description = "Detects the use of powershell commands from headless ConHost window. The "--headless" flag hides the windows from the user upon execution."
    author = "Matt Anderson (Huntress)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*--headless.*/ nocase and $e.target.process.command_line = /.*powershell.*/ nocase)) and (($e.target.process.file.full_path = /.*\\conhost.exe$/ nocase) or ($e.target.process.file.name = "CONHOST.EXE")))

  condition:
    $e
}
