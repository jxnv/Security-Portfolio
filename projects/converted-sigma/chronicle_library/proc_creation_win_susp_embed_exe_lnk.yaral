// Title: Hidden Powershell in Link File Pattern
// ID: 30e92f50-bb5a-4884-98b5-d20aa80f3d7a
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-02-06
// Tags: attack.execution, attack.t1059.001
// Description: Detects events that appear when a user click on a link file with a powershell command in it
// Converted by: Sigma Universal SIEM/EDR CLI

rule 30e92f50_bb5a_4884_98b5_d20aa80f3d7a {
  meta:
    title = "Hidden Powershell in Link File Pattern"
    description = "Detects events that appear when a user click on a link file with a powershell command in it"
    author = "frack113"
    severity = "MEDIUM"

  events:
    ($e.principal.process.file.full_path = "C:\\Windows\\explorer.exe" and $e.target.process.file.full_path = "C:\\Windows\\System32\\cmd.exe" and ($e.target.process.command_line = /.*powershell.*/ nocase and $e.target.process.command_line = /.*.lnk.*/ nocase))

  condition:
    $e
}
