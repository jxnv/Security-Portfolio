// Title: PUA - Ngrok Execution
// ID: ee37eb7c-a4e7-4cd5-8fa4-efa27f1c3f31
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-05-14
// Tags: attack.command-and-control, attack.t1572
// Description: Detects the use of Ngrok, a utility used for port forwarding and tunneling, often used by threat actors to make local protected services publicly available.
// Involved domains are bin.equinox.io for download and *.ngrok.io for connections.
// Converted by: Sigma Universal SIEM/EDR CLI

rule ee37eb7c_a4e7_4cd5_8fa4_efa27f1c3f31 {
  meta:
    title = "PUA - Ngrok Execution"
    description = "Detects the use of Ngrok, a utility used for port forwarding and tunneling, often used by threat actors to make local protected services publicly available. Involved domains are bin.equinox.io for download and *.ngrok.io for connections."
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.* tcp 139.*/ nocase or $e.target.process.command_line = /.* tcp 445.*/ nocase or $e.target.process.command_line = /.* tcp 3389.*/ nocase or $e.target.process.command_line = /.* tcp 5985.*/ nocase or $e.target.process.command_line = /.* tcp 5986.*/ nocase)) or (($e.target.process.command_line = /.* start .*/ nocase and $e.target.process.command_line = /.*--all.*/ nocase and $e.target.process.command_line = /.*--config.*/ nocase and $e.target.process.command_line = /.*.yml.*/ nocase)) or ($e.target.process.file.full_path = /.*ngrok.exe$/ nocase and ($e.target.process.command_line = /.* tcp .*/ nocase or $e.target.process.command_line = /.* http .*/ nocase or $e.target.process.command_line = /.* authtoken .*/ nocase)) or (($e.target.process.command_line = /.*.exe authtoken .*/ nocase or $e.target.process.command_line = /.*.exe start --all.*/ nocase)))

  condition:
    $e
}
