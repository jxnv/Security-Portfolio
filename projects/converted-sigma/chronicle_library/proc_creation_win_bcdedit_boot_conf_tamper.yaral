// Title: Boot Configuration Tampering Via Bcdedit.EXE
// ID: 1444443e-6757-43e4-9ea4-c8fc705f79a2
// Status: stable
// Level: high
// Author: E.M. Anhaus (originally from Atomic Blue Detections, Endgame), oscd.community
// Date: 2019-10-24
// Tags: attack.impact, attack.t1490
// Description: Detects the use of the bcdedit command to tamper with the boot configuration data. This technique is often times used by malware or attackers as a destructive way before launching ransomware.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 1444443e_6757_43e4_9ea4_c8fc705f79a2 {
  meta:
    title = "Boot Configuration Tampering Via Bcdedit.EXE"
    description = "Detects the use of the bcdedit command to tamper with the boot configuration data. This technique is often times used by malware or attackers as a destructive way before launching ransomware."
    author = "E.M. Anhaus (originally from Atomic Blue Detections, Endgame), oscd.community"
    severity = "HIGH"

  events:
    (((($e.target.process.command_line = /.*bootstatuspolicy.*/ nocase and $e.target.process.command_line = /.*ignoreallfailures.*/ nocase)) or (($e.target.process.command_line = /.*recoveryenabled.*/ nocase and $e.target.process.command_line = /.*no.*/ nocase))) and (($e.target.process.file.full_path = /.*\\bcdedit.exe$/ nocase) or ($e.target.process.file.name = "bcdedit.exe")) and ($e.target.process.command_line = /.*set.*/ nocase))

  condition:
    $e
}
