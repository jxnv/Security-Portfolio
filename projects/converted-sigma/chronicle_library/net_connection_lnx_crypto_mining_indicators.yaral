// Title: Linux Crypto Mining Pool Connections
// ID: a46c93b7-55ed-4d27-a41b-c259456c4746
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-10-26
// Tags: attack.impact, attack.t1496
// Description: Detects process connections to a Monero crypto mining pool
// Converted by: Sigma Universal SIEM/EDR CLI

rule a46c93b7_55ed_4d27_a41b_c259456c4746 {
  meta:
    title = "Linux Crypto Mining Pool Connections"
    description = "Detects process connections to a Monero crypto mining pool"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.DestinationHostname = "pool.minexmr.com" or $e.DestinationHostname = "fr.minexmr.com" or $e.DestinationHostname = "de.minexmr.com" or $e.DestinationHostname = "sg.minexmr.com" or $e.DestinationHostname = "ca.minexmr.com" or $e.DestinationHostname = "us-west.minexmr.com" or $e.DestinationHostname = "pool.supportxmr.com" or $e.DestinationHostname = "mine.c3pool.com" or $e.DestinationHostname = "xmr-eu1.nanopool.org" or $e.DestinationHostname = "xmr-eu2.nanopool.org" or $e.DestinationHostname = "xmr-us-east1.nanopool.org" or $e.DestinationHostname = "xmr-us-west1.nanopool.org" or $e.DestinationHostname = "xmr-asia1.nanopool.org" or $e.DestinationHostname = "xmr-jp1.nanopool.org" or $e.DestinationHostname = "xmr-au1.nanopool.org" or $e.DestinationHostname = "xmr.2miners.com" or $e.DestinationHostname = "xmr.hashcity.org" or $e.DestinationHostname = "xmr.f2pool.com" or $e.DestinationHostname = "xmrpool.eu" or $e.DestinationHostname = "pool.hashvault.pro" or $e.DestinationHostname = "moneroocean.stream" or $e.DestinationHostname = "monerocean.stream"))

  condition:
    $e
}
