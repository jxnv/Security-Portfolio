// Title: Credential Manager Access By Uncommon Applications
// ID: 407aecb1-e762-4acf-8c7b-d087bcff3bb6
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-11
// Tags: attack.t1003, attack.credential-access
// Description: Detects suspicious processes based on name and location that access the windows credential manager and vault.
// Which can be a sign of credential stealing. Example case would be usage of mimikatz "dpapi::cred" function
// Converted by: Sigma Universal SIEM/EDR CLI

rule 407aecb1_e762_4acf_8c7b_d087bcff3bb6 {
  meta:
    title = "Credential Manager Access By Uncommon Applications"
    description = "Detects suspicious processes based on name and location that access the windows credential manager and vault. Which can be a sign of credential stealing. Example case would be usage of mimikatz "dpapi::cred" function"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.FileName = /.*\\AppData\\Local\\Microsoft\\Credentials\\.*/ nocase or $e.FileName = /.*\\AppData\\Roaming\\Microsoft\\Credentials\\.*/ nocase or $e.FileName = /.*\\AppData\\Local\\Microsoft\\Vault\\.*/ nocase or $e.FileName = /.*\\ProgramData\\Microsoft\\Vault\\.*/ nocase)) and not((($e.target.process.file.full_path = "C:\\Windows\\explorer.exe") or (($e.target.process.file.full_path = /^C:\\Program Files\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files (x86)\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\system32\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\SysWOW64\\.*/ nocase)))))

  condition:
    $e
}
