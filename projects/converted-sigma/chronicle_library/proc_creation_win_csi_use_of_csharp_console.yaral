// Title: Suspicious Use of CSharp Interactive Console
// ID: a9e416a8-e613-4f8b-88b8-a7d1d1af2f61
// Status: test
// Level: high
// Author: Michael R. (@nahamike01)
// Date: 2020-03-08
// Tags: attack.execution, attack.stealth, attack.t1127
// Description: Detects the execution of CSharp interactive console by PowerShell
// Converted by: Sigma Universal SIEM/EDR CLI

rule a9e416a8_e613_4f8b_88b8_a7d1d1af2f61 {
  meta:
    title = "Suspicious Use of CSharp Interactive Console"
    description = "Detects the execution of CSharp interactive console by PowerShell"
    author = "Michael R. (@nahamike01)"
    severity = "HIGH"

  events:
    ($e.target.process.file.full_path = /.*\\csi.exe$/ nocase and ($e.principal.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.principal.process.file.full_path = /.*\\pwsh.exe$/ nocase or $e.principal.process.file.full_path = /.*\\powershell_ise.exe$/ nocase) and $e.target.process.file.name = "csi.exe")

  condition:
    $e
}
