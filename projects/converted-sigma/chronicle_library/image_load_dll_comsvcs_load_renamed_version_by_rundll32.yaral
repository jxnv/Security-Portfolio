// Title: Suspicious Renamed Comsvcs DLL Loaded By Rundll32
// ID: 8cde342c-ba48-4b74-b615-172c330f2e93
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-14
// Tags: attack.credential-access, attack.t1003.001
// Description: Detects rundll32 loading a renamed comsvcs.dll to dump process memory
// Converted by: Sigma Universal SIEM/EDR CLI

rule 8cde342c_ba48_4b74_b615_172c330f2e93 {
  meta:
    title = "Suspicious Renamed Comsvcs DLL Loaded By Rundll32"
    description = "Detects rundll32 loading a renamed comsvcs.dll to dump process memory"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase and ($e.Hashes = /.*IMPHASH=eed93054cb555f3de70eaa9787f32ebb.*/ nocase or $e.Hashes = /.*IMPHASH=5e0dbdec1fce52daae251a110b4f309d.*/ nocase or $e.Hashes = /.*IMPHASH=eadbccbb324829acb5f2bbe87e5549a8.*/ nocase or $e.Hashes = /.*IMPHASH=407ca0f7b523319d758a40d7c0193699.*/ nocase or $e.Hashes = /.*IMPHASH=281d618f4e6271e527e6386ea6f748de.*/ nocase)) and not(($e.ImageLoaded = /.*\\comsvcs.dll$/ nocase)))

  condition:
    $e
}
