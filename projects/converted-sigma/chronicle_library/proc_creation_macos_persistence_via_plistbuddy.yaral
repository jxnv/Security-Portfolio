// Title: Potential Persistence Via PlistBuddy
// ID: 65d506d3-fcfe-4071-b4b2-bcefe721bbbb
// Status: test
// Level: high
// Author: Sohan G (D4rkCiph3r)
// Date: 2023-02-18
// Tags: attack.privilege-escalation, attack.persistence, attack.t1543.001, attack.t1543.004
// Description: Detects potential persistence activity using LaunchAgents or LaunchDaemons via the PlistBuddy utility
// Converted by: Sigma Universal SIEM/EDR CLI

rule 65d506d3_fcfe_4071_b4b2_bcefe721bbbb {
  meta:
    title = "Potential Persistence Via PlistBuddy"
    description = "Detects potential persistence activity using LaunchAgents or LaunchDaemons via the PlistBuddy utility"
    author = "Sohan G (D4rkCiph3r)"
    severity = "HIGH"

  events:
    ($e.target.process.file.full_path = /.*/PlistBuddy$/ nocase and ($e.target.process.command_line = /.*RunAtLoad.*/ nocase and $e.target.process.command_line = /.*true.*/ nocase) and ($e.target.process.command_line = /.*LaunchAgents.*/ nocase or $e.target.process.command_line = /.*LaunchDaemons.*/ nocase))

  condition:
    $e
}
