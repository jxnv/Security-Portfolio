rule 99980a85_3a61_43d3_ac0f_b68d6b4797b1 {
  meta:
    title = "Google Cloud VPN Tunnel Modified or Deleted"
    description = "Identifies when a VPN Tunnel Modified or Deleted in Google Cloud."
    author = "Austin Songer @austinsonger"
    severity = "MEDIUM"

  events:
    (($e.gcp.audit.method_name = "compute.vpnTunnels.insert" or $e.gcp.audit.method_name = "compute.vpnTunnels.delete"))

  condition:
    $e
}
