// Title: Remote Access Tool - AnyDesk Piped Password Via CLI
// ID: b1377339-fda6-477a-b455-ac0923f9ec2c
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-28
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects piping the password to an anydesk instance via CMD and the '--set-password' flag.
// Converted by: Sigma Universal SIEM/EDR CLI

rule b1377339_fda6_477a_b455_ac0923f9ec2c {
  meta:
    title = "Remote Access Tool - AnyDesk Piped Password Via CLI"
    description = "Detects piping the password to an anydesk instance via CMD and the '--set-password' flag."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.target.process.command_line = /.*/c .*/ nocase and $e.target.process.command_line = /.*echo .*/ nocase and $e.target.process.command_line = /.*.exe --set-password.*/ nocase))

  condition:
    $e
}
