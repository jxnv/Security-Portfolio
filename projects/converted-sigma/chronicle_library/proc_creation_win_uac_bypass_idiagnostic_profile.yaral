// Description: Detects the "IDiagnosticProfileUAC" UAC bypass technique
// Converted by: Sigma Universal SIEM/EDR CLI

rule 4cbef972_f347_4170_b62a_8253f6168e6d {
  meta:
    title = "UAC Bypass Using IDiagnostic Profile"
    description = "Detects the "IDiagnosticProfileUAC" UAC bypass technique"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ($e.principal.process.file.full_path = /.*\\DllHost.exe$/ nocase and $e.principal.process.command_line = /.* /Processid:{12C21EA7-2EB8-4B55-9249-AC243DA8C666}.*/ nocase and ($e.IntegrityLevel = "High" or $e.IntegrityLevel = "System" or $e.IntegrityLevel = "S-1-16-16384" or $e.IntegrityLevel = "S-1-16-12288"))

  condition:
    $e
}
