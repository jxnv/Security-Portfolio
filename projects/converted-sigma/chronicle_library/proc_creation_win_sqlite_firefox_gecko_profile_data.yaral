// Title: SQLite Firefox Profile Data DB Access
// ID: 4833155a-4053-4c9c-a997-777fcea0baa7
// Status: test
// Level: high
// Author: frack113
// Date: 2022-04-08
// Tags: attack.credential-access, attack.t1539, attack.collection, attack.t1005
// Description: Detect usage of the "sqlite" binary to query databases in Firefox and other Gecko-based browsers for potential data stealing.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 4833155a_4053_4c9c_a997_777fcea0baa7 {
  meta:
    title = "SQLite Firefox Profile Data DB Access"
    description = "Detect usage of the "sqlite" binary to query databases in Firefox and other Gecko-based browsers for potential data stealing."
    author = "frack113"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*cookies.sqlite.*/ nocase or $e.target.process.command_line = /.*places.sqlite.*/ nocase)) and (($e.Product = "SQLite") or (($e.target.process.file.full_path = /.*\\sqlite.exe$/ nocase or $e.target.process.file.full_path = /.*\\sqlite3.exe$/ nocase))))

  condition:
    $e
}
