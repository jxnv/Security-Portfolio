rule 7a14080d_a048_4de8_ae58_604ce58a795b {
  meta:
    title = "Remote File Copy"
    description = "Detects the use of tools that copy files from or to remote systems"
    author = "Ömer Günal"
    severity = "LOW"

  events:
    (("scp " or "rsync " or "sftp ") and ("@" or ":"))

  condition:
    $e
}
