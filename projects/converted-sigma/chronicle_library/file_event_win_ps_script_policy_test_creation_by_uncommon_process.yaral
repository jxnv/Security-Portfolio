// Title: PSScriptPolicyTest Creation By Uncommon Process
// ID: 1027d292-dd87-4a1a-8701-2abe04d7783c
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-01
// Tags: attack.stealth
// Description: Detects the creation of the "PSScriptPolicyTest" PowerShell script by an uncommon process. This file is usually generated by Microsoft Powershell to test against Applocker.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 1027d292_dd87_4a1a_8701_2abe04d7783c {
  meta:
    title = "PSScriptPolicyTest Creation By Uncommon Process"
    description = "Detects the creation of the "PSScriptPolicyTest" PowerShell script by an uncommon process. This file is usually generated by Microsoft Powershell to test against Applocker."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.target.file.full_path = /.*__PSScriptPolicyTest_.*/ nocase) and not(((($e.target.process.file.full_path = "C:\\Windows\\System32\\dsac.exe" or $e.target.process.file.full_path = "C:\\Windows\\System32\\sdiagnhost.exe" or $e.target.process.file.full_path = "C:\\Windows\\System32\\ServerManager.exe" or $e.target.process.file.full_path = "C:\\Windows\\System32\\wsmprovhost.exe" or $e.target.process.file.full_path = "C:\\Windows\\SysWOW64\\sdiagnhost.exe")) or (($e.target.process.file.full_path = "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" or $e.target.process.file.full_path = "C:\\Program Files\\PowerShell\\7\\pwsh.exe" or $e.target.process.file.full_path = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or $e.target.process.file.full_path = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" or $e.target.process.file.full_path = "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or $e.target.process.file.full_path = "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")) or (($e.target.process.file.full_path = /.*C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview.*/ nocase or $e.target.process.file.full_path = /.*\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview.*/ nocase) and $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase))) and not(($e.target.process.file.full_path = /^C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_.*/ nocase and $e.target.process.file.full_path = /.*\\GetHelp.exe$/ nocase)))

  condition:
    $e
}
