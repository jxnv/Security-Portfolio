// Description: Detects the load of a signed WinRing0 driver often used by threat actors, crypto miners (XMRIG) or malware for privilege escalation
// Converted by: Sigma Universal SIEM/EDR CLI

rule 1a42dfa6_6cb2_4df9_9b48_295be477e835 {
  meta:
    title = "Vulnerable WinRing0 Driver Load"
    description = "Detects the load of a signed WinRing0 driver often used by threat actors, crypto miners (XMRIG) or malware for privilege escalation"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.Hashes = /.*IMPHASH=D41FA95D4642DC981F10DE36F4DC8CD7.*/ nocase) or (($e.ImageLoaded = /.*\\WinRing0x64.sys$/ nocase or $e.ImageLoaded = /.*\\WinRing0.sys$/ nocase or $e.ImageLoaded = /.*\\WinRing0.dll$/ nocase or $e.ImageLoaded = /.*\\WinRing0x64.dll$/ nocase or $e.ImageLoaded = /.*\\winring00x64.sys$/ nocase)))

  condition:
    $e
}
