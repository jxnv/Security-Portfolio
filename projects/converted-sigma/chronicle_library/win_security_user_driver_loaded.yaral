// Title: Potential Privileged System Service Operation - SeLoadDriverPrivilege
// ID: f63508a0-c809-4435-b3be-ed819394d612
// Status: test
// Level: medium
// Author: xknow (@xknow_infosec), xorxes (@xor_xes)
// Date: 2019-04-08
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects the usage of the 'SeLoadDriverPrivilege' privilege. This privilege is required to load or unload a device driver.
// With this privilege, the user can dynamically load and unload device drivers or other code in to kernel mode.
// This user right does not apply to Plug and Play device drivers.
// If you exclude privileged users/admins and processes, which are allowed to do so, you are maybe left with bad programs trying to load malicious kernel drivers.
// This will detect Ghost-In-The-Logs (https://github.com/bats3c/Ghost-In-The-Logs) and the usage of Sysinternals and various other tools. So you have to work with a whitelist to find the bad stuff.
// Converted by: Sigma Universal SIEM/EDR CLI

rule f63508a0_c809_4435_b3be_ed819394d612 {
  meta:
    title = "Potential Privileged System Service Operation - SeLoadDriverPrivilege"
    description = "Detects the usage of the 'SeLoadDriverPrivilege' privilege. This privilege is required to load or unload a device driver. With this privilege, the user can dynamically load and unload device drivers or other code in to kernel mode. This user right does not apply to Plug and Play device drivers. If you exclude privileged users/admins and processes, which are allowed to do so, you are maybe left with bad programs trying to load malicious kernel drivers. This will detect Ghost-In-The-Logs (https://github.com/bats3c/Ghost-In-The-Logs) and the usage of Sysinternals and various other tools. So you have to work with a whitelist to find the bad stuff."
    author = "xknow (@xknow_infosec), xorxes (@xor_xes)"
    severity = "MEDIUM"

  events:
    (($e.EventID = 4673 and $e.PrivilegeList = "SeLoadDriverPrivilege" and $e.Service = "-") and not(((($e.ProcessName = "C:\\Windows\\explorer.exe" or $e.ProcessName = "C:\\Windows\\HelpPane.exe" or $e.ProcessName = "C:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe" or $e.ProcessName = "C:\\Windows\\System32\\Dism.exe" or $e.ProcessName = "C:\\Windows\\System32\\fltMC.exe" or $e.ProcessName = "C:\\Windows\\System32\\mmc.exe" or $e.ProcessName = "C:\\Windows\\System32\\rundll32.exe" or $e.ProcessName = "C:\\Windows\\System32\\RuntimeBroker.exe" or $e.ProcessName = "C:\\Windows\\System32\\ShellHost.exe" or $e.ProcessName = "C:\\Windows\\System32\\svchost.exe" or $e.ProcessName = "C:\\Windows\\System32\\SystemSettingsBroker.exe" or $e.ProcessName = "C:\\Windows\\System32\\wimserv.exe")) or ($e.ProcessName = /^C:\\Program Files\\WindowsApps\\Microsoft.*/ nocase))) and not(((($e.ProcessName = /^C:\\Program Files (x86)\\Dropbox\\.*/ nocase or $e.ProcessName = /^C:\\Program Files\\Dropbox\\.*/ nocase) and $e.ProcessName = /.*\\Dropbox.exe$/ nocase) or (($e.ProcessName = /.*\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe$/ nocase or $e.ProcessName = /.*\\Google\\Chrome\\Application\\chrome.exe$/ nocase or $e.ProcessName = /.*\\procexp.exe$/ nocase or $e.ProcessName = /.*\\procexp64.exe$/ nocase or $e.ProcessName = /.*\\procexp64a.exe$/ nocase or $e.ProcessName = /.*\\procmon.exe$/ nocase or $e.ProcessName = /.*\\procmon64.exe$/ nocase or $e.ProcessName = /.*\\procmon64a.exe$/ nocase)))))

  condition:
    $e
}
