// Tags: attack.persistence, attack.t1505.002
// Description: Detects a failed installation of a Exchange Transport Agent
// Converted by: Sigma Universal SIEM/EDR CLI

rule c7d16cae_aaf3_42e5_9c1c_fb8553faa6fa {
  meta:
    title = "Failed MSExchange Transport Agent Installation"
    description = "Detects a failed installation of a Exchange Transport Agent"
    author = "Tobias Michalski (Nextron Systems)"
    severity = "HIGH"

  events:
    ($e.EventID = 6 and $e.Data = /.*Install-TransportAgent.*/ nocase)

  condition:
    $e
}
