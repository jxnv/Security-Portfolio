// Title: Suspicious Parent Double Extension File Execution
// ID: 5e6a80c8-2d45-4633-9ef4-fa2671a39c5c
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-06
// Tags: attack.stealth, attack.t1036.007
// Description: Detect execution of suspicious double extension files in ParentCommandLine
// Converted by: Sigma Universal SIEM/EDR CLI

rule 5e6a80c8_2d45_4633_9ef4_fa2671a39c5c {
  meta:
    title = "Suspicious Parent Double Extension File Execution"
    description = "Detect execution of suspicious double extension files in ParentCommandLine"
    author = "frack113, Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.principal.process.file.full_path = /.*.doc.lnk$/ nocase or $e.principal.process.file.full_path = /.*.docx.lnk$/ nocase or $e.principal.process.file.full_path = /.*.xls.lnk$/ nocase or $e.principal.process.file.full_path = /.*.xlsx.lnk$/ nocase or $e.principal.process.file.full_path = /.*.ppt.lnk$/ nocase or $e.principal.process.file.full_path = /.*.pptx.lnk$/ nocase or $e.principal.process.file.full_path = /.*.rtf.lnk$/ nocase or $e.principal.process.file.full_path = /.*.pdf.lnk$/ nocase or $e.principal.process.file.full_path = /.*.txt.lnk$/ nocase or $e.principal.process.file.full_path = /.*.doc.js$/ nocase or $e.principal.process.file.full_path = /.*.docx.js$/ nocase or $e.principal.process.file.full_path = /.*.xls.js$/ nocase or $e.principal.process.file.full_path = /.*.xlsx.js$/ nocase or $e.principal.process.file.full_path = /.*.ppt.js$/ nocase or $e.principal.process.file.full_path = /.*.pptx.js$/ nocase or $e.principal.process.file.full_path = /.*.rtf.js$/ nocase or $e.principal.process.file.full_path = /.*.pdf.js$/ nocase or $e.principal.process.file.full_path = /.*.txt.js$/ nocase)) or (($e.principal.process.command_line = /.*.doc.lnk.*/ nocase or $e.principal.process.command_line = /.*.docx.lnk.*/ nocase or $e.principal.process.command_line = /.*.xls.lnk.*/ nocase or $e.principal.process.command_line = /.*.xlsx.lnk.*/ nocase or $e.principal.process.command_line = /.*.ppt.lnk.*/ nocase or $e.principal.process.command_line = /.*.pptx.lnk.*/ nocase or $e.principal.process.command_line = /.*.rtf.lnk.*/ nocase or $e.principal.process.command_line = /.*.pdf.lnk.*/ nocase or $e.principal.process.command_line = /.*.txt.lnk.*/ nocase or $e.principal.process.command_line = /.*.doc.js.*/ nocase or $e.principal.process.command_line = /.*.docx.js.*/ nocase or $e.principal.process.command_line = /.*.xls.js.*/ nocase or $e.principal.process.command_line = /.*.xlsx.js.*/ nocase or $e.principal.process.command_line = /.*.ppt.js.*/ nocase or $e.principal.process.command_line = /.*.pptx.js.*/ nocase or $e.principal.process.command_line = /.*.rtf.js.*/ nocase or $e.principal.process.command_line = /.*.pdf.js.*/ nocase or $e.principal.process.command_line = /.*.txt.js.*/ nocase)))

  condition:
    $e
}
