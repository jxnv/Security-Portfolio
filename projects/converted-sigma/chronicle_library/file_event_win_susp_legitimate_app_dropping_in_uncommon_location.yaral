// Title: Legitimate Application Writing Files In Uncommon Location
// ID: 1cf465a1-2609-4c15-9b66-c32dbe4bfd67
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-12-10
// Tags: attack.stealth, attack.t1218, attack.command-and-control, attack.t1105
// Description: Detects legitimate applications writing any type of file to uncommon or suspicious locations that are not typical for application data storage or execution.
// Adversaries may leverage legitimate applications (Living off the Land Binaries - LOLBins) to drop or download malicious files to uncommon locations on the system to evade detection by security solutions.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 1cf465a1_2609_4c15_9b66_c32dbe4bfd67 {
  meta:
    title = "Legitimate Application Writing Files In Uncommon Location"
    description = "Detects legitimate applications writing any type of file to uncommon or suspicious locations that are not typical for application data storage or execution. Adversaries may leverage legitimate applications (Living off the Land Binaries - LOLBins) to drop or download malicious files to uncommon locations on the system to evade detection by security solutions."
    author = "Swachchhanda Shrawan Poudel (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.file.full_path = /.*\\eqnedt32.exe$/ nocase or $e.target.process.file.full_path = /.*\\wordpad.exe$/ nocase or $e.target.process.file.full_path = /.*\\wordview.exe$/ nocase or $e.target.process.file.full_path = /.*\\cmdl32.exe$/ nocase or $e.target.process.file.full_path = /.*\\certutil.exe$/ nocase or $e.target.process.file.full_path = /.*\\certoc.exe$/ nocase or $e.target.process.file.full_path = /.*\\CertReq.exe$/ nocase or $e.target.process.file.full_path = /.*\\bitsadmin.exe$/ nocase or $e.target.process.file.full_path = /.*\\Desktopimgdownldr.exe$/ nocase or $e.target.process.file.full_path = /.*\\esentutl.exe$/ nocase or $e.target.process.file.full_path = /.*\\expand.exe$/ nocase or $e.target.process.file.full_path = /.*\\extrac32.exe$/ nocase or $e.target.process.file.full_path = /.*\\replace.exe$/ nocase or $e.target.process.file.full_path = /.*\\mshta.exe$/ nocase or $e.target.process.file.full_path = /.*\\ftp.exe$/ nocase or $e.target.process.file.full_path = /.*\\Ldifde.exe$/ nocase or $e.target.process.file.full_path = /.*\\RdrCEF.exe$/ nocase or $e.target.process.file.full_path = /.*\\hh.exe$/ nocase or $e.target.process.file.full_path = /.*\\finger.exe$/ nocase or $e.target.process.file.full_path = /.*\\findstr.exe$/ nocase)) and (($e.target.file.full_path = /.*:\\Perflogs.*/ nocase or $e.target.file.full_path = /.*:\\ProgramData\\.*/ nocase or $e.target.file.full_path = /.*:\\Temp\\.*/ nocase or $e.target.file.full_path = /.*:\\Users\\Public\\.*/ nocase or $e.target.file.full_path = /.*:\\Windows\\.*/ nocase or $e.target.file.full_path = /.*\\$Recycle.Bin\\.*/ nocase or $e.target.file.full_path = /.*\\AppData\\Local\\.*/ nocase or $e.target.file.full_path = /.*\\AppData\\Roaming\\.*/ nocase or $e.target.file.full_path = /.*\\Contacts\\.*/ nocase or $e.target.file.full_path = /.*\\Desktop\\.*/ nocase or $e.target.file.full_path = /.*\\Favorites\\.*/ nocase or $e.target.file.full_path = /.*\\Favourites\\.*/ nocase or $e.target.file.full_path = /.*\\inetpub\\wwwroot\\.*/ nocase or $e.target.file.full_path = /.*\\Music\\.*/ nocase or $e.target.file.full_path = /.*\\Pictures\\.*/ nocase or $e.target.file.full_path = /.*\\Start Menu\\Programs\\Startup\\.*/ nocase or $e.target.file.full_path = /.*\\Users\\Default\\.*/ nocase or $e.target.file.full_path = /.*\\Videos\\.*/ nocase)))

  condition:
    $e
}
