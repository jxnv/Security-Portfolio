// Title: Obfuscated IP Download Activity
// ID: cb5a2333-56cf-4562-8fcb-22ba1bca728d
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2022-08-03
// Tags: attack.discovery
// Description: Detects use of an encoded/obfuscated version of an IP address (hex, octal...) in an URL combined with a download command
// Converted by: Sigma Universal SIEM/EDR CLI

rule cb5a2333_56cf_4562_8fcb_22ba1bca728d {
  meta:
    title = "Obfuscated IP Download Activity"
    description = "Detects use of an encoded/obfuscated version of an IP address (hex, octal...) in an URL combined with a download command"
    author = "Florian Roth (Nextron Systems), X__Junior (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*Invoke-WebRequest.*/ nocase or $e.target.process.command_line = /.*iwr .*/ nocase or $e.target.process.command_line = /.*Invoke-RestMethod.*/ nocase or $e.target.process.command_line = /.*irm .*/ nocase or $e.target.process.command_line = /.*wget .*/ nocase or $e.target.process.command_line = /.*curl .*/ nocase or $e.target.process.command_line = /.*DownloadFile.*/ nocase or $e.target.process.command_line = /.*DownloadString.*/ nocase)) and ((($e.target.process.command_line = /.* 0x.*/ nocase or $e.target.process.command_line = /.*//0x.*/ nocase or $e.target.process.command_line = /.*.0x.*/ nocase or $e.target.process.command_line = /.*.00x.*/ nocase)) or (($e.target.process.command_line = /.*http://%.*/ nocase and $e.target.process.command_line = /.*%2e.*/ nocase)) or (($e.target.process.command_line = /https?://[0-9]{1,3}\.[0-9]{1,3}\.0[0-9]{3,4}/ nocase) or ($e.target.process.command_line = /https?://[0-9]{1,3}\.0[0-9]{3,7}/ nocase) or ($e.target.process.command_line = /https?://0[0-9]{3,11}/ nocase) or ($e.target.process.command_line = /https?://(?:0[0-9]{1,11}\.){3}0[0-9]{1,11}/ nocase) or ($e.target.process.command_line = /https?://0[0-9]{1,11}/ nocase) or ($e.target.process.command_line = / [0-7]{7,13}/ nocase))) and not(($e.target.process.command_line = /https?://(?:(?:25[0-5]|(?:2[0-4]|1\d|[1-9])?\d)(?:\.|\b)){4}/ nocase)))

  condition:
    $e
}
