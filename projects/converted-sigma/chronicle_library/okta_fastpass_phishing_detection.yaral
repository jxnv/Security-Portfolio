rule ee39a9f7_5a79_4b0a_9815_d36b3cf28d3e {
  meta:
    title = "Okta FastPass Phishing Detection"
    description = "Detects when Okta FastPass prevents a known phishing site."
    author = "Austin Songer @austinsonger"
    severity = "HIGH"

  events:
    ($e.outcome.reason = "FastPass declined phishing attempt" and $e.outcome.result = "FAILURE" and $e.eventType = "user.authentication.auth_via_mfa")

  condition:
    $e
}
