// Title: Arbitrary File Download Via ConfigSecurityPolicy.EXE
// ID: 1f0f6176-6482-4027-b151-00071af39d7e
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-11-26
// Tags: attack.exfiltration, attack.t1567
// Description: Detects the execution of "ConfigSecurityPolicy.EXE", a binary part of Windows Defender used to manage settings in Windows Defender.
// Users can configure different pilot collections for each of the co-management workloads.
// It can be abused by attackers in order to upload or download files.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 1f0f6176_6482_4027_b151_00071af39d7e {
  meta:
    title = "Arbitrary File Download Via ConfigSecurityPolicy.EXE"
    description = "Detects the execution of "ConfigSecurityPolicy.EXE", a binary part of Windows Defender used to manage settings in Windows Defender. Users can configure different pilot collections for each of the co-management workloads. It can be abused by attackers in order to upload or download files."
    author = "frack113"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*ConfigSecurityPolicy.exe.*/ nocase) or ($e.target.process.file.full_path = /.*\\ConfigSecurityPolicy.exe$/ nocase) or ($e.target.process.file.name = "ConfigSecurityPolicy.exe")) and (($e.target.process.command_line = /.*ftp://.*/ nocase or $e.target.process.command_line = /.*http://.*/ nocase or $e.target.process.command_line = /.*https://.*/ nocase)))

  condition:
    $e
}
