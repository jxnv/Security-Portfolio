rule 83c17918_746e_4bd9_920b_8e098bf88c23 {
  meta:
    title = "Azure Network Firewall Policy Modified or Deleted"
    description = "Identifies when a Firewall Policy is Modified or Deleted."
    author = "Austin Songer @austinsonger"
    severity = "MEDIUM"

  events:
    (($e.operationName = "MICROSOFT.NETWORK/FIREWALLPOLICIES/WRITE" or $e.operationName = "MICROSOFT.NETWORK/FIREWALLPOLICIES/JOIN/ACTION" or $e.operationName = "MICROSOFT.NETWORK/FIREWALLPOLICIES/CERTIFICATES/ACTION" or $e.operationName = "MICROSOFT.NETWORK/FIREWALLPOLICIES/DELETE"))

  condition:
    $e
}
