// Title: RottenPotato Like Attack Pattern
// ID: 16f5d8ca-44bd-47c8-acbe-6fc95a16c12f
// Status: test
// Level: high
// Author: @SBousseaden, Florian Roth
// Date: 2019-11-15
// Tags: attack.collection, attack.privilege-escalation, attack.credential-access, attack.t1557.001
// Description: Detects logon events that have characteristics of events generated during an attack with RottenPotato and the like
// Converted by: Sigma Universal SIEM/EDR CLI

rule 16f5d8ca_44bd_47c8_acbe_6fc95a16c12f {
  meta:
    title = "RottenPotato Like Attack Pattern"
    description = "Detects logon events that have characteristics of events generated during an attack with RottenPotato and the like"
    author = "@SBousseaden, Florian Roth"
    severity = "HIGH"

  events:
    ($e.EventID = 4624 and $e.LogonType = 3 and $e.TargetUserName = "ANONYMOUS LOGON" and $e.WorkstationName = "-" and ($e.IpAddress = "127.0.0.1" or $e.IpAddress = "::1"))

  condition:
    $e
}
