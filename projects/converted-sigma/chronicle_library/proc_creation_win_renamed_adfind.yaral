// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-08-21
// Tags: attack.discovery, attack.t1018, attack.t1087.002, attack.t1482, attack.t1069.002
// Description: Detects the use of a renamed Adfind.exe. AdFind continues to be seen across majority of breaches. It is used to domain trust discovery to plan out subsequent steps in the attack chain.
// Converted by: Sigma Universal SIEM/EDR CLI

rule df55196f_f105_44d3_a675_e9dfb6cc2f2b {
  meta:
    title = "Renamed AdFind Execution"
    description = "Detects the use of a renamed Adfind.exe. AdFind continues to be seen across majority of breaches. It is used to domain trust discovery to plan out subsequent steps in the attack chain."
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (((($e.target.process.command_line = /.*domainlist.*/ nocase or $e.target.process.command_line = /.*trustdmp.*/ nocase or $e.target.process.command_line = /.*dcmodes.*/ nocase or $e.target.process.command_line = /.*adinfo.*/ nocase or $e.target.process.command_line = /.* dclist .*/ nocase or $e.target.process.command_line = /.*computer_pwdnotreqd.*/ nocase or $e.target.process.command_line = /.*objectcategory=.*/ nocase or $e.target.process.command_line = /.*-subnets -f.*/ nocase or $e.target.process.command_line = /.*name=\"Domain Admins\".*/ nocase or $e.target.process.command_line = /.*-sc u:.*/ nocase or $e.target.process.command_line = /.*domainncs.*/ nocase or $e.target.process.command_line = /.*dompol.*/ nocase or $e.target.process.command_line = /.* oudmp .*/ nocase or $e.target.process.command_line = /.*subnetdmp.*/ nocase or $e.target.process.command_line = /.*gpodmp.*/ nocase or $e.target.process.command_line = /.*fspdmp.*/ nocase or $e.target.process.command_line = /.*users_noexpire.*/ nocase or $e.target.process.command_line = /.*computers_active.*/ nocase or $e.target.process.command_line = /.*computers_pwdnotreqd.*/ nocase)) or (($e.Hashes = /.*IMPHASH=BCA5675746D13A1F246E2DA3C2217492.*/ nocase or $e.Hashes = /.*IMPHASH=53E117A96057EAF19C41380D0E87F1C2.*/ nocase or $e.Hashes = /.*IMPHASH=d144de8117df2beceaba2201ad304764.*/ nocase or $e.Hashes = /.*IMPHASH=12ce1c0f3f5837ecc18a3782408fa975.*/ nocase or $e.Hashes = /.*IMPHASH=4fbf3f084fbbb2470b80b2013134df35.*/ nocase or $e.Hashes = /.*IMPHASH=49b639b4acbecc49d72a01f357aa4930.*/ nocase or $e.Hashes = /.*IMPHASH=680dad9e300346e05a85023965867201.*/ nocase or $e.Hashes = /.*IMPHASH=21aa085d54992511b9f115355e468782.*/ nocase)) or ($e.target.process.file.name = "AdFind.exe")) and not(($e.target.process.file.full_path = /.*\\AdFind.exe$/ nocase)))

  condition:
    $e
}
