// Title: File With Uncommon Extension Created By An Office Application
// ID: c7a74c80-ba5a-486e-9974-ab9e682bc5e4
// Status: test
// Level: high
// Author: Vadim Khrykov (ThreatIntel), Cyb3rEng (Rule), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-08-23
// Tags: attack.t1204.002, attack.execution
// Description: Detects the creation of files with an executable or script extension by an Office application.
// Converted by: Sigma Universal SIEM/EDR CLI

rule c7a74c80_ba5a_486e_9974_ab9e682bc5e4 {
  meta:
    title = "File With Uncommon Extension Created By An Office Application"
    description = "Detects the creation of files with an executable or script extension by an Office application."
    author = "Vadim Khrykov (ThreatIntel), Cyb3rEng (Rule), Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    (((($e.target.process.file.full_path = /.*\\excel.exe$/ nocase or $e.target.process.file.full_path = /.*\\msaccess.exe$/ nocase or $e.target.process.file.full_path = /.*\\mspub.exe$/ nocase or $e.target.process.file.full_path = /.*\\powerpnt.exe$/ nocase or $e.target.process.file.full_path = /.*\\visio.exe$/ nocase or $e.target.process.file.full_path = /.*\\winword.exe$/ nocase)) and (($e.target.file.full_path = /.*.bat$/ nocase or $e.target.file.full_path = /.*.cmd$/ nocase or $e.target.file.full_path = /.*.com$/ nocase or $e.target.file.full_path = /.*.dll$/ nocase or $e.target.file.full_path = /.*.exe$/ nocase or $e.target.file.full_path = /.*.hta$/ nocase or $e.target.file.full_path = /.*.ocx$/ nocase or $e.target.file.full_path = /.*.proj$/ nocase or $e.target.file.full_path = /.*.ps1$/ nocase or $e.target.file.full_path = /.*.scf$/ nocase or $e.target.file.full_path = /.*.scr$/ nocase or $e.target.file.full_path = /.*.sys$/ nocase or $e.target.file.full_path = /.*.vbe$/ nocase or $e.target.file.full_path = /.*.vbs$/ nocase or $e.target.file.full_path = /.*.wsf$/ nocase or $e.target.file.full_path = /.*.wsh$/ nocase))) and not(($e.target.file.full_path = /.*\\AppData\\Local\\assembly\\tmp\\.*/ nocase and $e.target.file.full_path = /.*.dll$/ nocase)) and not(((($e.target.file.full_path = /.*C:\\Users\\.*/ nocase and $e.target.file.full_path = /.*\\AppData\\Local\\Microsoft\\Office\\.*/ nocase and $e.target.file.full_path = /.*\\BackstageInAppNavCache\\.*/ nocase) and $e.target.file.full_path = /.*.com$/ nocase) or ($e.target.process.file.full_path = /.*\\winword.exe$/ nocase and $e.target.file.full_path = /.*\\AppData\\Local\\Temp\\webexdelta\\.*/ nocase and ($e.target.file.full_path = /.*.dll$/ nocase or $e.target.file.full_path = /.*.exe$/ nocase)) or (($e.target.file.full_path = /.*C:\\Users\\.*/ nocase and $e.target.file.full_path = /.*\\AppData\\Local\\Microsoft\\Office\\.*/ nocase and $e.target.file.full_path = /.*\\WebServiceCache\\AllUsers.*/ nocase) and $e.target.file.full_path = /.*.com$/ nocase))))

  condition:
    $e
}
