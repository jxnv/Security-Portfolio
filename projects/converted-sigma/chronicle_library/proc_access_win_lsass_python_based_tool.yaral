// Title: Credential Dumping Activity By Python Based Tool
// ID: f8be3e82-46a3-4e4e-ada5-8e538ae8b9c9
// Status: stable
// Level: high
// Author: Bhabesh Raj, Jonhnathan Ribeiro
// Date: 2023-11-27
// Tags: attack.credential-access, attack.t1003.001, attack.s0349
// Description: Detects LSASS process access for potential credential dumping by a Python-like tool such as LaZagne or Pypykatz.
// Converted by: Sigma Universal SIEM/EDR CLI

rule f8be3e82_46a3_4e4e_ada5_8e538ae8b9c9 {
  meta:
    title = "Credential Dumping Activity By Python Based Tool"
    description = "Detects LSASS process access for potential credential dumping by a Python-like tool such as LaZagne or Pypykatz."
    author = "Bhabesh Raj, Jonhnathan Ribeiro"
    severity = "HIGH"

  events:
    ($e.TargetImage = /.*\\lsass.exe$/ nocase and ($e.CallTrace = /.*_ctypes.pyd+.*/ nocase and $e.CallTrace = /.*:\\Windows\\System32\\KERNELBASE.dll+.*/ nocase and $e.CallTrace = /.*:\\Windows\\SYSTEM32\\ntdll.dll+.*/ nocase) and ($e.CallTrace = /.*python27.dll+.*/ nocase or $e.CallTrace = /.*python3*.dll+.*/ nocase) and $e.GrantedAccess = "0x1FFFFF")

  condition:
    $e
}
