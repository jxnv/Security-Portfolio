// Title: Suspicious Non PowerShell WSMAN COM Provider
// ID: df9a0e0e-fedb-4d6c-8668-d765dfc92aa7
// Status: test
// Level: medium
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2020-06-24
// Tags: attack.execution, attack.t1059.001, attack.lateral-movement, attack.t1021.003
// Description: Detects suspicious use of the WSMAN provider without PowerShell.exe as the host application.
// Converted by: Sigma Universal SIEM/EDR CLI

rule df9a0e0e_fedb_4d6c_8668_d765dfc92aa7 {
  meta:
    title = "Suspicious Non PowerShell WSMAN COM Provider"
    description = "Detects suspicious use of the WSMAN provider without PowerShell.exe as the host application."
    author = "Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)"
    severity = "MEDIUM"

  events:
    (($e.Data = /.*ProviderName=WSMan.*/ nocase) and not((($e.Data = /HostId=[a-zA-Z0-9-]{36}\s+EngineVersion=/ nocase) or (($e.Data = /.*HostApplication=powershell.*/ nocase or $e.Data = /.*HostApplication=C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.*/ nocase or $e.Data = /.*HostApplication=C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.*/ nocase or $e.Data = /.*HostApplication=C:/Windows/System32/WindowsPowerShell/v1.0/powershell.*/ nocase or $e.Data = /.*HostApplication=C:/Windows/SysWOW64/WindowsPowerShell/v1.0/powershell.*/ nocase)))) and not(($e.Data = /.*HostApplication=C:\\Hexnode\\Hexnode Agent\\Current\\HexnodeAgent.exe.*/ nocase)))

  condition:
    $e
}
