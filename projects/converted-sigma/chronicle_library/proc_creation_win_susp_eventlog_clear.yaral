// Title: Suspicious Eventlog Clearing or Configuration Change Activity
// ID: cc36992a-4671-4f21-a91d-6c2b72a2edf5
// Status: stable
// Level: high
// Author: Ecco, Daniil Yugoslavskiy, oscd.community, D3F7A5105, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2019-09-26
// Tags: attack.defense-impairment, attack.t1685.005, attack.t1685.001, car.2016-04-002
// Description: Detects the clearing or configuration tampering of EventLog using utilities such as "wevtutil", "powershell" and "wmic".
// This technique were seen used by threat actors and ransomware strains in order to evade defenses.
// Converted by: Sigma Universal SIEM/EDR CLI

rule cc36992a_4671_4f21_a91d_6c2b72a2edf5 {
  meta:
    title = "Suspicious Eventlog Clearing or Configuration Change Activity"
    description = "Detects the clearing or configuration tampering of EventLog using utilities such as "wevtutil", "powershell" and "wmic". This technique were seen used by threat actors and ransomware strains in order to evade defenses."
    author = "Ecco, Daniil Yugoslavskiy, oscd.community, D3F7A5105, Swachchhanda Shrawan Poudel (Nextron Systems)"
    severity = "HIGH"

  events:
    ((((($e.target.process.command_line = /.*clear-log .*/ nocase or $e.target.process.command_line = /.* cl .*/ nocase or $e.target.process.command_line = /.*set-log .*/ nocase or $e.target.process.command_line = /.* sl .*/ nocase or $e.target.process.command_line = /.*lfn:.*/ nocase)) and (($e.target.process.file.full_path = /.*\\wevtutil.exe$/ nocase) or ($e.target.process.file.name = "wevtutil.exe"))) or (((($e.target.process.command_line = /.*Clear-EventLog .*/ nocase or $e.target.process.command_line = /.*Remove-EventLog .*/ nocase or $e.target.process.command_line = /.*Limit-EventLog .*/ nocase or $e.target.process.command_line = /.*Clear-WinEvent .*/ nocase)) or (($e.target.process.command_line = /.*Eventing.Reader.EventLogSession.*/ nocase and $e.target.process.command_line = /.*ClearLog.*/ nocase)) or (($e.target.process.command_line = /.*Diagnostics.EventLog.*/ nocase and $e.target.process.command_line = /.*Clear.*/ nocase))) and (($e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell_ise.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase))) or (($e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell_ise.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase or $e.target.process.file.full_path = /.*\\wmic.exe$/ nocase) and $e.target.process.command_line = /.*ClearEventLog.*/ nocase)) and not((($e.principal.process.file.full_path = "C:\\Windows\\SysWOW64\\msiexec.exe" or $e.principal.process.file.full_path = "C:\\Windows\\System32\\msiexec.exe") and $e.target.process.command_line = /.* sl .*/ nocase)))

  condition:
    $e
}
