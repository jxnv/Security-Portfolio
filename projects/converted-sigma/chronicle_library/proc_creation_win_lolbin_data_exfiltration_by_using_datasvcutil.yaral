// Tags: attack.exfiltration, attack.t1567
// Description: Detects when a user performs data exfiltration by using DataSvcUtil.exe
// Converted by: Sigma Universal SIEM/EDR CLI

rule e290b10b_1023_4452_a4a9_eb31a9013b3a {
  meta:
    title = "LOLBAS Data Exfiltration by DataSvcUtil.exe"
    description = "Detects when a user performs data exfiltration by using DataSvcUtil.exe"
    author = "Ialle Teixeira @teixeira0xfffff, Austin Songer @austinsonger"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*/in:.*/ nocase or $e.target.process.command_line = /.*/out:.*/ nocase or $e.target.process.command_line = /.*/uri:.*/ nocase)) and (($e.target.process.file.full_path = /.*\\DataSvcUtil.exe$/ nocase) or ($e.target.process.file.name = "DataSvcUtil.exe")))

  condition:
    $e
}
