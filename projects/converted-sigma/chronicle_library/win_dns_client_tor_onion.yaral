// Title: Query Tor Onion Address - DNS Client
// ID: 8384bd26-bde6-4da9-8e5d-4174a7a47ca2
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-02-20
// Tags: attack.command-and-control, attack.t1090.003
// Description: Detects DNS resolution of an .onion address related to Tor routing networks
// Converted by: Sigma Universal SIEM/EDR CLI

rule 8384bd26_bde6_4da9_8e5d_4174a7a47ca2 {
  meta:
    title = "Query Tor Onion Address - DNS Client"
    description = "Detects DNS resolution of an .onion address related to Tor routing networks"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ($e.EventID = 3008 and ($e.QueryName = /.*.hiddenservice.net$/ nocase or $e.QueryName = /.*.onion.ca$/ nocase or $e.QueryName = /.*.onion.cab$/ nocase or $e.QueryName = /.*.onion.casa$/ nocase or $e.QueryName = /.*.onion.city$/ nocase or $e.QueryName = /.*.onion.direct$/ nocase or $e.QueryName = /.*.onion.dog$/ nocase or $e.QueryName = /.*.onion.glass$/ nocase or $e.QueryName = /.*.onion.gq$/ nocase or $e.QueryName = /.*.onion.guide$/ nocase or $e.QueryName = /.*.onion.in.net$/ nocase or $e.QueryName = /.*.onion.ink$/ nocase or $e.QueryName = /.*.onion.it$/ nocase or $e.QueryName = /.*.onion.link$/ nocase or $e.QueryName = /.*.onion.lt$/ nocase or $e.QueryName = /.*.onion.lu$/ nocase or $e.QueryName = /.*.onion.ly$/ nocase or $e.QueryName = /.*.onion.mn$/ nocase or $e.QueryName = /.*.onion.network$/ nocase or $e.QueryName = /.*.onion.nu$/ nocase or $e.QueryName = /.*.onion.pet$/ nocase or $e.QueryName = /.*.onion.plus$/ nocase or $e.QueryName = /.*.onion.pt$/ nocase or $e.QueryName = /.*.onion.pw$/ nocase or $e.QueryName = /.*.onion.rip$/ nocase or $e.QueryName = /.*.onion.sh$/ nocase or $e.QueryName = /.*.onion.si$/ nocase or $e.QueryName = /.*.onion.to$/ nocase or $e.QueryName = /.*.onion.top$/ nocase or $e.QueryName = /.*.onion.ws$/ nocase or $e.QueryName = /.*.onion$/ nocase or $e.QueryName = /.*.s1.tor-gateways.de$/ nocase or $e.QueryName = /.*.s2.tor-gateways.de$/ nocase or $e.QueryName = /.*.s3.tor-gateways.de$/ nocase or $e.QueryName = /.*.s4.tor-gateways.de$/ nocase or $e.QueryName = /.*.s5.tor-gateways.de$/ nocase or $e.QueryName = /.*.t2w.pw$/ nocase or $e.QueryName = /.*.tor2web.ae.org$/ nocase or $e.QueryName = /.*.tor2web.blutmagie.de$/ nocase or $e.QueryName = /.*.tor2web.com$/ nocase or $e.QueryName = /.*.tor2web.fi$/ nocase or $e.QueryName = /.*.tor2web.io$/ nocase or $e.QueryName = /.*.tor2web.org$/ nocase or $e.QueryName = /.*.tor2web.xyz$/ nocase or $e.QueryName = /.*.torlink.co$/ nocase))

  condition:
    $e
}
