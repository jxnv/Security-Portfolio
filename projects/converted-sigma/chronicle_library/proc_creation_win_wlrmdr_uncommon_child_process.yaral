// Title: Wlrmdr.EXE Uncommon Argument Or Child Process
// ID: 9cfc00b6-bfb7-49ce-9781-ef78503154bb
// Status: experimental
// Level: medium
// Author: frack113, manasmbellani
// Date: 2022-02-16
// Tags: attack.stealth, attack.t1218
// Description: Detects the execution of "Wlrmdr.exe" with the "-u" command line flag which allows anything passed to it to be an argument of the ShellExecute API, which would allow an attacker to execute arbitrary binaries.
// This detection also focuses on any uncommon child processes spawned from "Wlrmdr.exe" as a supplement for those that posses "ParentImage" telemetry.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 9cfc00b6_bfb7_49ce_9781_ef78503154bb {
  meta:
    title = "Wlrmdr.EXE Uncommon Argument Or Child Process"
    description = "Detects the execution of "Wlrmdr.exe" with the "-u" command line flag which allows anything passed to it to be an argument of the ShellExecute API, which would allow an attacker to execute arbitrary binaries. This detection also focuses on any uncommon child processes spawned from "Wlrmdr.exe" as a supplement for those that posses "ParentImage" telemetry."
    author = "frack113, manasmbellani"
    severity = "MEDIUM"

  events:
    (($e.principal.process.file.full_path = /.*\\wlrmdr.exe$/ nocase) or (((($e.target.process.command_line = /.*-a .*/ nocase or $e.target.process.command_line = /.*/a .*/ nocase)) and (($e.target.process.command_line = /.*-f .*/ nocase or $e.target.process.command_line = /.*/f .*/ nocase)) and (($e.target.process.command_line = /.*-m .*/ nocase or $e.target.process.command_line = /.*/m .*/ nocase)) and (($e.target.process.command_line = /.*-s .*/ nocase or $e.target.process.command_line = /.*/s .*/ nocase)) and (($e.target.process.command_line = /.*-t .*/ nocase or $e.target.process.command_line = /.*/t .*/ nocase)) and (($e.target.process.command_line = /.*-u .*/ nocase or $e.target.process.command_line = /.*/u .*/ nocase)) and (($e.target.process.file.full_path = /.*\\wlrmdr.exe$/ nocase) or ($e.target.process.file.name = "WLRMNDR.EXE"))) and not(((($e.principal.process.file.full_path = "" or $e.principal.process.file.full_path = "-")) or (not ($e.principal.process.file.full_path = /.*/)) or ($e.principal.process.file.full_path = "C:\\Windows\\System32\\winlogon.exe")))))

  condition:
    $e
}
