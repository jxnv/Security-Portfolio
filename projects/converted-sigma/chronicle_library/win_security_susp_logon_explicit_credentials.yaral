// Title: Suspicious Remote Logon with Explicit Credentials
// ID: 941e5c45-cda7-4864-8cea-bbb7458d194a
// Status: test
// Level: medium
// Author: oscd.community, Teymur Kheirkhabarov @HeirhabarovT, Zach Stanford @svch0st, Tim Shelton
// Date: 2020-10-05
// Tags: attack.privilege-escalation, attack.persistence, attack.initial-access, attack.stealth, attack.t1078, attack.lateral-movement
// Description: Detects suspicious processes logging on with explicit credentials
// Converted by: Sigma Universal SIEM/EDR CLI

rule 941e5c45_cda7_4864_8cea_bbb7458d194a {
  meta:
    title = "Suspicious Remote Logon with Explicit Credentials"
    description = "Detects suspicious processes logging on with explicit credentials"
    author = "oscd.community, Teymur Kheirkhabarov @HeirhabarovT, Zach Stanford @svch0st, Tim Shelton"
    severity = "MEDIUM"

  events:
    (($e.EventID = 4648 and ($e.ProcessName = /.*\\cmd.exe$/ nocase or $e.ProcessName = /.*\\powershell.exe$/ nocase or $e.ProcessName = /.*\\pwsh.exe$/ nocase or $e.ProcessName = /.*\\winrs.exe$/ nocase or $e.ProcessName = /.*\\wmic.exe$/ nocase or $e.ProcessName = /.*\\net.exe$/ nocase or $e.ProcessName = /.*\\net1.exe$/ nocase or $e.ProcessName = /.*\\reg.exe$/ nocase)) and not((($e.TargetServerName = "localhost") or ($e.SubjectUserName = /.*$$/ nocase and $e.TargetUserName = /.*$$/ nocase))))

  condition:
    $e
}
