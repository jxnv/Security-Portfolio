// Title: Google Cloud Service Account Modified
// ID: 6b67c12e-5e40-47c6-b3b0-1e6b571184cc
// Status: test
// Level: medium
// Author: Austin Songer @austinsonger
// Date: 2021-08-14
// Tags: attack.impact
// Description: Identifies when a service account is modified in Google Cloud.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 6b67c12e_5e40_47c6_b3b0_1e6b571184cc {
  meta:
    title = "Google Cloud Service Account Modified"
    description = "Identifies when a service account is modified in Google Cloud."
    author = "Austin Songer @austinsonger"
    severity = "MEDIUM"

  events:
    (($e.gcp.audit.method_name = /.*.serviceAccounts.patch$/ nocase or $e.gcp.audit.method_name = /.*.serviceAccounts.create$/ nocase or $e.gcp.audit.method_name = /.*.serviceAccounts.update$/ nocase or $e.gcp.audit.method_name = /.*.serviceAccounts.enable$/ nocase or $e.gcp.audit.method_name = /.*.serviceAccounts.undelete$/ nocase))

  condition:
    $e
}
