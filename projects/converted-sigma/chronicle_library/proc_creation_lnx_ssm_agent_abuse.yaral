rule f9b3edc5_3322_4fc7_8aa3_245d646cc4b7 {
  meta:
    title = "Potential Linux Amazon SSM Agent Hijacking"
    description = "Detects potential Amazon SSM agent hijack attempts as outlined in the Mitiga research report."
    author = "Muhammad Faisal"
    severity = "MEDIUM"

  events:
    ($e.target.process.file.full_path = /.*/amazon-ssm-agent$/ nocase and ($e.target.process.command_line = /.*-register .*/ nocase and $e.target.process.command_line = /.*-code .*/ nocase and $e.target.process.command_line = /.*-id .*/ nocase and $e.target.process.command_line = /.*-region .*/ nocase))

  condition:
