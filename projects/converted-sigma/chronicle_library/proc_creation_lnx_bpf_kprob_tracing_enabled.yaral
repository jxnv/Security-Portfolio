// Title: Enable BPF Kprobes Tracing
// ID: 7692f583-bd30-4008-8615-75dab3f08a99
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-25
// Tags: attack.execution, attack.stealth
// Description: Detects common command used to enable bpf kprobes tracing
// Converted by: Sigma Universal SIEM/EDR CLI

rule 7692f583_bd30_4008_8615_75dab3f08a99 {
  meta:
    title = "Enable BPF Kprobes Tracing"
    description = "Detects common command used to enable bpf kprobes tracing"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.target.process.command_line = /.*echo 1 >.*/ nocase and $e.target.process.command_line = /.*/sys/kernel/debug/tracing/events/kprobes/.*/ nocase) and ($e.target.process.command_line = /.*/myprobe/enable.*/ nocase or $e.target.process.command_line = /.*/myretprobe/enable.*/ nocase))

  condition:
    $e
}
