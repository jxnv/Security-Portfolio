rule 7c797da2_9cf2_4523_ba64_33b06339f0cc {
  meta:
    title = "AWS ElastiCache Security Group Modified or Deleted"
    description = "Identifies when an ElastiCache security group has been modified or deleted."
    author = "Austin Songer @austinsonger"
    severity = "LOW"

  events:
    ($e.eventSource = "elasticache.amazonaws.com" and ($e.eventName = "DeleteCacheSecurityGroup" or $e.eventName = "AuthorizeCacheSecurityGroupIngress" or $e.eventName = "RevokeCacheSecurityGroupIngress" or $e.eventName = "AuthorizeCacheSecurityGroupEgress" or $e.eventName = "RevokeCacheSecurityGroupEgress"))

  condition:
    $e
}
