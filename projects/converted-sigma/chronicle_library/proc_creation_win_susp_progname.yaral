// Title: Suspicious Program Names
// ID: efdd8dd5-cee8-4e59-9390-7d4d5e4dd6f6
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-11
// Tags: attack.execution, attack.t1059
// Description: Detects suspicious patterns in program names or folders that are often found in malicious samples or hacktools
// Converted by: Sigma Universal SIEM/EDR CLI

rule efdd8dd5_cee8_4e59_9390_7d4d5e4dd6f6 {
  meta:
    title = "Suspicious Program Names"
    description = "Detects suspicious patterns in program names or folders that are often found in malicious samples or hacktools"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*inject.ps1.*/ nocase or $e.target.process.command_line = /.*Invoke-CVE.*/ nocase or $e.target.process.command_line = /.*pupy.ps1.*/ nocase or $e.target.process.command_line = /.*payload.ps1.*/ nocase or $e.target.process.command_line = /.*beacon.ps1.*/ nocase or $e.target.process.command_line = /.*PowerView.ps1.*/ nocase or $e.target.process.command_line = /.*bypass.ps1.*/ nocase or $e.target.process.command_line = /.*obfuscated.ps1.*/ nocase or $e.target.process.command_line = /.*obfusc.ps1.*/ nocase or $e.target.process.command_line = /.*obfus.ps1.*/ nocase or $e.target.process.command_line = /.*obfs.ps1.*/ nocase or $e.target.process.command_line = /.*evil.ps1.*/ nocase or $e.target.process.command_line = /.*MiniDogz.ps1.*/ nocase or $e.target.process.command_line = /.*_enc.ps1.*/ nocase or $e.target.process.command_line = /.*\\shell.ps1.*/ nocase or $e.target.process.command_line = /.*\\rshell.ps1.*/ nocase or $e.target.process.command_line = /.*revshell.ps1.*/ nocase or $e.target.process.command_line = /.*\\av.ps1.*/ nocase or $e.target.process.command_line = /.*\\av_test.ps1.*/ nocase or $e.target.process.command_line = /.*adrecon.ps1.*/ nocase or $e.target.process.command_line = /.*mimikatz.ps1.*/ nocase or $e.target.process.command_line = /.*\\PowerUp_.*/ nocase or $e.target.process.command_line = /.*powerup.ps1.*/ nocase or $e.target.process.command_line = /.*\\Temp\\a.ps1.*/ nocase or $e.target.process.command_line = /.*\\Temp\\p.ps1.*/ nocase or $e.target.process.command_line = /.*\\Temp\\1.ps1.*/ nocase or $e.target.process.command_line = /.*Hound.ps1.*/ nocase or $e.target.process.command_line = /.*encode.ps1.*/ nocase or $e.target.process.command_line = /.*powercat.ps1.*/ nocase)) or ((($e.target.process.file.full_path = /.*\\CVE-202.*/ nocase or $e.target.process.file.full_path = /.*\\CVE202.*/ nocase)) or (($e.target.process.file.full_path = /.*\\poc.exe$/ nocase or $e.target.process.file.full_path = /.*\\artifact.exe$/ nocase or $e.target.process.file.full_path = /.*\\artifact64.exe$/ nocase or $e.target.process.file.full_path = /.*\\artifact_protected.exe$/ nocase or $e.target.process.file.full_path = /.*\\artifact32.exe$/ nocase or $e.target.process.file.full_path = /.*\\artifact32big.exe$/ nocase or $e.target.process.file.full_path = /.*obfuscated.exe$/ nocase or $e.target.process.file.full_path = /.*obfusc.exe$/ nocase or $e.target.process.file.full_path = /.*\\meterpreter$/ nocase))))

  condition:
    $e
}
