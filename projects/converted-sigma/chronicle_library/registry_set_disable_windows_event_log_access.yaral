// Title: Windows Event Log Access Tampering Via Registry
// ID: ba226dcf-d390-4642-b9af-b534872f1156
// Status: experimental
// Level: high
// Author: X__Junior
// Date: 2025-01-16
// Tags: attack.privilege-escalation, attack.persistence, attack.defense-impairment, attack.t1547.001, attack.t1112
// Description: Detects changes to the Windows EventLog channel permission values. It focuses on changes to the Security Descriptor Definition Language (SDDL) string, as modifications to these values can restrict access to specific users or groups, potentially aiding in defense evasion by controlling who can view or modify a event log channel. Upon execution, the user shouldn't be able to access the event log channel via the event viewer or via utilities such as "Get-EventLog" or "wevtutil".
// Converted by: Sigma Universal SIEM/EDR CLI

rule ba226dcf_d390_4642_b9af_b534872f1156 {
  meta:
    title = "Windows Event Log Access Tampering Via Registry"
    description = "Detects changes to the Windows EventLog channel permission values. It focuses on changes to the Security Descriptor Definition Language (SDDL) string, as modifications to these values can restrict access to specific users or groups, potentially aiding in defense evasion by controlling who can view or modify a event log channel. Upon execution, the user shouldn't be able to access the event log channel via the event viewer or via utilities such as "Get-EventLog" or "wevtutil"."
    author = "X__Junior"
    severity = "HIGH"

  events:
    ((($e.TargetObject = /.*\\SYSTEM\\CurrentControlSet\\Services\\EventLog\\.*/ nocase and $e.TargetObject = /.*\\CustomSD$/ nocase) or (($e.TargetObject = /.*\\Policies\\Microsoft\\Windows\\EventLog\\.*/ nocase or $e.TargetObject = /.*\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels.*/ nocase) and $e.TargetObject = /.*\\ChannelAccess$/ nocase)) and (($e.Details = /.*D:(D;.*/ nocase) or (($e.Details = /.*D:(.*/ nocase and $e.Details = /.*)(D;.*/ nocase))) and not((($e.target.process.file.full_path = /^C:\\Windows\\WinSxS\\.*/ nocase and $e.target.process.file.full_path = /.*\\TiWorker.exe$/ nocase) or ($e.target.process.file.full_path = "C:\\Windows\\servicing\\TrustedInstaller.exe"))) and not((($e.target.process.file.full_path = "") or (not ($e.target.process.file.full_path = /.*/)))))

  condition:
    $e
}
