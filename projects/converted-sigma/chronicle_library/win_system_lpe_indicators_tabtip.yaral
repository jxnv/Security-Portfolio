// Description: Detects the invocation of TabTip via CLSID as seen when JuicyPotatoNG is used on a system in brute force mode
// Converted by: Sigma Universal SIEM/EDR CLI

rule bc2e25ed_b92b_4daa_b074_b502bdd1982b {
  meta:
    title = "Local Privilege Escalation Indicator TabTip"
    description = "Detects the invocation of TabTip via CLSID as seen when JuicyPotatoNG is used on a system in brute force mode"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    ($e.Provider_Name = "Microsoft-Windows-DistributedCOM" and $e.EventID = 10001 and $e.param1 = "C:\\Program Files\\Common Files\\microsoft shared\\ink\\TabTip.exe" and $e.param2 = 2147943140 and $e.param3 = "{054AAE20-4BEA-4347-8A35-64A533254A9D}")

  condition:
    $e
}
