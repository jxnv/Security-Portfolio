// Tags: attack.privilege-escalation
// Description: Detects possible suspicious glue development endpoint activity.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 4990c2e3_f4b8_45e3_bc3c_30b14ff0ed26 {
  meta:
    title = "AWS Glue Development Endpoint Activity"
    description = "Detects possible suspicious glue development endpoint activity."
    author = "Austin Songer @austinsonger"
    severity = "LOW"

  events:
    ($e.eventSource = "glue.amazonaws.com" and ($e.eventName = "CreateDevEndpoint" or $e.eventName = "DeleteDevEndpoint" or $e.eventName = "UpdateDevEndpoint"))

  condition:
    $e
}
