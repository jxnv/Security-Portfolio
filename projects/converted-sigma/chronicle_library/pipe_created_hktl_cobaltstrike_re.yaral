// Title: CobaltStrike Named Pipe Pattern Regex
// ID: 0e7163d4-9e19-4fa7-9be6-000c61aad77a
// Status: test
// Level: critical
// Author: Florian Roth (Nextron Systems)
// Date: 2021-07-30
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects the creation of a named pipe matching a pattern used by CobaltStrike Malleable C2 profiles
// Converted by: Sigma Universal SIEM/EDR CLI

rule 0e7163d4_9e19_4fa7_9be6_000c61aad77a {
  meta:
    title = "CobaltStrike Named Pipe Pattern Regex"
    description = "Detects the creation of a named pipe matching a pattern used by CobaltStrike Malleable C2 profiles"
    author = "Florian Roth (Nextron Systems)"
    severity = "CRITICAL"

  events:
    (($e.PipeName = /\\mojo\.5688\.8052\.(?:183894939787088877|35780273329370473)[0-9a-f]{2}/ nocase) or ($e.PipeName = /\\wkssvc_?[0-9a-f]{2}/ nocase) or ($e.PipeName = /\\ntsvcs[0-9a-f]{2}/ nocase) or ($e.PipeName = /\\DserNamePipe[0-9a-f]{2}/ nocase) or ($e.PipeName = /\\SearchTextHarvester[0-9a-f]{2}/ nocase) or ($e.PipeName = /\\mypipe-(?:f|h)[0-9a-f]{2}/ nocase) or ($e.PipeName = /\\windows\.update\.manager[0-9a-f]{2,3}/ nocase) or ($e.PipeName = /\\ntsvcs_[0-9a-f]{2}/ nocase) or ($e.PipeName = /\\scerpc_?[0-9a-f]{2}/ nocase) or ($e.PipeName = /\\PGMessagePipe[0-9a-f]{2}/ nocase) or ($e.PipeName = /\\MsFteWds[0-9a-f]{2}/ nocase) or ($e.PipeName = /\\f4c3[0-9a-f]{2}/ nocase) or ($e.PipeName = /\\fullduplex_[0-9a-f]{2}/ nocase) or ($e.PipeName = /\\msrpc_[0-9a-f]{4}/ nocase) or ($e.PipeName = /\\win\\msrpc_[0-9a-f]{2}/ nocase) or ($e.PipeName = /\\f53f[0-9a-f]{2}$/ nocase) or ($e.PipeName = /\\rpc_[0-9a-f]{2}/ nocase) or ($e.PipeName = /\\spoolss_[0-9a-f]{2}/ nocase) or ($e.PipeName = /\\Winsock2\\CatalogChangeListener-[0-9a-f]{3}-0,/ nocase))

  condition:
    $e
}
