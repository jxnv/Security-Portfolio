// Title: Renamed NirCmd.EXE Execution
// ID: 264982dc-dbad-4dce-b707-1e0d3e0f73d9
// Status: test
// Level: high
// Author: X__Junior (Nextron Systems)
// Date: 2024-03-11
// Tags: attack.execution, attack.stealth, attack.t1059, attack.t1202
// Description: Detects the execution of a renamed "NirCmd.exe" binary based on the PE metadata fields.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 264982dc_dbad_4dce_b707_1e0d3e0f73d9 {
  meta:
    title = "Renamed NirCmd.EXE Execution"
    description = "Detects the execution of a renamed "NirCmd.exe" binary based on the PE metadata fields."
    author = "X__Junior (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.file.name = "NirCmd.exe") and not((($e.target.process.file.full_path = /.*\\nircmd.exe$/ nocase or $e.target.process.file.full_path = /.*\\nircmdc.exe$/ nocase))))

  condition:
    $e
}
