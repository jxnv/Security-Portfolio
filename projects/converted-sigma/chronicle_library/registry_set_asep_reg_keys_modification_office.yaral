// Title: Office Autorun Keys Modification
// ID: baecf8fb-edbf-429f-9ade-31fc3f22b970
// Status: test
// Level: medium
// Author: Victor Sergeev, Daniil Yugoslavskiy, Gleb Sukhodolskiy, Timur Zinniatullin, oscd.community, Tim Shelton, frack113 (split)
// Date: 2019-10-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects modification of autostart extensibility point (ASEP) in registry. Adversaries may modify these keys to execute malicious code when Office files are opened.
// There are various legitimate add-ins that also use these keys and this filter list might not be exhaustive.
// Thus, it is recommended to review and tune filters for your environment to reduce false positives before deploying to production.
// Converted by: Sigma Universal SIEM/EDR CLI

rule baecf8fb_edbf_429f_9ade_31fc3f22b970 {
  meta:
    title = "Office Autorun Keys Modification"
    description = "Detects modification of autostart extensibility point (ASEP) in registry. Adversaries may modify these keys to execute malicious code when Office files are opened. There are various legitimate add-ins that also use these keys and this filter list might not be exhaustive. Thus, it is recommended to review and tune filters for your environment to reduce false positives before deploying to production."
    author = "Victor Sergeev, Daniil Yugoslavskiy, Gleb Sukhodolskiy, Timur Zinniatullin, oscd.community, Tim Shelton, frack113 (split)"
    severity = "MEDIUM"

  events:
    (((($e.TargetObject = /.*\\Word\\Addins.*/ nocase or $e.TargetObject = /.*\\PowerPoint\\Addins.*/ nocase or $e.TargetObject = /.*\\Outlook\\Addins.*/ nocase or $e.TargetObject = /.*\\Onenote\\Addins.*/ nocase or $e.TargetObject = /.*\\Excel\\Addins.*/ nocase or $e.TargetObject = /.*\\Access\\Addins.*/ nocase or $e.TargetObject = /.*test\\Special\\Perf.*/ nocase)) and (($e.TargetObject = /.*\\Software\\Wow6432Node\\Microsoft\\Office.*/ nocase or $e.TargetObject = /.*\\Software\\Microsoft\\Office.*/ nocase))) and not((($e.Details = "(Empty)") or (($e.target.process.file.full_path = /^C:\\Program Files\\Microsoft Office\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files (x86)\\Microsoft Office\\.*/ nocase or $e.target.process.file.full_path = /^C:\\PROGRA~2\\MICROS~2\\Office.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\System32\\msiexec.exe.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\SysWOW64\\msiexec.exe.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\System32\\regsvr32.exe.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\SysWOW64\\regsvr32.exe.*/ nocase) and ($e.TargetObject = /.*\\Excel\\Addins\\AdHocReportingExcelClientLib.AdHocReportingExcelClientAddIn.1\\.*/ nocase or $e.TargetObject = /.*\\Excel\\Addins\\ExcelPlugInShell.PowerMapConnect\\.*/ nocase or $e.TargetObject = /.*\\Excel\\Addins\\NativeShim\\.*/ nocase or $e.TargetObject = /.*\\Excel\\Addins\\NativeShim.InquireConnector.1\\.*/ nocase or $e.TargetObject = /.*\\Excel\\Addins\\PowerPivotExcelClientAddIn.NativeEntry.1\\.*/ nocase or $e.TargetObject = /.*\\Outlook\\AddIns\\AccessAddin.DC\\.*/ nocase or $e.TargetObject = /.*\\Outlook\\AddIns\\ColleagueImport.ColleagueImportAddin\\.*/ nocase or $e.TargetObject = /.*\\Outlook\\AddIns\\EvernoteCC.EvernoteContactConnector\\.*/ nocase or $e.TargetObject = /.*\\Outlook\\AddIns\\EvernoteOLRD.Connect\\.*/ nocase or $e.TargetObject = /.*\\Outlook\\Addins\\OneNote.OutlookAddin.*/ nocase or $e.TargetObject = /.*\\Outlook\\Addins\\DriveFSExtensionLib.Connect\\.*/ nocase or $e.TargetObject = /.*\\Outlook\\Addins\\GoogleAppsSync.Connect\\.*/ nocase or $e.TargetObject = /.*\\Outlook\\Addins\\Microsoft.VbaAddinForOutlook.1\\.*/ nocase or $e.TargetObject = /.*\\Outlook\\Addins\\OcOffice.OcForms\\.*/ nocase or $e.TargetObject = /.*\\Outlook\\Addins\\OscAddin.Connect\\.*/ nocase or $e.TargetObject = /.*\\Outlook\\Addins\\OutlookChangeNotifier.Connect\\.*/ nocase or $e.TargetObject = /.*\\Outlook\\Addins\\UCAddin.LyncAddin.1.*/ nocase or $e.TargetObject = /.*\\Outlook\\Addins\\UCAddin.UCAddin.1.*/ nocase or $e.TargetObject = /.*\\Outlook\\Addins\\UmOutlookAddin.FormRegionAddin\\.*/ nocase or $e.TargetObject = /.*AddinTakeNotesService\\FriendlyName.*/ nocase)) or (not ($e.Details = /.*/)) or (($e.target.process.file.full_path = /^C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\.*/ nocase) and $e.target.process.file.full_path = /.*\\OfficeClickToRun.exe$/ nocase) or (($e.target.process.file.full_path = /^C:\\Program Files\\Common Files\\Microsoft Shared\\VSTO\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files (x86)\\Microsoft Shared\\VSTO\\.*/ nocase) and $e.target.process.file.full_path = /.*\\VSTOInstaller.exe$/ nocase))) and not(((($e.target.process.file.full_path = "C:\\Program Files\\Avast Software\\Avast\\RegSvr.exe" or $e.target.process.file.full_path = "C:\\Program Files\\Avast Software\\Avast\\x86\\RegSvr.exe") and $e.TargetObject = /.*\\Microsoft\\Office\\Outlook\\Addins\\Avast.AsOutExt\\.*/ nocase) or (($e.target.process.file.full_path = "C:\\Program Files\\AVG\\Antivirus\\RegSvr.exe" or $e.target.process.file.full_path = "C:\\Program Files\\AVG\\Antivirus\\x86\\RegSvr.exe") and $e.TargetObject = /.*\\Microsoft\\Office\\Outlook\\Addins\\Antivirus.AsOutExt\\.*/ nocase))))

  condition:
    $e
}
