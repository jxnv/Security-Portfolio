// Title: Potential Active Directory Enumeration Using AD Module - ProcCreation
// ID: 70bc5215-526f-4477-963c-a47a5c9ebd12
// Status: test
// Level: medium
// Author: frack113
// Date: 2023-01-22
// Tags: attack.reconnaissance, attack.discovery, attack.impact
// Description: Detects usage of the "Import-Module" cmdlet to load the "Microsoft.ActiveDirectory.Management.dl" DLL. Which is often used by attackers to perform AD enumeration.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 70bc5215_526f_4477_963c_a47a5c9ebd12 {
  meta:
    title = "Potential Active Directory Enumeration Using AD Module - ProcCreation"
    description = "Detects usage of the "Import-Module" cmdlet to load the "Microsoft.ActiveDirectory.Management.dl" DLL. Which is often used by attackers to perform AD enumeration."
    author = "frack113"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*Import-Module .*/ nocase or $e.target.process.command_line = /.*ipmo .*/ nocase)) and ($e.target.process.command_line = /.*Microsoft.ActiveDirectory.Management.dll.*/ nocase) and ((($e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase)) or (($e.target.process.file.name = "PowerShell.EXE" or $e.target.process.file.name = "pwsh.dll"))))

  condition:
    $e
}
