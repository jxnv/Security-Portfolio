// Title: Powershell Create Scheduled Task
// ID: 363eccc0-279a-4ccf-a3ab-24c2e63b11fb
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-12-28
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053.005
// Description: Adversaries may abuse the Windows Task Scheduler to perform task scheduling for initial or recurring execution of malicious code
// Converted by: Sigma Universal SIEM/EDR CLI

rule 363eccc0_279a_4ccf_a3ab_24c2e63b11fb {
  meta:
    title = "Powershell Create Scheduled Task"
    description = "Adversaries may abuse the Windows Task Scheduler to perform task scheduling for initial or recurring execution of malicious code"
    author = "frack113"
    severity = "MEDIUM"

  events:
    (((($e.ScriptBlockText = /.*Invoke-CimMethod.*/ nocase and $e.ScriptBlockText = /.*-ClassName.*/ nocase and $e.ScriptBlockText = /.*PS_ScheduledTask.*/ nocase and $e.ScriptBlockText = /.*-NameSpace.*/ nocase and $e.ScriptBlockText = /.*Root\\Microsoft\\Windows\\TaskScheduler.*/ nocase)) or (($e.ScriptBlockText = /.*New-ScheduledTaskAction.*/ nocase or $e.ScriptBlockText = /.*New-ScheduledTaskTrigger.*/ nocase or $e.ScriptBlockText = /.*New-ScheduledTaskPrincipal.*/ nocase or $e.ScriptBlockText = /.*New-ScheduledTaskSettingsSet.*/ nocase or $e.ScriptBlockText = /.*New-ScheduledTask.*/ nocase or $e.ScriptBlockText = /.*Register-ScheduledTask.*/ nocase))) and not((($e.ScriptBlockText = /.*Microsoft.PowerShell.Core\\Export-ModuleMember.*/ nocase and $e.ScriptBlockText = /.*Microsoft.Management.Infrastructure.CimInstance.*/ nocase and $e.ScriptBlockText = /.*__cmdletization_methodParameter.*/ nocase))))

  condition:
    $e
}
