// Title: New Firewall Rule Added Via Netsh.EXE
// ID: cd5cfd80-aa5f-44c0-9c20-108c4ae12e3c
// Status: test
// Level: medium
// Author: Markus Neis, Sander Wiebing
// Date: 2019-01-29
// Tags: attack.defense-impairment, attack.t1686.003, attack.s0246
// Description: Detects the addition of a new rule to the Windows firewall via netsh
// Converted by: Sigma Universal SIEM/EDR CLI

rule cd5cfd80_aa5f_44c0_9c20_108c4ae12e3c {
  meta:
    title = "New Firewall Rule Added Via Netsh.EXE"
    description = "Detects the addition of a new rule to the Windows firewall via netsh"
    author = "Markus Neis, Sander Wiebing"
    severity = "MEDIUM"

  events:
    (((($e.target.process.command_line = /.* firewall .*/ nocase and $e.target.process.command_line = /.* add .*/ nocase)) and (($e.target.process.file.full_path = /.*\\netsh.exe$/ nocase) or ($e.target.process.file.name = "netsh.exe"))) and not((($e.target.process.command_line = /.*advfirewall firewall add rule name=Dropbox dir=in action=allow \"program=?:\\Program Files (x86)\\Dropbox\\Client\\Dropbox.exe\" enable=yes profile=Any.*/ nocase or $e.target.process.command_line = /.*advfirewall firewall add rule name=Dropbox dir=in action=allow \"program=?:\\Program Files\\Dropbox\\Client\\Dropbox.exe\" enable=yes profile=Any.*/ nocase))))

  condition:
    $e
}
