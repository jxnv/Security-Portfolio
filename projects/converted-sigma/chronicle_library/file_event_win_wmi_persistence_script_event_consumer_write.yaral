// Title: WMI Persistence - Script Event Consumer File Write
// ID: 33f41cdd-35ac-4ba8-814b-c6a4244a1ad4
// Status: test
// Level: high
// Author: Thomas Patzke
// Date: 2018-03-07
// Tags: attack.privilege-escalation, attack.t1546.003, attack.persistence
// Description: Detects file writes of WMI script event consumer
// Converted by: Sigma Universal SIEM/EDR CLI

rule 33f41cdd_35ac_4ba8_814b_c6a4244a1ad4 {
  meta:
    title = "WMI Persistence - Script Event Consumer File Write"
    description = "Detects file writes of WMI script event consumer"
    author = "Thomas Patzke"
    severity = "HIGH"

  events:
    ($e.target.process.file.full_path = "C:\\WINDOWS\\system32\\wbem\\scrcons.exe")

  condition:
    $e
}
