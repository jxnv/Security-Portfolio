// Title: Network Connection Initiated To Cloudflared Tunnels Domains
// ID: 7cd1dcdc-6edf-4896-86dc-d1f19ad64903
// Status: test
// Level: medium
// Author: Kamran Saifullah, Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-05-27
// Tags: attack.exfiltration, attack.command-and-control, attack.t1567, attack.t1572
// Description: Detects network connections to Cloudflared tunnels domains initiated by a process on the system.
// Attackers can abuse that feature to establish a reverse shell or persistence on a machine.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 7cd1dcdc_6edf_4896_86dc_d1f19ad64903 {
  meta:
    title = "Network Connection Initiated To Cloudflared Tunnels Domains"
    description = "Detects network connections to Cloudflared tunnels domains initiated by a process on the system. Attackers can abuse that feature to establish a reverse shell or persistence on a machine."
    author = "Kamran Saifullah, Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ($e.Initiated = "true" and ($e.DestinationHostname = /.*.v2.argotunnel.com$/ nocase or $e.DestinationHostname = /.*protocol-v2.argotunnel.com$/ nocase or $e.DestinationHostname = /.*trycloudflare.com$/ nocase or $e.DestinationHostname = /.*update.argotunnel.com$/ nocase))

  condition:
    $e
}
