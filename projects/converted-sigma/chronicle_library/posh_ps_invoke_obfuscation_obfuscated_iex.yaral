// Title: Invoke-Obfuscation Obfuscated IEX Invocation - PowerShell
// ID: 1b9dc62e-6e9e-42a3-8990-94d7a10007f7
// Status: test
// Level: high
// Author: Daniel Bohannon (@Mandiant/@FireEye), oscd.community
// Date: 2019-11-08
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects all variations of obfuscated powershell IEX invocation code generated by Invoke-Obfuscation framework from the following code block \u2014
// Converted by: Sigma Universal SIEM/EDR CLI

rule 1b9dc62e_6e9e_42a3_8990_94d7a10007f7 {
  meta:
    title = "Invoke-Obfuscation Obfuscated IEX Invocation - PowerShell"
    description = "Detects all variations of obfuscated powershell IEX invocation code generated by Invoke-Obfuscation framework from the following code block \u2014"
    author = "Daniel Bohannon (@Mandiant/@FireEye), oscd.community"
    severity = "HIGH"

  events:
    (($e.ScriptBlockText = /\$PSHome\[\s*\d{1,3}\s*\]\s*\+\s*\$PSHome\[/ nocase) or ($e.ScriptBlockText = /\$ShellId\[\s*\d{1,3}\s*\]\s*\+\s*\$ShellId\[/ nocase) or ($e.ScriptBlockText = /\$env:Public\[\s*\d{1,3}\s*\]\s*\+\s*\$env:Public\[/ nocase) or ($e.ScriptBlockText = /\$env:ComSpec\[(\s*\d{1,3}\s*,){2}/ nocase) or ($e.ScriptBlockText = /\*mdr\*\W\s*\)\.Name/ nocase) or ($e.ScriptBlockText = /\$VerbosePreference\.ToString\(/ nocase))

  condition:
    $e
}
