// Title: Unmount Share Via Net.EXE
// ID: cb7c4a03-2871-43c0-9bbb-18bbdb079896
// Status: test
// Level: low
// Author: oscd.community, @redcanary, Zach Stanford @svch0st
// Date: 2020-10-08
// Tags: attack.stealth, attack.t1070.005
// Description: Detects when when a mounted share is removed. Adversaries may remove share connections that are no longer useful in order to clean up traces of their operation
// Converted by: Sigma Universal SIEM/EDR CLI

rule cb7c4a03_2871_43c0_9bbb_18bbdb079896 {
  meta:
    title = "Unmount Share Via Net.EXE"
    description = "Detects when when a mounted share is removed. Adversaries may remove share connections that are no longer useful in order to clean up traces of their operation"
    author = "oscd.community, @redcanary, Zach Stanford @svch0st"
    severity = "LOW"

  events:
    ((($e.target.process.command_line = /.*share.*/ nocase and $e.target.process.command_line = /.*/delete.*/ nocase)) and ((($e.target.process.file.full_path = /.*\\net.exe$/ nocase or $e.target.process.file.full_path = /.*\\net1.exe$/ nocase)) or (($e.target.process.file.name = "net.exe" or $e.target.process.file.name = "net1.exe"))))

  condition:
    $e
}
