// Title: ISO Image Mounted
// ID: 0248a7bc-8a9a-4cd8-a57e-3ae8e073a073
// Status: test
// Level: medium
// Author: Syed Hasan (@syedhasan009)
// Date: 2021-05-29
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects the mount of an ISO image on an endpoint
// Converted by: Sigma Universal SIEM/EDR CLI

rule 0248a7bc_8a9a_4cd8_a57e_3ae8e073a073 {
  meta:
    title = "ISO Image Mounted"
    description = "Detects the mount of an ISO image on an endpoint"
    author = "Syed Hasan (@syedhasan009)"
    severity = "MEDIUM"

  events:
    (($e.EventID = 4663 and $e.ObjectServer = "Security" and $e.ObjectType = "File" and $e.ObjectName = /^\\Device\\CdRom.*/ nocase) and not((($e.ObjectName = "\\Device\\CdRom0\\autorun.ico" or $e.ObjectName = "\\Device\\CdRom0\\setup.exe" or $e.ObjectName = "\\Device\\CdRom0\\setup64.exe"))))

  condition:
    $e
}
