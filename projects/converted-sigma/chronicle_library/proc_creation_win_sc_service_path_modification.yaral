// Title: Suspicious Service Path Modification
// ID: 138d3531-8793-4f50-a2cd-f291b2863d78
// Status: test
// Level: high
// Author: Victor Sergeev, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-10-21
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects service path modification via the "sc" binary to a suspicious command or path
// Converted by: Sigma Universal SIEM/EDR CLI

rule 138d3531_8793_4f50_a2cd_f291b2863d78 {
  meta:
    title = "Suspicious Service Path Modification"
    description = "Detects service path modification via the "sc" binary to a suspicious command or path"
    author = "Victor Sergeev, oscd.community, Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ($e.target.process.file.full_path = /.*\\sc.exe$/ nocase and ($e.target.process.command_line = /.*config.*/ nocase and $e.target.process.command_line = /.*binPath.*/ nocase) and ($e.target.process.command_line = /.*powershell.*/ nocase or $e.target.process.command_line = /.*cmd .*/ nocase or $e.target.process.command_line = /.*mshta.*/ nocase or $e.target.process.command_line = /.*wscript.*/ nocase or $e.target.process.command_line = /.*cscript.*/ nocase or $e.target.process.command_line = /.*rundll32.*/ nocase or $e.target.process.command_line = /.*svchost.*/ nocase or $e.target.process.command_line = /.*dllhost.*/ nocase or $e.target.process.command_line = /.*cmd.exe /c.*/ nocase or $e.target.process.command_line = /.*cmd.exe /k.*/ nocase or $e.target.process.command_line = /.*cmd.exe /r.*/ nocase or $e.target.process.command_line = /.*cmd /c.*/ nocase or $e.target.process.command_line = /.*cmd /k.*/ nocase or $e.target.process.command_line = /.*cmd /r.*/ nocase or $e.target.process.command_line = /.*C:\\Users\\Public.*/ nocase or $e.target.process.command_line = /.*\\Downloads\\.*/ nocase or $e.target.process.command_line = /.*\\Desktop\\.*/ nocase or $e.target.process.command_line = /.*\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\.*/ nocase or $e.target.process.command_line = /.*C:\\Windows\\TEMP\\.*/ nocase or $e.target.process.command_line = /.*\\AppData\\Local\\Temp.*/ nocase))

  condition:
    $e
}
