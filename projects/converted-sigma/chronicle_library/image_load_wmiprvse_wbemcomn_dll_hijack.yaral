// Title: Wmiprvse Wbemcomn DLL Hijack
// ID: 7707a579-e0d8-4886-a853-ce47e4575aaa
// Status: test
// Level: high
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2020-10-12
// Tags: attack.execution, attack.t1047, attack.lateral-movement, attack.t1021.002
// Description: Detects a threat actor creating a file named `wbemcomn.dll` in the `C:\Windows\System32\wbem\` directory over the network and loading it for a WMI DLL Hijack scenario.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 7707a579_e0d8_4886_a853_ce47e4575aaa {
  meta:
    title = "Wmiprvse Wbemcomn DLL Hijack"
    description = "Detects a threat actor creating a file named `wbemcomn.dll` in the `C:\Windows\System32\wbem\` directory over the network and loading it for a WMI DLL Hijack scenario."
    author = "Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)"
    severity = "HIGH"

  events:
    ($e.target.process.file.full_path = /.*\\wmiprvse.exe$/ nocase and $e.ImageLoaded = /.*\\wbem\\wbemcomn.dll$/ nocase)

  condition:
    $e
}
