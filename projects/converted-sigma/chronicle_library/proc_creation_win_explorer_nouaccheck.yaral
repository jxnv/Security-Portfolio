// Title: Explorer NOUACCHECK Flag
// ID: 534f2ef7-e8a2-4433-816d-c91bccde289b
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-23
// Tags: attack.privilege-escalation, attack.t1548.002
// Description: Detects suspicious starts of explorer.exe that use the /NOUACCHECK flag that allows to run all sub processes of that newly started explorer.exe without any UAC checks
// Converted by: Sigma Universal SIEM/EDR CLI

rule 534f2ef7_e8a2_4433_816d_c91bccde289b {
  meta:
    title = "Explorer NOUACCHECK Flag"
    description = "Detects suspicious starts of explorer.exe that use the /NOUACCHECK flag that allows to run all sub processes of that newly started explorer.exe without any UAC checks"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.file.full_path = /.*\\explorer.exe$/ nocase and $e.target.process.command_line = /.*/NOUACCHECK.*/ nocase) and not((($e.principal.process.command_line = "C:\\Windows\\system32\\svchost.exe -k netsvcs -p -s Schedule") or ($e.principal.process.file.full_path = "C:\\Windows\\System32\\svchost.exe"))))

  condition:
    $e
}
