// Title: Potential appverifUI.DLL Sideloading
// ID: ee6cea48-c5b6-4304-a332-10fc6446f484
// Status: test
// Level: high
// Author: X__Junior (Nextron Systems)
// Date: 2023-06-20
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of "appverifUI.dll"
// Converted by: Sigma Universal SIEM/EDR CLI

rule ee6cea48_c5b6_4304_a332_10fc6446f484 {
  meta:
    title = "Potential appverifUI.DLL Sideloading"
    description = "Detects potential DLL sideloading of "appverifUI.dll""
    author = "X__Junior (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.ImageLoaded = /.*\\appverifUI.dll$/ nocase) and not((($e.target.process.file.full_path = "C:\\Windows\\SysWOW64\\appverif.exe" or $e.target.process.file.full_path = "C:\\Windows\\System32\\appverif.exe") and ($e.ImageLoaded = /^C:\\Windows\\System32\\.*/ nocase or $e.ImageLoaded = /^C:\\Windows\\SysWOW64\\.*/ nocase or $e.ImageLoaded = /^C:\\Windows\\WinSxS\\.*/ nocase))))

  condition:
    $e
}
