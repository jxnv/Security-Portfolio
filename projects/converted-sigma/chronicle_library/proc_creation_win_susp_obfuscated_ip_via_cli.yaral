// Title: Obfuscated IP Via CLI
// ID: 56d19cb4-6414-4769-9644-1ed35ffbb148
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2022-08-03
// Tags: attack.discovery
// Description: Detects usage of an encoded/obfuscated version of an IP address (hex, octal, etc.) via command line
// Converted by: Sigma Universal SIEM/EDR CLI

rule 56d19cb4_6414_4769_9644_1ed35ffbb148 {
  meta:
    title = "Obfuscated IP Via CLI"
    description = "Detects usage of an encoded/obfuscated version of an IP address (hex, octal, etc.) via command line"
    author = "Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.file.full_path = /.*\\ping.exe$/ nocase or $e.target.process.file.full_path = /.*\\arp.exe$/ nocase)) and ((($e.target.process.command_line = /.* 0x.*/ nocase or $e.target.process.command_line = /.*//0x.*/ nocase or $e.target.process.command_line = /.*.0x.*/ nocase or $e.target.process.command_line = /.*.00x.*/ nocase)) or (($e.target.process.command_line = /.*http://%.*/ nocase and $e.target.process.command_line = /.*%2e.*/ nocase)) or (($e.target.process.command_line = /https?://[0-9]{1,3}\.[0-9]{1,3}\.0[0-9]{3,4}/ nocase) or ($e.target.process.command_line = /https?://[0-9]{1,3}\.0[0-9]{3,7}/ nocase) or ($e.target.process.command_line = /https?://0[0-9]{3,11}/ nocase) or ($e.target.process.command_line = /https?://(?:0[0-9]{1,11}\.){3}0[0-9]{1,11}/ nocase) or ($e.target.process.command_line = /https?://0[0-9]{1,11}/ nocase) or ($e.target.process.command_line = / [0-7]{7,13}/ nocase))) and not(($e.target.process.command_line = /https?://(?:(?:25[0-5]|(?:2[0-4]|1\d|[1-9])?\d)(?:\.|\b)){4}/ nocase)))

  condition:
    $e
}
