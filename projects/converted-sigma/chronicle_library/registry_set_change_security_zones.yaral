// Date: 2022-01-22
// Tags: attack.persistence, attack.t1137
// Description: Hides the file extension through modification of the registry
// Converted by: Sigma Universal SIEM/EDR CLI

rule 45e112d0_7759_4c2a_aa36_9f8fb79d3393 {
  meta:
    title = "IE Change Domain Zone"
    description = "Hides the file extension through modification of the registry"
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.TargetObject = /.*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\ZoneMap\\Domains\\.*/ nocase) and not((($e.Details = "DWORD (0x00000000)" or $e.Details = "DWORD (0x00000001)" or $e.Details = "(Empty)"))))

  condition:
    $e
}
