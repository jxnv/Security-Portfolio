rule d557dc06_62e8_4468_a8e8_7984124908ce {
  meta:
    title = "HackTool - WinPwn Execution"
    description = "Detects commandline keywords indicative of potential usge of the tool WinPwn. A tool for Windows and Active Directory reconnaissance and exploitation."
    author = "Swachchhanda Shrawan Poudel"
    severity = "HIGH"

  events:
    (($e.target.process.command_line = /.*Offline_Winpwn.*/ nocase or $e.target.process.command_line = /.*WinPwn .*/ nocase or $e.target.process.command_line = /.*WinPwn.exe.*/ nocase or $e.target.process.command_line = /.*WinPwn.ps1.*/ nocase))

  condition:
    $e
}
