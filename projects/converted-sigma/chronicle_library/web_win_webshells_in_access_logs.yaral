// Title: Windows Webshell Strings
// ID: 7ff9db12-1b94-4a79-ba68-a2402c5d6729
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2017-02-19
// Tags: attack.persistence, attack.t1505.003
// Description: Detects common commands used in Windows webshells
// Converted by: Sigma Universal SIEM/EDR CLI

rule 7ff9db12_1b94_4a79_ba68_a2402c5d6729 {
  meta:
    title = "Windows Webshell Strings"
    description = "Detects common commands used in Windows webshells"
    author = "Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    (("=whoami" or "=net%20user" or "=net+user" or "=net%2Buser" or "=cmd%20/c%" or "=cmd+/c+" or "=cmd%2B/c%" or "=cmd%20/r%" or "=cmd+/r+" or "=cmd%2B/r%" or "=cmd%20/k%" or "=cmd+/k+" or "=cmd%2B/k%" or "=powershell%" or "=powershell+" or "=tasklist%" or "=tasklist+" or "=wmic%" or "=wmic+" or "=ssh%" or "=ssh+" or "=python%" or "=python+" or "=python3%" or "=python3+" or "=ipconfig" or "=wget%" or "=wget+" or "=curl%" or "=curl+" or "=certutil" or "=copy%20%5C%5C" or "=dsquery%" or "=dsquery+" or "=nltest%" or "=nltest+") and ($e.cs-method = "GET"))

  condition:
    $e
}
