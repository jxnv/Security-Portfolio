// Title: Deleted Data Overwritten Via Cipher.EXE
// ID: 4b046706-5789-4673-b111-66f25fe99534
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-12-26
// Tags: attack.impact, attack.t1485
// Description: Detects usage of the "cipher" built-in utility in order to overwrite deleted data from disk.
// Adversaries may destroy data and files on specific systems or in large numbers on a network to interrupt availability to systems, services, and network resources.
// Data destruction is likely to render stored data irrecoverable by forensic techniques through overwriting files or data on local and remote drives
// Converted by: Sigma Universal SIEM/EDR CLI

rule 4b046706_5789_4673_b111_66f25fe99534 {
  meta:
    title = "Deleted Data Overwritten Via Cipher.EXE"
    description = "Detects usage of the "cipher" built-in utility in order to overwrite deleted data from disk. Adversaries may destroy data and files on specific systems or in large numbers on a network to interrupt availability to systems, services, and network resources. Data destruction is likely to render stored data irrecoverable by forensic techniques through overwriting files or data on local and remote drives"
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.target.process.command_line = /.* /w:.*/ nocase) and (($e.target.process.file.name = "CIPHER.EXE") or ($e.target.process.file.full_path = /.*\\cipher.exe$/ nocase)))

  condition:
    $e
}
