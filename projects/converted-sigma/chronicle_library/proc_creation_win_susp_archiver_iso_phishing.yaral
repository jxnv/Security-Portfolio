// Title: Phishing Pattern ISO in Archive
// ID: fcdf69e5-a3d3-452a-9724-26f2308bf2b1
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-06-07
// Tags: attack.initial-access, attack.t1566
// Description: Detects cases in which an ISO files is opend within an archiver like 7Zip or Winrar, which is a sign of phishing as threat actors put small ISO files in archives as email attachments to bypass certain filters and protective measures (mark of web)
// Converted by: Sigma Universal SIEM/EDR CLI

rule fcdf69e5_a3d3_452a_9724_26f2308bf2b1 {
  meta:
    title = "Phishing Pattern ISO in Archive"
    description = "Detects cases in which an ISO files is opend within an archiver like 7Zip or Winrar, which is a sign of phishing as threat actors put small ISO files in archives as email attachments to bypass certain filters and protective measures (mark of web)"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.principal.process.file.full_path = /.*\\Winrar.exe$/ nocase or $e.principal.process.file.full_path = /.*\\7zFM.exe$/ nocase or $e.principal.process.file.full_path = /.*\\peazip.exe$/ nocase) and ($e.target.process.file.full_path = /.*\\isoburn.exe$/ nocase or $e.target.process.file.full_path = /.*\\PowerISO.exe$/ nocase or $e.target.process.file.full_path = /.*\\ImgBurn.exe$/ nocase))

  condition:
    $e
}
