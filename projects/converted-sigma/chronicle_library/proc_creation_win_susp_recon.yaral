// Title: Recon Information for Export with Command Prompt
// ID: aa2efee7-34dd-446e-8a37-40790a66efd7
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-07-30
// Tags: attack.collection, attack.t1119
// Description: Once established within a system or network, an adversary may use automated techniques for collecting internal data.
// Converted by: Sigma Universal SIEM/EDR CLI

rule aa2efee7_34dd_446e_8a37_40790a66efd7 {
  meta:
    title = "Recon Information for Export with Command Prompt"
    description = "Once established within a system or network, an adversary may use automated techniques for collecting internal data."
    author = "frack113"
    severity = "MEDIUM"

  events:
    (((($e.target.process.file.full_path = /.*\\tree.com$/ nocase or $e.target.process.file.full_path = /.*\\WMIC.exe$/ nocase or $e.target.process.file.full_path = /.*\\doskey.exe$/ nocase or $e.target.process.file.full_path = /.*\\sc.exe$/ nocase)) or (($e.target.process.file.name = "wmic.exe" or $e.target.process.file.name = "DOSKEY.EXE" or $e.target.process.file.name = "sc.exe"))) and (($e.principal.process.command_line = /.* > %TEMP%\\.*/ nocase or $e.principal.process.command_line = /.* > %TMP%\\.*/ nocase)))

  condition:
    $e
}
