// Title: AWS GuardDuty Detector Deleted Or Updated
// ID: d2656e78-c069-4571-8220-9e0ab5913f19
// Status: experimental
// Level: high
// Author: suktech24
// Date: 2025-11-27
// Tags: attack.defense-impairment, attack.t1685, attack.t1685.002
// Description: Detects successful deletion or disabling of an AWS GuardDuty detector, possibly by an attacker trying to avoid detection of its malicious activities.
// Upon deletion, GuardDuty stops monitoring the environment and all existing findings are lost.
// Verify with the user identity that this activity is legitimate.
// Converted by: Sigma Universal SIEM/EDR CLI

rule d2656e78_c069_4571_8220_9e0ab5913f19 {
  meta:
    title = "AWS GuardDuty Detector Deleted Or Updated"
    description = "Detects successful deletion or disabling of an AWS GuardDuty detector, possibly by an attacker trying to avoid detection of its malicious activities. Upon deletion, GuardDuty stops monitoring the environment and all existing findings are lost. Verify with the user identity that this activity is legitimate."
    author = "suktech24"
    severity = "HIGH"

  events:
    (($e.eventSource = "guardduty.amazonaws.com") and (($e.eventName = "DeleteDetector") or ($e.eventName = "UpdateDetector" and $e.requestParameters.enable = "false")) and ((not ($e.errorCode = /.*/)) or ($e.errorCode = "Success")))

  condition:
    $e
}
