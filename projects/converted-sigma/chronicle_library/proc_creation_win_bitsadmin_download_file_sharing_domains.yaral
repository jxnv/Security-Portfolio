// Title: Suspicious Download From File-Sharing Website Via Bitsadmin
// ID: 8518ed3d-f7c9-4601-a26c-f361a4256a0c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-06-28
// Tags: attack.persistence, attack.execution, attack.stealth, attack.t1197, attack.s0190, attack.t1036.003, attack.command-and-control, attack.t1105
// Description: Detects usage of bitsadmin downloading a file from a suspicious domain
// Converted by: Sigma Universal SIEM/EDR CLI

rule 8518ed3d_f7c9_4601_a26c_f361a4256a0c {
  meta:
    title = "Suspicious Download From File-Sharing Website Via Bitsadmin"
    description = "Detects usage of bitsadmin downloading a file from a suspicious domain"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*.githubusercontent.com.*/ nocase or $e.target.process.command_line = /.*0x0.st.*/ nocase or $e.target.process.command_line = /.*anonfiles.com.*/ nocase or $e.target.process.command_line = /.*bashupload.com.*/ nocase or $e.target.process.command_line = /.*cdn.discordapp.com.*/ nocase or $e.target.process.command_line = /.*chunk.io.*/ nocase or $e.target.process.command_line = /.*ddns.net.*/ nocase or $e.target.process.command_line = /.*dl.dropboxusercontent.com.*/ nocase or $e.target.process.command_line = /.*ghostbin.co.*/ nocase or $e.target.process.command_line = /.*github.com.*/ nocase or $e.target.process.command_line = /.*glitch.me.*/ nocase or $e.target.process.command_line = /.*gofile.io.*/ nocase or $e.target.process.command_line = /.*hastebin.com.*/ nocase or $e.target.process.command_line = /.*mediafire.com.*/ nocase or $e.target.process.command_line = /.*mega.nz.*/ nocase or $e.target.process.command_line = /.*onrender.com.*/ nocase or $e.target.process.command_line = /.*pages.dev.*/ nocase or $e.target.process.command_line = /.*paste.ee.*/ nocase or $e.target.process.command_line = /.*pastebin.com.*/ nocase or $e.target.process.command_line = /.*pastebin.pl.*/ nocase or $e.target.process.command_line = /.*pastetext.net.*/ nocase or $e.target.process.command_line = /.*privatlab.com.*/ nocase or $e.target.process.command_line = /.*privatlab.net.*/ nocase or $e.target.process.command_line = /.*send.exploit.in.*/ nocase or $e.target.process.command_line = /.*sendspace.com.*/ nocase or $e.target.process.command_line = /.*storage.googleapis.com.*/ nocase or $e.target.process.command_line = /.*storjshare.io.*/ nocase or $e.target.process.command_line = /.*supabase.co.*/ nocase or $e.target.process.command_line = /.*temp.sh.*/ nocase or $e.target.process.command_line = /.*transfer.sh.*/ nocase or $e.target.process.command_line = /.*trycloudflare.com.*/ nocase or $e.target.process.command_line = /.*ufile.io.*/ nocase or $e.target.process.command_line = /.*w3spaces.com.*/ nocase or $e.target.process.command_line = /.*workers.dev.*/ nocase or $e.target.process.command_line = /.*x0.at.*/ nocase)) and (($e.target.process.command_line = /.* /transfer .*/ nocase or $e.target.process.command_line = /.* /create .*/ nocase or $e.target.process.command_line = /.* /addfile .*/ nocase)) and (($e.target.process.file.full_path = /.*\\bitsadmin.exe$/ nocase) or ($e.target.process.file.name = "bitsadmin.exe")))

  condition:
    $e
}
