// Title: Raccine Uninstall
// ID: a31eeaed-3fd5-478e-a8ba-e62c6b3f9ecc
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-01-21
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects commands that indicate a Raccine removal from an end system. Raccine is a free ransomware protection tool.
// Converted by: Sigma Universal SIEM/EDR CLI

rule a31eeaed_3fd5_478e_a8ba_e62c6b3f9ecc {
  meta:
    title = "Raccine Uninstall"
    description = "Detects commands that indicate a Raccine removal from an end system. Raccine is a free ransomware protection tool."
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*taskkill .*/ nocase and $e.target.process.command_line = /.*RaccineSettings.exe.*/ nocase)) or (($e.target.process.command_line = /.*reg.exe.*/ nocase and $e.target.process.command_line = /.*delete.*/ nocase and $e.target.process.command_line = /.*Raccine Tray.*/ nocase)) or (($e.target.process.command_line = /.*schtasks.*/ nocase and $e.target.process.command_line = /.*/DELETE.*/ nocase and $e.target.process.command_line = /.*Raccine Rules Updater.*/ nocase)))

  condition:
    $e
}
