// Tags: attack.stealth, attack.t1036
// Description: Detects the execution of a Windows system binary that is usually located in the system folder from an uncommon location.
// Converted by: Sigma Universal SIEM/EDR CLI

rule e4a6b256_3e47_40fc_89d2_7a477edd6915 {
  meta:
    title = "System File Execution Location Anomaly"
    description = "Detects the execution of a Windows system binary that is usually located in the system folder from an uncommon location."
    author = "Florian Roth (Nextron Systems), Patrick Bareiss, Anton Kutepov, oscd.community, Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.file.full_path = /.*\\atbroker.exe$/ nocase or $e.target.process.file.full_path = /.*\\audiodg.exe$/ nocase or $e.target.process.file.full_path = /.*\\bcdedit.exe$/ nocase or $e.target.process.file.full_path = /.*\\bitsadmin.exe$/ nocase or $e.target.process.file.full_path = /.*\\certreq.exe$/ nocase or $e.target.process.file.full_path = /.*\\certutil.exe$/ nocase or $e.target.process.file.full_path = /.*\\cmstp.exe$/ nocase or $e.target.process.file.full_path = /.*\\conhost.exe$/ nocase or $e.target.process.file.full_path = /.*\\consent.exe$/ nocase or $e.target.process.file.full_path = /.*\\cscript.exe$/ nocase or $e.target.process.file.full_path = /.*\\csrss.exe$/ nocase or $e.target.process.file.full_path = /.*\\dashost.exe$/ nocase or $e.target.process.file.full_path = /.*\\defrag.exe$/ nocase or $e.target.process.file.full_path = /.*\\dfrgui.exe$/ nocase or $e.target.process.file.full_path = /.*\\dism.exe$/ nocase or $e.target.process.file.full_path = /.*\\dllhost.exe$/ nocase or $e.target.process.file.full_path = /.*\\dllhst3g.exe$/ nocase or $e.target.process.file.full_path = /.*\\dwm.exe$/ nocase or $e.target.process.file.full_path = /.*\\eventvwr.exe$/ nocase or $e.target.process.file.full_path = /.*\\fsquirt.exe$/ nocase or $e.target.process.file.full_path = /.*\\finger.exe$/ nocase or $e.target.process.file.full_path = /.*\\logonui.exe$/ nocase or $e.target.process.file.full_path = /.*\\LsaIso.exe$/ nocase or $e.target.process.file.full_path = /.*\\lsass.exe$/ nocase or $e.target.process.file.full_path = /.*\\lsm.exe$/ nocase or $e.target.process.file.full_path = /.*\\msiexec.exe$/ nocase or $e.target.process.file.full_path = /.*\\ntoskrnl.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell_ise.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase or $e.target.process.file.full_path = /.*\\regsvr32.exe$/ nocase or $e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase or $e.target.process.file.full_path = /.*\\runonce.exe$/ nocase or $e.target.process.file.full_path = /.*\\RuntimeBroker.exe$/ nocase or $e.target.process.file.full_path = /.*\\schtasks.exe$/ nocase or $e.target.process.file.full_path = /.*\\services.exe$/ nocase or $e.target.process.file.full_path = /.*\\sihost.exe$/ nocase or $e.target.process.file.full_path = /.*\\smartscreen.exe$/ nocase or $e.target.process.file.full_path = /.*\\smss.exe$/ nocase or $e.target.process.file.full_path = /.*\\spoolsv.exe$/ nocase or $e.target.process.file.full_path = /.*\\svchost.exe$/ nocase or $e.target.process.file.full_path = /.*\\taskhost.exe$/ nocase or $e.target.process.file.full_path = /.*\\taskhostw.exe$/ nocase or $e.target.process.file.full_path = /.*\\Taskmgr.exe$/ nocase or $e.target.process.file.full_path = /.*\\userinit.exe$/ nocase or $e.target.process.file.full_path = /.*\\werfault.exe$/ nocase or $e.target.process.file.full_path = /.*\\werfaultsecure.exe$/ nocase or $e.target.process.file.full_path = /.*\\wininit.exe$/ nocase or $e.target.process.file.full_path = /.*\\winlogon.exe$/ nocase or $e.target.process.file.full_path = /.*\\winver.exe$/ nocase or $e.target.process.file.full_path = /.*\\wlanext.exe$/ nocase or $e.target.process.file.full_path = /.*\\wmic.exe$/ nocase or $e.target.process.file.full_path = /.*\\wscript.exe$/ nocase or $e.target.process.file.full_path = /.*\\wsl.exe$/ nocase or $e.target.process.file.full_path = /.*\\wsmprovhost.exe$/ nocase)) and not(((($e.target.process.file.full_path = /^C:\\$WINDOWS.~BT\\.*/ nocase or $e.target.process.file.full_path = /^C:\\$WinREAgent\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\SoftwareDistribution\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\System32\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\SystemTemp\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\SysWOW64\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\uus\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\WinSxS\\.*/ nocase)) or (($e.target.process.file.full_path = /.*C:\\Program Files\\PowerShell\\7\\.*/ nocase or $e.target.process.file.full_path = /.*C:\\Program Files\\PowerShell\\7-preview\\.*/ nocase or $e.target.process.file.full_path = /.*C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview.*/ nocase or $e.target.process.file.full_path = /.*\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview.*/ nocase) and $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase) or ($e.target.process.file.full_path = /^C:\\Users\\.*/ nocase and $e.target.process.file.full_path = /.*\\AppData\\Local\\Microsoft\\WindowsApps\\.*/ nocase and $e.target.process.file.full_path = /.*\\wsl.exe$/ nocase) or (($e.target.process.file.full_path = /^C:\\Program Files\\WindowsApps\\MicrosoftCorporationII.WindowsSubsystemForLinux.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\WSL\\.*/ nocase) and $e.target.process.file.full_path = /.*\\wsl.exe$/ nocase))) and not(($e.target.process.file.full_path = /.*\\SystemRoot\\System32\\.*/ nocase)))

