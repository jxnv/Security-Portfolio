// Title: PowerShell Web Access Feature Enabled Via DISM
// ID: 7e8f2d3b-9c1a-4f67-b9e8-8d9006e0e51f
// Status: test
// Level: high
// Author: Michael Haag
// Date: 2024-09-03
// Tags: attack.privilege-escalation, attack.persistence, attack.t1548.002
// Description: Detects the use of DISM to enable the PowerShell Web Access feature, which could be used for remote access and potential abuse
// Converted by: Sigma Universal SIEM/EDR CLI

rule 7e8f2d3b_9c1a_4f67_b9e8_8d9006e0e51f {
  meta:
    title = "PowerShell Web Access Feature Enabled Via DISM"
    description = "Detects the use of DISM to enable the PowerShell Web Access feature, which could be used for remote access and potential abuse"
    author = "Michael Haag"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*WindowsPowerShellWebAccess.*/ nocase and $e.target.process.command_line = /.*/online.*/ nocase and $e.target.process.command_line = /.*/enable-feature.*/ nocase)) and (($e.target.process.file.full_path = /.*\\dism.exe$/ nocase) or ($e.target.process.file.name = "DISM.EXE")))

  condition:
    $e
}
