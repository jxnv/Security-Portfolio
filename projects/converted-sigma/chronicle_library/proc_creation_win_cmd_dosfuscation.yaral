// Title: Potential Dosfuscation Activity
// ID: a77c1610-fc73-4019-8e29-0f51efc04a51
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-02-15
// Tags: attack.execution, attack.t1059
// Description: Detects possible payload obfuscation via the commandline
// Converted by: Sigma Universal SIEM/EDR CLI

rule a77c1610_fc73_4019_8e29_0f51efc04a51 {
  meta:
    title = "Potential Dosfuscation Activity"
    description = "Detects possible payload obfuscation via the commandline"
    author = "frack113, Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.target.process.command_line = /.*^^.*/ nocase or $e.target.process.command_line = /.*^|^.*/ nocase or $e.target.process.command_line = /.*,;,.*/ nocase or $e.target.process.command_line = /.*;;;;.*/ nocase or $e.target.process.command_line = /.*;; ;;.*/ nocase or $e.target.process.command_line = /.*(,(,.*/ nocase or $e.target.process.command_line = /.*%COMSPEC:~.*/ nocase or $e.target.process.command_line = /.* c^m^d.*/ nocase or $e.target.process.command_line = /.*^c^m^d.*/ nocase or $e.target.process.command_line = /.* c^md.*/ nocase or $e.target.process.command_line = /.* cm^d.*/ nocase or $e.target.process.command_line = /.*^cm^d.*/ nocase or $e.target.process.command_line = /.* s^et .*/ nocase or $e.target.process.command_line = /.* s^e^t .*/ nocase or $e.target.process.command_line = /.* se^t .*/ nocase))

  condition:
    $e
}
