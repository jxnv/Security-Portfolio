// Title: Potential Commandline Obfuscation Using Escape Characters
// ID: f0cdd048-82dc-4f7a-8a7a-b87a52b6d0fd
// Status: test
// Level: medium
// Author: juju4
// Date: 2018-12-11
// Tags: attack.stealth, attack.t1140
// Description: Detects potential commandline obfuscation using known escape characters
// Converted by: Sigma Universal SIEM/EDR CLI

rule f0cdd048_82dc_4f7a_8a7a_b87a52b6d0fd {
  meta:
    title = "Potential Commandline Obfuscation Using Escape Characters"
    description = "Detects potential commandline obfuscation using known escape characters"
    author = "juju4"
    severity = "MEDIUM"

  events:
    (($e.target.process.command_line = /.*h^t^t^p.*/ nocase or $e.target.process.command_line = /.*h\"t\"t\"p.*/ nocase))

  condition:
    $e
}
