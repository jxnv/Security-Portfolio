rule 0ef56343_059e_4cb6_adc1_4c3c967c5e46 {
  meta:
    title = "Suspicious Execution of Systeminfo"
    description = "Detects usage of the "systeminfo" command to retrieve information"
    author = "frack113"
    severity = "LOW"

  events:
    (($e.target.process.file.full_path = /.*\\systeminfo.exe$/ nocase) or ($e.target.process.file.name = "sysinfo.exe"))

  condition:
    $e
}
