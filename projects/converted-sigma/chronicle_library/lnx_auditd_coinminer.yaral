rule 071d5e5a_9cef_47ec_bc4e_a42e34d8d0ed {
  meta:
    title = "Possible Coin Miner CPU Priority Param"
    description = "Detects command line parameter very often used with coin miners"
    author = "Florian Roth (Nextron Systems)"
    severity = "CRITICAL"

  events:
    (($e.a1 = /^--cpu-priority.*/ nocase) or ($e.a2 = /^--cpu-priority.*/ nocase) or ($e.a3 = /^--cpu-priority.*/ nocase) or ($e.a4 = /^--cpu-priority.*/ nocase) or ($e.a5 = /^--cpu-priority.*/ nocase) or ($e.a6 = /^--cpu-priority.*/ nocase) or ($e.a7 = /^--cpu-priority.*/ nocase))

  condition:
    $e
}
