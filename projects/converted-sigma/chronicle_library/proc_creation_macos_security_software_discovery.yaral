// Title: Security Software Discovery - MacOs
// ID: 0ed75b9c-c73b-424d-9e7d-496cd565fbe0
// Status: test
// Level: medium
// Author: Daniil Yugoslavskiy, oscd.community
// Date: 2020-10-19
// Tags: attack.discovery, attack.t1518.001
// Description: Detects usage of system utilities (only grep for now) to discover security software discovery
// Converted by: Sigma Universal SIEM/EDR CLI

rule 0ed75b9c_c73b_424d_9e7d_496cd565fbe0 {
  meta:
    title = "Security Software Discovery - MacOs"
    description = "Detects usage of system utilities (only grep for now) to discover security software discovery"
    author = "Daniil Yugoslavskiy, oscd.community"
    severity = "MEDIUM"

  events:
    (($e.target.process.file.full_path = "/usr/bin/grep") and ((($e.target.process.command_line = /.*nessusd.*/ nocase or $e.target.process.command_line = /.*santad.*/ nocase or $e.target.process.command_line = /.*CbDefense.*/ nocase or $e.target.process.command_line = /.*falcond.*/ nocase or $e.target.process.command_line = /.*td-agent.*/ nocase or $e.target.process.command_line = /.*packetbeat.*/ nocase or $e.target.process.command_line = /.*filebeat.*/ nocase or $e.target.process.command_line = /.*auditbeat.*/ nocase or $e.target.process.command_line = /.*osqueryd.*/ nocase or $e.target.process.command_line = /.*BlockBlock.*/ nocase or $e.target.process.command_line = /.*LuLu.*/ nocase)) or (($e.target.process.command_line = /.*Little.*/ nocase and $e.target.process.command_line = /.*Snitch.*/ nocase))))

  condition:
    $e
}
