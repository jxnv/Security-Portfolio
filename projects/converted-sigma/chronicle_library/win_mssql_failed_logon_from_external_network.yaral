// Title: MSSQL Server Failed Logon From External Network
// ID: ebfe73c2-5bc9-4ed9-aaa8-8b54b2b4777d
// Status: test
// Level: medium
// Author: j4son
// Date: 2023-10-11
// Tags: attack.credential-access, attack.t1110
// Description: Detects failed logon attempts from clients with external network IP to an MSSQL server. This can be a sign of a bruteforce attack.
// Converted by: Sigma Universal SIEM/EDR CLI

rule ebfe73c2_5bc9_4ed9_aaa8_8b54b2b4777d {
  meta:
    title = "MSSQL Server Failed Logon From External Network"
    description = "Detects failed logon attempts from clients with external network IP to an MSSQL server. This can be a sign of a bruteforce attack."
    author = "j4son"
    severity = "MEDIUM"

  events:
    (($e.Provider_Name = /.*MSSQL.*/ nocase and $e.EventID = 18456) and not((($e.Data = /.*CLIENT: 10..*/ nocase or $e.Data = /.*CLIENT: 172.16..*/ nocase or $e.Data = /.*CLIENT: 172.17..*/ nocase or $e.Data = /.*CLIENT: 172.18..*/ nocase or $e.Data = /.*CLIENT: 172.19..*/ nocase or $e.Data = /.*CLIENT: 172.20..*/ nocase or $e.Data = /.*CLIENT: 172.21..*/ nocase or $e.Data = /.*CLIENT: 172.22..*/ nocase or $e.Data = /.*CLIENT: 172.23..*/ nocase or $e.Data = /.*CLIENT: 172.24..*/ nocase or $e.Data = /.*CLIENT: 172.25..*/ nocase or $e.Data = /.*CLIENT: 172.26..*/ nocase or $e.Data = /.*CLIENT: 172.27..*/ nocase or $e.Data = /.*CLIENT: 172.28..*/ nocase or $e.Data = /.*CLIENT: 172.29..*/ nocase or $e.Data = /.*CLIENT: 172.30..*/ nocase or $e.Data = /.*CLIENT: 172.31..*/ nocase or $e.Data = /.*CLIENT: 192.168..*/ nocase or $e.Data = /.*CLIENT: 127..*/ nocase or $e.Data = /.*CLIENT: 169.254..*/ nocase or $e.Data = /.*CLIENT: <local machine>.*/ nocase))))

  condition:
    $e
}
