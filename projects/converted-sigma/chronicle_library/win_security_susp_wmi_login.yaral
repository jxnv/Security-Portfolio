rule 5af54681_df95_4c26_854f_2565e13cfab0 {
  meta:
    title = "Successful Account Login Via WMI"
    description = "Detects successful logon attempts performed with WMI"
    author = "Thomas Patzke"
    severity = "LOW"

  events:
    ($e.EventID = 4624 and $e.ProcessName = /.*\\WmiPrvSE.exe$/ nocase)

  condition:
    $e
}
