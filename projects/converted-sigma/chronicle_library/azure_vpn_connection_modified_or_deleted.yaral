rule 61171ffc_d79c_4ae5_8e10_9323dba19cd3 {
  meta:
    title = "Azure VPN Connection Modified or Deleted"
    description = "Identifies when a VPN connection is modified or deleted."
    author = "Austin Songer @austinsonger"
    severity = "MEDIUM"

  events:
    (($e.operationName = "MICROSOFT.NETWORK/VPNGATEWAYS/VPNCONNECTIONS/WRITE" or $e.operationName = "MICROSOFT.NETWORK/VPNGATEWAYS/VPNCONNECTIONS/DELETE"))

  condition:
    $e
}
