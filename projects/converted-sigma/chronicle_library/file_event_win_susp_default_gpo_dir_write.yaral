// Title: Suspicious Files in Default GPO Folder
// ID: 5f87308a-0a5b-4623-ae15-d8fa1809bc60
// Status: test
// Level: medium
// Author: elhoim
// Date: 2022-04-28
// Tags: attack.stealth, attack.t1036.005
// Description: Detects the creation of copy of suspicious files (EXE/DLL) to the default GPO storage folder
// Converted by: Sigma Universal SIEM/EDR CLI

rule 5f87308a_0a5b_4623_ae15_d8fa1809bc60 {
  meta:
    title = "Suspicious Files in Default GPO Folder"
    description = "Detects the creation of copy of suspicious files (EXE/DLL) to the default GPO storage folder"
    author = "elhoim"
    severity = "MEDIUM"

  events:
    ($e.target.file.full_path = /.*\\Policies\\{31B2F340-016D-11D2-945F-00C04FB984F9}\\.*/ nocase and ($e.target.file.full_path = /.*.dll$/ nocase or $e.target.file.full_path = /.*.exe$/ nocase))

  condition:
    $e
}
