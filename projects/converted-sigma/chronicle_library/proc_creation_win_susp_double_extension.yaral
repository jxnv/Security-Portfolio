// Title: Suspicious Double Extension File Execution
// ID: 1cdd9a09-06c9-4769-99ff-626e2b3991b8
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems), @blu3_team (idea), Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-06-26
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects suspicious use of an .exe extension after a non-executable file extension like .pdf.exe, a set of spaces or underlines to cloak the executable file in spear phishing campaigns
// Converted by: Sigma Universal SIEM/EDR CLI

rule 1cdd9a09_06c9_4769_99ff_626e2b3991b8 {
  meta:
    title = "Suspicious Double Extension File Execution"
    description = "Detects suspicious use of an .exe extension after a non-executable file extension like .pdf.exe, a set of spaces or underlines to cloak the executable file in spear phishing campaigns"
    author = "Florian Roth (Nextron Systems), @blu3_team (idea), Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.file.full_path = /.*      .exe$/ nocase or $e.target.process.file.full_path = /.*______.exe$/ nocase or $e.target.process.file.full_path = /.*.doc.exe$/ nocase or $e.target.process.file.full_path = /.*.doc.js$/ nocase or $e.target.process.file.full_path = /.*.docx.exe$/ nocase or $e.target.process.file.full_path = /.*.docx.js$/ nocase or $e.target.process.file.full_path = /.*.gif.exe$/ nocase or $e.target.process.file.full_path = /.*.jpeg.exe$/ nocase or $e.target.process.file.full_path = /.*.jpg.exe$/ nocase or $e.target.process.file.full_path = /.*.mkv.exe$/ nocase or $e.target.process.file.full_path = /.*.mov.exe$/ nocase or $e.target.process.file.full_path = /.*.mp3.exe$/ nocase or $e.target.process.file.full_path = /.*.mp4.exe$/ nocase or $e.target.process.file.full_path = /.*.pdf.exe$/ nocase or $e.target.process.file.full_path = /.*.pdf.js$/ nocase or $e.target.process.file.full_path = /.*.png.exe$/ nocase or $e.target.process.file.full_path = /.*.ppt.exe$/ nocase or $e.target.process.file.full_path = /.*.ppt.js$/ nocase or $e.target.process.file.full_path = /.*.pptx.exe$/ nocase or $e.target.process.file.full_path = /.*.pptx.js$/ nocase or $e.target.process.file.full_path = /.*.rtf.exe$/ nocase or $e.target.process.file.full_path = /.*.rtf.js$/ nocase or $e.target.process.file.full_path = /.*.svg.exe$/ nocase or $e.target.process.file.full_path = /.*.txt.exe$/ nocase or $e.target.process.file.full_path = /.*.txt.js$/ nocase or $e.target.process.file.full_path = /.*.xls.exe$/ nocase or $e.target.process.file.full_path = /.*.xls.js$/ nocase or $e.target.process.file.full_path = /.*.xlsx.exe$/ nocase or $e.target.process.file.full_path = /.*.xlsx.js$/ nocase or $e.target.process.file.full_path = /.*⠀⠀⠀⠀⠀⠀.exe$/ nocase) and ($e.target.process.command_line = /.*      .exe.*/ nocase or $e.target.process.command_line = /.*______.exe.*/ nocase or $e.target.process.command_line = /.*.doc.exe.*/ nocase or $e.target.process.command_line = /.*.doc.js.*/ nocase or $e.target.process.command_line = /.*.docx.exe.*/ nocase or $e.target.process.command_line = /.*.docx.js.*/ nocase or $e.target.process.command_line = /.*.gif.exe.*/ nocase or $e.target.process.command_line = /.*.jpeg.exe.*/ nocase or $e.target.process.command_line = /.*.jpg.exe.*/ nocase or $e.target.process.command_line = /.*.mkv.exe.*/ nocase or $e.target.process.command_line = /.*.mov.exe.*/ nocase or $e.target.process.command_line = /.*.mp3.exe.*/ nocase or $e.target.process.command_line = /.*.mp4.exe.*/ nocase or $e.target.process.command_line = /.*.pdf.exe.*/ nocase or $e.target.process.command_line = /.*.pdf.js.*/ nocase or $e.target.process.command_line = /.*.png.exe.*/ nocase or $e.target.process.command_line = /.*.ppt.exe.*/ nocase or $e.target.process.command_line = /.*.ppt.js.*/ nocase or $e.target.process.command_line = /.*.pptx.exe.*/ nocase or $e.target.process.command_line = /.*.pptx.js.*/ nocase or $e.target.process.command_line = /.*.rtf.exe.*/ nocase or $e.target.process.command_line = /.*.rtf.js.*/ nocase or $e.target.process.command_line = /.*.svg.exe.*/ nocase or $e.target.process.command_line = /.*.txt.exe.*/ nocase or $e.target.process.command_line = /.*.txt.js.*/ nocase or $e.target.process.command_line = /.*.xls.exe.*/ nocase or $e.target.process.command_line = /.*.xls.js.*/ nocase or $e.target.process.command_line = /.*.xlsx.exe.*/ nocase or $e.target.process.command_line = /.*.xlsx.js.*/ nocase or $e.target.process.command_line = /.*⠀⠀⠀⠀⠀⠀.exe.*/ nocase))

  condition:
    $e
}
