// Status: test
// Level: medium
// Author: @d4ns4n_
// Date: 2023-04-24
// Tags: attack.execution, attack.t1059
// Description: Detects usage of "xterm" as a potential reverse shell tunnel
// Converted by: Sigma Universal SIEM/EDR CLI

rule 4e25af4b_246d_44ea_8563_e42aacab006b {
  meta:
    title = "Potential Xterm Reverse Shell"
    description = "Detects usage of "xterm" as a potential reverse shell tunnel"
    author = "@d4ns4n_"
    severity = "MEDIUM"

  events:
    ($e.target.process.file.full_path = /.*xterm.*/ nocase and $e.target.process.command_line = /.*-display.*/ nocase and $e.target.process.command_line = /.*:1$/ nocase)

  condition:
    $e
}
