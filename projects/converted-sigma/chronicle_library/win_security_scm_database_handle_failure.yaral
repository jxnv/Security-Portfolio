rule 13addce7_47b2_4ca0_a98f_1de964d1d669 {
  meta:
    title = "SCM Database Handle Failure"
    description = "Detects non-system users failing to get a handle of the SCM database."
    author = "Roberto Rodriguez @Cyb3rWard0g"
    severity = "MEDIUM"

  events:
    (($e.EventID = 4656 and $e.ObjectType = "SC_MANAGER OBJECT" and $e.ObjectName = "ServicesActive" and $e.AccessMask = "0xf003f") and not(($e.SubjectLogonId = "0x3e4")))

  condition:
    $e
}
