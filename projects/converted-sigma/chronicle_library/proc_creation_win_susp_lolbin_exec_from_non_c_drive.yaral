// Title: LOLBIN Execution From Abnormal Drive
// ID: d4ca7c59-e9e4-42d8-bf57-91a776efcb87
// Status: test
// Level: medium
// Author: Christopher Peacock '@securepeacock', SCYTHE '@scythe_io', Angelo Violetti - SEC Consult '@angelo_violetti', Aaron Herman
// Date: 2022-01-25
// Tags: attack.stealth
// Description: Detects LOLBINs executing from an abnormal or uncommon drive such as a mounted ISO.
// Converted by: Sigma Universal SIEM/EDR CLI

rule d4ca7c59_e9e4_42d8_bf57_91a776efcb87 {
  meta:
    title = "LOLBIN Execution From Abnormal Drive"
    description = "Detects LOLBINs executing from an abnormal or uncommon drive such as a mounted ISO."
    author = "Christopher Peacock '@securepeacock', SCYTHE '@scythe_io', Angelo Violetti - SEC Consult '@angelo_violetti', Aaron Herman"
    severity = "MEDIUM"

  events:
    (((($e.target.process.file.full_path = /.*\\calc.exe$/ nocase or $e.target.process.file.full_path = /.*\\certutil.exe$/ nocase or $e.target.process.file.full_path = /.*\\cmstp.exe$/ nocase or $e.target.process.file.full_path = /.*\\cscript.exe$/ nocase or $e.target.process.file.full_path = /.*\\installutil.exe$/ nocase or $e.target.process.file.full_path = /.*\\mshta.exe$/ nocase or $e.target.process.file.full_path = /.*\\regsvr32.exe$/ nocase or $e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase or $e.target.process.file.full_path = /.*\\wscript.exe$/ nocase)) or (($e.target.process.file.name = "CALC.EXE" or $e.target.process.file.name = "CertUtil.exe" or $e.target.process.file.name = "CMSTP.EXE" or $e.target.process.file.name = "cscript.exe" or $e.target.process.file.name = "installutil.exe" or $e.target.process.file.name = "MSHTA.EXE" or $e.target.process.file.name = "REGSVR32.EXE" or $e.target.process.file.name = "RUNDLL32.EXE" or $e.target.process.file.name = "wscript.exe"))) and not((($e.CurrentDirectory = /.*C:\\.*/ nocase) or ($e.CurrentDirectory = "") or (not ($e.CurrentDirectory = /.*/)))))

  condition:
    $e
}
