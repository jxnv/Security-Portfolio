// Title: HackTool - Rubeus Execution - ScriptBlock
// ID: 3245cd30-e015-40ff-a31d-5cadd5f377ec
// Status: test
// Level: high
// Author: Christian Burkard (Nextron Systems), Florian Roth (Nextron Systems)
// Date: 2023-04-27
// Tags: attack.credential-access, attack.t1003, attack.t1558.003, attack.lateral-movement, attack.t1550.003
// Description: Detects the execution of the hacktool Rubeus using specific command line flags
// Converted by: Sigma Universal SIEM/EDR CLI

rule 3245cd30_e015_40ff_a31d_5cadd5f377ec {
  meta:
    title = "HackTool - Rubeus Execution - ScriptBlock"
    description = "Detects the execution of the hacktool Rubeus using specific command line flags"
    author = "Christian Burkard (Nextron Systems), Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.ScriptBlockText = /.*asreproast .*/ nocase or $e.ScriptBlockText = /.*dump /service:krbtgt .*/ nocase or $e.ScriptBlockText = /.*dump /luid:0x.*/ nocase or $e.ScriptBlockText = /.*kerberoast .*/ nocase or $e.ScriptBlockText = /.*createnetonly /program:.*/ nocase or $e.ScriptBlockText = /.*ptt /ticket:.*/ nocase or $e.ScriptBlockText = /.*/impersonateuser:.*/ nocase or $e.ScriptBlockText = /.*renew /ticket:.*/ nocase or $e.ScriptBlockText = /.*asktgt /user:.*/ nocase or $e.ScriptBlockText = /.*harvest /interval:.*/ nocase or $e.ScriptBlockText = /.*s4u /user:.*/ nocase or $e.ScriptBlockText = /.*s4u /ticket:.*/ nocase or $e.ScriptBlockText = /.*hash /password:.*/ nocase or $e.ScriptBlockText = /.*golden /aes256:.*/ nocase or $e.ScriptBlockText = /.*silver /user:.*/ nocase))

  condition:
    $e
}
