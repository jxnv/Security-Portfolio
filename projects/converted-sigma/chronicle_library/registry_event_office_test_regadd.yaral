// Status: test
// Level: medium
// Author: omkar72
// Date: 2020-10-25
// Tags: attack.persistence, attack.t1137.002
// Description: Detects the addition of office test registry that allows a user to specify an arbitrary DLL that will be executed every time an Office application is started
// Converted by: Sigma Universal SIEM/EDR CLI

rule 3d27f6dd_1c74_4687_b4fa_ca849d128d1c {
  meta:
    title = "Office Application Startup - Office Test"
    description = "Detects the addition of office test registry that allows a user to specify an arbitrary DLL that will be executed every time an Office application is started"
    author = "omkar72"
    severity = "MEDIUM"

  events:
    ($e.TargetObject = /.*\\Software\\Microsoft\\Office test\\Special\\Perf.*/ nocase)

  condition:
    $e
}
