// Title: GCP Access Policy Deleted
// ID: 32438676-1dba-4ac7-bf69-b86cba995e05
// Status: test
// Level: medium
// Author: Bryan Lim
// Date: 2024-01-12
// Tags: attack.persistence, attack.privilege-escalation, attack.t1098
// Description: Detects when an access policy that is applied to a GCP cloud resource is deleted.
// An adversary would be able to remove access policies to gain access to a GCP cloud resource.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 32438676_1dba_4ac7_bf69_b86cba995e05 {
  meta:
    title = "GCP Access Policy Deleted"
    description = "Detects when an access policy that is applied to a GCP cloud resource is deleted. An adversary would be able to remove access policies to gain access to a GCP cloud resource."
    author = "Bryan Lim"
    severity = "MEDIUM"

  events:
    (($e.data.protoPayload.authorizationInfo.permission = "accesscontextmanager.accessPolicies.delete" or $e.data.protoPayload.authorizationInfo.permission = "accesscontextmanager.accessPolicies.accessLevels.delete" or $e.data.protoPayload.authorizationInfo.permission = "accesscontextmanager.accessPolicies.accessZones.delete" or $e.data.protoPayload.authorizationInfo.permission = "accesscontextmanager.accessPolicies.authorizedOrgsDescs.delete") and $e.data.protoPayload.authorizationInfo.granted = "true" and $e.data.protoPayload.serviceName = "accesscontextmanager.googleapis.com")

  condition:
    $e
}
