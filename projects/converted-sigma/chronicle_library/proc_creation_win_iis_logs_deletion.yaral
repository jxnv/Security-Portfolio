// Title: IIS WebServer Log Deletion via CommandLine Utilities
// ID: 0649be4a-aeb0-45b0-b89e-7f1668f6d9c0
// Status: experimental
// Level: medium
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-09-02
// Tags: attack.stealth, attack.t1070
// Description: Detects attempts to delete Internet Information Services (IIS) log files via command line utilities, which is a common defense evasion technique used by attackers to cover their tracks.
// Threat actors often abuse vulnerabilities in web applications hosted on IIS servers to gain initial access and later delete IIS logs to evade detection.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 0649be4a_aeb0_45b0_b89e_7f1668f6d9c0 {
  meta:
    title = "IIS WebServer Log Deletion via CommandLine Utilities"
    description = "Detects attempts to delete Internet Information Services (IIS) log files via command line utilities, which is a common defense evasion technique used by attackers to cover their tracks. Threat actors often abuse vulnerabilities in web applications hosted on IIS servers to gain initial access and later delete IIS logs to evade detection."
    author = "Swachchhanda Shrawan Poudel (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*del .*/ nocase or $e.target.process.command_line = /.*erase .*/ nocase or $e.target.process.command_line = /.*rm .*/ nocase or $e.target.process.command_line = /.*remove-item .*/ nocase or $e.target.process.command_line = /.*rmdir .*/ nocase)) and ($e.target.process.command_line = /.*\\inetpub\\logs\\.*/ nocase) and ((($e.target.process.file.full_path = /.*\\cmd.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell_ise.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase)) or (($e.target.process.file.name = "cmd.exe" or $e.target.process.file.name = "powershell.exe" or $e.target.process.file.name = "powershell_ise.exe" or $e.target.process.file.name = "pwsh.dll"))))

  condition:
    $e
}
