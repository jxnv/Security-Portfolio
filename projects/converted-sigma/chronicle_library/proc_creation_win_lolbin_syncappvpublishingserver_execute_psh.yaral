rule fbd7c32d_db2a_4418_b92c_566eb8911133 {
  meta:
    title = "SyncAppvPublishingServer Execute Arbitrary PowerShell Code"
    description = "Executes arbitrary PowerShell code using SyncAppvPublishingServer.exe."
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.target.process.command_line = /.*\"n; .*/ nocase) and (($e.target.process.file.full_path = /.*\\SyncAppvPublishingServer.exe$/ nocase) or ($e.target.process.file.name = "syncappvpublishingserver.exe")))

  condition:
    $e
}
