// Title: HackTool - RemoteKrbRelay SMB Relay Secrets Dump Module Indicators
// ID: 3ab79e90-9fab-4cdf-a7b2-6522bc742adb
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-06-27
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects the creation of file with specific names used by RemoteKrbRelay SMB Relay attack module.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 3ab79e90_9fab_4cdf_a7b2_6522bc742adb {
  meta:
    title = "HackTool - RemoteKrbRelay SMB Relay Secrets Dump Module Indicators"
    description = "Detects the creation of file with specific names used by RemoteKrbRelay SMB Relay attack module."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.file.full_path = /.*:\\windows\\temp\\sam.tmp$/ nocase or $e.target.file.full_path = /.*:\\windows\\temp\\sec.tmp$/ nocase or $e.target.file.full_path = /.*:\\windows\\temp\\sys.tmp$/ nocase))

  condition:
    $e
}
