rule 185d7418_f250_42d0_b72e_0c8b70661e93 {
  meta:
    title = "Suspicious Diantz Download and Compress Into a CAB File"
    description = "Download and compress a remote file and store it in a cab file on local machine."
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.target.process.command_line = /.*diantz.exe.*/ nocase and $e.target.process.command_line = /.* \\\\\\\\.*/ nocase and $e.target.process.command_line = /.*.cab.*/ nocase))

  condition:
    $e
}
