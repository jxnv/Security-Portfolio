// Title: Suspicious Git Clone - Linux
// ID: cfec9d29-64ec-4a0f-9ffe-0fdb856d5446
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-03
// Tags: attack.reconnaissance, attack.t1593.003
// Description: Detects execution of "git" in order to clone a remote repository that contain suspicious keywords which might be suspicious
// Converted by: Sigma Universal SIEM/EDR CLI

rule cfec9d29_64ec_4a0f_9ffe_0fdb856d5446 {
  meta:
    title = "Suspicious Git Clone - Linux"
    description = "Detects execution of "git" in order to clone a remote repository that contain suspicious keywords which might be suspicious"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.target.process.file.full_path = /.*/git$/ nocase and $e.target.process.command_line = /.* clone .*/ nocase) and (($e.target.process.command_line = /.*exploit.*/ nocase or $e.target.process.command_line = /.*Vulns.*/ nocase or $e.target.process.command_line = /.*vulnerability.*/ nocase or $e.target.process.command_line = /.*RCE.*/ nocase or $e.target.process.command_line = /.*RemoteCodeExecution.*/ nocase or $e.target.process.command_line = /.*Invoke-.*/ nocase or $e.target.process.command_line = /.*CVE-.*/ nocase or $e.target.process.command_line = /.*poc-.*/ nocase or $e.target.process.command_line = /.*ProofOfConcept.*/ nocase or $e.target.process.command_line = /.*proxyshell.*/ nocase or $e.target.process.command_line = /.*log4shell.*/ nocase or $e.target.process.command_line = /.*eternalblue.*/ nocase or $e.target.process.command_line = /.*eternal-blue.*/ nocase or $e.target.process.command_line = /.*MS17-.*/ nocase)))

  condition:
    $e
}
