// Title: Communication To Ngrok Tunneling Service - Linux
// ID: 19bf6fdb-7721-4f3d-867f-53467f6a5db6
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-11-03
// Tags: attack.exfiltration, attack.command-and-control, attack.t1567, attack.t1568.002, attack.t1572, attack.t1090, attack.t1102, attack.s0508
// Description: Detects an executable accessing an ngrok tunneling endpoint, which could be a sign of forbidden exfiltration of data exfiltration by malicious actors
// Converted by: Sigma Universal SIEM/EDR CLI

rule 19bf6fdb_7721_4f3d_867f_53467f6a5db6 {
  meta:
    title = "Communication To Ngrok Tunneling Service - Linux"
    description = "Detects an executable accessing an ngrok tunneling endpoint, which could be a sign of forbidden exfiltration of data exfiltration by malicious actors"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.DestinationHostname = /.*tunnel.us.ngrok.com.*/ nocase or $e.DestinationHostname = /.*tunnel.eu.ngrok.com.*/ nocase or $e.DestinationHostname = /.*tunnel.ap.ngrok.com.*/ nocase or $e.DestinationHostname = /.*tunnel.au.ngrok.com.*/ nocase or $e.DestinationHostname = /.*tunnel.sa.ngrok.com.*/ nocase or $e.DestinationHostname = /.*tunnel.jp.ngrok.com.*/ nocase or $e.DestinationHostname = /.*tunnel.in.ngrok.com.*/ nocase))

  condition:
    $e
}
