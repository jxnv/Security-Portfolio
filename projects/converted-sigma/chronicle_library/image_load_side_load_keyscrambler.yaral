// Title: Potential DLL Sideloading Of KeyScramblerIE.DLL Via KeyScrambler.EXE
// ID: d2451be2-b582-4e15-8701-4196ac180260
// Status: test
// Level: high
// Author: Swachchhanda Shrawan Poudel
// Date: 2024-04-15
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL side loading of "KeyScramblerIE.dll" by "KeyScrambler.exe".
// Various threat actors and malware have been found side loading a masqueraded "KeyScramblerIE.dll" through "KeyScrambler.exe".
// Converted by: Sigma Universal SIEM/EDR CLI

rule d2451be2_b582_4e15_8701_4196ac180260 {
  meta:
    title = "Potential DLL Sideloading Of KeyScramblerIE.DLL Via KeyScrambler.EXE"
    description = "Detects potential DLL side loading of "KeyScramblerIE.dll" by "KeyScrambler.exe". Various threat actors and malware have been found side loading a masqueraded "KeyScramblerIE.dll" through "KeyScrambler.exe"."
    author = "Swachchhanda Shrawan Poudel"
    severity = "HIGH"

  events:
    ((($e.target.process.file.full_path = /.*\\KeyScrambler.exe$/ nocase or $e.target.process.file.full_path = /.*\\KeyScramblerLogon.exe$/ nocase) and $e.ImageLoaded = /.*\\KeyScramblerIE.dll$/ nocase) and not(((($e.target.process.file.full_path = /.*C:\\Program Files (x86)\\KeyScrambler\\.*/ nocase or $e.target.process.file.full_path = /.*C:\\Program Files\\KeyScrambler\\.*/ nocase) and ($e.ImageLoaded = /.*C:\\Program Files (x86)\\KeyScrambler\\.*/ nocase or $e.ImageLoaded = /.*C:\\Program Files\\KeyScrambler\\.*/ nocase)) or ($e.Signature = "QFX Software Corporation" and $e.SignatureStatus = "Valid"))))

  condition:
    $e
}
