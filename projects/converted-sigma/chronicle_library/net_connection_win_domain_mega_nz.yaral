// Title: Network Connection Initiated To Mega.nz
// ID: fdeebdf0-9f3f-4d08-84a6-4c4d13e39fe4
// Status: test
// Level: low
// Author: Florian Roth (Nextron Systems)
// Date: 2021-12-06
// Tags: attack.exfiltration, attack.t1567.002
// Description: Detects a network connection initiated by a binary to "api.mega.co.nz".
// Attackers were seen abusing file sharing websites similar to "mega.nz" in order to upload/download additional payloads.
// Converted by: Sigma Universal SIEM/EDR CLI

rule fdeebdf0_9f3f_4d08_84a6_4c4d13e39fe4 {
  meta:
    title = "Network Connection Initiated To Mega.nz"
    description = "Detects a network connection initiated by a binary to "api.mega.co.nz". Attackers were seen abusing file sharing websites similar to "mega.nz" in order to upload/download additional payloads."
    author = "Florian Roth (Nextron Systems)"
    severity = "LOW"

  events:
    ($e.Initiated = "true" and ($e.DestinationHostname = /.*mega.co.nz$/ nocase or $e.DestinationHostname = /.*mega.nz$/ nocase))

  condition:
    $e
}
