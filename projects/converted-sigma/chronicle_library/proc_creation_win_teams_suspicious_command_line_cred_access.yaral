// Title: Potentially Suspicious Command Targeting Teams Sensitive Files
// ID: d2eb17db-1d39-41dc-b57f-301f6512fa75
// Status: test
// Level: medium
// Author: @SerkinValery
// Date: 2022-09-16
// Tags: attack.credential-access, attack.t1528
// Description: Detects a commandline containing references to the Microsoft Teams database or cookies files from a process other than Teams.
// The database might contain authentication tokens and other sensitive information about the logged in accounts.
// Converted by: Sigma Universal SIEM/EDR CLI

rule d2eb17db_1d39_41dc_b57f_301f6512fa75 {
  meta:
    title = "Potentially Suspicious Command Targeting Teams Sensitive Files"
    description = "Detects a commandline containing references to the Microsoft Teams database or cookies files from a process other than Teams. The database might contain authentication tokens and other sensitive information about the logged in accounts."
    author = "@SerkinValery"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*\\Microsoft\\Teams\\Cookies.*/ nocase or $e.target.process.command_line = /.*\\Microsoft\\Teams\\Local Storage\\leveldb.*/ nocase)) and not(($e.target.process.file.full_path = /.*\\Microsoft\\Teams\\current\\Teams.exe$/ nocase)))

  condition:
    $e
}
