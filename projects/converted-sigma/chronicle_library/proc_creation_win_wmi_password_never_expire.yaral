// Title: Password Set to Never Expire via WMI
// ID: 7864a175-3654-4824-9f0d-f0da18ab27c0
// Status: experimental
// Level: medium
// Author: Daniel Koifman (KoifSec)
// Date: 2025-07-30
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1047, attack.t1098
// Description: Detects the use of wmic.exe to modify user account settings and explicitly disable password expiration.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 7864a175_3654_4824_9f0d_f0da18ab27c0 {
  meta:
    title = "Password Set to Never Expire via WMI"
    description = "Detects the use of wmic.exe to modify user account settings and explicitly disable password expiration."
    author = "Daniel Koifman (KoifSec)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*useraccount.*/ nocase and $e.target.process.command_line = /.* set .*/ nocase and $e.target.process.command_line = /.*passwordexpires.*/ nocase and $e.target.process.command_line = /.*false.*/ nocase)) and (($e.target.process.file.full_path = /.*\\wmic.exe$/ nocase) or ($e.target.process.file.name = "wmic.exe")))

  condition:
    $e
}
