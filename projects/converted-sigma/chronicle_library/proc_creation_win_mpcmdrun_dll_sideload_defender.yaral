// Title: Potential Mpclient.DLL Sideloading Via Defender Binaries
// ID: 7002aa10-b8d4-47ae-b5ba-51ab07e228b9
// Status: test
// Level: high
// Author: Bhabesh Raj
// Date: 2022-08-01
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential sideloading of "mpclient.dll" by Windows Defender processes ("MpCmdRun" and "NisSrv") from their non-default directory.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 7002aa10_b8d4_47ae_b5ba_51ab07e228b9 {
  meta:
    title = "Potential Mpclient.DLL Sideloading Via Defender Binaries"
    description = "Detects potential sideloading of "mpclient.dll" by Windows Defender processes ("MpCmdRun" and "NisSrv") from their non-default directory."
    author = "Bhabesh Raj"
    severity = "HIGH"

  events:
    ((($e.target.process.file.full_path = /.*\\MpCmdRun.exe$/ nocase or $e.target.process.file.full_path = /.*\\NisSrv.exe$/ nocase)) and not((($e.target.process.file.full_path = /^C:\\Program Files (x86)\\Windows Defender\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\Microsoft Security Client\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\Windows Defender\\.*/ nocase or $e.target.process.file.full_path = /^C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\WinSxS\\.*/ nocase))))

  condition:
    $e
}
