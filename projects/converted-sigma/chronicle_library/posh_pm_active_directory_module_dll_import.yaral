// Title: Potential Active Directory Enumeration Using AD Module - PsModule
// ID: 74176142-4684-4d8a-8b0a-713257e7df8e
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), frack113
// Date: 2023-01-22
// Tags: attack.reconnaissance, attack.discovery, attack.impact
// Description: Detects usage of the "Import-Module" cmdlet to load the "Microsoft.ActiveDirectory.Management.dl" DLL. Which is often used by attackers to perform AD enumeration.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 74176142_4684_4d8a_8b0a_713257e7df8e {
  meta:
    title = "Potential Active Directory Enumeration Using AD Module - PsModule"
    description = "Detects usage of the "Import-Module" cmdlet to load the "Microsoft.ActiveDirectory.Management.dl" DLL. Which is often used by attackers to perform AD enumeration."
    author = "Nasreddine Bencherchali (Nextron Systems), frack113"
    severity = "MEDIUM"

  events:
    ((($e.Payload = /.*Import-Module .*/ nocase or $e.Payload = /.*ipmo .*/ nocase)) and ($e.Payload = /.*Microsoft.ActiveDirectory.Management.dll.*/ nocase))

  condition:
    $e
}
