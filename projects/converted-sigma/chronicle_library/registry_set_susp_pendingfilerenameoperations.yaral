// Title: Potential PendingFileRenameOperations Tampering
// ID: 4eec988f-7bf0-49f1-8675-1e6a510b3a2a
// Status: test
// Level: medium
// Author: frack113
// Date: 2023-01-27
// Tags: attack.stealth, attack.t1036.003
// Description: Detect changes to the "PendingFileRenameOperations" registry key from uncommon or suspicious images locations to stage currently used files for rename or deletion after reboot.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 4eec988f_7bf0_49f1_8675_1e6a510b3a2a {
  meta:
    title = "Potential PendingFileRenameOperations Tampering"
    description = "Detect changes to the "PendingFileRenameOperations" registry key from uncommon or suspicious images locations to stage currently used files for rename or deletion after reboot."
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.TargetObject = /.*\\CurrentControlSet\\Control\\Session Manager\\PendingFileRenameOperations.*/ nocase) and ((($e.target.process.file.full_path = /.*\\reg.exe$/ nocase or $e.target.process.file.full_path = /.*\\regedit.exe$/ nocase)) or ($e.target.process.file.full_path = /.*\\Users\\Public\\.*/ nocase)))

  condition:
    $e
}
