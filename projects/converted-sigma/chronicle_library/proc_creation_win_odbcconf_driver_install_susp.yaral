// Title: Suspicious Driver/DLL Installation Via Odbcconf.EXE
// ID: cb0fe7c5-f3a3-484d-aa25-d350a7912729
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-23
// Tags: attack.stealth, attack.t1218.008
// Description: Detects execution of "odbcconf" with the "INSTALLDRIVER" action where the driver doesn't contain a ".dll" extension. This is often used as a defense evasion method.
// Converted by: Sigma Universal SIEM/EDR CLI

rule cb0fe7c5_f3a3_484d_aa25_d350a7912729 {
  meta:
    title = "Suspicious Driver/DLL Installation Via Odbcconf.EXE"
    description = "Detects execution of "odbcconf" with the "INSTALLDRIVER" action where the driver doesn't contain a ".dll" extension. This is often used as a defense evasion method."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*INSTALLDRIVER .*/ nocase) and (($e.target.process.file.full_path = /.*\\odbcconf.exe$/ nocase) or ($e.target.process.file.name = "odbcconf.exe"))) and not(($e.target.process.command_line = /.*.dll.*/ nocase)))

  condition:
    $e
}
