th = "C:\\WINDOWS\\system32\\svchost.exe") or ($e.target.process.file.full_path = "System") or ($e.target.process.file.full_path = /^C:\\Windows\\.*/ nocase and $e.target.process.file.full_path = /.*\\TiWorker.exe$/ nocase))) and not(((($e.target.process.file.full_path = "C:\\Program Files (x86)\\Dropbox\\Update\\DropboxUpdate.exe" or $e.target.process.file.full_path = "C:\\Program Files\\Dropbox\\Update\\DropboxUpdate.exe")) or (($e.target.process.file.full_path = /.*C:\\Program Files (x86)\\Microsoft\\EdgeUpdate\\MicrosoftEdgeUpdate.exe$/ nocase or $e.target.process.file.full_path = /.*C:\\Program Files\\Microsoft\\EdgeUpdate\\MicrosoftEdgeUpdate.exe$/ nocase)) or (($e.target.process.file.full_path = /.*C:\\Program Files (x86)\\Microsoft OneDrive\\OneDrive.exe$/ nocase or $e.target.process.file.full_path = /.*C:\\Program Files\\Microsoft OneDrive\\OneDrive.exe$/ nocase)))))

