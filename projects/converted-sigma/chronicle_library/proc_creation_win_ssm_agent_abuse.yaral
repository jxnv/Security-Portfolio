rule d20ee2f4_822c_4827_9e15_41500b1fff10 {
  meta:
    title = "Potential Amazon SSM Agent Hijacking"
    description = "Detects potential Amazon SSM agent hijack attempts as outlined in the Mitiga research report."
    author = "Muhammad Faisal"
    severity = "MEDIUM"

  events:
    ($e.target.process.file.full_path = /.*\\amazon-ssm-agent.exe$/ nocase and ($e.target.process.command_line = /.*-register .*/ nocase and $e.target.process.command_line = /.*-code .*/ nocase and $e.target.process.command_line = /.*-id .*/ nocase and $e.target.process.command_line = /.*-region .*/ nocase))

  condition:
    $e
}
