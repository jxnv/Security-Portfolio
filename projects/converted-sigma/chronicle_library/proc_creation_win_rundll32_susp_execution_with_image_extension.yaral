// Title: Suspicious Rundll32 Execution With Image Extension
// ID: 4aa6040b-3f28-44e3-a769-9208e5feb5ec
// Status: test
// Level: high
// Author: Hieu Tran
// Date: 2023-03-13
// Tags: attack.stealth, attack.t1218.011
// Description: Detects the execution of Rundll32.exe with DLL files masquerading as image files
// Converted by: Sigma Universal SIEM/EDR CLI

rule 4aa6040b_3f28_44e3_a769_9208e5feb5ec {
  meta:
    title = "Suspicious Rundll32 Execution With Image Extension"
    description = "Detects the execution of Rundll32.exe with DLL files masquerading as image files"
    author = "Hieu Tran"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*.bmp.*/ nocase or $e.target.process.command_line = /.*.cr2.*/ nocase or $e.target.process.command_line = /.*.eps.*/ nocase or $e.target.process.command_line = /.*.gif.*/ nocase or $e.target.process.command_line = /.*.ico.*/ nocase or $e.target.process.command_line = /.*.jpeg.*/ nocase or $e.target.process.command_line = /.*.jpg.*/ nocase or $e.target.process.command_line = /.*.nef.*/ nocase or $e.target.process.command_line = /.*.orf.*/ nocase or $e.target.process.command_line = /.*.png.*/ nocase or $e.target.process.command_line = /.*.raw.*/ nocase or $e.target.process.command_line = /.*.sr2.*/ nocase or $e.target.process.command_line = /.*.tif.*/ nocase or $e.target.process.command_line = /.*.tiff.*/ nocase)) and (($e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase) or ($e.target.process.file.name = "RUNDLL32.exe")))

  condition:
    $e
}
