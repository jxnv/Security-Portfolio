// Title: Potentially Suspicious ODBC Driver Registered
// ID: e4d22291-f3d5-4b78-9a0c-a1fbaf32a6a4
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-23
// Tags: attack.credential-access, attack.persistence, attack.t1003
// Description: Detects the registration of a new ODBC driver where the driver is located in a potentially suspicious location
// Converted by: Sigma Universal SIEM/EDR CLI

rule e4d22291_f3d5_4b78_9a0c_a1fbaf32a6a4 {
  meta:
    title = "Potentially Suspicious ODBC Driver Registered"
    description = "Detects the registration of a new ODBC driver where the driver is located in a potentially suspicious location"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ($e.TargetObject = /.*\\SOFTWARE\\ODBC\\ODBCINST.INI\\.*/ nocase and ($e.TargetObject = /.*\\Driver$/ nocase or $e.TargetObject = /.*\\Setup$/ nocase) and ($e.Details = /.*:\\PerfLogs\\.*/ nocase or $e.Details = /.*:\\ProgramData\\.*/ nocase or $e.Details = /.*:\\Temp\\.*/ nocase or $e.Details = /.*:\\Users\\Public\\.*/ nocase or $e.Details = /.*:\\Windows\\Registration\\CRMLog.*/ nocase or $e.Details = /.*:\\Windows\\System32\\com\\dmp\\.*/ nocase or $e.Details = /.*:\\Windows\\System32\\FxsTmp\\.*/ nocase or $e.Details = /.*:\\Windows\\System32\\Microsoft\\Crypto\\RSA\\MachineKeys\\.*/ nocase or $e.Details = /.*:\\Windows\\System32\\spool\\drivers\\color\\.*/ nocase or $e.Details = /.*:\\Windows\\System32\\spool\\PRINTERS\\.*/ nocase or $e.Details = /.*:\\Windows\\System32\\spool\\SERVERS\\.*/ nocase or $e.Details = /.*:\\Windows\\System32\\Tasks_Migrated\\.*/ nocase or $e.Details = /.*:\\Windows\\System32\\Tasks\\Microsoft\\Windows\\SyncCenter\\.*/ nocase or $e.Details = /.*:\\Windows\\SysWOW64\\com\\dmp\\.*/ nocase or $e.Details = /.*:\\Windows\\SysWOW64\\FxsTmp\\.*/ nocase or $e.Details = /.*:\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\PLA\\System\\.*/ nocase or $e.Details = /.*:\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\SyncCenter\\.*/ nocase or $e.Details = /.*:\\Windows\\Tasks\\.*/ nocase or $e.Details = /.*:\\Windows\\Temp\\.*/ nocase or $e.Details = /.*:\\Windows\\Tracing\\.*/ nocase or $e.Details = /.*\\AppData\\Local\\Temp\\.*/ nocase or $e.Details = /.*\\AppData\\Roaming\\.*/ nocase))

  condition:
    $e
}
