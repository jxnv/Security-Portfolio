// Title: TrustedPath UAC Bypass Pattern
// ID: 4ac47ed3-44c2-4b1f-9d51-bf46e8914126
// Status: test
// Level: critical
// Author: Florian Roth (Nextron Systems)
// Date: 2021-08-27
// Tags: attack.privilege-escalation, attack.t1548.002
// Description: Detects indicators of a UAC bypass method by mocking directories
// Converted by: Sigma Universal SIEM/EDR CLI

rule 4ac47ed3_44c2_4b1f_9d51_bf46e8914126 {
  meta:
    title = "TrustedPath UAC Bypass Pattern"
    description = "Detects indicators of a UAC bypass method by mocking directories"
    author = "Florian Roth (Nextron Systems)"
    severity = "CRITICAL"

  events:
    (($e.target.process.file.full_path = /.*C:\\Windows \\System32\\.*/ nocase or $e.target.process.file.full_path = /.*C:\\Windows \\SysWOW64\\.*/ nocase))

  condition:
    $e
}
