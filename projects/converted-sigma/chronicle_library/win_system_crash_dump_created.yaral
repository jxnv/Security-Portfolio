// Tags: attack.credential-access, attack.collection, attack.t1003.002, attack.t1005
// Description: Detects "BugCheck" errors indicating the system rebooted due to a crash, capturing the bugcheck code, dump file path, and report ID.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 882fbe50_d8d7_4e29_ae80_0648a8556866 {
  meta:
    title = "Crash Dump Created By Operating System"
    description = "Detects "BugCheck" errors indicating the system rebooted due to a crash, capturing the bugcheck code, dump file path, and report ID."
    author = "Jason Mull"
    severity = "MEDIUM"

  events:
    ($e.Provider_Name = "Microsoft-Windows-WER-SystemErrorReporting" and $e.EventID = 1001)

  condition:
    $e
}
