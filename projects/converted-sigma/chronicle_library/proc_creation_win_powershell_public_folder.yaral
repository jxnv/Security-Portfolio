// Title: Execution of Powershell Script in Public Folder
// ID: fb9d3ff7-7348-46ab-af8c-b55f5fbf39b4
// Status: test
// Level: high
// Author: Max Altgelt (Nextron Systems)
// Date: 2022-04-06
// Tags: attack.execution, attack.t1059.001
// Description: This rule detects execution of PowerShell scripts located in the "C:\Users\Public" folder
// Converted by: Sigma Universal SIEM/EDR CLI

rule fb9d3ff7_7348_46ab_af8c_b55f5fbf39b4 {
  meta:
    title = "Execution of Powershell Script in Public Folder"
    description = "This rule detects execution of PowerShell scripts located in the "C:\Users\Public" folder"
    author = "Max Altgelt (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase) and ($e.target.process.command_line = /.*-f C:\\Users\\Public.*/ nocase or $e.target.process.command_line = /.*-f \"C:\\Users\\Public.*/ nocase or $e.target.process.command_line = /.*-f %Public%.*/ nocase or $e.target.process.command_line = /.*-fi C:\\Users\\Public.*/ nocase or $e.target.process.command_line = /.*-fi \"C:\\Users\\Public.*/ nocase or $e.target.process.command_line = /.*-fi %Public%.*/ nocase or $e.target.process.command_line = /.*-fil C:\\Users\\Public.*/ nocase or $e.target.process.command_line = /.*-fil \"C:\\Users\\Public.*/ nocase or $e.target.process.command_line = /.*-fil %Public%.*/ nocase or $e.target.process.command_line = /.*-file C:\\Users\\Public.*/ nocase or $e.target.process.command_line = /.*-file \"C:\\Users\\Public.*/ nocase or $e.target.process.command_line = /.*-file %Public%.*/ nocase))

  condition:
    $e
}
