rule 410d2a41_1e6d_452f_85e5_abdd8257a823 {
  meta:
    title = "Azure Application Deleted"
    description = "Identifies when a application is deleted in Azure."
    author = "Austin Songer @austinsonger"
    severity = "MEDIUM"

  events:
    (($e.operationName = "Delete application" or $e.operationName = "Hard Delete application" or $e.operationName = "Delete administrative unit"))

  condition:
    $e
}
