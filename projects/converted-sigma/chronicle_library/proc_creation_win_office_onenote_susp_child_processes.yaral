// Title: Suspicious Microsoft OneNote Child Process
// ID: c27515df-97a9-4162-8a60-dc0eeb51b775
// Status: test
// Level: high
// Author: Tim Rauch (Nextron Systems), Nasreddine Bencherchali (Nextron Systems), Elastic (idea)
// Date: 2022-10-21
// Tags: attack.t1566, attack.t1566.001, attack.initial-access
// Description: Detects suspicious child processes of the Microsoft OneNote application. This may indicate an attempt to execute malicious embedded objects from a .one file.
// Converted by: Sigma Universal SIEM/EDR CLI

rule c27515df_97a9_4162_8a60_dc0eeb51b775 {
  meta:
    title = "Suspicious Microsoft OneNote Child Process"
    description = "Detects suspicious child processes of the Microsoft OneNote application. This may indicate an attempt to execute malicious embedded objects from a .one file."
    author = "Tim Rauch (Nextron Systems), Nasreddine Bencherchali (Nextron Systems), Elastic (idea)"
    severity = "HIGH"

  events:
    (($e.principal.process.file.full_path = /.*\\onenote.exe$/ nocase) and (($e.target.process.file.full_path = /.*\\explorer.exe$/ nocase and ($e.target.process.command_line = /.*.hta.*/ nocase or $e.target.process.command_line = /.*.vb.*/ nocase or $e.target.process.command_line = /.*.wsh.*/ nocase or $e.target.process.command_line = /.*.js.*/ nocase or $e.target.process.command_line = /.*.ps.*/ nocase or $e.target.process.command_line = /.*.scr.*/ nocase or $e.target.process.command_line = /.*.pif.*/ nocase or $e.target.process.command_line = /.*.bat.*/ nocase or $e.target.process.command_line = /.*.cmd.*/ nocase)) or ((($e.target.process.file.name = "bitsadmin.exe" or $e.target.process.file.name = "CertOC.exe" or $e.target.process.file.name = "CertUtil.exe" or $e.target.process.file.name = "Cmd.Exe" or $e.target.process.file.name = "CMSTP.EXE" or $e.target.process.file.name = "cscript.exe" or $e.target.process.file.name = "curl.exe" or $e.target.process.file.name = "HH.exe" or $e.target.process.file.name = "IEExec.exe" or $e.target.process.file.name = "InstallUtil.exe" or $e.target.process.file.name = "javaw.exe" or $e.target.process.file.name = "Microsoft.Workflow.Compiler.exe" or $e.target.process.file.name = "msdt.exe" or $e.target.process.file.name = "MSHTA.EXE" or $e.target.process.file.name = "msiexec.exe" or $e.target.process.file.name = "Msxsl.exe" or $e.target.process.file.name = "odbcconf.exe" or $e.target.process.file.name = "pcalua.exe" or $e.target.process.file.name = "PowerShell.EXE" or $e.target.process.file.name = "RegAsm.exe" or $e.target.process.file.name = "RegSvcs.exe" or $e.target.process.file.name = "REGSVR32.exe" or $e.target.process.file.name = "RUNDLL32.exe" or $e.target.process.file.name = "schtasks.exe" or $e.target.process.file.name = "ScriptRunner.exe" or $e.target.process.file.name = "wmic.exe" or $e.target.process.file.name = "WorkFolders.exe" or $e.target.process.file.name = "wscript.exe")) or (($e.target.process.file.full_path = /.*\\AppVLP.exe$/ nocase or $e.target.process.file.full_path = /.*\\bash.exe$/ nocase or $e.target.process.file.full_path = /.*\\bitsadmin.exe$/ nocase or $e.target.process.file.full_path = /.*\\certoc.exe$/ nocase or $e.target.process.file.full_path = /.*\\certutil.exe$/ nocase or $e.target.process.file.full_path = /.*\\cmd.exe$/ nocase or $e.target.process.file.full_path = /.*\\cmstp.exe$/ nocase or $e.target.process.file.full_path = /.*\\control.exe$/ nocase or $e.target.process.file.full_path = /.*\\cscript.exe$/ nocase or $e.target.process.file.full_path = /.*\\curl.exe$/ nocase or $e.target.process.file.full_path = /.*\\forfiles.exe$/ nocase or $e.target.process.file.full_path = /.*\\hh.exe$/ nocase or $e.target.process.file.full_path = /.*\\ieexec.exe$/ nocase or $e.target.process.file.full_path = /.*\\installutil.exe$/ nocase or $e.target.process.file.full_path = /.*\\javaw.exe$/ nocase or $e.target.process.file.full_path = /.*\\mftrace.exe$/ nocase or $e.target.process.file.full_path = /.*\\Microsoft.Workflow.Compiler.exe$/ nocase or $e.target.process.file.full_path = /.*\\msbuild.exe$/ nocase or $e.target.process.file.full_path = /.*\\msdt.exe$/ nocase or $e.target.process.file.full_path = /.*\\mshta.exe$/ nocase or $e.target.process.file.full_path = /.*\\msidb.exe$/ nocase or $e.target.process.file.full_path = /.*\\msiexec.exe$/ nocase or $e.target.process.file.full_path = /.*\\msxsl.exe$/ nocase or $e.target.process.file.full_path = /.*\\odbcconf.exe$/ nocase or $e.target.process.file.full_path = /.*\\pcalua.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase or $e.target.process.file.full_path = /.*\\regasm.exe$/ nocase or $e.target.process.file.full_path = /.*\\regsvcs.exe$/ nocase or $e.target.process.file.full_path = /.*\\regsvr32.exe$/ nocase or $e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase or $e.target.process.file.full_path = /.*\\schtasks.exe$/ nocase or $e.target.process.file.full_path = /.*\\scrcons.exe$/ nocase or $e.target.process.file.full_path = /.*\\scriptrunner.exe$/ nocase or $e.target.process.file.full_path = /.*\\sh.exe$/ nocase or $e.target.process.file.full_path = /.*\\svchost.exe$/ nocase or $e.target.process.file.full_path = /.*\\verclsid.exe$/ nocase or $e.target.process.file.full_path = /.*\\wmic.exe$/ nocase or $e.target.process.file.full_path = /.*\\workfolders.exe$/ nocase or $e.target.process.file.full_path = /.*\\wscript.exe$/ nocase))) or (($e.target.process.file.full_path = /.*\\AppData\\.*/ nocase or $e.target.process.file.full_path = /.*\\Users\\Public\\.*/ nocase or $e.target.process.file.full_path = /.*\\ProgramData\\.*/ nocase or $e.target.process.file.full_path = /.*\\Windows\\Tasks\\.*/ nocase or $e.target.process.file.full_path = /.*\\Windows\\Temp\\.*/ nocase or $e.target.process.file.full_path = /.*\\Windows\\System32\\Tasks\\.*/ nocase))) and not((($e.target.process.file.full_path = /.*\\AppData\\Local\\Microsoft\\OneDrive\\.*/ nocase and $e.target.process.file.full_path = /.*\\FileCoAuth.exe$/ nocase and $e.target.process.command_line = /.*-Embedding$/ nocase) or ($e.target.process.file.full_path = /.*\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe$/ nocase and $e.target.process.command_line = /.*-Embedding$/ nocase))))

  condition:
    $e
}
