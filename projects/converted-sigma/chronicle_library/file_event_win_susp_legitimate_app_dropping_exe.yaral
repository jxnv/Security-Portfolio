// Title: Legitimate Application Dropped Executable
// ID: f0540f7e-2db3-4432-b9e0-3965486744bc
// Status: test
// Level: high
// Author: frack113, Florian Roth (Nextron Systems)
// Date: 2022-08-21
// Tags: attack.stealth, attack.t1218
// Description: Detects LOLBINs and applications that should not legitimately drop executable or executable-equivalent files to disk.
// This may indicate malware staging, process injection, or abuse of a trusted binary for payload delivery.
// Converted by: Sigma Universal SIEM/EDR CLI

rule f0540f7e_2db3_4432_b9e0_3965486744bc {
  meta:
    title = "Legitimate Application Dropped Executable"
    description = "Detects LOLBINs and applications that should not legitimately drop executable or executable-equivalent files to disk. This may indicate malware staging, process injection, or abuse of a trusted binary for payload delivery."
    author = "frack113, Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.file.full_path = /.*\\eqnedt32.exe$/ nocase or $e.target.process.file.full_path = /.*\\wordpad.exe$/ nocase or $e.target.process.file.full_path = /.*\\wordview.exe$/ nocase or $e.target.process.file.full_path = /.*\\certutil.exe$/ nocase or $e.target.process.file.full_path = /.*\\certoc.exe$/ nocase or $e.target.process.file.full_path = /.*\\CertReq.exe$/ nocase or $e.target.process.file.full_path = /.*\\Desktopimgdownldr.exe$/ nocase or $e.target.process.file.full_path = /.*\\esentutl.exe$/ nocase or $e.target.process.file.full_path = /.*\\mshta.exe$/ nocase or $e.target.process.file.full_path = /.*\\AcroRd32.exe$/ nocase or $e.target.process.file.full_path = /.*\\RdrCEF.exe$/ nocase or $e.target.process.file.full_path = /.*\\hh.exe$/ nocase or $e.target.process.file.full_path = /.*\\finger.exe$/ nocase) and ($e.target.file.full_path = /.*.com$/ nocase or $e.target.file.full_path = /.*.dll$/ nocase or $e.target.file.full_path = /.*.exe$/ nocase or $e.target.file.full_path = /.*.jar$/ nocase or $e.target.file.full_path = /.*.ocx$/ nocase or $e.target.file.full_path = /.*.pyc$/ nocase))

  condition:
    $e
}
