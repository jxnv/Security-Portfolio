// Tags: attack.defense-impairment, attack.t1685
// Description: Detects requests to disable Microsoft Defender features using PowerShell commands
// Converted by: Sigma Universal SIEM/EDR CLI

rule 1ec65a5f_9473_4f12_97da_622044d6df21 {
  meta:
    title = "Powershell Defender Disable Scan Feature"
    description = "Detects requests to disable Microsoft Defender features using PowerShell commands"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (((($e.target.process.command_line = /.*Add-MpPreference .*/ nocase or $e.target.process.command_line = /.*Set-MpPreference .*/ nocase)) and (($e.target.process.command_line = /.*DisableArchiveScanning .*/ nocase or $e.target.process.command_line = /.*DisableRealtimeMonitoring .*/ nocase or $e.target.process.command_line = /.*DisableIOAVProtection .*/ nocase or $e.target.process.command_line = /.*DisableBehaviorMonitoring .*/ nocase or $e.target.process.command_line = /.*DisableBlockAtFirstSeen .*/ nocase or $e.target.process.command_line = /.*DisableCatchupFullScan .*/ nocase or $e.target.process.command_line = /.*DisableCatchupQuickScan .*/ nocase)) and (($e.target.process.command_line = /.*$true.*/ nocase or $e.target.process.command_line = /.* 1 .*/ nocase))) or ((($e.target.process.command_line = /.*RABpAHMAYQBiAGwAZQBSAGUAYQBsAHQAaQBtAGUATQBvAG4AaQB0AG8AcgBpAG4AZwAgA.*/ nocase or $e.target.process.command_line = /.*QAaQBzAGEAYgBsAGUAUgBlAGEAbAB0AGkAbQBlAE0AbwBuAGkAdABvAHIAaQBuAGcAIA.*/ nocase or $e.target.process.command_line = /.*EAGkAcwBhAGIAbABlAFIAZQBhAGwAdABpAG0AZQBNAG8AbgBpAHQAbwByAGkAbgBnACAA.*/ nocase or $e.target.process.command_line = /.*RABpAHMAYQBiAGwAZQBJAE8AQQBWAFAAcgBvAHQAZQBjAHQAaQBvAG4AIA.*/ nocase or $e.target.process.command_line = /.*QAaQBzAGEAYgBsAGUASQBPAEEAVgBQAHIAbwB0AGUAYwB0AGkAbwBuACAA.*/ nocase or $e.target.process.command_line = /.*EAGkAcwBhAGIAbABlAEkATwBBAFYAUAByAG8AdABlAGMAdABpAG8AbgAgA.*/ nocase or $e.target.process.command_line = /.*RABpAHMAYQBiAGwAZQBCAGUAaABhAHYAaQBvAHIATQBvAG4AaQB0AG8AcgBpAG4AZwAgA.*/ nocase or $e.target.process.command_line = /.*QAaQBzAGEAYgBsAGUAQgBlAGgAYQB2AGkAbwByAE0AbwBuAGkAdABvAHIAaQBuAGcAIA.*/ nocase or $e.target.process.command_line = /.*EAGkAcwBhAGIAbABlAEIAZQBoAGEAdgBpAG8AcgBNAG8AbgBpAHQAbwByAGkAbgBnACAA.*/ nocase or $e.target.process.command_line = /.*RABpAHMAYQBiAGwAZQBCAGwAbwBjAGsAQQB0AEYAaQByAHMAdABTAGUAZQBuACAA.*/ nocase or $e.target.process.command_line = /.*QAaQBzAGEAYgBsAGUAQgBsAG8AYwBr