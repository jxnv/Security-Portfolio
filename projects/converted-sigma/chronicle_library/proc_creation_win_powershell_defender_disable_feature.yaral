ss.command_line = /.*kaXNhYmxlY2F0Y2h1cHF1aWNrc2Nhbi.*/ nocase or $e.target.process.command_line = /.*RGlzYWJsZUNhdGNodXBRdWlja1NjYW4g.*/ nocase or $e.target.process.command_line = /.*Rpc2FibGVDYXRjaHVwUXVpY2tTY2FuI.*/ nocase or $e.target.process.command_line = /.*EaXNhYmxlQ2F0Y2h1cFF1aWNrU2Nhbi.*/ nocase or $e.target.process.command_line = /.*ZGlzYWJsZWlvYXZwcm90ZWN0aW9uI.*/ nocase or $e.target.process.command_line = /.*Rpc2FibGVpb2F2cHJvdGVjdGlvbi.*/ nocase or $e.target.process.command_line = /.*kaXNhYmxlaW9hdnByb3RlY3Rpb24g.*/ nocase or $e.target.process.command_line = /.*RGlzYWJsZUlPQVZQcm90ZWN0aW9uI.*/ nocase or $e.target.process.command_line = /.*Rpc2FibGVJT0FWUHJvdGVjdGlvbi.*/ nocase or $e.target.process.command_line = /.*EaXNhYmxlSU9BVlByb3RlY3Rpb24g.*/ nocase or $e.target.process.command_line = /.*ZGlzYWJsZXJlYWx0aW1lbW9uaXRvcmluZy.*/ nocase or $e.target.process.command_line = /.*Rpc2FibGVyZWFsdGltZW1vbml0b3Jpbmcg.*/ nocase or $e.target.process.command_line = /.*kaXNhYmxlcmVhbHRpbWVtb25pdG9yaW5nI.*/ nocase or $e.target.process.command_line = /.*RGlzYWJsZVJlYWx0aW1lTW9uaXRvcmluZy.*/ nocase or $e.target.process.command_line = /.*Rpc2FibGVSZWFsdGltZU1vbml0b3Jpbmcg.*/ nocase or $e.target.process.command_line = /.*EaXNhYmxlUmVhbHRpbWVNb25pdG9yaW5nI.*/ nocase))))

