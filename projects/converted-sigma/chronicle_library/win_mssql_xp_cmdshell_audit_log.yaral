// Title: MSSQL XPCmdshell Suspicious Execution
// ID: 7f103213-a04e-4d59-8261-213dddf22314
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-12
// Tags: attack.execution
// Description: Detects when the MSSQL "xp_cmdshell" stored procedure is used to execute commands
// Converted by: Sigma Universal SIEM/EDR CLI

rule 7f103213_a04e_4d59_8261_213dddf22314 {
  meta:
    title = "MSSQL XPCmdshell Suspicious Execution"
    description = "Detects when the MSSQL "xp_cmdshell" stored procedure is used to execute commands"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ($e.Provider_Name = /.*MSSQL.*/ nocase and $e.EventID = 33205 and ($e.Data = /.*object_name:xp_cmdshell.*/ nocase and $e.Data = /.*statement:EXEC.*/ nocase))

  condition:
    $e
}
