rule 674202d0_b22a_4af4_ae5f_2eda1f3da1af {
  meta:
    title = "Bypass UAC Using Event Viewer"
    description = "Bypasses User Account Control using Event Viewer and a relevant Windows Registry modification"
    author = "frack113"
    severity = "HIGH"

  events:
    (($e.TargetObject = /.*_Classes\\mscfile\\shell\\open\\command\\(Default)$/ nocase) and not(($e.Details = /^%SystemRoot%\\system32\\mmc.exe \"%1\" %.*/ nocase)))

  condition:
    $e
}
