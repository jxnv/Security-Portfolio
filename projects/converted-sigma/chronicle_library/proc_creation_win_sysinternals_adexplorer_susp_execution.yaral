// Title: Suspicious Active Directory Database Snapshot Via ADExplorer
// ID: ef61af62-bc74-4f58-b49b-626448227652
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-03-14
// Tags: attack.discovery, attack.t1087.002, attack.t1069.002, attack.t1482
// Description: Detects the execution of Sysinternals ADExplorer with the "-snapshot" flag in order to save a local copy of the active directory database to a suspicious directory. This can be used by attackers to extract data for Bloodhound, usernames for password spraying or use the meta data for social engineering. The snapshot doesn't contain password hashes but there have been cases, where administrators put passwords in the comment field.
// Converted by: Sigma Universal SIEM/EDR CLI

rule ef61af62_bc74_4f58_b49b_626448227652 {
  meta:
    title = "Suspicious Active Directory Database Snapshot Via ADExplorer"
    description = "Detects the execution of Sysinternals ADExplorer with the "-snapshot" flag in order to save a local copy of the active directory database to a suspicious directory. This can be used by attackers to extract data for Bloodhound, usernames for password spraying or use the meta data for social engineering. The snapshot doesn't contain password hashes but there have been cases, where administrators put passwords in the comment field."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.command_line = /.*snapshot.*/ nocase) and ((($e.target.process.file.full_path = /.*\\ADExp.exe$/ nocase or $e.target.process.file.full_path = /.*\\ADExplorer.exe$/ nocase or $e.target.process.file.full_path = /.*\\ADExplorer64.exe$/ nocase or $e.target.process.file.full_path = /.*\\ADExplorer64a.exe$/ nocase)) or ($e.target.process.file.name = "AdExp") or ($e.Description = "Active Directory Editor") or ($e.Product = "Sysinternals ADExplorer")) and (($e.target.process.command_line = /.*\\Downloads\\.*/ nocase or $e.target.process.command_line = /.*\\Users\\Public\\.*/ nocase or $e.target.process.command_line = /.*\\AppData\\.*/ nocase or $e.target.process.command_line = /.*\\Windows\\Temp\\.*/ nocase)))

  condition:
    $e
}
