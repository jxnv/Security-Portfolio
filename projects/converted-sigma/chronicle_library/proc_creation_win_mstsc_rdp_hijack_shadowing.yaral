rule 6ba5a05f_b095_4f0a_8654_b825f4f16334 {
  meta:
    title = "Potential MSTSC Shadowing Activity"
    description = "Detects RDP session hijacking by using MSTSC shadowing"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.command_line = /.*noconsentprompt.*/ nocase and $e.target.process.command_line = /.*shadow:.*/ nocase))

  condition:
    $e
}
