// Title: Invoke-Obfuscation Obfuscated IEX Invocation - System
// ID: 51aa9387-1c53-4153-91cc-d73c59ae1ca9
// Status: test
// Level: high
// Author: Daniel Bohannon (@Mandiant/@FireEye), oscd.community
// Date: 2019-11-08
// Tags: attack.stealth, attack.t1027
// Description: Detects all variations of obfuscated powershell IEX invocation code generated by Invoke-Obfuscation framework from the code block linked in the references
// Converted by: Sigma Universal SIEM/EDR CLI

rule 51aa9387_1c53_4153_91cc_d73c59ae1ca9 {
  meta:
    title = "Invoke-Obfuscation Obfuscated IEX Invocation - System"
    description = "Detects all variations of obfuscated powershell IEX invocation code generated by Invoke-Obfuscation framework from the code block linked in the references"
    author = "Daniel Bohannon (@Mandiant/@FireEye), oscd.community"
    severity = "HIGH"

  events:
    (($e.EventID = 7045) and (($e.ImagePath = /\$PSHome\[\s*\d{1,3}\s*\]\s*\+\s*\$PSHome\[/ nocase) or ($e.ImagePath = /\$ShellId\[\s*\d{1,3}\s*\]\s*\+\s*\$ShellId\[/ nocase) or ($e.ImagePath = /\$env:Public\[\s*\d{1,3}\s*\]\s*\+\s*\$env:Public\[/ nocase) or ($e.ImagePath = /\$env:ComSpec\[(\s*\d{1,3}\s*,){2}/ nocase) or ($e.ImagePath = /\\*mdr\*\W\s*\)\.Name/ nocase) or ($e.ImagePath = /\$VerbosePreference\.ToString\(/ nocase) or ($e.ImagePath = /\String\]\s*\$VerbosePreference/ nocase)))

  condition:
    $e
}
