// Title: Invoke-Obfuscation COMPRESS OBFUSCATION - PowerShell Module
// ID: 7034cbbb-cc55-4dc2-8dad-36c0b942e8f1
// Status: test
// Level: medium
// Author: Timur Zinniatullin, oscd.community
// Date: 2020-10-18
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via COMPRESS OBFUSCATION
// Converted by: Sigma Universal SIEM/EDR CLI

rule 7034cbbb_cc55_4dc2_8dad_36c0b942e8f1 {
  meta:
    title = "Invoke-Obfuscation COMPRESS OBFUSCATION - PowerShell Module"
    description = "Detects Obfuscated Powershell via COMPRESS OBFUSCATION"
    author = "Timur Zinniatullin, oscd.community"
    severity = "MEDIUM"

  events:
    (($e.Payload = /.*new-object.*/ nocase and $e.Payload = /.*text.encoding]::ascii.*/ nocase) and ($e.Payload = /.*system.io.compression.deflatestream.*/ nocase or $e.Payload = /.*system.io.streamreader.*/ nocase) and $e.Payload = /.*readtoend$/ nocase)

  condition:
    $e
}
