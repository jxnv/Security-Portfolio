// Title: New Network Trace Capture Started Via Netsh.EXE
// ID: d3c3861d-c504-4c77-ba55-224ba82d0118
// Status: test
// Level: medium
// Author: Kutepov Anton, oscd.community
// Date: 2019-10-24
// Tags: attack.discovery, attack.credential-access, attack.t1040
// Description: Detects the execution of netsh with the "trace" flag in order to start a network capture
// Converted by: Sigma Universal SIEM/EDR CLI

rule d3c3861d_c504_4c77_ba55_224ba82d0118 {
  meta:
    title = "New Network Trace Capture Started Via Netsh.EXE"
    description = "Detects the execution of netsh with the "trace" flag in order to start a network capture"
    author = "Kutepov Anton, oscd.community"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*trace.*/ nocase and $e.target.process.command_line = /.*start.*/ nocase)) and (($e.target.process.file.full_path = /.*\\netsh.exe$/ nocase) or ($e.target.process.file.name = "netsh.exe")))

  condition:
    $e
}
