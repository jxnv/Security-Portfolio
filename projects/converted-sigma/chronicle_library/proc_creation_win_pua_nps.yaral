// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-10-08
// Tags: attack.command-and-control, attack.t1090
// Description: Detects the use of NPS, a port forwarding and intranet penetration proxy server
// Converted by: Sigma Universal SIEM/EDR CLI

rule 68d37776_61db_42f5_bf54_27e87072d17e {
  meta:
    title = "PUA - NPS Tunneling Tool Execution"
    description = "Detects the use of NPS, a port forwarding and intranet penetration proxy server"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.* -server=.*/ nocase and $e.target.process.command_line = /.* -vkey=.*/ nocase and $e.target.process.command_line = /.* -password=.*/ nocase)) or ($e.target.process.command_line = /.* -config=npc.*/ nocase) or (($e.Hashes = /.*MD5=AE8ACF66BFE3A44148964048B826D005.*/ nocase or $e.Hashes = /.*SHA1=CEA49E9B9B67F3A13AD0BE1C2655293EA3C18181.*/ nocase or $e.Hashes = /.*SHA256=5A456283392FFCEEEACA3D3426C306EB470304637520D72FED1CC1FEBBBD6856.*/ nocase)) or ($e.target.process.file.full_path = /.*\\npc.exe$/ nocase))

  condition:
    $e
}
