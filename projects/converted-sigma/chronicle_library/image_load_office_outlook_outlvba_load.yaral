// Title: Microsoft VBA For Outlook Addin Loaded Via Outlook
// ID: 9a0b8719-cd3c-4f0a-90de-765a4cb3f5ed
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-08
// Tags: attack.execution, attack.t1204.002
// Description: Detects outlvba (Microsoft VBA for Outlook Addin) DLL being loaded by the outlook process
// Converted by: Sigma Universal SIEM/EDR CLI

rule 9a0b8719_cd3c_4f0a_90de_765a4cb3f5ed {
  meta:
    title = "Microsoft VBA For Outlook Addin Loaded Via Outlook"
    description = "Detects outlvba (Microsoft VBA for Outlook Addin) DLL being loaded by the outlook process"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ($e.target.process.file.full_path = /.*\\outlook.exe$/ nocase and $e.ImageLoaded = /.*\\outlvba.dll$/ nocase)

  condition:
    $e
}
