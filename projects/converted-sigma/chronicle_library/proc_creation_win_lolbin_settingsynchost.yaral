// Level: high
// Author: Anton Kutepov, oscd.community
// Date: 2020-02-05
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.stealth, attack.t1574.008
// Description: Detects using SettingSyncHost.exe to run hijacked binary
// Converted by: Sigma Universal SIEM/EDR CLI

rule b2ddd389_f676_4ac4_845a_e00781a48e5f {
  meta:
    title = "Using SettingSyncHost.exe as LOLBin"
    description = "Detects using SettingSyncHost.exe to run hijacked binary"
    author = "Anton Kutepov, oscd.community"
    severity = "HIGH"

  events:
    (not((($e.target.process.file.full_path = /^C:\\Windows\\System32\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\SysWOW64\\.*/ nocase))) and (($e.principal.process.command_line = /.*cmd.exe /c.*/ nocase and $e.principal.process.command_line = /.*RoamDiag.cmd.*/ nocase and $e.principal.process.command_line = /.*-outputpath.*/ nocase)))

  condition:
    $e
}
