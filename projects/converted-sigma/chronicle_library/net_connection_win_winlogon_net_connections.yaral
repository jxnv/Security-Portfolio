// Title: Outbound Network Connection To Public IP Via Winlogon
// ID: 7610a4ea-c06d-495f-a2ac-0a696abcfd3b
// Status: test
// Level: medium
// Author: Christopher Peacock @securepeacock, SCYTHE @scythe_io
// Date: 2023-04-28
// Tags: attack.execution, attack.command-and-control, attack.stealth, attack.t1218.011
// Description: Detects a "winlogon.exe" process that initiate network communications with public IP addresses
// Converted by: Sigma Universal SIEM/EDR CLI

rule 7610a4ea_c06d_495f_a2ac_0a696abcfd3b {
  meta:
    title = "Outbound Network Connection To Public IP Via Winlogon"
    description = "Detects a "winlogon.exe" process that initiate network communications with public IP addresses"
    author = "Christopher Peacock @securepeacock, SCYTHE @scythe_io"
    severity = "MEDIUM"

  events:
    (($e.target.process.file.full_path = /.*\\winlogon.exe$/ nocase and $e.Initiated = "true") and not(((net.ip_in_range_cidr($e.target.ip, "127.0.0.0/8") or net.ip_in_range_cidr($e.target.ip, "10.0.0.0/8") or net.ip_in_range_cidr($e.target.ip, "172.16.0.0/12") or net.ip_in_range_cidr($e.target.ip, "192.168.0.0/16") or net.ip_in_range_cidr($e.target.ip, "169.254.0.0/16") or net.ip_in_range_cidr($e.target.ip, "::1/128") or net.ip_in_range_cidr($e.target.ip, "fe80::/10") or net.ip_in_range_cidr($e.target.ip, "fc00::/7")))))

  condition:
    $e
}
