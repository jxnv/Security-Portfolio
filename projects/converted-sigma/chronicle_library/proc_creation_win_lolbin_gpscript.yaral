// Title: Gpscript Execution
// ID: 1e59c230-6670-45bf-83b0-98903780607e
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-05-16
// Tags: attack.stealth, attack.t1218
// Description: Detects the execution of the LOLBIN gpscript, which executes logon or startup scripts configured in Group Policy
// Converted by: Sigma Universal SIEM/EDR CLI

rule 1e59c230_6670_45bf_83b0_98903780607e {
  meta:
    title = "Gpscript Execution"
    description = "Detects the execution of the LOLBIN gpscript, which executes logon or startup scripts configured in Group Policy"
    author = "frack113"
    severity = "MEDIUM"

  events:
    (((($e.target.process.command_line = /.* /logon.*/ nocase or $e.target.process.command_line = /.* /startup.*/ nocase)) and (($e.target.process.file.full_path = /.*\\gpscript.exe$/ nocase) or ($e.target.process.file.name = "GPSCRIPT.EXE"))) and not(($e.principal.process.command_line = "C:\\windows\\system32\\svchost.exe -k netsvcs -p -s gpsvc")))

  condition:
    $e
}
