rule 790317c0_0a36_4a6a_a105_6e576bf99a14 {
  meta:
    title = "COM Object Hijacking Via Modification Of Default System CLSID Default Value"
    description = "Detects potential COM object hijacking via modification of default system CLSID."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    (((($e.TargetObject = /.*\\{1f486a52-3cb1-48fd-8f50-b8dc300d9f9d}\\.*/ nocase or $e.TargetObject = /.*\\{2155fee3-2419-4373-b102-6843707eb41f}\\.*/ nocase or $e.TargetObject = /.*\\{4590f811-1d3a-11d0-891f-00aa004b2e24}\\.*/ nocase or $e.TargetObject = /.*\\{4de225bf-cf59-4cfc-85f7-68b90f185355}\\.*/ nocase or $e.TargetObject = /.*\\{ddc05a5a-351a-4e06-8eaf-54ec1bc2dcea}\\.*/ nocase or $e.TargetObject = /.*\\{F56F6FDD-AA9D-4618-A949-C1B91AF43B1A}\\.*/ nocase or $e.TargetObject = /.*\\{F82B4EF1-93A9-4DDE-8015-F7950A1A6E31}\\.*/ nocase or $e.TargetObject = /.*\\{7849596a-48ea-486e-8937-a2a3009f31a9}\\.*/ nocase or $e.TargetObject = /.*\\{0b91a74b-ad7c-4a9d-b563-29eef9167172}\\.*/ nocase or $e.TargetObject = /.*\\{603D3801-BD81-11d0-A3A5-00C04FD706EC}\\.*/ nocase or $e.TargetObject = /.*\\{30D49246-D217-465F-B00B-AC9DDD652EB7}\\.*/ nocase or $e.TargetObject = /.*\\{A7A63E5C-3877-4840-8727-C1EA9D7A4D50}\\.*/ nocase or $e.TargetObject = /.*\\{2227A280-3AEA-1069-A2DE-08002B30309D}\\.*/ nocase or $e.TargetObject = /.*\\{2DEA658F-54C1-4227-AF9B-260AB5FC3543}\\.*/ nocase or $e.TargetObject = /.*\\{AA509086-5Ca9-4C25-8F95-589D3C07B48A}\\.*/ nocase)) and ($e.TargetObject = /.*\\CLSID\\.*/ nocase and ($e.TargetObject = /.*\\InprocServer32\\(Default)$/ nocase or $e.TargetObject = /.*\\LocalServer32\\(Default)$/ nocase))) and ((($e.Details = /.*:\\Perflogs\\.*/ nocase or $e.Details = /.*\\AppData\\Local\\.*/ nocase or $e.Details = /.*\\Desktop\\.*/ nocase or $e.Details = /.*\\Downloads\\.*/ nocase or $e.Details = /.*\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\.*/ nocase or $e.Details = /.*\\System32\\spool\\drivers\\color\\.*/ nocase or $e.Details = /.*\\Temporary Internet.*/ nocase or $e.Details = /.*\\Users\\Public\\.*/ nocase or $e.Details = /.*\\Windows\\Temp\\.*/ nocase or $e.Details = /.*%appdata%.*/ nocase or $e.Details = /.*%temp%.*/ nocase or $e.Details = /.*%tmp%.*/ nocase)) or ((($e.Details = /.*:\\Users\\.*/ nocase and $e.Details = /.*\\Favorites\\.*/ nocase)) or (($e.Details = /.*:\\Users\\.*/ nocase and $e.Details = /.*\\Favourites\\.*/ nocase)) or (($e.Details = /.*:\\Users\\.*/ nocase and $e.Details = /.*\\Contacts\\.*/ nocase)) or (($e.Details = /.*:\\Users\\.*/ nocase and $e.Details = /.*\\Pictures\\.*/ nocase)))))

  condition:
    $e
}
