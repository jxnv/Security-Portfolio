// Title: File Download via CertOC.EXE
// ID: 70ad0861-d1fe-491c-a45f-fa48148a300d
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-05-16
// Tags: attack.command-and-control, attack.t1105
// Description: Detects when a user downloads a file by using CertOC.exe
// Converted by: Sigma Universal SIEM/EDR CLI

rule 70ad0861_d1fe_491c_a45f_fa48148a300d {
  meta:
    title = "File Download via CertOC.EXE"
    description = "Detects when a user downloads a file by using CertOC.exe"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*-GetCACAPS.*/ nocase and $e.target.process.command_line = /.*http.*/ nocase)) and (($e.target.process.file.full_path = /.*\\certoc.exe$/ nocase) or ($e.target.process.file.name = "CertOC.exe")))

  condition:
    $e
}
