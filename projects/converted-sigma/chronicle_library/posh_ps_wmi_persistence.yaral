// Tags: attack.persistence, attack.privilege-escalation, attack.t1546.003
// Description: Adversaries may establish persistence and elevate privileges by executing malicious content triggered by a Windows Management Instrumentation (WMI) event subscription.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 9e07f6e7_83aa_45c6_998e_0af26efd0a85 {
  meta:
    title = "Powershell WMI Persistence"
    description = "Adversaries may establish persistence and elevate privileges by executing malicious content triggered by a Windows Management Instrumentation (WMI) event subscription."
    author = "frack113"
    severity = "MEDIUM"

  events:
    ((($e.ScriptBlockText = /.*New-CimInstance .*/ nocase and $e.ScriptBlockText = /.*-Namespace root/subscription .*/ nocase and $e.ScriptBlockText = /.*-ClassName __EventFilter .*/ nocase and $e.ScriptBlockText = /.*-Property .*/ nocase)) or (($e.ScriptBlockText = /.*New-CimInstance .*/ nocase and $e.ScriptBlockText = /.*-Namespace root/subscription .*/ nocase and $e.ScriptBlockText = /.*-ClassName CommandLineEventConsumer .*/ nocase and $e.ScriptBlockText = /.*-Property .*/ nocase)))

  condition:
    $e
}
