// Title: Startup Folder File Write
// ID: 2aa0a6b4-a865-495b-ab51-c28249537b75
// Status: test
// Level: medium
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2020-05-02
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: A General detection for files being created in the Windows startup directory. This could be an indicator of persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 2aa0a6b4_a865_495b_ab51_c28249537b75 {
  meta:
    title = "Startup Folder File Write"
    description = "A General detection for files being created in the Windows startup directory. This could be an indicator of persistence."
    author = "Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)"
    severity = "MEDIUM"

  events:
    (($e.target.file.full_path = /.*\\Microsoft\\Windows\\Start Menu\\Programs\\StartUp.*/ nocase) and not(((($e.target.process.file.full_path = "C:\\Windows\\System32\\wuauclt.exe" or $e.target.process.file.full_path = "C:\\Windows\\uus\\ARM64\\wuaucltcore.exe")) or (($e.target.file.full_path = /^C:\\$WINDOWS.~BT\\NewOS\\.*/ nocase or $e.target.file.full_path = /^C:\\$WinREAgent\\Scratch\\Mount\\.*/ nocase)))) and not(($e.target.process.file.full_path = /.*\\ONENOTE.EXE$/ nocase and $e.target.file.full_path = /.*\\Send to OneNote.lnk$/ nocase)))

  condition:
    $e
}
