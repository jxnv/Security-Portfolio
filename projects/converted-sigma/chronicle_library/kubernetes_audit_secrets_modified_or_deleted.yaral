// Title: Kubernetes Secrets Modified or Deleted
// ID: 58d31a75-a4f8-4c40-985b-373d58162ca2
// Status: test
// Level: medium
// Author: kelnage
// Date: 2024-07-11
// Tags: attack.credential-access
// Description: Detects when Kubernetes Secrets are Modified or Deleted.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 58d31a75_a4f8_4c40_985b_373d58162ca2 {
  meta:
    title = "Kubernetes Secrets Modified or Deleted"
    description = "Detects when Kubernetes Secrets are Modified or Deleted."
    author = "kelnage"
    severity = "MEDIUM"

  events:
    ($e.objectRef.resource = "secrets" and ($e.verb = "create" or $e.verb = "delete" or $e.verb = "patch" or $e.verb = "replace" or $e.verb = "update"))

  condition:
    $e
}
