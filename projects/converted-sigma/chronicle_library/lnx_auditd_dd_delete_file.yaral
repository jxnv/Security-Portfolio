// Title: Overwriting the File with Dev Zero or Null
// ID: 37222991-11e9-4b6d-8bdf-60fbe48f753e
// Status: stable
// Level: low
// Author: Jakob Weinzettl, oscd.community
// Date: 2019-10-23
// Tags: attack.impact, attack.t1485
// Description: Detects overwriting (effectively wiping/deleting) of a file.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 37222991_11e9_4b6d_8bdf_60fbe48f753e {
  meta:
    title = "Overwriting the File with Dev Zero or Null"
    description = "Detects overwriting (effectively wiping/deleting) of a file."
    author = "Jakob Weinzettl, oscd.community"
    severity = "LOW"

  events:
    ($e.type = "EXECVE" and $e.a0 = /.*dd.*/ nocase and ($e.a1 = /.*if=/dev/null.*/ nocase or $e.a1 = /.*if=/dev/zero.*/ nocase))

  condition:
    $e
}
