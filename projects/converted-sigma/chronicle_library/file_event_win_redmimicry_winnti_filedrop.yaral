rule 130c9e58_28ac_4f83_8574_0a4cc913b97e {
  meta:
    title = "Potential Winnti Dropper Activity"
    description = "Detects files dropped by Winnti as described in RedMimicry Winnti playbook"
    author = "Alexander Rausch"
    severity = "HIGH"

  events:
    (($e.target.file.full_path = /.*\\gthread-3.6.dll$/ nocase or $e.target.file.full_path = /.*\\sigcmm-2.4.dll$/ nocase or $e.target.file.full_path = /.*\\Windows\\Temp\\tmp.bat$/ nocase))

  condition:
    $e
}
