// Title: PsExec Tool Execution From Suspicious Locations - PipeName
// ID: 41504465-5e3a-4a5b-a5b4-2a0baadd4463
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-04
// Tags: attack.execution, attack.t1569.002, attack.s0029
// Description: Detects PsExec default pipe creation where the image executed is located in a suspicious location. Which could indicate that the tool is being used in an attack
// Converted by: Sigma Universal SIEM/EDR CLI

rule 41504465_5e3a_4a5b_a5b4_2a0baadd4463 {
  meta:
    title = "PsExec Tool Execution From Suspicious Locations - PipeName"
    description = "Detects PsExec default pipe creation where the image executed is located in a suspicious location. Which could indicate that the tool is being used in an attack"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ($e.PipeName = "\\PSEXESVC" and ($e.target.process.file.full_path = /.*:\\Users\\Public\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\Temp\\.*/ nocase or $e.target.process.file.full_path = /.*\\AppData\\Local\\Temp\\.*/ nocase or $e.target.process.file.full_path = /.*\\Desktop\\.*/ nocase or $e.target.process.file.full_path = /.*\\Downloads\\.*/ nocase))

  condition:
    $e
}
