// Title: Potential Password Spraying Attempt Using Dsacls.EXE
// ID: bac9fb54-2da7-44e9-988f-11e9a5edbc0c
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-20
// Tags: attack.stealth, attack.t1218
// Description: Detects possible password spraying attempts using Dsacls
// Converted by: Sigma Universal SIEM/EDR CLI

rule bac9fb54_2da7_44e9_988f_11e9a5edbc0c {
  meta:
    title = "Potential Password Spraying Attempt Using Dsacls.EXE"
    description = "Detects possible password spraying attempts using Dsacls"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*/user:.*/ nocase and $e.target.process.command_line = /.*/passwd:.*/ nocase)) and (($e.target.process.file.full_path = /.*\\dsacls.exe$/ nocase) or ($e.target.process.file.name = "DSACLS.EXE")))

  condition:
    $e
}
