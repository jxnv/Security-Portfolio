rule 8ffc5407_52e3_478f_9596_0a7371eafe13 {
  meta:
    title = "Disable PUA Protection on Windows Defender"
    description = "Detects disabling Windows Defender PUA protection"
    author = "Austin Songer @austinsonger"
    severity = "HIGH"

  events:
    ($e.TargetObject = /.*\\Policies\\Microsoft\\Windows Defender\\PUAProtection.*/ nocase and $e.Details = "DWORD (0x00000000)")

  condition:
    $e
}
