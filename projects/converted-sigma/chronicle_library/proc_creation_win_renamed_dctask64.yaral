// Title: Renamed ZOHO Dctask64 Execution
// ID: 340a090b-c4e9-412e-bb36-b4b16fe96f9b
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2020-01-28
// Tags: attack.privilege-escalation, attack.stealth, attack.t1036, attack.t1055.001, attack.t1202, attack.t1218
// Description: Detects a renamed "dctask64.exe" execution, a signed binary by ZOHO Corporation part of ManageEngine Endpoint Central.
// This binary can be abused for DLL injection, arbitrary command and process execution.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 340a090b_c4e9_412e_bb36_b4b16fe96f9b {
  meta:
    title = "Renamed ZOHO Dctask64 Execution"
    description = "Detects a renamed "dctask64.exe" execution, a signed binary by ZOHO Corporation part of ManageEngine Endpoint Central. This binary can be abused for DLL injection, arbitrary command and process execution."
    author = "Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.Hashes = /.*IMPHASH=6834B1B94E49701D77CCB3C0895E1AFD.*/ nocase or $e.Hashes = /.*IMPHASH=1BB6F93B129F398C7C4A76BB97450BBA.*/ nocase or $e.Hashes = /.*IMPHASH=FAA2AC19875FADE461C8D89DCF2710A3.*/ nocase or $e.Hashes = /.*IMPHASH=F1039CED4B91572AB7847D26032E6BBF.*/ nocase)) and not(($e.target.process.file.full_path = /.*\\dctask64.exe$/ nocase)))

  condition:
    $e
}
