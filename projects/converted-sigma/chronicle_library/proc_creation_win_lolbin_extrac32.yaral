rule aa8e035d_7be4_48d3_a944_102aec04400d {
  meta:
    title = "Suspicious Extrac32 Execution"
    description = "Download or Copy file with Extrac32"
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.target.process.command_line = /.*.cab.*/ nocase) and (($e.target.process.command_line = /.*extrac32.exe.*/ nocase) or ($e.target.process.file.full_path = /.*\\extrac32.exe$/ nocase) or ($e.target.process.file.name = "extrac32.exe")) and (($e.target.process.command_line = /.*/C.*/ nocase or $e.target.process.command_line = /.*/Y.*/ nocase or $e.target.process.command_line = /.* \\\\\\\\.*/ nocase)))

  condition:
    $e
}
