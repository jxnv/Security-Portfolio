// Title: CobaltStrike Named Pipe Patterns
// ID: 85adeb13-4fc9-4e68-8a4a-c7cb2c336eb7
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Christian Burkard (Nextron Systems)
// Date: 2021-07-30
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055, stp.1k
// Description: Detects the creation of a named pipe with a pattern found in CobaltStrike malleable C2 profiles
// Converted by: Sigma Universal SIEM/EDR CLI

rule 85adeb13_4fc9_4e68_8a4a_c7cb2c336eb7 {
  meta:
    title = "CobaltStrike Named Pipe Patterns"
    description = "Detects the creation of a named pipe with a pattern found in CobaltStrike malleable C2 profiles"
    author = "Florian Roth (Nextron Systems), Christian Burkard (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.PipeName = /^\\Winsock2\\CatalogChangeListener-.*/ nocase and $e.PipeName = /.*-0,$/ nocase) or ((($e.PipeName = /^\\DserNamePipe.*/ nocase or $e.PipeName = /^\\f4c3.*/ nocase or $e.PipeName = /^\\f53f.*/ nocase or $e.PipeName = /^\\fullduplex_.*/ nocase or $e.PipeName = /^\\mojo.5688.8052.183894939787088877.*/ nocase or $e.PipeName = /^\\mojo.5688.8052.35780273329370473.*/ nocase or $e.PipeName = /^\\MsFteWds.*/ nocase or $e.PipeName = /^\\msrpc_.*/ nocase or $e.PipeName = /^\\mypipe-f.*/ nocase or $e.PipeName = /^\\mypipe-h.*/ nocase or $e.PipeName = /^\\ntsvcs.*/ nocase or $e.PipeName = /^\\PGMessagePipe.*/ nocase or $e.PipeName = /^\\rpc_.*/ nocase or $e.PipeName = /^\\scerpc.*/ nocase or $e.PipeName = /^\\SearchTextHarvester.*/ nocase or $e.PipeName = /^\\spoolss.*/ nocase or $e.PipeName = /^\\win_svc.*/ nocase or $e.PipeName = /^\\win\\msrpc_.*/ nocase or $e.PipeName = /^\\windows.update.manager.*/ nocase or $e.PipeName = /^\\wkssvc.*/ nocase)) or (($e.PipeName = "\\demoagent_11" or $e.PipeName = "\\demoagent_22")))) and not((($e.PipeName = "\\wkssvc" or $e.PipeName = "\\spoolss" or $e.PipeName = "\\scerpc" or $e.PipeName = "\\ntsvcs" or $e.PipeName = "\\SearchTextHarvester" or $e.PipeName = "\\PGMessagePipe" or $e.PipeName = "\\MsFteWds"))) and not((($e.target.process.file.full_path = /.*:\\Program Files\\Websense\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Program Files (x86)\\Websense\\.*/ nocase) and ($e.PipeName = /^\\DserNamePipeR.*/ nocase or $e.PipeName = /^\\DserNamePipeW.*/ nocase))))

  condition:
    $e
}
