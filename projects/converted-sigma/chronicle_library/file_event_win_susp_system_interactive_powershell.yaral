// Title: Suspicious Interactive PowerShell as SYSTEM
// ID: 5b40a734-99b6-4b98-a1d0-1cea51a08ab2
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-12-07
// Tags: attack.execution, attack.t1059.001
// Description: Detects the creation of files that indicator an interactive use of PowerShell in the SYSTEM user context
// Converted by: Sigma Universal SIEM/EDR CLI

rule 5b40a734_99b6_4b98_a1d0_1cea51a08ab2 {
  meta:
    title = "Suspicious Interactive PowerShell as SYSTEM"
    description = "Detects the creation of files that indicator an interactive use of PowerShell in the SYSTEM user context"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.file.full_path = "C:\\Windows\\System32\\config\\systemprofile\\AppData\\Roaming\\Microsoft\\Windows\\PowerShell\\PSReadLine\\ConsoleHost_history.txt" or $e.target.file.full_path = "C:\\Windows\\System32\\config\\systemprofile\\AppData\\Local\\Microsoft\\Windows\\PowerShell\\StartupProfileData-Interactive"))

  condition:
    $e
}
