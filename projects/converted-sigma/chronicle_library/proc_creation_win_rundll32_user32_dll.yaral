// Title: Suspicious Workstation Locking via Rundll32
// ID: 3b5b0213-0460-4e3f-8937-3abf98ff7dcc
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-06-04
// Tags: attack.stealth
// Description: Detects a suspicious call to the user32.dll function that locks the user workstation
// Converted by: Sigma Universal SIEM/EDR CLI

rule 3b5b0213_0460_4e3f_8937_3abf98ff7dcc {
  meta:
    title = "Suspicious Workstation Locking via Rundll32"
    description = "Detects a suspicious call to the user32.dll function that locks the user workstation"
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.target.process.command_line = /.*user32.dll,.*/ nocase) and (($e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase) or ($e.target.process.file.name = "RUNDLL32.EXE")) and ($e.principal.process.file.full_path = /.*\\cmd.exe$/ nocase) and ($e.target.process.command_line = /.*LockWorkStation.*/ nocase))

  condition:
    $e
}
