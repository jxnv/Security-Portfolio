// Title: Potentially Suspicious Execution Of Regasm/Regsvcs From Uncommon Location
// ID: cc368ed0-2411-45dc-a222-510ace303cb2
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-25
// Tags: attack.stealth, attack.t1218.009
// Description: Detects potentially suspicious execution of the Regasm/Regsvcs utilities from a potentially suspicious location
// Converted by: Sigma Universal SIEM/EDR CLI

rule cc368ed0_2411_45dc_a222_510ace303cb2 {
  meta:
    title = "Potentially Suspicious Execution Of Regasm/Regsvcs From Uncommon Location"
    description = "Detects potentially suspicious execution of the Regasm/Regsvcs utilities from a potentially suspicious location"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*\\AppData\\Local\\Temp\\.*/ nocase or $e.target.process.command_line = /.*\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\.*/ nocase or $e.target.process.command_line = /.*\\PerfLogs\\.*/ nocase or $e.target.process.command_line = /.*\\Users\\Public\\.*/ nocase or $e.target.process.command_line = /.*\\Windows\\Temp\\.*/ nocase)) and ((($e.target.process.file.full_path = /.*\\Regsvcs.exe$/ nocase or $e.target.process.file.full_path = /.*\\Regasm.exe$/ nocase)) or (($e.target.process.file.name = "RegSvcs.exe" or $e.target.process.file.name = "RegAsm.exe"))))

  condition:
    $e
}
