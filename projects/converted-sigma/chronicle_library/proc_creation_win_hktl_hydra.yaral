// Tags: attack.credential-access, attack.t1110, attack.t1110.001
// Description: Detects command line parameters used by Hydra password guessing hack tool
// Converted by: Sigma Universal SIEM/EDR CLI

rule aaafa146_074c_11eb_adc1_0242ac120002 {
  meta:
    title = "HackTool - Hydra Password Bruteforce Execution"
    description = "Detects command line parameters used by Hydra password guessing hack tool"
    author = "Vasiliy Burov"
    severity = "HIGH"

  events:
    (($e.target.process.command_line = /.*-u .*/ nocase and $e.target.process.command_line = /.*-p .*/ nocase) and ($e.target.process.command_line = /.*^USER^.*/ nocase or $e.target.process.command_line = /.*^PASS^.*/ nocase))

  condition:
    $e
}
