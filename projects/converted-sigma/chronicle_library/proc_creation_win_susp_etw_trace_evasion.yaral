// Title: ETW Trace Evasion Activity
// ID: a238b5d0-ce2d-4414-a676-7a531b3d13d6
// Status: test
// Level: high
// Author: @neu5ron, Florian Roth (Nextron Systems), Jonhnathan Ribeiro, oscd.community
// Date: 2019-03-22
// Tags: attack.stealth, attack.defense-impairment, attack.t1070, attack.t1685, car.2016-04-002
// Description: Detects command line activity that tries to clear or disable any ETW trace log which could be a sign of logging evasion.
// Converted by: Sigma Universal SIEM/EDR CLI

rule a238b5d0_ce2d_4414_a676_7a531b3d13d6 {
  meta:
    title = "ETW Trace Evasion Activity"
    description = "Detects command line activity that tries to clear or disable any ETW trace log which could be a sign of logging evasion."
    author = "@neu5ron, Florian Roth (Nextron Systems), Jonhnathan Ribeiro, oscd.community"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*cl.*/ nocase and $e.target.process.command_line = /.*/Trace.*/ nocase)) or (($e.target.process.command_line = /.*clear-log.*/ nocase and $e.target.process.command_line = /.*/Trace.*/ nocase)) or (($e.target.process.command_line = /.*sl.*/ nocase and $e.target.process.command_line = /.*/e:false.*/ nocase)) or (($e.target.process.command_line = /.*set-log.*/ nocase and $e.target.process.command_line = /.*/e:false.*/ nocase)) or (($e.target.process.command_line = /.*logman.*/ nocase and $e.target.process.command_line = /.*update.*/ nocase and $e.target.process.command_line = /.*trace.*/ nocase and $e.target.process.command_line = /.*--p.*/ nocase and $e.target.process.command_line = /.*-ets.*/ nocase)) or ($e.target.process.command_line = /.*Remove-EtwTraceProvider.*/ nocase) or (($e.target.process.command_line = /.*Set-EtwTraceProvider.*/ nocase and $e.target.process.command_line = /.*0x11.*/ nocase)))

  condition:
    $e
}
