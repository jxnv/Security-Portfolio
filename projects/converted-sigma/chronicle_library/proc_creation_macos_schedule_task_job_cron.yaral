// Title: Scheduled Cron Task/Job - MacOs
// ID: 7c3b43d8-d794-47d2-800a-d277715aa460
// Status: test
// Level: medium
// Author: Alejandro Ortuno, oscd.community
// Date: 2020-10-06
// Tags: attack.execution, attack.persistence, attack.privilege-escalation, attack.t1053.003
// Description: Detects abuse of the cron utility to perform task scheduling for initial or recurring execution of malicious code. Detection will focus on crontab jobs uploaded from the tmp folder.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 7c3b43d8_d794_47d2_800a_d277715aa460 {
  meta:
    title = "Scheduled Cron Task/Job - MacOs"
    description = "Detects abuse of the cron utility to perform task scheduling for initial or recurring execution of malicious code. Detection will focus on crontab jobs uploaded from the tmp folder."
    author = "Alejandro Ortuno, oscd.community"
    severity = "MEDIUM"

  events:
    ($e.target.process.file.full_path = /.*/crontab$/ nocase and $e.target.process.command_line = /.*/tmp/.*/ nocase)

  condition:
    $e
}
