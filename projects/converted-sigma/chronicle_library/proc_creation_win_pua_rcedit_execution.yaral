// Title: PUA - Potential PE Metadata Tamper Using Rcedit
// ID: 0c92f2e6-f08f-4b73-9216-ecb0ca634689
// Status: test
// Level: medium
// Author: Micah Babinski
// Date: 2022-12-11
// Tags: attack.stealth, attack.t1036.003, attack.t1036, attack.t1027.005, attack.t1027
// Description: Detects the use of rcedit to potentially alter executable PE metadata properties, which could conceal efforts to rename system utilities for defense evasion.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 0c92f2e6_f08f_4b73_9216_ecb0ca634689 {
  meta:
    title = "PUA - Potential PE Metadata Tamper Using Rcedit"
    description = "Detects the use of rcedit to potentially alter executable PE metadata properties, which could conceal efforts to rename system utilities for defense evasion."
    author = "Micah Babinski"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*OriginalFileName.*/ nocase or $e.target.process.command_line = /.*CompanyName.*/ nocase or $e.target.process.command_line = /.*FileDescription.*/ nocase or $e.target.process.command_line = /.*ProductName.*/ nocase or $e.target.process.command_line = /.*ProductVersion.*/ nocase or $e.target.process.command_line = /.*LegalCopyright.*/ nocase)) and ($e.target.process.command_line = /.*--set-.*/ nocase) and ((($e.target.process.file.full_path = /.*\\rcedit-x64.exe$/ nocase or $e.target.process.file.full_path = /.*\\rcedit-x86.exe$/ nocase)) or ($e.Description = "Edit resources of exe") or ($e.Product = "rcedit")))

  condition:
    $e
}
