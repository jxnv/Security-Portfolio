// Title: Volume Shadow Copy Mount
// ID: f512acbf-e662-4903-843e-97ce4652b740
// Status: test
// Level: low
// Author: Roberto Rodriguez @Cyb3rWard0g, Open Threat Research (OTR)
// Date: 2020-10-20
// Tags: attack.credential-access, attack.t1003.002
// Description: Detects volume shadow copy mount via Windows event log
// Converted by: Sigma Universal SIEM/EDR CLI

rule f512acbf_e662_4903_843e_97ce4652b740 {
  meta:
    title = "Volume Shadow Copy Mount"
    description = "Detects volume shadow copy mount via Windows event log"
    author = "Roberto Rodriguez @Cyb3rWard0g, Open Threat Research (OTR)"
    severity = "LOW"

  events:
    ($e.Provider_Name = "Microsoft-Windows-Ntfs" and $e.EventID = 98 and $e.DeviceName = /.*HarddiskVolumeShadowCopy.*/ nocase)

  condition:
    $e
}
