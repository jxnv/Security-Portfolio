// Title: Registry Modification to Hidden File Extension
// ID: 5df86130-4e95-4a54-90f7-26541b40aec2
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-01-22
// Tags: attack.persistence, attack.t1137
// Description: Hides the file extension through modification of the registry
// Converted by: Sigma Universal SIEM/EDR CLI

rule 5df86130_4e95_4a54_90f7_26541b40aec2 {
  meta:
    title = "Registry Modification to Hidden File Extension"
    description = "Hides the file extension through modification of the registry"
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.TargetObject = /.*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced\\Hidden$/ nocase and $e.Details = "DWORD (0x00000002)") or ($e.TargetObject = /.*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced\\HideFileExt$/ nocase and $e.Details = "DWORD (0x00000001)"))

  condition:
    $e
}
