rule c3f265c7_ff03_4056_8ab2_d486227b4599 {
  meta:
    title = "Restore Public AWS RDS Instance"
    description = "Detects the recovery of a new public database instance from a snapshot. It may be a part of data exfiltration."
    author = "faloker"
    severity = "HIGH"

  events:
    ($e.eventSource = "rds.amazonaws.com" and $e.responseElements.publiclyAccessible = "true" and $e.eventName = "RestoreDBInstanceFromDBSnapshot")

  condition:
    $e
}
