// Title: WSL Child Process Anomaly
// ID: 2267fe65-0681-42ad-9a6d-46553d3f3480
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-23
// Tags: attack.execution, attack.stealth, attack.t1218, attack.t1202
// Description: Detects uncommon or suspicious child processes spawning from a WSL process. This could indicate an attempt to evade parent/child relationship detections or persistence attempts via cron using WSL
// Converted by: Sigma Universal SIEM/EDR CLI

rule 2267fe65_0681_42ad_9a6d_46553d3f3480 {
  meta:
    title = "WSL Child Process Anomaly"
    description = "Detects uncommon or suspicious child processes spawning from a WSL process. This could indicate an attempt to evade parent/child relationship detections or persistence attempts via cron using WSL"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.principal.process.file.full_path = /.*\\wsl.exe$/ nocase or $e.principal.process.file.full_path = /.*\\wslhost.exe$/ nocase)) and ((($e.target.process.file.full_path = /.*\\calc.exe$/ nocase or $e.target.process.file.full_path = /.*\\cmd.exe$/ nocase or $e.target.process.file.full_path = /.*\\cscript.exe$/ nocase or $e.target.process.file.full_path = /.*\\mshta.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase or $e.target.process.file.full_path = /.*\\regsvr32.exe$/ nocase or $e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase or $e.target.process.file.full_path = /.*\\wscript.exe$/ nocase)) or (($e.target.process.file.full_path = /.*\\AppData\\Local\\Temp\\.*/ nocase or $e.target.process.file.full_path = /.*C:\\Users\\Public\\.*/ nocase or $e.target.process.file.full_path = /.*C:\\Windows\\Temp\\.*/ nocase or $e.target.process.file.full_path = /.*C:\\Temp\\.*/ nocase or $e.target.process.file.full_path = /.*\\Downloads\\.*/ nocase or $e.target.process.file.full_path = /.*\\Desktop\\.*/ nocase))))

  condition:
    $e
}
