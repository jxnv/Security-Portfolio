// Title: NetNTLM Downgrade Attack - Registry
// ID: d67572a0-e2ec-45d6-b8db-c100d14b8ef2
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), wagga, Nasreddine Bencherchali (Splunk STRT)
// Date: 2018-03-20
// Tags: attack.persistence, attack.defense-impairment, attack.t1685, attack.t1112
// Description: Detects NetNTLM downgrade attack
// Converted by: Sigma Universal SIEM/EDR CLI

rule d67572a0_e2ec_45d6_b8db_c100d14b8ef2 {
  meta:
    title = "NetNTLM Downgrade Attack - Registry"
    description = "Detects NetNTLM downgrade attack"
    author = "Florian Roth (Nextron Systems), wagga, Nasreddine Bencherchali (Splunk STRT)"
    severity = "HIGH"

  events:
    ((($e.TargetObject = /.*SYSTEM\\.*/ nocase and $e.TargetObject = /.*ControlSet.*/ nocase and $e.TargetObject = /.*\\Control\\Lsa.*/ nocase)) and (($e.TargetObject = /.*\\lmcompatibilitylevel$/ nocase and ($e.Details = "DWORD (0x00000000)" or $e.Details = "DWORD (0x00000001)" or $e.Details = "DWORD (0x00000002)")) or ($e.TargetObject = /.*\\NtlmMinClientSec$/ nocase and ($e.Details = "DWORD (0x00000000)" or $e.Details = "DWORD (0x00000010)" or $e.Details = "DWORD (0x00000020)" or $e.Details = "DWORD (0x00000030)")) or ($e.TargetObject = /.*\\RestrictSendingNTLMTraffic$/ nocase)))

  condition:
    $e
}
