rule 4d136857_6a1a_432a_82fc_5dd497ee5e7c {
  meta:
    title = "Sign-ins by Unknown Devices"
    description = "Monitor and alert for Sign-ins by unknown devices from non-Trusted locations."
    author = "Michael Epping, '@mepples21'"
    severity = "LOW"

  events:
    ($e.AuthenticationRequirement = "singleFactorAuthentication" and $e.ResultType = 0 and $e.NetworkLocationDetails = "[]" and $e.DeviceDetail.deviceId = "")

  condition:
    $e
}
