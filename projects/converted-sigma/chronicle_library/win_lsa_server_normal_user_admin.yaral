// Status: test
// Level: medium
// Author: frack113
// Date: 2023-01-13
// Tags: attack.credential-access, attack.privilege-escalation
// Description: Detect standard users login that are part of high privileged groups such as the Administrator group
// Converted by: Sigma Universal SIEM/EDR CLI

rule 7ac407cc_0f48_4328_aede_de1d2e6fef41 {
  meta:
    title = "Standard User In High Privileged Group"
    description = "Detect standard users login that are part of high privileged groups such as the Administrator group"
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.EventID = 300 and $e.TargetUserSid = /^S-1-5-21-.*/ nocase and ($e.SidList = /.*S-1-5-32-544.*/ nocase or $e.SidList = /.*-500}.*/ nocase or $e.SidList = /.*-518}.*/ nocase or $e.SidList = /.*-519}.*/ nocase)) and not((($e.TargetUserSid = /.*-500$/ nocase or $e.TargetUserSid = /.*-518$/ nocase or $e.TargetUserSid = /.*-519$/ nocase))))

  condition:
    $e
}
