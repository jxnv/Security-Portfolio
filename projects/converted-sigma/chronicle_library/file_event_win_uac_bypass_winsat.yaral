// Title: UAC Bypass Abusing Winsat Path Parsing - File
// ID: 155dbf56-e0a4-4dd0-8905-8a98705045e8
// Status: test
// Level: high
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-08-30
// Tags: attack.privilege-escalation, attack.t1548.002
// Description: Detects the pattern of UAC Bypass using a path parsing issue in winsat.exe (UACMe 52)
// Converted by: Sigma Universal SIEM/EDR CLI

rule 155dbf56_e0a4_4dd0_8905_8a98705045e8 {
  meta:
    title = "UAC Bypass Abusing Winsat Path Parsing - File"
    description = "Detects the pattern of UAC Bypass using a path parsing issue in winsat.exe (UACMe 52)"
    author = "Christian Burkard (Nextron Systems)"
    severity = "HIGH"

  events:
    ($e.target.file.full_path = /^C:\\Users\\.*/ nocase and ($e.target.file.full_path = /.*\\AppData\\Local\\Temp\\system32\\winsat.exe$/ nocase or $e.target.file.full_path = /.*\\AppData\\Local\\Temp\\system32\\winmm.dll$/ nocase))

  condition:
    $e
}
