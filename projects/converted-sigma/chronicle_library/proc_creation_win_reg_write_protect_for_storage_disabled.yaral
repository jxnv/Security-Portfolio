// Title: Write Protect For Storage Disabled
// ID: 75f7a0e2-7154-4c4d-9eae-5cdb4e0a5c13
// Status: test
// Level: medium
// Author: Sreeman
// Date: 2021-06-11
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects applications trying to modify the registry in order to disable any write-protect property for storage devices.
// This could be a precursor to a ransomware attack and has been an observed technique used by cypherpunk group.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 75f7a0e2_7154_4c4d_9eae_5cdb4e0a5c13 {
  meta:
    title = "Write Protect For Storage Disabled"
    description = "Detects applications trying to modify the registry in order to disable any write-protect property for storage devices. This could be a precursor to a ransomware attack and has been an observed technique used by cypherpunk group."
    author = "Sreeman"
    severity = "MEDIUM"

  events:
    (($e.target.process.command_line = /.*\\System\\CurrentControlSet\\Control.*/ nocase and $e.target.process.command_line = /.*Write Protection.*/ nocase and $e.target.process.command_line = /.*0.*/ nocase and $e.target.process.command_line = /.*storage.*/ nocase))

  condition:
    $e
}
