// Title: Password Provided In Command Line Of Net.EXE
// ID: d4498716-1d52-438f-8084-4a603157d131
// Status: test
// Level: medium
// Author: Tim Shelton (HAWK.IO)
// Date: 2021-12-09
// Tags: attack.initial-access, attack.persistence, attack.privilege-escalation, attack.lateral-movement, attack.stealth, attack.t1021.002, attack.t1078
// Description: Detects a when net.exe is called with a password in the command line
// Converted by: Sigma Universal SIEM/EDR CLI

rule d4498716_1d52_438f_8084_4a603157d131 {
  meta:
    title = "Password Provided In Command Line Of Net.EXE"
    description = "Detects a when net.exe is called with a password in the command line"
    author = "Tim Shelton (HAWK.IO)"
    severity = "MEDIUM"

  events:
    (((($e.target.process.command_line = /.* use .*/ nocase and $e.target.process.command_line = /.*:*\\\\.*/ nocase and $e.target.process.command_line = /.*/USER:* *.*/ nocase)) and ((($e.target.process.file.full_path = /.*\\net.exe$/ nocase or $e.target.process.file.full_path = /.*\\net1.exe$/ nocase)) or (($e.target.process.file.name = "net.exe" or $e.target.process.file.name = "net1.exe")))) and not(($e.target.process.command_line = /.* $/ nocase)))

  condition:
    $e
}
