// Title: Rundll32 Execution Without CommandLine Parameters
// ID: 1775e15e-b61b-4d14-a1a3-80981298085a
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-05-27
// Tags: attack.stealth, attack.t1202
// Description: Detects suspicious start of rundll32.exe without any parameters as found in CobaltStrike beacon activity
// Converted by: Sigma Universal SIEM/EDR CLI

rule 1775e15e_b61b_4d14_a1a3_80981298085a {
  meta:
    title = "Rundll32 Execution Without CommandLine Parameters"
    description = "Detects suspicious start of rundll32.exe without any parameters as found in CobaltStrike beacon activity"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*\\rundll32.exe$/ nocase or $e.target.process.command_line = /.*\\rundll32.exe\"$/ nocase or $e.target.process.command_line = /.*\\rundll32$/ nocase)) and not((($e.principal.process.file.full_path = /.*\\AppData\\Local\\.*/ nocase or $e.principal.process.file.full_path = /.*\\Microsoft\\Edge\\.*/ nocase))))

  condition:
    $e
}
