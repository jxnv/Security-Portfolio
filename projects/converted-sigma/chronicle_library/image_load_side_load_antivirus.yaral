ed = /.*\\tmdbglog.dll$/ nocase) and not((($e.ImageLoaded = /^C:\\program Files\\Trend Micro\\Titanium\\.*/ nocase or $e.ImageLoaded = /^C:\\program Files (x86)\\Trend Micro\\Titanium\\.*/ nocase)))) or (($e.ImageLoaded = /.*\\DLPPREM32.dll$/ nocase) and not((($e.ImageLoaded = /^C:\\program Files\\ESET.*/ nocase or $e.ImageLoaded = /^C:\\program Files (x86)\\ESET.*/ nocase)))))

