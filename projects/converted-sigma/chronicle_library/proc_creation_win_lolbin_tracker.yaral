// Title: Potential DLL Injection Or Execution Using Tracker.exe
// ID: 148431ce-4b70-403d-8525-fcc2993f29ea
// Status: test
// Level: medium
// Author: Avneet Singh @v3t0_, oscd.community
// Date: 2020-10-18
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055.001
// Description: Detects potential DLL injection and execution using "Tracker.exe"
// Converted by: Sigma Universal SIEM/EDR CLI

rule 148431ce_4b70_403d_8525_fcc2993f29ea {
  meta:
    title = "Potential DLL Injection Or Execution Using Tracker.exe"
    description = "Detects potential DLL injection and execution using "Tracker.exe""
    author = "Avneet Singh @v3t0_, oscd.community"
    severity = "MEDIUM"

  events:
    (((($e.target.process.command_line = /.* /d .*/ nocase or $e.target.process.command_line = /.* /c .*/ nocase)) and (($e.target.process.file.full_path = /.*\\tracker.exe$/ nocase) or ($e.Description = "Tracker"))) and not((($e.target.process.command_line = /.* /ERRORREPORT:PROMPT .*/ nocase) or (($e.principal.process.file.full_path = /.*\\Msbuild\\Current\\Bin\\MSBuild.exe$/ nocase or $e.principal.process.file.full_path = /.*\\Msbuild\\Current\\Bin\\amd64\\MSBuild.exe$/ nocase)))))

  condition:
    $e
}
