// Title: Suspicious Invoke-WebRequest Execution With DirectIP
// ID: 1edff897-9146-48d2-9066-52e8d8f80a2f
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-21
// Tags: attack.command-and-control, attack.t1105
// Description: Detects calls to PowerShell with Invoke-WebRequest cmdlet using direct IP access
// Converted by: Sigma Universal SIEM/EDR CLI

rule 1edff897_9146_48d2_9066_52e8d8f80a2f {
  meta:
    title = "Suspicious Invoke-WebRequest Execution With DirectIP"
    description = "Detects calls to PowerShell with Invoke-WebRequest cmdlet using direct IP access"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*curl .*/ nocase or $e.target.process.command_line = /.*Invoke-RestMethod.*/ nocase or $e.target.process.command_line = /.*Invoke-WebRequest.*/ nocase or $e.target.process.command_line = /.* irm .*/ nocase or $e.target.process.command_line = /.*iwr .*/ nocase or $e.target.process.command_line = /.*wget .*/ nocase)) and ((($e.target.process.file.full_path = /.*\\powershell_ise.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase)) or (($e.target.process.file.name = "powershell_ise.EXE" or $e.target.process.file.name = "PowerShell.EXE" or $e.target.process.file.name = "pwsh.dll"))) and (($e.target.process.command_line = /.*://1.*/ nocase or $e.target.process.command_line = /.*://2.*/ nocase or $e.target.process.command_line = /.*://3.*/ nocase or $e.target.process.command_line = /.*://4.*/ nocase or $e.target.process.command_line = /.*://5.*/ nocase or $e.target.process.command_line = /.*://6.*/ nocase or $e.target.process.command_line = /.*://7.*/ nocase or $e.target.process.command_line = /.*://8.*/ nocase or $e.target.process.command_line = /.*://9.*/ nocase)))

  condition:
    $e
}
