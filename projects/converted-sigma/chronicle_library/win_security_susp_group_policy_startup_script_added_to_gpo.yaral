// Title: Startup/Logon Script Added to Group Policy Object
// ID: 123e4e6d-b123-48f8-b261-7214938acaf0
// Status: test
// Level: medium
// Author: Elastic, Josh Nickels, Marius Rothenbücher
// Date: 2024-09-06
// Tags: attack.persistence, attack.privilege-escalation, attack.defense-impairment, attack.t1484.001, attack.t1547
// Description: Detects the modification of Group Policy Objects (GPO) to add a startup/logon script to users or computer objects.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 123e4e6d_b123_48f8_b261_7214938acaf0 {
  meta:
    title = "Startup/Logon Script Added to Group Policy Object"
    description = "Detects the modification of Group Policy Objects (GPO) to add a startup/logon script to users or computer objects."
    author = "Elastic, Josh Nickels, Marius Rothenbücher"
    severity = "MEDIUM"

  events:
    ((($e.EventID = 5136 or $e.EventID = 5145)) and (((($e.AttributeLDAPDisplayName = "gPCMachineExtensionNames" or $e.AttributeLDAPDisplayName = "gPCUserExtensionNames") and $e.AttributeValue = /.*42B5FAAE-6536-11D2-AE5A-0000F87571E3.*/ nocase) and (($e.AttributeValue = /.*40B6664F-4972-11D1-A7CA-0000F87571E3.*/ nocase or $e.AttributeValue = /.*40B66650-4972-11D1-A7CA-0000F87571E3.*/ nocase))) or ($e.ShareName = /.*\\SYSVOL$/ nocase and ($e.RelativeTargetName = /.*\\scripts.ini$/ nocase or $e.RelativeTargetName = /.*\\psscripts.ini$/ nocase) and $e.AccessList = /.*%%4417.*/ nocase)))

  condition:
    $e
}
