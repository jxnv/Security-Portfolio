// Title: Loading of Kernel Module via Insmod
// ID: 106d7cbd-80ff-4985-b682-a7043e5acb72
// Status: test
// Level: high
// Author: Pawel Mazur
// Date: 2021-11-02
// Tags: attack.persistence, attack.privilege-escalation, attack.t1547.006
// Description: Detects loading of kernel modules with insmod command.
// Loadable Kernel Modules (LKMs) are pieces of code that can be loaded and unloaded into the kernel upon demand.
// Adversaries may use LKMs to obtain persistence within the system or elevate the privileges.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 106d7cbd_80ff_4985_b682_a7043e5acb72 {
  meta:
    title = "Loading of Kernel Module via Insmod"
    description = "Detects loading of kernel modules with insmod command. Loadable Kernel Modules (LKMs) are pieces of code that can be loaded and unloaded into the kernel upon demand. Adversaries may use LKMs to obtain persistence within the system or elevate the privileges."
    author = "Pawel Mazur"
    severity = "HIGH"

  events:
    ($e.type = "SYSCALL" and $e.comm = "insmod" and $e.exe = "/usr/bin/kmod")

  condition:
    $e
}
