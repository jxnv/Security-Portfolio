// Title: Persistence Via Sudoers Files
// ID: ddb26b76-4447-4807-871f-1b035b2bfa5d
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-05
// Tags: attack.privilege-escalation, attack.persistence, attack.t1548.003
// Description: Detects the creation or modification of the main "/etc/sudoers" file or files within the "/etc/sudoers.d/" directory on Linux systems.
// Adversaries may alter sudoers configuration to execute commands with elevated privileges without supplying a password.
// Converted by: Sigma Universal SIEM/EDR CLI

rule ddb26b76_4447_4807_871f_1b035b2bfa5d {
  meta:
    title = "Persistence Via Sudoers Files"
    description = "Detects the creation or modification of the main "/etc/sudoers" file or files within the "/etc/sudoers.d/" directory on Linux systems. Adversaries may alter sudoers configuration to execute commands with elevated privileges without supplying a password."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.file.full_path = "/etc/sudoers") or ($e.target.file.full_path = /^/etc/sudoers.d/.*/ nocase)) and not(($e.target.process.file.full_path = /.*/usr/bin/dpkg$/ nocase and $e.target.file.full_path = "/etc/sudoers.d/README.dpkg-new")))

  condition:
    $e
}
