// Title: PowerShell SAM Copy
// ID: 1af57a4b-460a-4738-9034-db68b880c665
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-07-29
// Tags: attack.credential-access, attack.t1003.002
// Description: Detects suspicious PowerShell scripts accessing SAM hives
// Converted by: Sigma Universal SIEM/EDR CLI

rule 1af57a4b_460a_4738_9034_db68b880c665 {
  meta:
    title = "PowerShell SAM Copy"
    description = "Detects suspicious PowerShell scripts accessing SAM hives"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*\\HarddiskVolumeShadowCopy.*/ nocase and $e.target.process.command_line = /.*System32\\config\\sam.*/ nocase)) and (($e.target.process.command_line = /.*Copy-Item.*/ nocase or $e.target.process.command_line = /.*cp $_..*/ nocase or $e.target.process.command_line = /.*cpi $_..*/ nocase or $e.target.process.command_line = /.*copy $_..*/ nocase or $e.target.process.command_line = /.*.File]::Copy(.*/ nocase)))

  condition:
    $e
}
