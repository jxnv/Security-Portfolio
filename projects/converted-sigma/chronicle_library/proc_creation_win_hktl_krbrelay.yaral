// Title: HackTool - KrbRelay Execution
// ID: e96253b8-6b3b-4f90-9e59-3b24b99cf9b4
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-04-27
// Tags: attack.credential-access, attack.t1558.003
// Description: Detects the use of KrbRelay, a Kerberos relaying tool
// Converted by: Sigma Universal SIEM/EDR CLI

rule e96253b8_6b3b_4f90_9e59_3b24b99cf9b4 {
  meta:
    title = "HackTool - KrbRelay Execution"
    description = "Detects the use of KrbRelay, a Kerberos relaying tool"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.* -spn .*/ nocase and $e.target.process.command_line = /.* -clsid .*/ nocase and $e.target.process.command_line = /.* -rbcd .*/ nocase)) or (($e.target.process.command_line = /.*shadowcred.*/ nocase and $e.target.process.command_line = /.*clsid.*/ nocase and $e.target.process.command_line = /.*spn.*/ nocase)) or (($e.target.process.command_line = /.*spn .*/ nocase and $e.target.process.command_line = /.*session .*/ nocase and $e.target.process.command_line = /.*clsid .*/ nocase)) or (($e.target.process.file.full_path = /.*\\KrbRelay.exe$/ nocase) or ($e.target.process.file.name = "KrbRelay.exe")))

  condition:
    $e
}
