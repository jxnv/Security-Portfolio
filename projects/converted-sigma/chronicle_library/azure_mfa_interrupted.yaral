// Title: Multifactor Authentication Interrupted
// ID: 5496ff55-42ec-4369-81cb-00f417029e25
// Status: test
// Level: medium
// Author: AlertIQ
// Date: 2021-10-10
// Tags: attack.privilege-escalation, attack.persistence, attack.initial-access, attack.credential-access, attack.stealth, attack.t1078.004, attack.t1110, attack.t1621
// Description: Identifies user login with multifactor authentication failures, which might be an indication an attacker has the password for the account but can't pass the MFA challenge.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 5496ff55_42ec_4369_81cb_00f417029e25 {
  meta:
    title = "Multifactor Authentication Interrupted"
    description = "Identifies user login with multifactor authentication failures, which might be an indication an attacker has the password for the account but can't pass the MFA challenge."
    author = "AlertIQ"
    severity = "MEDIUM"

  events:
    (($e.ResultType = 500121 and $e.ResultDescription = /.*Authentication failed during strong authentication request.*/ nocase) or ($e.ResultType = 50074 and $e.ResultDescription = /.*Strong Auth required.*/ nocase))

  condition:
    $e
}
