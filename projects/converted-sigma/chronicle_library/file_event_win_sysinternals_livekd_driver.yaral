// Title: LiveKD Driver Creation
// ID: 16fe46bb-4f64-46aa-817d-ff7bec4a2352
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-16
// Tags: attack.privilege-escalation, attack.stealth
// Description: Detects the creation of the LiveKD driver, which is used for live kernel debugging
// Converted by: Sigma Universal SIEM/EDR CLI

rule 16fe46bb_4f64_46aa_817d_ff7bec4a2352 {
  meta:
    title = "LiveKD Driver Creation"
    description = "Detects the creation of the LiveKD driver, which is used for live kernel debugging"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ($e.target.file.full_path = "C:\\Windows\\System32\\drivers\\LiveKdD.SYS" and ($e.target.process.file.full_path = /.*\\livekd.exe$/ nocase or $e.target.process.file.full_path = /.*\\livek64.exe$/ nocase))

  condition:
    $e
}
