// Title: DSInternals Suspicious PowerShell Cmdlets
// ID: 43d91656-a9b2-4541-b7e2-6a9bd3a13f4e
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Nounou Mbeiri
// Date: 2024-06-26
// Tags: attack.execution, attack.t1059.001
// Description: Detects execution and usage of the DSInternals PowerShell module. Which can be used to perform what might be considered as suspicious activity such as dumping DPAPI backup keys or manipulating NTDS.DIT files.
// The DSInternals PowerShell Module exposes several internal features of Active Directory and Azure Active Directory. These include FIDO2 and NGC key auditing, offline ntds.dit file manipulation, password auditing, DC recovery from IFM backups and password hash calculation.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 43d91656_a9b2_4541_b7e2_6a9bd3a13f4e {
  meta:
    title = "DSInternals Suspicious PowerShell Cmdlets"
    description = "Detects execution and usage of the DSInternals PowerShell module. Which can be used to perform what might be considered as suspicious activity such as dumping DPAPI backup keys or manipulating NTDS.DIT files. The DSInternals PowerShell Module exposes several internal features of Active Directory and Azure Active Directory. These include FIDO2 and NGC key auditing, offline ntds.dit file manipulation, password auditing, DC recovery from IFM backups and password hash calculation."
    author = "Nasreddine Bencherchali (Nextron Systems), Nounou Mbeiri"
    severity = "HIGH"

  events:
    (($e.target.process.command_line = /.*Add-ADDBSidHistory.*/ nocase or $e.target.process.command_line = /.*Add-ADNgcKey.*/ nocase or $e.target.process.command_line = /.*Add-ADReplNgcKey.*/ nocase or $e.target.process.command_line = /.*ConvertFrom-ADManagedPasswordBlob.*/ nocase or $e.target.process.command_line = /.*ConvertFrom-GPPrefPassword.*/ nocase or $e.target.process.command_line = /.*ConvertFrom-ManagedPasswordBlob.*/ nocase or $e.target.process.command_line = /.*ConvertFrom-UnattendXmlPassword.*/ nocase or $e.target.process.command_line = /.*ConvertFrom-UnicodePassword.*/ nocase or $e.target.process.command_line = /.*ConvertTo-AADHash.*/ nocase or $e.target.process.command_line = /.*ConvertTo-GPPrefPassword.*/ nocase or $e.target.process.command_line = /.*ConvertTo-KerberosKey.*/ nocase or $e.target.process.command_line = /.*ConvertTo-LMHash.*/ nocase or $e.target.process.command_line = /.*ConvertTo-MsoPasswordHash.*/ nocase or $e.target.process.command_line = /.*ConvertTo-NTHash.*/ nocase or $e.target.process.command_line = /.*ConvertTo-OrgIdHash.*/ nocase or $e.target.process.command_line = /.*ConvertTo-UnicodePassword.*/ nocase or $e.target.process.command_line = /.*Disable-ADDBAccount.*/ nocase or $e.target.process.command_line = /.*Enable-ADDBAccount.*/ nocase or $e.target.process.command_line = /.*Get-ADDBAccount.*/ nocase or $e.target.process.command_line = /.*Get-ADDBBackupKey.*/ nocase or $e.target.process.command_line = /.*Get-ADDBDomainController.*/ nocase or $e.target.process.command_line = /.*Get-ADDBGroupManagedServiceAccount.*/ nocase or $e.target.process.command_line = /.*Get-ADDBKdsRootKey.*/ nocase or $e.target.process.command_line = /.*Get-ADDBSchemaAttribute.*/ nocase or $e.target.process.command_line = /.*Get-ADDBServiceAccount.*/ nocase or $e.target.process.command_line = /.*Get-ADDefaultPasswordPolicy.*/ nocase or $e.target.process.command_line = /.*Get-ADKeyCredential.*/ nocase or $e.target.process.command_line = /.*Get-ADPasswordPolicy.*/ nocase or $e.target.process.command_line = /.*Get-ADReplAccount.*/ nocase or $e.target.process.command_line = /.*Get-ADReplBackupKey.*/ nocase or $e.target.process.command_line = /.*Get-ADReplicationAccount.*/ nocase or $e.target.process.command_line = /.*Get-ADSIAccount.*/ nocase or $e.target.process.command_line = /.*Get-AzureADUserEx.*/ nocase or $e.target.process.command_line = /.*Get-BootKey.*/ nocase or $e.target.process.command_line = /.*Get-KeyCredential.*/ nocase or $e.target.process.command_line = /.*Get-LsaBackupKey.*/ nocase or $e.target.process.command_line = /.*Get-LsaPolicy.*/ nocase or $e.target.process.command_line = /.*Get-SamPasswordPolicy.*/ nocase or $e.target.process.command_line = /.*Get-SysKey.*/ nocase or $e.target.process.command_line = /.*Get-SystemKey.*/ nocase or $e.target.process.command_line = /.*New-ADDBRestoreFromMediaScript.*/ nocase or $e.target.process.command_line = /.*New-ADKeyCredential.*/ nocase or $e.target.process.command_line = /.*New-ADNgcKey.*/ nocase or $e.target.process.command_line = /.*New-NTHashSet.*/ nocase or $e.target.process.command_line = /.*Remove-ADDBObject.*/ nocase or $e.target.process.command_line = /.*Save-DPAPIBlob.*/ nocase or $e.target.process.command_line = /.*Set-ADAccountPasswordHash.*/ nocase or $e.target.process.command_line = /.*Set-ADDBAccountPassword.*/ nocase or $e.target.process.command_line = /.*Set-ADDBBootKey.*/ nocase or $e.target.process.command_line = /.*Set-ADDBDomainController.*/ nocase or $e.target.process.command_line = /.*Set-ADDBPrimaryGroup.*/ nocase or $e.target.process.command_line = /.*Set-ADDBSysKey.*/ nocase or $e.target.process.command_line = /.*Set-AzureADUserEx.*/ nocase or $e.target.process.command_line = /.*Set-LsaPolicy.*/ nocase or $e.target.process.command_line = /.*Set-SamAccountPasswordHash.*/ nocase or $e.target.process.command_line = /.*Set-WinUserPasswordHash.*/ nocase or $e.target.process.command_line = /.*Test-ADDBPasswordQuality.*/ nocase or $e.target.process.command_line = /.*Test-ADPasswordQuality.*/ nocase or $e.target.process.command_line = /.*Test-ADReplPasswordQuality.*/ nocase or $e.target.process.command_line = /.*Test-PasswordQuality.*/ nocase or $e.target.process.command_line = /.*Unlock-ADDBAccount.*/ nocase or $e.target.process.command_line = /.*Write-ADNgcKey.*/ nocase or $e.target.process.command_line = /.*Write-ADReplNgcKey.*/ nocase))

  condition:
    $e
}
