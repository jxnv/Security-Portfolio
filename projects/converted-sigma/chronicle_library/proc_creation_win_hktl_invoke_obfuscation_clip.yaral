// Title: Invoke-Obfuscation CLIP+ Launcher
// ID: b222df08-0e07-11eb-adc1-0242ac120002
// Status: test
// Level: high
// Author: Jonathan Cheong, oscd.community
// Date: 2020-10-13
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated use of Clip.exe to execute PowerShell
// Converted by: Sigma Universal SIEM/EDR CLI

rule b222df08_0e07_11eb_adc1_0242ac120002 {
  meta:
    title = "Invoke-Obfuscation CLIP+ Launcher"
    description = "Detects Obfuscated use of Clip.exe to execute PowerShell"
    author = "Jonathan Cheong, oscd.community"
    severity = "HIGH"

  events:
    (($e.target.process.command_line = /.*cmd.*/ nocase and $e.target.process.command_line = /.*&&.*/ nocase and $e.target.process.command_line = /.*clipboard]::.*/ nocase and $e.target.process.command_line = /.*-f.*/ nocase) and ($e.target.process.command_line = /.*/c.*/ nocase or $e.target.process.command_line = /.*/r.*/ nocase))

  condition:
    $e
}
