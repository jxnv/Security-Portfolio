// Title: Syslog Clearing or Removal Via System Utilities
// ID: 3fcc9b35-39e4-44c0-a2ad-9e82b6902b31
// Status: test
// Level: high
// Author: Max Altgelt (Nextron Systems), Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research), MSTIC
// Date: 2021-10-15
// Tags: attack.defense-impairment, attack.t1685.006
// Description: Detects specific commands commonly used to remove or empty the syslog. Which is a technique often used by attacker as a method to hide their tracks
// Converted by: Sigma Universal SIEM/EDR CLI

rule 3fcc9b35_39e4_44c0_a2ad_9e82b6902b31 {
  meta:
    title = "Syslog Clearing or Removal Via System Utilities"
    description = "Detects specific commands commonly used to remove or empty the syslog. Which is a technique often used by attacker as a method to hide their tracks"
    author = "Max Altgelt (Nextron Systems), Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research), MSTIC"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*/var/log/syslog.*/ nocase) and (($e.target.process.file.full_path = /.*/cp$/ nocase and $e.target.process.command_line = /.*/dev/null.*/ nocase) or ($e.target.process.file.full_path = /.*/ln$/ nocase and ($e.target.process.command_line = /.*/dev/null .*/ nocase and $e.target.process.command_line = /.*/var/log/syslog.*/ nocase) and ($e.target.process.command_line = /.*-sf .*/ nocase or $e.target.process.command_line = /.*-sfn .*/ nocase or $e.target.process.command_line = /.*-sfT .*/ nocase)) or ($e.target.process.file.full_path = /.*/mv$/ nocase) or ($e.target.process.file.full_path = /.*/rm$/ nocase and ($e.target.process.command_line = /.* -r .*/ nocase or $e.target.process.command_line = /.* -f .*/ nocase or $e.target.process.command_line = /.* -rf .*/ nocase or $e.target.process.command_line = /.*/var/log/syslog.*/ nocase)) or ($e.target.process.file.full_path = /.*/shred$/ nocase and $e.target.process.command_line = /.*-u .*/ nocase) or ($e.target.process.file.full_path = /.*/truncate$/ nocase and ($e.target.process.command_line = /.*0 .*/ nocase and $e.target.process.command_line = /.*/var/log/syslog.*/ nocase) and ($e.target.process.command_line = /.*-s .*/ nocase or $e.target.process.command_line = /.*-c .*/ nocase or $e.target.process.command_line = /.*--size.*/ nocase)) or ($e.target.process.file.full_path = /.*/unlink$/ nocase))) or ((($e.target.process.command_line = /.*journalctl --vacuum.*/ nocase or $e.target.process.command_line = /.*journalctl --rotate.*/ nocase)) or (($e.target.process.command_line = /.* > /var/log/syslog.*/ nocase or $e.target.process.command_line = /.* >/var/log/syslog.*/ nocase or $e.target.process.command_line = /.* >| /var/log/syslog.*/ nocase or $e.target.process.command_line = /.*: > /var/log/syslog.*/ nocase or $e.target.process.command_line = /.*:> /var/log/syslog.*/ nocase or $e.target.process.command_line = /.*:>/var/log/syslog.*/ nocase or $e.target.process.command_line = /.*>|/var/log/syslog.*/ nocase))))

  condition:
    $e
}
