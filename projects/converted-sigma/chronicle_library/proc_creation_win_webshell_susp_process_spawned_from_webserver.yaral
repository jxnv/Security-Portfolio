// Title: Suspicious Process By Web Server Process
// ID: 8202070f-edeb-4d31-a010-a26c72ac5600
// Status: test
// Level: high
// Author: Thomas Patzke, Florian Roth (Nextron Systems), Zach Stanford @svch0st, Tim Shelton, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-01-16
// Tags: attack.persistence, attack.initial-access, attack.t1505.003, attack.t1190
// Description: Detects potentially suspicious processes being spawned by a web server process which could be the result of a successfully placed web shell or exploitation
// Converted by: Sigma Universal SIEM/EDR CLI

rule 8202070f_edeb_4d31_a010_a26c72ac5600 {
  meta:
    title = "Suspicious Process By Web Server Process"
    description = "Detects potentially suspicious processes being spawned by a web server process which could be the result of a successfully placed web shell or exploitation"
    author = "Thomas Patzke, Florian Roth (Nextron Systems), Zach Stanford @svch0st, Tim Shelton, Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    (((($e.principal.process.file.full_path = /.*\\java.exe$/ nocase or $e.principal.process.file.full_path = /.*\\javaw.exe$/ nocase) and ($e.principal.process.file.full_path = /.*-tomcat-.*/ nocase or $e.principal.process.file.full_path = /.*\\tomcat.*/ nocase)) or (($e.principal.process.file.full_path = /.*\\java.exe$/ nocase or $e.principal.process.file.full_path = /.*\\javaw.exe$/ nocase) and ($e.principal.process.command_line = /.*CATALINA_HOME.*/ nocase or $e.principal.process.command_line = /.*catalina.home.*/ nocase or $e.principal.process.command_line = /.*catalina.jar.*/ nocase)) or (($e.principal.process.file.full_path = /.*\\caddy.exe$/ nocase or $e.principal.process.file.full_path = /.*\\httpd.exe$/ nocase or $e.principal.process.file.full_path = /.*\\nginx.exe$/ nocase or $e.principal.process.file.full_path = /.*\\php-cgi.exe$/ nocase or $e.principal.process.file.full_path = /.*\\php.exe$/ nocase or $e.principal.process.file.full_path = /.*\\tomcat.exe$/ nocase or $e.principal.process.file.full_path = /.*\\UMWorkerProcess.exe$/ nocase or $e.principal.process.file.full_path = /.*\\w3wp.exe$/ nocase or $e.principal.process.file.full_path = /.*\\ws_TomcatService.exe$/ nocase))) and (($e.target.process.file.full_path = /.*\\arp.exe$/ nocase or $e.target.process.file.full_path = /.*\\at.exe$/ nocase or $e.target.process.file.full_path = /.*\\bash.exe$/ nocase or $e.target.process.file.full_path = /.*\\bitsadmin.exe$/ nocase or $e.target.process.file.full_path = /.*\\certutil.exe$/ nocase or $e.target.process.file.full_path = /.*\\cmd.exe$/ nocase or $e.target.process.file.full_path = /.*\\cscript.exe$/ nocase or $e.target.process.file.full_path = /.*\\dsget.exe$/ nocase or $e.target.process.file.full_path = /.*\\hostname.exe$/ nocase or $e.target.process.file.full_path = /.*\\nbtstat.exe$/ nocase or $e.target.process.file.full_path = /.*\\net.exe$/ nocase or $e.target.process.file.full_path = /.*\\net1.exe$/ nocase or $e.target.process.file.full_path = /.*\\netdom.exe$/ nocase or $e.target.process.file.full_path = /.*\\netsh.exe$/ nocase or $e.target.process.file.full_path = /.*\\nltest.exe$/ nocase or $e.target.process.file.full_path = /.*\\ntdsutil.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell_ise.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase or $e.target.process.file.full_path = /.*\\qprocess.exe$/ nocase or $e.target.process.file.full_path = /.*\\query.exe$/ nocase or $e.target.process.file.full_path = /.*\\qwinsta.exe$/ nocase or $e.target.process.file.full_path = /.*\\reg.exe$/ nocase or $e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase or $e.target.process.file.full_path = /.*\\sc.exe$/ nocase or $e.target.process.file.full_path = /.*\\sh.exe$/ nocase or $e.target.process.file.full_path = /.*\\wmic.exe$/ nocase or $e.target.process.file.full_path = /.*\\wscript.exe$/ nocase or $e.target.process.file.full_path = /.*\\wusa.exe$/ nocase)) and not((($e.principal.process.file.full_path = /.*\\java.exe$/ nocase and $e.target.process.command_line = /.*Windows\\system32\\cmd.exe /c C:\\ManageEngine\\ADManager \"Plus\\ES\\bin\\elasticsearch.bat -Enode.name=RMP-NODE1 -pelasticsearch-pid.txt$/ nocase) or ($e.principal.process.file.full_path = /.*\\java.exe$/ nocase and ($e.target.process.command_line = /.*sc query.*/ nocase and $e.target.process.command_line = /.*ADManager Plus.*/ nocase)))))

  condition:
    $e
}
