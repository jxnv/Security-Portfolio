rule f956c7c1_0f60_4bc5_b7d7_b39ab3c08908 {
  meta:
    title = "PktMon.EXE Execution"
    description = "Detects execution of PktMon, a tool that captures network packets."
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.target.process.file.full_path = /.*\\pktmon.exe$/ nocase) or ($e.target.process.file.name = "PktMon.exe"))

  condition:
    $e
}
