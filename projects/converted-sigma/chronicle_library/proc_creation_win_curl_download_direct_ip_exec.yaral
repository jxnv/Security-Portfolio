// Title: File Download From IP URL Via Curl.EXE
// ID: 9cc85849-3b02-4cb5-b371-3a1ff54f2218
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-10-18
// Tags: attack.execution
// Description: Detects file downloads directly from IP address URL using curl.exe
// Converted by: Sigma Universal SIEM/EDR CLI

rule 9cc85849_3b02_4cb5_b371_3a1ff54f2218 {
  meta:
    title = "File Download From IP URL Via Curl.EXE"
    description = "Detects file downloads directly from IP address URL using curl.exe"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (((($e.target.process.command_line = /.* -O.*/ nocase or $e.target.process.command_line = /.*--remote-name.*/ nocase or $e.target.process.command_line = /.*--output.*/ nocase)) and ($e.target.process.command_line = /.*http.*/ nocase) and (($e.target.process.file.full_path = /.*\\curl.exe$/ nocase) or ($e.target.process.file.name = "curl.exe")) and ($e.target.process.command_line = /://[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}/ nocase)) and not((($e.target.process.command_line = /.*.bat$/ nocase or $e.target.process.command_line = /.*.bat\"$/ nocase or $e.target.process.command_line = /.*.dat$/ nocase or $e.target.process.command_line = /.*.dat\"$/ nocase or $e.target.process.command_line = /.*.dll$/ nocase or $e.target.process.command_line = /.*.dll\"$/ nocase or $e.target.process.command_line = /.*.exe$/ nocase or $e.target.process.command_line = /.*.exe\"$/ nocase or $e.target.process.command_line = /.*.gif$/ nocase or $e.target.process.command_line = /.*.gif\"$/ nocase or $e.target.process.command_line = /.*.hta$/ nocase or $e.target.process.command_line = /.*.hta\"$/ nocase or $e.target.process.command_line = /.*.jpeg$/ nocase or $e.target.process.command_line = /.*.jpeg\"$/ nocase or $e.target.process.command_line = /.*.log$/ nocase or $e.target.process.command_line = /.*.log\"$/ nocase or $e.target.process.command_line = /.*.msi$/ nocase or $e.target.process.command_line = /.*.msi\"$/ nocase or $e.target.process.command_line = /.*.png$/ nocase or $e.target.process.command_line = /.*.png\"$/ nocase or $e.target.process.command_line = /.*.ps1$/ nocase or $e.target.process.command_line = /.*.ps1\"$/ nocase or $e.target.process.command_line = /.*.psm1$/ nocase or $e.target.process.command_line = /.*.psm1\"$/ nocase or $e.target.process.command_line = /.*.vbe$/ nocase or $e.target.process.command_line = /.*.vbe\"$/ nocase or $e.target.process.command_line = /.*.vbs$/ nocase or $e.target.process.command_line = /.*.vbs\"$/ nocase or $e.target.process.command_line = /.*.bat'$/ nocase or $e.target.process.command_line = /.*.dat'$/ nocase or $e.target.process.command_line = /.*.dll'$/ nocase or $e.target.process.command_line = /.*.exe'$/ nocase or $e.target.process.command_line = /.*.gif'$/ nocase or $e.target.process.command_line = /.*.hta'$/ nocase or $e.target.process.command_line = /.*.jpeg'$/ nocase or $e.target.process.command_line = /.*.log'$/ nocase or $e.target.process.command_line = /.*.msi'$/ nocase or $e.target.process.command_line = /.*.png'$/ nocase or $e.target.process.command_line = /.*.ps1'$/ nocase or $e.target.process.command_line = /.*.psm1'$/ nocase or $e.target.process.command_line = /.*.vbe'$/ nocase or $e.target.process.command_line = /.*.vbs'$/ nocase))))

  condition:
    $e
}
