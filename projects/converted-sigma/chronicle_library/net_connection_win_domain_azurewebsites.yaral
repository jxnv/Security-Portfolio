// Title: Network Connection Initiated To AzureWebsites.NET By Non-Browser Process
// ID: 5c80b618-0dbb-46e6-acbb-03d90bcb6d83
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.command-and-control, attack.t1102, attack.t1102.001
// Description: Detects an initiated network connection by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 5c80b618_0dbb_46e6_acbb_03d90bcb6d83 {
  meta:
    title = "Network Connection Initiated To AzureWebsites.NET By Non-Browser Process"
    description = "Detects an initiated network connection by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.Initiated = "true" and $e.DestinationHostname = /.*azurewebsites.net$/ nocase) and not(((($e.target.process.file.full_path = /^C:\\Program Files (x86)\\Avant Browser\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\Avant Browser\\.*/ nocase) and $e.target.process.file.full_path = /.*\\avant.exe$/ nocase) or ($e.target.process.file.full_path = /^C:\\Program Files\\BraveSoftware\\.*/ nocase and $e.target.process.file.full_path = /.*\\brave.exe$/ nocase) or (($e.target.process.file.full_path = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or $e.target.process.file.full_path = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or ($e.target.process.file.full_path = /^C:\\Users\\.*/ nocase and $e.target.process.file.full_path = /.*\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe$/ nocase) or (($e.target.process.file.full_path = /.*C:\\Program Files\\Windows Defender Advanced Threat Protection\\.*/ nocase or $e.target.process.file.full_path = /.*C:\\Program Files\\Windows Defender\\.*/ nocase or $e.target.process.file.full_path = /.*C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\.*/ nocase) and ($e.target.process.file.full_path = /.*\\MsMpEng.exe$/ nocase or $e.target.process.file.full_path = /.*\\MsSense.exe$/ nocase)) or ($e.target.process.file.full_path = /.*\\AppData\\Local\\Discord\\.*/ nocase and $e.target.process.file.full_path = /.*\\Discord.exe$/ nocase) or (($e.target.process.file.full_path = /^C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\.*/ nocase) or ($e.target.process.file.full_path = /.*\\WindowsApps\\MicrosoftEdge.exe$/ nocase) or (($e.target.process.file.full_path = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or $e.target.process.file.full_path = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or (($e.target.process.file.full_path = /^C:\\Program Files (x86)\\Microsoft\\EdgeCore\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\Microsoft\\EdgeCore\\.*/ nocase) and ($e.target.process.file.full_path = /.*\\msedge.exe$/ nocase or $e.target.process.file.full_path = /.*\\msedgewebview2.exe$/ nocase)) or ($e.target.process.file.full_path = "") or (($e.target.process.file.full_path = /^C:\\Program Files\\Falkon\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files (x86)\\Falkon\\.*/ nocase) and $e.target.process.file.full_path = /.*\\falkon.exe$/ nocase) or (($e.target.process.file.full_path = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or $e.target.process.file.full_path = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or ($e.target.process.file.full_path = /^C:\\Users\\.*/ nocase and $e.target.process.file.full_path = /.*\\AppData\\Local\\Mozilla Firefox\\firefox.exe$/ nocase) or ($e.target.process.file.full_path = /.*\\AppData\\Local\\Flock\\.*/ nocase and $e.target.process.file.full_path = /.*\\Flock.exe$/ nocase) or (($e.target.process.file.full_path = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or $e.target.process.file.full_path = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or ($e.target.process.file.full_path = /.*\\AppData\\Local\\Maxthon\\.*/ nocase and $e.target.process.file.full_path = /.*\\maxthon.exe$/ nocase) or (not ($e.target.process.file.full_path = /.*/)) or ($e.target.process.file.full_path = /.*\\AppData\\Local\\Programs\\Opera\\.*/ nocase and $e.target.process.file.full_path = /.*\\opera.exe$/ nocase) or ($e.target.process.file.full_path = /.*\\AppData\\Local\\Phoebe\\.*/ nocase and $e.target.process.file.full_path = /.*\\Phoebe.exe$/ nocase) or (($e.target.process.file.full_path = /.*C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe$/ nocase or $e.target.process.file.full_path = /.*C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe$/ nocase)) or (($e.target.process.file.full_path = /^C:\\Program Files (x86)\\QtWeb\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\QtWeb\\.*/ nocase) and $e.target.process.file.full_path = /.*\\QtWeb.exe$/ nocase) or (($e.target.process.file.full_path = /.*C:\\Program Files (x86)\\Safari\\.*/ nocase or $e.target.process.file.full_path = /.*C:\\Program Files\\Safari\\.*/ nocase) and $e.target.process.file.full_path = /.*\\safari.exe$/ nocase) or (($e.target.process.file.full_path = /^C:\\Program Files\\SeaMonkey\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files (x86)\\SeaMonkey\\.*/ nocase) and $e.target.process.file.full_path = /.*\\seamonkey.exe$/ nocase) or (($e.target.process.file.full_path = /^C:\\Program Files\\SlimBrowser\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files (x86)\\SlimBrowser\\.*/ nocase) and $e.target.process.file.full_path = /.*\\slimbrowser.exe$/ nocase) or ($e.target.process.file.full_path = /.*\\AppData\\Local\\Vivaldi\\.*/ nocase and $e.target.process.file.full_path = /.*\\vivaldi.exe$/ nocase) or (($e.target.process.file.full_path = /^C:\\Program Files\\Naver\\Naver Whale\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files (x86)\\Naver\\Naver Whale\\.*/ nocase) and $e.target.process.file.full_path = /.*\\whale.exe$/ nocase) or (($e.target.process.file.full_path = /^C:\\Program Files\\Waterfox\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files (x86)\\Waterfox\\.*/ nocase) and $e.target.process.file.full_path = /.*\\Waterfox.exe$/ nocase))))

  condition:
    $e
}
