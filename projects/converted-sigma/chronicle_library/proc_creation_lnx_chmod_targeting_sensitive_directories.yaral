// Title: Chmod Targeting Sensitive Directories
// ID: 6419afd1-3742-47a5-a7e6-b50386cd15f8
// Status: test
// Level: medium
// Author: Christopher Peacock @SecurePeacock, SCYTHE @scythe_io
// Date: 2022-06-03
// Tags: attack.defense-impairment, attack.t1222.002
// Description: Detects chmod targeting files in sensitive directory paths on Linux systems.
// Attackers may use chmod to change permissions of files in these directories to maintain persistence, escalate privileges, or disrupt system operations.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 6419afd1_3742_47a5_a7e6_b50386cd15f8 {
  meta:
    title = "Chmod Targeting Sensitive Directories"
    description = "Detects chmod targeting files in sensitive directory paths on Linux systems. Attackers may use chmod to change permissions of files in these directories to maintain persistence, escalate privileges, or disrupt system operations."
    author = "Christopher Peacock @SecurePeacock, SCYTHE @scythe_io"
    severity = "MEDIUM"

  events:
    (($e.target.process.file.full_path = /.*/chmod$/ nocase and ($e.target.process.command_line = /.*/tmp/.*/ nocase or $e.target.process.command_line = /.*/.Library/.*/ nocase or $e.target.process.command_line = /.*/etc/.*/ nocase or $e.target.process.command_line = /.*/opt/.*/ nocase)) and not((($e.target.process.command_line = /^chmod 700 /tmp/apt-key-gpghome..*/ nocase) or ($e.target.process.command_line = "chmod 0775 /etc/landscape/") or ($e.target.process.command_line = /^chmod 755 /var/tmp/mkinitramfs.*/ nocase) or ($e.target.process.command_line = /.*/etc/.*/ nocase and ($e.principal.process.command_line = /.*/var/lib/dpkg/info/.*/ nocase and $e.principal.process.command_line = /.*.postinst configure.*/ nocase)) or ($e.target.process.command_line = "chmod 644 /etc/apparmor.d/tunables/home.d/ubuntu") or ($e.target.process.command_line = /.*chmod --reference=/etc/shells.*/ nocase and $e.principal.process.command_line = /.*/update-shells$/ nocase))))

  condition:
    $e
}
