// Title: Process Access via TrolleyExpress Exclusion
// ID: 4c0aaedc-154c-4427-ada0-d80ef9c9deb6
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-10
// Tags: attack.stealth, attack.t1218.011, attack.credential-access, attack.t1003.001
// Description: Detects a possible process memory dump that uses the white-listed Citrix TrolleyExpress.exe filename as a way to dump the lsass process memory
// Converted by: Sigma Universal SIEM/EDR CLI

rule 4c0aaedc_154c_4427_ada0_d80ef9c9deb6 {
  meta:
    title = "Process Access via TrolleyExpress Exclusion"
    description = "Detects a possible process memory dump that uses the white-listed Citrix TrolleyExpress.exe filename as a way to dump the lsass process memory"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*\\TrolleyExpress 7.*/ nocase or $e.target.process.command_line = /.*\\TrolleyExpress 8.*/ nocase or $e.target.process.command_line = /.*\\TrolleyExpress 9.*/ nocase or $e.target.process.command_line = /.*\\TrolleyExpress.exe 7.*/ nocase or $e.target.process.command_line = /.*\\TrolleyExpress.exe 8.*/ nocase or $e.target.process.command_line = /.*\\TrolleyExpress.exe 9.*/ nocase or $e.target.process.command_line = /.*\\TrolleyExpress.exe -ma .*/ nocase)) or (($e.target.process.file.full_path = /.*\\TrolleyExpress.exe$/ nocase) and not(((not ($e.target.process.file.name = /.*/)) or ($e.target.process.file.name = /.*CtxInstall.*/ nocase)))))

  condition:
    $e
}
