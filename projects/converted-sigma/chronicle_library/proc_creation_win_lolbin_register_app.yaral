// Title: REGISTER_APP.VBS Proxy Execution
// ID: 1c8774a0-44d4-4db0-91f8-e792359c70bd
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-19
// Tags: attack.stealth, attack.t1218
// Description: Detects the use of a Microsoft signed script 'REGISTER_APP.VBS' to register a VSS/VDS Provider as a COM+ application.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 1c8774a0_44d4_4db0_91f8_e792359c70bd {
  meta:
    title = "REGISTER_APP.VBS Proxy Execution"
    description = "Detects the use of a Microsoft signed script 'REGISTER_APP.VBS' to register a VSS/VDS Provider as a COM+ application."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.target.process.command_line = /.*\\register_app.vbs.*/ nocase and $e.target.process.command_line = /.*-register.*/ nocase))

  condition:
    $e
}
