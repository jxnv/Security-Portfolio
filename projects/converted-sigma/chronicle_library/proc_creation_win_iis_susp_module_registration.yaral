// Title: Suspicious IIS Module Registration
// ID: 043c4b8b-3a54-4780-9682-081cb6b8185c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Microsoft (idea)
// Date: 2022-08-04
// Tags: attack.persistence, attack.t1505.004
// Description: Detects a suspicious IIS module registration as described in Microsoft threat report on IIS backdoors
// Converted by: Sigma Universal SIEM/EDR CLI

rule 043c4b8b_3a54_4780_9682_081cb6b8185c {
  meta:
    title = "Suspicious IIS Module Registration"
    description = "Detects a suspicious IIS module registration as described in Microsoft threat report on IIS backdoors"
    author = "Florian Roth (Nextron Systems), Microsoft (idea)"
    severity = "HIGH"

  events:
    (($e.principal.process.file.full_path = /.*\\w3wp.exe$/ nocase) and (($e.target.process.command_line = /.*appcmd.exe add module.*/ nocase) or ($e.target.process.command_line = /.* system.enterpriseservices.internal.publish.*/ nocase and $e.target.process.file.full_path = /.*\\powershell.exe$/ nocase) or (($e.target.process.command_line = /.*gacutil.*/ nocase and $e.target.process.command_line = /.* /I.*/ nocase))))

  condition:
    $e
}
