// Title: Curl File Upload To File Sharing Websites
// ID: e328cc73-f92a-42fb-b3fa-7c2cffda981a
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-03-29
// Tags: attack.exfiltration, attack.t1567.002
// Description: Detects usage of curl to upload files to known file sharing domains, which may indicate data exfiltration.
// Converted by: Sigma Universal SIEM/EDR CLI

rule e328cc73_f92a_42fb_b3fa_7c2cffda981a {
  meta:
    title = "Curl File Upload To File Sharing Websites"
    description = "Detects usage of curl to upload files to known file sharing domains, which may indicate data exfiltration."
    author = "Swachchhanda Shrawan Poudel (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*0x0.st.*/ nocase or $e.target.process.command_line = /.*bashupload.com.*/ nocase or $e.target.process.command_line = /.*chunk.io.*/ nocase or $e.target.process.command_line = /.*file.io.*/ nocase or $e.target.process.command_line = /.*filebin.net.*/ nocase or $e.target.process.command_line = /.*pastebin.*/ nocase or $e.target.process.command_line = /.*send.firefox.com.*/ nocase or $e.target.process.command_line = /.*temp.sh.*/ nocase or $e.target.process.command_line = /.*transfer.sh.*/ nocase or $e.target.process.command_line = /.*ufile.io.*/ nocase or $e.target.process.command_line = /.*uploadfiles.io.*/ nocase or $e.target.process.command_line = /.*wetransfer.com.*/ nocase or $e.target.process.command_line = /.*x0.at.*/ nocase)) and ((($e.target.process.command_line = /.* --form.*/ nocase or $e.target.process.command_line = /.* --upload-file.*/ nocase or $e.target.process.command_line = /.* --data.*/ nocase or $e.target.process.command_line = /.* -X POST.*/ nocase or $e.target.process.command_line = /.* --request POST .*/ nocase)) or (($e.target.process.command_line = /\s-[FTd]\s/ nocase or $e.target.process.command_line = /\s-sT\s/ nocase))) and (($e.target.process.file.full_path = /.*\\curl.exe$/ nocase) or ($e.target.process.file.name = "curl.exe")))

  condition:
    $e
}
