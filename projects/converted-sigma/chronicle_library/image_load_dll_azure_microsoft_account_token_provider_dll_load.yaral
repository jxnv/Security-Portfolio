// Title: Potential Azure Browser SSO Abuse
// ID: 50f852e6-af22-4c78-9ede-42ef36aa3453
// Status: test
// Level: low
// Author: Den Iuzvyk
// Date: 2020-07-15
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects abusing Azure Browser SSO by requesting OAuth 2.0 refresh tokens for an Azure-AD-authenticated Windows user (i.e. the machine is joined to Azure AD and a user logs in with their Azure AD account) wanting to perform SSO authentication in the browser.
// An attacker can use this to authenticate to Azure AD in a browser as that user.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 50f852e6_af22_4c78_9ede_42ef36aa3453 {
  meta:
    title = "Potential Azure Browser SSO Abuse"
    description = "Detects abusing Azure Browser SSO by requesting OAuth 2.0 refresh tokens for an Azure-AD-authenticated Windows user (i.e. the machine is joined to Azure AD and a user logs in with their Azure AD account) wanting to perform SSO authentication in the browser. An attacker can use this to authenticate to Azure AD in a browser as that user."
    author = "Den Iuzvyk"
    severity = "LOW"

  events:
    (($e.ImageLoaded = "C:\\Windows\\System32\\MicrosoftAccountTokenProvider.dll") and not((($e.target.process.file.full_path = /^C:\\Windows\\System32\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\SysWOW64\\.*/ nocase) and $e.target.process.file.full_path = /.*\\BackgroundTaskHost.exe$/ nocase)) and not(((($e.target.process.file.full_path = /^C:\\Program Files\\Microsoft Visual Studio\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files (x86)\\Microsoft Visual Studio\\.*/ nocase) and $e.target.process.file.full_path = /.*\\IDE\\devenv.exe$/ nocase) or (($e.target.process.file.full_path = /^C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\.*/ nocase) or ($e.target.process.file.full_path = /.*\\WindowsApps\\MicrosoftEdge.exe$/ nocase) or (($e.target.process.file.full_path = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or $e.target.process.file.full_path = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or (($e.target.process.file.full_path = /^C:\\Program Files (x86)\\Microsoft\\EdgeCore\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\Microsoft\\EdgeCore\\.*/ nocase) and ($e.target.process.file.full_path = /.*\\msedge.exe$/ nocase or $e.target.process.file.full_path = /.*\\msedgewebview2.exe$/ nocase)) or (($e.target.process.file.full_path = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or $e.target.process.file.full_path = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (not ($e.target.process.file.full_path = /.*/)) or ($e.target.process.file.full_path = /.*\\AppData\\Local\\Microsoft\\OneDrive\\OneDrive.exe$/ nocase))))

  condition:
    $e
}
