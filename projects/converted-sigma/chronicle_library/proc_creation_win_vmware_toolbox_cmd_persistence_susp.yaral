// Title: Suspicious Persistence Via VMwareToolBoxCmd.EXE VM State Change Script
// ID: 236d8e89-ed95-4789-a982-36f4643738ba
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-14
// Tags: attack.execution, attack.persistence, attack.t1059
// Description: Detects execution of the "VMwareToolBoxCmd.exe" with the "script" and "set" flag to setup a specific script that's located in a potentially suspicious location to run for a specific VM state
// Converted by: Sigma Universal SIEM/EDR CLI

rule 236d8e89_ed95_4789_a982_36f4643738ba {
  meta:
    title = "Suspicious Persistence Via VMwareToolBoxCmd.EXE VM State Change Script"
    description = "Detects execution of the "VMwareToolBoxCmd.exe" with the "script" and "set" flag to setup a specific script that's located in a potentially suspicious location to run for a specific VM state"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.* script .*/ nocase and $e.target.process.command_line = /.* set .*/ nocase)) and (($e.target.process.file.full_path = /.*\\VMwareToolBoxCmd.exe$/ nocase) or ($e.target.process.file.name = "toolbox-cmd.exe")) and (($e.target.process.command_line = /.*:\\PerfLogs\\.*/ nocase or $e.target.process.command_line = /.*:\\Temp\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\System32\\Tasks\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\Tasks\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\Temp\\.*/ nocase or $e.target.process.command_line = /.*\\AppData\\Local\\Temp.*/ nocase)))

  condition:
    $e
}
