rule c02e96b7_c63a_4c47_bd83_4a9f74afcfb2 {
  meta:
    title = "New Service Creation Using PowerShell"
    description = "Detects the creation of a new service using powershell."
    author = "Timur Zinniatullin, Daniil Yugoslavskiy, oscd.community"
    severity = "LOW"

  events:
    (($e.target.process.command_line = /.*New-Service.*/ nocase and $e.target.process.command_line = /.*-BinaryPathName.*/ nocase))

  condition:
    $e
}
