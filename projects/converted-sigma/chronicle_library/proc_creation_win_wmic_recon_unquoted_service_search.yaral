// Title: Potential Unquoted Service Path Reconnaissance Via Wmic.EXE
// ID: 68bcd73b-37ef-49cb-95fc-edc809730be6
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-20
// Tags: attack.execution, attack.t1047
// Description: Detects known WMI recon method to look for unquoted service paths using wmic. Often used by pentester and attacker enumeration scripts
// Converted by: Sigma Universal SIEM/EDR CLI

rule 68bcd73b_37ef_49cb_95fc_edc809730be6 {
  meta:
    title = "Potential Unquoted Service Path Reconnaissance Via Wmic.EXE"
    description = "Detects known WMI recon method to look for unquoted service paths using wmic. Often used by pentester and attacker enumeration scripts"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.* service get .*/ nocase and $e.target.process.command_line = /.*name,displayname,pathname,startmode.*/ nocase)) and (($e.target.process.file.name = "wmic.exe") or ($e.target.process.file.full_path = /.*\\WMIC.exe$/ nocase)))

  condition:
    $e
}
