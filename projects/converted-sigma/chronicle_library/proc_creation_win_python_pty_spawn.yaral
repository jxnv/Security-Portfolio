// Title: Python Spawning Pretty TTY on Windows
// ID: 480e7e51-e797-47e3-8d72-ebfce65b6d8d
// Status: test
// Level: high
// Author: Nextron Systems
// Date: 2022-06-03
// Tags: attack.execution, attack.t1059
// Description: Detects python spawning a pretty tty
// Converted by: Sigma Universal SIEM/EDR CLI

rule 480e7e51_e797_47e3_8d72_ebfce65b6d8d {
  meta:
    title = "Python Spawning Pretty TTY on Windows"
    description = "Detects python spawning a pretty tty"
    author = "Nextron Systems"
    severity = "HIGH"

  events:
    ((($e.target.process.file.full_path = /.*python.exe$/ nocase or $e.target.process.file.full_path = /.*python3.exe$/ nocase or $e.target.process.file.full_path = /.*python2.exe$/ nocase)) and ((($e.target.process.command_line = /.*import pty.*/ nocase and $e.target.process.command_line = /.*.spawn(.*/ nocase)) or ($e.target.process.command_line = /.*from pty import spawn.*/ nocase)))

  condition:
    $e
}
