// Title: Access To Potentially Sensitive Sysvol Files By Uncommon Applications
// ID: d51694fe-484a-46ac-92d6-969e76d60d10
// Status: test
// Level: medium
// Author: frack113
// Date: 2023-12-21
// Tags: attack.credential-access, attack.t1552.006
// Description: Detects file access requests to potentially sensitive files hosted on the Windows Sysvol share.
// Converted by: Sigma Universal SIEM/EDR CLI

rule d51694fe_484a_46ac_92d6_969e76d60d10 {
  meta:
    title = "Access To Potentially Sensitive Sysvol Files By Uncommon Applications"
    description = "Detects file access requests to potentially sensitive files hosted on the Windows Sysvol share."
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.FileName = /^\\\\.*/ nocase and ($e.FileName = /.*\\sysvol\\.*/ nocase and $e.FileName = /.*\\Policies\\.*/ nocase) and ($e.FileName = /.*audit.csv$/ nocase or $e.FileName = /.*Files.xml$/ nocase or $e.FileName = /.*GptTmpl.inf$/ nocase or $e.FileName = /.*groups.xml$/ nocase or $e.FileName = /.*Registry.pol$/ nocase or $e.FileName = /.*Registry.xml$/ nocase or $e.FileName = /.*scheduledtasks.xml$/ nocase or $e.FileName = /.*scripts.ini$/ nocase or $e.FileName = /.*services.xml$/ nocase)) and not((($e.target.process.file.full_path = "C:\\Windows\\explorer.exe") or (($e.target.process.file.full_path = /^C:\\Program Files (x86)\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\system32\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\SysWOW64\\.*/ nocase)))))

  condition:
    $e
}
