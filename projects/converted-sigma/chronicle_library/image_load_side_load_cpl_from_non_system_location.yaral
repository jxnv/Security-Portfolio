// Title: System Control Panel Item Loaded From Uncommon Location
// ID: 2b140a5c-dc02-4bb8-b6b1-8bdb45714cde
// Status: test
// Level: high
// Author: Anish Bogati
// Date: 2024-01-09
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects image load events of system control panel items (.cpl) from uncommon or non-system locations that may indicate DLL sideloading or other abuse techniques.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 2b140a5c_dc02_4bb8_b6b1_8bdb45714cde {
  meta:
    title = "System Control Panel Item Loaded From Uncommon Location"
    description = "Detects image load events of system control panel items (.cpl) from uncommon or non-system locations that may indicate DLL sideloading or other abuse techniques."
    author = "Anish Bogati"
    severity = "HIGH"

  events:
    ((($e.ImageLoaded = /.*\\appwiz.cpl$/ nocase or $e.ImageLoaded = /.*\\bthprops.cpl$/ nocase or $e.ImageLoaded = /.*\\hdwwiz.cpl$/ nocase)) and not((($e.ImageLoaded = /^C:\\Windows\\Prefetch\\.*/ nocase or $e.ImageLoaded = /^C:\\Windows\\System32\\.*/ nocase or $e.ImageLoaded = /^C:\\Windows\\SysWOW64\\.*/ nocase or $e.ImageLoaded = /^C:\\Windows\\WinSxS\\.*/ nocase))))

  condition:
    $e
}
