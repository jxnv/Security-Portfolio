// Title: Potential DLL Sideloading Via comctl32.dll
// ID: 6360757a-d460-456c-8b13-74cf0e60cceb
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Subhash Popuri (@pbssubhash)
// Date: 2022-12-16
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading using comctl32.dll to obtain system privileges
// Converted by: Sigma Universal SIEM/EDR CLI

rule 6360757a_d460_456c_8b13_74cf0e60cceb {
  meta:
    title = "Potential DLL Sideloading Via comctl32.dll"
    description = "Detects potential DLL sideloading using comctl32.dll to obtain system privileges"
    author = "Nasreddine Bencherchali (Nextron Systems), Subhash Popuri (@pbssubhash)"
    severity = "HIGH"

  events:
    (($e.ImageLoaded = /^C:\\Windows\\System32\\logonUI.exe.local\\.*/ nocase or $e.ImageLoaded = /^C:\\Windows\\System32\\werFault.exe.local\\.*/ nocase or $e.ImageLoaded = /^C:\\Windows\\System32\\consent.exe.local\\.*/ nocase or $e.ImageLoaded = /^C:\\Windows\\System32\\narrator.exe.local\\.*/ nocase or $e.ImageLoaded = /^C:\\windows\\system32\\wermgr.exe.local\\.*/ nocase) and $e.ImageLoaded = /.*\\comctl32.dll$/ nocase)

  condition:
    $e
}
