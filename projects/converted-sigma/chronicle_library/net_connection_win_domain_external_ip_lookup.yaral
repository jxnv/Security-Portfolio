// Title: Suspicious Network Connection to IP Lookup Service APIs
// ID: edf3485d-dac4-4d50-90e4-b0e5813f7e60
// Status: test
// Level: medium
// Author: Janantha Marasinghe, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-24
// Tags: attack.discovery, attack.t1016
// Description: Detects external IP address lookups by non-browser processes via services such as "api.ipify.org". This could be indicative of potential post compromise internet test activity.
// Converted by: Sigma Universal SIEM/EDR CLI

rule edf3485d_dac4_4d50_90e4_b0e5813f7e60 {
  meta:
    title = "Suspicious Network Connection to IP Lookup Service APIs"
    description = "Detects external IP address lookups by non-browser processes via services such as "api.ipify.org". This could be indicative of potential post compromise internet test activity."
    author = "Janantha Marasinghe, Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (((($e.DestinationHostname = "www.ip.cn" or $e.DestinationHostname = "l2.io")) or (($e.DestinationHostname = /.*api.2ip.ua.*/ nocase or $e.DestinationHostname = /.*api.bigdatacloud.net.*/ nocase or $e.DestinationHostname = /.*api.ipify.org.*/ nocase or $e.DestinationHostname = /.*bot.whatismyipaddress.com.*/ nocase or $e.DestinationHostname = /.*canireachthe.net.*/ nocase or $e.DestinationHostname = /.*checkip.amazonaws.com.*/ nocase or $e.DestinationHostname = /.*checkip.dyndns.org.*/ nocase or $e.DestinationHostname = /.*curlmyip.com.*/ nocase or $e.DestinationHostname = /.*db-ip.com.*/ nocase or $e.DestinationHostname = /.*edns.ip-api.com.*/ nocase or $e.DestinationHostname = /.*eth0.me.*/ nocase or $e.DestinationHostname = /.*freegeoip.app.*/ nocase or $e.DestinationHostname = /.*geoipy.com.*/ nocase or $e.DestinationHostname = /.*getip.pro.*/ nocase or $e.DestinationHostname = /.*icanhazip.com.*/ nocase or $e.DestinationHostname = /.*ident.me.*/ nocase or $e.DestinationHostname = /.*ifconfig.io.*/ nocase or $e.DestinationHostname = /.*ifconfig.me.*/ nocase or $e.DestinationHostname = /.*ip-api.com.*/ nocase or $e.DestinationHostname = /.*ip.360.cn.*/ nocase or $e.DestinationHostname = /.*ip.anysrc.net.*/ nocase or $e.DestinationHostname = /.*ip.taobao.com.*/ nocase or $e.DestinationHostname = /.*ip.tyk.nu.*/ nocase or $e.DestinationHostname = /.*ipaddressworld.com.*/ nocase or $e.DestinationHostname = /.*ipapi.co.*/ nocase or $e.DestinationHostname = /.*ipconfig.io.*/ nocase or $e.DestinationHostname = /.*ipecho.net.*/ nocase or $e.DestinationHostname = /.*ipinfo.io.*/ nocase or $e.DestinationHostname = /.*ipip.net.*/ nocase or $e.DestinationHostname = /.*ipof.in.*/ nocase or $e.DestinationHostname = /.*ipv4.icanhazip.com.*/ nocase or $e.DestinationHostname = /.*ipv4bot.whatismyipaddress.com.*/ nocase or $e.DestinationHostname = /.*ipv6-test.com.*/ nocase or $e.DestinationHostname = /.*ipwho.is.*/ nocase or $e.DestinationHostname = /.*jsonip.com.*/ nocase or $e.DestinationHostname = /.*myexternalip.com.*/ nocase or $e.DestinationHostname = /.*seeip.org.*/ nocase or $e.DestinationHostname = /.*wgetip.com.*/ nocase or $e.DestinationHostname = /.*whatismyip.akamai.com.*/ nocase or $e.DestinationHostname = /.*whois.pconline.com.cn.*/ nocase or $e.DestinationHostname = /.*wtfismyip.com.*/ nocase))) and not((($e.target.process.file.full_path = /.*\\brave.exe$/ nocase) or (($e.target.process.file.full_path = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or $e.target.process.file.full_path = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or (($e.target.process.file.full_path = /^C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\.*/ nocase) or ($e.target.process.file.full_path = /.*\\WindowsApps\\MicrosoftEdge.exe$/ nocase) or (($e.target.process.file.full_path = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or $e.target.process.file.full_path = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or (($e.target.process.file.full_path = /^C:\\Program Files (x86)\\Microsoft\\EdgeCore\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\Microsoft\\EdgeCore\\.*/ nocase) and ($e.target.process.file.full_path = /.*\\msedge.exe$/ nocase or $e.target.process.file.full_path = /.*\\msedgewebview2.exe$/ nocase)) or (($e.target.process.file.full_path = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or $e.target.process.file.full_path = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or (($e.target.process.file.full_path = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or $e.target.process.file.full_path = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or ($e.target.process.file.full_path = /.*\\maxthon.exe$/ nocase) or ($e.target.process.file.full_path = /.*\\opera.exe$/ nocase) or ($e.target.process.file.full_path = /.*\\safari.exe$/ nocase) or ($e.target.process.file.full_path = /.*\\seamonkey.exe$/ nocase) or ($e.target.process.file.full_path = /.*\\vivaldi.exe$/ nocase) or ($e.target.process.file.full_path = /.*\\whale.exe$/ nocase))))

  condition:
    $e
}
