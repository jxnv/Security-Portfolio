// Title: SCM Database Privileged Operation
// ID: dae8171c-5ec6-4396-b210-8466585b53e9
// Status: test
// Level: medium
// Author: Roberto Rodriguez @Cyb3rWard0g, Tim Shelton
// Date: 2019-08-15
// Tags: attack.privilege-escalation, attack.t1548
// Description: Detects non-system users performing privileged operation os the SCM database
// Converted by: Sigma Universal SIEM/EDR CLI

rule dae8171c_5ec6_4396_b210_8466585b53e9 {
  meta:
    title = "SCM Database Privileged Operation"
    description = "Detects non-system users performing privileged operation os the SCM database"
    author = "Roberto Rodriguez @Cyb3rWard0g, Tim Shelton"
    severity = "MEDIUM"

  events:
    (($e.EventID = 4674 and $e.ObjectType = "SC_MANAGER OBJECT" and $e.ObjectName = "servicesactive" and $e.PrivilegeList = "SeTakeOwnershipPrivilege") and not(($e.SubjectLogonId = "0x3e4" and $e.ProcessName = /.*:\\Windows\\System32\\services.exe$/ nocase)))

  condition:
    $e
}
