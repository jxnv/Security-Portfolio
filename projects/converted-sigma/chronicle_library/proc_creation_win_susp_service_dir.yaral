// Title: Suspicious Service Binary Directory
// ID: 883faa95-175a-4e22-8181-e5761aeb373c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-03-09
// Tags: attack.stealth, attack.t1202
// Description: Detects a service binary running in a suspicious directory
// Converted by: Sigma Universal SIEM/EDR CLI

rule 883faa95_175a_4e22_8181_e5761aeb373c {
  meta:
    title = "Suspicious Service Binary Directory"
    description = "Detects a service binary running in a suspicious directory"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.file.full_path = /.*\\Users\\Public\\.*/ nocase or $e.target.process.file.full_path = /.*\\$Recycle.bin.*/ nocase or $e.target.process.file.full_path = /.*\\Users\\All Users\\.*/ nocase or $e.target.process.file.full_path = /.*\\Users\\Default\\.*/ nocase or $e.target.process.file.full_path = /.*\\Users\\Contacts\\.*/ nocase or $e.target.process.file.full_path = /.*\\Users\\Searches\\.*/ nocase or $e.target.process.file.full_path = /.*C:\\Perflogs\\.*/ nocase or $e.target.process.file.full_path = /.*\\config\\systemprofile\\.*/ nocase or $e.target.process.file.full_path = /.*\\Windows\\Fonts\\.*/ nocase or $e.target.process.file.full_path = /.*\\Windows\\IME\\.*/ nocase or $e.target.process.file.full_path = /.*\\Windows\\addins\\.*/ nocase) and ($e.principal.process.file.full_path = /.*\\services.exe$/ nocase or $e.principal.process.file.full_path = /.*\\svchost.exe$/ nocase))

  condition:
    $e
}
