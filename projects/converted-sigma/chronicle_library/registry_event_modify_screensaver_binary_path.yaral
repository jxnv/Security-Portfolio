// Title: Path To Screensaver Binary Modified
// ID: 67a6c006-3fbe-46a7-9074-2ba3b82c3000
// Status: test
// Level: medium
// Author: Bartlomiej Czyz @bczyz1, oscd.community
// Date: 2020-10-11
// Tags: attack.persistence, attack.privilege-escalation, attack.t1546.002
// Description: Detects value modification of registry key containing path to binary used as screensaver.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 67a6c006_3fbe_46a7_9074_2ba3b82c3000 {
  meta:
    title = "Path To Screensaver Binary Modified"
    description = "Detects value modification of registry key containing path to binary used as screensaver."
    author = "Bartlomiej Czyz @bczyz1, oscd.community"
    severity = "MEDIUM"

  events:
    (($e.TargetObject = /.*\\Control Panel\\Desktop\\SCRNSAVE.EXE$/ nocase) and not((($e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase or $e.target.process.file.full_path = /.*\\explorer.exe$/ nocase))))

  condition:
    $e
}
