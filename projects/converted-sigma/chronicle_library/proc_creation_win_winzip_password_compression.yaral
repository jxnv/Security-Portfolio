rule e2e80da2_8c66_4e00_ae3c_2eebd29f6b6d {
  meta:
    title = "Compress Data and Lock With Password for Exfiltration With WINZIP"
    description = "An adversary may compress or encrypt data that is collected prior to exfiltration using 3rd party utilities"
    author = "frack113"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.* -min .*/ nocase or $e.target.process.command_line = /.* -a .*/ nocase)) and ($e.target.process.command_line = /.*-s\".*/ nocase) and (($e.target.process.command_line = /.*winzip.exe.*/ nocase or $e.target.process.command_line = /.*winzip64.exe.*/ nocase)))

  condition:
    $e
}
