rule bc3a4b0c_e167_48e1_aa88_b3020950e560 {
  meta:
    title = "Remote Printing Abuse for Lateral Movement"
    description = "Detects remote RPC calls to possibly abuse remote printing service via MS-RPRN / MS-PAR"
    author = "Sagie Dulce, Dekel Paz"
    severity = "HIGH"

  events:
    ($e.EventLog = "RPCFW" and $e.EventID = 3 and ($e.InterfaceUuid = "12345678-1234-abcd-ef00-0123456789ab" or $e.InterfaceUuid = "76f03f96-cdfd-44fc-a22c-64950a001209" or $e.InterfaceUuid = "0b6edbfa-4a24-4fc6-8a23-942b1eca65d1" or $e.InterfaceUuid = "ae33069b-a2a8-46ee-a235-ddfd339be281"))

  condition:
    $e
}
