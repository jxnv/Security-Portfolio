// Title: Win Susp Computer Name Containing Samtheadmin
// ID: 39698b3f-da92-4bc6-bfb5-645a98386e45
// Status: test
// Level: critical
// Author: elhoim
// Date: 2022-09-09
// Tags: attack.initial-access, cve.2021-42278, cve.2021-42287, attack.persistence, attack.privilege-escalation, attack.stealth, attack.t1078
// Description: Detects suspicious computer name samtheadmin-{1..100}$ generated by hacktool
// Converted by: Sigma Universal SIEM/EDR CLI

rule 39698b3f_da92_4bc6_bfb5_645a98386e45 {
  meta:
    title = "Win Susp Computer Name Containing Samtheadmin"
    description = "Detects suspicious computer name samtheadmin-{1..100}$ generated by hacktool"
    author = "elhoim"
    severity = "CRITICAL"

  events:
    (($e.SamAccountName = /^SAMTHEADMIN-.*/ nocase and $e.SamAccountName = /.*$$/ nocase) or ($e.TargetUserName = /^SAMTHEADMIN-.*/ nocase and $e.TargetUserName = /.*$$/ nocase))

  condition:
    $e
}
