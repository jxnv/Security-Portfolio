rule cd71385d_fd9b_4691_9b98_2b1f7e508714 {
  meta:
    title = "Lolbin Runexehelper Use As Proxy"
    description = "Detect usage of the "runexehelper.exe" binary as a proxy to launch other programs"
    author = "frack113"
    severity = "MEDIUM"

  events:
    ($e.principal.process.file.full_path = /.*\\runexehelper.exe$/ nocase)

  condition:
    $e
}
