rule 076ebe48_cc05_4d8f_9d41_89245cd93a14 {
  meta:
    title = "Remote Access Tool - ScreenConnect Command Execution"
    description = "Detects command execution via ScreenConnect RMM"
    author = "Ali Alwashali"
    severity = "LOW"

  events:
    ($e.Provider_Name = "ScreenConnect" and $e.EventID = 200 and $e.Data = /.*Executed command of length.*/ nocase)

  condition:
    $e
}
