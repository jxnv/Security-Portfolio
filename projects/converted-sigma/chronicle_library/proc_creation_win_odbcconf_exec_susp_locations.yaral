// Title: Odbcconf.EXE Suspicious DLL Location
// ID: 6b65c28e-11f3-46cb-902a-68f2cafaf474
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-22
// Tags: attack.stealth, attack.t1218.008
// Description: Detects execution of "odbcconf" where the path of the DLL being registered is located in a potentially suspicious location.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 6b65c28e_11f3_46cb_902a_68f2cafaf474 {
  meta:
    title = "Odbcconf.EXE Suspicious DLL Location"
    description = "Detects execution of "odbcconf" where the path of the DLL being registered is located in a potentially suspicious location."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*:\\PerfLogs\\.*/ nocase or $e.target.process.command_line = /.*:\\ProgramData\\.*/ nocase or $e.target.process.command_line = /.*:\\Temp\\.*/ nocase or $e.target.process.command_line = /.*:\\Users\\Public\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\Registration\\CRMLog.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\System32\\com\\dmp\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\System32\\FxsTmp\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\System32\\Microsoft\\Crypto\\RSA\\MachineKeys\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\System32\\spool\\drivers\\color\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\System32\\spool\\PRINTERS\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\System32\\spool\\SERVERS\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\System32\\Tasks_Migrated\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\System32\\Tasks\\Microsoft\\Windows\\SyncCenter\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\SysWOW64\\com\\dmp\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\SysWOW64\\FxsTmp\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\PLA\\System\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\SyncCenter\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\Tasks\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\Temp\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\Tracing\\.*/ nocase or $e.target.process.command_line = /.*\\AppData\\Local\\Temp\\.*/ nocase or $e.target.process.command_line = /.*\\AppData\\Roaming\\.*/ nocase)) and (($e.target.process.file.full_path = /.*\\odbcconf.exe$/ nocase) or ($e.target.process.file.name = "odbcconf.exe")))

  condition:
    $e
}
