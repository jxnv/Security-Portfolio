// Title: PUA - Suspicious ActiveDirectory Enumeration Via AdFind.EXE
// ID: 455b9d50-15a1-4b99-853f-8d37655a4c1b
// Status: test
// Level: high
// Author: frack113
// Date: 2021-12-13
// Tags: attack.discovery, attack.t1087.002
// Description: Detects active directory enumeration activity using known AdFind CLI flags
// Converted by: Sigma Universal SIEM/EDR CLI

rule 455b9d50_15a1_4b99_853f_8d37655a4c1b {
  meta:
    title = "PUA - Suspicious ActiveDirectory Enumeration Via AdFind.EXE"
    description = "Detects active directory enumeration activity using known AdFind CLI flags"
    author = "frack113"
    severity = "HIGH"

  events:
    (($e.target.process.command_line = /.*-sc admincountdmp.*/ nocase) or ($e.target.process.command_line = /.*-sc exchaddresses.*/ nocase) or (($e.target.process.command_line = /.*lockoutduration.*/ nocase or $e.target.process.command_line = /.*lockoutthreshold.*/ nocase or $e.target.process.command_line = /.*lockoutobservationwindow.*/ nocase or $e.target.process.command_line = /.*maxpwdage.*/ nocase or $e.target.process.command_line = /.*minpwdage.*/ nocase or $e.target.process.command_line = /.*minpwdlength.*/ nocase or $e.target.process.command_line = /.*pwdhistorylength.*/ nocase or $e.target.process.command_line = /.*pwdproperties.*/ nocase)))

  condition:
    $e
}
