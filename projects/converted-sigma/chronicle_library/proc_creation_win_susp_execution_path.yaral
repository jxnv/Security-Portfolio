// Title: Process Execution From A Potentially Suspicious Folder
// ID: 3dfd06d2-eaf4-4532-9555-68aca59f57c4
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Tim Shelton
// Date: 2019-01-16
// Tags: attack.stealth, attack.t1036
// Description: Detects a potentially suspicious execution from an uncommon folder.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 3dfd06d2_eaf4_4532_9555_68aca59f57c4 {
  meta:
    title = "Process Execution From A Potentially Suspicious Folder"
    description = "Detects a potentially suspicious execution from an uncommon folder."
    author = "Florian Roth (Nextron Systems), Tim Shelton"
    severity = "HIGH"

  events:
    ((($e.target.process.file.full_path = /.*:\\Perflogs\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Users\\All Users\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Users\\Default\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Users\\NetworkService\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\addins\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\debug\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\Fonts\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\Help\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\IME\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\Media\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\repair\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\security\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\System32\\Tasks\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\Tasks\\.*/ nocase or $e.target.process.file.full_path = /.*$Recycle.bin.*/ nocase or $e.target.process.file.full_path = /.*\\config\\systemprofile\\.*/ nocase or $e.target.process.file.full_path = /.*\\Intel\\Logs\\.*/ nocase or $e.target.process.file.full_path = /.*\\RSA\\MachineKeys\\.*/ nocase)) and not((($e.target.process.file.full_path = /^C:\\Windows\\SysWOW64\\config\\systemprofile\\Citrix\\UpdaterBinaries\\.*/ nocase and $e.target.process.file.full_path = /.*\\CitrixReceiverUpdater.exe$/ nocase) or ($e.target.process.file.full_path = /^C:\\Users\\Public\\IBM\\ClientSolutions\\Start_Programs\\.*/ nocase))))

  condition:
    $e
}
