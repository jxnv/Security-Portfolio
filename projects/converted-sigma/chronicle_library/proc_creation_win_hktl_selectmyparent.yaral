// Title: HackTool - PPID Spoofing SelectMyParent Tool Execution
// ID: 52ff7941-8211-46f9-84f8-9903efb7077d
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-07-23
// Tags: attack.privilege-escalation, attack.stealth, attack.t1134.004
// Description: Detects the use of parent process ID spoofing tools like Didier Stevens tool SelectMyParent
// Converted by: Sigma Universal SIEM/EDR CLI

rule 52ff7941_8211_46f9_84f8_9903efb7077d {
  meta:
    title = "HackTool - PPID Spoofing SelectMyParent Tool Execution"
    description = "Detects the use of parent process ID spoofing tools like Didier Stevens tool SelectMyParent"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.file.full_path = /.*\\SelectMyParent.exe$/ nocase) or (($e.target.process.command_line = /.*PPID-spoof.*/ nocase or $e.target.process.command_line = /.*ppid_spoof.*/ nocase or $e.target.process.command_line = /.*spoof-ppid.*/ nocase or $e.target.process.command_line = /.*spoof_ppid.*/ nocase or $e.target.process.command_line = /.*ppidspoof.*/ nocase or $e.target.process.command_line = /.*spoofppid.*/ nocase or $e.target.process.command_line = /.*spoofedppid.*/ nocase or $e.target.process.command_line = /.* -spawnto .*/ nocase)) or (($e.target.process.file.name = /.*PPID-spoof.*/ nocase or $e.target.process.file.name = /.*ppid_spoof.*/ nocase or $e.target.process.file.name = /.*spoof-ppid.*/ nocase or $e.target.process.file.name = /.*spoof_ppid.*/ nocase or $e.target.process.file.name = /.*ppidspoof.*/ nocase or $e.target.process.file.name = /.*spoofppid.*/ nocase or $e.target.process.file.name = /.*spoofedppid.*/ nocase)) or ($e.Description = "SelectMyParent") or (($e.Hashes = /.*IMPHASH=04D974875BD225F00902B4CAD9AF3FBC.*/ nocase or $e.Hashes = /.*IMPHASH=A782AF154C9E743DDF3F3EB2B8F3D16E.*/ nocase or $e.Hashes = /.*IMPHASH=89059503D7FBF470E68F7E63313DA3AD.*/ nocase or $e.Hashes = /.*IMPHASH=CA28337632625C8281AB8A130B3D6BAD.*/ nocase)))

  condition:
    $e
}
