// Title: Potential File Overwrite Via Sysinternals SDelete
// ID: a4824fca-976f-4964-b334-0621379e84c4
// Status: test
// Level: high
// Author: frack113
// Date: 2021-06-03
// Tags: attack.impact, attack.t1485
// Description: Detects the use of SDelete to erase a file not the free space
// Converted by: Sigma Universal SIEM/EDR CLI

rule a4824fca_976f_4964_b334_0621379e84c4 {
  meta:
    title = "Potential File Overwrite Via Sysinternals SDelete"
    description = "Detects the use of SDelete to erase a file not the free space"
    author = "frack113"
    severity = "HIGH"

  events:
    (($e.target.process.file.name = "sdelete.exe") and not((($e.target.process.command_line = /.* -h.*/ nocase or $e.target.process.command_line = /.* -c.*/ nocase or $e.target.process.command_line = /.* -z.*/ nocase or $e.target.process.command_line = /.* /\\?.*/ nocase))))

  condition:
    $e
}
