rule 37b437cf_3fc5_4c8e_9c94_1d7c9aff842b {
  meta:
    title = "Allow RDP Remote Assistance Feature"
    description = "Detect enable rdp feature to allow specific user to rdp connect on the targeted machine"
    author = "frack113"
    severity = "MEDIUM"

  events:
    ($e.TargetObject = /.*System\\CurrentControlSet\\Control\\Terminal Server\\fAllowToGetHelp$/ nocase and $e.Details = "DWORD (0x00000001)")

  condition:
    $e
}
