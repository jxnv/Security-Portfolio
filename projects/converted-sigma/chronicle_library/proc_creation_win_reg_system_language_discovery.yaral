// Title: System Language Discovery via Reg.Exe
// ID: c43a5405-e8e1-4221-9ac9-dbe3fa14e886
// Status: experimental
// Level: medium
// Author: Marco Pedrinazzi (@pedrinazziM) (InTheCyber)
// Date: 2026-01-09
// Tags: attack.discovery, attack.t1614.001
// Description: Detects the usage of Reg.Exe to query system language settings.
// Attackers may discover the system language to determine the geographic location of victims, customize payloads for specific regions,
// or avoid targeting certain locales to evade detection.
// Converted by: Sigma Universal SIEM/EDR CLI

rule c43a5405_e8e1_4221_9ac9_dbe3fa14e886 {
  meta:
    title = "System Language Discovery via Reg.Exe"
    description = "Detects the usage of Reg.Exe to query system language settings. Attackers may discover the system language to determine the geographic location of victims, customize payloads for specific regions, or avoid targeting certain locales to evade detection."
    author = "Marco Pedrinazzi (@pedrinazziM) (InTheCyber)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*query.*/ nocase and $e.target.process.command_line = /.*Control\\Nls\\Language.*/ nocase)) and (($e.target.process.file.full_path = /.*\\reg.exe$/ nocase) or ($e.target.process.file.name = "reg.exe")))

  condition:
    $e
}
