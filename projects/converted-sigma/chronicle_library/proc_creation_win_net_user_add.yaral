// Title: New User Created Via Net.EXE
// ID: cd219ff3-fa99-45d4-8380-a7d15116c6dc
// Status: test
// Level: medium
// Author: Endgame, JHasenbusch (adapted to Sigma for oscd.community)
// Date: 2018-10-30
// Tags: attack.persistence, attack.t1136.001
// Description: Identifies the creation of local users via the net.exe command.
// Converted by: Sigma Universal SIEM/EDR CLI

rule cd219ff3_fa99_45d4_8380_a7d15116c6dc {
  meta:
    title = "New User Created Via Net.EXE"
    description = "Identifies the creation of local users via the net.exe command."
    author = "Endgame, JHasenbusch (adapted to Sigma for oscd.community)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*user.*/ nocase and $e.target.process.command_line = /.*add.*/ nocase)) and ((($e.target.process.file.full_path = /.*\\net.exe$/ nocase or $e.target.process.file.full_path = /.*\\net1.exe$/ nocase)) or (($e.target.process.file.name = "net.exe" or $e.target.process.file.name = "net1.exe"))))

  condition:
    $e
}
