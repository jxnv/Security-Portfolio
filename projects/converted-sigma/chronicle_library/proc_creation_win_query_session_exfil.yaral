// Title: Query Usage To Exfil Data
// ID: 53ef0cef-fa24-4f25-a34a-6c72dfa2e6e2
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-01
// Tags: attack.execution
// Description: Detects usage of "query.exe" a system binary to exfil information such as "sessions" and "processes" for later use
// Converted by: Sigma Universal SIEM/EDR CLI

rule 53ef0cef_fa24_4f25_a34a_6c72dfa2e6e2 {
  meta:
    title = "Query Usage To Exfil Data"
    description = "Detects usage of "query.exe" a system binary to exfil information such as "sessions" and "processes" for later use"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ($e.target.process.file.full_path = /.*:\\Windows\\System32\\query.exe$/ nocase and ($e.target.process.command_line = /.*session >.*/ nocase or $e.target.process.command_line = /.*process >.*/ nocase))

  condition:
    $e
}
