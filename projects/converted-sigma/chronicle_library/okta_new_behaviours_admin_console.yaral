// Tags: attack.privilege-escalation, attack.persistence, attack.initial-access, attack.stealth, attack.t1078.004
// Description: Detects when Okta identifies new activity in the Admin Console.
// Converted by: Sigma Universal SIEM/EDR CLI

rule a0b38b70_3cb5_484b_a4eb_c4d8e7bcc0a9 {
  meta:
    title = "Okta New Admin Console Behaviours"
    description = "Detects when Okta identifies new activity in the Admin Console."
    author = "kelnage"
    severity = "HIGH"

  events:
    (($e.eventType = "policy.evaluate_sign_on" and $e.target.displayName = "Okta Admin Console") and (($e.debugContext.debugData.behaviors = /.*POSITIVE.*/ nocase) or ($e.debugContext.debugData.logOnlySecurityData = /.*POSITIVE.*/ nocase)))

  condition:
    $e
}
