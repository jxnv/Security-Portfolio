rule 2ff692c2_4594_41ec_8fcb_46587de769e0 {
  meta:
    title = "CrashControl CrashDump Disabled"
    description = "Detects disabling the CrashDump per registry (as used by HermeticWiper)"
    author = "Tobias Michalski (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ($e.TargetObject = /.*SYSTEM\\CurrentControlSet\\Control\\CrashControl.*/ nocase and $e.Details = "DWORD (0x00000000)")

  condition:
    $e
}
