// Title: Scheduled Task Creation Via Schtasks.EXE
// ID: 92626ddd-662c-49e3-ac59-f6535f12d189
// Status: test
// Level: low
// Author: Florian Roth (Nextron Systems)
// Date: 2019-01-16
// Tags: attack.execution, attack.persistence, attack.privilege-escalation, attack.t1053.005, attack.s0111, car.2013-08-001, stp.1u
// Description: Detects the creation of scheduled tasks by user accounts via the "schtasks" utility.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 92626ddd_662c_49e3_ac59_f6535f12d189 {
  meta:
    title = "Scheduled Task Creation Via Schtasks.EXE"
    description = "Detects the creation of scheduled tasks by user accounts via the "schtasks" utility."
    author = "Florian Roth (Nextron Systems)"
    severity = "LOW"

  events:
    (($e.target.process.file.full_path = /.*\\schtasks.exe$/ nocase and $e.target.process.command_line = /.* /create .*/ nocase) and not((($e.target.user.userid = /.*AUTHORI.*/ nocase or $e.target.user.userid = /.*AUTORI.*/ nocase))) and not((($e.principal.process.file.full_path = "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe" or $e.principal.process.file.full_path = "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe") and ($e.target.process.file.full_path = "C:\\Windows\\System32\\schtasks.exe" or $e.target.process.file.full_path = "C:\\Windows\\SysWOW64\\schtasks.exe") and $e.target.process.command_line = /.*Microsoft\\Office\\Office Performance Monitor.*/ nocase)))

  condition:
    $e
}
