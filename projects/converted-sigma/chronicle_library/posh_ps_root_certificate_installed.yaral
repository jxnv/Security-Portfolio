// Title: Root Certificate Installed - PowerShell
// ID: 42821614-9264-4761-acfc-5772c3286f76
// Status: test
// Level: medium
// Author: oscd.community, @redcanary, Zach Stanford @svch0st
// Date: 2020-10-10
// Tags: attack.defense-impairment, attack.t1553.004
// Description: Adversaries may install a root certificate on a compromised system to avoid warnings when connecting to adversary controlled web servers.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 42821614_9264_4761_acfc_5772c3286f76 {
  meta:
    title = "Root Certificate Installed - PowerShell"
    description = "Adversaries may install a root certificate on a compromised system to avoid warnings when connecting to adversary controlled web servers."
    author = "oscd.community, @redcanary, Zach Stanford @svch0st"
    severity = "MEDIUM"

  events:
    ((($e.ScriptBlockText = /.*Move-Item.*/ nocase and $e.ScriptBlockText = /.*Cert:\\LocalMachine\\Root.*/ nocase)) or (($e.ScriptBlockText = /.*Import-Certificate.*/ nocase and $e.ScriptBlockText = /.*Cert:\\LocalMachine\\Root.*/ nocase)))

  condition:
    $e
}
