// Title: Potential PowerShell Obfuscation Using Character Join
// ID: e8314f79-564d-4f79-bc13-fbc0bf2660d8
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-09
// Tags: attack.execution, attack.stealth, attack.t1027, attack.t1059.001
// Description: Detects specific techniques often seen used inside of PowerShell scripts to obfscuate Alias creation
// Converted by: Sigma Universal SIEM/EDR CLI

rule e8314f79_564d_4f79_bc13_fbc0bf2660d8 {
  meta:
    title = "Potential PowerShell Obfuscation Using Character Join"
    description = "Detects specific techniques often seen used inside of PowerShell scripts to obfscuate Alias creation"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "LOW"

  events:
    (($e.ScriptBlockText = /.*-Alias.*/ nocase and $e.ScriptBlockText = /.* -Value (-join(.*/ nocase))

  condition:
    $e
}
