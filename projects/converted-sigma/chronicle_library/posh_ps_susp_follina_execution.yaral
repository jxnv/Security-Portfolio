// Title: Troubleshooting Pack Cmdlet Execution
// ID: 03409c93-a7c7-49ba-9a4c-a00badf2a153
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-21
// Tags: attack.stealth, attack.t1202
// Description: Detects execution of "TroubleshootingPack" cmdlets to leverage CVE-2022-30190 or action similar to "msdt" lolbin (as described in LOLBAS)
// Converted by: Sigma Universal SIEM/EDR CLI

rule 03409c93_a7c7_49ba_9a4c_a00badf2a153 {
  meta:
    title = "Troubleshooting Pack Cmdlet Execution"
    description = "Detects execution of "TroubleshootingPack" cmdlets to leverage CVE-2022-30190 or action similar to "msdt" lolbin (as described in LOLBAS)"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.ScriptBlockText = /.*Invoke-TroubleshootingPack.*/ nocase and $e.ScriptBlockText = /.*C:\\Windows\\Diagnostics\\System\\PCW.*/ nocase and $e.ScriptBlockText = /.*-AnswerFile.*/ nocase and $e.ScriptBlockText = /.*-Unattended.*/ nocase))

  condition:
    $e
}
