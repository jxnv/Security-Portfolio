// Title: Suspicious SYSTEM User Process Creation
// ID: 2617e7ed-adb7-40ba-b0f3-8f9945fe6c09
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), David ANDRE (additional keywords)
// Date: 2021-12-20
// Tags: attack.credential-access, attack.privilege-escalation, attack.stealth, attack.t1134, attack.t1003, attack.t1027
// Description: Detects a suspicious process creation as SYSTEM user (suspicious program or command line parameter)
// Converted by: Sigma Universal SIEM/EDR CLI

rule 2617e7ed_adb7_40ba_b0f3_8f9945fe6c09 {
  meta:
    title = "Suspicious SYSTEM User Process Creation"
    description = "Detects a suspicious process creation as SYSTEM user (suspicious program or command line parameter)"
    author = "Florian Roth (Nextron Systems), David ANDRE (additional keywords)"
    severity = "HIGH"

  events:
    (((($e.IntegrityLevel = "System" or $e.IntegrityLevel = "S-1-16-16384") and ($e.target.user.userid = /.*AUTHORI.*/ nocase or $e.target.user.userid = /.*AUTORI.*/ nocase)) and ((($e.target.process.file.full_path = /.*\\calc.exe$/ nocase or $e.target.process.file.full_path = /.*\\cscript.exe$/ nocase or $e.target.process.file.full_path = /.*\\forfiles.exe$/ nocase or $e.target.process.file.full_path = /.*\\hh.exe$/ nocase or $e.target.process.file.full_path = /.*\\mshta.exe$/ nocase or $e.target.process.file.full_path = /.*\\ping.exe$/ nocase or $e.target.process.file.full_path = /.*\\wscript.exe$/ nocase)) or ($e.target.process.command_line = /net\s+user\s+/ nocase) or (($e.target.process.command_line = /.* -NoP .*/ nocase or $e.target.process.command_line = /.* -W Hidden .*/ nocase or $e.target.process.command_line = /.* -decode .*/ nocase or $e.target.process.command_line = /.* /decode .*/ nocase or $e.target.process.command_line = /.* /urlcache .*/ nocase or $e.target.process.command_line = /.* -urlcache .*/ nocase or $e.target.process.command_line = /.* -e* JAB.*/ nocase or $e.target.process.command_line = /.* -e* SUVYI.*/ nocase or $e.target.process.command_line = /.* -e* SQBFAFgA.*/ nocase or $e.target.process.command_line = /.* -e* aWV4I.*/ nocase or $e.target.process.command_line = /.* -e* IAB.*/ nocase or $e.target.process.command_line = /.* -e* PAA.*/ nocase or $e.target.process.command_line = /.* -e* aQBlAHgA.*/ nocase or $e.target.process.command_line = /.*vssadmin delete shadows.*/ nocase or $e.target.process.command_line = /.*reg SAVE HKLM.*/ nocase or $e.target.process.command_line = /.* -ma .*/ nocase or $e.target.process.command_line = /.*Microsoft\\Windows\\CurrentVersion\\Run.*/ nocase or $e.target.process.command_line = /.*.downloadstring(.*/ nocase or $e.target.process.command_line = /.*.downloadfile(.*/ nocase or $e.target.process.command_line = /.* /ticket:.*/ nocase or $e.target.process.command_line = /.*dpapi::.*/ nocase or $e.target.process.command_line = /.*event::clear.*/ nocase or $e.target.process.command_line = /.*event::drop.*/ nocase or $e.target.process.command_line = /.*id::modify.*/ nocase or $e.target.process.command_line = /.*kerberos::.*/ nocase or $e.target.process.command_line = /.*lsadump::.*/ nocase or $e.target.process.command_line = /.*misc::.*/ nocase or $e.target.process.command_line = /.*privilege::.*/ nocase or $e.target.process.command_line = /.*rpc::.*/ nocase or $e.target.process.command_line = /.*sekurlsa::.*/ nocase or $e.target.process.command_line = /.*sid::.*/ nocase or $e.target.process.command_line = /.*token::.*/ nocase or $e.target.process.command_line = /.*vault::cred.*/ nocase or $e.target.process.command_line = /.*vault::list.*/ nocase or $e.target.process.command_line = /.* p::d .*/ nocase or $e.target.process.command_line = /.*;iex(.*/ nocase or $e.target.process.command_line = /.*MiniDump.*/ nocase)))) and not((($e.principal.process.file.full_path = /.*:\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\.*/ nocase) or (($e.principal.process.file.full_path = /.*:\\Program Files (x86)\\Java\\.*/ nocase or $e.principal.process.file.full_path = /.*:\\Program Files\\Java\\.*/ nocase) and $e.principal.process.file.full_path = /.*\\bin\\javaws.exe$/ nocase and ($e.target.process.file.full_path = /.*:\\Program Files (x86)\\Java\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Program Files\\Java\\.*/ nocase) and $e.target.process.file.full_path = /.*\\bin\\jp2launcher.exe$/ nocase and $e.target.process.command_line = /.* -ma .*/ nocase) or (($e.target.process.command_line = /.*ping.*/ nocase and $e.target.process.command_line = /.*127.0.0.1.*/ nocase and $e.target.process.command_line = /.* -n .*/ nocase)) or ($e.target.process.file.full_path = /.*\\PING.EXE$/ nocase and $e.principal.process.command_line = /.*\\DismFoDInstall.cmd.*/ nocase))))

  condition:
    $e
}
