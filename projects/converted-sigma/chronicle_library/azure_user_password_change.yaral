rule 340ee172_4b67_4fb4_832f_f961bdc1f3aa {
  meta:
    title = "Password Reset By User Account"
    description = "Detect when a user has reset their password in Azure AD"
    author = "YochanaHenderson, '@Yochana-H'"
    severity = "MEDIUM"

  events:
    (($e.Category = "UserManagement" and $e.Status = "Success" and $e.Initiatedby = "UPN") and ($e.Target = /.*UPN.*/ nocase and $e.ActivityType = /.*Password reset.*/ nocase))

  condition:
    $e
}
