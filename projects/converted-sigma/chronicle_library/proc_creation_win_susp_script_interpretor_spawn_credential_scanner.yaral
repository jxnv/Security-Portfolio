// Title: Script Interpreter Spawning Credential Scanner - Windows
// ID: 0f60b28c-64dd-4e2c-9a63-5334d3e3a6e6
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-11-25
// Tags: attack.credential-access, attack.t1552, attack.collection, attack.execution, attack.t1005, attack.t1059.007
// Description: Detects a script interpreter process (like node.js or bun) spawning a known credential scanning tool (e.g., trufflehog, gitleaks).
// This behavior is indicative of an attempt to find and steal secrets, as seen in the "Shai-Hulud: The Second Coming" campaign.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 0f60b28c_64dd_4e2c_9a63_5334d3e3a6e6 {
  meta:
    title = "Script Interpreter Spawning Credential Scanner - Windows"
    description = "Detects a script interpreter process (like node.js or bun) spawning a known credential scanning tool (e.g., trufflehog, gitleaks). This behavior is indicative of an attempt to find and steal secrets, as seen in the "Shai-Hulud: The Second Coming" campaign."
    author = "Swachchhanda Shrawan Poudel (Nextron Systems)"
    severity = "HIGH"

  events:
    (((($e.target.process.file.full_path = /.*trufflehog.exe$/ nocase or $e.target.process.file.full_path = /.*gitleaks.exe$/ nocase)) or (($e.target.process.command_line = /.*trufflehog.*/ nocase or $e.target.process.command_line = /.*gitleaks.*/ nocase))) and (($e.principal.process.file.full_path = /.*\\node.exe$/ nocase or $e.principal.process.file.full_path = /.*\\bun.exe$/ nocase)))

  condition:
    $e
}
