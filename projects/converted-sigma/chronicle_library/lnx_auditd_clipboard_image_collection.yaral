// Title: Clipboard Collection of Image Data with Xclip Tool
// ID: f200dc3f-b219-425d-a17e-c38467364816
// Status: test
// Level: low
// Author: Pawel Mazur
// Date: 2021-10-01
// Tags: attack.collection, attack.t1115
// Description: Detects attempts to collect image data stored in the clipboard from users with the usage of xclip tool.
// Xclip has to be installed.
// Highly recommended using rule on servers, due to high usage of clipboard utilities on user workstations.
// Converted by: Sigma Universal SIEM/EDR CLI

rule f200dc3f_b219_425d_a17e_c38467364816 {
  meta:
    title = "Clipboard Collection of Image Data with Xclip Tool"
    description = "Detects attempts to collect image data stored in the clipboard from users with the usage of xclip tool. Xclip has to be installed. Highly recommended using rule on servers, due to high usage of clipboard utilities on user workstations."
    author = "Pawel Mazur"
    severity = "LOW"

  events:
    ($e.type = "EXECVE" and $e.a0 = "xclip" and ($e.a1 = "-selection" or $e.a1 = "-sel") and ($e.a2 = "clipboard" or $e.a2 = "clip") and $e.a3 = "-t" and $e.a4 = /^image/.*/ nocase and $e.a5 = "-o")

  condition:
    $e
}
