// Title: Renamed Powershell Under Powershell Channel
// ID: 30a8cb77-8eb3-4cfb-8e79-ad457c5a4592
// Status: test
// Level: low
// Author: Harish Segar, frack113
// Date: 2020-06-29
// Tags: attack.execution, attack.stealth, attack.t1059.001, attack.t1036.003
// Description: Detects a renamed Powershell execution, which is a common technique used to circumvent security controls and bypass detection logic that's dependent on process names and process paths.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 30a8cb77_8eb3_4cfb_8e79_ad457c5a4592 {
  meta:
    title = "Renamed Powershell Under Powershell Channel"
    description = "Detects a renamed Powershell execution, which is a common technique used to circumvent security controls and bypass detection logic that's dependent on process names and process paths."
    author = "Harish Segar, frack113"
    severity = "LOW"

  events:
    (($e.Data = /.*HostName=ConsoleHost.*/ nocase) and not((($e.Data = /HostId=[a-zA-Z0-9-]{36}\s+EngineVersion=/ nocase) or (($e.Data = /.*HostApplication=powershell.*/ nocase or $e.Data = /.*HostApplication=C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.*/ nocase or $e.Data = /.*HostApplication=C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.*/ nocase or $e.Data = /.*HostApplication=C:/Windows/System32/WindowsPowerShell/v1.0/powershell.*/ nocase or $e.Data = /.*HostApplication=C:/Windows/SysWOW64/WindowsPowerShell/v1.0/powershell.*/ nocase or $e.Data = /.*HostApplication=C:\\\\\\\\WINDOWS\\\\\\\\system32\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\powershell.exe.*/ nocase or $e.Data = /.*HostApplication=C:\\\\\\\\WINDOWS\\\\\\\\SysWOW64\\\\\\\\WindowsPowerShell\\\\\\\\v1.0\\\\\\\\powershell.exe.*/ nocase)))))

  condition:
    $e
}
