// Title: Potential Command Line Path Traversal Evasion Attempt
// ID: 1327381e-6ab0-4f38-b583-4c1b8346a56b
// Status: test
// Level: medium
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-10-26
// Tags: attack.stealth, attack.t1036
// Description: Detects potential evasion or obfuscation attempts using bogus path traversal via the commandline
// Converted by: Sigma Universal SIEM/EDR CLI

rule 1327381e_6ab0_4f38_b583_4c1b8346a56b {
  meta:
    title = "Potential Command Line Path Traversal Evasion Attempt"
    description = "Detects potential evasion or obfuscation attempts using bogus path traversal via the commandline"
    author = "Christian Burkard (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.file.full_path = /.*\\Windows\\.*/ nocase and ($e.target.process.command_line = /.*\\..\\Windows\\.*/ nocase or $e.target.process.command_line = /.*\\..\\System32\\.*/ nocase or $e.target.process.command_line = /.*\\..\\..\\.*/ nocase)) or ($e.target.process.command_line = /.*.exe\\..\\.*/ nocase)) and not((($e.target.process.command_line = /.*\\Citrix\\Virtual Smart Card\\Citrix.Authentication.VirtualSmartcard.Launcher.exe\\..\\.*/ nocase) or ($e.target.process.command_line = /.*\\Google\\Drive\\googledrivesync.exe\\..\\.*/ nocase))))

  condition:
    $e
}
