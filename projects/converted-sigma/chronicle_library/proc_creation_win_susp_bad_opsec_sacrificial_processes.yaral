// Title: Bad Opsec Defaults Sacrificial Processes With Improper Arguments
// ID: a7c3d773-caef-227e-a7e7-c2f13c622329
// Status: test
// Level: high
// Author: Oleg Kolesnikov @securonix invrep_de, oscd.community, Florian Roth (Nextron Systems), Christian Burkard (Nextron Systems)
// Date: 2020-10-23
// Tags: attack.stealth, attack.t1218.011
// Description: Detects attackers using tooling with bad opsec defaults.
// E.g. spawning a sacrificial process to inject a capability into the process without taking into account how the process is normally run.
// One trivial example of this is using rundll32.exe without arguments as a sacrificial process (default in CS, now highlighted by c2lint), running WerFault without arguments (Kraken - credit am0nsec), and other examples.
// Converted by: Sigma Universal SIEM/EDR CLI

rule a7c3d773_caef_227e_a7e7_c2f13c622329 {
  meta:
    title = "Bad Opsec Defaults Sacrificial Processes With Improper Arguments"
    description = "Detects attackers using tooling with bad opsec defaults. E.g. spawning a sacrificial process to inject a capability into the process without taking into account how the process is normally run. One trivial example of this is using rundll32.exe without arguments as a sacrificial process (default in CS, now highlighted by c2lint), running WerFault without arguments (Kraken - credit am0nsec), and other examples."
    author = "Oleg Kolesnikov @securonix invrep_de, oscd.community, Florian Roth (Nextron Systems), Christian Burkard (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.file.full_path = /.*\\regasm.exe$/ nocase and $e.target.process.command_line = /.*regasm.exe$/ nocase) or ($e.target.process.file.full_path = /.*\\regsvcs.exe$/ nocase and $e.target.process.command_line = /.*regsvcs.exe$/ nocase) or ($e.target.process.file.full_path = /.*\\regsvr32.exe$/ nocase and $e.target.process.command_line = /.*regsvr32.exe$/ nocase) or ($e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase and $e.target.process.command_line = /.*rundll32.exe$/ nocase) or ($e.target.process.file.full_path = /.*\\WerFault.exe$/ nocase and $e.target.process.command_line = /.*WerFault.exe$/ nocase)) and not(((($e.principal.process.file.full_path = /.*\\AppData\\Local\\BraveSoftware\\Brave-Browser\\Application\\.*/ nocase or $e.principal.process.file.full_path = /.*\\AppData\\Local\\Google\\Chrome\\Application\\.*/ nocase) and $e.principal.process.file.full_path = /.*\\Installer\\setup.exe$/ nocase and $e.principal.process.command_line = /.*--uninstall .*/ nocase and $e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase and $e.target.process.command_line = /.*rundll32.exe$/ nocase) or ($e.principal.process.file.full_path = /.*\\AppData\\Local\\Microsoft\\EdgeUpdate\\Install\\{.*/ nocase and $e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase and $e.target.process.command_line = /.*rundll32.exe$/ nocase))))

  condition:
    $e
}
