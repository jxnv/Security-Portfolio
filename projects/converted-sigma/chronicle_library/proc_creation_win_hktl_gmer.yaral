rule 9082ff1f_88ab_4678_a3cc_5bcff99fc74d {
  meta:
    title = "HackTool - GMER Rootkit Detector and Remover Execution"
    description = "Detects the execution GMER tool based on image and hash fields."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.file.full_path = /.*\\gmer.exe$/ nocase) or (($e.Hashes = /.*MD5=E9DC058440D321AA17D0600B3CA0AB04.*/ nocase or $e.Hashes = /.*SHA1=539C228B6B332F5AA523E5CE358C16647D8BBE57.*/ nocase or $e.Hashes = /.*SHA256=E8A3E804A96C716A3E9B69195DB6FFB0D33E2433AF871E4D4E1EAB3097237173.*/ nocase)))

  condition:
    $e
}
