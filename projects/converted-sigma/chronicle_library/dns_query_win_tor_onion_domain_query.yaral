// Title: DNS Query Tor .Onion Address - Sysmon
// ID: b55ca2a3-7cff-4dda-8bdd-c7bfa63bf544
// Status: test
// Level: high
// Author: frack113
// Date: 2022-02-20
// Tags: attack.command-and-control, attack.t1090.003
// Description: Detects DNS queries to an ".onion" address related to Tor routing networks
// Converted by: Sigma Universal SIEM/EDR CLI

rule b55ca2a3_7cff_4dda_8bdd_c7bfa63bf544 {
  meta:
    title = "DNS Query Tor .Onion Address - Sysmon"
    description = "Detects DNS queries to an ".onion" address related to Tor routing networks"
    author = "frack113"
    severity = "HIGH"

  events:
    (($e.QueryName = /.*.hiddenservice.net$/ nocase or $e.QueryName = /.*.onion.ca$/ nocase or $e.QueryName = /.*.onion.cab$/ nocase or $e.QueryName = /.*.onion.casa$/ nocase or $e.QueryName = /.*.onion.city$/ nocase or $e.QueryName = /.*.onion.direct$/ nocase or $e.QueryName = /.*.onion.dog$/ nocase or $e.QueryName = /.*.onion.glass$/ nocase or $e.QueryName = /.*.onion.gq$/ nocase or $e.QueryName = /.*.onion.ink$/ nocase or $e.QueryName = /.*.onion.it$/ nocase or $e.QueryName = /.*.onion.link$/ nocase or $e.QueryName = /.*.onion.lt$/ nocase or $e.QueryName = /.*.onion.lu$/ nocase or $e.QueryName = /.*.onion.nu$/ nocase or $e.QueryName = /.*.onion.pet$/ nocase or $e.QueryName = /.*.onion.plus$/ nocase or $e.QueryName = /.*.onion.rip$/ nocase or $e.QueryName = /.*.onion.sh$/ nocase or $e.QueryName = /.*.onion.to$/ nocase or $e.QueryName = /.*.onion.top$/ nocase or $e.QueryName = /.*.onion$/ nocase or $e.QueryName = /.*.s1.tor-gateways.de$/ nocase or $e.QueryName = /.*.s2.tor-gateways.de$/ nocase or $e.QueryName = /.*.s3.tor-gateways.de$/ nocase or $e.QueryName = /.*.s4.tor-gateways.de$/ nocase or $e.QueryName = /.*.s5.tor-gateways.de$/ nocase or $e.QueryName = /.*.t2w.pw$/ nocase or $e.QueryName = /.*.tor2web.ae.org$/ nocase or $e.QueryName = /.*.tor2web.blutmagie.de$/ nocase or $e.QueryName = /.*.tor2web.com$/ nocase or $e.QueryName = /.*.tor2web.fi$/ nocase or $e.QueryName = /.*.tor2web.io$/ nocase or $e.QueryName = /.*.tor2web.org$/ nocase or $e.QueryName = /.*.tor2web.xyz$/ nocase or $e.QueryName = /.*.torlink.co$/ nocase))

  condition:
    $e
}
