// Title: MacOS Emond Launch Daemon
// ID: 23c43900-e732-45a4-8354-63e4a6c187ce
// Status: test
// Level: medium
// Author: Alejandro Ortuno, oscd.community
// Date: 2020-10-23
// Tags: attack.persistence, attack.privilege-escalation, attack.t1546.014
// Description: Detects additions to the Emond Launch Daemon that adversaries may use to gain persistence and elevate privileges.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 23c43900_e732_45a4_8354_63e4a6c187ce {
  meta:
    title = "MacOS Emond Launch Daemon"
    description = "Detects additions to the Emond Launch Daemon that adversaries may use to gain persistence and elevate privileges."
    author = "Alejandro Ortuno, oscd.community"
    severity = "MEDIUM"

  events:
    (($e.target.file.full_path = /.*/etc/emond.d/rules/.*/ nocase and $e.target.file.full_path = /.*.plist$/ nocase) or ($e.target.file.full_path = /.*/private/var/db/emondClients/.*/ nocase))

  condition:
    $e
}
