rule 2111118f_7e46_4fc8_974a_59fd8ec95196 {
  meta:
    title = "DiagTrackEoP Default Login Username"
    description = "Detects the default "UserName" used by the DiagTrackEoP POC"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "CRITICAL"

  events:
    ($e.EventID = 4624 and $e.LogonType = 9 and $e.TargetOutboundUserName = "thisisnotvaliduser")

  condition:
    $e
}
