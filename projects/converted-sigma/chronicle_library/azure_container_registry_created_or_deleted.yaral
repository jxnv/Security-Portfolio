rule 93e0ef48_37c8_49ed_a02c_038aab23628e {
  meta:
    title = "Azure Container Registry Created or Deleted"
    description = "Detects when a Container Registry is created or deleted."
    author = "Austin Songer @austinsonger"
    severity = "LOW"

  events:
    (($e.operationName = "MICROSOFT.CONTAINERREGISTRY/REGISTRIES/WRITE" or $e.operationName = "MICROSOFT.CONTAINERREGISTRY/REGISTRIES/DELETE"))

  condition:
    $e
}
