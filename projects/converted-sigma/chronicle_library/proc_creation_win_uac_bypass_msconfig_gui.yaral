// Title: UAC Bypass Using MSConfig Token Modification - Process
// ID: ad92e3f9-7eb6-460e-96b1-582b0ccbb980
// Status: test
// Level: high
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-08-30
// Tags: attack.privilege-escalation, attack.t1548.002
// Description: Detects the pattern of UAC Bypass using a msconfig GUI hack (UACMe 55)
// Converted by: Sigma Universal SIEM/EDR CLI

rule ad92e3f9_7eb6_460e_96b1_582b0ccbb980 {
  meta:
    title = "UAC Bypass Using MSConfig Token Modification - Process"
    description = "Detects the pattern of UAC Bypass using a msconfig GUI hack (UACMe 55)"
    author = "Christian Burkard (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.IntegrityLevel = "High" or $e.IntegrityLevel = "System" or $e.IntegrityLevel = "S-1-16-16384" or $e.IntegrityLevel = "S-1-16-12288") and $e.principal.process.file.full_path = /.*\\AppData\\Local\\Temp\\pkgmgr.exe$/ nocase and $e.target.process.command_line = "\"C:\\Windows\\system32\\msconfig.exe\" -5")

  condition:
    $e
}
