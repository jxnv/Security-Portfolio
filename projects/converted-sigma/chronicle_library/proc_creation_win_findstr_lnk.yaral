// Title: Findstr Launching .lnk File
// ID: 33339be3-148b-4e16-af56-ad16ec6c7e7b
// Status: test
// Level: medium
// Author: Trent Liffick
// Date: 2020-05-01
// Tags: attack.stealth, attack.t1036, attack.t1202, attack.t1027.003
// Description: Detects usage of findstr to identify and execute a lnk file as seen within the HHS redirect attack
// Converted by: Sigma Universal SIEM/EDR CLI

rule 33339be3_148b_4e16_af56_ad16ec6c7e7b {
  meta:
    title = "Findstr Launching .lnk File"
    description = "Detects usage of findstr to identify and execute a lnk file as seen within the HHS redirect attack"
    author = "Trent Liffick"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*.lnk$/ nocase or $e.target.process.command_line = /.*.lnk\"$/ nocase or $e.target.process.command_line = /.*.lnk'$/ nocase)) and ((($e.target.process.file.full_path = /.*\\find.exe$/ nocase or $e.target.process.file.full_path = /.*\\findstr.exe$/ nocase)) or (($e.target.process.file.name = "FIND.EXE" or $e.target.process.file.name = "FINDSTR.EXE"))))

  condition:
    $e
}
