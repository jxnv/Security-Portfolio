// Tags: attack.stealth, attack.t1027.003
// Description: Detects appending of zip file to image
// Converted by: Sigma Universal SIEM/EDR CLI

rule 45810b50_7edc_42ca_813b_bdac02fb946b {
  meta:
    title = "Steganography Hide Zip Information in Picture File"
    description = "Detects appending of zip file to image"
    author = "Pawel Mazur"
    severity = "LOW"

  events:
    (($e.type = "EXECVE" and $e.a0 = "cat") and (($e.a1 = /.*.jpg$/ nocase or $e.a1 = /.*.png$/ nocase)) and ($e.a2 = /.*.zip$/ nocase))

  condition:
    $e
}
