// Title: Use Short Name Path in Image
// ID: a96970af-f126-420d-90e1-d37bf25e50e1
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali
// Date: 2022-08-07
// Tags: attack.stealth, attack.t1564.004
// Description: Detect use of the Windows 8.3 short name. Which could be used as a method to avoid Image detection
// Converted by: Sigma Universal SIEM/EDR CLI

rule a96970af_f126_420d_90e1_d37bf25e50e1 {
  meta:
    title = "Use Short Name Path in Image"
    description = "Detect use of the Windows 8.3 short name. Which could be used as a method to avoid Image detection"
    author = "frack113, Nasreddine Bencherchali"
    severity = "MEDIUM"

  events:
    ((($e.target.process.file.full_path = /.*~1\\.*/ nocase or $e.target.process.file.full_path = /.*~2\\.*/ nocase)) and not((((($e.target.process.file.full_path = /.*\\AppData\\.*/ nocase and $e.target.process.file.full_path = /.*\\Temp\\.*/ nocase)) or (($e.target.process.file.full_path = /.*~1\\unzip.exe$/ nocase or $e.target.process.file.full_path = /.*~1\\7zG.exe$/ nocase))) or (($e.principal.process.file.full_path = "C:\\Windows\\System32\\Dism.exe" or $e.principal.process.file.full_path = "C:\\Windows\\System32\\cleanmgr.exe")))) and not(((($e.Product = "InstallShield (R)") or ($e.Description = "InstallShield (R) Setup Engine") or ($e.Company = "InstallShield Software Corporation")) or ($e.principal.process.file.full_path = /.*\\thor\\thor64.exe$/ nocase) or ($e.principal.process.file.full_path = /.*\\WebEx\\WebexHost.exe$/ nocase))))

  condition:
    $e
}
