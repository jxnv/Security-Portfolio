rule 7eedcc9d_9fdb_4d94_9c54_474e8affc0c7 {
  meta:
    title = "Invoke-Obfuscation COMPRESS OBFUSCATION"
    description = "Detects Obfuscated Powershell via COMPRESS OBFUSCATION"
    author = "Timur Zinniatullin, oscd.community"
    severity = "MEDIUM"

  events:
    (($e.target.process.command_line = /.*new-object.*/ nocase and $e.target.process.command_line = /.*text.encoding]::ascii.*/ nocase) and ($e.target.process.command_line = /.*system.io.compression.deflatestream.*/ nocase or $e.target.process.command_line = /.*system.io.streamreader.*/ nocase or $e.target.process.command_line = /.*readtoend(.*/ nocase))

  condition:
    $e
}
