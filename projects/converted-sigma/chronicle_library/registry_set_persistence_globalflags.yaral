// Title: Potential Persistence Via GlobalFlags
// ID: 36803969-5421-41ec-b92f-8500f79c23b0
// Status: test
// Level: high
// Author: Karneades, Jonhnathan Ribeiro, Florian Roth
// Date: 2018-04-11
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.012, car.2013-01-002
// Description: Detects registry persistence technique using the GlobalFlags and SilentProcessExit keys
// Converted by: Sigma Universal SIEM/EDR CLI

rule 36803969_5421_41ec_b92f_8500f79c23b0 {
  meta:
    title = "Potential Persistence Via GlobalFlags"
    description = "Detects registry persistence technique using the GlobalFlags and SilentProcessExit keys"
    author = "Karneades, Jonhnathan Ribeiro, Florian Roth"
    severity = "HIGH"

  events:
    ((($e.TargetObject = /.*\\Microsoft\\Windows NT\\CurrentVersion\\.*/ nocase and $e.TargetObject = /.*\\Image File Execution Options\\.*/ nocase and $e.TargetObject = /.*\\GlobalFlag.*/ nocase)) or (($e.TargetObject = /.*\\Microsoft\\Windows NT\\CurrentVersion\\.*/ nocase and $e.TargetObject = /.*\\SilentProcessExit\\.*/ nocase) and ($e.TargetObject = /.*\\ReportingMode.*/ nocase or $e.TargetObject = /.*\\MonitorProcess.*/ nocase)))

  condition:
    $e
}
