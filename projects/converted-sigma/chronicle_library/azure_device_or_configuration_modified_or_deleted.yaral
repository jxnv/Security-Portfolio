// Description: Identifies when a device or device configuration in azure is modified or deleted.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 46530378_f9db_4af9_a9e5_889c177d3881 {
  meta:
    title = "Azure Device or Configuration Modified or Deleted"
    description = "Identifies when a device or device configuration in azure is modified or deleted."
    author = "Austin Songer @austinsonger"
    severity = "MEDIUM"

  events:
    (($e.properties.message = "Delete device" or $e.properties.message = "Delete device configuration" or $e.properties.message = "Update device" or $e.properties.message = "Update device configuration"))

  condition:
    $e
}
