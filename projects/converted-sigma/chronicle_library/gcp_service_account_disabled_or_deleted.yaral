rule 13f81a90_a69c_4fab_8f07_b5bb55416a9f {
  meta:
    title = "Google Cloud Service Account Disabled or Deleted"
    description = "Identifies when a service account is disabled or deleted in Google Cloud."
    author = "Austin Songer @austinsonger"
    severity = "MEDIUM"

  events:
    (($e.gcp.audit.method_name = /.*.serviceAccounts.disable$/ nocase or $e.gcp.audit.method_name = /.*.serviceAccounts.delete$/ nocase))

  condition:
    $e
}
