// Title: Bypass UAC via CMSTP
// ID: e66779cc-383e-4224-a3a4-267eeb585c40
// Status: test
// Level: high
// Author: E.M. Anhaus (originally from Atomic Blue Detections, Endgame), oscd.community
// Date: 2019-10-24
// Tags: attack.privilege-escalation, attack.stealth, attack.t1548.002, attack.t1218.003
// Description: Detect commandline usage of Microsoft Connection Manager Profile Installer (cmstp.exe) to install specially formatted local .INF files
// Converted by: Sigma Universal SIEM/EDR CLI

rule e66779cc_383e_4224_a3a4_267eeb585c40 {
  meta:
    title = "Bypass UAC via CMSTP"
    description = "Detect commandline usage of Microsoft Connection Manager Profile Installer (cmstp.exe) to install specially formatted local .INF files"
    author = "E.M. Anhaus (originally from Atomic Blue Detections, Endgame), oscd.community"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*/s.*/ nocase or $e.target.process.command_line = /.*-s.*/ nocase or $e.target.process.command_line = /.*/au.*/ nocase or $e.target.process.command_line = /.*-au.*/ nocase or $e.target.process.command_line = /.*/ni.*/ nocase or $e.target.process.command_line = /.*-ni.*/ nocase)) and (($e.target.process.file.full_path = /.*\\cmstp.exe$/ nocase) or ($e.target.process.file.name = "CMSTP.EXE")))

  condition:
    $e
}
