// Title: 7Zip Compressing Dump Files
// ID: ec570e53-4c76-45a9-804d-dc3f355ff7a7
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-27
// Tags: attack.collection, attack.t1560.001
// Description: Detects execution of 7z in order to compress a file with a ".dmp"/".dump" extension, which could be a step in a process of dump file exfiltration.
// Converted by: Sigma Universal SIEM/EDR CLI

rule ec570e53_4c76_45a9_804d_dc3f355ff7a7 {
  meta:
    title = "7Zip Compressing Dump Files"
    description = "Detects execution of 7z in order to compress a file with a ".dmp"/".dump" extension, which could be a step in a process of dump file exfiltration."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*.dmp.*/ nocase or $e.target.process.command_line = /.*.dump.*/ nocase or $e.target.process.command_line = /.*.hdmp.*/ nocase)) and (($e.Description = /.*7-Zip.*/ nocase) or (($e.target.process.file.full_path = /.*\\7z.exe$/ nocase or $e.target.process.file.full_path = /.*\\7zr.exe$/ nocase or $e.target.process.file.full_path = /.*\\7za.exe$/ nocase)) or (($e.target.process.file.name = "7z.exe" or $e.target.process.file.name = "7za.exe" or $e.target.process.file.name = "7zr.exe"))))

  condition:
    $e
}
