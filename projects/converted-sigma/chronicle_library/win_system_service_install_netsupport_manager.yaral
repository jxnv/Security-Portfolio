// Title: NetSupport Manager Service Install
// ID: 2d510d8d-912b-45c5-b1df-36faa3d8c3f4
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-31
// Tags: attack.persistence
// Description: Detects NetSupport Manager service installation on the target system.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 2d510d8d_912b_45c5_b1df_36faa3d8c3f4 {
  meta:
    title = "NetSupport Manager Service Install"
    description = "Detects NetSupport Manager service installation on the target system."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.Provider_Name = "Service Control Manager" and $e.EventID = 7045) and (($e.ImagePath = /.*\\NetSupport Manager\\client32.exe.*/ nocase) or ($e.ServiceName = "Client32")))

  condition:
    $e
}
