// Title: Remote PowerShell Session Host Process (WinRM)
// ID: 734f8d9b-42b8-41b2-bcf5-abaf49d5a3c8
// Status: test
// Level: medium
// Author: Roberto Rodriguez @Cyb3rWard0g
// Date: 2019-09-12
// Tags: attack.execution, attack.lateral-movement, attack.t1059.001, attack.t1021.006
// Description: Detects remote PowerShell sections by monitoring for wsmprovhost (WinRM host process) as a parent or child process (sign of an active PowerShell remote session).
// Converted by: Sigma Universal SIEM/EDR CLI

rule 734f8d9b_42b8_41b2_bcf5_abaf49d5a3c8 {
  meta:
    title = "Remote PowerShell Session Host Process (WinRM)"
    description = "Detects remote PowerShell sections by monitoring for wsmprovhost (WinRM host process) as a parent or child process (sign of an active PowerShell remote session)."
    author = "Roberto Rodriguez @Cyb3rWard0g"
    severity = "MEDIUM"

  events:
    (($e.target.process.file.full_path = /.*\\wsmprovhost.exe$/ nocase) or ($e.principal.process.file.full_path = /.*\\wsmprovhost.exe$/ nocase))

  condition:
    $e
}
