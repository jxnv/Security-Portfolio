// Title: RunDLL32 Spawning Explorer
// ID: caa06de8-fdef-4c91-826a-7f9e163eef4b
// Status: test
// Level: high
// Author: elhoim, CD_ROM_
// Date: 2022-04-27
// Tags: attack.stealth, attack.t1218.011
// Description: Detects RunDLL32.exe spawning explorer.exe as child, which is very uncommon, often observes Gamarue spawning the explorer.exe process in an unusual way
// Converted by: Sigma Universal SIEM/EDR CLI

rule caa06de8_fdef_4c91_826a_7f9e163eef4b {
  meta:
    title = "RunDLL32 Spawning Explorer"
    description = "Detects RunDLL32.exe spawning explorer.exe as child, which is very uncommon, often observes Gamarue spawning the explorer.exe process in an unusual way"
    author = "elhoim, CD_ROM_"
    severity = "HIGH"

  events:
    (($e.principal.process.file.full_path = /.*\\rundll32.exe$/ nocase and $e.target.process.file.full_path = /.*\\explorer.exe$/ nocase) and not(($e.principal.process.command_line = /.*\\shell32.dll,Control_RunDLL.*/ nocase)))

  condition:
    $e
}
