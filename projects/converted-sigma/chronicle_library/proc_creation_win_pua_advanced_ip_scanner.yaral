// Title: PUA - Advanced IP Scanner Execution
// ID: bef37fa2-f205-4a7b-b484-0759bfd5f86f
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), @ROxPinTeddy
// Date: 2020-05-12
// Tags: attack.discovery, attack.t1046, attack.t1135
// Description: Detects the use of Advanced IP Scanner. Seems to be a popular tool for ransomware groups.
// Converted by: Sigma Universal SIEM/EDR CLI

rule bef37fa2_f205_4a7b_b484_0759bfd5f86f {
  meta:
    title = "PUA - Advanced IP Scanner Execution"
    description = "Detects the use of Advanced IP Scanner. Seems to be a popular tool for ransomware groups."
    author = "Nasreddine Bencherchali (Nextron Systems), @ROxPinTeddy"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*/portable.*/ nocase and $e.target.process.command_line = /.*/lng.*/ nocase)) or (($e.target.process.file.full_path = /.*\\advanced_ip_scanner.*/ nocase) or ($e.target.process.file.name = /.*advanced_ip_scanner.*/ nocase) or ($e.Description = /.*Advanced IP Scanner.*/ nocase)))

  condition:
    $e
}
