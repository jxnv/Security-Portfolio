// Title: Suspicious Schtasks Schedule Types
// ID: 24c8392b-aa3c-46b7-a545-43f71657fe98
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects scheduled task creations or modification on a suspicious schedule type
// Converted by: Sigma Universal SIEM/EDR CLI

rule 24c8392b_aa3c_46b7_a545_43f71657fe98 {
  meta:
    title = "Suspicious Schtasks Schedule Types"
    description = "Detects scheduled task creations or modification on a suspicious schedule type"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    (((($e.target.process.file.full_path = /.*\\schtasks.exe$/ nocase) or ($e.target.process.file.name = "schtasks.exe")) and (($e.target.process.command_line = /.* ONLOGON .*/ nocase or $e.target.process.command_line = /.* ONSTART .*/ nocase or $e.target.process.command_line = /.* ONCE .*/ nocase or $e.target.process.command_line = /.* ONIDLE .*/ nocase))) and not((($e.target.process.command_line = /.*NT AUT.*/ nocase or $e.target.process.command_line = /.* SYSTEM.*/ nocase or $e.target.process.command_line = /.*HIGHEST.*/ nocase))))

  condition:
    $e
}
