// Title: Potentially Suspicious Windows App Activity
// ID: f91ed517-a6ba-471d-9910-b3b4a398c0f3
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-12
// Tags: attack.stealth
// Description: Detects potentially suspicious child process of applications launched from inside the WindowsApps directory. This could be a sign of a rogue ".appx" package installation/execution
// Converted by: Sigma Universal SIEM/EDR CLI

rule f91ed517_a6ba_471d_9910_b3b4a398c0f3 {
  meta:
    title = "Potentially Suspicious Windows App Activity"
    description = "Detects potentially suspicious child process of applications launched from inside the WindowsApps directory. This could be a sign of a rogue ".appx" package installation/execution"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.principal.process.file.full_path = /.*C:\\Program Files\\WindowsApps\\.*/ nocase) and ((($e.target.process.command_line = /.*cmd /c.*/ nocase or $e.target.process.command_line = /.*Invoke-.*/ nocase or $e.target.process.command_line = /.*Base64.*/ nocase)) or (($e.target.process.file.full_path = /.*\\cmd.exe$/ nocase or $e.target.process.file.full_path = /.*\\cscript.exe$/ nocase or $e.target.process.file.full_path = /.*\\mshta.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell_ise.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase or $e.target.process.file.full_path = /.*\\regsvr32.exe$/ nocase or $e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase or $e.target.process.file.full_path = /.*\\wscript.exe$/ nocase))) and not((($e.principal.process.file.full_path = /^C:\\Program Files\\WindowsApps\\Microsoft.SysinternalsSuite.*/ nocase and $e.target.process.file.full_path = /.*\\cmd.exe$/ nocase) or ($e.principal.process.file.full_path = /.*:\\Program Files\\WindowsApps\\Microsoft.WindowsTerminal.*/ nocase and $e.principal.process.file.full_path = /.*\\WindowsTerminal.exe$/ nocase and ($e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\cmd.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase)))))

  condition:
    $e
}
