// Title: Program Executed Using Proxy/Local Command Via SSH.EXE
// ID: 7d6d30b8-5b91-4b90-a891-46cccaf29598
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali
// Date: 2022-12-29
// Tags: attack.stealth, attack.t1218
// Description: Detect usage of the "ssh.exe" binary as a proxy to launch other programs.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 7d6d30b8_5b91_4b90_a891_46cccaf29598 {
  meta:
    title = "Program Executed Using Proxy/Local Command Via SSH.EXE"
    description = "Detect usage of the "ssh.exe" binary as a proxy to launch other programs."
    author = "frack113, Nasreddine Bencherchali"
    severity = "MEDIUM"

  events:
    (($e.principal.process.file.full_path = "C:\\Windows\\System32\\OpenSSH\\sshd.exe") or ((($e.target.process.command_line = /.*ProxyCommand=.*/ nocase) or (($e.target.process.command_line = /.*PermitLocalCommand=yes.*/ nocase and $e.target.process.command_line = /.* LocalCommand.*/ nocase))) and (($e.target.process.file.full_path = /.*\\ssh.exe$/ nocase) or ($e.Product = "OpenSSH for Windows") or (($e.Hashes = /.*IMPHASH=55b4964d29aad5438b9e950052dbbbc0.*/ nocase or $e.Hashes = /.*IMPHASH=334d66c33503ccbf647c15b47c27eef4.*/ nocase or $e.Hashes = /.*IMPHASH=27b0da080ef92afb37983d30d839141e.*/ nocase or $e.Hashes = /.*IMPHASH=977eb4c263d384e47daa0712d34713ab.*/ nocase or $e.Hashes = /.*IMPHASH=3eaadce9ae43d5a918bb082065815c3b.*/ nocase or $e.Hashes = /.*IMPHASH=980fe6cf0d996ab1eedf877222e722aa.*/ nocase or $e.Hashes = /.*IMPHASH=5f959422308ac3d721010d66647e100e.*/ nocase or $e.Hashes = /.*IMPHASH=a49aaa3d03d1cd9c8dc7fca60f7f480b.*/ nocase or $e.Hashes = /.*IMPHASH=dd335f759b6d5d6a8382b71dd9d65791.*/ nocase)))))

  condition:
    $e
}
