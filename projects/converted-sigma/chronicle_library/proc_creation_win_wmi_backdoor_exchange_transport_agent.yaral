// Title: WMI Backdoor Exchange Transport Agent
// ID: 797011dc-44f4-4e6f-9f10-a8ceefbe566b
// Status: test
// Level: critical
// Author: Florian Roth (Nextron Systems)
// Date: 2019-10-11
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.003
// Description: Detects a WMI backdoor in Exchange Transport Agents via WMI event filters
// Converted by: Sigma Universal SIEM/EDR CLI

rule 797011dc_44f4_4e6f_9f10_a8ceefbe566b {
  meta:
    title = "WMI Backdoor Exchange Transport Agent"
    description = "Detects a WMI backdoor in Exchange Transport Agents via WMI event filters"
    author = "Florian Roth (Nextron Systems)"
    severity = "CRITICAL"

  events:
    (($e.principal.process.file.full_path = /.*\\EdgeTransport.exe$/ nocase) and not((($e.target.process.file.full_path = "C:\\Windows\\System32\\conhost.exe") or ($e.target.process.file.full_path = /^C:\\Program Files\\Microsoft\\Exchange Server\\.*/ nocase and $e.target.process.file.full_path = /.*\\Bin\\OleConverter.exe$/ nocase))))

  condition:
    $e
}
