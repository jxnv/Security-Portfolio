// Title: PDF File Created By RegEdit.EXE
// ID: 145095eb-e273-443b-83d0-f9b519b7867b
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-07-08
// Tags: attack.stealth
// Description: Detects the creation of a file with the ".pdf" extension by the "RegEdit.exe" process.
// This indicates that a user is trying to print/save a registry key as a PDF in order to potentially extract sensitive information and bypass defenses.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 145095eb_e273_443b_83d0_f9b519b7867b {
  meta:
    title = "PDF File Created By RegEdit.EXE"
    description = "Detects the creation of a file with the ".pdf" extension by the "RegEdit.exe" process. This indicates that a user is trying to print/save a registry key as a PDF in order to potentially extract sensitive information and bypass defenses."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ($e.target.process.file.full_path = /.*\\regedit.exe$/ nocase and $e.target.file.full_path = /.*.pdf$/ nocase)

  condition:
    $e
}
