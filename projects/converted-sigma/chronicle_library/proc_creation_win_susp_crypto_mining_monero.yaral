// Title: Potential Crypto Mining Activity
// ID: 66c3b204-9f88-4d0a-a7f7-8a57d521ca55
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-10-26
// Tags: attack.impact, attack.t1496
// Description: Detects command line parameters or strings often used by crypto miners
// Converted by: Sigma Universal SIEM/EDR CLI

rule 66c3b204_9f88_4d0a_a7f7_8a57d521ca55 {
  meta:
    title = "Potential Crypto Mining Activity"
    description = "Detects command line parameters or strings often used by crypto miners"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.* --cpu-priority=.*/ nocase or $e.target.process.command_line = /.*--donate-level=0.*/ nocase or $e.target.process.command_line = /.* -o pool..*/ nocase or $e.target.process.command_line = /.* --nicehash.*/ nocase or $e.target.process.command_line = /.* --algo=rx/0 .*/ nocase or $e.target.process.command_line = /.*stratum+tcp://.*/ nocase or $e.target.process.command_line = /.*stratum+udp://.*/ nocase or $e.target.process.command_line = /.*LS1kb25hdGUtbGV2ZWw9.*/ nocase or $e.target.process.command_line = /.*0tZG9uYXRlLWxldmVsP.*/ nocase or $e.target.process.command_line = /.*tLWRvbmF0ZS1sZXZlbD.*/ nocase or $e.target.process.command_line = /.*c3RyYXR1bSt0Y3A6Ly.*/ nocase or $e.target.process.command_line = /.*N0cmF0dW0rdGNwOi8v.*/ nocase or $e.target.process.command_line = /.*zdHJhdHVtK3RjcDovL.*/ nocase or $e.target.process.command_line = /.*c3RyYXR1bSt1ZHA6Ly.*/ nocase or $e.target.process.command_line = /.*N0cmF0dW0rdWRwOi8v.*/ nocase or $e.target.process.command_line = /.*zdHJhdHVtK3VkcDovL.*/ nocase)) and not((($e.target.process.command_line = /.* pool.c .*/ nocase or $e.target.process.command_line = /.* pool.o .*/ nocase or $e.target.process.command_line = /.*gcc -.*/ nocase))))

  condition:
    $e
}
