// Title: Network Reconnaissance Activity
// ID: e6313acd-208c-44fc-a0ff-db85d572e90e
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-07
// Tags: attack.discovery, attack.t1087, attack.t1082, car.2016-03-001
// Description: Detects a set of suspicious network related commands often used in recon stages
// Converted by: Sigma Universal SIEM/EDR CLI

rule e6313acd_208c_44fc_a0ff_db85d572e90e {
  meta:
    title = "Network Reconnaissance Activity"
    description = "Detects a set of suspicious network related commands often used in recon stages"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.command_line = /.*nslookup.*/ nocase and $e.target.process.command_line = /.*_ldap._tcp.dc._msdcs..*/ nocase))

  condition:
    $e
}
