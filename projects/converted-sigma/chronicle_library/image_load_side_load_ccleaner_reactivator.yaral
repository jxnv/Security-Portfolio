// Title: Potential CCleanerReactivator.DLL Sideloading
// ID: 3735d5ac-d770-4da0-99ff-156b180bc600
// Status: test
// Level: medium
// Author: X__Junior
// Date: 2023-07-13
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of "CCleanerReactivator.dll"
// Converted by: Sigma Universal SIEM/EDR CLI

rule 3735d5ac_d770_4da0_99ff_156b180bc600 {
  meta:
    title = "Potential CCleanerReactivator.DLL Sideloading"
    description = "Detects potential DLL sideloading of "CCleanerReactivator.dll""
    author = "X__Junior"
    severity = "MEDIUM"

  events:
    (($e.ImageLoaded = /.*\\CCleanerReactivator.dll$/ nocase) and not((($e.target.process.file.full_path = /^C:\\Program Files\\CCleaner\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files (x86)\\CCleaner\\.*/ nocase) and $e.target.process.file.full_path = /.*\\CCleanerReactivator.exe$/ nocase)))

  condition:
    $e
}
