// Title: Rundll32 UNC Path Execution
// ID: 5cdb711b-5740-4fb2-ba88-f7945027afac
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-10
// Tags: attack.execution, attack.lateral-movement, attack.stealth, attack.t1021.002, attack.t1218.011
// Description: Detects rundll32 execution where the DLL is located on a remote location (share).
// Threat actors can abuse the rundll32.exe binary to execute remote DLLs from a UNC pathh.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 5cdb711b_5740_4fb2_ba88_f7945027afac {
  meta:
    title = "Rundll32 UNC Path Execution"
    description = "Detects rundll32 execution where the DLL is located on a remote location (share). Threat actors can abuse the rundll32.exe binary to execute remote DLLs from a UNC pathh."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    (((($e.target.process.command_line = /.* \\\\\\\\.*/ nocase or $e.target.process.command_line = /.* '\\\\\\\\.*/ nocase or $e.target.process.command_line = /.* \"\\\\\\\\.*/ nocase)) and (($e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase) or ($e.target.process.file.name = "RUNDLL32.EXE") or ($e.target.process.command_line = /.*rundll32.*/ nocase))) and not(($e.target.process.command_line = /.*\\\\\\\\.\\\\pipe.*/ nocase)))

  condition:
    $e
}
