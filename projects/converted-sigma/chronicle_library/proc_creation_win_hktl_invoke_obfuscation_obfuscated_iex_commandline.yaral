// Title: Invoke-Obfuscation Obfuscated IEX Invocation
// ID: 4bf943c6-5146-4273-98dd-e958fd1e3abf
// Status: test
// Level: high
// Author: Daniel Bohannon (@Mandiant/@FireEye), oscd.community
// Date: 2019-11-08
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects all variations of obfuscated powershell IEX invocation code generated by Invoke-Obfuscation framework from the following code block
// Converted by: Sigma Universal SIEM/EDR CLI

rule 4bf943c6_5146_4273_98dd_e958fd1e3abf {
  meta:
    title = "Invoke-Obfuscation Obfuscated IEX Invocation"
    description = "Detects all variations of obfuscated powershell IEX invocation code generated by Invoke-Obfuscation framework from the following code block"
    author = "Daniel Bohannon (@Mandiant/@FireEye), oscd.community"
    severity = "HIGH"

  events:
    (($e.target.process.command_line = /\$PSHome\[\s*\d{1,3}\s*\]\s*\+\s*\$PSHome\[/ nocase) or ($e.target.process.command_line = /\$ShellId\[\s*\d{1,3}\s*\]\s*\+\s*\$ShellId\[/ nocase) or ($e.target.process.command_line = /\$env:Public\[\s*\d{1,3}\s*\]\s*\+\s*\$env:Public\[/ nocase) or ($e.target.process.command_line = /\$env:ComSpec\[(?:\s*\d{1,3}\s*,){2}/ nocase) or ($e.target.process.command_line = /\*mdr\*\W\s*\)\.Name/ nocase) or ($e.target.process.command_line = /\$VerbosePreference\.ToString\(/ nocase) or ($e.target.process.command_line = /\[String\]\s*\$VerbosePreference/ nocase))

  condition:
    $e
}
