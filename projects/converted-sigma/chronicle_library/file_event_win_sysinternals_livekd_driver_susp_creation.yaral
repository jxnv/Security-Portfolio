// Title: LiveKD Driver Creation By Uncommon Process
// ID: 059c5af9-5131-4d8d-92b2-de4ad6146712
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-16
// Tags: attack.privilege-escalation, attack.stealth
// Description: Detects the creation of the LiveKD driver by a process image other than "livekd.exe".
// Converted by: Sigma Universal SIEM/EDR CLI

rule 059c5af9_5131_4d8d_92b2_de4ad6146712 {
  meta:
    title = "LiveKD Driver Creation By Uncommon Process"
    description = "Detects the creation of the LiveKD driver by a process image other than "livekd.exe"."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.file.full_path = "C:\\Windows\\System32\\drivers\\LiveKdD.SYS") and not((($e.target.process.file.full_path = /.*\\livekd.exe$/ nocase or $e.target.process.file.full_path = /.*\\livek64.exe$/ nocase))))

  condition:
    $e
}
