// Title: CobaltStrike Service Installations - System
// ID: 5a105d34-05fc-401e-8553-272b45c1522d
// Status: test
// Level: critical
// Author: Florian Roth (Nextron Systems), Wojciech Lesicki
// Date: 2021-05-26
// Tags: attack.persistence, attack.execution, attack.privilege-escalation, attack.lateral-movement, attack.t1021.002, attack.t1543.003, attack.t1569.002
// Description: Detects known malicious service installs that appear in cases in which a Cobalt Strike beacon elevates privileges or lateral movement
// Converted by: Sigma Universal SIEM/EDR CLI

rule 5a105d34_05fc_401e_8553_272b45c1522d {
  meta:
    title = "CobaltStrike Service Installations - System"
    description = "Detects known malicious service installs that appear in cases in which a Cobalt Strike beacon elevates privileges or lateral movement"
    author = "Florian Roth (Nextron Systems), Wojciech Lesicki"
    severity = "CRITICAL"

  events:
    (($e.Provider_Name = "Service Control Manager" and $e.EventID = 7045) and ((($e.ImagePath = /.*ADMIN$.*/ nocase and $e.ImagePath = /.*.exe.*/ nocase)) or (($e.ImagePath = /.*%COMSPEC%.*/ nocase and $e.ImagePath = /.*start.*/ nocase and $e.ImagePath = /.*powershell.*/ nocase)) or ($e.ImagePath = /.*powershell -nop -w hidden -encodedcommand.*/ nocase) or (($e.ImagePath = /.*SUVYIChOZXctT2JqZWN0IE5ldC5XZWJjbGllbnQpLkRvd25sb2FkU3RyaW5nKCdodHRwOi8vMTI3LjAuMC4xO.*/ nocase or $e.ImagePath = /.*lFWCAoTmV3LU9iamVjdCBOZXQuV2ViY2xpZW50KS5Eb3dubG9hZFN0cmluZygnaHR0cDovLzEyNy4wLjAuMT.*/ nocase or $e.ImagePath = /.*JRVggKE5ldy1PYmplY3QgTmV0LldlYmNsaWVudCkuRG93bmxvYWRTdHJpbmcoJ2h0dHA6Ly8xMjcuMC4wLjE6.*/ nocase))))

  condition:
    $e
}
