// Title: Telegram API Access
// ID: b494b165-6634-483d-8c47-2026a6c52372
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2018-06-05
// Tags: attack.command-and-control, attack.t1071.001, attack.t1102.002
// Description: Detects suspicious requests to Telegram API without the usual Telegram User-Agent
// Converted by: Sigma Universal SIEM/EDR CLI

rule b494b165_6634_483d_8c47_2026a6c52372 {
  meta:
    title = "Telegram API Access"
    description = "Detects suspicious requests to Telegram API without the usual Telegram User-Agent"
    author = "Florian Roth (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.cs-host = "api.telegram.org") and not((($e.c-useragent = /.*Telegram.*/ nocase or $e.c-useragent = /.*Bot.*/ nocase))))

  condition:
    $e
}
