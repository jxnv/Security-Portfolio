// Title: Remote Utilities Host Service Install
// ID: 85cce894-dd8b-4427-a958-5cc47a4dc9b9
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-31
// Tags: attack.persistence
// Description: Detects Remote Utilities Host service installation on the target system.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 85cce894_dd8b_4427_a958_5cc47a4dc9b9 {
  meta:
    title = "Remote Utilities Host Service Install"
    description = "Detects Remote Utilities Host service installation on the target system."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.Provider_Name = "Service Control Manager" and $e.EventID = 7045) and ((($e.ImagePath = /.*\\rutserv.exe.*/ nocase and $e.ImagePath = /.*-service.*/ nocase)) or ($e.ServiceName = "Remote Utilities - Host")))

  condition:
    $e
}
