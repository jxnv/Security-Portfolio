// Title: PowerShell MSI Install via WindowsInstaller COM From Remote Location
// ID: 222720a7-047f-4054-baa5-bab9be757db0
// Status: experimental
// Level: medium
// Author: Meroujan Antonyan (vx3r)
// Date: 2025-06-05
// Tags: attack.execution, attack.stealth, attack.t1059.001, attack.t1218, attack.command-and-control, attack.t1105
// Description: Detects the execution of PowerShell commands that attempt to install MSI packages via the
// Windows Installer COM object (`WindowsInstaller.Installer`) hosted remotely.
// This could be indication of malicious software deployment or lateral movement attempts using Windows Installer functionality.
// And the usage of WindowsInstaller COM object rather than msiexec could be an attempt to bypass the detection.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 222720a7_047f_4054_baa5_bab9be757db0 {
  meta:
    title = "PowerShell MSI Install via WindowsInstaller COM From Remote Location"
    description = "Detects the execution of PowerShell commands that attempt to install MSI packages via the Windows Installer COM object (`WindowsInstaller.Installer`) hosted remotely. This could be indication of malicious software deployment or lateral movement attempts using Windows Installer functionality. And the usage of WindowsInstaller COM object rather than msiexec could be an attempt to bypass the detection."
    author = "Meroujan Antonyan (vx3r)"
    severity = "MEDIUM"

  events:
    (((($e.target.process.command_line = /.*-ComObject.*/ nocase and $e.target.process.command_line = /.*InstallProduct(.*/ nocase)) and ((($e.target.process.file.full_path = /.*\\powershell_ise.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase)) or (($e.target.process.file.name = "PowerShell_ISE.EXE" or $e.target.process.file.name = "PowerShell.EXE" or $e.target.process.file.name = "pwsh.dll"))) and (($e.target.process.command_line = /.*http.*/ nocase or $e.target.process.command_line = /.*\\\\\\\\.*/ nocase))) and not((($e.target.process.command_line = /.*://127.0.0.1.*/ nocase or $e.target.process.command_line = /.*://localhost.*/ nocase))))

  condition:
    $e
}
