rule c8557060_9221_4448_8794_96320e6f3e74 {
  meta:
    title = "Windows PowerShell User Agent"
    description = "Detects Windows PowerShell Web Access"
    author = "Florian Roth (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ($e.c-useragent = /.* WindowsPowerShell/.*/ nocase)

  condition:
    $e
}
