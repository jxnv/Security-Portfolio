// Title: Arbitrary File Download Via MSEDGE_PROXY.EXE
// ID: e84d89c4-f544-41ca-a6af-4b92fd38b023
// Status: test
// Level: medium
// Author: Swachchhanda Shrawan Poudel
// Date: 2023-11-09
// Tags: attack.execution, attack.stealth, attack.t1218
// Description: Detects usage of "msedge_proxy.exe" to download arbitrary files
// Converted by: Sigma Universal SIEM/EDR CLI

rule e84d89c4_f544_41ca_a6af_4b92fd38b023 {
  meta:
    title = "Arbitrary File Download Via MSEDGE_PROXY.EXE"
    description = "Detects usage of "msedge_proxy.exe" to download arbitrary files"
    author = "Swachchhanda Shrawan Poudel"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*http://.*/ nocase or $e.target.process.command_line = /.*https://.*/ nocase)) and (($e.target.process.file.full_path = /.*\\msedge_proxy.exe$/ nocase) or ($e.target.process.file.name = "msedge_proxy.exe")))

  condition:
    $e
}
