// Title: File Download Using Notepad++ GUP Utility
// ID: 44143844-0631-49ab-97a0-96387d6b2d7c
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-10
// Tags: attack.command-and-control, attack.t1105
// Description: Detects execution of the Notepad++ updater (gup) from a process other than Notepad++ to download files.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 44143844_0631_49ab_97a0_96387d6b2d7c {
  meta:
    title = "File Download Using Notepad++ GUP Utility"
    description = "Detects execution of the Notepad++ updater (gup) from a process other than Notepad++ to download files."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    (((($e.target.process.command_line = /.* -unzipTo .*/ nocase and $e.target.process.command_line = /.*http.*/ nocase)) and (($e.target.process.file.full_path = /.*\\GUP.exe$/ nocase) or ($e.target.process.file.name = "gup.exe"))) and not(($e.principal.process.file.full_path = /.*\\notepad++.exe$/ nocase)))

  condition:
    $e
}
