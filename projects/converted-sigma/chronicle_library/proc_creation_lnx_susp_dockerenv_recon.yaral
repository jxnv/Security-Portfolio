// Title: Docker Container Discovery Via Dockerenv Listing
// ID: 11701de9-d5a5-44aa-8238-84252f131895
// Status: test
// Level: low
// Author: Seth Hanford
// Date: 2023-08-23
// Tags: attack.discovery, attack.t1082
// Description: Detects listing or file reading of ".dockerenv" which can be a sing of potential container discovery
// Converted by: Sigma Universal SIEM/EDR CLI

rule 11701de9_d5a5_44aa_8238_84252f131895 {
  meta:
    title = "Docker Container Discovery Via Dockerenv Listing"
    description = "Detects listing or file reading of ".dockerenv" which can be a sing of potential container discovery"
    author = "Seth Hanford"
    severity = "LOW"

  events:
    (($e.target.process.file.full_path = /.*/cat$/ nocase or $e.target.process.file.full_path = /.*/dir$/ nocase or $e.target.process.file.full_path = /.*/find$/ nocase or $e.target.process.file.full_path = /.*/ls$/ nocase or $e.target.process.file.full_path = /.*/stat$/ nocase or $e.target.process.file.full_path = /.*/test$/ nocase or $e.target.process.file.full_path = /.*grep$/ nocase) and $e.target.process.command_line = /.*.dockerenv$/ nocase)

  condition:
    $e
}
