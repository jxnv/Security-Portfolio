// Title: Arbitrary File Download Via IMEWDBLD.EXE
// ID: 863218bd-c7d0-4c52-80cd-0a96c09f54af
// Status: test
// Level: high
// Author: Swachchhanda Shrawan Poudel
// Date: 2023-11-09
// Tags: attack.execution, attack.stealth, attack.t1218
// Description: Detects usage of "IMEWDBLD.exe" to download arbitrary files
// Converted by: Sigma Universal SIEM/EDR CLI

rule 863218bd_c7d0_4c52_80cd_0a96c09f54af {
  meta:
    title = "Arbitrary File Download Via IMEWDBLD.EXE"
    description = "Detects usage of "IMEWDBLD.exe" to download arbitrary files"
    author = "Swachchhanda Shrawan Poudel"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*http://.*/ nocase or $e.target.process.command_line = /.*https://.*/ nocase)) and (($e.target.process.file.full_path = /.*\\IMEWDBLD.exe$/ nocase) or ($e.target.process.file.name = "imewdbld.exe")))

  condition:
    $e
}
