// Tags: attack.t1059.002, attack.execution
// Description: Detects potential suspicious run-only executions compiled using OSACompile
// Converted by: Sigma Universal SIEM/EDR CLI

rule b9d9b652_d8ed_4697_89a2_a1186ee680ac {
  meta:
    title = "OSACompile Run-Only Execution"
    description = "Detects potential suspicious run-only executions compiled using OSACompile"
    author = "Sohan G (D4rkCiph3r)"
    severity = "HIGH"

  events:
    (($e.target.process.command_line = /.*osacompile.*/ nocase and $e.target.process.command_line = /.* -x .*/ nocase and $e.target.process.command_line = /.* -e .*/ nocase))

  condition:
    $e
}
