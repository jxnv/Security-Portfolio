// Title: Copying Sensitive Files with Credential Data
// ID: e7be6119-fc37-43f0-ad4f-1f3f99be2f9f
// Status: test
// Level: high
// Author: Teymur Kheirkhabarov, Daniil Yugoslavskiy, oscd.community
// Date: 2019-10-22
// Tags: attack.credential-access, attack.t1003.002, attack.t1003.003, car.2013-07-001, attack.s0404
// Description: Files with well-known filenames (sensitive files with credential data) copying
// Converted by: Sigma Universal SIEM/EDR CLI

rule e7be6119_fc37_43f0_ad4f_1f3f99be2f9f {
  meta:
    title = "Copying Sensitive Files with Credential Data"
    description = "Files with well-known filenames (sensitive files with credential data) copying"
    author = "Teymur Kheirkhabarov, Daniil Yugoslavskiy, oscd.community"
    severity = "HIGH"

  events:
    (((($e.target.process.command_line = /.*vss.*/ nocase or $e.target.process.command_line = /.* /m .*/ nocase or $e.target.process.command_line = /.* /y .*/ nocase)) and (($e.target.process.file.full_path = /.*\\esentutl.exe$/ nocase) or ($e.target.process.file.name = "\\esentutl.exe"))) or (($e.target.process.command_line = /.*\\config\\RegBack\\sam.*/ nocase or $e.target.process.command_line = /.*\\config\\RegBack\\security.*/ nocase or $e.target.process.command_line = /.*\\config\\RegBack\\system.*/ nocase or $e.target.process.command_line = /.*\\config\\sam.*/ nocase or $e.target.process.command_line = /.*\\config\\security.*/ nocase or $e.target.process.command_line = /.*\\config\\system .*/ nocase or $e.target.process.command_line = /.*\\repair\\sam.*/ nocase or $e.target.process.command_line = /.*\\repair\\security.*/ nocase or $e.target.process.command_line = /.*\\repair\\system.*/ nocase or $e.target.process.command_line = /.*\\windows\\ntds\\ntds.dit.*/ nocase)))

  condition:
    $e
}
