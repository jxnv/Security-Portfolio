// Title: Potential CommandLine Obfuscation Using Unicode Characters From Suspicious Image
// ID: 584bca0f-3608-4402-80fd-4075ff6072e3
// Status: test
// Level: high
// Author: frack113, Florian Roth (Nextron Systems), Josh Nickels
// Date: 2024-09-02
// Tags: attack.stealth, attack.t1027
// Description: Detects potential commandline obfuscation using unicode characters.
// Adversaries may attempt to make an executable or file difficult to discover or analyze by encrypting, encoding, or otherwise obfuscating its contents on the system or in transit.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 584bca0f_3608_4402_80fd_4075ff6072e3 {
  meta:
    title = "Potential CommandLine Obfuscation Using Unicode Characters From Suspicious Image"
    description = "Detects potential commandline obfuscation using unicode characters. Adversaries may attempt to make an executable or file difficult to discover or analyze by encrypting, encoding, or otherwise obfuscating its contents on the system or in transit."
    author = "frack113, Florian Roth (Nextron Systems), Josh Nickels"
    severity = "HIGH"

  events:
    ((($e.target.process.file.full_path = /.*\\cmd.exe$/ nocase or $e.target.process.file.full_path = /.*\\cscript.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell_ise.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase or $e.target.process.file.full_path = /.*\\wscript.exe$/ nocase) and ($e.target.process.file.name = "Cmd.EXE" or $e.target.process.file.name = "cscript.exe" or $e.target.process.file.name = "PowerShell.EXE" or $e.target.process.file.name = "PowerShell_ISE.EXE" or $e.target.process.file.name = "pwsh.dll" or $e.target.process.file.name = "wscript.exe")) and (($e.target.process.command_line = /.*ˣ.*/ nocase or $e.target.process.command_line = /.*˪.*/ nocase or $e.target.process.command_line = /.*ˢ.*/ nocase or $e.target.process.command_line = /.*∕.*/ nocase or $e.target.process.command_line = /.*⁄.*/ nocase or $e.target.process.command_line = /.*―.*/ nocase or $e.target.process.command_line = /.*—.*/ nocase or $e.target.process.command_line = /.* .*/ nocase or $e.target.process.command_line = /.*¯.*/ nocase or $e.target.process.command_line = /.*®.*/ nocase or $e.target.process.command_line = /.*¶.*/ nocase or $e.target.process.command_line = /.*⠀.*/ nocase)))

  condition:
    $e
}
