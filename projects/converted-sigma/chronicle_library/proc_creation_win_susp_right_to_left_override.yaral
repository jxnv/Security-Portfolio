// Title: Potential Defense Evasion Via Right-to-Left Override
// ID: ad691d92-15f2-4181-9aa4-723c74f9ddc3
// Status: test
// Level: high
// Author: Micah Babinski, @micahbabinski, Swachchhanda Shrawan Poudel (Nextron Systems), Luc Génaux
// Date: 2023-02-15
// Tags: attack.stealth, attack.t1036.002
// Description: Detects the presence of the "u202+E" character, which causes a terminal, browser, or operating system to render text in a right-to-left sequence.
// This character is used as an obfuscation and masquerading techniques by adversaries to trick users into opening malicious files.
// Converted by: Sigma Universal SIEM/EDR CLI

rule ad691d92_15f2_4181_9aa4_723c74f9ddc3 {
  meta:
    title = "Potential Defense Evasion Via Right-to-Left Override"
    description = "Detects the presence of the "u202+E" character, which causes a terminal, browser, or operating system to render text in a right-to-left sequence. This character is used as an obfuscation and masquerading techniques by adversaries to trick users into opening malicious files."
    author = "Micah Babinski, @micahbabinski, Swachchhanda Shrawan Poudel (Nextron Systems), Luc Génaux"
    severity = "HIGH"

  events:
    (($e.target.process.command_line = /.*\\u202e.*/ nocase or $e.target.process.command_line = /.*[U+202E].*/ nocase or $e.target.process.command_line = /.*‮.*/ nocase))

  condition:
    $e
}
