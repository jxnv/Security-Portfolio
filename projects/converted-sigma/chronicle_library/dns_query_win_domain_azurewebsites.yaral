// Title: DNS Query To AzureWebsites.NET By Non-Browser Process
// ID: e043f529-8514-4205-8ab0-7f7d2927b400
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects a DNS query by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
// Converted by: Sigma Universal SIEM/EDR CLI

rule e043f529_8514_4205_8ab0_7f7d2927b400 {
  meta:
    title = "DNS Query To AzureWebsites.NET By Non-Browser Process"
    description = "Detects a DNS query by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.QueryName = /.*azurewebsites.net$/ nocase) and not(((($e.target.process.file.full_path = /^C:\\Program Files (x86)\\Avant Browser\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\Avant Browser\\.*/ nocase) and $e.target.process.file.full_path = /.*\\avant.exe$/ nocase) or ($e.target.process.file.full_path = /.*\\brave.exe$/ nocase and $e.target.process.file.full_path = /^C:\\Program Files\\BraveSoftware\\.*/ nocase) or (($e.target.process.file.full_path = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or $e.target.process.file.full_path = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or (($e.target.process.file.full_path = /.*\\MsMpEng.exe$/ nocase or $e.target.process.file.full_path = /.*\\MsSense.exe$/ nocase)) or (($e.target.process.file.full_path = /^C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\.*/ nocase) or ($e.target.process.file.full_path = /.*\\WindowsApps\\MicrosoftEdge.exe$/ nocase) or (($e.target.process.file.full_path = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or $e.target.process.file.full_path = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or (($e.target.process.file.full_path = /^C:\\Program Files (x86)\\Microsoft\\EdgeCore\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\Microsoft\\EdgeCore\\.*/ nocase) and ($e.target.process.file.full_path = /.*\\msedge.exe$/ nocase or $e.target.process.file.full_path = /.*\\msedgewebview2.exe$/ nocase)) or (($e.target.process.file.full_path = /^C:\\Program Files\\Falkon\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files (x86)\\Falkon\\.*/ nocase) and $e.target.process.file.full_path = /.*\\falkon.exe$/ nocase) or (($e.target.process.file.full_path = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or $e.target.process.file.full_path = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or ($e.target.process.file.full_path = /.*\\AppData\\Local\\Flock\\.*/ nocase and $e.target.process.file.full_path = /.*\\Flock.exe$/ nocase) or (($e.target.process.file.full_path = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or $e.target.process.file.full_path = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or ($e.target.process.file.full_path = /.*\\AppData\\Local\\Maxthon\\.*/ nocase and $e.target.process.file.full_path = /.*\\maxthon.exe$/ nocase) or ($e.target.process.file.full_path = /.*\\AppData\\Local\\Programs\\midori-ng\\.*/ nocase and $e.target.process.file.full_path = /.*\\Midori Next Generation.exe$/ nocase) or ($e.target.process.file.full_path = /.*\\AppData\\Local\\Programs\\Opera\\.*/ nocase and $e.target.process.file.full_path = /.*\\opera.exe$/ nocase) or ($e.target.process.file.full_path = /.*\\AppData\\Local\\Phoebe\\.*/ nocase and $e.target.process.file.full_path = /.*\\Phoebe.exe$/ nocase) or ($e.target.process.file.full_path = /.*\\safari.exe$/ nocase) or (($e.target.process.file.full_path = /^C:\\Program Files\\SeaMonkey\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files (x86)\\SeaMonkey\\.*/ nocase) and $e.target.process.file.full_path = /.*\\seamonkey.exe$/ nocase) or (($e.target.process.file.full_path = /^C:\\Program Files\\SlimBrowser\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files (x86)\\SlimBrowser\\.*/ nocase) and $e.target.process.file.full_path = /.*\\slimbrowser.exe$/ nocase) or ($e.target.process.file.full_path = /.*\\Tor Browser\\.*/ nocase) or ($e.target.process.file.full_path = /.*\\AppData\\Local\\Vivaldi\\.*/ nocase and $e.target.process.file.full_path = /.*\\vivaldi.exe$/ nocase) or (($e.target.process.file.full_path = /^C:\\Program Files\\Naver\\Naver Whale\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files (x86)\\Naver\\Naver Whale\\.*/ nocase) and $e.target.process.file.full_path = /.*\\whale.exe$/ nocase) or (($e.target.process.file.full_path = /^C:\\Program Files\\Waterfox\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files (x86)\\Waterfox\\.*/ nocase) and $e.target.process.file.full_path = /.*\\Waterfox.exe$/ nocase))))

  condition:
    $e
}
