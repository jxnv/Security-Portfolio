// Title: Arbitrary File Download Via MSOHTMED.EXE
// ID: 459f2f98-397b-4a4a-9f47-6a5ec2f1c69d
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-19
// Tags: attack.execution, attack.stealth, attack.t1218
// Description: Detects usage of "MSOHTMED" to download arbitrary files
// Converted by: Sigma Universal SIEM/EDR CLI

rule 459f2f98_397b_4a4a_9f47_6a5ec2f1c69d {
  meta:
    title = "Arbitrary File Download Via MSOHTMED.EXE"
    description = "Detects usage of "MSOHTMED" to download arbitrary files"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*ftp://.*/ nocase or $e.target.process.command_line = /.*http://.*/ nocase or $e.target.process.command_line = /.*https://.*/ nocase)) and (($e.target.process.file.full_path = /.*\\MSOHTMED.exe$/ nocase) or ($e.target.process.file.name = "MsoHtmEd.exe")))

  condition:
    $e
}
