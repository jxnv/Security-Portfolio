// Title: DNS Server Discovery Via LDAP Query
// ID: a21bcd7e-38ec-49ad-b69a-9ea17e69509e
// Status: test
// Level: low
// Author: frack113
// Date: 2022-08-20
// Tags: attack.discovery, attack.t1482
// Description: Detects DNS server discovery via LDAP query requests from uncommon applications
// Converted by: Sigma Universal SIEM/EDR CLI

rule a21bcd7e_38ec_49ad_b69a_9ea17e69509e {
  meta:
    title = "DNS Server Discovery Via LDAP Query"
    description = "Detects DNS server discovery via LDAP query requests from uncommon applications"
    author = "frack113"
    severity = "LOW"

  events:
    (($e.QueryName = /^_ldap..*/ nocase) and not((($e.target.process.file.full_path = /.*:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\.*/ nocase and $e.target.process.file.full_path = /.*\\MsMpEng.exe$/ nocase) or (($e.target.process.file.full_path = /.*:\\Program Files\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Program Files (x86)\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\.*/ nocase)) or (not ($e.target.process.file.full_path = /.*/)) or ($e.target.process.file.full_path = "<unknown process>"))) and not((($e.target.process.file.full_path = /^C:\\WindowsAzure\\GuestAgent.*/ nocase) or (($e.target.process.file.full_path = /.*\\chrome.exe$/ nocase or $e.target.process.file.full_path = /.*\\firefox.exe$/ nocase or $e.target.process.file.full_path = /.*\\opera.exe$/ nocase)))))

  condition:
    $e
}
