rule fe3a2d49_f255_4d10_935c_bda7391108eb {
  meta:
    title = "New BITS Job Created Via PowerShell"
    description = "Detects the creation of a new bits job by PowerShell"
    author = "frack113"
    severity = "LOW"

  events:
    ($e.EventID = 3 and ($e.processPath = /.*\\powershell.exe$/ nocase or $e.processPath = /.*\\pwsh.exe$/ nocase))

  condition:
    $e
}
