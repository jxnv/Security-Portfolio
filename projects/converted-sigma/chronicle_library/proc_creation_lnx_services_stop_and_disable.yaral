// Title: Disable Or Stop Services
// ID: de25eeb8-3655-4643-ac3a-b662d3f26b6b
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-15
// Tags: attack.defense-impairment, attack.t1685, attack.impact, attack.t1489
// Description: Detects the usage of utilities such as 'systemctl', 'service'...etc to stop or disable tools and services on Linux systems.
// Attackers may stop or disable security tools and services to evade detection, maintain persistence, or disrupt system operations.
// Converted by: Sigma Universal SIEM/EDR CLI

rule de25eeb8_3655_4643_ac3a_b662d3f26b6b {
  meta:
    title = "Disable Or Stop Services"
    description = "Detects the usage of utilities such as 'systemctl', 'service'...etc to stop or disable tools and services on Linux systems. Attackers may stop or disable security tools and services to evade detection, maintain persistence, or disrupt system operations."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.file.full_path = /.*/service$/ nocase or $e.target.process.file.full_path = /.*/systemctl$/ nocase or $e.target.process.file.full_path = /.*/chkconfig$/ nocase) and ($e.target.process.command_line = /.* stop .*/ nocase or $e.target.process.command_line = /.* disable .*/ nocase)) and not((($e.target.process.file.full_path = /.*/systemctl$/ nocase and ($e.target.process.command_line = /.*--no-reload disable snap-snapd-.*/ nocase or $e.target.process.command_line = /.* stop snap-snapd-.*/ nocase)) or ($e.target.process.file.full_path = /.*/systemctl$/ nocase and $e.principal.process.command_line = /.*tmp.ci/preinst upgrade.*/ nocase and ($e.target.process.command_line = /.* stop .*/ nocase and $e.target.process.command_line = /.*ssh..*/ nocase)) or ($e.principal.process.command_line = /.*/dpkg/info/ubuntu-pro-client.prerm upgrade.*/ nocase and $e.target.process.file.full_path = /.*/systemctl$/ nocase))) and not(($e.target.process.file.full_path = /.*/systemctl$/ nocase and $e.target.process.command_line = /.*snap.amazon-ssm-agent.amazon-ssm-agent.service$/ nocase)))

  condition:
    $e
}
