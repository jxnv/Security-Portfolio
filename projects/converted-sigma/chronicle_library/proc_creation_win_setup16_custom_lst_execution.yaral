// Title: Setup16.EXE Execution With Custom .Lst File
// ID: 99c8be4f-3087-4f9f-9c24-8c7e257b442e
// Status: test
// Level: medium
// Author: frack113
// Date: 2024-12-01
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.stealth, attack.t1574.005
// Description: Detects the execution of "Setup16.EXE" and old installation utility with a custom ".lst" file.
// These ".lst" file can contain references to external program that "Setup16.EXE" will execute.
// Attackers and adversaries might leverage this as a living of the land utility.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 99c8be4f_3087_4f9f_9c24_8c7e257b442e {
  meta:
    title = "Setup16.EXE Execution With Custom .Lst File"
    description = "Detects the execution of "Setup16.EXE" and old installation utility with a custom ".lst" file. These ".lst" file can contain references to external program that "Setup16.EXE" will execute. Attackers and adversaries might leverage this as a living of the land utility."
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.principal.process.file.full_path = "C:\\Windows\\SysWOW64\\setup16.exe" and $e.principal.process.command_line = /.* -m .*/ nocase) and not(($e.target.process.file.full_path = /^C:\\~MSSETUP.T\\.*/ nocase)))

  condition:
    $e
}
