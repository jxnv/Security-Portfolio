// Title: Potential ShellDispatch.DLL Functionality Abuse
// ID: 82343930-652f-43f5-ab70-2ee9fdd6d5e9
// Status: test
// Level: medium
// Author: X__Junior (Nextron Systems)
// Date: 2023-06-20
// Tags: attack.execution, attack.stealth
// Description: Detects potential "ShellDispatch.dll" functionality abuse to execute arbitrary binaries via "ShellExecute"
// Converted by: Sigma Universal SIEM/EDR CLI

rule 82343930_652f_43f5_ab70_2ee9fdd6d5e9 {
  meta:
    title = "Potential ShellDispatch.DLL Functionality Abuse"
    description = "Detects potential "ShellDispatch.dll" functionality abuse to execute arbitrary binaries via "ShellExecute""
    author = "X__Junior (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.target.process.command_line = /.*RunDll_ShellExecuteW.*/ nocase) and (($e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase) or ($e.target.process.file.name = "RUNDLL32.EXE")))

  condition:
    $e
}
