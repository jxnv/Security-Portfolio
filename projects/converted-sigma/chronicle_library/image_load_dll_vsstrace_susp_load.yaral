// Title: Potentially Suspicious Volume Shadow Copy Vsstrace.dll Load
// ID: 48bfd177-7cf2-412b-ad77-baf923489e82
// Status: test
// Level: medium
// Author: frack113
// Date: 2023-02-17
// Tags: attack.impact, attack.t1490
// Description: Detects the image load of VSS DLL by uncommon executables
// Converted by: Sigma Universal SIEM/EDR CLI

rule 48bfd177_7cf2_412b_ad77_baf923489e82 {
  meta:
    title = "Potentially Suspicious Volume Shadow Copy Vsstrace.dll Load"
    description = "Detects the image load of VSS DLL by uncommon executables"
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.ImageLoaded = /.*\\vsstrace.dll$/ nocase) and not(((not ($e.target.process.file.full_path = /.*/)) or (($e.target.process.file.full_path = /^C:\\Program Files\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files (x86)\\.*/ nocase)) or ((($e.target.process.file.full_path = "C:\\Windows\\explorer.exe" or $e.target.process.file.full_path = "C:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe" or $e.target.process.file.full_path = "C:\\Windows\\servicing\\TrustedInstaller.exe")) or (($e.target.process.file.full_path = /^C:\\Windows\\System32\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\SysWOW64\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\Temp\\{.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\WinSxS\\.*/ nocase or $e.target.process.file.full_path = /^C:\\ProgramData\\Package Cache\\{.*/ nocase))))) and not(((($e.target.process.file.full_path = /.*\\temp\\is-.*/ nocase and $e.target.process.file.full_path = /.*\\avira_system_speedup.tmp.*/ nocase)) or ($e.target.process.file.full_path = /^C:\\$WinREAgent\\Scratch\\.*/ nocase))))

  condition:
    $e
}
