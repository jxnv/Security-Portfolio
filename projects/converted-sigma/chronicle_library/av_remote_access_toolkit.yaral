// Title: Antivirus - Remote Access Tools Signature
// ID: 97233998-3838-4581-88c6-f1d19d3993fb
// Status: experimental
// Level: critical
// Author: Arnim Rupp (Nextron Systems)
// Date: 2026-06-15
// Tags: attack.execution, attack.t1203, attack.command-and-control, attack.t1219.002
// Description: Detects a highly relevant Antivirus alert that reports a remote access tool.
// This event must not be ignored just because the AV has blocked the malware but investigate, how it came there in the first place.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 97233998_3838_4581_88c6_f1d19d3993fb {
  meta:
    title = "Antivirus - Remote Access Tools Signature"
    description = "Detects a highly relevant Antivirus alert that reports a remote access tool. This event must not be ignored just because the AV has blocked the malware but investigate, how it came there in the first place."
    author = "Arnim Rupp (Nextron Systems)"
    severity = "CRITICAL"

  events:
    (($e.Signature = /.*AgentB.*/ nocase or $e.Signature = /.*AgentTesla.*/ nocase or $e.Signature = /.*AMRat.*/ nocase or $e.Signature = /.*Ammyy.*/ nocase or $e.Signature = /.*AsyncRAT.*/ nocase or $e.Signature = /.*Bandook.*/ nocase or $e.Signature = /.*Bitrat.*/ nocase or $e.Signature = /.*Bladabindi.*/ nocase or $e.Signature = /.*Connectwise.*/ nocase or $e.Signature = /.*CyberGate.*/ nocase or $e.Signature = /.*DarkComet.*/ nocase or $e.Signature = /.*DCrat.*/ nocase or $e.Signature = /.*Delf.*/ nocase or $e.Signature = /.*DokStorm.*/ nocase or $e.Signature = /.*Egairtigado.*/ nocase or $e.Signature = /.*Gh0st.*/ nocase or $e.Signature = /.*Gorat.*/ nocase or $e.Signature = /.*GodRat.*/ nocase or $e.Signature = /.*Jalapeno.*/ nocase or $e.Signature = /.*LummaC2.*/ nocase or $e.Signature = /.*Minirat.*/ nocase or $e.Signature = /.*Netwire.*/ nocase or $e.Signature = /.*NanoCore.*/ nocase or $e.Signature = /.*NJRat.*/ nocase or $e.Signature = /.*Paralax.*/ nocase or $e.Signature = /.*PlugX.*/ nocase or $e.Signature = /.*Pulsar.*/ nocase or $e.Signature = /.*Quasar.*/ nocase or $e.Signature = /.*Remcos.*/ nocase or $e.Signature = /.*Ravartar.*/ nocase or $e.Signature = /.*RemoteAdmin.*/ nocase or $e.Signature = /.*RemoteTool.*/ nocase or $e.Signature = /.*revengeRAT.*/ nocase or $e.Signature = /.*rokRAT.*/ nocase or $e.Signature = /.*salatstealer.*/ nocase or $e.Signature = /.*Salgorea.*/ nocase or $e.Signature = /.*SmokedHam.*/ nocase or $e.Signature = /.*TigerRat.*/ nocase or $e.Signature = /.*Tzeebot.*/ nocase or $e.Signature = /.*WarZone.*/ nocase or $e.Signature = /.*VenomRAT.*/ nocase or $e.Signature = /.*Vidar.*/ nocase or $e.Signature = /.*Wirenet.*/ nocase or $e.Signature = /.*XWorm.*/ nocase or $e.Signature = /.*Zapchast.*/ nocase or $e.Signature = /.*Zegost.*/ nocase))

  condition:
    $e
}
