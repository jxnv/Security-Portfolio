rule c2496b41_16a9_4016_a776_b23f8910dc58 {
  meta:
    title = "Certificate-Based Authentication Enabled"
    description = "Detects when certificate based authentication has been enabled in an Azure Active Directory tenant."
    author = "Harjot Shah Singh, '@cyb3rjy0t'"
    severity = "MEDIUM"

  events:
    ($e.OperationName = "Authentication Methods Policy Update" and $e.TargetResources.modifiedProperties = /.*AuthenticationMethodsPolicy.*/ nocase)

  condition:
    $e
}
