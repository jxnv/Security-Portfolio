// Title: Uncommon Svchost Command Line Parameter
// ID: f17211f1-1f24-4d0c-829f-31e28dc93cdd
// Status: experimental
// Level: high
// Author: Liran Ravich
// Date: 2025-11-14
// Tags: attack.privilege-escalation, attack.stealth, attack.t1036.005, attack.t1055, attack.t1055.012
// Description: Detects instances of svchost.exe running with an unusual or uncommon command line parameter by excluding known legitimate or common patterns.
// This could point at a file masquerading as svchost, a process injection, or hollowing of a legitimate svchost instance.
// Converted by: Sigma Universal SIEM/EDR CLI

rule f17211f1_1f24_4d0c_829f_31e28dc93cdd {
  meta:
    title = "Uncommon Svchost Command Line Parameter"
    description = "Detects instances of svchost.exe running with an unusual or uncommon command line parameter by excluding known legitimate or common patterns. This could point at a file masquerading as svchost, a process injection, or hollowing of a legitimate svchost instance."
    author = "Liran Ravich"
    severity = "HIGH"

  events:
    (($e.target.process.file.full_path = /.*\\svchost.exe$/ nocase) and not((($e.target.process.command_line = "") or ($e.target.process.command_line = /-k\s\w{1,64}(?:\s?(?:-p|-s))?/ nocase) or (not ($e.target.process.command_line = /.*/)))) and not((($e.principal.process.file.full_path = /.*\\MsMpEng.exe$/ nocase and $e.target.process.command_line = /.*svchost.exe.*/ nocase) or ($e.principal.process.file.full_path = /.*\\MRT.exe$/ nocase and $e.target.process.command_line = "svchost.exe"))))

  condition:
    $e
}
