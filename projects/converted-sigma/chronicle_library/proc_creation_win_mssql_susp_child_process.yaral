// Title: Suspicious Child Process Of SQL Server
// ID: 869b9ca7-9ea2-4a5a-8325-e80e62f75445
// Status: test
// Level: high
// Author: FPT.EagleEye Team, wagga
// Date: 2020-12-11
// Tags: attack.t1505.003, attack.t1190, attack.initial-access, attack.persistence, attack.privilege-escalation
// Description: Detects suspicious child processes of the SQLServer process. This could indicate potential RCE or SQL Injection.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 869b9ca7_9ea2_4a5a_8325_e80e62f75445 {
  meta:
    title = "Suspicious Child Process Of SQL Server"
    description = "Detects suspicious child processes of the SQLServer process. This could indicate potential RCE or SQL Injection."
    author = "FPT.EagleEye Team, wagga"
    severity = "HIGH"

  events:
    (($e.principal.process.file.full_path = /.*\\sqlservr.exe$/ nocase and ($e.target.process.file.full_path = /.*\\bash.exe$/ nocase or $e.target.process.file.full_path = /.*\\bitsadmin.exe$/ nocase or $e.target.process.file.full_path = /.*\\cmd.exe$/ nocase or $e.target.process.file.full_path = /.*\\netstat.exe$/ nocase or $e.target.process.file.full_path = /.*\\nltest.exe$/ nocase or $e.target.process.file.full_path = /.*\\ping.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase or $e.target.process.file.full_path = /.*\\regsvr32.exe$/ nocase or $e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase or $e.target.process.file.full_path = /.*\\sh.exe$/ nocase or $e.target.process.file.full_path = /.*\\systeminfo.exe$/ nocase or $e.target.process.file.full_path = /.*\\tasklist.exe$/ nocase or $e.target.process.file.full_path = /.*\\wsl.exe$/ nocase)) and not(($e.principal.process.file.full_path = /^C:\\Program Files\\Microsoft SQL Server\\.*/ nocase and $e.principal.process.file.full_path = /.*DATEV_DBENGINE\\MSSQL\\Binn\\sqlservr.exe$/ nocase and $e.target.process.file.full_path = "C:\\Windows\\System32\\cmd.exe" and $e.target.process.command_line = /^\"C:\\Windows\\system32\\cmd.exe\" .*/ nocase)))

  condition:
    $e
}
