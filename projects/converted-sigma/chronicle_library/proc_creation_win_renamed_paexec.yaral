// Title: Renamed PAExec Execution
// ID: c4e49831-1496-40cf-8ce1-b53f942b02f9
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Jason Lynch
// Date: 2021-05-22
// Tags: attack.stealth, attack.t1202
// Description: Detects execution of renamed version of PAExec. Often used by attackers
// Converted by: Sigma Universal SIEM/EDR CLI

rule c4e49831_1496_40cf_8ce1_b53f942b02f9 {
  meta:
    title = "Renamed PAExec Execution"
    description = "Detects execution of renamed version of PAExec. Often used by attackers"
    author = "Florian Roth (Nextron Systems), Jason Lynch"
    severity = "HIGH"

  events:
    ((($e.Description = "PAExec Application") or ($e.target.process.file.name = "PAExec.exe") or ($e.Product = /.*PAExec.*/ nocase) or (($e.Hashes = /.*IMPHASH=11D40A7B7876288F919AB819CC2D9802.*/ nocase or $e.Hashes = /.*IMPHASH=6444f8a34e99b8f7d9647de66aabe516.*/ nocase or $e.Hashes = /.*IMPHASH=dfd6aa3f7b2b1035b76b718f1ddc689f.*/ nocase or $e.Hashes = /.*IMPHASH=1a6cca4d5460b1710a12dea39e4a592c.*/ nocase))) and not((($e.target.process.file.full_path = /.*\\paexec.exe$/ nocase) or ($e.target.process.file.full_path = /^C:\\Windows\\PAExec-.*/ nocase))))

  condition:
    $e
}
