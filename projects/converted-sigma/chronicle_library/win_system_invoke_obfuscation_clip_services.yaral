// Title: Invoke-Obfuscation CLIP+ Launcher - System
// ID: f7385ee2-0e0c-11eb-adc1-0242ac120002
// Status: test
// Level: high
// Author: Jonathan Cheong, oscd.community
// Date: 2020-10-13
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated use of Clip.exe to execute PowerShell
// Converted by: Sigma Universal SIEM/EDR CLI

rule f7385ee2_0e0c_11eb_adc1_0242ac120002 {
  meta:
    title = "Invoke-Obfuscation CLIP+ Launcher - System"
    description = "Detects Obfuscated use of Clip.exe to execute PowerShell"
    author = "Jonathan Cheong, oscd.community"
    severity = "HIGH"

  events:
    ($e.Provider_Name = "Service Control Manager" and $e.EventID = 7045 and ($e.ImagePath = /.*cmd.*/ nocase and $e.ImagePath = /.*&&.*/ nocase and $e.ImagePath = /.*clipboard]::.*/ nocase))

  condition:
    $e
}
