// Title: Rclone Config File Creation
// ID: 34986307-b7f4-49be-92f3-e7a4d01ac5db
// Status: test
// Level: medium
// Author: Aaron Greetham (@beardofbinary) - NCC Group
// Date: 2021-05-26
// Tags: attack.exfiltration, attack.t1567.002
// Description: Detects Rclone config files being created
// Converted by: Sigma Universal SIEM/EDR CLI

rule 34986307_b7f4_49be_92f3_e7a4d01ac5db {
  meta:
    title = "Rclone Config File Creation"
    description = "Detects Rclone config files being created"
    author = "Aaron Greetham (@beardofbinary) - NCC Group"
    severity = "MEDIUM"

  events:
    (($e.target.file.full_path = /.*:\\Users\\.*/ nocase and $e.target.file.full_path = /.*\\.config\\rclone\\.*/ nocase))

  condition:
    $e
}
