// Title: JAMF MDM Potential Suspicious Child Process
// ID: 2316929c-01aa-438c-970f-099145ab1ee6
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-08-22
// Tags: attack.execution
// Description: Detects potential suspicious child processes of "jamf". Could be a sign of potential abuse of Jamf as a C2 server as seen by Typhon MythicAgent.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 2316929c_01aa_438c_970f_099145ab1ee6 {
  meta:
    title = "JAMF MDM Potential Suspicious Child Process"
    description = "Detects potential suspicious child processes of "jamf". Could be a sign of potential abuse of Jamf as a C2 server as seen by Typhon MythicAgent."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ($e.principal.process.file.full_path = /.*/jamf$/ nocase and ($e.target.process.file.full_path = /.*/bash$/ nocase or $e.target.process.file.full_path = /.*/sh$/ nocase))

  condition:
    $e
}
