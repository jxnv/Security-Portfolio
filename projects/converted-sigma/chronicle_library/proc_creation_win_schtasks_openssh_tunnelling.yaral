// Title: Potential SSH Tunnel Persistence Install Using A Scheduled Task
// ID: 2daa93a0-a5fb-41c5-8cd8-3c11294bfd1f
// Status: experimental
// Level: high
// Author: Rory Duncan
// Date: 2025-07-14
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005, attack.command-and-control
// Description: Detects the creation of new scheduled tasks via commandline, using Schtasks.exe. This rule detects tasks creating that call OpenSSH, which may indicate the creation of reverse SSH tunnel to the attacker's server.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 2daa93a0_a5fb_41c5_8cd8_3c11294bfd1f {
  meta:
    title = "Potential SSH Tunnel Persistence Install Using A Scheduled Task"
    description = "Detects the creation of new scheduled tasks via commandline, using Schtasks.exe. This rule detects tasks creating that call OpenSSH, which may indicate the creation of reverse SSH tunnel to the attacker's server."
    author = "Rory Duncan"
    severity = "HIGH"

  events:
    ((($e.target.process.file.full_path = /.*\\schtasks.exe$/ nocase) or ($e.target.process.file.name = "schtasks.exe")) and ((($e.target.process.command_line = /.* /create .*/ nocase and $e.target.process.command_line = /.*ssh.exe.*/ nocase and $e.target.process.command_line = /.*-i.*/ nocase)) or (($e.target.process.command_line = /.* /create .*/ nocase and $e.target.process.command_line = /.*sshd.exe.*/ nocase and $e.target.process.command_line = /.*-f.*/ nocase))))

  condition:
    $e
}
