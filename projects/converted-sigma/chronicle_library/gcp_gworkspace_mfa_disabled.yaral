rule 780601d1_6376_4f2a_884e_b8d45599f78c {
  meta:
    title = "Google Workspace MFA Disabled"
    description = "Detects when multi-factor authentication (MFA) is disabled."
    author = "Austin Songer"
    severity = "MEDIUM"

  events:
    (($e.eventService = "admin.googleapis.com" and ($e.eventName = "ENFORCE_STRONG_AUTHENTICATION" or $e.eventName = "ALLOW_STRONG_AUTHENTICATION")) and ($e.new_value = "false"))

  condition:
    $e
}
