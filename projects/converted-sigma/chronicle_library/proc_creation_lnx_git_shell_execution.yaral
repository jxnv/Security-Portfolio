// Title: Shell Execution via Git - Linux
// ID: 47b3bbd4-1bf7-48cc-84ab-995362aaa75a
// Status: test
// Level: high
// Author: Li Ling, Andy Parkidomo, Robert Rakowski, Blake Hartstein (Bloomberg L.P.)
// Date: 2024-09-02
// Tags: attack.execution, attack.t1059
// Description: Detects the use of the "git" utility to execute a shell. Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 47b3bbd4_1bf7_48cc_84ab_995362aaa75a {
  meta:
    title = "Shell Execution via Git - Linux"
    description = "Detects the use of the "git" utility to execute a shell. Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments."
    author = "Li Ling, Andy Parkidomo, Robert Rakowski, Blake Hartstein (Bloomberg L.P.)"
    severity = "HIGH"

  events:
    ($e.principal.process.file.full_path = /.*/git$/ nocase and ($e.principal.process.command_line = /.* -p .*/ nocase and $e.principal.process.command_line = /.*help.*/ nocase) and ($e.target.process.command_line = /.*bash 0<&1.*/ nocase or $e.target.process.command_line = /.*dash 0<&1.*/ nocase or $e.target.process.command_line = /.*sh 0<&1.*/ nocase))

  condition:
    $e
}
