// Title: DSInternals Suspicious PowerShell Cmdlets - ScriptBlock
// ID: 846c7a87-8e14-4569-9d49-ecfd4276a01c
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-06-26
// Tags: attack.execution, attack.t1059.001
// Description: Detects execution and usage of the DSInternals PowerShell module. Which can be used to perform what might be considered as suspicious activity such as dumping DPAPI backup keys or manipulating NTDS.DIT files.
// The DSInternals PowerShell Module exposes several internal features of Active Directory and Azure Active Directory. These include FIDO2 and NGC key auditing, offline ntds.dit file manipulation, password auditing, DC recovery from IFM backups and password hash calculation.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 846c7a87_8e14_4569_9d49_ecfd4276a01c {
  meta:
    title = "DSInternals Suspicious PowerShell Cmdlets - ScriptBlock"
    description = "Detects execution and usage of the DSInternals PowerShell module. Which can be used to perform what might be considered as suspicious activity such as dumping DPAPI backup keys or manipulating NTDS.DIT files. The DSInternals PowerShell Module exposes several internal features of Active Directory and Azure Active Directory. These include FIDO2 and NGC key auditing, offline ntds.dit file manipulation, password auditing, DC recovery from IFM backups and password hash calculation."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.ScriptBlockText = /.*Add-ADDBSidHistory.*/ nocase or $e.ScriptBlockText = /.*Add-ADNgcKey.*/ nocase or $e.ScriptBlockText = /.*Add-ADReplNgcKey.*/ nocase or $e.ScriptBlockText = /.*ConvertFrom-ADManagedPasswordBlob.*/ nocase or $e.ScriptBlockText = /.*ConvertFrom-GPPrefPassword.*/ nocase or $e.ScriptBlockText = /.*ConvertFrom-ManagedPasswordBlob.*/ nocase or $e.ScriptBlockText = /.*ConvertFrom-UnattendXmlPassword.*/ nocase or $e.ScriptBlockText = /.*ConvertFrom-UnicodePassword.*/ nocase or $e.ScriptBlockText = /.*ConvertTo-AADHash.*/ nocase or $e.ScriptBlockText = /.*ConvertTo-GPPrefPassword.*/ nocase or $e.ScriptBlockText = /.*ConvertTo-KerberosKey.*/ nocase or $e.ScriptBlockText = /.*ConvertTo-LMHash.*/ nocase or $e.ScriptBlockText = /.*ConvertTo-MsoPasswordHash.*/ nocase or $e.ScriptBlockText = /.*ConvertTo-NTHash.*/ nocase or $e.ScriptBlockText = /.*ConvertTo-OrgIdHash.*/ nocase or $e.ScriptBlockText = /.*ConvertTo-UnicodePassword.*/ nocase or $e.ScriptBlockText = /.*Disable-ADDBAccount.*/ nocase or $e.ScriptBlockText = /.*Enable-ADDBAccount.*/ nocase or $e.ScriptBlockText = /.*Get-ADDBAccount.*/ nocase or $e.ScriptBlockText = /.*Get-ADDBBackupKey.*/ nocase or $e.ScriptBlockText = /.*Get-ADDBDomainController.*/ nocase or $e.ScriptBlockText = /.*Get-ADDBGroupManagedServiceAccount.*/ nocase or $e.ScriptBlockText = /.*Get-ADDBKdsRootKey.*/ nocase or $e.ScriptBlockText = /.*Get-ADDBSchemaAttribute.*/ nocase or $e.ScriptBlockText = /.*Get-ADDBServiceAccount.*/ nocase or $e.ScriptBlockText = /.*Get-ADDefaultPasswordPolicy.*/ nocase or $e.ScriptBlockText = /.*Get-ADKeyCredential.*/ nocase or $e.ScriptBlockText = /.*Get-ADPasswordPolicy.*/ nocase or $e.ScriptBlockText = /.*Get-ADReplAccount.*/ nocase or $e.ScriptBlockText = /.*Get-ADReplBackupKey.*/ nocase or $e.ScriptBlockText = /.*Get-ADReplicationAccount.*/ nocase or $e.ScriptBlockText = /.*Get-ADSIAccount.*/ nocase or $e.ScriptBlockText = /.*Get-AzureADUserEx.*/ nocase or $e.ScriptBlockText = /.*Get-BootKey.*/ nocase or $e.ScriptBlockText = /.*Get-KeyCredential.*/ nocase or $e.ScriptBlockText = /.*Get-LsaBackupKey.*/ nocase or $e.ScriptBlockText = /.*Get-LsaPolicy.*/ nocase or $e.ScriptBlockText = /.*Get-SamPasswordPolicy.*/ nocase or $e.ScriptBlockText = /.*Get-SysKey.*/ nocase or $e.ScriptBlockText = /.*Get-SystemKey.*/ nocase or $e.ScriptBlockText = /.*New-ADDBRestoreFromMediaScript.*/ nocase or $e.ScriptBlockText = /.*New-ADKeyCredential.*/ nocase or $e.ScriptBlockText = /.*New-ADNgcKey.*/ nocase or $e.ScriptBlockText = /.*New-NTHashSet.*/ nocase or $e.ScriptBlockText = /.*Remove-ADDBObject.*/ nocase or $e.ScriptBlockText = /.*Save-DPAPIBlob.*/ nocase or $e.ScriptBlockText = /.*Set-ADAccountPasswordHash.*/ nocase or $e.ScriptBlockText = /.*Set-ADDBAccountPassword.*/ nocase or $e.ScriptBlockText = /.*Set-ADDBBootKey.*/ nocase or $e.ScriptBlockText = /.*Set-ADDBDomainController.*/ nocase or $e.ScriptBlockText = /.*Set-ADDBPrimaryGroup.*/ nocase or $e.ScriptBlockText = /.*Set-ADDBSysKey.*/ nocase or $e.ScriptBlockText = /.*Set-AzureADUserEx.*/ nocase or $e.ScriptBlockText = /.*Set-LsaPolicy.*/ nocase or $e.ScriptBlockText = /.*Set-SamAccountPasswordHash.*/ nocase or $e.ScriptBlockText = /.*Set-WinUserPasswordHash.*/ nocase or $e.ScriptBlockText = /.*Test-ADDBPasswordQuality.*/ nocase or $e.ScriptBlockText = /.*Test-ADPasswordQuality.*/ nocase or $e.ScriptBlockText = /.*Test-ADReplPasswordQuality.*/ nocase or $e.ScriptBlockText = /.*Test-PasswordQuality.*/ nocase or $e.ScriptBlockText = /.*Unlock-ADDBAccount.*/ nocase or $e.ScriptBlockText = /.*Write-ADNgcKey.*/ nocase or $e.ScriptBlockText = /.*Write-ADReplNgcKey.*/ nocase))

  condition:
    $e
}
