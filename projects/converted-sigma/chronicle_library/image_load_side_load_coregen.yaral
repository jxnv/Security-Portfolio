// Title: Potential DLL Sideloading Using Coregen.exe
// ID: 0fa66f66-e3f6-4a9c-93f8-4f2610b00171
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-12-31
// Tags: attack.privilege-escalation, attack.stealth, attack.t1218, attack.t1055
// Description: Detect usage of the "coregen.exe" (Microsoft CoreCLR Native Image Generator) binary to sideload arbitrary DLLs.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 0fa66f66_e3f6_4a9c_93f8_4f2610b00171 {
  meta:
    title = "Potential DLL Sideloading Using Coregen.exe"
    description = "Detect usage of the "coregen.exe" (Microsoft CoreCLR Native Image Generator) binary to sideload arbitrary DLLs."
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.target.process.file.full_path = /.*\\coregen.exe$/ nocase) and not((($e.ImageLoaded = /^C:\\Program Files (x86)\\Microsoft Silverlight\\.*/ nocase or $e.ImageLoaded = /^C:\\Program Files\\Microsoft Silverlight\\.*/ nocase or $e.ImageLoaded = /^C:\\Windows\\System32\\.*/ nocase or $e.ImageLoaded = /^C:\\Windows\\SysWOW64\\.*/ nocase))))

  condition:
    $e
}
