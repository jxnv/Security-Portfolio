// Description: Detects when a configuration change is made to an applications URI.
// URIs for domain names that no longer exist (dangling URIs), not using HTTPS, wildcards at the end of the domain, URIs that are no unique to that app, or URIs that point to domains you do not control should be investigated.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 0055ad1f_be85_4798_83cf_a6da17c993b3 {
  meta:
    title = "Application URI Configuration Changes"
    description = "Detects when a configuration change is made to an applications URI. URIs for domain names that no longer exist (dangling URIs), not using HTTPS, wildcards at the end of the domain, URIs that are no unique to that app, or URIs that point to domains you do not control should be investigated."
    author = "Mark Morowczynski '@markmorow', Bailey Bercik '@baileybercik'"
    severity = "HIGH"

  events:
    ($e.properties.message = "Update Application Sucess- Property Name AppAddress")

  condition:
    $e
}
