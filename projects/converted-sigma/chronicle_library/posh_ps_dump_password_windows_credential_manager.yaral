// Title: Dump Credentials from Windows Credential Manager With PowerShell
// ID: 99c49d9c-34ea-45f7-84a7-4751ae6b2cbc
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-12-20
// Tags: attack.credential-access, attack.t1555
// Description: Adversaries may search for common password storage locations to obtain user credentials.
// Passwords are stored in several places on a system, depending on the operating system or application holding the credentials.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 99c49d9c_34ea_45f7_84a7_4751ae6b2cbc {
  meta:
    title = "Dump Credentials from Windows Credential Manager With PowerShell"
    description = "Adversaries may search for common password storage locations to obtain user credentials. Passwords are stored in several places on a system, depending on the operating system or application holding the credentials."
    author = "frack113"
    severity = "MEDIUM"

  events:
    ((($e.ScriptBlockText = /.*Get-PasswordVaultCredentials.*/ nocase or $e.ScriptBlockText = /.*Get-CredManCreds.*/ nocase)) or (($e.ScriptBlockText = /.*New-Object.*/ nocase and $e.ScriptBlockText = /.*Windows.Security.Credentials.PasswordVault.*/ nocase)) or (($e.ScriptBlockText = /.*New-Object.*/ nocase and $e.ScriptBlockText = /.*Microsoft.CSharp.CSharpCodeProvider.*/ nocase and $e.ScriptBlockText = /.*[System.Runtime.InteropServices.RuntimeEnvironment]::GetRuntimeDirectory()).*/ nocase and $e.ScriptBlockText = /.*Collections.ArrayList.*/ nocase and $e.ScriptBlockText = /.*System.CodeDom.Compiler.CompilerParameters.*/ nocase)))

  condition:
    $e
}
