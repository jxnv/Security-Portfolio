rule 1ff315dc_2a3a_4b71_8dde_873818d25d39 {
  meta:
    title = "New BITS Job Created Via Bitsadmin"
    description = "Detects the creation of a new bits job by Bitsadmin"
    author = "frack113"
    severity = "LOW"

  events:
    ($e.EventID = 3 and $e.processPath = /.*\\bitsadmin.exe$/ nocase)

  condition:
    $e
}
