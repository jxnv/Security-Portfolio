// Title: Office Macro File Download
// ID: 0e29e3a7-1ad8-40aa-b691-9f82ecd33d66
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-23
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects the creation of a new office macro files on the system via an application (browser, mail client).
// This can help identify potential malicious activity, such as the download of macro-enabled documents that could be used for exploitation.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 0e29e3a7_1ad8_40aa_b691_9f82ecd33d66 {
  meta:
    title = "Office Macro File Download"
    description = "Detects the creation of a new office macro files on the system via an application (browser, mail client). This can help identify potential malicious activity, such as the download of macro-enabled documents that could be used for exploitation."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "LOW"

  events:
    (((($e.target.file.full_path = /.*.docm$/ nocase or $e.target.file.full_path = /.*.dotm$/ nocase or $e.target.file.full_path = /.*.xlsm$/ nocase or $e.target.file.full_path = /.*.xltm$/ nocase or $e.target.file.full_path = /.*.potm$/ nocase or $e.target.file.full_path = /.*.pptm$/ nocase)) or (($e.target.file.full_path = /.*.docm:Zone.*/ nocase or $e.target.file.full_path = /.*.dotm:Zone.*/ nocase or $e.target.file.full_path = /.*.xlsm:Zone.*/ nocase or $e.target.file.full_path = /.*.xltm:Zone.*/ nocase or $e.target.file.full_path = /.*.potm:Zone.*/ nocase or $e.target.file.full_path = /.*.pptm:Zone.*/ nocase))) and (($e.target.process.file.full_path = /.*\\RuntimeBroker.exe$/ nocase or $e.target.process.file.full_path = /.*\\outlook.exe$/ nocase or $e.target.process.file.full_path = /.*\\thunderbird.exe$/ nocase or $e.target.process.file.full_path = /.*\\brave.exe$/ nocase or $e.target.process.file.full_path = /.*\\chrome.exe$/ nocase or $e.target.process.file.full_path = /.*\\firefox.exe$/ nocase or $e.target.process.file.full_path = /.*\\iexplore.exe$/ nocase or $e.target.process.file.full_path = /.*\\maxthon.exe$/ nocase or $e.target.process.file.full_path = /.*\\MicrosoftEdge.exe$/ nocase or $e.target.process.file.full_path = /.*\\msedge.exe$/ nocase or $e.target.process.file.full_path = /.*\\msedgewebview2.exe$/ nocase or $e.target.process.file.full_path = /.*\\opera.exe$/ nocase or $e.target.process.file.full_path = /.*\\safari.exe$/ nocase or $e.target.process.file.full_path = /.*\\seamonkey.exe$/ nocase or $e.target.process.file.full_path = /.*\\vivaldi.exe$/ nocase or $e.target.process.file.full_path = /.*\\whale.exe$/ nocase)))

  condition:
    $e
}
