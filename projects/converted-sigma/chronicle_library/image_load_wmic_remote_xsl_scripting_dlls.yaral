// Title: WMIC Loading Scripting Libraries
// ID: 06ce37c2-61ab-4f05-9ff5-b1a96d18ae32
// Status: test
// Level: medium
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2020-10-17
// Tags: attack.stealth, attack.t1220
// Description: Detects threat actors proxy executing code and bypassing application controls by leveraging wmic and the `/FORMAT` argument switch to download and execute an XSL file (i.e js, vbs, etc).
// It could be an indicator of SquiblyTwo technique, which uses Windows Management Instrumentation (WMI) to execute malicious code.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 06ce37c2_61ab_4f05_9ff5_b1a96d18ae32 {
  meta:
    title = "WMIC Loading Scripting Libraries"
    description = "Detects threat actors proxy executing code and bypassing application controls by leveraging wmic and the `/FORMAT` argument switch to download and execute an XSL file (i.e js, vbs, etc). It could be an indicator of SquiblyTwo technique, which uses Windows Management Instrumentation (WMI) to execute malicious code."
    author = "Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)"
    severity = "MEDIUM"

  events:
    ($e.target.process.file.full_path = /.*\\wmic.exe$/ nocase and ($e.ImageLoaded = /.*\\jscript.dll$/ nocase or $e.ImageLoaded = /.*\\vbscript.dll$/ nocase))

  condition:
    $e
}
