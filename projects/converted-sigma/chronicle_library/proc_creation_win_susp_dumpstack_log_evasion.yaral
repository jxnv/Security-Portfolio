// Title: DumpStack.log Defender Evasion
// ID: 4f647cfa-b598-4e12-ad69-c68dd16caef8
// Status: test
// Level: critical
// Author: Florian Roth (Nextron Systems)
// Date: 2022-01-06
// Tags: attack.defense-impairment
// Description: Detects the use of the filename DumpStack.log to evade Microsoft Defender
// Converted by: Sigma Universal SIEM/EDR CLI

rule 4f647cfa_b598_4e12_ad69_c68dd16caef8 {
  meta:
    title = "DumpStack.log Defender Evasion"
    description = "Detects the use of the filename DumpStack.log to evade Microsoft Defender"
    author = "Florian Roth (Nextron Systems)"
    severity = "CRITICAL"

  events:
    (($e.target.process.file.full_path = /.*\\DumpStack.log$/ nocase) or ($e.target.process.command_line = /.* -o DumpStack.log.*/ nocase))

  condition:
    $e
}
