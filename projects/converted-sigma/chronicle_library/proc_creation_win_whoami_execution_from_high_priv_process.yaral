// Title: Whoami.EXE Execution From Privileged Process
// ID: 79ce34ca-af29-4d0e-b832-fc1b377020db
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Teymur Kheirkhabarov
// Date: 2022-01-28
// Tags: attack.privilege-escalation, attack.discovery, attack.t1033
// Description: Detects the execution of "whoami.exe" by privileged accounts that are often abused by threat actors
// Converted by: Sigma Universal SIEM/EDR CLI

rule 79ce34ca_af29_4d0e_b832_fc1b377020db {
  meta:
    title = "Whoami.EXE Execution From Privileged Process"
    description = "Detects the execution of "whoami.exe" by privileged accounts that are often abused by threat actors"
    author = "Florian Roth (Nextron Systems), Teymur Kheirkhabarov"
    severity = "HIGH"

  events:
    ((($e.target.process.file.name = "whoami.exe") or ($e.target.process.file.full_path = /.*\\whoami.exe$/ nocase)) and (($e.target.user.userid = /.*AUTHORI.*/ nocase or $e.target.user.userid = /.*AUTORI.*/ nocase or $e.target.user.userid = /.*TrustedInstaller.*/ nocase)))

  condition:
    $e
}
