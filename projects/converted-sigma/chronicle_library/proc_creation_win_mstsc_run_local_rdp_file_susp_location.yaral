// Title: Suspicious Mstsc.EXE Execution With Local RDP File
// ID: 6e22722b-dfb1-4508-a911-49ac840b40f8
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects potential RDP connection via Mstsc using a local ".rdp" file located in suspicious locations.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 6e22722b_dfb1_4508_a911_49ac840b40f8 {
  meta:
    title = "Suspicious Mstsc.EXE Execution With Local RDP File"
    description = "Detects potential RDP connection via Mstsc using a local ".rdp" file located in suspicious locations."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*.rdp$/ nocase or $e.target.process.command_line = /.*.rdp\"$/ nocase)) and (($e.target.process.file.full_path = /.*\\mstsc.exe$/ nocase) or ($e.target.process.file.name = "mstsc.exe")) and (($e.target.process.command_line = /.*:\\Users\\Public\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\System32\\spool\\drivers\\color.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\System32\\Tasks_Migrated .*/ nocase or $e.target.process.command_line = /.*:\\Windows\\Tasks\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\Temp\\.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\Tracing\\.*/ nocase or $e.target.process.command_line = /.*\\AppData\\Local\\Temp\\.*/ nocase or $e.target.process.command_line = /.*\\Downloads\\.*/ nocase)))

  condition:
    $e
}
