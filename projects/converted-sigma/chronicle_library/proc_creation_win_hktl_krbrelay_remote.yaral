// Title: HackTool - RemoteKrbRelay Execution
// ID: a7664b14-75fb-4a50-a223-cb9bc0afbacf
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-06-27
// Tags: attack.credential-access, attack.t1558.003
// Description: Detects the use of RemoteKrbRelay, a Kerberos relaying tool via CommandLine flags and PE metadata.
// Converted by: Sigma Universal SIEM/EDR CLI

rule a7664b14_75fb_4a50_a223_cb9bc0afbacf {
  meta:
    title = "HackTool - RemoteKrbRelay Execution"
    description = "Detects the use of RemoteKrbRelay, a Kerberos relaying tool via CommandLine flags and PE metadata."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.file.full_path = /.*\\RemoteKrbRelay.exe$/ nocase) or ($e.target.process.file.name = "RemoteKrbRelay.exe")) or (($e.target.process.command_line = /.* -clsid .*/ nocase and $e.target.process.command_line = /.* -target .*/ nocase and $e.target.process.command_line = /.* -victim .*/ nocase)) or (($e.target.process.command_line = /.*-rbcd .*/ nocase) and (($e.target.process.command_line = /.*-cn .*/ nocase or $e.target.process.command_line = /.*--computername .*/ nocase))) or ($e.target.process.command_line = /.*-chp .*/ nocase and ($e.target.process.command_line = /.*-chpPass .*/ nocase and $e.target.process.command_line = /.*-chpUser .*/ nocase)) or (($e.target.process.command_line = /.*-addgroupmember .*/ nocase and $e.target.process.command_line = /.*-group .*/ nocase and $e.target.process.command_line = /.*-groupuser .*/ nocase)) or (($e.target.process.command_line = /.*-smb .*/ nocase and $e.target.process.command_line = /.*--smbkeyword .*/ nocase) and ($e.target.process.command_line = /.*interactive.*/ nocase or $e.target.process.command_line = /.*secrets.*/ nocase or $e.target.process.command_line = /.*service-add.*/ nocase)))

  condition:
    $e
}
