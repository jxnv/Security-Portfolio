// Title: Suspicious ShellExec_RunDLL Call Via Ordinal
// ID: 8823e85d-31d8-473e-b7f4-92da070f0fc6
// Status: test
// Level: high
// Author: Swachchhanda Shrawan Poudel
// Date: 2024-12-01
// Tags: attack.stealth, attack.t1218.011
// Description: Detects suspicious call to the "ShellExec_RunDLL" exported function of SHELL32.DLL through the ordinal number to launch other commands.
// Adversary might only use the ordinal number in order to bypass existing detection that alert on usage of ShellExec_RunDLL on CommandLine.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 8823e85d_31d8_473e_b7f4_92da070f0fc6 {
  meta:
    title = "Suspicious ShellExec_RunDLL Call Via Ordinal"
    description = "Detects suspicious call to the "ShellExec_RunDLL" exported function of SHELL32.DLL through the ordinal number to launch other commands. Adversary might only use the ordinal number in order to bypass existing detection that alert on usage of ShellExec_RunDLL on CommandLine."
    author = "Swachchhanda Shrawan Poudel"
    severity = "HIGH"

  events:
    ((($e.principal.process.command_line = /.*SHELL32.DLL.*/ nocase) and (($e.principal.process.command_line = /.*#568.*/ nocase or $e.principal.process.command_line = /.*#570.*/ nocase or $e.principal.process.command_line = /.*#572.*/ nocase or $e.principal.process.command_line = /.*#576.*/ nocase))) and ((($e.target.process.file.full_path = /.*\\bash.exe$/ nocase or $e.target.process.file.full_path = /.*\\bitsadmin.exe$/ nocase or $e.target.process.file.full_path = /.*\\cmd.exe$/ nocase or $e.target.process.file.full_path = /.*\\cscript.exe$/ nocase or $e.target.process.file.full_path = /.*\\curl.exe$/ nocase or $e.target.process.file.full_path = /.*\\mshta.exe$/ nocase or $e.target.process.file.full_path = /.*\\msiexec.exe$/ nocase or $e.target.process.file.full_path = /.*\\msxsl.exe$/ nocase or $e.target.process.file.full_path = /.*\\odbcconf.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase or $e.target.process.file.full_path = /.*\\regsvr32.exe$/ nocase or $e.target.process.file.full_path = /.*\\schtasks.exe$/ nocase or $e.target.process.file.full_path = /.*\\wmic.exe$/ nocase or $e.target.process.file.full_path = /.*\\wscript.exe$/ nocase)) or ((($e.principal.process.command_line = /.*comspec.*/ nocase or $e.principal.process.command_line = /.*iex.*/ nocase or $e.principal.process.command_line = /.*Invoke-.*/ nocase or $e.principal.process.command_line = /.*msiexec.*/ nocase or $e.principal.process.command_line = /.*odbcconf.*/ nocase or $e.principal.process.command_line = /.*regsvr32.*/ nocase)) or (($e.principal.process.command_line = /.*\\Desktop\\.*/ nocase or $e.principal.process.command_line = /.*\\ProgramData\\.*/ nocase or $e.principal.process.command_line = /.*\\Temp\\.*/ nocase or $e.principal.process.command_line = /.*\\Users\\Public\\.*/ nocase)))))

  condition:
    $e
}
