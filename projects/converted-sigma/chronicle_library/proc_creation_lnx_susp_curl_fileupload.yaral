// Title: Suspicious Curl File Upload - Linux
// ID: 00b90cc1-17ec-402c-96ad-3a8117d7a582
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Cedric MAURUGEON (Update)
// Date: 2022-09-15
// Tags: attack.exfiltration, attack.command-and-control, attack.t1567, attack.t1105
// Description: Detects a suspicious curl process start the adds a file to a web request
// Converted by: Sigma Universal SIEM/EDR CLI

rule 00b90cc1_17ec_402c_96ad_3a8117d7a582 {
  meta:
    title = "Suspicious Curl File Upload - Linux"
    description = "Detects a suspicious curl process start the adds a file to a web request"
    author = "Nasreddine Bencherchali (Nextron Systems), Cedric MAURUGEON (Update)"
    severity = "MEDIUM"

  events:
    ((((($e.target.process.command_line = /.* --form.*/ nocase or $e.target.process.command_line = /.* --upload-file .*/ nocase or $e.target.process.command_line = /.* --data .*/ nocase or $e.target.process.command_line = /.* --data-.*/ nocase)) or ($e.target.process.command_line = /\s-[FTd]\s/ nocase)) and ($e.target.process.file.full_path = /.*/curl$/ nocase)) and not((($e.target.process.command_line = /.*://localhost.*/ nocase or $e.target.process.command_line = /.*://127.0.0.1.*/ nocase))))

  condition:
    $e
}
