// Title: PowerShell Module File Created
// ID: e36941d0-c0f0-443f-bc6f-cb2952eb69ea
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-09
// Tags: attack.persistence
// Description: Detects the creation of a new PowerShell module ".psm1", ".psd1", ".dll", ".ps1", etc.
// Converted by: Sigma Universal SIEM/EDR CLI

rule e36941d0_c0f0_443f_bc6f_cb2952eb69ea {
  meta:
    title = "PowerShell Module File Created"
    description = "Detects the creation of a new PowerShell module ".psm1", ".psd1", ".dll", ".ps1", etc."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "LOW"

  events:
    (($e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase) and ($e.target.file.full_path = /.*\\WindowsPowerShell\\Modules\\.*/ nocase or $e.target.file.full_path = /.*\\PowerShell\\7\\Modules\\.*/ nocase))

  condition:
    $e
}
