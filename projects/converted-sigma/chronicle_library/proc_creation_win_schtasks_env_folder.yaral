// Title: Schedule Task Creation From Env Variable Or Potentially Suspicious Path Via Schtasks.EXE
// ID: 81325ce1-be01-4250-944f-b4789644556f
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-21
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects Schtask creations that point to a suspicious folder or an environment variable often used by malware
// Converted by: Sigma Universal SIEM/EDR CLI

rule 81325ce1_be01_4250_944f_b4789644556f {
  meta:
    title = "Schedule Task Creation From Env Variable Or Potentially Suspicious Path Via Schtasks.EXE"
    description = "Detects Schtask creations that point to a suspicious folder or an environment variable often used by malware"
    author = "Florian Roth (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((((($e.target.process.command_line = /.*:\\Perflogs.*/ nocase or $e.target.process.command_line = /.*:\\Users\\All Users\\.*/ nocase or $e.target.process.command_line = /.*:\\Users\\Default\\.*/ nocase or $e.target.process.command_line = /.*:\\Users\\Public.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\Temp.*/ nocase or $e.target.process.command_line = /.*\\AppData\\Local\\.*/ nocase or $e.target.process.command_line = /.*\\AppData\\Roaming\\.*/ nocase or $e.target.process.command_line = /.*%AppData%.*/ nocase or $e.target.process.command_line = /.*%Public%.*/ nocase)) and ($e.target.process.file.full_path = /.*\\schtasks.exe$/ nocase and $e.target.process.command_line = /.* /create .*/ nocase)) or (($e.principal.process.command_line = /.*\\svchost.exe -k netsvcs -p -s Schedule$/ nocase) and (($e.target.process.command_line = /.*:\\Perflogs.*/ nocase or $e.target.process.command_line = /.*:\\Windows\\Temp.*/ nocase or $e.target.process.command_line = /.*\\Users\\Public.*/ nocase or $e.target.process.command_line = /.*%Public%.*/ nocase)))) and not(((($e.target.process.command_line = /.*/Create /Xml .*/ nocase and $e.target.process.command_line = /.*\\Temp\\.CR..*/ nocase and $e.target.process.command_line = /.*\\Avira_Security_Installation.xml.*/ nocase)) or (($e.target.process.command_line = /.*/Create /F /TN.*/ nocase and $e.target.process.command_line = /.*/Xml .*/ nocase and $e.target.process.command_line = /.*\\Temp\\.*/ nocase and $e.target.process.command_line = /.*Avira_.*/ nocase) and ($e.target.process.command_line = /.*.tmp\\UpdateFallbackTask.xml.*/ nocase or $e.target.process.command_line = /.*.tmp\\WatchdogServiceControlManagerTimeout.xml.*/ nocase or $e.target.process.command_line = /.*.tmp\\SystrayAutostart.xml.*/ nocase or $e.target.process.command_line = /.*.tmp\\MaintenanceTask.xml.*/ nocase)) or (($e.target.process.command_line = /.*\\Temp\\.*/ nocase and $e.target.process.command_line = /.*/Create /TN \"klcp_update\" /XML .*/ nocase and $e.target.process.command_line = /.*\\klcp_update_task.xml.*/ nocase)) or (($e.principal.process.command_line = /.*unattended.ini.*/ nocase) or ($e.target.process.command_line = /.*update_task.xml.*/ nocase)) or ($e.target.process.command_line = /.*/Create /TN TVInstallRestore /TR.*/ nocase))))

  condition:
    $e
}
