// Title: WMIC Unquoted Services Path Lookup - PowerShell
// ID: 09658312-bc27-4a3b-91c5-e49ab9046d1b
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-20
// Tags: attack.execution, attack.t1047
// Description: Detects known WMI recon method to look for unquoted service paths, often used by pentest inside of powershell scripts attackers enum scripts
// Converted by: Sigma Universal SIEM/EDR CLI

rule 09658312_bc27_4a3b_91c5_e49ab9046d1b {
  meta:
    title = "WMIC Unquoted Services Path Lookup - PowerShell"
    description = "Detects known WMI recon method to look for unquoted service paths, often used by pentest inside of powershell scripts attackers enum scripts"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.ScriptBlockText = /.*Get-WmiObject .*/ nocase or $e.ScriptBlockText = /.*gwmi .*/ nocase) and ($e.ScriptBlockText = /.* Win32_Service .*/ nocase and $e.ScriptBlockText = /.*Name.*/ nocase and $e.ScriptBlockText = /.*DisplayName.*/ nocase and $e.ScriptBlockText = /.*PathName.*/ nocase and $e.ScriptBlockText = /.*StartMode.*/ nocase))

  condition:
    $e
}
