// Title: Antivirus - Password Dumper Signature
// ID: 78cc2dd2-7d20-4d32-93ff-057084c38b93
// Status: stable
// Level: critical
// Author: Florian Roth (Nextron Systems), Arnim Rupp
// Date: 2018-09-09
// Tags: attack.credential-access, attack.t1003, attack.t1558, attack.t1003.001, attack.t1003.002
// Description: Detects a highly relevant Antivirus alert that reports password dumpers and stealers.
// This event must not be ignored just because the AV has blocked the malware but investigate, how it came there in the first place and check if passwords need to be reset.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 78cc2dd2_7d20_4d32_93ff_057084c38b93 {
  meta:
    title = "Antivirus - Password Dumper Signature"
    description = "Detects a highly relevant Antivirus alert that reports password dumpers and stealers. This event must not be ignored just because the AV has blocked the malware but investigate, how it came there in the first place and check if passwords need to be reset."
    author = "Florian Roth (Nextron Systems), Arnim Rupp"
    severity = "CRITICAL"

  events:
    (($e.Signature = /^PWS.*/ nocase) or (($e.Signature = /.*Certify.*/ nocase or $e.Signature = /.*DCSync.*/ nocase or $e.Signature = /.*Creddump.*/ nocase or $e.Signature = /.*DumpCreds.*/ nocase or $e.Signature = /.*DumpLsass.*/ nocase or $e.Signature = /.*DumpPert.*/ nocase or $e.Signature = /.*FormBook.*/ nocase or $e.Signature = /.*HTool/WCE.*/ nocase or $e.Signature = /.*Kekeo.*/ nocase or $e.Signature = /.*Lazagne.*/ nocase or $e.Signature = /.*LsassDump.*/ nocase or $e.Signature = /.*Lummast.*/ nocase or $e.Signature = /.*Mimikatz.*/ nocase or $e.Signature = /.*MultiDump.*/ nocase or $e.Signature = /.*Multiverze.*/ nocase or $e.Signature = /.*Nanodump.*/ nocase or $e.Signature = /.*NativeDump.*/ nocase or $e.Signature = /.*Outflank.*/ nocase or $e.Signature = /.*PShlSpy.*/ nocase or $e.Signature = /.*PSWTool.*/ nocase or $e.Signature = /.*PWCrack.*/ nocase or $e.Signature = /.*PWDump.*/ nocase or $e.Signature = /.*PWS..*/ nocase or $e.Signature = /.*PWSX.*/ nocase or $e.Signature = /.*pypykatz.*/ nocase or $e.Signature = /.*Rubeus.*/ nocase or $e.Signature = /.*SafetyKatz.*/ nocase or $e.Signature = /.*SecurityTool.*/ nocase or $e.Signature = /.*SharpChrome.*/ nocase or $e.Signature = /.*SharpDPAPI.*/ nocase or $e.Signature = /.*SharpDump.*/ nocase or $e.Signature = /.*SharpKatz.*/ nocase or $e.Signature = /.*SharpS..*/ nocase or $e.Signature = /.*ShpKatz.*/ nocase or $e.Signature = /.*Steal.*/ nocase or $e.Signature = /.*TrickDump.*/ nocase or $e.Signature = /.*wsass.*/ nocase)))

  condition:
    $e
}
