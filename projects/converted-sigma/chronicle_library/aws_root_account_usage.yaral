rule 8ad1600d_e9dc_4251_b0ee_a65268f29add {
  meta:
    title = "AWS Root Credentials"
    description = "Detects AWS root account usage"
    author = "vitaliy0x1"
    severity = "MEDIUM"

  events:
    (($e.userIdentity.type = "Root") and not(($e.eventType = "AwsServiceEvent")))

  condition:
    $e
}
