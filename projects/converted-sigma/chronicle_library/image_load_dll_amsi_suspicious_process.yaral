// Title: Amsi.DLL Loaded Via LOLBIN Process
// ID: 6ec86d9e-912e-4726-91a2-209359b999b9
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-01
// Tags: attack.defense-impairment
// Description: Detects loading of "Amsi.dll" by a living of the land process. This could be an indication of a "PowerShell without PowerShell" attack
// Converted by: Sigma Universal SIEM/EDR CLI

rule 6ec86d9e_912e_4726_91a2_209359b999b9 {
  meta:
    title = "Amsi.DLL Loaded Via LOLBIN Process"
    description = "Detects loading of "Amsi.dll" by a living of the land process. This could be an indication of a "PowerShell without PowerShell" attack"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ($e.ImageLoaded = /.*\\amsi.dll$/ nocase and ($e.target.process.file.full_path = /.*\\ExtExport.exe$/ nocase or $e.target.process.file.full_path = /.*\\odbcconf.exe$/ nocase or $e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase))

  condition:
    $e
}
