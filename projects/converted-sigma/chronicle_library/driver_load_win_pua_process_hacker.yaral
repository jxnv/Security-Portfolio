  events:
    (($e.ImageLoaded = /.*\\kprocesshacker.sys$/ nocase) or (($e.Hashes = /.*IMPHASH=821D74031D3F625BCBD0DF08B70F1E77.*/ nocase or $e.Hashes = /.*IMPHASH=F86759BB4DE4320918615DC06E998A39.*/ nocase or $e.Hashes = /.*IMPHASH=0A64EEB85419257D0CE32BD5D55C3A18.*/ nocase or $e.Hashes = /.*IMPHASH=6E7B34DFC017700B1517B230DF6FF0D0.*/ nocase)))

