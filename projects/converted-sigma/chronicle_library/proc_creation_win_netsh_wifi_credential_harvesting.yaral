// Title: Harvesting Of Wifi Credentials Via Netsh.EXE
// ID: 42b1a5b8-353f-4f10-b256-39de4467faff
// Status: test
// Level: medium
// Author: Andreas Hunkeler (@Karneades), oscd.community
// Date: 2020-04-20
// Tags: attack.discovery, attack.credential-access, attack.t1040
// Description: Detect the harvesting of wifi credentials using netsh.exe
// Converted by: Sigma Universal SIEM/EDR CLI

rule 42b1a5b8_353f_4f10_b256_39de4467faff {
  meta:
    title = "Harvesting Of Wifi Credentials Via Netsh.EXE"
    description = "Detect the harvesting of wifi credentials using netsh.exe"
    author = "Andreas Hunkeler (@Karneades), oscd.community"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*wlan.*/ nocase and $e.target.process.command_line = /.* s.*/ nocase and $e.target.process.command_line = /.* p.*/ nocase and $e.target.process.command_line = /.* k.*/ nocase and $e.target.process.command_line = /.*=clear.*/ nocase)) and (($e.target.process.file.full_path = /.*\\netsh.exe$/ nocase) or ($e.target.process.file.name = "netsh.exe")))

  condition:
    $e
}
