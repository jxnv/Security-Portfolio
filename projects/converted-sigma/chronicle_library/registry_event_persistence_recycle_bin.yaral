// Tags: attack.privilege-escalation, attack.persistence, attack.t1547
// Description: Detects persistence registry keys for Recycle Bin
// Converted by: Sigma Universal SIEM/EDR CLI

rule 277efb8f_60be_4f10_b4d3_037802f37167 {
  meta:
    title = "Registry Persistence Mechanisms in Recycle Bin"
    description = "Detects persistence registry keys for Recycle Bin"
    author = "frack113"
    severity = "HIGH"

  events:
    (($e.EventType = "RenameKey" and $e.NewName = /.*\\CLSID\\{645FF040-5081-101B-9F08-00AA002F954E}\\shell\\open.*/ nocase) or ($e.EventType = "SetValue" and $e.TargetObject = /.*\\CLSID\\{645FF040-5081-101B-9F08-00AA002F954E}\\shell\\open\\command\\(Default).*/ nocase))

  condition:
    $e
}
