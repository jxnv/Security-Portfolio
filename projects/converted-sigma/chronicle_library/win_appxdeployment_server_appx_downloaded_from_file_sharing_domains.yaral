// Title: Remote AppX Package Downloaded from File Sharing or CDN Domain
// ID: 8b48ad89-10d8-4382-a546-50588c410f0d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-11
// Tags: attack.stealth
// Description: Detects an appx package that was added to the pipeline of the "to be processed" packages which was downloaded from a file sharing or CDN domain.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 8b48ad89_10d8_4382_a546_50588c410f0d {
  meta:
    title = "Remote AppX Package Downloaded from File Sharing or CDN Domain"
    description = "Detects an appx package that was added to the pipeline of the "to be processed" packages which was downloaded from a file sharing or CDN domain."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ($e.EventID = 854 and ($e.Path = /.*.githubusercontent.com.*/ nocase or $e.Path = /.*0x0.st.*/ nocase or $e.Path = /.*anonfiles.com.*/ nocase or $e.Path = /.*bashupload.com.*/ nocase or $e.Path = /.*cdn.discordapp.com.*/ nocase or $e.Path = /.*chunk.io.*/ nocase or $e.Path = /.*ddns.net.*/ nocase or $e.Path = /.*dl.dropboxusercontent.com.*/ nocase or $e.Path = /.*ghostbin.co.*/ nocase or $e.Path = /.*github.com.*/ nocase or $e.Path = /.*glitch.me.*/ nocase or $e.Path = /.*gofile.io.*/ nocase or $e.Path = /.*hastebin.com.*/ nocase or $e.Path = /.*mediafire.com.*/ nocase or $e.Path = /.*mega.nz.*/ nocase or $e.Path = /.*onrender.com.*/ nocase or $e.Path = /.*pages.dev.*/ nocase or $e.Path = /.*paste.ee.*/ nocase or $e.Path = /.*pastebin.com.*/ nocase or $e.Path = /.*pastebin.pl.*/ nocase or $e.Path = /.*pastetext.net.*/ nocase or $e.Path = /.*privatlab.com.*/ nocase or $e.Path = /.*privatlab.net.*/ nocase or $e.Path = /.*send.exploit.in.*/ nocase or $e.Path = /.*sendspace.com.*/ nocase or $e.Path = /.*storage.googleapis.com.*/ nocase or $e.Path = /.*storjshare.io.*/ nocase or $e.Path = /.*supabase.co.*/ nocase or $e.Path = /.*temp.sh.*/ nocase or $e.Path = /.*transfer.sh.*/ nocase or $e.Path = /.*trycloudflare.com.*/ nocase or $e.Path = /.*ufile.io.*/ nocase or $e.Path = /.*w3spaces.com.*/ nocase or $e.Path = /.*workers.dev.*/ nocase or $e.Path = /.*x0.at.*/ nocase))

  condition:
    $e
}
