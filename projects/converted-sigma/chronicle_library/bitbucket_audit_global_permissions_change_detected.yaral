// Tags: attack.persistence, attack.privilege-escalation, attack.t1098
// Description: Detects global permissions change activity.
// Converted by: Sigma Universal SIEM/EDR CLI

rule aac6c4f4_87c7_4961_96ac_c3fd3a42c310 {
  meta:
    title = "Bitbucket Global Permission Changed"
    description = "Detects global permissions change activity."
    author = "Muhammad Faisal (@faisalusuf)"
    severity = "MEDIUM"

  events:
    ($e.auditType.category = "Permissions" and ($e.auditType.action = "Global permission remove request" or $e.auditType.action = "Global permission removed" or $e.auditType.action = "Global permission granted" or $e.auditType.action = "Global permission requested"))

  condition:
    $e
}
