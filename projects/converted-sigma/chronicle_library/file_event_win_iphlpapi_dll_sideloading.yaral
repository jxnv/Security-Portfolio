// Title: Malicious DLL File Dropped in the Teams or OneDrive Folder
// ID: 1908fcc1-1b92-4272-8214-0fbaf2fa5163
// Status: test
// Level: high
// Author: frack113
// Date: 2022-08-12
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects creation of a malicious DLL file in the location where the OneDrive or Team applications
// Upon execution of the Teams or OneDrive application, the dropped malicious DLL file ("iphlpapi.dll") is sideloaded
// Converted by: Sigma Universal SIEM/EDR CLI

rule 1908fcc1_1b92_4272_8214_0fbaf2fa5163 {
  meta:
    title = "Malicious DLL File Dropped in the Teams or OneDrive Folder"
    description = "Detects creation of a malicious DLL file in the location where the OneDrive or Team applications Upon execution of the Teams or OneDrive application, the dropped malicious DLL file ("iphlpapi.dll") is sideloaded"
    author = "frack113"
    severity = "HIGH"

  events:
    (($e.target.file.full_path = /.*iphlpapi.dll.*/ nocase and $e.target.file.full_path = /.*\\AppData\\Local\\Microsoft.*/ nocase))

  condition:
    $e
}
