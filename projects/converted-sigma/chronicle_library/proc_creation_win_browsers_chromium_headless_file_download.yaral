// Title: File Download with Headless Browser
// ID: 0e8cfe08-02c9-4815-a2f8-0d157b7ed33e
// Status: test
// Level: high
// Author: Sreeman, Florian Roth (Nextron Systems)
// Date: 2022-01-04
// Tags: attack.command-and-control, attack.stealth, attack.t1105, attack.t1564.003
// Description: Detects execution of chromium based browser in headless mode using the "dump-dom" command line to download files
// Converted by: Sigma Universal SIEM/EDR CLI

rule 0e8cfe08_02c9_4815_a2f8_0d157b7ed33e {
  meta:
    title = "File Download with Headless Browser"
    description = "Detects execution of chromium based browser in headless mode using the "dump-dom" command line to download files"
    author = "Sreeman, Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.file.full_path = /.*\\brave.exe$/ nocase or $e.target.process.file.full_path = /.*\\chrome.exe$/ nocase or $e.target.process.file.full_path = /.*\\msedge.exe$/ nocase or $e.target.process.file.full_path = /.*\\opera.exe$/ nocase or $e.target.process.file.full_path = /.*\\vivaldi.exe$/ nocase) and ($e.target.process.command_line = /.*--headless.*/ nocase and $e.target.process.command_line = /.*dump-dom.*/ nocase and $e.target.process.command_line = /.*http.*/ nocase)) and not(((($e.target.process.file.full_path = /^C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files (x86)\\Microsoft\\EdgeCore\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\Microsoft\\Edge\\Application\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\Microsoft\\EdgeCore\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\Microsoft\\EdgeWebView\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\WindowsApps\\Microsoft.MicrosoftEdge.*/ nocase) and ($e.target.process.file.full_path = /.*\\msedge.exe$/ nocase or $e.target.process.file.full_path = /.*\\msedgewebview2.exe$/ nocase or $e.target.process.file.full_path = /.*\\MicrosoftEdge.exe$/ nocase) and $e.target.process.command_line = /.*--headless --disable-gpu --disable-extensions --disable-plugins --mute-audio --no-first-run --incognito --aggressive-cache-discard --dump-dom.*/ nocase) or (($e.target.process.file.full_path = /.*\\AppData\\Local\\Microsoft\\WindowsApps\\.*/ nocase or $e.target.process.file.full_path = /.*\\Windows\\SystemApps\\Microsoft.MicrosoftEdge.*/ nocase) and ($e.target.process.file.full_path = /.*\\msedge.exe$/ nocase or $e.target.process.file.full_path = /.*\\MicrosoftEdge.exe$/ nocase) and $e.target.process.command_line = /.*--headless --disable-gpu --disable-extensions --disable-plugins --mute-audio --no-first-run --incognito --aggressive-cache-discard --dump-dom.*/ nocase))))

  condition:
    $e
}
