// Title: Local File Read Using Curl.EXE
// ID: aa6f6ea6-0676-40dd-b510-6e46f02d8867
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-07-27
// Tags: attack.execution
// Description: Detects execution of "curl.exe" with the "file://" protocol handler in order to read local files.
// Converted by: Sigma Universal SIEM/EDR CLI

rule aa6f6ea6_0676_40dd_b510_6e46f02d8867 {
  meta:
    title = "Local File Read Using Curl.EXE"
    description = "Detects execution of "curl.exe" with the "file://" protocol handler in order to read local files."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.target.process.command_line = /.*file:///.*/ nocase) and (($e.target.process.file.full_path = /.*\\curl.exe$/ nocase) or ($e.target.process.file.name = "curl.exe")))

  condition:
    $e
}
