// Title: New Cron File Created
// ID: 6c4e2f43-d94d-4ead-b64d-97e53fa2bd05
// Status: experimental
// Level: low
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research), MSTIC
// Date: 2021-10-15
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053.003
// Description: Detects the creation of cron files in Cron directories, which could indicate potential persistence mechanisms being established by an attacker.
// Note that not all cron file creations are malicious - legitimate system administration activities and software installations may also create cron files.
// This detection should be investigated in context, considering factors such as the user creating the file, the timing of creation, and the contents of the cron job.
// Focus investigation on unexpected cron files created by non-administrative users or during suspicious timeframes.
// Additionally, it is recommended to review the contents of the newly created cron files to assess their intent.
// Furthermore, it is suggested to baseline normal cron file creation and apply additional filters to reduce false positives based on the specific environment.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 6c4e2f43_d94d_4ead_b64d_97e53fa2bd05 {
  meta:
    title = "New Cron File Created"
    description = "Detects the creation of cron files in Cron directories, which could indicate potential persistence mechanisms being established by an attacker. Note that not all cron file creations are malicious - legitimate system administration activities and software installations may also create cron files. This detection should be investigated in context, considering factors such as the user creating the file, the timing of creation, and the contents of the cron job. Focus investigation on unexpected cron files created by non-administrative users or during suspicious timeframes. Additionally, it is recommended to review the contents of the newly created cron files to assess their intent. Furthermore, it is suggested to baseline normal cron file creation and apply additional filters to reduce false positives based on the specific environment."
    author = "Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research), MSTIC"
    severity = "LOW"

  events:
    (((($e.target.file.full_path = /^/etc/cron.d/.*/ nocase or $e.target.file.full_path = /^/etc/cron.daily/.*/ nocase or $e.target.file.full_path = /^/etc/cron.hourly/.*/ nocase or $e.target.file.full_path = /^/etc/cron.monthly/.*/ nocase or $e.target.file.full_path = /^/etc/cron.weekly/.*/ nocase or $e.target.file.full_path = /^/var/spool/cron/crontabs/.*/ nocase or $e.target.file.full_path = /^/var/spool/cron/root.*/ nocase)) or (($e.target.file.full_path = /.*/etc/cron.allow.*/ nocase or $e.target.file.full_path = /.*/etc/cron.deny.*/ nocase or $e.target.file.full_path = /.*/etc/crontab.*/ nocase))) and not((($e.target.file.full_path = "/etc/cron.daily/apt" or $e.target.file.full_path = "/etc/cron.daily/dpkg" or $e.target.file.full_path = "/etc/cron.daily/passwd" or $e.target.file.full_path = "/etc/crontabs/root"))))

  condition:
    $e
}
