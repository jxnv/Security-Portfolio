// Title: Suspicious Execution Location Of Wermgr.EXE
// ID: 5394fcc7-aeb2-43b5-9a09-cac9fc5edcd5
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-10-14
// Tags: attack.execution
// Description: Detects suspicious Windows Error Reporting manager (wermgr.exe) execution location.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 5394fcc7_aeb2_43b5_9a09_cac9fc5edcd5 {
  meta:
    title = "Suspicious Execution Location Of Wermgr.EXE"
    description = "Detects suspicious Windows Error Reporting manager (wermgr.exe) execution location."
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.file.full_path = /.*\\wermgr.exe$/ nocase) and not((($e.target.process.file.full_path = /^C:\\Windows\\System32\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\SysWOW64\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\WinSxS\\.*/ nocase))))

  condition:
    $e
}
