// Title: Suspicious Child Process Created as System
// ID: 590a5f4c-6c8c-4f10-8307-89afe9453a9d
// Status: test
// Level: high
// Author: Teymur Kheirkhabarov, Roberto Rodriguez (@Cyb3rWard0g), Open Threat Research (OTR)
// Date: 2019-10-26
// Tags: attack.privilege-escalation, attack.stealth, attack.t1134.002
// Description: Detection of child processes spawned with SYSTEM privileges by parents with LOCAL SERVICE or NETWORK SERVICE accounts
// Converted by: Sigma Universal SIEM/EDR CLI

rule 590a5f4c_6c8c_4f10_8307_89afe9453a9d {
  meta:
    title = "Suspicious Child Process Created as System"
    description = "Detection of child processes spawned with SYSTEM privileges by parents with LOCAL SERVICE or NETWORK SERVICE accounts"
    author = "Teymur Kheirkhabarov, Roberto Rodriguez (@Cyb3rWard0g), Open Threat Research (OTR)"
    severity = "HIGH"

  events:
    ((($e.ParentUser = /.*AUTHORI.*/ nocase or $e.ParentUser = /.*AUTORI.*/ nocase) and ($e.ParentUser = /.*\\NETWORK SERVICE$/ nocase or $e.ParentUser = /.*\\LOCAL SERVICE$/ nocase) and ($e.target.user.userid = /.*AUTHORI.*/ nocase or $e.target.user.userid = /.*AUTORI.*/ nocase) and ($e.target.user.userid = /.*\\SYSTEM$/ nocase or $e.target.user.userid = /.*\\Système$/ nocase or $e.target.user.userid = /.*\\СИСТЕМА$/ nocase) and ($e.IntegrityLevel = "System" or $e.IntegrityLevel = "S-1-16-16384")) and not(($e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase and $e.target.process.command_line = /.*DavSetCookie.*/ nocase)))

  condition:
    $e
}
