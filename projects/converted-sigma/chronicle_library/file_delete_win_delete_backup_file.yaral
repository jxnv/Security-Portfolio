// Title: Backup Files Deleted
// ID: 06125661-3814-4e03-bfa2-1e4411c60ac3
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-01-02
// Tags: attack.impact, attack.t1490
// Description: Detects deletion of files with extensions often used for backup files. Adversaries may delete or remove built-in operating system data and turn off services designed to aid in the recovery of a corrupted system to prevent recovery.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 06125661_3814_4e03_bfa2_1e4411c60ac3 {
  meta:
    title = "Backup Files Deleted"
    description = "Detects deletion of files with extensions often used for backup files. Adversaries may delete or remove built-in operating system data and turn off services designed to aid in the recovery of a corrupted system to prevent recovery."
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.target.process.file.full_path = /.*\\cmd.exe$/ nocase or $e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase or $e.target.process.file.full_path = /.*\\wt.exe$/ nocase or $e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase or $e.target.process.file.full_path = /.*\\regsvr32.exe$/ nocase) and ($e.target.file.full_path = /.*.VHD$/ nocase or $e.target.file.full_path = /.*.bac$/ nocase or $e.target.file.full_path = /.*.bak$/ nocase or $e.target.file.full_path = /.*.wbcat$/ nocase or $e.target.file.full_path = /.*.bkf$/ nocase or $e.target.file.full_path = /.*.set$/ nocase or $e.target.file.full_path = /.*.win$/ nocase or $e.target.file.full_path = /.*.dsk$/ nocase))

  condition:
    $e
}
