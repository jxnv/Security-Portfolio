// Title: Java Running with Remote Debugging
// ID: 8f88e3f6-2a49-48f5-a5c4-2f7eedf78710
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2019-01-16
// Tags: attack.t1203, attack.execution
// Description: Detects a JAVA process running with remote debugging allowing more than just localhost to connect
// Converted by: Sigma Universal SIEM/EDR CLI

rule 8f88e3f6_2a49_48f5_a5c4_2f7eedf78710 {
  meta:
    title = "Java Running with Remote Debugging"
    description = "Detects a JAVA process running with remote debugging allowing more than just localhost to connect"
    author = "Florian Roth (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*transport=dt_socket,address=.*/ nocase) and (($e.target.process.command_line = /.*jre1..*/ nocase or $e.target.process.command_line = /.*jdk1..*/ nocase))) and not((($e.target.process.command_line = /.*address=127.0.0.1.*/ nocase or $e.target.process.command_line = /.*address=localhost.*/ nocase))))

  condition:
    $e
}
