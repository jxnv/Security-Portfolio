// Title: Replace Desktop Wallpaper by Powershell
// ID: c5ac6a1e-9407-45f5-a0ce-ca9a0806a287
// Status: test
// Level: low
// Author: frack113
// Date: 2021-12-26
// Tags: attack.impact, attack.t1491.001
// Description: An adversary may deface systems internal to an organization in an attempt to intimidate or mislead users.
// This may take the form of modifications to internal websites, or directly to user systems with the replacement of the desktop wallpaper
// Converted by: Sigma Universal SIEM/EDR CLI

rule c5ac6a1e_9407_45f5_a0ce_ca9a0806a287 {
  meta:
    title = "Replace Desktop Wallpaper by Powershell"
    description = "An adversary may deface systems internal to an organization in an attempt to intimidate or mislead users. This may take the form of modifications to internal websites, or directly to user systems with the replacement of the desktop wallpaper"
    author = "frack113"
    severity = "LOW"

  events:
    ((($e.ScriptBlockText = /.*Get-ItemProperty.*/ nocase and $e.ScriptBlockText = /.*Registry::.*/ nocase and $e.ScriptBlockText = /.*HKEY_CURRENT_USER\\Control Panel\\Desktop\\.*/ nocase and $e.ScriptBlockText = /.*WallPaper.*/ nocase)) or ($e.ScriptBlockText = /.*SystemParametersInfo(20,0,*,3).*/ nocase))

  condition:
    $e
}
