// Title: DriverQuery.EXE Execution
// ID: a20def93-0709-4eae-9bd2-31206e21e6b2
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-19
// Tags: attack.discovery
// Description: Detect usage of the "driverquery" utility. Which can be used to perform reconnaissance on installed drivers
// Converted by: Sigma Universal SIEM/EDR CLI

rule a20def93_0709_4eae_9bd2_31206e21e6b2 {
  meta:
    title = "DriverQuery.EXE Execution"
    description = "Detect usage of the "driverquery" utility. Which can be used to perform reconnaissance on installed drivers"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.file.full_path = /.*driverquery.exe$/ nocase) or ($e.target.process.file.name = "drvqry.exe")) and not(((($e.principal.process.file.full_path = /.*\\cscript.exe$/ nocase or $e.principal.process.file.full_path = /.*\\mshta.exe$/ nocase or $e.principal.process.file.full_path = /.*\\regsvr32.exe$/ nocase or $e.principal.process.file.full_path = /.*\\rundll32.exe$/ nocase or $e.principal.process.file.full_path = /.*\\wscript.exe$/ nocase)) or (($e.principal.process.file.full_path = /.*\\AppData\\Local\\.*/ nocase or $e.principal.process.file.full_path = /.*\\Users\\Public\\.*/ nocase or $e.principal.process.file.full_path = /.*\\Windows\\Temp\\.*/ nocase)))))

  condition:
    $e
}
