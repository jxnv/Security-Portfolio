// Title: Potential Cookies Session Hijacking
// ID: 5a6e1e16-07de-48d8-8aae-faa766c05e88
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-07-27
// Tags: attack.execution
// Description: Detects execution of "curl.exe" with the "-c" flag in order to save cookie data.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 5a6e1e16_07de_48d8_8aae_faa766c05e88 {
  meta:
    title = "Potential Cookies Session Hijacking"
    description = "Detects execution of "curl.exe" with the "-c" flag in order to save cookie data."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /\s-c\s/ nocase) or ($e.target.process.command_line = /.*--cookie-jar.*/ nocase)) and (($e.target.process.file.full_path = /.*\\curl.exe$/ nocase) or ($e.target.process.file.name = "curl.exe")))

  condition:
    $e
}
