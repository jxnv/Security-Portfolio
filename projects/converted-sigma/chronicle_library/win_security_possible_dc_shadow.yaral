// Tags: attack.credential-access, attack.defense-impairment, attack.t1207
// Description: Detects DCShadow via create new SPN
// Converted by: Sigma Universal SIEM/EDR CLI

rule 32e19d25_4aed_4860_a55a_be99cb0bf7ed {
  meta:
    title = "Possible DC Shadow Attack"
    description = "Detects DCShadow via create new SPN"
    author = "Ilyas Ochkov, oscd.community, Chakib Gzenayi (@Chak092), Hosni Mribah"
    severity = "MEDIUM"

  events:
    (($e.EventID = 4742 and $e.ServicePrincipalNames = /.*GC/.*/ nocase) or ($e.EventID = 5136 and $e.AttributeLDAPDisplayName = "servicePrincipalName" and $e.AttributeValue = /^GC/.*/ nocase))

  condition:
    $e
}
