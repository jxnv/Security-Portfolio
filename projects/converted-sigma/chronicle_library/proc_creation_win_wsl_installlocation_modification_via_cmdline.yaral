// Title: Suspicious WSL InstallLocation Registry Key Modification Via CommandLine
// ID: f9f62824-de4e-40ca-afe7-8358f76a876d
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-05-05
// Tags: attack.stealth, attack.defense-impairment, attack.persistence, attack.t1112, attack.t1218
// Description: Detects the use of reg.exe or PowerShell to modify the WSL InstallLocation registry key via command-line arguments.
// Legitimate modifications to this key are performed exclusively by the Windows Installer (msiexec.exe) during WSL package installation or update.
// Manual use of reg.exe or PowerShell to set this value strongly indicates an attempt to redirect WSL execution to a malicious binary.
// Converted by: Sigma Universal SIEM/EDR CLI

rule f9f62824_de4e_40ca_afe7_8358f76a876d {
  meta:
    title = "Suspicious WSL InstallLocation Registry Key Modification Via CommandLine"
    description = "Detects the use of reg.exe or PowerShell to modify the WSL InstallLocation registry key via command-line arguments. Legitimate modifications to this key are performed exclusively by the Windows Installer (msiexec.exe) during WSL package installation or update. Manual use of reg.exe or PowerShell to set this value strongly indicates an attempt to redirect WSL execution to a malicious binary."
    author = "Swachchhanda Shrawan Poudel (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.* add .*/ nocase or $e.target.process.command_line = /.*New-ItemProperty.*/ nocase or $e.target.process.command_line = /.*Set-ItemProperty.*/ nocase or $e.target.process.command_line = /.*sp .*/ nocase)) and (($e.target.process.command_line = /.*\\Lxss\\MSI.*/ nocase or $e.target.process.command_line = /.*/Lxss/MSI.*/ nocase)) and ($e.target.process.command_line = /.*InstallLocation.*/ nocase) and ((($e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase or $e.target.process.file.full_path = /.*\\reg.exe$/ nocase)) or (($e.target.process.file.name = "powershell.exe" or $e.target.process.file.name = "pwsh.dll" or $e.target.process.file.name = "reg.exe"))))

  condition:
    $e
}
