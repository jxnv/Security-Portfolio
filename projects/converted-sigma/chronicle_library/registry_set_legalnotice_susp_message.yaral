// Title: Potential Ransomware Activity Using LegalNotice Message
// ID: 8b9606c9-28be-4a38-b146-0e313cc232c1
// Status: test
// Level: high
// Author: frack113
// Date: 2022-12-11
// Tags: attack.impact, attack.t1491.001
// Description: Detect changes to the "LegalNoticeCaption" or "LegalNoticeText" registry values where the message set contains keywords often used in ransomware ransom messages
// Converted by: Sigma Universal SIEM/EDR CLI

rule 8b9606c9_28be_4a38_b146_0e313cc232c1 {
  meta:
    title = "Potential Ransomware Activity Using LegalNotice Message"
    description = "Detect changes to the "LegalNoticeCaption" or "LegalNoticeText" registry values where the message set contains keywords often used in ransomware ransom messages"
    author = "frack113"
    severity = "HIGH"

  events:
    (($e.TargetObject = /.*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\LegalNoticeCaption.*/ nocase or $e.TargetObject = /.*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\LegalNoticeText.*/ nocase) and ($e.Details = /.*encrypted.*/ nocase or $e.Details = /.*Unlock-Password.*/ nocase or $e.Details = /.*paying.*/ nocase))

  condition:
    $e
}
