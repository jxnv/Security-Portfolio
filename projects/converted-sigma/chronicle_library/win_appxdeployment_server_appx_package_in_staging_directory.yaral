// Title: AppX Located in Known Staging Directory Added to Deployment Pipeline
// ID: 5cdeaf3d-1489-477c-95ab-c318559fc051
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-11
// Tags: attack.stealth
// Description: Detects an appx package that was added to the pipeline of the "to be processed" packages that is located in a known folder often used as a staging directory.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 5cdeaf3d_1489_477c_95ab_c318559fc051 {
  meta:
    title = "AppX Located in Known Staging Directory Added to Deployment Pipeline"
    description = "Detects an appx package that was added to the pipeline of the "to be processed" packages that is located in a known folder often used as a staging directory."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.EventID = 854) and ((($e.Path = /.*:\\PerfLogs\\.*/ nocase or $e.Path = /.*:\\Users\\Public\\.*/ nocase or $e.Path = /.*:\\Windows\\Temp\\.*/ nocase or $e.Path = /.*\\AppdData\\Local\\Temp\\.*/ nocase or $e.Path = /.*\\Desktop\\.*/ nocase or $e.Path = /.*\\Downloads\\.*/ nocase)) or (($e.Path = /.*:/Perflogs/.*/ nocase or $e.Path = /.*:/Users/Public/.*/ nocase or $e.Path = /.*:/Windows/Temp/.*/ nocase or $e.Path = /.*/AppdData/Local/Temp/.*/ nocase or $e.Path = /.*/Desktop/.*/ nocase or $e.Path = /.*/Downloads/.*/ nocase))))

  condition:
    $e
}
