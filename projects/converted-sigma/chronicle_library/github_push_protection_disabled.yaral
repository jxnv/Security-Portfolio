    severity = "HIGH"

  events:
    (($e.action = "business_secret_scanning_custom_pattern_push_protection.disabled" or $e.action = "business_secret_scanning_push_protection.disable" or $e.action = "business_secret_scanning_push_protection.disabled_for_new_repos" or $e.action = "org.secret_scanning_custom_pattern_push_protection_disabled" or $e.action = "org.secret_scanning_push_protection_disable" or $e.action = "org.secret_scanning_push_protection_new_repos_disable" or $e.action = "repository_secret_scanning_custom_pattern_push_protection.disabled"))

