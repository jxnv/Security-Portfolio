// Title: Suspicious MSDT Parent Process
// ID: 7a74da6b-ea76-47db-92cc-874ad90df734
// Status: test
// Level: high
// Author: Nextron Systems
// Date: 2022-06-01
// Tags: attack.stealth, attack.t1036, attack.t1218
// Description: Detects msdt.exe executed by a suspicious parent as seen in CVE-2022-30190 / Follina exploitation
// Converted by: Sigma Universal SIEM/EDR CLI

rule 7a74da6b_ea76_47db_92cc_874ad90df734 {
  meta:
    title = "Suspicious MSDT Parent Process"
    description = "Detects msdt.exe executed by a suspicious parent as seen in CVE-2022-30190 / Follina exploitation"
    author = "Nextron Systems"
    severity = "HIGH"

  events:
    ((($e.target.process.file.full_path = /.*\\msdt.exe$/ nocase) or ($e.target.process.file.name = "msdt.exe")) and (($e.principal.process.file.full_path = /.*\\cmd.exe$/ nocase or $e.principal.process.file.full_path = /.*\\cscript.exe$/ nocase or $e.principal.process.file.full_path = /.*\\mshta.exe$/ nocase or $e.principal.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.principal.process.file.full_path = /.*\\pwsh.exe$/ nocase or $e.principal.process.file.full_path = /.*\\regsvr32.exe$/ nocase or $e.principal.process.file.full_path = /.*\\rundll32.exe$/ nocase or $e.principal.process.file.full_path = /.*\\schtasks.exe$/ nocase or $e.principal.process.file.full_path = /.*\\wmic.exe$/ nocase or $e.principal.process.file.full_path = /.*\\wscript.exe$/ nocase or $e.principal.process.file.full_path = /.*\\wsl.exe$/ nocase)))

  condition:
    $e
}
