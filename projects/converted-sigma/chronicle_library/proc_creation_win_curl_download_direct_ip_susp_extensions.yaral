// Title: Suspicious File Download From IP Via Curl.EXE
// ID: 5cb299fc-5fb1-4d07-b989-0644c68b6043
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-07-27
// Tags: attack.execution
// Description: Detects potentially suspicious file downloads directly from IP addresses using curl.exe
// Converted by: Sigma Universal SIEM/EDR CLI

rule 5cb299fc_5fb1_4d07_b989_0644c68b6043 {
  meta:
    title = "Suspicious File Download From IP Via Curl.EXE"
    description = "Detects potentially suspicious file downloads directly from IP addresses using curl.exe"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*.bat$/ nocase or $e.target.process.command_line = /.*.bat\"$/ nocase or $e.target.process.command_line = /.*.dat$/ nocase or $e.target.process.command_line = /.*.dat\"$/ nocase or $e.target.process.command_line = /.*.dll$/ nocase or $e.target.process.command_line = /.*.dll\"$/ nocase or $e.target.process.command_line = /.*.exe$/ nocase or $e.target.process.command_line = /.*.exe\"$/ nocase or $e.target.process.command_line = /.*.gif$/ nocase or $e.target.process.command_line = /.*.gif\"$/ nocase or $e.target.process.command_line = /.*.hta$/ nocase or $e.target.process.command_line = /.*.hta\"$/ nocase or $e.target.process.command_line = /.*.jpeg$/ nocase or $e.target.process.command_line = /.*.jpeg\"$/ nocase or $e.target.process.command_line = /.*.log$/ nocase or $e.target.process.command_line = /.*.log\"$/ nocase or $e.target.process.command_line = /.*.msi$/ nocase or $e.target.process.command_line = /.*.msi\"$/ nocase or $e.target.process.command_line = /.*.png$/ nocase or $e.target.process.command_line = /.*.png\"$/ nocase or $e.target.process.command_line = /.*.ps1$/ nocase or $e.target.process.command_line = /.*.ps1\"$/ nocase or $e.target.process.command_line = /.*.psm1$/ nocase or $e.target.process.command_line = /.*.psm1\"$/ nocase or $e.target.process.command_line = /.*.vbe$/ nocase or $e.target.process.command_line = /.*.vbe\"$/ nocase or $e.target.process.command_line = /.*.vbs$/ nocase or $e.target.process.command_line = /.*.vbs\"$/ nocase or $e.target.process.command_line = /.*.bat'$/ nocase or $e.target.process.command_line = /.*.dat'$/ nocase or $e.target.process.command_line = /.*.dll'$/ nocase or $e.target.process.command_line = /.*.exe'$/ nocase or $e.target.process.command_line = /.*.gif'$/ nocase or $e.target.process.command_line = /.*.hta'$/ nocase or $e.target.process.command_line = /.*.jpeg'$/ nocase or $e.target.process.command_line = /.*.log'$/ nocase or $e.target.process.command_line = /.*.msi'$/ nocase or $e.target.process.command_line = /.*.png'$/ nocase or $e.target.process.command_line = /.*.ps1'$/ nocase or $e.target.process.command_line = /.*.psm1'$/ nocase or $e.target.process.command_line = /.*.vbe'$/ nocase or $e.target.process.command_line = /.*.vbs'$/ nocase)) and (($e.target.process.command_line = /.* -O.*/ nocase or $e.target.process.command_line = /.*--remote-name.*/ nocase or $e.target.process.command_line = /.*--output.*/ nocase)) and ($e.target.process.command_line = /.*http.*/ nocase) and (($e.target.process.file.full_path = /.*\\curl.exe$/ nocase) or ($e.target.process.file.name = "curl.exe")) and ($e.target.process.command_line = /://[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}/ nocase))

  condition:
    $e
}
