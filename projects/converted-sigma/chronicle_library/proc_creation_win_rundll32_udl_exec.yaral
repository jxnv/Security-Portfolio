// Title: Potentially Suspicious Rundll32.EXE Execution of UDL File
// ID: 0ea52357-cd59-4340-9981-c46c7e900428
// Status: test
// Level: medium
// Author: @kostastsale
// Date: 2024-08-16
// Tags: attack.execution, attack.command-and-control, attack.stealth, attack.t1218.011, attack.t1071
// Description: Detects the execution of rundll32.exe with the oledb32.dll library to open a UDL file.
// Threat actors can abuse this technique as a phishing vector to capture authentication credentials or other sensitive data.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 0ea52357_cd59_4340_9981_c46c7e900428 {
  meta:
    title = "Potentially Suspicious Rundll32.EXE Execution of UDL File"
    description = "Detects the execution of rundll32.exe with the oledb32.dll library to open a UDL file. Threat actors can abuse this technique as a phishing vector to capture authentication credentials or other sensitive data."
    author = "@kostastsale"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*oledb32.dll.*/ nocase and $e.target.process.command_line = /.*,OpenDSLFile .*/ nocase and $e.target.process.command_line = /.*\\\\Users\\\\*\\\\Downloads\\\\.*/ nocase) and $e.target.process.command_line = /.*.udl$/ nocase) and (($e.target.process.file.full_path = /.*\\rundll32.exe$/ nocase) or ($e.target.process.file.name = "RUNDLL32.EXE")) and ($e.principal.process.file.full_path = /.*\\explorer.exe$/ nocase))

  condition:
    $e
}
