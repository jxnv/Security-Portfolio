// Title: Suspicious IIS URL GlobalRules Rewrite Via AppCmd
// ID: 7c8af9b2-dcae-41a2-a9db-b28c288b5f08
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-22
// Tags: attack.stealth
// Description: Detects usage of "appcmd" to create new global URL rewrite rules. This behaviour has been observed being used by threat actors to add new rules so they can access their webshells.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 7c8af9b2_dcae_41a2_a9db_b28c288b5f08 {
  meta:
    title = "Suspicious IIS URL GlobalRules Rewrite Via AppCmd"
    description = "Detects usage of "appcmd" to create new global URL rewrite rules. This behaviour has been observed being used by threat actors to add new rules so they can access their webshells."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*set.*/ nocase and $e.target.process.command_line = /.*config.*/ nocase and $e.target.process.command_line = /.*section:system.webServer/rewrite/globalRules.*/ nocase and $e.target.process.command_line = /.*commit:.*/ nocase)) and (($e.target.process.file.full_path = /.*\\appcmd.exe$/ nocase) or ($e.target.process.file.name = "appcmd.exe")))

  condition:
    $e
}
