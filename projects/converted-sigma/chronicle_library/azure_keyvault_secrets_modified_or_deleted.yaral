// Title: Azure Keyvault Secrets Modified or Deleted
// ID: b831353c-1971-477b-abb6-2828edc3bca1
// Status: test
// Level: medium
// Author: Austin Songer @austinsonger
// Date: 2021-08-16
// Tags: attack.impact, attack.credential-access, attack.t1552, attack.t1552.001
// Description: Identifies when secrets are modified or deleted in Azure.
// Converted by: Sigma Universal SIEM/EDR CLI

rule b831353c_1971_477b_abb6_2828edc3bca1 {
  meta:
    title = "Azure Keyvault Secrets Modified or Deleted"
    description = "Identifies when secrets are modified or deleted in Azure."
    author = "Austin Songer @austinsonger"
    severity = "MEDIUM"

  events:
    (($e.operationName = "MICROSOFT.KEYVAULT/VAULTS/SECRETS/WRITE" or $e.operationName = "MICROSOFT.KEYVAULT/VAULTS/SECRETS/DELETE" or $e.operationName = "MICROSOFT.KEYVAULT/VAULTS/SECRETS/BACKUP/ACTION" or $e.operationName = "MICROSOFT.KEYVAULT/VAULTS/SECRETS/PURGE/ACTION" or $e.operationName = "MICROSOFT.KEYVAULT/VAULTS/SECRETS/UPDATE/ACTION" or $e.operationName = "MICROSOFT.KEYVAULT/VAULTS/SECRETS/RECOVER/ACTION" or $e.operationName = "MICROSOFT.KEYVAULT/VAULTS/SECRETS/RESTORE/ACTION" or $e.operationName = "MICROSOFT.KEYVAULT/VAULTS/SECRETS/SETSECRET/ACTION"))

  condition:
    $e
}
