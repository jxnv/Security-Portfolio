// Title: Read Contents From Stdin Via Cmd.EXE
// ID: 241e802a-b65e-484f-88cd-c2dc10f9206d
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-03-07
// Tags: attack.execution, attack.t1059.003
// Description: Detect the use of "<" to read and potentially execute a file via cmd.exe
// Converted by: Sigma Universal SIEM/EDR CLI

rule 241e802a_b65e_484f_88cd_c2dc10f9206d {
  meta:
    title = "Read Contents From Stdin Via Cmd.EXE"
    description = "Detect the use of "<" to read and potentially execute a file via cmd.exe"
    author = "frack113, Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.target.process.command_line = /.*<.*/ nocase) and (($e.target.process.file.name = "Cmd.Exe") or ($e.target.process.file.full_path = /.*\\cmd.exe$/ nocase)))

  condition:
    $e
}
