// Title: Active Directory User Backdoors
// ID: 300bac00-e041-4ee2-9c36-e262656a6ecc
// Status: test
// Level: high
// Author: @neu5ron
// Date: 2017-04-13
// Tags: attack.privilege-escalation, attack.t1098, attack.persistence
// Description: Detects scenarios where one can control another users or computers account without having to use their credentials.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 300bac00_e041_4ee2_9c36_e262656a6ecc {
  meta:
    title = "Active Directory User Backdoors"
    description = "Detects scenarios where one can control another users or computers account without having to use their credentials."
    author = "@neu5ron"
    severity = "HIGH"

  events:
    ((($e.EventID = 4738) and not(((($e.AllowedToDelegateTo = "" or $e.AllowedToDelegateTo = "-")) or (not ($e.AllowedToDelegateTo = /.*/))))) or (($e.EventID = 5136 and $e.AttributeLDAPDisplayName = "msDS-AllowedToDelegateTo") or ($e.EventID = 5136 and $e.ObjectClass = "user" and $e.AttributeLDAPDisplayName = "servicePrincipalName") or ($e.EventID = 5136 and $e.AttributeLDAPDisplayName = "msDS-AllowedToActOnBehalfOfOtherIdentity")))

  condition:
    $e
}
