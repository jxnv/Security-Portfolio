// Status: test
// Level: low
// Author: frack113
// Date: 2022-01-09
// Tags: attack.stealth, attack.t1027.004
// Description: When C# is compiled dynamically, a .cmdline file will be created as a part of the process.
// Certain processes are not typically observed compiling C# code, but can do so without touching disk.
// This can be used to unpack a payload for execution
// Converted by: Sigma Universal SIEM/EDR CLI

rule e4a74e34_ecde_4aab_b2fb_9112dd01aed0 {
  meta:
    title = "Dynamic CSharp Compile Artefact"
    description = "When C# is compiled dynamically, a .cmdline file will be created as a part of the process. Certain processes are not typically observed compiling C# code, but can do so without touching disk. This can be used to unpack a payload for execution"
    author = "frack113"
    severity = "LOW"

  events:
    ($e.target.file.full_path = /.*.cmdline$/ nocase)

  condition:
    $e
}
