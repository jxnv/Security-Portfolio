// Title: Multi Factor Authentication Disabled For User Account
// ID: b18454c8-0be3-41f7-86bc-9c614611b839
// Status: test
// Level: medium
// Author: Harjot Singh (@cyb3rjy0t)
// Date: 2024-08-21
// Tags: attack.credential-access, attack.persistence
// Description: Detects changes to the "StrongAuthenticationRequirement" value, where the state is set to "0" or "Disabled".
// Threat actors were seen disabling multi factor authentication for users in order to maintain or achieve access to the account. Also see in SIM Swap attacks.
// Converted by: Sigma Universal SIEM/EDR CLI

rule b18454c8_0be3_41f7_86bc_9c614611b839 {
  meta:
    title = "Multi Factor Authentication Disabled For User Account"
    description = "Detects changes to the "StrongAuthenticationRequirement" value, where the state is set to "0" or "Disabled". Threat actors were seen disabling multi factor authentication for users in order to maintain or achieve access to the account. Also see in SIM Swap attacks."
    author = "Harjot Singh (@cyb3rjy0t)"
    severity = "MEDIUM"

  events:
    ($e.LoggedByService = "Core Directory" and $e.Category = "UserManagement" and $e.OperationName = "Update user" and $e.TargetResources.ModifiedProperties.DisplayName = "StrongAuthenticationRequirement" and $e.TargetResources.ModifiedProperties.NewValue = /.*State\":0.*/ nocase)

  condition:
    $e
}
