// Description: Detects suspicious Splwow64.exe process without any command line parameters
// Converted by: Sigma Universal SIEM/EDR CLI

rule 1f1a8509_2cbb_44f5_8751_8e1571518ce2 {
  meta:
    title = "Suspicious Splwow64 Without Params"
    description = "Detects suspicious Splwow64.exe process without any command line parameters"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    ($e.target.process.file.full_path = /.*\\splwow64.exe$/ nocase and $e.target.process.command_line = /.*splwow64.exe$/ nocase)

  condition:
    $e
}
