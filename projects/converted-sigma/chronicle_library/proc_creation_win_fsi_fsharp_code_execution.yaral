// Title: Use of FSharp Interpreters
// ID: b96b2031-7c17-4473-afe7-a30ce714db29
// Status: test
// Level: medium
// Author: Christopher Peacock @SecurePeacock, SCYTHE @scythe_io
// Date: 2022-06-02
// Tags: attack.execution, attack.t1059
// Description: Detects the execution of FSharp Interpreters "FsiAnyCpu.exe" and "FSi.exe"
// Both can be used for AWL bypass and to execute F# code via scripts or inline.
// Converted by: Sigma Universal SIEM/EDR CLI

rule b96b2031_7c17_4473_afe7_a30ce714db29 {
  meta:
    title = "Use of FSharp Interpreters"
    description = "Detects the execution of FSharp Interpreters "FsiAnyCpu.exe" and "FSi.exe" Both can be used for AWL bypass and to execute F# code via scripts or inline."
    author = "Christopher Peacock @SecurePeacock, SCYTHE @scythe_io"
    severity = "MEDIUM"

  events:
    ((($e.target.process.file.full_path = /.*\\fsi.exe$/ nocase or $e.target.process.file.full_path = /.*\\fsianycpu.exe$/ nocase)) or (($e.target.process.file.name = "fsi.exe" or $e.target.process.file.name = "fsianycpu.exe")))

  condition:
    $e
}
