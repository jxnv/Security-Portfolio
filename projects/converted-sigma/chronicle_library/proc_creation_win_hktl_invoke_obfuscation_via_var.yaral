// Title: Invoke-Obfuscation VAR++ LAUNCHER OBFUSCATION
// ID: e9f55347-2928-4c06-88e5-1a7f8169942e
// Status: test
// Level: high
// Author: Timur Zinniatullin, oscd.community
// Date: 2020-10-13
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via VAR++ LAUNCHER
// Converted by: Sigma Universal SIEM/EDR CLI

rule e9f55347_2928_4c06_88e5_1a7f8169942e {
  meta:
    title = "Invoke-Obfuscation VAR++ LAUNCHER OBFUSCATION"
    description = "Detects Obfuscated Powershell via VAR++ LAUNCHER"
    author = "Timur Zinniatullin, oscd.community"
    severity = "HIGH"

  events:
    (($e.target.process.command_line = /.*&&set.*/ nocase and $e.target.process.command_line = /.*cmd.*/ nocase and $e.target.process.command_line = /.*/c.*/ nocase and $e.target.process.command_line = /.*-f.*/ nocase) and ($e.target.process.command_line = /.*{0}.*/ nocase or $e.target.process.command_line = /.*{1}.*/ nocase or $e.target.process.command_line = /.*{2}.*/ nocase or $e.target.process.command_line = /.*{3}.*/ nocase or $e.target.process.command_line = /.*{4}.*/ nocase or $e.target.process.command_line = /.*{5}.*/ nocase))

  condition:
    $e
}
