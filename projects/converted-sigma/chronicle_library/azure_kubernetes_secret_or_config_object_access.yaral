// Title: Azure Kubernetes Secret or Config Object Access
// ID: 7ee0b4aa-d8d4-4088-b661-20efdf41a04c
// Status: test
// Level: medium
// Author: Austin Songer @austinsonger
// Date: 2021-08-07
// Tags: attack.impact, attack.t1485, attack.t1496, attack.t1489
// Description: Identifies when a Kubernetes account access a sensitive objects such as configmaps or secrets.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 7ee0b4aa_d8d4_4088_b661_20efdf41a04c {
  meta:
    title = "Azure Kubernetes Secret or Config Object Access"
    description = "Identifies when a Kubernetes account access a sensitive objects such as configmaps or secrets."
    author = "Austin Songer @austinsonger"
    severity = "MEDIUM"

  events:
    (($e.operationName = "MICROSOFT.KUBERNETES/CONNECTEDCLUSTERS/CONFIGMAPS/WRITE" or $e.operationName = "MICROSOFT.KUBERNETES/CONNECTEDCLUSTERS/CONFIGMAPS/DELETE" or $e.operationName = "MICROSOFT.KUBERNETES/CONNECTEDCLUSTERS/SECRETS/WRITE" or $e.operationName = "MICROSOFT.KUBERNETES/CONNECTEDCLUSTERS/SECRETS/DELETE"))

  condition:
    $e
}
