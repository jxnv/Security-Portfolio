rule 5afa454e_030c_4ab4_9253_a90aa7fcc581 {
  meta:
    title = "Device Registration or Join Without MFA"
    description = "Monitor and alert for device registration or join events where MFA was not performed."
    author = "Michael Epping, '@mepples21'"
    severity = "MEDIUM"

  events:
    (($e.ResourceDisplayName = "Device Registration Service" and $e.conditionalAccessStatus = "success") and not(($e.AuthenticationRequirement = "multiFactorAuthentication")))

  condition:
    $e
}
