// Title: Suspicious Installer Package Child Process
// ID: e0cfaecd-602d-41af-988d-f6ccebb2af26
// Status: test
// Level: medium
// Author: Sohan G (D4rkCiph3r)
// Date: 2023-02-18
// Tags: attack.t1059, attack.t1059.007, attack.t1071, attack.t1071.001, attack.execution, attack.command-and-control
// Description: Detects the execution of suspicious child processes from macOS installer package parent process. This includes osascript, JXA, curl and wget amongst other interpreters
// Converted by: Sigma Universal SIEM/EDR CLI

rule e0cfaecd_602d_41af_988d_f6ccebb2af26 {
  meta:
    title = "Suspicious Installer Package Child Process"
    description = "Detects the execution of suspicious child processes from macOS installer package parent process. This includes osascript, JXA, curl and wget amongst other interpreters"
    author = "Sohan G (D4rkCiph3r)"
    severity = "MEDIUM"

  events:
    (($e.principal.process.file.full_path = /.*/package_script_service$/ nocase or $e.principal.process.file.full_path = /.*/installer$/ nocase) and ($e.target.process.file.full_path = /.*/sh$/ nocase or $e.target.process.file.full_path = /.*/bash$/ nocase or $e.target.process.file.full_path = /.*/dash$/ nocase or $e.target.process.file.full_path = /.*/python$/ nocase or $e.target.process.file.full_path = /.*/ruby$/ nocase or $e.target.process.file.full_path = /.*/perl$/ nocase or $e.target.process.file.full_path = /.*/php$/ nocase or $e.target.process.file.full_path = /.*/javascript$/ nocase or $e.target.process.file.full_path = /.*/osascript$/ nocase or $e.target.process.file.full_path = /.*/tclsh$/ nocase or $e.target.process.file.full_path = /.*/curl$/ nocase or $e.target.process.file.full_path = /.*/wget$/ nocase) and ($e.target.process.command_line = /.*preinstall.*/ nocase or $e.target.process.command_line = /.*postinstall.*/ nocase))

  condition:
    $e
}
