rule cf93e05e_d798_4d9e_b522_b0248dc61eaf {
  meta:
    title = "HackTool - SharpChisel Execution"
    description = "Detects usage of the Sharp Chisel via the commandline arguments"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.file.full_path = /.*\\SharpChisel.exe$/ nocase) or ($e.Product = "SharpChisel"))

  condition:
    $e
}
