// Title: Registry Enumeration via WMI Stdregprov
// ID: a0e417e2-2fa1-40da-b6d2-e094cd5e1191
// Status: experimental
// Level: medium
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-07-30
// Tags: attack.execution, attack.t1047, attack.discovery, attack.t1012
// Description: Detects the usage of wmic.exe to enumerate or read Windows registry via the WMI StdRegProv class read methods (EnumKey, EnumValues, GetStringValue, etc.).
// While registry reads are common, attackers may use this technique to perform reconnaissance and discover sensitive configuration values, credentials, or installed software.
// The use of WMI as an alternative to standard tools like reg.exe can indicate an attempt to evade detection focused on traditional registry query commands.
// Converted by: Sigma Universal SIEM/EDR CLI

rule a0e417e2_2fa1_40da_b6d2_e094cd5e1191 {
  meta:
    title = "Registry Enumeration via WMI Stdregprov"
    description = "Detects the usage of wmic.exe to enumerate or read Windows registry via the WMI StdRegProv class read methods (EnumKey, EnumValues, GetStringValue, etc.). While registry reads are common, attackers may use this technique to perform reconnaissance and discover sensitive configuration values, credentials, or installed software. The use of WMI as an alternative to standard tools like reg.exe can indicate an attempt to evade detection focused on traditional registry query commands."
    author = "Swachchhanda Shrawan Poudel (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*stdregprov.*/ nocase and $e.target.process.command_line = /.*call.*/ nocase) and ($e.target.process.command_line = /.*CheckAccess.*/ nocase or $e.target.process.command_line = /.*EnumKey.*/ nocase or $e.target.process.command_line = /.*EnumValues.*/ nocase or $e.target.process.command_line = /.*GetBinaryValue.*/ nocase or $e.target.process.command_line = /.*GetDWORDValue.*/ nocase or $e.target.process.command_line = /.*GetExpandedStringValue.*/ nocase or $e.target.process.command_line = /.*GetMultiStringValue.*/ nocase or $e.target.process.command_line = /.*GetQWORDValue.*/ nocase or $e.target.process.command_line = /.*GetSecurityDescriptor.*/ nocase or $e.target.process.command_line = /.*GetStringValue.*/ nocase)) and (($e.target.process.file.full_path = /.*\\wmic.exe$/ nocase) or ($e.target.process.file.name = "wmic.exe")))

  condition:
    $e
}
