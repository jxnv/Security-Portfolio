// Title: Chopper Webshell Process Pattern
// ID: fa3c117a-bc0d-416e-a31b-0c0e80653efb
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), MSTI (query)
// Date: 2022-10-01
// Tags: attack.persistence, attack.discovery, attack.t1505.003, attack.t1018, attack.t1033, attack.t1087
// Description: Detects patterns found in process executions cause by China Chopper like tiny (ASPX) webshells
// Converted by: Sigma Universal SIEM/EDR CLI

rule fa3c117a_bc0d_416e_a31b_0c0e80653efb {
  meta:
    title = "Chopper Webshell Process Pattern"
    description = "Detects patterns found in process executions cause by China Chopper like tiny (ASPX) webshells"
    author = "Florian Roth (Nextron Systems), MSTI (query)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*&ipconfig&echo.*/ nocase or $e.target.process.command_line = /.*&quser&echo.*/ nocase or $e.target.process.command_line = /.*&whoami&echo.*/ nocase or $e.target.process.command_line = /.*&c:&echo.*/ nocase or $e.target.process.command_line = /.*&cd&echo.*/ nocase or $e.target.process.command_line = /.*&dir&echo.*/ nocase or $e.target.process.command_line = /.*&echo [E].*/ nocase or $e.target.process.command_line = /.*&echo [S].*/ nocase)) and (($e.target.process.file.full_path = /.*\\w3wp.exe$/ nocase) or ($e.principal.process.file.full_path = /.*\\w3wp.exe$/ nocase)))

  condition:
    $e
}
