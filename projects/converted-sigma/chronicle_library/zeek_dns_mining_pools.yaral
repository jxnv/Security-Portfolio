r $e.query = /.*hash-to-coins.com$/ nocase or $e.query = /.*pool-proxy.com$/ nocase or $e.query = /.*hashfor.cash$/ nocase or $e.query = /.*fairpool.cloud$/ nocase or $e.query = /.*litecoinpool.org$/ nocase or $e.query = /.*mineshaft.ml$/ nocase or $e.query = /.*abcxyz.stream$/ nocase or $e.query = /.*moneropool.ru$/ nocase or $e.query = /.*cryptonotepool.org.uk$/ nocase or $e.query = /.*extremepool.org$/ nocase or $e.query = /.*extremehash.com$/ nocase or $e.query = /.*hashinvest.net$/ nocase or $e.query = /.*unipool.pro$/ nocase or $e.query = /.*crypto-pools.org$/ nocase or $e.query = /.*monero.net$/ nocase or $e.query = /.*backup-pool.com$/ nocase or $e.query = /.*mooo.com$/ nocase or $e.query = /.*freeyy.me$/ nocase or $e.query = /.*cryptonight.net$/ nocase or $e.query = /.*shscrypto.net$/ nocase)) and not(((($e.answers = "127.0.0.1" or $e.answers = "0.0.0.0")) or ($e.rejected = "true"))))

