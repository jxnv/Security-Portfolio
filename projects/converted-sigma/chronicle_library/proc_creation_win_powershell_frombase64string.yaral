// Title: Base64 Encoded PowerShell Command Detected
// ID: e32d4572-9826-4738-b651-95fa63747e8a
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2020-01-29
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1140, attack.t1059.001
// Description: Detects usage of the "FromBase64String" function in the commandline which is used to decode a base64 encoded string
// Converted by: Sigma Universal SIEM/EDR CLI

rule e32d4572_9826_4738_b651_95fa63747e8a {
  meta:
    title = "Base64 Encoded PowerShell Command Detected"
    description = "Detects usage of the "FromBase64String" function in the commandline which is used to decode a base64 encoded string"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    ($e.target.process.command_line = /.*::FromBase64String(.*/ nocase)

  condition:
    $e
}
