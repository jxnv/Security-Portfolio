// Title: Potential Privilege Escalation To LOCAL SYSTEM
// ID: 207b0396-3689-42d9-8399-4222658efc99
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-05-22
// Tags: attack.resource-development, attack.t1587.001
// Description: Detects unknown program using commandline flags usually used by tools such as PsExec and PAExec to start programs with SYSTEM Privileges
// Converted by: Sigma Universal SIEM/EDR CLI

rule 207b0396_3689_42d9_8399_4222658efc99 {
  meta:
    title = "Potential Privilege Escalation To LOCAL SYSTEM"
    description = "Detects unknown program using commandline flags usually used by tools such as PsExec and PAExec to start programs with SYSTEM Privileges"
    author = "Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.* -s cmd.*/ nocase or $e.target.process.command_line = /.* -s -i cmd.*/ nocase or $e.target.process.command_line = /.* -i -s cmd.*/ nocase or $e.target.process.command_line = /.* -s pwsh.*/ nocase or $e.target.process.command_line = /.* -s -i pwsh.*/ nocase or $e.target.process.command_line = /.* -i -s pwsh.*/ nocase or $e.target.process.command_line = /.* -s powershell.*/ nocase or $e.target.process.command_line = /.* -s -i powershell.*/ nocase or $e.target.process.command_line = /.* -i -s powershell.*/ nocase)) and not((($e.target.process.command_line = /.*paexec.*/ nocase or $e.target.process.command_line = /.*PsExec.*/ nocase or $e.target.process.command_line = /.*accepteula.*/ nocase))))

  condition:
    $e
}
