// Title: Google Cloud SQL Database Modified or Deleted
// ID: f346bbd5-2c4e-4789-a221-72de7685090d
// Status: test
// Level: medium
// Author: Austin Songer @austinsonger
// Date: 2021-10-15
// Tags: attack.impact
// Description: Detect when a Cloud SQL DB has been modified or deleted.
// Converted by: Sigma Universal SIEM/EDR CLI

rule f346bbd5_2c4e_4789_a221_72de7685090d {
  meta:
    title = "Google Cloud SQL Database Modified or Deleted"
    description = "Detect when a Cloud SQL DB has been modified or deleted."
    author = "Austin Songer @austinsonger"
    severity = "MEDIUM"

  events:
    (($e.gcp.audit.method_name = "cloudsql.instances.create" or $e.gcp.audit.method_name = "cloudsql.instances.delete" or $e.gcp.audit.method_name = "cloudsql.users.update" or $e.gcp.audit.method_name = "cloudsql.users.delete"))

  condition:
    $e
}
