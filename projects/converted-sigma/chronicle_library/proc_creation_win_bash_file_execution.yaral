// Title: Indirect Command Execution From Script File Via Bash.EXE
// ID: 2d22a514-e024-4428-9dba-41505bd63a5b
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-08-15
// Tags: attack.stealth, attack.t1202
// Description: Detects execution of Microsoft bash launcher without any flags to execute the content of a bash script directly.
// This can be used to potentially bypass defenses and execute Linux or Windows-based binaries directly via bash.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 2d22a514_e024_4428_9dba_41505bd63a5b {
  meta:
    title = "Indirect Command Execution From Script File Via Bash.EXE"
    description = "Detects execution of Microsoft bash launcher without any flags to execute the content of a bash script directly. This can be used to potentially bypass defenses and execute Linux or Windows-based binaries directly via bash."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (((($e.target.process.file.full_path = /.*:\\Windows\\System32\\bash.exe$/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\SysWOW64\\bash.exe$/ nocase)) or ($e.target.process.file.name = "Bash.exe")) and not(((($e.target.process.command_line = /.*bash.exe -.*/ nocase or $e.target.process.command_line = /.*bash -.*/ nocase)) or ($e.target.process.command_line = "") or (not ($e.target.process.command_line = /.*/)) or (($e.target.process.command_line = "bash.exe" or $e.target.process.command_line = "bash")))))

  condition:
    $e
}
