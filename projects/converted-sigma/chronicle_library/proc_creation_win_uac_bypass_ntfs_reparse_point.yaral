// Title: UAC Bypass Using NTFS Reparse Point - Process
// ID: 39ed3c80-e6a1-431b-9df3-911ac53d08a7
// Status: test
// Level: high
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-08-30
// Tags: attack.privilege-escalation, attack.t1548.002
// Description: Detects the pattern of UAC Bypass using NTFS reparse point and wusa.exe DLL hijacking (UACMe 36)
// Converted by: Sigma Universal SIEM/EDR CLI

rule 39ed3c80_e6a1_431b_9df3_911ac53d08a7 {
  meta:
    title = "UAC Bypass Using NTFS Reparse Point - Process"
    description = "Detects the pattern of UAC Bypass using NTFS reparse point and wusa.exe DLL hijacking (UACMe 36)"
    author = "Christian Burkard (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.command_line = /^\"C:\\Windows\\system32\\wusa.exe\"  /quiet C:\\Users\\.*/ nocase and $e.target.process.command_line = /.*\\AppData\\Local\\Temp\\update.msu$/ nocase and ($e.IntegrityLevel = "High" or $e.IntegrityLevel = "System" or $e.IntegrityLevel = "S-1-16-16384" or $e.IntegrityLevel = "S-1-16-12288")) or ($e.principal.process.command_line = "\"C:\\Windows\\system32\\dism.exe\" /online /quiet /norestart /add-package /packagepath:\"C:\\Windows\\system32\\pe386\" /ignorecheck" and ($e.IntegrityLevel = "High" or $e.IntegrityLevel = "System") and ($e.target.process.command_line = /.*C:\\Users\\.*/ nocase and $e.target.process.command_line = /.*\\AppData\\Local\\Temp\\.*/ nocase and $e.target.process.command_line = /.*\\dismhost.exe {.*/ nocase) and $e.target.process.file.full_path = /.*\\DismHost.exe$/ nocase))

  condition:
    $e
}
