rule 2d1b83e4_17c6_4896_a37b_29140b40a788 {
  meta:
    title = "Google Workspace User Granted Admin Privileges"
    description = "Detects when an Google Workspace user is granted admin privileges."
    author = "Austin Songer"
    severity = "MEDIUM"

  events:
    ($e.eventService = "admin.googleapis.com" and ($e.eventName = "GRANT_DELEGATED_ADMIN_PRIVILEGES" or $e.eventName = "GRANT_ADMIN_PRIVILEGE"))

  condition:
    $e
}
