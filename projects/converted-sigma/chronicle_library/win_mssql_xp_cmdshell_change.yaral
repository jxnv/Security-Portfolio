rule d08dd86f_681e_4a00_a92c_1db218754417 {
  meta:
    title = "MSSQL XPCmdshell Option Change"
    description = "Detects when the MSSQL "xp_cmdshell" stored procedure setting is changed."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ($e.Provider_Name = /.*MSSQL.*/ nocase and $e.EventID = 15457 and $e.Data = /.*xp_cmdshell.*/ nocase)

  condition:
    $e
}
