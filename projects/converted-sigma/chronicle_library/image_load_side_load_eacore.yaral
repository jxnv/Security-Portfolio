// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of "EACore.dll"
// Converted by: Sigma Universal SIEM/EDR CLI

rule edd3ddc3_386f_4ba5_9ada_4376b2cfa7b5 {
  meta:
    title = "Potential EACore.DLL Sideloading"
    description = "Detects potential DLL sideloading of "EACore.dll""
    author = "X__Junior (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.ImageLoaded = /.*\\EACore.dll$/ nocase) and not((($e.target.process.file.full_path = /.*C:\\Program Files\\Electronic Arts\\EA Desktop\\.*/ nocase and $e.target.process.file.full_path = /.*\\EACoreServer.exe.*/ nocase) and $e.ImageLoaded = /^C:\\Program Files\\Electronic Arts\\EA Desktop\\.*/ nocase)))

  condition:
    $e
}
