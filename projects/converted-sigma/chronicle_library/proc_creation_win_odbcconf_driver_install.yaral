// Title: Driver/DLL Installation Via Odbcconf.EXE
// ID: 3f5491e2-8db8-496b-9e95-1029fce852d4
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-22
// Tags: attack.stealth, attack.t1218.008
// Description: Detects execution of "odbcconf" with "INSTALLDRIVER" which installs a new ODBC driver. Attackers abuse this to install and run malicious DLLs.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 3f5491e2_8db8_496b_9e95_1029fce852d4 {
  meta:
    title = "Driver/DLL Installation Via Odbcconf.EXE"
    description = "Detects execution of "odbcconf" with "INSTALLDRIVER" which installs a new ODBC driver. Attackers abuse this to install and run malicious DLLs."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.*INSTALLDRIVER .*/ nocase and $e.target.process.command_line = /.*.dll.*/ nocase)) and (($e.target.process.file.full_path = /.*\\odbcconf.exe$/ nocase) or ($e.target.process.file.name = "odbcconf.exe")))

  condition:
    $e
}
