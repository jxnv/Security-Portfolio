// Title: Suspicious Powercfg Execution To Change Lock Screen Timeout
// ID: f8d6a15e-4bc8-4c27-8e5d-2b10f0b73e5b
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-11-18
// Tags: attack.stealth
// Description: Detects suspicious execution of 'Powercfg.exe' to change lock screen timeout
// Converted by: Sigma Universal SIEM/EDR CLI

rule f8d6a15e_4bc8_4c27_8e5d_2b10f0b73e5b {
  meta:
    title = "Suspicious Powercfg Execution To Change Lock Screen Timeout"
    description = "Detects suspicious execution of 'Powercfg.exe' to change lock screen timeout"
    author = "frack113"
    severity = "MEDIUM"

  events:
    ((($e.target.process.file.full_path = /.*\\powercfg.exe$/ nocase) or ($e.target.process.file.name = "PowerCfg.exe")) and ((($e.target.process.command_line = /.*/setacvalueindex .*/ nocase and $e.target.process.command_line = /.*SCHEME_CURRENT.*/ nocase and $e.target.process.command_line = /.*SUB_VIDEO.*/ nocase and $e.target.process.command_line = /.*VIDEOCONLOCK.*/ nocase)) or (($e.target.process.command_line = /.*-change .*/ nocase and $e.target.process.command_line = /.*-standby-timeout-.*/ nocase))))

  condition:
    $e
}
