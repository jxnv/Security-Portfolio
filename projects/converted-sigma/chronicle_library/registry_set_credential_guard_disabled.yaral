// Title: Windows Credential Guard Disabled - Registry
// ID: 73921b9c-cafd-4446-b0c6-fdb0ace42bc0
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-12-26
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects attempts to disable Windows Credential Guard by setting registry values to 0. Credential Guard uses virtualization-based security to isolate secrets so that only privileged system software can access them.
// Adversaries may disable Credential Guard to gain access to sensitive credentials stored in the system, such as NTLM hashes and Kerberos tickets, which can be used for lateral movement and privilege escalation.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 73921b9c_cafd_4446_b0c6_fdb0ace42bc0 {
  meta:
    title = "Windows Credential Guard Disabled - Registry"
    description = "Detects attempts to disable Windows Credential Guard by setting registry values to 0. Credential Guard uses virtualization-based security to isolate secrets so that only privileged system software can access them. Adversaries may disable Credential Guard to gain access to sensitive credentials stored in the system, such as NTLM hashes and Kerberos tickets, which can be used for lateral movement and privilege escalation."
    author = "Swachchhanda Shrawan Poudel (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.TargetObject = /.*\\DeviceGuard\\EnableVirtualizationBasedSecurity$/ nocase or $e.TargetObject = /.*\\DeviceGuard\\LsaCfgFlags$/ nocase or $e.TargetObject = /.*\\Lsa\\LsaCfgFlags$/ nocase) and $e.Details = "DWORD (0x00000000)")

  condition:
    $e
}
