// Title: Google Cloud Firewall Modified or Deleted
// ID: fe513c69-734c-4d4a-8548-ac5f609be82b
// Status: test
// Level: medium
// Author: Austin Songer @austinsonger
// Date: 2021-08-13
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects  when a firewall rule is modified or deleted in Google Cloud Platform (GCP).
// Converted by: Sigma Universal SIEM/EDR CLI

rule fe513c69_734c_4d4a_8548_ac5f609be82b {
  meta:
    title = "Google Cloud Firewall Modified or Deleted"
    description = "Detects  when a firewall rule is modified or deleted in Google Cloud Platform (GCP)."
    author = "Austin Songer @austinsonger"
    severity = "MEDIUM"

  events:
    (($e.gcp.audit.method_name = "v*.Compute.Firewalls.Delete" or $e.gcp.audit.method_name = "v*.Compute.Firewalls.Patch" or $e.gcp.audit.method_name = "v*.Compute.Firewalls.Update" or $e.gcp.audit.method_name = "v*.Compute.Firewalls.Insert"))

  condition:
    $e
}
