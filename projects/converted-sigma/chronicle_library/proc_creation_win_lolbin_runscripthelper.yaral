rule eca49c87_8a75_4f13_9c73_a5a29e845f03 {
  meta:
    title = "Suspicious Runscripthelper.exe"
    description = "Detects execution of powershell scripts via Runscripthelper.exe"
    author = "Victor Sergeev, oscd.community"
    severity = "MEDIUM"

  events:
    ($e.target.process.file.full_path = /.*\\Runscripthelper.exe$/ nocase and $e.target.process.command_line = /.*surfacecheck.*/ nocase)

  condition:
    $e
}
