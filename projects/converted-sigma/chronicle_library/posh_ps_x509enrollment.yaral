rule 504d63cb_0dba_4d02_8531_e72981aace2c {
  meta:
    title = "Suspicious X509Enrollment - Ps Script"
    description = "Detect use of X509Enrollment"
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.ScriptBlockText = /.*X509Enrollment.CBinaryConverter.*/ nocase or $e.ScriptBlockText = /.*884e2002-217d-11da-b2a4-000e7bbb2b09.*/ nocase))

  condition:
    $e
}
