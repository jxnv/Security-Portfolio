// Title: ADFS Database Named Pipe Connection By Uncommon Tool
// ID: 1ea13e8c-03ea-409b-877d-ce5c3d2c1cb3
// Status: test
// Level: medium
// Author: Roberto Rodriguez @Cyb3rWard0g
// Date: 2021-10-08
// Tags: attack.collection, attack.t1005
// Description: Detects suspicious local connections via a named pipe to the AD FS configuration database (Windows Internal Database).
// Used to access information such as the AD FS configuration settings which contains sensitive information used to sign SAML tokens.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 1ea13e8c_03ea_409b_877d_ce5c3d2c1cb3 {
  meta:
    title = "ADFS Database Named Pipe Connection By Uncommon Tool"
    description = "Detects suspicious local connections via a named pipe to the AD FS configuration database (Windows Internal Database). Used to access information such as the AD FS configuration settings which contains sensitive information used to sign SAML tokens."
    author = "Roberto Rodriguez @Cyb3rWard0g"
    severity = "MEDIUM"

  events:
    (($e.PipeName = "\\MICROSOFT##WID\\tsql\\query") and not((($e.target.process.file.full_path = /.*:\\Windows\\System32\\mmc.exe$/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\system32\\svchost.exe$/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\System32\\wsmprovhost.exe$/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\SysWOW64\\mmc.exe$/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\SysWOW64\\wsmprovhost.exe$/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\WID\\Binn\\sqlwriter.exe$/ nocase or $e.target.process.file.full_path = /.*\\AzureADConnect.exe$/ nocase or $e.target.process.file.full_path = /.*\\Microsoft.Identity.Health.Adfs.PshSurrogate.exe$/ nocase or $e.target.process.file.full_path = /.*\\Microsoft.IdentityServer.ServiceHost.exe$/ nocase or $e.target.process.file.full_path = /.*\\Microsoft.Tri.Sensor.exe$/ nocase or $e.target.process.file.full_path = /.*\\sqlservr.exe$/ nocase or $e.target.process.file.full_path = /.*\\tssdis.exe$/ nocase))))

  condition:
    $e
}
