rule b37998de_a70b_4f33_b219_ec36bf433dc0 {
  meta:
    title = "PUA - PingCastle Execution From Potentially Suspicious Parent"
    description = "Detects the execution of PingCastle, a tool designed to quickly assess the Active Directory security level via a script located in a potentially suspicious or uncommon location."
    author = "Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)"
    severity = "HIGH"

  events:
    (((($e.principal.process.command_line = /.*.bat.*/ nocase or $e.principal.process.command_line = /.*.chm.*/ nocase or $e.principal.process.command_line = /.*.cmd.*/ nocase or $e.principal.process.command_line = /.*.hta.*/ nocase or $e.principal.process.command_line = /.*.htm.*/ nocase or $e.principal.process.command_line = /.*.html.*/ nocase or $e.principal.process.command_line = /.*.js.*/ nocase or $e.principal.process.command_line = /.*.lnk.*/ nocase or $e.principal.process.command_line = /.*.ps1.*/ nocase or $e.principal.process.command_line = /.*.vbe.*/ nocase or $e.principal.process.command_line = /.*.vbs.*/ nocase or $e.principal.process.command_line = /.*.wsf.*/ nocase)) or (($e.principal.process.command_line = /.*:\\Perflogs\\.*/ nocase or $e.principal.process.command_line = /.*:\\Temp\\.*/ nocase or $e.principal.process.command_line = /.*:\\Users\\Public\\.*/ nocase or $e.principal.process.command_line = /.*:\\Windows\\Temp\\.*/ nocase or $e.principal.process.command_line = /.*\\AppData\\Local\\Temp.*/ nocase or $e.principal.process.command_line = /.*\\AppData\\Roaming\\.*/ nocase or $e.principal.process.command_line = /.*\\Temporary Internet.*/ nocase)) or ((($e.principal.process.command_line = /.*:\\Users\\.*/ nocase and $e.principal.process.command_line = /.*\\Favorites\\.*/ nocase)) or (($e.principal.process.command_line = /.*:\\Users\\.*/ nocase and $e.principal.process.command_line = /.*\\Favourites\\.*/ nocase)) or (($e.principal.process.command_line = /.*:\\Users\\.*/ nocase and $e.principal.process.command_line = /.*\\Contacts\\.*/ nocase)))) and (($e.principal.process.command_line = /.*.bat.*/ nocase or $e.principal.process.command_line = /.*.chm.*/ nocase or $e.principal.process.command_line = /.*.cmd.*/ nocase or $e.principal.process.command_line = /.*.hta.*/ nocase or $e.principal.process.command_line = /.*.htm.*/ nocase or $e.principal.process.command_line = /.*.html.*/ nocase or $e.principal.process.command_line = /.*.js.*/ nocase or $e.principal.process.command_line = /.*.lnk.*/ nocase or $e.principal.process.command_line = /.*.ps1.*/ nocase or $e.principal.process.command_line = /.*.vbe.*/ nocase or $e.principal.process.command_line = /.*.vbs.*/ nocase or $e.principal.process.command_line = /.*.wsf.*/ nocase)) and (($e.target.process.file.full_path = /.*\\PingCastle.exe$/ nocase) or ($e.target.process.file.name = "PingCastle.exe") or ($e.Product = "Ping Castle") or (($e.target.process.command_line = /.*--scanner aclcheck.*/ nocase or $e.target.process.command_line = /.*--scanner antivirus.*/ nocase or $e.target.process.command_line = /.*--scanner computerversion.*/ nocase or $e.target.process.command_line = /.*--scanner foreignusers.*/ nocase or $e.target.process.command_line = /.*--scanner laps_bitlocker.*/ nocase or $e.target.process.command_line = /.*--scanner localadmin.*/ nocase or $e.target.process.command_line = /.*--scanner nullsession.*/ nocase or $e.target.process.command_line = /.*--scanner nullsession-trust.*/ nocase or $e.target.process.command_line = /.*--scanner oxidbindings.*/ nocase or $e.target.process.command_line = /.*--scanner remote.*/ nocase or $e.target.process.command_line = /.*--scanner share.*/ nocase or $e.target.process.command_line = /.*--scanner smb.*/ nocase or $e.target.process.command_line = /.*--scanner smb3querynetwork.*/ nocase or $e.target.process.command_line = /.*--scanner spooler.*/ nocase or $e.target.process.command_line = /.*--scanner startup.*/ nocase or $e.target.process.command_line = /.*--scanner zerologon.*/ nocase)) or ($e.target.process.command_line = /.*--no-enum-limit.*/ nocase) or (($e.target.process.command_line = /.*--healthcheck.*/ nocase and $e.target.process.command_line = /.*--level Full.*/ nocase)) or (($e.target.process.command_line = /.*--healthcheck.*/ nocase and $e.target.process.command_line = /.*--server .*/ nocase))))

  condition:
    $e
}
