// Title: Uncommon Child Process Of BgInfo.EXE
// ID: aaf46cdc-934e-4284-b329-34aa701e3771
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Beyu Denis, oscd.community
// Date: 2019-10-26
// Tags: attack.execution, attack.stealth, attack.t1059.005, attack.t1218, attack.t1202
// Description: Detects uncommon child processes of "BgInfo.exe" which could be a sign of potential abuse of the binary to proxy execution via external VBScript
// Converted by: Sigma Universal SIEM/EDR CLI

rule aaf46cdc_934e_4284_b329_34aa701e3771 {
  meta:
    title = "Uncommon Child Process Of BgInfo.EXE"
    description = "Detects uncommon child processes of "BgInfo.exe" which could be a sign of potential abuse of the binary to proxy execution via external VBScript"
    author = "Nasreddine Bencherchali (Nextron Systems), Beyu Denis, oscd.community"
    severity = "MEDIUM"

  events:
    (($e.principal.process.file.full_path = /.*\\bginfo.exe$/ nocase or $e.principal.process.file.full_path = /.*\\bginfo64.exe$/ nocase))

  condition:
    $e
}
