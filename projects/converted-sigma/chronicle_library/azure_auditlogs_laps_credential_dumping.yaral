// Title: Windows LAPS Credential Dump From Entra ID
// ID: a4b25073-8947-489c-a8dd-93b41c23f26d
// Status: test
// Level: high
// Author: andrewdanis
// Date: 2024-06-26
// Tags: attack.privilege-escalation, attack.persistence, attack.t1098.005
// Description: Detects when an account dumps the LAPS password from Entra ID.
// Converted by: Sigma Universal SIEM/EDR CLI

rule a4b25073_8947_489c_a8dd_93b41c23f26d {
  meta:
    title = "Windows LAPS Credential Dump From Entra ID"
    description = "Detects when an account dumps the LAPS password from Entra ID."
    author = "andrewdanis"
    severity = "HIGH"

  events:
    ($e.category = "Device" and $e.activityType = /.*Recover device local administrator password.*/ nocase and $e.additionalDetails.additionalInfo = /.*Successfully recovered local credential by device id.*/ nocase)

  condition:
    $e
}
