rule 1f6399cf_2c80_4924_ace1_6fcff3393480 {
  meta:
    title = "DirectorySearcher Powershell Exploitation"
    description = "Enumerates Active Directory to determine computers that are joined to the domain"
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.ScriptBlockText = /.*New-Object .*/ nocase and $e.ScriptBlockText = /.*System.DirectoryServices.DirectorySearcher.*/ nocase and $e.ScriptBlockText = /.*.PropertiesToLoad.Add.*/ nocase and $e.ScriptBlockText = /.*.findall().*/ nocase and $e.ScriptBlockText = /.*Properties.name.*/ nocase))

  condition:
    $e
}
