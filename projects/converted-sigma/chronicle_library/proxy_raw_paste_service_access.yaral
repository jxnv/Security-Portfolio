// Title: Raw Paste Service Access
// ID: 5468045b-4fcc-4d1a-973c-c9c9578edacb
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2019-12-05
// Tags: attack.command-and-control, attack.t1071.001, attack.t1102.001, attack.t1102.003
// Description: Detects direct access to raw pastes in different paste services often used by malware in their second stages to download malicious code in encrypted or encoded form
// Converted by: Sigma Universal SIEM/EDR CLI

rule 5468045b_4fcc_4d1a_973c_c9c9578edacb {
  meta:
    title = "Raw Paste Service Access"
    description = "Detects direct access to raw pastes in different paste services often used by malware in their second stages to download malicious code in encrypted or encoded form"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.c-uri = /.*.paste.ee/r/.*/ nocase or $e.c-uri = /.*.pastebin.com/raw/.*/ nocase or $e.c-uri = /.*.hastebin.com/raw/.*/ nocase or $e.c-uri = /.*.ghostbin.co/paste/*/raw/.*/ nocase or $e.c-uri = /.*pastetext.net/.*/ nocase or $e.c-uri = /.*pastebin.pl/.*/ nocase or $e.c-uri = /.*paste.ee/.*/ nocase))

  condition:
    $e
}
