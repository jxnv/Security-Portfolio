// Title: Renamed Msdt.EXE Execution
// ID: bd1c6866-65fc-44b2-be51-5588fcff82b9
// Status: test
// Level: high
// Author: pH-T (Nextron Systems)
// Date: 2022-06-03
// Tags: attack.stealth, attack.t1036.003
// Description: Detects the execution of a renamed "Msdt.exe" binary
// Converted by: Sigma Universal SIEM/EDR CLI

rule bd1c6866_65fc_44b2_be51_5588fcff82b9 {
  meta:
    title = "Renamed Msdt.EXE Execution"
    description = "Detects the execution of a renamed "Msdt.exe" binary"
    author = "pH-T (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.file.name = "msdt.exe") and not(($e.target.process.file.full_path = /.*\\msdt.exe$/ nocase)))

  condition:
    $e
}
