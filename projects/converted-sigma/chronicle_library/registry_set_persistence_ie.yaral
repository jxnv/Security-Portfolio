// Title: Modification of IE Registry Settings
// ID: d88d0ab2-e696-4d40-a2ed-9790064e66b3
// Status: test
// Level: low
// Author: frack113
// Date: 2022-01-22
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects modification of the registry settings used for Internet Explorer and other Windows components that use these settings. An attacker can abuse this registry key to add a domain to the trusted sites Zone or insert JavaScript for persistence
// Converted by: Sigma Universal SIEM/EDR CLI

rule d88d0ab2_e696_4d40_a2ed_9790064e66b3 {
  meta:
    title = "Modification of IE Registry Settings"
    description = "Detects modification of the registry settings used for Internet Explorer and other Windows components that use these settings. An attacker can abuse this registry key to add a domain to the trusted sites Zone or insert JavaScript for persistence"
    author = "frack113"
    severity = "LOW"

  events:
    (($e.TargetObject = /.*\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings.*/ nocase) and not((($e.Details = "Binary Data") or ($e.Details = /^DWORD.*/ nocase) or (not ($e.Details = /.*/)) or (($e.Details = "Cookie:" or $e.Details = "Visited:" or $e.Details = "(Empty)")) or (($e.TargetObject = /.*\\Cache.*/ nocase or $e.TargetObject = /.*\\ZoneMap.*/ nocase or $e.TargetObject = /.*\\WpadDecision.*/ nocase)))) and not(($e.TargetObject = /.*\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Accepted Documents.*/ nocase)))

  condition:
    $e
}
