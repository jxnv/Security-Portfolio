// Description: Detects files that have extensions commonly seen while SDelete is used to wipe files.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 39a80702_d7ca_4a83_b776_525b1f86a36d {
  meta:
    title = "Potential Secure Deletion with SDelete"
    description = "Detects files that have extensions commonly seen while SDelete is used to wipe files."
    author = "Thomas Patzke"
    severity = "MEDIUM"

  events:
    (($e.EventID = 4656 or $e.EventID = 4663 or $e.EventID = 4658) and ($e.ObjectName = /.*.AAA$/ nocase or $e.ObjectName = /.*.ZZZ$/ nocase))

  condition:
    $e
}
