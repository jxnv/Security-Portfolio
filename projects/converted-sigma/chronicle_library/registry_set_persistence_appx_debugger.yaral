// Title: Potential Persistence Using DebugPath
// ID: df4dc653-1029-47ba-8231-3c44238cc0ae
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-07-27
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.015
// Description: Detects potential persistence using Appx DebugPath
// Converted by: Sigma Universal SIEM/EDR CLI

rule df4dc653_1029_47ba_8231_3c44238cc0ae {
  meta:
    title = "Potential Persistence Using DebugPath"
    description = "Detects potential persistence using Appx DebugPath"
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.TargetObject = /.*Classes\\ActivatableClasses\\Package\\Microsoft..*/ nocase and $e.TargetObject = /.*\\DebugPath$/ nocase) or ($e.TargetObject = /.*\\Software\\Microsoft\\Windows\\CurrentVersion\\PackagedAppXDebug\\Microsoft..*/ nocase and $e.TargetObject = /.*\\(Default)$/ nocase))

  condition:
    $e
}
