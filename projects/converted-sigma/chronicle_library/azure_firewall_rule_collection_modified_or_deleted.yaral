rule 025c9fe7_db72_49f9_af0d_31341dd7dd57 {
  meta:
    title = "Azure Firewall Rule Collection Modified or Deleted"
    description = "Identifies when Rule Collections (Application, NAT, and Network) is being modified or deleted."
    author = "Austin Songer @austinsonger"
    severity = "MEDIUM"

  events:
    (($e.operationName = "MICROSOFT.NETWORK/AZUREFIREWALLS/APPLICATIONRULECOLLECTIONS/WRITE" or $e.operationName = "MICROSOFT.NETWORK/AZUREFIREWALLS/APPLICATIONRULECOLLECTIONS/DELETE" or $e.operationName = "MICROSOFT.NETWORK/AZUREFIREWALLS/NATRULECOLLECTIONS/WRITE" or $e.operationName = "MICROSOFT.NETWORK/AZUREFIREWALLS/NATRULECOLLECTIONS/DELETE" or $e.operationName = "MICROSOFT.NETWORK/AZUREFIREWALLS/NETWORKRULECOLLECTIONS/WRITE" or $e.operationName = "MICROSOFT.NETWORK/AZUREFIREWALLS/NETWORKRULECOLLECTIONS/DELETE"))

  condition:
    $e
}
