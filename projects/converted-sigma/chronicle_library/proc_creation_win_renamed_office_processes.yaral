// Title: Renamed Office Binary Execution
// ID: 0b0cd537-fc77-4e6e-a973-e53495c1083d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-20
// Tags: attack.stealth, attack.t1036.003
// Description: Detects the execution of a renamed office binary
// Converted by: Sigma Universal SIEM/EDR CLI

rule 0b0cd537_fc77_4e6e_a973_e53495c1083d {
  meta:
    title = "Renamed Office Binary Execution"
    description = "Detects the execution of a renamed office binary"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    (((($e.target.process.file.name = "Excel.exe" or $e.target.process.file.name = "MSACCESS.EXE" or $e.target.process.file.name = "MSPUB.EXE" or $e.target.process.file.name = "OneNote.exe" or $e.target.process.file.name = "OneNoteM.exe" or $e.target.process.file.name = "OUTLOOK.EXE" or $e.target.process.file.name = "POWERPNT.EXE" or $e.target.process.file.name = "WinWord.exe" or $e.target.process.file.name = "Olk.exe")) or (($e.Description = "Microsoft Access" or $e.Description = "Microsoft Excel" or $e.Description = "Microsoft OneNote" or $e.Description = "Microsoft Outlook" or $e.Description = "Microsoft PowerPoint" or $e.Description = "Microsoft Publisher" or $e.Description = "Microsoft Word" or $e.Description = "Sent to OneNote Tool"))) and not((($e.target.process.file.full_path = /.*\\EXCEL.exe$/ nocase or $e.target.process.file.full_path = /.*\\excelcnv.exe$/ nocase or $e.target.process.file.full_path = /.*\\MSACCESS.exe$/ nocase or $e.target.process.file.full_path = /.*\\MSPUB.EXE$/ nocase or $e.target.process.file.full_path = /.*\\ONENOTE.EXE$/ nocase or $e.target.process.file.full_path = /.*\\ONENOTEM.EXE$/ nocase or $e.target.process.file.full_path = /.*\\OUTLOOK.EXE$/ nocase or $e.target.process.file.full_path = /.*\\POWERPNT.EXE$/ nocase or $e.target.process.file.full_path = /.*\\WINWORD.exe$/ nocase or $e.target.process.file.full_path = /.*\\OLK.EXE$/ nocase))))

  condition:
    $e
}
