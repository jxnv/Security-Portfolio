// Title: Access To Windows DPAPI Master Keys By Uncommon Applications
// ID: 46612ae6-86be-4802-bc07-39b59feb1309
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-17
// Tags: attack.credential-access, attack.t1555.004
// Description: Detects file access requests to the the Windows Data Protection API Master keys by an uncommon application.
// This can be a sign of credential stealing. Example case would be usage of mimikatz "dpapi::masterkey" function
// Converted by: Sigma Universal SIEM/EDR CLI

rule 46612ae6_86be_4802_bc07_39b59feb1309 {
  meta:
    title = "Access To Windows DPAPI Master Keys By Uncommon Applications"
    description = "Detects file access requests to the the Windows Data Protection API Master keys by an uncommon application. This can be a sign of credential stealing. Example case would be usage of mimikatz "dpapi::masterkey" function"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.FileName = /.*\\Microsoft\\Protect\\S-1-5-18\\.*/ nocase or $e.FileName = /.*\\Microsoft\\Protect\\S-1-5-21-.*/ nocase)) and not((($e.target.process.file.full_path = "C:\\Windows\\explorer.exe") or (($e.target.process.file.full_path = /^C:\\Program Files\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files (x86)\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\system32\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\SysWOW64\\.*/ nocase)))))

  condition:
    $e
}
