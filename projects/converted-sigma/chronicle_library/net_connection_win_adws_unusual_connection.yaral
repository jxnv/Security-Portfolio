// Title: Uncommon Connection to Active Directory Web Services
// ID: b3ad3c0f-c949-47a1-a30e-b0491ccae876
// Status: test
// Level: medium
// Author: @kostastsale
// Date: 2024-01-26
// Tags: attack.discovery, attack.t1087
// Description: Detects uncommon network connections to the Active Directory Web Services (ADWS) from processes not typically associated with ADWS management.
// Converted by: Sigma Universal SIEM/EDR CLI

rule b3ad3c0f_c949_47a1_a30e_b0491ccae876 {
  meta:
    title = "Uncommon Connection to Active Directory Web Services"
    description = "Detects uncommon network connections to the Active Directory Web Services (ADWS) from processes not typically associated with ADWS management."
    author = "@kostastsale"
    severity = "MEDIUM"

  events:
    (($e.Initiated = True and $e.target.port = 9389) and not((($e.target.process.file.full_path = "C:\\Windows\\system32\\dsac.exe") or ($e.target.process.file.full_path = "C:\\Program Files\\Microsoft Monitoring Agent\\") or (($e.target.process.file.full_path = /^C:\\Program Files\\PowerShell\\7\\pwsh.exe.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\PowerShell\\7-preview\\pwsh.ex.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\System32\\WindowsPowerShell\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\SysWOW64\\WindowsPowerShell\\.*/ nocase)))))

  condition:
    $e
}
