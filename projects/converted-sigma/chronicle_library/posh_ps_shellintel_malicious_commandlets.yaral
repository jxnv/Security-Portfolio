// Title: Malicious ShellIntel PowerShell Commandlets
// ID: 402e1e1d-ad59-47b6-bf80-1ee44985b3a7
// Status: test
// Level: high
// Author: Max Altgelt (Nextron Systems), Tobias Michalski (Nextron Systems)
// Date: 2021-08-09
// Tags: attack.execution, attack.t1059.001
// Description: Detects Commandlet names from ShellIntel exploitation scripts.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 402e1e1d_ad59_47b6_bf80_1ee44985b3a7 {
  meta:
    title = "Malicious ShellIntel PowerShell Commandlets"
    description = "Detects Commandlet names from ShellIntel exploitation scripts."
    author = "Max Altgelt (Nextron Systems), Tobias Michalski (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.ScriptBlockText = /.*Invoke-SMBAutoBrute.*/ nocase or $e.ScriptBlockText = /.*Invoke-GPOLinks.*/ nocase or $e.ScriptBlockText = /.*Invoke-Potato.*/ nocase))

  condition:
    $e
}
