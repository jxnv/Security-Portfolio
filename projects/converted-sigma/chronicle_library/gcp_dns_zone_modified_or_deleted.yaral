rule 28268a8f_191f_4c17_85b2_f5aa4fa829c3 {
  meta:
    title = "Google Cloud DNS Zone Modified or Deleted"
    description = "Identifies when a DNS Zone is modified or deleted in Google Cloud."
    author = "Austin Songer @austinsonger"
    severity = "MEDIUM"

  events:
    (($e.gcp.audit.method_name = "Dns.ManagedZones.Delete" or $e.gcp.audit.method_name = "Dns.ManagedZones.Update" or $e.gcp.audit.method_name = "Dns.ManagedZones.Patch"))

  condition:
    $e
}
