// Title: WinRAR Creating Files in Startup Locations
// ID: 74a2b37d-fea4-41e0-9ac7-c9fbcf1f60cc
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-07-16
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects WinRAR creating files in Windows startup locations, which may indicate an attempt to establish persistence by adding malicious files to the Startup folder.
// This kind of behaviour has been associated with exploitation of WinRAR path traversal vulnerability CVE-2025-6218 or CVE-2025-8088.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 74a2b37d_fea4_41e0_9ac7_c9fbcf1f60cc {
  meta:
    title = "WinRAR Creating Files in Startup Locations"
    description = "Detects WinRAR creating files in Windows startup locations, which may indicate an attempt to establish persistence by adding malicious files to the Startup folder. This kind of behaviour has been associated with exploitation of WinRAR path traversal vulnerability CVE-2025-6218 or CVE-2025-8088."
    author = "Swachchhanda Shrawan Poudel (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.file.full_path = /.*\\WinRAR.exe$/ nocase or $e.target.process.file.full_path = /.*\\Rar.exe$/ nocase) and $e.target.file.full_path = /.*\\Start Menu\\Programs\\Startup\\.*/ nocase)

  condition:
    $e
}
