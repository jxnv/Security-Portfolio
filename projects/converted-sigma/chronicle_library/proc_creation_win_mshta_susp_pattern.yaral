// Title: Suspicious Mshta.EXE Execution Patterns
// ID: e32f92d1-523e-49c3-9374-bdb13b46a3ba
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-07-17
// Tags: attack.execution, attack.t1106
// Description: Detects suspicious mshta process execution patterns
// Converted by: Sigma Universal SIEM/EDR CLI

rule e32f92d1_523e_49c3_9374_bdb13b46a3ba {
  meta:
    title = "Suspicious Mshta.EXE Execution Patterns"
    description = "Detects suspicious mshta process execution patterns"
    author = "Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    (((($e.target.process.file.full_path = /.*\\mshta.exe$/ nocase) or ($e.target.process.file.name = "MSHTA.EXE")) and (($e.principal.process.file.full_path = /.*\\cmd.exe$/ nocase or $e.principal.process.file.full_path = /.*\\cscript.exe$/ nocase or $e.principal.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.principal.process.file.full_path = /.*\\pwsh.exe$/ nocase or $e.principal.process.file.full_path = /.*\\regsvr32.exe$/ nocase or $e.principal.process.file.full_path = /.*\\rundll32.exe$/ nocase or $e.principal.process.file.full_path = /.*\\wscript.exe$/ nocase) and ($e.target.process.command_line = /.*\\AppData\\Local\\.*/ nocase or $e.target.process.command_line = /.*C:\\ProgramData\\.*/ nocase or $e.target.process.command_line = /.*C:\\Users\\Public\\.*/ nocase or $e.target.process.command_line = /.*C:\\Windows\\Temp\\.*/ nocase))) or ((($e.target.process.file.full_path = /.*\\mshta.exe$/ nocase) or ($e.target.process.file.name = "MSHTA.EXE")) and not(((($e.target.process.file.full_path = /^C:\\Windows\\System32\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\SysWOW64\\.*/ nocase)) or (($e.target.process.command_line = /.*.htm.*/ nocase or $e.target.process.command_line = /.*.hta.*/ nocase)) or (($e.target.process.command_line = /.*mshta.exe$/ nocase or $e.target.process.command_line = /.*mshta$/ nocase))))))

  condition:
    $e
}
