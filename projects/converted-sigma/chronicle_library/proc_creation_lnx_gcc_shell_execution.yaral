// Title: Shell Execution GCC  - Linux
// ID: 9b5de532-a757-4d70-946c-1f3e44f48b4d
// Status: test
// Level: high
// Author: Li Ling, Andy Parkidomo, Robert Rakowski, Blake Hartstein (Bloomberg L.P.)
// Date: 2024-09-02
// Tags: attack.discovery, attack.t1083
// Description: Detects the use of the "gcc" utility to execute a shell. Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 9b5de532_a757_4d70_946c_1f3e44f48b4d {
  meta:
    title = "Shell Execution GCC  - Linux"
    description = "Detects the use of the "gcc" utility to execute a shell. Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments."
    author = "Li Ling, Andy Parkidomo, Robert Rakowski, Blake Hartstein (Bloomberg L.P.)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*/bin/bash,-s.*/ nocase or $e.target.process.command_line = /.*/bin/dash,-s.*/ nocase or $e.target.process.command_line = /.*/bin/fish,-s.*/ nocase or $e.target.process.command_line = /.*/bin/sh,-s.*/ nocase or $e.target.process.command_line = /.*/bin/zsh,-s.*/ nocase)) and (($e.target.process.file.full_path = /.*/c89$/ nocase or $e.target.process.file.full_path = /.*/c99$/ nocase or $e.target.process.file.full_path = /.*/gcc$/ nocase) and $e.target.process.command_line = /.*-wrapper.*/ nocase))

  condition:
    $e
}
