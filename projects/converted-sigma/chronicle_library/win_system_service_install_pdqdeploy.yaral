// Title: New PDQDeploy Service - Server Side
// ID: ee9ca27c-9bd7-4cee-9b01-6e906be7cae3
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-22
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects a PDQDeploy service installation which indicates that PDQDeploy was installed on the machines.
// PDQDeploy can be abused by attackers to remotely install packages or execute commands on target machines
// Converted by: Sigma Universal SIEM/EDR CLI

rule ee9ca27c_9bd7_4cee_9b01_6e906be7cae3 {
  meta:
    title = "New PDQDeploy Service - Server Side"
    description = "Detects a PDQDeploy service installation which indicates that PDQDeploy was installed on the machines. PDQDeploy can be abused by attackers to remotely install packages or execute commands on target machines"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.Provider_Name = "Service Control Manager" and $e.EventID = 7045) and (($e.ImagePath = /.*PDQDeployService.exe.*/ nocase) or (($e.ServiceName = "PDQDeploy" or $e.ServiceName = "PDQ Deploy"))))

  condition:
    $e
}
