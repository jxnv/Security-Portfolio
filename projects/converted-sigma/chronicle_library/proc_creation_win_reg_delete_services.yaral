// Title: Service Registry Key Deleted Via Reg.EXE
// ID: 05b2aa93-1210-42c8-8d9a-2fcc13b284f5
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-01
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects execution of "reg.exe" commands with the "delete" flag on services registry key. Often used by attacker to remove AV software services
// Converted by: Sigma Universal SIEM/EDR CLI

rule 05b2aa93_1210_42c8_8d9a_2fcc13b284f5 {
  meta:
    title = "Service Registry Key Deleted Via Reg.EXE"
    description = "Detects execution of "reg.exe" commands with the "delete" flag on services registry key. Often used by attacker to remove AV software services"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.command_line = /.* delete .*/ nocase) and (($e.target.process.file.full_path = /.*reg.exe$/ nocase) or ($e.target.process.file.name = "reg.exe")) and ($e.target.process.command_line = /.*\\SYSTEM\\CurrentControlSet\\services\\.*/ nocase))

  condition:
    $e
}
