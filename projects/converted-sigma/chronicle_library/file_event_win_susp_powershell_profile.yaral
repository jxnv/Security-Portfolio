// Title: PowerShell Profile Modification
// ID: b5b78988-486d-4a80-b991-930eff3ff8bf
// Status: test
// Level: medium
// Author: HieuTT35, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-10-24
// Tags: attack.persistence, attack.privilege-escalation, attack.t1546.013
// Description: Detects the creation or modification of a powershell profile which could indicate suspicious activity as the profile can be used as a mean of persistence
// Converted by: Sigma Universal SIEM/EDR CLI

rule b5b78988_486d_4a80_b991_930eff3ff8bf {
  meta:
    title = "PowerShell Profile Modification"
    description = "Detects the creation or modification of a powershell profile which could indicate suspicious activity as the profile can be used as a mean of persistence"
    author = "HieuTT35, Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.target.file.full_path = /.*\\Microsoft.PowerShell_profile.ps1$/ nocase or $e.target.file.full_path = /.*\\PowerShell\\profile.ps1$/ nocase or $e.target.file.full_path = /.*\\Program Files\\PowerShell\\7-preview\\profile.ps1$/ nocase or $e.target.file.full_path = /.*\\Program Files\\PowerShell\\7\\profile.ps1$/ nocase or $e.target.file.full_path = /.*\\Windows\\System32\\WindowsPowerShell\\v1.0\\profile.ps1$/ nocase or $e.target.file.full_path = /.*\\WindowsPowerShell\\profile.ps1$/ nocase))

  condition:
    $e
}
