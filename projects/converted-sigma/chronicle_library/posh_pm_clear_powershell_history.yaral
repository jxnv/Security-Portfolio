// Title: Clear PowerShell History - PowerShell Module
// ID: f99276ad-d122-4989-a09a-d00904a5f9d2
// Status: test
// Level: medium
// Author: Ilyas Ochkov, Jonhnathan Ribeiro, Daniil Yugoslavskiy, oscd.community
// Date: 2019-10-25
// Tags: attack.stealth, attack.t1070.003
// Description: Detects keywords that could indicate clearing PowerShell history
// Converted by: Sigma Universal SIEM/EDR CLI

rule f99276ad_d122_4989_a09a_d00904a5f9d2 {
  meta:
    title = "Clear PowerShell History - PowerShell Module"
    description = "Detects keywords that could indicate clearing PowerShell history"
    author = "Ilyas Ochkov, Jonhnathan Ribeiro, Daniil Yugoslavskiy, oscd.community"
    severity = "MEDIUM"

  events:
    (((($e.Payload = /.*Set-PSReadlineOption.*/ nocase and $e.Payload = /.*–HistorySaveStyle.*/ nocase and $e.Payload = /.*SaveNothing.*/ nocase)) or (($e.Payload = /.*Set-PSReadlineOption.*/ nocase and $e.Payload = /.*-HistorySaveStyle.*/ nocase and $e.Payload = /.*SaveNothing.*/ nocase))) or ((($e.Payload = /.*del.*/ nocase or $e.Payload = /.*Remove-Item.*/ nocase or $e.Payload = /.*rm.*/ nocase)) and ($e.Payload = /.*(Get-PSReadlineOption).HistorySavePath.*/ nocase)))

  condition:
    $e
}
