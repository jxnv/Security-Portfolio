// Title: SQLite Chromium Profile Data DB Access
// ID: 24c77512-782b-448a-8950-eddb0785fc71
// Status: test
// Level: high
// Author: TropChaud
// Date: 2022-12-19
// Tags: attack.credential-access, attack.t1539, attack.t1555.003, attack.collection, attack.t1005
// Description: Detect usage of the "sqlite" binary to query databases in Chromium-based browsers for potential data stealing.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 24c77512_782b_448a_8950_eddb0785fc71 {
  meta:
    title = "SQLite Chromium Profile Data DB Access"
    description = "Detect usage of the "sqlite" binary to query databases in Chromium-based browsers for potential data stealing."
    author = "TropChaud"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.*\\User Data\\.*/ nocase or $e.target.process.command_line = /.*\\Opera Software\\.*/ nocase or $e.target.process.command_line = /.*\\ChromiumViewer\\.*/ nocase)) and (($e.target.process.command_line = /.*Login Data.*/ nocase or $e.target.process.command_line = /.*Cookies.*/ nocase or $e.target.process.command_line = /.*Web Data.*/ nocase or $e.target.process.command_line = /.*History.*/ nocase or $e.target.process.command_line = /.*Bookmarks.*/ nocase)) and (($e.Product = "SQLite") or (($e.target.process.file.full_path = /.*\\sqlite.exe$/ nocase or $e.target.process.file.full_path = /.*\\sqlite3.exe$/ nocase))))

  condition:
    $e
}
