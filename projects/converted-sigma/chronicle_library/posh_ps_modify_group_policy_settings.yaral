// Title: Modify Group Policy Settings - ScriptBlockLogging
// ID: b7216a7d-687e-4c8d-82b1-3080b2ad961f
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-08-19
// Tags: attack.privilege-escalation, attack.defense-impairment, attack.t1484.001
// Description: Detect malicious GPO modifications can be used to implement many other malicious behaviors.
// Converted by: Sigma Universal SIEM/EDR CLI

rule b7216a7d_687e_4c8d_82b1_3080b2ad961f {
  meta:
    title = "Modify Group Policy Settings - ScriptBlockLogging"
    description = "Detect malicious GPO modifications can be used to implement many other malicious behaviors."
    author = "frack113"
    severity = "MEDIUM"

  events:
    ((($e.ScriptBlockText = /.*GroupPolicyRefreshTimeDC.*/ nocase or $e.ScriptBlockText = /.*GroupPolicyRefreshTimeOffsetDC.*/ nocase or $e.ScriptBlockText = /.*GroupPolicyRefreshTime.*/ nocase or $e.ScriptBlockText = /.*GroupPolicyRefreshTimeOffset.*/ nocase or $e.ScriptBlockText = /.*EnableSmartScreen.*/ nocase or $e.ScriptBlockText = /.*ShellSmartScreenLevel.*/ nocase)) and ($e.ScriptBlockText = /.*\\SOFTWARE\\Policies\\Microsoft\\Windows\\System.*/ nocase))

  condition:
    $e
}
