// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Jack Croock (method), Jonhnathan Ribeiro (improvements), oscd.community
// Date: 2017-03-07
// Tags: attack.discovery, attack.t1087.002, attack.t1069.002, attack.s0039
// Description: Detects activity as "net user administrator /domain" and "net group domain admins /domain"
// Converted by: Sigma Universal SIEM/EDR CLI

rule 968eef52_9cff_4454_8992_1e74b9cbad6c {
  meta:
    title = "Reconnaissance Activity"
    description = "Detects activity as "net user administrator /domain" and "net group domain admins /domain""
    author = "Florian Roth (Nextron Systems), Jack Croock (method), Jonhnathan Ribeiro (improvements), oscd.community"
    severity = "HIGH"

  events:
    ($e.EventID = 4661 and $e.AccessMask = "0x2d" and ($e.ObjectType = "SAM_USER" or $e.ObjectType = "SAM_GROUP") and $e.ObjectName = /^S-1-5-21-.*/ nocase and ($e.ObjectName = /.*-500$/ nocase or $e.ObjectName = /.*-512$/ nocase))

  condition:
    $e
}
