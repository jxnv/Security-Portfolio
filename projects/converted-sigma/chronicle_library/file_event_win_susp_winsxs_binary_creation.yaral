// Title: WinSxS Executable File Creation By Non-System Process
// ID: 34746e8c-5fb8-415a-b135-0abc167e912a
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-11
// Tags: attack.execution
// Description: Detects the creation of binaries in the WinSxS folder by non-system processes
// Converted by: Sigma Universal SIEM/EDR CLI

rule 34746e8c_5fb8_415a_b135_0abc167e912a {
  meta:
    title = "WinSxS Executable File Creation By Non-System Process"
    description = "Detects the creation of binaries in the WinSxS folder by non-system processes"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (($e.target.file.full_path = /^C:\\Windows\\WinSxS\\.*/ nocase and $e.target.file.full_path = /.*.exe$/ nocase) and not((($e.target.process.file.full_path = /^C:\\Windows\\Systems32\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\SysWOW64\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\WinSxS\\.*/ nocase))))

  condition:
    $e
}
