// Title: Suspicious Msiexec Execute Arbitrary DLL
// ID: 6f4191bb-912b-48a8-9ce7-682769541e6d
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-01-16
// Tags: attack.stealth, attack.t1218.007
// Description: Adversaries may abuse msiexec.exe to proxy execution of malicious payloads.
// Msiexec.exe is the command-line utility for the Windows Installer and is thus commonly associated with executing installation packages (.msi)
// Converted by: Sigma Universal SIEM/EDR CLI

rule 6f4191bb_912b_48a8_9ce7_682769541e6d {
  meta:
    title = "Suspicious Msiexec Execute Arbitrary DLL"
    description = "Adversaries may abuse msiexec.exe to proxy execution of malicious payloads. Msiexec.exe is the command-line utility for the Windows Installer and is thus commonly associated with executing installation packages (.msi)"
    author = "frack113"
    severity = "MEDIUM"

  events:
    (($e.target.process.file.full_path = /.*\\msiexec.exe$/ nocase and $e.target.process.command_line = /.* /Y.*/ nocase) and not((($e.target.process.command_line = /.*\\MsiExec.exe\" /Y \"C:\\Program Files\\.*/ nocase or $e.target.process.command_line = /.*\\MsiExec.exe\" /Y \"C:\\Program Files (x86)\\.*/ nocase or $e.target.process.command_line = /.*\\MsiExec.exe\" /Y \"C:\\Windows\\System32\\.*/ nocase or $e.target.process.command_line = /.*\\MsiExec.exe\" /Y \"C:\\Windows\\SysWOW64\\.*/ nocase))))

  condition:
    $e
}
