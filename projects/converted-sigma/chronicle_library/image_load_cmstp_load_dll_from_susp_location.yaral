// Title: DLL Loaded From Suspicious Location Via Cmspt.EXE
// ID: 75e508f7-932d-4ebc-af77-269237a84ce1
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-30
// Tags: attack.stealth, attack.t1218.003
// Description: Detects cmstp loading "dll" or "ocx" files from suspicious locations
// Converted by: Sigma Universal SIEM/EDR CLI

rule 75e508f7_932d_4ebc_af77_269237a84ce1 {
  meta:
    title = "DLL Loaded From Suspicious Location Via Cmspt.EXE"
    description = "Detects cmstp loading "dll" or "ocx" files from suspicious locations"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ($e.target.process.file.full_path = /.*\\cmstp.exe$/ nocase and ($e.ImageLoaded = /.*\\PerfLogs\\.*/ nocase or $e.ImageLoaded = /.*\\ProgramData\\.*/ nocase or $e.ImageLoaded = /.*\\Users\\.*/ nocase or $e.ImageLoaded = /.*\\Windows\\Temp\\.*/ nocase or $e.ImageLoaded = /.*C:\\Temp\\.*/ nocase) and ($e.ImageLoaded = /.*.dll$/ nocase or $e.ImageLoaded = /.*.ocx$/ nocase))

  condition:
    $e
}
