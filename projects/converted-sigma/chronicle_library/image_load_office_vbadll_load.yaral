// Title: VBA DLL Loaded Via Office Application
// ID: e6ce8457-68b1-485b-9bdd-3c2b5d679aa9
// Status: test
// Level: high
// Author: Antonlovesdnb
// Date: 2020-02-19
// Tags: attack.execution, attack.t1204.002
// Description: Detects VB DLL's loaded by an office application. Which could indicate the presence of VBA Macros.
// Converted by: Sigma Universal SIEM/EDR CLI

rule e6ce8457_68b1_485b_9bdd_3c2b5d679aa9 {
  meta:
    title = "VBA DLL Loaded Via Office Application"
    description = "Detects VB DLL's loaded by an office application. Which could indicate the presence of VBA Macros."
    author = "Antonlovesdnb"
    severity = "HIGH"

  events:
    (($e.target.process.file.full_path = /.*\\excel.exe$/ nocase or $e.target.process.file.full_path = /.*\\mspub.exe$/ nocase or $e.target.process.file.full_path = /.*\\onenote.exe$/ nocase or $e.target.process.file.full_path = /.*\\onenoteim.exe$/ nocase or $e.target.process.file.full_path = /.*\\outlook.exe$/ nocase or $e.target.process.file.full_path = /.*\\powerpnt.exe$/ nocase or $e.target.process.file.full_path = /.*\\winword.exe$/ nocase) and ($e.ImageLoaded = /.*\\VBE7.DLL$/ nocase or $e.ImageLoaded = /.*\\VBEUI.DLL$/ nocase or $e.ImageLoaded = /.*\\VBE7INTL.DLL$/ nocase))

  condition:
    $e
}
