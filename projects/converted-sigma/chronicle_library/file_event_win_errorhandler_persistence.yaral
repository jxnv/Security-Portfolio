// Title: Potential Persistence Attempt Via ErrorHandler.Cmd
// ID: 15904280-565c-4b73-9303-3291f964e7f9
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-09
// Tags: attack.persistence
// Description: Detects creation of a file named "ErrorHandler.cmd" in the "C:\WINDOWS\Setup\Scripts\" directory which could be used as a method of persistence
// The content of C:\WINDOWS\Setup\Scripts\ErrorHandler.cmd is read whenever some tools under C:\WINDOWS\System32\oobe\ (e.g. Setup.exe) fail to run for any reason.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 15904280_565c_4b73_9303_3291f964e7f9 {
  meta:
    title = "Potential Persistence Attempt Via ErrorHandler.Cmd"
    description = "Detects creation of a file named "ErrorHandler.cmd" in the "C:\WINDOWS\Setup\Scripts\" directory which could be used as a method of persistence The content of C:\WINDOWS\Setup\Scripts\ErrorHandler.cmd is read whenever some tools under C:\WINDOWS\System32\oobe\ (e.g. Setup.exe) fail to run for any reason."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ($e.target.file.full_path = /.*\\WINDOWS\\Setup\\Scripts\\ErrorHandler.cmd$/ nocase)

  condition:
    $e
}
