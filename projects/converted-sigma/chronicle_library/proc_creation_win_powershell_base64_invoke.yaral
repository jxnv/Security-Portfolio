// Title: PowerShell Base64 Encoded Invoke Keyword
// ID: 6385697e-9f1b-40bd-8817-f4a91f40508e
// Status: test
// Level: high
// Author: pH-T (Nextron Systems), Harjot Singh, @cyb3rjy0t
// Date: 2022-05-20
// Tags: attack.execution, attack.stealth, attack.t1059.001, attack.t1027
// Description: Detects UTF-8 and UTF-16 Base64 encoded powershell 'Invoke-' calls
// Converted by: Sigma Universal SIEM/EDR CLI

rule 6385697e_9f1b_40bd_8817_f4a91f40508e {
  meta:
    title = "PowerShell Base64 Encoded Invoke Keyword"
    description = "Detects UTF-8 and UTF-16 Base64 encoded powershell 'Invoke-' calls"
    author = "pH-T (Nextron Systems), Harjot Singh, @cyb3rjy0t"
    severity = "HIGH"

  events:
    (($e.target.process.command_line = /.* -e.*/ nocase) and (($e.target.process.command_line = /.*SQBuAHYAbwBrAGUALQ.*/ nocase or $e.target.process.command_line = /.*kAbgB2AG8AawBlAC0A.*/ nocase or $e.target.process.command_line = /.*JAG4AdgBvAGsAZQAtA.*/ nocase or $e.target.process.command_line = /.*SW52b2tlL.*/ nocase or $e.target.process.command_line = /.*ludm9rZS.*/ nocase or $e.target.process.command_line = /.*JbnZva2Ut.*/ nocase)) and ((($e.target.process.file.full_path = /.*\\powershell.exe$/ nocase or $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase)) or (($e.target.process.file.name = "PowerShell.EXE" or $e.target.process.file.name = "pwsh.dll"))))

  condition:
    $e
}
