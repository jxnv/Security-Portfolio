// Title: Potential DLL Sideloading Of MsCorSvc.DLL
// ID: cdb15e19-c2d0-432a-928e-e49c8c60dcf2
// Status: test
// Level: medium
// Author: Wietze Beukema
// Date: 2024-07-11
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of "mscorsvc.dll".
// Converted by: Sigma Universal SIEM/EDR CLI

rule cdb15e19_c2d0_432a_928e_e49c8c60dcf2 {
  meta:
    title = "Potential DLL Sideloading Of MsCorSvc.DLL"
    description = "Detects potential DLL sideloading of "mscorsvc.dll"."
    author = "Wietze Beukema"
    severity = "MEDIUM"

  events:
    (($e.ImageLoaded = /.*\\mscorsvc.dll$/ nocase) and not((($e.ImageLoaded = /^C:\\Windows\\Microsoft.NET\\Framework\\.*/ nocase or $e.ImageLoaded = /^C:\\Windows\\Microsoft.NET\\Framework64\\.*/ nocase or $e.ImageLoaded = /^C:\\Windows\\Microsoft.NET\\FrameworkArm\\.*/ nocase or $e.ImageLoaded = /^C:\\Windows\\Microsoft.NET\\FrameworkArm64\\.*/ nocase or $e.ImageLoaded = /^C:\\Windows\\WinSxS\\.*/ nocase))))

  condition:
    $e
}
