// Tags: attack.credential-access, attack.persistence, attack.defense-impairment, attack.t1556
// Description: Detects when a user disables a critical security feature for an organization.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 8622c92d_c00e_463c_b09d_fd06166f6794 {
  meta:
    title = "Github High Risk Configuration Disabled"
    description = "Detects when a user disables a critical security feature for an organization."
    author = "Muhammad Faisal (@faisalusuf)"
    severity = "HIGH"

  events:
    (($e.action = "business_advanced_security.disabled_for_new_repos" or $e.action = "business_advanced_security.disabled_for_new_user_namespace_repos" or $e.action = "business_advanced_security.disabled" or $e.action = "business_advanced_security.user_namespace_repos_disabled" or $e.action = "org.advanced_security_disabled_for_new_repos" or $e.action = "org.advanced_security_disabled_on_all_repos" or $e.action = "org.advanced_security_policy_selected_member_disabled" or $e.action = "org.disable_oauth_app_restrictions" or $e.action = "org.disable_two_factor_requirement" or $e.action = "repo.advanced_security_disabled"))

  condition:
    $e
}
