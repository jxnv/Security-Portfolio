// Title: Azure Virtual Network Device Modified or Deleted
// ID: 15ef3fac-f0f0-4dc4-ada0-660aa72980b3
// Status: test
// Level: medium
// Author: Austin Songer @austinsonger
// Date: 2021-08-08
// Tags: attack.impact
// Description: Identifies when a virtual network device is being modified or deleted.
// This can be a network interface, network virtual appliance, virtual hub, or virtual router.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 15ef3fac_f0f0_4dc4_ada0_660aa72980b3 {
  meta:
    title = "Azure Virtual Network Device Modified or Deleted"
    description = "Identifies when a virtual network device is being modified or deleted. This can be a network interface, network virtual appliance, virtual hub, or virtual router."
    author = "Austin Songer @austinsonger"
    severity = "MEDIUM"

  events:
    (($e.operationName = "MICROSOFT.NETWORK/NETWORKINTERFACES/TAPCONFIGURATIONS/WRITE" or $e.operationName = "MICROSOFT.NETWORK/NETWORKINTERFACES/TAPCONFIGURATIONS/DELETE" or $e.operationName = "MICROSOFT.NETWORK/NETWORKINTERFACES/WRITE" or $e.operationName = "MICROSOFT.NETWORK/NETWORKINTERFACES/JOIN/ACTION" or $e.operationName = "MICROSOFT.NETWORK/NETWORKINTERFACES/DELETE" or $e.operationName = "MICROSOFT.NETWORK/NETWORKVIRTUALAPPLIANCES/DELETE" or $e.operationName = "MICROSOFT.NETWORK/NETWORKVIRTUALAPPLIANCES/WRITE" or $e.operationName = "MICROSOFT.NETWORK/VIRTUALHUBS/DELETE" or $e.operationName = "MICROSOFT.NETWORK/VIRTUALHUBS/WRITE" or $e.operationName = "MICROSOFT.NETWORK/VIRTUALROUTERS/WRITE" or $e.operationName = "MICROSOFT.NETWORK/VIRTUALROUTERS/DELETE"))

  condition:
    $e
}
