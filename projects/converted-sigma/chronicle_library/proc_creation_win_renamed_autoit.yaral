// Title: Renamed AutoIt Execution
// ID: f4264e47-f522-4c38-a420-04525d5b880f
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2023-06-04
// Tags: attack.stealth, attack.t1027
// Description: Detects the execution of a renamed AutoIt2.exe or AutoIt3.exe.
// AutoIt is a scripting language and automation tool for Windows systems. While primarily used for legitimate automation tasks, it can be misused in cyber attacks.
// Attackers can leverage AutoIt to create and distribute malware, including keyloggers, spyware, and botnets. A renamed AutoIt executable is particularly suspicious.
// Converted by: Sigma Universal SIEM/EDR CLI

rule f4264e47_f522_4c38_a420_04525d5b880f {
  meta:
    title = "Renamed AutoIt Execution"
    description = "Detects the execution of a renamed AutoIt2.exe or AutoIt3.exe. AutoIt is a scripting language and automation tool for Windows systems. While primarily used for legitimate automation tasks, it can be misused in cyber attacks. Attackers can leverage AutoIt to create and distribute malware, including keyloggers, spyware, and botnets. A renamed AutoIt executable is particularly suspicious."
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (((($e.target.process.command_line = /.* /AutoIt3ExecuteScript.*/ nocase or $e.target.process.command_line = /.* /ErrorStdOut.*/ nocase)) or (($e.Hashes = /.*IMPHASH=FDC554B3A8683918D731685855683DDF.*/ nocase or $e.Hashes = /.*IMPHASH=CD30A61B60B3D60CECDB034C8C83C290.*/ nocase or $e.Hashes = /.*IMPHASH=F8A00C72F2D667D2EDBB234D0C0AE000.*/ nocase)) or (($e.target.process.file.name = "AutoIt3.exe" or $e.target.process.file.name = "AutoIt2.exe" or $e.target.process.file.name = "AutoIt.exe"))) and not((($e.target.process.file.full_path = /.*\\AutoIt.exe$/ nocase or $e.target.process.file.full_path = /.*\\AutoIt2.exe$/ nocase or $e.target.process.file.full_path = /.*\\AutoIt3_x64.exe$/ nocase or $e.target.process.file.full_path = /.*\\AutoIt3.exe$/ nocase))))

  condition:
    $e
}
