// Title: Windows Recall Feature Enabled Via Reg.EXE
// ID: 817f252c-5143-4dae-b418-48c3e9f63728
// Status: test
// Level: medium
// Author: Sajid Nawaz Khan
// Date: 2024-06-02
// Tags: attack.collection, attack.t1113
// Description: Detects the enabling of the Windows Recall feature via registry manipulation.
// Windows Recall can be enabled by deleting the existing "DisableAIDataAnalysis" value, or setting it to 0.
// Adversaries may enable Windows Recall as part of post-exploitation discovery and collection activities.
// This rule assumes that Recall is already explicitly disabled on the host, and subsequently enabled by the adversary.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 817f252c_5143_4dae_b418_48c3e9f63728 {
  meta:
    title = "Windows Recall Feature Enabled Via Reg.EXE"
    description = "Detects the enabling of the Windows Recall feature via registry manipulation. Windows Recall can be enabled by deleting the existing "DisableAIDataAnalysis" value, or setting it to 0. Adversaries may enable Windows Recall as part of post-exploitation discovery and collection activities. This rule assumes that Recall is already explicitly disabled on the host, and subsequently enabled by the adversary."
    author = "Sajid Nawaz Khan"
    severity = "MEDIUM"

  events:
    ((($e.target.process.file.full_path = /.*\\reg.exe$/ nocase) or ($e.target.process.file.name = "reg.exe")) and (($e.target.process.command_line = /.*Microsoft\\Windows\\WindowsAI.*/ nocase and $e.target.process.command_line = /.*DisableAIDataAnalysis.*/ nocase)) and ((($e.target.process.command_line = /.*add.*/ nocase or $e.target.process.command_line = /.*0.*/ nocase)) or ($e.target.process.command_line = /.*delete.*/ nocase)))

  condition:
    $e
}
