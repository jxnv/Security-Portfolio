// Title: Remote Task Creation via ATSVC Named Pipe
// ID: f6de6525-4509-495a-8a82-1f8b0ed73a00
// Status: test
// Level: medium
// Author: Samir Bousseaden
// Date: 2019-04-03
// Tags: attack.privilege-escalation, attack.execution, attack.lateral-movement, attack.persistence, car.2013-05-004, car.2015-04-001, attack.t1053.002
// Description: Detects remote task creation via at.exe or API interacting with ATSVC namedpipe
// Converted by: Sigma Universal SIEM/EDR CLI

rule f6de6525_4509_495a_8a82_1f8b0ed73a00 {
  meta:
    title = "Remote Task Creation via ATSVC Named Pipe"
    description = "Detects remote task creation via at.exe or API interacting with ATSVC namedpipe"
    author = "Samir Bousseaden"
    severity = "MEDIUM"

  events:
    ($e.EventID = 5145 and $e.ShareName = "\\\\\\\\\\*\\\\IPC$" and $e.RelativeTargetName = "atsvc" and $e.AccessList = /.*WriteData.*/ nocase)

  condition:
    $e
}
