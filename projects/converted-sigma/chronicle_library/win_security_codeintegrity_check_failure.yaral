// Title: Failed Code Integrity Checks
// ID: 470ec5fa-7b4e-4071-b200-4c753100f49b
// Status: stable
// Level: informational
// Author: Thomas Patzke
// Date: 2019-12-03
// Tags: attack.stealth, attack.t1027.001
// Description: Detects code integrity failures such as missing page hashes or corrupted drivers due unauthorized modification. This could be a sign of tampered binaries.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 470ec5fa_7b4e_4071_b200_4c753100f49b {
  meta:
    title = "Failed Code Integrity Checks"
    description = "Detects code integrity failures such as missing page hashes or corrupted drivers due unauthorized modification. This could be a sign of tampered binaries."
    author = "Thomas Patzke"
    severity = "INFORMATIONAL"

  events:
    ((($e.EventID = 5038 or $e.EventID = 6281)) and not(((($e.param1 = /.*\\CSFalconServiceUninstallTool_.*/ nocase or $e.param1 = /.*\\Program Files\\CrowdStrike\\.*/ nocase or $e.param1 = /.*\\System32\\drivers\\CrowdStrike\\.*/ nocase or $e.param1 = /.*\\Windows\\System32\\ScriptControl64_.*/ nocase)) or ($e.param1 = /.*\\Program Files\\Sophos\\.*/ nocase))))

  condition:
    $e
}
