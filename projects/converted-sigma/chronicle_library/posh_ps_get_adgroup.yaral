rule 8c3a6607_b7dc_4f0d_a646_ef38c00b76ee {
  meta:
    title = "Active Directory Group Enumeration With Get-AdGroup"
    description = "Detects usage of the "Get-AdGroup" cmdlet to enumerate Groups within Active Directory"
    author = "frack113"
    severity = "LOW"

  events:
    (($e.ScriptBlockText = /.*Get-AdGroup .*/ nocase and $e.ScriptBlockText = /.*-Filter.*/ nocase))

  condition:
    $e
}
