// Title: Potentially Suspicious CMD Shell Output Redirect
// ID: 8e0bb260-d4b2-4fff-bb8d-3f82118e6892
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-12
// Tags: attack.stealth, attack.t1218
// Description: Detects inline Windows shell commands redirecting output via the ">" symbol to a suspicious location.
// This technique is sometimes used by malicious actors in order to redirect the output of reconnaissance commands such as "hostname" and "dir" to files for future exfiltration.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 8e0bb260_d4b2_4fff_bb8d_3f82118e6892 {
  meta:
    title = "Potentially Suspicious CMD Shell Output Redirect"
    description = "Detects inline Windows shell commands redirecting output via the ">" symbol to a suspicious location. This technique is sometimes used by malicious actors in order to redirect the output of reconnaissance commands such as "hostname" and "dir" to files for future exfiltration."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.file.full_path = /.*\\cmd.exe$/ nocase) or ($e.target.process.file.name = "Cmd.Exe")) and ((($e.target.process.command_line = /.*>?%APPDATA%\\.*/ nocase or $e.target.process.command_line = /.*>?%TEMP%\\.*/ nocase or $e.target.process.command_line = /.*>?%TMP%\\.*/ nocase or $e.target.process.command_line = /.*>?%USERPROFILE%\\.*/ nocase or $e.target.process.command_line = /.*>?C:\\ProgramData\\.*/ nocase or $e.target.process.command_line = /.*>?C:\\Temp\\.*/ nocase or $e.target.process.command_line = /.*>?C:\\Users\\Public\\.*/ nocase or $e.target.process.command_line = /.*>?C:\\Windows\\Temp\\.*/ nocase)) or (($e.target.process.command_line = /.* >.*/ nocase or $e.target.process.command_line = /.*\">.*/ nocase or $e.target.process.command_line = /.*'>.*/ nocase) and ($e.target.process.command_line = /.*C:\\Users\\.*/ nocase and $e.target.process.command_line = /.*\\AppData\\Local\\.*/ nocase))))

  condition:
    $e
}
