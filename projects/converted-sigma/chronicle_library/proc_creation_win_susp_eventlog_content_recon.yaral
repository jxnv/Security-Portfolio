// Title: Potentially Suspicious EventLog Recon Activity Using Log Query Utilities
// ID: beaa66d6-aa1b-4e3c-80f5-e0145369bfaf
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.credential-access, attack.discovery, attack.t1552, attack.t1087
// Description: Detects execution of different log query utilities and commands to search and dump the content of specific event logs or look for specific event IDs.
// This technique is used by threat actors in order to extract sensitive information from events logs such as usernames, IP addresses, hostnames, etc.
// Converted by: Sigma Universal SIEM/EDR CLI

rule beaa66d6_aa1b_4e3c_80f5_e0145369bfaf {
  meta:
    title = "Potentially Suspicious EventLog Recon Activity Using Log Query Utilities"
    description = "Detects execution of different log query utilities and commands to search and dump the content of specific event logs or look for specific event IDs. This technique is used by threat actors in order to extract sensitive information from events logs such as usernames, IP addresses, hostnames, etc."
    author = "Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)"
    severity = "MEDIUM"

  events:
    (((($e.target.process.command_line = /.*-InstanceId 462?.*/ nocase or $e.target.process.command_line = /.*.eventid -eq 462?.*/ nocase or $e.target.process.command_line = /.*.ID -eq 462?.*/ nocase or $e.target.process.command_line = /.*EventCode=?462?.*/ nocase or $e.target.process.command_line = /.*EventIdentifier=?462?.*/ nocase or $e.target.process.command_line = /.*System[EventID=462?].*/ nocase or $e.target.process.command_line = /.*-InstanceId 4778.*/ nocase or $e.target.process.command_line = /.*.eventid -eq 4778.*/ nocase or $e.target.process.command_line = /.*.ID -eq 4778.*/ nocase or $e.target.process.command_line = /.*EventCode=?4778?.*/ nocase or $e.target.process.command_line = /.*EventIdentifier=?4778?.*/ nocase or $e.target.process.command_line = /.*System[EventID=4778].*/ nocase or $e.target.process.command_line = /.*-InstanceId 25.*/ nocase or $e.target.process.command_line = /.*.eventid -eq 25.*/ nocase or $e.target.process.command_line = /.*.ID -eq 25.*/ nocase or $e.target.process.command_line = /.*EventCode=?25?.*/ nocase or $e.target.process.command_line = /.*EventIdentifier=?25?.*/ nocase or $e.target.process.command_line = /.*System[EventID=25].*/ nocase or $e.target.process.command_line = /.*-InstanceId 1149.*/ nocase or $e.target.process.command_line = /.*.eventid -eq 1149.*/ nocase or $e.target.process.command_line = /.*.ID -eq 1149.*/ nocase or $e.target.process.command_line = /.*EventCode=?1149?.*/ nocase or $e.target.process.command_line = /.*EventIdentifier=?1149?.*/ nocase or $e.target.process.command_line = /.*System[EventID=1149].*/ nocase or $e.target.process.command_line = /.*-InstanceId 21.*/ nocase or $e.target.process.command_line = /.*.eventid -eq 21.*/ nocase or $e.target.process.command_line = /.*.ID -eq 21.*/ nocase or $e.target.process.command_line = /.*EventCode=?21?.*/ nocase or $e.target.process.command_line = /.*EventIdentifier=?21?.*/ nocase or $e.target.process.command_line = /.*System[EventID=21].*/ nocase or $e.target.process.command_line = /.*-InstanceId 22.*/ nocase or $e.target.process.command_line = /.*.eventid -eq 22.*/ nocase or $e.target.process.command_line = /.*.ID -eq 22.*/ nocase or $e.target.process.command_line = /.*EventCode=?22?.*/ nocase or $e.target.process.command_line = /.*EventIdentifier=?22?.*/ nocase or $e.target.process.command_line = /.*System[EventID=22].*/ nocase)) or (($e.target.process.command_line = /.*Microsoft-Windows-PowerShell.*/ nocase or $e.target.process.command_line = /.*Microsoft-Windows-Security-Auditing.*/ nocase or $e.target.process.command_line = /.*Microsoft-Windows-TerminalServices-LocalSessionManager.*/ nocase or $e.target.process.command_line = /.*Microsoft-Windows-TerminalServices-RemoteConnectionManager.*/ nocase or $e.target.process.command_line = /.*Microsoft-Windows-Windows Defender.*/ nocase or $e.target.process.command_line = /.*PowerShellCore.*/ nocase or $e.target.process.command_line = /.*Security.*/ nocase or $e.target.process.command_line = /.*Windows PowerShell.*/ nocase))) and ((($e.target.process.command_line = /.*Select.*/ nocase and $e.target.process.command_line = /.*Win32_NTLogEvent.*/ nocase)) or ((($e.target.process.command_line = /.* qe .*/ nocase or $e.target.process.command_line = /.* query-events .*/ nocase)) and (($e.target.process.file.full_path = /.*\\wevtutil.exe$/ nocase) or ($e.target.process.file.name = "wevtutil.exe"))) or (($e.target.process.command_line = /.* ntevent.*/ nocase) and (($e.target.process.file.full_path = /.*\\wmic.exe$/ nocase) or ($e.target.process.file.name = "wmic.exe"))) or (($e.target.process.command_line = /.*Get-WinEvent .*/ nocase or $e.target.process.command_line = /.*get-eventlog .*/ nocase))))

  condition:
    $e
}
