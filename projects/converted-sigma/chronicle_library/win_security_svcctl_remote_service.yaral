rule 586a8d6b_6bfe_4ad9_9d78_888cd2fe50c3 {
  meta:
    title = "Remote Service Activity via SVCCTL Named Pipe"
    description = "Detects remote service activity via remote access to the svcctl named pipe"
    author = "Samir Bousseaden"
    severity = "MEDIUM"

  events:
    ($e.EventID = 5145 and $e.ShareName = "\\\\\\\\\\*\\\\IPC$" and $e.RelativeTargetName = "svcctl" and $e.AccessList = /.*WriteData.*/ nocase)

  condition:
    $e
}
