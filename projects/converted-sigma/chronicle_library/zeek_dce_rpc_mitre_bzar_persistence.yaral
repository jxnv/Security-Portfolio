// Description: Windows DCE-RPC functions which indicate a persistence techniques on the remote system. All credit for the Zeek mapping of the suspicious endpoint/operation field goes to MITRE.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 53389db6_ba46_48e3_a94c_e0f2cefe1583 {
  meta:
    title = "MITRE BZAR Indicators for Persistence"
    description = "Windows DCE-RPC functions which indicate a persistence techniques on the remote system. All credit for the Zeek mapping of the suspicious endpoint/operation field goes to MITRE."
    author = "@neu5ron, SOC Prime"
    severity = "MEDIUM"

  events:
    (($e.endpoint = "spoolss" and $e.operation = "RpcAddMonitor") or ($e.endpoint = "spoolss" and $e.operation = "RpcAddPrintProcessor") or ($e.endpoint = "IRemoteWinspool" and $e.operation = "RpcAsyncAddMonitor") or ($e.endpoint = "IRemoteWinspool" and $e.operation = "RpcAsyncAddPrintProcessor") or ($e.endpoint = "ISecLogon" and $e.operation = "SeclCreateProcessWithLogonW") or ($e.endpoint = "ISecLogon" and $e.operation = "SeclCreateProcessWithLogonExW"))

  condition:
    $e
}
