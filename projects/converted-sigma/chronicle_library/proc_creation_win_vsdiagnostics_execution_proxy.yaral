// Title: Potential Binary Proxy Execution Via VSDiagnostics.EXE
// ID: ac1c92b4-ac81-405a-9978-4604d78cc47e
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-08-03
// Tags: attack.stealth, attack.t1218
// Description: Detects execution of "VSDiagnostics.exe" with the "start" command in order to launch and proxy arbitrary binaries.
// Converted by: Sigma Universal SIEM/EDR CLI

rule ac1c92b4_ac81_405a_9978_4604d78cc47e {
  meta:
    title = "Potential Binary Proxy Execution Via VSDiagnostics.EXE"
    description = "Detects execution of "VSDiagnostics.exe" with the "start" command in order to launch and proxy arbitrary binaries."
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "MEDIUM"

  events:
    ((($e.target.process.command_line = /.* /launch:.*/ nocase or $e.target.process.command_line = /.* -launch:.*/ nocase)) and ($e.target.process.command_line = /.*start.*/ nocase) and (($e.target.process.file.full_path = /.*\\VSDiagnostics.exe$/ nocase) or ($e.target.process.file.name = "VSDiagnostics.exe")))

  condition:
    $e
}
