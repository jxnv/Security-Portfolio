rule 07330162_dba1_4746_8121_a9647d49d297 {
  meta:
    title = "AWS Config Disabling Channel/Recorder"
    description = "Detects AWS Config Service disabling"
    author = "vitaliy0x1"
    severity = "HIGH"

  events:
    ($e.eventSource = "config.amazonaws.com" and ($e.eventName = "DeleteDeliveryChannel" or $e.eventName = "StopConfigurationRecorder"))

  condition:
    $e
}
