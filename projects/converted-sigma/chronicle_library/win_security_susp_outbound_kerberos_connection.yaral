// Title: Uncommon Outbound Kerberos Connection - Security
// ID: eca91c7c-9214-47b9-b4c5-cb1d7e4f2350
// Status: test
// Level: medium
// Author: Ilyas Ochkov, oscd.community
// Date: 2019-10-24
// Tags: attack.lateral-movement, attack.credential-access, attack.t1558.003
// Description: Detects uncommon outbound network activity via Kerberos default port indicating possible lateral movement or first stage PrivEsc via delegation.
// Converted by: Sigma Universal SIEM/EDR CLI

rule eca91c7c_9214_47b9_b4c5_cb1d7e4f2350 {
  meta:
    title = "Uncommon Outbound Kerberos Connection - Security"
    description = "Detects uncommon outbound network activity via Kerberos default port indicating possible lateral movement or first stage PrivEsc via delegation."
    author = "Ilyas Ochkov, oscd.community"
    severity = "MEDIUM"

  events:
    (($e.EventID = 5156 and $e.DestPort = 88) and not((($e.Application = /^\\device\\harddiskvolume.*/ nocase or $e.Application = /^C:.*/ nocase) and $e.Application = /.*\\Windows\\System32\\lsass.exe$/ nocase)) and not(((($e.Application = /^\\device\\harddiskvolume.*/ nocase or $e.Application = /^C:.*/ nocase) and ($e.Application = /.*\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe$/ nocase or $e.Application = /.*\\Program Files\\Google\\Chrome\\Application\\chrome.exe$/ nocase)) or (($e.Application = /^\\device\\harddiskvolume.*/ nocase or $e.Application = /^C:.*/ nocase) and ($e.Application = /.*\\Program Files (x86)\\Mozilla Firefox\\firefox.exe$/ nocase or $e.Application = /.*\\Program Files\\Mozilla Firefox\\firefox.exe$/ nocase)) or ($e.Application = /.*\\tomcat\\bin\\tomcat8.exe$/ nocase))))

  condition:
    $e
}
