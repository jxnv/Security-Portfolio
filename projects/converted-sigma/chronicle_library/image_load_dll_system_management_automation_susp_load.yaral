// Title: PowerShell Core DLL Loaded By Non PowerShell Process
// ID: 092bc4b9-3d1d-43b4-a6b4-8c8acd83522f
// Status: test
// Level: medium
// Author: Tom Kern, oscd.community, Natalia Shornikova, Tim Shelton, Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2019-11-14
// Tags: attack.t1059.001, attack.execution
// Description: Detects loading of essential DLLs used by PowerShell by non-PowerShell process.
// Detects behavior similar to meterpreter's "load powershell" extension.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 092bc4b9_3d1d_43b4_a6b4_8c8acd83522f {
  meta:
    title = "PowerShell Core DLL Loaded By Non PowerShell Process"
    description = "Detects loading of essential DLLs used by PowerShell by non-PowerShell process. Detects behavior similar to meterpreter's "load powershell" extension."
    author = "Tom Kern, oscd.community, Natalia Shornikova, Tim Shelton, Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)"
    severity = "MEDIUM"

  events:
    ((($e.Description = "System.Management.Automation") or ($e.target.process.file.name = "System.Management.Automation.dll") or (($e.ImageLoaded = /.*\\System.Management.Automation.dll$/ nocase or $e.ImageLoaded = /.*\\System.Management.Automation.ni.dll$/ nocase))) and not(((($e.target.process.file.full_path = /^C:\\Windows\\Microsoft.NET\\Framework\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\Microsoft.NET\\FrameworkArm\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\Microsoft.NET\\FrameworkArm64\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Windows\\Microsoft.NET\\Framework64\\.*/ nocase) and $e.target.process.file.full_path = /.*\\mscorsvw.exe$/ nocase) or (($e.target.process.file.full_path = "C:\\Windows\\System32\\dsac.exe" or $e.target.process.file.full_path = "C:\\WINDOWS\\System32\\RemoteFXvGPUDisablement.exe" or $e.target.process.file.full_path = "C:\\Windows\\System32\\runscripthelper.exe" or $e.target.process.file.full_path = "C:\\WINDOWS\\System32\\sdiagnhost.exe" or $e.target.process.file.full_path = "C:\\Windows\\System32\\ServerManager.exe" or $e.target.process.file.full_path = "C:\\Windows\\System32\\SyncAppvPublishingServer.exe" or $e.target.process.file.full_path = "C:\\Windows\\System32\\winrshost.exe" or $e.target.process.file.full_path = "C:\\Windows\\System32\\wsmprovhost.exe" or $e.target.process.file.full_path = "C:\\Windows\\SysWOW64\\winrshost.exe" or $e.target.process.file.full_path = "C:\\Windows\\SysWOW64\\wsmprovhost.exe")) or (($e.target.process.file.full_path = "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" or $e.target.process.file.full_path = "C:\\Program Files\\PowerShell\\7\\pwsh.exe" or $e.target.process.file.full_path = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or $e.target.process.file.full_path = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" or $e.target.process.file.full_path = "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or $e.target.process.file.full_path = "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")) or (($e.target.process.file.full_path = /.*C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview.*/ nocase or $e.target.process.file.full_path = /.*\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview.*/ nocase) and $e.target.process.file.full_path = /.*\\pwsh.exe$/ nocase))) and not(((not ($e.target.process.file.full_path = /.*/)) or ($e.target.process.file.full_path = /^C:\\ProgramData\\chocolatey\\choco.exe.*/ nocase) or ($e.target.process.file.full_path = /.*\\Citrix\\ConfigSync\\ConfigSyncRun.exe$/ nocase) or ($e.target.process.file.full_path = /^C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_.*/ nocase and $e.target.process.file.full_path = /.*\\GetHelp.exe$/ nocase) or ($e.target.process.file.full_path = /^C:\\Windows\\Temp\\asgard2-agent\\.*/ nocase and ($e.target.process.file.full_path = /.*\\thor64.exe$/ nocase or $e.target.process.file.full_path = /.*\\thor.exe$/ nocase)) or (($e.target.process.file.full_path = /^C:\\Program Files (x86)\\Microsoft SQL Server Management Studio.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\Microsoft SQL Server Management Studio.*/ nocase) and $e.target.process.file.full_path = /.*\\IDE\\Ssms.exe$/ nocase) or (($e.target.process.file.full_path = /^C:\\Program Files (x86)\\Microsoft SQL Server\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\Microsoft SQL Server\\.*/ nocase) and $e.target.process.file.full_path = /.*\\Tools\\Binn\\SQLPS.exe$/ nocase) or (($e.target.process.file.full_path = /^C:\\Program Files (x86)\\Microsoft Visual Studio\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\Microsoft Visual Studio\\.*/ nocase)))))

  condition:
    $e
}
