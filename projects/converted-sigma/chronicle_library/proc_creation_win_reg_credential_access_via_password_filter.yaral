// Title: Dropping Of Password Filter DLL
// ID: b7966f4a-b333-455b-8370-8ca53c229762
// Status: test
// Level: medium
// Author: Sreeman
// Date: 2020-10-29
// Tags: attack.persistence, attack.credential-access, attack.defense-impairment, attack.t1556.002
// Description: Detects dropping of dll files in system32 that may be used to retrieve user credentials from LSASS
// Converted by: Sigma Universal SIEM/EDR CLI

rule b7966f4a_b333_455b_8370_8ca53c229762 {
  meta:
    title = "Dropping Of Password Filter DLL"
    description = "Detects dropping of dll files in system32 that may be used to retrieve user credentials from LSASS"
    author = "Sreeman"
    severity = "MEDIUM"

  events:
    (($e.target.process.command_line = /.*HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa.*/ nocase and $e.target.process.command_line = /.*scecli\\0*.*/ nocase and $e.target.process.command_line = /.*reg add.*/ nocase))

  condition:
    $e
}
