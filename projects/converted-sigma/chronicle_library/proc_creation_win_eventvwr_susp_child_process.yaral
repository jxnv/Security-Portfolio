// Title: Potentially Suspicious Event Viewer Child Process
// ID: be344333-921d-4c4d-8bb8-e584cf584780
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2017-03-19
// Tags: attack.privilege-escalation, attack.t1548.002, car.2019-04-001
// Description: Detects uncommon or suspicious child processes of "eventvwr.exe" which might indicate a UAC bypass attempt
// Converted by: Sigma Universal SIEM/EDR CLI

rule be344333_921d_4c4d_8bb8_e584cf584780 {
  meta:
    title = "Potentially Suspicious Event Viewer Child Process"
    description = "Detects uncommon or suspicious child processes of "eventvwr.exe" which might indicate a UAC bypass attempt"
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.principal.process.file.full_path = /.*\\eventvwr.exe$/ nocase) and not((($e.target.process.file.full_path = /.*:\\Windows\\System32\\mmc.exe$/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\System32\\WerFault.exe$/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\SysWOW64\\WerFault.exe$/ nocase))))

  condition:
    $e
}
