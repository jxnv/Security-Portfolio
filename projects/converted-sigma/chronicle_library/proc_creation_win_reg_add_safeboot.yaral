// Title: Add SafeBoot Keys Via Reg Utility
// ID: d7662ff6-9e97-4596-a61d-9839e32dee8d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-02
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects execution of "reg.exe" commands with the "add" or "copy" flags on safe boot registry keys. Often used by attacker to allow the ransomware to work in safe mode as some security products do not
// Converted by: Sigma Universal SIEM/EDR CLI

rule d7662ff6_9e97_4596_a61d_9839e32dee8d {
  meta:
    title = "Add SafeBoot Keys Via Reg Utility"
    description = "Detects execution of "reg.exe" commands with the "add" or "copy" flags on safe boot registry keys. Often used by attacker to allow the ransomware to work in safe mode as some security products do not"
    author = "Nasreddine Bencherchali (Nextron Systems)"
    severity = "HIGH"

  events:
    ((($e.target.process.command_line = /.* copy .*/ nocase or $e.target.process.command_line = /.* add .*/ nocase)) and (($e.target.process.file.full_path = /.*\\reg.exe$/ nocase) or ($e.target.process.file.name = "reg.exe")) and ($e.target.process.command_line = /.*\\SYSTEM\\CurrentControlSet\\Control\\SafeBoot.*/ nocase))

  condition:
    $e
}
