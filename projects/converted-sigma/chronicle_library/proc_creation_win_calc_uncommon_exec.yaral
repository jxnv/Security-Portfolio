// Title: Suspicious Calculator Usage
// ID: 737e618a-a410-49b5-bec3-9e55ff7fbc15
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2019-02-09
// Tags: attack.stealth, attack.t1036
// Description: Detects suspicious use of 'calc.exe' with command line parameters or in a suspicious directory, which is likely caused by some PoC or detection evasion.
// Converted by: Sigma Universal SIEM/EDR CLI

rule 737e618a_a410_49b5_bec3_9e55ff7fbc15 {
  meta:
    title = "Suspicious Calculator Usage"
    description = "Detects suspicious use of 'calc.exe' with command line parameters or in a suspicious directory, which is likely caused by some PoC or detection evasion."
    author = "Florian Roth (Nextron Systems)"
    severity = "HIGH"

  events:
    (($e.target.process.command_line = /.*\\calc.exe .*/ nocase) or (($e.target.process.file.full_path = /.*\\calc.exe$/ nocase) and not((($e.target.process.file.full_path = /.*:\\Windows\\System32\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\SysWOW64\\.*/ nocase or $e.target.process.file.full_path = /.*:\\Windows\\WinSxS\\.*/ nocase)))))

  condition:
    $e
}
