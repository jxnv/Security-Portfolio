rule cc268ac1_42d9_40fd_9ed3_8c4e1a5b87e6 {
  meta:
    title = "Devtoolslauncher.exe Executes Specified Binary"
    description = "The Devtoolslauncher.exe executes other binary"
    author = "Beyu Denis, oscd.community (rule), @_felamos (idea)"
    severity = "HIGH"

  events:
    ($e.target.process.file.full_path = /.*\\devtoolslauncher.exe$/ nocase and $e.target.process.command_line = /.*LaunchForDeploy.*/ nocase)

  condition:
    $e
}
