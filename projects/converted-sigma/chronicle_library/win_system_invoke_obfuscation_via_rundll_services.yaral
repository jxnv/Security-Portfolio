rule 11b52f18_aaec_4d60_9143_5dd8cc4706b9 {
  meta:
    title = "Invoke-Obfuscation RUNDLL LAUNCHER - System"
    description = "Detects Obfuscated Powershell via RUNDLL LAUNCHER"
    author = "Timur Zinniatullin, oscd.community"
    severity = "MEDIUM"

  events:
    ($e.Provider_Name = "Service Control Manager" and $e.EventID = 7045 and ($e.ImagePath = /.*rundll32.exe.*/ nocase and $e.ImagePath = /.*shell32.dll.*/ nocase and $e.ImagePath = /.*shellexec_rundll.*/ nocase and $e.ImagePath = /.*powershell.*/ nocase))

  condition:
    $e
}
