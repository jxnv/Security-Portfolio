// Title: Potential Process Injection Via Msra.EXE
// ID: 744a188b-0415-4792-896f-11ddb0588dbc
// Status: test
// Level: high
// Author: Alexander McDonald
// Date: 2022-06-24
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects potential process injection via Microsoft Remote Asssistance (Msra.exe) by looking at suspicious child processes spawned from the aforementioned process. It has been a target used by many threat actors and used for discovery and persistence tactics
// Converted by: Sigma Universal SIEM/EDR CLI

rule 744a188b_0415_4792_896f_11ddb0588dbc {
  meta:
    title = "Potential Process Injection Via Msra.EXE"
    description = "Detects potential process injection via Microsoft Remote Asssistance (Msra.exe) by looking at suspicious child processes spawned from the aforementioned process. It has been a target used by many threat actors and used for discovery and persistence tactics"
    author = "Alexander McDonald"
    severity = "HIGH"

  events:
    ($e.principal.process.file.full_path = /.*\\msra.exe$/ nocase and $e.principal.process.command_line = /.*msra.exe$/ nocase and ($e.target.process.file.full_path = /.*\\arp.exe$/ nocase or $e.target.process.file.full_path = /.*\\cmd.exe$/ nocase or $e.target.process.file.full_path = /.*\\net.exe$/ nocase or $e.target.process.file.full_path = /.*\\netstat.exe$/ nocase or $e.target.process.file.full_path = /.*\\nslookup.exe$/ nocase or $e.target.process.file.full_path = /.*\\route.exe$/ nocase or $e.target.process.file.full_path = /.*\\schtasks.exe$/ nocase or $e.target.process.file.full_path = /.*\\whoami.exe$/ nocase))

  condition:
    $e
}
