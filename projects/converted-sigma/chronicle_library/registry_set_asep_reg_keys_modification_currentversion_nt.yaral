rule cbf93e5d_ca6c_4722_8bea_e9119007c248 {
  meta:
    title = "CurrentVersion NT Autorun Keys Modification"
    description = "Detects modification of autostart extensibility point (ASEP) in registry."
    author = "Victor Sergeev, Daniil Yugoslavskiy, Gleb Sukhodolskiy, Timur Zinniatullin, oscd.community, Tim Shelton, frack113 (split)"
    severity = "MEDIUM"

  events:
    (((($e.TargetObject = /.*\\Winlogon\\VmApplet.*/ nocase or $e.TargetObject = /.*\\Winlogon\\Userinit.*/ nocase or $e.TargetObject = /.*\\Winlogon\\Taskman.*/ nocase or $e.TargetObject = /.*\\Winlogon\\Shell.*/ nocase or $e.TargetObject = /.*\\Winlogon\\GpExtensions.*/ nocase or $e.TargetObject = /.*\\Winlogon\\AppSetup.*/ nocase or $e.TargetObject = /.*\\Winlogon\\AlternateShells\\AvailableShells.*/ nocase or $e.TargetObject = /.*\\Windows\\IconServiceLib.*/ nocase or $e.TargetObject = /.*\\Windows\\Appinit_Dlls.*/ nocase or $e.TargetObject = /.*\\Image File Execution Options.*/ nocase or $e.TargetObject = /.*\\Font Drivers.*/ nocase or $e.TargetObject = /.*\\Drivers32.*/ nocase or $e.TargetObject = /.*\\Windows\\Run.*/ nocase or $e.TargetObject = /.*\\Windows\\Load.*/ nocase)) and ($e.TargetObject = /.*\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion.*/ nocase)) and not((($e.Details = "(Empty)") or ($e.TargetObject = /.*\\Image File Execution Options\\.*/ nocase and ($e.TargetObject = /.*\\DisableExceptionChainValidation$/ nocase or $e.TargetObject = /.*\\MitigationOptions$/ nocase)) or (not ($e.Details = /.*/)) or ($e.target.process.file.full_path = "C:\\Windows\\System32\\poqexec.exe") or ($e.target.process.file.full_path = "C:\\Windows\\System32\\RuntimeBroker.exe" and $e.TargetObject = /.*\\runtimebroker.exe\\Microsoft.Windows.ShellExperienceHost.*/ nocase) or ($e.target.process.file.full_path = "C:\\Windows\\system32\\svchost.exe" and ($e.TargetObject = /.*\\Winlogon\\GPExtensions\\{827D319E-6EAC-11D2-A4EA-00C04F79F83A}\\PreviousPolicyAreas.*/ nocase or $e.TargetObject = /.*\\Winlogon\\GPExtensions\\{827D319E-6EAC-11D2-A4EA-00C04F79F83A}\\MaxNoGPOListChangesInterval.*/ nocase) and ($e.Details = "DWORD (0x00000001)" or $e.Details = "DWORD (0x00000009)" or $e.Details = "DWORD (0x000003c0)")))) and not(((($e.target.process.file.full_path = /^C:\\Program Files (x86)\\Avira\\Antivirus\\avguard.exe.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\Avira\\Antivirus\\avguard.exe.*/ nocase) and $e.TargetObject = /.*SOFTWARE\\WOW6432Node\\Avira\\Antivirus\\Overwrite_Keys\\HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon\\.*/ nocase and ($e.TargetObject = /.*\\userinit\\UseAsDefault$/ nocase or $e.TargetObject = /.*\\shell\\UseAsDefault$/ nocase) and ($e.Details = "explorer.exe" or $e.Details = "C:\\Windows\\system32\\userinit.exe,")) or ($e.target.process.file.full_path = /^C:\\Program Files (x86)\\Microsoft\\Temp\\.*/ nocase and $e.target.process.file.full_path = /.*\\MicrosoftEdgeUpdate.exe$/ nocase) or ((($e.TargetObject = /.*\\ClickToRunStore\\HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\.*/ nocase or $e.TargetObject = /.*\\ClickToRun\\REGISTRY\\MACHINE\\Software\\Microsoft\\Windows NT\\CurrentVersion\\.*/ nocase)) or (($e.target.process.file.full_path = "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe" or $e.target.process.file.full_path = "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe"))) or ($e.target.process.file.full_path = /^C:\\Windows\\Microsoft.NET\\Framework.*/ nocase and $e.target.process.file.full_path = /.*\\ngen.exe$/ nocase) or (($e.target.process.file.full_path = /^C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\.*/ nocase) and $e.target.process.file.full_path = /.*\\OfficeClickToRun.exe$/ nocase) or ($e.target.process.file.full_path = /.*\\AppData\\Local\\Microsoft\\OneDrive\\StandaloneUpdater\\OneDriveSetup.exe$/ nocase and $e.TargetObject = /.*\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\Delete Cached Update Binary$/ nocase and $e.Details = /^C:\\Windows\\system32\\cmd.exe /q /c del /q \"C:\\Users\\.*/ nocase and $e.Details = /.*\\AppData\\Local\\Microsoft\\OneDrive\\Update\\OneDriveSetup.exe\"$/ nocase))))

  condition:
    $e
}
