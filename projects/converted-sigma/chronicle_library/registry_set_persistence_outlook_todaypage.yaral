// Title: Potential Persistence Via Outlook Today Page
// ID: 487bb375-12ef-41f6-baae-c6a1572b4dd1
// Status: test
// Level: high
// Author: Tobias Michalski (Nextron Systems), David Bertho (@dbertho) & Eirik Sveen (@0xSV1), Storebrand
// Date: 2021-06-10
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects potential persistence activity via outlook today page.
// An attacker can set a custom page to execute arbitrary code and link to it via the registry values "URL" and "UserDefinedUrl".
// Converted by: Sigma Universal SIEM/EDR CLI

rule 487bb375_12ef_41f6_baae_c6a1572b4dd1 {
  meta:
    title = "Potential Persistence Via Outlook Today Page"
    description = "Detects potential persistence activity via outlook today page. An attacker can set a custom page to execute arbitrary code and link to it via the registry values "URL" and "UserDefinedUrl"."
    author = "Tobias Michalski (Nextron Systems), David Bertho (@dbertho) & Eirik Sveen (@0xSV1), Storebrand"
    severity = "HIGH"

  events:
    ((($e.TargetObject = /.*Software\\Microsoft\\Office\\.*/ nocase and $e.TargetObject = /.*\\Outlook\\Today\\.*/ nocase)) and (($e.TargetObject = /.*\\Stamp$/ nocase and $e.Details = "DWORD (0x00000001)") or (($e.TargetObject = /.*\\URL$/ nocase or $e.TargetObject = /.*\\UserDefinedUrl$/ nocase))) and not((($e.target.process.file.full_path = /^C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\.*/ nocase or $e.target.process.file.full_path = /^C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\.*/ nocase) and $e.target.process.file.full_path = /.*\\OfficeClickToRun.exe$/ nocase)))

  condition:
    $e
}
