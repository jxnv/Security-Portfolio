// Title: Suspicious Mshta.EXE Execution Patterns
// ID: e32f92d1-523e-49c3-9374-bdb13b46a3ba
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-07-17
// Tags: attack.execution, attack.t1106
// Description: Detects suspicious mshta process execution patterns
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((Image="*\\mshta.exe") OR (OriginalFileName == "MSHTA.EXE")) AND ((ParentImage="*\\cmd.exe" OR ParentImage="*\\cscript.exe" OR ParentImage="*\\powershell.exe" OR ParentImage="*\\pwsh.exe" OR ParentImage="*\\regsvr32.exe" OR ParentImage="*\\rundll32.exe" OR ParentImage="*\\wscript.exe") AND (contains(CommandLine, "\\AppData\\Local\\") OR contains(CommandLine, "C:\\ProgramData\\") OR contains(CommandLine, "C:\\Users\\Public\\") OR contains(CommandLine, "C:\\Windows\\Temp\\")))) OR (((Image="*\\mshta.exe") OR (OriginalFileName == "MSHTA.EXE")) AND NOT ((((Image="C:\\Windows\\System32\\*" OR Image="C:\\Windows\\SysWOW64\\*")) OR ((contains(CommandLine, ".htm") OR contains(CommandLine, ".hta"))) OR ((CommandLine="*mshta.exe" OR CommandLine="*mshta"))))))
