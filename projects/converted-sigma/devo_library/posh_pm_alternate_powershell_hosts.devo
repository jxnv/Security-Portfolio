// Title: Alternate PowerShell Hosts - PowerShell Module
// ID: 64e8e417-c19a-475a-8d19-98ea705394cc
// Status: test
// Level: medium
// Author: Roberto Rodriguez @Cyb3rWard0g
// Date: 2019-08-11
// Tags: attack.execution, attack.t1059.001
// Description: Detects alternate PowerShell hosts potentially bypassing detections looking for powershell.exe
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(ContextInfo, "*")) AND NOT (((contains(ContextInfo, "C:\\Windows\\system32\\dsac.exe")) OR (contains(ContextInfo, "ConfigSyncRun.exe")) OR ((contains(Payload, "Update-Help") OR contains(Payload, "Failed to update Help for the module"))) OR ((contains(ContextInfo, "= powershell") OR contains(ContextInfo, "= C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell") OR contains(ContextInfo, "= C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell") OR contains(ContextInfo, "= C:/Windows/System32/WindowsPowerShell/v1.0/powershell") OR contains(ContextInfo, "= C:/Windows/SysWOW64/WindowsPowerShell/v1.0/powershell") OR contains(ContextInfo, "= \\\\\\?\\?\\C:Windows\\System32\\WindowsPowerShell\\v1.0\\powershell") OR contains(ContextInfo, "= \\\\\\?\\?\\C:Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell"))) OR (contains(ContextInfo, "= C:\\WINDOWS\\System32\\sdiagnhost.exe -Embedding")) OR (contains(ContextInfo, "C:\\Windows\\system32\\wsmprovhost.exe -Embedding")))))
