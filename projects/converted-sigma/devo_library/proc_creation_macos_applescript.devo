// Title: MacOS Scripting Interpreter AppleScript
// ID: 1bc2e6c5-0885-472b-bed6-be5ea8eace55
// Status: test
// Level: medium
// Author: Alejandro Ortuno, oscd.community
// Date: 2020-10-21
// Tags: attack.execution, attack.t1059.002
// Description: Detects execution of AppleScript of the macOS scripting language AppleScript.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((Image="*/osascript" AND (contains(CommandLine, " -e ") OR contains(CommandLine, ".scpt") OR contains(CommandLine, ".js"))) AND NOT ((ParentImage="*opencode" AND (contains(CommandLine, "osascript") AND contains(CommandLine, " -e ") AND contains(CommandLine, "set imageData to the clipboard") AND contains(CommandLine, "set fileRef")))))
