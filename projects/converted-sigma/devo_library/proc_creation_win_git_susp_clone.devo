// Title: Suspicious Git Clone
// ID: aef9d1f1-7396-4e92-a927-4567c7a495c1
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-03
// Tags: attack.reconnaissance, attack.t1593.003
// Description: Detects execution of "git" in order to clone a remote repository that contain suspicious keywords which might be suspicious
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, " clone ") OR contains(CommandLine, "git-remote-https "))) AND (((Image="*\\git.exe" OR Image="*\\git-remote-https.exe")) OR (OriginalFileName == "git.exe")) AND ((contains(CommandLine, "exploit") OR contains(CommandLine, "Vulns") OR contains(CommandLine, "vulnerability") OR contains(CommandLine, "RemoteCodeExecution") OR contains(CommandLine, "Invoke-") OR contains(CommandLine, "CVE-") OR contains(CommandLine, "poc-") OR contains(CommandLine, "ProofOfConcept") OR contains(CommandLine, "proxyshell") OR contains(CommandLine, "log4shell") OR contains(CommandLine, "eternalblue") OR contains(CommandLine, "eternal-blue") OR contains(CommandLine, "MS17-"))))
