// Title: Potential Webshell Creation On Static Website
// ID: 39f1f9f2-9636-45de-98f6-a4046aa8e4b9
// Status: test
// Level: medium
// Author: Beyu Denis, oscd.community, Tim Shelton, Thurein Oo
// Date: 2019-10-22
// Tags: attack.persistence, attack.t1505.003
// Description: Detects the creation of files with certain extensions on a static web site. This can be indicative of potential uploads of a web shell.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((((contains(TargetFilename, ".ashx") OR contains(TargetFilename, ".asp") OR contains(TargetFilename, ".ph") OR contains(TargetFilename, ".soap"))) AND (contains(TargetFilename, "\\inetpub\\wwwroot\\"))) OR ((contains(TargetFilename, ".ph")) AND ((contains(TargetFilename, "\\www\\") OR contains(TargetFilename, "\\htdocs\\") OR contains(TargetFilename, "\\html\\"))))) AND NOT (((contains(TargetFilename, "\\xampp")) OR (Image == "System") OR ((contains(TargetFilename, "\\AppData\\Local\\Temp\\") OR contains(TargetFilename, "\\Windows\\Temp\\"))))))
