// Title: BITS Transfer Job Download From Direct IP
// ID: 90f138c1-f578-4ac3-8c49-eecfd847c8b7
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-11
// Tags: attack.persistence, attack.execution, attack.stealth, attack.t1197
// Description: Detects a BITS transfer job downloading file(s) from a direct IP address.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((EventID == "16403" AND (contains(RemoteName, "http://1") OR contains(RemoteName, "http://2") OR contains(RemoteName, "http://3") OR contains(RemoteName, "http://4") OR contains(RemoteName, "http://5") OR contains(RemoteName, "http://6") OR contains(RemoteName, "http://7") OR contains(RemoteName, "http://8") OR contains(RemoteName, "http://9") OR contains(RemoteName, "https://1") OR contains(RemoteName, "https://2") OR contains(RemoteName, "https://3") OR contains(RemoteName, "https://4") OR contains(RemoteName, "https://5") OR contains(RemoteName, "https://6") OR contains(RemoteName, "https://7") OR contains(RemoteName, "https://8") OR contains(RemoteName, "https://9"))) AND NOT ((((contains(RemoteName, "://10.") OR contains(RemoteName, "://192.168.") OR contains(RemoteName, "://172.16.") OR contains(RemoteName, "://172.17.") OR contains(RemoteName, "://172.18.") OR contains(RemoteName, "://172.19.") OR contains(RemoteName, "://172.20.") OR contains(RemoteName, "://172.21.") OR contains(RemoteName, "://172.22.") OR contains(RemoteName, "://172.23.") OR contains(RemoteName, "://172.24.") OR contains(RemoteName, "://172.25.") OR contains(RemoteName, "://172.26.") OR contains(RemoteName, "://172.27.") OR contains(RemoteName, "://172.28.") OR contains(RemoteName, "://172.29.") OR contains(RemoteName, "://172.30.") OR contains(RemoteName, "://172.31.") OR contains(RemoteName, "://127.") OR contains(RemoteName, "://169.254."))) OR ((contains(RemoteName, "https://7-") OR contains(RemoteName, "http://7-"))))))
