// Title: Suspicious Msiexec Quiet Install From Remote Location
// ID: 8150732a-0c9d-4a99-82b9-9efb9b90c40c
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-28
// Tags: attack.stealth, attack.t1218.007
// Description: Detects usage of Msiexec.exe to install packages hosted remotely quietly
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((contains(CommandLine, "-i") OR contains(CommandLine, "/i") OR contains(CommandLine, "-package") OR contains(CommandLine, "/package") OR contains(CommandLine, "-a") OR contains(CommandLine, "/a") OR contains(CommandLine, "-j") OR contains(CommandLine, "/j"))) AND ((Image="*\\msiexec.exe") OR (OriginalFileName == "msiexec.exe")) AND ((contains(CommandLine, "-q") OR contains(CommandLine, "/q"))) AND ((contains(CommandLine, "http") OR contains(CommandLine, "\\\\\\\\")))) AND NOT (((contains(CommandLine, "\\AppData\\Local\\Temp\\OpenOffice") AND contains(CommandLine, "Installation Files\\openoffice")))))
