// Title: Suspicious Autorun Registry Modified via WMI
// ID: c80e66d8-1780-48a9-b412-46663fd21ac0
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-02-17
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1547.001, attack.t1047
// Description: Detects suspicious activity where the WMIC process is used to create an autorun registry entry via reg.exe, which is often indicative of persistence mechanisms employed by malware.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((contains(CommandLine, "reg") AND contains(CommandLine, " add ")) AND (contains(CommandLine, "\\Software\\Microsoft\\Windows\\CurrentVersion\\Run") OR contains(CommandLine, "\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run") OR contains(CommandLine, "\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\Run"))) AND ((Image="*\\wmic.exe") OR (OriginalFileName == "wmic.exe") OR (ParentImage="*\\wmiprvse.exe"))) AND (((contains(CommandLine, ":\\Perflogs") OR contains(CommandLine, ":\\ProgramData'") OR contains(CommandLine, ":\\Windows\\Temp") OR contains(CommandLine, ":\\Temp") OR contains(CommandLine, "\\AppData\\Local\\Temp") OR contains(CommandLine, "\\AppData\\Roaming") OR contains(CommandLine, ":\\$Recycle.bin") OR contains(CommandLine, ":\\Users\\Default") OR contains(CommandLine, ":\\Users\\public") OR contains(CommandLine, "%temp%") OR contains(CommandLine, "%tmp%") OR contains(CommandLine, "%Public%") OR contains(CommandLine, "%AppData%"))) OR ((contains(CommandLine, ":\\Users\\")) AND ((contains(CommandLine, "\\Favorites") OR contains(CommandLine, "\\Favourites") OR contains(CommandLine, "\\Contacts") OR contains(CommandLine, "\\Music") OR contains(CommandLine, "\\Pictures") OR contains(CommandLine, "\\Documents") OR contains(CommandLine, "\\Photos"))))))
