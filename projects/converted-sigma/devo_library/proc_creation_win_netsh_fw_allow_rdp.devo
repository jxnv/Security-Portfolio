// Title: RDP Connection Allowed Via Netsh.EXE
// ID: 01aeb693-138d-49d2-9403-c4f52d7d3d62
// Status: test
// Level: high
// Author: Sander Wiebing
// Date: 2020-05-23
// Tags: attack.defense-impairment, attack.t1686.003
// Description: Detects usage of the netsh command to open and allow connections to port 3389 (RDP). As seen used by Sarwent Malware
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "firewall ") AND contains(CommandLine, "add ") AND contains(CommandLine, "tcp ") AND contains(CommandLine, "3389")) AND (contains(CommandLine, "portopening") OR contains(CommandLine, "allow"))) AND ((Image="*\\netsh.exe") OR (OriginalFileName == "netsh.exe")))
