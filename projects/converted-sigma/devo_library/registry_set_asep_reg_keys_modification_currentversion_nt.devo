// Title: CurrentVersion NT Autorun Keys Modification
// ID: cbf93e5d-ca6c-4722-8bea-e9119007c248
// Status: test
// Level: medium
// Author: Victor Sergeev, Daniil Yugoslavskiy, Gleb Sukhodolskiy, Timur Zinniatullin, oscd.community, Tim Shelton, frack113 (split)
// Date: 2019-10-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects modification of autostart extensibility point (ASEP) in registry.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((contains(TargetObject, "\\Winlogon\\VmApplet") OR contains(TargetObject, "\\Winlogon\\Userinit") OR contains(TargetObject, "\\Winlogon\\Taskman") OR contains(TargetObject, "\\Winlogon\\Shell") OR contains(TargetObject, "\\Winlogon\\GpExtensions") OR contains(TargetObject, "\\Winlogon\\AppSetup") OR contains(TargetObject, "\\Winlogon\\AlternateShells\\AvailableShells") OR contains(TargetObject, "\\Windows\\IconServiceLib") OR contains(TargetObject, "\\Windows\\Appinit_Dlls") OR contains(TargetObject, "\\Image File Execution Options") OR contains(TargetObject, "\\Font Drivers") OR contains(TargetObject, "\\Drivers32") OR contains(TargetObject, "\\Windows\\Run") OR contains(TargetObject, "\\Windows\\Load"))) AND (contains(TargetObject, "\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion"))) AND NOT (((Details == "(Empty)") OR (contains(TargetObject, "\\Image File Execution Options\\") AND (TargetObject="*\\DisableExceptionChainValidation" OR TargetObject="*\\MitigationOptions")) OR (NOT Details=*) OR (Image == "C:\\Windows\\System32\\poqexec.exe") OR (Image == "C:\\Windows\\System32\\RuntimeBroker.exe" AND contains(TargetObject, "\\runtimebroker.exe\\Microsoft.Windows.ShellExperienceHost")) OR (Image == "C:\\Windows\\system32\\svchost.exe" AND (contains(TargetObject, "\\Winlogon\\GPExtensions\\{827D319E-6EAC-11D2-A4EA-00C04F79F83A}\\PreviousPolicyAreas") OR contains(TargetObject, "\\Winlogon\\GPExtensions\\{827D319E-6EAC-11D2-A4EA-00C04F79F83A}\\MaxNoGPOListChangesInterval")) AND (Details == "DWORD (0x00000001)" OR Details == "DWORD (0x00000009)" OR Details == "DWORD (0x000003c0)")))) AND NOT ((((Image="C:\\Program Files (x86)\\Avira\\Antivirus\\avguard.exe*" OR Image="C:\\Program Files\\Avira\\Antivirus\\avguard.exe*") AND contains(TargetObject, "SOFTWARE\\WOW6432Node\\Avira\\Antivirus\\Overwrite_Keys\\HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon\\") AND (TargetObject="*\\userinit\\UseAsDefault" OR TargetObject="*\\shell\\UseAsDefault") AND (Details == "explorer.exe" OR Details == "C:\\Windows\\system32\\userinit.exe,")) OR (Image="C:\\Program Files (x86)\\Microsoft\\Temp\\*" AND Image="*\\MicrosoftEdgeUpdate.exe") OR (((contains(TargetObject, "\\ClickToRunStore\\HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\") OR contains(TargetObject, "\\ClickToRun\\REGISTRY\\MACHINE\\Software\\Microsoft\\Windows NT\\CurrentVersion\\"))) OR ((Image == "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe" OR Image == "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe"))) OR (Image="C:\\Windows\\Microsoft.NET\\Framework*" AND Image="*\\ngen.exe") OR ((Image="C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\*" OR Image="C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\*") AND Image="*\\OfficeClickToRun.exe") OR (Image="*\\AppData\\Local\\Microsoft\\OneDrive\\StandaloneUpdater\\OneDriveSetup.exe" AND TargetObject="*\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\Delete Cached Update Binary" AND Details="C:\\Windows\\system32\\cmd.exe /q /c del /q \"C:\\Users\\*" AND Details="*\\AppData\\Local\\Microsoft\\OneDrive\\Update\\OneDriveSetup.exe\""))))
