// Title: Suspicious File Download From File Sharing Websites -  File Stream
// ID: 52182dfb-afb7-41db-b4bc-5336cb29b464
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-08-24
// Tags: attack.stealth, attack.s0139, attack.t1564.004
// Description: Detects the download of suspicious file type from a well-known file and paste sharing domain
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(Contents, ".githubusercontent.com") OR contains(Contents, "0x0.st") OR contains(Contents, "anonfiles.com") OR contains(Contents, "bashupload.com") OR contains(Contents, "cdn.discordapp.com") OR contains(Contents, "chunk.io") OR contains(Contents, "ddns.net") OR contains(Contents, "dl.dropboxusercontent.com") OR contains(Contents, "ghostbin.co") OR contains(Contents, "github.com") OR contains(Contents, "glitch.me") OR contains(Contents, "gofile.io") OR contains(Contents, "hastebin.com") OR contains(Contents, "mediafire.com") OR contains(Contents, "mega.nz") OR contains(Contents, "onrender.com") OR contains(Contents, "pages.dev") OR contains(Contents, "paste.ee") OR contains(Contents, "pastebin.com") OR contains(Contents, "pastebin.pl") OR contains(Contents, "pastetext.net") OR contains(Contents, "pixeldrain.com") OR contains(Contents, "privatlab.com") OR contains(Contents, "privatlab.net") OR contains(Contents, "send.exploit.in") OR contains(Contents, "sendspace.com") OR contains(Contents, "storage.googleapis.com") OR contains(Contents, "storjshare.io") OR contains(Contents, "supabase.co") OR contains(Contents, "temp.sh") OR contains(Contents, "transfer.sh") OR contains(Contents, "trycloudflare.com") OR contains(Contents, "ufile.io") OR contains(Contents, "w3spaces.com") OR contains(Contents, "workers.dev") OR contains(Contents, "x0.at"))) AND ((contains(TargetFilename, ".cpl:Zone") OR contains(TargetFilename, ".dll:Zone") OR contains(TargetFilename, ".exe:Zone") OR contains(TargetFilename, ".hta:Zone") OR contains(TargetFilename, ".lnk:Zone") OR contains(TargetFilename, ".one:Zone") OR contains(TargetFilename, ".vbe:Zone") OR contains(TargetFilename, ".vbs:Zone") OR contains(TargetFilename, ".xll:Zone"))))
