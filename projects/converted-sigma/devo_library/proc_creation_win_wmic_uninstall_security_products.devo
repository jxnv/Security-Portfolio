// Title: Potential Tampering With Security Products Via WMIC
// ID: 847d5ff3-8a31-4737-a970-aeae8fe21765
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-01-30
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects uninstallation or termination of security products using the WMIC utility
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((contains(CommandLine, "wmic") AND contains(CommandLine, "product ") AND contains(CommandLine, "uninstall")) AND (contains(CommandLine, "/nointeractive") OR contains(CommandLine, "-nointeractive"))) OR ((contains(CommandLine, "wmic") AND contains(CommandLine, "caption like ")) AND (contains(CommandLine, "call delete") OR contains(CommandLine, "call terminate"))) OR ((contains(CommandLine, "process ") AND contains(CommandLine, "where ") AND contains(CommandLine, "delete")))) AND ((contains(CommandLine, "%carbon%") OR contains(CommandLine, "%cylance%") OR contains(CommandLine, "%endpoint%") OR contains(CommandLine, "%eset%") OR contains(CommandLine, "%malware%") OR contains(CommandLine, "%Sophos%") OR contains(CommandLine, "%symantec%") OR contains(CommandLine, "Antivirus") OR contains(CommandLine, "AVG ") OR contains(CommandLine, "Carbon Black") OR contains(CommandLine, "CarbonBlack") OR contains(CommandLine, "Cb Defense Sensor 64-bit") OR contains(CommandLine, "Crowdstrike Sensor") OR contains(CommandLine, "Cylance ") OR contains(CommandLine, "Dell Threat Defense") OR contains(CommandLine, "DLP Endpoint") OR contains(CommandLine, "Endpoint Detection") OR contains(CommandLine, "Endpoint Protection") OR contains(CommandLine, "Endpoint Security") OR contains(CommandLine, "Endpoint Sensor") OR contains(CommandLine, "ESET File Security") OR contains(CommandLine, "LogRhythm System Monitor Service") OR contains(CommandLine, "Malwarebytes") OR contains(CommandLine, "McAfee Agent") OR contains(CommandLine, "Microsoft Security Client") OR contains(CommandLine, "Sophos Anti-Virus") OR contains(CommandLine, "Sophos AutoUpdate") OR contains(CommandLine, "Sophos Credential Store") OR contains(CommandLine, "Sophos Management Console") OR contains(CommandLine, "Sophos Management Database") OR contains(CommandLine, "Sophos Management Server") OR contains(CommandLine, "Sophos Remote Management System") OR contains(CommandLine, "Sophos Update Manager") OR contains(CommandLine, "Threat Protection") OR contains(CommandLine, "VirusScan") OR contains(CommandLine, "Webroot SecureAnywhere") OR contains(CommandLine, "Windows Defender"))))
