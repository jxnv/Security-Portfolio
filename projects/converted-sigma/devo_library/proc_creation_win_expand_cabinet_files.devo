// Title: Potentially Suspicious Cabinet File Expansion
// ID: 9f107a84-532c-41af-b005-8d12a607639f
// Status: test
// Level: medium
// Author: Bhabesh Raj, X__Junior (Nextron Systems)
// Date: 2021-07-30
// Tags: attack.stealth, attack.t1218
// Description: Detects the expansion or decompression of cabinet files from potentially suspicious or uncommon locations, e.g. seen in Iranian MeteorExpress related attacks
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((Image="*\\expand.exe" AND (contains(CommandLine, "-F:") OR contains(CommandLine, "/F:"))) AND (((contains(CommandLine, ":\\Perflogs\\") OR contains(CommandLine, ":\\ProgramData") OR contains(CommandLine, ":\\Users\\Public\\") OR contains(CommandLine, ":\\Windows\\Temp\\") OR contains(CommandLine, "\\Admin$\\") OR contains(CommandLine, "\\AppData\\Local\\Temp\\") OR contains(CommandLine, "\\AppData\\Roaming\\") OR contains(CommandLine, "\\C$\\") OR contains(CommandLine, "\\Temporary Internet"))) OR (((contains(CommandLine, ":\\Users\\") AND contains(CommandLine, "\\Favorites\\"))) OR ((contains(CommandLine, ":\\Users\\") AND contains(CommandLine, "\\Favourites\\"))) OR ((contains(CommandLine, ":\\Users\\") AND contains(CommandLine, "\\Contacts\\"))))) AND NOT ((ParentImage == "C:\\Program Files (x86)\\Dell\\UpdateService\\ServiceShell.exe" AND contains(CommandLine, "C:\\ProgramData\\Dell\\UpdateService\\Temp\\"))))
