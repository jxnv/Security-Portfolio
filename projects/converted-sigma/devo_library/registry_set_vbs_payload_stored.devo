// Title: VBScript Payload Stored in Registry
// ID: 46490193-1b22-4c29-bdd6-5bf63907216f
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-03-05
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects VBScript content stored into registry keys as seen being used by UNC2452 group
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(TargetObject, "Software\\Microsoft\\Windows\\CurrentVersion") AND (contains(Details, "vbscript:") OR contains(Details, "jscript:") OR contains(Details, "mshtml,") OR contains(Details, "RunHTMLApplication") OR contains(Details, "Execute(") OR contains(Details, "CreateObject") OR contains(Details, "window.close"))) AND NOT (((contains(TargetObject, "Software\\Microsoft\\Windows\\CurrentVersion\\Run")) OR (Image="*\\msiexec.exe" AND contains(TargetObject, "\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Installer\\UserData\\") AND (contains(Details, "\\Microsoft.NET\\Primary Interop Assemblies\\Microsoft.mshtml.dll") OR contains(Details, "<\\Microsoft.mshtml,fileVersion=") OR contains(Details, "_mshtml_dll_") OR contains(Details, "<\\Microsoft.mshtml,culture="))))))
