// Title: Suspicious Invoke-WebRequest Execution With DirectIP
// ID: 1edff897-9146-48d2-9066-52e8d8f80a2f
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-21
// Tags: attack.command-and-control, attack.t1105
// Description: Detects calls to PowerShell with Invoke-WebRequest cmdlet using direct IP access
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "curl ") OR contains(CommandLine, "Invoke-RestMethod") OR contains(CommandLine, "Invoke-WebRequest") OR contains(CommandLine, " irm ") OR contains(CommandLine, "iwr ") OR contains(CommandLine, "wget "))) AND (((Image="*\\powershell_ise.exe" OR Image="*\\powershell.exe" OR Image="*\\pwsh.exe")) OR ((OriginalFileName == "powershell_ise.EXE" OR OriginalFileName == "PowerShell.EXE" OR OriginalFileName == "pwsh.dll"))) AND ((contains(CommandLine, "://1") OR contains(CommandLine, "://2") OR contains(CommandLine, "://3") OR contains(CommandLine, "://4") OR contains(CommandLine, "://5") OR contains(CommandLine, "://6") OR contains(CommandLine, "://7") OR contains(CommandLine, "://8") OR contains(CommandLine, "://9"))))
