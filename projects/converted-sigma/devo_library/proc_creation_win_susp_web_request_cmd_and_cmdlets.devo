// Title: Usage Of Web Request Commands And Cmdlets
// ID: 9fc51a3c-81b3-4fa7-b35f-7c02cf10fd2d
// Status: test
// Level: medium
// Author: James Pemberton / @4A616D6573, Endgame, JHasenbusch, oscd.community, Austin Songer @austinsonger
// Date: 2019-10-24
// Tags: attack.execution, attack.t1059.001
// Description: Detects the use of various web request commands with commandline tools and Windows PowerShell cmdlets (including aliases) via CommandLine
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(CommandLine, "[System.Net.WebRequest]::create") OR contains(CommandLine, "curl ") OR contains(CommandLine, "Invoke-RestMethod") OR contains(CommandLine, "Invoke-WebRequest") OR contains(CommandLine, " irm ") OR contains(CommandLine, "iwr ") OR contains(CommandLine, "Resume-BitsTransfer") OR contains(CommandLine, "Start-BitsTransfer") OR contains(CommandLine, "wget ") OR contains(CommandLine, "WinHttp.WinHttpRequest")))
