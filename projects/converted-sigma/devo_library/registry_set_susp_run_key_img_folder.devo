// Title: New RUN Key Pointing to Suspicious Folder
// ID: 02ee49e2-e294-4d0f-9278-f5b3212fc588
// Status: experimental
// Level: high
// Author: Florian Roth (Nextron Systems), Markus Neis, Sander Wiebing, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2018-08-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects suspicious new RUN key element pointing to an executable in a suspicious folder
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(TargetObject, "\\Software\\Microsoft\\Windows\\CurrentVersion\\Run") OR contains(TargetObject, "\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run") OR contains(TargetObject, "\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\Run"))) AND (((contains(Details, ":\\Perflogs") OR contains(Details, ":\\ProgramData'") OR contains(Details, ":\\Windows\\Temp") OR contains(Details, ":\\Temp") OR contains(Details, "\\AppData\\Local\\Temp") OR contains(Details, "\\AppData\\Roaming") OR contains(Details, ":\\$Recycle.bin") OR contains(Details, ":\\Users\\Default") OR contains(Details, ":\\Users\\public") OR contains(Details, "%temp%") OR contains(Details, "%tmp%") OR contains(Details, "%Public%") OR contains(Details, "%AppData%"))) OR ((contains(Details, ":\\Users\\")) AND ((contains(Details, "\\Favorites") OR contains(Details, "\\Favourites") OR contains(Details, "\\Contacts") OR contains(Details, "\\Music") OR contains(Details, "\\Pictures") OR contains(Details, "\\Documents") OR contains(Details, "\\Photos"))))) AND NOT ((contains(TargetObject, "\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\") AND Image="C:\\Windows\\SoftwareDistribution\\Download\\*" AND (contains(Details, "rundll32.exe ") AND contains(Details, "C:\\WINDOWS\\system32\\advpack.dll,DelNodeRunDLL32")) AND (contains(Details, "\\AppData\\Local\\Temp\\") OR contains(Details, "C:\\Windows\\Temp\\")))) AND NOT (((Image="*C:\\Program Files\\Spotify\\Spotify.exe" OR Image="*C:\\Program Files (x86)\\Spotify\\Spotify.exe" OR Image="*\\AppData\\Roaming\\Spotify\\Spotify.exe") AND TargetObject="*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\\Spotify" AND Details="*Spotify.exe --autostart --minimized")))
