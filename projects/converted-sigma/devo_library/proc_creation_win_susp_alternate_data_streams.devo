// Title: Execute From Alternate Data Streams
// ID: 7f43c430-5001-4f8b-aaa9-c3b88f18fa5c
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-09-01
// Tags: attack.stealth, attack.t1564.004
// Description: Detects execution from an Alternate Data Stream (ADS). Adversaries may use NTFS file attributes to hide their malicious data in order to evade detection
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(CommandLine, "txt:")) AND (((contains(CommandLine, "esentutl ") AND contains(CommandLine, " /y ") AND contains(CommandLine, " /d ") AND contains(CommandLine, " /o "))) OR ((contains(CommandLine, "makecab ") AND contains(CommandLine, ".cab"))) OR ((contains(CommandLine, "reg ") AND contains(CommandLine, " export "))) OR ((contains(CommandLine, "regedit ") AND contains(CommandLine, " /E "))) OR ((contains(CommandLine, "type ") AND contains(CommandLine, " > ")))))
