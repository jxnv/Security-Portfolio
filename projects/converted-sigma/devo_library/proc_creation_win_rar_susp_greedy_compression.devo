// Title: Suspicious Greedy Compression Using Rar.EXE
// ID: afe52666-401e-4a02-b4ff-5d128990b8cb
// Status: test
// Level: high
// Author: X__Junior (Nextron Systems), Florian Roth (Nextron Systems)
// Date: 2022-12-15
// Tags: attack.execution, attack.t1059
// Description: Detects RAR usage that creates an archive from a suspicious folder, either a system folder or one of the folders often used by attackers for staging purposes
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((Image="*\\rar.exe") OR (Description == "Command line RAR")) OR ((contains(CommandLine, ".exe a ") OR contains(CommandLine, " a -m")))) AND (((contains(CommandLine, " -hp") AND contains(CommandLine, " -r "))) AND ((contains(CommandLine, " ?:\\\\\\*.") OR contains(CommandLine, " ?:\\\\\\\\\\*.") OR contains(CommandLine, " ?:\\$Recycle.bin\\") OR contains(CommandLine, " ?:\\PerfLogs\\") OR contains(CommandLine, " ?:\\Temp") OR contains(CommandLine, " ?:\\Users\\Public\\") OR contains(CommandLine, " ?:\\Windows\\") OR contains(CommandLine, " %public%")))))
