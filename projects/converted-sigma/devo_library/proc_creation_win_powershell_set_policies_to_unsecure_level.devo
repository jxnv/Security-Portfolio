// Title: Change PowerShell Policies to an Insecure Level
// ID: 87e3c4e8-a6a8-4ad9-bb4f-46e7ff99a180
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-11-01
// Tags: attack.execution, attack.t1059.001
// Description: Detects changing the PowerShell script execution policy to a potentially insecure level using the "-ExecutionPolicy" flag.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((((OriginalFileName == "powershell_ise.exe" OR OriginalFileName == "PowerShell.EXE" OR OriginalFileName == "pwsh.dll")) OR ((Image="*\\powershell_ise.exe" OR Image="*\\powershell.exe" OR Image="*\\pwsh.exe"))) AND ((contains(CommandLine, "Bypass") OR contains(CommandLine, "Unrestricted"))) AND ((contains(CommandLine, "-executionpolicy ") OR contains(CommandLine, " -ep ") OR contains(CommandLine, " -exec ")))) AND NOT (((ParentImage == "C:\\Windows\\SysWOW64\\msiexec.exe" OR ParentImage == "C:\\Windows\\System32\\msiexec.exe") AND (contains(CommandLine, "-NoProfile -ExecutionPolicy Bypass -File \"C:\\Program Files\\PowerShell\\7\\") OR contains(CommandLine, "-NoProfile -ExecutionPolicy Bypass -File \"C:\\Program Files (x86)\\PowerShell\\7\\")))) AND NOT (((contains(ParentImage, "C:\\Program Files\\Avast Software\\Avast\\") OR contains(ParentImage, "C:\\Program Files (x86)\\Avast Software\\Avast\\") OR contains(ParentImage, "\\instup.exe")) AND (contains(CommandLine, "-ExecutionPolicy ByPass -File \"C:\\Program Files\\Avast Software\\Avast") OR contains(CommandLine, "-ExecutionPolicy ByPass -File \"C:\\Program Files (x86)\\Avast Software\\Avast\\")))))
