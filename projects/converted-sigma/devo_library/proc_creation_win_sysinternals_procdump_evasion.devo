// Title: Potential SysInternals ProcDump Evasion
// ID: 79b06761-465f-4f88-9ef2-150e24d3d737
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-01-11
// Tags: attack.stealth, attack.t1036, attack.t1003.001, attack.credential-access
// Description: Detects uses of the SysInternals ProcDump utility in which ProcDump or its output get renamed, or a dump file is moved or copied to a different name
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "copy procdump") OR contains(CommandLine, "move procdump"))) OR ((contains(CommandLine, "copy ") AND contains(CommandLine, ".dmp ")) AND (contains(CommandLine, "2.dmp") OR contains(CommandLine, "lsass") OR contains(CommandLine, "out.dmp"))) OR ((contains(CommandLine, "copy lsass.exe_") OR contains(CommandLine, "move lsass.exe_"))))
