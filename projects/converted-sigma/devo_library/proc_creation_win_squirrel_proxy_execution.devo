// Title: Process Proxy Execution Via Squirrel.EXE
// ID: 45239e6a-b035-4aaf-b339-8ad379fcb67e
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Karneades / Markus Neis, Jonhnathan Ribeiro, oscd.community
// Date: 2022-06-09
// Tags: attack.execution, attack.stealth, attack.t1218
// Description: Detects the usage of the "Squirrel.exe" binary to execute arbitrary processes. This binary is part of multiple Electron based software installations (Slack, Teams, Discord, etc.)
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((contains(CommandLine, "--processStart") OR contains(CommandLine, "--processStartAndWait") OR contains(CommandLine, "--createShortcut"))) AND ((Image="*\\squirrel.exe" OR Image="*\\update.exe"))) AND NOT ((((contains(CommandLine, ":\\Users\\") AND contains(CommandLine, "\\AppData\\Local\\Discord\\Update.exe") AND contains(CommandLine, "Discord.exe")) AND (contains(CommandLine, "--createShortcut") OR contains(CommandLine, "--processStart"))) OR ((contains(CommandLine, ":\\Users\\") AND contains(CommandLine, "\\AppData\\Local\\GitHubDesktop\\Update.exe") AND contains(CommandLine, "GitHubDesktop.exe")) AND (contains(CommandLine, "--createShortcut") OR contains(CommandLine, "--processStartAndWait"))) OR ((contains(CommandLine, ":\\Users\\") AND contains(CommandLine, "\\AppData\\Local\\Microsoft\\Teams\\Update.exe") AND contains(CommandLine, "Teams.exe")) AND (contains(CommandLine, "--processStart") OR contains(CommandLine, "--createShortcut"))) OR ((contains(CommandLine, ":\\Users\\") AND contains(CommandLine, "\\AppData\\Local\\yammerdesktop\\Update.exe") AND contains(CommandLine, "Yammer.exe")) AND (contains(CommandLine, "--processStart") OR contains(CommandLine, "--createShortcut"))))))
