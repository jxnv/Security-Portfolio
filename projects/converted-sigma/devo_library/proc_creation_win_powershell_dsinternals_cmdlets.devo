// Title: DSInternals Suspicious PowerShell Cmdlets
// ID: 43d91656-a9b2-4541-b7e2-6a9bd3a13f4e
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Nounou Mbeiri
// Date: 2024-06-26
// Tags: attack.execution, attack.t1059.001
// Description: Detects execution and usage of the DSInternals PowerShell module. Which can be used to perform what might be considered as suspicious activity such as dumping DPAPI backup keys or manipulating NTDS.DIT files.
// The DSInternals PowerShell Module exposes several internal features of Active Directory and Azure Active Directory. These include FIDO2 and NGC key auditing, offline ntds.dit file manipulation, password auditing, DC recovery from IFM backups and password hash calculation.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(CommandLine, "Add-ADDBSidHistory") OR contains(CommandLine, "Add-ADNgcKey") OR contains(CommandLine, "Add-ADReplNgcKey") OR contains(CommandLine, "ConvertFrom-ADManagedPasswordBlob") OR contains(CommandLine, "ConvertFrom-GPPrefPassword") OR contains(CommandLine, "ConvertFrom-ManagedPasswordBlob") OR contains(CommandLine, "ConvertFrom-UnattendXmlPassword") OR contains(CommandLine, "ConvertFrom-UnicodePassword") OR contains(CommandLine, "ConvertTo-AADHash") OR contains(CommandLine, "ConvertTo-GPPrefPassword") OR contains(CommandLine, "ConvertTo-KerberosKey") OR contains(CommandLine, "ConvertTo-LMHash") OR contains(CommandLine, "ConvertTo-MsoPasswordHash") OR contains(CommandLine, "ConvertTo-NTHash") OR contains(CommandLine, "ConvertTo-OrgIdHash") OR contains(CommandLine, "ConvertTo-UnicodePassword") OR contains(CommandLine, "Disable-ADDBAccount") OR contains(CommandLine, "Enable-ADDBAccount") OR contains(CommandLine, "Get-ADDBAccount") OR contains(CommandLine, "Get-ADDBBackupKey") OR contains(CommandLine, "Get-ADDBDomainController") OR contains(CommandLine, "Get-ADDBGroupManagedServiceAccount") OR contains(CommandLine, "Get-ADDBKdsRootKey") OR contains(CommandLine, "Get-ADDBSchemaAttribute") OR contains(CommandLine, "Get-ADDBServiceAccount") OR contains(CommandLine, "Get-ADDefaultPasswordPolicy") OR contains(CommandLine, "Get-ADKeyCredential") OR contains(CommandLine, "Get-ADPasswordPolicy") OR contains(CommandLine, "Get-ADReplAccount") OR contains(CommandLine, "Get-ADReplBackupKey") OR contains(CommandLine, "Get-ADReplicationAccount") OR contains(CommandLine, "Get-ADSIAccount") OR contains(CommandLine, "Get-AzureADUserEx") OR contains(CommandLine, "Get-BootKey") OR contains(CommandLine, "Get-KeyCredential") OR contains(CommandLine, "Get-LsaBackupKey") OR contains(CommandLine, "Get-LsaPolicy") OR contains(CommandLine, "Get-SamPasswordPolicy") OR contains(CommandLine, "Get-SysKey") OR contains(CommandLine, "Get-SystemKey") OR contains(CommandLine, "New-ADDBRestoreFromMediaScript") OR contains(CommandLine, "New-ADKeyCredential") OR contains(CommandLine, "New-ADNgcKey") OR contains(CommandLine, "New-NTHashSet") OR contains(CommandLine, "Remove-ADDBObject") OR contains(CommandLine, "Save-DPAPIBlob") OR contains(CommandLine, "Set-ADAccountPasswordHash") OR contains(CommandLine, "Set-ADDBAccountPassword") OR contains(CommandLine, "Set-ADDBBootKey") OR contains(CommandLine, "Set-ADDBDomainController") OR contains(CommandLine, "Set-ADDBPrimaryGroup") OR contains(CommandLine, "Set-ADDBSysKey") OR contains(CommandLine, "Set-AzureADUserEx") OR contains(CommandLine, "Set-LsaPolicy") OR contains(CommandLine, "Set-SamAccountPasswordHash") OR contains(CommandLine, "Set-WinUserPasswordHash") OR contains(CommandLine, "Test-ADDBPasswordQuality") OR contains(CommandLine, "Test-ADPasswordQuality") OR contains(CommandLine, "Test-ADReplPasswordQuality") OR contains(CommandLine, "Test-PasswordQuality") OR contains(CommandLine, "Unlock-ADDBAccount") OR contains(CommandLine, "Write-ADNgcKey") OR contains(CommandLine, "Write-ADReplNgcKey")))
