// Title: Potential WinAPI Calls Via CommandLine
// ID: ba3f5c1b-6272-4119-9dbd-0bc8d21c2702
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-06
// Tags: attack.execution, attack.t1106
// Description: Detects the use of WinAPI Functions via the commandline. As seen used by threat actors via the tool winapiexec
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "AddSecurityPackage") OR contains(CommandLine, "AdjustTokenPrivileges") OR contains(CommandLine, "Advapi32") OR contains(CommandLine, "CloseHandle") OR contains(CommandLine, "CreateProcessWithToken") OR contains(CommandLine, "CreatePseudoConsole") OR contains(CommandLine, "CreateRemoteThread") OR contains(CommandLine, "CreateThread") OR contains(CommandLine, "CreateUserThread") OR contains(CommandLine, "DangerousGetHandle") OR contains(CommandLine, "DuplicateTokenEx") OR contains(CommandLine, "EnumerateSecurityPackages") OR contains(CommandLine, "FreeHGlobal") OR contains(CommandLine, "FreeLibrary") OR contains(CommandLine, "GetDelegateForFunctionPointer") OR contains(CommandLine, "GetLogonSessionData") OR contains(CommandLine, "GetModuleHandle") OR contains(CommandLine, "GetProcAddress") OR contains(CommandLine, "GetProcessHandle") OR contains(CommandLine, "GetTokenInformation") OR contains(CommandLine, "ImpersonateLoggedOnUser") OR contains(CommandLine, "kernel32") OR contains(CommandLine, "LoadLibrary") OR contains(CommandLine, "memcpy") OR contains(CommandLine, "MiniDumpWriteDump") OR contains(CommandLine, "ntdll") OR contains(CommandLine, "OpenDesktop") OR contains(CommandLine, "OpenProcess") OR contains(CommandLine, "OpenProcessToken") OR contains(CommandLine, "OpenThreadToken") OR contains(CommandLine, "OpenWindowStation") OR contains(CommandLine, "PtrToString") OR contains(CommandLine, "QueueUserApc") OR contains(CommandLine, "ReadProcessMemory") OR contains(CommandLine, "RevertToSelf") OR contains(CommandLine, "RtlCreateUserThread") OR contains(CommandLine, "secur32") OR contains(CommandLine, "SetThreadToken") OR contains(CommandLine, "VirtualAlloc") OR contains(CommandLine, "VirtualFree") OR contains(CommandLine, "VirtualProtect") OR contains(CommandLine, "WaitForSingleObject") OR contains(CommandLine, "WriteInt32") OR contains(CommandLine, "WriteProcessMemory") OR contains(CommandLine, "ZeroFreeGlobalAllocUnicode"))) AND NOT (((ParentImage="*\\CompatTelRunner.exe" AND (contains(CommandLine, "FreeHGlobal") OR contains(CommandLine, "PtrToString") OR contains(CommandLine, "kernel32") OR contains(CommandLine, "CloseHandle"))) OR (Image="*\\MpCmdRun.exe" AND contains(CommandLine, "GetLoadLibraryWAddress32")))))
