// Title: Powershell Inline Execution From A File
// ID: ee218c12-627a-4d27-9e30-d6fb2fe22ed2
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-12-25
// Tags: attack.execution, attack.t1059.001
// Description: Detects inline execution of PowerShell code from a file
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "iex ") OR contains(CommandLine, "Invoke-Expression ") OR contains(CommandLine, "Invoke-Command ") OR contains(CommandLine, "icm "))) AND (contains(CommandLine, " -raw")) AND ((contains(CommandLine, "cat ") OR contains(CommandLine, "get-content ") OR contains(CommandLine, "type "))))
