// Title: Suspicious Service Path Modification
// ID: 138d3531-8793-4f50-a2cd-f291b2863d78
// Status: test
// Level: high
// Author: Victor Sergeev, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-10-21
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects service path modification via the "sc" binary to a suspicious command or path
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (Image="*\\sc.exe" AND (contains(CommandLine, "config") AND contains(CommandLine, "binPath")) AND (contains(CommandLine, "powershell") OR contains(CommandLine, "cmd ") OR contains(CommandLine, "mshta") OR contains(CommandLine, "wscript") OR contains(CommandLine, "cscript") OR contains(CommandLine, "rundll32") OR contains(CommandLine, "svchost") OR contains(CommandLine, "dllhost") OR contains(CommandLine, "cmd.exe /c") OR contains(CommandLine, "cmd.exe /k") OR contains(CommandLine, "cmd.exe /r") OR contains(CommandLine, "cmd /c") OR contains(CommandLine, "cmd /k") OR contains(CommandLine, "cmd /r") OR contains(CommandLine, "C:\\Users\\Public") OR contains(CommandLine, "\\Downloads\\") OR contains(CommandLine, "\\Desktop\\") OR contains(CommandLine, "\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\") OR contains(CommandLine, "C:\\Windows\\TEMP\\") OR contains(CommandLine, "\\AppData\\Local\\Temp")))
