// Title: Suspicious Download From File-Sharing Website Via Bitsadmin
// ID: 8518ed3d-f7c9-4601-a26c-f361a4256a0c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-06-28
// Tags: attack.persistence, attack.execution, attack.stealth, attack.t1197, attack.s0190, attack.t1036.003, attack.command-and-control, attack.t1105
// Description: Detects usage of bitsadmin downloading a file from a suspicious domain
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, ".githubusercontent.com") OR contains(CommandLine, "0x0.st") OR contains(CommandLine, "anonfiles.com") OR contains(CommandLine, "bashupload.com") OR contains(CommandLine, "cdn.discordapp.com") OR contains(CommandLine, "chunk.io") OR contains(CommandLine, "ddns.net") OR contains(CommandLine, "dl.dropboxusercontent.com") OR contains(CommandLine, "ghostbin.co") OR contains(CommandLine, "github.com") OR contains(CommandLine, "glitch.me") OR contains(CommandLine, "gofile.io") OR contains(CommandLine, "hastebin.com") OR contains(CommandLine, "mediafire.com") OR contains(CommandLine, "mega.nz") OR contains(CommandLine, "onrender.com") OR contains(CommandLine, "pages.dev") OR contains(CommandLine, "paste.ee") OR contains(CommandLine, "pastebin.com") OR contains(CommandLine, "pastebin.pl") OR contains(CommandLine, "pastetext.net") OR contains(CommandLine, "privatlab.com") OR contains(CommandLine, "privatlab.net") OR contains(CommandLine, "send.exploit.in") OR contains(CommandLine, "sendspace.com") OR contains(CommandLine, "storage.googleapis.com") OR contains(CommandLine, "storjshare.io") OR contains(CommandLine, "supabase.co") OR contains(CommandLine, "temp.sh") OR contains(CommandLine, "transfer.sh") OR contains(CommandLine, "trycloudflare.com") OR contains(CommandLine, "ufile.io") OR contains(CommandLine, "w3spaces.com") OR contains(CommandLine, "workers.dev") OR contains(CommandLine, "x0.at"))) AND ((contains(CommandLine, " /transfer ") OR contains(CommandLine, " /create ") OR contains(CommandLine, " /addfile "))) AND ((Image="*\\bitsadmin.exe") OR (OriginalFileName == "bitsadmin.exe")))
