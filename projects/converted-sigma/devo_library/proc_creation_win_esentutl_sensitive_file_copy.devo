// Title: Copying Sensitive Files with Credential Data
// ID: e7be6119-fc37-43f0-ad4f-1f3f99be2f9f
// Status: test
// Level: high
// Author: Teymur Kheirkhabarov, Daniil Yugoslavskiy, oscd.community
// Date: 2019-10-22
// Tags: attack.credential-access, attack.t1003.002, attack.t1003.003, car.2013-07-001, attack.s0404
// Description: Files with well-known filenames (sensitive files with credential data) copying
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((contains(CommandLine, "vss") OR contains(CommandLine, " /m ") OR contains(CommandLine, " /y "))) AND ((Image="*\\esentutl.exe") OR (OriginalFileName == "\\esentutl.exe"))) OR ((contains(CommandLine, "\\config\\RegBack\\sam") OR contains(CommandLine, "\\config\\RegBack\\security") OR contains(CommandLine, "\\config\\RegBack\\system") OR contains(CommandLine, "\\config\\sam") OR contains(CommandLine, "\\config\\security") OR contains(CommandLine, "\\config\\system ") OR contains(CommandLine, "\\repair\\sam") OR contains(CommandLine, "\\repair\\security") OR contains(CommandLine, "\\repair\\system") OR contains(CommandLine, "\\windows\\ntds\\ntds.dit"))))
