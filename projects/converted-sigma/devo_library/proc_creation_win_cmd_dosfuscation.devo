// Title: Potential Dosfuscation Activity
// ID: a77c1610-fc73-4019-8e29-0f51efc04a51
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-02-15
// Tags: attack.execution, attack.t1059
// Description: Detects possible payload obfuscation via the commandline
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(CommandLine, "^^") OR contains(CommandLine, "^|^") OR contains(CommandLine, ",;,") OR contains(CommandLine, ";;;;") OR contains(CommandLine, ";; ;;") OR contains(CommandLine, "(,(,") OR contains(CommandLine, "%COMSPEC:~") OR contains(CommandLine, " c^m^d") OR contains(CommandLine, "^c^m^d") OR contains(CommandLine, " c^md") OR contains(CommandLine, " cm^d") OR contains(CommandLine, "^cm^d") OR contains(CommandLine, " s^et ") OR contains(CommandLine, " s^e^t ") OR contains(CommandLine, " se^t ")))
