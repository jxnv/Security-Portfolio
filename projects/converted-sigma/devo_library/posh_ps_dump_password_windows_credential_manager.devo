// Title: Dump Credentials from Windows Credential Manager With PowerShell
// ID: 99c49d9c-34ea-45f7-84a7-4751ae6b2cbc
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-12-20
// Tags: attack.credential-access, attack.t1555
// Description: Adversaries may search for common password storage locations to obtain user credentials.
// Passwords are stored in several places on a system, depending on the operating system or application holding the credentials.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(ScriptBlockText, "Get-PasswordVaultCredentials") OR contains(ScriptBlockText, "Get-CredManCreds"))) OR ((contains(ScriptBlockText, "New-Object") AND contains(ScriptBlockText, "Windows.Security.Credentials.PasswordVault"))) OR ((contains(ScriptBlockText, "New-Object") AND contains(ScriptBlockText, "Microsoft.CSharp.CSharpCodeProvider") AND contains(ScriptBlockText, "[System.Runtime.InteropServices.RuntimeEnvironment]::GetRuntimeDirectory())") AND contains(ScriptBlockText, "Collections.ArrayList") AND contains(ScriptBlockText, "System.CodeDom.Compiler.CompilerParameters"))))
