// Title: Potential Command Line Path Traversal Evasion Attempt
// ID: 1327381e-6ab0-4f38-b583-4c1b8346a56b
// Status: test
// Level: medium
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-10-26
// Tags: attack.stealth, attack.t1036
// Description: Detects potential evasion or obfuscation attempts using bogus path traversal via the commandline
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(Image, "\\Windows\\") AND (contains(CommandLine, "\\..\\Windows\\") OR contains(CommandLine, "\\..\\System32\\") OR contains(CommandLine, "\\..\\..\\"))) OR (contains(CommandLine, ".exe\\..\\"))) AND NOT (((contains(CommandLine, "\\Citrix\\Virtual Smart Card\\Citrix.Authentication.VirtualSmartcard.Launcher.exe\\..\\")) OR (contains(CommandLine, "\\Google\\Drive\\googledrivesync.exe\\..\\")))))
