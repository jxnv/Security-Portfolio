// Title: PowerShell Base64 Encoded WMI Classes
// ID: 1816994b-42e1-4fb1-afd2-134d88184f71
// Status: test
// Level: high
// Author: Christian Burkard (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-30
// Tags: attack.execution, attack.stealth, attack.t1059.001, attack.t1027
// Description: Detects calls to base64 encoded WMI class such as "Win32_ShadowCopy", "Win32_ScheduledJob", etc.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((Image="*\\powershell.exe" OR Image="*\\pwsh.exe")) OR ((OriginalFileName == "PowerShell.EXE" OR OriginalFileName == "pwsh.dll"))) AND (((contains(CommandLine, "VwBpAG4AMwAyAF8ATABvAGcAZwBlAGQATwBuAFUAcwBlAHIA") OR contains(CommandLine, "cAaQBuADMAMgBfAEwAbwBnAGcAZQBkAE8AbgBVAHMAZQByA") OR contains(CommandLine, "XAGkAbgAzADIAXwBMAG8AZwBnAGUAZABPAG4AVQBzAGUAcg") OR contains(CommandLine, "V2luMzJfTG9nZ2VkT25Vc2Vy") OR contains(CommandLine, "dpbjMyX0xvZ2dlZE9uVXNlc") OR contains(CommandLine, "XaW4zMl9Mb2dnZWRPblVzZX"))) OR ((contains(CommandLine, "VwBpAG4AMwAyAF8AUAByAG8AYwBlAHMAcw") OR contains(CommandLine, "cAaQBuADMAMgBfAFAAcgBvAGMAZQBzAHMA") OR contains(CommandLine, "XAGkAbgAzADIAXwBQAHIAbwBjAGUAcwBzA") OR contains(CommandLine, "V2luMzJfUHJvY2Vzc") OR contains(CommandLine, "dpbjMyX1Byb2Nlc3") OR contains(CommandLine, "XaW4zMl9Qcm9jZXNz"))) OR ((contains(CommandLine, "VwBpAG4AMwAyAF8AUwBjAGgAZQBkAHUAbABlAGQASgBvAGIA") OR contains(CommandLine, "cAaQBuADMAMgBfAFMAYwBoAGUAZAB1AGwAZQBkAEoAbwBiA") OR contains(CommandLine, "XAGkAbgAzADIAXwBTAGMAaABlAGQAdQBsAGUAZABKAG8AYg") OR contains(CommandLine, "V2luMzJfU2NoZWR1bGVkSm9i") OR contains(CommandLine, "dpbjMyX1NjaGVkdWxlZEpvY") OR contains(CommandLine, "XaW4zMl9TY2hlZHVsZWRKb2"))) OR ((contains(CommandLine, "VwBpAG4AMwAyAF8AUwBoAGEAZABvAHcAYwBvAHAAeQ") OR contains(CommandLine, "cAaQBuADMAMgBfAFMAaABhAGQAbwB3AGMAbwBwAHkA") OR contains(CommandLine, "XAGkAbgAzADIAXwBTAGgAYQBkAG8AdwBjAG8AcAB5A") OR contains(CommandLine, "V2luMzJfU2hhZG93Y29we") OR contains(CommandLine, "dpbjMyX1NoYWRvd2NvcH") OR contains(CommandLine, "XaW4zMl9TaGFkb3djb3B5"))) OR ((contains(CommandLine, "VwBpAG4AMwAyAF8AVQBzAGUAcgBBAGMAYwBvAHUAbgB0A") OR contains(CommandLine, "cAaQBuADMAMgBfAFUAcwBlAHIAQQBjAGMAbwB1AG4AdA") OR contains(CommandLine, "XAGkAbgAzADIAXwBVAHMAZQByAEEAYwBjAG8AdQBuAHQA") OR contains(CommandLine, "V2luMzJfVXNlckFjY291bn") OR contains(CommandLine, "dpbjMyX1VzZXJBY2NvdW50") OR contains(CommandLine, "XaW4zMl9Vc2VyQWNjb3Vud")))))
