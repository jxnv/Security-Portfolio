// Title: AADInternals PowerShell Cmdlets Execution - ProccessCreation
// ID: c86500e9-a645-4680-98d7-f882c70c1ea3
// Status: test
// Level: high
// Author: Austin Songer (@austinsonger), Nasreddine Bencherchali (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2022-12-23
// Tags: attack.execution, attack.reconnaissance, attack.discovery, attack.credential-access, attack.impact
// Description: Detects ADDInternals Cmdlet execution. A tool for administering Azure AD and Office 365. Which can be abused by threat actors to attack Azure AD or Office 365.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "Add-AADInt") OR contains(CommandLine, "ConvertTo-AADInt") OR contains(CommandLine, "Disable-AADInt") OR contains(CommandLine, "Enable-AADInt") OR contains(CommandLine, "Export-AADInt") OR contains(CommandLine, "Find-AADInt") OR contains(CommandLine, "Get-AADInt") OR contains(CommandLine, "Grant-AADInt") OR contains(CommandLine, "Initialize-AADInt") OR contains(CommandLine, "Install-AADInt") OR contains(CommandLine, "Invoke-AADInt") OR contains(CommandLine, "Join-AADInt") OR contains(CommandLine, "New-AADInt") OR contains(CommandLine, "Open-AADInt") OR contains(CommandLine, "Read-AADInt") OR contains(CommandLine, "Register-AADInt") OR contains(CommandLine, "Remove-AADInt") OR contains(CommandLine, "Reset-AADInt") OR contains(CommandLine, "Resolve-AADInt") OR contains(CommandLine, "Restore-AADInt") OR contains(CommandLine, "Save-AADInt") OR contains(CommandLine, "Search-AADInt") OR contains(CommandLine, "Send-AADInt") OR contains(CommandLine, "Set-AADInt") OR contains(CommandLine, "Start-AADInt") OR contains(CommandLine, "Unprotect-AADInt") OR contains(CommandLine, "Update-AADInt"))) AND (((Image="*\\powershell.exe" OR Image="*\\powershell_ise.exe" OR Image="*\\pwsh.exe")) OR ((OriginalFileName == "PowerShell.Exe" OR OriginalFileName == "pwsh.dll"))))
