// Title: Schtasks Creation Or Modification With SYSTEM Privileges
// ID: 89ca78fd-b37c-4310-b3d3-81a023f83936
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-28
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053.005
// Description: Detects the creation or update of a scheduled task to run with "NT AUTHORITY\SYSTEM" privileges
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((Image="*\\schtasks.exe" AND (contains(CommandLine, " /change ") OR contains(CommandLine, " /create "))) AND (contains(CommandLine, "/ru ")) AND ((contains(CommandLine, "NT AUT") OR contains(CommandLine, " SYSTEM ")))) AND NOT ((((contains(CommandLine, "/Create /F /RU System /SC WEEKLY /TN AviraSystemSpeedupVerify /TR ") OR contains(CommandLine, ":\\Program Files (x86)\\Avira\\System Speedup\\setup\\avira_speedup_setup.exe") OR contains(CommandLine, "/VERIFY /VERYSILENT /NOSTART /NODOTNET /NORESTART\" /RL HIGHEST"))) OR ((contains(CommandLine, "Subscription Heartbeat") AND contains(CommandLine, "\\HeartbeatConfig.xml") AND contains(CommandLine, "\\Microsoft Shared\\OFFICE"))) OR (Image="*\\schtasks.exe" AND (contains(CommandLine, "/TN TVInstallRestore") AND contains(CommandLine, "\\TeamViewer_.exe"))))))
