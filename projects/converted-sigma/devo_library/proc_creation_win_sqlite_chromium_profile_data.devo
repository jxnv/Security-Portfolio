// Title: SQLite Chromium Profile Data DB Access
// ID: 24c77512-782b-448a-8950-eddb0785fc71
// Status: test
// Level: high
// Author: TropChaud
// Date: 2022-12-19
// Tags: attack.credential-access, attack.t1539, attack.t1555.003, attack.collection, attack.t1005
// Description: Detect usage of the "sqlite" binary to query databases in Chromium-based browsers for potential data stealing.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "\\User Data\\") OR contains(CommandLine, "\\Opera Software\\") OR contains(CommandLine, "\\ChromiumViewer\\"))) AND ((contains(CommandLine, "Login Data") OR contains(CommandLine, "Cookies") OR contains(CommandLine, "Web Data") OR contains(CommandLine, "History") OR contains(CommandLine, "Bookmarks"))) AND ((Product == "SQLite") OR ((Image="*\\sqlite.exe" OR Image="*\\sqlite3.exe"))))
