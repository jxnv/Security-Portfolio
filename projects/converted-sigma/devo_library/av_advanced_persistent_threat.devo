// Title: Antivirus - APT Malware Signature
// ID: 101a1877-2cf4-474d-abfd-7f6ac4788d1a
// Status: experimental
// Level: critical
// Author: Arnim Rupp (Nextron Systems)
// Date: 2026-06-15
// Tags: attack.execution, attack.t1203, attack.command-and-control, attack.t1219.002
// Description: Detects a highly relevant Antivirus alert that reports APT malware.
// This event must not be ignored just because the AV has blocked the malware but investigate, how it came there in the first place.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((Signature=regex("APT\\d") OR Signature=regex("ATK\\d") OR Signature=regex("UNC\\d") OR Signature=regex("UAC\\d"))) OR ((contains(Signature, "[APT]") OR contains(Signature, "APT_") OR contains(Signature, "APT-") OR contains(Signature, "BackOrder") OR contains(Signature, "BlindingCan") OR contains(Signature, "Blizzard") OR contains(Signature, "Chollima") OR contains(Signature, "Cleaver") OR contains(Signature, "Cobra") OR contains(Signature, "DarkHotel") OR contains(Signature, "Dragon") OR contains(Signature, "DTrack") OR contains(Signature, "Equation") OR contains(Signature, "GiftedCrook") OR contains(Signature, "GraphSteel") OR contains(Signature, "GreyEnergy") OR contains(Signature, "GEnergy") OR contains(Signature, "GrimPlant") OR contains(Signature, "Hydra") OR contains(Signature, "Jackal") OR contains(Signature, "Kitten") OR contains(Signature, "Kimsuky") OR contains(Signature, "Lazar") OR contains(Signature, "LightRail") OR contains(Signature, "Lotus") OR contains(Signature, "Luminous") OR contains(Signature, "LumiMoth") OR contains(Signature, "Nimbus") OR contains(Signature, "Manticore") OR contains(Signature, "MiniBike") OR contains(Signature, "MiniBrowse") OR contains(Signature, "MiniBus") OR contains(Signature, "MiniFast") OR contains(Signature, "MiniJuke") OR contains(Signature, "MiniUpdate") OR contains(Signature, "MuddyWater") OR contains(Signature, "NukeSped") OR contains(Signature, "OilRig") OR contains(Signature, "Panda") OR contains(Signature, "Sandstorm") OR contains(Signature, "SandWorm") OR contains(Signature, "Seamonkey") OR contains(Signature, "Sleet") OR contains(Signature, "SlugResin") OR contains(Signature, "SnailResin") OR contains(Signature, "Snake") OR contains(Signature, "Tempest") OR contains(Signature, "Tsunami") OR contains(Signature, "Turla") OR contains(Signature, "Typhoon") OR contains(Signature, "UAC_") OR contains(Signature, "UAC-") OR contains(Signature, "UNC_") OR contains(Signature, "UNC-") OR contains(Signature, "VinoSiren") OR contains(Signature, "Winnti"))))
