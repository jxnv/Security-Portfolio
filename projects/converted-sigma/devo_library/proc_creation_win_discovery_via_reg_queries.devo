// Title: System Information Discovery via Registry Queries
// ID: 0022869c-49f7-4ff2-ba03-85ac42ddac58
// Status: experimental
// Level: low
// Author: lazarg
// Date: 2025-06-12
// Tags: attack.discovery, attack.t1082
// Description: Detects attempts to query system information directly from the Windows Registry.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((Image="*\\powershell.exe" OR Image="*\\pwsh.exe") AND (contains(CommandLine, "Get-ItemPropertyValue") OR contains(CommandLine, "gpv"))) OR (Image="*\\reg.exe" AND contains(CommandLine, "query") AND (contains(CommandLine, "-v") OR contains(CommandLine, "/v")))) AND ((contains(CommandLine, "\\SOFTWARE\\Microsoft\\Windows Defender") OR contains(CommandLine, "\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion") OR contains(CommandLine, "\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall") OR contains(CommandLine, "\\SYSTEM\\CurrentControlSet\\Control\\TimeZoneInformation") OR contains(CommandLine, "\\SYSTEM\\CurrentControlSet\\Services"))))
