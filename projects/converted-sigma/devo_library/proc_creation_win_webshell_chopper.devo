// Title: Chopper Webshell Process Pattern
// ID: fa3c117a-bc0d-416e-a31b-0c0e80653efb
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), MSTI (query)
// Date: 2022-10-01
// Tags: attack.persistence, attack.discovery, attack.t1505.003, attack.t1018, attack.t1033, attack.t1087
// Description: Detects patterns found in process executions cause by China Chopper like tiny (ASPX) webshells
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "&ipconfig&echo") OR contains(CommandLine, "&quser&echo") OR contains(CommandLine, "&whoami&echo") OR contains(CommandLine, "&c:&echo") OR contains(CommandLine, "&cd&echo") OR contains(CommandLine, "&dir&echo") OR contains(CommandLine, "&echo [E]") OR contains(CommandLine, "&echo [S]"))) AND ((Image="*\\w3wp.exe") OR (ParentImage="*\\w3wp.exe")))
