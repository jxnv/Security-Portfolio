// Title: Webshell Hacking Activity Patterns
// ID: 4ebc877f-4612-45cb-b3a5-8e3834db36c9
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-17
// Tags: attack.persistence, attack.discovery, attack.t1505.003, attack.t1018, attack.t1033, attack.t1087
// Description: Detects certain parent child patterns found in cases in which a web shell is used to perform certain credential dumping or exfiltration activities on a compromised system
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((ParentImage="*\\java.exe" OR ParentImage="*\\javaw.exe") AND (contains(ParentImage, "-tomcat-") OR contains(ParentImage, "\\tomcat"))) OR ((ParentImage="*\\java.exe" OR ParentImage="*\\javaw.exe") AND (contains(CommandLine, "catalina.jar") OR contains(CommandLine, "CATALINA_HOME"))) OR ((ParentImage="*\\caddy.exe" OR ParentImage="*\\httpd.exe" OR ParentImage="*\\nginx.exe" OR ParentImage="*\\php-cgi.exe" OR ParentImage="*\\w3wp.exe" OR ParentImage="*\\ws_tomcatservice.exe"))) AND (((contains(CommandLine, "rundll32") AND contains(CommandLine, "comsvcs"))) OR ((contains(CommandLine, " -hp") AND contains(CommandLine, " a ") AND contains(CommandLine, " -m"))) OR ((contains(CommandLine, "net") AND contains(CommandLine, " user ") AND contains(CommandLine, " /add"))) OR ((contains(CommandLine, "net") AND contains(CommandLine, " localgroup ") AND contains(CommandLine, " administrators ") AND contains(CommandLine, "/add"))) OR ((Image="*\\ntdsutil.exe" OR Image="*\\ldifde.exe" OR Image="*\\adfind.exe" OR Image="*\\procdump.exe" OR Image="*\\Nanodump.exe" OR Image="*\\vssadmin.exe" OR Image="*\\fsutil.exe")) OR ((contains(CommandLine, " -decode ") OR contains(CommandLine, " -NoP ") OR contains(CommandLine, " -W Hidden ") OR contains(CommandLine, " /decode ") OR contains(CommandLine, " /ticket:") OR contains(CommandLine, " sekurlsa") OR contains(CommandLine, ".dmp full") OR contains(CommandLine, ".downloadfile(") OR contains(CommandLine, ".downloadstring(") OR contains(CommandLine, "FromBase64String") OR contains(CommandLine, "process call create") OR contains(CommandLine, "reg save ") OR contains(CommandLine, "whoami /priv")))))
