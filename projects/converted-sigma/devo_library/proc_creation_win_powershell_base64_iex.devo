// Title: PowerShell Base64 Encoded IEX Cmdlet
// ID: 88f680b8-070e-402c-ae11-d2914f2257f1
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2019-08-23
// Tags: attack.execution, attack.t1059.001
// Description: Detects usage of a base64 encoded "IEX" cmdlet in a process command line
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "SUVYIChb") OR contains(CommandLine, "lFWCAoW") OR contains(CommandLine, "JRVggKF") OR contains(CommandLine, "aWV4IChb") OR contains(CommandLine, "lleCAoW") OR contains(CommandLine, "pZXggKF") OR contains(CommandLine, "aWV4IChOZX") OR contains(CommandLine, "lleCAoTmV3") OR contains(CommandLine, "pZXggKE5ld") OR contains(CommandLine, "SUVYIChOZX") OR contains(CommandLine, "lFWCAoTmV3") OR contains(CommandLine, "JRVggKE5ld") OR contains(CommandLine, "SUVYKF") OR contains(CommandLine, "lFWChb") OR contains(CommandLine, "JRVgoW") OR contains(CommandLine, "aWV4KF") OR contains(CommandLine, "lleChb") OR contains(CommandLine, "pZXgoW") OR contains(CommandLine, "aWV4KE5ld") OR contains(CommandLine, "lleChOZX") OR contains(CommandLine, "pZXgoTmV3") OR contains(CommandLine, "SUVYKE5ld") OR contains(CommandLine, "lFWChOZX") OR contains(CommandLine, "JRVgoTmV3") OR contains(CommandLine, "SUVYKCgn") OR contains(CommandLine, "lFWCgoJ") OR contains(CommandLine, "JRVgoKC") OR contains(CommandLine, "aWV4KCgn") OR contains(CommandLine, "lleCgoJ") OR contains(CommandLine, "pZXgoKC"))) OR ((contains(CommandLine, "SQBFAFgAIAAoAFsA") OR contains(CommandLine, "kARQBYACAAKABbA") OR contains(CommandLine, "JAEUAWAAgACgAWw") OR contains(CommandLine, "aQBlAHgAIAAoAFsA") OR contains(CommandLine, "kAZQB4ACAAKABbA") OR contains(CommandLine, "pAGUAeAAgACgAWw") OR contains(CommandLine, "aQBlAHgAIAAoAE4AZQB3A") OR contains(CommandLine, "kAZQB4ACAAKABOAGUAdw") OR contains(CommandLine, "pAGUAeAAgACgATgBlAHcA") OR contains(CommandLine, "SQBFAFgAIAAoAE4AZQB3A") OR contains(CommandLine, "kARQBYACAAKABOAGUAdw") OR contains(CommandLine, "JAEUAWAAgACgATgBlAHcA"))))
