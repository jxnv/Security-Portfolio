// Title: Suspicious SYSTEM User Process Creation
// ID: 2617e7ed-adb7-40ba-b0f3-8f9945fe6c09
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), David ANDRE (additional keywords)
// Date: 2021-12-20
// Tags: attack.credential-access, attack.privilege-escalation, attack.stealth, attack.t1134, attack.t1003, attack.t1027
// Description: Detects a suspicious process creation as SYSTEM user (suspicious program or command line parameter)
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((IntegrityLevel == "System" OR IntegrityLevel == "S-1-16-16384") AND (contains(User, "AUTHORI") OR contains(User, "AUTORI"))) AND (((Image="*\\calc.exe" OR Image="*\\cscript.exe" OR Image="*\\forfiles.exe" OR Image="*\\hh.exe" OR Image="*\\mshta.exe" OR Image="*\\ping.exe" OR Image="*\\wscript.exe")) OR (CommandLine=regex("net\\s+user\\s+")) OR ((contains(CommandLine, " -NoP ") OR contains(CommandLine, " -W Hidden ") OR contains(CommandLine, " -decode ") OR contains(CommandLine, " /decode ") OR contains(CommandLine, " /urlcache ") OR contains(CommandLine, " -urlcache ") OR contains(CommandLine, " -e* JAB") OR contains(CommandLine, " -e* SUVYI") OR contains(CommandLine, " -e* SQBFAFgA") OR contains(CommandLine, " -e* aWV4I") OR contains(CommandLine, " -e* IAB") OR contains(CommandLine, " -e* PAA") OR contains(CommandLine, " -e* aQBlAHgA") OR contains(CommandLine, "vssadmin delete shadows") OR contains(CommandLine, "reg SAVE HKLM") OR contains(CommandLine, " -ma ") OR contains(CommandLine, "Microsoft\\Windows\\CurrentVersion\\Run") OR contains(CommandLine, ".downloadstring(") OR contains(CommandLine, ".downloadfile(") OR contains(CommandLine, " /ticket:") OR contains(CommandLine, "dpapi::") OR contains(CommandLine, "event::clear") OR contains(CommandLine, "event::drop") OR contains(CommandLine, "id::modify") OR contains(CommandLine, "kerberos::") OR contains(CommandLine, "lsadump::") OR contains(CommandLine, "misc::") OR contains(CommandLine, "privilege::") OR contains(CommandLine, "rpc::") OR contains(CommandLine, "sekurlsa::") OR contains(CommandLine, "sid::") OR contains(CommandLine, "token::") OR contains(CommandLine, "vault::cred") OR contains(CommandLine, "vault::list") OR contains(CommandLine, " p::d ") OR contains(CommandLine, ";iex(") OR contains(CommandLine, "MiniDump"))))) AND NOT (((contains(ParentImage, ":\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\")) OR ((contains(ParentImage, ":\\Program Files (x86)\\Java\\") OR contains(ParentImage, ":\\Program Files\\Java\\")) AND ParentImage="*\\bin\\javaws.exe" AND (contains(Image, ":\\Program Files (x86)\\Java\\") OR contains(Image, ":\\Program Files\\Java\\")) AND Image="*\\bin\\jp2launcher.exe" AND contains(CommandLine, " -ma ")) OR ((contains(CommandLine, "ping") AND contains(CommandLine, "127.0.0.1") AND contains(CommandLine, " -n "))) OR (Image="*\\PING.EXE" AND contains(ParentCommandLine, "\\DismFoDInstall.cmd")))))
