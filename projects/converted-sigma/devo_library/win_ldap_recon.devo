// Title: Potential Active Directory Reconnaissance/Enumeration Via LDAP
// ID: 31d68132-4038-47c7-8f8e-635a39a7c174
// Status: test
// Level: medium
// Author: Adeem Mawani
// Date: 2021-06-22
// Tags: attack.discovery, attack.t1069.002, attack.t1087.002, attack.t1482
// Description: Detects potential Active Directory enumeration via LDAP
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((EventID == "30" AND (contains(SearchFilter, "(groupType:1.2.840.113556.1.4.803:=2147483648)") OR contains(SearchFilter, "(groupType:1.2.840.113556.1.4.803:=2147483656)") OR contains(SearchFilter, "(groupType:1.2.840.113556.1.4.803:=2147483652)") OR contains(SearchFilter, "(groupType:1.2.840.113556.1.4.803:=2147483650)") OR contains(SearchFilter, "(sAMAccountType=805306369)") OR contains(SearchFilter, "(sAMAccountType=805306368)") OR contains(SearchFilter, "(sAMAccountType=536870913)") OR contains(SearchFilter, "(sAMAccountType=536870912)") OR contains(SearchFilter, "(sAMAccountType=268435457)") OR contains(SearchFilter, "(sAMAccountType=268435456)") OR contains(SearchFilter, "(objectCategory=groupPolicyContainer)") OR contains(SearchFilter, "(objectCategory=organizationalUnit)") OR contains(SearchFilter, "(objectCategory=nTDSDSA)") OR contains(SearchFilter, "(objectCategory=server)") OR contains(SearchFilter, "(objectCategory=domain)") OR contains(SearchFilter, "(objectCategory=person)") OR contains(SearchFilter, "(objectCategory=group)") OR contains(SearchFilter, "(objectCategory=user)") OR contains(SearchFilter, "(objectClass=trustedDomain)") OR contains(SearchFilter, "(objectClass=computer)") OR contains(SearchFilter, "(objectClass=server)") OR contains(SearchFilter, "(objectClass=group)") OR contains(SearchFilter, "(objectClass=user)") OR contains(SearchFilter, "(primaryGroupID=521)") OR contains(SearchFilter, "(primaryGroupID=516)") OR contains(SearchFilter, "(primaryGroupID=515)") OR contains(SearchFilter, "(primaryGroupID=512)") OR contains(SearchFilter, "Domain Admins") OR contains(SearchFilter, "objectGUID=\\*") OR contains(SearchFilter, "(schemaIDGUID=\\*)") OR contains(SearchFilter, "admincount=1"))) AND NOT ((EventID == "30" AND (contains(SearchFilter, "(domainSid=*)") OR contains(SearchFilter, "(objectSid=*)"))))) OR (EventID == "30" AND (contains(SearchFilter, "(userAccountControl:1.2.840.113556.1.4.803:=4194304)") OR contains(SearchFilter, "(userAccountControl:1.2.840.113556.1.4.803:=2097152)") OR contains(SearchFilter, "!(userAccountControl:1.2.840.113556.1.4.803:=1048574)") OR contains(SearchFilter, "(userAccountControl:1.2.840.113556.1.4.803:=524288)") OR contains(SearchFilter, "(userAccountControl:1.2.840.113556.1.4.803:=65536)") OR contains(SearchFilter, "(userAccountControl:1.2.840.113556.1.4.803:=8192)") OR contains(SearchFilter, "(userAccountControl:1.2.840.113556.1.4.803:=544)") OR contains(SearchFilter, "!(UserAccountControl:1.2.840.113556.1.4.803:=2)") OR contains(SearchFilter, "msDS-AllowedToActOnBehalfOfOtherIdentity") OR contains(SearchFilter, "msDS-AllowedToDelegateTo") OR contains(SearchFilter, "msDS-GroupManagedServiceAccount") OR contains(SearchFilter, "(accountExpires=9223372036854775807)") OR contains(SearchFilter, "(accountExpires=0)") OR contains(SearchFilter, "(adminCount=1)") OR contains(SearchFilter, "ms-MCS-AdmPwd"))) OR (EventID == "30" AND SearchFilter == "(objectclass=\\*)" AND (contains(DistinguishedName, "CN=Domain Admins") OR contains(DistinguishedName, "CN=Enterprise Admins") OR contains(DistinguishedName, "CN=Group Policy Creator Owners"))))
