// Title: Schedule Task Creation From Env Variable Or Potentially Suspicious Path Via Schtasks.EXE
// ID: 81325ce1-be01-4250-944f-b4789644556f
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-21
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects Schtask creations that point to a suspicious folder or an environment variable often used by malware
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((((contains(CommandLine, ":\\Perflogs") OR contains(CommandLine, ":\\Users\\All Users\\") OR contains(CommandLine, ":\\Users\\Default\\") OR contains(CommandLine, ":\\Users\\Public") OR contains(CommandLine, ":\\Windows\\Temp") OR contains(CommandLine, "\\AppData\\Local\\") OR contains(CommandLine, "\\AppData\\Roaming\\") OR contains(CommandLine, "%AppData%") OR contains(CommandLine, "%Public%"))) AND (Image="*\\schtasks.exe" AND contains(CommandLine, " /create "))) OR ((ParentCommandLine="*\\svchost.exe -k netsvcs -p -s Schedule") AND ((contains(CommandLine, ":\\Perflogs") OR contains(CommandLine, ":\\Windows\\Temp") OR contains(CommandLine, "\\Users\\Public") OR contains(CommandLine, "%Public%"))))) AND NOT ((((contains(CommandLine, "/Create /Xml ") AND contains(CommandLine, "\\Temp\\.CR.") AND contains(CommandLine, "\\Avira_Security_Installation.xml"))) OR ((contains(CommandLine, "/Create /F /TN") AND contains(CommandLine, "/Xml ") AND contains(CommandLine, "\\Temp\\") AND contains(CommandLine, "Avira_")) AND (contains(CommandLine, ".tmp\\UpdateFallbackTask.xml") OR contains(CommandLine, ".tmp\\WatchdogServiceControlManagerTimeout.xml") OR contains(CommandLine, ".tmp\\SystrayAutostart.xml") OR contains(CommandLine, ".tmp\\MaintenanceTask.xml"))) OR ((contains(CommandLine, "\\Temp\\") AND contains(CommandLine, "/Create /TN \"klcp_update\" /XML ") AND contains(CommandLine, "\\klcp_update_task.xml"))) OR ((contains(ParentCommandLine, "unattended.ini")) OR (contains(CommandLine, "update_task.xml"))) OR (contains(CommandLine, "/Create /TN TVInstallRestore /TR")))))
