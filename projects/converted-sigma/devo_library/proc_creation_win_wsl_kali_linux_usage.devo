// Title: WSL Kali-Linux Usage
// ID: 6f1a11aa-4b8a-4b7f-9e13-4d3e4ff0e0d4
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-10-10
// Tags: attack.stealth, attack.t1202
// Description: Detects the use of Kali Linux through Windows Subsystem for Linux
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((((contains(Image, ":\\Users\\") AND contains(Image, "\\AppData\\Local\\packages\\KaliLinux"))) OR ((contains(Image, ":\\Users\\") AND contains(Image, "\\AppData\\Local\\Microsoft\\WindowsApps\\kali.exe")))) OR (contains(Image, ":\\Program Files\\WindowsApps\\KaliLinux.") AND Image="*\\kali.exe")) OR (((((contains(Image, "\\kali.exe") OR contains(Image, "\\KaliLinux"))) OR ((contains(CommandLine, "Kali.exe") OR contains(CommandLine, "Kali-linux") OR contains(CommandLine, "kalilinux")))) AND ((ParentImage="*\\wsl.exe" OR ParentImage="*\\wslhost.exe"))) AND NOT (((contains(CommandLine, " -i ") OR contains(CommandLine, " --install ") OR contains(CommandLine, " --unregister "))))))
