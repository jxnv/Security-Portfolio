// Title: AppX Located in Known Staging Directory Added to Deployment Pipeline
// ID: 5cdeaf3d-1489-477c-95ab-c318559fc051
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-11
// Tags: attack.stealth
// Description: Detects an appx package that was added to the pipeline of the "to be processed" packages that is located in a known folder often used as a staging directory.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((EventID == "854") AND (((contains(Path, ":\\PerfLogs\\") OR contains(Path, ":\\Users\\Public\\") OR contains(Path, ":\\Windows\\Temp\\") OR contains(Path, "\\AppdData\\Local\\Temp\\") OR contains(Path, "\\Desktop\\") OR contains(Path, "\\Downloads\\"))) OR ((contains(Path, ":/Perflogs/") OR contains(Path, ":/Users/Public/") OR contains(Path, ":/Windows/Temp/") OR contains(Path, "/AppdData/Local/Temp/") OR contains(Path, "/Desktop/") OR contains(Path, "/Downloads/")))))
