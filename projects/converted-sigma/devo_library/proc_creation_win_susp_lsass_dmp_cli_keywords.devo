// Title: LSASS Dump Keyword In CommandLine
// ID: ffa6861c-4461-4f59-8a41-578c39f3f23e
// Status: test
// Level: high
// Author: E.M. Anhaus, Tony Lambert, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-10-24
// Tags: attack.credential-access, attack.t1003.001
// Description: Detects the presence of the keywords "lsass" and ".dmp" in the commandline, which could indicate a potential attempt to dump or create a dump of the lsass process.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "lsass.dmp") OR contains(CommandLine, "lsass.zip") OR contains(CommandLine, "lsass.rar") OR contains(CommandLine, "Andrew.dmp") OR contains(CommandLine, "Coredump.dmp") OR contains(CommandLine, "NotLSASS.zip") OR contains(CommandLine, "lsass_2") OR contains(CommandLine, "lsassdump") OR contains(CommandLine, "lsassdmp"))) OR ((contains(CommandLine, "lsass") AND contains(CommandLine, ".dmp"))) OR ((contains(CommandLine, "SQLDmpr") AND contains(CommandLine, ".mdmp"))) OR ((contains(CommandLine, "nanodump") AND contains(CommandLine, ".dmp"))))
