// Title: File Download Via Nscurl - MacOS
// ID: 6d8a7cf1-8085-423b-b87d-7e880faabbdf
// Status: test
// Level: medium
// Author: Daniel Cortez
// Date: 2024-06-04
// Tags: attack.command-and-control, attack.t1105
// Description: Detects the execution of the nscurl utility in order to download files.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (Image="*/nscurl" AND (contains(CommandLine, "--download ") OR contains(CommandLine, "--download-directory ") OR contains(CommandLine, "--output ") OR contains(CommandLine, "-dir ") OR contains(CommandLine, "-dl ") OR contains(CommandLine, "-ld") OR contains(CommandLine, "-o ")))
