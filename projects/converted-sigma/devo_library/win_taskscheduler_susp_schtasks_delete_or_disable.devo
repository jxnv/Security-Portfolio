// Title: Important Scheduled Task Deleted or Disabled
// ID: 9e3cb244-bdb8-4632-8c90-6079c8f4f16d
// Status: test
// Level: high
// Author: frack113
// Date: 2023-01-13
// Tags: attack.impact, attack.t1489
// Description: Detects when adversaries try to stop system services or processes by deleting or disabling their respective scheduled tasks in order to conduct data destructive activities
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((EventID == "141" OR EventID == "142") AND (contains(TaskName, "\\Windows\\SystemRestore\\SR") OR contains(TaskName, "\\Windows\\Windows Defender\\") OR contains(TaskName, "\\Windows\\BitLocker") OR contains(TaskName, "\\Windows\\WindowsBackup\\") OR contains(TaskName, "\\Windows\\WindowsUpdate\\") OR contains(TaskName, "\\Windows\\UpdateOrchestrator\\") OR contains(TaskName, "\\Windows\\ExploitGuard"))) AND NOT (((contains(UserName, "AUTHORI") OR contains(UserName, "AUTORI")))))
