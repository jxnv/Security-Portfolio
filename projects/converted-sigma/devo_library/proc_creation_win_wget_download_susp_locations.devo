// Title: Suspicious File Download From IP Via Wget.EXE - Paths
// ID: 40aa399c-7b02-4715-8e5f-73572b493f33
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-02-23
// Tags: attack.execution
// Description: Detects potentially suspicious file downloads directly from IP addresses and stored in suspicious locations using Wget.exe
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((CommandLine=regex("\\s-O\\s")) OR (contains(CommandLine, "--output-document"))) AND (contains(CommandLine, "http")) AND ((Image="*\\wget.exe") OR (OriginalFileName == "wget.exe")) AND (CommandLine=regex("://[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}")) AND (((contains(CommandLine, ":\\PerfLogs\\") OR contains(CommandLine, ":\\Temp\\") OR contains(CommandLine, ":\\Users\\Public\\") OR contains(CommandLine, ":\\Windows\\Help\\") OR contains(CommandLine, ":\\Windows\\Temp\\") OR contains(CommandLine, "\\Temporary Internet"))) OR ((contains(CommandLine, ":\\Users\\") AND contains(CommandLine, "\\Favorites\\"))) OR ((contains(CommandLine, ":\\Users\\") AND contains(CommandLine, "\\Favourites\\"))) OR ((contains(CommandLine, ":\\Users\\") AND contains(CommandLine, "\\Contacts\\"))) OR ((contains(CommandLine, ":\\Users\\") AND contains(CommandLine, "\\Pictures\\")))))
