// Title: Suspicious Mstsc.EXE Execution With Local RDP File
// ID: 6e22722b-dfb1-4508-a911-49ac840b40f8
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects potential RDP connection via Mstsc using a local ".rdp" file located in suspicious locations.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((CommandLine="*.rdp" OR CommandLine="*.rdp\"")) AND ((Image="*\\mstsc.exe") OR (OriginalFileName == "mstsc.exe")) AND ((contains(CommandLine, ":\\Users\\Public\\") OR contains(CommandLine, ":\\Windows\\System32\\spool\\drivers\\color") OR contains(CommandLine, ":\\Windows\\System32\\Tasks_Migrated ") OR contains(CommandLine, ":\\Windows\\Tasks\\") OR contains(CommandLine, ":\\Windows\\Temp\\") OR contains(CommandLine, ":\\Windows\\Tracing\\") OR contains(CommandLine, "\\AppData\\Local\\Temp\\") OR contains(CommandLine, "\\Downloads\\"))))
