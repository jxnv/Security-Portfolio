// Title: Recon Information for Export with PowerShell
// ID: a9723fcc-881c-424c-8709-fd61442ab3c3
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-07-30
// Tags: attack.collection, attack.t1119
// Description: Once established within a system or network, an adversary may use automated techniques for collecting internal data
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(ScriptBlockText, "Get-Service ") OR contains(ScriptBlockText, "Get-ChildItem ") OR contains(ScriptBlockText, "Get-Process "))) AND (contains(ScriptBlockText, "> $env:TEMP\\")))
