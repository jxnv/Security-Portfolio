// Title: PUA - Netcat Suspicious Execution
// ID: e31033fc-33f0-4020-9a16-faf9b31cbf08
// Status: test
// Level: high
// Author: frack113, Florian Roth (Nextron Systems)
// Date: 2021-07-21
// Tags: attack.command-and-control, attack.t1095
// Description: Detects execution of Netcat. Adversaries may use a non-application layer protocol for communication between host and C2 server or among infected hosts within a network
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, " -lvp ") OR contains(CommandLine, " -lvnp") OR contains(CommandLine, " -l -v -p ") OR contains(CommandLine, " -lv -p ") OR contains(CommandLine, " -l --proxy-type http ") OR contains(CommandLine, " -vnl --exec ") OR contains(CommandLine, " -vnl -e ") OR contains(CommandLine, " --lua-exec ") OR contains(CommandLine, " --sh-exec "))) OR ((Image="*\\nc.exe" OR Image="*\\ncat.exe" OR Image="*\\netcat.exe")))
