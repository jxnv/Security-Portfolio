// Title: New Connection Initiated To Potential Dead Drop Resolver Domain
// ID: 297ae038-edc2-4b2e-bb3e-7c5fc94dd5c7
// Status: test
// Level: high
// Author: Sorina Ionescu, X__Junior (Nextron Systems)
// Date: 2022-08-17
// Tags: attack.command-and-control, attack.t1102, attack.t1102.001
// Description: Detects an executable, which is not an internet browser or known application, initiating network connections to legit popular websites, which were seen to be used as dead drop resolvers in previous attacks.
// In this context attackers leverage known websites such as "facebook", "youtube", etc. In order to pass through undetected.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((Initiated == "true" AND (DestinationHostname="*.t.me" OR DestinationHostname="*0x0.st" OR DestinationHostname="*4shared.com" OR DestinationHostname="*abuse.ch" OR DestinationHostname="*anonfiles.com" OR DestinationHostname="*bashupload.com" OR DestinationHostname="*cdn.discordapp.com" OR DestinationHostname="*chunk.io" OR DestinationHostname="*cloudflare.com" OR DestinationHostname="*ddns.net" OR DestinationHostname="*discord.com" OR DestinationHostname="*docs.google.com" OR DestinationHostname="*drive.google.com" OR DestinationHostname="*dropbox.com" OR DestinationHostname="*dropmefiles.com" OR DestinationHostname="*facebook.com" OR DestinationHostname="*feeds.rapidfeeds.com" OR DestinationHostname="*fotolog.com" OR DestinationHostname="*ghostbin.co/" OR DestinationHostname="*githubusercontent.com" OR DestinationHostname="*gofile.io" OR DestinationHostname="*hastebin.com" OR DestinationHostname="*imgur.com" OR DestinationHostname="*livejournal.com" OR DestinationHostname="*mediafire.com" OR DestinationHostname="*mega.co.nz" OR DestinationHostname="*mega.nz" OR DestinationHostname="*onedrive.com" OR DestinationHostname="*pages.dev" OR DestinationHostname="*paste.ee" OR DestinationHostname="*pastebin.com" OR DestinationHostname="*pastebin.pl" OR DestinationHostname="*pastetext.net" OR DestinationHostname="*pixeldrain.com" OR DestinationHostname="*privatlab.com" OR DestinationHostname="*privatlab.net" OR DestinationHostname="*reddit.com" OR DestinationHostname="*send.exploit.in" OR DestinationHostname="*sendspace.com" OR DestinationHostname="*steamcommunity.com" OR DestinationHostname="*storage.googleapis.com" OR DestinationHostname="*technet.microsoft.com" OR DestinationHostname="*temp.sh" OR DestinationHostname="*transfer.sh" OR DestinationHostname="*trycloudflare.com" OR DestinationHostname="*twitter.com" OR DestinationHostname="*ufile.io" OR DestinationHostname="*vimeo.com" OR DestinationHostname="*w3spaces.com" OR DestinationHostname="*wetransfer.com" OR DestinationHostname="*workers.dev" OR DestinationHostname="*x0.at" OR DestinationHostname="*youtube.com")) AND NOT ((((Image="C:\\Program Files (x86)\\Avant Browser\\*" OR Image="C:\\Program Files\\Avant Browser\\*") AND Image="*\\avant.exe") OR (Image="C:\\Program Files\\BraveSoftware\\*" AND Image="*\\brave.exe") OR ((Image == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR Image == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR (Image="C:\\Users\\*" AND Image="*\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe") OR ((contains(Image, "C:\\Program Files\\Windows Defender Advanced Threat Protection\\") OR contains(Image, "C:\\Program Files\\Windows Defender\\") OR contains(Image, "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\")) AND (Image="*\\MsMpEng.exe" OR Image="*\\MsSense.exe")) OR (contains(Image, "\\AppData\\Local\\Discord\\") AND Image="*\\Discord.exe" AND (DestinationHostname="*discord.com" OR DestinationHostname="*cdn.discordapp.com")) OR ((Image="C:\\Program Files (x86)\\Dropbox\\Client\\*" OR Image="C:\\Program Files\\Dropbox\\Client\\*") AND (Image="*\\Dropbox.exe" OR Image="*\\DropboxInstaller.exe") AND DestinationHostname="*dropbox.com") OR ((Image="C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*") OR (Image="*\\WindowsApps\\MicrosoftEdge.exe") OR ((Image == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR Image == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((Image="C:\\Program Files (x86)\\Microsoft\\EdgeCore\\*" OR Image="C:\\Program Files\\Microsoft\\EdgeCore\\*") AND (Image="*\\msedge.exe" OR Image="*\\msedgewebview2.exe")) OR (Image == "") OR ((Image="C:\\Program Files\\Falkon\\*" OR Image="C:\\Program Files (x86)\\Falkon\\*") AND Image="*\\falkon.exe") OR ((Image == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR Image == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR (Image="C:\\Users\\*" AND Image="*\\AppData\\Local\\Mozilla Firefox\\firefox.exe") OR (contains(Image, "\\AppData\\Local\\Flock\\") AND Image="*\\Flock.exe") OR ((contains(Image, "C:\\Program Files\\Google\\Drive File Stream\\") OR contains(Image, "C:\\Program Files (x86)\\Google\\Drive File Stream\\")) AND Image="*GoogleDriveFS.exe" AND DestinationHostname="*drive.google.com") OR ((Image == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR Image == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (contains(Image, "\\AppData\\Local\\Maxthon\\") AND Image="*\\maxthon.exe") OR ((Image="*\\MEGAsync.exe" OR Image="*\\MEGAsyncSetup32_*RC.exe" OR Image="*\\MEGAsyncSetup32.exe" OR Image="*\\MEGAsyncSetup64.exe" OR Image="*\\MEGAupdater.exe") AND (DestinationHostname="*mega.co.nz" OR DestinationHostname="*mega.nz")) OR (contains(Image, "\\AppData\\Local\\Programs\\midori-ng\\") AND Image="*\\Midori Next Generation.exe") OR (NOT Image=*) OR (contains(Image, "\\AppData\\Local\\Microsoft\\OneDrive\\") AND Image="*\\OneDrive.exe" AND DestinationHostname="*onedrive.com") OR (contains(Image, "\\AppData\\Local\\Programs\\Opera\\") AND Image="*\\opera.exe") OR (contains(Image, "\\AppData\\Local\\Phoebe\\") AND Image="*\\Phoebe.exe") OR ((Image="*C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe" OR Image="*C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe")) OR ((Image="C:\\Program Files (x86)\\QtWeb\\*" OR Image="C:\\Program Files\\QtWeb\\*") AND Image="*\\QtWeb.exe") OR ((contains(Image, "C:\\Program Files (x86)\\Safari\\") OR contains(Image, "C:\\Program Files\\Safari\\")) AND Image="*\\safari.exe") OR ((Image="C:\\Program Files\\SeaMonkey\\*" OR Image="C:\\Program Files (x86)\\SeaMonkey\\*") AND Image="*\\seamonkey.exe") OR ((Image="C:\\Program Files\\SlimBrowser\\*" OR Image="C:\\Program Files (x86)\\SlimBrowser\\*") AND Image="*\\slimbrowser.exe") OR (contains(Image, "\\AppData\\Roaming\\Telegram Desktop\\") AND Image="*\\Telegram.exe" AND DestinationHostname="*.t.me") OR (contains(Image, "\\AppData\\Local\\Vivaldi\\") AND Image="*\\vivaldi.exe") OR ((Image="C:\\Program Files\\Naver\\Naver Whale\\*" OR Image="C:\\Program Files (x86)\\Naver\\Naver Whale\\*") AND Image="*\\whale.exe") OR ((Image="C:\\Program Files\\Waterfox\\*" OR Image="C:\\Program Files (x86)\\Waterfox\\*") AND Image="*\\Waterfox.exe") OR ((Image="C:\\Program Files (x86)\\WindowsApps\\*" OR Image="C:\\Program Files\\WindowsApps\\*") AND Image="*\\WhatsApp.exe" AND DestinationHostname="*facebook.com"))))
