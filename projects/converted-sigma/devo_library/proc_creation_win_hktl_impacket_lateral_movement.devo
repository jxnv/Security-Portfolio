// Title: HackTool - Potential Impacket Lateral Movement Activity
// ID: 10c14723-61c7-4c75-92ca-9af245723ad2
// Status: stable
// Level: high
// Author: Ecco, oscd.community, Jonhnathan Ribeiro, Tim Rauch
// Date: 2019-09-03
// Tags: attack.execution, attack.t1047, attack.lateral-movement, attack.t1021.003
// Description: Detects wmiexec/dcomexec/atexec/smbexec from Impacket framework
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(ParentCommandLine, "svchost.exe -k netsvcs") OR contains(ParentCommandLine, "taskeng.exe")) AND (contains(CommandLine, "cmd.exe") AND contains(CommandLine, "/C") AND contains(CommandLine, "Windows\\Temp\\") AND contains(CommandLine, "&1"))) OR ((ParentImage="*\\wmiprvse.exe" OR ParentImage="*\\mmc.exe" OR ParentImage="*\\explorer.exe" OR ParentImage="*\\services.exe") AND (contains(CommandLine, "cmd.exe") AND contains(CommandLine, "/Q") AND contains(CommandLine, "/c") AND contains(CommandLine, "\\\\\\\\127.0.0.1\\\\") AND contains(CommandLine, "&1"))))
