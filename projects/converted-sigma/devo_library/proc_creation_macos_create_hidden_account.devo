// Title: Hidden User Creation
// ID: b22a5b36-2431-493a-8be1-0bae56c28ef3
// Status: test
// Level: medium
// Author: Daniil Yugoslavskiy, oscd.community
// Date: 2020-10-10
// Tags: attack.stealth, attack.t1564.002
// Description: Detects creation of a hidden user account on macOS (UserID < 500) or with IsHidden option
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((Image="*/dscl" AND contains(CommandLine, "create")) AND (contains(CommandLine, "UniqueID") AND CommandLine=regex("([0-9]|[1-9][0-9]|[1-4][0-9]{2})"))) OR ((Image="*/dscl" AND contains(CommandLine, "create")) AND ((contains(CommandLine, "IsHidden")) AND ((contains(CommandLine, "true") OR contains(CommandLine, "yes") OR contains(CommandLine, "1"))))))
