// Title: Potential CommandLine Path Traversal Via Cmd.EXE
// ID: 087790e3-3287-436c-bccf-cbd0184a7db1
// Status: test
// Level: high
// Author: xknow @xknow_infosec, Tim Shelton
// Date: 2020-06-11
// Tags: attack.execution, attack.t1059.003
// Description: Detects potential path traversal attempt via cmd.exe. Could indicate possible command/argument confusion/hijacking
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((((contains(ParentCommandLine, "/c") OR contains(ParentCommandLine, "/k") OR contains(ParentCommandLine, "/r"))) OR ((contains(CommandLine, "/c") OR contains(CommandLine, "/k") OR contains(CommandLine, "/r")))) AND ((ParentImage="*\\cmd.exe") OR (Image="*\\cmd.exe") OR (OriginalFileName == "cmd.exe")) AND ((ParentCommandLine == "/../../") OR (contains(CommandLine, "/../../")))) AND NOT ((contains(CommandLine, "\\Tasktop\\keycloak\\bin\\/../../jre\\bin\\java"))))
