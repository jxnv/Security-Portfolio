// Title: PUA - Restic Backup Tool Execution
// ID: 6ddff2e8-ea1a-45d0-8938-93dfc1d67ae7
// Status: experimental
// Level: high
// Author: Nounou Mbeiri, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-10-17
// Tags: attack.exfiltration, attack.t1048, attack.t1567.002
// Description: Detects the execution of the Restic backup tool, which can be used for data exfiltration.
// Threat actors may leverage Restic to back up and exfiltrate sensitive data to remote storage locations, including cloud services.
// If not legitimately used in the enterprise environment, its presence may indicate malicious activity.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "sftp:") OR contains(CommandLine, "rest:http") OR contains(CommandLine, "s3:s3.") OR contains(CommandLine, "s3.http") OR contains(CommandLine, "azure:") OR contains(CommandLine, " gs:") OR contains(CommandLine, "rclone:") OR contains(CommandLine, "swift:") OR contains(CommandLine, " b2:")) AND (contains(CommandLine, " init ") AND contains(CommandLine, " -r "))) OR (((contains(CommandLine, "--password-file") AND contains(CommandLine, "init") AND contains(CommandLine, " -r "))) OR ((contains(CommandLine, "--use-fs-snapshot") AND contains(CommandLine, "backup") AND contains(CommandLine, " -r ")))))
