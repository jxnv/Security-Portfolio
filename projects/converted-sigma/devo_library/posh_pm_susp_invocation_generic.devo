// Title: Suspicious PowerShell Invocations - Generic - PowerShell Module
// ID: bbb80e91-5746-4fbe-8898-122e2cafdbf4
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2017-03-12
// Tags: attack.execution, attack.t1059.001
// Description: Detects suspicious PowerShell invocation command parameters
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(ContextInfo, " -enc ") OR contains(ContextInfo, " -EncodedCommand ") OR contains(ContextInfo, " -ec "))) AND ((contains(ContextInfo, " -w hidden ") OR contains(ContextInfo, " -window hidden ") OR contains(ContextInfo, " -windowstyle hidden ") OR contains(ContextInfo, " -w 1 "))) AND ((contains(ContextInfo, " -noni ") OR contains(ContextInfo, " -noninteractive "))))
