// Title: Monero Crypto Coin Mining Pool Lookup
// ID: b593fd50-7335-4682-a36c-4edcb68e4641
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-10-24
// Tags: attack.impact, attack.t1496, attack.exfiltration, attack.t1567
// Description: Detects suspicious DNS queries to Monero mining pools
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(query, "pool.minexmr.com") OR contains(query, "fr.minexmr.com") OR contains(query, "de.minexmr.com") OR contains(query, "sg.minexmr.com") OR contains(query, "ca.minexmr.com") OR contains(query, "us-west.minexmr.com") OR contains(query, "pool.supportxmr.com") OR contains(query, "mine.c3pool.com") OR contains(query, "xmr-eu1.nanopool.org") OR contains(query, "xmr-eu2.nanopool.org") OR contains(query, "xmr-us-east1.nanopool.org") OR contains(query, "xmr-us-west1.nanopool.org") OR contains(query, "xmr-asia1.nanopool.org") OR contains(query, "xmr-jp1.nanopool.org") OR contains(query, "xmr-au1.nanopool.org") OR contains(query, "xmr.2miners.com") OR contains(query, "xmr.hashcity.org") OR contains(query, "xmr.f2pool.com") OR contains(query, "xmrpool.eu") OR contains(query, "pool.hashvault.pro")))
