// Title: Private Keys Reconnaissance Via CommandLine Tools
// ID: 213d6a77-3d55-4ce8-ba74-fcfef741974e
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-07-20
// Tags: attack.credential-access, attack.t1552.004
// Description: Adversaries may search for private key certificate files on compromised systems for insecurely stored credential
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, ".key") OR contains(CommandLine, ".pgp") OR contains(CommandLine, ".gpg") OR contains(CommandLine, ".ppk") OR contains(CommandLine, ".p12") OR contains(CommandLine, ".pem") OR contains(CommandLine, ".pfx") OR contains(CommandLine, ".cer") OR contains(CommandLine, ".p7b") OR contains(CommandLine, ".asc"))) AND (((contains(CommandLine, "dir ")) AND ((Image="*\\cmd.exe") OR (OriginalFileName == "Cmd.Exe"))) OR ((contains(CommandLine, "Get-ChildItem ")) AND (((Image="*\\powershell.exe" OR Image="*\\pwsh.exe")) OR ((OriginalFileName == "PowerShell.EXE" OR OriginalFileName == "pwsh.dll")))) OR ((Image="*\\findstr.exe") OR (OriginalFileName == "FINDSTR.EXE"))))
