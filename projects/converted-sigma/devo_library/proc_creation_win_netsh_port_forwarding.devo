// Title: New Port Forwarding Rule Added Via Netsh.EXE
// ID: 322ed9ec-fcab-4f67-9a34-e7c6aef43614
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), omkar72, oscd.community, Swachchhanda Shrawan Poudel
// Date: 2019-01-29
// Tags: attack.lateral-movement, attack.command-and-control, attack.t1090
// Description: Detects the execution of netsh commands that configure a new port forwarding (PortProxy) rule
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((Image="*\\netsh.exe") OR (OriginalFileName == "netsh.exe")) AND (((contains(CommandLine, "interface") AND contains(CommandLine, "portproxy") AND contains(CommandLine, "add") AND contains(CommandLine, "v4tov4"))) OR ((contains(CommandLine, "i ") AND contains(CommandLine, "p ") AND contains(CommandLine, "a ") AND contains(CommandLine, "v "))) OR ((contains(CommandLine, "connectp") AND contains(CommandLine, "listena") AND contains(CommandLine, "c=")))))
