// Title: Invoke-Obfuscation Via Use MSHTA - PowerShell
// ID: e55a5195-4724-480e-a77e-3ebe64bd3759
// Status: test
// Level: high
// Author: Nikita Nazarov, oscd.community
// Date: 2020-10-08
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via use MSHTA in Scripts
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(ScriptBlockText, "set") AND contains(ScriptBlockText, "&&") AND contains(ScriptBlockText, "mshta") AND contains(ScriptBlockText, "vbscript:createobject") AND contains(ScriptBlockText, ".run") AND contains(ScriptBlockText, "(window.close)")))
