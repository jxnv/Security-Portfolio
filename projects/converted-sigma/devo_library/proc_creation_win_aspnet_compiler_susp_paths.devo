// Title: Potentially Suspicious ASP.NET Compilation Via AspNetCompiler
// ID: 9f50fe98-fe5c-4a2d-86c7-fad7f63ed622
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-08-14
// Tags: attack.execution, attack.stealth, attack.t1127
// Description: Detects execution of "aspnet_compiler.exe" with potentially suspicious paths for compilation.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(Image, ":\\Windows\\Microsoft.NET\\Framework\\") OR contains(Image, ":\\Windows\\Microsoft.NET\\Framework64\\") OR contains(Image, ":\\Windows\\Microsoft.NET\\FrameworkArm\\") OR contains(Image, ":\\Windows\\Microsoft.NET\\FrameworkArm64\\")) AND Image="*\\aspnet_compiler.exe" AND (contains(CommandLine, "\\Users\\Public\\") OR contains(CommandLine, "\\AppData\\Local\\Temp\\") OR contains(CommandLine, "\\AppData\\Local\\Roaming\\") OR contains(CommandLine, ":\\Temp\\") OR contains(CommandLine, ":\\Windows\\Temp\\") OR contains(CommandLine, ":\\Windows\\System32\\Tasks\\") OR contains(CommandLine, ":\\Windows\\Tasks\\")))
