// Title: Diskshadow Script Mode - Execution From Potential Suspicious Location
// ID: fa1a7e52-3d02-435b-81b8-00da14dd66c1
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-09-15
// Tags: attack.stealth, attack.t1218
// Description: Detects execution of "Diskshadow.exe" in script mode using the "/s" flag where the script is located in a potentially suspicious location.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "-s ") OR contains(CommandLine, "/s "))) AND ((OriginalFileName == "diskshadow.exe") OR (Image="*\\diskshadow.exe")) AND ((contains(CommandLine, ":\\Temp\\") OR contains(CommandLine, ":\\Windows\\Temp\\") OR contains(CommandLine, "\\AppData\\Local\\") OR contains(CommandLine, "\\AppData\\Roaming\\") OR contains(CommandLine, "\\ProgramData\\") OR contains(CommandLine, "\\Users\\Public\\"))))
