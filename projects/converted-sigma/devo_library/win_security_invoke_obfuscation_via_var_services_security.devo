// Title: Invoke-Obfuscation VAR++ LAUNCHER OBFUSCATION - Security
// ID: 4c54ba8f-73d2-4d40-8890-d9cf1dca3d30
// Status: test
// Level: high
// Author: Timur Zinniatullin, oscd.community
// Date: 2020-10-13
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via VAR++ LAUNCHER
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (EventID == "4697" AND (contains(ServiceFileName, "&&set") AND contains(ServiceFileName, "cmd") AND contains(ServiceFileName, "/c") AND contains(ServiceFileName, "-f")) AND (contains(ServiceFileName, "{0}") OR contains(ServiceFileName, "{1}") OR contains(ServiceFileName, "{2}") OR contains(ServiceFileName, "{3}") OR contains(ServiceFileName, "{4}") OR contains(ServiceFileName, "{5}")))
