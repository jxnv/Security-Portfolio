// Title: HackTool - SharPersist Execution
// ID: 26488ad0-f9fd-4536-876f-52fea846a2e4
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-09-15
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053
// Description: Detects the execution of the hacktool SharPersist - used to deploy various different kinds of persistence mechanisms
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, " -t schtask -c ") OR contains(CommandLine, " -t startupfolder -c "))) OR ((contains(CommandLine, " -t reg -c ") AND contains(CommandLine, " -m add"))) OR ((contains(CommandLine, " -t service -c ") AND contains(CommandLine, " -m add"))) OR ((contains(CommandLine, " -t schtask -c ") AND contains(CommandLine, " -m add"))) OR ((Image="*\\SharPersist.exe") OR (Product == "SharPersist")))
