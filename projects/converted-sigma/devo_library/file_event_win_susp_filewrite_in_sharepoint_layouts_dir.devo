// Title: Suspicious File Write to SharePoint Layouts Directory
// ID: 1f0489be-b496-4ddf-b3a9-5900f2044e9c
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-07-24
// Tags: attack.initial-access, attack.t1190, attack.persistence, attack.t1505.003
// Description: Detects suspicious file writes to SharePoint layouts directory which could indicate webshell activity or post-exploitation.
// This behavior has been observed in the exploitation of SharePoint vulnerabilities such as CVE-2025-49704, CVE-2025-49706 or CVE-2025-53770.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((Image="*\\cmd.exe" OR Image="*\\powershell_ise.exe" OR Image="*\\powershell.exe" OR Image="*\\pwsh.exe" OR Image="*\\w3wp.exe") AND (TargetFilename="C:\\Program Files\\Common Files\\Microsoft Shared\\Web Server Extensions\\*" OR TargetFilename="C:\\Program Files (x86)\\Common Files\\Microsoft Shared\\Web Server Extensions\\*") AND (contains(TargetFilename, "\\15\\TEMPLATE\\LAYOUTS\\") OR contains(TargetFilename, "\\16\\TEMPLATE\\LAYOUTS\\")) AND (TargetFilename="*.asax" OR TargetFilename="*.ascx" OR TargetFilename="*.ashx" OR TargetFilename="*.asmx" OR TargetFilename="*.asp" OR TargetFilename="*.aspx" OR TargetFilename="*.bat" OR TargetFilename="*.cmd" OR TargetFilename="*.cer" OR TargetFilename="*.config" OR TargetFilename="*.hta" OR TargetFilename="*.js" OR TargetFilename="*.jsp" OR TargetFilename="*.jspx" OR TargetFilename="*.php" OR TargetFilename="*.ps1" OR TargetFilename="*.vbs"))
