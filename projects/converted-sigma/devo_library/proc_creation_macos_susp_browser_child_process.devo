// Title: Suspicious Browser Child Process - MacOS
// ID: 0250638a-2b28-4541-86fc-ea4c558fa0c6
// Status: test
// Level: medium
// Author: Sohan G (D4rkCiph3r)
// Date: 2023-04-05
// Tags: attack.initial-access, attack.execution, attack.t1189, attack.t1203, attack.t1059
// Description: Detects suspicious child processes spawned from browsers. This could be a result of a potential web browser exploitation.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(ParentImage, "com.apple.WebKit.WebContent") OR contains(ParentImage, "firefox") OR contains(ParentImage, "Google Chrome Helper") OR contains(ParentImage, "Google Chrome") OR contains(ParentImage, "Microsoft Edge") OR contains(ParentImage, "Opera") OR contains(ParentImage, "Safari") OR contains(ParentImage, "Tor Browser")) AND (Image="*/bash" OR Image="*/curl" OR Image="*/dash" OR Image="*/ksh" OR Image="*/osascript" OR Image="*/perl" OR Image="*/php" OR Image="*/pwsh" OR Image="*/python" OR Image="*/sh" OR Image="*/tcsh" OR Image="*/wget" OR Image="*/zsh")) AND NOT ((((contains(ParentImage, "Google Chrome Helper") OR contains(ParentImage, "Google Chrome")) AND (contains(CommandLine, "/Volumes/Google Chrome/Google Chrome.app/Contents/Frameworks/*/Resources/install.sh") OR contains(CommandLine, "/Applications/Google Chrome.app/Contents/Frameworks/Google Chrome Framework.framework/*/Resources/keystone_promote_preflight.sh") OR contains(CommandLine, "/Applications/Google Chrome.app/Contents/Frameworks/Google Chrome Framework.framework/*/Resources/keystone_promote_postflight.sh"))) OR ((contains(ParentImage, "Google Chrome Helper") OR contains(ParentImage, "Google Chrome")) AND (contains(CommandLine, "/Users/") AND contains(CommandLine, "/Library/Application Support/Google/Chrome/recovery/") AND contains(CommandLine, "/ChromeRecovery"))) OR (contains(CommandLine, "--defaults-torrc")) OR (contains(CommandLine, "/Library/Application Support/Microsoft/MAU*/Microsoft AutoUpdate.app/Contents/MacOS/msupdate")) OR (contains(ParentImage, "Microsoft Edge") AND (contains(CommandLine, "IOPlatformExpertDevice") OR contains(CommandLine, "hw.model"))))) AND NOT (((CommandLine == "") OR (NOT CommandLine=*))))
