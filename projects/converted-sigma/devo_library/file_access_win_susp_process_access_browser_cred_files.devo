// Title: Suspicious File Access to Browser Credential Storage
// ID: a1dfd976-4852-41d4-9507-dc6590a3ccd0
// Status: experimental
// Level: low
// Author: frack113, X__Junior (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems), Parth-FourCore
// Date: 2025-05-22
// Tags: attack.credential-access, attack.t1555.003, attack.discovery, attack.t1217
// Description: Detects file access to browser credential storage paths by non-browser processes, which may indicate credential access attempts.
// Adversaries may attempt to access browser credential storage to extract sensitive information such as usernames and passwords or cookies.
// This behavior is often commonly observed in credential stealing malware.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((contains(FileName, "\\Sputnik\\Sputnik") OR contains(FileName, "\\MapleStudio\\ChromePlus") OR contains(FileName, "\\QIP Surf") OR contains(FileName, "\\BlackHawk") OR contains(FileName, "\\7Star\\7Star") OR contains(FileName, "\\CatalinaGroup\\Citrio") OR contains(FileName, "\\Google\\Chrome") OR contains(FileName, "\\Coowon\\Coowon") OR contains(FileName, "\\CocCoc\\Browser") OR contains(FileName, "\\uCozMedia\\Uran") OR contains(FileName, "\\Tencent\\QQBrowser") OR contains(FileName, "\\Orbitum") OR contains(FileName, "\\Slimjet") OR contains(FileName, "\\Iridium") OR contains(FileName, "\\Vivaldi") OR contains(FileName, "\\Chromium") OR contains(FileName, "\\GhostBrowser") OR contains(FileName, "\\CentBrowser") OR contains(FileName, "\\Xvast") OR contains(FileName, "\\Chedot") OR contains(FileName, "\\SuperBird") OR contains(FileName, "\\360Browser\\Browser") OR contains(FileName, "\\360Chrome\\Chrome") OR contains(FileName, "\\Comodo\\Dragon") OR contains(FileName, "\\BraveSoftware\\Brave-Browser") OR contains(FileName, "\\Torch") OR contains(FileName, "\\UCBrowser\\") OR contains(FileName, "\\Blisk") OR contains(FileName, "\\Epic Privacy Browser") OR contains(FileName, "\\Nichrome") OR contains(FileName, "\\Amigo") OR contains(FileName, "\\Kometa") OR contains(FileName, "\\Xpom") OR contains(FileName, "\\Microsoft\\Edge") OR contains(FileName, "\\Liebao7Default\\EncryptedStorage") OR contains(FileName, "\\AVAST Software\\Browser") OR contains(FileName, "\\Kinza") OR contains(FileName, "\\Mozilla\\SeaMonkey\\") OR contains(FileName, "\\Comodo\\IceDragon\\") OR contains(FileName, "\\8pecxstudios\\Cyberfox\\") OR contains(FileName, "\\FlashPeak\\SlimBrowser\\") OR contains(FileName, "\\Moonchild Productions\\Pale Moon\\"))) AND ((contains(FileName, "\\Profiles\\") OR contains(FileName, "\\User Data"))) AND (((contains(FileName, "\\Login Data") OR contains(FileName, "\\Cookies") OR contains(FileName, "\\EncryptedStorage") OR contains(FileName, "\\WebCache\\"))) OR ((FileName="*cert9.db" OR FileName="*cookies.sqlite" OR FileName="*formhistory.sqlite" OR FileName="*key3.db" OR FileName="*key4.db" OR FileName="*Login Data.sqlite" OR FileName="*logins.json" OR FileName="*places.sqlite")))) AND NOT ((((Image="C:\\Program Files\\*" OR Image="C:\\Program Files (x86)\\*" OR Image="C:\\Windows\\System32\\*" OR Image="C:\\Windows\\SysWOW64\\*")) OR ((Image="*\\Sputnik.exe" OR Image="*\\ChromePlus.exe" OR Image="*\\QIP Surf.exe" OR Image="*\\BlackHawk.exe" OR Image="*\\7Star.exe" OR Image="*\\Sleipnir5.exe" OR Image="*\\Citrio.exe" OR Image="*\\Chrome SxS.exe" OR Image="*\\Chrome.exe" OR Image="*\\Coowon.exe" OR Image="*\\CocCocBrowser.exe" OR Image="*\\Uran.exe" OR Image="*\\QQBrowser.exe" OR Image="*\\Orbitum.exe" OR Image="*\\Slimjet.exe" OR Image="*\\Iridium.exe" OR Image="*\\Vivaldi.exe" OR Image="*\\Chromium.exe" OR Image="*\\GhostBrowser.exe" OR Image="*\\CentBrowser.exe" OR Image="*\\Xvast.exe" OR Image="*\\Chedot.exe" OR Image="*\\SuperBird.exe" OR Image="*\\360Browser.exe" OR Image="*\\360Chrome.exe" OR Image="*\\dragon.exe" OR Image="*\\brave.exe" OR Image="*\\torch.exe" OR Image="*\\UCBrowser.exe" OR Image="*\\BliskBrowser.exe" OR Image="*\\Epic Privacy Browser.exe" OR Image="*\\nichrome.exe" OR Image="*\\AmigoBrowser.exe" OR Image="*\\KometaBrowser.exe" OR Image="*\\XpomBrowser.exe" OR Image="*\\msedge.exe" OR Image="*\\LiebaoBrowser.exe" OR Image="*\\AvastBrowser.exe" OR Image="*\\Kinza.exe" OR Image="*\\seamonkey.exe" OR Image="*\\icedragon.exe" OR Image="*\\cyberfox.exe" OR Image="*\\SlimBrowser.exe" OR Image="*\\palemoon.exe")) OR ((contains(Image, "\\Sputnik\\") OR contains(Image, "\\MapleStudio\\") OR contains(Image, "\\QIP Surf\\") OR contains(Image, "\\BlackHawk\\") OR contains(Image, "\\7Star\\") OR contains(Image, "\\Fenrir Inc\\") OR contains(Image, "\\CatalinaGroup\\") OR contains(Image, "\\Google\\") OR contains(Image, "\\Coowon\\") OR contains(Image, "\\CocCoc\\") OR contains(Image, "\\uCozMedia\\") OR contains(Image, "\\Tencent\\") OR contains(Image, "\\Orbitum\\") OR contains(Image, "\\Slimjet\\") OR contains(Image, "\\Iridium\\") OR contains(Image, "\\Vivaldi\\") OR contains(Image, "\\Chromium\\") OR contains(Image, "\\GhostBrowser\\") OR contains(Image, "\\CentBrowser\\") OR contains(Image, "\\Xvast\\") OR contains(Image, "\\Chedot\\") OR contains(Image, "\\SuperBird\\") OR contains(Image, "\\360Browser\\") OR contains(Image, "\\360Chrome\\") OR contains(Image, "\\Comodo\\") OR contains(Image, "\\BraveSoftware\\") OR contains(Image, "\\Torch\\") OR contains(Image, "\\UCBrowser\\") OR contains(Image, "\\Blisk\\") OR contains(Image, "\\Epic Privacy Browser\\") OR contains(Image, "\\Nichrome\\") OR contains(Image, "\\Amigo\\") OR contains(Image, "\\Kometa\\") OR contains(Image, "\\Xpom\\") OR contains(Image, "\\Microsoft\\") OR contains(Image, "\\Liebao7\\") OR contains(Image, "\\AVAST Software\\") OR contains(Image, "\\Kinza\\") OR contains(Image, "\\Mozilla\\") OR contains(Image, "\\8pecxstudios\\") OR contains(Image, "\\FlashPeak\\") OR contains(Image, "\\Moonchild Productions\\"))) OR (Image == "System" AND ParentImage == "Idle"))) AND NOT (((contains(Image, "\\Microsoft\\Windows Defender\\") AND (Image="*\\MpCopyAccelerator.exe" OR Image="*\\MsMpEng.exe")) OR (ParentImage == "C:\\Windows\\System32\\msiexec.exe") OR (Image="*\\everything.exe") OR ((Image="*\\thor.exe" OR Image="*\\thor64.exe")))))
