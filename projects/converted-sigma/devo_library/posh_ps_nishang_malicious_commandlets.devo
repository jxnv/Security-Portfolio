// Title: Malicious Nishang PowerShell Commandlets
// ID: f772cee9-b7c2-4cb2-8f07-49870adc02e0
// Status: test
// Level: high
// Author: Alec Costello
// Date: 2019-05-16
// Tags: attack.execution, attack.t1059.001
// Description: Detects Commandlet names and arguments from the Nishang exploitation framework
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(ScriptBlockText, "Add-ConstrainedDelegationBackdoor") OR contains(ScriptBlockText, "Copy-VSS") OR contains(ScriptBlockText, "Create-MultipleSessions") OR contains(ScriptBlockText, "DataToEncode") OR contains(ScriptBlockText, "DNS_TXT_Pwnage") OR contains(ScriptBlockText, "Do-Exfiltration-Dns") OR contains(ScriptBlockText, "Download_Execute") OR contains(ScriptBlockText, "Download-Execute-PS") OR contains(ScriptBlockText, "DownloadAndExtractFromRemoteRegistry") OR contains(ScriptBlockText, "DumpCerts") OR contains(ScriptBlockText, "DumpCreds") OR contains(ScriptBlockText, "DumpHashes") OR contains(ScriptBlockText, "Enable-DuplicateToken") OR contains(ScriptBlockText, "Enable-Duplication") OR contains(ScriptBlockText, "Execute-Command-MSSQL") OR contains(ScriptBlockText, "Execute-DNSTXT-Code") OR contains(ScriptBlockText, "Execute-OnTime") OR contains(ScriptBlockText, "ExetoText") OR contains(ScriptBlockText, "exfill") OR contains(ScriptBlockText, "ExfilOption") OR contains(ScriptBlockText, "FakeDC") OR contains(ScriptBlockText, "FireBuster") OR contains(ScriptBlockText, "FireListener") OR contains(ScriptBlockText, "Get-Information ") OR contains(ScriptBlockText, "Get-PassHints") OR contains(ScriptBlockText, "Get-Web-Credentials") OR contains(ScriptBlockText, "Get-WebCredentials") OR contains(ScriptBlockText, "Get-WLAN-Keys") OR contains(ScriptBlockText, "HTTP-Backdoor") OR contains(ScriptBlockText, "Invoke-AmsiBypass") OR contains(ScriptBlockText, "Invoke-BruteForce") OR contains(ScriptBlockText, "Invoke-CredentialsPhish") OR contains(ScriptBlockText, "Invoke-Decode") OR contains(ScriptBlockText, "Invoke-Encode") OR contains(ScriptBlockText, "Invoke-Interceptor") OR contains(ScriptBlockText, "Invoke-JSRatRegsvr") OR contains(ScriptBlockText, "Invoke-JSRatRundll") OR contains(ScriptBlockText, "Invoke-MimikatzWDigestDowngrade") OR contains(ScriptBlockText, "Invoke-NetworkRelay") OR contains(ScriptBlockText, "Invoke-PowerShellIcmp") OR contains(ScriptBlockText, "Invoke-PowerShellUdp") OR contains(ScriptBlockText, "Invoke-Prasadhak") OR contains(ScriptBlockText, "Invoke-PSGcat") OR contains(ScriptBlockText, "Invoke-PsGcatAgent") OR contains(ScriptBlockText, "Invoke-SessionGopher") OR contains(ScriptBlockText, "Invoke-SSIDExfil") OR contains(ScriptBlockText, "LoggedKeys") OR contains(ScriptBlockText, "Nishang") OR contains(ScriptBlockText, "NotAllNameSpaces") OR contains(ScriptBlockText, "Out-CHM") OR contains(ScriptBlockText, "OUT-DNSTXT") OR contains(ScriptBlockText, "Out-HTA") OR contains(ScriptBlockText, "Out-RundllCommand") OR contains(ScriptBlockText, "Out-SCF") OR contains(ScriptBlockText, "Out-SCT") OR contains(ScriptBlockText, "Out-Shortcut") OR contains(ScriptBlockText, "Out-WebQuery") OR contains(ScriptBlockText, "Out-Word") OR contains(ScriptBlockText, "Parse_Keys") OR contains(ScriptBlockText, "Password-List") OR contains(ScriptBlockText, "Powerpreter") OR contains(ScriptBlockText, "Remove-Persistence") OR contains(ScriptBlockText, "Remove-PoshRat") OR contains(ScriptBlockText, "Remove-Update") OR contains(ScriptBlockText, "Run-EXEonRemote") OR contains(ScriptBlockText, "Set-DCShadowPermissions") OR contains(ScriptBlockText, "Set-RemotePSRemoting") OR contains(ScriptBlockText, "Set-RemoteWMI") OR contains(ScriptBlockText, "Shellcode32") OR contains(ScriptBlockText, "Shellcode64") OR contains(ScriptBlockText, "StringtoBase64") OR contains(ScriptBlockText, "TexttoExe")))
