// Title: Suspicious DLL Loaded via CertOC.EXE
// ID: 84232095-ecca-4015-b0d7-7726507ee793
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-15
// Tags: attack.stealth, attack.t1218
// Description: Detects when a user installs certificates by using CertOC.exe to load the target DLL file.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(CommandLine, " -LoadDLL ")) AND ((Image="*\\certoc.exe") OR (OriginalFileName == "CertOC.exe")) AND ((contains(CommandLine, "\\Appdata\\Local\\Temp\\") OR contains(CommandLine, "\\Desktop\\") OR contains(CommandLine, "\\Downloads\\") OR contains(CommandLine, "\\Users\\Public\\") OR contains(CommandLine, "C:\\Windows\\Tasks\\") OR contains(CommandLine, "C:\\Windows\\Temp\\"))))
