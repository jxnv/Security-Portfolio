// Title: Enumeration for 3rd Party Creds From CLI
// ID: 87a476dc-0079-4583-a985-dee7a20a03de
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-20
// Tags: attack.credential-access, attack.t1552.002
// Description: Detects processes that query known 3rd party registry keys that holds credentials via commandline
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "\\Software\\Aerofox\\Foxmail\\V3.1") OR contains(CommandLine, "\\Software\\Aerofox\\FoxmailPreview") OR contains(CommandLine, "\\Software\\DownloadManager\\Passwords") OR contains(CommandLine, "\\Software\\FTPWare\\COREFTP\\Sites") OR contains(CommandLine, "\\Software\\IncrediMail\\Identities") OR contains(CommandLine, "\\Software\\Martin Prikryl\\WinSCP 2\\Sessions") OR contains(CommandLine, "\\Software\\Mobatek\\MobaXterm\\") OR contains(CommandLine, "\\Software\\OpenSSH\\Agent\\Keys") OR contains(CommandLine, "\\Software\\OpenVPN-GUI\\configs") OR contains(CommandLine, "\\Software\\ORL\\WinVNC3\\Password") OR contains(CommandLine, "\\Software\\Qualcomm\\Eudora\\CommandLine") OR contains(CommandLine, "\\Software\\RealVNC\\WinVNC4") OR contains(CommandLine, "\\Software\\RimArts\\B2\\Settings") OR contains(CommandLine, "\\Software\\SimonTatham\\PuTTY\\Sessions") OR contains(CommandLine, "\\Software\\SimonTatham\\PuTTY\\SshHostKeys\\") OR contains(CommandLine, "\\Software\\Sota\\FFFTP") OR contains(CommandLine, "\\Software\\TightVNC\\Server") OR contains(CommandLine, "\\Software\\WOW6432Node\\Radmin\\v3.0\\Server\\Parameters\\Radmin"))) AND NOT ((Image="*reg.exe" AND (contains(CommandLine, "export") OR contains(CommandLine, "save")))))
