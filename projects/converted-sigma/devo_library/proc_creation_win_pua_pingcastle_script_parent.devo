// Title: PUA - PingCastle Execution From Potentially Suspicious Parent
// ID: b37998de-a70b-4f33-b219-ec36bf433dc0
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2024-01-11
// Tags: attack.reconnaissance, attack.t1595
// Description: Detects the execution of PingCastle, a tool designed to quickly assess the Active Directory security level via a script located in a potentially suspicious or uncommon location.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((contains(ParentCommandLine, ".bat") OR contains(ParentCommandLine, ".chm") OR contains(ParentCommandLine, ".cmd") OR contains(ParentCommandLine, ".hta") OR contains(ParentCommandLine, ".htm") OR contains(ParentCommandLine, ".html") OR contains(ParentCommandLine, ".js") OR contains(ParentCommandLine, ".lnk") OR contains(ParentCommandLine, ".ps1") OR contains(ParentCommandLine, ".vbe") OR contains(ParentCommandLine, ".vbs") OR contains(ParentCommandLine, ".wsf"))) OR ((contains(ParentCommandLine, ":\\Perflogs\\") OR contains(ParentCommandLine, ":\\Temp\\") OR contains(ParentCommandLine, ":\\Users\\Public\\") OR contains(ParentCommandLine, ":\\Windows\\Temp\\") OR contains(ParentCommandLine, "\\AppData\\Local\\Temp") OR contains(ParentCommandLine, "\\AppData\\Roaming\\") OR contains(ParentCommandLine, "\\Temporary Internet"))) OR (((contains(ParentCommandLine, ":\\Users\\") AND contains(ParentCommandLine, "\\Favorites\\"))) OR ((contains(ParentCommandLine, ":\\Users\\") AND contains(ParentCommandLine, "\\Favourites\\"))) OR ((contains(ParentCommandLine, ":\\Users\\") AND contains(ParentCommandLine, "\\Contacts\\"))))) AND ((contains(ParentCommandLine, ".bat") OR contains(ParentCommandLine, ".chm") OR contains(ParentCommandLine, ".cmd") OR contains(ParentCommandLine, ".hta") OR contains(ParentCommandLine, ".htm") OR contains(ParentCommandLine, ".html") OR contains(ParentCommandLine, ".js") OR contains(ParentCommandLine, ".lnk") OR contains(ParentCommandLine, ".ps1") OR contains(ParentCommandLine, ".vbe") OR contains(ParentCommandLine, ".vbs") OR contains(ParentCommandLine, ".wsf"))) AND ((Image="*\\PingCastle.exe") OR (OriginalFileName == "PingCastle.exe") OR (Product == "Ping Castle") OR ((contains(CommandLine, "--scanner aclcheck") OR contains(CommandLine, "--scanner antivirus") OR contains(CommandLine, "--scanner computerversion") OR contains(CommandLine, "--scanner foreignusers") OR contains(CommandLine, "--scanner laps_bitlocker") OR contains(CommandLine, "--scanner localadmin") OR contains(CommandLine, "--scanner nullsession") OR contains(CommandLine, "--scanner nullsession-trust") OR contains(CommandLine, "--scanner oxidbindings") OR contains(CommandLine, "--scanner remote") OR contains(CommandLine, "--scanner share") OR contains(CommandLine, "--scanner smb") OR contains(CommandLine, "--scanner smb3querynetwork") OR contains(CommandLine, "--scanner spooler") OR contains(CommandLine, "--scanner startup") OR contains(CommandLine, "--scanner zerologon"))) OR (contains(CommandLine, "--no-enum-limit")) OR ((contains(CommandLine, "--healthcheck") AND contains(CommandLine, "--level Full"))) OR ((contains(CommandLine, "--healthcheck") AND contains(CommandLine, "--server ")))))
