// Title: Potential Suspicious Winget Package Installation
// ID: a3f5c081-e75b-43a0-9f5b-51f26fe5dba2
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.persistence, attack.stealth
// Description: Detects potential suspicious winget package installation from a suspicious source.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (Contents="[ZoneTransfer]  ZoneId=3*" AND (contains(Contents, "://1") OR contains(Contents, "://2") OR contains(Contents, "://3") OR contains(Contents, "://4") OR contains(Contents, "://5") OR contains(Contents, "://6") OR contains(Contents, "://7") OR contains(Contents, "://8") OR contains(Contents, "://9")) AND TargetFilename="*:Zone.Identifier" AND contains(TargetFilename, "\\AppData\\Local\\Temp\\WinGet\\"))
