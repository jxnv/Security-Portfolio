// Title: Suspicious Manipulation Of Default Accounts Via Net.EXE
// ID: 5b768e71-86f2-4879-b448-81061cbae951
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-01
// Tags: attack.collection, attack.t1560.001
// Description: Detects suspicious manipulations of default accounts such as 'administrator' and 'guest'. For example 'enable' or 'disable' accounts or change the password...etc
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((((Image="*\\net.exe" OR Image="*\\net1.exe")) OR ((OriginalFileName == "net.exe" OR OriginalFileName == "net1.exe"))) AND (contains(CommandLine, " user ")) AND ((contains(CommandLine, " Järjestelmänvalvoja ") OR contains(CommandLine, " Rendszergazda ") OR contains(CommandLine, " Администратор ") OR contains(CommandLine, " Administrateur ") OR contains(CommandLine, " Administrador ") OR contains(CommandLine, " Administratör ") OR contains(CommandLine, " Administrator ") OR contains(CommandLine, " guest ") OR contains(CommandLine, " DefaultAccount ") OR contains(CommandLine, " \"Järjestelmänvalvoja\" ") OR contains(CommandLine, " \"Rendszergazda\" ") OR contains(CommandLine, " \"Администратор\" ") OR contains(CommandLine, " \"Administrateur\" ") OR contains(CommandLine, " \"Administrador\" ") OR contains(CommandLine, " \"Administratör\" ") OR contains(CommandLine, " \"Administrator\" ") OR contains(CommandLine, " \"guest\" ") OR contains(CommandLine, " \"DefaultAccount\" ") OR contains(CommandLine, " 'Järjestelmänvalvoja' ") OR contains(CommandLine, " 'Rendszergazda' ") OR contains(CommandLine, " 'Администратор' ") OR contains(CommandLine, " 'Administrateur' ") OR contains(CommandLine, " 'Administrador' ") OR contains(CommandLine, " 'Administratör' ") OR contains(CommandLine, " 'Administrator' ") OR contains(CommandLine, " 'guest' ") OR contains(CommandLine, " 'DefaultAccount' ")))) AND NOT (((contains(CommandLine, "guest") AND contains(CommandLine, "/active no")))))
