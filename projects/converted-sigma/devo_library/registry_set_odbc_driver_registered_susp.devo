// Title: Potentially Suspicious ODBC Driver Registered
// ID: e4d22291-f3d5-4b78-9a0c-a1fbaf32a6a4
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-23
// Tags: attack.credential-access, attack.persistence, attack.t1003
// Description: Detects the registration of a new ODBC driver where the driver is located in a potentially suspicious location
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (contains(TargetObject, "\\SOFTWARE\\ODBC\\ODBCINST.INI\\") AND (TargetObject="*\\Driver" OR TargetObject="*\\Setup") AND (contains(Details, ":\\PerfLogs\\") OR contains(Details, ":\\ProgramData\\") OR contains(Details, ":\\Temp\\") OR contains(Details, ":\\Users\\Public\\") OR contains(Details, ":\\Windows\\Registration\\CRMLog") OR contains(Details, ":\\Windows\\System32\\com\\dmp\\") OR contains(Details, ":\\Windows\\System32\\FxsTmp\\") OR contains(Details, ":\\Windows\\System32\\Microsoft\\Crypto\\RSA\\MachineKeys\\") OR contains(Details, ":\\Windows\\System32\\spool\\drivers\\color\\") OR contains(Details, ":\\Windows\\System32\\spool\\PRINTERS\\") OR contains(Details, ":\\Windows\\System32\\spool\\SERVERS\\") OR contains(Details, ":\\Windows\\System32\\Tasks_Migrated\\") OR contains(Details, ":\\Windows\\System32\\Tasks\\Microsoft\\Windows\\SyncCenter\\") OR contains(Details, ":\\Windows\\SysWOW64\\com\\dmp\\") OR contains(Details, ":\\Windows\\SysWOW64\\FxsTmp\\") OR contains(Details, ":\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\PLA\\System\\") OR contains(Details, ":\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\SyncCenter\\") OR contains(Details, ":\\Windows\\Tasks\\") OR contains(Details, ":\\Windows\\Temp\\") OR contains(Details, ":\\Windows\\Tracing\\") OR contains(Details, "\\AppData\\Local\\Temp\\") OR contains(Details, "\\AppData\\Roaming\\")))
