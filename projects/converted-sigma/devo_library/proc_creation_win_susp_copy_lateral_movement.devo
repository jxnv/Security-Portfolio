// Title: Copy From Or To Admin Share Or Sysvol Folder
// ID: 855bc8b5-2ae8-402e-a9ed-b889e6df1900
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), oscd.community, Teymur Kheirkhabarov @HeirhabarovT, Zach Stanford @svch0st, Nasreddine Bencherchali
// Date: 2019-12-30
// Tags: attack.lateral-movement, attack.collection, attack.exfiltration, attack.t1039, attack.t1048, attack.t1021.002
// Description: Detects a copy command or a copy utility execution to or from an Admin share or remote
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "\\\\\\\\*\\\\*$") OR contains(CommandLine, "\\Sysvol\\"))) AND ((((Image="*\\robocopy.exe" OR Image="*\\xcopy.exe")) OR ((OriginalFileName == "robocopy.exe" OR OriginalFileName == "XCOPY.EXE"))) OR ((contains(CommandLine, "copy")) AND ((Image="*\\cmd.exe") OR (OriginalFileName == "Cmd.Exe"))) OR (((contains(CommandLine, "copy-item") OR contains(CommandLine, "copy ") OR contains(CommandLine, "cpi ") OR contains(CommandLine, " cp ") OR contains(CommandLine, "move ") OR contains(CommandLine, " move-item") OR contains(CommandLine, " mi ") OR contains(CommandLine, " mv "))) AND (((contains(Image, "\\powershell_ise.exe") OR contains(Image, "\\powershell.exe") OR contains(Image, "\\pwsh.exe"))) OR ((OriginalFileName == "powershell_ise.exe" OR OriginalFileName == "PowerShell.EXE" OR OriginalFileName == "pwsh.dll"))))))
