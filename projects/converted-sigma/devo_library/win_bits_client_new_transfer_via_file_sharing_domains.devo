// Title: BITS Transfer Job Download From File Sharing Domains
// ID: d635249d-86b5-4dad-a8c7-d7272b788586
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-06-28
// Tags: attack.persistence, attack.execution, attack.stealth, attack.t1197
// Description: Detects BITS transfer job downloading files from a file sharing domain.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (EventID == "16403" AND (contains(RemoteName, ".githubusercontent.com") OR contains(RemoteName, "0x0.st") OR contains(RemoteName, "anonfiles.com") OR contains(RemoteName, "bashupload.com") OR contains(RemoteName, "cdn.discordapp.com") OR contains(RemoteName, "chunk.io") OR contains(RemoteName, "ddns.net") OR contains(RemoteName, "dl.dropboxusercontent.com") OR contains(RemoteName, "ghostbin.co") OR contains(RemoteName, "github.com") OR contains(RemoteName, "glitch.me") OR contains(RemoteName, "gofile.io") OR contains(RemoteName, "hastebin.com") OR contains(RemoteName, "mediafire.com") OR contains(RemoteName, "mega.nz") OR contains(RemoteName, "onrender.com") OR contains(RemoteName, "pages.dev") OR contains(RemoteName, "paste.ee") OR contains(RemoteName, "pastebin.com") OR contains(RemoteName, "pastebin.pl") OR contains(RemoteName, "pastetext.net") OR contains(RemoteName, "pixeldrain.com") OR contains(RemoteName, "privatlab.com") OR contains(RemoteName, "privatlab.net") OR contains(RemoteName, "send.exploit.in") OR contains(RemoteName, "sendspace.com") OR contains(RemoteName, "storage.googleapis.com") OR contains(RemoteName, "storjshare.io") OR contains(RemoteName, "supabase.co") OR contains(RemoteName, "temp.sh") OR contains(RemoteName, "transfer.sh") OR contains(RemoteName, "trycloudflare.com") OR contains(RemoteName, "ufile.io") OR contains(RemoteName, "w3spaces.com") OR contains(RemoteName, "workers.dev") OR contains(RemoteName, "x0.at")))
