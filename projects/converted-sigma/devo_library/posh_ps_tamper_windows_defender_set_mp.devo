// Title: Tamper Windows Defender - ScriptBlockLogging
// ID: 14c71865-6cd3-44ae-adaa-1db923fae5f2
// Status: test
// Level: high
// Author: frack113, elhoim, Tim Shelton (fps, alias support), Swachchhanda Shrawan Poudel, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-16
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects PowerShell scripts attempting to disable scheduled scanning and other parts of Windows Defender ATP or set default actions to allow.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((contains(ScriptBlockText, "-dbaf $true") OR contains(ScriptBlockText, "-dbaf 1") OR contains(ScriptBlockText, "-dbm $true") OR contains(ScriptBlockText, "-dbm 1") OR contains(ScriptBlockText, "-dips $true") OR contains(ScriptBlockText, "-dips 1") OR contains(ScriptBlockText, "-DisableArchiveScanning $true") OR contains(ScriptBlockText, "-DisableArchiveScanning 1") OR contains(ScriptBlockText, "-DisableBehaviorMonitoring $true") OR contains(ScriptBlockText, "-DisableBehaviorMonitoring 1") OR contains(ScriptBlockText, "-DisableBlockAtFirstSeen $true") OR contains(ScriptBlockText, "-DisableBlockAtFirstSeen 1") OR contains(ScriptBlockText, "-DisableCatchupFullScan $true") OR contains(ScriptBlockText, "-DisableCatchupFullScan 1") OR contains(ScriptBlockText, "-DisableCatchupQuickScan $true") OR contains(ScriptBlockText, "-DisableCatchupQuickScan 1") OR contains(ScriptBlockText, "-DisableIntrusionPreventionSystem $true") OR contains(ScriptBlockText, "-DisableIntrusionPreventionSystem 1") OR contains(ScriptBlockText, "-DisableIOAVProtection $true") OR contains(ScriptBlockText, "-DisableIOAVProtection 1") OR contains(ScriptBlockText, "-DisableRealtimeMonitoring $true") OR contains(ScriptBlockText, "-DisableRealtimeMonitoring 1") OR contains(ScriptBlockText, "-DisableRemovableDriveScanning $true") OR contains(ScriptBlockText, "-DisableRemovableDriveScanning 1") OR contains(ScriptBlockText, "-DisableScanningMappedNetworkDrivesForFullScan $true") OR contains(ScriptBlockText, "-DisableScanningMappedNetworkDrivesForFullScan 1") OR contains(ScriptBlockText, "-DisableScanningNetworkFiles $true") OR contains(ScriptBlockText, "-DisableScanningNetworkFiles 1") OR contains(ScriptBlockText, "-DisableScriptScanning $true") OR contains(ScriptBlockText, "-DisableScriptScanning 1") OR contains(ScriptBlockText, "-MAPSReporting $false") OR contains(ScriptBlockText, "-MAPSReporting 0") OR contains(ScriptBlockText, "-drdsc $true") OR contains(ScriptBlockText, "-drdsc 1") OR contains(ScriptBlockText, "-drtm $true") OR contains(ScriptBlockText, "-drtm 1") OR contains(ScriptBlockText, "-dscrptsc $true") OR contains(ScriptBlockText, "-dscrptsc 1") OR contains(ScriptBlockText, "-dsmndf $true") OR contains(ScriptBlockText, "-dsmndf 1") OR contains(ScriptBlockText, "-dsnf $true") OR contains(ScriptBlockText, "-dsnf 1") OR contains(ScriptBlockText, "-dss $true") OR contains(ScriptBlockText, "-dss 1"))) AND (contains(ScriptBlockText, "Set-MpPreference"))) OR ((contains(ScriptBlockText, "Set-MpPreference")) AND ((contains(ScriptBlockText, "HighThreatDefaultAction Allow") OR contains(ScriptBlockText, "htdefac Allow") OR contains(ScriptBlockText, "LowThreatDefaultAction Allow") OR contains(ScriptBlockText, "ltdefac Allow") OR contains(ScriptBlockText, "ModerateThreatDefaultAction Allow") OR contains(ScriptBlockText, "mtdefac Allow") OR contains(ScriptBlockText, "SevereThreatDefaultAction Allow") OR contains(ScriptBlockText, "stdefac Allow")))))
