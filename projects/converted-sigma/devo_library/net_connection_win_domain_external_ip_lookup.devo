// Title: Suspicious Network Connection to IP Lookup Service APIs
// ID: edf3485d-dac4-4d50-90e4-b0e5813f7e60
// Status: test
// Level: medium
// Author: Janantha Marasinghe, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-24
// Tags: attack.discovery, attack.t1016
// Description: Detects external IP address lookups by non-browser processes via services such as "api.ipify.org". This could be indicative of potential post compromise internet test activity.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((DestinationHostname == "www.ip.cn" OR DestinationHostname == "l2.io")) OR ((contains(DestinationHostname, "api.2ip.ua") OR contains(DestinationHostname, "api.bigdatacloud.net") OR contains(DestinationHostname, "api.ipify.org") OR contains(DestinationHostname, "bot.whatismyipaddress.com") OR contains(DestinationHostname, "canireachthe.net") OR contains(DestinationHostname, "checkip.amazonaws.com") OR contains(DestinationHostname, "checkip.dyndns.org") OR contains(DestinationHostname, "curlmyip.com") OR contains(DestinationHostname, "db-ip.com") OR contains(DestinationHostname, "edns.ip-api.com") OR contains(DestinationHostname, "eth0.me") OR contains(DestinationHostname, "freegeoip.app") OR contains(DestinationHostname, "geoipy.com") OR contains(DestinationHostname, "getip.pro") OR contains(DestinationHostname, "icanhazip.com") OR contains(DestinationHostname, "ident.me") OR contains(DestinationHostname, "ifconfig.io") OR contains(DestinationHostname, "ifconfig.me") OR contains(DestinationHostname, "ip-api.com") OR contains(DestinationHostname, "ip.360.cn") OR contains(DestinationHostname, "ip.anysrc.net") OR contains(DestinationHostname, "ip.taobao.com") OR contains(DestinationHostname, "ip.tyk.nu") OR contains(DestinationHostname, "ipaddressworld.com") OR contains(DestinationHostname, "ipapi.co") OR contains(DestinationHostname, "ipconfig.io") OR contains(DestinationHostname, "ipecho.net") OR contains(DestinationHostname, "ipinfo.io") OR contains(DestinationHostname, "ipip.net") OR contains(DestinationHostname, "ipof.in") OR contains(DestinationHostname, "ipv4.icanhazip.com") OR contains(DestinationHostname, "ipv4bot.whatismyipaddress.com") OR contains(DestinationHostname, "ipv6-test.com") OR contains(DestinationHostname, "ipwho.is") OR contains(DestinationHostname, "jsonip.com") OR contains(DestinationHostname, "myexternalip.com") OR contains(DestinationHostname, "seeip.org") OR contains(DestinationHostname, "wgetip.com") OR contains(DestinationHostname, "whatismyip.akamai.com") OR contains(DestinationHostname, "whois.pconline.com.cn") OR contains(DestinationHostname, "wtfismyip.com")))) AND NOT (((Image="*\\brave.exe") OR ((Image == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR Image == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((Image="C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*") OR (Image="*\\WindowsApps\\MicrosoftEdge.exe") OR ((Image == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR Image == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((Image="C:\\Program Files (x86)\\Microsoft\\EdgeCore\\*" OR Image="C:\\Program Files\\Microsoft\\EdgeCore\\*") AND (Image="*\\msedge.exe" OR Image="*\\msedgewebview2.exe")) OR ((Image == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR Image == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR ((Image == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR Image == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (Image="*\\maxthon.exe") OR (Image="*\\opera.exe") OR (Image="*\\safari.exe") OR (Image="*\\seamonkey.exe") OR (Image="*\\vivaldi.exe") OR (Image="*\\whale.exe"))))
