// Title: Malicious Base64 Encoded PowerShell Keywords in Command Lines
// ID: f26c6093-6f14-4b12-800f-0fcb46f5ffd0
// Status: test
// Level: high
// Author: John Lambert (rule)
// Date: 2019-01-16
// Tags: attack.execution, attack.t1059.001
// Description: Detects base64 encoded strings used in hidden malicious PowerShell command lines
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "AGkAdABzAGEAZABtAGkAbgAgAC8AdAByAGEAbgBzAGYAZQByA") OR contains(CommandLine, "aXRzYWRtaW4gL3RyYW5zZmVy") OR contains(CommandLine, "IAaQB0AHMAYQBkAG0AaQBuACAALwB0AHIAYQBuAHMAZgBlAHIA") OR contains(CommandLine, "JpdHNhZG1pbiAvdHJhbnNmZX") OR contains(CommandLine, "YgBpAHQAcwBhAGQAbQBpAG4AIAAvAHQAcgBhAG4AcwBmAGUAcg") OR contains(CommandLine, "Yml0c2FkbWluIC90cmFuc2Zlc") OR contains(CommandLine, "AGMAaAB1AG4AawBfAHMAaQB6AGUA") OR contains(CommandLine, "JABjAGgAdQBuAGsAXwBzAGkAegBlA") OR contains(CommandLine, "JGNodW5rX3Npem") OR contains(CommandLine, "QAYwBoAHUAbgBrAF8AcwBpAHoAZQ") OR contains(CommandLine, "RjaHVua19zaXpl") OR contains(CommandLine, "Y2h1bmtfc2l6Z") OR contains(CommandLine, "AE8ALgBDAG8AbQBwAHIAZQBzAHMAaQBvAG4A") OR contains(CommandLine, "kATwAuAEMAbwBtAHAAcgBlAHMAcwBpAG8Abg") OR contains(CommandLine, "lPLkNvbXByZXNzaW9u") OR contains(CommandLine, "SQBPAC4AQwBvAG0AcAByAGUAcwBzAGkAbwBuA") OR contains(CommandLine, "SU8uQ29tcHJlc3Npb2") OR contains(CommandLine, "Ty5Db21wcmVzc2lvb") OR contains(CommandLine, "AE8ALgBNAGUAbQBvAHIAeQBTAHQAcgBlAGEAbQ") OR contains(CommandLine, "kATwAuAE0AZQBtAG8AcgB5AFMAdAByAGUAYQBtA") OR contains(CommandLine, "lPLk1lbW9yeVN0cmVhb") OR contains(CommandLine, "SQBPAC4ATQBlAG0AbwByAHkAUwB0AHIAZQBhAG0A") OR contains(CommandLine, "SU8uTWVtb3J5U3RyZWFt") OR contains(CommandLine, "Ty5NZW1vcnlTdHJlYW") OR contains(CommandLine, "4ARwBlAHQAQwBoAHUAbgBrA") OR contains(CommandLine, "5HZXRDaHVua") OR contains(CommandLine, "AEcAZQB0AEMAaAB1AG4Aaw") OR contains(CommandLine, "LgBHAGUAdABDAGgAdQBuAGsA") OR contains(CommandLine, "LkdldENodW5r") OR contains(CommandLine, "R2V0Q2h1bm") OR contains(CommandLine, "AEgAUgBFAEEARABfAEkATgBGAE8ANgA0A") OR contains(CommandLine, "QASABSAEUAQQBEAF8ASQBOAEYATwA2ADQA") OR contains(CommandLine, "RIUkVBRF9JTkZPNj") OR contains(CommandLine, "SFJFQURfSU5GTzY0") OR contains(CommandLine, "VABIAFIARQBBAEQAXwBJAE4ARgBPADYANA") OR contains(CommandLine, "VEhSRUFEX0lORk82N") OR contains(CommandLine, "AHIAZQBhAHQAZQBSAGUAbQBvAHQAZQBUAGgAcgBlAGEAZA") OR contains(CommandLine, "cmVhdGVSZW1vdGVUaHJlYW") OR contains(CommandLine, "MAcgBlAGEAdABlAFIAZQBtAG8AdABlAFQAaAByAGUAYQBkA") OR contains(CommandLine, "NyZWF0ZVJlbW90ZVRocmVhZ") OR contains(CommandLine, "Q3JlYXRlUmVtb3RlVGhyZWFk") OR contains(CommandLine, "QwByAGUAYQB0AGUAUgBlAG0AbwB0AGUAVABoAHIAZQBhAGQA") OR contains(CommandLine, "0AZQBtAG0AbwB2AGUA") OR contains(CommandLine, "1lbW1vdm") OR contains(CommandLine, "AGUAbQBtAG8AdgBlA") OR contains(CommandLine, "bQBlAG0AbQBvAHYAZQ") OR contains(CommandLine, "bWVtbW92Z") OR contains(CommandLine, "ZW1tb3Zl"))) AND (contains(CommandLine, " hidden ")) AND (((Image="*\\powershell.exe" OR Image="*\\pwsh.exe")) OR ((OriginalFileName == "PowerShell.EXE" OR OriginalFileName == "pwsh.dll"))))
