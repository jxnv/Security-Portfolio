// Title: Antivirus - Remote Access Tools Signature
// ID: 97233998-3838-4581-88c6-f1d19d3993fb
// Status: experimental
// Level: critical
// Author: Arnim Rupp (Nextron Systems)
// Date: 2026-06-15
// Tags: attack.execution, attack.t1203, attack.command-and-control, attack.t1219.002
// Description: Detects a highly relevant Antivirus alert that reports a remote access tool.
// This event must not be ignored just because the AV has blocked the malware but investigate, how it came there in the first place.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(Signature, "AgentB") OR contains(Signature, "AgentTesla") OR contains(Signature, "AMRat") OR contains(Signature, "Ammyy") OR contains(Signature, "AsyncRAT") OR contains(Signature, "Bandook") OR contains(Signature, "Bitrat") OR contains(Signature, "Bladabindi") OR contains(Signature, "Connectwise") OR contains(Signature, "CyberGate") OR contains(Signature, "DarkComet") OR contains(Signature, "DCrat") OR contains(Signature, "Delf") OR contains(Signature, "DokStorm") OR contains(Signature, "Egairtigado") OR contains(Signature, "Gh0st") OR contains(Signature, "Gorat") OR contains(Signature, "GodRat") OR contains(Signature, "Jalapeno") OR contains(Signature, "LummaC2") OR contains(Signature, "Minirat") OR contains(Signature, "Netwire") OR contains(Signature, "NanoCore") OR contains(Signature, "NJRat") OR contains(Signature, "Paralax") OR contains(Signature, "PlugX") OR contains(Signature, "Pulsar") OR contains(Signature, "Quasar") OR contains(Signature, "Remcos") OR contains(Signature, "Ravartar") OR contains(Signature, "RemoteAdmin") OR contains(Signature, "RemoteTool") OR contains(Signature, "revengeRAT") OR contains(Signature, "rokRAT") OR contains(Signature, "salatstealer") OR contains(Signature, "Salgorea") OR contains(Signature, "SmokedHam") OR contains(Signature, "TigerRat") OR contains(Signature, "Tzeebot") OR contains(Signature, "WarZone") OR contains(Signature, "VenomRAT") OR contains(Signature, "Vidar") OR contains(Signature, "Wirenet") OR contains(Signature, "XWorm") OR contains(Signature, "Zapchast") OR contains(Signature, "Zegost")))
