// Title: Linux Crypto Mining Indicators
// ID: 9069ea3c-b213-4c52-be13-86506a227ab1
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-10-26
// Tags: attack.impact, attack.t1496
// Description: Detects command line parameters or strings often used by crypto miners
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(CommandLine, " --cpu-priority=") OR contains(CommandLine, "--donate-level=0") OR contains(CommandLine, " -o pool.") OR contains(CommandLine, " --nicehash") OR contains(CommandLine, " --algo=rx/0 ") OR contains(CommandLine, "stratum+tcp://") OR contains(CommandLine, "stratum+udp://") OR contains(CommandLine, "sh -c /sbin/modprobe msr allow_writes=on") OR contains(CommandLine, "LS1kb25hdGUtbGV2ZWw9") OR contains(CommandLine, "0tZG9uYXRlLWxldmVsP") OR contains(CommandLine, "tLWRvbmF0ZS1sZXZlbD") OR contains(CommandLine, "c3RyYXR1bSt0Y3A6Ly") OR contains(CommandLine, "N0cmF0dW0rdGNwOi8v") OR contains(CommandLine, "zdHJhdHVtK3RjcDovL") OR contains(CommandLine, "c3RyYXR1bSt1ZHA6Ly") OR contains(CommandLine, "N0cmF0dW0rdWRwOi8v") OR contains(CommandLine, "zdHJhdHVtK3VkcDovL")))
