// Title: Potential Dropper Script Execution Via WScript/CScript/MSHTA
// ID: cea72823-df4d-4567-950c-0b579eaf0846
// Status: test
// Level: medium
// Author: Margaritis Dimitrios (idea), Florian Roth (Nextron Systems), oscd.community, Nasreddine Bencherchali (Nextron Systems), Dave Johnson
// Date: 2019-01-16
// Tags: attack.execution, attack.t1059.005, attack.t1059.007
// Description: Detects wscript/cscript/mshta executions of scripts located in user directories
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((Image="*\\wscript.exe" OR Image="*\\cscript.exe" OR Image="*\\mshta.exe")) AND ((contains(CommandLine, ".hta") OR contains(CommandLine, ".js") OR contains(CommandLine, ".jse") OR contains(CommandLine, ".vba") OR contains(CommandLine, ".vbe") OR contains(CommandLine, ".vbs") OR contains(CommandLine, ".wsf") OR contains(CommandLine, ".wsh"))) AND ((contains(CommandLine, ":\\Perflogs\\") OR contains(CommandLine, ":\\Temp\\") OR contains(CommandLine, ":\\Tmp\\") OR contains(CommandLine, ":\\Users\\Public\\") OR contains(CommandLine, ":\\Windows\\Temp\\") OR contains(CommandLine, "\\AppData\\Local\\Temp\\") OR contains(CommandLine, "\\AppData\\Roaming\\Temp\\") OR contains(CommandLine, "\\Start Menu\\Programs\\Startup\\") OR contains(CommandLine, "\\Temporary Internet") OR contains(CommandLine, "\\Windows\\Temp") OR contains(CommandLine, "%LocalAppData%\\Temp\\") OR contains(CommandLine, "%TEMP%") OR contains(CommandLine, "%TMP%"))))
