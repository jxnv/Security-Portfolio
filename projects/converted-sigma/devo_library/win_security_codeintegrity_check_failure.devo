// Title: Failed Code Integrity Checks
// ID: 470ec5fa-7b4e-4071-b200-4c753100f49b
// Status: stable
// Level: informational
// Author: Thomas Patzke
// Date: 2019-12-03
// Tags: attack.stealth, attack.t1027.001
// Description: Detects code integrity failures such as missing page hashes or corrupted drivers due unauthorized modification. This could be a sign of tampered binaries.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((EventID == "5038" OR EventID == "6281")) AND NOT ((((contains(param1, "\\CSFalconServiceUninstallTool_") OR contains(param1, "\\Program Files\\CrowdStrike\\") OR contains(param1, "\\System32\\drivers\\CrowdStrike\\") OR contains(param1, "\\Windows\\System32\\ScriptControl64_"))) OR (contains(param1, "\\Program Files\\Sophos\\")))))
