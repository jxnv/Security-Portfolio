// Title: Potentially Suspicious Rundll32 Activity
// ID: e593cf51-88db-4ee1-b920-37e89012a3c9
// Status: test
// Level: medium
// Author: juju4, Jonhnathan Ribeiro, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-01-16
// Tags: attack.stealth, attack.t1218.011
// Description: Detects suspicious execution of rundll32, with specific calls to some DLLs with known LOLBIN functionalities
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((contains(CommandLine, "javascript:") AND contains(CommandLine, ".RegisterXLL"))) OR ((contains(CommandLine, "url.dll") AND contains(CommandLine, "OpenURL"))) OR ((contains(CommandLine, "url.dll") AND contains(CommandLine, "OpenURLA"))) OR ((contains(CommandLine, "url.dll") AND contains(CommandLine, "FileProtocolHandler"))) OR ((contains(CommandLine, "zipfldr.dll") AND contains(CommandLine, "RouteTheCall"))) OR ((contains(CommandLine, "shell32.dll") AND contains(CommandLine, "Control_RunDLL"))) OR ((contains(CommandLine, "shell32.dll") AND contains(CommandLine, "ShellExec_RunDLL"))) OR ((contains(CommandLine, "mshtml.dll") AND contains(CommandLine, "PrintHTML"))) OR ((contains(CommandLine, "advpack.dll") AND contains(CommandLine, "LaunchINFSection"))) OR ((contains(CommandLine, "advpack.dll") AND contains(CommandLine, "RegisterOCX"))) OR ((contains(CommandLine, "ieadvpack.dll") AND contains(CommandLine, "LaunchINFSection"))) OR ((contains(CommandLine, "ieadvpack.dll") AND contains(CommandLine, "RegisterOCX"))) OR ((contains(CommandLine, "ieframe.dll") AND contains(CommandLine, "OpenURL"))) OR ((contains(CommandLine, "shdocvw.dll") AND contains(CommandLine, "OpenURL"))) OR ((contains(CommandLine, "syssetup.dll") AND contains(CommandLine, "SetupInfObjectInstallAction"))) OR ((contains(CommandLine, "setupapi.dll") AND contains(CommandLine, "InstallHinfSection"))) OR ((contains(CommandLine, "pcwutl.dll") AND contains(CommandLine, "LaunchApplication"))) OR ((contains(CommandLine, "dfshim.dll") AND contains(CommandLine, "ShOpenVerbApplication"))) OR ((contains(CommandLine, "dfshim.dll") AND contains(CommandLine, "ShOpenVerbShortcut"))) OR ((contains(CommandLine, "scrobj.dll") AND contains(CommandLine, "GenerateTypeLib") AND contains(CommandLine, "http"))) OR ((contains(CommandLine, "shimgvw.dll") AND contains(CommandLine, "ImageView_Fullscreen") AND contains(CommandLine, "http"))) OR ((contains(CommandLine, "comsvcs.dll") AND contains(CommandLine, "MiniDump")))) AND NOT (((ParentImage == "C:\\Windows\\System32\\control.exe" AND contains(ParentCommandLine, ".cpl") AND (contains(CommandLine, "Shell32.dll") AND contains(CommandLine, "Control_RunDLL") AND contains(CommandLine, ".cpl"))) OR (contains(CommandLine, "shell32.dll,Control_RunDLL desk.cpl,screensaver,@screensaver")) OR (ParentImage == "C:\\Windows\\System32\\control.exe" AND CommandLine="\"C:\\Windows\\system32\\rundll32.exe\" Shell32.dll,Control_RunDLL \"C:\\Windows\\System32\\*" AND CommandLine="*.cpl\","))))
