// Title: PUA - AdFind Suspicious Execution
// ID: 9a132afa-654e-11eb-ae93-0242ac130002
// Status: test
// Level: high
// Author: Janantha Marasinghe (https://github.com/blueteam0ps), FPT.EagleEye Team, omkar72, oscd.community
// Date: 2021-02-02
// Tags: attack.discovery, attack.t1018, attack.t1087.002, attack.t1482, attack.t1069.002, stp.1u
// Description: Detects AdFind execution with common flags seen used during attacks
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(CommandLine, "domainlist") OR contains(CommandLine, "trustdmp") OR contains(CommandLine, "dcmodes") OR contains(CommandLine, "adinfo") OR contains(CommandLine, "-sc dclist") OR contains(CommandLine, "computer_pwdnotreqd") OR contains(CommandLine, "objectcategory=") OR contains(CommandLine, "-subnets -f") OR contains(CommandLine, "name=\"Domain Admins\"") OR contains(CommandLine, "-sc u:") OR contains(CommandLine, "domainncs") OR contains(CommandLine, "dompol") OR contains(CommandLine, " oudmp ") OR contains(CommandLine, "subnetdmp") OR contains(CommandLine, "gpodmp") OR contains(CommandLine, "fspdmp") OR contains(CommandLine, "users_noexpire") OR contains(CommandLine, "computers_active") OR contains(CommandLine, "computers_pwdnotreqd")))
