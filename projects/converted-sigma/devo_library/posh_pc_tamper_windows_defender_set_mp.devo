// Title: Tamper Windows Defender - PSClassic
// ID: ec19ebab-72dc-40e1-9728-4c0b805d722c
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-06-07
// Tags: attack.defense-impairment, attack.t1685
// Description: Attempting to disable scheduled scanning and other parts of Windows Defender ATP or set default actions to allow.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(Data, "Set-MpPreference")) AND (((contains(Data, "HighThreatDefaultAction Allow") OR contains(Data, "htdefac Allow") OR contains(Data, "LowThreatDefaultAction Allow") OR contains(Data, "ltdefac Allow") OR contains(Data, "ModerateThreatDefaultAction Allow") OR contains(Data, "mtdefac Allow") OR contains(Data, "SevereThreatDefaultAction Allow") OR contains(Data, "stdefac Allow"))) OR ((contains(Data, "-dbaf $true") OR contains(Data, "-dbaf 1") OR contains(Data, "-dbm $true") OR contains(Data, "-dbm 1") OR contains(Data, "-dips $true") OR contains(Data, "-dips 1") OR contains(Data, "-DisableArchiveScanning $true") OR contains(Data, "-DisableArchiveScanning 1") OR contains(Data, "-DisableBehaviorMonitoring $true") OR contains(Data, "-DisableBehaviorMonitoring 1") OR contains(Data, "-DisableBlockAtFirstSeen $true") OR contains(Data, "-DisableBlockAtFirstSeen 1") OR contains(Data, "-DisableCatchupFullScan $true") OR contains(Data, "-DisableCatchupFullScan 1") OR contains(Data, "-DisableCatchupQuickScan $true") OR contains(Data, "-DisableCatchupQuickScan 1") OR contains(Data, "-DisableIntrusionPreventionSystem $true") OR contains(Data, "-DisableIntrusionPreventionSystem 1") OR contains(Data, "-DisableIOAVProtection $true") OR contains(Data, "-DisableIOAVProtection 1") OR contains(Data, "-DisableRealtimeMonitoring $true") OR contains(Data, "-DisableRealtimeMonitoring 1") OR contains(Data, "-DisableRemovableDriveScanning $true") OR contains(Data, "-DisableRemovableDriveScanning 1") OR contains(Data, "-DisableScanningMappedNetworkDrivesForFullScan $true") OR contains(Data, "-DisableScanningMappedNetworkDrivesForFullScan 1") OR contains(Data, "-DisableScanningNetworkFiles $true") OR contains(Data, "-DisableScanningNetworkFiles 1") OR contains(Data, "-DisableScriptScanning $true") OR contains(Data, "-DisableScriptScanning 1") OR contains(Data, "-MAPSReporting $false") OR contains(Data, "-MAPSReporting 0") OR contains(Data, "-drdsc $true") OR contains(Data, "-drdsc 1") OR contains(Data, "-drtm $true") OR contains(Data, "-drtm 1") OR contains(Data, "-dscrptsc $true") OR contains(Data, "-dscrptsc 1") OR contains(Data, "-dsmndf $true") OR contains(Data, "-dsmndf 1") OR contains(Data, "-dsnf $true") OR contains(Data, "-dsnf 1") OR contains(Data, "-dss $true") OR contains(Data, "-dss 1")))))
