// Title: Suspicious Windows Defender Registry Key Tampering Via Reg.EXE
// ID: 452bce90-6fb0-43cc-97a5-affc283139b3
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Swachchhanda Shrawan Poudel, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-03-22
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects the usage of "reg.exe" to tamper with different Windows Defender registry keys in order to disable some important features related to protection and detection
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((Image="*\\reg.exe") OR (OriginalFileName == "reg.exe")) AND ((contains(CommandLine, "SOFTWARE\\Microsoft\\Windows Defender\\") OR contains(CommandLine, "SOFTWARE\\Policies\\Microsoft\\Windows Defender Security Center") OR contains(CommandLine, "SOFTWARE\\Policies\\Microsoft\\Windows Defender\\")))) AND (((contains(CommandLine, " add ") AND contains(CommandLine, "d 0")) AND (contains(CommandLine, "DisallowExploitProtectionOverride") OR contains(CommandLine, "EnableControlledFolderAccess") OR contains(CommandLine, "MpEnablePus") OR contains(CommandLine, "PUAProtection") OR contains(CommandLine, "SpynetReporting") OR contains(CommandLine, "SubmitSamplesConsent") OR contains(CommandLine, "TamperProtection"))) OR ((contains(CommandLine, " add ") AND contains(CommandLine, "d 1")) AND (contains(CommandLine, "DisableAccess") OR contains(CommandLine, "DisableAntiSpyware") OR contains(CommandLine, "DisableAntiSpywareRealtimeProtection") OR contains(CommandLine, "DisableAntiVirus") OR contains(CommandLine, "DisableAntiVirusSignatures") OR contains(CommandLine, "DisableArchiveScanning") OR contains(CommandLine, "DisableBehaviorMonitoring") OR contains(CommandLine, "DisableBlockAtFirstSeen") OR contains(CommandLine, "DisableCloudProtection") OR contains(CommandLine, "DisableConfig") OR contains(CommandLine, "DisableEnhancedNotifications") OR contains(CommandLine, "DisableIntrusionPreventionSystem") OR contains(CommandLine, "DisableIOAVProtection") OR contains(CommandLine, "DisableNetworkProtection") OR contains(CommandLine, "DisableOnAccessProtection") OR contains(CommandLine, "DisablePrivacyMode") OR contains(CommandLine, "DisableRealtimeMonitoring") OR contains(CommandLine, "DisableRoutinelyTakingAction") OR contains(CommandLine, "DisableScanOnRealtimeEnable") OR contains(CommandLine, "DisableScriptScanning") OR contains(CommandLine, "DisableSecurityCenter") OR contains(CommandLine, "Notification_Suppress") OR contains(CommandLine, "SignatureDisableUpdateOnStartupWithoutEngine")))))
