// Title: Hack Tool User Agent
// ID: c42a3073-30fb-48ae-8c99-c23ada84b103
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2017-07-08
// Tags: attack.initial-access, attack.t1190, attack.credential-access, attack.t1110
// Description: Detects suspicious user agent strings user by hack tools in proxy logs
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(c-useragent, "(hydra)") OR contains(c-useragent, " arachni/") OR contains(c-useragent, " BFAC ") OR contains(c-useragent, " brutus ") OR contains(c-useragent, " cgichk ") OR contains(c-useragent, "core-project/1.0") OR contains(c-useragent, " crimscanner/") OR contains(c-useragent, "datacha0s") OR contains(c-useragent, "dirbuster") OR contains(c-useragent, "domino hunter") OR contains(c-useragent, "dotdotpwn") OR contains(c-useragent, "FHScan Core") OR contains(c-useragent, "floodgate") OR contains(c-useragent, "get-minimal") OR contains(c-useragent, "gootkit auto-rooter scanner") OR contains(c-useragent, "grendel-scan") OR contains(c-useragent, " inspath ") OR contains(c-useragent, "internet ninja") OR contains(c-useragent, "jaascois") OR contains(c-useragent, " zmeu ") OR contains(c-useragent, "masscan") OR contains(c-useragent, " metis ") OR contains(c-useragent, "morfeus fucking scanner") OR contains(c-useragent, "n-stealth") OR contains(c-useragent, "nsauditor") OR contains(c-useragent, "pmafind") OR contains(c-useragent, "security scan") OR contains(c-useragent, "springenwerk") OR contains(c-useragent, "teh forest lobster") OR contains(c-useragent, "toata dragostea") OR contains(c-useragent, " vega/") OR contains(c-useragent, "voideye") OR contains(c-useragent, "webshag") OR contains(c-useragent, "webvulnscan") OR contains(c-useragent, " whcc/") OR contains(c-useragent, " Havij") OR contains(c-useragent, "absinthe") OR contains(c-useragent, "bsqlbf") OR contains(c-useragent, "mysqloit") OR contains(c-useragent, "pangolin") OR contains(c-useragent, "sql power injector") OR contains(c-useragent, "sqlmap") OR contains(c-useragent, "sqlninja") OR contains(c-useragent, "uil2pn") OR contains(c-useragent, "ruler") OR contains(c-useragent, "Mozilla/5.0 (Windows; U; Windows NT 5.1; pt-PT; rv:1.9.1.2) Gecko/20090729 Firefox/3.5.2 (.NET CLR 3.5.30729)")))
