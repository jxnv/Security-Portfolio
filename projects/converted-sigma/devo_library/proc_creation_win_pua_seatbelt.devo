// Title: PUA - Seatbelt Execution
// ID: 38646daa-e78f-4ace-9de0-55547b2d30da
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-18
// Tags: attack.discovery, attack.t1526, attack.t1087, attack.t1083
// Description: Detects the execution of the PUA/Recon tool Seatbelt via PE information of command line parameters
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((Image="*\\Seatbelt.exe") OR (OriginalFileName == "Seatbelt.exe") OR (Description == "Seatbelt") OR ((contains(CommandLine, " DpapiMasterKeys") OR contains(CommandLine, " InterestingProcesses") OR contains(CommandLine, " InterestingFiles") OR contains(CommandLine, " CertificateThumbprints") OR contains(CommandLine, " ChromiumBookmarks") OR contains(CommandLine, " ChromiumHistory") OR contains(CommandLine, " ChromiumPresence") OR contains(CommandLine, " CloudCredentials") OR contains(CommandLine, " CredEnum") OR contains(CommandLine, " CredGuard") OR contains(CommandLine, " FirefoxHistory") OR contains(CommandLine, " ProcessCreationEvents")))) OR (((contains(CommandLine, " -group=misc") OR contains(CommandLine, " -group=remote") OR contains(CommandLine, " -group=chromium") OR contains(CommandLine, " -group=slack") OR contains(CommandLine, " -group=system") OR contains(CommandLine, " -group=user") OR contains(CommandLine, " -group=all"))) AND (contains(CommandLine, " -outputfile="))))
