// Title: Potential Crypto Mining Activity
// ID: 66c3b204-9f88-4d0a-a7f7-8a57d521ca55
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-10-26
// Tags: attack.impact, attack.t1496
// Description: Detects command line parameters or strings often used by crypto miners
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, " --cpu-priority=") OR contains(CommandLine, "--donate-level=0") OR contains(CommandLine, " -o pool.") OR contains(CommandLine, " --nicehash") OR contains(CommandLine, " --algo=rx/0 ") OR contains(CommandLine, "stratum+tcp://") OR contains(CommandLine, "stratum+udp://") OR contains(CommandLine, "LS1kb25hdGUtbGV2ZWw9") OR contains(CommandLine, "0tZG9uYXRlLWxldmVsP") OR contains(CommandLine, "tLWRvbmF0ZS1sZXZlbD") OR contains(CommandLine, "c3RyYXR1bSt0Y3A6Ly") OR contains(CommandLine, "N0cmF0dW0rdGNwOi8v") OR contains(CommandLine, "zdHJhdHVtK3RjcDovL") OR contains(CommandLine, "c3RyYXR1bSt1ZHA6Ly") OR contains(CommandLine, "N0cmF0dW0rdWRwOi8v") OR contains(CommandLine, "zdHJhdHVtK3VkcDovL"))) AND NOT (((contains(CommandLine, " pool.c ") OR contains(CommandLine, " pool.o ") OR contains(CommandLine, "gcc -")))))
