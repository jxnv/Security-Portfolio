// Title: Suspicious File Downloaded From Direct IP Via Certutil.EXE
// ID: 13e6fe51-d478-4c7e-b0f2-6da9b400a829
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-15
// Tags: attack.stealth, attack.t1027, attack.command-and-control, attack.t1105
// Description: Detects the execution of certutil with certain flags that allow the utility to download files from direct IPs.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((contains(CommandLine, "urlcache ") OR contains(CommandLine, "verifyctl ") OR contains(CommandLine, "URL "))) AND ((contains(CommandLine, "://1") OR contains(CommandLine, "://2") OR contains(CommandLine, "://3") OR contains(CommandLine, "://4") OR contains(CommandLine, "://5") OR contains(CommandLine, "://6") OR contains(CommandLine, "://7") OR contains(CommandLine, "://8") OR contains(CommandLine, "://9"))) AND ((Image="*\\certutil.exe") OR (OriginalFileName == "CertUtil.exe"))) AND NOT ((contains(CommandLine, "://7-"))))
