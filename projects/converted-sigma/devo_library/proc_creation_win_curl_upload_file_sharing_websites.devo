// Title: Curl File Upload To File Sharing Websites
// ID: e328cc73-f92a-42fb-b3fa-7c2cffda981a
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-03-29
// Tags: attack.exfiltration, attack.t1567.002
// Description: Detects usage of curl to upload files to known file sharing domains, which may indicate data exfiltration.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "0x0.st") OR contains(CommandLine, "bashupload.com") OR contains(CommandLine, "chunk.io") OR contains(CommandLine, "file.io") OR contains(CommandLine, "filebin.net") OR contains(CommandLine, "pastebin") OR contains(CommandLine, "send.firefox.com") OR contains(CommandLine, "temp.sh") OR contains(CommandLine, "transfer.sh") OR contains(CommandLine, "ufile.io") OR contains(CommandLine, "uploadfiles.io") OR contains(CommandLine, "wetransfer.com") OR contains(CommandLine, "x0.at"))) AND (((contains(CommandLine, " --form") OR contains(CommandLine, " --upload-file") OR contains(CommandLine, " --data") OR contains(CommandLine, " -X POST") OR contains(CommandLine, " --request POST "))) OR ((CommandLine=regex("\\s-[FTd]\\s") OR CommandLine=regex("\\s-sT\\s")))) AND ((Image="*\\curl.exe") OR (OriginalFileName == "curl.exe")))
