// Title: Suspicious Camera and Microphone Access
// ID: 62120148-6b7a-42be-8b91-271c04e281a3
// Status: test
// Level: high
// Author: Den Iuzvyk
// Date: 2020-06-07
// Tags: attack.collection, attack.t1125, attack.t1123
// Description: Detects Processes accessing the camera and microphone from suspicious folder
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(TargetObject, "\\Software\\Microsoft\\Windows\\CurrentVersion\\CapabilityAccessManager\\ConsentStore\\") AND contains(TargetObject, "\\NonPackaged"))) AND ((contains(TargetObject, "microphone") OR contains(TargetObject, "webcam"))) AND ((contains(TargetObject, ":#Windows#Temp#") OR contains(TargetObject, ":#$Recycle.bin#") OR contains(TargetObject, ":#Temp#") OR contains(TargetObject, ":#Users#Public#") OR contains(TargetObject, ":#Users#Default#") OR contains(TargetObject, ":#Users#Desktop#"))))
