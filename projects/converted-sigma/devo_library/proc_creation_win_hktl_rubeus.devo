// Title: HackTool - Rubeus Execution
// ID: 7ec2c172-dceb-4c10-92c9-87c1881b7e18
// Status: stable
// Level: critical
// Author: Florian Roth (Nextron Systems)
// Date: 2018-12-19
// Tags: attack.credential-access, attack.t1003, attack.t1558.003, attack.lateral-movement, attack.t1550.003
// Description: Detects the execution of the hacktool Rubeus via PE information of command line parameters
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((Image="*\\Rubeus.exe") OR (OriginalFileName == "Rubeus.exe") OR (Description == "Rubeus") OR ((contains(CommandLine, "asreproast ") OR contains(CommandLine, "dump /service:krbtgt ") OR contains(CommandLine, "dump /luid:0x") OR contains(CommandLine, "kerberoast ") OR contains(CommandLine, "createnetonly /program:") OR contains(CommandLine, "ptt /ticket:") OR contains(CommandLine, "/impersonateuser:") OR contains(CommandLine, "renew /ticket:") OR contains(CommandLine, "asktgt /user:") OR contains(CommandLine, "harvest /interval:") OR contains(CommandLine, "s4u /user:") OR contains(CommandLine, "s4u /ticket:") OR contains(CommandLine, "hash /password:") OR contains(CommandLine, "golden /aes256:") OR contains(CommandLine, "silver /user:"))))
