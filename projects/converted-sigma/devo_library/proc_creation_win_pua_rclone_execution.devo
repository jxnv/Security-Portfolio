// Title: PUA - Rclone Execution
// ID: e37db05d-d1f9-49c8-b464-cee1a4b11638
// Status: test
// Level: high
// Author: Bhabesh Raj, Sittikorn S, Aaron Greetham (@beardofbinary) - NCC Group
// Date: 2021-05-10
// Tags: attack.exfiltration, attack.t1567.002
// Description: Detects execution of RClone utility for exfiltration as used by various ransomwares strains like REvil, Conti, FiveHands, etc
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "--config ") AND contains(CommandLine, "--no-check-certificate ") AND contains(CommandLine, " copy "))) OR (((contains(CommandLine, "pass") OR contains(CommandLine, "user") OR contains(CommandLine, "copy") OR contains(CommandLine, "sync") OR contains(CommandLine, "config") OR contains(CommandLine, "lsd") OR contains(CommandLine, "remote") OR contains(CommandLine, "ls") OR contains(CommandLine, "mega") OR contains(CommandLine, "pcloud") OR contains(CommandLine, "ftp") OR contains(CommandLine, "ignore-existing") OR contains(CommandLine, "auto-confirm") OR contains(CommandLine, "transfers") OR contains(CommandLine, "multi-thread-streams") OR contains(CommandLine, "no-check-certificate "))) AND ((Image="*\\rclone.exe") OR (Description == "Rsync for cloud storage"))))
