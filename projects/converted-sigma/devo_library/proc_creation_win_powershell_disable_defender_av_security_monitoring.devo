// Title: Disable Windows Defender AV Security Monitoring
// ID: a7ee1722-c3c5-aeff-3212-c777e4733217
// Status: test
// Level: high
// Author: ok @securonix invrep-de, oscd.community, frack113
// Date: 2020-10-12
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects attackers attempting to disable Windows Defender using Powershell
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((((Image="*\\powershell.exe" OR Image="*\\pwsh.exe")) OR ((OriginalFileName == "PowerShell.EXE" OR OriginalFileName == "pwsh.dll"))) AND ((contains(CommandLine, "-DisableBehaviorMonitoring $true") OR contains(CommandLine, "-DisableRuntimeMonitoring $true")))) OR (((Image="*\\sc.exe") OR (OriginalFileName == "sc.exe")) AND (((contains(CommandLine, "delete") AND contains(CommandLine, "WinDefend"))) OR ((contains(CommandLine, "config") AND contains(CommandLine, "WinDefend") AND contains(CommandLine, "start=disabled"))) OR ((contains(CommandLine, "stop") AND contains(CommandLine, "WinDefend"))))))
