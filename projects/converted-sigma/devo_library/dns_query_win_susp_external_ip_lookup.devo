// Title: Suspicious DNS Query for IP Lookup Service APIs
// ID: ec82e2a5-81ea-4211-a1f8-37a0286df2c2
// Status: test
// Level: medium
// Author: Brandon George (blog post), Thomas Patzke
// Date: 2021-07-08
// Tags: attack.reconnaissance, attack.t1590
// Description: Detects DNS queries for IP lookup services such as "api.ipify.org" originating from a non browser process.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((QueryName == "www.ip.cn" OR QueryName == "l2.io")) OR ((contains(QueryName, "api.2ip.ua") OR contains(QueryName, "api.bigdatacloud.net") OR contains(QueryName, "api.ipify.org") OR contains(QueryName, "bot.whatismyipaddress.com") OR contains(QueryName, "canireachthe.net") OR contains(QueryName, "checkip.amazonaws.com") OR contains(QueryName, "checkip.dyndns.org") OR contains(QueryName, "curlmyip.com") OR contains(QueryName, "db-ip.com") OR contains(QueryName, "edns.ip-api.com") OR contains(QueryName, "eth0.me") OR contains(QueryName, "freegeoip.app") OR contains(QueryName, "geoipy.com") OR contains(QueryName, "getip.pro") OR contains(QueryName, "icanhazip.com") OR contains(QueryName, "ident.me") OR contains(QueryName, "ifconfig.io") OR contains(QueryName, "ifconfig.me") OR contains(QueryName, "ip-api.com") OR contains(QueryName, "ip.360.cn") OR contains(QueryName, "ip.anysrc.net") OR contains(QueryName, "ip.taobao.com") OR contains(QueryName, "ip.tyk.nu") OR contains(QueryName, "ipaddressworld.com") OR contains(QueryName, "ipapi.co") OR contains(QueryName, "ipconfig.io") OR contains(QueryName, "ipecho.net") OR contains(QueryName, "ipinfo.io") OR contains(QueryName, "ipip.net") OR contains(QueryName, "ipof.in") OR contains(QueryName, "ipv4.icanhazip.com") OR contains(QueryName, "ipv4bot.whatismyipaddress.com") OR contains(QueryName, "ipv6-test.com") OR contains(QueryName, "ipwho.is") OR contains(QueryName, "jsonip.com") OR contains(QueryName, "myexternalip.com") OR contains(QueryName, "seeip.org") OR contains(QueryName, "wgetip.com") OR contains(QueryName, "whatismyip.akamai.com") OR contains(QueryName, "whois.pconline.com.cn") OR contains(QueryName, "wtfismyip.com")))) AND NOT (((Image="*\\brave.exe") OR ((Image == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR Image == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((Image="C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*") OR (Image="*\\WindowsApps\\MicrosoftEdge.exe") OR ((Image == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR Image == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((Image="C:\\Program Files (x86)\\Microsoft\\EdgeCore\\*" OR Image="C:\\Program Files\\Microsoft\\EdgeCore\\*") AND (Image="*\\msedge.exe" OR Image="*\\msedgewebview2.exe")) OR ((Image == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR Image == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR ((Image == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR Image == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (Image="*\\maxthon.exe") OR (Image="*\\opera.exe") OR (Image="*\\safari.exe") OR (Image="*\\seamonkey.exe") OR (Image="*\\vivaldi.exe") OR (Image="*\\whale.exe"))))
