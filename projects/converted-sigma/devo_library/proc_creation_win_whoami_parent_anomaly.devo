// Title: Whoami.EXE Execution Anomaly
// ID: 8de1cbe8-d6f5-496d-8237-5f44a721c7a0
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2021-08-12
// Tags: attack.discovery, attack.t1033, car.2016-03-001
// Description: Detects the execution of whoami.exe with suspicious parent processes.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((Image="*\\whoami.exe") OR (OriginalFileName == "whoami.exe")) AND NOT ((((ParentImage="*\\cmd.exe" OR ParentImage="*\\powershell_ise.exe" OR ParentImage="*\\powershell.exe" OR ParentImage="*\\pwsh.exe")) OR ((ParentImage == "" OR ParentImage == "-")) OR (NOT ParentImage=*))) AND NOT ((ParentImage="*:\\Program Files\\Microsoft Monitoring Agent\\Agent\\MonitoringHost.exe")))
