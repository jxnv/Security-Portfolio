// Title: Suspicious Program Names
// ID: efdd8dd5-cee8-4e59-9390-7d4d5e4dd6f6
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-11
// Tags: attack.execution, attack.t1059
// Description: Detects suspicious patterns in program names or folders that are often found in malicious samples or hacktools
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "inject.ps1") OR contains(CommandLine, "Invoke-CVE") OR contains(CommandLine, "pupy.ps1") OR contains(CommandLine, "payload.ps1") OR contains(CommandLine, "beacon.ps1") OR contains(CommandLine, "PowerView.ps1") OR contains(CommandLine, "bypass.ps1") OR contains(CommandLine, "obfuscated.ps1") OR contains(CommandLine, "obfusc.ps1") OR contains(CommandLine, "obfus.ps1") OR contains(CommandLine, "obfs.ps1") OR contains(CommandLine, "evil.ps1") OR contains(CommandLine, "MiniDogz.ps1") OR contains(CommandLine, "_enc.ps1") OR contains(CommandLine, "\\shell.ps1") OR contains(CommandLine, "\\rshell.ps1") OR contains(CommandLine, "revshell.ps1") OR contains(CommandLine, "\\av.ps1") OR contains(CommandLine, "\\av_test.ps1") OR contains(CommandLine, "adrecon.ps1") OR contains(CommandLine, "mimikatz.ps1") OR contains(CommandLine, "\\PowerUp_") OR contains(CommandLine, "powerup.ps1") OR contains(CommandLine, "\\Temp\\a.ps1") OR contains(CommandLine, "\\Temp\\p.ps1") OR contains(CommandLine, "\\Temp\\1.ps1") OR contains(CommandLine, "Hound.ps1") OR contains(CommandLine, "encode.ps1") OR contains(CommandLine, "powercat.ps1"))) OR (((contains(Image, "\\CVE-202") OR contains(Image, "\\CVE202"))) OR ((Image="*\\poc.exe" OR Image="*\\artifact.exe" OR Image="*\\artifact64.exe" OR Image="*\\artifact_protected.exe" OR Image="*\\artifact32.exe" OR Image="*\\artifact32big.exe" OR Image="*obfuscated.exe" OR Image="*obfusc.exe" OR Image="*\\meterpreter"))))
