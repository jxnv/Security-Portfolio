// Title: Vim GTFOBin Abuse - Linux
// ID: 7ab8f73a-fcff-428b-84aa-6a5ff7877dea
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Luc Génaux
// Date: 2022-12-28
// Tags: attack.execution, attack.discovery, attack.t1059, attack.t1083
// Description: Detects the use of "vim" and it's siblings commands to execute a shell or proxy commands.
// Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, ":!/") OR contains(CommandLine, ":!$") OR contains(CommandLine, ":!..") OR contains(CommandLine, ":lua ") OR contains(CommandLine, ":py ") OR contains(CommandLine, ":shell") OR contains(CommandLine, "/bin/bash") OR contains(CommandLine, "/bin/dash") OR contains(CommandLine, "/bin/fish") OR contains(CommandLine, "/bin/sh") OR contains(CommandLine, "/bin/csh") OR contains(CommandLine, "/bin/ksh") OR contains(CommandLine, "/bin/zsh") OR contains(CommandLine, "/bin/tmux"))) AND ((Image="*/rvim" OR Image="*/vi" OR Image="*/vim" OR Image="*/vimdiff") AND (contains(CommandLine, " --cmd ") OR contains(CommandLine, " -c"))))
