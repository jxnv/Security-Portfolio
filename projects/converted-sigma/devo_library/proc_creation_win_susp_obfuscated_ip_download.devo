// Title: Obfuscated IP Download Activity
// ID: cb5a2333-56cf-4562-8fcb-22ba1bca728d
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2022-08-03
// Tags: attack.discovery
// Description: Detects use of an encoded/obfuscated version of an IP address (hex, octal...) in an URL combined with a download command
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "Invoke-WebRequest") OR contains(CommandLine, "iwr ") OR contains(CommandLine, "Invoke-RestMethod") OR contains(CommandLine, "irm ") OR contains(CommandLine, "wget ") OR contains(CommandLine, "curl ") OR contains(CommandLine, "DownloadFile") OR contains(CommandLine, "DownloadString"))) AND (((contains(CommandLine, " 0x") OR contains(CommandLine, "//0x") OR contains(CommandLine, ".0x") OR contains(CommandLine, ".00x"))) OR ((contains(CommandLine, "http://%") AND contains(CommandLine, "%2e"))) OR ((CommandLine=regex("https?://[0-9]{1,3}\\.[0-9]{1,3}\\.0[0-9]{3,4}")) OR (CommandLine=regex("https?://[0-9]{1,3}\\.0[0-9]{3,7}")) OR (CommandLine=regex("https?://0[0-9]{3,11}")) OR (CommandLine=regex("https?://(?:0[0-9]{1,11}\\.){3}0[0-9]{1,11}")) OR (CommandLine=regex("https?://0[0-9]{1,11}")) OR (CommandLine=regex(" [0-7]{7,13}")))) AND NOT ((CommandLine=regex("https?://(?:(?:25[0-5]|(?:2[0-4]|1\\d|[1-9])?\\d)(?:\\.|\\b)){4}"))))
