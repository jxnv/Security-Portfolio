// Title: Local System Accounts Discovery - Linux
// ID: b45e3d6f-42c6-47d8-a478-df6bd6cf534c
// Status: test
// Level: low
// Author: Alejandro Ortuno, oscd.community, CheraghiMilad
// Date: 2020-10-08
// Tags: attack.discovery, attack.t1087.001
// Description: Detects enumeration of local system accounts. This information can help adversaries determine which local accounts exist on a system to aid in follow-on behavior.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((Image="*/lastlog") OR (contains(CommandLine, "'x:0:'")) OR ((Image="*/cat" OR Image="*/ed" OR Image="*/head" OR Image="*/more" OR Image="*/nano" OR Image="*/tail" OR Image="*/vi" OR Image="*/vim" OR Image="*/less" OR Image="*/emacs" OR Image="*/sqlite3" OR Image="*/makemap") AND (contains(CommandLine, "/etc/passwd") OR contains(CommandLine, "/etc/shadow") OR contains(CommandLine, "/etc/sudoers") OR contains(CommandLine, "/etc/spwd.db") OR contains(CommandLine, "/etc/pwd.db") OR contains(CommandLine, "/etc/master.passwd"))) OR (Image="*/id") OR (Image="*/lsof" AND contains(CommandLine, "-u")))
