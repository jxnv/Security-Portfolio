// Title: WMImplant Hack Tool
// ID: 8028c2c3-e25a-46e3-827f-bbb5abf181d7
// Status: test
// Level: high
// Author: NVISO
// Date: 2020-03-26
// Tags: attack.execution, attack.t1047, attack.t1059.001
// Description: Detects parameters used by WMImplant
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(ScriptBlockText, "WMImplant") OR contains(ScriptBlockText, " change_user ") OR contains(ScriptBlockText, " gen_cli ") OR contains(ScriptBlockText, " command_exec ") OR contains(ScriptBlockText, " disable_wdigest ") OR contains(ScriptBlockText, " disable_winrm ") OR contains(ScriptBlockText, " enable_wdigest ") OR contains(ScriptBlockText, " enable_winrm ") OR contains(ScriptBlockText, " registry_mod ") OR contains(ScriptBlockText, " remote_posh ") OR contains(ScriptBlockText, " sched_job ") OR contains(ScriptBlockText, " service_mod ") OR contains(ScriptBlockText, " process_kill ") OR contains(ScriptBlockText, " active_users ") OR contains(ScriptBlockText, " basic_info ") OR contains(ScriptBlockText, " power_off ") OR contains(ScriptBlockText, " vacant_system ") OR contains(ScriptBlockText, " logon_events ")))
