// Title: Invoke-Obfuscation VAR++ LAUNCHER OBFUSCATION
// ID: e9f55347-2928-4c06-88e5-1a7f8169942e
// Status: test
// Level: high
// Author: Timur Zinniatullin, oscd.community
// Date: 2020-10-13
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via VAR++ LAUNCHER
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(CommandLine, "&&set") AND contains(CommandLine, "cmd") AND contains(CommandLine, "/c") AND contains(CommandLine, "-f")) AND (contains(CommandLine, "{0}") OR contains(CommandLine, "{1}") OR contains(CommandLine, "{2}") OR contains(CommandLine, "{3}") OR contains(CommandLine, "{4}") OR contains(CommandLine, "{5}")))
