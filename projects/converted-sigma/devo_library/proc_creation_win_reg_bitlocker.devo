// Title: Suspicious Reg Add BitLocker
// ID: 0e0255bf-2548-47b8-9582-c0955c9283f5
// Status: test
// Level: high
// Author: frack113
// Date: 2021-11-15
// Tags: attack.impact, attack.t1486
// Description: Detects suspicious addition to BitLocker related registry keys via the reg.exe utility
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(CommandLine, "REG") AND contains(CommandLine, "ADD") AND contains(CommandLine, "\\SOFTWARE\\Policies\\Microsoft\\FVE") AND contains(CommandLine, "/v") AND contains(CommandLine, "/f")) AND (contains(CommandLine, "EnableBDEWithNoTPM") OR contains(CommandLine, "UseAdvancedStartup") OR contains(CommandLine, "UseTPM") OR contains(CommandLine, "UseTPMKey") OR contains(CommandLine, "UseTPMKeyPIN") OR contains(CommandLine, "RecoveryKeyMessageSource") OR contains(CommandLine, "UseTPMPIN") OR contains(CommandLine, "RecoveryKeyMessage")))
