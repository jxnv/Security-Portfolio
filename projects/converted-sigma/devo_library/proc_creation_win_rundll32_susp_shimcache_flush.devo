// Title: ShimCache Flush
// ID: b0524451-19af-4efa-a46f-562a977f792e
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-02-01
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects actions that clear the local ShimCache and remove forensic evidence
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((contains(CommandLine, "rundll32") AND contains(CommandLine, "apphelp.dll"))) AND ((contains(CommandLine, "ShimFlushCache") OR contains(CommandLine, "#250")))) OR (((contains(CommandLine, "rundll32") AND contains(CommandLine, "kernel32.dll"))) AND ((contains(CommandLine, "BaseFlushAppcompatCache") OR contains(CommandLine, "#46")))))
