// Title: PowerView PowerShell Cmdlets - ScriptBlock
// ID: dcd74b95-3f36-4ed9-9598-0490951643aa
// Status: test
// Level: high
// Author: Bhabesh Raj
// Date: 2021-05-18
// Tags: attack.execution, attack.t1059.001
// Description: Detects Cmdlet names from PowerView of the PowerSploit exploitation framework.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(ScriptBlockText, "Export-PowerViewCSV") OR contains(ScriptBlockText, "Find-DomainLocalGroupMember") OR contains(ScriptBlockText, "Find-DomainObjectPropertyOutlier") OR contains(ScriptBlockText, "Find-DomainProcess") OR contains(ScriptBlockText, "Find-DomainShare") OR contains(ScriptBlockText, "Find-DomainUserEvent") OR contains(ScriptBlockText, "Find-DomainUserLocation") OR contains(ScriptBlockText, "Find-ForeignGroup") OR contains(ScriptBlockText, "Find-ForeignUser") OR contains(ScriptBlockText, "Find-GPOComputerAdmin") OR contains(ScriptBlockText, "Find-GPOLocation") OR contains(ScriptBlockText, "Find-InterestingDomain") OR contains(ScriptBlockText, "Find-InterestingFile") OR contains(ScriptBlockText, "Find-LocalAdminAccess") OR contains(ScriptBlockText, "Find-ManagedSecurityGroups") OR contains(ScriptBlockText, "Get-CachedRDPConnection") OR contains(ScriptBlockText, "Get-DFSshare") OR contains(ScriptBlockText, "Get-DomainDFSShare") OR contains(ScriptBlockText, "Get-DomainDNSRecord") OR contains(ScriptBlockText, "Get-DomainDNSZone") OR contains(ScriptBlockText, "Get-DomainFileServer") OR contains(ScriptBlockText, "Get-DomainGPOComputerLocalGroupMapping") OR contains(ScriptBlockText, "Get-DomainGPOLocalGroup") OR contains(ScriptBlockText, "Get-DomainGPOUserLocalGroupMapping") OR contains(ScriptBlockText, "Get-LastLoggedOn") OR contains(ScriptBlockText, "Get-LoggedOnLocal") OR contains(ScriptBlockText, "Get-NetFileServer") OR contains(ScriptBlockText, "Get-NetForest") OR contains(ScriptBlockText, "Get-NetGPOGroup") OR contains(ScriptBlockText, "Get-NetProcess") OR contains(ScriptBlockText, "Get-NetRDPSession") OR contains(ScriptBlockText, "Get-RegistryMountedDrive") OR contains(ScriptBlockText, "Get-RegLoggedOn") OR contains(ScriptBlockText, "Get-WMIRegCachedRDPConnection") OR contains(ScriptBlockText, "Get-WMIRegLastLoggedOn") OR contains(ScriptBlockText, "Get-WMIRegMountedDrive") OR contains(ScriptBlockText, "Get-WMIRegProxy") OR contains(ScriptBlockText, "Invoke-ACLScanner") OR contains(ScriptBlockText, "Invoke-CheckLocalAdminAccess") OR contains(ScriptBlockText, "Invoke-EnumerateLocalAdmin") OR contains(ScriptBlockText, "Invoke-EventHunter") OR contains(ScriptBlockText, "Invoke-FileFinder") OR contains(ScriptBlockText, "Invoke-Kerberoast") OR contains(ScriptBlockText, "Invoke-MapDomainTrust") OR contains(ScriptBlockText, "Invoke-ProcessHunter") OR contains(ScriptBlockText, "Invoke-RevertToSelf") OR contains(ScriptBlockText, "Invoke-ShareFinder") OR contains(ScriptBlockText, "Invoke-UserHunter") OR contains(ScriptBlockText, "Invoke-UserImpersonation") OR contains(ScriptBlockText, "Remove-RemoteConnection") OR contains(ScriptBlockText, "Request-SPNTicket") OR contains(ScriptBlockText, "Resolve-IPAddress")))
