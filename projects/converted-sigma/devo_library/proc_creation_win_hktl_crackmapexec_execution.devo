// Title: HackTool - CrackMapExec Execution
// ID: 42a993dd-bb3e-48c8-b372-4d6684c4106c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-25
// Tags: attack.execution, attack.persistence, attack.privilege-escalation, attack.credential-access, attack.discovery, attack.t1047, attack.t1053, attack.t1059.003, attack.t1059.001, attack.t1110, attack.t1201
// Description: This rule detect common flag combinations used by CrackMapExec in order to detect its use even if the binary has been replaced.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((Image="*\\crackmapexec.exe") OR ((contains(CommandLine, " --local-auth") AND contains(CommandLine, " -u ") AND contains(CommandLine, " -x "))) OR ((contains(CommandLine, " --local-auth") AND contains(CommandLine, " -u ") AND contains(CommandLine, " -p ") AND contains(CommandLine, " -H 'NTHASH'"))) OR ((contains(CommandLine, " mssql ") AND contains(CommandLine, " -u ") AND contains(CommandLine, " -p ") AND contains(CommandLine, " -M ") AND contains(CommandLine, " -d "))) OR ((contains(CommandLine, " smb ") AND contains(CommandLine, " -u ") AND contains(CommandLine, " -H ") AND contains(CommandLine, " -M ") AND contains(CommandLine, " -o "))) OR ((contains(CommandLine, " smb ") AND contains(CommandLine, " -u ") AND contains(CommandLine, " -p ") AND contains(CommandLine, " --local-auth"))) OR (contains(CommandLine, " -M pe_inject "))) OR (((contains(CommandLine, " --local-auth") AND contains(CommandLine, " -u ") AND contains(CommandLine, " -p "))) AND ((contains(CommandLine, " 10.") AND contains(CommandLine, " 192.168.") AND contains(CommandLine, "/24 ")))))
