// Title: Local Groups Discovery - MacOs
// ID: 89bb1f97-c7b9-40e8-b52b-7d6afbd67276
// Status: test
// Level: informational
// Author: Ömer Günal, Alejandro Ortuno, oscd.community
// Date: 2020-10-11
// Tags: attack.discovery, attack.t1069.001
// Description: Detects enumeration of local system groups
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((Image="*/dscacheutil" AND (contains(CommandLine, "-q") AND contains(CommandLine, "group"))) OR (Image="*/cat" AND contains(CommandLine, "/etc/group")) OR (Image="*/dscl" AND (contains(CommandLine, "-list") AND contains(CommandLine, "/groups"))))
