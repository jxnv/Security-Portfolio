// Title: Potential Encoded PowerShell Patterns In CommandLine
// ID: cdf05894-89e7-4ead-b2b0-0a5f97a90f2f
// Status: test
// Level: low
// Author: Teymur Kheirkhabarov (idea), Vasiliy Burov (rule), oscd.community, Tim Shelton
// Date: 2020-10-11
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects specific combinations of encoding methods in PowerShell via the commandline
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((Image="*\\powershell.exe" OR Image="*\\pwsh.exe")) OR ((OriginalFileName == "PowerShell.EXE" OR OriginalFileName == "pwsh.dll"))) AND ((((contains(CommandLine, "ToInt") OR contains(CommandLine, "ToDecimal") OR contains(CommandLine, "ToByte") OR contains(CommandLine, "ToUint") OR contains(CommandLine, "ToSingle") OR contains(CommandLine, "ToSByte"))) AND ((contains(CommandLine, "ToChar") OR contains(CommandLine, "ToString") OR contains(CommandLine, "String")))) OR (((contains(CommandLine, "char") AND contains(CommandLine, "join"))) OR ((contains(CommandLine, "split") AND contains(CommandLine, "join"))))))
