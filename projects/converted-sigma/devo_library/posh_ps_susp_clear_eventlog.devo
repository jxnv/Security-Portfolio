// Title: Suspicious Eventlog Clear
// ID: 0f017df3-8f5a-414f-ad6b-24aff1128278
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2022-09-12
// Tags: attack.defense-impairment, attack.t1685.005
// Description: Detects usage of known powershell cmdlets such as "Clear-EventLog" to clear the Windows event logs
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(ScriptBlockText, "Clear-EventLog ") OR contains(ScriptBlockText, "Remove-EventLog ") OR contains(ScriptBlockText, "Limit-EventLog ") OR contains(ScriptBlockText, "Clear-WinEvent "))) OR ((contains(ScriptBlockText, "Eventing.Reader.EventLogSession") AND contains(ScriptBlockText, "ClearLog"))) OR ((contains(ScriptBlockText, "Diagnostics.EventLog") AND contains(ScriptBlockText, "Clear"))))
