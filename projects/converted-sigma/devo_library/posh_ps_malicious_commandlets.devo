// Title: Malicious PowerShell Commandlets - ScriptBlock
// ID: 89819aa4-bbd6-46bc-88ec-c7f7fe30efa6
// Status: test
// Level: high
// Author: Sean Metcalf, Florian Roth, Bartlomiej Czyz @bczyz1, oscd.community, Nasreddine Bencherchali, Tim Shelton, Mustafa Kaan Demir, Georg Lauenstein, Max Altgelt, Tobias Michalski, Austin Songer
// Date: 2017-03-05
// Tags: attack.execution, attack.discovery, attack.t1482, attack.t1087, attack.t1087.001, attack.t1087.002, attack.t1069.001, attack.t1069.002, attack.t1069, attack.t1059.001
// Description: Detects Commandlet names from well-known PowerShell exploitation frameworks
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(ScriptBlockText, "Add-Exfiltration") OR contains(ScriptBlockText, "Add-Persistence") OR contains(ScriptBlockText, "Add-RegBackdoor") OR contains(ScriptBlockText, "Add-RemoteRegBackdoor") OR contains(ScriptBlockText, "Add-ScrnSaveBackdoor") OR contains(ScriptBlockText, "ConvertTo-Rc4ByteStream") OR contains(ScriptBlockText, "Decrypt-Hash") OR contains(ScriptBlockText, "Disable-ADIDNSNode") OR contains(ScriptBlockText, "Do-Exfiltration") OR contains(ScriptBlockText, "Enable-ADIDNSNode") OR contains(ScriptBlockText, "Enabled-DuplicateToken") OR contains(ScriptBlockText, "Exploit-Jboss") OR contains(ScriptBlockText, "Export-ADRCSV") OR contains(ScriptBlockText, "Export-ADRExcel") OR contains(ScriptBlockText, "Export-ADRHTML") OR contains(ScriptBlockText, "Export-ADRJSON") OR contains(ScriptBlockText, "Export-ADRXML") OR contains(ScriptBlockText, "Find-Fruit") OR contains(ScriptBlockText, "Find-GPOLocation") OR contains(ScriptBlockText, "Find-TrustedDocuments") OR contains(ScriptBlockText, "Get-ADIDNSNodeAttribute") OR contains(ScriptBlockText, "Get-ADIDNSNodeOwner") OR contains(ScriptBlockText, "Get-ADIDNSNodeTombstoned") OR contains(ScriptBlockText, "Get-ADIDNSPermission") OR contains(ScriptBlockText, "Get-ADIDNSZone") OR contains(ScriptBlockText, "Get-ChromeDump") OR contains(ScriptBlockText, "Get-ClipboardContents") OR contains(ScriptBlockText, "Get-FoxDump") OR contains(ScriptBlockText, "Get-GPPPassword") OR contains(ScriptBlockText, "Get-IndexedItem") OR contains(ScriptBlockText, "Get-KerberosAESKey") OR contains(ScriptBlockText, "Get-Keystrokes") OR contains(ScriptBlockText, "Get-LSASecret") OR contains(ScriptBlockText, "Get-PassHashes") OR contains(ScriptBlockText, "Get-RegAlwaysInstallElevated") OR contains(ScriptBlockText, "Get-RegAutoLogon") OR contains(ScriptBlockText, "Get-RemoteBootKey") OR contains(ScriptBlockText, "Get-RemoteCachedCredential") OR contains(ScriptBlockText, "Get-RemoteLocalAccountHash") OR contains(ScriptB