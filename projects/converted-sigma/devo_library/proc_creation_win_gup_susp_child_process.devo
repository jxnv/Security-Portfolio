// Title: Suspicious Child Process of Notepad++ Updater - GUP.Exe
// ID: bb0e87ce-c89f-4857-84fa-095e4483e9cb
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-02-03
// Tags: attack.collection, attack.credential-access, attack.t1195.002, attack.initial-access, attack.t1557
// Description: Detects suspicious child process creation by the Notepad++ updater process (gup.exe).
// This could indicate potential exploitation of the updater component to deliver unwanted malware.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((ParentImage="*\\gup.exe") AND (((contains(CommandLine, "bitsadmin") OR contains(CommandLine, "certutil") OR contains(CommandLine, "curl") OR contains(CommandLine, "finger") OR contains(CommandLine, "forfiles") OR contains(CommandLine, "regsvr32") OR contains(CommandLine, "rundll32") OR contains(CommandLine, "wget"))) OR ((Image="*\\cmd.exe" OR Image="*\\powershell.exe" OR Image="*\\pwsh.exe" OR Image="*\\cscript.exe" OR Image="*\\wscript.exe" OR Image="*\\mshta.exe"))))
