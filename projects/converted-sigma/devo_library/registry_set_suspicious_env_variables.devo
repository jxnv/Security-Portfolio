// Title: Suspicious Environment Variable Has Been Registered
// ID: 966315ef-c5e1-4767-ba25-fce9c8de3660
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-20
// Tags: attack.persistence, attack.stealth
// Description: Detects the creation of user-specific or system-wide environment variables via the registry. Which contains suspicious commands and strings
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((Details == "powershell" OR Details == "pwsh")) OR ((contains(Details, "\\AppData\\Local\\Temp\\") OR contains(Details, "C:\\Users\\Public\\") OR contains(Details, "TVqQAAMAAAAEAAAA") OR contains(Details, "TVpQAAIAAAAEAA8A") OR contains(Details, "TVqAAAEAAAAEABAA") OR contains(Details, "TVoAAAAAAAAAAAAA") OR contains(Details, "TVpTAQEAAAAEAAAA") OR contains(Details, "SW52b2tlL") OR contains(Details, "ludm9rZS") OR contains(Details, "JbnZva2Ut") OR contains(Details, "SQBuAHYAbwBrAGUALQ") OR contains(Details, "kAbgB2AG8AawBlAC0A") OR contains(Details, "JAG4AdgBvAGsAZQAtA"))) OR ((Details="SUVY*" OR Details="SQBFAF*" OR Details="SQBuAH*" OR Details="cwBhA*" OR Details="aWV4*" OR Details="aQBlA*" OR Details="R2V0*" OR Details="dmFy*" OR Details="dgBhA*" OR Details="dXNpbm*" OR Details="H4sIA*" OR Details="Y21k*" OR Details="cABhAH*" OR Details="Qzpc*" OR Details="Yzpc*"))) AND (contains(TargetObject, "\\Environment\\")))
