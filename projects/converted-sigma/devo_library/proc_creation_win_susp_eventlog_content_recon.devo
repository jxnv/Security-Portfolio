// Title: Potentially Suspicious EventLog Recon Activity Using Log Query Utilities
// ID: beaa66d6-aa1b-4e3c-80f5-e0145369bfaf
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.credential-access, attack.discovery, attack.t1552, attack.t1087
// Description: Detects execution of different log query utilities and commands to search and dump the content of specific event logs or look for specific event IDs.
// This technique is used by threat actors in order to extract sensitive information from events logs such as usernames, IP addresses, hostnames, etc.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((contains(CommandLine, "-InstanceId 462?") OR contains(CommandLine, ".eventid -eq 462?") OR contains(CommandLine, ".ID -eq 462?") OR contains(CommandLine, "EventCode=?462?") OR contains(CommandLine, "EventIdentifier=?462?") OR contains(CommandLine, "System[EventID=462?]") OR contains(CommandLine, "-InstanceId 4778") OR contains(CommandLine, ".eventid -eq 4778") OR contains(CommandLine, ".ID -eq 4778") OR contains(CommandLine, "EventCode=?4778?") OR contains(CommandLine, "EventIdentifier=?4778?") OR contains(CommandLine, "System[EventID=4778]") OR contains(CommandLine, "-InstanceId 25") OR contains(CommandLine, ".eventid -eq 25") OR contains(CommandLine, ".ID -eq 25") OR contains(CommandLine, "EventCode=?25?") OR contains(CommandLine, "EventIdentifier=?25?") OR contains(CommandLine, "System[EventID=25]") OR contains(CommandLine, "-InstanceId 1149") OR contains(CommandLine, ".eventid -eq 1149") OR contains(CommandLine, ".ID -eq 1149") OR contains(CommandLine, "EventCode=?1149?") OR contains(CommandLine, "EventIdentifier=?1149?") OR contains(CommandLine, "System[EventID=1149]") OR contains(CommandLine, "-InstanceId 21") OR contains(CommandLine, ".eventid -eq 21") OR contains(CommandLine, ".ID -eq 21") OR contains(CommandLine, "EventCode=?21?") OR contains(CommandLine, "EventIdentifier=?21?") OR contains(CommandLine, "System[EventID=21]") OR contains(CommandLine, "-InstanceId 22") OR contains(CommandLine, ".eventid -eq 22") OR contains(CommandLine, ".ID -eq 22") OR contains(CommandLine, "EventCode=?22?") OR contains(CommandLine, "EventIdentifier=?22?") OR contains(CommandLine, "System[EventID=22]"))) OR ((contains(CommandLine, "Microsoft-Windows-PowerShell") OR contains(CommandLine, "Microsoft-Windows-Security-Auditing") OR contains(CommandLine, "Microsoft-Windows-TerminalServices-LocalSessionManager") OR contains(CommandLine, "Microsoft-Windows-TerminalServices-RemoteConnectionManager") OR contains(CommandLine, "Microsoft-Windows-Windows Defender") OR contains(CommandLine, "PowerShellCore") OR contains(CommandLine, "Security") OR contains(CommandLine, "Windows PowerShell")))) AND (((contains(CommandLine, "Select") AND contains(CommandLine, "Win32_NTLogEvent"))) OR (((contains(CommandLine, " qe ") OR contains(CommandLine, " query-events "))) AND ((Image="*\\wevtutil.exe") OR (OriginalFileName == "wevtutil.exe"))) OR ((contains(CommandLine, " ntevent")) AND ((Image="*\\wmic.exe") OR (OriginalFileName == "wmic.exe"))) OR ((contains(CommandLine, "Get-WinEvent ") OR contains(CommandLine, "get-eventlog ")))))
