// Description: Detects disabling security tools
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ("stopping iptables" OR "stopping ip6tables" OR "stopping firewalld" OR "stopping cbdaemon" OR "stopping falcon-sensor")
