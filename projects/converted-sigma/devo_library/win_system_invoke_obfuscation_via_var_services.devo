// Title: Invoke-Obfuscation VAR++ LAUNCHER OBFUSCATION - System
// ID: 14bcba49-a428-42d9-b943-e2ce0f0f7ae6
// Status: test
// Level: high
// Author: Timur Zinniatullin, oscd.community
// Date: 2020-10-13
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via VAR++ LAUNCHER
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (Provider_Name == "Service Control Manager" AND EventID == "7045" AND (contains(ImagePath, "&&set") AND contains(ImagePath, "cmd") AND contains(ImagePath, "/c") AND contains(ImagePath, "-f")) AND (contains(ImagePath, "{0}") OR contains(ImagePath, "{1}") OR contains(ImagePath, "{2}") OR contains(ImagePath, "{3}") OR contains(ImagePath, "{4}") OR contains(ImagePath, "{5}")))
