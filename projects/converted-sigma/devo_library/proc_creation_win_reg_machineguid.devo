// Title: Suspicious Query of MachineGUID
// ID: f5240972-3938-4e56-8e4b-e33893176c1f
// Status: test
// Level: low
// Author: frack113
// Date: 2022-01-01
// Tags: attack.discovery, attack.t1082
// Description: Use of reg to get MachineGuid information
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (Image="*\\reg.exe" AND (contains(CommandLine, "SOFTWARE\\Microsoft\\Cryptography") AND contains(CommandLine, "/v ") AND contains(CommandLine, "MachineGuid")))
