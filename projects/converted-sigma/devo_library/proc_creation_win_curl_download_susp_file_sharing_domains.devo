// Title: Suspicious File Download From File Sharing Domain Via Curl.EXE
// ID: 56454143-524f-49fb-b1c6-3fb8b1ad41fb
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-05
// Tags: attack.execution
// Description: Detects potentially suspicious file download from file sharing domains using curl.exe
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((CommandLine="*.ps1" OR CommandLine="*.ps1'" OR CommandLine="*.ps1\"" OR CommandLine="*.dat" OR CommandLine="*.dat'" OR CommandLine="*.dat\"" OR CommandLine="*.msi" OR CommandLine="*.msi'" OR CommandLine="*.msi\"" OR CommandLine="*.bat" OR CommandLine="*.bat'" OR CommandLine="*.bat\"" OR CommandLine="*.exe" OR CommandLine="*.exe'" OR CommandLine="*.exe\"" OR CommandLine="*.vbs" OR CommandLine="*.vbs'" OR CommandLine="*.vbs\"" OR CommandLine="*.vbe" OR CommandLine="*.vbe'" OR CommandLine="*.vbe\"" OR CommandLine="*.hta" OR CommandLine="*.hta'" OR CommandLine="*.hta\"" OR CommandLine="*.dll" OR CommandLine="*.dll'" OR CommandLine="*.dll\"" OR CommandLine="*.psm1" OR CommandLine="*.psm1'" OR CommandLine="*.psm1\"")) AND ((contains(CommandLine, " -O") OR contains(CommandLine, "--remote-name") OR contains(CommandLine, "--output"))) AND (contains(CommandLine, "http")) AND ((Image="*\\curl.exe") OR (OriginalFileName == "curl.exe")) AND ((contains(CommandLine, ".githubusercontent.com") OR contains(CommandLine, "0x0.st") OR contains(CommandLine, "anonfiles.com") OR contains(CommandLine, "bashupload.com") OR contains(CommandLine, "cdn.discordapp.com") OR contains(CommandLine, "chunk.io") OR contains(CommandLine, "ddns.net") OR contains(CommandLine, "dl.dropboxusercontent.com") OR contains(CommandLine, "ghostbin.co") OR contains(CommandLine, "github.com") OR contains(CommandLine, "glitch.me") OR contains(CommandLine, "gofile.io") OR contains(CommandLine, "hastebin.com") OR contains(CommandLine, "mediafire.com") OR contains(CommandLine, "mega.nz") OR contains(CommandLine, "onrender.com") OR contains(CommandLine, "pages.dev") OR contains(CommandLine, "paste.ee") OR contains(CommandLine, "pastebin.com") OR contains(CommandLine, "pastebin.pl") OR contains(CommandLine, "pastetext.net") OR contains(CommandLine, "pixeldrain.com") OR contains(CommandLine, "privatlab.com") OR contains(CommandLine, "privatlab.net") OR contains(CommandLine, "send.exploit.in") OR contains(CommandLine, "sendspace.com") OR contains(CommandLine, "storage.googleapis.com") OR contains(CommandLine, "storjshare.io") OR contains(CommandLine, "supabase.co") OR contains(CommandLine, "temp.sh") OR contains(CommandLine, "transfer.sh") OR contains(CommandLine, "trycloudflare.com") OR contains(CommandLine, "ufile.io") OR contains(CommandLine, "w3spaces.com") OR contains(CommandLine, "workers.dev") OR contains(CommandLine, "x0.at"))))
