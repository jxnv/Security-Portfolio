// Title: Suspicious Double Extension File Execution
// ID: 1cdd9a09-06c9-4769-99ff-626e2b3991b8
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems), @blu3_team (idea), Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-06-26
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects suspicious use of an .exe extension after a non-executable file extension like .pdf.exe, a set of spaces or underlines to cloak the executable file in spear phishing campaigns
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((Image="*      .exe" OR Image="*______.exe" OR Image="*.doc.exe" OR Image="*.doc.js" OR Image="*.docx.exe" OR Image="*.docx.js" OR Image="*.gif.exe" OR Image="*.jpeg.exe" OR Image="*.jpg.exe" OR Image="*.mkv.exe" OR Image="*.mov.exe" OR Image="*.mp3.exe" OR Image="*.mp4.exe" OR Image="*.pdf.exe" OR Image="*.pdf.js" OR Image="*.png.exe" OR Image="*.ppt.exe" OR Image="*.ppt.js" OR Image="*.pptx.exe" OR Image="*.pptx.js" OR Image="*.rtf.exe" OR Image="*.rtf.js" OR Image="*.svg.exe" OR Image="*.txt.exe" OR Image="*.txt.js" OR Image="*.xls.exe" OR Image="*.xls.js" OR Image="*.xlsx.exe" OR Image="*.xlsx.js" OR Image="*⠀⠀⠀⠀⠀⠀.exe") AND (contains(CommandLine, "      .exe") OR contains(CommandLine, "______.exe") OR contains(CommandLine, ".doc.exe") OR contains(CommandLine, ".doc.js") OR contains(CommandLine, ".docx.exe") OR contains(CommandLine, ".docx.js") OR contains(CommandLine, ".gif.exe") OR contains(CommandLine, ".jpeg.exe") OR contains(CommandLine, ".jpg.exe") OR contains(CommandLine, ".mkv.exe") OR contains(CommandLine, ".mov.exe") OR contains(CommandLine, ".mp3.exe") OR contains(CommandLine, ".mp4.exe") OR contains(CommandLine, ".pdf.exe") OR contains(CommandLine, ".pdf.js") OR contains(CommandLine, ".png.exe") OR contains(CommandLine, ".ppt.exe") OR contains(CommandLine, ".ppt.js") OR contains(CommandLine, ".pptx.exe") OR contains(CommandLine, ".pptx.js") OR contains(CommandLine, ".rtf.exe") OR contains(CommandLine, ".rtf.js") OR contains(CommandLine, ".svg.exe") OR contains(CommandLine, ".txt.exe") OR contains(CommandLine, ".txt.js") OR contains(CommandLine, ".xls.exe") OR contains(CommandLine, ".xls.js") OR contains(CommandLine, ".xlsx.exe") OR contains(CommandLine, ".xlsx.js") OR contains(CommandLine, "⠀⠀⠀⠀⠀⠀.exe")))
