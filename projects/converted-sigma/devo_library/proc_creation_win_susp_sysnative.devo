// Title: Process Creation Using Sysnative Folder
// ID: 3c1b5fb0-c72f-45ba-abd1-4d4c353144ab
// Status: test
// Level: medium
// Author: Max Altgelt (Nextron Systems)
// Date: 2022-08-23
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects process creation events that use the Sysnative folder (common for CobaltStrike spawns)
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, ":\\Windows\\Sysnative\\")) OR (contains(Image, ":\\Windows\\Sysnative\\"))) AND NOT (((contains(Image, "C:\\Windows\\Microsoft.NET\\Framework64\\v") OR contains(Image, "C:\\Windows\\Microsoft.NET\\Framework\\v") OR contains(Image, "C:\\Windows\\Microsoft.NET\\FrameworkArm\\v") OR contains(Image, "C:\\Windows\\Microsoft.NET\\FrameworkArm64\\v")) AND Image="*\\ngen.exe" AND contains(CommandLine, "install"))) AND NOT (((contains(CommandLine, "\"C:\\Windows\\sysnative\\cmd.exe\"") AND contains(CommandLine, "\\xampp\\") AND contains(CommandLine, "\\catalina_start.bat")))))
