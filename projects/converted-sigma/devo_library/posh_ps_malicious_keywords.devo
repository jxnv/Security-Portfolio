// Title: Malicious PowerShell Keywords
// ID: f62176f3-8128-4faa-bf6c-83261322e5eb
// Status: test
// Level: medium
// Author: Sean Metcalf (source), Florian Roth (Nextron Systems)
// Date: 2017-03-05
// Tags: attack.execution, attack.t1059.001
// Description: Detects keywords from well-known PowerShell exploitation frameworks
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(ScriptBlockText, "AdjustTokenPrivileges") OR contains(ScriptBlockText, "IMAGE_NT_OPTIONAL_HDR64_MAGIC") OR contains(ScriptBlockText, "Metasploit") OR contains(ScriptBlockText, "Microsoft.Win32.UnsafeNativeMethods") OR contains(ScriptBlockText, "Mimikatz") OR contains(ScriptBlockText, "MiniDumpWriteDump") OR contains(ScriptBlockText, "PAGE_EXECUTE_READ") OR contains(ScriptBlockText, "ReadProcessMemory.Invoke") OR contains(ScriptBlockText, "SE_PRIVILEGE_ENABLED") OR contains(ScriptBlockText, "SECURITY_DELEGATION") OR contains(ScriptBlockText, "TOKEN_ADJUST_PRIVILEGES") OR contains(ScriptBlockText, "TOKEN_ALL_ACCESS") OR contains(ScriptBlockText, "TOKEN_ASSIGN_PRIMARY") OR contains(ScriptBlockText, "TOKEN_DUPLICATE") OR contains(ScriptBlockText, "TOKEN_ELEVATION") OR contains(ScriptBlockText, "TOKEN_IMPERSONATE") OR contains(ScriptBlockText, "TOKEN_INFORMATION_CLASS") OR contains(ScriptBlockText, "TOKEN_PRIVILEGES") OR contains(ScriptBlockText, "TOKEN_QUERY")))
