// Title: Silence.EDA Detection
// ID: 3ceb2083-a27f-449a-be33-14ec1b7cc973
// Status: test
// Level: critical
// Author: Alina Stepchenkova, Group-IB, oscd.community
// Date: 2019-11-01
// Tags: attack.execution, attack.t1059.001, attack.command-and-control, attack.t1071.004, attack.t1572, attack.impact, attack.t1529, attack.g0091, attack.s0363
// Description: Detects Silence EmpireDNSAgent as described in the Group-IP report
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(ScriptBlockText, "System.Diagnostics.Process") AND contains(ScriptBlockText, "Stop-Computer") AND contains(ScriptBlockText, "Restart-Computer") AND contains(ScriptBlockText, "Exception in execution") AND contains(ScriptBlockText, "$cmdargs") AND contains(ScriptBlockText, "Close-Dnscat2Tunnel"))) AND ((contains(ScriptBlockText, "set type=$LookupType`nserver") AND contains(ScriptBlockText, "$Command | nslookup 2>&1 | Out-String") AND contains(ScriptBlockText, "New-RandomDNSField") AND contains(ScriptBlockText, "[Convert]::ToString($SYNOptions, 16)") AND contains(ScriptBlockText, "$Session.Dead = $True") AND contains(ScriptBlockText, "$Session[\"Driver\"] -eq"))))
