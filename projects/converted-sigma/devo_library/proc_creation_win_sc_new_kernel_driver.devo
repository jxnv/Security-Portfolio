// Title: New Kernel Driver Via SC.EXE
// ID: 431a1fdb-4799-4f3b-91c3-a683b003fc49
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-14
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects creation of a new service (kernel driver) with the type "kernel"
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((Image="*\\sc.exe" AND (contains(CommandLine, "create") OR contains(CommandLine, "config")) AND (contains(CommandLine, "binPath") AND contains(CommandLine, "type") AND contains(CommandLine, "kernel"))) AND NOT ((((contains(CommandLine, "create netprotection_network_filter") AND contains(CommandLine, "type= kernel start= ") AND contains(CommandLine, "binPath= System32\\drivers\\netprotection_network_filter") AND contains(CommandLine, "DisplayName= netprotection_network_filter") AND contains(CommandLine, "group= PNP_TDI tag= yes"))) OR ((contains(CommandLine, "create avelam binpath=C:\\Windows\\system32\\drivers\\avelam.sys") AND contains(CommandLine, "type=kernel start=boot error=critical group=Early-Launch"))))))
