// Title: Suspicious Get Local Groups Information
// ID: cef24b90-dddc-4ae1-a09a-8764872f69fc
// Status: test
// Level: low
// Author: frack113
// Date: 2021-12-12
// Tags: attack.discovery, attack.t1069.001
// Description: Detects the use of PowerShell modules and cmdlets to gather local group information.
// Adversaries may use local system permission groups to determine which groups exist and which users belong to a particular group such as the local administrators group.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((contains(Payload, "get-localgroup ") OR contains(Payload, "get-localgroupmember "))) OR ((contains(ContextInfo, "get-localgroup ") OR contains(ContextInfo, "get-localgroupmember ")))) OR (((contains(Payload, "win32_group")) OR (contains(ContextInfo, "win32_group"))) AND (((contains(Payload, "get-wmiobject ") OR contains(Payload, "gwmi ") OR contains(Payload, "get-ciminstance ") OR contains(Payload, "gcim "))) OR ((contains(ContextInfo, "get-wmiobject ") AND contains(ContextInfo, "gwmi ") AND contains(ContextInfo, "get-ciminstance ") AND contains(ContextInfo, "gcim "))))))
