// Tags: attack.discovery, attack.t1049, attack.t1069.002, attack.t1482, attack.t1135, attack.t1033
// Description: Adversaries may look for details about the network configuration and settings of systems they access or through information discovery of remote systems
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((OriginalFileName == "SharpView.exe") OR (Image="*\\SharpView.exe") OR ((contains(CommandLine, "Add-RemoteConnection") OR contains(CommandLine, "Convert-ADName") OR contains(CommandLine, "ConvertFrom-SID") OR contains(CommandLine, "ConvertFrom-UACValue") OR contains(CommandLine, "Convert-SidToName") OR contains(CommandLine, "Export-PowerViewCSV") OR contains(CommandLine, "Find-DomainObjectPropertyOutlier") OR contains(CommandLine, "Find-DomainProcess") OR contains(CommandLine, "Find-DomainShare") OR contains(CommandLine, "Find-DomainUserEvent") OR contains(CommandLine, "Find-DomainUserLocation") OR contains(CommandLine, "Find-ForeignGroup") OR contains(CommandLine, "Find-ForeignUser") OR contains(CommandLine, "Find-GPOComputerAdmin") OR contains(CommandLine, "Find-GPOLocation") OR contains(CommandLine, "Find-Interesting") OR contains(CommandLine, "Find-LocalAdminAccess") OR contains(CommandLine, "Find-ManagedSecurityGroups") OR contains(CommandLine, "Get-CachedRDPConnection") OR contains(CommandLine, "Get-DFSshare") OR contains(CommandLine, "Get-DomainComputer") OR contains(CommandLine, "Get-DomainController") OR contains(CommandLine, "Get-DomainDFSShare") OR contains(CommandLine, "Get-DomainDNSRecord") OR contains(CommandLine, "Get-DomainFileServer") OR contains(CommandLine, "Get-DomainForeign") OR contains(CommandLine, "Get-DomainGPO") OR contains(CommandLine, "Get-DomainGroup") OR contains(CommandLine, "Get-DomainGUIDMap") OR contains(CommandLine, "Get-DomainManagedSecurityGroup") OR contains(CommandLine, "Get-DomainObject") OR contains(CommandLine, "Get-DomainOU") OR contains(CommandLine, "Get-DomainPolicy") OR contains(CommandLine, "Get-DomainSID") OR contains(CommandLine, "Get-DomainSite") OR contains(CommandLine, "Get-DomainSPNTicket") OR contains(CommandLine, "Get-DomainSubnet") OR contains(CommandLine, "Get-DomainTrust") OR contains(CommandLine, "Get-DomainUserEvent") OR contains(CommandLine, "Get-ForestDomain") OR contains(CommandLine, "Get-ForestGlobalCatalog") OR contains(CommandLine, "Get-ForestTrust") OR contains(CommandLine, "Get-GptTmpl") OR contains(CommandLine, "Get-GroupsXML") OR contains(CommandLine, "Get-LastLoggedOn") OR contains(CommandLine, "Get-LoggedOnLocal") OR contains(CommandLine, "Get-NetComputer") OR contains(CommandLine, "Get-NetDomain") OR contains(CommandLine, "Get-NetFileServer") OR contains(CommandLine, "Get-NetForest") OR contains(CommandLine, "Get-NetGPO") OR contains(CommandLine, "Get-NetGroupMember") OR contains(CommandLine, "Get-NetLocalGroup") OR contains(CommandLine, "Get-NetLoggedon") OR contains(CommandLine, "Get-NetOU") OR contains(CommandLine, "Get-NetProcess") OR contains(CommandLine, "Get-NetRDPSession") OR contains(CommandLine, "Get-NetSession") OR contains(CommandLine, "Get-NetShare") OR contains(CommandLine, "Get-NetSite") OR contains(CommandLine, "Get-NetSubnet") OR contains(CommandLine, "Get-NetUser") OR contains(CommandLine, "Get-PathAcl") OR contains(CommandLine, "Get-PrincipalContext") OR contains(CommandLine, "Get-RegistryMountedDrive") OR contains(CommandLine, "Get-RegLoggedOn") OR contains(CommandLine, "Get-WMIRegCachedRDPConnection") OR contains(CommandLine, "Get-WMIRegLastLoggedOn") OR contains(CommandLine, "Get-WMIRegMountedDrive") OR contains(CommandLine, "Get-WMIRegProxy") OR contains(CommandLine, "Invoke-ACLScanner") OR contains(CommandLine, "Invoke-CheckLocalAdminAccess") OR contains(CommandLine, "Invoke-Kerberoast") OR contains(CommandLine, "Invoke-MapDomainTrust") OR contains(CommandLine, "Invoke-RevertToSelf") OR contains(CommandLine, "Invoke-Sharefinder") OR contains(CommandLine, "Invoke-UserImpersonation") OR contains(CommandLine, "Remove-DomainObjectAcl") OR contains(CommandLine, "Remove-RemoteConnection") OR contains(CommandLine, "Request-SPNTicket") OR contains(CommandLine, "Set-DomainObject") OR contains(CommandLine, "Test-AdminAccess"))))
