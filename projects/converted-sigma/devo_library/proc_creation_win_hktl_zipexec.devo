// Title: Suspicious ZipExec Execution
// ID: 90dcf730-1b71-4ae7-9ffc-6fcf62bd0132
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-11-07
// Tags: attack.execution, attack.stealth, attack.t1218, attack.t1202
// Description: ZipExec is a Proof-of-Concept (POC) tool to wrap binary-based tools into a password-protected zip file.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "/generic:Microsoft_Windows_Shell_ZipFolder:filename=") AND contains(CommandLine, ".zip") AND contains(CommandLine, "/pass:") AND contains(CommandLine, "/user:"))) OR ((contains(CommandLine, "/delete") AND contains(CommandLine, "Microsoft_Windows_Shell_ZipFolder:filename=") AND contains(CommandLine, ".zip"))))
