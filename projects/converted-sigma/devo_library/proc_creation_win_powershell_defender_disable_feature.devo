// Title: Powershell Defender Disable Scan Feature
// ID: 1ec65a5f-9473-4f12-97da-622044d6df21
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-03
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects requests to disable Microsoft Defender features using PowerShell commands
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((contains(CommandLine, "Add-MpPreference ") OR contains(CommandLine, "Set-MpPreference "))) AND ((contains(CommandLine, "DisableArchiveScanning ") OR contains(CommandLine, "DisableRealtimeMonitoring ") OR contains(CommandLine, "DisableIOAVProtection ") OR contains(CommandLine, "DisableBehaviorMonitoring ") OR contains(CommandLine, "DisableBlockAtFirstSeen ") OR contains(CommandLine, "DisableCatchupFullScan ") OR contains(CommandLine, "DisableCatchupQuickScan "))) AND ((contains(CommandLine, "$true") OR contains(CommandLine, " 1 ")))) OR (((contains(CommandLine, "RABpAHMAYQBiAGwAZQBSAGUAYQBsAHQAaQBtAGUATQBvAG4AaQB0AG8AcgBpAG4AZwAgA") OR contains(CommandLine, "QAaQBzAGEAYgBsAGUAUgBlAGEAbAB0AGkAbQBlAE0AbwBuAGkAdABvAHIAaQBuAGcAIA") OR contains(CommandLine, "EAGkAcwBhAGIAbABlAFIAZQBhAGwAdABpAG0AZQBNAG8AbgBpAHQAbwByAGkAbgBnACAA") OR contains(CommandLine, "RABpAHMAYQBiAGwAZQBJAE8AQQBWAFAAcgBvAHQAZQBjAHQAaQBvAG4AIA") OR contains(CommandLine, "QAaQBzAGEAYgBsAGUASQBPAEEAVgBQAHIAbwB0AGUAYwB0AGkAbwBuACAA") OR contains(CommandLine, "EAGkAcwBhAGIAbABlAEkATwBBAFYAUAByAG8AdABlAGMAdABpAG8AbgAgA") OR contains(CommandLine, "RABpAHMAYQBiAGwAZQBCAGUAaABhAHYAaQBvAHIATQBvAG4AaQB0AG8AcgBpAG4AZwAgA") OR contains(CommandLine, "QAaQBzAGEAYgBsAGUAQgBlAGgAYQB2AGkAbwByAE0AbwBuAGkAdABvAHIAaQBuAGcAIA") OR contains(CommandLine, "EAGkAcwBhAGIAbABlAEIAZQBoAGEAdgBpAG8AcgBNAG8AbgBpAHQAbwByAGkAbgBnACAA") OR contains(CommandLine, "RABpAHMAYQBiAGwAZQBCAGwAbwBjAGsAQQB0AEYAaQByAHMAdABTAGUAZQBuACAA") OR contains(CommandLine, "QAaQBzAGEAYgBsAGUAQgBsAG8AYwBrAEEAdABGAGkAcgBzAHQAUwBlAGUAbgAgA") OR contains(CommandLine, "EAGkAcwBhAGIAbABlAEIAbABvAGMAawBBAHQARgBpAHIAcwB0AFMAZQBlAG4AIA") OR contains(CommandLine, "ZABpAHMAYQBiAGwAZQByAGUAYQBsAHQAaQBtAGUAbQBvAG4AaQB0AG8AcgBpAG4AZwAgA") OR contains(CommandLine, "QAaQBzAGEAYgBsAGUAcgBlAGEAbAB0AGkAbQBlAG0AbwBuAGkAdABvAHIAaQBuAGcAIA") OR contains(CommandLine, "kAGkAcwBhAGIAbABlAHIAZQBhAGwAdABpAG0AZQBtAG8AbgBpAHQAbwByAGkAbgBnACAA") OR contains(Co