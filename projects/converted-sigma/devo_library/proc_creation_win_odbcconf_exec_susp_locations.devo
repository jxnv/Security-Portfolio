// Title: Odbcconf.EXE Suspicious DLL Location
// ID: 6b65c28e-11f3-46cb-902a-68f2cafaf474
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-22
// Tags: attack.stealth, attack.t1218.008
// Description: Detects execution of "odbcconf" where the path of the DLL being registered is located in a potentially suspicious location.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, ":\\PerfLogs\\") OR contains(CommandLine, ":\\ProgramData\\") OR contains(CommandLine, ":\\Temp\\") OR contains(CommandLine, ":\\Users\\Public\\") OR contains(CommandLine, ":\\Windows\\Registration\\CRMLog") OR contains(CommandLine, ":\\Windows\\System32\\com\\dmp\\") OR contains(CommandLine, ":\\Windows\\System32\\FxsTmp\\") OR contains(CommandLine, ":\\Windows\\System32\\Microsoft\\Crypto\\RSA\\MachineKeys\\") OR contains(CommandLine, ":\\Windows\\System32\\spool\\drivers\\color\\") OR contains(CommandLine, ":\\Windows\\System32\\spool\\PRINTERS\\") OR contains(CommandLine, ":\\Windows\\System32\\spool\\SERVERS\\") OR contains(CommandLine, ":\\Windows\\System32\\Tasks_Migrated\\") OR contains(CommandLine, ":\\Windows\\System32\\Tasks\\Microsoft\\Windows\\SyncCenter\\") OR contains(CommandLine, ":\\Windows\\SysWOW64\\com\\dmp\\") OR contains(CommandLine, ":\\Windows\\SysWOW64\\FxsTmp\\") OR contains(CommandLine, ":\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\PLA\\System\\") OR contains(CommandLine, ":\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\SyncCenter\\") OR contains(CommandLine, ":\\Windows\\Tasks\\") OR contains(CommandLine, ":\\Windows\\Temp\\") OR contains(CommandLine, ":\\Windows\\Tracing\\") OR contains(CommandLine, "\\AppData\\Local\\Temp\\") OR contains(CommandLine, "\\AppData\\Roaming\\"))) AND ((Image="*\\odbcconf.exe") OR (OriginalFileName == "odbcconf.exe")))
