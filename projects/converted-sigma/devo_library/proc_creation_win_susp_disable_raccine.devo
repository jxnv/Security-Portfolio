// Title: Raccine Uninstall
// ID: a31eeaed-3fd5-478e-a8ba-e62c6b3f9ecc
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-01-21
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects commands that indicate a Raccine removal from an end system. Raccine is a free ransomware protection tool.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "taskkill ") AND contains(CommandLine, "RaccineSettings.exe"))) OR ((contains(CommandLine, "reg.exe") AND contains(CommandLine, "delete") AND contains(CommandLine, "Raccine Tray"))) OR ((contains(CommandLine, "schtasks") AND contains(CommandLine, "/DELETE") AND contains(CommandLine, "Raccine Rules Updater"))))
