// Title: New Module Module Added To IIS Server
// ID: dd857d3e-0c6e-457b-9b48-e82ae7f86bd7
// Status: test
// Level: medium
// Author: frack113
// Date: 2024-10-06
// Tags: attack.persistence, attack.defense-impairment, attack.t1685.001, attack.t1505.004
// Description: Detects the addition of a new module to an IIS server.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((EventID == "29" AND contains(Configuration, "/system.webServer/modules/add")) AND NOT ((((NewValue == "AnonymousAuthenticationModule" OR NewValue == "CustomErrorModule" OR NewValue == "DefaultDocumentModule" OR NewValue == "DirectoryListingModule" OR NewValue == "FileCacheModule" OR NewValue == "HttpCacheModule" OR NewValue == "HttpLoggingModule" OR NewValue == "ProtocolSupportModule" OR NewValue == "RequestFilteringModule" OR NewValue == "StaticCompressionModule" OR NewValue == "StaticFileModule" OR NewValue == "TokenCacheModule" OR NewValue == "UriCacheModule")) OR (NewValue == ""))))
