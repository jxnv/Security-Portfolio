// Title: Potential Discovery Activity Using Find - Linux
// ID: 8344c0e5-5783-47cc-9cf9-a0f7fd03e6cf
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-28
// Tags: attack.discovery, attack.t1083
// Description: Detects usage of "find" binary in a suspicious manner to perform discovery
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (Image="*/find" AND (contains(CommandLine, "-perm -4000") OR contains(CommandLine, "-perm -2000") OR contains(CommandLine, "-perm 0777") OR contains(CommandLine, "-perm -222") OR contains(CommandLine, "-perm -o w") OR contains(CommandLine, "-perm -o x") OR contains(CommandLine, "-perm -u=s") OR contains(CommandLine, "-perm -g=s")))
