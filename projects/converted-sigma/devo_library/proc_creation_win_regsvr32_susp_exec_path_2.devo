// Title: Regsvr32 Execution From Highly Suspicious Location
// ID: 327ff235-94eb-4f06-b9de-aaee571324be
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-26
// Tags: attack.stealth, attack.t1218.010
// Description: Detects execution of regsvr32 where the DLL is located in a highly suspicious locations
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((Image="*\\regsvr32.exe") OR (OriginalFileName == "REGSVR32.EXE")) AND (((contains(CommandLine, ":\\PerfLogs\\") OR contains(CommandLine, ":\\Temp\\") OR contains(CommandLine, "\\Windows\\Registration\\CRMLog") OR contains(CommandLine, "\\Windows\\System32\\com\\dmp\\") OR contains(CommandLine, "\\Windows\\System32\\FxsTmp\\") OR contains(CommandLine, "\\Windows\\System32\\Microsoft\\Crypto\\RSA\\MachineKeys\\") OR contains(CommandLine, "\\Windows\\System32\\spool\\drivers\\color\\") OR contains(CommandLine, "\\Windows\\System32\\spool\\PRINTERS\\") OR contains(CommandLine, "\\Windows\\System32\\spool\\SERVERS\\") OR contains(CommandLine, "\\Windows\\System32\\Tasks_Migrated\\") OR contains(CommandLine, "\\Windows\\System32\\Tasks\\Microsoft\\Windows\\SyncCenter\\") OR contains(CommandLine, "\\Windows\\SysWOW64\\com\\dmp\\") OR contains(CommandLine, "\\Windows\\SysWOW64\\FxsTmp\\") OR contains(CommandLine, "\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\PLA\\System\\") OR contains(CommandLine, "\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\SyncCenter\\") OR contains(CommandLine, "\\Windows\\Tasks\\") OR contains(CommandLine, "\\Windows\\Tracing\\"))) OR (((contains(CommandLine, " \"C:\\") OR contains(CommandLine, " C:\\") OR contains(CommandLine, " 'C:\\") OR contains(CommandLine, "D:\\"))) AND NOT (((contains(CommandLine, "C:\\Program Files (x86)\\") OR contains(CommandLine, "C:\\Program Files\\") OR contains(CommandLine, "C:\\ProgramData\\") OR contains(CommandLine, "C:\\Users\\") OR contains(CommandLine, " C:\\Windows\\") OR contains(CommandLine, " \"C:\\Windows\\") OR contains(CommandLine, " 'C:\\Windows\\")))))) AND NOT (((CommandLine == "") OR (NOT CommandLine=*))))
