// Title: Potential Privilege Escalation To LOCAL SYSTEM
// ID: 207b0396-3689-42d9-8399-4222658efc99
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-05-22
// Tags: attack.resource-development, attack.t1587.001
// Description: Detects unknown program using commandline flags usually used by tools such as PsExec and PAExec to start programs with SYSTEM Privileges
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, " -s cmd") OR contains(CommandLine, " -s -i cmd") OR contains(CommandLine, " -i -s cmd") OR contains(CommandLine, " -s pwsh") OR contains(CommandLine, " -s -i pwsh") OR contains(CommandLine, " -i -s pwsh") OR contains(CommandLine, " -s powershell") OR contains(CommandLine, " -s -i powershell") OR contains(CommandLine, " -i -s powershell"))) AND NOT (((contains(CommandLine, "paexec") OR contains(CommandLine, "PsExec") OR contains(CommandLine, "accepteula")))))
