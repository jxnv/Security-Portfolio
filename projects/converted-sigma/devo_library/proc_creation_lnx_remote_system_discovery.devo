// Title: Linux Remote System Discovery
// ID: 11063ec2-de63-4153-935e-b1a8b9e616f1
// Status: test
// Level: low
// Author: Alejandro Ortuno, oscd.community
// Date: 2020-10-22
// Tags: attack.discovery, attack.t1018
// Description: Detects the enumeration of other remote systems.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((Image="*/arp" AND contains(CommandLine, "-a")) OR (Image="*/ping" AND (contains(CommandLine, " 10.") OR contains(CommandLine, " 192.168.") OR contains(CommandLine, " 172.16.") OR contains(CommandLine, " 172.17.") OR contains(CommandLine, " 172.18.") OR contains(CommandLine, " 172.19.") OR contains(CommandLine, " 172.20.") OR contains(CommandLine, " 172.21.") OR contains(CommandLine, " 172.22.") OR contains(CommandLine, " 172.23.") OR contains(CommandLine, " 172.24.") OR contains(CommandLine, " 172.25.") OR contains(CommandLine, " 172.26.") OR contains(CommandLine, " 172.27.") OR contains(CommandLine, " 172.28.") OR contains(CommandLine, " 172.29.") OR contains(CommandLine, " 172.30.") OR contains(CommandLine, " 172.31.") OR contains(CommandLine, " 127.") OR contains(CommandLine, " 169.254."))))
