// Title: Portable Gpg.EXE Execution
// ID: 77df53a5-1d78-4f32-bc5a-0e7465bd8f41
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-08-06
// Tags: attack.impact, attack.t1486
// Description: Detects the execution of "gpg.exe" from uncommon location. Often used by ransomware and loaders to decrypt/encrypt data.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((Image="*\\gpg.exe" OR Image="*\\gpg2.exe")) OR (OriginalFileName == "gpg.exe") OR (Description == "GnuPG’s OpenPGP tool")) AND NOT (((contains(Image, ":\\Program Files (x86)\\GNU\\GnuPG\\bin\\") OR contains(Image, ":\\Program Files (x86)\\GnuPG VS-Desktop\\") OR contains(Image, ":\\Program Files (x86)\\GnuPG\\bin\\") OR contains(Image, ":\\Program Files (x86)\\Gpg4win\\bin\\")))))
