// Title: Security Software Discovery - MacOs
// ID: 0ed75b9c-c73b-424d-9e7d-496cd565fbe0
// Status: test
// Level: medium
// Author: Daniil Yugoslavskiy, oscd.community
// Date: 2020-10-19
// Tags: attack.discovery, attack.t1518.001
// Description: Detects usage of system utilities (only grep for now) to discover security software discovery
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((Image == "/usr/bin/grep") AND (((contains(CommandLine, "nessusd") OR contains(CommandLine, "santad") OR contains(CommandLine, "CbDefense") OR contains(CommandLine, "falcond") OR contains(CommandLine, "td-agent") OR contains(CommandLine, "packetbeat") OR contains(CommandLine, "filebeat") OR contains(CommandLine, "auditbeat") OR contains(CommandLine, "osqueryd") OR contains(CommandLine, "BlockBlock") OR contains(CommandLine, "LuLu"))) OR ((contains(CommandLine, "Little") AND contains(CommandLine, "Snitch")))))
