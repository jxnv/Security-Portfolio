// Title: Potential Browser Data Stealing
// ID: 47147b5b-9e17-4d76-b8d2-7bac24c5ce1b
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-23
// Tags: attack.credential-access, attack.t1555.003
// Description: Adversaries may acquire credentials from web browsers by reading files specific to the target browser.
// Web browsers commonly save credentials such as website usernames and passwords so that they do not need to be entered manually in the future.
// Web browsers typically store the credentials in an encrypted format within a credential store.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((contains(CommandLine, "copy-item") OR contains(CommandLine, "copy ") OR contains(CommandLine, "cpi ") OR contains(CommandLine, " cp ") OR contains(CommandLine, "move ") OR contains(CommandLine, "move-item") OR contains(CommandLine, " mi ") OR contains(CommandLine, " mv "))) OR ((Image="*\\esentutl.exe" OR Image="*\\xcopy.exe" OR Image="*\\robocopy.exe")) OR ((OriginalFileName == "esentutl.exe" OR OriginalFileName == "XCOPY.EXE" OR OriginalFileName == "robocopy.exe"))) AND ((contains(CommandLine, "\\Amigo\\User Data") OR contains(CommandLine, "\\BraveSoftware\\Brave-Browser\\User Data") OR contains(CommandLine, "\\CentBrowser\\User Data") OR contains(CommandLine, "\\Chromium\\User Data") OR contains(CommandLine, "\\CocCoc\\Browser\\User Data") OR contains(CommandLine, "\\Comodo\\Dragon\\User Data") OR contains(CommandLine, "\\Elements Browser\\User Data") OR contains(CommandLine, "\\Epic Privacy Browser\\User Data") OR contains(CommandLine, "\\Google\\Chrome Beta\\User Data") OR contains(CommandLine, "\\Google\\Chrome SxS\\User Data") OR contains(CommandLine, "\\Google\\Chrome\\User Data\\") OR contains(CommandLine, "\\Kometa\\User Data") OR contains(CommandLine, "\\Maxthon5\\Users") OR contains(CommandLine, "\\Microsoft\\Edge\\User Data") OR contains(CommandLine, "\\Mozilla\\Firefox\\Profiles") OR contains(CommandLine, "\\Nichrome\\User Data") OR contains(CommandLine, "\\Opera Software\\Opera GX Stable\\") OR contains(CommandLine, "\\Opera Software\\Opera Neon\\User Data") OR contains(CommandLine, "\\Opera Software\\Opera Stable\\") OR contains(CommandLine, "\\Orbitum\\User Data") OR contains(CommandLine, "\\QIP Surf\\User Data") OR contains(CommandLine, "\\Sputnik\\User Data") OR contains(CommandLine, "\\Torch\\User Data") OR contains(CommandLine, "\\uCozMedia\\Uran\\User Data") OR contains(CommandLine, "\\Vivaldi\\User Data"))))
