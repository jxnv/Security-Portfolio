// Title: Suspicious Loading of Dbgcore/Dbghelp DLLs from Uncommon Location
// ID: 416bc4a2-7217-4519-8dc7-c3271817f1d5
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-11-27
// Tags: attack.credential-access, attack.defense-impairment, attack.t1003, attack.t1685
// Description: Detects loading of dbgcore.dll or dbghelp.dll from uncommon locations such as user directories.
// These DLLs contain the MiniDumpWriteDump function, which can be abused for credential dumping purposes or in some cases for evading EDR/AV detection by suspending processes.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((ImageLoaded="*\\dbgcore.dll" OR ImageLoaded="*\\dbghelp.dll")) AND ((contains(Image, ":\\Perflogs\\") OR contains(Image, ":\\Temp\\") OR contains(Image, ":\\Users\\Public\\") OR contains(Image, "\\$Recycle.Bin\\") OR contains(Image, "\\Contacts\\") OR contains(Image, "\\Documents\\") OR contains(Image, "\\Favorites\\") OR contains(Image, "\\Favourites\\") OR contains(Image, "\\inetpub\\wwwroot\\") OR contains(Image, "\\Music\\") OR contains(Image, "\\Pictures\\") OR contains(Image, "\\Start Menu\\Programs\\Startup\\") OR contains(Image, "\\Users\\Default\\") OR contains(Image, "\\Videos\\"))))
