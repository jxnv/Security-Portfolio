// Title: Suspicious PowerShell Parameter Substring
// ID: 36210e0d-5b19-485d-a087-c096088885f0
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Daniel Bohannon (idea), Roberto Rodriguez (Fix)
// Date: 2019-01-16
// Tags: attack.execution, attack.t1059.001
// Description: Detects suspicious PowerShell invocation with a parameter substring
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((Image="*\\powershell.exe" OR Image="*\\pwsh.exe") AND (contains(CommandLine, " -windowstyle h ") OR contains(CommandLine, " -windowstyl h") OR contains(CommandLine, " -windowsty h") OR contains(CommandLine, " -windowst h") OR contains(CommandLine, " -windows h") OR contains(CommandLine, " -windo h") OR contains(CommandLine, " -wind h") OR contains(CommandLine, " -win h") OR contains(CommandLine, " -wi h") OR contains(CommandLine, " -win h ") OR contains(CommandLine, " -win hi ") OR contains(CommandLine, " -win hid ") OR contains(CommandLine, " -win hidd ") OR contains(CommandLine, " -win hidde ") OR contains(CommandLine, " -NoPr ") OR contains(CommandLine, " -NoPro ") OR contains(CommandLine, " -NoProf ") OR contains(CommandLine, " -NoProfi ") OR contains(CommandLine, " -NoProfil ") OR contains(CommandLine, " -nonin ") OR contains(CommandLine, " -nonint ") OR contains(CommandLine, " -noninte ") OR contains(CommandLine, " -noninter ") OR contains(CommandLine, " -nonintera ") OR contains(CommandLine, " -noninterac ") OR contains(CommandLine, " -noninteract ") OR contains(CommandLine, " -noninteracti ") OR contains(CommandLine, " -noninteractiv ") OR contains(CommandLine, " -ec ") OR contains(CommandLine, " -encodedComman ") OR contains(CommandLine, " -encodedComma ") OR contains(CommandLine, " -encodedComm ") OR contains(CommandLine, " -encodedCom ") OR contains(CommandLine, " -encodedCo ") OR contains(CommandLine, " -encodedC ") OR contains(CommandLine, " -encoded ") OR contains(CommandLine, " -encode ") OR contains(CommandLine, " -encod ") OR contains(CommandLine, " -enco ") OR contains(CommandLine, " -en ") OR contains(CommandLine, " -executionpolic ") OR contains(CommandLine, " -executionpoli ") OR contains(CommandLine, " -executionpol ") OR contains(CommandLine, " -executionpo ") OR contains(CommandLine, " -executionp ") OR contains(CommandLine, " -execution bypass") OR contains(CommandLine, " -executio bypass") OR contains(CommandLine, " -executi bypass") OR contains(CommandLine, " -execut bypass") OR contains(CommandLine, " -execu bypass") OR contains(CommandLine, " -exec bypass") OR contains(CommandLine, " -exe bypass") OR contains(CommandLine, " -ex bypass") OR contains(CommandLine, " -ep bypass") OR contains(CommandLine, " /windowstyle h ") OR contains(CommandLine, " /windowstyl h") OR contains(CommandLine, " /windowsty h") OR contains(CommandLine, " /windowst h") OR contains(CommandLine, " /windows h") OR contains(CommandLine, " /windo h") OR contains(CommandLine, " /wind h") OR contains(CommandLine, " /win h") OR contains(CommandLine, " /wi h") OR contains(CommandLine, " /win h ") OR contains(CommandLine, " /win hi ") OR contains(CommandLine, " /win hid ") OR contains(CommandLine, " /win hidd ") OR contains(CommandLine, " /win hidde ") OR contains(CommandLine, " /NoPr ") OR contains(CommandLine, " /NoPro ") OR contains(CommandLine, " /NoProf ") OR contains(CommandLine, " /NoProfi ") OR contains(CommandLine, " /NoProfil ") OR contains(CommandLine, " /nonin ") OR contains(CommandLine, " /nonint ") OR contains(CommandLine, " /noninte ") OR contains(CommandLine, " /noninter ") OR contains(CommandLine, " /nonintera ") OR contains(CommandLine, " /noninterac ") OR contains(CommandLine, " /noninteract ") OR contains(CommandLine, " /noninteracti ") OR contains(CommandLine, " /noninteractiv ") OR contains(CommandLine, " /ec ") OR contains(CommandLine, " /encodedComman ") OR contains(CommandLine, " /encodedComma ") OR contains(CommandLine, " /encodedComm ") OR contains(CommandLine, " /encodedCom ") OR contains(CommandLine, " /encodedCo ") OR contains(CommandLine, " /encodedC ") OR contains(CommandLine, " /encoded ") OR contains(CommandLine, " /encode ") OR contains(CommandLine, " /encod ") OR contains(CommandLine, " /enco ") OR contains(CommandLine, " /en ") OR contains(CommandLine, " /executionpolic ") OR contains(CommandLine, " /executionpoli ") OR contains(CommandLine, " /executionpol ") OR contains(CommandLine, " /executionpo ") OR contains(CommandLine, " /executionp ") OR contains(CommandLine, " /execution bypass") OR contains(CommandLine, " /executio bypass") OR contains(CommandLine, " /executi bypass") OR contains(CommandLine, " /execut bypass") OR contains(CommandLine, " /execu bypass") OR contains(CommandLine, " /exec bypass") OR contains(CommandLine, " /exe bypass") OR contains(CommandLine, " /ex bypass") OR contains(CommandLine, " /ep bypass")))
