// Title: Shell32 DLL Execution in Suspicious Directory
// ID: 32b96012-7892-429e-b26c-ac2bf46066ff
// Status: test
// Level: high
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-11-24
// Tags: attack.execution, attack.stealth, attack.t1218.011
// Description: Detects shell32.dll executing a DLL in a suspicious directory
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "shell32.dll") AND contains(CommandLine, "Control_RunDLL")) AND (contains(CommandLine, "%AppData%") OR contains(CommandLine, "%LocalAppData%") OR contains(CommandLine, "%Temp%") OR contains(CommandLine, "%tmp%") OR contains(CommandLine, "\\AppData\\") OR contains(CommandLine, "\\Temp\\") OR contains(CommandLine, "\\Users\\Public\\"))) AND ((Image="*\\rundll32.exe") OR (OriginalFileName == "RUNDLL32.EXE")))
