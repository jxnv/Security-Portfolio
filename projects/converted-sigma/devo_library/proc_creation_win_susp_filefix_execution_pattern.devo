// Title: Suspicious FileFix Execution Pattern
// ID: b5b29e4e-31fa-4fdf-b058-296e7a1aa0c2
// Status: experimental
// Level: high
// Author: 0xFustang, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-11-24
// Tags: attack.execution, attack.t1204.004
// Description: Detects suspicious FileFix execution patterns where users are tricked into running malicious commands through browser file upload dialog manipulation.
// This attack typically begins when users visit malicious websites impersonating legitimate services or news platforms,
// which may display fake CAPTCHA challenges or direct instructions to open file explorer and paste clipboard content.
// The clipboard content usually contains commands that download and execute malware, such as information stealing tools.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((ParentImage="*\\brave.exe" OR ParentImage="*\\chrome.exe" OR ParentImage="*\\firefox.exe" OR ParentImage="*\\msedge.exe") AND contains(CommandLine, "#")) AND (((contains(CommandLine, "account") OR contains(CommandLine, "anti-bot") OR contains(CommandLine, "botcheck") OR contains(CommandLine, "captcha") OR contains(CommandLine, "challenge") OR contains(CommandLine, "confirmation") OR contains(CommandLine, "fraud") OR contains(CommandLine, "human") OR contains(CommandLine, "identification") OR contains(CommandLine, "identificator") OR contains(CommandLine, "identity") OR contains(CommandLine, "robot") OR contains(CommandLine, "validation") OR contains(CommandLine, "verification") OR contains(CommandLine, "verify"))) OR ((contains(CommandLine, "%comspec%") OR contains(CommandLine, "bitsadmin") OR contains(CommandLine, "certutil") OR contains(CommandLine, "cmd") OR contains(CommandLine, "cscript") OR contains(CommandLine, "curl") OR contains(CommandLine, "finger") OR contains(CommandLine, "mshta") OR contains(CommandLine, "powershell") OR contains(CommandLine, "pwsh") OR contains(CommandLine, "regsvr32") OR contains(CommandLine, "rundll32") OR contains(CommandLine, "schtasks") OR contains(CommandLine, "wget") OR contains(CommandLine, "wscript")))))
