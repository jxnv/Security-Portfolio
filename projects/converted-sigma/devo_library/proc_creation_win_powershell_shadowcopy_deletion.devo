// Title: Deletion of Volume Shadow Copies via WMI with PowerShell
// ID: 21ff4ca9-f13a-41ad-b828-0077b2af2e40
// Status: test
// Level: high
// Author: Tim Rauch, Elastic (idea)
// Date: 2022-09-20
// Tags: attack.impact, attack.t1490
// Description: Detects deletion of Windows Volume Shadow Copies with PowerShell code and Get-WMIObject. This technique is used by numerous ransomware families such as Sodinokibi/REvil
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, ".Delete()") OR contains(CommandLine, "Remove-WmiObject") OR contains(CommandLine, "rwmi") OR contains(CommandLine, "Remove-CimInstance") OR contains(CommandLine, "rcim"))) AND ((contains(CommandLine, "Get-WmiObject") OR contains(CommandLine, "gwmi") OR contains(CommandLine, "Get-CimInstance") OR contains(CommandLine, "gcim"))) AND (contains(CommandLine, "Win32_ShadowCopy")))
