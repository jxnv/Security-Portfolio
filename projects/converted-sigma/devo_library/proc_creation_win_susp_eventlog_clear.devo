// Title: Suspicious Eventlog Clearing or Configuration Change Activity
// ID: cc36992a-4671-4f21-a91d-6c2b72a2edf5
// Status: stable
// Level: high
// Author: Ecco, Daniil Yugoslavskiy, oscd.community, D3F7A5105, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2019-09-26
// Tags: attack.defense-impairment, attack.t1685.005, attack.t1685.001, car.2016-04-002
// Description: Detects the clearing or configuration tampering of EventLog using utilities such as "wevtutil", "powershell" and "wmic".
// This technique were seen used by threat actors and ransomware strains in order to evade defenses.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((((contains(CommandLine, "clear-log ") OR contains(CommandLine, " cl ") OR contains(CommandLine, "set-log ") OR contains(CommandLine, " sl ") OR contains(CommandLine, "lfn:"))) AND ((Image="*\\wevtutil.exe") OR (OriginalFileName == "wevtutil.exe"))) OR ((((contains(CommandLine, "Clear-EventLog ") OR contains(CommandLine, "Remove-EventLog ") OR contains(CommandLine, "Limit-EventLog ") OR contains(CommandLine, "Clear-WinEvent "))) OR ((contains(CommandLine, "Eventing.Reader.EventLogSession") AND contains(CommandLine, "ClearLog"))) OR ((contains(CommandLine, "Diagnostics.EventLog") AND contains(CommandLine, "Clear")))) AND ((Image="*\\powershell.exe" OR Image="*\\powershell_ise.exe" OR Image="*\\pwsh.exe"))) OR ((Image="*\\powershell.exe" OR Image="*\\powershell_ise.exe" OR Image="*\\pwsh.exe" OR Image="*\\wmic.exe") AND contains(CommandLine, "ClearEventLog"))) AND NOT (((ParentImage == "C:\\Windows\\SysWOW64\\msiexec.exe" OR ParentImage == "C:\\Windows\\System32\\msiexec.exe") AND contains(CommandLine, " sl "))))
