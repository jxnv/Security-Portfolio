// Title: Antivirus - Hacktool Signature
// ID: fa0c05b6-8ad3-468d-8231-c1cbccb64fba
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems), Arnim Rupp
// Date: 2021-08-16
// Tags: attack.execution, attack.t1204
// Description: Detects a highly relevant Antivirus alert that reports a hack tool or other attack tool.
// This event must not be ignored just because the AV has blocked the malware but investigate, how it came there in the first place.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((Signature="ATK/*" OR Signature="Exploit.Script.CVE*" OR Signature="HKTL*" OR Signature="HTOOL*" OR Signature="PWS.*" OR Signature="PWSX*" OR Signature="SecurityTool*")) OR ((contains(Signature, "Adfind") OR contains(Signature, "BloodH") OR contains(Signature, "BloodyAD") OR contains(Signature, "Brutel") OR contains(Signature, "BruteR") OR contains(Signature, "Cobalt") OR contains(Signature, "COBEACON") OR contains(Signature, "Cometer") OR contains(Signature, "DumpCreds") OR contains(Signature, "EDRfreeze") OR contains(Signature, "FastReverseProxy") OR contains(Signature, "Hacktool") OR contains(Signature, "Havoc") OR contains(Signature, "Impacket") OR contains(Signature, "Keylogger") OR contains(Signature, "Koadic") OR contains(Signature, "Mimikatz") OR contains(Signature, "Nighthawk") OR contains(Signature, "PentestPowerShell") OR contains(Signature, "Potato") OR contains(Signature, "PowerSploit") OR contains(Signature, "PowerSSH") OR contains(Signature, "PshlSpy") OR contains(Signature, "PSWTool") OR contains(Signature, "PWCrack") OR contains(Signature, "PWDump") OR contains(Signature, "Responder") OR contains(Signature, "Rozena") OR contains(Signature, "Rusthound") OR contains(Signature, "Sbelt") OR contains(Signature, "Seatbelt") OR contains(Signature, "SecurityTool") OR contains(Signature, "SharpDump") OR contains(Signature, "SharpHound") OR contains(Signature, "Shellcode") OR contains(Signature, "Sliver") OR contains(Signature, "Snaffler") OR contains(Signature, "SOAPHound") OR contains(Signature, "Splinter") OR contains(Signature, "Stowaway") OR contains(Signature, "Swrort") OR contains(Signature, "Trojan.Hound") OR contains(Signature, "TurtleLoader") OR contains(Signature, "Undefend") OR contains(Signature, "Undfnd"))))
