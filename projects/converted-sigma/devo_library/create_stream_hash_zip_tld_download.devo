// Title: Potentially Suspicious File Download From ZIP TLD
// ID: 0bb4bbeb-fe52-4044-b40c-430a04577ebe
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2023-05-18
// Tags: attack.stealth
// Description: Detects the download of a file with a potentially suspicious extension from a .zip top level domain.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (contains(Contents, ".zip/") AND (contains(TargetFilename, ".bat:Zone") OR contains(TargetFilename, ".dat:Zone") OR contains(TargetFilename, ".dll:Zone") OR contains(TargetFilename, ".doc:Zone") OR contains(TargetFilename, ".docm:Zone") OR contains(TargetFilename, ".exe:Zone") OR contains(TargetFilename, ".hta:Zone") OR contains(TargetFilename, ".pptm:Zone") OR contains(TargetFilename, ".ps1:Zone") OR contains(TargetFilename, ".rar:Zone") OR contains(TargetFilename, ".rtf:Zone") OR contains(TargetFilename, ".sct:Zone") OR contains(TargetFilename, ".vbe:Zone") OR contains(TargetFilename, ".vbs:Zone") OR contains(TargetFilename, ".ws:Zone") OR contains(TargetFilename, ".wsf:Zone") OR contains(TargetFilename, ".xll:Zone") OR contains(TargetFilename, ".xls:Zone") OR contains(TargetFilename, ".xlsm:Zone") OR contains(TargetFilename, ".zip:Zone")))
