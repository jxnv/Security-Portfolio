// Title: File Encryption/Decryption Via Gpg4win From Suspicious Locations
// ID: e1e0b7d7-e10b-4ee4-ac49-a4bda05d320d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2022-11-30
// Tags: attack.execution
// Description: Detects usage of Gpg4win to encrypt/decrypt files located in potentially suspicious locations.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(CommandLine, "-passphrase")) AND (((Image="*\\gpg.exe" OR Image="*\\gpg2.exe")) OR (Product == "GNU Privacy Guard (GnuPG)") OR (Description == "GnuPG’s OpenPGP tool")) AND ((contains(CommandLine, ":\\PerfLogs\\") OR contains(CommandLine, ":\\Temp\\") OR contains(CommandLine, ":\\Users\\Public\\") OR contains(CommandLine, ":\\Windows\\Temp\\") OR contains(CommandLine, "\\AppData\\Local\\Temp\\") OR contains(CommandLine, "\\AppData\\Roaming\\"))))
