// Title: JXA In-memory Execution Via OSAScript
// ID: f1408a58-0e94-4165-b80a-da9f96cf6fc3
// Status: test
// Level: high
// Author: Sohan G (D4rkCiph3r)
// Date: 2023-01-31
// Tags: attack.t1059.002, attack.t1059.007, attack.execution
// Description: Detects possible malicious execution of JXA in-memory via OSAScript
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((contains(CommandLine, " -l ") AND contains(CommandLine, "JavaScript"))) OR (contains(CommandLine, ".js"))) AND ((contains(CommandLine, "osascript") AND contains(CommandLine, " -e ") AND contains(CommandLine, "eval") AND contains(CommandLine, "NSData.dataWithContentsOfURL"))))
