// Title: Script Interpreter Execution From Suspicious Folder
// ID: 1228c958-e64e-4e71-92ad-7d429f4138ba
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-02-08
// Tags: attack.execution, attack.t1059
// Description: Detects suspicious script execution from suspicious directories or folders accessible by environment variables that may indicate malware activity.
// Script interpreters (cscript, wscript, mshta, powershell) executing from folders like Temp, Public, or user profile directories may suggest attempts to evade detection or execute malicious scripts.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((contains(CommandLine, " -ep bypass ") OR contains(CommandLine, " -ExecutionPolicy bypass ") OR contains(CommandLine, " -w hidden ") OR contains(CommandLine, "/e:javascript ") OR contains(CommandLine, "/e:Jscript ") OR contains(CommandLine, "/e:vbscript "))) OR ((Image="*\\cscript.exe" OR Image="*\\mshta.exe" OR Image="*\\wscript.exe")) OR ((OriginalFileName == "cscript.exe" OR OriginalFileName == "mshta.exe" OR OriginalFileName == "wscript.exe"))) AND (((contains(CommandLine, ":\\Perflogs\\") OR contains(CommandLine, ":\\Users\\Public\\") OR contains(CommandLine, "\\%Public%") OR contains(CommandLine, "\\AppData\\Local\\Temp") OR contains(CommandLine, "\\AppData\\Roaming\\Temp") OR contains(CommandLine, "\\Temporary Internet") OR contains(CommandLine, "\\Windows\\Temp") OR contains(CommandLine, "\\Start Menu\\Programs\\Startup\\") OR contains(CommandLine, "%TEMP%") OR contains(CommandLine, "%TMP%") OR contains(CommandLine, "%LocalAppData%\\Temp"))) OR (((contains(CommandLine, ":\\Users\\") AND contains(CommandLine, "\\Favorites\\"))) OR ((contains(CommandLine, ":\\Users\\") AND contains(CommandLine, "\\Favourites\\"))) OR ((contains(CommandLine, ":\\Users\\") AND contains(CommandLine, "\\Contacts\\"))) OR ((contains(CommandLine, ":\\Users\\") AND contains(CommandLine, "\\Documents\\"))) OR ((contains(CommandLine, ":\\Users\\") AND contains(CommandLine, "\\Music\\"))) OR ((contains(CommandLine, ":\\Users\\") AND contains(CommandLine, "\\Pictures\\"))) OR ((contains(CommandLine, ":\\Users\\") AND contains(CommandLine, "\\Videos\\"))))) AND NOT (((ParentImage == "C:\\Windows\\System32\\Msiexec.exe" OR ParentImage == "C:\\Windows\\SysWOW64\\Msiexec.exe") AND Image="*\\powershell.exe" AND (contains(CommandLine, "-NoProfile -ExecutionPolicy Bypass -Command") AND contains(CommandLine, "AppData\\Local\\Temp\\") AND contains(CommandLine, "Install-Chocolatey.ps1")))))
