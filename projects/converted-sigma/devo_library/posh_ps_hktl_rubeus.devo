// Title: HackTool - Rubeus Execution - ScriptBlock
// ID: 3245cd30-e015-40ff-a31d-5cadd5f377ec
// Status: test
// Level: high
// Author: Christian Burkard (Nextron Systems), Florian Roth (Nextron Systems)
// Date: 2023-04-27
// Tags: attack.credential-access, attack.t1003, attack.t1558.003, attack.lateral-movement, attack.t1550.003
// Description: Detects the execution of the hacktool Rubeus using specific command line flags
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(ScriptBlockText, "asreproast ") OR contains(ScriptBlockText, "dump /service:krbtgt ") OR contains(ScriptBlockText, "dump /luid:0x") OR contains(ScriptBlockText, "kerberoast ") OR contains(ScriptBlockText, "createnetonly /program:") OR contains(ScriptBlockText, "ptt /ticket:") OR contains(ScriptBlockText, "/impersonateuser:") OR contains(ScriptBlockText, "renew /ticket:") OR contains(ScriptBlockText, "asktgt /user:") OR contains(ScriptBlockText, "harvest /interval:") OR contains(ScriptBlockText, "s4u /user:") OR contains(ScriptBlockText, "s4u /ticket:") OR contains(ScriptBlockText, "hash /password:") OR contains(ScriptBlockText, "golden /aes256:") OR contains(ScriptBlockText, "silver /user:")))
