// Title: Delete Important Scheduled Task
// ID: dbc1f800-0fe0-4bc0-9c66-292c2abe3f78
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.impact, attack.t1489
// Description: Detects when adversaries stop services or processes by deleting their respective scheduled tasks in order to conduct data destructive activities
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "/delete") OR contains(CommandLine, "-delete"))) AND ((contains(CommandLine, "\\Windows\\BitLocker") OR contains(CommandLine, "\\Windows\\ExploitGuard") OR contains(CommandLine, "\\Windows\\SystemRestore\\SR") OR contains(CommandLine, "\\Windows\\UpdateOrchestrator\\") OR contains(CommandLine, "\\Windows\\Windows Defender\\") OR contains(CommandLine, "\\Windows\\WindowsBackup\\") OR contains(CommandLine, "\\Windows\\WindowsUpdate\\"))) AND ((Image="*\\schtasks.exe") OR (OriginalFileName == "schtasks.exe")))
