// Title: MSI Installation From Suspicious Locations
// ID: c7c8aa1c-5aff-408e-828b-998e3620b341
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-31
// Tags: attack.execution
// Description: Detects MSI package installation from suspicious locations
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((Provider_Name == "MsiInstaller" AND (EventID == "1040" OR EventID == "1042") AND (contains(Data, ":\\Windows\\TEMP\\") OR contains(Data, "\\\\\\\\") OR contains(Data, "\\Desktop\\") OR contains(Data, "\\PerfLogs\\") OR contains(Data, "\\Users\\Public\\"))) AND NOT (((contains(Data, "C:\\Windows\\TEMP\\UpdHealthTools.msi")) OR (contains(Data, "\\AppData\\Local\\Temp\\WinGet\\")))))
