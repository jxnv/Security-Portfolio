// Title: Service Started/Stopped Via Wmic.EXE
// ID: 0b7163dc-7eee-4960-af17-c0cd517f92da
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-20
// Tags: attack.execution, attack.t1047
// Description: Detects usage of wmic to start or stop a service
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, " service ") AND contains(CommandLine, " call ")) AND (contains(CommandLine, "stopservice") OR contains(CommandLine, "startservice"))) AND ((OriginalFileName == "wmic.exe") OR (Image="*\\WMIC.exe")))
