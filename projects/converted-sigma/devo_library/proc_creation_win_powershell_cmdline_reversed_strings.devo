// Title: Potential PowerShell Obfuscation Via Reversed Commands
// ID: b6b49cd1-34d6-4ead-b1bf-176e9edba9a4
// Status: test
// Level: high
// Author: Teymur Kheirkhabarov (idea), Vasiliy Burov (rule), oscd.community, Tim Shelton
// Date: 2020-10-11
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects the presence of reversed PowerShell commands in the CommandLine. This is often used as a method of obfuscation by attackers
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((contains(CommandLine, "hctac") OR contains(CommandLine, "kaerb") OR contains(CommandLine, "dnammoc") OR contains(CommandLine, "ekovn") OR contains(CommandLine, "eliFd") OR contains(CommandLine, "rahc") OR contains(CommandLine, "etirw") OR contains(CommandLine, "golon") OR contains(CommandLine, "tninon") OR contains(CommandLine, "eddih") OR contains(CommandLine, "tpircS") OR contains(CommandLine, "ssecorp") OR contains(CommandLine, "llehsrewop") OR contains(CommandLine, "esnopser") OR contains(CommandLine, "daolnwod") OR contains(CommandLine, "tneilCbeW") OR contains(CommandLine, "tneilc") OR contains(CommandLine, "ptth") OR contains(CommandLine, "elifotevas") OR contains(CommandLine, "46esab") OR contains(CommandLine, "htaPpmeTteG") OR contains(CommandLine, "tcejbO") OR contains(CommandLine, "maerts") OR contains(CommandLine, "hcaerof") OR contains(CommandLine, "retupmoc"))) AND (((Image="*\\powershell.exe" OR Image="*\\pwsh.exe")) OR ((OriginalFileName == "PowerShell.EXE" OR OriginalFileName == "pwsh.dll")))) AND NOT (((contains(CommandLine, " -EncodedCommand ") OR contains(CommandLine, " -enc ")))))
