// Title: Kubernetes Potential Enumeration Activity
// ID: 597a7e84-187d-458b-9e4f-2f5a0e676711
// Status: experimental
// Level: medium
// Author: uniqu3-us3r
// Date: 2026-04-28
// Tags: attack.execution, attack.discovery, attack.t1609, attack.t1613
// Description: Detects potential Kubernetes enumeration or attack activity via the audit log.
// This includes the execution of common shells, utilities, or specialized tools like 'Rakkess' (access_matrix) and 'TruffleHog' via Kubernetes API requests.
// Attackers use these methods to perform reconnaissance (enumeration), secret harvesting, or execute code (exec) within a cluster.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((responseStatus.code == "ALLOW") AND (((contains(requestURI, "%2fbin%2fash") OR contains(requestURI, "%2fbin%2fbash") OR contains(requestURI, "%2fbin%2fbusybox") OR contains(requestURI, "%2fbin%2fdash") OR contains(requestURI, "%2fbin%2fsh") OR contains(requestURI, "%2fbin%2fzsh") OR contains(requestURI, "/bin/ash") OR contains(requestURI, "/bin/bash") OR contains(requestURI, "/bin/busybox") OR contains(requestURI, "/bin/dash") OR contains(requestURI, "/bin/sh") OR contains(requestURI, "/bin/zsh") OR contains(requestURI, "%2fusr%2fbin%2fcurl") OR contains(requestURI, "%2fusr%2fbin%2fkubectl") OR contains(requestURI, "%2fusr%2fbin%2fperl") OR contains(requestURI, "%2fusr%2fbin%2fpython") OR contains(requestURI, "%2fusr%2fbin%2fwget") OR contains(requestURI, "/usr/bin/curl") OR contains(requestURI, "/usr/bin/kubectl") OR contains(requestURI, "/usr/bin/perl") OR contains(requestURI, "/usr/bin/python") OR contains(requestURI, "/usr/bin/wget"))) OR ((contains(userAgent, "access_matrix") OR contains(userAgent, "trufflehog") OR contains(userAgent, "azurehound") OR contains(userAgent, "micro-scanner")))))
