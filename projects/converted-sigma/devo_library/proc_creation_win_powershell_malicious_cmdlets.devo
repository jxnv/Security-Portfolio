// Title: Malicious PowerShell Commandlets - ProcessCreation
// ID: 02030f2f-6199-49ec-b258-ea71b07e03dc
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-02
// Tags: attack.execution, attack.discovery, attack.t1482, attack.t1087, attack.t1087.001, attack.t1087.002, attack.t1069.001, attack.t1069.002, attack.t1069, attack.t1059.001
// Description: Detects Commandlet names from well-known PowerShell exploitation frameworks
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(CommandLine, "Add-Exfiltration") OR contains(CommandLine, "Add-Persistence") OR contains(CommandLine, "Add-RegBackdoor") OR contains(CommandLine, "Add-RemoteRegBackdoor") OR contains(CommandLine, "Add-ScrnSaveBackdoor") OR contains(CommandLine, "Check-VM") OR contains(CommandLine, "ConvertTo-Rc4ByteStream") OR contains(CommandLine, "Decrypt-Hash") OR contains(CommandLine, "Disable-ADIDNSNode") OR contains(CommandLine, "Disable-MachineAccount") OR contains(CommandLine, "Do-Exfiltration") OR contains(CommandLine, "Enable-ADIDNSNode") OR contains(CommandLine, "Enable-MachineAccount") OR contains(CommandLine, "Enabled-DuplicateToken") OR contains(CommandLine, "Exploit-Jboss") OR contains(CommandLine, "Export-ADR") OR contains(CommandLine, "Export-ADRCSV") OR contains(CommandLine, "Export-ADRExcel") OR contains(CommandLine, "Export-ADRHTML") OR contains(CommandLine, "Export-ADRJSON") OR contains(CommandLine, "Export-ADRXML") OR contains(CommandLine, "Find-Fruit") OR contains(CommandLine, "Find-GPOLocation") OR contains(CommandLine, "Find-TrustedDocuments") OR contains(CommandLine, "Get-ADIDNS") OR contains(CommandLine, "Get-ApplicationHost") OR contains(CommandLine, "Get-ChromeDump") OR contains(CommandLine, "Get-ClipboardContents") OR contains(CommandLine, "Get-FoxDump") OR contains(CommandLine, "Get-GPPPassword") OR contains(CommandLine, "Get-IndexedItem") OR contains(CommandLine, "Get-KerberosAESKey") OR contains(CommandLine, "Get-Keystrokes") OR contains(CommandLine, "Get-LSASecret") OR contains(CommandLine, "Get-MachineAccountAttribute") OR contains(CommandLine, "Get-MachineAccountCreator") OR contains(CommandLine, "Get-PassHashes") OR contains(CommandLine, "Get-RegAlwaysInstallElevated") OR contains(CommandLine, "Get-RegAutoLogon") OR contains(CommandLine, "Get-RemoteBootKey") OR contains(CommandLine, "Get-RemoteCachedCredential") OR contains(CommandLine, "Get-RemoteLocalAccountHash") OR contains(CommandLine, "Get-RemoteLSAKey") OR