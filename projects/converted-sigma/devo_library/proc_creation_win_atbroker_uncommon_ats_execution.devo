// Title: Uncommon  Assistive Technology Applications Execution Via AtBroker.EXE
// ID: f24bcaea-0cd1-11eb-adc1-0242ac120002
// Status: test
// Level: medium
// Author: Mateusz Wydra, oscd.community
// Date: 2020-10-12
// Tags: attack.stealth, attack.t1218
// Description: Detects the start of a non built-in assistive technology applications via "Atbroker.EXE".
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "start")) AND ((Image="*\\AtBroker.exe") OR (OriginalFileName == "AtBroker.exe"))) AND NOT (((contains(CommandLine, "animations") OR contains(CommandLine, "audiodescription") OR contains(CommandLine, "caretbrowsing") OR contains(CommandLine, "caretwidth") OR contains(CommandLine, "colorfiltering") OR contains(CommandLine, "cursorindicator") OR contains(CommandLine, "cursorscheme") OR contains(CommandLine, "filterkeys") OR contains(CommandLine, "focusborderheight") OR contains(CommandLine, "focusborderwidth") OR contains(CommandLine, "highcontrast") OR contains(CommandLine, "keyboardcues") OR contains(CommandLine, "keyboardpref") OR contains(CommandLine, "livecaptions") OR contains(CommandLine, "magnifierpane") OR contains(CommandLine, "messageduration") OR contains(CommandLine, "minimumhitradius") OR contains(CommandLine, "mousekeys") OR contains(CommandLine, "Narrator") OR contains(CommandLine, "osk") OR contains(CommandLine, "overlappedcontent") OR contains(CommandLine, "showsounds") OR contains(CommandLine, "soundsentry") OR contains(CommandLine, "speechreco") OR contains(CommandLine, "stickykeys") OR contains(CommandLine, "togglekeys") OR contains(CommandLine, "voiceaccess") OR contains(CommandLine, "windowarranging") OR contains(CommandLine, "windowtracking") OR contains(CommandLine, "windowtrackingtimeout") OR contains(CommandLine, "windowtrackingzorder")))) AND NOT ((contains(CommandLine, "Oracle_JavaAccessBridge"))))
