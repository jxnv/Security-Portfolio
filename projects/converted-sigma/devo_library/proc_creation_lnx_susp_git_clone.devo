// Title: Suspicious Git Clone - Linux
// ID: cfec9d29-64ec-4a0f-9ffe-0fdb856d5446
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-03
// Tags: attack.reconnaissance, attack.t1593.003
// Description: Detects execution of "git" in order to clone a remote repository that contain suspicious keywords which might be suspicious
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((Image="*/git" AND contains(CommandLine, " clone ")) AND ((contains(CommandLine, "exploit") OR contains(CommandLine, "Vulns") OR contains(CommandLine, "vulnerability") OR contains(CommandLine, "RCE") OR contains(CommandLine, "RemoteCodeExecution") OR contains(CommandLine, "Invoke-") OR contains(CommandLine, "CVE-") OR contains(CommandLine, "poc-") OR contains(CommandLine, "ProofOfConcept") OR contains(CommandLine, "proxyshell") OR contains(CommandLine, "log4shell") OR contains(CommandLine, "eternalblue") OR contains(CommandLine, "eternal-blue") OR contains(CommandLine, "MS17-"))))
