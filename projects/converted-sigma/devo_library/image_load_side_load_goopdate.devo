// Title: Potential Goopdate.DLL Sideloading
// ID: b6188d2f-b3c4-4d2c-a17d-9706e0851af0
// Status: test
// Level: medium
// Author: X__Junior (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-15
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of "goopdate.dll", a DLL used by googleupdate.exe
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((ImageLoaded="*\\goopdate.dll") AND NOT (((ImageLoaded="C:\\Program Files (x86)\\*" OR ImageLoaded="C:\\Program Files\\*"))) AND NOT ((((contains(Image, "\\AppData\\Local\\Temp\\GUM") AND contains(Image, ".tmp\\Dropbox")) AND (contains(ImageLoaded, "\\AppData\\Local\\Temp\\GUM") AND contains(ImageLoaded, ".tmp\\goopdate.dll"))) OR ((contains(Image, "\\AppData\\Local\\Temp\\GUM") OR contains(Image, ":\\Windows\\SystemTemp\\GUM")) AND Image="*.tmp\\GoogleUpdate.exe" AND (contains(ImageLoaded, "\\AppData\\Local\\Temp\\GUM") OR contains(ImageLoaded, ":\\Windows\\SystemTemp\\GUM"))))))
