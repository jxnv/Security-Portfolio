// Title: PUA - Sysinternals Tools Execution - Registry
// ID: c7da8edc-49ae-45a2-9e61-9fd860e4e73d
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-24
// Tags: attack.resource-development, attack.t1588.002
// Description: Detects the execution of some potentially unwanted tools such as PsExec, Procdump, etc. (part of the Sysinternals suite) via the creation of the "accepteula" registry key.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(TargetObject, "\\Active Directory Explorer") OR contains(TargetObject, "\\Handle") OR contains(TargetObject, "\\LiveKd") OR contains(TargetObject, "\\Process Explorer") OR contains(TargetObject, "\\ProcDump") OR contains(TargetObject, "\\PsExec") OR contains(TargetObject, "\\PsLoglist") OR contains(TargetObject, "\\PsPasswd") OR contains(TargetObject, "\\SDelete") OR contains(TargetObject, "\\Sysinternals")) AND TargetObject="*\\EulaAccepted")
