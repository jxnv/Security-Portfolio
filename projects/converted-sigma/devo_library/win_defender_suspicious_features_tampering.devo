// Title: Windows Defender Configuration Changes
// ID: 801bd44f-ceed-4eb6-887c-11544633c0aa
// Status: stable
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-06
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects suspicious changes to the Windows Defender configuration
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (EventID == "5007" AND (contains(NewValue, "\\Windows Defender\\DisableAntiSpyware ") OR contains(NewValue, "\\Windows Defender\\Scan\\DisableRemovableDriveScanning ") OR contains(NewValue, "\\Windows Defender\\Scan\\DisableScanningMappedNetworkDrivesForFullScan ") OR contains(NewValue, "\\Windows Defender\\SpyNet\\DisableBlockAtFirstSeen ") OR contains(NewValue, "\\Real-Time Protection\\SpyNetReporting ")))
