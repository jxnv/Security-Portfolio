// Description: Detects scriptblock text keywords indicative of potential usge of the tool WinPwn. A tool for Windows and Active Directory reconnaissance and exploitation.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((contains(ScriptBlockText, "Offline_Winpwn") OR contains(ScriptBlockText, "WinPwn ") OR contains(ScriptBlockText, "WinPwn.exe") OR contains(ScriptBlockText, "WinPwn.ps1")))
