// Tags: attack.execution
// Description: Detects the execution of python with calls to the socket and pty module in order to connect and spawn a potential reverse shell.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (contains(Image, "python") AND (contains(CommandLine, " -c ") AND contains(CommandLine, "import") AND contains(CommandLine, "pty") AND contains(CommandLine, "socket") AND contains(CommandLine, "spawn") AND contains(CommandLine, ".connect")))
