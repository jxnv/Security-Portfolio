// Title: Usage Of Web Request Commands And Cmdlets - ScriptBlock
// ID: 1139d2e2-84b1-4226-b445-354492eba8ba
// Status: test
// Level: medium
// Author: James Pemberton / @4A616D6573
// Date: 2019-10-24
// Tags: attack.execution, attack.t1059.001
// Description: Detects the use of various web request commands with commandline tools and Windows PowerShell cmdlets (including aliases) via PowerShell scriptblock logs
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(ScriptBlockText, "[System.Net.WebRequest]::create") OR contains(ScriptBlockText, "curl ") OR contains(ScriptBlockText, "Invoke-RestMethod") OR contains(ScriptBlockText, "Invoke-WebRequest") OR contains(ScriptBlockText, " irm ") OR contains(ScriptBlockText, "iwr ") OR contains(ScriptBlockText, "Resume-BitsTransfer") OR contains(ScriptBlockText, "Start-BitsTransfer") OR contains(ScriptBlockText, "wget ") OR contains(ScriptBlockText, "WinHttp.WinHttpRequest"))) AND NOT ((Path="C:\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\*")))
