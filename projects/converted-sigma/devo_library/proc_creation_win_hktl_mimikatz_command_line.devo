// Title: HackTool - Mimikatz Execution
// ID: a642964e-bead-4bed-8910-1bb4d63e3b4d
// Status: test
// Level: high
// Author: Teymur Kheirkhabarov, oscd.community, David ANDRE (additional keywords), Tim Shelton
// Date: 2019-10-22
// Tags: attack.credential-access, attack.t1003.001, attack.t1003.002, attack.t1003.004, attack.t1003.005, attack.t1003.006
// Description: Detection well-known mimikatz command line arguments
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, "::aadcookie") OR contains(CommandLine, "::detours") OR contains(CommandLine, "::memssp") OR contains(CommandLine, "::mflt") OR contains(CommandLine, "::ncroutemon") OR contains(CommandLine, "::ngcsign") OR contains(CommandLine, "::printnightmare") OR contains(CommandLine, "::skeleton") OR contains(CommandLine, "::preshutdown") OR contains(CommandLine, "::mstsc") OR contains(CommandLine, "::multirdp"))) OR ((contains(CommandLine, "rpc::") OR contains(CommandLine, "token::") OR contains(CommandLine, "crypto::") OR contains(CommandLine, "dpapi::") OR contains(CommandLine, "sekurlsa::") OR contains(CommandLine, "kerberos::") OR contains(CommandLine, "lsadump::") OR contains(CommandLine, "privilege::") OR contains(CommandLine, "process::") OR contains(CommandLine, "vault::"))) OR ((contains(CommandLine, "DumpCreds") OR contains(CommandLine, "mimikatz"))))
