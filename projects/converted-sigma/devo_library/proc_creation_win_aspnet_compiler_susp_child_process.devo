// Title: Suspicious Child Process of AspNetCompiler
// ID: 9ccba514-7cb6-4c5c-b377-700758f2f120
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-08-14
// Tags: attack.execution, attack.stealth, attack.t1127
// Description: Detects potentially suspicious child processes of "aspnet_compiler.exe".
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((Image="*\\calc.exe" OR Image="*\\notepad.exe")) OR ((contains(Image, "\\Users\\Public\\") OR contains(Image, "\\AppData\\Local\\Temp\\") OR contains(Image, "\\AppData\\Local\\Roaming\\") OR contains(Image, ":\\Temp\\") OR contains(Image, ":\\Windows\\Temp\\") OR contains(Image, ":\\Windows\\System32\\Tasks\\") OR contains(Image, ":\\Windows\\Tasks\\")))) AND (ParentImage="*\\aspnet_compiler.exe"))
