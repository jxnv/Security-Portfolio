// Title: Potential Binary Or Script Dropper Via PowerShell
// ID: 7047d730-036f-4f40-b9d8-1c63e36d5e62
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-03-17
// Tags: attack.persistence
// Description: Detects PowerShell creating a binary executable or a script file.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((Image="*\\powershell.exe" OR Image="*\\powershell_ise.exe" OR Image="*\\pwsh.exe") AND (TargetFilename="*.bat" OR TargetFilename="*.chm" OR TargetFilename="*.cmd" OR TargetFilename="*.com" OR TargetFilename="*.dll" OR TargetFilename="*.exe" OR TargetFilename="*.hta" OR TargetFilename="*.jar" OR TargetFilename="*.js" OR TargetFilename="*.ocx" OR TargetFilename="*.scr" OR TargetFilename="*.sys" OR TargetFilename="*.vbe" OR TargetFilename="*.vbs" OR TargetFilename="*.wsf")) AND NOT (((TargetFilename="C:\\Program Files\\PackageManagement\\ProviderAssemblies\\nuget\\*" AND TargetFilename="*\\Microsoft.PackageManagement.NuGetProvider.dll") OR ((TargetFilename="C:\\Windows\\Temp\\*" OR TargetFilename="C:\\Windows\\SystemTemp\\*") AND (TargetFilename="*.dll" OR TargetFilename="*.exe")) OR (TargetFilename="C:\\Users\\*" AND contains(TargetFilename, "\\WindowsPowerShell\\Modules\\") AND TargetFilename="*.dll") OR (TargetFilename="C:\\Users\\*" AND contains(TargetFilename, "\\AppData\\Local\\Temp\\") AND (TargetFilename="*.dll" OR TargetFilename="*.exe")))))
