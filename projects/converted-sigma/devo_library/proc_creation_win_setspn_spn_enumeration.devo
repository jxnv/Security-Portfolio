// Title: Potential SPN Enumeration Via Setspn.EXE
// ID: 1eeed653-dbc8-4187-ad0c-eeebb20e6599
// Status: test
// Level: medium
// Author: Markus Neis, keepwatch
// Date: 2018-11-14
// Tags: attack.credential-access, attack.t1558.003
// Description: Detects service principal name (SPN) enumeration used for Kerberoasting
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where (((contains(CommandLine, " -q ") OR contains(CommandLine, " /q "))) AND ((Image="*\\setspn.exe") OR (OriginalFileName == "setspn.exe") OR ((contains(Description, "Query or reset the computer") AND contains(Description, "SPN attribute")))))
