// Title: HackTool - LaZagne Execution
// ID: c2b86e67-b880-4eec-b045-50bc98ef4844
// Status: experimental
// Level: medium
// Author: Nasreddine Bencherchali, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.credential-access
// Description: Detects the execution of the LaZagne. A utility used to retrieve multiple types of passwords stored on a local computer.
// LaZagne has been leveraged multiple times by threat actors in order to dump credentials.
// Converted by: Sigma Universal SIEM/EDR CLI

from siem.events where ((((contains(Image, ":\\PerfLogs\\") OR contains(Image, ":\\ProgramData\\") OR contains(Image, ":\\Temp\\") OR contains(Image, ":\\Tmp\\") OR contains(Image, ":\\Users\\Public\\") OR contains(Image, ":\\Windows\\Temp\\") OR contains(Image, "\\$Recycle.bin") OR contains(Image, "\\AppData\\") OR contains(Image, "\\Desktop\\") OR contains(Image, "\\Downloads\\") OR contains(Image, "\\Favorites\\") OR contains(Image, "\\Links\\") OR contains(Image, "\\Music\\") OR contains(Image, "\\Photos\\") OR contains(Image, "\\Pictures\\") OR contains(Image, "\\Saved Games\\") OR contains(Image, "\\Searches\\") OR contains(Image, "\\Users\\Contacts\\") OR contains(Image, "\\Users\\Default\\") OR contains(Image, "\\Users\\Searches\\") OR contains(Image, "\\Videos\\") OR contains(Image, "\\Windows\\addins\\") OR contains(Image, "\\Windows\\Fonts\\") OR contains(Image, "\\Windows\\IME\\")) AND (CommandLine="*.exe all" OR CommandLine="*.exe browsers" OR CommandLine="*.exe chats" OR CommandLine="*.exe databases" OR CommandLine="*.exe games" OR CommandLine="*.exe git" OR CommandLine="*.exe mails" OR CommandLine="*.exe maven" OR CommandLine="*.exe memory" OR CommandLine="*.exe multimedia" OR CommandLine="*.exe sysadmin" OR CommandLine="*.exe unused" OR CommandLine="*.exe wifi" OR CommandLine="*.exe windows")) OR (Image="*\\lazagne.exe")) OR (((contains(CommandLine, " all ") OR contains(CommandLine, " browsers ") OR contains(CommandLine, " chats ") OR contains(CommandLine, " databases ") OR contains(CommandLine, " games ") OR contains(CommandLine, " mails ") OR contains(CommandLine, " maven ") OR contains(CommandLine, " memory ") OR contains(CommandLine, " multimedia ") OR contains(CommandLine, " php ") OR contains(CommandLine, " svn ") OR contains(CommandLine, " sysadmin ") OR contains(CommandLine, " unused ") OR contains(CommandLine, " wifi "))) AND ((contains(CommandLine, "-1Password") OR contains(CommandLine, "-apachedirectorystudio") OR contains(CommandLine, "-autologon") OR contains(CommandLine, "-ChromiumBased") OR contains(CommandLine, "-coreftp") OR contains(CommandLine, "-credfiles") OR contains(CommandLine, "-credman") OR contains(CommandLine, "-cyberduck") OR contains(CommandLine, "-dbvis") OR contains(CommandLine, "-EyeCon") OR contains(CommandLine, "-filezilla") OR contains(CommandLine, "-filezillaserver") OR contains(CommandLine, "-ftpnavigator") OR contains(CommandLine, "-galconfusion") OR contains(CommandLine, "-gitforwindows") OR contains(CommandLine, "-hashdump") OR contains(CommandLine, "-iisapppool") OR contains(CommandLine, "-IISCentralCertP") OR contains(CommandLine, "-kalypsomedia") OR contains(CommandLine, "-keepass") OR contains(CommandLine, "-keepassconfig") OR contains(CommandLine, "-lsa_secrets") OR contains(CommandLine, "-mavenrepositories") OR contains(CommandLine, "-memory_dump") OR contains(CommandLine, "-Mozilla") OR contains(CommandLine, "-mRemoteNG") OR contains(CommandLine, "-mscache") OR contains(CommandLine, "-opensshforwindows") OR contains(CommandLine, "-openvpn") OR contains(CommandLine, "-outlook") OR contains(CommandLine, "-pidgin") OR contains(CommandLine, "-postgresql") OR contains(CommandLine, "-psi-im") OR contains(CommandLine, "-puttycm") OR contains(CommandLine, "-pypykatz") OR contains(CommandLine, "-Rclone") OR contains(CommandLine, "-rdpmanager") OR contains(CommandLine, "-robomongo") OR contains(CommandLine, "-roguestale") OR contains(CommandLine, "-skype") OR contains(CommandLine, "-SQLDeveloper") OR contains(CommandLine, "-squirrel") OR contains(CommandLine, "-tortoise") OR contains(CommandLine, "-turba") OR contains(CommandLine, "-UCBrowser") OR contains(CommandLine, "-unattended") OR contains(CommandLine, "-vault") OR contains(CommandLine, "-vaultfiles") OR contains(CommandLine, "-vnc") OR contains(CommandLine, "-winscp")))))
