// Description: Detects usage of bitsadmin downloading a file from a suspicious domain
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS ".githubusercontent.com" OR src.process.cmdline containsCIS "0x0.st" OR src.process.cmdline containsCIS "anonfiles.com" OR src.process.cmdline containsCIS "bashupload.com" OR src.process.cmdline containsCIS "cdn.discordapp.com" OR src.process.cmdline containsCIS "chunk.io" OR src.process.cmdline containsCIS "ddns.net" OR src.process.cmdline containsCIS "dl.dropboxusercontent.com" OR src.process.cmdline containsCIS "ghostbin.co" OR src.process.cmdline containsCIS "github.com" OR src.process.cmdline containsCIS "glitch.me" OR src.process.cmdline containsCIS "gofile.io" OR src.process.cmdline containsCIS "hastebin.com" OR src.process.cmdline containsCIS "mediafire.com" OR src.process.cmdline containsCIS "mega.nz" OR src.process.cmdline containsCIS "onrender.com" OR src.process.cmdline containsCIS "pages.dev" OR src.process.cmdline containsCIS "paste.ee" OR src.process.cmdline containsCIS "pastebin.com" OR src.process.cmdline containsCIS "pastebin.pl" OR src.process.cmdline containsCIS "pastetext.net" OR src.process.cmdline containsCIS "privatlab.com" OR src.process.cmdline containsCIS "privatlab.net" OR src.process.cmdline containsCIS "send.exploit.in" OR src.process.cmdline containsCIS "sendspace.com" OR src.process.cmdline containsCIS "storage.googleapis.com" OR src.process.cmdline containsCIS "storjshare.io" OR src.process.cmdline containsCIS "supabase.co" OR src.process.cmdline containsCIS "temp.sh" OR src.process.cmdline containsCIS "transfer.sh" OR src.process.cmdline containsCIS "trycloudflare.com" OR src.process.cmdline containsCIS "ufile.io" OR src.process.cmdline containsCIS "w3spaces.com" OR src.process.cmdline containsCIS "workers.dev" OR src.process.cmdline containsCIS "x0.at")) AND ((src.process.cmdline containsCIS " /transfer " OR src.process.cmdline containsCIS " /create " OR src.process.cmdline containsCIS " /addfile ")) AND ((src.process.image.path endswithCIS "\\bitsadmin.exe") OR (OriginalFileName = "bitsadmin.exe")))
