// Title: PUA - NirCmd Execution
// ID: 4e2ed651-1906-4a59-a78a-18220fca1b22
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-24
// Tags: attack.execution, attack.t1569.002, attack.s0029
// Description: Detects the use of NirCmd tool for command execution, which could be the result of legitimate administrative activity
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.cmdline containsCIS " execmd " OR src.process.cmdline containsCIS ".exe script " OR src.process.cmdline containsCIS ".exe shexec " OR src.process.cmdline containsCIS " runinteractive ")) OR ((src.process.image.path endswithCIS "\\NirCmd.exe") OR (OriginalFileName = "NirCmd.exe"))) OR (((src.process.cmdline containsCIS " exec " OR src.process.cmdline containsCIS " exec2 ")) AND ((src.process.cmdline containsCIS " show " OR src.process.cmdline containsCIS " hide "))))
