// Title: Linux Network Service Scanning - Auditd
// ID: 3761e026-f259-44e6-8826-719ed8079408
// Status: test
// Level: low
// Author: Alejandro Ortuno, oscd.community
// Date: 2020-10-21
// Tags: attack.discovery, attack.t1046
// Description: Detects enumeration of local or remote network services.
// Converted by: Sigma Universal SIEM/EDR CLI

(type = "SYSCALL" AND (exe endswithCIS "/telnet" OR exe endswithCIS "/nmap" OR exe endswithCIS "/netcat" OR exe endswithCIS "/nc" OR exe endswithCIS "/ncat" OR exe endswithCIS "/nc.openbsd") AND key = "network_connect_4")
