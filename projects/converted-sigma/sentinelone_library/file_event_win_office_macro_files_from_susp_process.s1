// Title: Office Macro File Creation From Suspicious Process
// ID: b1c50487-1967-4315-a026-6491686d860e
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-23
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects the creation of a office macro file from a a suspicious process
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.image.path endswithCIS "\\cscript.exe" OR src.process.image.path endswithCIS "\\mshta.exe" OR src.process.image.path endswithCIS "\\regsvr32.exe" OR src.process.image.path endswithCIS "\\rundll32.exe" OR src.process.image.path endswithCIS "\\wscript.exe")) OR ((src.process.parent.image.path endswithCIS "\\cscript.exe" OR src.process.parent.image.path endswithCIS "\\mshta.exe" OR src.process.parent.image.path endswithCIS "\\regsvr32.exe" OR src.process.parent.image.path endswithCIS "\\rundll32.exe" OR src.process.parent.image.path endswithCIS "\\wscript.exe"))) AND ((tgt.file.path endswithCIS ".docm" OR tgt.file.path endswithCIS ".dotm" OR tgt.file.path endswithCIS ".xlsm" OR tgt.file.path endswithCIS ".xltm" OR tgt.file.path endswithCIS ".potm" OR tgt.file.path endswithCIS ".pptm")))
