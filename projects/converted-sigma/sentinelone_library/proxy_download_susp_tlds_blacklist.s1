// Title: Download From Suspicious TLD - Blacklist
// ID: 00d0b5ab-1f55-4120-8e83-487c0a7baf19
// Status: test
// Level: low
// Author: Florian Roth (Nextron Systems)
// Date: 2017-11-07
// Tags: attack.initial-access, attack.t1566, attack.execution, attack.t1203, attack.t1204.002
// Description: Detects download of certain file types from hosts in suspicious TLDs
// Converted by: Sigma Universal SIEM/EDR CLI

((c-uri-extension = "exe" OR c-uri-extension = "vbs" OR c-uri-extension = "bat" OR c-uri-extension = "rar" OR c-uri-extension = "ps1" OR c-uri-extension = "doc" OR c-uri-extension = "docm" OR c-uri-extension = "xls" OR c-uri-extension = "xlsm" OR c-uri-extension = "pptm" OR c-uri-extension = "rtf" OR c-uri-extension = "hta" OR c-uri-extension = "dll" OR c-uri-extension = "ws" OR c-uri-extension = "wsf" OR c-uri-extension = "sct" OR c-uri-extension = "zip") AND (cs-host endswithCIS ".country" OR cs-host endswithCIS ".stream" OR cs-host endswithCIS ".gdn" OR cs-host endswithCIS ".mom" OR cs-host endswithCIS ".xin" OR cs-host endswithCIS ".kim" OR cs-host endswithCIS ".men" OR cs-host endswithCIS ".loan" OR cs-host endswithCIS ".download" OR cs-host endswithCIS ".racing" OR cs-host endswithCIS ".online" OR cs-host endswithCIS ".science" OR cs-host endswithCIS ".ren" OR cs-host endswithCIS ".gb" OR cs-host endswithCIS ".win" OR cs-host endswithCIS ".top" OR cs-host endswithCIS ".review" OR cs-host endswithCIS ".vip" OR cs-host endswithCIS ".party" OR cs-host endswithCIS ".tech" OR cs-host endswithCIS ".xyz" OR cs-host endswithCIS ".date" OR cs-host endswithCIS ".faith" OR cs-host endswithCIS ".zip" OR cs-host endswithCIS ".cricket" OR cs-host endswithCIS ".space" OR cs-host endswithCIS ".info" OR cs-host endswithCIS ".vn" OR cs-host endswithCIS ".cm" OR cs-host endswithCIS ".am" OR cs-host endswithCIS ".cc" OR cs-host endswithCIS ".asia" OR cs-host endswithCIS ".ws" OR cs-host endswithCIS ".tk" OR cs-host endswithCIS ".biz" OR cs-host endswithCIS ".su" OR cs-host endswithCIS ".st" OR cs-host endswithCIS ".ro" OR cs-host endswithCIS ".ge" OR cs-host endswithCIS ".ms" OR cs-host endswithCIS ".pk" OR cs-host endswithCIS ".nu" OR cs-host endswithCIS ".me" OR cs-host endswithCIS ".ph" OR cs-host endswithCIS ".to" OR cs-host endswithCIS ".tt" OR cs-host endswithCIS ".name" OR cs-host endswithCIS ".tv" OR cs-host endswithCIS ".kz" OR cs-host endswithCIS ".tc" OR cs-host endswithCIS ".mobi" OR cs-host endswithCIS ".study" OR cs-host endswithCIS ".click" OR cs-host endswithCIS ".link" OR cs-host endswithCIS ".trade" OR cs-host endswithCIS ".accountant" OR cs-host endswithCIS ".cf" OR cs-host endswithCIS ".gq" OR cs-host endswithCIS ".ml" OR cs-host endswithCIS ".ga" OR cs-host endswithCIS ".pw"))
