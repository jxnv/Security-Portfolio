// Title: User Discovery And Export Via Get-ADUser Cmdlet
// ID: 1114e048-b69c-4f41-bc20-657245ae6e3f
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.discovery, attack.t1033
// Description: Detects usage of the Get-ADUser cmdlet to collect user information and output it to a file
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "Get-ADUser " AND src.process.cmdline containsCIS " -Filter \\*") AND (src.process.cmdline containsCIS " > " OR src.process.cmdline containsCIS " | Select " OR src.process.cmdline containsCIS "Out-File" OR src.process.cmdline containsCIS "Set-Content" OR src.process.cmdline containsCIS "Add-Content")) AND (((src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe")) OR ((OriginalFileName = "PowerShell.EXE" OR OriginalFileName = "pwsh.dll"))))
