// Title: File and Directory Discovery - Linux
// ID: d3feb4ee-ff1d-4d3d-bd10-5b28a238cc72
// Status: test
// Level: informational
// Author: Daniil Yugoslavskiy, oscd.community, CheraghiMilad
// Date: 2020-10-19
// Tags: attack.discovery, attack.t1083
// Description: Detects usage of system utilities such as "find", "tree", "findmnt", etc, to discover files, directories and network shares.
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path endswithCIS "/file" AND src.process.cmdline RegEx "(.){200,}") OR (src.process.image.path endswithCIS "/find") OR (src.process.image.path endswithCIS "/findmnt") OR (src.process.image.path endswithCIS "/mlocate") OR (src.process.image.path endswithCIS "/ls" AND src.process.cmdline containsCIS "-R") OR (src.process.image.path endswithCIS "/tree"))
