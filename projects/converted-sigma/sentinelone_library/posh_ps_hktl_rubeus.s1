// Title: HackTool - Rubeus Execution - ScriptBlock
// ID: 3245cd30-e015-40ff-a31d-5cadd5f377ec
// Status: test
// Level: high
// Author: Christian Burkard (Nextron Systems), Florian Roth (Nextron Systems)
// Date: 2023-04-27
// Tags: attack.credential-access, attack.t1003, attack.t1558.003, attack.lateral-movement, attack.t1550.003
// Description: Detects the execution of the hacktool Rubeus using specific command line flags
// Converted by: Sigma Universal SIEM/EDR CLI

((ScriptBlockText containsCIS "asreproast " OR ScriptBlockText containsCIS "dump /service:krbtgt " OR ScriptBlockText containsCIS "dump /luid:0x" OR ScriptBlockText containsCIS "kerberoast " OR ScriptBlockText containsCIS "createnetonly /program:" OR ScriptBlockText containsCIS "ptt /ticket:" OR ScriptBlockText containsCIS "/impersonateuser:" OR ScriptBlockText containsCIS "renew /ticket:" OR ScriptBlockText containsCIS "asktgt /user:" OR ScriptBlockText containsCIS "harvest /interval:" OR ScriptBlockText containsCIS "s4u /user:" OR ScriptBlockText containsCIS "s4u /ticket:" OR ScriptBlockText containsCIS "hash /password:" OR ScriptBlockText containsCIS "golden /aes256:" OR ScriptBlockText containsCIS "silver /user:"))
