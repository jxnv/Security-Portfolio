// Title: Sticky Key Like Backdoor Execution
// ID: 2fdefcb3-dbda-401e-ae23-f0db027628bc
// Status: test
// Level: critical
// Author: Florian Roth (Nextron Systems), @twjackomo, Jonhnathan Ribeiro, oscd.community
// Date: 2018-03-15
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.008, car.2014-11-003, car.2014-11-008
// Description: Detects the usage and installation of a backdoor that uses an option to register a malicious debugger for built-in tools that are accessible in the login screen
// Converted by: Sigma Universal SIEM/EDR CLI

(src.process.parent.image.path endswithCIS "\\winlogon.exe" AND (src.process.image.path endswithCIS "\\cmd.exe" OR src.process.image.path endswithCIS "\\cscript.exe" OR src.process.image.path endswithCIS "\\mshta.exe" OR src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe" OR src.process.image.path endswithCIS "\\regsvr32.exe" OR src.process.image.path endswithCIS "\\rundll32.exe" OR src.process.image.path endswithCIS "\\wscript.exe" OR src.process.image.path endswithCIS "\\wt.exe") AND (src.process.cmdline containsCIS "sethc.exe" OR src.process.cmdline containsCIS "utilman.exe" OR src.process.cmdline containsCIS "osk.exe" OR src.process.cmdline containsCIS "Magnify.exe" OR src.process.cmdline containsCIS "Narrator.exe" OR src.process.cmdline containsCIS "DisplaySwitch.exe"))
