// Title: Schtasks From Suspicious Folders
// ID: 8a8379b8-780b-4dbf-b1e9-31c8d112fefb
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-04-15
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects scheduled task creations that have suspicious action command and folder combinations
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "C:\\ProgramData\\" OR src.process.cmdline containsCIS "%ProgramData%")) AND ((src.process.cmdline containsCIS "powershell" OR src.process.cmdline containsCIS "pwsh" OR src.process.cmdline containsCIS "cmd /c " OR src.process.cmdline containsCIS "cmd /k " OR src.process.cmdline containsCIS "cmd /r " OR src.process.cmdline containsCIS "cmd.exe /c " OR src.process.cmdline containsCIS "cmd.exe /k " OR src.process.cmdline containsCIS "cmd.exe /r ")) AND (src.process.cmdline containsCIS " /create ") AND ((src.process.image.path endswithCIS "\\schtasks.exe") OR (OriginalFileName = "schtasks.exe")))
