// Title: Suspicious Service Path Modification
// ID: 138d3531-8793-4f50-a2cd-f291b2863d78
// Status: test
// Level: high
// Author: Victor Sergeev, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-10-21
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects service path modification via the "sc" binary to a suspicious command or path
// Converted by: Sigma Universal SIEM/EDR CLI

(src.process.image.path endswithCIS "\\sc.exe" AND (src.process.cmdline containsCIS "config" AND src.process.cmdline containsCIS "binPath") AND (src.process.cmdline containsCIS "powershell" OR src.process.cmdline containsCIS "cmd " OR src.process.cmdline containsCIS "mshta" OR src.process.cmdline containsCIS "wscript" OR src.process.cmdline containsCIS "cscript" OR src.process.cmdline containsCIS "rundll32" OR src.process.cmdline containsCIS "svchost" OR src.process.cmdline containsCIS "dllhost" OR src.process.cmdline containsCIS "cmd.exe /c" OR src.process.cmdline containsCIS "cmd.exe /k" OR src.process.cmdline containsCIS "cmd.exe /r" OR src.process.cmdline containsCIS "cmd /c" OR src.process.cmdline containsCIS "cmd /k" OR src.process.cmdline containsCIS "cmd /r" OR src.process.cmdline containsCIS "C:\\Users\\Public" OR src.process.cmdline containsCIS "\\Downloads\\" OR src.process.cmdline containsCIS "\\Desktop\\" OR src.process.cmdline containsCIS "\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\" OR src.process.cmdline containsCIS "C:\\Windows\\TEMP\\" OR src.process.cmdline containsCIS "\\AppData\\Local\\Temp"))
