// Title: GAC DLL Loaded Via Office Applications
// ID: 90217a70-13fc-48e4-b3db-0d836c5824ac
// Status: test
// Level: high
// Author: Antonlovesdnb
// Date: 2020-02-19
// Tags: attack.execution, attack.t1204.002
// Description: Detects any GAC DLL being loaded by an Office Product
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path endswithCIS "\\excel.exe" OR src.process.image.path endswithCIS "\\mspub.exe" OR src.process.image.path endswithCIS "\\onenote.exe" OR src.process.image.path endswithCIS "\\onenoteim.exe" OR src.process.image.path endswithCIS "\\outlook.exe" OR src.process.image.path endswithCIS "\\powerpnt.exe" OR src.process.image.path endswithCIS "\\winword.exe") AND ImageLoaded startswithCIS "C:\\Windows\\Microsoft.NET\\assembly\\GAC_MSIL")
