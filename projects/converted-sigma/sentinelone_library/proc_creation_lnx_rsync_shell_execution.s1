// Title: Shell Execution via Rsync - Linux
// ID: e2326866-609f-4015-aea9-7ec634e8aa04
// Status: experimental
// Level: high
// Author: Li Ling, Andy Parkidomo, Robert Rakowski, Blake Hartstein (Bloomberg L.P.), Florian Roth
// Date: 2024-09-02
// Tags: attack.execution, attack.t1059
// Description: Detects the use of the "rsync" utility to execute a shell. Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "/ash " OR src.process.cmdline containsCIS "/bash " OR src.process.cmdline containsCIS "/dash " OR src.process.cmdline containsCIS "/csh " OR src.process.cmdline containsCIS "/sh " OR src.process.cmdline containsCIS "/zsh " OR src.process.cmdline containsCIS "/tcsh " OR src.process.cmdline containsCIS "/ksh " OR src.process.cmdline containsCIS "'ash " OR src.process.cmdline containsCIS "'bash " OR src.process.cmdline containsCIS "'dash " OR src.process.cmdline containsCIS "'csh " OR src.process.cmdline containsCIS "'sh " OR src.process.cmdline containsCIS "'zsh " OR src.process.cmdline containsCIS "'tcsh " OR src.process.cmdline containsCIS "'ksh ")) AND ((src.process.image.path endswithCIS "/rsync" OR src.process.image.path endswithCIS "/rsyncd") AND src.process.cmdline containsCIS " -e "))
