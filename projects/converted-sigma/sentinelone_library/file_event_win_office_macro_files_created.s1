// Title: Office Macro File Creation
// ID: 91174a41-dc8f-401b-be89-7bfc140612a0
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-23
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects the creation of a new office macro files on the systems
// Converted by: Sigma Universal SIEM/EDR CLI

(((tgt.file.path endswithCIS ".docm" OR tgt.file.path endswithCIS ".dotm" OR tgt.file.path endswithCIS ".xlsm" OR tgt.file.path endswithCIS ".xltm" OR tgt.file.path endswithCIS ".potm" OR tgt.file.path endswithCIS ".pptm")) AND NOT (((src.process.image.path startswithCIS "C:\\Program Files\\Microsoft Office\\" OR src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft Office\\") AND (src.process.image.path endswithCIS "\\WINWORD.EXE" OR src.process.image.path endswithCIS "\\EXCEL.EXE" OR src.process.image.path endswithCIS "\\POWERPNT.EXE") AND tgt.file.path containsCIS "\\~$")))
