// Title: Potentially Suspicious Powershell Script Execution From Temp Folder
// ID: a6a39bdb-935c-4f0a-ab77-35f4bbf44d33
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), Max Altgelt (Nextron Systems), Tim Shelton
// Date: 2021-07-14
// Tags: attack.execution, attack.t1059.001
// Description: Detects a potentially suspicious powershell script executions from temporary folder
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe") AND (src.process.cmdline containsCIS "\\Windows\\Temp" OR src.process.cmdline containsCIS "\\Temporary Internet" OR src.process.cmdline containsCIS "\\AppData\\Local\\Temp" OR src.process.cmdline containsCIS "\\AppData\\Roaming\\Temp" OR src.process.cmdline containsCIS "%TEMP%" OR src.process.cmdline containsCIS "%TMP%" OR src.process.cmdline containsCIS "%LocalAppData%\\Temp")) AND NOT (((src.process.cmdline containsCIS "\\Windows\\system32\\config\\systemprofile\\AppData\\Local\\Temp\\Amazon\\EC2-Windows\\") OR ((src.process.parent.image.path = "C:\\Windows\\System32\\Msiexec.exe" OR src.process.parent.image.path = "C:\\Windows\\SysWOW64\\Msiexec.exe") AND src.process.image.path endswithCIS "\\powershell.exe" AND (src.process.cmdline containsCIS "-NoProfile -ExecutionPolicy Bypass -Command" AND src.process.cmdline containsCIS "AppData\\Local\\Temp\\" AND src.process.cmdline containsCIS "Install-Chocolatey.ps1")) OR ((src.process.cmdline containsCIS " >" OR src.process.cmdline containsCIS "Out-File" OR src.process.cmdline containsCIS "ConvertTo-Json")) OR (src.process.cmdline containsCIS "-WindowStyle hidden -Verb runAs"))))
