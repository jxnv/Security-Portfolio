((src.process.parent.image.path endswithCIS "\\onenote.exe") AND ((src.process.image.path endswithCIS "\\explorer.exe" AND (src.process.cmdline containsCIS ".hta" OR src.process.cmdline containsCIS ".vb" OR src.process.cmdline containsCIS ".wsh" OR src.process.cmdline containsCIS ".js" OR src.process.cmdline containsCIS ".ps" OR src.process.cmdline containsCIS ".scr" OR src.process.cmdline containsCIS ".pif" OR src.process.cmdline containsCIS ".bat" OR src.process.cmdline containsCIS ".cmd")) OR (((OriginalFileName = "bitsadmin.exe" OR OriginalFileName = "CertOC.exe" OR OriginalFileName = "CertUtil.exe" OR OriginalFileName = "Cmd.Exe" OR OriginalFileName = "CMSTP.EXE" OR OriginalFileName = "cscript.exe" OR OriginalFileName = "curl.exe" OR OriginalFileName = "HH.exe" OR OriginalFileName = "IEExec.exe" OR OriginalFileName = "InstallUtil.exe" OR OriginalFileName = "javaw.exe" OR OriginalFileName = "Microsoft.Workflow.Compiler.exe" OR OriginalFileName = "msdt.exe" OR OriginalFileName = "MSHTA.EXE" OR OriginalFileName = "msiexec.exe" OR OriginalFileName = "Msxsl.exe" OR OriginalFileName = "odbcconf.exe" OR OriginalFileName = "pcalua.exe" OR OriginalFileName = "PowerShell.EXE" OR OriginalFileName = "RegAsm.exe" OR OriginalFileName = "RegSvcs.exe" OR OriginalFileName = "REGSVR32.exe" OR OriginalFileName = "RUNDLL32.exe" OR OriginalFileName = "schtasks.exe" OR OriginalFileName = "ScriptRunner.exe" OR OriginalFileName = "wmic.exe" OR OriginalFileName = "WorkFolders.exe" OR OriginalFileName = "wscript.exe")) OR ((src.process.image.path endswithCIS "\\AppVLP.exe" OR src.process.image.path endswithCIS "\\bash.exe" OR src.process.image.path endswithCIS "\\bitsadmin.exe" OR src.process.image.path endswithCIS "\\certoc.exe" OR src.process.image.path endswithCIS "\\certutil.exe" OR src.process.image.path endswithCIS "\\cmd.exe" OR src.process.image.path endswithCIS "\\cmstp.exe" OR src.process.image.path endswithCIS "\\control.exe" OR src.process.image.path endswithCIS "\\cscript.exe" OR src.process.image.path endswithCIS "\\curl.exe" OR src.process.image.path endswithCIS "\\forfiles.exe" OR src.process.image.path endswithCIS "\\hh.exe" OR src.process.image.path endswithCIS "\\ieexec.exe" OR src.process.image.path endswithCIS "\\installutil.exe" OR src.process.image.path endswithCIS "\\javaw.exe" OR src.process.image.path endswithCIS "\\mftrace.exe" OR src.process.image.path endswithCIS "\\Microsoft.Workflow.Compiler.exe" OR src.process.image.path endswithCIS "\\msbuild.exe" OR src.process.image.path endswithCIS "\\msdt.exe" OR src.process.image.path endswithCIS "\\mshta.exe" OR src.process.image.path endswithCIS "\\msidb.exe" OR src.process.image.path endswithCIS "\\msiexec.exe" OR src.process.image.path endswithCIS "\\msxsl.exe" OR src.process.image.path endswithCIS "\\odbcconf.exe" OR src.process.image.path endswithCIS "\\pcalua.exe" OR src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe" OR src.process.image.path endswithCIS "\\regasm.exe" OR src.process.image.path endswithCIS "\\regsvcs.exe" OR src.process.image.path endswithCIS "\\regsvr32.exe" OR src.process.image.path endswithCIS "\\rundll32.exe" OR src.process.image.path endswithCIS "\\schtasks.exe" OR src.process.image.path endswithCIS "\\scrcons.exe" OR src.process.image.path endswithCIS "\\scriptrunner.exe" OR src.process.image.path endswithCIS "\\sh.exe" OR src.process.image.path endswithCIS "\\svchost.exe" OR src.process.image.path endswithCIS "\\verclsid.exe" OR src.process.image.path endswithCIS "\\wmic.exe" OR src.process.image.path endswithCIS "\\workfolders.exe" OR src.process.image.path endswithCIS "\\wscript.exe"))) OR ((src.process.image.path containsCIS "\\AppData\\" OR src.process.image.path containsCIS "\\Users\\Public\\" OR src.process.image.path containsCIS "\\ProgramData\\" OR src.process.image.path containsCIS "\\Windows\\Tasks\\" OR src.process.image.path containsCIS "\\Windows\\Temp\\" OR src.process.image.path containsCIS "\\Windows\\System32\\Tasks\\"))) AND NOT (((src.process.image.path containsCIS "\\AppData\\Local\\Microsoft\\OneDrive\\" AND src.process.image.path endswithCIS "\\FileCoAuth.exe" AND src.process.cmdline endswithCIS "-Embedding") OR (src.process.image.path endswithCIS "\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe" AND src.process.cmdline endswithCIS "-Embedding"))))
