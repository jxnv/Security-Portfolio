// Title: PUA - AdFind Suspicious Execution
// ID: 9a132afa-654e-11eb-ae93-0242ac130002
// Status: test
// Level: high
// Author: Janantha Marasinghe (https://github.com/blueteam0ps), FPT.EagleEye Team, omkar72, oscd.community
// Date: 2021-02-02
// Tags: attack.discovery, attack.t1018, attack.t1087.002, attack.t1482, attack.t1069.002, stp.1u
// Description: Detects AdFind execution with common flags seen used during attacks
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.cmdline containsCIS "domainlist" OR src.process.cmdline containsCIS "trustdmp" OR src.process.cmdline containsCIS "dcmodes" OR src.process.cmdline containsCIS "adinfo" OR src.process.cmdline containsCIS "-sc dclist" OR src.process.cmdline containsCIS "computer_pwdnotreqd" OR src.process.cmdline containsCIS "objectcategory=" OR src.process.cmdline containsCIS "-subnets -f" OR src.process.cmdline containsCIS "name=\"Domain Admins\"" OR src.process.cmdline containsCIS "-sc u:" OR src.process.cmdline containsCIS "domainncs" OR src.process.cmdline containsCIS "dompol" OR src.process.cmdline containsCIS " oudmp " OR src.process.cmdline containsCIS "subnetdmp" OR src.process.cmdline containsCIS "gpodmp" OR src.process.cmdline containsCIS "fspdmp" OR src.process.cmdline containsCIS "users_noexpire" OR src.process.cmdline containsCIS "computers_active" OR src.process.cmdline containsCIS "computers_pwdnotreqd"))
