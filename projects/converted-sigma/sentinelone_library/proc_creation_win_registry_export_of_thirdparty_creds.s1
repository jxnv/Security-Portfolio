// Title: Registry Export of Third-Party Credentials
// ID: cc1abf27-78a3-4ac5-a51c-f3070b1d8e40
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-05-22
// Tags: attack.credential-access, attack.t1552.002
// Description: Detects the use of reg.exe to export registry paths associated with third-party credentials.
// Credential stealers have been known to use this technique to extract sensitive information from the registry.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "\\Software\\Aerofox\\Foxmail\\V3.1" OR src.process.cmdline containsCIS "\\Software\\Aerofox\\FoxmailPreview" OR src.process.cmdline containsCIS "\\Software\\DownloadManager\\Passwords" OR src.process.cmdline containsCIS "\\Software\\FTPWare\\COREFTP\\Sites" OR src.process.cmdline containsCIS "\\Software\\IncrediMail\\Identities" OR src.process.cmdline containsCIS "\\Software\\Martin Prikryl\\WinSCP 2\\Sessions" OR src.process.cmdline containsCIS "\\Software\\Mobatek\\MobaXterm" OR src.process.cmdline containsCIS "\\Software\\OpenSSH\\Agent\\Keys" OR src.process.cmdline containsCIS "\\Software\\OpenVPN-GUI\\configs" OR src.process.cmdline containsCIS "\\Software\\ORL\\WinVNC3\\Password" OR src.process.cmdline containsCIS "\\Software\\Qualcomm\\Eudora\\CommandLine" OR src.process.cmdline containsCIS "\\Software\\RealVNC\\WinVNC4" OR src.process.cmdline containsCIS "\\Software\\RimArts\\B2\\Settings" OR src.process.cmdline containsCIS "\\Software\\SimonTatham\\PuTTY\\Sessions" OR src.process.cmdline containsCIS "\\Software\\SimonTatham\\PuTTY\\SshHostKeys" OR src.process.cmdline containsCIS "\\Software\\Sota\\FFFTP" OR src.process.cmdline containsCIS "\\Software\\TightVNC\\Server" OR src.process.cmdline containsCIS "\\Software\\WOW6432Node\\Radmin\\v3.0\\Server\\Parameters\\Radmin")) AND ((src.process.cmdline containsCIS "save" OR src.process.cmdline containsCIS "export")) AND ((src.process.image.path endswithCIS "\\reg.exe") OR (OriginalFileName = "reg.exe")))
