// Title: Potentially Suspicious WDAC Policy File Creation
// ID: 1d2de8a6-4803-4fde-b85b-f58f3aa7a705
// Status: experimental
// Level: medium
// Author: X__Junior
// Date: 2025-02-07
// Tags: attack.defense-impairment
// Description: Detects suspicious Windows Defender Application Control (WDAC) policy file creation from abnormal processes that could be abused by attacker to block EDR/AV components while allowing their own malicious code to run on the system.
// Converted by: Sigma Universal SIEM/EDR CLI

((tgt.file.path containsCIS "\\Windows\\System32\\CodeIntegrity\\") AND NOT (((((src.process.cmdline containsCIS "ConvertFrom-CIPolicy -XmlFilePath" AND src.process.cmdline containsCIS "-BinaryFilePath ")) OR (src.process.cmdline containsCIS "CiTool --update-policy") OR ((src.process.cmdline containsCIS "Copy-Item -Path" AND src.process.cmdline containsCIS "-Destination"))) OR ((src.process.image.path endswithCIS "\\Microsoft.ConfigurationManagement.exe" OR src.process.image.path endswithCIS "\\WDAC Wizard.exe" OR src.process.image.path endswithCIS "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" OR src.process.image.path endswithCIS "C:\\Program Files\\PowerShell\\7\\pwsh.exe" OR src.process.image.path endswithCIS "C:\\Windows\\System32\\dllhost.exe" OR src.process.image.path endswithCIS "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" OR src.process.image.path endswithCIS "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" OR src.process.image.path endswithCIS "C:\\Windows\\SysWOW64\\dllhost.exe" OR src.process.image.path endswithCIS "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" OR src.process.image.path endswithCIS "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")) OR (src.process.image.path = "System") OR (src.process.image.path = "C:\\Windows\\System32\\wuauclt.exe") OR ((src.process.image.path = "C:\\Windows\\UUS\\arm64\\wuaucltcore.exe" OR src.process.image.path = "C:\\Windows\\UUS\\Packages\\Preview\\arm64\\wuaucltcore.exe")))))
