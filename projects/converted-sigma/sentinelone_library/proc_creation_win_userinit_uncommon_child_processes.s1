// Title: Uncommon Userinit Child Process
// ID: 0a98a10c-685d-4ab0-bddc-b6bdd1d48458
// Status: test
// Level: high
// Author: Tom Ueltschi (@c_APT_ure), Tim Shelton
// Date: 2019-01-12
// Tags: attack.privilege-escalation, attack.t1037.001, attack.persistence
// Description: Detects uncommon "userinit.exe" child processes, which could be a sign of uncommon shells or login scripts used for persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.parent.image.path endswithCIS "\\userinit.exe") AND NOT ((src.process.image.path endswithCIS ":\\WINDOWS\\explorer.exe")) AND NOT ((((src.process.image.path endswithCIS ":\\Program Files (x86)\\Citrix\\HDX\\bin\\cmstart.exe" OR src.process.image.path endswithCIS ":\\Program Files (x86)\\Citrix\\HDX\\bin\\icast.exe" OR src.process.image.path endswithCIS ":\\Program Files (x86)\\Citrix\\System32\\icast.exe" OR src.process.image.path endswithCIS ":\\Program Files\\Citrix\\HDX\\bin\\cmstart.exe" OR src.process.image.path endswithCIS ":\\Program Files\\Citrix\\HDX\\bin\\icast.exe" OR src.process.image.path endswithCIS ":\\Program Files\\Citrix\\System32\\icast.exe")) OR (src.process.image.path is null) OR ((src.process.cmdline containsCIS "netlogon.bat" OR src.process.cmdline containsCIS "UsrLogon.cmd")) OR ((src.process.image.path endswithCIS ":\\Windows\\System32\\proquota.exe" OR src.process.image.path endswithCIS ":\\Windows\\SysWOW64\\proquota.exe")) OR (src.process.cmdline = "PowerShell.exe"))))
