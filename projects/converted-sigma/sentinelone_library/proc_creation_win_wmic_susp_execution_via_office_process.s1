(((src.process.parent.image.path endswithCIS "\\WINWORD.EXE" OR src.process.parent.image.path endswithCIS "\\EXCEL.EXE" OR src.process.parent.image.path endswithCIS "\\POWERPNT.exe" OR src.process.parent.image.path endswithCIS "\\MSPUB.exe" OR src.process.parent.image.path endswithCIS "\\VISIO.exe" OR src.process.parent.image.path endswithCIS "\\MSACCESS.EXE" OR src.process.parent.image.path endswithCIS "\\EQNEDT32.EXE" OR src.process.parent.image.path endswithCIS "\\ONENOTE.EXE" OR src.process.parent.image.path endswithCIS "\\wordpad.exe" OR src.process.parent.image.path endswithCIS "\\wordview.exe")) AND ((src.process.cmdline containsCIS "process" AND src.process.cmdline containsCIS "create" AND src.process.cmdline containsCIS "call") AND (src.process.cmdline containsCIS "regsvr32" OR src.process.cmdline containsCIS "rundll32" OR src.process.cmdline containsCIS "msiexec" OR src.process.cmdline containsCIS "mshta" OR src.process.cmdline containsCIS "verclsid" OR src.process.cmdline containsCIS "wscript" OR src.process.cmdline containsCIS "cscript")) AND ((src.process.image.path endswithCIS "\\wbem\\WMIC.exe") OR (OriginalFileName = "wmic.exe")))
