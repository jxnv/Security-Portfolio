// Title: Tamper Windows Defender - ScriptBlockLogging
// ID: 14c71865-6cd3-44ae-adaa-1db923fae5f2
// Status: test
// Level: high
// Author: frack113, elhoim, Tim Shelton (fps, alias support), Swachchhanda Shrawan Poudel, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-16
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects PowerShell scripts attempting to disable scheduled scanning and other parts of Windows Defender ATP or set default actions to allow.
// Converted by: Sigma Universal SIEM/EDR CLI

((((ScriptBlockText containsCIS "-dbaf $true" OR ScriptBlockText containsCIS "-dbaf 1" OR ScriptBlockText containsCIS "-dbm $true" OR ScriptBlockText containsCIS "-dbm 1" OR ScriptBlockText containsCIS "-dips $true" OR ScriptBlockText containsCIS "-dips 1" OR ScriptBlockText containsCIS "-DisableArchiveScanning $true" OR ScriptBlockText containsCIS "-DisableArchiveScanning 1" OR ScriptBlockText containsCIS "-DisableBehaviorMonitoring $true" OR ScriptBlockText containsCIS "-DisableBehaviorMonitoring 1" OR ScriptBlockText containsCIS "-DisableBlockAtFirstSeen $true" OR ScriptBlockText containsCIS "-DisableBlockAtFirstSeen 1" OR ScriptBlockText containsCIS "-DisableCatchupFullScan $true" OR ScriptBlockText containsCIS "-DisableCatchupFullScan 1" OR ScriptBlockText containsCIS "-DisableCatchupQuickScan $true" OR ScriptBlockText containsCIS "-DisableCatchupQuickScan 1" OR ScriptBlockText containsCIS "-DisableIntrusionPreventionSystem $true" OR ScriptBlockText containsCIS "-DisableIntrusionPreventionSystem 1" OR ScriptBlockText containsCIS "-DisableIOAVProtection $true" OR ScriptBlockText containsCIS "-DisableIOAVProtection 1" OR ScriptBlockText containsCIS "-DisableRealtimeMonitoring $true" OR ScriptBlockText containsCIS "-DisableRealtimeMonitoring 1" OR ScriptBlockText containsCIS "-DisableRemovableDriveScanning $true" OR ScriptBlockText containsCIS "-DisableRemovableDriveScanning 1" OR ScriptBlockText containsCIS "-DisableScanningMappedNetworkDrivesForFullScan $true" OR ScriptBlockText containsCIS "-DisableScanningMappedNetworkDrivesForFullScan 1" OR ScriptBlockText containsCIS "-DisableScanningNetworkFiles $true" OR ScriptBlockText containsCIS "-DisableScanningNetworkFiles 1" OR ScriptBlockText containsCIS "-DisableScriptScanning $true" OR ScriptBlockText containsCIS "-DisableScriptScanning 1" OR ScriptBlockText containsCIS "-MAPSReporting $false" OR ScriptBlockText containsCIS "-MAPSReporting 0" OR ScriptBlockText containsCIS "-drdsc $true" OR ScriptBlockText containsCIS "-drdsc 1" OR ScriptBlockText containsCIS "-drtm $true" OR ScriptBlockText containsCIS "-drtm 1" OR ScriptBlockText containsCIS "-dscrptsc $true" OR ScriptBlockText containsCIS "-dscrptsc 1" OR ScriptBlockText containsCIS "-dsmndf $true" OR ScriptBlockText containsCIS "-dsmndf 1" OR ScriptBlockText containsCIS "-dsnf $true" OR ScriptBlockText containsCIS "-dsnf 1" OR ScriptBlockText containsCIS "-dss $true" OR ScriptBlockText containsCIS "-dss 1")) AND (ScriptBlockText containsCIS "Set-MpPreference")) OR ((ScriptBlockText containsCIS "Set-MpPreference") AND ((ScriptBlockText containsCIS "HighThreatDefaultAction Allow" OR ScriptBlockText containsCIS "htdefac Allow" OR ScriptBlockText containsCIS "LowThreatDefaultAction Allow" OR ScriptBlockText containsCIS "ltdefac Allow" OR ScriptBlockText containsCIS "ModerateThreatDefaultAction Allow" OR ScriptBlockText containsCIS "mtdefac Allow" OR ScriptBlockText containsCIS "SevereThreatDefaultAction Allow" OR ScriptBlockText containsCIS "stdefac Allow"))))
