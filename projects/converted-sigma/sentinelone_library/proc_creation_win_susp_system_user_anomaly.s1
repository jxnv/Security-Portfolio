// Title: Suspicious SYSTEM User Process Creation
// ID: 2617e7ed-adb7-40ba-b0f3-8f9945fe6c09
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), David ANDRE (additional keywords)
// Date: 2021-12-20
// Tags: attack.credential-access, attack.privilege-escalation, attack.stealth, attack.t1134, attack.t1003, attack.t1027
// Description: Detects a suspicious process creation as SYSTEM user (suspicious program or command line parameter)
// Converted by: Sigma Universal SIEM/EDR CLI

((((IntegrityLevel = "System" OR IntegrityLevel = "S-1-16-16384") AND (src.process.user containsCIS "AUTHORI" OR src.process.user containsCIS "AUTORI")) AND (((src.process.image.path endswithCIS "\\calc.exe" OR src.process.image.path endswithCIS "\\cscript.exe" OR src.process.image.path endswithCIS "\\forfiles.exe" OR src.process.image.path endswithCIS "\\hh.exe" OR src.process.image.path endswithCIS "\\mshta.exe" OR src.process.image.path endswithCIS "\\ping.exe" OR src.process.image.path endswithCIS "\\wscript.exe")) OR (src.process.cmdline RegEx "net\s+user\s+") OR ((src.process.cmdline containsCIS " -NoP " OR src.process.cmdline containsCIS " -W Hidden " OR src.process.cmdline containsCIS " -decode " OR src.process.cmdline containsCIS " /decode " OR src.process.cmdline containsCIS " /urlcache " OR src.process.cmdline containsCIS " -urlcache " OR src.process.cmdline containsCIS " -e* JAB" OR src.process.cmdline containsCIS " -e* SUVYI" OR src.process.cmdline containsCIS " -e* SQBFAFgA" OR src.process.cmdline containsCIS " -e* aWV4I" OR src.process.cmdline containsCIS " -e* IAB" OR src.process.cmdline containsCIS " -e* PAA" OR src.process.cmdline containsCIS " -e* aQBlAHgA" OR src.process.cmdline containsCIS "vssadmin delete shadows" OR src.process.cmdline containsCIS "reg SAVE HKLM" OR src.process.cmdline containsCIS " -ma " OR src.process.cmdline containsCIS "Microsoft\\Windows\\CurrentVersion\\Run" OR src.process.cmdline containsCIS ".downloadstring(" OR src.process.cmdline containsCIS ".downloadfile(" OR src.process.cmdline containsCIS " /ticket:" OR src.process.cmdline containsCIS "dpapi::" OR src.process.cmdline containsCIS "event::clear" OR src.process.cmdline containsCIS "event::drop" OR src.process.cmdline containsCIS "id::modify" OR src.process.cmdline containsCIS "kerberos::" OR src.process.cmdline containsCIS "lsadump::" OR src.process.cmdline containsCIS "misc::" OR src.process.cmdline containsCIS "privilege::" OR src.process.cmdline containsCIS "rpc::" OR src.process.cmdline containsCIS "sekurlsa::" OR src.process.cmdline containsCIS "sid::" OR src.process.cmdline containsCIS "token::" OR src.process.cmdline containsCIS "vault::cred" OR src.process.cmdline containsCIS "vault::list" OR src.process.cmdline containsCIS " p::d " OR src.process.cmdline containsCIS ";iex(" OR src.process.cmdline containsCIS "MiniDump")))) AND NOT (((src.process.parent.image.path containsCIS ":\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\") OR ((src.process.parent.image.path containsCIS ":\\Program Files (x86)\\Java\\" OR src.process.parent.image.path containsCIS ":\\Program Files\\Java\\") AND src.process.parent.image.path endswithCIS "\\bin\\javaws.exe" AND (src.process.image.path containsCIS ":\\Program Files (x86)\\Java\\" OR src.process.image.path containsCIS ":\\Program Files\\Java\\") AND src.process.image.path endswithCIS "\\bin\\jp2launcher.exe" AND src.process.cmdline containsCIS " -ma ") OR ((src.process.cmdline containsCIS "ping" AND src.process.cmdline containsCIS "127.0.0.1" AND src.process.cmdline containsCIS " -n ")) OR (src.process.image.path endswithCIS "\\PING.EXE" AND src.process.parent.cmdline containsCIS "\\DismFoDInstall.cmd"))))
