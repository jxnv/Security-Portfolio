// Title: Potential WinAPI Calls Via CommandLine
// ID: ba3f5c1b-6272-4119-9dbd-0bc8d21c2702
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-06
// Tags: attack.execution, attack.t1106
// Description: Detects the use of WinAPI Functions via the commandline. As seen used by threat actors via the tool winapiexec
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "AddSecurityPackage" OR src.process.cmdline containsCIS "AdjustTokenPrivileges" OR src.process.cmdline containsCIS "Advapi32" OR src.process.cmdline containsCIS "CloseHandle" OR src.process.cmdline containsCIS "CreateProcessWithToken" OR src.process.cmdline containsCIS "CreatePseudoConsole" OR src.process.cmdline containsCIS "CreateRemoteThread" OR src.process.cmdline containsCIS "CreateThread" OR src.process.cmdline containsCIS "CreateUserThread" OR src.process.cmdline containsCIS "DangerousGetHandle" OR src.process.cmdline containsCIS "DuplicateTokenEx" OR src.process.cmdline containsCIS "EnumerateSecurityPackages" OR src.process.cmdline containsCIS "FreeHGlobal" OR src.process.cmdline containsCIS "FreeLibrary" OR src.process.cmdline containsCIS "GetDelegateForFunctionPointer" OR src.process.cmdline containsCIS "GetLogonSessionData" OR src.process.cmdline containsCIS "GetModuleHandle" OR src.process.cmdline containsCIS "GetProcAddress" OR src.process.cmdline containsCIS "GetProcessHandle" OR src.process.cmdline containsCIS "GetTokenInformation" OR src.process.cmdline containsCIS "ImpersonateLoggedOnUser" OR src.process.cmdline containsCIS "kernel32" OR src.process.cmdline containsCIS "LoadLibrary" OR src.process.cmdline containsCIS "memcpy" OR src.process.cmdline containsCIS "MiniDumpWriteDump" OR src.process.cmdline containsCIS "ntdll" OR src.process.cmdline containsCIS "OpenDesktop" OR src.process.cmdline containsCIS "OpenProcess" OR src.process.cmdline containsCIS "OpenProcessToken" OR src.process.cmdline containsCIS "OpenThreadToken" OR src.process.cmdline containsCIS "OpenWindowStation" OR src.process.cmdline containsCIS "PtrToString" OR src.process.cmdline containsCIS "QueueUserApc" OR src.process.cmdline containsCIS "ReadProcessMemory" OR src.process.cmdline containsCIS "RevertToSelf" OR src.process.cmdline containsCIS "RtlCreateUserThread" OR src.process.cmdline containsCIS "secur32" OR src.process.cmdline containsCIS "SetThreadToken" OR src.process.cmdline containsCIS "VirtualAlloc" OR src.process.cmdline containsCIS "VirtualFree" OR src.process.cmdline containsCIS "VirtualProtect" OR src.process.cmdline containsCIS "WaitForSingleObject" OR src.process.cmdline containsCIS "WriteInt32" OR src.process.cmdline containsCIS "WriteProcessMemory" OR src.process.cmdline containsCIS "ZeroFreeGlobalAllocUnicode")) AND NOT (((src.process.parent.image.path endswithCIS "\\CompatTelRunner.exe" AND (src.process.cmdline containsCIS "FreeHGlobal" OR src.process.cmdline containsCIS "PtrToString" OR src.process.cmdline containsCIS "kernel32" OR src.process.cmdline containsCIS "CloseHandle")) OR (src.process.image.path endswithCIS "\\MpCmdRun.exe" AND src.process.cmdline containsCIS "GetLoadLibraryWAddress32"))))
