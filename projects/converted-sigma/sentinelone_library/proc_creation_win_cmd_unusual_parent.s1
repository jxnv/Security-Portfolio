// Tags: attack.execution, attack.t1059
// Description: Detects suspicious parent process for cmd.exe
// Converted by: Sigma Universal SIEM/EDR CLI

(src.process.image.path endswithCIS "\\cmd.exe" AND (src.process.parent.image.path endswithCIS "\\csrss.exe" OR src.process.parent.image.path endswithCIS "\\ctfmon.exe" OR src.process.parent.image.path endswithCIS "\\dllhost.exe" OR src.process.parent.image.path endswithCIS "\\epad.exe" OR src.process.parent.image.path endswithCIS "\\FlashPlayerUpdateService.exe" OR src.process.parent.image.path endswithCIS "\\GoogleUpdate.exe" OR src.process.parent.image.path endswithCIS "\\jucheck.exe" OR src.process.parent.image.path endswithCIS "\\jusched.exe" OR src.process.parent.image.path endswithCIS "\\LogonUI.exe" OR src.process.parent.image.path endswithCIS "\\lsass.exe" OR src.process.parent.image.path endswithCIS "\\regsvr32.exe" OR src.process.parent.image.path endswithCIS "\\SearchIndexer.exe" OR src.process.parent.image.path endswithCIS "\\SearchProtocolHost.exe" OR src.process.parent.image.path endswithCIS "\\SIHClient.exe" OR src.process.parent.image.path endswithCIS "\\sihost.exe" OR src.process.parent.image.path endswithCIS "\\slui.exe" OR src.process.parent.image.path endswithCIS "\\spoolsv.exe" OR src.process.parent.image.path endswithCIS "\\sppsvc.exe" OR src.process.parent.image.path endswithCIS "\\taskhostw.exe" OR src.process.parent.image.path endswithCIS "\\unsecapp.exe" OR src.process.parent.image.path endswithCIS "\\WerFault.exe" OR src.process.parent.image.path endswithCIS "\\wermgr.exe" OR src.process.parent.image.path endswithCIS "\\wlanext.exe" OR src.process.parent.image.path endswithCIS "\\WUDFHost.exe"))
