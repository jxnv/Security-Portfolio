// Description: Detects the pattern of UAC Bypass using Event Viewer RecentViews
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "\\Event Viewer\\RecentViews" OR src.process.cmdline containsCIS "\\EventV~1\\RecentViews")) AND (src.process.cmdline containsCIS ">"))
