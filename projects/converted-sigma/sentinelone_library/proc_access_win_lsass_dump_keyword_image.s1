// Title: LSASS Memory Access by Tool With Dump Keyword In Name
// ID: 9bd012ee-0dff-44d7-84a0-aa698cfd87a3
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-10
// Tags: attack.credential-access, attack.t1003.001, attack.s0002
// Description: Detects LSASS process access requests from a source process with the "dump" keyword in its image name.
// Converted by: Sigma Universal SIEM/EDR CLI

(TargetImage endswithCIS "\\lsass.exe" AND SourceImage containsCIS "dump" AND (GrantedAccess endswithCIS "10" OR GrantedAccess endswithCIS "30" OR GrantedAccess endswithCIS "50" OR GrantedAccess endswithCIS "70" OR GrantedAccess endswithCIS "90" OR GrantedAccess endswithCIS "B0" OR GrantedAccess endswithCIS "D0" OR GrantedAccess endswithCIS "F0" OR GrantedAccess endswithCIS "18" OR GrantedAccess endswithCIS "38" OR GrantedAccess endswithCIS "58" OR GrantedAccess endswithCIS "78" OR GrantedAccess endswithCIS "98" OR GrantedAccess endswithCIS "B8" OR GrantedAccess endswithCIS "D8" OR GrantedAccess endswithCIS "F8" OR GrantedAccess endswithCIS "1A" OR GrantedAccess endswithCIS "3A" OR GrantedAccess endswithCIS "5A" OR GrantedAccess endswithCIS "7A" OR GrantedAccess endswithCIS "9A" OR GrantedAccess endswithCIS "BA" OR GrantedAccess endswithCIS "DA" OR GrantedAccess endswithCIS "FA" OR GrantedAccess endswithCIS "0x14C2" OR GrantedAccess endswithCIS "FF"))
