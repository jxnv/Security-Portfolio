(((src.process.parent.image.path endswithCIS "\\minesweeper.exe" OR src.process.parent.image.path endswithCIS "\\winver.exe" OR src.process.parent.image.path endswithCIS "\\bitsadmin.exe")) OR (((src.process.parent.image.path endswithCIS "\\csrss.exe" OR src.process.parent.image.path endswithCIS "\\certutil.exe" OR src.process.parent.image.path endswithCIS "\\eventvwr.exe" OR src.process.parent.image.path endswithCIS "\\calc.exe" OR src.process.parent.image.path endswithCIS "\\notepad.exe")) AND NOT (((src.process.image.path is null) OR ((src.process.image.path endswithCIS "\\WerFault.exe" OR src.process.image.path endswithCIS "\\wermgr.exe" OR src.process.image.path endswithCIS "\\conhost.exe" OR src.process.image.path endswithCIS "\\mmc.exe" OR src.process.image.path endswithCIS "\\win32calc.exe" OR src.process.image.path endswithCIS "\\notepad.exe"))))))
