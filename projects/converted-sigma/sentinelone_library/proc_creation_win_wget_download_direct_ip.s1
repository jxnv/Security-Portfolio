// Title: Suspicious File Download From IP Via Wget.EXE
// ID: 17f0c0a8-8bd5-4ee0-8c5f-a342c0199f35
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-07-27
// Tags: attack.execution
// Description: Detects potentially suspicious file downloads directly from IP addresses using Wget.exe
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline endswithCIS ".ps1" OR src.process.cmdline endswithCIS ".ps1'" OR src.process.cmdline endswithCIS ".ps1\"" OR src.process.cmdline endswithCIS ".dat" OR src.process.cmdline endswithCIS ".dat'" OR src.process.cmdline endswithCIS ".dat\"" OR src.process.cmdline endswithCIS ".msi" OR src.process.cmdline endswithCIS ".msi'" OR src.process.cmdline endswithCIS ".msi\"" OR src.process.cmdline endswithCIS ".bat" OR src.process.cmdline endswithCIS ".bat'" OR src.process.cmdline endswithCIS ".bat\"" OR src.process.cmdline endswithCIS ".exe" OR src.process.cmdline endswithCIS ".exe'" OR src.process.cmdline endswithCIS ".exe\"" OR src.process.cmdline endswithCIS ".vbs" OR src.process.cmdline endswithCIS ".vbs'" OR src.process.cmdline endswithCIS ".vbs\"" OR src.process.cmdline endswithCIS ".vbe" OR src.process.cmdline endswithCIS ".vbe'" OR src.process.cmdline endswithCIS ".vbe\"" OR src.process.cmdline endswithCIS ".hta" OR src.process.cmdline endswithCIS ".hta'" OR src.process.cmdline endswithCIS ".hta\"" OR src.process.cmdline endswithCIS ".dll" OR src.process.cmdline endswithCIS ".dll'" OR src.process.cmdline endswithCIS ".dll\"" OR src.process.cmdline endswithCIS ".psm1" OR src.process.cmdline endswithCIS ".psm1'" OR src.process.cmdline endswithCIS ".psm1\"")) AND ((src.process.cmdline RegEx "\s-O\s") OR (src.process.cmdline containsCIS "--output-document")) AND (src.process.cmdline containsCIS "http") AND ((src.process.image.path endswithCIS "\\wget.exe") OR (OriginalFileName = "wget.exe")) AND (src.process.cmdline RegEx "://[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}"))
