// Tags: attack.credential-access, attack.t1552.002
// Description: Detects processes that query known 3rd party registry keys that holds credentials via commandline
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "\\Software\\Aerofox\\Foxmail\\V3.1" OR src.process.cmdline containsCIS "\\Software\\Aerofox\\FoxmailPreview" OR src.process.cmdline containsCIS "\\Software\\DownloadManager\\Passwords" OR src.process.cmdline containsCIS "\\Software\\FTPWare\\COREFTP\\Sites" OR src.process.cmdline containsCIS "\\Software\\IncrediMail\\Identities" OR src.process.cmdline containsCIS "\\Software\\Martin Prikryl\\WinSCP 2\\Sessions" OR src.process.cmdline containsCIS "\\Software\\Mobatek\\MobaXterm\\" OR src.process.cmdline containsCIS "\\Software\\OpenSSH\\Agent\\Keys" OR src.process.cmdline containsCIS "\\Software\\OpenVPN-GUI\\configs" OR src.process.cmdline containsCIS "\\Software\\ORL\\WinVNC3\\Password" OR src.process.cmdline containsCIS "\\Software\\Qualcomm\\Eudora\\CommandLine" OR src.process.cmdline containsCIS "\\Software\\RealVNC\\WinVNC4" OR src.process.cmdline containsCIS "\\Software\\RimArts\\B2\\Settings" OR src.process.cmdline containsCIS "\\Software\\SimonTatham\\PuTTY\\Sessions" OR src.process.cmdline containsCIS "\\Software\\SimonTatham\\PuTTY\\SshHostKeys\\" OR src.process.cmdline containsCIS "\\Software\\Sota\\FFFTP" OR src.process.cmdline containsCIS "\\Software\\TightVNC\\Server" OR src.process.cmdline containsCIS "\\Software\\WOW6432Node\\Radmin\\v3.0\\Server\\Parameters\\Radmin")) AND NOT ((src.process.image.path endswithCIS "reg.exe" AND (src.process.cmdline containsCIS "export" OR src.process.cmdline containsCIS "save"))))
