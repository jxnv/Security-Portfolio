// Title: Regsvr32 DLL Execution With Uncommon Extension
// ID: 50919691-7302-437f-8e10-1fe088afa145
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2019-07-17
// Tags: attack.privilege-escalation, attack.persistence, attack.stealth, attack.t1574, attack.execution
// Description: Detects a "regsvr32" execution where the DLL doesn't contain a common file extension.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "\\regsvr32.exe") OR (OriginalFileName = "REGSVR32.EXE")) AND NOT (((src.process.cmdline = "") OR ((src.process.cmdline containsCIS ".ax" OR src.process.cmdline containsCIS ".cpl" OR src.process.cmdline containsCIS ".dll" OR src.process.cmdline containsCIS ".ocx")) OR (src.process.cmdline is null))) AND NOT (((src.process.cmdline containsCIS ".bav") OR (src.process.cmdline containsCIS ".ppl"))))
