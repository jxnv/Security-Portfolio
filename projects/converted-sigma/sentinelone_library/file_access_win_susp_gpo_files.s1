// Title: Access To Potentially Sensitive Sysvol Files By Uncommon Applications
// ID: d51694fe-484a-46ac-92d6-969e76d60d10
// Status: test
// Level: medium
// Author: frack113
// Date: 2023-12-21
// Tags: attack.credential-access, attack.t1552.006
// Description: Detects file access requests to potentially sensitive files hosted on the Windows Sysvol share.
// Converted by: Sigma Universal SIEM/EDR CLI

((FileName startswithCIS "\\\\" AND (FileName containsCIS "\\sysvol\\" AND FileName containsCIS "\\Policies\\") AND (FileName endswithCIS "audit.csv" OR FileName endswithCIS "Files.xml" OR FileName endswithCIS "GptTmpl.inf" OR FileName endswithCIS "groups.xml" OR FileName endswithCIS "Registry.pol" OR FileName endswithCIS "Registry.xml" OR FileName endswithCIS "scheduledtasks.xml" OR FileName endswithCIS "scripts.ini" OR FileName endswithCIS "services.xml")) AND NOT (((src.process.image.path = "C:\\Windows\\explorer.exe") OR ((src.process.image.path startswithCIS "C:\\Program Files (x86)\\" OR src.process.image.path startswithCIS "C:\\Program Files\\" OR src.process.image.path startswithCIS "C:\\Windows\\system32\\" OR src.process.image.path startswithCIS "C:\\Windows\\SysWOW64\\")))))
