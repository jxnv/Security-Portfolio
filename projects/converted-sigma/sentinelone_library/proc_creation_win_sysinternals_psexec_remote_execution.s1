// Title: Potential PsExec Remote Execution
// ID: ea011323-7045-460b-b2d7-0f7442ea6b38
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-28
// Tags: attack.resource-development, attack.t1587.001
// Description: Detects potential psexec command that initiate execution on a remote systems via common commandline flags used by the utility
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "accepteula" AND src.process.cmdline containsCIS " -u " AND src.process.cmdline containsCIS " -p " AND src.process.cmdline containsCIS " \\\\\\\\")) AND NOT (((src.process.cmdline containsCIS "\\\\\\\\localhost" OR src.process.cmdline containsCIS "\\\\\\\\127."))))
