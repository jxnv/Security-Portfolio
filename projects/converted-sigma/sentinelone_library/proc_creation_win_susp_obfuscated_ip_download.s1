// Title: Obfuscated IP Download Activity
// ID: cb5a2333-56cf-4562-8fcb-22ba1bca728d
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2022-08-03
// Tags: attack.discovery
// Description: Detects use of an encoded/obfuscated version of an IP address (hex, octal...) in an URL combined with a download command
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "Invoke-WebRequest" OR src.process.cmdline containsCIS "iwr " OR src.process.cmdline containsCIS "Invoke-RestMethod" OR src.process.cmdline containsCIS "irm " OR src.process.cmdline containsCIS "wget " OR src.process.cmdline containsCIS "curl " OR src.process.cmdline containsCIS "DownloadFile" OR src.process.cmdline containsCIS "DownloadString")) AND (((src.process.cmdline containsCIS " 0x" OR src.process.cmdline containsCIS "//0x" OR src.process.cmdline containsCIS ".0x" OR src.process.cmdline containsCIS ".00x")) OR ((src.process.cmdline containsCIS "http://%" AND src.process.cmdline containsCIS "%2e")) OR ((src.process.cmdline RegEx "https?://[0-9]{1,3}\.[0-9]{1,3}\.0[0-9]{3,4}") OR (src.process.cmdline RegEx "https?://[0-9]{1,3}\.0[0-9]{3,7}") OR (src.process.cmdline RegEx "https?://0[0-9]{3,11}") OR (src.process.cmdline RegEx "https?://(?:0[0-9]{1,11}\.){3}0[0-9]{1,11}") OR (src.process.cmdline RegEx "https?://0[0-9]{1,11}") OR (src.process.cmdline RegEx " [0-7]{7,13}"))) AND NOT ((src.process.cmdline RegEx "https?://(?:(?:25[0-5]|(?:2[0-4]|1\d|[1-9])?\d)(?:\.|\b)){4}")))
