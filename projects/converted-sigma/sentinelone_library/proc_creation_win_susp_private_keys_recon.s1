(((src.process.cmdline containsCIS ".key" OR src.process.cmdline containsCIS ".pgp" OR src.process.cmdline containsCIS ".gpg" OR src.process.cmdline containsCIS ".ppk" OR src.process.cmdline containsCIS ".p12" OR src.process.cmdline containsCIS ".pem" OR src.process.cmdline containsCIS ".pfx" OR src.process.cmdline containsCIS ".cer" OR src.process.cmdline containsCIS ".p7b" OR src.process.cmdline containsCIS ".asc")) AND (((src.process.cmdline containsCIS "dir ") AND ((src.process.image.path endswithCIS "\\cmd.exe") OR (OriginalFileName = "Cmd.Exe"))) OR ((src.process.cmdline containsCIS "Get-ChildItem ") AND (((src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe")) OR ((OriginalFileName = "PowerShell.EXE" OR OriginalFileName = "pwsh.dll")))) OR ((src.process.image.path endswithCIS "\\findstr.exe") OR (OriginalFileName = "FINDSTR.EXE"))))
