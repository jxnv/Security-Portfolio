// Title: Network Connection Initiated From Process Located In Potentially Suspicious Or Uncommon Location
// ID: 7b434893-c57d-4f41-908d-6a17bf1ae98f
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2017-03-19
// Tags: attack.command-and-control, attack.t1105
// Description: Detects a network connection initiated by programs or processes running from suspicious or uncommon files system locations.
// Converted by: Sigma Universal SIEM/EDR CLI

((Initiated = "true" AND (src.process.image.path containsCIS ":\\$Recycle.bin" OR src.process.image.path containsCIS ":\\Perflogs\\" OR src.process.image.path containsCIS ":\\Temp\\" OR src.process.image.path containsCIS ":\\Users\\Default\\" OR src.process.image.path containsCIS ":\\Users\\Public\\" OR src.process.image.path containsCIS ":\\Windows\\Fonts\\" OR src.process.image.path containsCIS ":\\Windows\\IME\\" OR src.process.image.path containsCIS ":\\Windows\\System32\\Tasks\\" OR src.process.image.path containsCIS ":\\Windows\\Tasks\\" OR src.process.image.path containsCIS "\\config\\systemprofile\\" OR src.process.image.path containsCIS "\\Contacts\\" OR src.process.image.path containsCIS "\\Favorites\\" OR src.process.image.path containsCIS "\\Favourites\\" OR src.process.image.path containsCIS "\\Music\\" OR src.process.image.path containsCIS "\\Pictures\\" OR src.process.image.path containsCIS "\\Videos\\" OR src.process.image.path containsCIS "\\Windows\\addins\\")) AND NOT (((DestinationHostname endswithCIS ".githubusercontent.com" OR DestinationHostname endswithCIS "0x0.st" OR DestinationHostname endswithCIS "anonfiles.com" OR DestinationHostname endswithCIS "bashupload.com" OR DestinationHostname endswithCIS "cdn.discordapp.com" OR DestinationHostname endswithCIS "chunk.io" OR DestinationHostname endswithCIS "ddns.net" OR DestinationHostname endswithCIS "dl.dropboxusercontent.com" OR DestinationHostname endswithCIS "ghostbin.co" OR DestinationHostname endswithCIS "github.com" OR DestinationHostname endswithCIS "glitch.me" OR DestinationHostname endswithCIS "gofile.io" OR DestinationHostname endswithCIS "hastebin.com" OR DestinationHostname endswithCIS "mediafire.com" OR DestinationHostname endswithCIS "mega.co.nz" OR DestinationHostname endswithCIS "mega.nz" OR DestinationHostname endswithCIS "onrender.com" OR DestinationHostname endswithCIS "pages.dev" OR DestinationHostname endswithCIS "paste.ee" OR DestinationHostname endswithCIS "pastebin.com" OR DestinationHostname endswithCIS "pastebin.pl" OR DestinationHostname endswithCIS "pastetext.net" OR DestinationHostname endswithCIS "portmap.io" OR DestinationHostname endswithCIS "privatlab.com" OR DestinationHostname endswithCIS "privatlab.net" OR DestinationHostname endswithCIS "send.exploit.in" OR DestinationHostname endswithCIS "sendspace.com" OR DestinationHostname endswithCIS "storage.googleapis.com" OR DestinationHostname endswithCIS "storjshare.io" OR DestinationHostname endswithCIS "supabase.co" OR DestinationHostname endswithCIS "temp.sh" OR DestinationHostname endswithCIS "transfer.sh" OR DestinationHostname endswithCIS "trycloudflare.com" OR DestinationHostname endswithCIS "ufile.io" OR DestinationHostname endswithCIS "w3spaces.com" OR DestinationHostname endswithCIS "workers.dev" OR DestinationHostname endswithCIS "x0.at"))))
