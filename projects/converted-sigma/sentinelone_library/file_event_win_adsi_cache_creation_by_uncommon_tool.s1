// Description: Detects the creation of an "Active Directory Schema Cache File" (.sch) file by an uncommon tool.
// Converted by: Sigma Universal SIEM/EDR CLI

((tgt.file.path containsCIS "\\Local\\Microsoft\\Windows\\SchCache\\" AND tgt.file.path endswithCIS ".sch") AND NOT (((((src.process.image.path endswithCIS ":\\Program Files\\Cylance\\Desktop\\CylanceSvc.exe" OR src.process.image.path endswithCIS ":\\Windows\\CCM\\CcmExec.exe" OR src.process.image.path endswithCIS ":\\windows\\system32\\dllhost.exe" OR src.process.image.path endswithCIS ":\\Windows\\system32\\dsac.exe" OR src.process.image.path endswithCIS ":\\Windows\\system32\\efsui.exe" OR src.process.image.path endswithCIS ":\\windows\\system32\\mmc.exe" OR src.process.image.path endswithCIS ":\\windows\\system32\\svchost.exe" OR src.process.image.path endswithCIS ":\\Windows\\System32\\wbem\\WmiPrvSE.exe" OR src.process.image.path endswithCIS ":\\windows\\system32\\WindowsPowerShell\\v1.0\\powershell.exe")) OR ((src.process.image.path containsCIS ":\\Windows\\ccmsetup\\autoupgrade\\ccmsetup" OR src.process.image.path containsCIS ":\\Program Files\\SentinelOne\\Sentinel Agent"))) OR ((src.process.image.path containsCIS ":\\Program Files\\" AND src.process.image.path containsCIS "\\Microsoft Office") AND src.process.image.path endswithCIS "\\OUTLOOK.EXE"))) AND NOT (((src.process.image.path endswithCIS ":\\Program Files\\Citrix\\Receiver StoreFront\\Services\\DefaultDomainServices\\Citrix.DeliveryServices.DomainServices.ServiceHost.exe") OR (src.process.image.path endswithCIS "\\LANDesk\\LDCLient\\ldapwhoami.exe"))))
