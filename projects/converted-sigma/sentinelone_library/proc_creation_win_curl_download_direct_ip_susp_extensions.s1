// Title: Suspicious File Download From IP Via Curl.EXE
// ID: 5cb299fc-5fb1-4d07-b989-0644c68b6043
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-07-27
// Tags: attack.execution
// Description: Detects potentially suspicious file downloads directly from IP addresses using curl.exe
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline endswithCIS ".bat" OR src.process.cmdline endswithCIS ".bat\"" OR src.process.cmdline endswithCIS ".dat" OR src.process.cmdline endswithCIS ".dat\"" OR src.process.cmdline endswithCIS ".dll" OR src.process.cmdline endswithCIS ".dll\"" OR src.process.cmdline endswithCIS ".exe" OR src.process.cmdline endswithCIS ".exe\"" OR src.process.cmdline endswithCIS ".gif" OR src.process.cmdline endswithCIS ".gif\"" OR src.process.cmdline endswithCIS ".hta" OR src.process.cmdline endswithCIS ".hta\"" OR src.process.cmdline endswithCIS ".jpeg" OR src.process.cmdline endswithCIS ".jpeg\"" OR src.process.cmdline endswithCIS ".log" OR src.process.cmdline endswithCIS ".log\"" OR src.process.cmdline endswithCIS ".msi" OR src.process.cmdline endswithCIS ".msi\"" OR src.process.cmdline endswithCIS ".png" OR src.process.cmdline endswithCIS ".png\"" OR src.process.cmdline endswithCIS ".ps1" OR src.process.cmdline endswithCIS ".ps1\"" OR src.process.cmdline endswithCIS ".psm1" OR src.process.cmdline endswithCIS ".psm1\"" OR src.process.cmdline endswithCIS ".vbe" OR src.process.cmdline endswithCIS ".vbe\"" OR src.process.cmdline endswithCIS ".vbs" OR src.process.cmdline endswithCIS ".vbs\"" OR src.process.cmdline endswithCIS ".bat'" OR src.process.cmdline endswithCIS ".dat'" OR src.process.cmdline endswithCIS ".dll'" OR src.process.cmdline endswithCIS ".exe'" OR src.process.cmdline endswithCIS ".gif'" OR src.process.cmdline endswithCIS ".hta'" OR src.process.cmdline endswithCIS ".jpeg'" OR src.process.cmdline endswithCIS ".log'" OR src.process.cmdline endswithCIS ".msi'" OR src.process.cmdline endswithCIS ".png'" OR src.process.cmdline endswithCIS ".ps1'" OR src.process.cmdline endswithCIS ".psm1'" OR src.process.cmdline endswithCIS ".vbe'" OR src.process.cmdline endswithCIS ".vbs'")) AND ((src.process.cmdline containsCIS " -O" OR src.process.cmdline containsCIS "--remote-name" OR src.process.cmdline containsCIS "--output")) AND (src.process.cmdline containsCIS "http") AND ((src.process.image.path endswithCIS "\\curl.exe") OR (OriginalFileName = "curl.exe")) AND (src.process.cmdline RegEx "://[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}"))
