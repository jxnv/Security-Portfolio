// Title: Use Short Name Path in Image
// ID: a96970af-f126-420d-90e1-d37bf25e50e1
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali
// Date: 2022-08-07
// Tags: attack.stealth, attack.t1564.004
// Description: Detect use of the Windows 8.3 short name. Which could be used as a method to avoid Image detection
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path containsCIS "~1\\" OR src.process.image.path containsCIS "~2\\")) AND NOT (((((src.process.image.path containsCIS "\\AppData\\" AND src.process.image.path containsCIS "\\Temp\\")) OR ((src.process.image.path endswithCIS "~1\\unzip.exe" OR src.process.image.path endswithCIS "~1\\7zG.exe"))) OR ((src.process.parent.image.path = "C:\\Windows\\System32\\Dism.exe" OR src.process.parent.image.path = "C:\\Windows\\System32\\cleanmgr.exe")))) AND NOT ((((Product = "InstallShield (R)") OR (Description = "InstallShield (R) Setup Engine") OR (Company = "InstallShield Software Corporation")) OR (src.process.parent.image.path endswithCIS "\\thor\\thor64.exe") OR (src.process.parent.image.path endswithCIS "\\WebEx\\WebexHost.exe"))))
