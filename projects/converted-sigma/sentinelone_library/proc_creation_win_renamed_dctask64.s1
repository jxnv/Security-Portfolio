// Description: Detects a renamed "dctask64.exe" execution, a signed binary by ZOHO Corporation part of ManageEngine Endpoint Central.
// This binary can be abused for DLL injection, arbitrary command and process execution.
// Converted by: Sigma Universal SIEM/EDR CLI

(((Hashes containsCIS "IMPHASH=6834B1B94E49701D77CCB3C0895E1AFD" OR Hashes containsCIS "IMPHASH=1BB6F93B129F398C7C4A76BB97450BBA" OR Hashes containsCIS "IMPHASH=FAA2AC19875FADE461C8D89DCF2710A3" OR Hashes containsCIS "IMPHASH=F1039CED4B91572AB7847D26032E6BBF")) AND NOT ((src.process.image.path endswithCIS "\\dctask64.exe")))
