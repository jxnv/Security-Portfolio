// Title: Potential Privilege Escalation To LOCAL SYSTEM
// ID: 207b0396-3689-42d9-8399-4222658efc99
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-05-22
// Tags: attack.resource-development, attack.t1587.001
// Description: Detects unknown program using commandline flags usually used by tools such as PsExec and PAExec to start programs with SYSTEM Privileges
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS " -s cmd" OR src.process.cmdline containsCIS " -s -i cmd" OR src.process.cmdline containsCIS " -i -s cmd" OR src.process.cmdline containsCIS " -s pwsh" OR src.process.cmdline containsCIS " -s -i pwsh" OR src.process.cmdline containsCIS " -i -s pwsh" OR src.process.cmdline containsCIS " -s powershell" OR src.process.cmdline containsCIS " -s -i powershell" OR src.process.cmdline containsCIS " -i -s powershell")) AND NOT (((src.process.cmdline containsCIS "paexec" OR src.process.cmdline containsCIS "PsExec" OR src.process.cmdline containsCIS "accepteula"))))
