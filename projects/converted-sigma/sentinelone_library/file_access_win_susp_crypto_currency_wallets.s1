// Title: Access To Crypto Currency Wallets By Uncommon Applications
// ID: f41b0311-44f9-44f0-816d-dd45e39d4bc8
// Status: test
// Level: medium
// Author: X__Junior (Nextron Systems)
// Date: 2024-07-29
// Tags: attack.t1003, attack.credential-access
// Description: Detects file access requests to crypto currency files by uncommon processes.
// Could indicate potential attempt of crypto currency wallet stealing.
// Converted by: Sigma Universal SIEM/EDR CLI

((((FileName containsCIS "\\AppData\\Roaming\\Ethereum\\keystore\\" OR FileName containsCIS "\\AppData\\Roaming\\EthereumClassic\\keystore\\" OR FileName containsCIS "\\AppData\\Roaming\\monero\\wallets\\")) OR ((FileName endswithCIS "\\AppData\\Roaming\\Bitcoin\\wallet.dat" OR FileName endswithCIS "\\AppData\\Roaming\\BitcoinABC\\wallet.dat" OR FileName endswithCIS "\\AppData\\Roaming\\BitcoinSV\\wallet.dat" OR FileName endswithCIS "\\AppData\\Roaming\\DashCore\\wallet.dat" OR FileName endswithCIS "\\AppData\\Roaming\\DogeCoin\\wallet.dat" OR FileName endswithCIS "\\AppData\\Roaming\\Litecoin\\wallet.dat" OR FileName endswithCIS "\\AppData\\Roaming\\Ripple\\wallet.dat" OR FileName endswithCIS "\\AppData\\Roaming\\Zcash\\wallet.dat"))) AND NOT ((((src.process.image.path startswithCIS "C:\\Program Files (x86)\\" OR src.process.image.path startswithCIS "C:\\Program Files\\" OR src.process.image.path startswithCIS "C:\\Windows\\system32\\" OR src.process.image.path startswithCIS "C:\\Windows\\SysWOW64\\")) OR (src.process.image.path = "System"))) AND NOT ((src.process.image.path startswithCIS "C:\\ProgramData\\Microsoft\\Windows Defender\\" AND (src.process.image.path endswithCIS "\\MpCopyAccelerator.exe" OR src.process.image.path endswithCIS "\\MsMpEng.exe"))))
