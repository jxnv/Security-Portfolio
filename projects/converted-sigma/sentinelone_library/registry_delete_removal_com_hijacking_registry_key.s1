// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects any deletion of entries in ".*\shell\open\command" registry keys.
// These registry keys might have been used for COM hijacking activities by a threat actor or an attacker and the deletion could indicate steps to remove its tracks.
// Converted by: Sigma Universal SIEM/EDR CLI

((TargetObject endswithCIS "\\shell\\open\\command") AND NOT (((src.process.image.path endswithCIS "C:\\Windows\\explorer.exe") OR ((src.process.image.path startswithCIS "C:\\Program Files\\" OR src.process.image.path startswithCIS "C:\\Program Files (x86)\\")) OR ((src.process.image.path = "C:\\Windows\\System32\\msiexec.exe" OR src.process.image.path = "C:\\Windows\\SysWOW64\\msiexec.exe")) OR (src.process.image.path = "C:\\Windows\\System32\\OpenWith.exe") OR (src.process.image.path = "C:\\Windows\\system32\\svchost.exe"))) AND NOT ((((src.process.image.path = "C:\\Program Files (x86)\\Avira\\Antivirus\\" OR src.process.image.path = "C:\\Program Files\\Avira\\Antivirus\\") AND (TargetObject endswithCIS "\\CLSID\\{305CA226-D286-468e-B848-2B2E8E697B74}\\Shell\\Open\\Command" OR TargetObject endswithCIS "\\AntiVir.Keyfile\\shell\\open\\command")) OR (src.process.image.path endswithCIS "\\reg.exe" AND TargetObject endswithCIS "\\Discord\\shell\\open\\command") OR (src.process.image.path endswithCIS "\\Dropbox.exe" AND TargetObject containsCIS "\\Dropbox.") OR (src.process.image.path endswithCIS "C:\\eclipse\\eclipse.exe" AND TargetObject containsCIS "_Classes\\eclipse+") OR (src.process.image.path containsCIS "\\Microsoft\\EdgeUpdate\\Install") OR (src.process.image.path endswithCIS "\\Everything.exe" AND TargetObject containsCIS "\\Everything.") OR (((src.process.image.path containsCIS "AppData\\Local\\Temp" AND src.process.image.path containsCIS "\\setup.exe")) OR ((src.process.image.path containsCIS "\\Temp\\is-" AND src.process.image.path containsCIS "\\target.tmp"))) OR (src.process.image.path startswithCIS "C:\\Program Files (x86)\\Java\\" AND src.process.image.path endswithCIS "\\installer.exe" AND TargetObject containsCIS "\\Classes\\WOW6432Node\\CLSID\\{4299124F-F2C3-41b4-9C73-9236B2AD0E8F}") OR (src.process.image.path endswithCIS "\\ninite.exe") OR (src.process.image.path containsCIS "peazip" AND TargetObject containsCIS "\\PeaZip.") OR (src.process.image.path endswithCIS "\\Spotify.exe" AND TargetObject endswithCIS "\\Spotify\\shell\\open\\command") OR ((src.process.image.path containsCIS "\\Temp" AND src.process.image.path containsCIS "\\TeamViewer")) OR (src.process.image.path startswithCIS "C:\\Windows\\Installer\\MSI") OR (src.process.image.path endswithCIS "\\AppData\\Local\\Temp\\Wireshark_uninstaller.exe" AND TargetObject containsCIS "\\wireshark-capture-file\\"))))
