// Description: Detects Obfuscated use of Environment Variables to execute PowerShell
// Converted by: Sigma Universal SIEM/EDR CLI

(Provider_Name = "Service Control Manager" AND EventID = "7045" AND (ImagePath containsCIS "cmd" AND ImagePath containsCIS "\"set" AND ImagePath containsCIS "-f") AND (ImagePath containsCIS "/c" OR ImagePath containsCIS "/r"))
