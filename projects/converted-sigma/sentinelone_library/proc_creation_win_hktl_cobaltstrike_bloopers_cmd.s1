// Title: Operator Bloopers Cobalt Strike Commands
// ID: 647c7b9e-d784-4fda-b9a0-45c565a7b729
// Status: test
// Level: high
// Author: _pete_0, TheDFIRReport
// Date: 2022-05-06
// Tags: attack.execution, attack.t1059.003, stp.1u
// Description: Detects use of Cobalt Strike commands accidentally entered in the CMD shell
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline startswithCIS "cmd " OR src.process.cmdline startswithCIS "cmd.exe" OR src.process.cmdline startswithCIS "c:\\windows\\system32\\cmd.exe") AND (src.process.cmdline containsCIS "psinject" OR src.process.cmdline containsCIS "spawnas" OR src.process.cmdline containsCIS "make_token" OR src.process.cmdline containsCIS "remote-exec" OR src.process.cmdline containsCIS "rev2self" OR src.process.cmdline containsCIS "dcsync" OR src.process.cmdline containsCIS "logonpasswords" OR src.process.cmdline containsCIS "execute-assembly" OR src.process.cmdline containsCIS "getsystem")) AND ((OriginalFileName = "Cmd.Exe") OR (src.process.image.path endswithCIS "\\cmd.exe")))
