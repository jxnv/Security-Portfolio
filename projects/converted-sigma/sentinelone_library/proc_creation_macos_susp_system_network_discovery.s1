// Tags: attack.discovery, attack.t1016
// Description: Detects enumeration of local network configuration
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.image.path endswithCIS "/arp" OR src.process.image.path endswithCIS "/ifconfig" OR src.process.image.path endswithCIS "/netstat" OR src.process.image.path endswithCIS "/networksetup" OR src.process.image.path endswithCIS "/socketfilterfw")) OR (src.process.image.path = "/usr/bin/defaults" AND (src.process.cmdline containsCIS "/Library/Preferences/com.apple.alf" AND src.process.cmdline containsCIS "read"))) AND NOT ((src.process.parent.image.path endswithCIS "/wifivelocityd")))
