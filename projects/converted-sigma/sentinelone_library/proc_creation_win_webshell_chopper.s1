// Title: Chopper Webshell Process Pattern
// ID: fa3c117a-bc0d-416e-a31b-0c0e80653efb
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), MSTI (query)
// Date: 2022-10-01
// Tags: attack.persistence, attack.discovery, attack.t1505.003, attack.t1018, attack.t1033, attack.t1087
// Description: Detects patterns found in process executions cause by China Chopper like tiny (ASPX) webshells
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "&ipconfig&echo" OR src.process.cmdline containsCIS "&quser&echo" OR src.process.cmdline containsCIS "&whoami&echo" OR src.process.cmdline containsCIS "&c:&echo" OR src.process.cmdline containsCIS "&cd&echo" OR src.process.cmdline containsCIS "&dir&echo" OR src.process.cmdline containsCIS "&echo [E]" OR src.process.cmdline containsCIS "&echo [S]")) AND ((src.process.image.path endswithCIS "\\w3wp.exe") OR (src.process.parent.image.path endswithCIS "\\w3wp.exe")))
