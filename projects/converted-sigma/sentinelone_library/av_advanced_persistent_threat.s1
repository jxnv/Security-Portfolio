// Title: Antivirus - APT Malware Signature
// ID: 101a1877-2cf4-474d-abfd-7f6ac4788d1a
// Status: experimental
// Level: critical
// Author: Arnim Rupp (Nextron Systems)
// Date: 2026-06-15
// Tags: attack.execution, attack.t1203, attack.command-and-control, attack.t1219.002
// Description: Detects a highly relevant Antivirus alert that reports APT malware.
// This event must not be ignored just because the AV has blocked the malware but investigate, how it came there in the first place.
// Converted by: Sigma Universal SIEM/EDR CLI

(((Signature RegEx "APT\d" OR Signature RegEx "ATK\d" OR Signature RegEx "UNC\d" OR Signature RegEx "UAC\d")) OR ((Signature containsCIS "[APT]" OR Signature containsCIS "APT_" OR Signature containsCIS "APT-" OR Signature containsCIS "BackOrder" OR Signature containsCIS "BlindingCan" OR Signature containsCIS "Blizzard" OR Signature containsCIS "Chollima" OR Signature containsCIS "Cleaver" OR Signature containsCIS "Cobra" OR Signature containsCIS "DarkHotel" OR Signature containsCIS "Dragon" OR Signature containsCIS "DTrack" OR Signature containsCIS "Equation" OR Signature containsCIS "GiftedCrook" OR Signature containsCIS "GraphSteel" OR Signature containsCIS "GreyEnergy" OR Signature containsCIS "GEnergy" OR Signature containsCIS "GrimPlant" OR Signature containsCIS "Hydra" OR Signature containsCIS "Jackal" OR Signature containsCIS "Kitten" OR Signature containsCIS "Kimsuky" OR Signature containsCIS "Lazar" OR Signature containsCIS "LightRail" OR Signature containsCIS "Lotus" OR Signature containsCIS "Luminous" OR Signature containsCIS "LumiMoth" OR Signature containsCIS "Nimbus" OR Signature containsCIS "Manticore" OR Signature containsCIS "MiniBike" OR Signature containsCIS "MiniBrowse" OR Signature containsCIS "MiniBus" OR Signature containsCIS "MiniFast" OR Signature containsCIS "MiniJuke" OR Signature containsCIS "MiniUpdate" OR Signature containsCIS "MuddyWater" OR Signature containsCIS "NukeSped" OR Signature containsCIS "OilRig" OR Signature containsCIS "Panda" OR Signature containsCIS "Sandstorm" OR Signature containsCIS "SandWorm" OR Signature containsCIS "Seamonkey" OR Signature containsCIS "Sleet" OR Signature containsCIS "SlugResin" OR Signature containsCIS "SnailResin" OR Signature containsCIS "Snake" OR Signature containsCIS "Tempest" OR Signature containsCIS "Tsunami" OR Signature containsCIS "Turla" OR Signature containsCIS "Typhoon" OR Signature containsCIS "UAC_" OR Signature containsCIS "UAC-" OR Signature containsCIS "UNC_" OR Signature containsCIS "UNC-" OR Signature containsCIS "VinoSiren" OR Signature containsCIS "Winnti")))
