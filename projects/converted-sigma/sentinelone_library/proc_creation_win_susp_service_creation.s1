// Title: Suspicious New Service Creation
// ID: 17a1be64-8d88-40bf-b5ff-a4f7a50ebcc8
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-14
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects creation of a new service via "sc" command or the powershell "new-service" cmdlet with suspicious binary paths
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.cmdline containsCIS "New-Service" AND src.process.cmdline containsCIS "-BinaryPathName")) OR (src.process.image.path endswithCIS "\\sc.exe" AND (src.process.cmdline containsCIS "create" AND src.process.cmdline containsCIS "binPath="))) AND ((src.process.cmdline containsCIS "powershell" OR src.process.cmdline containsCIS "mshta" OR src.process.cmdline containsCIS "wscript" OR src.process.cmdline containsCIS "cscript" OR src.process.cmdline containsCIS "svchost" OR src.process.cmdline containsCIS "dllhost" OR src.process.cmdline containsCIS "cmd " OR src.process.cmdline containsCIS "cmd.exe /c" OR src.process.cmdline containsCIS "cmd.exe /k" OR src.process.cmdline containsCIS "cmd.exe /r" OR src.process.cmdline containsCIS "rundll32" OR src.process.cmdline containsCIS "C:\\Users\\Public" OR src.process.cmdline containsCIS "\\Downloads\\" OR src.process.cmdline containsCIS "\\Desktop\\" OR src.process.cmdline containsCIS "\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\" OR src.process.cmdline containsCIS "C:\\Windows\\TEMP\\" OR src.process.cmdline containsCIS "\\AppData\\Local\\Temp")))
