(((src.process.image.path endswithCIS "\\mstsc.exe") OR (OriginalFileName = "mstsc.exe")) AND ((src.process.parent.image.path endswithCIS "\\brave.exe" OR src.process.parent.image.path endswithCIS "\\CCleanerBrowser.exe" OR src.process.parent.image.path endswithCIS "\\chrome.exe" OR src.process.parent.image.path endswithCIS "\\chromium.exe" OR src.process.parent.image.path endswithCIS "\\firefox.exe" OR src.process.parent.image.path endswithCIS "\\iexplore.exe" OR src.process.parent.image.path endswithCIS "\\microsoftedge.exe" OR src.process.parent.image.path endswithCIS "\\msedge.exe" OR src.process.parent.image.path endswithCIS "\\opera.exe" OR src.process.parent.image.path endswithCIS "\\vivaldi.exe" OR src.process.parent.image.path endswithCIS "\\whale.exe" OR src.process.parent.image.path endswithCIS "\\outlook.exe")))
