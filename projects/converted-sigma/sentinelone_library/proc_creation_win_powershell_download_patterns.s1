// Title: PowerShell Download Pattern
// ID: 3b6ab547-8ec2-4991-b9d2-2b06702a48d7
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), oscd.community, Jonhnathan Ribeiro
// Date: 2019-01-16
// Tags: attack.execution, attack.t1059.001
// Description: Detects a Powershell process that contains download commands in its command line string
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "new-object" AND src.process.cmdline containsCIS "net.webclient)." AND src.process.cmdline containsCIS "download") AND (src.process.cmdline containsCIS "string(" OR src.process.cmdline containsCIS "file(")) AND (((src.process.image.path endswithCIS "\\powershell_ise.exe" OR src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe")) OR ((OriginalFileName = "PowerShell_ISE.EXE" OR OriginalFileName = "PowerShell.EXE" OR OriginalFileName = "pwsh.dll"))))
