ithCIS ".http80.info" OR cs-host endswithCIS ".https443.com" OR cs-host endswithCIS ".imap01.com" OR cs-host endswithCIS ".kadm5.com" OR cs-host endswithCIS ".mysq1.net" OR cs-host endswithCIS ".ns360.info" OR cs-host endswithCIS ".ntdll.net" OR cs-host endswithCIS ".ole32.com" OR cs-host endswithCIS ".proxy8080.com" OR cs-host endswithCIS ".sql01.com" OR cs-host endswithCIS ".ssh01.com" OR cs-host endswithCIS ".ssh22.net" OR cs-host endswithCIS ".tempors.com" OR cs-host endswithCIS ".tftpd.net" OR cs-host endswithCIS ".ttl60.com" OR cs-host endswithCIS ".ttl60.org" OR cs-host endswithCIS ".user32.com" OR cs-host endswithCIS ".voip01.com" OR cs-host endswithCIS ".wow64.net" OR cs-host endswithCIS ".x64.me" OR cs-host endswithCIS ".xns01.com" OR cs-host endswithCIS ".dyndns.org" OR cs-host endswithCIS ".dyndns.info" OR cs-host endswithCIS ".dyndns.tv" OR cs-host endswithCIS ".dyndns-at-home.com" OR cs-host endswithCIS ".dnsomatic.com" OR cs-host endswithCIS ".zapto.org" OR cs-host endswithCIS ".webhop.net" OR cs-host endswithCIS ".25u.com" OR cs-host endswithCIS ".slyip.net"))
