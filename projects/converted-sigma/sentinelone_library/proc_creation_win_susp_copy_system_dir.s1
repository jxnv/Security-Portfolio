// Title: Suspicious Copy From or To System Directory
// ID: fff9d2b7-e11c-4a69-93d3-40ef66189767
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), Markus Neis, Tim Shelton (HAWK.IO), Nasreddine Bencherchali (Nextron Systems)
// Date: 2020-07-03
// Tags: attack.stealth, attack.t1036.003
// Description: Detects a suspicious copy operation that tries to copy a program from system (System32, SysWOW64, WinSxS) directories to another on disk.
// Often used to move LOLBINs such as 'certutil' or 'desktopimgdownldr' to a different location with a different name in order to bypass detections based on locations.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "\\cmd.exe" AND src.process.cmdline containsCIS "copy ") OR (((src.process.image.path endswithCIS "\\robocopy.exe" OR src.process.image.path endswithCIS "\\xcopy.exe")) OR ((OriginalFileName = "robocopy.exe" OR OriginalFileName = "XCOPY.EXE"))) OR ((src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe") AND (src.process.cmdline containsCIS "copy-item" OR src.process.cmdline containsCIS " copy " OR src.process.cmdline containsCIS "cpi " OR src.process.cmdline containsCIS " cp "))) AND (src.process.cmdline RegEx "\s['"]?C:\\Windows\\(?:System32|SysWOW64|WinSxS)") AND NOT ((src.process.image.path endswithCIS "\\cmd.exe" AND (src.process.cmdline containsCIS "/c copy" AND src.process.cmdline containsCIS "\\Temp\\" AND src.process.cmdline containsCIS "\\avira_system_speedup.exe") AND (src.process.cmdline containsCIS "C:\\Program Files\\Avira\\" OR src.process.cmdline containsCIS "C:\\Program Files (x86)\\Avira\\"))))
