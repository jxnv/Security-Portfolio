// Title: Potential Tampering With Security Products Via WMIC
// ID: 847d5ff3-8a31-4737-a970-aeae8fe21765
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-01-30
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects uninstallation or termination of security products using the WMIC utility
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.cmdline containsCIS "wmic" AND src.process.cmdline containsCIS "product " AND src.process.cmdline containsCIS "uninstall") AND (src.process.cmdline containsCIS "/nointeractive" OR src.process.cmdline containsCIS "-nointeractive")) OR ((src.process.cmdline containsCIS "wmic" AND src.process.cmdline containsCIS "caption like ") AND (src.process.cmdline containsCIS "call delete" OR src.process.cmdline containsCIS "call terminate")) OR ((src.process.cmdline containsCIS "process " AND src.process.cmdline containsCIS "where " AND src.process.cmdline containsCIS "delete"))) AND ((src.process.cmdline containsCIS "%carbon%" OR src.process.cmdline containsCIS "%cylance%" OR src.process.cmdline containsCIS "%endpoint%" OR src.process.cmdline containsCIS "%eset%" OR src.process.cmdline containsCIS "%malware%" OR src.process.cmdline containsCIS "%Sophos%" OR src.process.cmdline containsCIS "%symantec%" OR src.process.cmdline containsCIS "Antivirus" OR src.process.cmdline containsCIS "AVG " OR src.process.cmdline containsCIS "Carbon Black" OR src.process.cmdline containsCIS "CarbonBlack" OR src.process.cmdline containsCIS "Cb Defense Sensor 64-bit" OR src.process.cmdline containsCIS "Crowdstrike Sensor" OR src.process.cmdline containsCIS "Cylance " OR src.process.cmdline containsCIS "Dell Threat Defense" OR src.process.cmdline containsCIS "DLP Endpoint" OR src.process.cmdline containsCIS "Endpoint Detection" OR src.process.cmdline containsCIS "Endpoint Protection" OR src.process.cmdline containsCIS "Endpoint Security" OR src.process.cmdline containsCIS "Endpoint Sensor" OR src.process.cmdline containsCIS "ESET File Security" OR src.process.cmdline containsCIS "LogRhythm System Monitor Service" OR src.process.cmdline containsCIS "Malwarebytes" OR src.process.cmdline containsCIS "McAfee Agent" OR src.process.cmdline containsCIS "Microsoft Security Client" OR src.process.cmdline containsCIS "Sophos Anti-Virus" OR src.process.cmdline containsCIS "Sophos AutoUpdate" OR src.process.cmdline containsCIS "Sophos Credential Store" OR src.process.cmdline containsCIS "Sophos Management Console" OR src.process.cmdline containsCIS "Sophos Management Database" OR src.process.cmdline containsCIS "Sophos Management Server" OR src.process.cmdline containsCIS "Sophos Remote Management System" OR src.process.cmdline containsCIS "Sophos Update Manager" OR src.process.cmdline containsCIS "Threat Protection" OR src.process.cmdline containsCIS "VirusScan" OR src.process.cmdline containsCIS "Webroot SecureAnywhere" OR src.process.cmdline containsCIS "Windows Defender")))
