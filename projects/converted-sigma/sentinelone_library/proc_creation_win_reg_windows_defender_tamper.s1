// Title: Suspicious Windows Defender Registry Key Tampering Via Reg.EXE
// ID: 452bce90-6fb0-43cc-97a5-affc283139b3
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Swachchhanda Shrawan Poudel, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-03-22
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects the usage of "reg.exe" to tamper with different Windows Defender registry keys in order to disable some important features related to protection and detection
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.image.path endswithCIS "\\reg.exe") OR (OriginalFileName = "reg.exe")) AND ((src.process.cmdline containsCIS "SOFTWARE\\Microsoft\\Windows Defender\\" OR src.process.cmdline containsCIS "SOFTWARE\\Policies\\Microsoft\\Windows Defender Security Center" OR src.process.cmdline containsCIS "SOFTWARE\\Policies\\Microsoft\\Windows Defender\\"))) AND (((src.process.cmdline containsCIS " add " AND src.process.cmdline containsCIS "d 0") AND (src.process.cmdline containsCIS "DisallowExploitProtectionOverride" OR src.process.cmdline containsCIS "EnableControlledFolderAccess" OR src.process.cmdline containsCIS "MpEnablePus" OR src.process.cmdline containsCIS "PUAProtection" OR src.process.cmdline containsCIS "SpynetReporting" OR src.process.cmdline containsCIS "SubmitSamplesConsent" OR src.process.cmdline containsCIS "TamperProtection")) OR ((src.process.cmdline containsCIS " add " AND src.process.cmdline containsCIS "d 1") AND (src.process.cmdline containsCIS "DisableAccess" OR src.process.cmdline containsCIS "DisableAntiSpyware" OR src.process.cmdline containsCIS "DisableAntiSpywareRealtimeProtection" OR src.process.cmdline containsCIS "DisableAntiVirus" OR src.process.cmdline containsCIS "DisableAntiVirusSignatures" OR src.process.cmdline containsCIS "DisableArchiveScanning" OR src.process.cmdline containsCIS "DisableBehaviorMonitoring" OR src.process.cmdline containsCIS "DisableBlockAtFirstSeen" OR src.process.cmdline containsCIS "DisableCloudProtection" OR src.process.cmdline containsCIS "DisableConfig" OR src.process.cmdline containsCIS "DisableEnhancedNotifications" OR src.process.cmdline containsCIS "DisableIntrusionPreventionSystem" OR src.process.cmdline containsCIS "DisableIOAVProtection" OR src.process.cmdline containsCIS "DisableNetworkProtection" OR src.process.cmdline containsCIS "DisableOnAccessProtection" OR src.process.cmdline containsCIS "DisablePrivacyMode" OR src.process.cmdline containsCIS "DisableRealtimeMonitoring" OR src.process.cmdline containsCIS "DisableRoutinelyTakingAction" OR src.process.cmdline containsCIS "DisableScanOnRealtimeEnable" OR src.process.cmdline containsCIS "DisableScriptScanning" OR src.process.cmdline containsCIS "DisableSecurityCenter" OR src.process.cmdline containsCIS "Notification_Suppress" OR src.process.cmdline containsCIS "SignatureDisableUpdateOnStartupWithoutEngine"))))
