// Title: Modify Group Policy Settings
// ID: ada4b0c4-758b-46ac-9033-9004613a150d
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-08-19
// Tags: attack.privilege-escalation, attack.defense-impairment, attack.t1484.001
// Description: Detect malicious GPO modifications can be used to implement many other malicious behaviors.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "GroupPolicyRefreshTimeDC" OR src.process.cmdline containsCIS "GroupPolicyRefreshTimeOffsetDC" OR src.process.cmdline containsCIS "GroupPolicyRefreshTime" OR src.process.cmdline containsCIS "GroupPolicyRefreshTimeOffset" OR src.process.cmdline containsCIS "EnableSmartScreen" OR src.process.cmdline containsCIS "ShellSmartScreenLevel")) AND (src.process.cmdline containsCIS "\\SOFTWARE\\Policies\\Microsoft\\Windows\\System") AND ((src.process.image.path endswithCIS "\\reg.exe") OR (OriginalFileName = "reg.exe")))
