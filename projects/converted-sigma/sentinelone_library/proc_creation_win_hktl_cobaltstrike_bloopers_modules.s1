// Title: Operator Bloopers Cobalt Strike Modules
// ID: 4f154fb6-27d1-4813-a759-78b93e0b9c48
// Status: test
// Level: high
// Author: _pete_0, TheDFIRReport
// Date: 2022-05-06
// Tags: attack.execution, attack.t1059.003
// Description: Detects Cobalt Strike module/commands accidentally entered in CMD shell
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "Invoke-UserHunter" OR src.process.cmdline containsCIS "Invoke-ShareFinder" OR src.process.cmdline containsCIS "Invoke-Kerberoast" OR src.process.cmdline containsCIS "Invoke-SMBAutoBrute" OR src.process.cmdline containsCIS "Invoke-Nightmare" OR src.process.cmdline containsCIS "zerologon" OR src.process.cmdline containsCIS "av_query")) AND ((OriginalFileName = "Cmd.Exe") OR (src.process.image.path endswithCIS "\\cmd.exe")))
