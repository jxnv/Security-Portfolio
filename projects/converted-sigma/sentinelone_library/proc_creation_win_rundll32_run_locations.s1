// Tags: attack.stealth, attack.t1036, car.2013-05-002
// Description: Detects suspicious process run from unusual locations
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path containsCIS ":\\RECYCLER\\" OR src.process.image.path containsCIS ":\\SystemVolumeInformation\\")) OR ((src.process.image.path startswithCIS "C:\\Windows\\Tasks\\" OR src.process.image.path startswithCIS "C:\\Windows\\debug\\" OR src.process.image.path startswithCIS "C:\\Windows\\fonts\\" OR src.process.image.path startswithCIS "C:\\Windows\\help\\" OR src.process.image.path startswithCIS "C:\\Windows\\drivers\\" OR src.process.image.path startswithCIS "C:\\Windows\\addins\\" OR src.process.image.path startswithCIS "C:\\Windows\\cursors\\" OR src.process.image.path startswithCIS "C:\\Windows\\system32\\tasks\\")))
