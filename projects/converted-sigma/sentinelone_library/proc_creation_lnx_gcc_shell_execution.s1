// Title: Shell Execution GCC  - Linux
// ID: 9b5de532-a757-4d70-946c-1f3e44f48b4d
// Status: test
// Level: high
// Author: Li Ling, Andy Parkidomo, Robert Rakowski, Blake Hartstein (Bloomberg L.P.)
// Date: 2024-09-02
// Tags: attack.discovery, attack.t1083
// Description: Detects the use of the "gcc" utility to execute a shell. Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "/bin/bash,-s" OR src.process.cmdline containsCIS "/bin/dash,-s" OR src.process.cmdline containsCIS "/bin/fish,-s" OR src.process.cmdline containsCIS "/bin/sh,-s" OR src.process.cmdline containsCIS "/bin/zsh,-s")) AND ((src.process.image.path endswithCIS "/c89" OR src.process.image.path endswithCIS "/c99" OR src.process.image.path endswithCIS "/gcc") AND src.process.cmdline containsCIS "-wrapper"))
