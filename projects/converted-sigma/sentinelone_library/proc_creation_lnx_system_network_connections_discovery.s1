// Title: System Network Connections Discovery - Linux
// ID: 4c519226-f0cd-4471-bd2f-6fbb2bb68a79
// Status: test
// Level: low
// Author: Daniil Yugoslavskiy, oscd.community
// Date: 2020-10-19
// Tags: attack.discovery, attack.t1049
// Description: Detects usage of system utilities to discover system network connections
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "/who" OR src.process.image.path endswithCIS "/w" OR src.process.image.path endswithCIS "/last" OR src.process.image.path endswithCIS "/lsof" OR src.process.image.path endswithCIS "/netstat")) AND NOT ((src.process.parent.cmdline containsCIS "/usr/bin/landscape-sysinfo" AND src.process.image.path endswithCIS "/who")))
