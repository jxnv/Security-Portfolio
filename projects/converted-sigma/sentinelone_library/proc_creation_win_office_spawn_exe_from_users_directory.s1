// Title: Suspicious Binary In User Directory Spawned From Office Application
// ID: aa3a6f94-890e-4e22-b634-ffdfd54792cc
// Status: test
// Level: high
// Author: Jason Lynch
// Date: 2019-04-02
// Tags: attack.execution, attack.t1204.002, attack.g0046, car.2013-05-002
// Description: Detects an executable in the users directory started from one of the Microsoft Office suite applications (Word, Excel, PowerPoint, Publisher, Visio)
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.parent.image.path endswithCIS "\\WINWORD.EXE" OR src.process.parent.image.path endswithCIS "\\EXCEL.EXE" OR src.process.parent.image.path endswithCIS "\\POWERPNT.exe" OR src.process.parent.image.path endswithCIS "\\MSPUB.exe" OR src.process.parent.image.path endswithCIS "\\VISIO.exe" OR src.process.parent.image.path endswithCIS "\\MSACCESS.exe" OR src.process.parent.image.path endswithCIS "\\EQNEDT32.exe") AND src.process.image.path startswithCIS "C:\\users\\" AND src.process.image.path endswithCIS ".exe") AND NOT ((src.process.image.path endswithCIS "\\Teams.exe")))
