// Description: Detects attempts to create a DLL file to a known desktop application dependencies folder such as Slack, Teams or OneDrive and by an unusual process. This may indicate an attempt to load a malicious module via DLL search order hijacking.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "\\winword.exe" OR src.process.image.path endswithCIS "\\excel.exe" OR src.process.image.path endswithCIS "\\powerpnt.exe" OR src.process.image.path endswithCIS "\\MSACCESS.EXE" OR src.process.image.path endswithCIS "\\MSPUB.EXE" OR src.process.image.path endswithCIS "\\fltldr.exe" OR src.process.image.path endswithCIS "\\cmd.exe" OR src.process.image.path endswithCIS "\\certutil.exe" OR src.process.image.path endswithCIS "\\mshta.exe" OR src.process.image.path endswithCIS "\\cscript.exe" OR src.process.image.path endswithCIS "\\wscript.exe" OR src.process.image.path endswithCIS "\\curl.exe" OR src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe") AND tgt.file.path endswithCIS ".dll" AND (tgt.file.path containsCIS "\\Users\\" AND tgt.file.path containsCIS "\\AppData\\") AND (tgt.file.path containsCIS "\\Microsoft\\OneDrive\\" OR tgt.file.path containsCIS "\\Microsoft OneDrive\\" OR tgt.file.path containsCIS "\\Microsoft\\Teams\\" OR tgt.file.path containsCIS "\\Local\\slack\\app-" OR tgt.file.path containsCIS "\\Local\\Programs\\Microsoft VS Code\\")) AND NOT ((src.process.image.path endswithCIS "\\cmd.exe" AND (tgt.file.path containsCIS "\\Users\\" AND tgt.file.path containsCIS "\\AppData\\" AND tgt.file.path containsCIS "\\Microsoft\\OneDrive\\" AND tgt.file.path containsCIS "\\api-ms-win-core-"))))
