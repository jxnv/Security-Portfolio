// Title: Change PowerShell Policies to an Insecure Level
// ID: 87e3c4e8-a6a8-4ad9-bb4f-46e7ff99a180
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-11-01
// Tags: attack.execution, attack.t1059.001
// Description: Detects changing the PowerShell script execution policy to a potentially insecure level using the "-ExecutionPolicy" flag.
// Converted by: Sigma Universal SIEM/EDR CLI

(((((OriginalFileName = "powershell_ise.exe" OR OriginalFileName = "PowerShell.EXE" OR OriginalFileName = "pwsh.dll")) OR ((src.process.image.path endswithCIS "\\powershell_ise.exe" OR src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe"))) AND ((src.process.cmdline containsCIS "Bypass" OR src.process.cmdline containsCIS "Unrestricted")) AND ((src.process.cmdline containsCIS "-executionpolicy " OR src.process.cmdline containsCIS " -ep " OR src.process.cmdline containsCIS " -exec "))) AND NOT (((src.process.parent.image.path = "C:\\Windows\\SysWOW64\\msiexec.exe" OR src.process.parent.image.path = "C:\\Windows\\System32\\msiexec.exe") AND (src.process.cmdline containsCIS "-NoProfile -ExecutionPolicy Bypass -File \"C:\\Program Files\\PowerShell\\7\\" OR src.process.cmdline containsCIS "-NoProfile -ExecutionPolicy Bypass -File \"C:\\Program Files (x86)\\PowerShell\\7\\"))) AND NOT (((src.process.parent.image.path containsCIS "C:\\Program Files\\Avast Software\\Avast\\" OR src.process.parent.image.path containsCIS "C:\\Program Files (x86)\\Avast Software\\Avast\\" OR src.process.parent.image.path containsCIS "\\instup.exe") AND (src.process.cmdline containsCIS "-ExecutionPolicy ByPass -File \"C:\\Program Files\\Avast Software\\Avast" OR src.process.cmdline containsCIS "-ExecutionPolicy ByPass -File \"C:\\Program Files (x86)\\Avast Software\\Avast\\"))))
