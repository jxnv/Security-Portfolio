// Title: Potentially Suspicious File Download From ZIP TLD
// ID: 0bb4bbeb-fe52-4044-b40c-430a04577ebe
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2023-05-18
// Tags: attack.stealth
// Description: Detects the download of a file with a potentially suspicious extension from a .zip top level domain.
// Converted by: Sigma Universal SIEM/EDR CLI

(Contents containsCIS ".zip/" AND (tgt.file.path containsCIS ".bat:Zone" OR tgt.file.path containsCIS ".dat:Zone" OR tgt.file.path containsCIS ".dll:Zone" OR tgt.file.path containsCIS ".doc:Zone" OR tgt.file.path containsCIS ".docm:Zone" OR tgt.file.path containsCIS ".exe:Zone" OR tgt.file.path containsCIS ".hta:Zone" OR tgt.file.path containsCIS ".pptm:Zone" OR tgt.file.path containsCIS ".ps1:Zone" OR tgt.file.path containsCIS ".rar:Zone" OR tgt.file.path containsCIS ".rtf:Zone" OR tgt.file.path containsCIS ".sct:Zone" OR tgt.file.path containsCIS ".vbe:Zone" OR tgt.file.path containsCIS ".vbs:Zone" OR tgt.file.path containsCIS ".ws:Zone" OR tgt.file.path containsCIS ".wsf:Zone" OR tgt.file.path containsCIS ".xll:Zone" OR tgt.file.path containsCIS ".xls:Zone" OR tgt.file.path containsCIS ".xlsm:Zone" OR tgt.file.path containsCIS ".zip:Zone"))
