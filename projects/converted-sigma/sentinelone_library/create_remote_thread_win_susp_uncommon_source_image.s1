(((SourceImage endswithCIS "\\explorer.exe" OR SourceImage endswithCIS "\\iexplore.exe" OR SourceImage endswithCIS "\\msiexec.exe" OR SourceImage endswithCIS "\\powerpnt.exe" OR SourceImage endswithCIS "\\schtasks.exe" OR SourceImage endswithCIS "\\winlogon.exe")) AND NOT (((TargetImage = "") OR (SourceImage = "C:\\Windows\\explorer.exe" AND (TargetImage startswithCIS "C:\\Program Files (x86)\\" OR TargetImage startswithCIS "C:\\Program Files\\" OR TargetImage startswithCIS "C:\\Windows\\System32\\" OR TargetImage startswithCIS "C:\\Windows\\SysWOW64\\")) OR (SourceImage = "C:\\Program Files\\Internet Explorer\\iexplore.exe" AND (TargetImage = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR TargetImage = "C:\\Windows\\System32\\rundll32.exe")) OR (SourceImage endswithCIS "\\msiexec.exe" AND (TargetImage containsCIS "\\AppData\\Local\\" OR TargetImage containsCIS "C:\\Program Files (x86)\\" OR TargetImage containsCIS "C:\\Program Files\\" OR TargetImage containsCIS "C:\\Windows\\Microsoft.NET\\Framework64\\")) OR (SourceImage endswithCIS "\\msiexec.exe" AND (TargetImage = "C:\\Windows\\System32\\msiexec.exe" OR TargetImage = "C:\\Windows\\SysWOW64\\msiexec.exe")) OR (TargetImage is null) OR (SourceImage endswithCIS "\\POWERPNT.EXE" AND (TargetImage containsCIS "C:\\Program Files\\Microsoft Office\\" OR TargetImage containsCIS "C:\\Program Files (x86)\\Microsoft Office\\")) OR ((SourceImage = "C:\\Windows\\System32\\schtasks.exe" OR SourceImage = "C:\\Windows\\SysWOW64\\schtasks.exe") AND TargetImage = "C:\\Windows\\System32\\conhost.exe") OR (TargetImage = "System") OR (SourceImage = "C:\\Windows\\System32\\winlogon.exe" AND (TargetImage = "C:\\Windows\\System32\\services.exe" OR TargetImage = "C:\\Windows\\System32\\wininit.exe" OR TargetImage = "C:\\Windows\\System32\\csrss.exe" OR TargetImage = "C:\\Windows\\System32\\LogonUI.exe" OR TargetImage = "C:\\Windows\\System32\\wlrmdr.exe" OR TargetImage = "C:\\Windows\\System32\\AtBroker.exe" OR TargetImage = "C:\\Windows\\System32\\dwm.exe" OR TargetImage = "C:\\Windows\\System32\\fontdrvhost.exe" OR TargetImage = "C:\\Windows\\System32\\userinit.exe")) OR (SourceImage = "C:\\Windows\\System32\\winlogon.exe" AND TargetParentProcessId = "4"))) AND NOT (((SourceImage = "C:\\Windows\\explorer.exe" AND TargetImage endswithCIS "\\aurora-dashboard.exe") OR (SourceImage = "C:\\Program Files\\internet explorer\\iexplore.exe" AND (SourceCommandLine containsCIS "https://" AND SourceCommandLine containsCIS ".checkpoint.com/documents/" AND SourceCommandLine containsCIS "SmartConsole_OLH/" AND SourceCommandLine containsCIS "default.htm#cshid=")) OR (SourceImage = "C:\\Program Files\\internet explorer\\iexplore.exe" AND (SourceParentImage startswithCIS "C:\\Program Files\\" OR SourceParentImage startswithCIS "C:\\Program Files (x86)\\") AND (SourceParentImage containsCIS "\\CheckPoint\\SmartConsole\\" AND SourceParentImage containsCIS "\\SmartConsole.exe")) OR (SourceImage = "C:\\Windows\\explorer.exe" AND TargetImage endswithCIS "\\OfficeSetup.exe") OR (SourceImage = "C:\\Windows\\explorer.exe" AND TargetImage endswithCIS "\\AppData\\Local\\Microsoft\\OneDrive\\OneDrive.exe") OR (SourceImage containsCIS "\\Microsoft Office\\" AND SourceImage endswithCIS "\\POWERPNT.EXE" AND TargetImage = "C:\\Windows\\System32\\csrss.exe"))))
