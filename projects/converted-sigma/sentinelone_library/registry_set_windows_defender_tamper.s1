// Title: Disable Windows Defender Functionalities Via Registry Keys
// ID: 0eb46774-f1ab-4a74-8238-1155855f2263
// Status: test
// Level: high
// Author: AlertIQ, Ján Trenčanský, frack113, Nasreddine Bencherchali, Swachchhanda Shrawan Poudel
// Date: 2022-08-01
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects when attackers or tools disable Windows Defender functionalities via the Windows registry
// Converted by: Sigma Universal SIEM/EDR CLI

(((TargetObject containsCIS "\\SOFTWARE\\Microsoft\\Windows Defender\\" OR TargetObject containsCIS "\\SOFTWARE\\Policies\\Microsoft\\Windows Defender Security Center\\" OR TargetObject containsCIS "\\SOFTWARE\\Policies\\Microsoft\\Windows Defender\\")) AND (((TargetObject endswithCIS "\\DisallowExploitProtectionOverride" OR TargetObject endswithCIS "\\Features\\TamperProtection" OR TargetObject endswithCIS "\\MpEngine\\MpEnablePus" OR TargetObject endswithCIS "\\PUAProtection" OR TargetObject endswithCIS "\\Signature Update\\ForceUpdateFromMU" OR TargetObject endswithCIS "\\SpyNet\\SpynetReporting" OR TargetObject endswithCIS "\\SpyNet\\SubmitSamplesConsent" OR TargetObject endswithCIS "\\Windows Defender Exploit Guard\\Controlled Folder Access\\EnableControlledFolderAccess") AND Details = "DWORD (0x00000000)") OR ((TargetObject endswithCIS "\\DisableAntiSpyware" OR TargetObject endswithCIS "\\DisableAntiVirus" OR TargetObject endswithCIS "\\DisableBehaviorMonitoring" OR TargetObject endswithCIS "\\DisableBlockAtFirstSeen" OR TargetObject endswithCIS "\\DisableEnhancedNotifications" OR TargetObject endswithCIS "\\DisableIntrusionPreventionSystem" OR TargetObject endswithCIS "\\DisableIOAVProtection" OR TargetObject endswithCIS "\\DisableOnAccessProtection" OR TargetObject endswithCIS "\\DisableRealtimeMonitoring" OR TargetObject endswithCIS "\\DisableScanOnRealtimeEnable" OR TargetObject endswithCIS "\\DisableScriptScanning") AND Details = "DWORD (0x00000001)")) AND NOT ((src.process.image.path startswithCIS "C:\\Program Files\\Symantec\\Symantec Endpoint Protection\\" AND src.process.image.path endswithCIS "\\sepWscSvc64.exe")))
