// Title: HackTool - Quarks PwDump Execution
// ID: 0685b176-c816-4837-8e7b-1216f346636b
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-05
// Tags: attack.credential-access, attack.t1003.002
// Description: Detects usage of the Quarks PwDump tool via commandline arguments
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline = " -dhl" OR src.process.cmdline = " --dump-hash-local" OR src.process.cmdline = " -dhdc" OR src.process.cmdline = " --dump-hash-domain-cached" OR src.process.cmdline = " --dump-bitlocker" OR src.process.cmdline = " -dhd " OR src.process.cmdline = " --dump-hash-domain " OR src.process.cmdline = "--ntds-file")) OR (src.process.image.path endswithCIS "\\QuarksPwDump.exe"))
