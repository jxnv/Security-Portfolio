// Title: Suspicious Get Local Groups Information
// ID: cef24b90-dddc-4ae1-a09a-8764872f69fc
// Status: test
// Level: low
// Author: frack113
// Date: 2021-12-12
// Tags: attack.discovery, attack.t1069.001
// Description: Detects the use of PowerShell modules and cmdlets to gather local group information.
// Adversaries may use local system permission groups to determine which groups exist and which users belong to a particular group such as the local administrators group.
// Converted by: Sigma Universal SIEM/EDR CLI

((((Payload containsCIS "get-localgroup " OR Payload containsCIS "get-localgroupmember ")) OR ((ContextInfo containsCIS "get-localgroup " OR ContextInfo containsCIS "get-localgroupmember "))) OR (((Payload containsCIS "win32_group") OR (ContextInfo containsCIS "win32_group")) AND (((Payload containsCIS "get-wmiobject " OR Payload containsCIS "gwmi " OR Payload containsCIS "get-ciminstance " OR Payload containsCIS "gcim ")) OR ((ContextInfo containsCIS "get-wmiobject " AND ContextInfo containsCIS "gwmi " AND ContextInfo containsCIS "get-ciminstance " AND ContextInfo containsCIS "gcim ")))))
