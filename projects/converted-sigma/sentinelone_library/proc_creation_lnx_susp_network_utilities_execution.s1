// Title: Linux Network Service Scanning Tools Execution
// ID: 3e102cd9-a70d-4a7a-9508-403963092f31
// Status: test
// Level: low
// Author: Alejandro Ortuno, oscd.community, Georg Lauenstein (sure[secure])
// Date: 2020-10-21
// Tags: attack.discovery, attack.t1046
// Description: Detects execution of network scanning and reconnaisance tools. These tools can be used for the enumeration of local or remote network services for example.
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.image.path endswithCIS "/nc" OR src.process.image.path endswithCIS "/ncat" OR src.process.image.path endswithCIS "/netcat" OR src.process.image.path endswithCIS "/socat")) AND NOT (((src.process.cmdline containsCIS " --listen " OR src.process.cmdline containsCIS " -l ")))) OR ((src.process.image.path endswithCIS "/autorecon" OR src.process.image.path endswithCIS "/hping" OR src.process.image.path endswithCIS "/hping2" OR src.process.image.path endswithCIS "/hping3" OR src.process.image.path endswithCIS "/naabu" OR src.process.image.path endswithCIS "/nmap" OR src.process.image.path endswithCIS "/nping" OR src.process.image.path endswithCIS "/telnet" OR src.process.image.path endswithCIS "/zenmap")))
