// Title: Suspicious ScreenSave Change by Reg.exe
// ID: 0fc35fc3-efe6-4898-8a37-0b233339524f
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-08-19
// Tags: attack.persistence, attack.privilege-escalation, attack.t1546.002
// Description: Adversaries may establish persistence by executing malicious content triggered by user inactivity.
// Screensavers are programs that execute after a configurable time of user inactivity and consist of Portable Executable (PE) files with a .scr file extension
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path endswithCIS "\\reg.exe" AND (src.process.cmdline containsCIS "HKEY_CURRENT_USER\\Control Panel\\Desktop" OR src.process.cmdline containsCIS "HKCU\\Control Panel\\Desktop")) AND (((src.process.cmdline containsCIS "/v ScreenSaveActive" AND src.process.cmdline containsCIS "/t REG_SZ" AND src.process.cmdline containsCIS "/d 1" AND src.process.cmdline containsCIS "/f")) OR ((src.process.cmdline containsCIS "/v ScreenSaveTimeout" AND src.process.cmdline containsCIS "/t REG_SZ" AND src.process.cmdline containsCIS "/d " AND src.process.cmdline containsCIS "/f")) OR ((src.process.cmdline containsCIS "/v ScreenSaverIsSecure" AND src.process.cmdline containsCIS "/t REG_SZ" AND src.process.cmdline containsCIS "/d 0" AND src.process.cmdline containsCIS "/f")) OR ((src.process.cmdline containsCIS "/v SCRNSAVE.EXE" AND src.process.cmdline containsCIS "/t REG_SZ" AND src.process.cmdline containsCIS "/d " AND src.process.cmdline containsCIS ".scr" AND src.process.cmdline containsCIS "/f"))))
