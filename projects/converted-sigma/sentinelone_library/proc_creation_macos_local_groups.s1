// Title: Local Groups Discovery - MacOs
// ID: 89bb1f97-c7b9-40e8-b52b-7d6afbd67276
// Status: test
// Level: informational
// Author: Ömer Günal, Alejandro Ortuno, oscd.community
// Date: 2020-10-11
// Tags: attack.discovery, attack.t1069.001
// Description: Detects enumeration of local system groups
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path endswithCIS "/dscacheutil" AND (src.process.cmdline containsCIS "-q" AND src.process.cmdline containsCIS "group")) OR (src.process.image.path endswithCIS "/cat" AND src.process.cmdline containsCIS "/etc/group") OR (src.process.image.path endswithCIS "/dscl" AND (src.process.cmdline containsCIS "-list" AND src.process.cmdline containsCIS "/groups")))
