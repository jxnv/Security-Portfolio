// Title: Suspicious Shells Spawn by Java Utility Keytool
// ID: 90fb5e62-ca1f-4e22-b42e-cc521874c938
// Status: test
// Level: high
// Author: Andreas Hunkeler (@Karneades)
// Date: 2021-12-22
// Tags: attack.initial-access, attack.persistence, attack.privilege-escalation
// Description: Detects suspicious shell spawn from Java utility keytool process (e.g. adselfservice plus exploitation)
// Converted by: Sigma Universal SIEM/EDR CLI

(src.process.parent.image.path endswithCIS "\\keytool.exe" AND (src.process.image.path endswithCIS "\\cmd.exe" OR src.process.image.path endswithCIS "\\sh.exe" OR src.process.image.path endswithCIS "\\bash.exe" OR src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe" OR src.process.image.path endswithCIS "\\schtasks.exe" OR src.process.image.path endswithCIS "\\certutil.exe" OR src.process.image.path endswithCIS "\\whoami.exe" OR src.process.image.path endswithCIS "\\bitsadmin.exe" OR src.process.image.path endswithCIS "\\wscript.exe" OR src.process.image.path endswithCIS "\\cscript.exe" OR src.process.image.path endswithCIS "\\scrcons.exe" OR src.process.image.path endswithCIS "\\regsvr32.exe" OR src.process.image.path endswithCIS "\\hh.exe" OR src.process.image.path endswithCIS "\\wmic.exe" OR src.process.image.path endswithCIS "\\mshta.exe" OR src.process.image.path endswithCIS "\\rundll32.exe" OR src.process.image.path endswithCIS "\\forfiles.exe" OR src.process.image.path endswithCIS "\\scriptrunner.exe" OR src.process.image.path endswithCIS "\\mftrace.exe" OR src.process.image.path endswithCIS "\\AppVLP.exe" OR src.process.image.path endswithCIS "\\systeminfo.exe" OR src.process.image.path endswithCIS "\\reg.exe" OR src.process.image.path endswithCIS "\\query.exe"))
