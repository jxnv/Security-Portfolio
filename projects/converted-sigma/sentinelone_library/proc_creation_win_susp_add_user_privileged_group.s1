// Title: User Added To Highly Privileged Group
// ID: 10fb649c-3600-4d37-b1e6-56ea90bb7e09
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-02-23
// Tags: attack.privilege-escalation, attack.persistence, attack.t1098
// Description: Detects addition of users to highly privileged groups via "Net" or "Add-LocalGroupMember".
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "Group Policy Creator Owners" OR src.process.cmdline containsCIS "Schema Admins")) AND (((src.process.cmdline containsCIS "localgroup " AND src.process.cmdline containsCIS " /add")) OR ((src.process.cmdline containsCIS "Add-LocalGroupMember " AND src.process.cmdline containsCIS " -Group "))))
