// Title: Security Software Discovery Via Powershell Script
// ID: 904e8e61-8edf-4350-b59c-b905fc8e810c
// Status: test
// Level: medium
// Author: frack113, Anish Bogati, Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-12-16
// Tags: attack.discovery, attack.t1518.001
// Description: Detects calls to "get-process" where the output is piped to a "where-object" filter to search for security solution processes.
// Adversaries may attempt to get a listing of security software, configurations, defensive tools, and sensors that are installed on a system or in a cloud environment. This may include things such as firewall rules and anti-virus
// Converted by: Sigma Universal SIEM/EDR CLI

(((ScriptBlockText containsCIS "get-process | \\?" OR ScriptBlockText containsCIS "get-process | where" OR ScriptBlockText containsCIS "gps | \\?" OR ScriptBlockText containsCIS "gps | where")) AND ((ScriptBlockText containsCIS "Company -like" OR ScriptBlockText containsCIS "Description -like" OR ScriptBlockText containsCIS "Name -like" OR ScriptBlockText containsCIS "Path -like" OR ScriptBlockText containsCIS "Product -like")) AND ((ScriptBlockText containsCIS "\\*avira\\*" OR ScriptBlockText containsCIS "\\*carbonblack\\*" OR ScriptBlockText containsCIS "\\*cylance\\*" OR ScriptBlockText containsCIS "\\*defender\\*" OR ScriptBlockText containsCIS "\\*kaspersky\\*" OR ScriptBlockText containsCIS "\\*malware\\*" OR ScriptBlockText containsCIS "\\*sentinel\\*" OR ScriptBlockText containsCIS "\\*symantec\\*" OR ScriptBlockText containsCIS "\\*virus\\*")))
