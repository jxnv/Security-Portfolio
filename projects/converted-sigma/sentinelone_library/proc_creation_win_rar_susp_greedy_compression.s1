// Title: Suspicious Greedy Compression Using Rar.EXE
// ID: afe52666-401e-4a02-b4ff-5d128990b8cb
// Status: test
// Level: high
// Author: X__Junior (Nextron Systems), Florian Roth (Nextron Systems)
// Date: 2022-12-15
// Tags: attack.execution, attack.t1059
// Description: Detects RAR usage that creates an archive from a suspicious folder, either a system folder or one of the folders often used by attackers for staging purposes
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.image.path endswithCIS "\\rar.exe") OR (Description = "Command line RAR")) OR ((src.process.cmdline containsCIS ".exe a " OR src.process.cmdline containsCIS " a -m"))) AND (((src.process.cmdline containsCIS " -hp" AND src.process.cmdline containsCIS " -r ")) AND ((src.process.cmdline containsCIS " ?:\\\\\\*." OR src.process.cmdline containsCIS " ?:\\\\\\\\\\*." OR src.process.cmdline containsCIS " ?:\\$Recycle.bin\\" OR src.process.cmdline containsCIS " ?:\\PerfLogs\\" OR src.process.cmdline containsCIS " ?:\\Temp" OR src.process.cmdline containsCIS " ?:\\Users\\Public\\" OR src.process.cmdline containsCIS " ?:\\Windows\\" OR src.process.cmdline containsCIS " %public%"))))
