// Title: Legitimate Application Writing Files In Uncommon Location
// ID: 1cf465a1-2609-4c15-9b66-c32dbe4bfd67
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-12-10
// Tags: attack.stealth, attack.t1218, attack.command-and-control, attack.t1105
// Description: Detects legitimate applications writing any type of file to uncommon or suspicious locations that are not typical for application data storage or execution.
// Adversaries may leverage legitimate applications (Living off the Land Binaries - LOLBins) to drop or download malicious files to uncommon locations on the system to evade detection by security solutions.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "\\eqnedt32.exe" OR src.process.image.path endswithCIS "\\wordpad.exe" OR src.process.image.path endswithCIS "\\wordview.exe" OR src.process.image.path endswithCIS "\\cmdl32.exe" OR src.process.image.path endswithCIS "\\certutil.exe" OR src.process.image.path endswithCIS "\\certoc.exe" OR src.process.image.path endswithCIS "\\CertReq.exe" OR src.process.image.path endswithCIS "\\bitsadmin.exe" OR src.process.image.path endswithCIS "\\Desktopimgdownldr.exe" OR src.process.image.path endswithCIS "\\esentutl.exe" OR src.process.image.path endswithCIS "\\expand.exe" OR src.process.image.path endswithCIS "\\extrac32.exe" OR src.process.image.path endswithCIS "\\replace.exe" OR src.process.image.path endswithCIS "\\mshta.exe" OR src.process.image.path endswithCIS "\\ftp.exe" OR src.process.image.path endswithCIS "\\Ldifde.exe" OR src.process.image.path endswithCIS "\\RdrCEF.exe" OR src.process.image.path endswithCIS "\\hh.exe" OR src.process.image.path endswithCIS "\\finger.exe" OR src.process.image.path endswithCIS "\\findstr.exe")) AND ((tgt.file.path containsCIS ":\\Perflogs" OR tgt.file.path containsCIS ":\\ProgramData\\" OR tgt.file.path containsCIS ":\\Temp\\" OR tgt.file.path containsCIS ":\\Users\\Public\\" OR tgt.file.path containsCIS ":\\Windows\\" OR tgt.file.path containsCIS "\\$Recycle.Bin\\" OR tgt.file.path containsCIS "\\AppData\\Local\\" OR tgt.file.path containsCIS "\\AppData\\Roaming\\" OR tgt.file.path containsCIS "\\Contacts\\" OR tgt.file.path containsCIS "\\Desktop\\" OR tgt.file.path containsCIS "\\Favorites\\" OR tgt.file.path containsCIS "\\Favourites\\" OR tgt.file.path containsCIS "\\inetpub\\wwwroot\\" OR tgt.file.path containsCIS "\\Music\\" OR tgt.file.path containsCIS "\\Pictures\\" OR tgt.file.path containsCIS "\\Start Menu\\Programs\\Startup\\" OR tgt.file.path containsCIS "\\Users\\Default\\" OR tgt.file.path containsCIS "\\Videos\\")))
