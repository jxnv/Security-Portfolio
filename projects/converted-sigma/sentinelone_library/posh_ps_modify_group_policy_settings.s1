// Title: Modify Group Policy Settings - ScriptBlockLogging
// ID: b7216a7d-687e-4c8d-82b1-3080b2ad961f
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-08-19
// Tags: attack.privilege-escalation, attack.defense-impairment, attack.t1484.001
// Description: Detect malicious GPO modifications can be used to implement many other malicious behaviors.
// Converted by: Sigma Universal SIEM/EDR CLI

(((ScriptBlockText containsCIS "GroupPolicyRefreshTimeDC" OR ScriptBlockText containsCIS "GroupPolicyRefreshTimeOffsetDC" OR ScriptBlockText containsCIS "GroupPolicyRefreshTime" OR ScriptBlockText containsCIS "GroupPolicyRefreshTimeOffset" OR ScriptBlockText containsCIS "EnableSmartScreen" OR ScriptBlockText containsCIS "ShellSmartScreenLevel")) AND (ScriptBlockText containsCIS "\\SOFTWARE\\Policies\\Microsoft\\Windows\\System"))
