// Title: Important Scheduled Task Deleted or Disabled
// ID: 9e3cb244-bdb8-4632-8c90-6079c8f4f16d
// Status: test
// Level: high
// Author: frack113
// Date: 2023-01-13
// Tags: attack.impact, attack.t1489
// Description: Detects when adversaries try to stop system services or processes by deleting or disabling their respective scheduled tasks in order to conduct data destructive activities
// Converted by: Sigma Universal SIEM/EDR CLI

(((EventID = "141" OR EventID = "142") AND (TaskName containsCIS "\\Windows\\SystemRestore\\SR" OR TaskName containsCIS "\\Windows\\Windows Defender\\" OR TaskName containsCIS "\\Windows\\BitLocker" OR TaskName containsCIS "\\Windows\\WindowsBackup\\" OR TaskName containsCIS "\\Windows\\WindowsUpdate\\" OR TaskName containsCIS "\\Windows\\UpdateOrchestrator\\" OR TaskName containsCIS "\\Windows\\ExploitGuard")) AND NOT (((UserName containsCIS "AUTHORI" OR UserName containsCIS "AUTORI"))))
