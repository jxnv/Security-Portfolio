// Title: Suspicious Scheduled Task Creation
// ID: 3a734d25-df5c-4b99-8034-af1ddb5883a4
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-05
// Tags: attack.execution, attack.privilege-escalation, attack.persistence, attack.t1053.005
// Description: Detects suspicious scheduled task creation events. Based on attributes such as paths, commands line flags, etc.
// Converted by: Sigma Universal SIEM/EDR CLI

(((TaskContent containsCIS "regsvr32" OR TaskContent containsCIS "rundll32" OR TaskContent containsCIS "cmd.exe</Command>" OR TaskContent containsCIS "cmd</Command>" OR TaskContent containsCIS "<Arguments>/c " OR TaskContent containsCIS "<Arguments>/k " OR TaskContent containsCIS "<Arguments>/r " OR TaskContent containsCIS "powershell" OR TaskContent containsCIS "pwsh" OR TaskContent containsCIS "mshta" OR TaskContent containsCIS "wscript" OR TaskContent containsCIS "cscript" OR TaskContent containsCIS "certutil" OR TaskContent containsCIS "bitsadmin" OR TaskContent containsCIS "bash.exe" OR TaskContent containsCIS "bash " OR TaskContent containsCIS "scrcons" OR TaskContent containsCIS "wmic " OR TaskContent containsCIS "wmic.exe" OR TaskContent containsCIS "forfiles" OR TaskContent containsCIS "scriptrunner" OR TaskContent containsCIS "hh.exe")) AND (EventID = "4698") AND ((TaskContent containsCIS "\\AppData\\Local\\Temp\\" OR TaskContent containsCIS "\\AppData\\Roaming\\" OR TaskContent containsCIS "\\Users\\Public\\" OR TaskContent containsCIS "\\WINDOWS\\Temp\\" OR TaskContent containsCIS "C:\\Temp\\" OR TaskContent containsCIS "\\Desktop\\" OR TaskContent containsCIS "\\Downloads\\" OR TaskContent containsCIS "\\Temporary Internet" OR TaskContent containsCIS "C:\\ProgramData\\" OR TaskContent containsCIS "C:\\Perflogs\\")))
