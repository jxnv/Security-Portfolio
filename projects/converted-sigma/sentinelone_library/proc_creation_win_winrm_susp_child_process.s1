// Title: Suspicious Processes Spawned by WinRM
// ID: 5cc2cda8-f261-4d88-a2de-e9e193c86716
// Status: test
// Level: high
// Author: Andreas Hunkeler (@Karneades), Markus Neis
// Date: 2021-05-20
// Tags: attack.t1190, attack.initial-access, attack.persistence, attack.privilege-escalation
// Description: Detects suspicious processes including shells spawnd from WinRM host process
// Converted by: Sigma Universal SIEM/EDR CLI

(src.process.parent.image.path endswithCIS "\\wsmprovhost.exe" AND (src.process.image.path endswithCIS "\\cmd.exe" OR src.process.image.path endswithCIS "\\sh.exe" OR src.process.image.path endswithCIS "\\bash.exe" OR src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe" OR src.process.image.path endswithCIS "\\wsl.exe" OR src.process.image.path endswithCIS "\\schtasks.exe" OR src.process.image.path endswithCIS "\\certutil.exe" OR src.process.image.path endswithCIS "\\whoami.exe" OR src.process.image.path endswithCIS "\\bitsadmin.exe"))
