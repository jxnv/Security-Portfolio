// Title: Suspicious DNS Query for IP Lookup Service APIs
// ID: ec82e2a5-81ea-4211-a1f8-37a0286df2c2
// Status: test
// Level: medium
// Author: Brandon George (blog post), Thomas Patzke
// Date: 2021-07-08
// Tags: attack.reconnaissance, attack.t1590
// Description: Detects DNS queries for IP lookup services such as "api.ipify.org" originating from a non browser process.
// Converted by: Sigma Universal SIEM/EDR CLI

((((QueryName = "www.ip.cn" OR QueryName = "l2.io")) OR ((QueryName containsCIS "api.2ip.ua" OR QueryName containsCIS "api.bigdatacloud.net" OR QueryName containsCIS "api.ipify.org" OR QueryName containsCIS "bot.whatismyipaddress.com" OR QueryName containsCIS "canireachthe.net" OR QueryName containsCIS "checkip.amazonaws.com" OR QueryName containsCIS "checkip.dyndns.org" OR QueryName containsCIS "curlmyip.com" OR QueryName containsCIS "db-ip.com" OR QueryName containsCIS "edns.ip-api.com" OR QueryName containsCIS "eth0.me" OR QueryName containsCIS "freegeoip.app" OR QueryName containsCIS "geoipy.com" OR QueryName containsCIS "getip.pro" OR QueryName containsCIS "icanhazip.com" OR QueryName containsCIS "ident.me" OR QueryName containsCIS "ifconfig.io" OR QueryName containsCIS "ifconfig.me" OR QueryName containsCIS "ip-api.com" OR QueryName containsCIS "ip.360.cn" OR QueryName containsCIS "ip.anysrc.net" OR QueryName containsCIS "ip.taobao.com" OR QueryName containsCIS "ip.tyk.nu" OR QueryName containsCIS "ipaddressworld.com" OR QueryName containsCIS "ipapi.co" OR QueryName containsCIS "ipconfig.io" OR QueryName containsCIS "ipecho.net" OR QueryName containsCIS "ipinfo.io" OR QueryName containsCIS "ipip.net" OR QueryName containsCIS "ipof.in" OR QueryName containsCIS "ipv4.icanhazip.com" OR QueryName containsCIS "ipv4bot.whatismyipaddress.com" OR QueryName containsCIS "ipv6-test.com" OR QueryName containsCIS "ipwho.is" OR QueryName containsCIS "jsonip.com" OR QueryName containsCIS "myexternalip.com" OR QueryName containsCIS "seeip.org" OR QueryName containsCIS "wgetip.com" OR QueryName containsCIS "whatismyip.akamai.com" OR QueryName containsCIS "whois.pconline.com.cn" OR QueryName containsCIS "wtfismyip.com"))) AND NOT (((src.process.image.path endswithCIS "\\brave.exe") OR ((src.process.image.path = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR src.process.image.path = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") OR (src.process.image.path endswithCIS "\\WindowsApps\\MicrosoftEdge.exe") OR ((src.process.image.path = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR src.process.image.path = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" OR src.process.image.path startswithCIS "C:\\Program Files\\Microsoft\\EdgeCore\\") AND (src.process.image.path endswithCIS "\\msedge.exe" OR src.process.image.path endswithCIS "\\msedgewebview2.exe")) OR ((src.process.image.path = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR src.process.image.path = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR ((src.process.image.path = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR src.process.image.path = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (src.process.image.path endswithCIS "\\maxthon.exe") OR (src.process.image.path endswithCIS "\\opera.exe") OR (src.process.image.path endswithCIS "\\safari.exe") OR (src.process.image.path endswithCIS "\\seamonkey.exe") OR (src.process.image.path endswithCIS "\\vivaldi.exe") OR (src.process.image.path endswithCIS "\\whale.exe"))))
