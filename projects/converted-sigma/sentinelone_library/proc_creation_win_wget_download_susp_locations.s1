// Title: Suspicious File Download From IP Via Wget.EXE - Paths
// ID: 40aa399c-7b02-4715-8e5f-73572b493f33
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-02-23
// Tags: attack.execution
// Description: Detects potentially suspicious file downloads directly from IP addresses and stored in suspicious locations using Wget.exe
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline RegEx "\s-O\s") OR (src.process.cmdline containsCIS "--output-document")) AND (src.process.cmdline containsCIS "http") AND ((src.process.image.path endswithCIS "\\wget.exe") OR (OriginalFileName = "wget.exe")) AND (src.process.cmdline RegEx "://[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}") AND (((src.process.cmdline containsCIS ":\\PerfLogs\\" OR src.process.cmdline containsCIS ":\\Temp\\" OR src.process.cmdline containsCIS ":\\Users\\Public\\" OR src.process.cmdline containsCIS ":\\Windows\\Help\\" OR src.process.cmdline containsCIS ":\\Windows\\Temp\\" OR src.process.cmdline containsCIS "\\Temporary Internet")) OR ((src.process.cmdline containsCIS ":\\Users\\" AND src.process.cmdline containsCIS "\\Favorites\\")) OR ((src.process.cmdline containsCIS ":\\Users\\" AND src.process.cmdline containsCIS "\\Favourites\\")) OR ((src.process.cmdline containsCIS ":\\Users\\" AND src.process.cmdline containsCIS "\\Contacts\\")) OR ((src.process.cmdline containsCIS ":\\Users\\" AND src.process.cmdline containsCIS "\\Pictures\\"))))
