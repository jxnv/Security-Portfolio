// Title: Suspicious Eventlog Clearing or Configuration Change Activity
// ID: cc36992a-4671-4f21-a91d-6c2b72a2edf5
// Status: stable
// Level: high
// Author: Ecco, Daniil Yugoslavskiy, oscd.community, D3F7A5105, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2019-09-26
// Tags: attack.defense-impairment, attack.t1685.005, attack.t1685.001, car.2016-04-002
// Description: Detects the clearing or configuration tampering of EventLog using utilities such as "wevtutil", "powershell" and "wmic".
// This technique were seen used by threat actors and ransomware strains in order to evade defenses.
// Converted by: Sigma Universal SIEM/EDR CLI

(((((src.process.cmdline containsCIS "clear-log " OR src.process.cmdline containsCIS " cl " OR src.process.cmdline containsCIS "set-log " OR src.process.cmdline containsCIS " sl " OR src.process.cmdline containsCIS "lfn:")) AND ((src.process.image.path endswithCIS "\\wevtutil.exe") OR (OriginalFileName = "wevtutil.exe"))) OR ((((src.process.cmdline containsCIS "Clear-EventLog " OR src.process.cmdline containsCIS "Remove-EventLog " OR src.process.cmdline containsCIS "Limit-EventLog " OR src.process.cmdline containsCIS "Clear-WinEvent ")) OR ((src.process.cmdline containsCIS "Eventing.Reader.EventLogSession" AND src.process.cmdline containsCIS "ClearLog")) OR ((src.process.cmdline containsCIS "Diagnostics.EventLog" AND src.process.cmdline containsCIS "Clear"))) AND ((src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\powershell_ise.exe" OR src.process.image.path endswithCIS "\\pwsh.exe"))) OR ((src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\powershell_ise.exe" OR src.process.image.path endswithCIS "\\pwsh.exe" OR src.process.image.path endswithCIS "\\wmic.exe") AND src.process.cmdline containsCIS "ClearEventLog")) AND NOT (((src.process.parent.image.path = "C:\\Windows\\SysWOW64\\msiexec.exe" OR src.process.parent.image.path = "C:\\Windows\\System32\\msiexec.exe") AND src.process.cmdline containsCIS " sl ")))
