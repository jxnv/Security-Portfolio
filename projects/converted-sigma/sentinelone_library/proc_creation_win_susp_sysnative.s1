// Title: Process Creation Using Sysnative Folder
// ID: 3c1b5fb0-c72f-45ba-abd1-4d4c353144ab
// Status: test
// Level: medium
// Author: Max Altgelt (Nextron Systems)
// Date: 2022-08-23
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects process creation events that use the Sysnative folder (common for CobaltStrike spawns)
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS ":\\Windows\\Sysnative\\") OR (src.process.image.path containsCIS ":\\Windows\\Sysnative\\")) AND NOT (((src.process.image.path containsCIS "C:\\Windows\\Microsoft.NET\\Framework64\\v" OR src.process.image.path containsCIS "C:\\Windows\\Microsoft.NET\\Framework\\v" OR src.process.image.path containsCIS "C:\\Windows\\Microsoft.NET\\FrameworkArm\\v" OR src.process.image.path containsCIS "C:\\Windows\\Microsoft.NET\\FrameworkArm64\\v") AND src.process.image.path endswithCIS "\\ngen.exe" AND src.process.cmdline containsCIS "install")) AND NOT (((src.process.cmdline containsCIS "\"C:\\Windows\\sysnative\\cmd.exe\"" AND src.process.cmdline containsCIS "\\xampp\\" AND src.process.cmdline containsCIS "\\catalina_start.bat"))))
