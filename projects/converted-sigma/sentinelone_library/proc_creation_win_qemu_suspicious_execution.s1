// Title: Potentially Suspicious Usage Of Qemu
// ID: 5fc297ae-25b6-488a-8f25-cc12ac29b744
// Status: test
// Level: medium
// Author: Muhammad Faisal (@faisalusuf), Hunter Juhan (@threatHNTR)
// Date: 2024-06-03
// Tags: attack.command-and-control, attack.t1090, attack.t1572
// Description: Detects potentially suspicious execution of the Qemu utility in a Windows environment.
// Threat actors have leveraged this utility and this technique for achieving network access as reported by Kaspersky.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "-m 1M" OR src.process.cmdline containsCIS "-m 2M" OR src.process.cmdline containsCIS "-m 3M") AND (src.process.cmdline containsCIS "restrict=off" AND src.process.cmdline containsCIS "-netdev " AND src.process.cmdline containsCIS "connect=" AND src.process.cmdline containsCIS "-nographic")) AND NOT (((src.process.cmdline containsCIS " -cdrom " OR src.process.cmdline containsCIS " type=virt " OR src.process.cmdline containsCIS " -blockdev "))))
