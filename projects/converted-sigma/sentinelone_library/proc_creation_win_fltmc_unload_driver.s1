// Description: Detect filter driver unloading activity via fltmc.exe
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "unload") AND ((src.process.image.path endswithCIS "\\fltMC.exe") OR (OriginalFileName = "fltMC.exe"))) AND NOT ((((src.process.parent.image.path containsCIS "\\AppData\\Local\\Temp\\" OR src.process.parent.image.path containsCIS ":\\Windows\\Temp\\") AND src.process.parent.image.path endswithCIS "\\endpoint-protection-installer-x64.tmp" AND (src.process.cmdline endswithCIS "unload rtp_filesystem_filter" OR src.process.cmdline endswithCIS "unload rtp_filter")) OR (src.process.parent.image.path = "C:\\Program Files (x86)\\ManageEngine\\uems_agent\\bin\\dcfaservice64.exe" AND src.process.cmdline endswithCIS "unload DFMFilter"))))
