// Title: Potentially Suspicious Child Process Of Regsvr32
// ID: 6f0947a4-1c5e-4e0d-8ac7-53159b8f23ca
// Status: test
// Level: high
// Author: elhoim, Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-05-05
// Tags: attack.stealth, attack.t1218.010
// Description: Detects potentially suspicious child processes of "regsvr32.exe".
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.parent.image.path endswithCIS "\\regsvr32.exe" AND (src.process.image.path endswithCIS "\\calc.exe" OR src.process.image.path endswithCIS "\\cscript.exe" OR src.process.image.path endswithCIS "\\explorer.exe" OR src.process.image.path endswithCIS "\\mshta.exe" OR src.process.image.path endswithCIS "\\net.exe" OR src.process.image.path endswithCIS "\\net1.exe" OR src.process.image.path endswithCIS "\\nltest.exe" OR src.process.image.path endswithCIS "\\notepad.exe" OR src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe" OR src.process.image.path endswithCIS "\\reg.exe" OR src.process.image.path endswithCIS "\\schtasks.exe" OR src.process.image.path endswithCIS "\\werfault.exe" OR src.process.image.path endswithCIS "\\wscript.exe")) AND NOT ((src.process.image.path endswithCIS "\\werfault.exe" AND src.process.cmdline containsCIS " -u -p ")))
