// Title: Potentially Suspicious ASP.NET Compilation Via AspNetCompiler
// ID: 9f50fe98-fe5c-4a2d-86c7-fad7f63ed622
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-08-14
// Tags: attack.execution, attack.stealth, attack.t1127
// Description: Detects execution of "aspnet_compiler.exe" with potentially suspicious paths for compilation.
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path containsCIS ":\\Windows\\Microsoft.NET\\Framework\\" OR src.process.image.path containsCIS ":\\Windows\\Microsoft.NET\\Framework64\\" OR src.process.image.path containsCIS ":\\Windows\\Microsoft.NET\\FrameworkArm\\" OR src.process.image.path containsCIS ":\\Windows\\Microsoft.NET\\FrameworkArm64\\") AND src.process.image.path endswithCIS "\\aspnet_compiler.exe" AND (src.process.cmdline containsCIS "\\Users\\Public\\" OR src.process.cmdline containsCIS "\\AppData\\Local\\Temp\\" OR src.process.cmdline containsCIS "\\AppData\\Local\\Roaming\\" OR src.process.cmdline containsCIS ":\\Temp\\" OR src.process.cmdline containsCIS ":\\Windows\\Temp\\" OR src.process.cmdline containsCIS ":\\Windows\\System32\\Tasks\\" OR src.process.cmdline containsCIS ":\\Windows\\Tasks\\"))
