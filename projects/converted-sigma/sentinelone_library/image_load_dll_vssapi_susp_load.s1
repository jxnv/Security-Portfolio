((ImageLoaded endswithCIS "\\vssapi.dll") AND NOT (((src.process.image.path is null) OR ((src.process.image.path startswithCIS "C:\\Program Files\\" OR src.process.image.path startswithCIS "C:\\Program Files (x86)\\")) OR (((src.process.image.path = "C:\\Windows\\explorer.exe" OR src.process.image.path = "C:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe" OR src.process.image.path = "C:\\Windows\\servicing\\TrustedInstaller.exe")) OR ((src.process.image.path startswithCIS "C:\\Windows\\System32\\" OR src.process.image.path startswithCIS "C:\\Windows\\SysWOW64\\" OR src.process.image.path startswithCIS "C:\\Windows\\Temp\\{" OR src.process.image.path startswithCIS "C:\\Windows\\WinSxS\\" OR src.process.image.path startswithCIS "C:\\$WinREAgent\\Scratch\\"))))) AND NOT ((((src.process.image.path containsCIS "\\temp\\is-" AND src.process.image.path containsCIS "\\avira_system_speedup.tmp")) OR (src.process.image.path startswithCIS "C:\\ProgramData\\Package Cache\\"))))
