// Description: Detects changes to the Windows EventLog channel permission values. It focuses on changes to the Security Descriptor Definition Language (SDDL) string, as modifications to these values can restrict access to specific users or groups, potentially aiding in defense evasion by controlling who can view or modify a event log channel. Upon execution, the user shouldn't be able to access the event log channel via the event viewer or via utilities such as "Get-EventLog" or "wevtutil".
// Converted by: Sigma Universal SIEM/EDR CLI

(((TargetObject containsCIS "\\SYSTEM\\CurrentControlSet\\Services\\EventLog\\" AND TargetObject endswithCIS "\\CustomSD") OR ((TargetObject containsCIS "\\Policies\\Microsoft\\Windows\\EventLog\\" OR TargetObject containsCIS "\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels") AND TargetObject endswithCIS "\\ChannelAccess")) AND ((Details containsCIS "D:(D;") OR ((Details containsCIS "D:(" AND Details containsCIS ")(D;"))) AND NOT (((src.process.image.path startswithCIS "C:\\Windows\\WinSxS\\" AND src.process.image.path endswithCIS "\\TiWorker.exe") OR (src.process.image.path = "C:\\Windows\\servicing\\TrustedInstaller.exe"))) AND NOT (((src.process.image.path = "") OR (src.process.image.path is null))))
