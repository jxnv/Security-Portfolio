// Title: Use NTFS Short Name in Image
// ID: 3ef5605c-9eb9-47b0-9a71-b727e6aa5c3b
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-06
// Tags: attack.stealth, attack.t1564.004
// Description: Detect use of the Windows 8.3 short name. Which could be used as a method to avoid Image based detection
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path containsCIS "~1.bat" OR src.process.image.path containsCIS "~1.dll" OR src.process.image.path containsCIS "~1.exe" OR src.process.image.path containsCIS "~1.hta" OR src.process.image.path containsCIS "~1.js" OR src.process.image.path containsCIS "~1.msi" OR src.process.image.path containsCIS "~1.ps1" OR src.process.image.path containsCIS "~1.tmp" OR src.process.image.path containsCIS "~1.vbe" OR src.process.image.path containsCIS "~1.vbs" OR src.process.image.path containsCIS "~2.bat" OR src.process.image.path containsCIS "~2.dll" OR src.process.image.path containsCIS "~2.exe" OR src.process.image.path containsCIS "~2.hta" OR src.process.image.path containsCIS "~2.js" OR src.process.image.path containsCIS "~2.msi" OR src.process.image.path containsCIS "~2.ps1" OR src.process.image.path containsCIS "~2.tmp" OR src.process.image.path containsCIS "~2.vbe" OR src.process.image.path containsCIS "~2.vbs")) AND NOT ((src.process.parent.image.path = "C:\\Windows\\explorer.exe")) AND NOT (((src.process.parent.image.path endswithCIS "\\thor\\thor64.exe") OR (src.process.image.path endswithCIS "\\VCREDI~1.EXE") OR (src.process.parent.image.path endswithCIS "\\WebEx\\WebexHost.exe") OR (src.process.image.path = "C:\\PROGRA~1\\WinZip\\WZPREL~1.EXE"))))
