// Title: File Download with Headless Browser
// ID: 0e8cfe08-02c9-4815-a2f8-0d157b7ed33e
// Status: test
// Level: high
// Author: Sreeman, Florian Roth (Nextron Systems)
// Date: 2022-01-04
// Tags: attack.command-and-control, attack.stealth, attack.t1105, attack.t1564.003
// Description: Detects execution of chromium based browser in headless mode using the "dump-dom" command line to download files
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "\\brave.exe" OR src.process.image.path endswithCIS "\\chrome.exe" OR src.process.image.path endswithCIS "\\msedge.exe" OR src.process.image.path endswithCIS "\\opera.exe" OR src.process.image.path endswithCIS "\\vivaldi.exe") AND (src.process.cmdline containsCIS "--headless" AND src.process.cmdline containsCIS "dump-dom" AND src.process.cmdline containsCIS "http")) AND NOT ((((src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\" OR src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" OR src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\" OR src.process.image.path startswithCIS "C:\\Program Files\\Microsoft\\Edge\\Application\\" OR src.process.image.path startswithCIS "C:\\Program Files\\Microsoft\\EdgeCore\\" OR src.process.image.path startswithCIS "C:\\Program Files\\Microsoft\\EdgeWebView\\" OR src.process.image.path startswithCIS "C:\\Program Files\\WindowsApps\\Microsoft.MicrosoftEdge") AND (src.process.image.path endswithCIS "\\msedge.exe" OR src.process.image.path endswithCIS "\\msedgewebview2.exe" OR src.process.image.path endswithCIS "\\MicrosoftEdge.exe") AND src.process.cmdline containsCIS "--headless --disable-gpu --disable-extensions --disable-plugins --mute-audio --no-first-run --incognito --aggressive-cache-discard --dump-dom") OR ((src.process.image.path containsCIS "\\AppData\\Local\\Microsoft\\WindowsApps\\" OR src.process.image.path containsCIS "\\Windows\\SystemApps\\Microsoft.MicrosoftEdge") AND (src.process.image.path endswithCIS "\\msedge.exe" OR src.process.image.path endswithCIS "\\MicrosoftEdge.exe") AND src.process.cmdline containsCIS "--headless --disable-gpu --disable-extensions --disable-plugins --mute-audio --no-first-run --incognito --aggressive-cache-discard --dump-dom"))))
