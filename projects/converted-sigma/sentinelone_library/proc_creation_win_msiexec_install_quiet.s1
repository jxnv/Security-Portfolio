// Tags: attack.stealth, attack.t1218.007
// Description: Adversaries may abuse msiexec.exe to proxy execution of malicious payloads.
// Msiexec.exe is the command-line utility for the Windows Installer and is thus commonly associated with executing installation packages (.msi)
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.cmdline containsCIS "-i" OR src.process.cmdline containsCIS "/i" OR src.process.cmdline containsCIS "-package" OR src.process.cmdline containsCIS "/package" OR src.process.cmdline containsCIS "-a" OR src.process.cmdline containsCIS "/a" OR src.process.cmdline containsCIS "-j" OR src.process.cmdline containsCIS "/j")) AND ((src.process.image.path endswithCIS "\\msiexec.exe") OR (OriginalFileName = "msiexec.exe")) AND ((src.process.cmdline containsCIS "-q" OR src.process.cmdline containsCIS "/q"))) AND NOT (((src.process.parent.image.path = "C:\\Windows\\CCM\\Ccm32BitLauncher.exe" AND (IntegrityLevel = "System" OR IntegrityLevel = "S-1-16-16384")) OR (src.process.parent.image.path startswithCIS "C:\\Windows\\Temp\\"))) AND NOT (((src.process.parent.image.path startswithCIS "C:\\Users\\" AND src.process.parent.image.path containsCIS "\\AppData\\Local\\Temp\\") OR (src.process.parent.image.path endswithCIS "C:\\Windows\\System32\\wsl.exe" AND src.process.image.path endswithCIS "C:\\Windows\\System32\\msiexec.exe"))))
