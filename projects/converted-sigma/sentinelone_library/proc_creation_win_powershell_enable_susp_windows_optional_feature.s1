// Title: Potential Suspicious Windows Feature Enabled - ProcCreation
// ID: c740d4cf-a1e9-41de-bb16-8a46a4f57918
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-29
// Tags: attack.stealth
// Description: Detects usage of the built-in PowerShell cmdlet "Enable-WindowsOptionalFeature" used as a Deployment Image Servicing and Management tool.
// Similar to DISM.exe, this cmdlet is used to enumerate, install, uninstall, configure, and update features and packages in Windows images
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "Enable-WindowsOptionalFeature" AND src.process.cmdline containsCIS "-Online" AND src.process.cmdline containsCIS "-FeatureName")) AND ((src.process.cmdline containsCIS "TelnetServer" OR src.process.cmdline containsCIS "Internet-Explorer-Optional-amd64" OR src.process.cmdline containsCIS "TFTP" OR src.process.cmdline containsCIS "SMB1Protocol" OR src.process.cmdline containsCIS "Client-ProjFS" OR src.process.cmdline containsCIS "Microsoft-Windows-Subsystem-Linux")))
