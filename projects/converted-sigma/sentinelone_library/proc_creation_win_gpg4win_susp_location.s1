// Title: File Encryption/Decryption Via Gpg4win From Suspicious Locations
// ID: e1e0b7d7-e10b-4ee4-ac49-a4bda05d320d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2022-11-30
// Tags: attack.execution
// Description: Detects usage of Gpg4win to encrypt/decrypt files located in potentially suspicious locations.
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.cmdline containsCIS "-passphrase") AND (((src.process.image.path endswithCIS "\\gpg.exe" OR src.process.image.path endswithCIS "\\gpg2.exe")) OR (Product = "GNU Privacy Guard (GnuPG)") OR (Description = "GnuPG’s OpenPGP tool")) AND ((src.process.cmdline containsCIS ":\\PerfLogs\\" OR src.process.cmdline containsCIS ":\\Temp\\" OR src.process.cmdline containsCIS ":\\Users\\Public\\" OR src.process.cmdline containsCIS ":\\Windows\\Temp\\" OR src.process.cmdline containsCIS "\\AppData\\Local\\Temp\\" OR src.process.cmdline containsCIS "\\AppData\\Roaming\\")))
