// Title: Suspicious Access to Sensitive File Extensions
// ID: 91c945bc-2ad1-4799-a591-4d00198a1215
// Status: test
// Level: medium
// Author: Samir Bousseaden
// Date: 2019-04-03
// Tags: attack.collection, attack.t1039
// Description: Detects known sensitive file extensions accessed on a network share
// Converted by: Sigma Universal SIEM/EDR CLI

(EventID = "5145" AND (RelativeTargetName endswithCIS ".bak" OR RelativeTargetName endswithCIS ".dmp" OR RelativeTargetName endswithCIS ".edb" OR RelativeTargetName endswithCIS ".kirbi" OR RelativeTargetName endswithCIS ".msg" OR RelativeTargetName endswithCIS ".nsf" OR RelativeTargetName endswithCIS ".nst" OR RelativeTargetName endswithCIS ".oab" OR RelativeTargetName endswithCIS ".ost" OR RelativeTargetName endswithCIS ".pst" OR RelativeTargetName endswithCIS ".rdp"))
