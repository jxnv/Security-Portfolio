// Title: Potential Credential Dumping Activity Via LSASS
// ID: 5ef9853e-4d0e-4a70-846f-a9ca37d876da
// Status: test
// Level: medium
// Author: Samir Bousseaden, Michael Haag
// Date: 2019-04-03
// Tags: attack.credential-access, attack.t1003.001, attack.s0002
// Description: Detects process access requests to the LSASS process with specific call trace calls and access masks.
// This behaviour is expressed by many credential dumping tools such as Mimikatz, NanoDump, Invoke-Mimikatz, Procdump and even the Taskmgr dumping feature.
// Converted by: Sigma Universal SIEM/EDR CLI

((TargetImage endswithCIS "\\lsass.exe" AND (GrantedAccess containsCIS "0x1038" OR GrantedAccess containsCIS "0x1438" OR GrantedAccess containsCIS "0x143a" OR GrantedAccess containsCIS "0x1fffff") AND (CallTrace containsCIS "dbgcore.dll" OR CallTrace containsCIS "dbghelp.dll" OR CallTrace containsCIS "kernel32.dll" OR CallTrace containsCIS "kernelbase.dll" OR CallTrace containsCIS "ntdll.dll")) AND NOT (((SourceUser containsCIS "AUTHORI" OR SourceUser containsCIS "AUTORI"))) AND NOT ((((SourceImage endswithCIS ":\\Windows\\Sysmon64.exe" OR SourceImage endswithCIS ":\\Windows\\Sysmon64a.exe")) OR ((CallTrace containsCIS ":\\Windows\\Temp\\asgard2-agent\\" AND CallTrace containsCIS "\\thor\\thor64.exe+" AND CallTrace containsCIS "|UNKNOWN(") AND GrantedAccess = "0x103800"))))
