((((src.process.cmdline containsCIS "shadow" AND src.process.cmdline containsCIS "delete")) AND (((src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe" OR src.process.image.path endswithCIS "\\wmic.exe" OR src.process.image.path endswithCIS "\\vssadmin.exe" OR src.process.image.path endswithCIS "\\diskshadow.exe")) OR ((OriginalFileName = "PowerShell.EXE" OR OriginalFileName = "pwsh.dll" OR OriginalFileName = "wmic.exe" OR OriginalFileName = "VSSADMIN.EXE" OR OriginalFileName = "diskshadow.exe")))) OR (((src.process.cmdline containsCIS "delete" AND src.process.cmdline containsCIS "catalog" AND src.process.cmdline containsCIS "quiet")) AND ((src.process.image.path endswithCIS "\\wbadmin.exe") OR (OriginalFileName = "WBADMIN.EXE"))) OR (((src.process.cmdline containsCIS "resize" AND src.process.cmdline containsCIS "shadowstorage") AND (src.process.cmdline containsCIS "unbounded" OR src.process.cmdline containsCIS "/MaxSize=")) AND ((src.process.image.path endswithCIS "\\vssadmin.exe") OR (OriginalFileName = "VSSADMIN.EXE"))))
