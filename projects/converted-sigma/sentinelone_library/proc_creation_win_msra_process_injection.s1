// Title: Potential Process Injection Via Msra.EXE
// ID: 744a188b-0415-4792-896f-11ddb0588dbc
// Status: test
// Level: high
// Author: Alexander McDonald
// Date: 2022-06-24
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects potential process injection via Microsoft Remote Asssistance (Msra.exe) by looking at suspicious child processes spawned from the aforementioned process. It has been a target used by many threat actors and used for discovery and persistence tactics
// Converted by: Sigma Universal SIEM/EDR CLI

(src.process.parent.image.path endswithCIS "\\msra.exe" AND src.process.parent.cmdline endswithCIS "msra.exe" AND (src.process.image.path endswithCIS "\\arp.exe" OR src.process.image.path endswithCIS "\\cmd.exe" OR src.process.image.path endswithCIS "\\net.exe" OR src.process.image.path endswithCIS "\\netstat.exe" OR src.process.image.path endswithCIS "\\nslookup.exe" OR src.process.image.path endswithCIS "\\route.exe" OR src.process.image.path endswithCIS "\\schtasks.exe" OR src.process.image.path endswithCIS "\\whoami.exe"))
