// Title: Potential Goopdate.DLL Sideloading
// ID: b6188d2f-b3c4-4d2c-a17d-9706e0851af0
// Status: test
// Level: medium
// Author: X__Junior (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-15
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of "goopdate.dll", a DLL used by googleupdate.exe
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageLoaded endswithCIS "\\goopdate.dll") AND NOT (((ImageLoaded startswithCIS "C:\\Program Files (x86)\\" OR ImageLoaded startswithCIS "C:\\Program Files\\"))) AND NOT ((((src.process.image.path containsCIS "\\AppData\\Local\\Temp\\GUM" AND src.process.image.path containsCIS ".tmp\\Dropbox") AND (ImageLoaded containsCIS "\\AppData\\Local\\Temp\\GUM" AND ImageLoaded containsCIS ".tmp\\goopdate.dll")) OR ((src.process.image.path containsCIS "\\AppData\\Local\\Temp\\GUM" OR src.process.image.path containsCIS ":\\Windows\\SystemTemp\\GUM") AND src.process.image.path endswithCIS ".tmp\\GoogleUpdate.exe" AND (ImageLoaded containsCIS "\\AppData\\Local\\Temp\\GUM" OR ImageLoaded containsCIS ":\\Windows\\SystemTemp\\GUM")))))
