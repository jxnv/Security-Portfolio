// Title: Dumping of Sensitive Hives Via Reg.EXE
// ID: fd877b94-9bb5-4191-bb25-d79cbd93c167
// Status: test
// Level: high
// Author: Teymur Kheirkhabarov, Endgame, JHasenbusch, Daniil Yugoslavskiy, oscd.community, frack113
// Date: 2019-10-22
// Tags: attack.credential-access, attack.t1003.002, attack.t1003.004, attack.t1003.005, car.2013-07-001
// Description: Detects the usage of "reg.exe" in order to dump sensitive registry hives. This includes SAM, SYSTEM and SECURITY hives.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS " save " OR src.process.cmdline containsCIS " export " OR src.process.cmdline containsCIS " ˢave " OR src.process.cmdline containsCIS " eˣport ")) AND ((src.process.cmdline containsCIS "\\system" OR src.process.cmdline containsCIS "\\sam" OR src.process.cmdline containsCIS "\\security" OR src.process.cmdline containsCIS "\\ˢystem" OR src.process.cmdline containsCIS "\\syˢtem" OR src.process.cmdline containsCIS "\\ˢyˢtem" OR src.process.cmdline containsCIS "\\ˢam" OR src.process.cmdline containsCIS "\\ˢecurity")) AND ((src.process.cmdline containsCIS "hklm" OR src.process.cmdline containsCIS "hk˪m" OR src.process.cmdline containsCIS "hkey_local_machine" OR src.process.cmdline containsCIS "hkey_˪ocal_machine" OR src.process.cmdline containsCIS "hkey_loca˪_machine" OR src.process.cmdline containsCIS "hkey_˪oca˪_machine")) AND ((src.process.image.path endswithCIS "\\reg.exe") OR (OriginalFileName = "reg.exe")))
