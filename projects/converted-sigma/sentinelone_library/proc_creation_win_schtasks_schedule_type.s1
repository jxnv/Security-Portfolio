// Title: Suspicious Schtasks Schedule Types
// ID: 24c8392b-aa3c-46b7-a545-43f71657fe98
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects scheduled task creations or modification on a suspicious schedule type
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.image.path endswithCIS "\\schtasks.exe") OR (OriginalFileName = "schtasks.exe")) AND ((src.process.cmdline containsCIS " ONLOGON " OR src.process.cmdline containsCIS " ONSTART " OR src.process.cmdline containsCIS " ONCE " OR src.process.cmdline containsCIS " ONIDLE "))) AND NOT (((src.process.cmdline containsCIS "NT AUT" OR src.process.cmdline containsCIS " SYSTEM" OR src.process.cmdline containsCIS "HIGHEST"))))
