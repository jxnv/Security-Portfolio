// Title: File Download And Execution Via IEExec.EXE
// ID: 9801abb8-e297-4dbf-9fbd-57dde0e830ad
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-05-16
// Tags: attack.command-and-control, attack.t1105
// Description: Detects execution of the IEExec utility to download and execute files
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "http://" OR src.process.cmdline containsCIS "https://")) AND ((src.process.image.path endswithCIS "\\IEExec.exe") OR (OriginalFileName = "IEExec.exe")))
