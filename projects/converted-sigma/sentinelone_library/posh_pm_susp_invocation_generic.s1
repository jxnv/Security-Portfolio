// Title: Suspicious PowerShell Invocations - Generic - PowerShell Module
// ID: bbb80e91-5746-4fbe-8898-122e2cafdbf4
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2017-03-12
// Tags: attack.execution, attack.t1059.001
// Description: Detects suspicious PowerShell invocation command parameters
// Converted by: Sigma Universal SIEM/EDR CLI

(((ContextInfo containsCIS " -enc " OR ContextInfo containsCIS " -EncodedCommand " OR ContextInfo containsCIS " -ec ")) AND ((ContextInfo containsCIS " -w hidden " OR ContextInfo containsCIS " -window hidden " OR ContextInfo containsCIS " -windowstyle hidden " OR ContextInfo containsCIS " -w 1 ")) AND ((ContextInfo containsCIS " -noni " OR ContextInfo containsCIS " -noninteractive ")))
