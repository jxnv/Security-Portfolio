// Title: Suspicious Mstsc.EXE Execution With Local RDP File
// ID: 6e22722b-dfb1-4508-a911-49ac840b40f8
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects potential RDP connection via Mstsc using a local ".rdp" file located in suspicious locations.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline endswithCIS ".rdp" OR src.process.cmdline endswithCIS ".rdp\"")) AND ((src.process.image.path endswithCIS "\\mstsc.exe") OR (OriginalFileName = "mstsc.exe")) AND ((src.process.cmdline containsCIS ":\\Users\\Public\\" OR src.process.cmdline containsCIS ":\\Windows\\System32\\spool\\drivers\\color" OR src.process.cmdline containsCIS ":\\Windows\\System32\\Tasks_Migrated " OR src.process.cmdline containsCIS ":\\Windows\\Tasks\\" OR src.process.cmdline containsCIS ":\\Windows\\Temp\\" OR src.process.cmdline containsCIS ":\\Windows\\Tracing\\" OR src.process.cmdline containsCIS "\\AppData\\Local\\Temp\\" OR src.process.cmdline containsCIS "\\Downloads\\")))
