// Title: Suspicious Msiexec Quiet Install From Remote Location
// ID: 8150732a-0c9d-4a99-82b9-9efb9b90c40c
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-28
// Tags: attack.stealth, attack.t1218.007
// Description: Detects usage of Msiexec.exe to install packages hosted remotely quietly
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.cmdline containsCIS "-i" OR src.process.cmdline containsCIS "/i" OR src.process.cmdline containsCIS "-package" OR src.process.cmdline containsCIS "/package" OR src.process.cmdline containsCIS "-a" OR src.process.cmdline containsCIS "/a" OR src.process.cmdline containsCIS "-j" OR src.process.cmdline containsCIS "/j")) AND ((src.process.image.path endswithCIS "\\msiexec.exe") OR (OriginalFileName = "msiexec.exe")) AND ((src.process.cmdline containsCIS "-q" OR src.process.cmdline containsCIS "/q")) AND ((src.process.cmdline containsCIS "http" OR src.process.cmdline containsCIS "\\\\\\\\"))) AND NOT (((src.process.cmdline containsCIS "\\AppData\\Local\\Temp\\OpenOffice" AND src.process.cmdline containsCIS "Installation Files\\openoffice"))))
