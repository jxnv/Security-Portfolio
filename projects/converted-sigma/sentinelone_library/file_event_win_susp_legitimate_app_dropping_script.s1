// Tags: attack.stealth, attack.t1218
// Description: Detects LOLBINs and applications that should not legitimately drop script files to disk.
// This may indicate malware staging or abuse of a trusted binary for script-based code execution.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "\\eqnedt32.exe" OR src.process.image.path endswithCIS "\\wordpad.exe" OR src.process.image.path endswithCIS "\\wordview.exe" OR src.process.image.path endswithCIS "\\certutil.exe" OR src.process.image.path endswithCIS "\\certoc.exe" OR src.process.image.path endswithCIS "\\CertReq.exe" OR src.process.image.path endswithCIS "\\Desktopimgdownldr.exe" OR src.process.image.path endswithCIS "\\esentutl.exe" OR src.process.image.path endswithCIS "\\mshta.exe" OR src.process.image.path endswithCIS "\\AcroRd32.exe" OR src.process.image.path endswithCIS "\\RdrCEF.exe" OR src.process.image.path endswithCIS "\\hh.exe" OR src.process.image.path endswithCIS "\\finger.exe") AND (tgt.file.path endswithCIS ".bat" OR tgt.file.path endswithCIS ".chm" OR tgt.file.path endswithCIS ".csproj" OR tgt.file.path endswithCIS ".hta" OR tgt.file.path endswithCIS ".js" OR tgt.file.path endswithCIS ".jse" OR tgt.file.path endswithCIS ".proj" OR tgt.file.path endswithCIS ".ps1" OR tgt.file.path endswithCIS ".py" OR tgt.file.path endswithCIS ".scf" OR tgt.file.path endswithCIS ".vbe" OR tgt.file.path endswithCIS ".vbs" OR tgt.file.path endswithCIS ".wsf" OR tgt.file.path endswithCIS ".wsh")) AND NOT ((src.process.image.path endswithCIS "\\mshta.exe" AND tgt.file.path endswithCIS ".hta")))
