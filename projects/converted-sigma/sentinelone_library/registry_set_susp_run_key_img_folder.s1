// Title: New RUN Key Pointing to Suspicious Folder
// ID: 02ee49e2-e294-4d0f-9278-f5b3212fc588
// Status: experimental
// Level: high
// Author: Florian Roth (Nextron Systems), Markus Neis, Sander Wiebing, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2018-08-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects suspicious new RUN key element pointing to an executable in a suspicious folder
// Converted by: Sigma Universal SIEM/EDR CLI

(((TargetObject containsCIS "\\Software\\Microsoft\\Windows\\CurrentVersion\\Run" OR TargetObject containsCIS "\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run" OR TargetObject containsCIS "\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\Run")) AND (((Details containsCIS ":\\Perflogs" OR Details containsCIS ":\\ProgramData'" OR Details containsCIS ":\\Windows\\Temp" OR Details containsCIS ":\\Temp" OR Details containsCIS "\\AppData\\Local\\Temp" OR Details containsCIS "\\AppData\\Roaming" OR Details containsCIS ":\\$Recycle.bin" OR Details containsCIS ":\\Users\\Default" OR Details containsCIS ":\\Users\\public" OR Details containsCIS "%temp%" OR Details containsCIS "%tmp%" OR Details containsCIS "%Public%" OR Details containsCIS "%AppData%")) OR ((Details containsCIS ":\\Users\\") AND ((Details containsCIS "\\Favorites" OR Details containsCIS "\\Favourites" OR Details containsCIS "\\Contacts" OR Details containsCIS "\\Music" OR Details containsCIS "\\Pictures" OR Details containsCIS "\\Documents" OR Details containsCIS "\\Photos")))) AND NOT ((TargetObject containsCIS "\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\" AND src.process.image.path startswithCIS "C:\\Windows\\SoftwareDistribution\\Download\\" AND (Details containsCIS "rundll32.exe " AND Details containsCIS "C:\\WINDOWS\\system32\\advpack.dll,DelNodeRunDLL32") AND (Details containsCIS "\\AppData\\Local\\Temp\\" OR Details containsCIS "C:\\Windows\\Temp\\"))) AND NOT (((src.process.image.path endswithCIS "C:\\Program Files\\Spotify\\Spotify.exe" OR src.process.image.path endswithCIS "C:\\Program Files (x86)\\Spotify\\Spotify.exe" OR src.process.image.path endswithCIS "\\AppData\\Roaming\\Spotify\\Spotify.exe") AND TargetObject endswithCIS "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\\Spotify" AND Details endswithCIS "Spotify.exe --autostart --minimized")))
