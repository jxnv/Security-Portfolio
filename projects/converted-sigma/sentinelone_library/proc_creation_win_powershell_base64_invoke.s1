// Title: PowerShell Base64 Encoded Invoke Keyword
// ID: 6385697e-9f1b-40bd-8817-f4a91f40508e
// Status: test
// Level: high
// Author: pH-T (Nextron Systems), Harjot Singh, @cyb3rjy0t
// Date: 2022-05-20
// Tags: attack.execution, attack.stealth, attack.t1059.001, attack.t1027
// Description: Detects UTF-8 and UTF-16 Base64 encoded powershell 'Invoke-' calls
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.cmdline containsCIS " -e") AND ((src.process.cmdline containsCIS "SQBuAHYAbwBrAGUALQ" OR src.process.cmdline containsCIS "kAbgB2AG8AawBlAC0A" OR src.process.cmdline containsCIS "JAG4AdgBvAGsAZQAtA" OR src.process.cmdline containsCIS "SW52b2tlL" OR src.process.cmdline containsCIS "ludm9rZS" OR src.process.cmdline containsCIS "JbnZva2Ut")) AND (((src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe")) OR ((OriginalFileName = "PowerShell.EXE" OR OriginalFileName = "pwsh.dll"))))
