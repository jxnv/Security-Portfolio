// Title: Firewall Disabled via Netsh.EXE
// ID: 57c4bf16-227f-4394-8ec7-1b745ee061c3
// Status: test
// Level: medium
// Author: Fatih Sirin
// Date: 2019-11-01
// Tags: attack.defense-impairment, attack.t1686.003, attack.s0108
// Description: Detects netsh commands that turns off the Windows firewall
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "\\netsh.exe") OR (OriginalFileName = "netsh.exe")) AND (((src.process.cmdline containsCIS "firewall" AND src.process.cmdline containsCIS "set" AND src.process.cmdline containsCIS "opmode" AND src.process.cmdline containsCIS "disable")) OR ((src.process.cmdline containsCIS "advfirewall" AND src.process.cmdline containsCIS "set" AND src.process.cmdline containsCIS "state" AND src.process.cmdline containsCIS "off"))))
