// Title: Potentially Suspicious Office Document Executed From Trusted Location
// ID: f99abdf0-6283-4e71-bd2b-b5c048a94743
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-21
// Tags: attack.stealth, attack.t1202
// Description: Detects the execution of an Office application that points to a document that is located in a trusted location. Attackers often used this to avoid macro security and execute their malicious code.
// Converted by: Sigma Universal SIEM/EDR CLI

(((((src.process.image.path endswithCIS "\\EXCEL.EXE" OR src.process.image.path endswithCIS "\\POWERPNT.EXE" OR src.process.image.path endswithCIS "\\WINWORD.exe")) OR ((OriginalFileName = "Excel.exe" OR OriginalFileName = "POWERPNT.EXE" OR OriginalFileName = "WinWord.exe"))) AND ((src.process.parent.image.path endswithCIS "\\explorer.exe" OR src.process.parent.image.path endswithCIS "\\dopus.exe")) AND ((src.process.cmdline containsCIS "\\AppData\\Roaming\\Microsoft\\Templates" OR src.process.cmdline containsCIS "\\AppData\\Roaming\\Microsoft\\Word\\Startup\\" OR src.process.cmdline containsCIS "\\Microsoft Office\\root\\Templates\\" OR src.process.cmdline containsCIS "\\Microsoft Office\\Templates\\"))) AND NOT (((src.process.cmdline endswithCIS ".dotx" OR src.process.cmdline endswithCIS ".xltx" OR src.process.cmdline endswithCIS ".potx"))))
