// Title: Security Tools Keyword Lookup Via Findstr.EXE
// ID: 4fe074b4-b833-4081-8f24-7dcfeca72b42
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), frack113
// Date: 2023-10-20
// Tags: attack.discovery, attack.t1518.001
// Description: Detects execution of "findstr" to search for common names of security tools. Attackers often pipe the results of recon commands such as "tasklist" or "whoami" to "findstr" in order to filter out the results.
// This detection focuses on the keywords that the attacker might use as a filter.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline endswithCIS " avira" OR src.process.cmdline endswithCIS " avira\"" OR src.process.cmdline endswithCIS " cb" OR src.process.cmdline endswithCIS " cb\"" OR src.process.cmdline endswithCIS " cylance" OR src.process.cmdline endswithCIS " cylance\"" OR src.process.cmdline endswithCIS " defender" OR src.process.cmdline endswithCIS " defender\"" OR src.process.cmdline endswithCIS " kaspersky" OR src.process.cmdline endswithCIS " kaspersky\"" OR src.process.cmdline endswithCIS " kes" OR src.process.cmdline endswithCIS " kes\"" OR src.process.cmdline endswithCIS " mc" OR src.process.cmdline endswithCIS " mc\"" OR src.process.cmdline endswithCIS " sec" OR src.process.cmdline endswithCIS " sec\"" OR src.process.cmdline endswithCIS " sentinel" OR src.process.cmdline endswithCIS " sentinel\"" OR src.process.cmdline endswithCIS " symantec" OR src.process.cmdline endswithCIS " symantec\"" OR src.process.cmdline endswithCIS " virus" OR src.process.cmdline endswithCIS " virus\"")) AND (((src.process.image.path endswithCIS "\\find.exe" OR src.process.image.path endswithCIS "\\findstr.exe")) OR ((OriginalFileName = "FIND.EXE" OR OriginalFileName = "FINDSTR.EXE"))))
