// Title: Legitimate Application Dropped Archive
// ID: 654fcc6d-840d-4844-9b07-2c3300e54a26
// Status: test
// Level: high
// Author: frack113, Florian Roth
// Date: 2022-08-21
// Tags: attack.stealth, attack.t1218
// Description: Detects programs on a Windows system that should not write an archive to disk
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path endswithCIS "\\winword.exe" OR src.process.image.path endswithCIS "\\excel.exe" OR src.process.image.path endswithCIS "\\powerpnt.exe" OR src.process.image.path endswithCIS "\\msaccess.exe" OR src.process.image.path endswithCIS "\\mspub.exe" OR src.process.image.path endswithCIS "\\eqnedt32.exe" OR src.process.image.path endswithCIS "\\visio.exe" OR src.process.image.path endswithCIS "\\wordpad.exe" OR src.process.image.path endswithCIS "\\wordview.exe" OR src.process.image.path endswithCIS "\\certutil.exe" OR src.process.image.path endswithCIS "\\certoc.exe" OR src.process.image.path endswithCIS "\\CertReq.exe" OR src.process.image.path endswithCIS "\\Desktopimgdownldr.exe" OR src.process.image.path endswithCIS "\\esentutl.exe" OR src.process.image.path endswithCIS "\\finger.exe" OR src.process.image.path endswithCIS "\\notepad.exe" OR src.process.image.path endswithCIS "\\AcroRd32.exe" OR src.process.image.path endswithCIS "\\RdrCEF.exe" OR src.process.image.path endswithCIS "\\mshta.exe" OR src.process.image.path endswithCIS "\\hh.exe") AND (tgt.file.path endswithCIS ".zip" OR tgt.file.path endswithCIS ".rar" OR tgt.file.path endswithCIS ".7z" OR tgt.file.path endswithCIS ".diagcab" OR tgt.file.path endswithCIS ".appx"))
