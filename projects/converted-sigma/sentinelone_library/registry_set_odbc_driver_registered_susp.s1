// Title: Potentially Suspicious ODBC Driver Registered
// ID: e4d22291-f3d5-4b78-9a0c-a1fbaf32a6a4
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-23
// Tags: attack.credential-access, attack.persistence, attack.t1003
// Description: Detects the registration of a new ODBC driver where the driver is located in a potentially suspicious location
// Converted by: Sigma Universal SIEM/EDR CLI

(TargetObject containsCIS "\\SOFTWARE\\ODBC\\ODBCINST.INI\\" AND (TargetObject endswithCIS "\\Driver" OR TargetObject endswithCIS "\\Setup") AND (Details containsCIS ":\\PerfLogs\\" OR Details containsCIS ":\\ProgramData\\" OR Details containsCIS ":\\Temp\\" OR Details containsCIS ":\\Users\\Public\\" OR Details containsCIS ":\\Windows\\Registration\\CRMLog" OR Details containsCIS ":\\Windows\\System32\\com\\dmp\\" OR Details containsCIS ":\\Windows\\System32\\FxsTmp\\" OR Details containsCIS ":\\Windows\\System32\\Microsoft\\Crypto\\RSA\\MachineKeys\\" OR Details containsCIS ":\\Windows\\System32\\spool\\drivers\\color\\" OR Details containsCIS ":\\Windows\\System32\\spool\\PRINTERS\\" OR Details containsCIS ":\\Windows\\System32\\spool\\SERVERS\\" OR Details containsCIS ":\\Windows\\System32\\Tasks_Migrated\\" OR Details containsCIS ":\\Windows\\System32\\Tasks\\Microsoft\\Windows\\SyncCenter\\" OR Details containsCIS ":\\Windows\\SysWOW64\\com\\dmp\\" OR Details containsCIS ":\\Windows\\SysWOW64\\FxsTmp\\" OR Details containsCIS ":\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\PLA\\System\\" OR Details containsCIS ":\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\SyncCenter\\" OR Details containsCIS ":\\Windows\\Tasks\\" OR Details containsCIS ":\\Windows\\Temp\\" OR Details containsCIS ":\\Windows\\Tracing\\" OR Details containsCIS "\\AppData\\Local\\Temp\\" OR Details containsCIS "\\AppData\\Roaming\\"))
