// Tags: attack.privilege-escalation, attack.stealth, attack.t1134.001, attack.t1134.002
// Description: Detects the use of getsystem Meterpreter/Cobalt Strike command by detecting a specific service starting
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.parent.image.path endswithCIS "\\services.exe") AND (((src.process.cmdline containsCIS "/c" AND src.process.cmdline containsCIS "echo" AND src.process.cmdline containsCIS "\\pipe\\") AND (src.process.cmdline containsCIS "cmd" OR src.process.cmdline containsCIS "%COMSPEC%")) OR ((src.process.cmdline containsCIS "rundll32" AND src.process.cmdline containsCIS ".dll,a" AND src.process.cmdline containsCIS "/p:"))) AND NOT ((src.process.cmdline containsCIS "MpCmdRun")))
