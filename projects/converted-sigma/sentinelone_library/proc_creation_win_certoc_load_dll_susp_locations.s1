// Title: Suspicious DLL Loaded via CertOC.EXE
// ID: 84232095-ecca-4015-b0d7-7726507ee793
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-15
// Tags: attack.stealth, attack.t1218
// Description: Detects when a user installs certificates by using CertOC.exe to load the target DLL file.
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.cmdline containsCIS " -LoadDLL ") AND ((src.process.image.path endswithCIS "\\certoc.exe") OR (OriginalFileName = "CertOC.exe")) AND ((src.process.cmdline containsCIS "\\Appdata\\Local\\Temp\\" OR src.process.cmdline containsCIS "\\Desktop\\" OR src.process.cmdline containsCIS "\\Downloads\\" OR src.process.cmdline containsCIS "\\Users\\Public\\" OR src.process.cmdline containsCIS "C:\\Windows\\Tasks\\" OR src.process.cmdline containsCIS "C:\\Windows\\Temp\\")))
