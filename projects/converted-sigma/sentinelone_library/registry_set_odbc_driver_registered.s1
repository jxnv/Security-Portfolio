// Title: New ODBC Driver Registered
// ID: 3390fbef-c98d-4bdd-a863-d65ed7c610dd
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-23
// Tags: attack.persistence
// Description: Detects the registration of a new ODBC driver.
// Converted by: Sigma Universal SIEM/EDR CLI

((TargetObject containsCIS "\\SOFTWARE\\ODBC\\ODBCINST.INI\\" AND TargetObject endswithCIS "\\Driver") AND NOT ((TargetObject containsCIS "\\SQL Server\\" AND Details = "%WINDIR%\\System32\\SQLSRV32.dll")) AND NOT (((TargetObject containsCIS "\\Microsoft Access " AND Details startswithCIS "C:\\Progra" AND Details endswithCIS "\\ACEODBC.DLL") OR (TargetObject containsCIS "\\Microsoft Excel Driver" AND Details startswithCIS "C:\\Progra" AND Details endswithCIS "\\ACEODBC.DLL"))))
