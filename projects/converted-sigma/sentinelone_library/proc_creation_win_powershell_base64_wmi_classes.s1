// Description: Detects calls to base64 encoded WMI class such as "Win32_ShadowCopy", "Win32_ScheduledJob", etc.
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe")) OR ((OriginalFileName = "PowerShell.EXE" OR OriginalFileName = "pwsh.dll"))) AND (((src.process.cmdline containsCIS "VwBpAG4AMwAyAF8ATABvAGcAZwBlAGQATwBuAFUAcwBlAHIA" OR src.process.cmdline containsCIS "cAaQBuADMAMgBfAEwAbwBnAGcAZQBkAE8AbgBVAHMAZQByA" OR src.process.cmdline containsCIS "XAGkAbgAzADIAXwBMAG8AZwBnAGUAZABPAG4AVQBzAGUAcg" OR src.process.cmdline containsCIS "V2luMzJfTG9nZ2VkT25Vc2Vy" OR src.process.cmdline containsCIS "dpbjMyX0xvZ2dlZE9uVXNlc" OR src.process.cmdline containsCIS "XaW4zMl9Mb2dnZWRPblVzZX")) OR ((src.process.cmdline containsCIS "VwBpAG4AMwAyAF8AUAByAG8AYwBlAHMAcw" OR src.process.cmdline containsCIS "cAaQBuADMAMgBfAFAAcgBvAGMAZQBzAHMA" OR src.process.cmdline containsCIS "XAGkAbgAzADIAXwBQAHIAbwBjAGUAcwBzA" OR src.process.cmdline containsCIS "V2luMzJfUHJvY2Vzc" OR src.process.cmdline containsCIS "dpbjMyX1Byb2Nlc3" OR src.process.cmdline containsCIS "XaW4zMl9Qcm9jZXNz")) OR ((src.process.cmdline containsCIS "VwBpAG4AMwAyAF8AUwBjAGgAZQBkAHUAbABlAGQASgBvAGIA" OR src.process.cmdline containsCIS "cAaQBuADMAMgBfAFMAYwBoAGUAZAB1AGwAZQBkAEoAbwBiA" OR src.process.cmdline containsCIS "XAGkAbgAzADIAXwBTAGMAaABlAGQAdQBsAGUAZABKAG8AYg" OR src.process.cmdline containsCIS "V2luMzJfU2NoZWR1bGVkSm9i" OR src.process.cmdline containsCIS "dpbjMyX1NjaGVkdWxlZEpvY" OR src.process.cmdline containsCIS "XaW4zMl9TY2hlZHVsZWRKb2")) OR ((src.process.cmdline containsCIS "VwBpAG4AMwAyAF8AUwBoAGEAZABvAHcAYwBvAHAAeQ" OR src.process.cmdline containsCIS "cAaQBuADMAMgBfAFMAaABhAGQAbwB3AGMAbwBwAHkA" OR src.process.cmdline containsCIS "XAGkAbgAzADIAXwBTAGgAYQBkAG8AdwBjAG8AcAB5A" OR src.process.cmdline containsCIS "V2luMzJfU2hhZG93Y29we" OR src.process.cmdline containsCIS "dpbjMyX1NoYWRvd2NvcH" OR src.process.cmdline containsCIS "XaW4zMl9TaGFkb3djb3B5")) OR ((src.process.cmdline containsCIS "VwBpAG4AMwAyAF8AVQBzAGUAcgBBAGMAYwBvAHUAbgB0A" OR src.process.cmdline containsCIS "cAaQBuADMAMgBfAFUAcwBlAHIAQQBjAGMAbwB1AG4AdA" OR src.process.cmdline containsCIS "XAGkAbgAzADIAXwBVAHMAZQByAEEAYwBjAG8AdQBuAHQA" OR src.process.cmdline containsCIS "V2luMzJfVXNlckFjY291bn" OR src.process.cmdline containsCIS "dpbjMyX1VzZXJBY2NvdW50" OR src.process.cmdline containsCIS "XaW4zMl9Vc2VyQWNjb3Vud"))))
