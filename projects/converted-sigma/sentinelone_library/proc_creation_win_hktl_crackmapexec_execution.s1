// Title: HackTool - CrackMapExec Execution
// ID: 42a993dd-bb3e-48c8-b372-4d6684c4106c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-25
// Tags: attack.execution, attack.persistence, attack.privilege-escalation, attack.credential-access, attack.discovery, attack.t1047, attack.t1053, attack.t1059.003, attack.t1059.001, attack.t1110, attack.t1201
// Description: This rule detect common flag combinations used by CrackMapExec in order to detect its use even if the binary has been replaced.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "\\crackmapexec.exe") OR ((src.process.cmdline containsCIS " --local-auth" AND src.process.cmdline containsCIS " -u " AND src.process.cmdline containsCIS " -x ")) OR ((src.process.cmdline containsCIS " --local-auth" AND src.process.cmdline containsCIS " -u " AND src.process.cmdline containsCIS " -p " AND src.process.cmdline containsCIS " -H 'NTHASH'")) OR ((src.process.cmdline containsCIS " mssql " AND src.process.cmdline containsCIS " -u " AND src.process.cmdline containsCIS " -p " AND src.process.cmdline containsCIS " -M " AND src.process.cmdline containsCIS " -d ")) OR ((src.process.cmdline containsCIS " smb " AND src.process.cmdline containsCIS " -u " AND src.process.cmdline containsCIS " -H " AND src.process.cmdline containsCIS " -M " AND src.process.cmdline containsCIS " -o ")) OR ((src.process.cmdline containsCIS " smb " AND src.process.cmdline containsCIS " -u " AND src.process.cmdline containsCIS " -p " AND src.process.cmdline containsCIS " --local-auth")) OR (src.process.cmdline containsCIS " -M pe_inject ")) OR (((src.process.cmdline containsCIS " --local-auth" AND src.process.cmdline containsCIS " -u " AND src.process.cmdline containsCIS " -p ")) AND ((src.process.cmdline containsCIS " 10." AND src.process.cmdline containsCIS " 192.168." AND src.process.cmdline containsCIS "/24 "))))
