// Title: Uncommon File Creation By Mysql Daemon Process
// ID: c61daa90-3c1e-4f18-af62-8f288b5c9aaf
// Status: test
// Level: high
// Author: Joseph Kamau
// Date: 2024-05-27
// Tags: attack.stealth
// Description: Detects the creation of files with scripting or executable extensions by Mysql daemon.
// Which could be an indicator of "User Defined Functions" abuse to download malware.
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path endswithCIS "\\mysqld.exe" OR src.process.image.path endswithCIS "\\mysqld-nt.exe") AND (tgt.file.path endswithCIS ".bat" OR tgt.file.path endswithCIS ".dat" OR tgt.file.path endswithCIS ".dll" OR tgt.file.path endswithCIS ".exe" OR tgt.file.path endswithCIS ".ps1" OR tgt.file.path endswithCIS ".psm1" OR tgt.file.path endswithCIS ".vbe" OR tgt.file.path endswithCIS ".vbs"))
