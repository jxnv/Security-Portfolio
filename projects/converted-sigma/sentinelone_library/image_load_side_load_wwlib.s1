// Description: Detects potential DLL sideloading of "wwlib.dll"
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageLoaded endswithCIS "\\wwlib.dll") AND NOT (((src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft Office\\" OR src.process.image.path startswithCIS "C:\\Program Files\\Microsoft Office\\") AND src.process.image.path endswithCIS "\\winword.exe" AND (ImageLoaded startswithCIS "C:\\Program Files (x86)\\Microsoft Office\\" OR ImageLoaded startswithCIS "C:\\Program Files\\Microsoft Office\\"))))
