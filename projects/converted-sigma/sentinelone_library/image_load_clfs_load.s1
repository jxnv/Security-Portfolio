// Title: Clfs.SYS Loaded By Process Located In a Potential Suspicious Location
// ID: fb4e2211-6d08-426b-8e6f-0d4a161e3b1d
// Status: experimental
// Level: medium
// Author: X__Junior
// Date: 2025-01-20
// Tags: attack.execution, attack.t1059
// Description: Detects Clfs.sys being loaded by a process running from a potentially suspicious location. Clfs.sys is loaded as part of many CVEs exploits that targets Common Log File.
// Converted by: Sigma Universal SIEM/EDR CLI

((ImageLoaded endswithCIS "\\clfs.sys") AND (((src.process.image.path containsCIS ":\\Perflogs\\" OR src.process.image.path containsCIS ":\\Users\\Public\\" OR src.process.image.path containsCIS "\\Temporary Internet" OR src.process.image.path containsCIS "\\Windows\\Temp\\")) OR (((src.process.image.path containsCIS ":\\Users\\" AND src.process.image.path containsCIS "\\Favorites\\")) OR ((src.process.image.path containsCIS ":\\Users\\" AND src.process.image.path containsCIS "\\Favourites\\")) OR ((src.process.image.path containsCIS ":\\Users\\" AND src.process.image.path containsCIS "\\Contacts\\")) OR ((src.process.image.path containsCIS ":\\Users\\" AND src.process.image.path containsCIS "\\Pictures\\")))))
