// Title: HackTool - KrbRelay Execution
// ID: e96253b8-6b3b-4f90-9e59-3b24b99cf9b4
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-04-27
// Tags: attack.credential-access, attack.t1558.003
// Description: Detects the use of KrbRelay, a Kerberos relaying tool
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS " -spn " AND src.process.cmdline containsCIS " -clsid " AND src.process.cmdline containsCIS " -rbcd ")) OR ((src.process.cmdline containsCIS "shadowcred" AND src.process.cmdline containsCIS "clsid" AND src.process.cmdline containsCIS "spn")) OR ((src.process.cmdline containsCIS "spn " AND src.process.cmdline containsCIS "session " AND src.process.cmdline containsCIS "clsid ")) OR ((src.process.image.path endswithCIS "\\KrbRelay.exe") OR (OriginalFileName = "KrbRelay.exe")))
