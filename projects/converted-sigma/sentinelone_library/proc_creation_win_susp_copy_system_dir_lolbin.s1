// Title: LOL-Binary Copied From System Directory
// ID: f5d19838-41b5-476c-98d8-ba8af4929ee2
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-08-29
// Tags: attack.stealth, attack.t1036.003
// Description: Detects a suspicious copy operation that tries to copy a known LOLBIN from system (System32, SysWOW64, WinSxS) directories to another on disk in order to bypass detections based on locations.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "\\cmd.exe" AND src.process.cmdline containsCIS "copy ") OR (((src.process.image.path endswithCIS "\\robocopy.exe" OR src.process.image.path endswithCIS "\\xcopy.exe")) OR ((OriginalFileName = "robocopy.exe" OR OriginalFileName = "XCOPY.EXE"))) OR ((src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe") AND (src.process.cmdline containsCIS "copy-item" OR src.process.cmdline containsCIS " copy " OR src.process.cmdline containsCIS "cpi " OR src.process.cmdline containsCIS " cp "))) AND (((src.process.cmdline containsCIS "\\bitsadmin.exe" OR src.process.cmdline containsCIS "\\calc.exe" OR src.process.cmdline containsCIS "\\certutil.exe" OR src.process.cmdline containsCIS "\\cmdl32.exe" OR src.process.cmdline containsCIS "\\cscript.exe" OR src.process.cmdline containsCIS "\\mshta.exe" OR src.process.cmdline containsCIS "\\rundll32.exe" OR src.process.cmdline containsCIS "\\wscript.exe" OR src.process.cmdline containsCIS "\\ie4uinit.exe")) AND ((src.process.cmdline containsCIS "\\System32" OR src.process.cmdline containsCIS "\\SysWOW64" OR src.process.cmdline containsCIS "\\WinSxS"))))
