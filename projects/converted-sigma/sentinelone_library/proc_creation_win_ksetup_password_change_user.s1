// Description: Detects password change for the logged-on user's via "ksetup.exe"
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.cmdline containsCIS " /ChangePassword ") AND ((src.process.image.path endswithCIS "\\ksetup.exe") OR (OriginalFileName = "ksetup.exe")))
