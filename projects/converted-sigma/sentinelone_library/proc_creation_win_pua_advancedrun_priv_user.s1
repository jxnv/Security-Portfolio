// Title: PUA - AdvancedRun Suspicious Execution
// ID: fa00b701-44c6-4679-994d-5a18afa8a707
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-01-20
// Tags: attack.privilege-escalation, attack.stealth, attack.t1134.002
// Description: Detects the execution of AdvancedRun utility in the context of the TrustedInstaller, SYSTEM, Local Service or Network Service accounts
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "/EXEFilename" OR src.process.cmdline containsCIS "/CommandLine")) AND (((src.process.cmdline containsCIS " /RunAs 8 " OR src.process.cmdline containsCIS " /RunAs 4 " OR src.process.cmdline containsCIS " /RunAs 10 " OR src.process.cmdline containsCIS " /RunAs 11 ")) OR ((src.process.cmdline endswithCIS "/RunAs 8" OR src.process.cmdline endswithCIS "/RunAs 4" OR src.process.cmdline endswithCIS "/RunAs 10" OR src.process.cmdline endswithCIS "/RunAs 11"))))
