// Title: CobaltStrike Named Pipe
// ID: d5601f8c-b26f-4ab0-9035-69e11a8d4ad2
// Status: test
// Level: critical
// Author: Florian Roth (Nextron Systems), Wojciech Lesicki
// Date: 2021-05-25
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects the creation of a named pipe as used by CobaltStrike
// Converted by: Sigma Universal SIEM/EDR CLI

(((PipeName containsCIS "\\MSSE-" AND PipeName containsCIS "-server")) OR (PipeName startswithCIS "\\interprocess_") OR (PipeName startswithCIS "\\lsarpc_") OR (PipeName startswithCIS "\\mojo_") OR (PipeName startswithCIS "\\msagent_") OR (PipeName startswithCIS "\\netlogon_") OR (PipeName startswithCIS "\\postex_") OR (PipeName startswithCIS "\\samr_") OR (PipeName startswithCIS "\\srvsvc_") OR (PipeName startswithCIS "\\status_") OR (PipeName startswithCIS "\\wkssvc_"))
