// Title: Monero Crypto Coin Mining Pool Lookup
// ID: b593fd50-7335-4682-a36c-4edcb68e4641
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-10-24
// Tags: attack.impact, attack.t1496, attack.exfiltration, attack.t1567
// Description: Detects suspicious DNS queries to Monero mining pools
// Converted by: Sigma Universal SIEM/EDR CLI

((query containsCIS "pool.minexmr.com" OR query containsCIS "fr.minexmr.com" OR query containsCIS "de.minexmr.com" OR query containsCIS "sg.minexmr.com" OR query containsCIS "ca.minexmr.com" OR query containsCIS "us-west.minexmr.com" OR query containsCIS "pool.supportxmr.com" OR query containsCIS "mine.c3pool.com" OR query containsCIS "xmr-eu1.nanopool.org" OR query containsCIS "xmr-eu2.nanopool.org" OR query containsCIS "xmr-us-east1.nanopool.org" OR query containsCIS "xmr-us-west1.nanopool.org" OR query containsCIS "xmr-asia1.nanopool.org" OR query containsCIS "xmr-jp1.nanopool.org" OR query containsCIS "xmr-au1.nanopool.org" OR query containsCIS "xmr.2miners.com" OR query containsCIS "xmr.hashcity.org" OR query containsCIS "xmr.f2pool.com" OR query containsCIS "xmrpool.eu" OR query containsCIS "pool.hashvault.pro"))
