// Description: Detects the modification of an existing service in order to execute an arbitrary payload when the service is started or killed as a potential method for persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.cmdline containsCIS "sc " AND src.process.cmdline containsCIS "config " AND src.process.cmdline containsCIS "binpath=")) OR ((src.process.cmdline containsCIS "sc " AND src.process.cmdline containsCIS "failure" AND src.process.cmdline containsCIS "command="))) OR (((src.process.cmdline containsCIS ".sh" OR src.process.cmdline containsCIS ".exe" OR src.process.cmdline containsCIS ".dll" OR src.process.cmdline containsCIS ".bin$" OR src.process.cmdline containsCIS ".bat" OR src.process.cmdline containsCIS ".cmd" OR src.process.cmdline containsCIS ".js" OR src.process.cmdline containsCIS ".msh$" OR src.process.cmdline containsCIS ".reg$" OR src.process.cmdline containsCIS ".scr" OR src.process.cmdline containsCIS ".ps" OR src.process.cmdline containsCIS ".vb" OR src.process.cmdline containsCIS ".jar" OR src.process.cmdline containsCIS ".pl")) AND (((src.process.cmdline containsCIS "reg " AND src.process.cmdline containsCIS "add " AND src.process.cmdline containsCIS "FailureCommand")) OR ((src.process.cmdline containsCIS "reg " AND src.process.cmdline containsCIS "add " AND src.process.cmdline containsCIS "ImagePath")))))
