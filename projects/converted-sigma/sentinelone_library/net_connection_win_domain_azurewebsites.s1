// Title: Network Connection Initiated To AzureWebsites.NET By Non-Browser Process
// ID: 5c80b618-0dbb-46e6-acbb-03d90bcb6d83
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.command-and-control, attack.t1102, attack.t1102.001
// Description: Detects an initiated network connection by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
// Converted by: Sigma Universal SIEM/EDR CLI

((Initiated = "true" AND DestinationHostname endswithCIS "azurewebsites.net") AND NOT ((((src.process.image.path startswithCIS "C:\\Program Files (x86)\\Avant Browser\\" OR src.process.image.path startswithCIS "C:\\Program Files\\Avant Browser\\") AND src.process.image.path endswithCIS "\\avant.exe") OR (src.process.image.path startswithCIS "C:\\Program Files\\BraveSoftware\\" AND src.process.image.path endswithCIS "\\brave.exe") OR ((src.process.image.path = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR src.process.image.path = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR (src.process.image.path startswithCIS "C:\\Users\\" AND src.process.image.path endswithCIS "\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe") OR ((src.process.image.path containsCIS "C:\\Program Files\\Windows Defender Advanced Threat Protection\\" OR src.process.image.path containsCIS "C:\\Program Files\\Windows Defender\\" OR src.process.image.path containsCIS "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\") AND (src.process.image.path endswithCIS "\\MsMpEng.exe" OR src.process.image.path endswithCIS "\\MsSense.exe")) OR (src.process.image.path containsCIS "\\AppData\\Local\\Discord\\" AND src.process.image.path endswithCIS "\\Discord.exe") OR ((src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") OR (src.process.image.path endswithCIS "\\WindowsApps\\MicrosoftEdge.exe") OR ((src.process.image.path = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR src.process.image.path = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" OR src.process.image.path startswithCIS "C:\\Program Files\\Microsoft\\EdgeCore\\") AND (src.process.image.path endswithCIS "\\msedge.exe" OR src.process.image.path endswithCIS "\\msedgewebview2.exe")) OR (src.process.image.path = "") OR ((src.process.image.path startswithCIS "C:\\Program Files\\Falkon\\" OR src.process.image.path startswithCIS "C:\\Program Files (x86)\\Falkon\\") AND src.process.image.path endswithCIS "\\falkon.exe") OR ((src.process.image.path = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR src.process.image.path = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR (src.process.image.path startswithCIS "C:\\Users\\" AND src.process.image.path endswithCIS "\\AppData\\Local\\Mozilla Firefox\\firefox.exe") OR (src.process.image.path containsCIS "\\AppData\\Local\\Flock\\" AND src.process.image.path endswithCIS "\\Flock.exe") OR ((src.process.image.path = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR src.process.image.path = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (src.process.image.path containsCIS "\\AppData\\Local\\Maxthon\\" AND src.process.image.path endswithCIS "\\maxthon.exe") OR (src.process.image.path is null) OR (src.process.image.path containsCIS "\\AppData\\Local\\Programs\\Opera\\" AND src.process.image.path endswithCIS "\\opera.exe") OR (src.process.image.path containsCIS "\\AppData\\Local\\Phoebe\\" AND src.process.image.path endswithCIS "\\Phoebe.exe") OR ((src.process.image.path endswithCIS "C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe" OR src.process.image.path endswithCIS "C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe")) OR ((src.process.image.path startswithCIS "C:\\Program Files (x86)\\QtWeb\\" OR src.process.image.path startswithCIS "C:\\Program Files\\QtWeb\\") AND src.process.image.path endswithCIS "\\QtWeb.exe") OR ((src.process.image.path containsCIS "C:\\Program Files (x86)\\Safari\\" OR src.process.image.path containsCIS "C:\\Program Files\\Safari\\") AND src.process.image.path endswithCIS "\\safari.exe") OR ((src.process.image.path startswithCIS "C:\\Program Files\\SeaMonkey\\" OR src.process.image.path startswithCIS "C:\\Program Files (x86)\\SeaMonkey\\") AND src.process.image.path endswithCIS "\\seamonkey.exe") OR ((src.process.image.path startswithCIS "C:\\Program Files\\SlimBrowser\\" OR src.process.image.path startswithCIS "C:\\Program Files (x86)\\SlimBrowser\\") AND src.process.image.path endswithCIS "\\slimbrowser.exe") OR (src.process.image.path containsCIS "\\AppData\\Local\\Vivaldi\\" AND src.process.image.path endswithCIS "\\vivaldi.exe") OR ((src.process.image.path startswithCIS "C:\\Program Files\\Naver\\Naver Whale\\" OR src.process.image.path startswithCIS "C:\\Program Files (x86)\\Naver\\Naver Whale\\") AND src.process.image.path endswithCIS "\\whale.exe") OR ((src.process.image.path startswithCIS "C:\\Program Files\\Waterfox\\" OR src.process.image.path startswithCIS "C:\\Program Files (x86)\\Waterfox\\") AND src.process.image.path endswithCIS "\\Waterfox.exe"))))
