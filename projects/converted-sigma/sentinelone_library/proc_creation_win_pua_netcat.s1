// Title: PUA - Netcat Suspicious Execution
// ID: e31033fc-33f0-4020-9a16-faf9b31cbf08
// Status: test
// Level: high
// Author: frack113, Florian Roth (Nextron Systems)
// Date: 2021-07-21
// Tags: attack.command-and-control, attack.t1095
// Description: Detects execution of Netcat. Adversaries may use a non-application layer protocol for communication between host and C2 server or among infected hosts within a network
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS " -lvp " OR src.process.cmdline containsCIS " -lvnp" OR src.process.cmdline containsCIS " -l -v -p " OR src.process.cmdline containsCIS " -lv -p " OR src.process.cmdline containsCIS " -l --proxy-type http " OR src.process.cmdline containsCIS " -vnl --exec " OR src.process.cmdline containsCIS " -vnl -e " OR src.process.cmdline containsCIS " --lua-exec " OR src.process.cmdline containsCIS " --sh-exec ")) OR ((src.process.image.path endswithCIS "\\nc.exe" OR src.process.image.path endswithCIS "\\ncat.exe" OR src.process.image.path endswithCIS "\\netcat.exe")))
