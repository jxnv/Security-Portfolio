// Title: Uncommon Microsoft Office Trusted Location Added
// ID: f742bde7-9528-42e5-bd82-84f51a8387d2
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-21
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects changes to registry keys related to "Trusted Location" of Microsoft Office where the path is set to something uncommon. Attackers might add additional trusted locations to avoid macro security restrictions.
// Converted by: Sigma Universal SIEM/EDR CLI

((TargetObject containsCIS "Security\\Trusted Locations\\Location" AND TargetObject endswithCIS "\\Path") AND NOT ((((src.process.image.path containsCIS ":\\Program Files\\Microsoft Office\\" OR src.process.image.path containsCIS ":\\Program Files (x86)\\Microsoft Office\\")) OR (src.process.image.path containsCIS ":\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\" AND src.process.image.path endswithCIS "\\OfficeClickToRun.exe"))) AND NOT (((Details containsCIS "%APPDATA%\\Microsoft\\Templates" OR Details containsCIS "%%APPDATA%%\\Microsoft\\Templates" OR Details containsCIS "%APPDATA%\\Microsoft\\Word\\Startup" OR Details containsCIS "%%APPDATA%%\\Microsoft\\Word\\Startup" OR Details containsCIS ":\\Program Files (x86)\\Microsoft Office\\root\\Templates\\" OR Details containsCIS ":\\Program Files\\Microsoft Office (x86)\\Templates" OR Details containsCIS ":\\Program Files\\Microsoft Office\\root\\Templates\\" OR Details containsCIS ":\\Program Files\\Microsoft Office\\Templates\\"))))
