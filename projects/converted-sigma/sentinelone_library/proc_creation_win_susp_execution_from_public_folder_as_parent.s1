// Title: Potentially Suspicious Execution From Parent Process In Public Folder
// ID: 69bd9b97-2be2-41b6-9816-fb08757a4d1a
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-02-25
// Tags: attack.execution, attack.stealth, attack.t1564, attack.t1059
// Description: Detects a potentially suspicious execution of a parent process located in the "\Users\Public" folder executing a child process containing references to shell or scripting binaries and commandlines.
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.image.path endswithCIS "\\bitsadmin.exe" OR src.process.image.path endswithCIS "\\certutil.exe" OR src.process.image.path endswithCIS "\\cmd.exe" OR src.process.image.path endswithCIS "\\cscript.exe" OR src.process.image.path endswithCIS "\\mshta.exe" OR src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe" OR src.process.image.path endswithCIS "\\regsvr32.exe" OR src.process.image.path endswithCIS "\\rundll32.exe" OR src.process.image.path endswithCIS "\\wscript.exe")) OR ((src.process.cmdline containsCIS "bitsadmin" OR src.process.cmdline containsCIS "certutil" OR src.process.cmdline containsCIS "cscript" OR src.process.cmdline containsCIS "mshta" OR src.process.cmdline containsCIS "powershell" OR src.process.cmdline containsCIS "regsvr32" OR src.process.cmdline containsCIS "rundll32" OR src.process.cmdline containsCIS "wscript"))) AND (src.process.parent.image.path containsCIS ":\\Users\\Public\\"))
