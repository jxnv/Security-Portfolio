// Description: Detects uncommon outbound network activity via Kerberos default port indicating possible lateral movement or first stage PrivEsc via delegation.
// Converted by: Sigma Universal SIEM/EDR CLI

((EventID = "5156" AND DestPort = "88") AND NOT (((Application startswithCIS "\\device\\harddiskvolume" OR Application startswithCIS "C:") AND Application endswithCIS "\\Windows\\System32\\lsass.exe")) AND NOT ((((Application startswithCIS "\\device\\harddiskvolume" OR Application startswithCIS "C:") AND (Application endswithCIS "\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe" OR Application endswithCIS "\\Program Files\\Google\\Chrome\\Application\\chrome.exe")) OR ((Application startswithCIS "\\device\\harddiskvolume" OR Application startswithCIS "C:") AND (Application endswithCIS "\\Program Files (x86)\\Mozilla Firefox\\firefox.exe" OR Application endswithCIS "\\Program Files\\Mozilla Firefox\\firefox.exe")) OR (Application endswithCIS "\\tomcat\\bin\\tomcat8.exe"))))
