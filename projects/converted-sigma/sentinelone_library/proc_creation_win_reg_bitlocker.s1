// Title: Suspicious Reg Add BitLocker
// ID: 0e0255bf-2548-47b8-9582-c0955c9283f5
// Status: test
// Level: high
// Author: frack113
// Date: 2021-11-15
// Tags: attack.impact, attack.t1486
// Description: Detects suspicious addition to BitLocker related registry keys via the reg.exe utility
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.cmdline containsCIS "REG" AND src.process.cmdline containsCIS "ADD" AND src.process.cmdline containsCIS "\\SOFTWARE\\Policies\\Microsoft\\FVE" AND src.process.cmdline containsCIS "/v" AND src.process.cmdline containsCIS "/f") AND (src.process.cmdline containsCIS "EnableBDEWithNoTPM" OR src.process.cmdline containsCIS "UseAdvancedStartup" OR src.process.cmdline containsCIS "UseTPM" OR src.process.cmdline containsCIS "UseTPMKey" OR src.process.cmdline containsCIS "UseTPMKeyPIN" OR src.process.cmdline containsCIS "RecoveryKeyMessageSource" OR src.process.cmdline containsCIS "UseTPMPIN" OR src.process.cmdline containsCIS "RecoveryKeyMessage"))
