// Title: Curl File Upload To File Sharing Websites
// ID: e328cc73-f92a-42fb-b3fa-7c2cffda981a
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-03-29
// Tags: attack.exfiltration, attack.t1567.002
// Description: Detects usage of curl to upload files to known file sharing domains, which may indicate data exfiltration.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "0x0.st" OR src.process.cmdline containsCIS "bashupload.com" OR src.process.cmdline containsCIS "chunk.io" OR src.process.cmdline containsCIS "file.io" OR src.process.cmdline containsCIS "filebin.net" OR src.process.cmdline containsCIS "pastebin" OR src.process.cmdline containsCIS "send.firefox.com" OR src.process.cmdline containsCIS "temp.sh" OR src.process.cmdline containsCIS "transfer.sh" OR src.process.cmdline containsCIS "ufile.io" OR src.process.cmdline containsCIS "uploadfiles.io" OR src.process.cmdline containsCIS "wetransfer.com" OR src.process.cmdline containsCIS "x0.at")) AND (((src.process.cmdline containsCIS " --form" OR src.process.cmdline containsCIS " --upload-file" OR src.process.cmdline containsCIS " --data" OR src.process.cmdline containsCIS " -X POST" OR src.process.cmdline containsCIS " --request POST ")) OR ((src.process.cmdline RegEx "\s-[FTd]\s" OR src.process.cmdline RegEx "\s-sT\s"))) AND ((src.process.image.path endswithCIS "\\curl.exe") OR (OriginalFileName = "curl.exe")))
