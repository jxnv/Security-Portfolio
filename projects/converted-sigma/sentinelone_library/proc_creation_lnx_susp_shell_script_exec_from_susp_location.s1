// Title: Execution Of Script Located In Potentially Suspicious Directory
// ID: 30bcce26-51c5-49f2-99c8-7b59e3af36c7
// Status: test
// Level: medium
// Author: Joseliyo Sanchez, @Joseliyo_Jstnk
// Date: 2023-06-02
// Tags: attack.execution
// Description: Detects executions of scripts located in potentially suspicious locations such as "/tmp" via a shell such as "bash", "sh", etc.
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.cmdline containsCIS " -c ") AND ((src.process.image.path endswithCIS "/bash" OR src.process.image.path endswithCIS "/csh" OR src.process.image.path endswithCIS "/dash" OR src.process.image.path endswithCIS "/fish" OR src.process.image.path endswithCIS "/ksh" OR src.process.image.path endswithCIS "/sh" OR src.process.image.path endswithCIS "/zsh")) AND (src.process.cmdline containsCIS "/tmp/"))
