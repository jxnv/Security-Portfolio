// Title: Unsigned AppX Installation Attempt Using Add-AppxPackage
// ID: 37651c2a-42cd-4a69-ae0d-22a4349aa04a
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-31
// Tags: attack.persistence, attack.stealth
// Description: Detects usage of the "Add-AppxPackage" or it's alias "Add-AppPackage" to install unsigned AppX packages
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "Add-AppPackage " OR src.process.cmdline containsCIS "Add-AppxPackage ")) AND (src.process.cmdline containsCIS " -AllowUnsigned") AND (((src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe")) OR ((OriginalFileName = "PowerShell.EXE" OR OriginalFileName = "pwsh.dll"))))
