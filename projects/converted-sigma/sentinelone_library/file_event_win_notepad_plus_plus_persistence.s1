// Title: Potential Persistence Via Notepad++ Plugins
// ID: 54127bd4-f541-4ac3-afdb-ea073f63f692
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-10
// Tags: attack.persistence
// Description: Detects creation of new ".dll" files inside the plugins directory of a notepad++ installation by a process other than "gup.exe". Which could indicates possible persistence
// Converted by: Sigma Universal SIEM/EDR CLI

((tgt.file.path containsCIS "\\Notepad++\\plugins\\" AND tgt.file.path endswithCIS ".dll") AND NOT (((src.process.image.path endswithCIS "\\Notepad++\\updater\\gup.exe") OR (src.process.image.path startswithCIS "C:\\Users\\" AND src.process.image.path containsCIS "\\AppData\\Local\\Temp\\" AND (src.process.image.path endswithCIS "\\target.exe" OR src.process.image.path endswithCIS "Installer.x64.exe")) OR (src.process.image.path containsCIS "\\npp." AND src.process.image.path endswithCIS ".exe" AND (tgt.file.path = "C:\\Program Files\\Notepad++\\plugins\\NppExport\\NppExport.dll" OR tgt.file.path = "C:\\Program Files\\Notepad++\\plugins\\mimeTools\\mimeTools.dll" OR tgt.file.path = "C:\\Program Files\\Notepad++\\plugins\\NppConverter\\NppConverter.dll" OR tgt.file.path = "C:\\Program Files\\Notepad++\\plugins\\Config\\nppPluginList.dll")))))
