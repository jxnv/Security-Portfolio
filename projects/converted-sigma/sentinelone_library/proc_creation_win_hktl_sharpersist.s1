// Title: HackTool - SharPersist Execution
// ID: 26488ad0-f9fd-4536-876f-52fea846a2e4
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-09-15
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053
// Description: Detects the execution of the hacktool SharPersist - used to deploy various different kinds of persistence mechanisms
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS " -t schtask -c " OR src.process.cmdline containsCIS " -t startupfolder -c ")) OR ((src.process.cmdline containsCIS " -t reg -c " AND src.process.cmdline containsCIS " -m add")) OR ((src.process.cmdline containsCIS " -t service -c " AND src.process.cmdline containsCIS " -m add")) OR ((src.process.cmdline containsCIS " -t schtask -c " AND src.process.cmdline containsCIS " -m add")) OR ((src.process.image.path endswithCIS "\\SharPersist.exe") OR (Product = "SharPersist")))
