// Title: Potential Binary Or Script Dropper Via PowerShell
// ID: 7047d730-036f-4f40-b9d8-1c63e36d5e62
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-03-17
// Tags: attack.persistence
// Description: Detects PowerShell creating a binary executable or a script file.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\powershell_ise.exe" OR src.process.image.path endswithCIS "\\pwsh.exe") AND (tgt.file.path endswithCIS ".bat" OR tgt.file.path endswithCIS ".chm" OR tgt.file.path endswithCIS ".cmd" OR tgt.file.path endswithCIS ".com" OR tgt.file.path endswithCIS ".dll" OR tgt.file.path endswithCIS ".exe" OR tgt.file.path endswithCIS ".hta" OR tgt.file.path endswithCIS ".jar" OR tgt.file.path endswithCIS ".js" OR tgt.file.path endswithCIS ".ocx" OR tgt.file.path endswithCIS ".scr" OR tgt.file.path endswithCIS ".sys" OR tgt.file.path endswithCIS ".vbe" OR tgt.file.path endswithCIS ".vbs" OR tgt.file.path endswithCIS ".wsf")) AND NOT (((tgt.file.path startswithCIS "C:\\Program Files\\PackageManagement\\ProviderAssemblies\\nuget\\" AND tgt.file.path endswithCIS "\\Microsoft.PackageManagement.NuGetProvider.dll") OR ((tgt.file.path startswithCIS "C:\\Windows\\Temp\\" OR tgt.file.path startswithCIS "C:\\Windows\\SystemTemp\\") AND (tgt.file.path endswithCIS ".dll" OR tgt.file.path endswithCIS ".exe")) OR (tgt.file.path startswithCIS "C:\\Users\\" AND tgt.file.path containsCIS "\\WindowsPowerShell\\Modules\\" AND tgt.file.path endswithCIS ".dll") OR (tgt.file.path startswithCIS "C:\\Users\\" AND tgt.file.path containsCIS "\\AppData\\Local\\Temp\\" AND (tgt.file.path endswithCIS ".dll" OR tgt.file.path endswithCIS ".exe")))))
