// Title: Suspicious Msbuild Execution By Uncommon Parent Process
// ID: 33be4333-2c6b-44f4-ae28-102cdbde0a31
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-11-17
// Tags: attack.stealth
// Description: Detects suspicious execution of 'Msbuild.exe' by a uncommon parent process
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "\\MSBuild.exe") OR (OriginalFileName = "MSBuild.exe")) AND NOT (((src.process.parent.image.path endswithCIS "\\devenv.exe" OR src.process.parent.image.path endswithCIS "\\cmd.exe" OR src.process.parent.image.path endswithCIS "\\msbuild.exe" OR src.process.parent.image.path endswithCIS "\\python.exe" OR src.process.parent.image.path endswithCIS "\\explorer.exe" OR src.process.parent.image.path endswithCIS "\\nuget.exe"))))
