// Tags: attack.execution, attack.t1059
// Description: Detects suspicious script execution from suspicious directories or folders accessible by environment variables that may indicate malware activity.
// Script interpreters (cscript, wscript, mshta, powershell) executing from folders like Temp, Public, or user profile directories may suggest attempts to evade detection or execute malicious scripts.
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.cmdline containsCIS " -ep bypass " OR src.process.cmdline containsCIS " -ExecutionPolicy bypass " OR src.process.cmdline containsCIS " -w hidden " OR src.process.cmdline containsCIS "/e:javascript " OR src.process.cmdline containsCIS "/e:Jscript " OR src.process.cmdline containsCIS "/e:vbscript ")) OR ((src.process.image.path endswithCIS "\\cscript.exe" OR src.process.image.path endswithCIS "\\mshta.exe" OR src.process.image.path endswithCIS "\\wscript.exe")) OR ((OriginalFileName = "cscript.exe" OR OriginalFileName = "mshta.exe" OR OriginalFileName = "wscript.exe"))) AND (((src.process.cmdline containsCIS ":\\Perflogs\\" OR src.process.cmdline containsCIS ":\\Users\\Public\\" OR src.process.cmdline containsCIS "\\%Public%" OR src.process.cmdline containsCIS "\\AppData\\Local\\Temp" OR src.process.cmdline containsCIS "\\AppData\\Roaming\\Temp" OR src.process.cmdline containsCIS "\\Temporary Internet" OR src.process.cmdline containsCIS "\\Windows\\Temp" OR src.process.cmdline containsCIS "\\Start Menu\\Programs\\Startup\\" OR src.process.cmdline containsCIS "%TEMP%" OR src.process.cmdline containsCIS "%TMP%" OR src.process.cmdline containsCIS "%LocalAppData%\\Temp")) OR (((src.process.cmdline containsCIS ":\\Users\\" AND src.process.cmdline containsCIS "\\Favorites\\")) OR ((src.process.cmdline containsCIS ":\\Users\\" AND src.process.cmdline containsCIS "\\Favourites\\")) OR ((src.process.cmdline containsCIS ":\\Users\\" AND src.process.cmdline containsCIS "\\Contacts\\")) OR ((src.process.cmdline containsCIS ":\\Users\\" AND src.process.cmdline containsCIS "\\Documents\\")) OR ((src.process.cmdline containsCIS ":\\Users\\" AND src.process.cmdline containsCIS "\\Music\\")) OR ((src.process.cmdline containsCIS ":\\Users\\" AND src.process.cmdline containsCIS "\\Pictures\\")) OR ((src.process.cmdline containsCIS ":\\Users\\" AND src.process.cmdline containsCIS "\\Videos\\")))) AND NOT (((src.process.parent.image.path = "C:\\Windows\\System32\\Msiexec.exe" OR src.process.parent.image.path = "C:\\Windows\\SysWOW64\\Msiexec.exe") AND src.process.image.path endswithCIS "\\powershell.exe" AND (src.process.cmdline containsCIS "-NoProfile -ExecutionPolicy Bypass -Command" AND src.process.cmdline containsCIS "AppData\\Local\\Temp\\" AND src.process.cmdline containsCIS "Install-Chocolatey.ps1"))))
