// Title: Renamed PingCastle Binary Execution
// ID: 2433a154-bb3d-42e4-86c3-a26bdac91c45
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2024-01-11
// Tags: attack.execution, attack.stealth, attack.t1059, attack.t1202
// Description: Detects the execution of a renamed "PingCastle" binary based on the PE metadata fields.
// Converted by: Sigma Universal SIEM/EDR CLI

((((OriginalFileName = "PingCastleReporting.exe" OR OriginalFileName = "PingCastleCloud.exe" OR OriginalFileName = "PingCastle.exe")) OR ((src.process.cmdline containsCIS "--scanner aclcheck" OR src.process.cmdline containsCIS "--scanner antivirus" OR src.process.cmdline containsCIS "--scanner computerversion" OR src.process.cmdline containsCIS "--scanner foreignusers" OR src.process.cmdline containsCIS "--scanner laps_bitlocker" OR src.process.cmdline containsCIS "--scanner localadmin" OR src.process.cmdline containsCIS "--scanner nullsession" OR src.process.cmdline containsCIS "--scanner nullsession-trust" OR src.process.cmdline containsCIS "--scanner oxidbindings" OR src.process.cmdline containsCIS "--scanner remote" OR src.process.cmdline containsCIS "--scanner share" OR src.process.cmdline containsCIS "--scanner smb" OR src.process.cmdline containsCIS "--scanner smb3querynetwork" OR src.process.cmdline containsCIS "--scanner spooler" OR src.process.cmdline containsCIS "--scanner startup" OR src.process.cmdline containsCIS "--scanner zerologon")) OR (src.process.cmdline containsCIS "--no-enum-limit") OR ((src.process.cmdline containsCIS "--healthcheck" AND src.process.cmdline containsCIS "--level Full")) OR ((src.process.cmdline containsCIS "--healthcheck" AND src.process.cmdline containsCIS "--server "))) AND NOT (((src.process.image.path endswithCIS "\\PingCastleReporting.exe" OR src.process.image.path endswithCIS "\\PingCastleCloud.exe" OR src.process.image.path endswithCIS "\\PingCastle.exe"))))
