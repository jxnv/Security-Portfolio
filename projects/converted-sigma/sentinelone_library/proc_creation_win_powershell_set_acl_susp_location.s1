// Title: PowerShell Set-Acl On Windows Folder
// ID: 0944e002-e3f6-4eb5-bf69-3a3067b53d73
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-18
// Tags: attack.stealth
// Description: Detects PowerShell scripts to set the ACL to a file in the Windows folder
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "Set-Acl " AND src.process.cmdline containsCIS "-AclObject ")) AND (((OriginalFileName = "PowerShell.EXE" OR OriginalFileName = "pwsh.dll")) OR ((src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe"))) AND ((src.process.cmdline containsCIS "-Path \"C:\\Windows" OR src.process.cmdline containsCIS "-Path 'C:\\Windows" OR src.process.cmdline containsCIS "-Path %windir%" OR src.process.cmdline containsCIS "-Path $env:windir")) AND ((src.process.cmdline containsCIS "FullControl" OR src.process.cmdline containsCIS "Allow")))
