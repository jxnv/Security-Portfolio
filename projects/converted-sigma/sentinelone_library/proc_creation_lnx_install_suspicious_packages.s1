// Title: Suspicious Package Installed - Linux
// ID: 700fb7e8-2981-401c-8430-be58e189e741
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-03
// Tags: attack.defense-impairment, attack.t1553.004
// Description: Detects installation of suspicious packages using system installation utilities
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.image.path endswithCIS "/apt" OR src.process.image.path endswithCIS "/apt-get") AND src.process.cmdline containsCIS "install") OR (src.process.image.path endswithCIS "/dpkg" AND (src.process.cmdline containsCIS "--install" OR src.process.cmdline containsCIS "-i")) OR (src.process.image.path endswithCIS "/rpm" AND src.process.cmdline containsCIS "-i") OR (src.process.image.path endswithCIS "/yum" AND (src.process.cmdline containsCIS "localinstall" OR src.process.cmdline containsCIS "install"))) AND ((src.process.cmdline containsCIS "nmap" OR src.process.cmdline containsCIS " nc" OR src.process.cmdline containsCIS "netcat" OR src.process.cmdline containsCIS "wireshark" OR src.process.cmdline containsCIS "tshark" OR src.process.cmdline containsCIS "openconnect" OR src.process.cmdline containsCIS "proxychains" OR src.process.cmdline containsCIS "socat")))
