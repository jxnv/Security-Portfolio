// Title: Suspicious File Download From File Sharing Websites -  File Stream
// ID: 52182dfb-afb7-41db-b4bc-5336cb29b464
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-08-24
// Tags: attack.stealth, attack.s0139, attack.t1564.004
// Description: Detects the download of suspicious file type from a well-known file and paste sharing domain
// Converted by: Sigma Universal SIEM/EDR CLI

(((Contents containsCIS ".githubusercontent.com" OR Contents containsCIS "0x0.st" OR Contents containsCIS "anonfiles.com" OR Contents containsCIS "bashupload.com" OR Contents containsCIS "cdn.discordapp.com" OR Contents containsCIS "chunk.io" OR Contents containsCIS "ddns.net" OR Contents containsCIS "dl.dropboxusercontent.com" OR Contents containsCIS "ghostbin.co" OR Contents containsCIS "github.com" OR Contents containsCIS "glitch.me" OR Contents containsCIS "gofile.io" OR Contents containsCIS "hastebin.com" OR Contents containsCIS "mediafire.com" OR Contents containsCIS "mega.nz" OR Contents containsCIS "onrender.com" OR Contents containsCIS "pages.dev" OR Contents containsCIS "paste.ee" OR Contents containsCIS "pastebin.com" OR Contents containsCIS "pastebin.pl" OR Contents containsCIS "pastetext.net" OR Contents containsCIS "pixeldrain.com" OR Contents containsCIS "privatlab.com" OR Contents containsCIS "privatlab.net" OR Contents containsCIS "send.exploit.in" OR Contents containsCIS "sendspace.com" OR Contents containsCIS "storage.googleapis.com" OR Contents containsCIS "storjshare.io" OR Contents containsCIS "supabase.co" OR Contents containsCIS "temp.sh" OR Contents containsCIS "transfer.sh" OR Contents containsCIS "trycloudflare.com" OR Contents containsCIS "ufile.io" OR Contents containsCIS "w3spaces.com" OR Contents containsCIS "workers.dev" OR Contents containsCIS "x0.at")) AND ((tgt.file.path containsCIS ".cpl:Zone" OR tgt.file.path containsCIS ".dll:Zone" OR tgt.file.path containsCIS ".exe:Zone" OR tgt.file.path containsCIS ".hta:Zone" OR tgt.file.path containsCIS ".lnk:Zone" OR tgt.file.path containsCIS ".one:Zone" OR tgt.file.path containsCIS ".vbe:Zone" OR tgt.file.path containsCIS ".vbs:Zone" OR tgt.file.path containsCIS ".xll:Zone")))
