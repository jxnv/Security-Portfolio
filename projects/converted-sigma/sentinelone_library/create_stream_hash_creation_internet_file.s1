// Title: Creation Of a Suspicious ADS File Outside a Browser Download
// ID: 573df571-a223-43bc-846e-3f98da481eca
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-10-22
// Tags: attack.stealth
// Description: Detects the creation of a suspicious ADS (Alternate Data Stream) file by software other than browsers
// Converted by: Sigma Universal SIEM/EDR CLI

((Contents startswithCIS "[ZoneTransfer]  ZoneId=3" AND tgt.file.path endswithCIS ":Zone.Identifier" AND (tgt.file.path containsCIS ".exe" OR tgt.file.path containsCIS ".scr" OR tgt.file.path containsCIS ".bat" OR tgt.file.path containsCIS ".cmd" OR tgt.file.path containsCIS ".docx" OR tgt.file.path containsCIS ".hta" OR tgt.file.path containsCIS ".jse" OR tgt.file.path containsCIS ".lnk" OR tgt.file.path containsCIS ".pptx" OR tgt.file.path containsCIS ".ps" OR tgt.file.path containsCIS ".reg" OR tgt.file.path containsCIS ".sct" OR tgt.file.path containsCIS ".vb" OR tgt.file.path containsCIS ".wsc" OR tgt.file.path containsCIS ".wsf" OR tgt.file.path containsCIS ".xlsx")) AND NOT (((src.process.image.path endswithCIS "\\brave.exe") OR ((src.process.image.path = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR src.process.image.path = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") OR (src.process.image.path endswithCIS "\\WindowsApps\\MicrosoftEdge.exe") OR ((src.process.image.path = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR src.process.image.path = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" OR src.process.image.path startswithCIS "C:\\Program Files\\Microsoft\\EdgeCore\\") AND (src.process.image.path endswithCIS "\\msedge.exe" OR src.process.image.path endswithCIS "\\msedgewebview2.exe")) OR ((src.process.image.path = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR src.process.image.path = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR ((src.process.image.path = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR src.process.image.path = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (src.process.image.path endswithCIS "\\maxthon.exe") OR (src.process.image.path endswithCIS "\\opera.exe") OR (src.process.image.path endswithCIS "\\safari.exe") OR (src.process.image.path endswithCIS "\\seamonkey.exe") OR (src.process.image.path startswithCIS "C:\\Program Files\\WindowsApps\\Microsoft.ScreenSketch_" AND src.process.image.path endswithCIS "\\SnippingTool\\SnippingTool.exe" AND tgt.file.path startswithCIS "C:\\Users\\" AND (tgt.file.path containsCIS "\\AppData\\Local\\Packages\\Microsoft.ScreenSketch_" AND tgt.file.path containsCIS "\\TempState\\Screenshot ") AND tgt.file.path endswithCIS ".png:Zone.Identifier") OR (src.process.image.path endswithCIS "\\vivaldi.exe") OR (src.process.image.path endswithCIS "\\whale.exe"))))
