// Title: DNS Query To AzureWebsites.NET By Non-Browser Process
// ID: e043f529-8514-4205-8ab0-7f7d2927b400
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects a DNS query by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
// Converted by: Sigma Universal SIEM/EDR CLI

((QueryName endswithCIS "azurewebsites.net") AND NOT ((((src.process.image.path startswithCIS "C:\\Program Files (x86)\\Avant Browser\\" OR src.process.image.path startswithCIS "C:\\Program Files\\Avant Browser\\") AND src.process.image.path endswithCIS "\\avant.exe") OR (src.process.image.path endswithCIS "\\brave.exe" AND src.process.image.path startswithCIS "C:\\Program Files\\BraveSoftware\\") OR ((src.process.image.path = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR src.process.image.path = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((src.process.image.path endswithCIS "\\MsMpEng.exe" OR src.process.image.path endswithCIS "\\MsSense.exe")) OR ((src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") OR (src.process.image.path endswithCIS "\\WindowsApps\\MicrosoftEdge.exe") OR ((src.process.image.path = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR src.process.image.path = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" OR src.process.image.path startswithCIS "C:\\Program Files\\Microsoft\\EdgeCore\\") AND (src.process.image.path endswithCIS "\\msedge.exe" OR src.process.image.path endswithCIS "\\msedgewebview2.exe")) OR ((src.process.image.path startswithCIS "C:\\Program Files\\Falkon\\" OR src.process.image.path startswithCIS "C:\\Program Files (x86)\\Falkon\\") AND src.process.image.path endswithCIS "\\falkon.exe") OR ((src.process.image.path = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR src.process.image.path = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR (src.process.image.path containsCIS "\\AppData\\Local\\Flock\\" AND src.process.image.path endswithCIS "\\Flock.exe") OR ((src.process.image.path = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR src.process.image.path = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (src.process.image.path containsCIS "\\AppData\\Local\\Maxthon\\" AND src.process.image.path endswithCIS "\\maxthon.exe") OR (src.process.image.path containsCIS "\\AppData\\Local\\Programs\\midori-ng\\" AND src.process.image.path endswithCIS "\\Midori Next Generation.exe") OR (src.process.image.path containsCIS "\\AppData\\Local\\Programs\\Opera\\" AND src.process.image.path endswithCIS "\\opera.exe") OR (src.process.image.path containsCIS "\\AppData\\Local\\Phoebe\\" AND src.process.image.path endswithCIS "\\Phoebe.exe") OR (src.process.image.path endswithCIS "\\safari.exe") OR ((src.process.image.path startswithCIS "C:\\Program Files\\SeaMonkey\\" OR src.process.image.path startswithCIS "C:\\Program Files (x86)\\SeaMonkey\\") AND src.process.image.path endswithCIS "\\seamonkey.exe") OR ((src.process.image.path startswithCIS "C:\\Program Files\\SlimBrowser\\" OR src.process.image.path startswithCIS "C:\\Program Files (x86)\\SlimBrowser\\") AND src.process.image.path endswithCIS "\\slimbrowser.exe") OR (src.process.image.path containsCIS "\\Tor Browser\\") OR (src.process.image.path containsCIS "\\AppData\\Local\\Vivaldi\\" AND src.process.image.path endswithCIS "\\vivaldi.exe") OR ((src.process.image.path startswithCIS "C:\\Program Files\\Naver\\Naver Whale\\" OR src.process.image.path startswithCIS "C:\\Program Files (x86)\\Naver\\Naver Whale\\") AND src.process.image.path endswithCIS "\\whale.exe") OR ((src.process.image.path startswithCIS "C:\\Program Files\\Waterfox\\" OR src.process.image.path startswithCIS "C:\\Program Files (x86)\\Waterfox\\") AND src.process.image.path endswithCIS "\\Waterfox.exe"))))
