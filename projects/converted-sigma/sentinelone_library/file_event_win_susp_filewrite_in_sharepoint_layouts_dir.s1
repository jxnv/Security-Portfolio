// Title: Suspicious File Write to SharePoint Layouts Directory
// ID: 1f0489be-b496-4ddf-b3a9-5900f2044e9c
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-07-24
// Tags: attack.initial-access, attack.t1190, attack.persistence, attack.t1505.003
// Description: Detects suspicious file writes to SharePoint layouts directory which could indicate webshell activity or post-exploitation.
// This behavior has been observed in the exploitation of SharePoint vulnerabilities such as CVE-2025-49704, CVE-2025-49706 or CVE-2025-53770.
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path endswithCIS "\\cmd.exe" OR src.process.image.path endswithCIS "\\powershell_ise.exe" OR src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe" OR src.process.image.path endswithCIS "\\w3wp.exe") AND (tgt.file.path startswithCIS "C:\\Program Files\\Common Files\\Microsoft Shared\\Web Server Extensions\\" OR tgt.file.path startswithCIS "C:\\Program Files (x86)\\Common Files\\Microsoft Shared\\Web Server Extensions\\") AND (tgt.file.path containsCIS "\\15\\TEMPLATE\\LAYOUTS\\" OR tgt.file.path containsCIS "\\16\\TEMPLATE\\LAYOUTS\\") AND (tgt.file.path endswithCIS ".asax" OR tgt.file.path endswithCIS ".ascx" OR tgt.file.path endswithCIS ".ashx" OR tgt.file.path endswithCIS ".asmx" OR tgt.file.path endswithCIS ".asp" OR tgt.file.path endswithCIS ".aspx" OR tgt.file.path endswithCIS ".bat" OR tgt.file.path endswithCIS ".cmd" OR tgt.file.path endswithCIS ".cer" OR tgt.file.path endswithCIS ".config" OR tgt.file.path endswithCIS ".hta" OR tgt.file.path endswithCIS ".js" OR tgt.file.path endswithCIS ".jsp" OR tgt.file.path endswithCIS ".jspx" OR tgt.file.path endswithCIS ".php" OR tgt.file.path endswithCIS ".ps1" OR tgt.file.path endswithCIS ".vbs"))
