// Title: 7Zip Compressing Dump Files
// ID: ec570e53-4c76-45a9-804d-dc3f355ff7a7
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-27
// Tags: attack.collection, attack.t1560.001
// Description: Detects execution of 7z in order to compress a file with a ".dmp"/".dump" extension, which could be a step in a process of dump file exfiltration.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS ".dmp" OR src.process.cmdline containsCIS ".dump" OR src.process.cmdline containsCIS ".hdmp")) AND ((Description containsCIS "7-Zip") OR ((src.process.image.path endswithCIS "\\7z.exe" OR src.process.image.path endswithCIS "\\7zr.exe" OR src.process.image.path endswithCIS "\\7za.exe")) OR ((OriginalFileName = "7z.exe" OR OriginalFileName = "7za.exe" OR OriginalFileName = "7zr.exe"))))
