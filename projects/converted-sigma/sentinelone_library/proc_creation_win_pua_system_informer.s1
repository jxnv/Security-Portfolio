// Description: Detects the execution of System Informer, a task manager tool to view and manipulate processes, kernel options and other low level operations
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path endswithCIS "\\SystemInformer.exe") OR (OriginalFileName = "SystemInformer.exe") OR (Description = "System Informer") OR (Product = "System Informer") OR ((Hashes containsCIS "MD5=19426363A37C03C3ED6FEDF57B6696EC" OR Hashes containsCIS "SHA1=8B12C6DA8FAC0D5E8AB999C31E5EA04AF32D53DC" OR Hashes containsCIS "SHA256=8EE9D84DE50803545937A63C686822388A3338497CDDB660D5D69CF68B68F287" OR Hashes containsCIS "IMPHASH=B68908ADAEB5D662F87F2528AF318F12")))
