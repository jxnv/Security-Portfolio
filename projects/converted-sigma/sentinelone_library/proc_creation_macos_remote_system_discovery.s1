((src.process.image.path endswithCIS "/arp" AND src.process.cmdline containsCIS "-a") OR (src.process.image.path endswithCIS "/ping" AND (src.process.cmdline containsCIS " 10." OR src.process.cmdline containsCIS " 192.168." OR src.process.cmdline containsCIS " 172.16." OR src.process.cmdline containsCIS " 172.17." OR src.process.cmdline containsCIS " 172.18." OR src.process.cmdline containsCIS " 172.19." OR src.process.cmdline containsCIS " 172.20." OR src.process.cmdline containsCIS " 172.21." OR src.process.cmdline containsCIS " 172.22." OR src.process.cmdline containsCIS " 172.23." OR src.process.cmdline containsCIS " 172.24." OR src.process.cmdline containsCIS " 172.25." OR src.process.cmdline containsCIS " 172.26." OR src.process.cmdline containsCIS " 172.27." OR src.process.cmdline containsCIS " 172.28." OR src.process.cmdline containsCIS " 172.29." OR src.process.cmdline containsCIS " 172.30." OR src.process.cmdline containsCIS " 172.31." OR src.process.cmdline containsCIS " 127." OR src.process.cmdline containsCIS " 169.254.")))
