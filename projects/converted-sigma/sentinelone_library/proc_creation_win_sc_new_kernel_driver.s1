// Title: New Kernel Driver Via SC.EXE
// ID: 431a1fdb-4799-4f3b-91c3-a683b003fc49
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-14
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects creation of a new service (kernel driver) with the type "kernel"
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path endswithCIS "\\sc.exe" AND (src.process.cmdline containsCIS "create" OR src.process.cmdline containsCIS "config") AND (src.process.cmdline containsCIS "binPath" AND src.process.cmdline containsCIS "type" AND src.process.cmdline containsCIS "kernel")) AND NOT ((((src.process.cmdline containsCIS "create netprotection_network_filter" AND src.process.cmdline containsCIS "type= kernel start= " AND src.process.cmdline containsCIS "binPath= System32\\drivers\\netprotection_network_filter" AND src.process.cmdline containsCIS "DisplayName= netprotection_network_filter" AND src.process.cmdline containsCIS "group= PNP_TDI tag= yes")) OR ((src.process.cmdline containsCIS "create avelam binpath=C:\\Windows\\system32\\drivers\\avelam.sys" AND src.process.cmdline containsCIS "type=kernel start=boot error=critical group=Early-Launch")))))
