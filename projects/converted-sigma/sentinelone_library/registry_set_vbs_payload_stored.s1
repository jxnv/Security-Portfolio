// Title: VBScript Payload Stored in Registry
// ID: 46490193-1b22-4c29-bdd6-5bf63907216f
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-03-05
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects VBScript content stored into registry keys as seen being used by UNC2452 group
// Converted by: Sigma Universal SIEM/EDR CLI

((TargetObject containsCIS "Software\\Microsoft\\Windows\\CurrentVersion" AND (Details containsCIS "vbscript:" OR Details containsCIS "jscript:" OR Details containsCIS "mshtml," OR Details containsCIS "RunHTMLApplication" OR Details containsCIS "Execute(" OR Details containsCIS "CreateObject" OR Details containsCIS "window.close")) AND NOT (((TargetObject containsCIS "Software\\Microsoft\\Windows\\CurrentVersion\\Run") OR (src.process.image.path endswithCIS "\\msiexec.exe" AND TargetObject containsCIS "\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Installer\\UserData\\" AND (Details containsCIS "\\Microsoft.NET\\Primary Interop Assemblies\\Microsoft.mshtml.dll" OR Details containsCIS "<\\Microsoft.mshtml,fileVersion=" OR Details containsCIS "_mshtml_dll_" OR Details containsCIS "<\\Microsoft.mshtml,culture=")))))
