// Title: AD Privileged Users or Groups Reconnaissance
// ID: 35ba1d85-724d-42a3-889f-2e2362bcaf23
// Status: test
// Level: high
// Author: Samir Bousseaden
// Date: 2019-04-03
// Tags: attack.discovery, attack.t1087.002
// Description: Detect priv users or groups recon based on 4661 eventid and known privileged users or groups SIDs
// Converted by: Sigma Universal SIEM/EDR CLI

((EventID = "4661" AND (ObjectType = "SAM_USER" OR ObjectType = "SAM_GROUP")) AND (((ObjectName endswithCIS "-512" OR ObjectName endswithCIS "-502" OR ObjectName endswithCIS "-500" OR ObjectName endswithCIS "-505" OR ObjectName endswithCIS "-519" OR ObjectName endswithCIS "-520" OR ObjectName endswithCIS "-544" OR ObjectName endswithCIS "-551" OR ObjectName endswithCIS "-555")) OR (ObjectName containsCIS "admin")) AND NOT ((SubjectUserName endswithCIS "$")))
