// Title: Cscript/Wscript Potentially Suspicious Child Process
// ID: b6676963-0353-4f88-90f5-36c20d443c6a
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Alejandro Houspanossian ('@lekz86')
// Date: 2023-05-15
// Tags: attack.execution
// Description: Detects potentially suspicious child processes of Wscript/Cscript. These include processes such as rundll32 with uncommon exports or PowerShell spawning rundll32 or regsvr32.
// Malware such as Pikabot and Qakbot were seen using similar techniques as well as many others.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.parent.image.path endswithCIS "\\wscript.exe" OR src.process.parent.image.path endswithCIS "\\cscript.exe")) AND ((src.process.image.path endswithCIS "\\rundll32.exe") OR (((src.process.image.path endswithCIS "\\cmd.exe" OR src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe")) AND (((src.process.cmdline containsCIS "mshta" AND src.process.cmdline containsCIS "http")) OR ((src.process.cmdline containsCIS "rundll32" OR src.process.cmdline containsCIS "regsvr32" OR src.process.cmdline containsCIS "msiexec"))))) AND NOT ((src.process.image.path endswithCIS "\\rundll32.exe" AND (src.process.cmdline containsCIS "UpdatePerUserSystemParameters" OR src.process.cmdline containsCIS "PrintUIEntry" OR src.process.cmdline containsCIS "ClearMyTracksByProcess"))))
