(((src.process.cmdline containsCIS "inject.ps1" OR src.process.cmdline containsCIS "Invoke-CVE" OR src.process.cmdline containsCIS "pupy.ps1" OR src.process.cmdline containsCIS "payload.ps1" OR src.process.cmdline containsCIS "beacon.ps1" OR src.process.cmdline containsCIS "PowerView.ps1" OR src.process.cmdline containsCIS "bypass.ps1" OR src.process.cmdline containsCIS "obfuscated.ps1" OR src.process.cmdline containsCIS "obfusc.ps1" OR src.process.cmdline containsCIS "obfus.ps1" OR src.process.cmdline containsCIS "obfs.ps1" OR src.process.cmdline containsCIS "evil.ps1" OR src.process.cmdline containsCIS "MiniDogz.ps1" OR src.process.cmdline containsCIS "_enc.ps1" OR src.process.cmdline containsCIS "\\shell.ps1" OR src.process.cmdline containsCIS "\\rshell.ps1" OR src.process.cmdline containsCIS "revshell.ps1" OR src.process.cmdline containsCIS "\\av.ps1" OR src.process.cmdline containsCIS "\\av_test.ps1" OR src.process.cmdline containsCIS "adrecon.ps1" OR src.process.cmdline containsCIS "mimikatz.ps1" OR src.process.cmdline containsCIS "\\PowerUp_" OR src.process.cmdline containsCIS "powerup.ps1" OR src.process.cmdline containsCIS "\\Temp\\a.ps1" OR src.process.cmdline containsCIS "\\Temp\\p.ps1" OR src.process.cmdline containsCIS "\\Temp\\1.ps1" OR src.process.cmdline containsCIS "Hound.ps1" OR src.process.cmdline containsCIS "encode.ps1" OR src.process.cmdline containsCIS "powercat.ps1")) OR (((src.process.image.path containsCIS "\\CVE-202" OR src.process.image.path containsCIS "\\CVE202")) OR ((src.process.image.path endswithCIS "\\poc.exe" OR src.process.image.path endswithCIS "\\artifact.exe" OR src.process.image.path endswithCIS "\\artifact64.exe" OR src.process.image.path endswithCIS "\\artifact_protected.exe" OR src.process.image.path endswithCIS "\\artifact32.exe" OR src.process.image.path endswithCIS "\\artifact32big.exe" OR src.process.image.path endswithCIS "obfuscated.exe" OR src.process.image.path endswithCIS "obfusc.exe" OR src.process.image.path endswithCIS "\\meterpreter"))))
