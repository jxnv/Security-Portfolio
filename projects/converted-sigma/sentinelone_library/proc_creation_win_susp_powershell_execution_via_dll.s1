// Title: Potential PowerShell Execution Via DLL
// ID: 6812a10b-60ea-420c-832f-dfcc33b646ba
// Status: test
// Level: high
// Author: Markus Neis, Nasreddine Bencherchali (Nextron Systems)
// Date: 2018-08-25
// Tags: attack.stealth, attack.t1218.011
// Description: Detects potential PowerShell execution from a DLL instead of the usual PowerShell process as seen used in PowerShdll.
// This detection assumes that PowerShell commands are passed via the CommandLine.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "Default.GetString" OR src.process.cmdline containsCIS "DownloadString" OR src.process.cmdline containsCIS "FromBase64String" OR src.process.cmdline containsCIS "ICM " OR src.process.cmdline containsCIS "IEX " OR src.process.cmdline containsCIS "Invoke-Command" OR src.process.cmdline containsCIS "Invoke-Expression")) AND (((src.process.image.path endswithCIS "\\InstallUtil.exe" OR src.process.image.path endswithCIS "\\RegAsm.exe" OR src.process.image.path endswithCIS "\\RegSvcs.exe" OR src.process.image.path endswithCIS "\\regsvr32.exe" OR src.process.image.path endswithCIS "\\rundll32.exe")) OR ((OriginalFileName = "InstallUtil.exe" OR OriginalFileName = "RegAsm.exe" OR OriginalFileName = "RegSvcs.exe" OR OriginalFileName = "REGSVR32.EXE" OR OriginalFileName = "RUNDLL32.EXE"))))
