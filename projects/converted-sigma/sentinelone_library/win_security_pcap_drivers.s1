// Title: Windows Pcap Drivers
// ID: 7b687634-ab20-11ea-bb37-0242ac130002
// Status: test
// Level: medium
// Author: Cian Heasley
// Date: 2020-06-10
// Tags: attack.discovery, attack.credential-access, attack.t1040
// Description: Detects Windows Pcap driver installation based on a list of associated .sys files.
// Converted by: Sigma Universal SIEM/EDR CLI

(EventID = "4697" AND (ServiceFileName containsCIS "pcap" OR ServiceFileName containsCIS "npcap" OR ServiceFileName containsCIS "npf" OR ServiceFileName containsCIS "nm3" OR ServiceFileName containsCIS "ndiscap" OR ServiceFileName containsCIS "nmnt" OR ServiceFileName containsCIS "windivert" OR ServiceFileName containsCIS "USBPcap" OR ServiceFileName containsCIS "pktmon"))
