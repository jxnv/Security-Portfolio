// Title: Potential Adplus.EXE Abuse
// ID: 2f869d59-7f6a-4931-992c-cce556ff2d53
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-09
// Tags: attack.execution, attack.credential-access, attack.t1003.001
// Description: Detects execution of "AdPlus.exe", a binary that is part of the Windows SDK that can be used as a LOLBIN in order to dump process memory and execute arbitrary commands.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS " -hang " OR src.process.cmdline containsCIS " -pn " OR src.process.cmdline containsCIS " -pmn " OR src.process.cmdline containsCIS " -p " OR src.process.cmdline containsCIS " -po " OR src.process.cmdline containsCIS " -c " OR src.process.cmdline containsCIS " -sc ")) AND ((src.process.image.path endswithCIS "\\adplus.exe") OR (OriginalFileName = "Adplus.exe")))
