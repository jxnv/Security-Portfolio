// Title: Registry Persistence via Service in Safe Mode
// ID: 1547e27c-3974-43e2-a7d7-7f484fb928ec
// Status: test
// Level: high
// Author: frack113
// Date: 2022-04-04
// Tags: attack.stealth, attack.t1564.001
// Description: Detects the modification of the registry to allow a driver or service to persist in Safe Mode.
// Converted by: Sigma Universal SIEM/EDR CLI

(((TargetObject containsCIS "\\Control\\SafeBoot\\Minimal\\" OR TargetObject containsCIS "\\Control\\SafeBoot\\Network\\") AND TargetObject endswithCIS "\\(Default)" AND Details = "Service") AND NOT (((src.process.image.path = "C:\\Hexnode\\Hexnode Agent\\Current\\HexnodeAgent.exe" AND (TargetObject endswithCIS "\\Control\\SafeBoot\\Minimal\\Hexnode Updater\\(Default)" OR TargetObject endswithCIS "\\Control\\SafeBoot\\Network\\Hexnode Updater\\(Default)" OR TargetObject endswithCIS "\\Control\\SafeBoot\\Minimal\\Hexnode Agent\\(Default)" OR TargetObject endswithCIS "\\Control\\SafeBoot\\Network\\Hexnode Agent\\(Default)") AND Details = "Service") OR (src.process.image.path endswithCIS "\\MBAMInstallerService.exe" AND TargetObject endswithCIS "\\MBAMService\\(Default)" AND Details = "Service") OR (src.process.image.path = "C:\\WINDOWS\\system32\\msiexec.exe" AND (TargetObject endswithCIS "\\Control\\SafeBoot\\Minimal\\SAVService\\(Default)" OR TargetObject endswithCIS "\\Control\\SafeBoot\\Network\\SAVService\\(Default)")))))
