// Title: Potential Suspicious Change To Sensitive/Critical Files
// ID: 86157017-c2b1-4d4a-8c33-93b8e67e4af4
// Status: test
// Level: medium
// Author: @d4ns4n_ (Wuerth-Phoenix)
// Date: 2023-05-30
// Tags: attack.impact, attack.t1565.001
// Description: Detects changes of sensitive and critical files. Monitors files that you don't expect to change without planning on Linux system.
// These files include, but are not limited to, system configuration files, authentication files, and critical application files.
// Attackers often target these files to maintain persistence, escalate privileges, or disrupt system operations.
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.image.path endswithCIS "/cat" OR src.process.image.path endswithCIS "/echo" OR src.process.image.path endswithCIS "/grep" OR src.process.image.path endswithCIS "/head" OR src.process.image.path endswithCIS "/more" OR src.process.image.path endswithCIS "/tail") AND src.process.cmdline containsCIS ">") OR ((src.process.image.path endswithCIS "/emacs" OR src.process.image.path endswithCIS "/nano" OR src.process.image.path endswithCIS "/sed" OR src.process.image.path endswithCIS "/vi" OR src.process.image.path endswithCIS "/vim"))) AND ((src.process.cmdline containsCIS "/bin/login" OR src.process.cmdline containsCIS "/bin/passwd" OR src.process.cmdline containsCIS "/boot/" OR src.process.cmdline containsCIS "/etc/*.conf" OR src.process.cmdline containsCIS "/etc/cron." OR src.process.cmdline containsCIS "/etc/crontab" OR src.process.cmdline containsCIS "/etc/hosts" OR src.process.cmdline containsCIS "/etc/init.d" OR src.process.cmdline containsCIS "/etc/sudoers" OR src.process.cmdline containsCIS "/opt/bin/" OR src.process.cmdline containsCIS "/sbin" OR src.process.cmdline containsCIS "/usr/bin/" OR src.process.cmdline containsCIS "/usr/local/bin/")) AND NOT (1=1))
