// Title: Access of Sudoers File Content
// ID: 0f79c4d2-4e1f-4683-9c36-b5469a665e06
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-06-20
// Tags: attack.reconnaissance, attack.t1592.004
// Description: Detects the execution of a text-based file access or inspection utilities to read the content of /etc/sudoers in order to potentially list all users that have sudo rights.
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path endswithCIS "/cat" OR src.process.image.path endswithCIS "/ed" OR src.process.image.path endswithCIS "/egrep" OR src.process.image.path endswithCIS "/emacs" OR src.process.image.path endswithCIS "/fgrep" OR src.process.image.path endswithCIS "/grep" OR src.process.image.path endswithCIS "/head" OR src.process.image.path endswithCIS "/less" OR src.process.image.path endswithCIS "/more" OR src.process.image.path endswithCIS "/nano" OR src.process.image.path endswithCIS "/tail") AND src.process.cmdline containsCIS " /etc/sudoers")
