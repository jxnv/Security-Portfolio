(((src.process.cmdline containsCIS ":\\PerfLogs\\" OR src.process.cmdline containsCIS ":\\ProgramData\\" OR src.process.cmdline containsCIS ":\\Temp\\" OR src.process.cmdline containsCIS ":\\Users\\Public\\" OR src.process.cmdline containsCIS ":\\Windows\\Registration\\CRMLog" OR src.process.cmdline containsCIS ":\\Windows\\System32\\com\\dmp\\" OR src.process.cmdline containsCIS ":\\Windows\\System32\\FxsTmp\\" OR src.process.cmdline containsCIS ":\\Windows\\System32\\Microsoft\\Crypto\\RSA\\MachineKeys\\" OR src.process.cmdline containsCIS ":\\Windows\\System32\\spool\\drivers\\color\\" OR src.process.cmdline containsCIS ":\\Windows\\System32\\spool\\PRINTERS\\" OR src.process.cmdline containsCIS ":\\Windows\\System32\\spool\\SERVERS\\" OR src.process.cmdline containsCIS ":\\Windows\\System32\\Tasks_Migrated\\" OR src.process.cmdline containsCIS ":\\Windows\\System32\\Tasks\\Microsoft\\Windows\\SyncCenter\\" OR src.process.cmdline containsCIS ":\\Windows\\SysWOW64\\com\\dmp\\" OR src.process.cmdline containsCIS ":\\Windows\\SysWOW64\\FxsTmp\\" OR src.process.cmdline containsCIS ":\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\PLA\\System\\" OR src.process.cmdline containsCIS ":\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\SyncCenter\\" OR src.process.cmdline containsCIS ":\\Windows\\Tasks\\" OR src.process.cmdline containsCIS ":\\Windows\\Temp\\" OR src.process.cmdline containsCIS ":\\Windows\\Tracing\\" OR src.process.cmdline containsCIS "\\AppData\\Local\\Temp\\" OR src.process.cmdline containsCIS "\\AppData\\Roaming\\")) AND ((src.process.image.path endswithCIS "\\odbcconf.exe") OR (OriginalFileName = "odbcconf.exe")))
