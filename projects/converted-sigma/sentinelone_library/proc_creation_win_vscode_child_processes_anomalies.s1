// Title: Potentially Suspicious Child Process Of VsCode
// ID: 5a3164f2-b373-4152-93cf-090b13c12d27
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-26
// Tags: attack.execution, attack.stealth, attack.t1218, attack.t1202
// Description: Detects uncommon or suspicious child processes spawning from a VsCode "code.exe" process. This could indicate an attempt of persistence via VsCode tasks or terminal profiles.
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.parent.image.path endswithCIS "\\code.exe") AND (((src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe" OR src.process.image.path endswithCIS "\\cmd.exe") AND (src.process.cmdline containsCIS "Invoke-Expressions" OR src.process.cmdline containsCIS "IEX" OR src.process.cmdline containsCIS "Invoke-Command" OR src.process.cmdline containsCIS "ICM" OR src.process.cmdline containsCIS "DownloadString" OR src.process.cmdline containsCIS "rundll32" OR src.process.cmdline containsCIS "regsvr32" OR src.process.cmdline containsCIS "wscript" OR src.process.cmdline containsCIS "cscript")) OR ((src.process.image.path endswithCIS "\\calc.exe" OR src.process.image.path endswithCIS "\\regsvr32.exe" OR src.process.image.path endswithCIS "\\rundll32.exe" OR src.process.image.path endswithCIS "\\cscript.exe" OR src.process.image.path endswithCIS "\\wscript.exe")) OR ((src.process.image.path containsCIS ":\\Users\\Public\\" OR src.process.image.path containsCIS ":\\Windows\\Temp\\" OR src.process.image.path containsCIS ":\\Temp\\"))))
