// Title: Execute From Alternate Data Streams
// ID: 7f43c430-5001-4f8b-aaa9-c3b88f18fa5c
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-09-01
// Tags: attack.stealth, attack.t1564.004
// Description: Detects execution from an Alternate Data Stream (ADS). Adversaries may use NTFS file attributes to hide their malicious data in order to evade detection
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.cmdline containsCIS "txt:") AND (((src.process.cmdline containsCIS "esentutl " AND src.process.cmdline containsCIS " /y " AND src.process.cmdline containsCIS " /d " AND src.process.cmdline containsCIS " /o ")) OR ((src.process.cmdline containsCIS "makecab " AND src.process.cmdline containsCIS ".cab")) OR ((src.process.cmdline containsCIS "reg " AND src.process.cmdline containsCIS " export ")) OR ((src.process.cmdline containsCIS "regedit " AND src.process.cmdline containsCIS " /E ")) OR ((src.process.cmdline containsCIS "type " AND src.process.cmdline containsCIS " > "))))
