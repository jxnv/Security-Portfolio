// Title: File Download Via Nscurl - MacOS
// ID: 6d8a7cf1-8085-423b-b87d-7e880faabbdf
// Status: test
// Level: medium
// Author: Daniel Cortez
// Date: 2024-06-04
// Tags: attack.command-and-control, attack.t1105
// Description: Detects the execution of the nscurl utility in order to download files.
// Converted by: Sigma Universal SIEM/EDR CLI

(src.process.image.path endswithCIS "/nscurl" AND (src.process.cmdline containsCIS "--download " OR src.process.cmdline containsCIS "--download-directory " OR src.process.cmdline containsCIS "--output " OR src.process.cmdline containsCIS "-dir " OR src.process.cmdline containsCIS "-dl " OR src.process.cmdline containsCIS "-ld" OR src.process.cmdline containsCIS "-o "))
