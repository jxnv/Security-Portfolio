// Description: Detects uncommon network connections to the Active Directory Web Services (ADWS) from processes not typically associated with ADWS management.
// Converted by: Sigma Universal SIEM/EDR CLI

((Initiated = "True" AND DestinationPort = "9389") AND NOT (((src.process.image.path = "C:\\Windows\\system32\\dsac.exe") OR (src.process.image.path = "C:\\Program Files\\Microsoft Monitoring Agent\\") OR ((src.process.image.path startswithCIS "C:\\Program Files\\PowerShell\\7\\pwsh.exe" OR src.process.image.path startswithCIS "C:\\Program Files\\PowerShell\\7-preview\\pwsh.ex" OR src.process.image.path startswithCIS "C:\\Windows\\System32\\WindowsPowerShell\\" OR src.process.image.path startswithCIS "C:\\Windows\\SysWOW64\\WindowsPowerShell\\")))))
