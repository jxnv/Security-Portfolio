// Title: Chromium Browser Headless Execution To Mockbin Like Site
// ID: 1c526788-0abe-4713-862f-b520da5e5316
// Status: test
// Level: high
// Author: X__Junior (Nextron Systems)
// Date: 2023-09-11
// Tags: attack.execution
// Description: Detects the execution of a Chromium based browser process with the "headless" flag and a URL pointing to the mockbin.org service (which can be used to exfiltrate data).
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.cmdline containsCIS "--headless") AND ((src.process.image.path endswithCIS "\\brave.exe" OR src.process.image.path endswithCIS "\\chrome.exe" OR src.process.image.path endswithCIS "\\msedge.exe" OR src.process.image.path endswithCIS "\\opera.exe" OR src.process.image.path endswithCIS "\\vivaldi.exe")) AND ((src.process.cmdline containsCIS "://run.mocky" OR src.process.cmdline containsCIS "://mockbin")))
