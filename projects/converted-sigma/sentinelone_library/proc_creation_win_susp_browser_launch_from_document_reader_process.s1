// Title: Potential Suspicious Browser Launch From Document Reader Process
// ID: 1193d960-2369-499f-a158-7b50a31df682
// Status: test
// Level: medium
// Author: Joseph Kamau
// Date: 2024-05-27
// Tags: attack.execution, attack.t1204.002
// Description: Detects when a browser process or browser tab is launched from an application that handles document files such as Adobe, Microsoft Office, etc. And connects to a web application over http(s), this could indicate a possible phishing attempt.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.parent.image.path containsCIS "Acrobat Reader" OR src.process.parent.image.path containsCIS "Microsoft Office" OR src.process.parent.image.path containsCIS "PDF Reader") AND (src.process.image.path endswithCIS "\\brave.exe" OR src.process.image.path endswithCIS "\\chrome.exe" OR src.process.image.path endswithCIS "\\firefox.exe" OR src.process.image.path endswithCIS "\\msedge.exe" OR src.process.image.path endswithCIS "\\opera.exe" OR src.process.image.path endswithCIS "\\maxthon.exe" OR src.process.image.path endswithCIS "\\seamonkey.exe" OR src.process.image.path endswithCIS "\\vivaldi.exe") AND src.process.cmdline containsCIS "http") AND NOT ((src.process.cmdline containsCIS "https://go.microsoft.com/fwlink/")) AND NOT (((src.process.cmdline containsCIS "http://ad.foxitsoftware.com/adlog.php?" OR src.process.cmdline containsCIS "https://globe-map.foxitservice.com/go.php?do=redirect"))))
