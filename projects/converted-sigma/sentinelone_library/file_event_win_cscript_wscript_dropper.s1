// Title: WScript or CScript Dropper - File
// ID: 002bdb95-0cf1-46a6-9e08-d38c128a6127
// Status: test
// Level: high
// Author: Tim Shelton
// Date: 2022-01-10
// Tags: attack.execution, attack.t1059.005, attack.t1059.007
// Description: Detects a file ending in jse, vbe, js, vba, vbs, wsf, wsh written by cscript.exe or wscript.exe
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path endswithCIS "\\wscript.exe" OR src.process.image.path endswithCIS "\\cscript.exe") AND (tgt.file.path containsCIS ":\\Perflogs\\" OR tgt.file.path containsCIS ":\\ProgramData\\" OR tgt.file.path containsCIS ":\\Temp\\" OR tgt.file.path containsCIS ":\\Tmp\\" OR tgt.file.path containsCIS ":\\Users\\" OR tgt.file.path containsCIS ":\\Windows\\Temp\\" OR tgt.file.path containsCIS "\\AppData\\Local\\Temp" OR tgt.file.path containsCIS "\\AppData\\Roaming\\Temp" OR tgt.file.path containsCIS "\\Start Menu\\Programs\\Startup\\" OR tgt.file.path containsCIS "\\Temporary Internet") AND (tgt.file.path endswithCIS ".js" OR tgt.file.path endswithCIS ".jse" OR tgt.file.path endswithCIS ".vba" OR tgt.file.path endswithCIS ".vbe" OR tgt.file.path endswithCIS ".vbs" OR tgt.file.path endswithCIS ".wsf" OR tgt.file.path endswithCIS ".wsh"))
