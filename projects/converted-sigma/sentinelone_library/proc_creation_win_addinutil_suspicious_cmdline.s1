// Title: Suspicious AddinUtil.EXE CommandLine Execution
// ID: 631b22a4-70f4-4e2f-9ea8-42f84d9df6d8
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Michael McKinley (@McKinleyMike), Tony Latteri (@TheLatteri)
// Date: 2023-09-18
// Tags: attack.stealth, attack.t1218
// Description: Detects execution of the Add-In deployment cache updating utility (AddInutil.exe) with suspicious Addinroot or Pipelineroot paths. An adversary may execute AddinUtil.exe with uncommon Addinroot/Pipelineroot paths that point to the adversaries Addins.Store payload.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "\\addinutil.exe") OR (OriginalFileName = "AddInUtil.exe")) AND ((((src.process.cmdline containsCIS "-AddInRoot:" OR src.process.cmdline containsCIS "-PipelineRoot:")) AND ((src.process.cmdline containsCIS "\\AppData\\Local\\Temp\\" OR src.process.cmdline containsCIS "\\Desktop\\" OR src.process.cmdline containsCIS "\\Downloads\\" OR src.process.cmdline containsCIS "\\Users\\Public\\" OR src.process.cmdline containsCIS "\\Windows\\Temp\\"))) OR ((src.process.cmdline containsCIS "-AddInRoot:." OR src.process.cmdline containsCIS "-AddInRoot:\".\"" OR src.process.cmdline containsCIS "-PipelineRoot:." OR src.process.cmdline containsCIS "-PipelineRoot:\".\"") AND (CurrentDirectory containsCIS "\\AppData\\Local\\Temp\\" OR CurrentDirectory containsCIS "\\Desktop\\" OR CurrentDirectory containsCIS "\\Downloads\\" OR CurrentDirectory containsCIS "\\Users\\Public\\" OR CurrentDirectory containsCIS "\\Windows\\Temp\\"))))
