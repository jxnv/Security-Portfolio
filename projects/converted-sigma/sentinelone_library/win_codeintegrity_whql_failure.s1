// Description: Detects loaded kernel modules that did not meet the WHQL signing requirements.
// Converted by: Sigma Universal SIEM/EDR CLI

(((EventID = "3082" OR EventID = "3083")) AND NOT (((FileNameBuffer = "system32\\drivers\\vsock.sys" OR FileNameBuffer = "System32\\drivers\\vmci.sys"))))
