// Title: Potential Browser Data Stealing
// ID: 47147b5b-9e17-4d76-b8d2-7bac24c5ce1b
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-23
// Tags: attack.credential-access, attack.t1555.003
// Description: Adversaries may acquire credentials from web browsers by reading files specific to the target browser.
// Web browsers commonly save credentials such as website usernames and passwords so that they do not need to be entered manually in the future.
// Web browsers typically store the credentials in an encrypted format within a credential store.
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.cmdline containsCIS "copy-item" OR src.process.cmdline containsCIS "copy " OR src.process.cmdline containsCIS "cpi " OR src.process.cmdline containsCIS " cp " OR src.process.cmdline containsCIS "move " OR src.process.cmdline containsCIS "move-item" OR src.process.cmdline containsCIS " mi " OR src.process.cmdline containsCIS " mv ")) OR ((src.process.image.path endswithCIS "\\esentutl.exe" OR src.process.image.path endswithCIS "\\xcopy.exe" OR src.process.image.path endswithCIS "\\robocopy.exe")) OR ((OriginalFileName = "esentutl.exe" OR OriginalFileName = "XCOPY.EXE" OR OriginalFileName = "robocopy.exe"))) AND ((src.process.cmdline containsCIS "\\Amigo\\User Data" OR src.process.cmdline containsCIS "\\BraveSoftware\\Brave-Browser\\User Data" OR src.process.cmdline containsCIS "\\CentBrowser\\User Data" OR src.process.cmdline containsCIS "\\Chromium\\User Data" OR src.process.cmdline containsCIS "\\CocCoc\\Browser\\User Data" OR src.process.cmdline containsCIS "\\Comodo\\Dragon\\User Data" OR src.process.cmdline containsCIS "\\Elements Browser\\User Data" OR src.process.cmdline containsCIS "\\Epic Privacy Browser\\User Data" OR src.process.cmdline containsCIS "\\Google\\Chrome Beta\\User Data" OR src.process.cmdline containsCIS "\\Google\\Chrome SxS\\User Data" OR src.process.cmdline containsCIS "\\Google\\Chrome\\User Data\\" OR src.process.cmdline containsCIS "\\Kometa\\User Data" OR src.process.cmdline containsCIS "\\Maxthon5\\Users" OR src.process.cmdline containsCIS "\\Microsoft\\Edge\\User Data" OR src.process.cmdline containsCIS "\\Mozilla\\Firefox\\Profiles" OR src.process.cmdline containsCIS "\\Nichrome\\User Data" OR src.process.cmdline containsCIS "\\Opera Software\\Opera GX Stable\\" OR src.process.cmdline containsCIS "\\Opera Software\\Opera Neon\\User Data" OR src.process.cmdline containsCIS "\\Opera Software\\Opera Stable\\" OR src.process.cmdline containsCIS "\\Orbitum\\User Data" OR src.process.cmdline containsCIS "\\QIP Surf\\User Data" OR src.process.cmdline containsCIS "\\Sputnik\\User Data" OR src.process.cmdline containsCIS "\\Torch\\User Data" OR src.process.cmdline containsCIS "\\uCozMedia\\Uran\\User Data" OR src.process.cmdline containsCIS "\\Vivaldi\\User Data")))
