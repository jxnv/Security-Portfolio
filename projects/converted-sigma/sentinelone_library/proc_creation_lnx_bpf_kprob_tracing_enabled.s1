// Title: Enable BPF Kprobes Tracing
// ID: 7692f583-bd30-4008-8615-75dab3f08a99
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-25
// Tags: attack.execution, attack.stealth
// Description: Detects common command used to enable bpf kprobes tracing
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.cmdline containsCIS "echo 1 >" AND src.process.cmdline containsCIS "/sys/kernel/debug/tracing/events/kprobes/") AND (src.process.cmdline containsCIS "/myprobe/enable" OR src.process.cmdline containsCIS "/myretprobe/enable"))
