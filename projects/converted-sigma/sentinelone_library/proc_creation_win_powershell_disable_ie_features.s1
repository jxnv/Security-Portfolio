// Title: Disabled IE Security Features
// ID: fb50eb7a-5ab1-43ae-bcc9-091818cb8424
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2020-06-19
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects command lines that indicate unwanted modifications to registry keys that disable important Internet Explorer security features
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS " -name IEHarden " AND src.process.cmdline containsCIS " -value 0 ")) OR ((src.process.cmdline containsCIS " -name DEPOff " AND src.process.cmdline containsCIS " -value 1 ")) OR ((src.process.cmdline containsCIS " -name DisableFirstRunCustomize " AND src.process.cmdline containsCIS " -value 2 ")))
