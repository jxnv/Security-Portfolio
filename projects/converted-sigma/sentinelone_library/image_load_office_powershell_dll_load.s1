// Title: PowerShell Core DLL Loaded Via Office Application
// ID: bb2ba6fb-95d4-4a25-89fc-30bb736c021a
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-01
// Tags: attack.stealth
// Description: Detects PowerShell core DLL being loaded by an Office Product
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path endswithCIS "\\excel.exe" OR src.process.image.path endswithCIS "\\mspub.exe" OR src.process.image.path endswithCIS "\\outlook.exe" OR src.process.image.path endswithCIS "\\onenote.exe" OR src.process.image.path endswithCIS "\\onenoteim.exe" OR src.process.image.path endswithCIS "\\powerpnt.exe" OR src.process.image.path endswithCIS "\\winword.exe") AND (ImageLoaded containsCIS "\\System.Management.Automation.Dll" OR ImageLoaded containsCIS "\\System.Management.Automation.ni.Dll"))
