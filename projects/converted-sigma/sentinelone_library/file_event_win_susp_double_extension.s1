// Title: Suspicious Double Extension Files
// ID: b4926b47-a9d7-434c-b3a0-adc3fa0bd13e
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), frack113
// Date: 2022-06-19
// Tags: attack.stealth, attack.t1036.007
// Description: Detects dropped files with double extensions, which is often used by malware as a method to abuse the fact that Windows hide default extensions by default.
// Converted by: Sigma Universal SIEM/EDR CLI

((((tgt.file.path endswithCIS ".rar.exe" OR tgt.file.path endswithCIS ".zip.exe")) OR ((tgt.file.path endswithCIS ".exe" OR tgt.file.path endswithCIS ".iso" OR tgt.file.path endswithCIS ".rar" OR tgt.file.path endswithCIS ".svg" OR tgt.file.path endswithCIS ".zip") AND (tgt.file.path containsCIS ".doc." OR tgt.file.path containsCIS ".docx." OR tgt.file.path containsCIS ".gif." OR tgt.file.path containsCIS ".jpeg." OR tgt.file.path containsCIS ".jpg." OR tgt.file.path containsCIS ".mp3." OR tgt.file.path containsCIS ".mp4." OR tgt.file.path containsCIS ".pdf." OR tgt.file.path containsCIS ".png." OR tgt.file.path containsCIS ".ppt." OR tgt.file.path containsCIS ".pptx." OR tgt.file.path containsCIS ".rtf." OR tgt.file.path containsCIS ".svg." OR tgt.file.path containsCIS ".txt." OR tgt.file.path containsCIS ".xls." OR tgt.file.path containsCIS ".xlsx."))) AND NOT ((tgt.file.path startswithCIS "/usr/share/icons/")))
