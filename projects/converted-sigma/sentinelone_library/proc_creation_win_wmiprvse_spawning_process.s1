// Title: WmiPrvSE Spawned A Process
// ID: d21374ff-f574-44a7-9998-4a8c8bf33d7d
// Status: stable
// Level: medium
// Author: Roberto Rodriguez @Cyb3rWard0g
// Date: 2019-08-15
// Tags: attack.execution, attack.t1047
// Description: Detects WmiPrvSE spawning a process
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.parent.image.path endswithCIS "\\WmiPrvSe.exe") AND NOT ((((LogonId = "0x3e7" OR LogonId = "null")) OR (LogonId is null) OR ((src.process.user containsCIS "AUTHORI" OR src.process.user containsCIS "AUTORI")) OR (src.process.image.path endswithCIS "\\WerFault.exe") OR (src.process.image.path endswithCIS "\\WmiPrvSE.exe"))))
