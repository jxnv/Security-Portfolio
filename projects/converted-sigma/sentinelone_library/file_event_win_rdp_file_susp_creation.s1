// Title: .RDP File Created By Uncommon Application
// ID: fccfb43e-09a7-4bd2-8b37-a5a7df33386d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.stealth
// Description: Detects creation of a file with an ".rdp" extension by an application that doesn't commonly create such files.
// Converted by: Sigma Universal SIEM/EDR CLI

(tgt.file.path endswithCIS ".rdp" AND (src.process.image.path endswithCIS "\\brave.exe" OR src.process.image.path endswithCIS "\\CCleaner Browser\\Application\\CCleanerBrowser.exe" OR src.process.image.path endswithCIS "\\chromium.exe" OR src.process.image.path endswithCIS "\\firefox.exe" OR src.process.image.path endswithCIS "\\Google\\Chrome\\Application\\chrome.exe" OR src.process.image.path endswithCIS "\\iexplore.exe" OR src.process.image.path endswithCIS "\\microsoftedge.exe" OR src.process.image.path endswithCIS "\\msedge.exe" OR src.process.image.path endswithCIS "\\Opera.exe" OR src.process.image.path endswithCIS "\\Vivaldi.exe" OR src.process.image.path endswithCIS "\\Whale.exe" OR src.process.image.path endswithCIS "\\olk.exe" OR src.process.image.path endswithCIS "\\Outlook.exe" OR src.process.image.path endswithCIS "\\RuntimeBroker.exe" OR src.process.image.path endswithCIS "\\Thunderbird.exe" OR src.process.image.path endswithCIS "\\Discord.exe" OR src.process.image.path endswithCIS "\\Keybase.exe" OR src.process.image.path endswithCIS "\\msteams.exe" OR src.process.image.path endswithCIS "\\Slack.exe" OR src.process.image.path endswithCIS "\\teams.exe"))
