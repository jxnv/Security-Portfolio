// Title: Potential CommandLine Obfuscation Using Unicode Characters From Suspicious Image
// ID: 584bca0f-3608-4402-80fd-4075ff6072e3
// Status: test
// Level: high
// Author: frack113, Florian Roth (Nextron Systems), Josh Nickels
// Date: 2024-09-02
// Tags: attack.stealth, attack.t1027
// Description: Detects potential commandline obfuscation using unicode characters.
// Adversaries may attempt to make an executable or file difficult to discover or analyze by encrypting, encoding, or otherwise obfuscating its contents on the system or in transit.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "\\cmd.exe" OR src.process.image.path endswithCIS "\\cscript.exe" OR src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\powershell_ise.exe" OR src.process.image.path endswithCIS "\\pwsh.exe" OR src.process.image.path endswithCIS "\\wscript.exe") AND (OriginalFileName = "Cmd.EXE" OR OriginalFileName = "cscript.exe" OR OriginalFileName = "PowerShell.EXE" OR OriginalFileName = "PowerShell_ISE.EXE" OR OriginalFileName = "pwsh.dll" OR OriginalFileName = "wscript.exe")) AND ((src.process.cmdline containsCIS "ˣ" OR src.process.cmdline containsCIS "˪" OR src.process.cmdline containsCIS "ˢ" OR src.process.cmdline containsCIS "∕" OR src.process.cmdline containsCIS "⁄" OR src.process.cmdline containsCIS "―" OR src.process.cmdline containsCIS "—" OR src.process.cmdline containsCIS " " OR src.process.cmdline containsCIS "¯" OR src.process.cmdline containsCIS "®" OR src.process.cmdline containsCIS "¶" OR src.process.cmdline containsCIS "⠀")))
