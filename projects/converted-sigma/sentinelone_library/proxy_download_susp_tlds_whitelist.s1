// Title: Download From Suspicious TLD - Whitelist
// ID: b5de2919-b74a-4805-91a7-5049accbaefe
// Status: test
// Level: low
// Author: Florian Roth (Nextron Systems)
// Date: 2017-03-13
// Tags: attack.initial-access, attack.t1566, attack.execution, attack.t1203, attack.t1204.002
// Description: Detects executable downloads from suspicious remote systems
// Converted by: Sigma Universal SIEM/EDR CLI

(((c-uri-extension = "exe" OR c-uri-extension = "vbs" OR c-uri-extension = "bat" OR c-uri-extension = "rar" OR c-uri-extension = "ps1" OR c-uri-extension = "doc" OR c-uri-extension = "docm" OR c-uri-extension = "xls" OR c-uri-extension = "xlsm" OR c-uri-extension = "pptm" OR c-uri-extension = "rtf" OR c-uri-extension = "hta" OR c-uri-extension = "dll" OR c-uri-extension = "ws" OR c-uri-extension = "wsf" OR c-uri-extension = "sct" OR c-uri-extension = "zip")) AND NOT (((cs-host endswithCIS ".com" OR cs-host endswithCIS ".org" OR cs-host endswithCIS ".net" OR cs-host endswithCIS ".edu" OR cs-host endswithCIS ".gov" OR cs-host endswithCIS ".uk" OR cs-host endswithCIS ".ca" OR cs-host endswithCIS ".de" OR cs-host endswithCIS ".jp" OR cs-host endswithCIS ".fr" OR cs-host endswithCIS ".au" OR cs-host endswithCIS ".us" OR cs-host endswithCIS ".ch" OR cs-host endswithCIS ".it" OR cs-host endswithCIS ".nl" OR cs-host endswithCIS ".se" OR cs-host endswithCIS ".no" OR cs-host endswithCIS ".es"))))
