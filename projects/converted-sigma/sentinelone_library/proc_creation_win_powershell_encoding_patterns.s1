// Title: Potential Encoded PowerShell Patterns In CommandLine
// ID: cdf05894-89e7-4ead-b2b0-0a5f97a90f2f
// Status: test
// Level: low
// Author: Teymur Kheirkhabarov (idea), Vasiliy Burov (rule), oscd.community, Tim Shelton
// Date: 2020-10-11
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects specific combinations of encoding methods in PowerShell via the commandline
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe")) OR ((OriginalFileName = "PowerShell.EXE" OR OriginalFileName = "pwsh.dll"))) AND ((((src.process.cmdline containsCIS "ToInt" OR src.process.cmdline containsCIS "ToDecimal" OR src.process.cmdline containsCIS "ToByte" OR src.process.cmdline containsCIS "ToUint" OR src.process.cmdline containsCIS "ToSingle" OR src.process.cmdline containsCIS "ToSByte")) AND ((src.process.cmdline containsCIS "ToChar" OR src.process.cmdline containsCIS "ToString" OR src.process.cmdline containsCIS "String"))) OR (((src.process.cmdline containsCIS "char" AND src.process.cmdline containsCIS "join")) OR ((src.process.cmdline containsCIS "split" AND src.process.cmdline containsCIS "join")))))
