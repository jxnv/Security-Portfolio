// Title: Suspicious ASPX File Drop by Exchange
// ID: bd1212e5-78da-431e-95fa-c58e3237a8e6
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), MSTI (query, idea)
// Date: 2022-10-01
// Tags: attack.persistence, attack.t1505.003
// Description: Detects suspicious file type dropped by an Exchange component in IIS into a suspicious folder
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path endswithCIS "\\w3wp.exe" AND src.process.cmdline containsCIS "MSExchange" AND (tgt.file.path containsCIS "FrontEnd\\HttpProxy\\" OR tgt.file.path containsCIS "\\inetpub\\wwwroot\\aspnet_client\\")) AND ((tgt.file.path endswithCIS ".aspx" OR tgt.file.path endswithCIS ".asp" OR tgt.file.path endswithCIS ".ashx")))
