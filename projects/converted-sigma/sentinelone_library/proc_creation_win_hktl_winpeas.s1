((src.process.cmdline containsCIS "https://github.com/carlospolop/PEASS-ng/releases/latest/download/") OR ((src.process.cmdline containsCIS " applicationsinfo" OR src.process.cmdline containsCIS " browserinfo" OR src.process.cmdline containsCIS " eventsinfo" OR src.process.cmdline containsCIS " fileanalysis" OR src.process.cmdline containsCIS " filesinfo" OR src.process.cmdline containsCIS " processinfo" OR src.process.cmdline containsCIS " servicesinfo" OR src.process.cmdline containsCIS " windowscreds")) OR ((src.process.parent.cmdline endswithCIS " -linpeas") OR (src.process.cmdline endswithCIS " -linpeas")) OR ((OriginalFileName = "winPEAS.exe") OR ((src.process.image.path endswithCIS "\\winPEASany_ofs.exe" OR src.process.image.path endswithCIS "\\winPEASany.exe" OR src.process.image.path endswithCIS "\\winPEASx64_ofs.exe" OR src.process.image.path endswithCIS "\\winPEASx64.exe" OR src.process.image.path endswithCIS "\\winPEASx86_ofs.exe" OR src.process.image.path endswithCIS "\\winPEASx86.exe"))))
