// Title: BITS Transfer Job Download From Direct IP
// ID: 90f138c1-f578-4ac3-8c49-eecfd847c8b7
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-11
// Tags: attack.persistence, attack.execution, attack.stealth, attack.t1197
// Description: Detects a BITS transfer job downloading file(s) from a direct IP address.
// Converted by: Sigma Universal SIEM/EDR CLI

((EventID = "16403" AND (RemoteName containsCIS "http://1" OR RemoteName containsCIS "http://2" OR RemoteName containsCIS "http://3" OR RemoteName containsCIS "http://4" OR RemoteName containsCIS "http://5" OR RemoteName containsCIS "http://6" OR RemoteName containsCIS "http://7" OR RemoteName containsCIS "http://8" OR RemoteName containsCIS "http://9" OR RemoteName containsCIS "https://1" OR RemoteName containsCIS "https://2" OR RemoteName containsCIS "https://3" OR RemoteName containsCIS "https://4" OR RemoteName containsCIS "https://5" OR RemoteName containsCIS "https://6" OR RemoteName containsCIS "https://7" OR RemoteName containsCIS "https://8" OR RemoteName containsCIS "https://9")) AND NOT ((((RemoteName containsCIS "://10." OR RemoteName containsCIS "://192.168." OR RemoteName containsCIS "://172.16." OR RemoteName containsCIS "://172.17." OR RemoteName containsCIS "://172.18." OR RemoteName containsCIS "://172.19." OR RemoteName containsCIS "://172.20." OR RemoteName containsCIS "://172.21." OR RemoteName containsCIS "://172.22." OR RemoteName containsCIS "://172.23." OR RemoteName containsCIS "://172.24." OR RemoteName containsCIS "://172.25." OR RemoteName containsCIS "://172.26." OR RemoteName containsCIS "://172.27." OR RemoteName containsCIS "://172.28." OR RemoteName containsCIS "://172.29." OR RemoteName containsCIS "://172.30." OR RemoteName containsCIS "://172.31." OR RemoteName containsCIS "://127." OR RemoteName containsCIS "://169.254.")) OR ((RemoteName containsCIS "https://7-" OR RemoteName containsCIS "http://7-")))))
