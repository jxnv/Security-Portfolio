// Title: Suspicious PowerShell Invocations - Specific - ProcessCreation
// ID: 536e2947-3729-478c-9903-745aaffe60d2
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-05
// Tags: attack.stealth
// Description: Detects suspicious PowerShell invocation command parameters
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.cmdline containsCIS "-nop" AND src.process.cmdline containsCIS " -w " AND src.process.cmdline containsCIS "hidden" AND src.process.cmdline containsCIS " -c " AND src.process.cmdline containsCIS "[Convert]::FromBase64String")) OR ((src.process.cmdline containsCIS " -w " AND src.process.cmdline containsCIS "hidden" AND src.process.cmdline containsCIS "-ep" AND src.process.cmdline containsCIS "bypass" AND src.process.cmdline containsCIS "-Enc")) OR ((src.process.cmdline containsCIS " -w " AND src.process.cmdline containsCIS "hidden" AND src.process.cmdline containsCIS "-noni" AND src.process.cmdline containsCIS "-nop" AND src.process.cmdline containsCIS " -c " AND src.process.cmdline containsCIS "iex" AND src.process.cmdline containsCIS "New-Object")) OR ((src.process.cmdline containsCIS "iex" AND src.process.cmdline containsCIS "New-Object" AND src.process.cmdline containsCIS "Net.WebClient" AND src.process.cmdline containsCIS ".Download")) OR ((src.process.cmdline containsCIS "powershell" AND src.process.cmdline containsCIS "reg" AND src.process.cmdline containsCIS "add" AND src.process.cmdline containsCIS "\\software\\")) OR ((src.process.cmdline containsCIS "bypass" AND src.process.cmdline containsCIS "-noprofile" AND src.process.cmdline containsCIS "-windowstyle" AND src.process.cmdline containsCIS "hidden" AND src.process.cmdline containsCIS "new-object" AND src.process.cmdline containsCIS "system.net.webclient" AND src.process.cmdline containsCIS ".download"))) AND NOT (((src.process.cmdline containsCIS "(New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1" OR src.process.cmdline containsCIS "Write-ChocolateyWarning"))))
