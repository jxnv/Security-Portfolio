// Title: Suspicious BitLocker Access Agent Update Utility Execution
// ID: 9f38c1db-e2ae-40bf-81d0-5b68f73fb512
// Status: experimental
// Level: high
// Author: andrewdanis, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-10-18
// Tags: attack.stealth, attack.t1218, attack.lateral-movement, attack.t1021.003
// Description: Detects the execution of the BitLocker Access Agent Update Utility (baaupdate.exe) which is not a common parent process for other processes.
// Suspicious child processes spawned by baaupdate.exe could indicate an attempt at lateral movement via BitLocker DCOM & COM Hijacking.
// Converted by: Sigma Universal SIEM/EDR CLI

(src.process.parent.image.path endswithCIS "\\baaupdate.exe" AND (src.process.image.path endswithCIS "\\bitsadmin.exe" OR src.process.image.path endswithCIS "\\cmd.exe" OR src.process.image.path endswithCIS "\\cscript.exe" OR src.process.image.path endswithCIS "\\mshta.exe" OR src.process.image.path endswithCIS "\\powershell_ise.exe" OR src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\regsvr32.exe" OR src.process.image.path endswithCIS "\\rundll32.exe" OR src.process.image.path endswithCIS "\\schtasks.exe" OR src.process.image.path endswithCIS "\\wmic.exe" OR src.process.image.path endswithCIS "\\wscript.exe"))
