// Title: Suspicious Network Command
// ID: a29c1813-ab1f-4dde-b489-330b952e91ae
// Status: test
// Level: low
// Author: frack113, Christopher Peacock '@securepeacock', SCYTHE '@scythe_io'
// Date: 2021-12-07
// Tags: attack.discovery, attack.t1016
// Description: Adversaries may look for details about the network configuration and settings of systems they access or through information discovery of remote systems
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.cmdline RegEx "ipconfig\s+/all" OR src.process.cmdline RegEx "netsh\s+interface show interface" OR src.process.cmdline RegEx "arp\s+-a" OR src.process.cmdline RegEx "nbtstat\s+-n" OR src.process.cmdline RegEx "net\s+config" OR src.process.cmdline RegEx "route\s+print"))
