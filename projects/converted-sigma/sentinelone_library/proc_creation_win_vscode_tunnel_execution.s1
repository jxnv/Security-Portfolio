// Title: Visual Studio Code Tunnel Execution
// ID: 90d6bd71-dffb-4989-8d86-a827fedd6624
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), citron_ninja
// Date: 2023-10-25
// Tags: attack.command-and-control, attack.t1071.001, attack.t1219
// Description: Detects Visual Studio Code tunnel execution. Attackers can abuse this functionality to establish a C2 channel
// Converted by: Sigma Universal SIEM/EDR CLI

((OriginalFileName is null AND src.process.cmdline endswithCIS ".exe tunnel") OR (src.process.parent.cmdline endswithCIS " tunnel" AND src.process.image.path endswithCIS "\\cmd.exe" AND (src.process.cmdline containsCIS "/d /c " AND src.process.cmdline containsCIS "\\servers\\Stable-" AND src.process.cmdline containsCIS "code-server.cmd")) OR ((src.process.cmdline containsCIS ".exe tunnel" AND src.process.cmdline containsCIS "--accept-server-license-terms")))
