(((((GrantedAccess endswithCIS "30" OR GrantedAccess endswithCIS "50" OR GrantedAccess endswithCIS "70" OR GrantedAccess endswithCIS "90" OR GrantedAccess endswithCIS "B0" OR GrantedAccess endswithCIS "D0" OR GrantedAccess endswithCIS "F0" OR GrantedAccess endswithCIS "18" OR GrantedAccess endswithCIS "38" OR GrantedAccess endswithCIS "58" OR GrantedAccess endswithCIS "78" OR GrantedAccess endswithCIS "98" OR GrantedAccess endswithCIS "B8" OR GrantedAccess endswithCIS "D8" OR GrantedAccess endswithCIS "F8" OR GrantedAccess endswithCIS "1A" OR GrantedAccess endswithCIS "3A" OR GrantedAccess endswithCIS "5A" OR GrantedAccess endswithCIS "7A" OR GrantedAccess endswithCIS "9A" OR GrantedAccess endswithCIS "BA" OR GrantedAccess endswithCIS "DA" OR GrantedAccess endswithCIS "FA" OR GrantedAccess endswithCIS "0x14C2")) OR ((GrantedAccess startswithCIS "0x100000" OR GrantedAccess startswithCIS "0x1418" OR GrantedAccess startswithCIS "0x1438" OR GrantedAccess startswithCIS "0x143a" OR GrantedAccess startswithCIS "0x1f0fff" OR GrantedAccess startswithCIS "0x1f1fff" OR GrantedAccess startswithCIS "0x1f2fff" OR GrantedAccess startswithCIS "0x1f3fff" OR GrantedAccess startswithCIS "0x40"))) AND (TargetImage endswithCIS "\\lsass.exe")) AND NOT (((SourceImage endswithCIS "\\explorer.exe" AND GrantedAccess = "0x401") OR ((SourceImage containsCIS ":\\Program Files (x86)\\" OR SourceImage containsCIS ":\\Program Files\\" OR SourceImage containsCIS ":\\Windows\\System32\\" OR SourceImage containsCIS ":\\Windows\\SysWOW64\\")) OR (SourceImage containsCIS ":\\ProgramData\\Microsoft\\Windows Defender\\" AND SourceImage endswithCIS "\\MsMpEng.exe") OR ((CallTrace containsCIS "|?:\\ProgramData\\Microsoft\\Windows Defender\\Definition Updates\\{" AND CallTrace containsCIS "}\\mpengine.dll+") AND GrantedAccess = "0x1418") OR ((CallTrace containsCIS "|c:\\program files\\windows defender\\mprtp.dll" OR CallTrace containsCIS "|c:\\program files\\windows defender\\MpClient.dll")))) AND NOT (((SourceImage endswithCIS ":\\ProgramData\\MALWAREBYTES\\MBAMSERVICE\\ctlrupdate\\mbupdatr.exe") OR (SourceImage endswithCIS "\\MBAMInstallerService.exe" AND GrantedAccess = "0x40") OR ((SourceImage endswithCIS "\\aurora-agent-64.exe" OR SourceImage endswithCIS "\\aurora-agent.exe" OR SourceImage endswithCIS "\\thor.exe" OR SourceImage endswithCIS "\\thor64.exe") AND GrantedAccess = "0x40") OR (SourceImage containsCIS "\\SteamLibrary\\steamapps\\") OR ((SourceImage endswithCIS "\\handle.exe" OR SourceImage endswithCIS "\\handle64.exe" OR SourceImage endswithCIS "\\handle64a.exe") AND GrantedAccess = "0x40") OR ((SourceImage endswithCIS "\\PROCEXP64.EXE" OR SourceImage endswithCIS "\\PROCEXP.EXE") AND GrantedAccess = "0x40") OR (SourceImage containsCIS ":\\ProgramData\\VMware\\VMware Tools\\" AND SourceImage endswithCIS "\\vmtoolsd.exe") OR (SourceImage endswithCIS "\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe") OR (SourceImage endswithCIS "\\AppData\\Local\\WebEx\\WebexHost.exe" AND GrantedAccess = "0x401"))))
