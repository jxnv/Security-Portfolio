// Title: Suspicious Download from Office Domain
// ID: 00d49ed5-4491-4271-a8db-650a4ef6f8c1
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-12-27
// Tags: attack.command-and-control, attack.resource-development, attack.t1105, attack.t1608
// Description: Detects suspicious ways to download files from Microsoft domains that are used to store attachments in Emails or OneNote documents
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "https://attachment.outlook.live.net/owa/" OR src.process.cmdline containsCIS "https://onenoteonlinesync.onenote.com/onenoteonlinesync/")) AND (((src.process.image.path endswithCIS "\\curl.exe" OR src.process.image.path endswithCIS "\\wget.exe")) OR ((src.process.cmdline containsCIS "Invoke-WebRequest" OR src.process.cmdline containsCIS "iwr " OR src.process.cmdline containsCIS "curl " OR src.process.cmdline containsCIS "wget " OR src.process.cmdline containsCIS "Start-BitsTransfer" OR src.process.cmdline containsCIS ".DownloadFile(" OR src.process.cmdline containsCIS ".DownloadString("))))
