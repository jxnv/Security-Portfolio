// Title: PUA - Chisel Tunneling Tool Execution
// ID: 8b0e12da-d3c3-49db-bb4f-256703f380e5
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-09-13
// Tags: attack.command-and-control, attack.t1090.001
// Description: Detects usage of the Chisel tunneling tool via the commandline arguments
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path endswithCIS "\\chisel.exe") OR (((src.process.cmdline containsCIS "exe client " OR src.process.cmdline containsCIS "exe server ")) AND ((src.process.cmdline containsCIS "-socks5" OR src.process.cmdline containsCIS "-reverse" OR src.process.cmdline containsCIS " r:" OR src.process.cmdline containsCIS ":127.0.0.1:" OR src.process.cmdline containsCIS "-tls-skip-verify " OR src.process.cmdline containsCIS ":socks"))))
