// Title: File and Directory Discovery - MacOS
// ID: 089dbdf6-b960-4bcc-90e3-ffc3480c20f6
// Status: test
// Level: informational
// Author: Daniil Yugoslavskiy, oscd.community
// Date: 2020-10-19
// Tags: attack.discovery, attack.t1083
// Description: Detects usage of system utilities to discover files and directories
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path = "/usr/bin/file" AND src.process.cmdline RegEx "(.){200,}") OR (src.process.image.path = "/usr/bin/find") OR (src.process.image.path = "/usr/bin/mdfind") OR (src.process.image.path = "/bin/ls" AND src.process.cmdline containsCIS "-R") OR 1=1)
