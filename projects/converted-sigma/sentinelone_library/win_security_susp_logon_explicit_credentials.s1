// Title: Suspicious Remote Logon with Explicit Credentials
// ID: 941e5c45-cda7-4864-8cea-bbb7458d194a
// Status: test
// Level: medium
// Author: oscd.community, Teymur Kheirkhabarov @HeirhabarovT, Zach Stanford @svch0st, Tim Shelton
// Date: 2020-10-05
// Tags: attack.privilege-escalation, attack.persistence, attack.initial-access, attack.stealth, attack.t1078, attack.lateral-movement
// Description: Detects suspicious processes logging on with explicit credentials
// Converted by: Sigma Universal SIEM/EDR CLI

((EventID = "4648" AND (ProcessName endswithCIS "\\cmd.exe" OR ProcessName endswithCIS "\\powershell.exe" OR ProcessName endswithCIS "\\pwsh.exe" OR ProcessName endswithCIS "\\winrs.exe" OR ProcessName endswithCIS "\\wmic.exe" OR ProcessName endswithCIS "\\net.exe" OR ProcessName endswithCIS "\\net1.exe" OR ProcessName endswithCIS "\\reg.exe")) AND NOT (((TargetServerName = "localhost") OR (SubjectUserName endswithCIS "$" AND TargetUserName endswithCIS "$"))))
