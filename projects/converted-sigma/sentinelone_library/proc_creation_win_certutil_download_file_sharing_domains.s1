// Title: Suspicious File Downloaded From File-Sharing Website Via Certutil.EXE
// ID: 42a5f1e7-9603-4f6d-97ae-3f37d130d794
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-15
// Tags: attack.stealth, attack.t1027, attack.command-and-control, attack.t1105
// Description: Detects the execution of certutil with certain flags that allow the utility to download files from file-sharing websites.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "urlcache " OR src.process.cmdline containsCIS "verifyctl " OR src.process.cmdline containsCIS "URL ")) AND ((src.process.cmdline containsCIS ".githubusercontent.com" OR src.process.cmdline containsCIS "0x0.st" OR src.process.cmdline containsCIS "anonfiles.com" OR src.process.cmdline containsCIS "bashupload.com" OR src.process.cmdline containsCIS "cdn.discordapp.com" OR src.process.cmdline containsCIS "chunk.io" OR src.process.cmdline containsCIS "ddns.net" OR src.process.cmdline containsCIS "dl.dropboxusercontent.com" OR src.process.cmdline containsCIS "ghostbin.co" OR src.process.cmdline containsCIS "github.com" OR src.process.cmdline containsCIS "glitch.me" OR src.process.cmdline containsCIS "gofile.io" OR src.process.cmdline containsCIS "hastebin.com" OR src.process.cmdline containsCIS "mediafire.com" OR src.process.cmdline containsCIS "mega.nz" OR src.process.cmdline containsCIS "onrender.com" OR src.process.cmdline containsCIS "pages.dev" OR src.process.cmdline containsCIS "paste.ee" OR src.process.cmdline containsCIS "pastebin.com" OR src.process.cmdline containsCIS "pastebin.pl" OR src.process.cmdline containsCIS "pastetext.net" OR src.process.cmdline containsCIS "privatlab.com" OR src.process.cmdline containsCIS "privatlab.net" OR src.process.cmdline containsCIS "send.exploit.in" OR src.process.cmdline containsCIS "sendspace.com" OR src.process.cmdline containsCIS "storage.googleapis.com" OR src.process.cmdline containsCIS "storjshare.io" OR src.process.cmdline containsCIS "supabase.co" OR src.process.cmdline containsCIS "temp.sh" OR src.process.cmdline containsCIS "transfer.sh" OR src.process.cmdline containsCIS "trycloudflare.com" OR src.process.cmdline containsCIS "ufile.io" OR src.process.cmdline containsCIS "w3spaces.com" OR src.process.cmdline containsCIS "workers.dev" OR src.process.cmdline containsCIS "x0.at")) AND ((src.process.image.path endswithCIS "\\certutil.exe") OR (OriginalFileName = "CertUtil.exe")))
