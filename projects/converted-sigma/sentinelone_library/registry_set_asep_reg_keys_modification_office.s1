// Description: Detects modification of autostart extensibility point (ASEP) in registry. Adversaries may modify these keys to execute malicious code when Office files are opened.
// There are various legitimate add-ins that also use these keys and this filter list might not be exhaustive.
// Thus, it is recommended to review and tune filters for your environment to reduce false positives before deploying to production.
// Converted by: Sigma Universal SIEM/EDR CLI

((((TargetObject containsCIS "\\Word\\Addins" OR TargetObject containsCIS "\\PowerPoint\\Addins" OR TargetObject containsCIS "\\Outlook\\Addins" OR TargetObject containsCIS "\\Onenote\\Addins" OR TargetObject containsCIS "\\Excel\\Addins" OR TargetObject containsCIS "\\Access\\Addins" OR TargetObject containsCIS "test\\Special\\Perf")) AND ((TargetObject containsCIS "\\Software\\Wow6432Node\\Microsoft\\Office" OR TargetObject containsCIS "\\Software\\Microsoft\\Office"))) AND NOT (((Details = "(Empty)") OR ((src.process.image.path startswithCIS "C:\\Program Files\\Microsoft Office\\" OR src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft Office\\" OR src.process.image.path startswithCIS "C:\\PROGRA~2\\MICROS~2\\Office" OR src.process.image.path startswithCIS "C:\\Windows\\System32\\msiexec.exe" OR src.process.image.path startswithCIS "C:\\Windows\\SysWOW64\\msiexec.exe" OR src.process.image.path startswithCIS "C:\\Windows\\System32\\regsvr32.exe" OR src.process.image.path startswithCIS "C:\\Windows\\SysWOW64\\regsvr32.exe") AND (TargetObject containsCIS "\\Excel\\Addins\\AdHocReportingExcelClientLib.AdHocReportingExcelClientAddIn.1\\" OR TargetObject containsCIS "\\Excel\\Addins\\ExcelPlugInShell.PowerMapConnect\\" OR TargetObject containsCIS "\\Excel\\Addins\\NativeShim\\" OR TargetObject containsCIS "\\Excel\\Addins\\NativeShim.InquireConnector.1\\" OR TargetObject containsCIS "\\Excel\\Addins\\PowerPivotExcelClientAddIn.NativeEntry.1\\" OR TargetObject containsCIS "\\Outlook\\AddIns\\AccessAddin.DC\\" OR TargetObject containsCIS "\\Outlook\\AddIns\\ColleagueImport.ColleagueImportAddin\\" OR TargetObject containsCIS "\\Outlook\\AddIns\\EvernoteCC.EvernoteContactConnector\\" OR TargetObject containsCIS "\\Outlook\\AddIns\\EvernoteOLRD.Connect\\" OR TargetObject containsCIS "\\Outlook\\Addins\\OneNote.OutlookAddin" OR TargetObject containsCIS "\\Outlook\\Addins\\DriveFSExtensionLib.Connect\\" OR TargetObject containsCIS "\\Outlook\\Addins\\GoogleAppsSync.Connect\\" OR TargetObject containsCIS "\\Outlook\\Addins\\Microsoft.VbaAddinForOutlook.1\\" OR TargetObject containsCIS "\\Outlook\\Addins\\OcOffice.OcForms\\" OR TargetObject containsCIS "\\Outlook\\Addins\\OscAddin.Connect\\" OR TargetObject containsCIS "\\Outlook\\Addins\\OutlookChangeNotifier.Connect\\" OR TargetObject containsCIS "\\Outlook\\Addins\\UCAddin.LyncAddin.1" OR TargetObject containsCIS "\\Outlook\\Addins\\UCAddin.UCAddin.1" OR TargetObject containsCIS "\\Outlook\\Addins\\UmOutlookAddin.FormRegionAddin\\" OR TargetObject containsCIS "AddinTakeNotesService\\FriendlyName")) OR (Details is null) OR ((src.process.image.path startswithCIS "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\" OR src.process.image.path startswithCIS "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\") AND src.process.image.path endswithCIS "\\OfficeClickToRun.exe") OR ((src.process.image.path startswithCIS "C:\\Program Files\\Common Files\\Microsoft Shared\\VSTO\\" OR src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft Shared\\VSTO\\") AND src.process.image.path endswithCIS "\\VSTOInstaller.exe"))) AND NOT ((((src.process.image.path = "C:\\Program Files\\Avast Software\\Avast\\RegSvr.exe" OR src.process.image.path = "C:\\Program Files\\Avast Software\\Avast\\x86\\RegSvr.exe") AND TargetObject containsCIS "\\Microsoft\\Office\\Outlook\\Addins\\Avast.AsOutExt\\") OR ((src.process.image.path = "C:\\Program Files\\AVG\\Antivirus\\RegSvr.exe" OR src.process.image.path = "C:\\Program Files\\AVG\\Antivirus\\x86\\RegSvr.exe") AND TargetObject containsCIS "\\Microsoft\\Office\\Outlook\\Addins\\Antivirus.AsOutExt\\"))))
