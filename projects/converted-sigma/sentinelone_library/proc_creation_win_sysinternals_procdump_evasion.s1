// Title: Potential SysInternals ProcDump Evasion
// ID: 79b06761-465f-4f88-9ef2-150e24d3d737
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-01-11
// Tags: attack.stealth, attack.t1036, attack.t1003.001, attack.credential-access
// Description: Detects uses of the SysInternals ProcDump utility in which ProcDump or its output get renamed, or a dump file is moved or copied to a different name
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "copy procdump" OR src.process.cmdline containsCIS "move procdump")) OR ((src.process.cmdline containsCIS "copy " AND src.process.cmdline containsCIS ".dmp ") AND (src.process.cmdline containsCIS "2.dmp" OR src.process.cmdline containsCIS "lsass" OR src.process.cmdline containsCIS "out.dmp")) OR ((src.process.cmdline containsCIS "copy lsass.exe_" OR src.process.cmdline containsCIS "move lsass.exe_")))
