(((Description = "System.Management.Automation") OR (OriginalFileName = "System.Management.Automation.dll") OR ((ImageLoaded endswithCIS "\\System.Management.Automation.dll" OR ImageLoaded endswithCIS "\\System.Management.Automation.ni.dll"))) AND NOT ((((src.process.image.path startswithCIS "C:\\Windows\\Microsoft.NET\\Framework\\" OR src.process.image.path startswithCIS "C:\\Windows\\Microsoft.NET\\FrameworkArm\\" OR src.process.image.path startswithCIS "C:\\Windows\\Microsoft.NET\\FrameworkArm64\\" OR src.process.image.path startswithCIS "C:\\Windows\\Microsoft.NET\\Framework64\\") AND src.process.image.path endswithCIS "\\mscorsvw.exe") OR ((src.process.image.path = "C:\\Windows\\System32\\dsac.exe" OR src.process.image.path = "C:\\WINDOWS\\System32\\RemoteFXvGPUDisablement.exe" OR src.process.image.path = "C:\\Windows\\System32\\runscripthelper.exe" OR src.process.image.path = "C:\\WINDOWS\\System32\\sdiagnhost.exe" OR src.process.image.path = "C:\\Windows\\System32\\ServerManager.exe" OR src.process.image.path = "C:\\Windows\\System32\\SyncAppvPublishingServer.exe" OR src.process.image.path = "C:\\Windows\\System32\\winrshost.exe" OR src.process.image.path = "C:\\Windows\\System32\\wsmprovhost.exe" OR src.process.image.path = "C:\\Windows\\SysWOW64\\winrshost.exe" OR src.process.image.path = "C:\\Windows\\SysWOW64\\wsmprovhost.exe")) OR ((src.process.image.path = "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" OR src.process.image.path = "C:\\Program Files\\PowerShell\\7\\pwsh.exe" OR src.process.image.path = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" OR src.process.image.path = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" OR src.process.image.path = "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" OR src.process.image.path = "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")) OR ((src.process.image.path containsCIS "C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview" OR src.process.image.path containsCIS "\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview") AND src.process.image.path endswithCIS "\\pwsh.exe"))) AND NOT (((src.process.image.path is null) OR (src.process.image.path startswithCIS "C:\\ProgramData\\chocolatey\\choco.exe") OR (src.process.image.path endswithCIS "\\Citrix\\ConfigSync\\ConfigSyncRun.exe") OR (src.process.image.path startswithCIS "C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_" AND src.process.image.path endswithCIS "\\GetHelp.exe") OR (src.process.image.path startswithCIS "C:\\Windows\\Temp\\asgard2-agent\\" AND (src.process.image.path endswithCIS "\\thor64.exe" OR src.process.image.path endswithCIS "\\thor.exe")) OR ((src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft SQL Server Management Studio" OR src.process.image.path startswithCIS "C:\\Program Files\\Microsoft SQL Server Management Studio") AND src.process.image.path endswithCIS "\\IDE\\Ssms.exe") OR ((src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft SQL Server\\" OR src.process.image.path startswithCIS "C:\\Program Files\\Microsoft SQL Server\\") AND src.process.image.path endswithCIS "\\Tools\\Binn\\SQLPS.exe") OR ((src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft Visual Studio\\" OR src.process.image.path startswithCIS "C:\\Program Files\\Microsoft Visual Studio\\")))))
