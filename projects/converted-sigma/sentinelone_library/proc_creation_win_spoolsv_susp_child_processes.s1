((src.process.parent.image.path endswithCIS "\\spoolsv.exe" AND (IntegrityLevel = "System" OR IntegrityLevel = "S-1-16-16384")) AND (((src.process.image.path endswithCIS "\\gpupdate.exe" OR src.process.image.path endswithCIS "\\whoami.exe" OR src.process.image.path endswithCIS "\\nltest.exe" OR src.process.image.path endswithCIS "\\taskkill.exe" OR src.process.image.path endswithCIS "\\wmic.exe" OR src.process.image.path endswithCIS "\\taskmgr.exe" OR src.process.image.path endswithCIS "\\sc.exe" OR src.process.image.path endswithCIS "\\findstr.exe" OR src.process.image.path endswithCIS "\\curl.exe" OR src.process.image.path endswithCIS "\\wget.exe" OR src.process.image.path endswithCIS "\\certutil.exe" OR src.process.image.path endswithCIS "\\bitsadmin.exe" OR src.process.image.path endswithCIS "\\accesschk.exe" OR src.process.image.path endswithCIS "\\wevtutil.exe" OR src.process.image.path endswithCIS "\\bcdedit.exe" OR src.process.image.path endswithCIS "\\fsutil.exe" OR src.process.image.path endswithCIS "\\cipher.exe" OR src.process.image.path endswithCIS "\\schtasks.exe" OR src.process.image.path endswithCIS "\\write.exe" OR src.process.image.path endswithCIS "\\wuauclt.exe" OR src.process.image.path endswithCIS "\\systeminfo.exe" OR src.process.image.path endswithCIS "\\reg.exe" OR src.process.image.path endswithCIS "\\query.exe")) OR (((src.process.image.path endswithCIS "\\net.exe" OR src.process.image.path endswithCIS "\\net1.exe")) AND NOT ((src.process.cmdline containsCIS "start"))) OR ((src.process.image.path endswithCIS "\\cmd.exe") AND NOT (((src.process.cmdline containsCIS ".spl" OR src.process.cmdline containsCIS "route add" OR src.process.cmdline containsCIS "program files")))) OR ((src.process.image.path endswithCIS "\\netsh.exe") AND NOT (((src.process.cmdline containsCIS "add portopening" OR src.process.cmdline containsCIS "rule name")))) OR (((src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe")) AND NOT ((src.process.cmdline containsCIS ".spl"))) OR ((src.process.cmdline endswithCIS "rundll32.exe") AND ((src.process.image.path endswithCIS "\\rundll32.exe") OR (OriginalFileName = "RUNDLL32.EXE")))))
