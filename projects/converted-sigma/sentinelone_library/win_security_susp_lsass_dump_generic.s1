// Title: Potentially Suspicious AccessMask Requested From LSASS
// ID: 4a1b6da0-d94f-4fc3-98fc-2d9cb9e5ee76
// Status: test
// Level: medium
// Author: Roberto Rodriguez, Teymur Kheirkhabarov, Dimitrios Slamaris, Mark Russinovich, Aleksey Potapov, oscd.community (update)
// Date: 2019-11-01
// Tags: attack.credential-access, car.2019-04-004, attack.t1003.001
// Description: Detects process handle on LSASS process with certain access mask
// Converted by: Sigma Universal SIEM/EDR CLI

(((EventID = "4656" AND ObjectName endswithCIS "\\lsass.exe" AND (AccessMask containsCIS "0x40" OR AccessMask containsCIS "0x1400" OR AccessMask containsCIS "0x100000" OR AccessMask containsCIS "0x1410" OR AccessMask containsCIS "0x1010" OR AccessMask containsCIS "0x1438" OR AccessMask containsCIS "0x143a" OR AccessMask containsCIS "0x1418" OR AccessMask containsCIS "0x1f0fff" OR AccessMask containsCIS "0x1f1fff" OR AccessMask containsCIS "0x1f2fff" OR AccessMask containsCIS "0x1f3fff")) OR (EventID = "4663" AND ObjectName endswithCIS "\\lsass.exe" AND (AccessList containsCIS "4484" OR AccessList containsCIS "4416"))) AND NOT (((ProcessName containsCIS ":\\Windows\\Temp\\asgard2-agent-sc\\aurora\\" AND ProcessName endswithCIS "\\aurora-agent-64.exe" AND AccessList containsCIS "%%4484") OR ((ProcessName containsCIS ":\\Users\\" AND ProcessName containsCIS "\\AppData\\Local\\Temp\\is-") AND ProcessName endswithCIS "\\avira_system_speedup.tmp" AND AccessList containsCIS "%%4484") OR (ProcessName containsCIS ":\\Windows\\Temp\\" AND ProcessName endswithCIS "\\avira_speedup_setup_update.tmp" AND AccessList containsCIS "%%4484") OR ((ProcessName endswithCIS ":\\Windows\\System32\\taskhostw.exe" OR ProcessName endswithCIS ":\\Windows\\System32\\msiexec.exe" OR ProcessName endswithCIS ":\\Windows\\CCM\\CcmExec.exe")) OR (ProcessName containsCIS ":\\Program Files") OR (ProcessName containsCIS ":\\Windows\\SystemTemp\\" AND ProcessName endswithCIS "\\GoogleUpdate.exe" AND AccessList containsCIS "%%4484") OR (ProcessName endswithCIS "\\x64\\SCENARIOENGINE.EXE" AND AccessList containsCIS "%%4484") OR (ProcessName endswithCIS ":\\Windows\\System32\\snmp.exe" AND AccessList containsCIS "%%4484") OR ((ProcessName endswithCIS "\\csrss.exe" OR ProcessName endswithCIS "\\GamingServices.exe" OR ProcessName endswithCIS "\\lsm.exe" OR ProcessName endswithCIS "\\MicrosoftEdgeUpdate.exe" OR ProcessName endswithCIS "\\minionhost.exe" OR ProcessName endswithCIS "\\MRT.exe" OR ProcessName endswithCIS "\\MsMpEng.exe" OR ProcessName endswithCIS "\\perfmon.exe" OR ProcessName endswithCIS "\\procexp.exe" OR ProcessName endswithCIS "\\procexp64.exe" OR ProcessName endswithCIS "\\procexp64a.exe" OR ProcessName endswithCIS "\\svchost.exe" OR ProcessName endswithCIS "\\taskmgr.exe" OR ProcessName endswithCIS "\\thor.exe" OR ProcessName endswithCIS "\\thor64.exe" OR ProcessName endswithCIS "\\vmtoolsd.exe" OR ProcessName endswithCIS "\\VsTskMgr.exe" OR ProcessName endswithCIS "\\wininit.exe" OR ProcessName endswithCIS "\\wmiprvse.exe" OR ProcessName endswithCIS "RtkAudUService64") AND (ProcessName containsCIS ":\\Program Files (x86)\\" OR ProcessName containsCIS ":\\Program Files\\" OR ProcessName containsCIS ":\\ProgramData\\Microsoft\\Windows Defender\\Platform\\" OR ProcessName containsCIS ":\\Windows\\SysNative\\" OR ProcessName containsCIS ":\\Windows\\System32\\" OR ProcessName containsCIS ":\\Windows\\SysWow64\\" OR ProcessName containsCIS ":\\Windows\\Temp\\asgard2-agent\\")) OR ((ProcessName endswithCIS ":\\Windows\\Sysmon64.exe" OR ProcessName endswithCIS ":\\Windows\\Sysmon64a.exe") AND AccessList containsCIS "%%4484"))) AND NOT (((ProcessName endswithCIS "\\procmon64.exe" OR ProcessName endswithCIS "\\procmon64a.exe" OR ProcessName endswithCIS "\\procmon.exe") AND AccessList containsCIS "%%4484")))
