// Title: File In Suspicious Location Encoded To Base64 Via Certutil.EXE
// ID: 82a6714f-4899-4f16-9c1e-9a333544d4c3
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-15
// Tags: attack.stealth, attack.t1027
// Description: Detects the execution of certutil with the "encode" flag to encode a file to base64 where the files are located in potentially suspicious locations
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "-encode" OR src.process.cmdline containsCIS "/encode")) AND ((src.process.cmdline containsCIS "\\AppData\\Roaming\\" OR src.process.cmdline containsCIS "\\Desktop\\" OR src.process.cmdline containsCIS "\\Local\\Temp\\" OR src.process.cmdline containsCIS "\\PerfLogs\\" OR src.process.cmdline containsCIS "\\Users\\Public\\" OR src.process.cmdline containsCIS "\\Windows\\Temp\\" OR src.process.cmdline containsCIS "$Recycle.Bin")) AND ((src.process.image.path endswithCIS "\\certutil.exe") OR (OriginalFileName = "CertUtil.exe")))
