// Tags: attack.discovery, attack.t1046, attack.t1135
// Description: Detects the use of Advanced Port Scanner.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "/portable" AND src.process.cmdline containsCIS "/lng")) OR ((src.process.image.path containsCIS "\\advanced_port_scanner") OR (OriginalFileName containsCIS "advanced_port_scanner") OR (Description containsCIS "Advanced Port Scanner")))
