// Title: Potentially Suspicious Mofcomp Execution
// ID: 1dd05363-104e-4b4a-b963-196a534b03a1
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-12
// Tags: attack.stealth, attack.t1218
// Description: Detects execution of the "mofcomp" utility as a child of a suspicious shell or script running utility or by having a suspicious path in the commandline.
// The "mofcomp" utility parses a file containing MOF statements and adds the classes and class instances defined in the file to the WMI repository.
// Attackers abuse this utility to install malicious MOF scripts
// Converted by: Sigma Universal SIEM/EDR CLI

(((((src.process.parent.image.path endswithCIS "\\cmd.exe" OR src.process.parent.image.path endswithCIS "\\powershell.exe" OR src.process.parent.image.path endswithCIS "\\pwsh.exe" OR src.process.parent.image.path endswithCIS "\\wsl.exe" OR src.process.parent.image.path endswithCIS "\\wscript.exe" OR src.process.parent.image.path endswithCIS "\\cscript.exe")) OR ((src.process.cmdline containsCIS "\\AppData\\Local\\Temp" OR src.process.cmdline containsCIS "\\Contacts\\" OR src.process.cmdline containsCIS "\\Favorites\\" OR src.process.cmdline containsCIS "\\Favourites\\" OR src.process.cmdline containsCIS "\\Music\\" OR src.process.cmdline containsCIS "\\Pictures\\" OR src.process.cmdline containsCIS "\\Users\\Public\\" OR src.process.cmdline containsCIS "\\Videos\\" OR src.process.cmdline containsCIS "\\WINDOWS\\Temp\\" OR src.process.cmdline containsCIS "%appdata%" OR src.process.cmdline containsCIS "%temp%" OR src.process.cmdline containsCIS "%tmp%"))) AND ((src.process.image.path endswithCIS "\\mofcomp.exe") OR (OriginalFileName = "mofcomp.exe"))) AND NOT (((src.process.parent.cmdline endswithCIS "\\InstallUtil.exe /Uninstall C:\\Windows\\CCM\\Microsoft.ConfigurationManager.SVProvider.dll" AND src.process.parent.image.path endswithCIS "\\InstallUtil.exe" AND (src.process.cmdline containsCIS "C:\\Windows\\TEMP" AND src.process.cmdline containsCIS ".tmp")) OR (src.process.parent.image.path = "C:\\Windows\\System32\\wbem\\WmiPrvSE.exe" AND src.process.cmdline containsCIS "C:\\Windows\\TEMP\\" AND src.process.cmdline endswithCIS ".mof"))) AND NOT ((src.process.parent.cmdline is null)))
