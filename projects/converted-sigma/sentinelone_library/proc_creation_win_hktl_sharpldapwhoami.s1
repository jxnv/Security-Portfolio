// Description: Detects SharpLdapWhoami, a whoami alternative that queries the LDAP service on a domain controller
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline endswithCIS " /method:ntlm" OR src.process.cmdline endswithCIS " /method:kerb" OR src.process.cmdline endswithCIS " /method:nego" OR src.process.cmdline endswithCIS " /m:nego" OR src.process.cmdline endswithCIS " /m:ntlm" OR src.process.cmdline endswithCIS " /m:kerb")) OR (src.process.image.path endswithCIS "\\SharpLdapWhoami.exe") OR ((OriginalFileName containsCIS "SharpLdapWhoami") OR (Product = "SharpLdapWhoami")))
