// Title: ServiceDll Hijack
// ID: 612e47e9-8a59-43a6-b404-f48683f45bd6
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-02-04
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects changes to the "ServiceDLL" value related to a service in the registry.
// This is often used as a method of persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

(((TargetObject containsCIS "\\System\\" AND TargetObject containsCIS "ControlSet" AND TargetObject containsCIS "\\Services\\") AND TargetObject endswithCIS "\\Parameters\\ServiceDll") AND NOT (((src.process.image.path = "C:\\Windows\\system32\\lsass.exe" AND TargetObject endswithCIS "\\Services\\NTDS\\Parameters\\ServiceDll" AND Details = "%%systemroot%%\\system32\\ntdsa.dll") OR (src.process.image.path = "C:\\Windows\\System32\\poqexec.exe") OR (Details = "C:\\Windows\\system32\\spool\\drivers\\x64\\3\\PrintConfig.dll") OR (src.process.image.path endswithCIS "\\regsvr32.exe" AND TargetObject endswithCIS "\\Services\\PrintNotify\\Parameters\\ServiceDll" AND Details startswithCIS "C:\\WINDOWS\\System32\\DriverStore\\FileRepository\\" AND Details endswithCIS "\\arm64\\PrintConfig.dll"))) AND NOT ((src.process.image.path endswithCIS "\\regsvr32.exe" AND Details = "C:\\Windows\\System32\\STAgent.dll")))
