// Title: Suspicious Network Connection Binary No CommandLine
// ID: 20384606-a124-4fec-acbb-8bd373728613
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-07-03
// Tags: attack.stealth
// Description: Detects suspicious network connections made by a well-known Windows binary run with no command line parameters
// Converted by: Sigma Universal SIEM/EDR CLI

((Initiated = "true" AND (src.process.image.path endswithCIS "\\regsvr32.exe" OR src.process.image.path endswithCIS "\\rundll32.exe" OR src.process.image.path endswithCIS "\\dllhost.exe") AND (src.process.cmdline endswithCIS "\\regsvr32.exe" OR src.process.cmdline endswithCIS "\\rundll32.exe" OR src.process.cmdline endswithCIS "\\dllhost.exe")) AND NOT (((src.process.cmdline = "") OR (src.process.cmdline is null))))
