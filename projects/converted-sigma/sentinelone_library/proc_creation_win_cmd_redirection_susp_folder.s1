// Title: Potentially Suspicious CMD Shell Output Redirect
// ID: 8e0bb260-d4b2-4fff-bb8d-3f82118e6892
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-12
// Tags: attack.stealth, attack.t1218
// Description: Detects inline Windows shell commands redirecting output via the ">" symbol to a suspicious location.
// This technique is sometimes used by malicious actors in order to redirect the output of reconnaissance commands such as "hostname" and "dir" to files for future exfiltration.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "\\cmd.exe") OR (OriginalFileName = "Cmd.Exe")) AND (((src.process.cmdline containsCIS ">?%APPDATA%\\" OR src.process.cmdline containsCIS ">?%TEMP%\\" OR src.process.cmdline containsCIS ">?%TMP%\\" OR src.process.cmdline containsCIS ">?%USERPROFILE%\\" OR src.process.cmdline containsCIS ">?C:\\ProgramData\\" OR src.process.cmdline containsCIS ">?C:\\Temp\\" OR src.process.cmdline containsCIS ">?C:\\Users\\Public\\" OR src.process.cmdline containsCIS ">?C:\\Windows\\Temp\\")) OR ((src.process.cmdline containsCIS " >" OR src.process.cmdline containsCIS "\">" OR src.process.cmdline containsCIS "'>") AND (src.process.cmdline containsCIS "C:\\Users\\" AND src.process.cmdline containsCIS "\\AppData\\Local\\"))))
