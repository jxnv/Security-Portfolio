// Title: Suspicious Child Process Created as System
// ID: 590a5f4c-6c8c-4f10-8307-89afe9453a9d
// Status: test
// Level: high
// Author: Teymur Kheirkhabarov, Roberto Rodriguez (@Cyb3rWard0g), Open Threat Research (OTR)
// Date: 2019-10-26
// Tags: attack.privilege-escalation, attack.stealth, attack.t1134.002
// Description: Detection of child processes spawned with SYSTEM privileges by parents with LOCAL SERVICE or NETWORK SERVICE accounts
// Converted by: Sigma Universal SIEM/EDR CLI

(((ParentUser containsCIS "AUTHORI" OR ParentUser containsCIS "AUTORI") AND (ParentUser endswithCIS "\\NETWORK SERVICE" OR ParentUser endswithCIS "\\LOCAL SERVICE") AND (src.process.user containsCIS "AUTHORI" OR src.process.user containsCIS "AUTORI") AND (src.process.user endswithCIS "\\SYSTEM" OR src.process.user endswithCIS "\\Système" OR src.process.user endswithCIS "\\СИСТЕМА") AND (IntegrityLevel = "System" OR IntegrityLevel = "S-1-16-16384")) AND NOT ((src.process.image.path endswithCIS "\\rundll32.exe" AND src.process.cmdline containsCIS "DavSetCookie")))
