// Title: UAC Bypass Using Disk Cleanup
// ID: b697e69c-746f-4a86-9f59-7bfff8eab881
// Status: test
// Level: high
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-08-30
// Tags: attack.privilege-escalation, attack.t1548.002
// Description: Detects the pattern of UAC Bypass using scheduled tasks and variable expansion of cleanmgr.exe (UACMe 34)
// Converted by: Sigma Universal SIEM/EDR CLI

(src.process.cmdline endswithCIS "\"\\system32\\cleanmgr.exe /autoclean /d C:" AND src.process.parent.cmdline = "C:\\Windows\\system32\\svchost.exe -k netsvcs -p -s Schedule" AND (IntegrityLevel = "High" OR IntegrityLevel = "System" OR IntegrityLevel = "S-1-16-16384" OR IntegrityLevel = "S-1-16-12288"))
