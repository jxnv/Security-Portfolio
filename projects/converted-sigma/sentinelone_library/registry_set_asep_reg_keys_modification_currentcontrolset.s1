// Title: CurrentControlSet Autorun Keys Modification
// ID: f674e36a-4b91-431e-8aef-f8a96c2aca35
// Status: test
// Level: medium
// Author: Victor Sergeev, Daniil Yugoslavskiy, Gleb Sukhodolskiy, Timur Zinniatullin, oscd.community, Tim Shelton, frack113 (split)
// Date: 2019-10-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects modification of autostart extensibility point (ASEP) in registry.
// Converted by: Sigma Universal SIEM/EDR CLI

(((TargetObject containsCIS "\\SYSTEM\\CurrentControlSet\\Control") AND ((TargetObject containsCIS "\\Terminal Server\\WinStations\\RDP-Tcp\\InitialProgram" OR TargetObject containsCIS "\\Terminal Server\\Wds\\rdpwd\\StartupPrograms" OR TargetObject containsCIS "\\SecurityProviders\\SecurityProviders" OR TargetObject containsCIS "\\SafeBoot\\AlternateShell" OR TargetObject containsCIS "\\Print\\Providers" OR TargetObject containsCIS "\\Print\\Monitors" OR TargetObject containsCIS "\\NetworkProvider\\Order" OR TargetObject containsCIS "\\Lsa\\Notification Packages" OR TargetObject containsCIS "\\Lsa\\Authentication Packages" OR TargetObject containsCIS "\\BootVerificationProgram\\ImagePath"))) AND NOT (((src.process.image.path = "C:\\Windows\\System32\\spoolsv.exe" AND TargetObject containsCIS "\\Print\\Monitors\\CutePDF Writer Monitor" AND (Details = "cpwmon64_v40.dll" OR Details = "CutePDF Writer")) OR (Details = "(Empty)") OR (src.process.image.path = "C:\\Windows\\System32\\spoolsv.exe" AND TargetObject containsCIS "Print\\Monitors\\Appmon\\Ports\\Microsoft.Office.OneNote_" AND (src.process.user containsCIS "AUTHORI" OR src.process.user containsCIS "AUTORI")) OR (src.process.image.path = "C:\\Windows\\System32\\poqexec.exe" AND TargetObject endswithCIS "\\NetworkProvider\\Order\\ProviderOrder") OR (src.process.image.path = "C:\\Windows\\System32\\spoolsv.exe" AND TargetObject endswithCIS "\\Print\\Monitors\\MONVNC\\Driver" AND Details = "VNCpm.dll"))))
