// Title: Usage Of Web Request Commands And Cmdlets - ScriptBlock
// ID: 1139d2e2-84b1-4226-b445-354492eba8ba
// Status: test
// Level: medium
// Author: James Pemberton / @4A616D6573
// Date: 2019-10-24
// Tags: attack.execution, attack.t1059.001
// Description: Detects the use of various web request commands with commandline tools and Windows PowerShell cmdlets (including aliases) via PowerShell scriptblock logs
// Converted by: Sigma Universal SIEM/EDR CLI

(((ScriptBlockText containsCIS "[System.Net.WebRequest]::create" OR ScriptBlockText containsCIS "curl " OR ScriptBlockText containsCIS "Invoke-RestMethod" OR ScriptBlockText containsCIS "Invoke-WebRequest" OR ScriptBlockText containsCIS " irm " OR ScriptBlockText containsCIS "iwr " OR ScriptBlockText containsCIS "Resume-BitsTransfer" OR ScriptBlockText containsCIS "Start-BitsTransfer" OR ScriptBlockText containsCIS "wget " OR ScriptBlockText containsCIS "WinHttp.WinHttpRequest")) AND NOT ((Path startswithCIS "C:\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\")))
