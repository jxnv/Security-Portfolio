// Title: WinSxS Executable File Creation By Non-System Process
// ID: 34746e8c-5fb8-415a-b135-0abc167e912a
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-11
// Tags: attack.execution
// Description: Detects the creation of binaries in the WinSxS folder by non-system processes
// Converted by: Sigma Universal SIEM/EDR CLI

((tgt.file.path startswithCIS "C:\\Windows\\WinSxS\\" AND tgt.file.path endswithCIS ".exe") AND NOT (((src.process.image.path startswithCIS "C:\\Windows\\Systems32\\" OR src.process.image.path startswithCIS "C:\\Windows\\SysWOW64\\" OR src.process.image.path startswithCIS "C:\\Windows\\WinSxS\\"))))
