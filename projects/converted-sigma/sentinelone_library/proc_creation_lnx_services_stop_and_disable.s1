// Title: Disable Or Stop Services
// ID: de25eeb8-3655-4643-ac3a-b662d3f26b6b
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-15
// Tags: attack.defense-impairment, attack.t1685, attack.impact, attack.t1489
// Description: Detects the usage of utilities such as 'systemctl', 'service'...etc to stop or disable tools and services on Linux systems.
// Attackers may stop or disable security tools and services to evade detection, maintain persistence, or disrupt system operations.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "/service" OR src.process.image.path endswithCIS "/systemctl" OR src.process.image.path endswithCIS "/chkconfig") AND (src.process.cmdline containsCIS " stop " OR src.process.cmdline containsCIS " disable ")) AND NOT (((src.process.image.path endswithCIS "/systemctl" AND (src.process.cmdline containsCIS "--no-reload disable snap-snapd-" OR src.process.cmdline containsCIS " stop snap-snapd-")) OR (src.process.image.path endswithCIS "/systemctl" AND src.process.parent.cmdline containsCIS "tmp.ci/preinst upgrade" AND (src.process.cmdline containsCIS " stop " AND src.process.cmdline containsCIS "ssh.")) OR (src.process.parent.cmdline containsCIS "/dpkg/info/ubuntu-pro-client.prerm upgrade" AND src.process.image.path endswithCIS "/systemctl"))) AND NOT ((src.process.image.path endswithCIS "/systemctl" AND src.process.cmdline endswithCIS "snap.amazon-ssm-agent.amazon-ssm-agent.service")))
