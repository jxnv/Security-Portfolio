// Title: Credential Manager Access By Uncommon Applications
// ID: 407aecb1-e762-4acf-8c7b-d087bcff3bb6
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-11
// Tags: attack.t1003, attack.credential-access
// Description: Detects suspicious processes based on name and location that access the windows credential manager and vault.
// Which can be a sign of credential stealing. Example case would be usage of mimikatz "dpapi::cred" function
// Converted by: Sigma Universal SIEM/EDR CLI

(((FileName containsCIS "\\AppData\\Local\\Microsoft\\Credentials\\" OR FileName containsCIS "\\AppData\\Roaming\\Microsoft\\Credentials\\" OR FileName containsCIS "\\AppData\\Local\\Microsoft\\Vault\\" OR FileName containsCIS "\\ProgramData\\Microsoft\\Vault\\")) AND NOT (((src.process.image.path = "C:\\Windows\\explorer.exe") OR ((src.process.image.path startswithCIS "C:\\Program Files\\" OR src.process.image.path startswithCIS "C:\\Program Files (x86)\\" OR src.process.image.path startswithCIS "C:\\Windows\\system32\\" OR src.process.image.path startswithCIS "C:\\Windows\\SysWOW64\\")))))
