// Tags: attack.execution, attack.t1059
// Description: Detects possible payload obfuscation via the commandline
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.cmdline containsCIS "^^" OR src.process.cmdline containsCIS "^|^" OR src.process.cmdline containsCIS ",;," OR src.process.cmdline containsCIS ";;;;" OR src.process.cmdline containsCIS ";; ;;" OR src.process.cmdline containsCIS "(,(," OR src.process.cmdline containsCIS "%COMSPEC:~" OR src.process.cmdline containsCIS " c^m^d" OR src.process.cmdline containsCIS "^c^m^d" OR src.process.cmdline containsCIS " c^md" OR src.process.cmdline containsCIS " cm^d" OR src.process.cmdline containsCIS "^cm^d" OR src.process.cmdline containsCIS " s^et " OR src.process.cmdline containsCIS " s^e^t " OR src.process.cmdline containsCIS " se^t "))
