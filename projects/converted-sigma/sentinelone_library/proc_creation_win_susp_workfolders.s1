// Title: Execution via WorkFolders.exe
// ID: 0bbc6369-43e3-453d-9944-cae58821c173
// Status: test
// Level: high
// Author: Maxime Thiebaut (@0xThiebaut)
// Date: 2021-10-21
// Tags: attack.stealth, attack.t1218
// Description: Detects using WorkFolders.exe to execute an arbitrary control.exe
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path endswithCIS "\\control.exe" AND src.process.parent.image.path endswithCIS "\\WorkFolders.exe") AND NOT ((src.process.image.path = "C:\\Windows\\System32\\control.exe")))
