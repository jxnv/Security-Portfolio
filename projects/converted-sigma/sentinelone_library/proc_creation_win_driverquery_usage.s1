// Title: DriverQuery.EXE Execution
// ID: a20def93-0709-4eae-9bd2-31206e21e6b2
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-19
// Tags: attack.discovery
// Description: Detect usage of the "driverquery" utility. Which can be used to perform reconnaissance on installed drivers
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "driverquery.exe") OR (OriginalFileName = "drvqry.exe")) AND NOT ((((src.process.parent.image.path endswithCIS "\\cscript.exe" OR src.process.parent.image.path endswithCIS "\\mshta.exe" OR src.process.parent.image.path endswithCIS "\\regsvr32.exe" OR src.process.parent.image.path endswithCIS "\\rundll32.exe" OR src.process.parent.image.path endswithCIS "\\wscript.exe")) OR ((src.process.parent.image.path containsCIS "\\AppData\\Local\\" OR src.process.parent.image.path containsCIS "\\Users\\Public\\" OR src.process.parent.image.path containsCIS "\\Windows\\Temp\\")))))
