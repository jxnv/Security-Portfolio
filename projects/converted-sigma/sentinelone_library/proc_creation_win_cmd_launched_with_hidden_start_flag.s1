// Title: Cmd Launched with Hidden Start Flags to Suspicious Targets
// ID: 5a6b7c8d-9e0f-1a2b-3c4d-5e6f7a8b9c0d
// Status: experimental
// Level: medium
// Author: Vladan Sekulic, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-01-24
// Tags: attack.stealth, attack.t1564.003
// Description: Detects cmd.exe executing commands with the "start" utility using "/b" (no window) or "/min" (minimized) flags.
// To reduce false positives from standard background tasks, detection is restricted to scenarios where the target is a known script extension or located in suspicious temporary/public directories.
// This technique was observed in Chaos, DarkSide, and Emotet malware campaigns.
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.cmdline containsCIS "start " OR src.process.cmdline containsCIS "start/b" OR src.process.cmdline containsCIS "start/min")) AND ((src.process.cmdline containsCIS "/b " OR src.process.cmdline containsCIS "-b " OR src.process.cmdline containsCIS "/b\"" OR src.process.cmdline containsCIS "-b\"" OR src.process.cmdline containsCIS "/min " OR src.process.cmdline containsCIS "-min " OR src.process.cmdline containsCIS "/min\"" OR src.process.cmdline containsCIS "-min\"")) AND ((src.process.image.path endswithCIS "\\cmd.exe") OR (OriginalFileName = "Cmd.Exe"))) AND (((src.process.cmdline containsCIS ".bat" OR src.process.cmdline containsCIS ".cmd" OR src.process.cmdline containsCIS ".cpl" OR src.process.cmdline containsCIS ".hta" OR src.process.cmdline containsCIS ".js" OR src.process.cmdline containsCIS ".ps1" OR src.process.cmdline containsCIS ".scr" OR src.process.cmdline containsCIS ".vbe" OR src.process.cmdline containsCIS ".vbs")) OR ((src.process.cmdline containsCIS " -nop " OR src.process.cmdline containsCIS " -sta " OR src.process.cmdline containsCIS ".downloadfile(" OR src.process.cmdline containsCIS ".downloadstring(" OR src.process.cmdline containsCIS "-noni " OR src.process.cmdline containsCIS "-w hidden ")) OR ((src.process.cmdline containsCIS ":\\Perflogs\\" OR src.process.cmdline containsCIS ":\\Temp\\" OR src.process.cmdline containsCIS ":\\Users\\Default\\" OR src.process.cmdline containsCIS ":\\Windows\\Temp\\" OR src.process.cmdline containsCIS "\\AppData\\Roaming\\" OR src.process.cmdline containsCIS "\\Contacts\\" OR src.process.cmdline containsCIS "\\Documents\\" OR src.process.cmdline containsCIS "\\Downloads\\" OR src.process.cmdline containsCIS "\\Favorites\\" OR src.process.cmdline containsCIS "\\Favourites\\" OR src.process.cmdline containsCIS "\\inetpub\\" OR src.process.cmdline containsCIS "\\Music\\" OR src.process.cmdline containsCIS "\\Photos\\" OR src.process.cmdline containsCIS "\\Temporary Internet\\" OR src.process.cmdline containsCIS "\\Users\\Public\\" OR src.process.cmdline containsCIS "\\Videos\\"))))
