// Title: New Port Forwarding Rule Added Via Netsh.EXE
// ID: 322ed9ec-fcab-4f67-9a34-e7c6aef43614
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), omkar72, oscd.community, Swachchhanda Shrawan Poudel
// Date: 2019-01-29
// Tags: attack.lateral-movement, attack.command-and-control, attack.t1090
// Description: Detects the execution of netsh commands that configure a new port forwarding (PortProxy) rule
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "\\netsh.exe") OR (OriginalFileName = "netsh.exe")) AND (((src.process.cmdline containsCIS "interface" AND src.process.cmdline containsCIS "portproxy" AND src.process.cmdline containsCIS "add" AND src.process.cmdline containsCIS "v4tov4")) OR ((src.process.cmdline containsCIS "i " AND src.process.cmdline containsCIS "p " AND src.process.cmdline containsCIS "a " AND src.process.cmdline containsCIS "v ")) OR ((src.process.cmdline containsCIS "connectp" AND src.process.cmdline containsCIS "listena" AND src.process.cmdline containsCIS "c="))))
