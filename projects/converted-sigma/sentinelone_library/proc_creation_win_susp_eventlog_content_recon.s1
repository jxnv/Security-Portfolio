// Description: Detects execution of different log query utilities and commands to search and dump the content of specific event logs or look for specific event IDs.
// This technique is used by threat actors in order to extract sensitive information from events logs such as usernames, IP addresses, hostnames, etc.
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.cmdline containsCIS "-InstanceId 462?" OR src.process.cmdline containsCIS ".eventid -eq 462?" OR src.process.cmdline containsCIS ".ID -eq 462?" OR src.process.cmdline containsCIS "EventCode=?462?" OR src.process.cmdline containsCIS "EventIdentifier=?462?" OR src.process.cmdline containsCIS "System[EventID=462?]" OR src.process.cmdline containsCIS "-InstanceId 4778" OR src.process.cmdline containsCIS ".eventid -eq 4778" OR src.process.cmdline containsCIS ".ID -eq 4778" OR src.process.cmdline containsCIS "EventCode=?4778?" OR src.process.cmdline containsCIS "EventIdentifier=?4778?" OR src.process.cmdline containsCIS "System[EventID=4778]" OR src.process.cmdline containsCIS "-InstanceId 25" OR src.process.cmdline containsCIS ".eventid -eq 25" OR src.process.cmdline containsCIS ".ID -eq 25" OR src.process.cmdline containsCIS "EventCode=?25?" OR src.process.cmdline containsCIS "EventIdentifier=?25?" OR src.process.cmdline containsCIS "System[EventID=25]" OR src.process.cmdline containsCIS "-InstanceId 1149" OR src.process.cmdline containsCIS ".eventid -eq 1149" OR src.process.cmdline containsCIS ".ID -eq 1149" OR src.process.cmdline containsCIS "EventCode=?1149?" OR src.process.cmdline containsCIS "EventIdentifier=?1149?" OR src.process.cmdline containsCIS "System[EventID=1149]" OR src.process.cmdline containsCIS "-InstanceId 21" OR src.process.cmdline containsCIS ".eventid -eq 21" OR src.process.cmdline containsCIS ".ID -eq 21" OR src.process.cmdline containsCIS "EventCode=?21?" OR src.process.cmdline containsCIS "EventIdentifier=?21?" OR src.process.cmdline containsCIS "System[EventID=21]" OR src.process.cmdline containsCIS "-InstanceId 22" OR src.process.cmdline containsCIS ".eventid -eq 22" OR src.process.cmdline containsCIS ".ID -eq 22" OR src.process.cmdline containsCIS "EventCode=?22?" OR src.process.cmdline containsCIS "EventIdentifier=?22?" OR src.process.cmdline containsCIS "System[EventID=22]")) OR ((src.process.cmdline containsCIS "Microsoft-Windows-PowerShell" OR src.process.cmdline containsCIS "Microsoft-Windows-Security-Auditing" OR src.process.cmdline containsCIS "Microsoft-Windows-TerminalServices-LocalSessionManager" OR src.process.cmdline containsCIS "Microsoft-Windows-TerminalServices-RemoteConnectionManager" OR src.process.cmdline containsCIS "Microsoft-Windows-Windows Defender" OR src.process.cmdline containsCIS "PowerShellCore" OR src.process.cmdline containsCIS "Security" OR src.process.cmdline containsCIS "Windows PowerShell"))) AND (((src.process.cmdline containsCIS "Select" AND src.process.cmdline containsCIS "Win32_NTLogEvent")) OR (((src.process.cmdline containsCIS " qe " OR src.process.cmdline containsCIS " query-events ")) AND ((src.process.image.path endswithCIS "\\wevtutil.exe") OR (OriginalFileName = "wevtutil.exe"))) OR ((src.process.cmdline containsCIS " ntevent") AND ((src.process.image.path endswithCIS "\\wmic.exe") OR (OriginalFileName = "wmic.exe"))) OR ((src.process.cmdline containsCIS "Get-WinEvent " OR src.process.cmdline containsCIS "get-eventlog "))))
