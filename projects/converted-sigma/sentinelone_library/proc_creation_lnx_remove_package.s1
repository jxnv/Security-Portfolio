// Title: Linux Package Uninstall
// ID: 95d61234-7f56-465c-6f2d-b562c6fedbc4
// Status: test
// Level: low
// Author: Tuan Le (NCSGroup), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-03-09
// Tags: attack.stealth, attack.t1070
// Description: Detects linux package removal using builtin tools such as "yum", "apt", "apt-get" or "dpkg".
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "/apt" OR src.process.image.path endswithCIS "/apt-get") AND (src.process.cmdline containsCIS "remove" OR src.process.cmdline containsCIS "purge")) OR (src.process.image.path endswithCIS "/dpkg" AND (src.process.cmdline containsCIS "--remove " OR src.process.cmdline containsCIS " -r ")) OR (src.process.image.path endswithCIS "/rpm" AND src.process.cmdline containsCIS " -e ") OR (src.process.image.path endswithCIS "/yum" AND (src.process.cmdline containsCIS "erase" OR src.process.cmdline containsCIS "remove")))
