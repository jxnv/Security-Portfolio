// Title: Schedule Task Creation From Env Variable Or Potentially Suspicious Path Via Schtasks.EXE
// ID: 81325ce1-be01-4250-944f-b4789644556f
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-21
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects Schtask creations that point to a suspicious folder or an environment variable often used by malware
// Converted by: Sigma Universal SIEM/EDR CLI

(((((src.process.cmdline containsCIS ":\\Perflogs" OR src.process.cmdline containsCIS ":\\Users\\All Users\\" OR src.process.cmdline containsCIS ":\\Users\\Default\\" OR src.process.cmdline containsCIS ":\\Users\\Public" OR src.process.cmdline containsCIS ":\\Windows\\Temp" OR src.process.cmdline containsCIS "\\AppData\\Local\\" OR src.process.cmdline containsCIS "\\AppData\\Roaming\\" OR src.process.cmdline containsCIS "%AppData%" OR src.process.cmdline containsCIS "%Public%")) AND (src.process.image.path endswithCIS "\\schtasks.exe" AND src.process.cmdline containsCIS " /create ")) OR ((src.process.parent.cmdline endswithCIS "\\svchost.exe -k netsvcs -p -s Schedule") AND ((src.process.cmdline containsCIS ":\\Perflogs" OR src.process.cmdline containsCIS ":\\Windows\\Temp" OR src.process.cmdline containsCIS "\\Users\\Public" OR src.process.cmdline containsCIS "%Public%")))) AND NOT ((((src.process.cmdline containsCIS "/Create /Xml " AND src.process.cmdline containsCIS "\\Temp\\.CR." AND src.process.cmdline containsCIS "\\Avira_Security_Installation.xml")) OR ((src.process.cmdline containsCIS "/Create /F /TN" AND src.process.cmdline containsCIS "/Xml " AND src.process.cmdline containsCIS "\\Temp\\" AND src.process.cmdline containsCIS "Avira_") AND (src.process.cmdline containsCIS ".tmp\\UpdateFallbackTask.xml" OR src.process.cmdline containsCIS ".tmp\\WatchdogServiceControlManagerTimeout.xml" OR src.process.cmdline containsCIS ".tmp\\SystrayAutostart.xml" OR src.process.cmdline containsCIS ".tmp\\MaintenanceTask.xml")) OR ((src.process.cmdline containsCIS "\\Temp\\" AND src.process.cmdline containsCIS "/Create /TN \"klcp_update\" /XML " AND src.process.cmdline containsCIS "\\klcp_update_task.xml")) OR ((src.process.parent.cmdline containsCIS "unattended.ini") OR (src.process.cmdline containsCIS "update_task.xml")) OR (src.process.cmdline containsCIS "/Create /TN TVInstallRestore /TR"))))
