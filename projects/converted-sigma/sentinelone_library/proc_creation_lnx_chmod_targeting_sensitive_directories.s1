// Title: Chmod Targeting Sensitive Directories
// ID: 6419afd1-3742-47a5-a7e6-b50386cd15f8
// Status: test
// Level: medium
// Author: Christopher Peacock @SecurePeacock, SCYTHE @scythe_io
// Date: 2022-06-03
// Tags: attack.defense-impairment, attack.t1222.002
// Description: Detects chmod targeting files in sensitive directory paths on Linux systems.
// Attackers may use chmod to change permissions of files in these directories to maintain persistence, escalate privileges, or disrupt system operations.
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path endswithCIS "/chmod" AND (src.process.cmdline containsCIS "/tmp/" OR src.process.cmdline containsCIS "/.Library/" OR src.process.cmdline containsCIS "/etc/" OR src.process.cmdline containsCIS "/opt/")) AND NOT (((src.process.cmdline startswithCIS "chmod 700 /tmp/apt-key-gpghome.") OR (src.process.cmdline = "chmod 0775 /etc/landscape/") OR (src.process.cmdline startswithCIS "chmod 755 /var/tmp/mkinitramfs") OR (src.process.cmdline containsCIS "/etc/" AND (src.process.parent.cmdline containsCIS "/var/lib/dpkg/info/" AND src.process.parent.cmdline containsCIS ".postinst configure")) OR (src.process.cmdline = "chmod 644 /etc/apparmor.d/tunables/home.d/ubuntu") OR (src.process.cmdline containsCIS "chmod --reference=/etc/shells" AND src.process.parent.cmdline endswithCIS "/update-shells"))))
