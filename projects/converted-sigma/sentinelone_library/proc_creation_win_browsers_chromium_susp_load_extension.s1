// Title: Suspicious Chromium Browser Instance Executed With Custom Extension
// ID: 27ba3207-dd30-4812-abbf-5d20c57d474e
// Status: test
// Level: high
// Author: Aedan Russell, frack113, X__Junior (Nextron Systems)
// Date: 2022-06-19
// Tags: attack.persistence, attack.t1176.001
// Description: Detects a suspicious process spawning a Chromium based browser process with the 'load-extension' flag to start an instance with a custom extension
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.parent.image.path endswithCIS "\\cmd.exe" OR src.process.parent.image.path endswithCIS "\\cscript.exe" OR src.process.parent.image.path endswithCIS "\\mshta.exe" OR src.process.parent.image.path endswithCIS "\\powershell.exe" OR src.process.parent.image.path endswithCIS "\\pwsh.exe" OR src.process.parent.image.path endswithCIS "\\regsvr32.exe" OR src.process.parent.image.path endswithCIS "\\rundll32.exe" OR src.process.parent.image.path endswithCIS "\\wscript.exe") AND (src.process.image.path endswithCIS "\\brave.exe" OR src.process.image.path endswithCIS "\\chrome.exe" OR src.process.image.path endswithCIS "\\msedge.exe" OR src.process.image.path endswithCIS "\\opera.exe" OR src.process.image.path endswithCIS "\\vivaldi.exe") AND src.process.cmdline containsCIS "--load-extension=")
