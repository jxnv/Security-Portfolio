// Title: Suspicious PowerShell Invocations - Generic
// ID: ed965133-513f-41d9-a441-e38076a0798f
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2017-03-12
// Tags: attack.execution, attack.t1059.001
// Description: Detects suspicious PowerShell invocation command parameters
// Converted by: Sigma Universal SIEM/EDR CLI

(((ScriptBlockText containsCIS " -enc " OR ScriptBlockText containsCIS " -EncodedCommand " OR ScriptBlockText containsCIS " -ec ")) AND ((ScriptBlockText containsCIS " -w hidden " OR ScriptBlockText containsCIS " -window hidden " OR ScriptBlockText containsCIS " -windowstyle hidden " OR ScriptBlockText containsCIS " -w 1 ")) AND ((ScriptBlockText containsCIS " -noni " OR ScriptBlockText containsCIS " -noninteractive ")))
