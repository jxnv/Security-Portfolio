// Title: Prefetch File Deleted
// ID: 0a1f9d29-6465-4776-b091-7f43b26e4c89
// Status: test
// Level: high
// Author: Cedric MAURUGEON
// Date: 2021-09-29
// Tags: attack.stealth, attack.t1070.004
// Description: Detects the deletion of a prefetch file which may indicate an attempt to destroy forensic evidence
// Converted by: Sigma Universal SIEM/EDR CLI

((tgt.file.path containsCIS ":\\Windows\\Prefetch\\" AND tgt.file.path endswithCIS ".pf") AND NOT ((src.process.image.path endswithCIS ":\\windows\\system32\\svchost.exe" AND (src.process.user containsCIS "AUTHORI" OR src.process.user containsCIS "AUTORI"))))
