// Title: Schtasks Creation Or Modification With SYSTEM Privileges
// ID: 89ca78fd-b37c-4310-b3d3-81a023f83936
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-28
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053.005
// Description: Detects the creation or update of a scheduled task to run with "NT AUTHORITY\SYSTEM" privileges
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "\\schtasks.exe" AND (src.process.cmdline containsCIS " /change " OR src.process.cmdline containsCIS " /create ")) AND (src.process.cmdline containsCIS "/ru ") AND ((src.process.cmdline containsCIS "NT AUT" OR src.process.cmdline containsCIS " SYSTEM "))) AND NOT ((((src.process.cmdline containsCIS "/Create /F /RU System /SC WEEKLY /TN AviraSystemSpeedupVerify /TR " OR src.process.cmdline containsCIS ":\\Program Files (x86)\\Avira\\System Speedup\\setup\\avira_speedup_setup.exe" OR src.process.cmdline containsCIS "/VERIFY /VERYSILENT /NOSTART /NODOTNET /NORESTART\" /RL HIGHEST")) OR ((src.process.cmdline containsCIS "Subscription Heartbeat" AND src.process.cmdline containsCIS "\\HeartbeatConfig.xml" AND src.process.cmdline containsCIS "\\Microsoft Shared\\OFFICE")) OR (src.process.image.path endswithCIS "\\schtasks.exe" AND (src.process.cmdline containsCIS "/TN TVInstallRestore" AND src.process.cmdline containsCIS "\\TeamViewer_.exe")))))
