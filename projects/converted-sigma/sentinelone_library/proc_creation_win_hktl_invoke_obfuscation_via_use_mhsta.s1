// Title: Invoke-Obfuscation Via Use MSHTA
// ID: ac20ae82-8758-4f38-958e-b44a3140ca88
// Status: test
// Level: high
// Author: Nikita Nazarov, oscd.community
// Date: 2020-10-08
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via use MSHTA in Scripts
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.cmdline containsCIS "set" AND src.process.cmdline containsCIS "&&" AND src.process.cmdline containsCIS "mshta" AND src.process.cmdline containsCIS "vbscript:createobject" AND src.process.cmdline containsCIS ".run" AND src.process.cmdline containsCIS "(window.close)"))
