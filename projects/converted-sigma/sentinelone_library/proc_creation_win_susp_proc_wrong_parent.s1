(((src.process.image.path endswithCIS "\\svchost.exe" OR src.process.image.path endswithCIS "\\taskhost.exe" OR src.process.image.path endswithCIS "\\lsm.exe" OR src.process.image.path endswithCIS "\\lsass.exe" OR src.process.image.path endswithCIS "\\services.exe" OR src.process.image.path endswithCIS "\\lsaiso.exe" OR src.process.image.path endswithCIS "\\csrss.exe" OR src.process.image.path endswithCIS "\\wininit.exe" OR src.process.image.path endswithCIS "\\winlogon.exe")) AND NOT ((((src.process.parent.image.path containsCIS "\\Windows Defender\\" OR src.process.parent.image.path containsCIS "\\Microsoft Security Client\\") AND src.process.parent.image.path endswithCIS "\\MsMpEng.exe") OR ((src.process.parent.image.path is null) OR ((src.process.parent.image.path = "" OR src.process.parent.image.path = "-"))) OR (((src.process.parent.image.path endswithCIS "\\SavService.exe" OR src.process.parent.image.path endswithCIS "\\ngen.exe")) OR ((src.process.parent.image.path containsCIS "\\System32\\" OR src.process.parent.image.path containsCIS "\\SysWOW64\\"))))))
