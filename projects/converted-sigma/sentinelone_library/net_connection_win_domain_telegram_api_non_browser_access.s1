// Title: Suspicious Non-Browser Network Communication With Telegram API
// ID: c3dbbc9f-ef1d-470a-a90a-d343448d5875
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-19
// Tags: attack.command-and-control, attack.exfiltration, attack.t1102, attack.t1567, attack.t1105
// Description: Detects an a non-browser process interacting with the Telegram API which could indicate use of a covert C2
// Converted by: Sigma Universal SIEM/EDR CLI

((DestinationHostname containsCIS "api.telegram.org") AND NOT (((src.process.image.path endswithCIS "\\brave.exe") OR ((src.process.image.path = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR src.process.image.path = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") OR (src.process.image.path endswithCIS "\\WindowsApps\\MicrosoftEdge.exe") OR ((src.process.image.path = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR src.process.image.path = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" OR src.process.image.path startswithCIS "C:\\Program Files\\Microsoft\\EdgeCore\\") AND (src.process.image.path endswithCIS "\\msedge.exe" OR src.process.image.path endswithCIS "\\msedgewebview2.exe")) OR ((src.process.image.path = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR src.process.image.path = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR ((src.process.image.path = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR src.process.image.path = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (src.process.image.path endswithCIS "\\maxthon.exe") OR (src.process.image.path endswithCIS "\\opera.exe") OR (src.process.image.path endswithCIS "\\safari.exe") OR (src.process.image.path endswithCIS "\\seamonkey.exe") OR (src.process.image.path endswithCIS "\\vivaldi.exe") OR (src.process.image.path endswithCIS "\\whale.exe"))))
