// Title: Potential Data Exfiltration Activity Via CommandLine Tools
// ID: 7d1aaf3d-4304-425c-b7c3-162055e0b3ab
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-02
// Tags: attack.execution, attack.t1059.001
// Description: Detects the use of various CLI utilities exfiltrating data via web requests
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.image.path endswithCIS "\\powershell_ise.exe" OR src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe" OR src.process.image.path endswithCIS "\\cmd.exe") AND (src.process.cmdline containsCIS "curl " OR src.process.cmdline containsCIS "Invoke-RestMethod" OR src.process.cmdline containsCIS "Invoke-WebRequest" OR src.process.cmdline containsCIS "irm " OR src.process.cmdline containsCIS "iwr " OR src.process.cmdline containsCIS "wget ") AND (src.process.cmdline containsCIS " -ur" AND src.process.cmdline containsCIS " -me" AND src.process.cmdline containsCIS " -b" AND src.process.cmdline containsCIS " POST ")) OR ((src.process.image.path endswithCIS "\\curl.exe" AND src.process.cmdline containsCIS "--ur") AND ((src.process.cmdline containsCIS " -d " OR src.process.cmdline containsCIS " --data "))) OR (src.process.image.path endswithCIS "\\wget.exe" AND (src.process.cmdline containsCIS "--post-data" OR src.process.cmdline containsCIS "--post-file"))) AND (((src.process.cmdline RegEx "net\s+view" OR src.process.cmdline RegEx "sc\s+query")) OR ((src.process.cmdline containsCIS "Get-Content" OR src.process.cmdline containsCIS "GetBytes" OR src.process.cmdline containsCIS "hostname" OR src.process.cmdline containsCIS "ifconfig" OR src.process.cmdline containsCIS "ipconfig" OR src.process.cmdline containsCIS "netstat" OR src.process.cmdline containsCIS "nltest" OR src.process.cmdline containsCIS "qprocess" OR src.process.cmdline containsCIS "systeminfo" OR src.process.cmdline containsCIS "tasklist" OR src.process.cmdline containsCIS "ToBase64String" OR src.process.cmdline containsCIS "whoami")) OR ((src.process.cmdline containsCIS "type " AND src.process.cmdline containsCIS " > " AND src.process.cmdline containsCIS " C:\\"))))
