// Title: MacOS Scripting Interpreter AppleScript
// ID: 1bc2e6c5-0885-472b-bed6-be5ea8eace55
// Status: test
// Level: medium
// Author: Alejandro Ortuno, oscd.community
// Date: 2020-10-21
// Tags: attack.execution, attack.t1059.002
// Description: Detects execution of AppleScript of the macOS scripting language AppleScript.
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path endswithCIS "/osascript" AND (src.process.cmdline containsCIS " -e " OR src.process.cmdline containsCIS ".scpt" OR src.process.cmdline containsCIS ".js")) AND NOT ((src.process.parent.image.path endswithCIS "opencode" AND (src.process.cmdline containsCIS "osascript" AND src.process.cmdline containsCIS " -e " AND src.process.cmdline containsCIS "set imageData to the clipboard" AND src.process.cmdline containsCIS "set fileRef"))))
