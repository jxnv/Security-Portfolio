// Title: Security Service Disabled Via Reg.EXE
// ID: 5e95028c-5229-4214-afae-d653d573d0ec
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), John Lambert (idea), elhoim
// Date: 2021-07-14
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects execution of "reg.exe" to disable security services such as Windows Defender.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "d 4" AND src.process.cmdline containsCIS "v Start") AND (src.process.cmdline containsCIS "\\AppIDSvc" OR src.process.cmdline containsCIS "\\MsMpSvc" OR src.process.cmdline containsCIS "\\NisSrv" OR src.process.cmdline containsCIS "\\SecurityHealthService" OR src.process.cmdline containsCIS "\\Sense" OR src.process.cmdline containsCIS "\\UsoSvc" OR src.process.cmdline containsCIS "\\WdBoot" OR src.process.cmdline containsCIS "\\WdFilter" OR src.process.cmdline containsCIS "\\WdNisDrv" OR src.process.cmdline containsCIS "\\WdNisSvc" OR src.process.cmdline containsCIS "\\WinDefend" OR src.process.cmdline containsCIS "\\wscsvc" OR src.process.cmdline containsCIS "\\wuauserv")) AND ((src.process.cmdline containsCIS "reg" AND src.process.cmdline containsCIS "add")))
