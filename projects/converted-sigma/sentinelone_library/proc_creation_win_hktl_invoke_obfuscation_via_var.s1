// Description: Detects Obfuscated Powershell via VAR++ LAUNCHER
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.cmdline containsCIS "&&set" AND src.process.cmdline containsCIS "cmd" AND src.process.cmdline containsCIS "/c" AND src.process.cmdline containsCIS "-f") AND (src.process.cmdline containsCIS "{0}" OR src.process.cmdline containsCIS "{1}" OR src.process.cmdline containsCIS "{2}" OR src.process.cmdline containsCIS "{3}" OR src.process.cmdline containsCIS "{4}" OR src.process.cmdline containsCIS "{5}"))
