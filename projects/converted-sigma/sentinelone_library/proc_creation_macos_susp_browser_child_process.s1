(((src.process.parent.image.path containsCIS "com.apple.WebKit.WebContent" OR src.process.parent.image.path containsCIS "firefox" OR src.process.parent.image.path containsCIS "Google Chrome Helper" OR src.process.parent.image.path containsCIS "Google Chrome" OR src.process.parent.image.path containsCIS "Microsoft Edge" OR src.process.parent.image.path containsCIS "Opera" OR src.process.parent.image.path containsCIS "Safari" OR src.process.parent.image.path containsCIS "Tor Browser") AND (src.process.image.path endswithCIS "/bash" OR src.process.image.path endswithCIS "/curl" OR src.process.image.path endswithCIS "/dash" OR src.process.image.path endswithCIS "/ksh" OR src.process.image.path endswithCIS "/osascript" OR src.process.image.path endswithCIS "/perl" OR src.process.image.path endswithCIS "/php" OR src.process.image.path endswithCIS "/pwsh" OR src.process.image.path endswithCIS "/python" OR src.process.image.path endswithCIS "/sh" OR src.process.image.path endswithCIS "/tcsh" OR src.process.image.path endswithCIS "/wget" OR src.process.image.path endswithCIS "/zsh")) AND NOT ((((src.process.parent.image.path containsCIS "Google Chrome Helper" OR src.process.parent.image.path containsCIS "Google Chrome") AND (src.process.cmdline containsCIS "/Volumes/Google Chrome/Google Chrome.app/Contents/Frameworks/*/Resources/install.sh" OR src.process.cmdline containsCIS "/Applications/Google Chrome.app/Contents/Frameworks/Google Chrome Framework.framework/*/Resources/keystone_promote_preflight.sh" OR src.process.cmdline containsCIS "/Applications/Google Chrome.app/Contents/Frameworks/Google Chrome Framework.framework/*/Resources/keystone_promote_postflight.sh")) OR ((src.process.parent.image.path containsCIS "Google Chrome Helper" OR src.process.parent.image.path containsCIS "Google Chrome") AND (src.process.cmdline containsCIS "/Users/" AND src.process.cmdline containsCIS "/Library/Application Support/Google/Chrome/recovery/" AND src.process.cmdline containsCIS "/ChromeRecovery")) OR (src.process.cmdline containsCIS "--defaults-torrc") OR (src.process.cmdline containsCIS "/Library/Application Support/Microsoft/MAU*/Microsoft AutoUpdate.app/Contents/MacOS/msupdate") OR (src.process.parent.image.path containsCIS "Microsoft Edge" AND (src.process.cmdline containsCIS "IOPlatformExpertDevice" OR src.process.cmdline containsCIS "hw.model")))) AND NOT (((src.process.cmdline = "") OR (src.process.cmdline is null))))
