// Title: Suspicious WindowsTerminal Child Processes
// ID: 8de89e52-f6e1-4b5b-afd1-41ecfa300d48
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-25
// Tags: attack.execution, attack.persistence
// Description: Detects suspicious children spawned via the Windows Terminal application which could be a sign of persistence via WindowsTerminal (see references section)
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.parent.image.path endswithCIS "\\WindowsTerminal.exe" OR src.process.parent.image.path endswithCIS "\\wt.exe")) AND (((src.process.image.path endswithCIS "\\rundll32.exe" OR src.process.image.path endswithCIS "\\regsvr32.exe" OR src.process.image.path endswithCIS "\\certutil.exe" OR src.process.image.path endswithCIS "\\cscript.exe" OR src.process.image.path endswithCIS "\\wscript.exe" OR src.process.image.path endswithCIS "\\csc.exe")) OR ((src.process.image.path containsCIS "C:\\Users\\Public\\" OR src.process.image.path containsCIS "\\Downloads\\" OR src.process.image.path containsCIS "\\Desktop\\" OR src.process.image.path containsCIS "\\AppData\\Local\\Temp\\" OR src.process.image.path containsCIS "\\Windows\\TEMP\\")) OR ((src.process.cmdline containsCIS " iex " OR src.process.cmdline containsCIS " icm" OR src.process.cmdline containsCIS "Invoke-" OR src.process.cmdline containsCIS "Import-Module " OR src.process.cmdline containsCIS "ipmo " OR src.process.cmdline containsCIS "DownloadString(" OR src.process.cmdline containsCIS " /c " OR src.process.cmdline containsCIS " /k " OR src.process.cmdline containsCIS " /r ")))) AND NOT ((((src.process.cmdline containsCIS "Import-Module" AND src.process.cmdline containsCIS "Microsoft.VisualStudio.DevShell.dll" AND src.process.cmdline containsCIS "Enter-VsDevShell")) OR ((src.process.cmdline containsCIS "\\AppData\\Local\\Packages\\Microsoft.WindowsTerminal_" AND src.process.cmdline containsCIS "\\LocalState\\settings.json")) OR ((src.process.cmdline containsCIS "C:\\Program Files\\Microsoft Visual Studio\\" AND src.process.cmdline containsCIS "\\Common7\\Tools\\VsDevCmd.bat")))))
