((src.process.cmdline containsCIS "/etc/resolv.conf") OR ((src.process.image.path endswithCIS "/firewall-cmd" OR src.process.image.path endswithCIS "/ufw" OR src.process.image.path endswithCIS "/iptables" OR src.process.image.path endswithCIS "/netstat" OR src.process.image.path endswithCIS "/ss" OR src.process.image.path endswithCIS "/ip" OR src.process.image.path endswithCIS "/ifconfig" OR src.process.image.path endswithCIS "/systemd-resolve" OR src.process.image.path endswithCIS "/route")))
