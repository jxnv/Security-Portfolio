// Title: Malicious PowerShell Keywords
// ID: f62176f3-8128-4faa-bf6c-83261322e5eb
// Status: test
// Level: medium
// Author: Sean Metcalf (source), Florian Roth (Nextron Systems)
// Date: 2017-03-05
// Tags: attack.execution, attack.t1059.001
// Description: Detects keywords from well-known PowerShell exploitation frameworks
// Converted by: Sigma Universal SIEM/EDR CLI

((ScriptBlockText containsCIS "AdjustTokenPrivileges" OR ScriptBlockText containsCIS "IMAGE_NT_OPTIONAL_HDR64_MAGIC" OR ScriptBlockText containsCIS "Metasploit" OR ScriptBlockText containsCIS "Microsoft.Win32.UnsafeNativeMethods" OR ScriptBlockText containsCIS "Mimikatz" OR ScriptBlockText containsCIS "MiniDumpWriteDump" OR ScriptBlockText containsCIS "PAGE_EXECUTE_READ" OR ScriptBlockText containsCIS "ReadProcessMemory.Invoke" OR ScriptBlockText containsCIS "SE_PRIVILEGE_ENABLED" OR ScriptBlockText containsCIS "SECURITY_DELEGATION" OR ScriptBlockText containsCIS "TOKEN_ADJUST_PRIVILEGES" OR ScriptBlockText containsCIS "TOKEN_ALL_ACCESS" OR ScriptBlockText containsCIS "TOKEN_ASSIGN_PRIMARY" OR ScriptBlockText containsCIS "TOKEN_DUPLICATE" OR ScriptBlockText containsCIS "TOKEN_ELEVATION" OR ScriptBlockText containsCIS "TOKEN_IMPERSONATE" OR ScriptBlockText containsCIS "TOKEN_INFORMATION_CLASS" OR ScriptBlockText containsCIS "TOKEN_PRIVILEGES" OR ScriptBlockText containsCIS "TOKEN_QUERY"))
