// Title: PowerShell Script Dropped Via PowerShell.EXE
// ID: 576426ad-0131-4001-ae01-be175da0c108
// Status: test
// Level: low
// Author: frack113
// Date: 2023-05-09
// Tags: attack.persistence
// Description: Detects PowerShell creating a PowerShell file (.ps1). While often times this behavior is benign, sometimes it can be a sign of a dropper script trying to achieve persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe") AND tgt.file.path endswithCIS ".ps1") AND NOT (((tgt.file.path startswithCIS "C:\\Users\\" AND tgt.file.path containsCIS "\\AppData\\Local\\Temp\\") OR (tgt.file.path containsCIS "__PSScriptPolicyTest_") OR (tgt.file.path startswithCIS "C:\\Windows\\Temp\\"))))
