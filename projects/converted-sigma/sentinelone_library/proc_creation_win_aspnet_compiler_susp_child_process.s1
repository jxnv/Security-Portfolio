// Tags: attack.execution, attack.stealth, attack.t1127
// Description: Detects potentially suspicious child processes of "aspnet_compiler.exe".
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.image.path endswithCIS "\\calc.exe" OR src.process.image.path endswithCIS "\\notepad.exe")) OR ((src.process.image.path containsCIS "\\Users\\Public\\" OR src.process.image.path containsCIS "\\AppData\\Local\\Temp\\" OR src.process.image.path containsCIS "\\AppData\\Local\\Roaming\\" OR src.process.image.path containsCIS ":\\Temp\\" OR src.process.image.path containsCIS ":\\Windows\\Temp\\" OR src.process.image.path containsCIS ":\\Windows\\System32\\Tasks\\" OR src.process.image.path containsCIS ":\\Windows\\Tasks\\"))) AND (src.process.parent.image.path endswithCIS "\\aspnet_compiler.exe"))
