// Title: Execution of Suspicious File Type Extension
// ID: c09dad97-1c78-4f71-b127-7edb2b8e491a
// Status: test
// Level: medium
// Author: Max Altgelt (Nextron Systems)
// Date: 2021-12-09
// Tags: attack.stealth
// Description: Detects whether the image specified in a process creation event doesn't refer to an ".exe" (or other known executable extension) file. This can be caused by process ghosting or other unorthodox methods to start a process.
// This rule might require some initial baselining to align with some third party tooling in the user environment.
// Converted by: Sigma Universal SIEM/EDR CLI

(NOT (((src.process.image.path endswithCIS ".bin" OR src.process.image.path endswithCIS ".cgi" OR src.process.image.path endswithCIS ".com" OR src.process.image.path endswithCIS ".exe" OR src.process.image.path endswithCIS ".scr" OR src.process.image.path endswithCIS ".tmp"))) AND NOT (((src.process.image.path containsCIS ":\\$Extend\\$Deleted\\") OR (src.process.image.path containsCIS ":\\Windows\\System32\\DriverStore\\FileRepository\\") OR ((src.process.image.path = "-" OR src.process.image.path = "")) OR ((src.process.image.path = "System" OR src.process.image.path = "Registry" OR src.process.image.path = "MemCompression" OR src.process.image.path = "vmmem")) OR (src.process.image.path containsCIS ":\\Windows\\Installer\\MSI") OR (src.process.image.path containsCIS ":\\Config.Msi\\" AND (src.process.image.path endswithCIS ".rbf" OR src.process.image.path endswithCIS ".rbs")) OR (src.process.image.path is null) OR ((src.process.parent.image.path containsCIS ":\\Windows\\Temp\\") OR (src.process.image.path containsCIS ":\\Windows\\Temp\\")))) AND NOT (((src.process.parent.image.path containsCIS ":\\ProgramData\\Avira\\") OR (src.process.parent.image.path = "C:\\Windows\\System32\\services.exe" AND src.process.image.path endswithCIS "com.docker.service") OR (src.process.image.path containsCIS ":\\Program Files\\Mozilla Firefox\\") OR (src.process.image.path endswithCIS "\\LZMA_EXE") OR ((src.process.image.path endswithCIS ":\\Program Files (x86)\\MyQ\\Server\\pcltool.dll" OR src.process.image.path endswithCIS ":\\Program Files\\MyQ\\Server\\pcltool.dll")) OR (src.process.image.path containsCIS "NVIDIA\\NvBackend\\" AND src.process.image.path endswithCIS ".dat") OR ((src.process.image.path containsCIS ":\\Program Files (x86)\\WINPAKPRO\\" OR src.process.image.path containsCIS ":\\Program Files\\WINPAKPRO\\") AND src.process.image.path endswithCIS ".ngn") OR ((src.process.image.path containsCIS "\\AppData\\Local\\Packages\\" AND src.process.image.path containsCIS "\\LocalState\\rootfs\\")))))
