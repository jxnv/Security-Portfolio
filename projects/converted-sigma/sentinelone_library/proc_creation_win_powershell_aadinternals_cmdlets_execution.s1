// Title: AADInternals PowerShell Cmdlets Execution - ProccessCreation
// ID: c86500e9-a645-4680-98d7-f882c70c1ea3
// Status: test
// Level: high
// Author: Austin Songer (@austinsonger), Nasreddine Bencherchali (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2022-12-23
// Tags: attack.execution, attack.reconnaissance, attack.discovery, attack.credential-access, attack.impact
// Description: Detects ADDInternals Cmdlet execution. A tool for administering Azure AD and Office 365. Which can be abused by threat actors to attack Azure AD or Office 365.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "Add-AADInt" OR src.process.cmdline containsCIS "ConvertTo-AADInt" OR src.process.cmdline containsCIS "Disable-AADInt" OR src.process.cmdline containsCIS "Enable-AADInt" OR src.process.cmdline containsCIS "Export-AADInt" OR src.process.cmdline containsCIS "Find-AADInt" OR src.process.cmdline containsCIS "Get-AADInt" OR src.process.cmdline containsCIS "Grant-AADInt" OR src.process.cmdline containsCIS "Initialize-AADInt" OR src.process.cmdline containsCIS "Install-AADInt" OR src.process.cmdline containsCIS "Invoke-AADInt" OR src.process.cmdline containsCIS "Join-AADInt" OR src.process.cmdline containsCIS "New-AADInt" OR src.process.cmdline containsCIS "Open-AADInt" OR src.process.cmdline containsCIS "Read-AADInt" OR src.process.cmdline containsCIS "Register-AADInt" OR src.process.cmdline containsCIS "Remove-AADInt" OR src.process.cmdline containsCIS "Reset-AADInt" OR src.process.cmdline containsCIS "Resolve-AADInt" OR src.process.cmdline containsCIS "Restore-AADInt" OR src.process.cmdline containsCIS "Save-AADInt" OR src.process.cmdline containsCIS "Search-AADInt" OR src.process.cmdline containsCIS "Send-AADInt" OR src.process.cmdline containsCIS "Set-AADInt" OR src.process.cmdline containsCIS "Start-AADInt" OR src.process.cmdline containsCIS "Unprotect-AADInt" OR src.process.cmdline containsCIS "Update-AADInt")) AND (((src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\powershell_ise.exe" OR src.process.image.path endswithCIS "\\pwsh.exe")) OR ((OriginalFileName = "PowerShell.Exe" OR OriginalFileName = "pwsh.dll"))))
