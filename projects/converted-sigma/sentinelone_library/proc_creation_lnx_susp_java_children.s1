// Title: Suspicious Java Children Processes
// ID: d292e0af-9a18-420c-9525-ec0ac3936892
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-03
// Tags: attack.execution, attack.t1059
// Description: Detects java process spawning suspicious children
// Converted by: Sigma Universal SIEM/EDR CLI

(src.process.parent.image.path endswithCIS "/java" AND (src.process.cmdline containsCIS "/bin/sh" OR src.process.cmdline containsCIS "bash" OR src.process.cmdline containsCIS "dash" OR src.process.cmdline containsCIS "ksh" OR src.process.cmdline containsCIS "zsh" OR src.process.cmdline containsCIS "csh" OR src.process.cmdline containsCIS "fish" OR src.process.cmdline containsCIS "curl" OR src.process.cmdline containsCIS "wget" OR src.process.cmdline containsCIS "python"))
