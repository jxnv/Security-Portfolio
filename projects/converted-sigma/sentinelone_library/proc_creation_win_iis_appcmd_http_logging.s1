// Description: Disables HTTP logging on a Windows IIS web server as seen by Threat Group 3390 (Bronze Union)
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "set" AND src.process.cmdline containsCIS "config" AND src.process.cmdline containsCIS "section:httplogging" AND src.process.cmdline containsCIS "dontLog:true")) AND ((src.process.image.path endswithCIS "\\appcmd.exe") OR (OriginalFileName = "appcmd.exe")))
