// Date: 2024-01-02
// Tags: attack.execution, attack.stealth, attack.t1218
// Description: Detects commandline arguments for executing a child process via dotnet-trace.exe
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "-- " AND src.process.cmdline containsCIS "collect")) AND ((src.process.image.path endswithCIS "\\dotnet-trace.exe") OR (OriginalFileName = "dotnet-trace.dll")))
