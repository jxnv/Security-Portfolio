// Title: Root Certificate Installed From Susp Locations
// ID: 5f6a601c-2ecb-498b-9c33-660362323afa
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.defense-impairment, attack.t1553.004
// Description: Adversaries may install a root certificate on a compromised system to avoid warnings when connecting to adversary controlled web servers.
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.cmdline containsCIS "Import-Certificate" AND src.process.cmdline containsCIS " -FilePath " AND src.process.cmdline containsCIS "Cert:\\LocalMachine\\Root") AND (src.process.cmdline containsCIS "\\AppData\\Local\\Temp\\" OR src.process.cmdline containsCIS ":\\Windows\\TEMP\\" OR src.process.cmdline containsCIS "\\Desktop\\" OR src.process.cmdline containsCIS "\\Downloads\\" OR src.process.cmdline containsCIS "\\Perflogs\\" OR src.process.cmdline containsCIS ":\\Users\\Public\\"))
