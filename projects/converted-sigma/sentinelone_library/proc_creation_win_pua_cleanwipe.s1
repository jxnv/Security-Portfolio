// Title: PUA - CleanWipe Execution
// ID: f44800ac-38ec-471f-936e-3fa7d9c53100
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-12-18
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects the use of CleanWipe a tool usually used to delete Symantec antivirus.
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path endswithCIS "\\SepRemovalToolNative_x64.exe") OR (src.process.image.path endswithCIS "\\CATClean.exe" AND src.process.cmdline containsCIS "--uninstall") OR (src.process.image.path endswithCIS "\\NetInstaller.exe" AND src.process.cmdline containsCIS "-r") OR (src.process.image.path endswithCIS "\\WFPUnins.exe" AND (src.process.cmdline containsCIS "/uninstall" AND src.process.cmdline containsCIS "/enterprise")))
