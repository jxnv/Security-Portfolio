// Title: Potential Defense Evasion Via Rename Of Highly Relevant Binaries
// ID: 0ba1da6d-b6ce-4366-828c-18826c9de23e
// Status: test
// Level: high
// Author: Matthew Green - @mgreen27, Florian Roth (Nextron Systems), frack113
// Date: 2019-06-15
// Tags: attack.stealth, attack.t1036.003, car.2013-05-009
// Description: Detects the execution of a renamed binary often used by attackers or malware leveraging new Sysmon OriginalFileName datapoint.
// Converted by: Sigma Universal SIEM/EDR CLI

(((Description = "Execute processes remotely") OR (Product = "Sysinternals PsExec") OR ((Description startswithCIS "Windows PowerShell" OR Description startswithCIS "pwsh")) OR ((OriginalFileName = "certutil.exe" OR OriginalFileName = "cmstp.exe" OR OriginalFileName = "cscript.exe" OR OriginalFileName = "IE4UINIT.EXE" OR OriginalFileName = "finger.exe" OR OriginalFileName = "mshta.exe" OR OriginalFileName = "msiexec.exe" OR OriginalFileName = "msxsl.exe" OR OriginalFileName = "powershell_ise.exe" OR OriginalFileName = "powershell.exe" OR OriginalFileName = "psexec.c" OR OriginalFileName = "psexec.exe" OR OriginalFileName = "psexesvc.exe" OR OriginalFileName = "pwsh.dll" OR OriginalFileName = "reg.exe" OR OriginalFileName = "regsvr32.exe" OR OriginalFileName = "rundll32.exe" OR OriginalFileName = "WerMgr" OR OriginalFileName = "wmic.exe" OR OriginalFileName = "wscript.exe"))) AND NOT (((src.process.image.path endswithCIS "\\certutil.exe" OR src.process.image.path endswithCIS "\\cmstp.exe" OR src.process.image.path endswithCIS "\\cscript.exe" OR src.process.image.path endswithCIS "\\ie4uinit.exe" OR src.process.image.path endswithCIS "\\finger.exe" OR src.process.image.path endswithCIS "\\mshta.exe" OR src.process.image.path endswithCIS "\\msiexec.exe" OR src.process.image.path endswithCIS "\\msxsl.exe" OR src.process.image.path endswithCIS "\\powershell_ise.exe" OR src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\psexec.exe" OR src.process.image.path endswithCIS "\\psexec64.exe" OR src.process.image.path endswithCIS "\\psexec64a.exe" OR src.process.image.path endswithCIS "\\PSEXESVC.exe" OR src.process.image.path endswithCIS "\\pwsh.exe" OR src.process.image.path endswithCIS "\\reg.exe" OR src.process.image.path endswithCIS "\\regsvr32.exe" OR src.process.image.path endswithCIS "\\rundll32.exe" OR src.process.image.path endswithCIS "\\wermgr.exe" OR src.process.image.path endswithCIS "\\wmic.exe" OR src.process.image.path endswithCIS "\\wscript.exe"))))
