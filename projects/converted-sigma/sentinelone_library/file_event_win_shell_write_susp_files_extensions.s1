((((src.process.image.path endswithCIS "\\csrss.exe" OR src.process.image.path endswithCIS "\\lsass.exe" OR src.process.image.path endswithCIS "\\RuntimeBroker.exe" OR src.process.image.path endswithCIS "\\sihost.exe" OR src.process.image.path endswithCIS "\\smss.exe" OR src.process.image.path endswithCIS "\\wininit.exe" OR src.process.image.path endswithCIS "\\winlogon.exe") AND (tgt.file.path endswithCIS ".bat" OR tgt.file.path endswithCIS ".dll" OR tgt.file.path endswithCIS ".exe" OR tgt.file.path endswithCIS ".hta" OR tgt.file.path endswithCIS ".iso" OR tgt.file.path endswithCIS ".ps1" OR tgt.file.path endswithCIS ".txt" OR tgt.file.path endswithCIS ".vbe" OR tgt.file.path endswithCIS ".vbs")) OR ((src.process.image.path endswithCIS "\\dllhost.exe" OR src.process.image.path endswithCIS "\\rundll32.exe" OR src.process.image.path endswithCIS "\\svchost.exe") AND (tgt.file.path endswithCIS ".bat" OR tgt.file.path endswithCIS ".hta" OR tgt.file.path endswithCIS ".iso" OR tgt.file.path endswithCIS ".ps1" OR tgt.file.path endswithCIS ".vbe" OR tgt.file.path endswithCIS ".vbs"))) AND NOT (((src.process.image.path = "C:\\Windows\\System32\\dllhost.exe" AND (tgt.file.path containsCIS ":\\Users\\" AND tgt.file.path containsCIS "\\AppData\\Local\\Temp\\__PSScriptPolicyTest_") AND tgt.file.path endswithCIS ".ps1") OR (src.process.image.path = "C:\\Windows\\system32\\svchost.exe" AND (tgt.file.path containsCIS "C:\\Program Files\\WindowsApps\\Clipchamp" AND tgt.file.path containsCIS ".ps1")) OR ((src.process.image.path = "C:\\Windows\\system32\\svchost.exe" OR src.process.image.path = "C:\\Windows\\SysWOW64\\svchost.exe") AND (tgt.file.path startswithCIS "C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview" OR tgt.file.path startswithCIS "C:\\Program Files (x86)\\WindowsApps\\Microsoft.PowerShellPreview") AND tgt.file.path endswithCIS ".ps1") OR (src.process.image.path = "C:\\Windows\\system32\\svchost.exe" AND (tgt.file.path containsCIS "C:\\Windows\\System32\\GroupPolicy\\DataStore\\" AND tgt.file.path containsCIS "\\sysvol\\" AND tgt.file.path containsCIS "\\Policies\\" AND tgt.file.path containsCIS "\\Machine\\Scripts\\Startup\\") AND (tgt.file.path endswithCIS ".ps1" OR tgt.file.path endswithCIS ".bat")))))
