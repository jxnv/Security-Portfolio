// Title: Suspicious File Downloaded From Direct IP Via Certutil.EXE
// ID: 13e6fe51-d478-4c7e-b0f2-6da9b400a829
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-15
// Tags: attack.stealth, attack.t1027, attack.command-and-control, attack.t1105
// Description: Detects the execution of certutil with certain flags that allow the utility to download files from direct IPs.
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.cmdline containsCIS "urlcache " OR src.process.cmdline containsCIS "verifyctl " OR src.process.cmdline containsCIS "URL ")) AND ((src.process.cmdline containsCIS "://1" OR src.process.cmdline containsCIS "://2" OR src.process.cmdline containsCIS "://3" OR src.process.cmdline containsCIS "://4" OR src.process.cmdline containsCIS "://5" OR src.process.cmdline containsCIS "://6" OR src.process.cmdline containsCIS "://7" OR src.process.cmdline containsCIS "://8" OR src.process.cmdline containsCIS "://9")) AND ((src.process.image.path endswithCIS "\\certutil.exe") OR (OriginalFileName = "CertUtil.exe"))) AND NOT ((src.process.cmdline containsCIS "://7-")))
