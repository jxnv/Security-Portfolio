// Title: Suspicious Use of PsLogList
// ID: aae1243f-d8af-40d8-ab20-33fc6d0c55bc
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-12-18
// Tags: attack.discovery, attack.t1087, attack.t1087.001, attack.t1087.002
// Description: Detects usage of the PsLogList utility to dump event log in order to extract admin accounts and perform account discovery or delete events logs
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS " security" OR src.process.cmdline containsCIS " application" OR src.process.cmdline containsCIS " system")) AND ((src.process.cmdline containsCIS " -d" OR src.process.cmdline containsCIS " -x" OR src.process.cmdline containsCIS " -s" OR src.process.cmdline containsCIS " -c" OR src.process.cmdline containsCIS " -g")) AND ((OriginalFileName = "psloglist.exe") OR ((src.process.image.path endswithCIS "\\psloglist.exe" OR src.process.image.path endswithCIS "\\psloglist64.exe" OR src.process.image.path endswithCIS "\\psloglist64a.exe"))))
