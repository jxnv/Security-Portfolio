// Title: Netsh Allow Group Policy on Microsoft Defender Firewall
// ID: 347906f3-e207-4d18-ae5b-a9403d6bcdef
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-01-09
// Tags: attack.defense-impairment, attack.t1686.003
// Description: Adversaries may modify system firewalls in order to bypass controls limiting network usage
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "advfirewall" AND src.process.cmdline containsCIS "firewall" AND src.process.cmdline containsCIS "set" AND src.process.cmdline containsCIS "rule" AND src.process.cmdline containsCIS "group=" AND src.process.cmdline containsCIS "new" AND src.process.cmdline containsCIS "enable=Yes")) AND ((src.process.image.path endswithCIS "\\netsh.exe") OR (OriginalFileName = "netsh.exe")))
