// Title: Scripting/CommandLine Process Spawned Regsvr32
// ID: ab37a6ec-6068-432b-a64e-2c7bf95b1d22
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-26
// Tags: attack.stealth, attack.t1218.010
// Description: Detects various command line and scripting engines/processes such as "PowerShell", "Wscript", "Cmd", etc. spawning a "regsvr32" instance.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.parent.image.path endswithCIS "\\cmd.exe" OR src.process.parent.image.path endswithCIS "\\cscript.exe" OR src.process.parent.image.path endswithCIS "\\mshta.exe" OR src.process.parent.image.path endswithCIS "\\powershell_ise.exe" OR src.process.parent.image.path endswithCIS "\\powershell.exe" OR src.process.parent.image.path endswithCIS "\\pwsh.exe" OR src.process.parent.image.path endswithCIS "\\wscript.exe") AND src.process.image.path endswithCIS "\\regsvr32.exe") AND NOT ((src.process.parent.image.path = "C:\\Windows\\System32\\cmd.exe" AND src.process.cmdline endswithCIS " /s C:\\Windows\\System32\\RpcProxy\\RpcProxy.dll")))
