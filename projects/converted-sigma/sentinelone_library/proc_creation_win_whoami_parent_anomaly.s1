(((src.process.image.path endswithCIS "\\whoami.exe") OR (OriginalFileName = "whoami.exe")) AND NOT ((((src.process.parent.image.path endswithCIS "\\cmd.exe" OR src.process.parent.image.path endswithCIS "\\powershell_ise.exe" OR src.process.parent.image.path endswithCIS "\\powershell.exe" OR src.process.parent.image.path endswithCIS "\\pwsh.exe")) OR ((src.process.parent.image.path = "" OR src.process.parent.image.path = "-")) OR (src.process.parent.image.path is null))) AND NOT ((src.process.parent.image.path endswithCIS ":\\Program Files\\Microsoft Monitoring Agent\\Agent\\MonitoringHost.exe")))
