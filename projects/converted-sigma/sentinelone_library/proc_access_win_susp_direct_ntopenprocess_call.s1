// Title: Potential Direct Syscall of NtOpenProcess
// ID: 3f3f3506-1895-401b-9cc3-e86b16e630d0
// Status: test
// Level: medium
// Author: Christian Burkard (Nextron Systems), Tim Shelton (FP)
// Date: 2021-07-28
// Tags: attack.execution, attack.t1106
// Description: Detects potential calls to NtOpenProcess directly from NTDLL.
// Converted by: Sigma Universal SIEM/EDR CLI

((CallTrace startswithCIS "UNKNOWN") AND NOT ((((SourceImage containsCIS ":\\Program Files (x86)\\" OR SourceImage containsCIS ":\\Program Files\\" OR SourceImage containsCIS ":\\Windows\\System32\\" OR SourceImage containsCIS ":\\Windows\\SysWOW64\\" OR SourceImage containsCIS ":\\Windows\\WinSxS\\") AND (TargetImage containsCIS ":\\Program Files (x86)\\" OR TargetImage containsCIS ":\\Program Files\\" OR TargetImage containsCIS ":\\Windows\\System32\\" OR TargetImage containsCIS ":\\Windows\\SysWOW64\\" OR TargetImage containsCIS ":\\Windows\\WinSxS\\")) OR (Provider_Name = "Microsoft-Windows-Kernel-Audit-API-Calls") OR (TargetImage endswithCIS "vcredist_x64.exe" AND SourceImage endswithCIS "vcredist_x64.exe"))) AND NOT (((SourceImage containsCIS ":\\Program Files\\Adobe\\Acrobat DC\\Acrobat\\" AND SourceImage endswithCIS "\\AcroCEF.exe" AND TargetImage containsCIS ":\\Program Files\\Adobe\\Acrobat DC\\Acrobat\\" AND TargetImage endswithCIS "\\AcroCEF.exe") OR (SourceImage endswithCIS "AmazonSSMAgentSetup.exe" AND TargetImage endswithCIS "AmazonSSMAgentSetup.exe") OR (SourceImage endswithCIS ":\\Windows\\Explorer.EXE" AND TargetImage endswithCIS ":\\Program Files\\Cylance\\Desktop\\CylanceUI.exe") OR (TargetImage containsCIS "\\AppData\\Local\\Discord\\" AND TargetImage endswithCIS "\\Discord.exe") OR (TargetImage endswithCIS "\\Evernote\\Evernote.exe") OR (TargetImage endswithCIS "\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe" AND SourceImage endswithCIS "\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe") OR (TargetImage endswithCIS ":\\Windows\\system32\\systeminfo.exe" AND SourceImage endswithCIS "setup64.exe") OR (SourceImage endswithCIS "\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe" AND TargetImage endswithCIS "\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe") OR (SourceImage containsCIS "\\AppData\\Local\\yammerdesktop\\app-" AND SourceImage endswithCIS "\\Yammer.exe" AND TargetImage containsCIS "\\AppData\\Local\\yammerdesktop\\app-" AND TargetImage endswithCIS "\\Yammer.exe" AND GrantedAccess = "0x1000"))))
