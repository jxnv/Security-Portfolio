// Title: File Download From IP URL Via Curl.EXE
// ID: 9cc85849-3b02-4cb5-b371-3a1ff54f2218
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-10-18
// Tags: attack.execution
// Description: Detects file downloads directly from IP address URL using curl.exe
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.cmdline containsCIS " -O" OR src.process.cmdline containsCIS "--remote-name" OR src.process.cmdline containsCIS "--output")) AND (src.process.cmdline containsCIS "http") AND ((src.process.image.path endswithCIS "\\curl.exe") OR (OriginalFileName = "curl.exe")) AND (src.process.cmdline RegEx "://[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}")) AND NOT (((src.process.cmdline endswithCIS ".bat" OR src.process.cmdline endswithCIS ".bat\"" OR src.process.cmdline endswithCIS ".dat" OR src.process.cmdline endswithCIS ".dat\"" OR src.process.cmdline endswithCIS ".dll" OR src.process.cmdline endswithCIS ".dll\"" OR src.process.cmdline endswithCIS ".exe" OR src.process.cmdline endswithCIS ".exe\"" OR src.process.cmdline endswithCIS ".gif" OR src.process.cmdline endswithCIS ".gif\"" OR src.process.cmdline endswithCIS ".hta" OR src.process.cmdline endswithCIS ".hta\"" OR src.process.cmdline endswithCIS ".jpeg" OR src.process.cmdline endswithCIS ".jpeg\"" OR src.process.cmdline endswithCIS ".log" OR src.process.cmdline endswithCIS ".log\"" OR src.process.cmdline endswithCIS ".msi" OR src.process.cmdline endswithCIS ".msi\"" OR src.process.cmdline endswithCIS ".png" OR src.process.cmdline endswithCIS ".png\"" OR src.process.cmdline endswithCIS ".ps1" OR src.process.cmdline endswithCIS ".ps1\"" OR src.process.cmdline endswithCIS ".psm1" OR src.process.cmdline endswithCIS ".psm1\"" OR src.process.cmdline endswithCIS ".vbe" OR src.process.cmdline endswithCIS ".vbe\"" OR src.process.cmdline endswithCIS ".vbs" OR src.process.cmdline endswithCIS ".vbs\"" OR src.process.cmdline endswithCIS ".bat'" OR src.process.cmdline endswithCIS ".dat'" OR src.process.cmdline endswithCIS ".dll'" OR src.process.cmdline endswithCIS ".exe'" OR src.process.cmdline endswithCIS ".gif'" OR src.process.cmdline endswithCIS ".hta'" OR src.process.cmdline endswithCIS ".jpeg'" OR src.process.cmdline endswithCIS ".log'" OR src.process.cmdline endswithCIS ".msi'" OR src.process.cmdline endswithCIS ".png'" OR src.process.cmdline endswithCIS ".ps1'" OR src.process.cmdline endswithCIS ".psm1'" OR src.process.cmdline endswithCIS ".vbe'" OR src.process.cmdline endswithCIS ".vbs'"))))
