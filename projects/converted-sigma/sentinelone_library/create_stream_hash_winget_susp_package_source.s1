// Title: Potential Suspicious Winget Package Installation
// ID: a3f5c081-e75b-43a0-9f5b-51f26fe5dba2
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.persistence, attack.stealth
// Description: Detects potential suspicious winget package installation from a suspicious source.
// Converted by: Sigma Universal SIEM/EDR CLI

(Contents startswithCIS "[ZoneTransfer]  ZoneId=3" AND (Contents containsCIS "://1" OR Contents containsCIS "://2" OR Contents containsCIS "://3" OR Contents containsCIS "://4" OR Contents containsCIS "://5" OR Contents containsCIS "://6" OR Contents containsCIS "://7" OR Contents containsCIS "://8" OR Contents containsCIS "://9") AND tgt.file.path endswithCIS ":Zone.Identifier" AND tgt.file.path containsCIS "\\AppData\\Local\\Temp\\WinGet\\")
