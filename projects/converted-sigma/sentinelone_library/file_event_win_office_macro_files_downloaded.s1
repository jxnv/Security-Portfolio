// Title: Office Macro File Download
// ID: 0e29e3a7-1ad8-40aa-b691-9f82ecd33d66
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-23
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects the creation of a new office macro files on the system via an application (browser, mail client).
// This can help identify potential malicious activity, such as the download of macro-enabled documents that could be used for exploitation.
// Converted by: Sigma Universal SIEM/EDR CLI

((((tgt.file.path endswithCIS ".docm" OR tgt.file.path endswithCIS ".dotm" OR tgt.file.path endswithCIS ".xlsm" OR tgt.file.path endswithCIS ".xltm" OR tgt.file.path endswithCIS ".potm" OR tgt.file.path endswithCIS ".pptm")) OR ((tgt.file.path containsCIS ".docm:Zone" OR tgt.file.path containsCIS ".dotm:Zone" OR tgt.file.path containsCIS ".xlsm:Zone" OR tgt.file.path containsCIS ".xltm:Zone" OR tgt.file.path containsCIS ".potm:Zone" OR tgt.file.path containsCIS ".pptm:Zone"))) AND ((src.process.image.path endswithCIS "\\RuntimeBroker.exe" OR src.process.image.path endswithCIS "\\outlook.exe" OR src.process.image.path endswithCIS "\\thunderbird.exe" OR src.process.image.path endswithCIS "\\brave.exe" OR src.process.image.path endswithCIS "\\chrome.exe" OR src.process.image.path endswithCIS "\\firefox.exe" OR src.process.image.path endswithCIS "\\iexplore.exe" OR src.process.image.path endswithCIS "\\maxthon.exe" OR src.process.image.path endswithCIS "\\MicrosoftEdge.exe" OR src.process.image.path endswithCIS "\\msedge.exe" OR src.process.image.path endswithCIS "\\msedgewebview2.exe" OR src.process.image.path endswithCIS "\\opera.exe" OR src.process.image.path endswithCIS "\\safari.exe" OR src.process.image.path endswithCIS "\\seamonkey.exe" OR src.process.image.path endswithCIS "\\vivaldi.exe" OR src.process.image.path endswithCIS "\\whale.exe")))
