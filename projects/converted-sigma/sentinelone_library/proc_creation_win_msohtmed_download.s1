// Title: Arbitrary File Download Via MSOHTMED.EXE
// ID: 459f2f98-397b-4a4a-9f47-6a5ec2f1c69d
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-19
// Tags: attack.execution, attack.stealth, attack.t1218
// Description: Detects usage of "MSOHTMED" to download arbitrary files
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "ftp://" OR src.process.cmdline containsCIS "http://" OR src.process.cmdline containsCIS "https://")) AND ((src.process.image.path endswithCIS "\\MSOHTMED.exe") OR (OriginalFileName = "MsoHtmEd.exe")))
