// Title: Potential Discovery Activity Using Find - Linux
// ID: 8344c0e5-5783-47cc-9cf9-a0f7fd03e6cf
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-28
// Tags: attack.discovery, attack.t1083
// Description: Detects usage of "find" binary in a suspicious manner to perform discovery
// Converted by: Sigma Universal SIEM/EDR CLI

(src.process.image.path endswithCIS "/find" AND (src.process.cmdline containsCIS "-perm -4000" OR src.process.cmdline containsCIS "-perm -2000" OR src.process.cmdline containsCIS "-perm 0777" OR src.process.cmdline containsCIS "-perm -222" OR src.process.cmdline containsCIS "-perm -o w" OR src.process.cmdline containsCIS "-perm -o x" OR src.process.cmdline containsCIS "-perm -u=s" OR src.process.cmdline containsCIS "-perm -g=s"))
