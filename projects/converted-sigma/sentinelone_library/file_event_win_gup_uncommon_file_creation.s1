// Description: Detects when the Notepad++ updater (gup.exe) creates files in suspicious or uncommon locations.
// This could indicate potential exploitation of the updater component to deliver unwanted malware or unwarranted files.
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path endswithCIS "\\gup.exe") AND NOT ((((tgt.file.path startswithCIS "C:\\Program Files\\Notepad++\\" OR tgt.file.path startswithCIS "C:\\Program Files (x86)\\Notepad++\\")) OR (((tgt.file.path containsCIS "\\plugins\\JsonTools\\testfiles\\" OR tgt.file.path containsCIS "\\Notepad++\\plugins\\ComparePlugin\\")) OR ((tgt.file.path containsCIS "npp." AND tgt.file.path containsCIS ".portable." AND tgt.file.path containsCIS "\\plugins\\"))) OR (tgt.file.path startswithCIS "C:\\$Recycle.Bin\\S-1-5-21") OR (tgt.file.path startswithCIS "C:\\Users\\" AND (tgt.file.path containsCIS "\\AppData\\Local\\Temp\\" AND tgt.file.path containsCIS ".zip")) OR (tgt.file.path startswithCIS "C:\\Users\\" AND (tgt.file.path containsCIS "\\AppData\\Local\\Temp\\" AND tgt.file.path containsCIS "npp." AND tgt.file.path containsCIS ".Installer." AND tgt.file.path containsCIS ".exe")))))
