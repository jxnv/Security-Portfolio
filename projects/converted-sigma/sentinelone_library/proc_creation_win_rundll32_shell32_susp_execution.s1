// Title: Shell32 DLL Execution in Suspicious Directory
// ID: 32b96012-7892-429e-b26c-ac2bf46066ff
// Status: test
// Level: high
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-11-24
// Tags: attack.execution, attack.stealth, attack.t1218.011
// Description: Detects shell32.dll executing a DLL in a suspicious directory
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "shell32.dll" AND src.process.cmdline containsCIS "Control_RunDLL") AND (src.process.cmdline containsCIS "%AppData%" OR src.process.cmdline containsCIS "%LocalAppData%" OR src.process.cmdline containsCIS "%Temp%" OR src.process.cmdline containsCIS "%tmp%" OR src.process.cmdline containsCIS "\\AppData\\" OR src.process.cmdline containsCIS "\\Temp\\" OR src.process.cmdline containsCIS "\\Users\\Public\\")) AND ((src.process.image.path endswithCIS "\\rundll32.exe") OR (OriginalFileName = "RUNDLL32.EXE")))
