// Title: DLL Loaded From Suspicious Location Via Cmspt.EXE
// ID: 75e508f7-932d-4ebc-af77-269237a84ce1
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-30
// Tags: attack.stealth, attack.t1218.003
// Description: Detects cmstp loading "dll" or "ocx" files from suspicious locations
// Converted by: Sigma Universal SIEM/EDR CLI

(src.process.image.path endswithCIS "\\cmstp.exe" AND (ImageLoaded containsCIS "\\PerfLogs\\" OR ImageLoaded containsCIS "\\ProgramData\\" OR ImageLoaded containsCIS "\\Users\\" OR ImageLoaded containsCIS "\\Windows\\Temp\\" OR ImageLoaded containsCIS "C:\\Temp\\") AND (ImageLoaded endswithCIS ".dll" OR ImageLoaded endswithCIS ".ocx"))
