((((src.process.cmdline containsCIS "vss" OR src.process.cmdline containsCIS " /m " OR src.process.cmdline containsCIS " /y ")) AND ((src.process.image.path endswithCIS "\\esentutl.exe") OR (OriginalFileName = "\\esentutl.exe"))) OR ((src.process.cmdline containsCIS "\\config\\RegBack\\sam" OR src.process.cmdline containsCIS "\\config\\RegBack\\security" OR src.process.cmdline containsCIS "\\config\\RegBack\\system" OR src.process.cmdline containsCIS "\\config\\sam" OR src.process.cmdline containsCIS "\\config\\security" OR src.process.cmdline containsCIS "\\config\\system " OR src.process.cmdline containsCIS "\\repair\\sam" OR src.process.cmdline containsCIS "\\repair\\security" OR src.process.cmdline containsCIS "\\repair\\system" OR src.process.cmdline containsCIS "\\windows\\ntds\\ntds.dit")))
