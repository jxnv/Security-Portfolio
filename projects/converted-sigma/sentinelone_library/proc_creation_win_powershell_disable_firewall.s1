// Title: Windows Firewall Disabled via PowerShell
// ID: 12f6b752-042d-483e-bf9c-915a6d06ad75
// Status: test
// Level: medium
// Author: Tim Rauch, Elastic (idea)
// Date: 2022-09-14
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects attempts to disable the Windows Firewall using PowerShell
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "Set-NetFirewallProfile " AND src.process.cmdline containsCIS " -Enabled " AND src.process.cmdline containsCIS " False")) AND (((src.process.image.path endswithCIS "\\powershell.exe" OR src.process.image.path endswithCIS "\\pwsh.exe" OR src.process.image.path endswithCIS "\\powershell_ise.exe")) OR ((OriginalFileName = "PowerShell.EXE" OR OriginalFileName = "pwsh.dll"))) AND ((src.process.cmdline containsCIS " -All " OR src.process.cmdline containsCIS "Public" OR src.process.cmdline containsCIS "Domain" OR src.process.cmdline containsCIS "Private")))
