// Title: Potentially Suspicious Network Connection To Notion API
// ID: 7e9cf7b6-e827-11ed-a05b-15959c120003
// Status: test
// Level: low
// Author: Gavin Knapp
// Date: 2023-05-03
// Tags: attack.command-and-control, attack.t1102
// Description: Detects a non-browser process communicating with the Notion API. This could indicate potential use of a covert C2 channel such as "OffensiveNotion C2"
// Converted by: Sigma Universal SIEM/EDR CLI

((DestinationHostname containsCIS "api.notion.com") AND NOT (((src.process.image.path endswithCIS "\\brave.exe") OR ((src.process.image.path = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR src.process.image.path = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") OR (src.process.image.path endswithCIS "\\WindowsApps\\MicrosoftEdge.exe") OR ((src.process.image.path = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR src.process.image.path = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((src.process.image.path startswithCIS "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" OR src.process.image.path startswithCIS "C:\\Program Files\\Microsoft\\EdgeCore\\") AND (src.process.image.path endswithCIS "\\msedge.exe" OR src.process.image.path endswithCIS "\\msedgewebview2.exe")) OR ((src.process.image.path = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR src.process.image.path = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR ((src.process.image.path = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR src.process.image.path = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (src.process.image.path endswithCIS "\\maxthon.exe") OR (src.process.image.path endswithCIS "\\AppData\\Local\\Programs\\Notion\\Notion.exe") OR (src.process.image.path endswithCIS "\\opera.exe") OR (src.process.image.path endswithCIS "\\safari.exe") OR (src.process.image.path endswithCIS "\\seamonkey.exe") OR (src.process.image.path endswithCIS "\\vivaldi.exe") OR (src.process.image.path endswithCIS "\\whale.exe"))))
