// Title: Suspicious Double Extension File Execution
// ID: 1cdd9a09-06c9-4769-99ff-626e2b3991b8
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems), @blu3_team (idea), Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-06-26
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects suspicious use of an .exe extension after a non-executable file extension like .pdf.exe, a set of spaces or underlines to cloak the executable file in spear phishing campaigns
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path endswithCIS "      .exe" OR src.process.image.path endswithCIS "______.exe" OR src.process.image.path endswithCIS ".doc.exe" OR src.process.image.path endswithCIS ".doc.js" OR src.process.image.path endswithCIS ".docx.exe" OR src.process.image.path endswithCIS ".docx.js" OR src.process.image.path endswithCIS ".gif.exe" OR src.process.image.path endswithCIS ".jpeg.exe" OR src.process.image.path endswithCIS ".jpg.exe" OR src.process.image.path endswithCIS ".mkv.exe" OR src.process.image.path endswithCIS ".mov.exe" OR src.process.image.path endswithCIS ".mp3.exe" OR src.process.image.path endswithCIS ".mp4.exe" OR src.process.image.path endswithCIS ".pdf.exe" OR src.process.image.path endswithCIS ".pdf.js" OR src.process.image.path endswithCIS ".png.exe" OR src.process.image.path endswithCIS ".ppt.exe" OR src.process.image.path endswithCIS ".ppt.js" OR src.process.image.path endswithCIS ".pptx.exe" OR src.process.image.path endswithCIS ".pptx.js" OR src.process.image.path endswithCIS ".rtf.exe" OR src.process.image.path endswithCIS ".rtf.js" OR src.process.image.path endswithCIS ".svg.exe" OR src.process.image.path endswithCIS ".txt.exe" OR src.process.image.path endswithCIS ".txt.js" OR src.process.image.path endswithCIS ".xls.exe" OR src.process.image.path endswithCIS ".xls.js" OR src.process.image.path endswithCIS ".xlsx.exe" OR src.process.image.path endswithCIS ".xlsx.js" OR src.process.image.path endswithCIS "⠀⠀⠀⠀⠀⠀.exe") AND (src.process.cmdline containsCIS "      .exe" OR src.process.cmdline containsCIS "______.exe" OR src.process.cmdline containsCIS ".doc.exe" OR src.process.cmdline containsCIS ".doc.js" OR src.process.cmdline containsCIS ".docx.exe" OR src.process.cmdline containsCIS ".docx.js" OR src.process.cmdline containsCIS ".gif.exe" OR src.process.cmdline containsCIS ".jpeg.exe" OR src.process.cmdline containsCIS ".jpg.exe" OR src.process.cmdline containsCIS ".mkv.exe" OR src.process.cmdline containsCIS ".mov.exe" OR src.process.cmdline containsCIS ".mp3.exe" OR src.process.cmdline containsCIS ".mp4.exe" OR src.process.cmdline containsCIS ".pdf.exe" OR src.process.cmdline containsCIS ".pdf.js" OR src.process.cmdline containsCIS ".png.exe" OR src.process.cmdline containsCIS ".ppt.exe" OR src.process.cmdline containsCIS ".ppt.js" OR src.process.cmdline containsCIS ".pptx.exe" OR src.process.cmdline containsCIS ".pptx.js" OR src.process.cmdline containsCIS ".rtf.exe" OR src.process.cmdline containsCIS ".rtf.js" OR src.process.cmdline containsCIS ".svg.exe" OR src.process.cmdline containsCIS ".txt.exe" OR src.process.cmdline containsCIS ".txt.js" OR src.process.cmdline containsCIS ".xls.exe" OR src.process.cmdline containsCIS ".xls.js" OR src.process.cmdline containsCIS ".xlsx.exe" OR src.process.cmdline containsCIS ".xlsx.js" OR src.process.cmdline containsCIS "⠀⠀⠀⠀⠀⠀.exe"))
