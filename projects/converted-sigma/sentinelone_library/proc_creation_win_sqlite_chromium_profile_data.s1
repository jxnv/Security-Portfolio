// Title: SQLite Chromium Profile Data DB Access
// ID: 24c77512-782b-448a-8950-eddb0785fc71
// Status: test
// Level: high
// Author: TropChaud
// Date: 2022-12-19
// Tags: attack.credential-access, attack.t1539, attack.t1555.003, attack.collection, attack.t1005
// Description: Detect usage of the "sqlite" binary to query databases in Chromium-based browsers for potential data stealing.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline containsCIS "\\User Data\\" OR src.process.cmdline containsCIS "\\Opera Software\\" OR src.process.cmdline containsCIS "\\ChromiumViewer\\")) AND ((src.process.cmdline containsCIS "Login Data" OR src.process.cmdline containsCIS "Cookies" OR src.process.cmdline containsCIS "Web Data" OR src.process.cmdline containsCIS "History" OR src.process.cmdline containsCIS "Bookmarks")) AND ((Product = "SQLite") OR ((src.process.image.path endswithCIS "\\sqlite.exe" OR src.process.image.path endswithCIS "\\sqlite3.exe"))))
