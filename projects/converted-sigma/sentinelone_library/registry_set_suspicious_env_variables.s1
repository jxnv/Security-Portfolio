// Title: Suspicious Environment Variable Has Been Registered
// ID: 966315ef-c5e1-4767-ba25-fce9c8de3660
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-20
// Tags: attack.persistence, attack.stealth
// Description: Detects the creation of user-specific or system-wide environment variables via the registry. Which contains suspicious commands and strings
// Converted by: Sigma Universal SIEM/EDR CLI

((((Details = "powershell" OR Details = "pwsh")) OR ((Details containsCIS "\\AppData\\Local\\Temp\\" OR Details containsCIS "C:\\Users\\Public\\" OR Details containsCIS "TVqQAAMAAAAEAAAA" OR Details containsCIS "TVpQAAIAAAAEAA8A" OR Details containsCIS "TVqAAAEAAAAEABAA" OR Details containsCIS "TVoAAAAAAAAAAAAA" OR Details containsCIS "TVpTAQEAAAAEAAAA" OR Details containsCIS "SW52b2tlL" OR Details containsCIS "ludm9rZS" OR Details containsCIS "JbnZva2Ut" OR Details containsCIS "SQBuAHYAbwBrAGUALQ" OR Details containsCIS "kAbgB2AG8AawBlAC0A" OR Details containsCIS "JAG4AdgBvAGsAZQAtA")) OR ((Details startswithCIS "SUVY" OR Details startswithCIS "SQBFAF" OR Details startswithCIS "SQBuAH" OR Details startswithCIS "cwBhA" OR Details startswithCIS "aWV4" OR Details startswithCIS "aQBlA" OR Details startswithCIS "R2V0" OR Details startswithCIS "dmFy" OR Details startswithCIS "dgBhA" OR Details startswithCIS "dXNpbm" OR Details startswithCIS "H4sIA" OR Details startswithCIS "Y21k" OR Details startswithCIS "cABhAH" OR Details startswithCIS "Qzpc" OR Details startswithCIS "Yzpc"))) AND (TargetObject containsCIS "\\Environment\\"))
