// Title: Execution Of Non-Existing File
// ID: 71158e3f-df67-472b-930e-7d287acaa3e1
// Status: test
// Level: high
// Author: Max Altgelt (Nextron Systems)
// Date: 2021-12-09
// Tags: attack.stealth, attack.privilege-escalation, attack.t1055
// Description: Detects process creation events where the Image field lacks an absolute path,
// which occurs when the backing file no longer exists on disk at the time of
// logging - commonly caused by Process Ghosting or other unorthodox process creation techniques.
// Converted by: Sigma Universal SIEM/EDR CLI

(NOT ((src.process.image.path containsCIS "\\")) AND NOT (((((src.process.image.path = "MemCompression" OR src.process.image.path = "Registry" OR src.process.image.path = "System" OR src.process.image.path = "vmmem" OR src.process.image.path = "vmmemWSL")) OR ((src.process.cmdline = "MemCompression" OR src.process.cmdline = "Registry" OR src.process.cmdline = "vmmem" OR src.process.cmdline = "vmmemWSL"))) OR ((src.process.image.path = "-" OR src.process.image.path = "")) OR (src.process.image.path is null))))
