// Title: Suspicious Execution via macOS Script Editor
// ID: 6e4dcdd1-e48b-42f7-b2d8-3b413fc58cb4
// Status: test
// Level: medium
// Author: Tim Rauch (rule), Elastic (idea)
// Date: 2022-10-21
// Tags: attack.defense-impairment, attack.t1566, attack.t1566.002, attack.initial-access, attack.t1059, attack.t1059.002, attack.t1204, attack.t1204.001, attack.execution, attack.persistence, attack.t1553
// Description: Detects when the macOS Script Editor utility spawns an unusual child process.
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.image.path endswithCIS "/curl" OR src.process.image.path endswithCIS "/bash" OR src.process.image.path endswithCIS "/sh" OR src.process.image.path endswithCIS "/zsh" OR src.process.image.path endswithCIS "/dash" OR src.process.image.path endswithCIS "/fish" OR src.process.image.path endswithCIS "/osascript" OR src.process.image.path endswithCIS "/mktemp" OR src.process.image.path endswithCIS "/chmod" OR src.process.image.path endswithCIS "/php" OR src.process.image.path endswithCIS "/nohup" OR src.process.image.path endswithCIS "/openssl" OR src.process.image.path endswithCIS "/plutil" OR src.process.image.path endswithCIS "/PlistBuddy" OR src.process.image.path endswithCIS "/xattr" OR src.process.image.path endswithCIS "/sqlite" OR src.process.image.path endswithCIS "/funzip" OR src.process.image.path endswithCIS "/popen")) OR ((src.process.image.path containsCIS "python" OR src.process.image.path containsCIS "perl"))) AND (src.process.parent.image.path endswithCIS "/Script Editor"))
