// Tags: attack.reconnaissance, attack.t1595
// Description: Detects the execution of PingCastle, a tool designed to quickly assess the Active Directory security level via a script located in a potentially suspicious or uncommon location.
// Converted by: Sigma Universal SIEM/EDR CLI

((((src.process.parent.cmdline containsCIS ".bat" OR src.process.parent.cmdline containsCIS ".chm" OR src.process.parent.cmdline containsCIS ".cmd" OR src.process.parent.cmdline containsCIS ".hta" OR src.process.parent.cmdline containsCIS ".htm" OR src.process.parent.cmdline containsCIS ".html" OR src.process.parent.cmdline containsCIS ".js" OR src.process.parent.cmdline containsCIS ".lnk" OR src.process.parent.cmdline containsCIS ".ps1" OR src.process.parent.cmdline containsCIS ".vbe" OR src.process.parent.cmdline containsCIS ".vbs" OR src.process.parent.cmdline containsCIS ".wsf")) OR ((src.process.parent.cmdline containsCIS ":\\Perflogs\\" OR src.process.parent.cmdline containsCIS ":\\Temp\\" OR src.process.parent.cmdline containsCIS ":\\Users\\Public\\" OR src.process.parent.cmdline containsCIS ":\\Windows\\Temp\\" OR src.process.parent.cmdline containsCIS "\\AppData\\Local\\Temp" OR src.process.parent.cmdline containsCIS "\\AppData\\Roaming\\" OR src.process.parent.cmdline containsCIS "\\Temporary Internet")) OR (((src.process.parent.cmdline containsCIS ":\\Users\\" AND src.process.parent.cmdline containsCIS "\\Favorites\\")) OR ((src.process.parent.cmdline containsCIS ":\\Users\\" AND src.process.parent.cmdline containsCIS "\\Favourites\\")) OR ((src.process.parent.cmdline containsCIS ":\\Users\\" AND src.process.parent.cmdline containsCIS "\\Contacts\\")))) AND ((src.process.parent.cmdline containsCIS ".bat" OR src.process.parent.cmdline containsCIS ".chm" OR src.process.parent.cmdline containsCIS ".cmd" OR src.process.parent.cmdline containsCIS ".hta" OR src.process.parent.cmdline containsCIS ".htm" OR src.process.parent.cmdline containsCIS ".html" OR src.process.parent.cmdline containsCIS ".js" OR src.process.parent.cmdline containsCIS ".lnk" OR src.process.parent.cmdline containsCIS ".ps1" OR src.process.parent.cmdline containsCIS ".vbe" OR src.process.parent.cmdline containsCIS ".vbs" OR src.process.parent.cmdline containsCIS ".wsf")) AND ((src.process.image.path endswithCIS "\\PingCastle.exe") OR (OriginalFileName = "PingCastle.exe") OR (Product = "Ping Castle") OR ((src.process.cmdline containsCIS "--scanner aclcheck" OR src.process.cmdline containsCIS "--scanner antivirus" OR src.process.cmdline containsCIS "--scanner computerversion" OR src.process.cmdline containsCIS "--scanner foreignusers" OR src.process.cmdline containsCIS "--scanner laps_bitlocker" OR src.process.cmdline containsCIS "--scanner localadmin" OR src.process.cmdline containsCIS "--scanner nullsession" OR src.process.cmdline containsCIS "--scanner nullsession-trust" OR src.process.cmdline containsCIS "--scanner oxidbindings" OR src.process.cmdline containsCIS "--scanner remote" OR src.process.cmdline containsCIS "--scanner share" OR src.process.cmdline containsCIS "--scanner smb" OR src.process.cmdline containsCIS "--scanner smb3querynetwork" OR src.process.cmdline containsCIS "--scanner spooler" OR src.process.cmdline containsCIS "--scanner startup" OR src.process.cmdline containsCIS "--scanner zerologon")) OR (src.process.cmdline containsCIS "--no-enum-limit") OR ((src.process.cmdline containsCIS "--healthcheck" AND src.process.cmdline containsCIS "--level Full")) OR ((src.process.cmdline containsCIS "--healthcheck" AND src.process.cmdline containsCIS "--server "))))
