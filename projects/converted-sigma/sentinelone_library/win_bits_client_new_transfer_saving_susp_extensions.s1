// Title: BITS Transfer Job Downloading File Potential Suspicious Extension
// ID: b85e5894-9b19-4d86-8c87-a2f3b81f0521
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-03-01
// Tags: attack.persistence, attack.execution, attack.stealth, attack.t1197
// Description: Detects new BITS transfer job saving local files with potential suspicious extensions
// Converted by: Sigma Universal SIEM/EDR CLI

((EventID = "16403" AND (LocalName endswithCIS ".bat" OR LocalName endswithCIS ".dll" OR LocalName endswithCIS ".exe" OR LocalName endswithCIS ".hta" OR LocalName endswithCIS ".ps1" OR LocalName endswithCIS ".psd1" OR LocalName endswithCIS ".sh" OR LocalName endswithCIS ".vbe" OR LocalName endswithCIS ".vbs")) AND NOT ((LocalName containsCIS "\\AppData\\" AND RemoteName containsCIS ".com")))
