// Title: Linux Shell Pipe to Shell
// ID: 880973f3-9708-491c-a77b-2a35a1921158
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-14
// Tags: attack.stealth, attack.t1140
// Description: Detects suspicious process command line that starts with a shell that executes something and finally gets piped into another shell
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.cmdline startswithCIS "sh -c " OR src.process.cmdline startswithCIS "bash -c ")) AND (((src.process.cmdline containsCIS "| bash " OR src.process.cmdline containsCIS "| sh " OR src.process.cmdline containsCIS "|bash " OR src.process.cmdline containsCIS "|sh ")) OR ((src.process.cmdline endswithCIS "| bash" OR src.process.cmdline endswithCIS "| sh" OR src.process.cmdline endswithCIS "|bash" OR src.process.cmdline endswithCIS " |sh"))))
