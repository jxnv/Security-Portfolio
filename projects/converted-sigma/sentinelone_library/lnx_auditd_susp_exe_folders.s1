// Title: Program Executions in Suspicious Folders
// ID: a39d7fa7-3fbd-4dc2-97e1-d87f546b1bbc
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2018-01-23
// Tags: attack.t1587, attack.t1584, attack.resource-development
// Description: Detects program executions in suspicious non-program folders related to malware or hacking activity
// Converted by: Sigma Universal SIEM/EDR CLI

(type = "SYSCALL" AND (exe startswithCIS "/tmp/" OR exe startswithCIS "/var/www/" OR exe startswithCIS "/home/*/public_html/" OR exe startswithCIS "/usr/local/apache2/" OR exe startswithCIS "/usr/local/httpd/" OR exe startswithCIS "/var/apache/" OR exe startswithCIS "/srv/www/" OR exe startswithCIS "/home/httpd/html/" OR exe startswithCIS "/srv/http/" OR exe startswithCIS "/usr/share/nginx/html/" OR exe startswithCIS "/var/lib/pgsql/data/" OR exe startswithCIS "/usr/local/mysql/data/" OR exe startswithCIS "/var/lib/mysql/" OR exe startswithCIS "/var/vsftpd/" OR exe startswithCIS "/etc/bind/" OR exe startswithCIS "/var/named/"))
