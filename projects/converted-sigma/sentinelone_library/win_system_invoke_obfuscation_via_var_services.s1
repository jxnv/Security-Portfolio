// Description: Detects Obfuscated Powershell via VAR++ LAUNCHER
// Converted by: Sigma Universal SIEM/EDR CLI

(Provider_Name = "Service Control Manager" AND EventID = "7045" AND (ImagePath containsCIS "&&set" AND ImagePath containsCIS "cmd" AND ImagePath containsCIS "/c" AND ImagePath containsCIS "-f") AND (ImagePath containsCIS "{0}" OR ImagePath containsCIS "{1}" OR ImagePath containsCIS "{2}" OR ImagePath containsCIS "{3}" OR ImagePath containsCIS "{4}" OR ImagePath containsCIS "{5}"))
