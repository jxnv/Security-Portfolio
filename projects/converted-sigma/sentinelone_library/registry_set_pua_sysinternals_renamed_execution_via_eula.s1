// Title: Suspicious Execution Of Renamed Sysinternals Tools - Registry
// ID: f50f3c09-557d-492d-81db-9064a8d4e211
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-24
// Tags: attack.resource-development, attack.t1588.002
// Description: Detects the creation of the "accepteula" key related to the Sysinternals tools being created from executables with the wrong name (e.g. a renamed Sysinternals tool)
// Converted by: Sigma Universal SIEM/EDR CLI

(((TargetObject containsCIS "\\Active Directory Explorer" OR TargetObject containsCIS "\\Handle" OR TargetObject containsCIS "\\LiveKd" OR TargetObject containsCIS "\\ProcDump" OR TargetObject containsCIS "\\Process Explorer" OR TargetObject containsCIS "\\PsExec" OR TargetObject containsCIS "\\PsLoggedon" OR TargetObject containsCIS "\\PsLoglist" OR TargetObject containsCIS "\\PsPasswd" OR TargetObject containsCIS "\\PsPing" OR TargetObject containsCIS "\\PsService" OR TargetObject containsCIS "\\SDelete") AND TargetObject endswithCIS "\\EulaAccepted") AND NOT (((src.process.image.path endswithCIS "\\ADExplorer.exe" OR src.process.image.path endswithCIS "\\ADExplorer64.exe" OR src.process.image.path endswithCIS "\\ADExplorer64a.exe" OR src.process.image.path endswithCIS "\\handle.exe" OR src.process.image.path endswithCIS "\\handle64.exe" OR src.process.image.path endswithCIS "\\handle64a.exe" OR src.process.image.path endswithCIS "\\livekd.exe" OR src.process.image.path endswithCIS "\\livekd64.exe" OR src.process.image.path endswithCIS "\\procdump.exe" OR src.process.image.path endswithCIS "\\procdump64.exe" OR src.process.image.path endswithCIS "\\procdump64a.exe" OR src.process.image.path endswithCIS "\\procexp.exe" OR src.process.image.path endswithCIS "\\procexp64.exe" OR src.process.image.path endswithCIS "\\procexp64a.exe" OR src.process.image.path endswithCIS "\\PsExec.exe" OR src.process.image.path endswithCIS "\\PsExec64.exe" OR src.process.image.path endswithCIS "\\PsExec64a.exe" OR src.process.image.path endswithCIS "\\PsLoggedon.exe" OR src.process.image.path endswithCIS "\\PsLoggedon64.exe" OR src.process.image.path endswithCIS "\\psloglist.exe" OR src.process.image.path endswithCIS "\\psloglist64.exe" OR src.process.image.path endswithCIS "\\psloglist64a.exe" OR src.process.image.path endswithCIS "\\pspasswd.exe" OR src.process.image.path endswithCIS "\\pspasswd64.exe" OR src.process.image.path endswithCIS "\\pspasswd64a.exe" OR src.process.image.path endswithCIS "\\PsPing.exe" OR src.process.image.path endswithCIS "\\PsPing64.exe" OR src.process.image.path endswithCIS "\\PsPing64a.exe" OR src.process.image.path endswithCIS "\\PsService.exe" OR src.process.image.path endswithCIS "\\PsService64.exe" OR src.process.image.path endswithCIS "\\PsService64a.exe" OR src.process.image.path endswithCIS "\\sdelete.exe"))))
