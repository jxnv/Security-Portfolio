// Title: Unusual File Download from Direct IP Address
// ID: 025bd229-fd1f-4fdb-97ab-20006e1a5368
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Florian Roth (Nextron Systems)
// Date: 2022-09-07
// Tags: attack.stealth, attack.t1564.004
// Description: Detects the download of suspicious file type from URLs with IP
// Converted by: Sigma Universal SIEM/EDR CLI

(Contents RegEx "http[s]?://[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}" AND (tgt.file.path containsCIS ".ps1:Zone" OR tgt.file.path containsCIS ".bat:Zone" OR tgt.file.path containsCIS ".exe:Zone" OR tgt.file.path containsCIS ".vbe:Zone" OR tgt.file.path containsCIS ".vbs:Zone" OR tgt.file.path containsCIS ".dll:Zone" OR tgt.file.path containsCIS ".one:Zone" OR tgt.file.path containsCIS ".cmd:Zone" OR tgt.file.path containsCIS ".hta:Zone" OR tgt.file.path containsCIS ".xll:Zone" OR tgt.file.path containsCIS ".lnk:Zone"))
