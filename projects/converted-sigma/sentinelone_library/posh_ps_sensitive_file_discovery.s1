(((ScriptBlockText containsCIS "ls" OR ScriptBlockText containsCIS "get-childitem" OR ScriptBlockText containsCIS "gci")) AND ((ScriptBlockText containsCIS ".pass" OR ScriptBlockText containsCIS ".kdbx" OR ScriptBlockText containsCIS ".kdb")) AND (ScriptBlockText containsCIS "-recurse"))
