// Tags: attack.stealth, attack.t1036.005
// Description: Detects an uncommon svchost parent process
// Converted by: Sigma Universal SIEM/EDR CLI

((src.process.image.path endswithCIS "\\svchost.exe") AND NOT ((((src.process.parent.image.path endswithCIS "\\Mrt.exe" OR src.process.parent.image.path endswithCIS "\\MsMpEng.exe" OR src.process.parent.image.path endswithCIS "\\ngen.exe" OR src.process.parent.image.path endswithCIS "\\rpcnet.exe" OR src.process.parent.image.path endswithCIS "\\services.exe" OR src.process.parent.image.path endswithCIS "\\TiWorker.exe")) OR ((src.process.parent.image.path = "-" OR src.process.parent.image.path = "")) OR (src.process.parent.image.path is null))))
