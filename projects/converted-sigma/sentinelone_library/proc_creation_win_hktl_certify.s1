// Description: Detects Certify a tool for Active Directory certificate abuse based on PE metadata characteristics and common command line arguments.
// Converted by: Sigma Universal SIEM/EDR CLI

(((src.process.image.path endswithCIS "\\Certify.exe") OR (OriginalFileName = "Certify.exe") OR (Description containsCIS "Certify")) OR (((src.process.cmdline containsCIS ".exe cas " OR src.process.cmdline containsCIS ".exe find " OR src.process.cmdline containsCIS ".exe pkiobjects " OR src.process.cmdline containsCIS ".exe request " OR src.process.cmdline containsCIS ".exe download ")) AND ((src.process.cmdline containsCIS " /vulnerable" OR src.process.cmdline containsCIS " /template:" OR src.process.cmdline containsCIS " /altname:" OR src.process.cmdline containsCIS " /domain:" OR src.process.cmdline containsCIS " /path:" OR src.process.cmdline containsCIS " /ca:"))))
