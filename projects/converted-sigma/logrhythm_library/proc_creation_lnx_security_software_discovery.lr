# Title: Security Software Discovery - Linux
# ID: c9d8b7fd-78e4-44fe-88f6-599135d46d60
# Status: test
# Level: low
# Author: Daniil Yugoslavskiy, oscd.community
# Date: 2020-10-19
# Tags: attack.discovery, attack.t1518.001
# Description: Detects usage of system utilities (only grep and egrep for now) to discover security software discovery
# Converted by: Sigma Universal SIEM/EDR CLI

((Image="*/grep" OR Image="*/egrep") AND (CommandLine="*nessusd*" OR CommandLine="*td-agent*" OR CommandLine="*packetbeat*" OR CommandLine="*filebeat*" OR CommandLine="*auditbeat*" OR CommandLine="*osqueryd*" OR CommandLine="*cbagentd*" OR CommandLine="*falcond*"))
