# Title: HackTool - SharpDPAPI Execution
# ID: c7d33b50-f690-4b51-8cfb-0fb912a31e57
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2024-06-26
# Tags: attack.privilege-escalation, attack.stealth, attack.t1134.001, attack.t1134.003
# Description: Detects the execution of the SharpDPAPI tool based on CommandLine flags and PE metadata.
# SharpDPAPI is a C# port of some DPAPI functionality from the Mimikatz project.
# Converted by: Sigma Universal SIEM/EDR CLI

(((Image="*\\SharpDPAPI.exe") OR (OriginalFileName="SharpDPAPI.exe")) OR (((CommandLine="* backupkey *" OR CommandLine="* blob *" OR CommandLine="* certificates *" OR CommandLine="* credentials *" OR CommandLine="* keepass *" OR CommandLine="* masterkeys *" OR CommandLine="* rdg *" OR CommandLine="* vaults *")) AND (((CommandLine="* /file:*" OR CommandLine="* /machine*" OR CommandLine="* /mkfile:*" OR CommandLine="* /password:*" OR CommandLine="* /pvk:*" OR CommandLine="* /server:*" OR CommandLine="* /target:*" OR CommandLine="* /unprotect*")) OR ((CommandLine="* {*" AND CommandLine="*}:*")))))
