# Title: Potentially Suspicious Windows App Activity
# ID: f91ed517-a6ba-471d-9910-b3b4a398c0f3
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-01-12
# Tags: attack.stealth
# Description: Detects potentially suspicious child process of applications launched from inside the WindowsApps directory. This could be a sign of a rogue ".appx" package installation/execution
# Converted by: Sigma Universal SIEM/EDR CLI

((ParentImage="*C:\\Program Files\\WindowsApps\\*") AND (((CommandLine="*cmd /c*" OR CommandLine="*Invoke-*" OR CommandLine="*Base64*")) OR ((Image="*\\cmd.exe" OR Image="*\\cscript.exe" OR Image="*\\mshta.exe" OR Image="*\\powershell.exe" OR Image="*\\powershell_ise.exe" OR Image="*\\pwsh.exe" OR Image="*\\regsvr32.exe" OR Image="*\\rundll32.exe" OR Image="*\\wscript.exe"))) AND NOT (((ParentImage="C:\\Program Files\\WindowsApps\\Microsoft.SysinternalsSuite*" AND Image="*\\cmd.exe") OR (ParentImage="*:\\Program Files\\WindowsApps\\Microsoft.WindowsTerminal*" AND ParentImage="*\\WindowsTerminal.exe" AND (Image="*\\powershell.exe" OR Image="*\\cmd.exe" OR Image="*\\pwsh.exe")))))
