# Title: Suspicious Outlook Child Process
# ID: 208748f7-881d-47ac-a29c-07ea84bf691d
# Status: test
# Level: high
# Author: Michael Haag, Florian Roth (Nextron Systems), Markus Neis, Elastic, FPT.EagleEye Team
# Date: 2022-02-28
# Tags: attack.execution, attack.t1204.002
# Description: Detects a suspicious process spawning from an Outlook process.
# Converted by: Sigma Universal SIEM/EDR CLI

(ParentImage="*\\OUTLOOK.EXE" AND (Image="*\\AppVLP.exe" OR Image="*\\bash.exe" OR Image="*\\cmd.exe" OR Image="*\\cscript.exe" OR Image="*\\forfiles.exe" OR Image="*\\hh.exe" OR Image="*\\mftrace.exe" OR Image="*\\msbuild.exe" OR Image="*\\msdt.exe" OR Image="*\\mshta.exe" OR Image="*\\msiexec.exe" OR Image="*\\powershell.exe" OR Image="*\\pwsh.exe" OR Image="*\\regsvr32.exe" OR Image="*\\schtasks.exe" OR Image="*\\scrcons.exe" OR Image="*\\scriptrunner.exe" OR Image="*\\sh.exe" OR Image="*\\svchost.exe" OR Image="*\\wmic.exe" OR Image="*\\wscript.exe"))
