((EventID="4657" AND ObjectName="*\\Environment*" AND (ObjectValueName="COMPlus_ETWEnabled" OR ObjectValueName="COMPlus_ETWFlags") AND NewValue="0") OR (EventID="4657" AND ObjectName="*\\SOFTWARE\\Microsoft\\.NETFramework" AND ObjectValueName="ETWEnabled" AND NewValue="0"))
