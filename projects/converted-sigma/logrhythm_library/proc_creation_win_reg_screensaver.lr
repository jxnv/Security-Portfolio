# Title: Suspicious ScreenSave Change by Reg.exe
# ID: 0fc35fc3-efe6-4898-8a37-0b233339524f
# Status: test
# Level: medium
# Author: frack113
# Date: 2021-08-19
# Tags: attack.persistence, attack.privilege-escalation, attack.t1546.002
# Description: Adversaries may establish persistence by executing malicious content triggered by user inactivity.
# Screensavers are programs that execute after a configurable time of user inactivity and consist of Portable Executable (PE) files with a .scr file extension
# Converted by: Sigma Universal SIEM/EDR CLI

((Image="*\\reg.exe" AND (CommandLine="*HKEY_CURRENT_USER\\Control Panel\\Desktop*" OR CommandLine="*HKCU\\Control Panel\\Desktop*")) AND (((CommandLine="*/v ScreenSaveActive*" AND CommandLine="*/t REG_SZ*" AND CommandLine="*/d 1*" AND CommandLine="*/f*")) OR ((CommandLine="*/v ScreenSaveTimeout*" AND CommandLine="*/t REG_SZ*" AND CommandLine="*/d *" AND CommandLine="*/f*")) OR ((CommandLine="*/v ScreenSaverIsSecure*" AND CommandLine="*/t REG_SZ*" AND CommandLine="*/d 0*" AND CommandLine="*/f*")) OR ((CommandLine="*/v SCRNSAVE.EXE*" AND CommandLine="*/t REG_SZ*" AND CommandLine="*/d *" AND CommandLine="*.scr*" AND CommandLine="*/f*"))))
