# Title: File With Uncommon Extension Created By An Office Application
# ID: c7a74c80-ba5a-486e-9974-ab9e682bc5e4
# Status: test
# Level: high
# Author: Vadim Khrykov (ThreatIntel), Cyb3rEng (Rule), Nasreddine Bencherchali (Nextron Systems)
# Date: 2021-08-23
# Tags: attack.t1204.002, attack.execution
# Description: Detects the creation of files with an executable or script extension by an Office application.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((process_path="*\\excel.exe" OR process_path="*\\msaccess.exe" OR process_path="*\\mspub.exe" OR process_path="*\\powerpnt.exe" OR process_path="*\\visio.exe" OR process_path="*\\winword.exe")) AND ((file_name="*.bat" OR file_name="*.cmd" OR file_name="*.com" OR file_name="*.dll" OR file_name="*.exe" OR file_name="*.hta" OR file_name="*.ocx" OR file_name="*.proj" OR file_name="*.ps1" OR file_name="*.scf" OR file_name="*.scr" OR file_name="*.sys" OR file_name="*.vbe" OR file_name="*.vbs" OR file_name="*.wsf" OR file_name="*.wsh"))) AND NOT ((file_name="*\\AppData\\Local\\assembly\\tmp\\*" AND file_name="*.dll")) AND NOT ((((file_name="*C:\\Users\\*" AND file_name="*\\AppData\\Local\\Microsoft\\Office\\*" AND file_name="*\\BackstageInAppNavCache\\*") AND file_name="*.com") OR (process_path="*\\winword.exe" AND file_name="*\\AppData\\Local\\Temp\\webexdelta\\*" AND (file_name="*.dll" OR file_name="*.exe")) OR ((file_name="*C:\\Users\\*" AND file_name="*\\AppData\\Local\\Microsoft\\Office\\*" AND file_name="*\\WebServiceCache\\AllUsers*") AND file_name="*.com"))))
