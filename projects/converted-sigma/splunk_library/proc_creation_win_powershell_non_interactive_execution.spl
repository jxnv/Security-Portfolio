# Title: Non Interactive PowerShell Process Spawned
# ID: f4bbd493-b796-416e-bbf2-121235348529
# Status: test
# Level: low
# Author: Roberto Rodriguez @Cyb3rWard0g (rule), oscd.community (improvements)
# Date: 2019-09-12
# Tags: attack.execution, attack.t1059.001
# Description: Detects non-interactive PowerShell activity by looking at the "powershell" process with a non-user GUI process such as "explorer.exe" as a parent.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe")) OR ((process_name="PowerShell.EXE" OR process_name="pwsh.dll"))) AND NOT ((((parent_process_path="*:\\Windows\\explorer.exe" OR parent_process_path="*:\\Windows\\System32\\CompatTelRunner.exe" OR parent_process_path="*:\\Windows\\SysWOW64\\explorer.exe")) OR (parent_process_path=":\\$WINDOWS.~BT\\Sources\\SetupHost.exe"))) AND NOT (((parent_process_path="*:\\Program Files\\Windows Defender Advanced Threat Protection\\SenseIR.exe") OR (parent_process_path="*:\\Program Files\\WindowsApps\\Microsoft.WindowsTerminal_*" AND parent_process_path="*\\WindowsTerminal.exe") OR (parent_process_path="*\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe" AND parent_process_exec="* --ms-enable-electron-run-as-node *"))))
