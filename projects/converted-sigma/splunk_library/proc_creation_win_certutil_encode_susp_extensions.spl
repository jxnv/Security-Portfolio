# Title: Suspicious File Encoded To Base64 Via Certutil.EXE
# ID: ea0cdc3e-2239-4f26-a947-4e8f8224e464
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-05-15
# Tags: attack.stealth, attack.t1027
# Description: Detects the execution of certutil with the "encode" flag to encode a file to base64 where the extensions of the file is suspicious
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="*-encode*" OR process_exec="*/encode*")) AND ((process_exec="*.acl*" OR process_exec="*.bat*" OR process_exec="*.doc*" OR process_exec="*.gif*" OR process_exec="*.jpeg*" OR process_exec="*.jpg*" OR process_exec="*.mp3*" OR process_exec="*.pdf*" OR process_exec="*.png*" OR process_exec="*.ppt*" OR process_exec="*.tmp*" OR process_exec="*.xls*" OR process_exec="*.xml*")) AND ((process_path="*\\certutil.exe") OR (process_name="CertUtil.exe")))
