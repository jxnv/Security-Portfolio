# Title: Potential Tampering With RDP Related Registry Keys Via Reg.EXE
# ID: 0d5675be-bc88-4172-86d3-1e96a4476536
# Status: test
# Level: high
# Author: pH-T (Nextron Systems), @Kostastsale, TheDFIRReport
# Date: 2022-02-12
# Tags: attack.persistence, attack.lateral-movement, attack.defense-impairment, attack.t1021.001, attack.t1112
# Description: Detects the execution of "reg.exe" for enabling/disabling the RDP service on the host by tampering with the 'CurrentControlSet\Control\Terminal Server' values
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((process_exec="* add *" AND process_exec="*\\CurrentControlSet\\Control\\Terminal Server*" AND process_exec="*REG_DWORD*" AND process_exec="* /f*")) AND ((process_path="*\\reg.exe") OR (process_name="reg.exe"))) AND (((process_exec="*Licensing Core*" AND process_exec="*EnableConcurrentSessions*")) OR ((process_exec="*AllowTSConnections*" OR process_exec="*fDenyTSConnections*" OR process_exec="*fEnableWinStation*" OR process_exec="*fSingleSessionPerUser*" OR process_exec="*IdleWinStationPoolCount*" OR process_exec="*MaxInstanceCount*" OR process_exec="*SecurityLayer*" OR process_exec="*TSAdvertise*" OR process_exec="*TSAppCompat*" OR process_exec="*TSEnabled*" OR process_exec="*TSUserEnabled*" OR process_exec="*WinStations\\RDP-Tcp*"))) AND NOT (((process_exec="*SecurityLayer*" AND process_exec="*02*"))))
