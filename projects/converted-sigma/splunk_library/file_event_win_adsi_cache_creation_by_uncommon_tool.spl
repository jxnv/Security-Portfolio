# Title: ADSI-Cache File Creation By Uncommon Tool
# ID: 75bf09fa-1dd7-4d18-9af9-dd9e492562eb
# Status: test
# Level: medium
# Author: xknow @xknow_infosec, Tim Shelton
# Date: 2019-03-24
# Tags: attack.t1001.003, attack.command-and-control
# Description: Detects the creation of an "Active Directory Schema Cache File" (.sch) file by an uncommon tool.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((file_name="*\\Local\\Microsoft\\Windows\\SchCache\\*" AND file_name="*.sch") AND NOT (((((process_path="*:\\Program Files\\Cylance\\Desktop\\CylanceSvc.exe" OR process_path="*:\\Windows\\CCM\\CcmExec.exe" OR process_path="*:\\windows\\system32\\dllhost.exe" OR process_path="*:\\Windows\\system32\\dsac.exe" OR process_path="*:\\Windows\\system32\\efsui.exe" OR process_path="*:\\windows\\system32\\mmc.exe" OR process_path="*:\\windows\\system32\\svchost.exe" OR process_path="*:\\Windows\\System32\\wbem\\WmiPrvSE.exe" OR process_path="*:\\windows\\system32\\WindowsPowerShell\\v1.0\\powershell.exe")) OR ((process_path="*:\\Windows\\ccmsetup\\autoupgrade\\ccmsetup*" OR process_path="*:\\Program Files\\SentinelOne\\Sentinel Agent*"))) OR ((process_path="*:\\Program Files\\*" AND process_path="*\\Microsoft Office*") AND process_path="*\\OUTLOOK.EXE"))) AND NOT (((process_path="*:\\Program Files\\Citrix\\Receiver StoreFront\\Services\\DefaultDomainServices\\Citrix.DeliveryServices.DomainServices.ServiceHost.exe") OR (process_path="*\\LANDesk\\LDCLient\\ldapwhoami.exe"))))
