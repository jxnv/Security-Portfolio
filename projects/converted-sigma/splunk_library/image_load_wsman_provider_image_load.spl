index=* eventtype=wineventlog (((((ImageLoaded="*\\WsmSvc.dll" OR ImageLoaded="*\\WsmAuto.dll" OR ImageLoaded="*\\Microsoft.WSMan.Management.ni.dll")) OR ((process_name="WsmSvc.dll" OR process_name="WSMANAUTOMATION.DLL" OR process_name="Microsoft.WSMan.Management.dll"))) OR (process_path="*\\svchost.exe" AND process_name="WsmWmiPl.dll")) AND NOT (((process_path="C:\\Program Files\\Citrix\\*") OR ((process_path="C:\\Program Files (x86)\\PowerShell\\6\\pwsh.exe" OR process_path="C:\\Program Files (x86)\\PowerShell\\7\\pwsh.exe" OR process_path="C:\\Program Files\\PowerShell\\6\\pwsh.exe" OR process_path="C:\\Program Files\\PowerShell\\7\\pwsh.exe" OR process_path="C:\\Windows\\System32\\sdiagnhost.exe" OR process_path="C:\\Windows\\System32\\services.exe" OR process_path="C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" OR process_path="C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe")) OR (process_path="C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_*" AND process_path="*\\GetHelp.exe") OR (process_path="*\\mmc.exe") OR ((process_path="C:\\Windows\\Microsoft.NET\\Framework64\\v*" OR process_path="C:\\Windows\\Microsoft.NET\\Framework\\v*" OR process_path="C:\\Windows\\Microsoft.NET\\FrameworkArm\\v*" OR process_path="C:\\Windows\\Microsoft.NET\\FrameworkArm64\\v*") AND process_path="*\\mscorsvw.exe") OR (process_path="C:\\Windows\\Temp\\asgard2-agent\\*") OR ((process_exec="*svchost.exe -k netsvcs -p -s BITS*" OR process_exec="*svchost.exe -k GraphicsPerfSvcGroup -s GraphicsPerfSvc*" OR process_exec="*svchost.exe -k NetworkService -p -s Wecsvc*" OR process_exec="*svchost.exe -k netsvcs*")) OR ((process_path="C:\\Windows\\System32\\Configure-SMRemoting.exe" OR process_path="C:\\Windows\\System32\\ServerManager.exe")) OR (process_path="C:\\$WINDOWS.~BT\\Sources\\*"))) AND NOT (((process_path="*\\svchost.exe") AND (NOT process_exec=*))))
