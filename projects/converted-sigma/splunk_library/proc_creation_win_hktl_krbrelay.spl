# Title: HackTool - KrbRelay Execution
# ID: e96253b8-6b3b-4f90-9e59-3b24b99cf9b4
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-04-27
# Tags: attack.credential-access, attack.t1558.003
# Description: Detects the use of KrbRelay, a Kerberos relaying tool
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="* -spn *" AND process_exec="* -clsid *" AND process_exec="* -rbcd *")) OR ((process_exec="*shadowcred*" AND process_exec="*clsid*" AND process_exec="*spn*")) OR ((process_exec="*spn *" AND process_exec="*session *" AND process_exec="*clsid *")) OR ((process_path="*\\KrbRelay.exe") OR (process_name="KrbRelay.exe")))
