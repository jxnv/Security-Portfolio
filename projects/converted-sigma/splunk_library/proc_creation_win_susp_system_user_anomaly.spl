# Title: Suspicious SYSTEM User Process Creation
# ID: 2617e7ed-adb7-40ba-b0f3-8f9945fe6c09
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), David ANDRE (additional keywords)
# Date: 2021-12-20
# Tags: attack.credential-access, attack.privilege-escalation, attack.stealth, attack.t1134, attack.t1003, attack.t1027
# Description: Detects a suspicious process creation as SYSTEM user (suspicious program or command line parameter)
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((IntegrityLevel="System" OR IntegrityLevel="S-1-16-16384") AND (user="*AUTHORI*" OR user="*AUTORI*")) AND (((process_path="*\\calc.exe" OR process_path="*\\cscript.exe" OR process_path="*\\forfiles.exe" OR process_path="*\\hh.exe" OR process_path="*\\mshta.exe" OR process_path="*\\ping.exe" OR process_path="*\\wscript.exe")) OR (regex process_exec="(?i)net\\s+user\\s+") OR ((process_exec="* -NoP *" OR process_exec="* -W Hidden *" OR process_exec="* -decode *" OR process_exec="* /decode *" OR process_exec="* /urlcache *" OR process_exec="* -urlcache *" OR process_exec="* -e* JAB*" OR process_exec="* -e* SUVYI*" OR process_exec="* -e* SQBFAFgA*" OR process_exec="* -e* aWV4I*" OR process_exec="* -e* IAB*" OR process_exec="* -e* PAA*" OR process_exec="* -e* aQBlAHgA*" OR process_exec="*vssadmin delete shadows*" OR process_exec="*reg SAVE HKLM*" OR process_exec="* -ma *" OR process_exec="*Microsoft\\Windows\\CurrentVersion\\Run*" OR process_exec="*.downloadstring(*" OR process_exec="*.downloadfile(*" OR process_exec="* /ticket:*" OR process_exec="*dpapi::*" OR process_exec="*event::clear*" OR process_exec="*event::drop*" OR process_exec="*id::modify*" OR process_exec="*kerberos::*" OR process_exec="*lsadump::*" OR process_exec="*misc::*" OR process_exec="*privilege::*" OR process_exec="*rpc::*" OR process_exec="*sekurlsa::*" OR process_exec="*sid::*" OR process_exec="*token::*" OR process_exec="*vault::cred*" OR process_exec="*vault::list*" OR process_exec="* p::d *" OR process_exec="*;iex(*" OR process_exec="*MiniDump*")))) AND NOT (((parent_process_path="*:\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\*") OR ((parent_process_path="*:\\Program Files (x86)\\Java\\*" OR parent_process_path="*:\\Program Files\\Java\\*") AND parent_process_path="*\\bin\\javaws.exe" AND (process_path="*:\\Program Files (x86)\\Java\\*" OR process_path="*:\\Program Files\\Java\\*") AND process_path="*\\bin\\jp2launcher.exe" AND process_exec="* -ma *") OR ((process_exec="*ping*" AND process_exec="*127.0.0.1*" AND process_exec="* -n *")) OR (process_path="*\\PING.EXE" AND parent_process_exec="*\\DismFoDInstall.cmd*"))))
