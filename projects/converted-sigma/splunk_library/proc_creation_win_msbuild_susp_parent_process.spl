# Title: Suspicious Msbuild Execution By Uncommon Parent Process
# ID: 33be4333-2c6b-44f4-ae28-102cdbde0a31
# Status: test
# Level: medium
# Author: frack113
# Date: 2022-11-17
# Tags: attack.stealth
# Description: Detects suspicious execution of 'Msbuild.exe' by a uncommon parent process
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_path="*\\MSBuild.exe") OR (process_name="MSBuild.exe")) AND NOT (((parent_process_path="*\\devenv.exe" OR parent_process_path="*\\cmd.exe" OR parent_process_path="*\\msbuild.exe" OR parent_process_path="*\\python.exe" OR parent_process_path="*\\explorer.exe" OR parent_process_path="*\\nuget.exe"))))
