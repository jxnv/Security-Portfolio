index=* eventtype=wineventlog (((source_process_path="*\\explorer.exe" OR source_process_path="*\\iexplore.exe" OR source_process_path="*\\msiexec.exe" OR source_process_path="*\\powerpnt.exe" OR source_process_path="*\\schtasks.exe" OR source_process_path="*\\winlogon.exe")) AND NOT (((target_process_path="") OR (source_process_path="C:\\Windows\\explorer.exe" AND (target_process_path="C:\\Program Files (x86)\\*" OR target_process_path="C:\\Program Files\\*" OR target_process_path="C:\\Windows\\System32\\*" OR target_process_path="C:\\Windows\\SysWOW64\\*")) OR (source_process_path="C:\\Program Files\\Internet Explorer\\iexplore.exe" AND (target_process_path="C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR target_process_path="C:\\Windows\\System32\\rundll32.exe")) OR (source_process_path="*\\msiexec.exe" AND (target_process_path="*\\AppData\\Local\\*" OR target_process_path="*C:\\Program Files (x86)\\*" OR target_process_path="*C:\\Program Files\\*" OR target_process_path="*C:\\Windows\\Microsoft.NET\\Framework64\\*")) OR (source_process_path="*\\msiexec.exe" AND (target_process_path="C:\\Windows\\System32\\msiexec.exe" OR target_process_path="C:\\Windows\\SysWOW64\\msiexec.exe")) OR (NOT target_process_path=*) OR (source_process_path="*\\POWERPNT.EXE" AND (target_process_path="*C:\\Program Files\\Microsoft Office\\*" OR target_process_path="*C:\\Program Files (x86)\\Microsoft Office\\*")) OR ((source_process_path="C:\\Windows\\System32\\schtasks.exe" OR source_process_path="C:\\Windows\\SysWOW64\\schtasks.exe") AND target_process_path="C:\\Windows\\System32\\conhost.exe") OR (target_process_path="System") OR (source_process_path="C:\\Windows\\System32\\winlogon.exe" AND (target_process_path="C:\\Windows\\System32\\services.exe" OR target_process_path="C:\\Windows\\System32\\wininit.exe" OR target_process_path="C:\\Windows\\System32\\csrss.exe" OR target_process_path="C:\\Windows\\System32\\LogonUI.exe" OR target_process_path="C:\\Windows\\System32\\wlrmdr.exe" OR target_process_path="C:\\Windows\\System32\\AtBroker.exe" OR target_process_path="C:\\Windows\\System32\\dwm.exe" OR target_process_path="C:\\Windows\\System32\\fontdrvhost.exe" OR target_process_path="C:\\Windows\\System32\\userinit.exe")) OR (source_process_path="C:\\Windows\\System32\\winlogon.exe" AND TargetParentProcessId=4))) AND NOT (((source_process_path="C:\\Windows\\explorer.exe" AND target_process_path="*\\aurora-dashboard.exe") OR (source_process_path="C:\\Program Files\\internet explorer\\iexplore.exe" AND (SourceCommandLine="*https://*" AND SourceCommandLine="*.checkpoint.com/documents/*" AND SourceCommandLine="*SmartConsole_OLH/*" AND SourceCommandLine="*default.htm#cshid=*")) OR (source_process_path="C:\\Program Files\\internet explorer\\iexplore.exe" AND (SourceParentImage="C:\\Program Files\\*" OR SourceParentImage="C:\\Program Files (x86)\\*") AND (SourceParentImage="*\\CheckPoint\\SmartConsole\\*" AND SourceParentImage="*\\SmartConsole.exe*")) OR (source_process_path="C:\\Windows\\explorer.exe" AND target_process_path="*\\OfficeSetup.exe") OR (source_process_path="C:\\Windows\\explorer.exe" AND target_process_path="*\\AppData\\Local\\Microsoft\\OneDrive\\OneDrive.exe") OR (source_process_path="*\\Microsoft Office\\*" AND source_process_path="*\\POWERPNT.EXE" AND target_process_path="C:\\Windows\\System32\\csrss.exe"))))
