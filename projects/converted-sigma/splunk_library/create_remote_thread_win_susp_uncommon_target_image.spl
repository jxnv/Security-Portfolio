# Title: Remote Thread Creation In Uncommon Target Image
# ID: a1a144b7-5c9b-4853-a559-2172be8d4a03
# Status: test
# Level: medium
# Author: Florian Roth (Nextron Systems)
# Date: 2022-03-16
# Tags: attack.privilege-escalation, attack.stealth, attack.t1055.003
# Description: Detects uncommon target processes for remote thread creation
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((target_process_path="*\\calc.exe" OR target_process_path="*\\calculator.exe" OR target_process_path="*\\mspaint.exe" OR target_process_path="*\\notepad.exe" OR target_process_path="*\\ping.exe" OR target_process_path="*\\sethc.exe" OR target_process_path="*\\spoolsv.exe" OR target_process_path="*\\wordpad.exe" OR target_process_path="*\\write.exe")) AND NOT (((source_process_path="C:\\Windows\\System32\\csrss.exe") OR ((source_process_path="C:\\Windows\\System32\\explorer.exe" OR source_process_path="C:\\Windows\\System32\\OpenWith.exe") AND target_process_path="C:\\Windows\\System32\\notepad.exe") OR (source_process_path="C:\\Windows\\System32\\AtBroker.exe" AND target_process_path="C:\\Windows\\System32\\Sethc.exe"))) AND NOT (((StartFunction="EtwpNotificationThread") OR (source_process_path="*unknown process*") OR (source_process_path="C:\\Program Files\\VMware\\VMware Tools\\vmtoolsd.exe" AND StartFunction="GetCommandLineW" AND (target_process_path="C:\\Windows\\System32\\notepad.exe" OR target_process_path="C:\\Windows\\System32\\spoolsv.exe")) OR (source_process_path="C:\\Program Files\\Xerox\\XeroxPrintExperience\\CommonFiles\\XeroxPrintJobEventManagerService.exe" AND StartFunction="LoadLibraryW" AND target_process_path="C:\\Windows\\System32\\spoolsv.exe"))))
