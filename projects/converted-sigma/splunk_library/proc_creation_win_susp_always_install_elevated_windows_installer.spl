# Title: Always Install Elevated Windows Installer
# ID: cd951fdc-4b2f-47f5-ba99-a33bf61e3770
# Status: test
# Level: medium
# Author: Teymur Kheirkhabarov (idea), Mangatas Tondang (rule), oscd.community
# Date: 2020-10-13
# Tags: attack.privilege-escalation, attack.t1548.002
# Description: Detects Windows Installer service (msiexec.exe) trying to install MSI packages with SYSTEM privilege
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((process_path="*\\Windows\\Installer\\*" AND process_path="*msi*") AND process_path="*tmp") OR (process_path="*\\msiexec.exe" AND (IntegrityLevel="System" OR IntegrityLevel="S-1-16-16384"))) AND ((user="*AUTHORI*" OR user="*AUTORI*")) AND NOT ((((parent_process_path="C:\\Program Files\\Avast Software\\*" OR parent_process_path="C:\\Program Files (x86)\\Avast Software\\*")) OR (parent_process_path="C:\\ProgramData\\Avira\\*") OR ((parent_process_path="C:\\Program Files\\Google\\Update\\*" OR parent_process_path="C:\\Program Files (x86)\\Google\\Update\\*")) OR (parent_process_path="C:\\Windows\\System32\\services.exe") OR ((process_exec="*\\system32\\msiexec.exe /V") OR (parent_process_exec="*\\system32\\msiexec.exe /V")) OR (parent_process_path="C:\\ProgramData\\Sophos\\*"))))
