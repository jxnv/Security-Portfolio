index=* eventtype=wineventlog ((((process_path="*\\tree.com" OR process_path="*\\WMIC.exe" OR process_path="*\\doskey.exe" OR process_path="*\\sc.exe")) OR ((process_name="wmic.exe" OR process_name="DOSKEY.EXE" OR process_name="sc.exe"))) AND ((parent_process_exec="* > %TEMP%\\*" OR parent_process_exec="* > %TMP%\\*")))
