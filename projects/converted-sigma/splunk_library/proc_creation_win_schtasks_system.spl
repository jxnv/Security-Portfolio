# Title: Schtasks Creation Or Modification With SYSTEM Privileges
# ID: 89ca78fd-b37c-4310-b3d3-81a023f83936
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-07-28
# Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053.005
# Description: Detects the creation or update of a scheduled task to run with "NT AUTHORITY\SYSTEM" privileges
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_path="*\\schtasks.exe" AND (process_exec="* /change *" OR process_exec="* /create *")) AND (process_exec="*/ru *") AND ((process_exec="*NT AUT*" OR process_exec="* SYSTEM *"))) AND NOT ((((process_exec="*/Create /F /RU System /SC WEEKLY /TN AviraSystemSpeedupVerify /TR *" OR process_exec="*:\\Program Files (x86)\\Avira\\System Speedup\\setup\\avira_speedup_setup.exe*" OR process_exec="*/VERIFY /VERYSILENT /NOSTART /NODOTNET /NORESTART\" /RL HIGHEST*")) OR ((process_exec="*Subscription Heartbeat*" AND process_exec="*\\HeartbeatConfig.xml*" AND process_exec="*\\Microsoft Shared\\OFFICE*")) OR (process_path="*\\schtasks.exe" AND (process_exec="*/TN TVInstallRestore*" AND process_exec="*\\TeamViewer_.exe*")))))
