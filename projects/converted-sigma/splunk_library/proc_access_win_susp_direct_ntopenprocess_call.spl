# Title: Potential Direct Syscall of NtOpenProcess
# ID: 3f3f3506-1895-401b-9cc3-e86b16e630d0
# Status: test
# Level: medium
# Author: Christian Burkard (Nextron Systems), Tim Shelton (FP)
# Date: 2021-07-28
# Tags: attack.execution, attack.t1106
# Description: Detects potential calls to NtOpenProcess directly from NTDLL.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((CallTrace="UNKNOWN*") AND NOT ((((source_process_path="*:\\Program Files (x86)\\*" OR source_process_path="*:\\Program Files\\*" OR source_process_path="*:\\Windows\\System32\\*" OR source_process_path="*:\\Windows\\SysWOW64\\*" OR source_process_path="*:\\Windows\\WinSxS\\*") AND (target_process_path="*:\\Program Files (x86)\\*" OR target_process_path="*:\\Program Files\\*" OR target_process_path="*:\\Windows\\System32\\*" OR target_process_path="*:\\Windows\\SysWOW64\\*" OR target_process_path="*:\\Windows\\WinSxS\\*")) OR (Provider_Name="Microsoft-Windows-Kernel-Audit-API-Calls") OR (target_process_path="*vcredist_x64.exe" AND source_process_path="*vcredist_x64.exe"))) AND NOT (((source_process_path="*:\\Program Files\\Adobe\\Acrobat DC\\Acrobat\\*" AND source_process_path="*\\AcroCEF.exe" AND target_process_path="*:\\Program Files\\Adobe\\Acrobat DC\\Acrobat\\*" AND target_process_path="*\\AcroCEF.exe") OR (source_process_path="*AmazonSSMAgentSetup.exe" AND target_process_path="*AmazonSSMAgentSetup.exe") OR (source_process_path="*:\\Windows\\Explorer.EXE" AND target_process_path="*:\\Program Files\\Cylance\\Desktop\\CylanceUI.exe") OR (target_process_path="*\\AppData\\Local\\Discord\\*" AND target_process_path="*\\Discord.exe") OR (target_process_path="*\\Evernote\\Evernote.exe") OR (target_process_path="*\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe" AND source_process_path="*\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe") OR (target_process_path="*:\\Windows\\system32\\systeminfo.exe" AND source_process_path="*setup64.exe") OR (source_process_path="*\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe" AND target_process_path="*\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe") OR (source_process_path="*\\AppData\\Local\\yammerdesktop\\app-*" AND source_process_path="*\\Yammer.exe" AND target_process_path="*\\AppData\\Local\\yammerdesktop\\app-*" AND target_process_path="*\\Yammer.exe" AND GrantedAccess="0x1000"))))
