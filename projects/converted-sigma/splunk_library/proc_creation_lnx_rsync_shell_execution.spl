# Title: Shell Execution via Rsync - Linux
# ID: e2326866-609f-4015-aea9-7ec634e8aa04
# Status: experimental
# Level: high
# Author: Li Ling, Andy Parkidomo, Robert Rakowski, Blake Hartstein (Bloomberg L.P.), Florian Roth
# Date: 2024-09-02
# Tags: attack.execution, attack.t1059
# Description: Detects the use of the "rsync" utility to execute a shell. Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* sourcetype="syslog" (((process_exec="*/ash *" OR process_exec="*/bash *" OR process_exec="*/dash *" OR process_exec="*/csh *" OR process_exec="*/sh *" OR process_exec="*/zsh *" OR process_exec="*/tcsh *" OR process_exec="*/ksh *" OR process_exec="*'ash *" OR process_exec="*'bash *" OR process_exec="*'dash *" OR process_exec="*'csh *" OR process_exec="*'sh *" OR process_exec="*'zsh *" OR process_exec="*'tcsh *" OR process_exec="*'ksh *")) AND ((process_path="*/rsync" OR process_path="*/rsyncd") AND process_exec="* -e *"))
