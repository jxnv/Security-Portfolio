# Title: Potential Binary Impersonating Sysinternals Tools
# ID: 7cce6fc8-a07f-4d84-a53e-96e1879843c9
# Status: test
# Level: medium
# Author: frack113, Swachchhanda Shrawan Poudel (Nextron Systems)
# Date: 2021-12-20
# Tags: attack.execution, attack.stealth, attack.t1218, attack.t1202, attack.t1036.005
# Description: Detects binaries that use the same name as legitimate sysinternals tools to evade detection.
# This rule looks for the execution of binaries that are named similarly to Sysinternals tools.
# Adversary may rename their malicious tools as legitimate Sysinternals tools to evade detection.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((process_path="*\\accesschk64a.exe" OR process_path="*\\ADExplorer64a.exe" OR process_path="*\\ADInsight64a.exe" OR process_path="*\\adrestore64a.exe" OR process_path="*\\Autologon64a.exe" OR process_path="*\\Autoruns64a.exe" OR process_path="*\\autorunsc64a.exe" OR process_path="*\\Clockres64a.exe" OR process_path="*\\Contig64a.exe" OR process_path="*\\Coreinfo64a.exe" OR process_path="*\\Dbgview64a.exe" OR process_path="*\\disk2vhd64a.exe" OR process_path="*\\diskext64a.exe" OR process_path="*\\DiskView64a.exe" OR process_path="*\\du64a.exe" OR process_path="*\\FindLinks64a.exe" OR process_path="*\\handle64a.exe" OR process_path="*\\hex2dec64a.exe" OR process_path="*\\junction64a.exe" OR process_path="*\\LoadOrd64a.exe" OR process_path="*\\LoadOrdC64a.exe" OR process_path="*\\logonsessions64a.exe" OR process_path="*\\movefile64a.exe" OR process_path="*\\notmyfault64a.exe" OR process_path="*\\notmyfaultc64a.exe" OR process_path="*\\pendmoves64a.exe" OR process_path="*\\pipelist64a.exe" OR process_path="*\\procdump64a.exe" OR process_path="*\\procexp64a.exe" OR process_path="*\\Procmon64a.exe" OR process_path="*\\PsExec64a.exe" OR process_path="*\\psfile64a.exe" OR process_path="*\\PsGetsid64a.exe" OR process_path="*\\PsInfo64a.exe" OR process_path="*\\pskill64a.exe" OR process_path="*\\psloglist64a.exe" OR process_path="*\\pspasswd64a.exe" OR process_path="*\\psping64a.exe" OR process_path="*\\PsService64a.exe" OR process_path="*\\pssuspend64a.exe" OR process_path="*\\RAMMap64a.exe" OR process_path="*\\RegDelNull64a.exe" OR process_path="*\\ru64a.exe" OR process_path="*\\sdelete64a.exe" OR process_path="*\\sigcheck64a.exe" OR process_path="*\\streams64a.exe" OR process_path="*\\strings64a.exe" OR process_path="*\\sync64a.exe" OR process_path="*\\Sysmon64a.exe" OR process_path="*\\tcpvcon64a.exe" OR process_path="*\\tcpview64a.exe" OR process_path="*\\vmmap64a.exe" OR process_path="*\\whois64a.exe" OR process_path="*\\Winobj64a.exe" 