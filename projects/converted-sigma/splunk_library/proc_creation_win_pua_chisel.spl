# Title: PUA - Chisel Tunneling Tool Execution
# ID: 8b0e12da-d3c3-49db-bb4f-256703f380e5
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-09-13
# Tags: attack.command-and-control, attack.t1090.001
# Description: Detects usage of the Chisel tunneling tool via the commandline arguments
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((process_path="*\\chisel.exe") OR (((process_exec="*exe client *" OR process_exec="*exe server *")) AND ((process_exec="*-socks5*" OR process_exec="*-reverse*" OR process_exec="* r:*" OR process_exec="*:127.0.0.1:*" OR process_exec="*-tls-skip-verify *" OR process_exec="*:socks*"))))
