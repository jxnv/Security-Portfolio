# Title: Windows Binaries Write Suspicious Extensions
# ID: b8fd0e93-ff58-4cbd-8f48-1c114e342e62
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-08-12
# Tags: attack.stealth, attack.t1036
# Description: Detects Windows executables that write files with suspicious extensions
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((process_path="*\\csrss.exe" OR process_path="*\\lsass.exe" OR process_path="*\\RuntimeBroker.exe" OR process_path="*\\sihost.exe" OR process_path="*\\smss.exe" OR process_path="*\\wininit.exe" OR process_path="*\\winlogon.exe") AND (file_name="*.bat" OR file_name="*.dll" OR file_name="*.exe" OR file_name="*.hta" OR file_name="*.iso" OR file_name="*.ps1" OR file_name="*.txt" OR file_name="*.vbe" OR file_name="*.vbs")) OR ((process_path="*\\dllhost.exe" OR process_path="*\\rundll32.exe" OR process_path="*\\svchost.exe") AND (file_name="*.bat" OR file_name="*.hta" OR file_name="*.iso" OR file_name="*.ps1" OR file_name="*.vbe" OR file_name="*.vbs"))) AND NOT (((process_path="C:\\Windows\\System32\\dllhost.exe" AND (file_name="*:\\Users\\*" AND file_name="*\\AppData\\Local\\Temp\\__PSScriptPolicyTest_*") AND file_name="*.ps1") OR (process_path="C:\\Windows\\system32\\svchost.exe" AND (file_name="*C:\\Program Files\\WindowsApps\\Clipchamp*" AND file_name="*.ps1*")) OR ((process_path="C:\\Windows\\system32\\svchost.exe" OR process_path="C:\\Windows\\SysWOW64\\svchost.exe") AND (file_name="C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview*" OR file_name="C:\\Program Files (x86)\\WindowsApps\\Microsoft.PowerShellPreview*") AND file_name="*.ps1") OR (process_path="C:\\Windows\\system32\\svchost.exe" AND (file_name="*C:\\Windows\\System32\\GroupPolicy\\DataStore\\*" AND file_name="*\\sysvol\\*" AND file_name="*\\Policies\\*" AND file_name="*\\Machine\\Scripts\\Startup\\*") AND (file_name="*.ps1" OR file_name="*.bat")))))
