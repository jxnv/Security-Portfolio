# Title: DNS Query To AzureWebsites.NET By Non-Browser Process
# ID: e043f529-8514-4205-8ab0-7f7d2927b400
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2024-06-24
# Tags: attack.command-and-control, attack.t1219.002
# Description: Detects a DNS query by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((QueryName="*azurewebsites.net") AND NOT ((((process_path="C:\\Program Files (x86)\\Avant Browser\\*" OR process_path="C:\\Program Files\\Avant Browser\\*") AND process_path="*\\avant.exe") OR (process_path="*\\brave.exe" AND process_path="C:\\Program Files\\BraveSoftware\\*") OR ((process_path="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR process_path="C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((process_path="*\\MsMpEng.exe" OR process_path="*\\MsSense.exe")) OR ((process_path="C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*") OR (process_path="*\\WindowsApps\\MicrosoftEdge.exe") OR ((process_path="C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR process_path="C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process_path="C:\\Program Files (x86)\\Microsoft\\EdgeCore\\*" OR process_path="C:\\Program Files\\Microsoft\\EdgeCore\\*") AND (process_path="*\\msedge.exe" OR process_path="*\\msedgewebview2.exe")) OR ((process_path="C:\\Program Files\\Falkon\\*" OR process_path="C:\\Program Files (x86)\\Falkon\\*") AND process_path="*\\falkon.exe") OR ((process_path="C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR process_path="C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR (process_path="*\\AppData\\Local\\Flock\\*" AND process_path="*\\Flock.exe") OR ((process_path="C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR process_path="C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process_path="*\\AppData\\Local\\Maxthon\\*" AND process_path="*\\maxthon.exe") OR (process_path="*\\AppData\\Local\\Programs\\midori-ng\\*" AND process_path="*\\Midori Next Generation.exe") OR (process_path="*\\AppData\\Local\\Programs\\Opera\\*" AND process_path="*\\opera.exe") OR (process_path="*\\AppData\\Local\\Phoebe\\*" AND process_path="*\\Phoebe.exe") OR (process_path="*\\safari.exe") OR ((process_path="C:\\Program Files\\SeaMonkey\\*" OR process_path="C:\\Program Files (x86)\\SeaMonkey\\*") AND process_path="*\\seamonkey.exe") OR ((process_path="C:\\Program Files\\SlimBrowser\\*" OR process_path="C:\\Program Files (x86)\\SlimBrowser\\*") AND process_path="*\\slimbrowser.exe") OR (process_path="*\\Tor Browser\\*") OR (process_path="*\\AppData\\Local\\Vivaldi\\*" AND process_path="*\\vivaldi.exe") OR ((process_path="C:\\Program Files\\Naver\\Naver Whale\\*" OR process_path="C:\\Program Files (x86)\\Naver\\Naver Whale\\*") AND process_path="*\\whale.exe") OR ((process_path="C:\\Program Files\\Waterfox\\*" OR process_path="C:\\Program Files (x86)\\Waterfox\\*") AND process_path="*\\Waterfox.exe"))))
