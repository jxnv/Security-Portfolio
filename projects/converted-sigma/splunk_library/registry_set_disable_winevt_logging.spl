# Title: Disable Windows Event Logging Via Registry
# ID: 2f78da12-f7c7-430b-8b19-a28f269b77a3
# Status: test
# Level: high
# Author: frack113, Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-07-04
# Tags: attack.defense-impairment, attack.t1685.001
# Description: Detects tampering with the "Enabled" registry key in order to disable Windows logging of a Windows event channel
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((registry_key_name="*\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\*" AND registry_key_name="*\\Enabled" AND Details="DWORD (0x00000000)") AND NOT (((process_path="C:\\Windows\\winsxs\\*" AND process_path="*\\TiWorker.exe") OR (process_path="C:\\Windows\\System32\\svchost.exe" AND (registry_key_name="*\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-FileInfoMinifilter*" OR registry_key_name="*\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-ASN1\\*" OR registry_key_name="*\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-Kernel-AppCompat\\*" OR registry_key_name="*\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-Runtime\\Error\\*" OR registry_key_name="*\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-CAPI2/Operational\\*")) OR (process_path="C:\\Windows\\servicing\\TrustedInstaller.exe" AND registry_key_name="*\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-Compat-Appraiser*") OR (process_path="C:\\Windows\\system32\\wevtutil.exe"))) AND NOT (((process_path="") OR (NOT process_path=*))))
