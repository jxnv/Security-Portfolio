# Title: Enumeration for 3rd Party Creds From CLI
# ID: 87a476dc-0079-4583-a985-dee7a20a03de
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-06-20
# Tags: attack.credential-access, attack.t1552.002
# Description: Detects processes that query known 3rd party registry keys that holds credentials via commandline
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="*\\Software\\Aerofox\\Foxmail\\V3.1*" OR process_exec="*\\Software\\Aerofox\\FoxmailPreview*" OR process_exec="*\\Software\\DownloadManager\\Passwords*" OR process_exec="*\\Software\\FTPWare\\COREFTP\\Sites*" OR process_exec="*\\Software\\IncrediMail\\Identities*" OR process_exec="*\\Software\\Martin Prikryl\\WinSCP 2\\Sessions*" OR process_exec="*\\Software\\Mobatek\\MobaXterm\\*" OR process_exec="*\\Software\\OpenSSH\\Agent\\Keys*" OR process_exec="*\\Software\\OpenVPN-GUI\\configs*" OR process_exec="*\\Software\\ORL\\WinVNC3\\Password*" OR process_exec="*\\Software\\Qualcomm\\Eudora\\CommandLine*" OR process_exec="*\\Software\\RealVNC\\WinVNC4*" OR process_exec="*\\Software\\RimArts\\B2\\Settings*" OR process_exec="*\\Software\\SimonTatham\\PuTTY\\Sessions*" OR process_exec="*\\Software\\SimonTatham\\PuTTY\\SshHostKeys\\*" OR process_exec="*\\Software\\Sota\\FFFTP*" OR process_exec="*\\Software\\TightVNC\\Server*" OR process_exec="*\\Software\\WOW6432Node\\Radmin\\v3.0\\Server\\Parameters\\Radmin*")) AND NOT ((process_path="*reg.exe" AND (process_exec="*export*" OR process_exec="*save*"))))
