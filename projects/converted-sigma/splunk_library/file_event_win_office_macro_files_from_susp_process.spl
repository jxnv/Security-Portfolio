# Title: Office Macro File Creation From Suspicious Process
# ID: b1c50487-1967-4315-a026-6491686d860e
# Status: test
# Level: high
# Author: frack113, Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-01-23
# Tags: attack.initial-access, attack.t1566.001
# Description: Detects the creation of a office macro file from a a suspicious process
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((process_path="*\\cscript.exe" OR process_path="*\\mshta.exe" OR process_path="*\\regsvr32.exe" OR process_path="*\\rundll32.exe" OR process_path="*\\wscript.exe")) OR ((parent_process_path="*\\cscript.exe" OR parent_process_path="*\\mshta.exe" OR parent_process_path="*\\regsvr32.exe" OR parent_process_path="*\\rundll32.exe" OR parent_process_path="*\\wscript.exe"))) AND ((file_name="*.docm" OR file_name="*.dotm" OR file_name="*.xlsm" OR file_name="*.xltm" OR file_name="*.potm" OR file_name="*.pptm")))
