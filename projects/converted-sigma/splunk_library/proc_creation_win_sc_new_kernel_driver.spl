# Title: New Kernel Driver Via SC.EXE
# ID: 431a1fdb-4799-4f3b-91c3-a683b003fc49
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-07-14
# Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
# Description: Detects creation of a new service (kernel driver) with the type "kernel"
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((process_path="*\\sc.exe" AND (process_exec="*create*" OR process_exec="*config*") AND (process_exec="*binPath*" AND process_exec="*type*" AND process_exec="*kernel*")) AND NOT ((((process_exec="*create netprotection_network_filter*" AND process_exec="*type= kernel start= *" AND process_exec="*binPath= System32\\drivers\\netprotection_network_filter*" AND process_exec="*DisplayName= netprotection_network_filter*" AND process_exec="*group= PNP_TDI tag= yes*")) OR ((process_exec="*create avelam binpath=C:\\Windows\\system32\\drivers\\avelam.sys*" AND process_exec="*type=kernel start=boot error=critical group=Early-Launch*")))))
