# Title: Renamed Visual Studio Code Tunnel Execution
# ID: 2cf29f11-e356-4f61-98c0-1bdb9393d6da
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-09-28
# Tags: attack.command-and-control, attack.t1071.001, attack.t1219
# Description: Detects renamed Visual Studio Code tunnel execution. Attackers can abuse this functionality to establish a C2 channel
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((NOT process_name=* AND process_exec="*.exe tunnel") OR ((process_exec="*.exe tunnel*" AND process_exec="*--accept-server-license-terms*")) OR ((process_exec="*tunnel *" AND process_exec="*service*" AND process_exec="*internal-run*" AND process_exec="*tunnel-service.log*"))) AND NOT (((process_path="*\\code-tunnel.exe" OR process_path="*\\code.exe")))) OR ((parent_process_exec="* tunnel" AND process_path="*\\cmd.exe" AND (process_exec="*/d /c *" AND process_exec="*\\servers\\Stable-*" AND process_exec="*code-server.cmd*")) AND NOT (((parent_process_path="*\\code-tunnel.exe" OR parent_process_path="*\\code.exe")))))
