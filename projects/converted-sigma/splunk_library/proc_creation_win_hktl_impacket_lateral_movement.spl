# Tags: attack.execution, attack.t1047, attack.lateral-movement, attack.t1021.003
# Description: Detects wmiexec/dcomexec/atexec/smbexec from Impacket framework
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((parent_process_exec="*svchost.exe -k netsvcs*" OR parent_process_exec="*taskeng.exe*") AND (process_exec="*cmd.exe*" AND process_exec="*/C*" AND process_exec="*Windows\\Temp\\*" AND process_exec="*&1*")) OR ((parent_process_path="*\\wmiprvse.exe" OR parent_process_path="*\\mmc.exe" OR parent_process_path="*\\explorer.exe" OR parent_process_path="*\\services.exe") AND (process_exec="*cmd.exe*" AND process_exec="*/Q*" AND process_exec="*/c*" AND process_exec="*\\\\\\\\127.0.0.1\\\\*" AND process_exec="*&1*")))
