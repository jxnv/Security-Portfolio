# Title: Disable Internal Tools or Feature in Registry
# ID: e2482f8d-3443-4237-b906-cc145d87a076
# Status: test
# Level: medium
# Author: frack113, Nasreddine Bencherchali (Nextron Systems), CrimpSec
# Date: 2022-03-18
# Tags: attack.persistence, attack.defense-impairment, attack.t1112
# Description: Detects registry modifications that change features of internal Windows tools (malware like Agent Tesla uses this technique)
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((registry_key_name="*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\ConsentPromptBehaviorAdmin" OR registry_key_name="*Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\InactivityTimeoutSecs" OR registry_key_name="*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\shutdownwithoutlogon" OR registry_key_name="*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\PushNotifications\\ToastEnabled" OR registry_key_name="*SYSTEM\\CurrentControlSet\\Control\\Storage\\Write Protection" OR registry_key_name="*SYSTEM\\CurrentControlSet\\Control\\StorageDevicePolicies\\WriteProtect") AND Details="DWORD (0x00000000)") OR ((registry_key_name="*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\DisableCMD" OR registry_key_name="*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\NoControlPanel" OR registry_key_name="*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\NoRun" OR registry_key_name="*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\StartMenuLogOff" OR registry_key_name="*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\DisableChangePassword" OR registry_key_name="*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\DisableLockWorkstation" OR registry_key_name="*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\DisableRegistryTools" OR registry_key_name="*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\DisableTaskmgr" OR registry_key_name="*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\NoDispBackgroundPage" OR registry_key_name="*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\NoDispCPL" OR registry_key_name="*SOFTWARE\\Policies\\Microsoft\\Windows\\Explorer\\DisableNotificationCenter" OR registry_key_name="*SOFTWARE\\Policies\\Microsoft\\Windows\\System\\DisableCMD") AND Details="DWORD (0x00000001)"))
