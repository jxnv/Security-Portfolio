# Tags: attack.stealth, attack.t1006
# Description: Detects raw disk access using uncommon tools or tools that are located in suspicious locations (heavy filtering is required), which could indicate possible defense evasion attempts
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (NOT (((Device="*floppy*") OR ((process_path="C:\\$WINDOWS.~BT\\*" OR process_path="C:\\Program Files (x86)\\*" OR process_path="C:\\Program Files\\*" OR process_path="C:\\Windows\\CCM\\*" OR process_path="C:\\Windows\\explorer.exe*" OR process_path="C:\\Windows\\servicing\\*" OR process_path="C:\\Windows\\SoftwareDistribution\\*" OR process_path="C:\\Windows\\System32\\*" OR process_path="C:\\Windows\\SystemApps\\*" OR process_path="C:\\Windows\\SysWOW64\\*" OR process_path="C:\\Windows\\uus\\*" OR process_path="C:\\Windows\\WinSxS\\*")) OR (process_path="C:\\Users\\*" AND (process_path="*\\AppData\\*" AND process_path="*\\Microsoft\\*")) OR (NOT process_path=*) OR (process_path="C:\\Windows\\Temp\\*" AND (process_path="*\\Executables\\SSDUpdate.exe" OR process_path="*\\HostMetadata\\NVMEHostmetadata.exe")) OR ((process_path="Registry" OR process_path="System")) OR (process_path="C:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe") OR (process_path="C:\\$WinREAgent\\Scratch\\*") OR (process_path="C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*" AND (process_path="*\\MsMpEng.exe" OR process_path="*\\MpDefenderCoreService.exe")))) AND NOT (((process_path="C:\\Users\\*" AND process_path="*\\AppData\\Local\\Keybase\\upd.exe*") OR (process_path="C:\\Users\\*" AND process_path="*\\AppData\\Local\\GitHubDesktop\\app-*" AND process_path="*\\resources\\app\\git\\mingw64\\bin\\git.exe") OR (process_path="C:\\Windows\\Temp\\asgard2-agent\\*" AND process_path="*\\thor.exe"))))
