# Title: File and Directory Discovery - MacOS
# ID: 089dbdf6-b960-4bcc-90e3-ffc3480c20f6
# Status: test
# Level: informational
# Author: Daniil Yugoslavskiy, oscd.community
# Date: 2020-10-19
# Tags: attack.discovery, attack.t1083
# Description: Detects usage of system utilities to discover files and directories
# Converted by: Sigma Universal SIEM/EDR CLI

index=* ((process_path="/usr/bin/file" AND regex process_exec="(?i)(.){200,}") OR (process_path="/usr/bin/find") OR (process_path="/usr/bin/mdfind") OR (process_path="/bin/ls" AND process_exec="*-R*") OR 1=1)
