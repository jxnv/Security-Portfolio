# Title: Renamed Office Binary Execution
# ID: 0b0cd537-fc77-4e6e-a973-e53495c1083d
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-12-20
# Tags: attack.stealth, attack.t1036.003
# Description: Detects the execution of a renamed office binary
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((process_name="Excel.exe" OR process_name="MSACCESS.EXE" OR process_name="MSPUB.EXE" OR process_name="OneNote.exe" OR process_name="OneNoteM.exe" OR process_name="OUTLOOK.EXE" OR process_name="POWERPNT.EXE" OR process_name="WinWord.exe" OR process_name="Olk.exe")) OR ((Description="Microsoft Access" OR Description="Microsoft Excel" OR Description="Microsoft OneNote" OR Description="Microsoft Outlook" OR Description="Microsoft PowerPoint" OR Description="Microsoft Publisher" OR Description="Microsoft Word" OR Description="Sent to OneNote Tool"))) AND NOT (((process_path="*\\EXCEL.exe" OR process_path="*\\excelcnv.exe" OR process_path="*\\MSACCESS.exe" OR process_path="*\\MSPUB.EXE" OR process_path="*\\ONENOTE.EXE" OR process_path="*\\ONENOTEM.EXE" OR process_path="*\\OUTLOOK.EXE" OR process_path="*\\POWERPNT.EXE" OR process_path="*\\WINWORD.exe" OR process_path="*\\OLK.EXE"))))
