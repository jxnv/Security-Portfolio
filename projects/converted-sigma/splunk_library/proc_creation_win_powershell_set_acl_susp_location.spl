# Title: PowerShell Set-Acl On Windows Folder
# ID: 0944e002-e3f6-4eb5-bf69-3a3067b53d73
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-10-18
# Tags: attack.stealth
# Description: Detects PowerShell scripts to set the ACL to a file in the Windows folder
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="*Set-Acl *" AND process_exec="*-AclObject *")) AND (((process_name="PowerShell.EXE" OR process_name="pwsh.dll")) OR ((process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe"))) AND ((process_exec="*-Path \"C:\\Windows*" OR process_exec="*-Path 'C:\\Windows*" OR process_exec="*-Path %windir%*" OR process_exec="*-Path $env:windir*")) AND ((process_exec="*FullControl*" OR process_exec="*Allow*")))
