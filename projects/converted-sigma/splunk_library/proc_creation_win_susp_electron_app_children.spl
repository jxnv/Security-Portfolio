# Title: Suspicious Electron Application Child Processes
# ID: f26eb764-fd89-464b-85e2-dc4a8e6e77b8
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-10-21
# Tags: attack.execution
# Description: Detects suspicious child processes of electron apps (teams, discord, slack, etc.). This could be a potential sign of ".asar" file tampering (See reference section for more information) or binary execution proxy through specific CLI arguments (see related rule)
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((parent_process_path="*\\chrome.exe" OR parent_process_path="*\\discord.exe" OR parent_process_path="*\\GitHubDesktop.exe" OR parent_process_path="*\\keybase.exe" OR parent_process_path="*\\msedge.exe" OR parent_process_path="*\\msedgewebview2.exe" OR parent_process_path="*\\msteams.exe" OR parent_process_path="*\\slack.exe" OR parent_process_path="*\\teams.exe")) AND (((process_path="*\\cmd.exe" OR process_path="*\\cscript.exe" OR process_path="*\\mshta.exe" OR process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe" OR process_path="*\\regsvr32.exe" OR process_path="*\\whoami.exe" OR process_path="*\\wscript.exe")) OR ((process_path="*:\\ProgramData\\*" OR process_path="*:\\Temp\\*" OR process_path="*\\AppData\\Local\\Temp\\*" OR process_path="*\\Users\\Public\\*" OR process_path="*\\Windows\\Temp\\*"))) AND NOT ((parent_process_path="*\\Discord.exe" AND process_path="*\\cmd.exe" AND process_exec="*\\NVSMI\\nvidia-smi.exe*")))
