# Title: Potentially Suspicious Child Process Of VsCode
# ID: 5a3164f2-b373-4152-93cf-090b13c12d27
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-01-26
# Tags: attack.execution, attack.stealth, attack.t1218, attack.t1202
# Description: Detects uncommon or suspicious child processes spawning from a VsCode "code.exe" process. This could indicate an attempt of persistence via VsCode tasks or terminal profiles.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((parent_process_path="*\\code.exe") AND (((process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe" OR process_path="*\\cmd.exe") AND (process_exec="*Invoke-Expressions*" OR process_exec="*IEX*" OR process_exec="*Invoke-Command*" OR process_exec="*ICM*" OR process_exec="*DownloadString*" OR process_exec="*rundll32*" OR process_exec="*regsvr32*" OR process_exec="*wscript*" OR process_exec="*cscript*")) OR ((process_path="*\\calc.exe" OR process_path="*\\regsvr32.exe" OR process_path="*\\rundll32.exe" OR process_path="*\\cscript.exe" OR process_path="*\\wscript.exe")) OR ((process_path="*:\\Users\\Public\\*" OR process_path="*:\\Windows\\Temp\\*" OR process_path="*:\\Temp\\*"))))
