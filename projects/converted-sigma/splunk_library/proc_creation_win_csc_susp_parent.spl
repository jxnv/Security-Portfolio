# Description: Detects a potentially suspicious parent of "csc.exe", which could be a sign of payload delivery.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_path="*\\csc.exe") OR (process_name="csc.exe")) AND (((parent_process_path="*\\cscript.exe" OR parent_process_path="*\\excel.exe" OR parent_process_path="*\\mshta.exe" OR parent_process_path="*\\onenote.exe" OR parent_process_path="*\\outlook.exe" OR parent_process_path="*\\powerpnt.exe" OR parent_process_path="*\\winword.exe" OR parent_process_path="*\\wscript.exe")) OR ((parent_process_path="*\\powershell.exe" OR parent_process_path="*\\pwsh.exe") AND (parent_process_exec="*-Encoded *" OR parent_process_exec="*FromBase64String*")) OR ((regex parent_process_exec="(?i)(?:[Pp]rogram[Dd]ata|%(?:[Ll]ocal)?[Aa]pp[Dd]ata%|\\\\[Aa]pp[Dd]ata\\\\(?:[Ll]ocal(?:[Ll]ow)?|[Rr]oaming))\\\\[^\\\\]{1,256}$") OR ((parent_process_exec="*:\\PerfLogs\\*" OR parent_process_exec="*:\\Users\\Public\\*" OR parent_process_exec="*:\\Windows\\Temp\\*" OR parent_process_exec="*\\Temporary Internet*")) OR ((parent_process_exec="*:\\Users\\*" AND parent_process_exec="*\\Favorites\\*")) OR ((parent_process_exec="*:\\Users\\*" AND parent_process_exec="*\\Favourites\\*")) OR ((parent_process_exec="*:\\Users\\*" AND parent_process_exec="*\\Contacts\\*")) OR ((parent_process_exec="*:\\Users\\*" AND parent_process_exec="*\\Pictures\\*")))) AND NOT ((((parent_process_path="C:\\Program Files (x86)\\*" OR parent_process_path="C:\\Program Files\\*")) OR (parent_process_path="C:\\Windows\\System32\\sdiagnhost.exe") OR (parent_process_path="C:\\Windows\\System32\\inetsrv\\w3wp.exe"))) AND NOT ((((parent_process_exec="*JwB7ACIAZgBhAGkAbABlAGQAIgA6AHQAcgB1AGUALAAiAG0AcwBnACIAOgAiAEEAbgBzAGkAYgBsAGUAIAByAGUAcQB1AGkAcgBlAHMAIABQAG8AdwBlAHIAUwBoAGUAbABsACAAdgAzAC4AMAAgAG8AcgAgAG4AZQB3AGUAcgAiAH0AJw*" OR parent_process_exec="*cAewAiAGYAYQBpAGwAZQBkACIAOgB0AHIAdQBlACwAIgBtAHMAZwAiADoAIgBBAG4AcwBpAGIAbABlACAAcgBlAHEAdQBpAHIAZQBzACAAUABvAHcAZQByAFMAaABlAGwAbAAgAHYAMwAuADAAIABvAHIAIABuAGUAdwBlAHIAIgB9ACcA*" OR parent_process_exec="*nAHsAIgBmAGEAaQBsAGUAZAAiADoAdAByAHUAZQAsACIAbQBzAGcAIgA6ACIAQQBuAHMAaQBiAGwAZQAgAHIAZQBxAHUAaQByAGUAcwAgAFAAbwB3AGUAcgBTAGgAZQBsAGwAIAB2ADMALgAwACAAbwByACAAbgBlAHcAZQByACIAfQAnA*")) OR (parent_process_path="C:\\ProgramData\\chocolatey\\choco.exe") OR (parent_process_exec="*\\ProgramData\\Microsoft\\Windows Defender Advanced Threat Protection*"))))
