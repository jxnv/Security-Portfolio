# Title: Suspicious Double Extension File Execution
# ID: 1cdd9a09-06c9-4769-99ff-626e2b3991b8
# Status: stable
# Level: high
# Author: Florian Roth (Nextron Systems), @blu3_team (idea), Nasreddine Bencherchali (Nextron Systems)
# Date: 2019-06-26
# Tags: attack.initial-access, attack.t1566.001
# Description: Detects suspicious use of an .exe extension after a non-executable file extension like .pdf.exe, a set of spaces or underlines to cloak the executable file in spear phishing campaigns
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((process_path="*      .exe" OR process_path="*______.exe" OR process_path="*.doc.exe" OR process_path="*.doc.js" OR process_path="*.docx.exe" OR process_path="*.docx.js" OR process_path="*.gif.exe" OR process_path="*.jpeg.exe" OR process_path="*.jpg.exe" OR process_path="*.mkv.exe" OR process_path="*.mov.exe" OR process_path="*.mp3.exe" OR process_path="*.mp4.exe" OR process_path="*.pdf.exe" OR process_path="*.pdf.js" OR process_path="*.png.exe" OR process_path="*.ppt.exe" OR process_path="*.ppt.js" OR process_path="*.pptx.exe" OR process_path="*.pptx.js" OR process_path="*.rtf.exe" OR process_path="*.rtf.js" OR process_path="*.svg.exe" OR process_path="*.txt.exe" OR process_path="*.txt.js" OR process_path="*.xls.exe" OR process_path="*.xls.js" OR process_path="*.xlsx.exe" OR process_path="*.xlsx.js" OR process_path="*⠀⠀⠀⠀⠀⠀.exe") AND (process_exec="*      .exe*" OR process_exec="*______.exe*" OR process_exec="*.doc.exe*" OR process_exec="*.doc.js*" OR process_exec="*.docx.exe*" OR process_exec="*.docx.js*" OR process_exec="*.gif.exe*" OR process_exec="*.jpeg.exe*" OR process_exec="*.jpg.exe*" OR process_exec="*.mkv.exe*" OR process_exec="*.mov.exe*" OR process_exec="*.mp3.exe*" OR process_exec="*.mp4.exe*" OR process_exec="*.pdf.exe*" OR process_exec="*.pdf.js*" OR process_exec="*.png.exe*" OR process_exec="*.ppt.exe*" OR process_exec="*.ppt.js*" OR process_exec="*.pptx.exe*" OR process_exec="*.pptx.js*" OR process_exec="*.rtf.exe*" OR process_exec="*.rtf.js*" OR process_exec="*.svg.exe*" OR process_exec="*.txt.exe*" OR process_exec="*.txt.js*" OR process_exec="*.xls.exe*" OR process_exec="*.xls.js*" OR process_exec="*.xlsx.exe*" OR process_exec="*.xlsx.js*" OR process_exec="*⠀⠀⠀⠀⠀⠀.exe*"))
