# Title: Linux Crypto Mining Indicators
# ID: 9069ea3c-b213-4c52-be13-86506a227ab1
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2021-10-26
# Tags: attack.impact, attack.t1496
# Description: Detects command line parameters or strings often used by crypto miners
# Converted by: Sigma Universal SIEM/EDR CLI

index=* sourcetype="syslog" ((process_exec="* --cpu-priority=*" OR process_exec="*--donate-level=0*" OR process_exec="* -o pool.*" OR process_exec="* --nicehash*" OR process_exec="* --algo=rx/0 *" OR process_exec="*stratum+tcp://*" OR process_exec="*stratum+udp://*" OR process_exec="*sh -c /sbin/modprobe msr allow_writes=on*" OR process_exec="*LS1kb25hdGUtbGV2ZWw9*" OR process_exec="*0tZG9uYXRlLWxldmVsP*" OR process_exec="*tLWRvbmF0ZS1sZXZlbD*" OR process_exec="*c3RyYXR1bSt0Y3A6Ly*" OR process_exec="*N0cmF0dW0rdGNwOi8v*" OR process_exec="*zdHJhdHVtK3RjcDovL*" OR process_exec="*c3RyYXR1bSt1ZHA6Ly*" OR process_exec="*N0cmF0dW0rdWRwOi8v*" OR process_exec="*zdHJhdHVtK3VkcDovL*"))
