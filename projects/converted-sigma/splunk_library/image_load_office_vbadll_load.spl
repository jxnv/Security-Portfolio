# Title: VBA DLL Loaded Via Office Application
# ID: e6ce8457-68b1-485b-9bdd-3c2b5d679aa9
# Status: test
# Level: high
# Author: Antonlovesdnb
# Date: 2020-02-19
# Tags: attack.execution, attack.t1204.002
# Description: Detects VB DLL's loaded by an office application. Which could indicate the presence of VBA Macros.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((process_path="*\\excel.exe" OR process_path="*\\mspub.exe" OR process_path="*\\onenote.exe" OR process_path="*\\onenoteim.exe" OR process_path="*\\outlook.exe" OR process_path="*\\powerpnt.exe" OR process_path="*\\winword.exe") AND (ImageLoaded="*\\VBE7.DLL" OR ImageLoaded="*\\VBEUI.DLL" OR ImageLoaded="*\\VBE7INTL.DLL"))
