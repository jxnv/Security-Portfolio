# Title: Registry Export of Third-Party Credentials
# ID: cc1abf27-78a3-4ac5-a51c-f3070b1d8e40
# Status: experimental
# Level: high
# Author: Swachchhanda Shrawan Poudel (Nextron Systems)
# Date: 2025-05-22
# Tags: attack.credential-access, attack.t1552.002
# Description: Detects the use of reg.exe to export registry paths associated with third-party credentials.
# Credential stealers have been known to use this technique to extract sensitive information from the registry.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="*\\Software\\Aerofox\\Foxmail\\V3.1*" OR process_exec="*\\Software\\Aerofox\\FoxmailPreview*" OR process_exec="*\\Software\\DownloadManager\\Passwords*" OR process_exec="*\\Software\\FTPWare\\COREFTP\\Sites*" OR process_exec="*\\Software\\IncrediMail\\Identities*" OR process_exec="*\\Software\\Martin Prikryl\\WinSCP 2\\Sessions*" OR process_exec="*\\Software\\Mobatek\\MobaXterm*" OR process_exec="*\\Software\\OpenSSH\\Agent\\Keys*" OR process_exec="*\\Software\\OpenVPN-GUI\\configs*" OR process_exec="*\\Software\\ORL\\WinVNC3\\Password*" OR process_exec="*\\Software\\Qualcomm\\Eudora\\CommandLine*" OR process_exec="*\\Software\\RealVNC\\WinVNC4*" OR process_exec="*\\Software\\RimArts\\B2\\Settings*" OR process_exec="*\\Software\\SimonTatham\\PuTTY\\Sessions*" OR process_exec="*\\Software\\SimonTatham\\PuTTY\\SshHostKeys*" OR process_exec="*\\Software\\Sota\\FFFTP*" OR process_exec="*\\Software\\TightVNC\\Server*" OR process_exec="*\\Software\\WOW6432Node\\Radmin\\v3.0\\Server\\Parameters\\Radmin*")) AND ((process_exec="*save*" OR process_exec="*export*")) AND ((process_path="*\\reg.exe") OR (process_name="reg.exe")))
