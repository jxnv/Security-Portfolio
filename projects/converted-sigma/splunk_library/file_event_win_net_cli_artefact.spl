# Title: Suspicious DotNET CLR Usage Log Artifact
# ID: e0b06658-7d1d-4cd3-bf15-03467507ff7c
# Status: test
# Level: high
# Author: frack113, omkar72, oscd.community, Wojciech Lesicki
# Date: 2022-11-18
# Tags: attack.stealth, attack.t1218
# Description: Detects the creation of Usage Log files by the CLR (clr.dll). These files are named after the executing process once the assembly is finished executing for the first time in the (user) session context.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((file_name="*\\UsageLogs\\cmstp.exe.log" OR file_name="*\\UsageLogs\\cscript.exe.log" OR file_name="*\\UsageLogs\\mshta.exe.log" OR file_name="*\\UsageLogs\\msxsl.exe.log" OR file_name="*\\UsageLogs\\regsvr32.exe.log" OR file_name="*\\UsageLogs\\rundll32.exe.log" OR file_name="*\\UsageLogs\\svchost.exe.log" OR file_name="*\\UsageLogs\\wscript.exe.log" OR file_name="*\\UsageLogs\\wmic.exe.log")) AND NOT ((parent_process_path="*\\MsiExec.exe" AND parent_process_exec="* -Embedding*" AND process_path="*\\rundll32.exe" AND (process_exec="*Temp*" AND process_exec="*zzzzInvokeManagedCustomActionOutOfProc*"))))
