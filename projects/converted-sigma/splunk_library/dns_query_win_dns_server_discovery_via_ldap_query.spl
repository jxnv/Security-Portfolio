# Title: DNS Server Discovery Via LDAP Query
# ID: a21bcd7e-38ec-49ad-b69a-9ea17e69509e
# Status: test
# Level: low
# Author: frack113
# Date: 2022-08-20
# Tags: attack.discovery, attack.t1482
# Description: Detects DNS server discovery via LDAP query requests from uncommon applications
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((QueryName="_ldap.*") AND NOT (((process_path="*:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*" AND process_path="*\\MsMpEng.exe") OR ((process_path="*:\\Program Files\\*" OR process_path="*:\\Program Files (x86)\\*" OR process_path="*:\\Windows\\*")) OR (NOT process_path=*) OR (process_path="<unknown process>"))) AND NOT (((process_path="C:\\WindowsAzure\\GuestAgent*") OR ((process_path="*\\chrome.exe" OR process_path="*\\firefox.exe" OR process_path="*\\opera.exe")))))
