# Title: Private Keys Reconnaissance Via CommandLine Tools
# ID: 213d6a77-3d55-4ce8-ba74-fcfef741974e
# Status: test
# Level: medium
# Author: frack113, Nasreddine Bencherchali (Nextron Systems)
# Date: 2021-07-20
# Tags: attack.credential-access, attack.t1552.004
# Description: Adversaries may search for private key certificate files on compromised systems for insecurely stored credential
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="*.key*" OR process_exec="*.pgp*" OR process_exec="*.gpg*" OR process_exec="*.ppk*" OR process_exec="*.p12*" OR process_exec="*.pem*" OR process_exec="*.pfx*" OR process_exec="*.cer*" OR process_exec="*.p7b*" OR process_exec="*.asc*")) AND (((process_exec="*dir *") AND ((process_path="*\\cmd.exe") OR (process_name="Cmd.Exe"))) OR ((process_exec="*Get-ChildItem *") AND (((process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe")) OR ((process_name="PowerShell.EXE" OR process_name="pwsh.dll")))) OR ((process_path="*\\findstr.exe") OR (process_name="FINDSTR.EXE"))))
