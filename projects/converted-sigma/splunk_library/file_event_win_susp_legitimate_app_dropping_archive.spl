# Title: Legitimate Application Dropped Archive
# ID: 654fcc6d-840d-4844-9b07-2c3300e54a26
# Status: test
# Level: high
# Author: frack113, Florian Roth
# Date: 2022-08-21
# Tags: attack.stealth, attack.t1218
# Description: Detects programs on a Windows system that should not write an archive to disk
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((process_path="*\\winword.exe" OR process_path="*\\excel.exe" OR process_path="*\\powerpnt.exe" OR process_path="*\\msaccess.exe" OR process_path="*\\mspub.exe" OR process_path="*\\eqnedt32.exe" OR process_path="*\\visio.exe" OR process_path="*\\wordpad.exe" OR process_path="*\\wordview.exe" OR process_path="*\\certutil.exe" OR process_path="*\\certoc.exe" OR process_path="*\\CertReq.exe" OR process_path="*\\Desktopimgdownldr.exe" OR process_path="*\\esentutl.exe" OR process_path="*\\finger.exe" OR process_path="*\\notepad.exe" OR process_path="*\\AcroRd32.exe" OR process_path="*\\RdrCEF.exe" OR process_path="*\\mshta.exe" OR process_path="*\\hh.exe") AND (file_name="*.zip" OR file_name="*.rar" OR file_name="*.7z" OR file_name="*.diagcab" OR file_name="*.appx"))
