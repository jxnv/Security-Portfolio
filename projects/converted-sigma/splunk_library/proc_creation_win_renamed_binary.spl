# Title: Potential Defense Evasion Via Binary Rename
# ID: 36480ae1-a1cb-4eaa-a0d6-29801d7e9142
# Status: test
# Level: medium
# Author: Matthew Green @mgreen27, Ecco, James Pemberton @4A616D6573, oscd.community, Andreas Hunkeler (@Karneades)
# Date: 2019-06-15
# Tags: attack.stealth, attack.t1036.003
# Description: Detects the execution of a renamed binary often used by attackers or malware leveraging new Sysmon OriginalFileName datapoint.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_name="Cmd.Exe" OR process_name="CONHOST.EXE" OR process_name="7z.exe" OR process_name="7za.exe" OR process_name="7zr.exe" OR process_name="WinRAR.exe" OR process_name="wevtutil.exe" OR process_name="net.exe" OR process_name="net1.exe" OR process_name="netsh.exe" OR process_name="InstallUtil.exe")) AND NOT (((process_path="*\\cmd.exe" OR process_path="*\\conhost.exe" OR process_path="*\\7z.exe" OR process_path="*\\7za.exe" OR process_path="*\\7zr.exe" OR process_path="*\\WinRAR.exe" OR process_path="*\\wevtutil.exe" OR process_path="*\\net.exe" OR process_path="*\\net1.exe" OR process_path="*\\netsh.exe" OR process_path="*\\InstallUtil.exe"))))
