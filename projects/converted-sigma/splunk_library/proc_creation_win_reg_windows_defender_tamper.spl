# Title: Suspicious Windows Defender Registry Key Tampering Via Reg.EXE
# ID: 452bce90-6fb0-43cc-97a5-affc283139b3
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), Swachchhanda Shrawan Poudel, Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-03-22
# Tags: attack.defense-impairment, attack.t1685
# Description: Detects the usage of "reg.exe" to tamper with different Windows Defender registry keys in order to disable some important features related to protection and detection
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((process_path="*\\reg.exe") OR (process_name="reg.exe")) AND ((process_exec="*SOFTWARE\\Microsoft\\Windows Defender\\*" OR process_exec="*SOFTWARE\\Policies\\Microsoft\\Windows Defender Security Center*" OR process_exec="*SOFTWARE\\Policies\\Microsoft\\Windows Defender\\*"))) AND (((process_exec="* add *" AND process_exec="*d 0*") AND (process_exec="*DisallowExploitProtectionOverride*" OR process_exec="*EnableControlledFolderAccess*" OR process_exec="*MpEnablePus*" OR process_exec="*PUAProtection*" OR process_exec="*SpynetReporting*" OR process_exec="*SubmitSamplesConsent*" OR process_exec="*TamperProtection*")) OR ((process_exec="* add *" AND process_exec="*d 1*") AND (process_exec="*DisableAccess*" OR process_exec="*DisableAntiSpyware*" OR process_exec="*DisableAntiSpywareRealtimeProtection*" OR process_exec="*DisableAntiVirus*" OR process_exec="*DisableAntiVirusSignatures*" OR process_exec="*DisableArchiveScanning*" OR process_exec="*DisableBehaviorMonitoring*" OR process_exec="*DisableBlockAtFirstSeen*" OR process_exec="*DisableCloudProtection*" OR process_exec="*DisableConfig*" OR process_exec="*DisableEnhancedNotifications*" OR process_exec="*DisableIntrusionPreventionSystem*" OR process_exec="*DisableIOAVProtection*" OR process_exec="*DisableNetworkProtection*" OR process_exec="*DisableOnAccessProtection*" OR process_exec="*DisablePrivacyMode*" OR process_exec="*DisableRealtimeMonitoring*" OR process_exec="*DisableRoutinelyTakingAction*" OR process_exec="*DisableScanOnRealtimeEnable*" OR process_exec="*DisableScriptScanning*" OR process_exec="*DisableSecurityCenter*" OR process_exec="*Notification_Suppress*" OR process_exec="*SignatureDisableUpdateOnStartupWithoutEngine*"))))
