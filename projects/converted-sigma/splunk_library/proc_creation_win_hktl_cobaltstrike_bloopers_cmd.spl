# Title: Operator Bloopers Cobalt Strike Commands
# ID: 647c7b9e-d784-4fda-b9a0-45c565a7b729
# Status: test
# Level: high
# Author: _pete_0, TheDFIRReport
# Date: 2022-05-06
# Tags: attack.execution, attack.t1059.003, stp.1u
# Description: Detects use of Cobalt Strike commands accidentally entered in the CMD shell
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="cmd *" OR process_exec="cmd.exe*" OR process_exec="c:\\windows\\system32\\cmd.exe*") AND (process_exec="*psinject*" OR process_exec="*spawnas*" OR process_exec="*make_token*" OR process_exec="*remote-exec*" OR process_exec="*rev2self*" OR process_exec="*dcsync*" OR process_exec="*logonpasswords*" OR process_exec="*execute-assembly*" OR process_exec="*getsystem*")) AND ((process_name="Cmd.Exe") OR (process_path="*\\cmd.exe")))
