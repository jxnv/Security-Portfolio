# Title: .RDP File Created By Uncommon Application
# ID: fccfb43e-09a7-4bd2-8b37-a5a7df33386d
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-04-18
# Tags: attack.stealth
# Description: Detects creation of a file with an ".rdp" extension by an application that doesn't commonly create such files.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (file_name="*.rdp" AND (process_path="*\\brave.exe" OR process_path="*\\CCleaner Browser\\Application\\CCleanerBrowser.exe" OR process_path="*\\chromium.exe" OR process_path="*\\firefox.exe" OR process_path="*\\Google\\Chrome\\Application\\chrome.exe" OR process_path="*\\iexplore.exe" OR process_path="*\\microsoftedge.exe" OR process_path="*\\msedge.exe" OR process_path="*\\Opera.exe" OR process_path="*\\Vivaldi.exe" OR process_path="*\\Whale.exe" OR process_path="*\\olk.exe" OR process_path="*\\Outlook.exe" OR process_path="*\\RuntimeBroker.exe" OR process_path="*\\Thunderbird.exe" OR process_path="*\\Discord.exe" OR process_path="*\\Keybase.exe" OR process_path="*\\msteams.exe" OR process_path="*\\Slack.exe" OR process_path="*\\teams.exe"))
