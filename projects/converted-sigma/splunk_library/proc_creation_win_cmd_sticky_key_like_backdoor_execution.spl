# Title: Sticky Key Like Backdoor Execution
# ID: 2fdefcb3-dbda-401e-ae23-f0db027628bc
# Status: test
# Level: critical
# Author: Florian Roth (Nextron Systems), @twjackomo, Jonhnathan Ribeiro, oscd.community
# Date: 2018-03-15
# Tags: attack.privilege-escalation, attack.persistence, attack.t1546.008, car.2014-11-003, car.2014-11-008
# Description: Detects the usage and installation of a backdoor that uses an option to register a malicious debugger for built-in tools that are accessible in the login screen
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (parent_process_path="*\\winlogon.exe" AND (process_path="*\\cmd.exe" OR process_path="*\\cscript.exe" OR process_path="*\\mshta.exe" OR process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe" OR process_path="*\\regsvr32.exe" OR process_path="*\\rundll32.exe" OR process_path="*\\wscript.exe" OR process_path="*\\wt.exe") AND (process_exec="*sethc.exe*" OR process_exec="*utilman.exe*" OR process_exec="*osk.exe*" OR process_exec="*Magnify.exe*" OR process_exec="*Narrator.exe*" OR process_exec="*DisplaySwitch.exe*"))
