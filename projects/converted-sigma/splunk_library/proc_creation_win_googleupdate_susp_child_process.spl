# Title: Potentially Suspicious GoogleUpdate Child Process
# ID: 84b1ecf9-6eff-4004-bafb-bae5c0e251b2
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-05-15
# Tags: attack.stealth
# Description: Detects potentially suspicious child processes of "GoogleUpdate.exe"
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((parent_process_path="*\\GoogleUpdate.exe") AND NOT (((NOT process_path=*) OR ((process_path="*\\Google*") OR ((process_path="*\\setup.exe" OR process_path="*chrome_updater.exe" OR process_path="*chrome_installer.exe"))))))
