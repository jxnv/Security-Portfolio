# Title: VHD Image Download Via Browser
# ID: 8468111a-ef07-4654-903b-b863a80bbc95
# Status: test
# Level: medium
# Author: frack113, Christopher Peacock '@securepeacock', SCYTHE '@scythe_io'
# Date: 2021-10-25
# Tags: attack.resource-development, attack.t1587.001
# Description: Detects creation of ".vhd"/".vhdx" files by browser processes.
# Malware can use mountable Virtual Hard Disk ".vhd" files to encapsulate payloads and evade security controls.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((process_path="*\\brave.exe" OR process_path="*\\chrome.exe" OR process_path="*\\firefox.exe" OR process_path="*\\iexplore.exe" OR process_path="*\\maxthon.exe" OR process_path="*\\MicrosoftEdge.exe" OR process_path="*\\msedge.exe" OR process_path="*\\msedgewebview2.exe" OR process_path="*\\opera.exe" OR process_path="*\\safari.exe" OR process_path="*\\seamonkey.exe" OR process_path="*\\vivaldi.exe" OR process_path="*\\whale.exe") AND file_name="*.vhd*")
