index=* eventtype=wineventlog (((regex process_exec="(?i)\\w+`(?:\\w+|-|.)`[\\w+|\\s]") OR (regex process_exec="(?i)\"(?:\\{\\d\\})+\"\\s*-f") OR (regex process_exec="(?i)(?i)\\$\\{`?e`?n`?v`?:`?p`?a`?t`?h`?\\}")) AND NOT ((process_exec="*${env:path}*")))
