# Title: CredUI.DLL Loaded By Uncommon Process
# ID: 9ae01559-cf7e-4f8e-8e14-4c290a1b4784
# Status: test
# Level: medium
# Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
# Date: 2020-10-20
# Tags: attack.credential-access, attack.collection, attack.t1056.002
# Description: Detects loading of "credui.dll" and related DLLs by an uncommon process. Attackers might leverage this DLL for potential use of "CredUIPromptForCredentials" or "CredUnPackAuthenticationBufferW".
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((ImageLoaded="*\\credui.dll" OR ImageLoaded="*\\wincredui.dll")) OR ((process_name="credui.dll" OR process_name="wincredui.dll"))) AND NOT ((((process_path="C:\\Windows\\explorer.exe" OR process_path="C:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe" OR process_path="C:\\Windows\\regedit.exe")) OR ((process_path="C:\\Program Files (x86)\\*" OR process_path="C:\\Program Files\\*" OR process_path="C:\\Windows\\System32\\*" OR process_path="C:\\Windows\\SysWOW64\\*" OR process_path="C:\\Windows\\SystemApps\\*")))) AND NOT (((process_path="C:\\Users\\*" AND process_path="*\\AppData\\Local\\Microsoft\\OneDrive\\*") OR (process_path="*\\opera_autoupdate.exe") OR ((process_path="*\\procexp64.exe" OR process_path="*\\procexp64a.exe" OR process_path="*\\procexp.exe")) OR (process_path="C:\\Users\\*" AND process_path="*\\AppData\\Local\\Microsoft\\Teams\\*" AND process_path="*\\Teams.exe"))))
