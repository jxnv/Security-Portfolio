# Title: Network Connection Initiated To AzureWebsites.NET By Non-Browser Process
# ID: 5c80b618-0dbb-46e6-acbb-03d90bcb6d83
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2024-06-24
# Tags: attack.command-and-control, attack.t1102, attack.t1102.001
# Description: Detects an initiated network connection by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((Initiated="true" AND DestinationHostname="*azurewebsites.net") AND NOT ((((process_path="C:\\Program Files (x86)\\Avant Browser\\*" OR process_path="C:\\Program Files\\Avant Browser\\*") AND process_path="*\\avant.exe") OR (process_path="C:\\Program Files\\BraveSoftware\\*" AND process_path="*\\brave.exe") OR ((process_path="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR process_path="C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR (process_path="C:\\Users\\*" AND process_path="*\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe") OR ((process_path="*C:\\Program Files\\Windows Defender Advanced Threat Protection\\*" OR process_path="*C:\\Program Files\\Windows Defender\\*" OR process_path="*C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*") AND (process_path="*\\MsMpEng.exe" OR process_path="*\\MsSense.exe")) OR (process_path="*\\AppData\\Local\\Discord\\*" AND process_path="*\\Discord.exe") OR ((process_path="C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*") OR (process_path="*\\WindowsApps\\MicrosoftEdge.exe") OR ((process_path="C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR process_path="C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process_path="C:\\Program Files (x86)\\Microsoft\\EdgeCore\\*" OR process_path="C:\\Program Files\\Microsoft\\EdgeCore\\*") AND (process_path="*\\msedge.exe" OR process_path="*\\msedgewebview2.exe")) OR (process_path="") OR ((process_path="C:\\Program Files\\Falkon\\*" OR process_path="C:\\Program Files (x86)\\Falkon\\*") AND process_path="*\\falkon.exe") OR ((process_path="C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR process_path="C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR (process_path="C:\\Users\\*" AND process_path="*\\AppData\\Local\\Mozilla Firefox\\firefox.exe") OR (process_path="*\\AppData\\Local\\Flock\\*" AND process_path="*\\Flock.exe") OR ((process_path="C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR process_path="C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process_path="*\\AppData\\Local\\Maxthon\\*" AND process_path="*\\maxthon.exe") OR (NOT process_path=*) OR (process_path="*\\AppData\\Local\\Programs\\Opera\\*" AND process_path="*\\opera.exe") OR (process_path="*\\AppData\\Local\\Phoebe\\*" AND process_path="*\\Phoebe.exe") OR ((process_path="*C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe" OR process_path="*C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe")) OR ((process_path="C:\\Program Files (x86)\\QtWeb\\*" OR process_path="C:\\Program Files\\QtWeb\\*") AND process_path="*\\QtWeb.exe") OR ((process_path="*C:\\Program Files (x86)\\Safari\\*" OR process_path="*C:\\Program Files\\Safari\\*") AND process_path="*\\safari.exe") OR ((process_path="C:\\Program Files\\SeaMonkey\\*" OR process_path="C:\\Program Files (x86)\\SeaMonkey\\*") AND process_path="*\\seamonkey.exe") OR ((process_path="C:\\Program Files\\SlimBrowser\\*" OR process_path="C:\\Program Files (x86)\\SlimBrowser\\*") AND process_path="*\\slimbrowser.exe") OR (process_path="*\\AppData\\Local\\Vivaldi\\*" AND process_path="*\\vivaldi.exe") OR ((process_path="C:\\Program Files\\Naver\\Naver Whale\\*" OR process_path="C:\\Program Files (x86)\\Naver\\Naver Whale\\*") AND process_path="*\\whale.exe") OR ((process_path="C:\\Program Files\\Waterfox\\*" OR process_path="C:\\Program Files (x86)\\Waterfox\\*") AND process_path="*\\Waterfox.exe"))))
