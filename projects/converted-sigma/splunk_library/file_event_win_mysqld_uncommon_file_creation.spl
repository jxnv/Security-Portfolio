# Title: Uncommon File Creation By Mysql Daemon Process
# ID: c61daa90-3c1e-4f18-af62-8f288b5c9aaf
# Status: test
# Level: high
# Author: Joseph Kamau
# Date: 2024-05-27
# Tags: attack.stealth
# Description: Detects the creation of files with scripting or executable extensions by Mysql daemon.
# Which could be an indicator of "User Defined Functions" abuse to download malware.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((process_path="*\\mysqld.exe" OR process_path="*\\mysqld-nt.exe") AND (file_name="*.bat" OR file_name="*.dat" OR file_name="*.dll" OR file_name="*.exe" OR file_name="*.ps1" OR file_name="*.psm1" OR file_name="*.vbe" OR file_name="*.vbs"))
