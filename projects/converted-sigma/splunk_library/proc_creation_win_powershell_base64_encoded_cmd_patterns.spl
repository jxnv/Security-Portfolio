# Title: Suspicious PowerShell Encoded Command Patterns
# ID: b9d9cc83-380b-4ba3-8d8f-60c0e7e2930c
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-05-24
# Tags: attack.execution, attack.t1059.001
# Description: Detects PowerShell command line patterns in combincation with encoded commands that often appear in malware infection chains
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((process_exec="* JAB*" OR process_exec="* SUVYI*" OR process_exec="* SQBFAFgA*" OR process_exec="* aWV4I*" OR process_exec="* IAB*" OR process_exec="* PAA*" OR process_exec="* aQBlAHgA*")) AND ((process_exec="* -e *" OR process_exec="* -en *" OR process_exec="* -enc *" OR process_exec="* -enco*")) AND (((process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe")) OR ((process_name="PowerShell.Exe" OR process_name="pwsh.dll")))) AND NOT (((parent_process_path="*C:\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\*" OR parent_process_path="*\\gc_worker.exe*"))))
