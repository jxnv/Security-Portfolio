# Title: Potential PowerShell Obfuscation Via Reversed Commands
# ID: b6b49cd1-34d6-4ead-b1bf-176e9edba9a4
# Status: test
# Level: high
# Author: Teymur Kheirkhabarov (idea), Vasiliy Burov (rule), oscd.community, Tim Shelton
# Date: 2020-10-11
# Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
# Description: Detects the presence of reversed PowerShell commands in the CommandLine. This is often used as a method of obfuscation by attackers
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((process_exec="*hctac*" OR process_exec="*kaerb*" OR process_exec="*dnammoc*" OR process_exec="*ekovn*" OR process_exec="*eliFd*" OR process_exec="*rahc*" OR process_exec="*etirw*" OR process_exec="*golon*" OR process_exec="*tninon*" OR process_exec="*eddih*" OR process_exec="*tpircS*" OR process_exec="*ssecorp*" OR process_exec="*llehsrewop*" OR process_exec="*esnopser*" OR process_exec="*daolnwod*" OR process_exec="*tneilCbeW*" OR process_exec="*tneilc*" OR process_exec="*ptth*" OR process_exec="*elifotevas*" OR process_exec="*46esab*" OR process_exec="*htaPpmeTteG*" OR process_exec="*tcejbO*" OR process_exec="*maerts*" OR process_exec="*hcaerof*" OR process_exec="*retupmoc*")) AND (((process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe")) OR ((process_name="PowerShell.EXE" OR process_name="pwsh.dll")))) AND NOT (((process_exec="* -EncodedCommand *" OR process_exec="* -enc *"))))
