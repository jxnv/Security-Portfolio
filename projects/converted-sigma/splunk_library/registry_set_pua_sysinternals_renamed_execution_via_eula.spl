# Title: Suspicious Execution Of Renamed Sysinternals Tools - Registry
# ID: f50f3c09-557d-492d-81db-9064a8d4e211
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-08-24
# Tags: attack.resource-development, attack.t1588.002
# Description: Detects the creation of the "accepteula" key related to the Sysinternals tools being created from executables with the wrong name (e.g. a renamed Sysinternals tool)
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((registry_key_name="*\\Active Directory Explorer*" OR registry_key_name="*\\Handle*" OR registry_key_name="*\\LiveKd*" OR registry_key_name="*\\ProcDump*" OR registry_key_name="*\\Process Explorer*" OR registry_key_name="*\\PsExec*" OR registry_key_name="*\\PsLoggedon*" OR registry_key_name="*\\PsLoglist*" OR registry_key_name="*\\PsPasswd*" OR registry_key_name="*\\PsPing*" OR registry_key_name="*\\PsService*" OR registry_key_name="*\\SDelete*") AND registry_key_name="*\\EulaAccepted") AND NOT (((process_path="*\\ADExplorer.exe" OR process_path="*\\ADExplorer64.exe" OR process_path="*\\ADExplorer64a.exe" OR process_path="*\\handle.exe" OR process_path="*\\handle64.exe" OR process_path="*\\handle64a.exe" OR process_path="*\\livekd.exe" OR process_path="*\\livekd64.exe" OR process_path="*\\procdump.exe" OR process_path="*\\procdump64.exe" OR process_path="*\\procdump64a.exe" OR process_path="*\\procexp.exe" OR process_path="*\\procexp64.exe" OR process_path="*\\procexp64a.exe" OR process_path="*\\PsExec.exe" OR process_path="*\\PsExec64.exe" OR process_path="*\\PsExec64a.exe" OR process_path="*\\PsLoggedon.exe" OR process_path="*\\PsLoggedon64.exe" OR process_path="*\\psloglist.exe" OR process_path="*\\psloglist64.exe" OR process_path="*\\psloglist64a.exe" OR process_path="*\\pspasswd.exe" OR process_path="*\\pspasswd64.exe" OR process_path="*\\pspasswd64a.exe" OR process_path="*\\PsPing.exe" OR process_path="*\\PsPing64.exe" OR process_path="*\\PsPing64a.exe" OR process_path="*\\PsService.exe" OR process_path="*\\PsService64.exe" OR process_path="*\\PsService64a.exe" OR process_path="*\\sdelete.exe"))))
