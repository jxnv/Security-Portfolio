# Title: PowerShell Base64 Encoded Invoke Keyword
# ID: 6385697e-9f1b-40bd-8817-f4a91f40508e
# Status: test
# Level: high
# Author: pH-T (Nextron Systems), Harjot Singh, @cyb3rjy0t
# Date: 2022-05-20
# Tags: attack.execution, attack.stealth, attack.t1059.001, attack.t1027
# Description: Detects UTF-8 and UTF-16 Base64 encoded powershell 'Invoke-' calls
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((process_exec="* -e*") AND ((process_exec="*SQBuAHYAbwBrAGUALQ*" OR process_exec="*kAbgB2AG8AawBlAC0A*" OR process_exec="*JAG4AdgBvAGsAZQAtA*" OR process_exec="*SW52b2tlL*" OR process_exec="*ludm9rZS*" OR process_exec="*JbnZva2Ut*")) AND (((process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe")) OR ((process_name="PowerShell.EXE" OR process_name="pwsh.dll"))))
