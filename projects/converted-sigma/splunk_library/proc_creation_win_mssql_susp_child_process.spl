# Title: Suspicious Child Process Of SQL Server
# ID: 869b9ca7-9ea2-4a5a-8325-e80e62f75445
# Status: test
# Level: high
# Author: FPT.EagleEye Team, wagga
# Date: 2020-12-11
# Tags: attack.t1505.003, attack.t1190, attack.initial-access, attack.persistence, attack.privilege-escalation
# Description: Detects suspicious child processes of the SQLServer process. This could indicate potential RCE or SQL Injection.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((parent_process_path="*\\sqlservr.exe" AND (process_path="*\\bash.exe" OR process_path="*\\bitsadmin.exe" OR process_path="*\\cmd.exe" OR process_path="*\\netstat.exe" OR process_path="*\\nltest.exe" OR process_path="*\\ping.exe" OR process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe" OR process_path="*\\regsvr32.exe" OR process_path="*\\rundll32.exe" OR process_path="*\\sh.exe" OR process_path="*\\systeminfo.exe" OR process_path="*\\tasklist.exe" OR process_path="*\\wsl.exe")) AND NOT ((parent_process_path="C:\\Program Files\\Microsoft SQL Server\\*" AND parent_process_path="*DATEV_DBENGINE\\MSSQL\\Binn\\sqlservr.exe" AND process_path="C:\\Windows\\System32\\cmd.exe" AND process_exec="\"C:\\Windows\\system32\\cmd.exe\" *")))
