# Title: Potentially Suspicious File Download From ZIP TLD
# ID: 0bb4bbeb-fe52-4044-b40c-430a04577ebe
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2023-05-18
# Tags: attack.stealth
# Description: Detects the download of a file with a potentially suspicious extension from a .zip top level domain.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (Contents="*.zip/*" AND (file_name="*.bat:Zone*" OR file_name="*.dat:Zone*" OR file_name="*.dll:Zone*" OR file_name="*.doc:Zone*" OR file_name="*.docm:Zone*" OR file_name="*.exe:Zone*" OR file_name="*.hta:Zone*" OR file_name="*.pptm:Zone*" OR file_name="*.ps1:Zone*" OR file_name="*.rar:Zone*" OR file_name="*.rtf:Zone*" OR file_name="*.sct:Zone*" OR file_name="*.vbe:Zone*" OR file_name="*.vbs:Zone*" OR file_name="*.ws:Zone*" OR file_name="*.wsf:Zone*" OR file_name="*.xll:Zone*" OR file_name="*.xls:Zone*" OR file_name="*.xlsm:Zone*" OR file_name="*.zip:Zone*"))
