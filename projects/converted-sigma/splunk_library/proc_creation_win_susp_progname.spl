# Title: Suspicious Program Names
# ID: efdd8dd5-cee8-4e59-9390-7d4d5e4dd6f6
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-02-11
# Tags: attack.execution, attack.t1059
# Description: Detects suspicious patterns in program names or folders that are often found in malicious samples or hacktools
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="*inject.ps1*" OR process_exec="*Invoke-CVE*" OR process_exec="*pupy.ps1*" OR process_exec="*payload.ps1*" OR process_exec="*beacon.ps1*" OR process_exec="*PowerView.ps1*" OR process_exec="*bypass.ps1*" OR process_exec="*obfuscated.ps1*" OR process_exec="*obfusc.ps1*" OR process_exec="*obfus.ps1*" OR process_exec="*obfs.ps1*" OR process_exec="*evil.ps1*" OR process_exec="*MiniDogz.ps1*" OR process_exec="*_enc.ps1*" OR process_exec="*\\shell.ps1*" OR process_exec="*\\rshell.ps1*" OR process_exec="*revshell.ps1*" OR process_exec="*\\av.ps1*" OR process_exec="*\\av_test.ps1*" OR process_exec="*adrecon.ps1*" OR process_exec="*mimikatz.ps1*" OR process_exec="*\\PowerUp_*" OR process_exec="*powerup.ps1*" OR process_exec="*\\Temp\\a.ps1*" OR process_exec="*\\Temp\\p.ps1*" OR process_exec="*\\Temp\\1.ps1*" OR process_exec="*Hound.ps1*" OR process_exec="*encode.ps1*" OR process_exec="*powercat.ps1*")) OR (((process_path="*\\CVE-202*" OR process_path="*\\CVE202*")) OR ((process_path="*\\poc.exe" OR process_path="*\\artifact.exe" OR process_path="*\\artifact64.exe" OR process_path="*\\artifact_protected.exe" OR process_path="*\\artifact32.exe" OR process_path="*\\artifact32big.exe" OR process_path="*obfuscated.exe" OR process_path="*obfusc.exe" OR process_path="*\\meterpreter"))))
