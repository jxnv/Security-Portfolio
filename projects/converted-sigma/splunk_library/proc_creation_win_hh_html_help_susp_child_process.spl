# Title: HTML Help HH.EXE Suspicious Child Process
# ID: 52cad028-0ff0-4854-8f67-d25dfcbc78b4
# Status: test
# Level: high
# Author: Maxim Pavlunin, Nasreddine Bencherchali (Nextron Systems)
# Date: 2020-04-01
# Tags: attack.execution, attack.initial-access, attack.stealth, attack.t1047, attack.t1059.001, attack.t1059.003, attack.t1059.005, attack.t1059.007, attack.t1218, attack.t1218.001, attack.t1218.010, attack.t1218.011, attack.t1566, attack.t1566.001
# Description: Detects a suspicious child process of a Microsoft HTML Help (HH.exe)
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (parent_process_path="*\\hh.exe" AND (process_path="*\\CertReq.exe" OR process_path="*\\CertUtil.exe" OR process_path="*\\cmd.exe" OR process_path="*\\cscript.exe" OR process_path="*\\installutil.exe" OR process_path="*\\MSbuild.exe" OR process_path="*\\MSHTA.EXE" OR process_path="*\\msiexec.exe" OR process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe" OR process_path="*\\regsvr32.exe" OR process_path="*\\rundll32.exe" OR process_path="*\\schtasks.exe" OR process_path="*\\wmic.exe" OR process_path="*\\wscript.exe"))
