y_name="*\\Outlook\\Addins\\OutlookChangeNotifier.Connect\\*" OR registry_key_name="*\\Outlook\\Addins\\UCAddin.LyncAddin.1*" OR registry_key_name="*\\Outlook\\Addins\\UCAddin.UCAddin.1*" OR registry_key_name="*\\Outlook\\Addins\\UmOutlookAddin.FormRegionAddin\\*" OR registry_key_name="*AddinTakeNotesService\\FriendlyName*")) OR (NOT Details=*) OR ((process_path="C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\*" OR process_path="C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\*") AND process_path="*\\OfficeClickToRun.exe") OR ((process_path="C:\\Program Files\\Common Files\\Microsoft Shared\\VSTO\\*" OR process_path="C:\\Program Files (x86)\\Microsoft Shared\\VSTO\\*") AND process_path="*\\VSTOInstaller.exe"))) AND NOT ((((process_path="C:\\Program Files\\Avast Software\\Avast\\RegSvr.exe" OR process_path="C:\\Program Files\\Avast Software\\Avast\\x86\\RegSvr.exe") AND registry_key_name="*\\Microsoft\\Office\\Outlook\\Addins\\Avast.AsOutExt\\*") OR ((process_path="C:\\Program Files\\AVG\\Antivirus\\RegSvr.exe" OR process_path="C:\\Program Files\\AVG\\Antivirus\\x86\\RegSvr.exe") AND registry_key_name="*\\Microsoft\\Office\\Outlook\\Addins\\Antivirus.AsOutExt\\*"))))
