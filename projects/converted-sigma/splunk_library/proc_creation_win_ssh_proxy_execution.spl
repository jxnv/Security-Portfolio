# Description: Detect usage of the "ssh.exe" binary as a proxy to launch other programs.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((parent_process_path="C:\\Windows\\System32\\OpenSSH\\sshd.exe") OR (((process_exec="*ProxyCommand=*") OR ((process_exec="*PermitLocalCommand=yes*" AND process_exec="* LocalCommand*"))) AND ((process_path="*\\ssh.exe") OR (Product="OpenSSH for Windows") OR ((file_hash="*IMPHASH=55b4964d29aad5438b9e950052dbbbc0*" OR file_hash="*IMPHASH=334d66c33503ccbf647c15b47c27eef4*" OR file_hash="*IMPHASH=27b0da080ef92afb37983d30d839141e*" OR file_hash="*IMPHASH=977eb4c263d384e47daa0712d34713ab*" OR file_hash="*IMPHASH=3eaadce9ae43d5a918bb082065815c3b*" OR file_hash="*IMPHASH=980fe6cf0d996ab1eedf877222e722aa*" OR file_hash="*IMPHASH=5f959422308ac3d721010d66647e100e*" OR file_hash="*IMPHASH=a49aaa3d03d1cd9c8dc7fca60f7f480b*" OR file_hash="*IMPHASH=dd335f759b6d5d6a8382b71dd9d65791*")))))
