# Title: Suspicious Outlook Child Process
# ID: 208748f7-881d-47ac-a29c-07ea84bf691d
# Status: test
# Level: high
# Author: Michael Haag, Florian Roth (Nextron Systems), Markus Neis, Elastic, FPT.EagleEye Team
# Date: 2022-02-28
# Tags: attack.execution, attack.t1204.002
# Description: Detects a suspicious process spawning from an Outlook process.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (parent_process_path="*\\OUTLOOK.EXE" AND (process_path="*\\AppVLP.exe" OR process_path="*\\bash.exe" OR process_path="*\\cmd.exe" OR process_path="*\\cscript.exe" OR process_path="*\\forfiles.exe" OR process_path="*\\hh.exe" OR process_path="*\\mftrace.exe" OR process_path="*\\msbuild.exe" OR process_path="*\\msdt.exe" OR process_path="*\\mshta.exe" OR process_path="*\\msiexec.exe" OR process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe" OR process_path="*\\regsvr32.exe" OR process_path="*\\schtasks.exe" OR process_path="*\\scrcons.exe" OR process_path="*\\scriptrunner.exe" OR process_path="*\\sh.exe" OR process_path="*\\svchost.exe" OR process_path="*\\wmic.exe" OR process_path="*\\wscript.exe"))
