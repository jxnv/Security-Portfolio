# Title: System File Execution Location Anomaly
# ID: e4a6b256-3e47-40fc-89d2-7a477edd6915
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), Patrick Bareiss, Anton Kutepov, oscd.community, Nasreddine Bencherchali (Nextron Systems)
# Date: 2017-11-27
# Tags: attack.stealth, attack.t1036
# Description: Detects the execution of a Windows system binary that is usually located in the system folder from an uncommon location.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_path="*\\atbroker.exe" OR process_path="*\\audiodg.exe" OR process_path="*\\bcdedit.exe" OR process_path="*\\bitsadmin.exe" OR process_path="*\\certreq.exe" OR process_path="*\\certutil.exe" OR process_path="*\\cmstp.exe" OR process_path="*\\conhost.exe" OR process_path="*\\consent.exe" OR process_path="*\\cscript.exe" OR process_path="*\\csrss.exe" OR process_path="*\\dashost.exe" OR process_path="*\\defrag.exe" OR process_path="*\\dfrgui.exe" OR process_path="*\\dism.exe" OR process_path="*\\dllhost.exe" OR process_path="*\\dllhst3g.exe" OR process_path="*\\dwm.exe" OR process_path="*\\eventvwr.exe" OR process_path="*\\fsquirt.exe" OR process_path="*\\finger.exe" OR process_path="*\\logonui.exe" OR process_path="*\\LsaIso.exe" OR process_path="*\\lsass.exe" OR process_path="*\\lsm.exe" OR process_path="*\\msiexec.exe" OR process_path="*\\ntoskrnl.exe" OR process_path="*\\powershell_ise.exe" OR process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe" OR process_path="*\\regsvr32.exe" OR process_path="*\\rundll32.exe" OR process_path="*\\runonce.exe" OR process_path="*\\RuntimeBroker.exe" OR process_path="*\\schtasks.exe" OR process_path="*\\services.exe" OR process_path="*\\sihost.exe" OR process_path="*\\smartscreen.exe" OR process_path="*\\smss.exe" OR process_path="*\\spoolsv.exe" OR process_path="*\\svchost.exe" OR process_path="*\\taskhost.exe" OR process_path="*\\taskhostw.exe" OR process_path="*\\Taskmgr.exe" OR process_path="*\\userinit.exe" OR process_path="*\\werfault.exe" OR process_path="*\\werfaultsecure.exe" OR process_path="*\\wininit.exe" OR process_path="*\\winlogon.exe" OR process_path="*\\winver.exe" OR process_path="*\\wlanext.exe" OR process_path="*\\wmic.exe" OR process_path="*\\wscript.exe" OR process_path="*\\wsl.exe" OR process_path="*\\wsmprovhost.exe")) AND NOT ((((process_path="C:\\$WINDOWS.~BT\\*" OR process_path="C:\\$WinREAgent\\*" OR process_path="C:\\Windows\\SoftwareDistribution\\*" OR process_path="C:\\Windows\\System32\\*" OR process_path="C:\\Windows\\SystemTemp\\*" OR process_path="C:\\Windows\\SysWOW64\\*" OR process_path="C:\\Windows\\uus\\*" OR process_path="C:\\Windows\\WinSxS\\*")) OR ((process_path="*C:\\Program Files\\PowerShell\\7\\*" OR process_path="*C:\\Program Files\\PowerShell\\7-preview\\*" OR process_path="*C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview*" OR process_path="*\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview*") AND process_path="*\\pwsh.exe") OR (process_path="C:\\Users\\*" AND process_path="*\\AppData\\Local\\Microsoft\\WindowsApps\\*" AND process_path="*\\wsl.exe") OR ((process_path="C:\\Program Files\\WindowsApps\\MicrosoftCorporationII.WindowsSubsystemForLinux*" OR process_path="C:\\Program Files\\WSL\\*") AND process_path="*\\wsl.exe"))) AND NOT ((process_path="*\\SystemRoot\\System32\\*")))
