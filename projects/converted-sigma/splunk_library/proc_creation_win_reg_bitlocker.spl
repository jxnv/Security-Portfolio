# Title: Suspicious Reg Add BitLocker
# ID: 0e0255bf-2548-47b8-9582-c0955c9283f5
# Status: test
# Level: high
# Author: frack113
# Date: 2021-11-15
# Tags: attack.impact, attack.t1486
# Description: Detects suspicious addition to BitLocker related registry keys via the reg.exe utility
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((process_exec="*REG*" AND process_exec="*ADD*" AND process_exec="*\\SOFTWARE\\Policies\\Microsoft\\FVE*" AND process_exec="*/v*" AND process_exec="*/f*") AND (process_exec="*EnableBDEWithNoTPM*" OR process_exec="*UseAdvancedStartup*" OR process_exec="*UseTPM*" OR process_exec="*UseTPMKey*" OR process_exec="*UseTPMKeyPIN*" OR process_exec="*RecoveryKeyMessageSource*" OR process_exec="*UseTPMPIN*" OR process_exec="*RecoveryKeyMessage*"))
