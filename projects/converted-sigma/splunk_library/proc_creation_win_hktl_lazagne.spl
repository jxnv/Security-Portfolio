# Title: HackTool - LaZagne Execution
# ID: c2b86e67-b880-4eec-b045-50bc98ef4844
# Status: experimental
# Level: medium
# Author: Nasreddine Bencherchali, Swachchhanda Shrawan Poudel (Nextron Systems)
# Date: 2024-06-24
# Tags: attack.credential-access
# Description: Detects the execution of the LaZagne. A utility used to retrieve multiple types of passwords stored on a local computer.
# LaZagne has been leveraged multiple times by threat actors in order to dump credentials.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((process_path="*:\\PerfLogs\\*" OR process_path="*:\\ProgramData\\*" OR process_path="*:\\Temp\\*" OR process_path="*:\\Tmp\\*" OR process_path="*:\\Users\\Public\\*" OR process_path="*:\\Windows\\Temp\\*" OR process_path="*\\$Recycle.bin*" OR process_path="*\\AppData\\*" OR process_path="*\\Desktop\\*" OR process_path="*\\Downloads\\*" OR process_path="*\\Favorites\\*" OR process_path="*\\Links\\*" OR process_path="*\\Music\\*" OR process_path="*\\Photos\\*" OR process_path="*\\Pictures\\*" OR process_path="*\\Saved Games\\*" OR process_path="*\\Searches\\*" OR process_path="*\\Users\\Contacts\\*" OR process_path="*\\Users\\Default\\*" OR process_path="*\\Users\\Searches\\*" OR process_path="*\\Videos\\*" OR process_path="*\\Windows\\addins\\*" OR process_path="*\\Windows\\Fonts\\*" OR process_path="*\\Windows\\IME\\*") AND (process_exec="*.exe all" OR process_exec="*.exe browsers" OR process_exec="*.exe chats" OR process_exec="*.exe databases" OR process_exec="*.exe games" OR process_exec="*.exe git" OR process_exec="*.exe mails" OR process_exec="*.exe maven" OR process_exec="*.exe memory" OR process_exec="*.exe multimedia" OR process_exec="*.exe sysadmin" OR process_exec="*.exe unused" OR process_exec="*.exe wifi" OR process_exec="*.exe windows")) OR (process_path="*\\lazagne.exe")) OR (((process_exec="* all *" OR process_exec="* browsers *" OR process_exec="* chats *" OR process_exec="* databases *" OR process_exec="* games *" OR process_exec="* mails *" OR process_exec="* maven *" OR process_exec="* memory *" OR process_exec="* multimedia *" OR process_exec="* php *" OR process_exec="* svn *" OR process_exec="* sysadmin *" OR process_exec="* unused *" OR process_exec="* wifi *")) AND ((process_exec="*-1Password*" OR process_exec="*-apachedirectorystudio*" OR process_exec="*-autologon*" OR process_exec="*-ChromiumBased*" OR process_exec="*-coreftp*" OR process_exec="*-credfiles*" OR process_exec="*-credman*" OR process_exec="*-cyberduck*" OR process_exec="*-dbvis*" OR process_exec="*-EyeCon*" OR process_exec="*-filezilla*" OR process_exec="*-filezillaserver*" OR process_exec="*-ftpnavigator*" OR process_exec="*-galconfusion*" OR process_exec="*-gitforwindows*" OR process_exec="*-hashdump*" OR process_exec="*-iisapppool*" OR process_exec="*-IISCentralCertP*" OR process_exec="*-kalypsomedia*" OR process_exec="*-keepass*" OR process_exec="*-keepassconfig*" OR process_exec="*-lsa_secrets*" OR process_exec="*-mavenrepositories*" OR process_exec="*-memory_dump*" OR process_exec="*-Mozilla*" OR process_exec="*-mRemoteNG*" OR process_exec="*-mscache*" OR process_exec="*-opensshforwindows*" OR process_exec="*-openvpn*" OR process_exec="*-outlook*" OR process_exec="*-pidgin*" OR process_exec="*-postgresql*" OR process_exec="*-psi-im*" OR process_exec="*-puttycm*" OR process_exec="*-pypykatz*" OR process_exec="*-Rclone*" OR process_exec="*-rdpmanager*" OR process_exec="*-robomongo*" OR process_exec="*-roguestale*" OR process_exec="*-skype*" OR process_exec="*-SQLDeveloper*" OR process_exec="*-squirrel*" OR process_exec="*-tortoise*" OR process_exec="*-turba*" OR process_exec="*-UCBrowser*" OR process_exec="*-unattended*" OR process_exec="*-vault*" OR process_exec="*-vaultfiles*" OR process_exec="*-vnc*" OR process_exec="*-winscp*"))))
