# Title: Potential Recon Activity Via Nltest.EXE
# ID: 5cc90652-4cbd-4241-aa3b-4b462fa5a248
# Status: test
# Level: medium
# Author: Craig Young, oscd.community, Georg Lauenstein
# Date: 2021-07-24
# Tags: attack.discovery, attack.t1016, attack.t1482
# Description: Detects nltest commands that can be used for information discovery
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_path="*\\nltest.exe") OR (process_name="nltestrk.exe")) AND (((process_exec="*server*" AND process_exec="*query*")) OR ((process_exec="*/user*" OR process_exec="*all_trusts*" OR process_exec="*dclist:*" OR process_exec="*dnsgetdc:*" OR process_exec="*domain_trusts*" OR process_exec="*dsgetdc:*" OR process_exec="*parentdomain*" OR process_exec="*trusted_domains*"))))
