# Title: Suspicious Child Process Of Wermgr.EXE
# ID: 396f6630-f3ac-44e3-bfc8-1b161bc00c4e
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-10-14
# Tags: attack.privilege-escalation, attack.stealth, attack.t1055, attack.t1036
# Description: Detects suspicious Windows Error Reporting manager (wermgr.exe) child process
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((parent_process_path="*\\wermgr.exe" AND (process_path="*\\cmd.exe" OR process_path="*\\cscript.exe" OR process_path="*\\ipconfig.exe" OR process_path="*\\mshta.exe" OR process_path="*\\net.exe" OR process_path="*\\net1.exe" OR process_path="*\\netstat.exe" OR process_path="*\\nslookup.exe" OR process_path="*\\powershell_ise.exe" OR process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe" OR process_path="*\\regsvr32.exe" OR process_path="*\\rundll32.exe" OR process_path="*\\systeminfo.exe" OR process_path="*\\whoami.exe" OR process_path="*\\wscript.exe")) AND NOT ((process_path="*\\rundll32.exe" AND (process_exec="*C:\\Windows\\system32\\WerConCpl.dll*" AND process_exec="*LaunchErcApp *") AND (process_exec="*-queuereporting*" OR process_exec="*-responsepester*"))))
