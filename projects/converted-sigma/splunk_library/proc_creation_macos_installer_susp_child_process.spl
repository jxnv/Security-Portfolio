# Title: Suspicious Installer Package Child Process
# ID: e0cfaecd-602d-41af-988d-f6ccebb2af26
# Status: test
# Level: medium
# Author: Sohan G (D4rkCiph3r)
# Date: 2023-02-18
# Tags: attack.t1059, attack.t1059.007, attack.t1071, attack.t1071.001, attack.execution, attack.command-and-control
# Description: Detects the execution of suspicious child processes from macOS installer package parent process. This includes osascript, JXA, curl and wget amongst other interpreters
# Converted by: Sigma Universal SIEM/EDR CLI

index=* ((parent_process_path="*/package_script_service" OR parent_process_path="*/installer") AND (process_path="*/sh" OR process_path="*/bash" OR process_path="*/dash" OR process_path="*/python" OR process_path="*/ruby" OR process_path="*/perl" OR process_path="*/php" OR process_path="*/javascript" OR process_path="*/osascript" OR process_path="*/tclsh" OR process_path="*/curl" OR process_path="*/wget") AND (process_exec="*preinstall*" OR process_exec="*postinstall*"))
