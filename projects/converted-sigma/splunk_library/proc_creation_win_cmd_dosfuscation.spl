# Tags: attack.execution, attack.t1059
# Description: Detects possible payload obfuscation via the commandline
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((process_exec="*^^*" OR process_exec="*^|^*" OR process_exec="*,;,*" OR process_exec="*;;;;*" OR process_exec="*;; ;;*" OR process_exec="*(,(,*" OR process_exec="*%COMSPEC:~*" OR process_exec="* c^m^d*" OR process_exec="*^c^m^d*" OR process_exec="* c^md*" OR process_exec="* cm^d*" OR process_exec="*^cm^d*" OR process_exec="* s^et *" OR process_exec="* s^e^t *" OR process_exec="* se^t *"))
