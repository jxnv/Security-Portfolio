# Title: HackTool - SharPersist Execution
# ID: 26488ad0-f9fd-4536-876f-52fea846a2e4
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-09-15
# Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053
# Description: Detects the execution of the hacktool SharPersist - used to deploy various different kinds of persistence mechanisms
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="* -t schtask -c *" OR process_exec="* -t startupfolder -c *")) OR ((process_exec="* -t reg -c *" AND process_exec="* -m add*")) OR ((process_exec="* -t service -c *" AND process_exec="* -m add*")) OR ((process_exec="* -t schtask -c *" AND process_exec="* -m add*")) OR ((process_path="*\\SharPersist.exe") OR (Product="SharPersist")))
