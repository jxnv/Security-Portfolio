# Title: Webshell Detection With Command Line Keywords
# ID: bed2a484-9348-4143-8a8a-b801c979301c
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), Jonhnathan Ribeiro, Anton Kutepov, oscd.community, Chad Hudson, Matt Anderson
# Date: 2017-01-01
# Tags: attack.persistence, attack.discovery, attack.t1505.003, attack.t1018, attack.t1033, attack.t1087
# Description: Detects certain command line parameters often used during reconnaissance activity via web shells
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((parent_process_path="*\\java.exe" OR parent_process_path="*\\javaw.exe") AND (parent_process_path="*-tomcat-*" OR parent_process_path="*\\tomcat*")) OR ((parent_process_path="*\\java.exe" OR parent_process_path="*\\javaw.exe") AND (process_exec="*catalina.jar*" OR process_exec="*CATALINA_HOME*")) OR ((parent_process_path="*\\w3wp.exe" OR parent_process_path="*\\php-cgi.exe" OR parent_process_path="*\\nginx.exe" OR parent_process_path="*\\httpd.exe" OR parent_process_path="*\\caddy.exe" OR parent_process_path="*\\ws_tomcatservice.exe"))) AND (((process_exec="*&cd&echo*" OR process_exec="*cd /d *")) OR (((process_path="*\\dsquery.exe" OR process_path="*\\find.exe" OR process_path="*\\findstr.exe" OR process_path="*\\ipconfig.exe" OR process_path="*\\netstat.exe" OR process_path="*\\nslookup.exe" OR process_path="*\\pathping.exe" OR process_path="*\\quser.exe" OR process_path="*\\schtasks.exe" OR process_path="*\\systeminfo.exe" OR process_path="*\\tasklist.exe" OR process_path="*\\tracert.exe" OR process_path="*\\wevtutil.exe" OR process_path="*\\whoami.exe")) OR ((process_name="dsquery.exe" OR process_name="find.exe" OR process_name="findstr.exe" OR process_name="ipconfig.exe" OR process_name="netstat.exe" OR process_name="nslookup.exe" OR process_name="pathping.exe" OR process_name="quser.exe" OR process_name="schtasks.exe" OR process_name="sysinfo.exe" OR process_name="tasklist.exe" OR process_name="tracert.exe" OR process_name="VSSADMIN.EXE" OR process_name="wevtutil.exe" OR process_name="whoami.exe"))) OR ((process_exec="* Test-NetConnection *" OR process_exec="*dir \\*")) OR ((process_name="net.exe" OR process_name="net1.exe") AND (process_exec="* user *" OR process_exec="* use *" OR process_exec="* group *")) OR (process_name="ping.exe" AND process_exec="* -n *") OR ((process_path="*\\cmd.exe" OR process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe") AND (process_exec="* -enc *" OR process_exec="* -EncodedCommand *" OR process_exec="* -w hidden *" OR process_exec="* -windowstyle hidden*" OR process_exec="*.WebClient).Download*")) OR (process_name="wmic.exe" AND process_exec="* /node:*")))
