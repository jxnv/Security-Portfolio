# Title: Syslog Clearing or Removal Via System Utilities
# ID: 3fcc9b35-39e4-44c0-a2ad-9e82b6902b31
# Status: test
# Level: high
# Author: Max Altgelt (Nextron Systems), Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research), MSTIC
# Date: 2021-10-15
# Tags: attack.defense-impairment, attack.t1685.006
# Description: Detects specific commands commonly used to remove or empty the syslog. Which is a technique often used by attacker as a method to hide their tracks
# Converted by: Sigma Universal SIEM/EDR CLI

index=* sourcetype="syslog" (((process_exec="*/var/log/syslog*") AND ((process_path="*/cp" AND process_exec="*/dev/null*") OR (process_path="*/ln" AND (process_exec="*/dev/null *" AND process_exec="*/var/log/syslog*") AND (process_exec="*-sf *" OR process_exec="*-sfn *" OR process_exec="*-sfT *")) OR (process_path="*/mv") OR (process_path="*/rm" AND (process_exec="* -r *" OR process_exec="* -f *" OR process_exec="* -rf *" OR process_exec="*/var/log/syslog*")) OR (process_path="*/shred" AND process_exec="*-u *") OR (process_path="*/truncate" AND (process_exec="*0 *" AND process_exec="*/var/log/syslog*") AND (process_exec="*-s *" OR process_exec="*-c *" OR process_exec="*--size*")) OR (process_path="*/unlink"))) OR (((process_exec="*journalctl --vacuum*" OR process_exec="*journalctl --rotate*")) OR ((process_exec="* > /var/log/syslog*" OR process_exec="* >/var/log/syslog*" OR process_exec="* >| /var/log/syslog*" OR process_exec="*: > /var/log/syslog*" OR process_exec="*:> /var/log/syslog*" OR process_exec="*:>/var/log/syslog*" OR process_exec="*>|/var/log/syslog*"))))
