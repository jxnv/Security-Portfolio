# Title: Reg Add Suspicious Paths
# ID: b7e2a8d4-74bb-4b78-adc9-3f92af2d4829
# Status: test
# Level: high
# Author: frack113, Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-08-19
# Tags: attack.persistence, attack.defense-impairment, attack.t1112, attack.t1685
# Description: Detects when an adversary uses the reg.exe utility to add or modify new keys or subkeys
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="*\\AppDataLow\\Software\\Microsoft\\*" OR process_exec="*\\Policies\\Microsoft\\Windows\\OOBE*" OR process_exec="*\\Policies\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon*" OR process_exec="*\\SOFTWARE\\Microsoft\\Windows NT\\Currentversion\\Winlogon*" OR process_exec="*\\CurrentControlSet\\Control\\SecurityProviders\\WDigest*" OR process_exec="*\\Microsoft\\Windows Defender\\*")) AND ((process_path="*\\reg.exe") OR (process_name="reg.exe")))
