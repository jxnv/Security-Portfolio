# Title: Suspicious File Download From File Sharing Domain Via Curl.EXE
# ID: 56454143-524f-49fb-b1c6-3fb8b1ad41fb
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-05-05
# Tags: attack.execution
# Description: Detects potentially suspicious file download from file sharing domains using curl.exe
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="*.ps1" OR process_exec="*.ps1'" OR process_exec="*.ps1\"" OR process_exec="*.dat" OR process_exec="*.dat'" OR process_exec="*.dat\"" OR process_exec="*.msi" OR process_exec="*.msi'" OR process_exec="*.msi\"" OR process_exec="*.bat" OR process_exec="*.bat'" OR process_exec="*.bat\"" OR process_exec="*.exe" OR process_exec="*.exe'" OR process_exec="*.exe\"" OR process_exec="*.vbs" OR process_exec="*.vbs'" OR process_exec="*.vbs\"" OR process_exec="*.vbe" OR process_exec="*.vbe'" OR process_exec="*.vbe\"" OR process_exec="*.hta" OR process_exec="*.hta'" OR process_exec="*.hta\"" OR process_exec="*.dll" OR process_exec="*.dll'" OR process_exec="*.dll\"" OR process_exec="*.psm1" OR process_exec="*.psm1'" OR process_exec="*.psm1\"")) AND ((process_exec="* -O*" OR process_exec="*--remote-name*" OR process_exec="*--output*")) AND (process_exec="*http*") AND ((process_path="*\\curl.exe") OR (process_name="curl.exe")) AND ((process_exec="*.githubusercontent.com*" OR process_exec="*0x0.st*" OR process_exec="*anonfiles.com*" OR process_exec="*bashupload.com*" OR process_exec="*cdn.discordapp.com*" OR process_exec="*chunk.io*" OR process_exec="*ddns.net*" OR process_exec="*dl.dropboxusercontent.com*" OR process_exec="*ghostbin.co*" OR process_exec="*github.com*" OR process_exec="*glitch.me*" OR process_exec="*gofile.io*" OR process_exec="*hastebin.com*" OR process_exec="*mediafire.com*" OR process_exec="*mega.nz*" OR process_exec="*onrender.com*" OR process_exec="*pages.dev*" OR process_exec="*paste.ee*" OR process_exec="*pastebin.com*" OR process_exec="*pastebin.pl*" OR process_exec="*pastetext.net*" OR process_exec="*pixeldrain.com*" OR process_exec="*privatlab.com*" OR process_exec="*privatlab.net*" OR process_exec="*send.exploit.in*" OR process_exec="*sendspace.com*" OR process_exec="*storage.googleapis.com*" OR process_exec="*storjshare.io*" OR process_exec="*supabase.co*" OR process_exec="*temp.sh*" OR process_exec="*transfer.sh*" OR process_exec="*trycloudflare.com*" OR process_exec="*ufile.io*" OR process_exec="*w3spaces.com*" OR process_exec="*workers.dev*" OR process_exec="*x0.at*")))
