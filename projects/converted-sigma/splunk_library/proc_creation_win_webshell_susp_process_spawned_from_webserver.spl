# Title: Suspicious Process By Web Server Process
# ID: 8202070f-edeb-4d31-a010-a26c72ac5600
# Status: test
# Level: high
# Author: Thomas Patzke, Florian Roth (Nextron Systems), Zach Stanford @svch0st, Tim Shelton, Nasreddine Bencherchali (Nextron Systems)
# Date: 2019-01-16
# Tags: attack.persistence, attack.initial-access, attack.t1505.003, attack.t1190
# Description: Detects potentially suspicious processes being spawned by a web server process which could be the result of a successfully placed web shell or exploitation
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((parent_process_path="*\\java.exe" OR parent_process_path="*\\javaw.exe") AND (parent_process_path="*-tomcat-*" OR parent_process_path="*\\tomcat*")) OR ((parent_process_path="*\\java.exe" OR parent_process_path="*\\javaw.exe") AND (parent_process_exec="*CATALINA_HOME*" OR parent_process_exec="*catalina.home*" OR parent_process_exec="*catalina.jar*")) OR ((parent_process_path="*\\caddy.exe" OR parent_process_path="*\\httpd.exe" OR parent_process_path="*\\nginx.exe" OR parent_process_path="*\\php-cgi.exe" OR parent_process_path="*\\php.exe" OR parent_process_path="*\\tomcat.exe" OR parent_process_path="*\\UMWorkerProcess.exe" OR parent_process_path="*\\w3wp.exe" OR parent_process_path="*\\ws_TomcatService.exe"))) AND ((process_path="*\\arp.exe" OR process_path="*\\at.exe" OR process_path="*\\bash.exe" OR process_path="*\\bitsadmin.exe" OR process_path="*\\certutil.exe" OR process_path="*\\cmd.exe" OR process_path="*\\cscript.exe" OR process_path="*\\dsget.exe" OR process_path="*\\hostname.exe" OR process_path="*\\nbtstat.exe" OR process_path="*\\net.exe" OR process_path="*\\net1.exe" OR process_path="*\\netdom.exe" OR process_path="*\\netsh.exe" OR process_path="*\\nltest.exe" OR process_path="*\\ntdsutil.exe" OR process_path="*\\powershell_ise.exe" OR process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe" OR process_path="*\\qprocess.exe" OR process_path="*\\query.exe" OR process_path="*\\qwinsta.exe" OR process_path="*\\reg.exe" OR process_path="*\\rundll32.exe" OR process_path="*\\sc.exe" OR process_path="*\\sh.exe" OR process_path="*\\wmic.exe" OR process_path="*\\wscript.exe" OR process_path="*\\wusa.exe")) AND NOT (((parent_process_path="*\\java.exe" AND process_exec="*Windows\\system32\\cmd.exe /c C:\\ManageEngine\\ADManager \"Plus\\ES\\bin\\elasticsearch.bat -Enode.name=RMP-NODE1 -pelasticsearch-pid.txt") OR (parent_process_path="*\\java.exe" AND (process_exec="*sc query*" AND process_exec="*ADManager Plus*")))))
