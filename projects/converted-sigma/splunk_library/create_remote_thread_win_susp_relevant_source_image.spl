# Description: Detects uncommon processes creating remote threads.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((source_process_path="*\\bash.exe" OR source_process_path="*\\cscript.exe" OR source_process_path="*\\cvtres.exe" OR source_process_path="*\\defrag.exe" OR source_process_path="*\\dialer.exe" OR source_process_path="*\\dnx.exe" OR source_process_path="*\\esentutl.exe" OR source_process_path="*\\excel.exe" OR source_process_path="*\\expand.exe" OR source_process_path="*\\find.exe" OR source_process_path="*\\findstr.exe" OR source_process_path="*\\forfiles.exe" OR source_process_path="*\\gpupdate.exe" OR source_process_path="*\\hh.exe" OR source_process_path="*\\installutil.exe" OR source_process_path="*\\lync.exe" OR source_process_path="*\\makecab.exe" OR source_process_path="*\\mDNSResponder.exe" OR source_process_path="*\\monitoringhost.exe" OR source_process_path="*\\msbuild.exe" OR source_process_path="*\\mshta.exe" OR source_process_path="*\\mspaint.exe" OR source_process_path="*\\outlook.exe" OR source_process_path="*\\ping.exe" OR source_process_path="*\\provtool.exe" OR source_process_path="*\\python.exe" OR source_process_path="*\\regsvr32.exe" OR source_process_path="*\\robocopy.exe" OR source_process_path="*\\runonce.exe" OR source_process_path="*\\sapcimc.exe" OR source_process_path="*\\smartscreen.exe" OR source_process_path="*\\spoolsv.exe" OR source_process_path="*\\tstheme.exe" OR source_process_path="*\\userinit.exe" OR source_process_path="*\\vssadmin.exe" OR source_process_path="*\\vssvc.exe" OR source_process_path="*\\w3wp.exe" OR source_process_path="*\\winscp.exe" OR source_process_path="*\\winword.exe" OR source_process_path="*\\wmic.exe" OR source_process_path="*\\wscript.exe")) AND NOT ((((source_process_path="C:\\Windows\\System32\\Defrag.exe" OR source_process_path="C:\\Windows\\System32\\makecab.exe") AND target_process_path="C:\\Windows\\System32\\conhost.exe") OR ((source_process_path="C:\\Program Files\\Microsoft Office\\*" OR source_process_path="C:\\Program Files (x86)\\Microsoft Office\\*") AND target_process_path="System") OR (source_process_path="C:\\Windows\\System32\\provtool.exe" AND target_process_path="C:\\Windows\\System32\\svchost.exe") OR (source_process_path="C:\\Windows\\System32\\provtool.exe" AND target_process_path="System") OR (source_process_path="C:\\Windows\\System32\\userinit.exe" AND target_process_path="C:\\Windows\\explorer.exe") OR (source_process_path="*\\WINWORD.EXE" AND (target_process_path="C:\\Program Files (x86)\\*" OR target_process_path="C:\\Program Files\\*")))) AND NOT ((source_process_path="*\\SysWOW64\\explorer.exe" AND (target_process_path="C:\\Program Files (x86)\\VMware\\VMware Tools\\vmtoolsd.exe" OR target_process_path="C:\\Program Files\\VMware\\VMware Tools\\vmtoolsd.exe"))))
