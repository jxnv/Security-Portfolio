(((CommandLine CONTAIN "/generic:Microsoft_Windows_Shell_ZipFolder:filename=" AND CommandLine CONTAIN ".zip" AND CommandLine CONTAIN "/pass:" AND CommandLine CONTAIN "/user:")) OR ((CommandLine CONTAIN "/delete" AND CommandLine CONTAIN "Microsoft_Windows_Shell_ZipFolder:filename=" AND CommandLine CONTAIN ".zip")))
