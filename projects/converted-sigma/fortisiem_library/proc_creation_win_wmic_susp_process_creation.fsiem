# Title: Suspicious Process Created Via Wmic.EXE
# ID: 3c89a1e8-0fba-449e-8f1b-8409d6267ec8
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
# Date: 2020-10-12
# Tags: attack.execution, attack.t1047
# Description: Detects WMIC executing "process call create" with suspicious calls to processes such as "rundll32", "regsrv32", etc.
# Converted by: Sigma Universal SIEM/EDR CLI

((CommandLine CONTAIN "process " AND CommandLine CONTAIN "call " AND CommandLine CONTAIN "create ") AND (CommandLine CONTAIN "rundll32" OR CommandLine CONTAIN "bitsadmin" OR CommandLine CONTAIN "regsvr32" OR CommandLine CONTAIN "cmd.exe /c " OR CommandLine CONTAIN "cmd.exe /k " OR CommandLine CONTAIN "cmd.exe /r " OR CommandLine CONTAIN "cmd /c " OR CommandLine CONTAIN "cmd /k " OR CommandLine CONTAIN "cmd /r " OR CommandLine CONTAIN "powershell" OR CommandLine CONTAIN "pwsh" OR CommandLine CONTAIN "certutil" OR CommandLine CONTAIN "cscript" OR CommandLine CONTAIN "wscript" OR CommandLine CONTAIN "mshta" OR CommandLine CONTAIN "\\Users\\Public\\" OR CommandLine CONTAIN "\\Windows\\Temp\\" OR CommandLine CONTAIN "\\AppData\\Local\\" OR CommandLine CONTAIN "%temp%" OR CommandLine CONTAIN "%tmp%" OR CommandLine CONTAIN "%ProgramData%" OR CommandLine CONTAIN "%appdata%" OR CommandLine CONTAIN "%comspec%" OR CommandLine CONTAIN "%localappdata%"))
