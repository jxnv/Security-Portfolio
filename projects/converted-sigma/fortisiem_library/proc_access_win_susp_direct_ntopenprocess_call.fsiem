# Title: Potential Direct Syscall of NtOpenProcess
# ID: 3f3f3506-1895-401b-9cc3-e86b16e630d0
# Status: test
# Level: medium
# Author: Christian Burkard (Nextron Systems), Tim Shelton (FP)
# Date: 2021-07-28
# Tags: attack.execution, attack.t1106
# Description: Detects potential calls to NtOpenProcess directly from NTDLL.
# Converted by: Sigma Universal SIEM/EDR CLI

((CallTrace="UNKNOWN*") AND NOT ((((SourceImage CONTAIN ":\\Program Files (x86)\\" OR SourceImage CONTAIN ":\\Program Files\\" OR SourceImage CONTAIN ":\\Windows\\System32\\" OR SourceImage CONTAIN ":\\Windows\\SysWOW64\\" OR SourceImage CONTAIN ":\\Windows\\WinSxS\\") AND (TargetImage CONTAIN ":\\Program Files (x86)\\" OR TargetImage CONTAIN ":\\Program Files\\" OR TargetImage CONTAIN ":\\Windows\\System32\\" OR TargetImage CONTAIN ":\\Windows\\SysWOW64\\" OR TargetImage CONTAIN ":\\Windows\\WinSxS\\")) OR (Provider_Name = "Microsoft-Windows-Kernel-Audit-API-Calls") OR (TargetImage="*vcredist_x64.exe" AND SourceImage="*vcredist_x64.exe"))) AND NOT (((SourceImage CONTAIN ":\\Program Files\\Adobe\\Acrobat DC\\Acrobat\\" AND SourceImage="*\\AcroCEF.exe" AND TargetImage CONTAIN ":\\Program Files\\Adobe\\Acrobat DC\\Acrobat\\" AND TargetImage="*\\AcroCEF.exe") OR (SourceImage="*AmazonSSMAgentSetup.exe" AND TargetImage="*AmazonSSMAgentSetup.exe") OR (SourceImage="*:\\Windows\\Explorer.EXE" AND TargetImage="*:\\Program Files\\Cylance\\Desktop\\CylanceUI.exe") OR (TargetImage CONTAIN "\\AppData\\Local\\Discord\\" AND TargetImage="*\\Discord.exe") OR (TargetImage="*\\Evernote\\Evernote.exe") OR (TargetImage="*\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe" AND SourceImage="*\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe") OR (TargetImage="*:\\Windows\\system32\\systeminfo.exe" AND SourceImage="*setup64.exe") OR (SourceImage="*\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe" AND TargetImage="*\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe") OR (SourceImage CONTAIN "\\AppData\\Local\\yammerdesktop\\app-" AND SourceImage="*\\Yammer.exe" AND TargetImage CONTAIN "\\AppData\\Local\\yammerdesktop\\app-" AND TargetImage="*\\Yammer.exe" AND GrantedAccess = "0x1000"))))
