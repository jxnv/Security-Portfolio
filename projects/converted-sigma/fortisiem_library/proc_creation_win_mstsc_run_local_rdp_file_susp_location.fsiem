# Title: Suspicious Mstsc.EXE Execution With Local RDP File
# ID: 6e22722b-dfb1-4508-a911-49ac840b40f8
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-04-18
# Tags: attack.command-and-control, attack.t1219.002
# Description: Detects potential RDP connection via Mstsc using a local ".rdp" file located in suspicious locations.
# Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine="*.rdp" OR CommandLine="*.rdp\"")) AND ((Image="*\\mstsc.exe") OR (OriginalFileName = "mstsc.exe")) AND ((CommandLine CONTAIN ":\\Users\\Public\\" OR CommandLine CONTAIN ":\\Windows\\System32\\spool\\drivers\\color" OR CommandLine CONTAIN ":\\Windows\\System32\\Tasks_Migrated " OR CommandLine CONTAIN ":\\Windows\\Tasks\\" OR CommandLine CONTAIN ":\\Windows\\Temp\\" OR CommandLine CONTAIN ":\\Windows\\Tracing\\" OR CommandLine CONTAIN "\\AppData\\Local\\Temp\\" OR CommandLine CONTAIN "\\Downloads\\")))
