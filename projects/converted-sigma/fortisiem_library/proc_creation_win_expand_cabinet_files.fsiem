# Title: Potentially Suspicious Cabinet File Expansion
# ID: 9f107a84-532c-41af-b005-8d12a607639f
# Status: test
# Level: medium
# Author: Bhabesh Raj, X__Junior (Nextron Systems)
# Date: 2021-07-30
# Tags: attack.stealth, attack.t1218
# Description: Detects the expansion or decompression of cabinet files from potentially suspicious or uncommon locations, e.g. seen in Iranian MeteorExpress related attacks
# Converted by: Sigma Universal SIEM/EDR CLI

((Image="*\\expand.exe" AND (CommandLine CONTAIN "-F:" OR CommandLine CONTAIN "/F:")) AND (((CommandLine CONTAIN ":\\Perflogs\\" OR CommandLine CONTAIN ":\\ProgramData" OR CommandLine CONTAIN ":\\Users\\Public\\" OR CommandLine CONTAIN ":\\Windows\\Temp\\" OR CommandLine CONTAIN "\\Admin$\\" OR CommandLine CONTAIN "\\AppData\\Local\\Temp\\" OR CommandLine CONTAIN "\\AppData\\Roaming\\" OR CommandLine CONTAIN "\\C$\\" OR CommandLine CONTAIN "\\Temporary Internet")) OR (((CommandLine CONTAIN ":\\Users\\" AND CommandLine CONTAIN "\\Favorites\\")) OR ((CommandLine CONTAIN ":\\Users\\" AND CommandLine CONTAIN "\\Favourites\\")) OR ((CommandLine CONTAIN ":\\Users\\" AND CommandLine CONTAIN "\\Contacts\\")))) AND NOT ((ParentImage = "C:\\Program Files (x86)\\Dell\\UpdateService\\ServiceShell.exe" AND CommandLine CONTAIN "C:\\ProgramData\\Dell\\UpdateService\\Temp\\")))
