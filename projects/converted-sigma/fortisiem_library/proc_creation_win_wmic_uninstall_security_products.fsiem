# Title: Potential Tampering With Security Products Via WMIC
# ID: 847d5ff3-8a31-4737-a970-aeae8fe21765
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
# Date: 2021-01-30
# Tags: attack.defense-impairment, attack.t1685
# Description: Detects uninstallation or termination of security products using the WMIC utility
# Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine CONTAIN "wmic" AND CommandLine CONTAIN "product " AND CommandLine CONTAIN "uninstall") AND (CommandLine CONTAIN "/nointeractive" OR CommandLine CONTAIN "-nointeractive")) OR ((CommandLine CONTAIN "wmic" AND CommandLine CONTAIN "caption like ") AND (CommandLine CONTAIN "call delete" OR CommandLine CONTAIN "call terminate")) OR ((CommandLine CONTAIN "process " AND CommandLine CONTAIN "where " AND CommandLine CONTAIN "delete"))) AND ((CommandLine CONTAIN "%carbon%" OR CommandLine CONTAIN "%cylance%" OR CommandLine CONTAIN "%endpoint%" OR CommandLine CONTAIN "%eset%" OR CommandLine CONTAIN "%malware%" OR CommandLine CONTAIN "%Sophos%" OR CommandLine CONTAIN "%symantec%" OR CommandLine CONTAIN "Antivirus" OR CommandLine CONTAIN "AVG " OR CommandLine CONTAIN "Carbon Black" OR CommandLine CONTAIN "CarbonBlack" OR CommandLine CONTAIN "Cb Defense Sensor 64-bit" OR CommandLine CONTAIN "Crowdstrike Sensor" OR CommandLine CONTAIN "Cylance " OR CommandLine CONTAIN "Dell Threat Defense" OR CommandLine CONTAIN "DLP Endpoint" OR CommandLine CONTAIN "Endpoint Detection" OR CommandLine CONTAIN "Endpoint Protection" OR CommandLine CONTAIN "Endpoint Security" OR CommandLine CONTAIN "Endpoint Sensor" OR CommandLine CONTAIN "ESET File Security" OR CommandLine CONTAIN "LogRhythm System Monitor Service" OR CommandLine CONTAIN "Malwarebytes" OR CommandLine CONTAIN "McAfee Agent" OR CommandLine CONTAIN "Microsoft Security Client" OR CommandLine CONTAIN "Sophos Anti-Virus" OR CommandLine CONTAIN "Sophos AutoUpdate" OR CommandLine CONTAIN "Sophos Credential Store" OR CommandLine CONTAIN "Sophos Management Console" OR CommandLine CONTAIN "Sophos Management Database" OR CommandLine CONTAIN "Sophos Management Server" OR CommandLine CONTAIN "Sophos Remote Management System" OR CommandLine CONTAIN "Sophos Update Manager" OR CommandLine CONTAIN "Threat Protection" OR CommandLine CONTAIN "VirusScan" OR CommandLine CONTAIN "Webroot SecureAnywhere" OR CommandLine CONTAIN "Windows Defender")))
