# Title: Execution of Powershell Script in Public Folder
# ID: fb9d3ff7-7348-46ab-af8c-b55f5fbf39b4
# Status: test
# Level: high
# Author: Max Altgelt (Nextron Systems)
# Date: 2022-04-06
# Tags: attack.execution, attack.t1059.001
# Description: This rule detects execution of PowerShell scripts located in the "C:\Users\Public" folder
# Converted by: Sigma Universal SIEM/EDR CLI

((Image="*\\powershell.exe" OR Image="*\\pwsh.exe") AND (CommandLine CONTAIN "-f C:\\Users\\Public" OR CommandLine CONTAIN "-f \"C:\\Users\\Public" OR CommandLine CONTAIN "-f %Public%" OR CommandLine CONTAIN "-fi C:\\Users\\Public" OR CommandLine CONTAIN "-fi \"C:\\Users\\Public" OR CommandLine CONTAIN "-fi %Public%" OR CommandLine CONTAIN "-fil C:\\Users\\Public" OR CommandLine CONTAIN "-fil \"C:\\Users\\Public" OR CommandLine CONTAIN "-fil %Public%" OR CommandLine CONTAIN "-file C:\\Users\\Public" OR CommandLine CONTAIN "-file \"C:\\Users\\Public" OR CommandLine CONTAIN "-file %Public%"))
