# Description: Detects suspicious child processes spawned from browsers. This could be a result of a potential web browser exploitation.
# Converted by: Sigma Universal SIEM/EDR CLI

(((ParentImage CONTAIN "com.apple.WebKit.WebContent" OR ParentImage CONTAIN "firefox" OR ParentImage CONTAIN "Google Chrome Helper" OR ParentImage CONTAIN "Google Chrome" OR ParentImage CONTAIN "Microsoft Edge" OR ParentImage CONTAIN "Opera" OR ParentImage CONTAIN "Safari" OR ParentImage CONTAIN "Tor Browser") AND (Image="*/bash" OR Image="*/curl" OR Image="*/dash" OR Image="*/ksh" OR Image="*/osascript" OR Image="*/perl" OR Image="*/php" OR Image="*/pwsh" OR Image="*/python" OR Image="*/sh" OR Image="*/tcsh" OR Image="*/wget" OR Image="*/zsh")) AND NOT ((((ParentImage CONTAIN "Google Chrome Helper" OR ParentImage CONTAIN "Google Chrome") AND (CommandLine CONTAIN "/Volumes/Google Chrome/Google Chrome.app/Contents/Frameworks/*/Resources/install.sh" OR CommandLine CONTAIN "/Applications/Google Chrome.app/Contents/Frameworks/Google Chrome Framework.framework/*/Resources/keystone_promote_preflight.sh" OR CommandLine CONTAIN "/Applications/Google Chrome.app/Contents/Frameworks/Google Chrome Framework.framework/*/Resources/keystone_promote_postflight.sh")) OR ((ParentImage CONTAIN "Google Chrome Helper" OR ParentImage CONTAIN "Google Chrome") AND (CommandLine CONTAIN "/Users/" AND CommandLine CONTAIN "/Library/Application Support/Google/Chrome/recovery/" AND CommandLine CONTAIN "/ChromeRecovery")) OR (CommandLine CONTAIN "--defaults-torrc") OR (CommandLine CONTAIN "/Library/Application Support/Microsoft/MAU*/Microsoft AutoUpdate.app/Contents/MacOS/msupdate") OR (ParentImage CONTAIN "Microsoft Edge" AND (CommandLine CONTAIN "IOPlatformExpertDevice" OR CommandLine CONTAIN "hw.model")))) AND NOT (((CommandLine = "") OR (NOT CommandLine=*))))
