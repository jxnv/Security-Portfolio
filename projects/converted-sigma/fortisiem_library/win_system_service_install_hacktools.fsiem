# Title: HackTool Service Registration or Execution
# ID: d26ce60c-2151-403c-9a42-49420d87b5e4
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-03-21
# Tags: attack.execution, attack.t1569.002, attack.s0029
# Description: Detects installation or execution of services
# Converted by: Sigma Universal SIEM/EDR CLI

((Provider_Name = "Service Control Manager" AND (EventID = "7045" OR EventID = "7036")) AND ((ImagePath CONTAIN "bypass") OR ((ServiceName CONTAIN "cachedump" OR ServiceName CONTAIN "DumpSvc" OR ServiceName CONTAIN "gsecdump" OR ServiceName CONTAIN "pwdump" OR ServiceName CONTAIN "UACBypassedService" OR ServiceName CONTAIN "WCE SERVICE" OR ServiceName CONTAIN "WCESERVICE" OR ServiceName CONTAIN "winexesvc"))))
