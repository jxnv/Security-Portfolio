# Title: Deletion of Volume Shadow Copies via WMI with PowerShell
# ID: 21ff4ca9-f13a-41ad-b828-0077b2af2e40
# Status: test
# Level: high
# Author: Tim Rauch, Elastic (idea)
# Date: 2022-09-20
# Tags: attack.impact, attack.t1490
# Description: Detects deletion of Windows Volume Shadow Copies with PowerShell code and Get-WMIObject. This technique is used by numerous ransomware families such as Sodinokibi/REvil
# Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAIN ".Delete()" OR CommandLine CONTAIN "Remove-WmiObject" OR CommandLine CONTAIN "rwmi" OR CommandLine CONTAIN "Remove-CimInstance" OR CommandLine CONTAIN "rcim")) AND ((CommandLine CONTAIN "Get-WmiObject" OR CommandLine CONTAIN "gwmi" OR CommandLine CONTAIN "Get-CimInstance" OR CommandLine CONTAIN "gcim")) AND (CommandLine CONTAIN "Win32_ShadowCopy"))
