# Title: Registry Export of Third-Party Credentials
# ID: cc1abf27-78a3-4ac5-a51c-f3070b1d8e40
# Status: experimental
# Level: high
# Author: Swachchhanda Shrawan Poudel (Nextron Systems)
# Date: 2025-05-22
# Tags: attack.credential-access, attack.t1552.002
# Description: Detects the use of reg.exe to export registry paths associated with third-party credentials.
# Credential stealers have been known to use this technique to extract sensitive information from the registry.
# Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAIN "\\Software\\Aerofox\\Foxmail\\V3.1" OR CommandLine CONTAIN "\\Software\\Aerofox\\FoxmailPreview" OR CommandLine CONTAIN "\\Software\\DownloadManager\\Passwords" OR CommandLine CONTAIN "\\Software\\FTPWare\\COREFTP\\Sites" OR CommandLine CONTAIN "\\Software\\IncrediMail\\Identities" OR CommandLine CONTAIN "\\Software\\Martin Prikryl\\WinSCP 2\\Sessions" OR CommandLine CONTAIN "\\Software\\Mobatek\\MobaXterm" OR CommandLine CONTAIN "\\Software\\OpenSSH\\Agent\\Keys" OR CommandLine CONTAIN "\\Software\\OpenVPN-GUI\\configs" OR CommandLine CONTAIN "\\Software\\ORL\\WinVNC3\\Password" OR CommandLine CONTAIN "\\Software\\Qualcomm\\Eudora\\CommandLine" OR CommandLine CONTAIN "\\Software\\RealVNC\\WinVNC4" OR CommandLine CONTAIN "\\Software\\RimArts\\B2\\Settings" OR CommandLine CONTAIN "\\Software\\SimonTatham\\PuTTY\\Sessions" OR CommandLine CONTAIN "\\Software\\SimonTatham\\PuTTY\\SshHostKeys" OR CommandLine CONTAIN "\\Software\\Sota\\FFFTP" OR CommandLine CONTAIN "\\Software\\TightVNC\\Server" OR CommandLine CONTAIN "\\Software\\WOW6432Node\\Radmin\\v3.0\\Server\\Parameters\\Radmin")) AND ((CommandLine CONTAIN "save" OR CommandLine CONTAIN "export")) AND ((Image="*\\reg.exe") OR (OriginalFileName = "reg.exe")))
