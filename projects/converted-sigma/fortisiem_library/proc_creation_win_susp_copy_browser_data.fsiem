# Title: Potential Browser Data Stealing
# ID: 47147b5b-9e17-4d76-b8d2-7bac24c5ce1b
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-12-23
# Tags: attack.credential-access, attack.t1555.003
# Description: Adversaries may acquire credentials from web browsers by reading files specific to the target browser.
# Web browsers commonly save credentials such as website usernames and passwords so that they do not need to be entered manually in the future.
# Web browsers typically store the credentials in an encrypted format within a credential store.
# Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine CONTAIN "copy-item" OR CommandLine CONTAIN "copy " OR CommandLine CONTAIN "cpi " OR CommandLine CONTAIN " cp " OR CommandLine CONTAIN "move " OR CommandLine CONTAIN "move-item" OR CommandLine CONTAIN " mi " OR CommandLine CONTAIN " mv ")) OR ((Image="*\\esentutl.exe" OR Image="*\\xcopy.exe" OR Image="*\\robocopy.exe")) OR ((OriginalFileName = "esentutl.exe" OR OriginalFileName = "XCOPY.EXE" OR OriginalFileName = "robocopy.exe"))) AND ((CommandLine CONTAIN "\\Amigo\\User Data" OR CommandLine CONTAIN "\\BraveSoftware\\Brave-Browser\\User Data" OR CommandLine CONTAIN "\\CentBrowser\\User Data" OR CommandLine CONTAIN "\\Chromium\\User Data" OR CommandLine CONTAIN "\\CocCoc\\Browser\\User Data" OR CommandLine CONTAIN "\\Comodo\\Dragon\\User Data" OR CommandLine CONTAIN "\\Elements Browser\\User Data" OR CommandLine CONTAIN "\\Epic Privacy Browser\\User Data" OR CommandLine CONTAIN "\\Google\\Chrome Beta\\User Data" OR CommandLine CONTAIN "\\Google\\Chrome SxS\\User Data" OR CommandLine CONTAIN "\\Google\\Chrome\\User Data\\" OR CommandLine CONTAIN "\\Kometa\\User Data" OR CommandLine CONTAIN "\\Maxthon5\\Users" OR CommandLine CONTAIN "\\Microsoft\\Edge\\User Data" OR CommandLine CONTAIN "\\Mozilla\\Firefox\\Profiles" OR CommandLine CONTAIN "\\Nichrome\\User Data" OR CommandLine CONTAIN "\\Opera Software\\Opera GX Stable\\" OR CommandLine CONTAIN "\\Opera Software\\Opera Neon\\User Data" OR CommandLine CONTAIN "\\Opera Software\\Opera Stable\\" OR CommandLine CONTAIN "\\Orbitum\\User Data" OR CommandLine CONTAIN "\\QIP Surf\\User Data" OR CommandLine CONTAIN "\\Sputnik\\User Data" OR CommandLine CONTAIN "\\Torch\\User Data" OR CommandLine CONTAIN "\\uCozMedia\\Uran\\User Data" OR CommandLine CONTAIN "\\Vivaldi\\User Data")))
