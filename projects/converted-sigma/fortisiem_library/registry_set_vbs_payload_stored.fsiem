# Title: VBScript Payload Stored in Registry
# ID: 46490193-1b22-4c29-bdd6-5bf63907216f
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2021-03-05
# Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
# Description: Detects VBScript content stored into registry keys as seen being used by UNC2452 group
# Converted by: Sigma Universal SIEM/EDR CLI

((TargetObject CONTAIN "Software\\Microsoft\\Windows\\CurrentVersion" AND (Details CONTAIN "vbscript:" OR Details CONTAIN "jscript:" OR Details CONTAIN "mshtml," OR Details CONTAIN "RunHTMLApplication" OR Details CONTAIN "Execute(" OR Details CONTAIN "CreateObject" OR Details CONTAIN "window.close")) AND NOT (((TargetObject CONTAIN "Software\\Microsoft\\Windows\\CurrentVersion\\Run") OR (Image="*\\msiexec.exe" AND TargetObject CONTAIN "\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Installer\\UserData\\" AND (Details CONTAIN "\\Microsoft.NET\\Primary Interop Assemblies\\Microsoft.mshtml.dll" OR Details CONTAIN "<\\Microsoft.mshtml,fileVersion=" OR Details CONTAIN "_mshtml_dll_" OR Details CONTAIN "<\\Microsoft.mshtml,culture=")))))
