# Title: Suspicious Encoded PowerShell Command Line
# ID: ca2092a1-c273-4878-9b4b-0d60115bf5ea
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), Markus Neis, Jonhnathan Ribeiro, Daniil Yugoslavskiy, Anton Kutepov, oscd.community
# Date: 2018-09-03
# Tags: attack.execution, attack.t1059.001
# Description: Detects suspicious powershell process starts with base64 encoded commands (e.g. Emotet)
# Converted by: Sigma Universal SIEM/EDR CLI

((((Image="*\\powershell.exe" OR Image="*\\pwsh.exe")) OR ((OriginalFileName = "PowerShell.EXE" OR OriginalFileName = "pwsh.dll"))) AND ((((CommandLine CONTAIN " JAB" OR CommandLine CONTAIN " SUVYI" OR CommandLine CONTAIN " SQBFAFgA" OR CommandLine CONTAIN " aQBlAHgA" OR CommandLine CONTAIN " aWV4I" OR CommandLine CONTAIN " IAA" OR CommandLine CONTAIN " IAB" OR CommandLine CONTAIN " UwB" OR CommandLine CONTAIN " cwB")) AND (CommandLine CONTAIN " -e")) OR ((CommandLine CONTAIN ".exe -ENCOD " OR CommandLine CONTAIN " BA^J e-"))) AND NOT ((CommandLine CONTAIN " -ExecutionPolicy remotesigned ")))
