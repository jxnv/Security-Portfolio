# Title: WSL Kali-Linux Usage
# ID: 6f1a11aa-4b8a-4b7f-9e13-4d3e4ff0e0d4
# Status: experimental
# Level: high
# Author: Swachchhanda Shrawan Poudel (Nextron Systems)
# Date: 2025-10-10
# Tags: attack.stealth, attack.t1202
# Description: Detects the use of Kali Linux through Windows Subsystem for Linux
# Converted by: Sigma Universal SIEM/EDR CLI

(((((Image CONTAIN ":\\Users\\" AND Image CONTAIN "\\AppData\\Local\\packages\\KaliLinux")) OR ((Image CONTAIN ":\\Users\\" AND Image CONTAIN "\\AppData\\Local\\Microsoft\\WindowsApps\\kali.exe"))) OR (Image CONTAIN ":\\Program Files\\WindowsApps\\KaliLinux." AND Image="*\\kali.exe")) OR (((((Image CONTAIN "\\kali.exe" OR Image CONTAIN "\\KaliLinux")) OR ((CommandLine CONTAIN "Kali.exe" OR CommandLine CONTAIN "Kali-linux" OR CommandLine CONTAIN "kalilinux"))) AND ((ParentImage="*\\wsl.exe" OR ParentImage="*\\wslhost.exe"))) AND NOT (((CommandLine CONTAIN " -i " OR CommandLine CONTAIN " --install " OR CommandLine CONTAIN " --unregister ")))))
