# Title: Suspicious SYSTEM User Process Creation
# ID: 2617e7ed-adb7-40ba-b0f3-8f9945fe6c09
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), David ANDRE (additional keywords)
# Date: 2021-12-20
# Tags: attack.credential-access, attack.privilege-escalation, attack.stealth, attack.t1134, attack.t1003, attack.t1027
# Description: Detects a suspicious process creation as SYSTEM user (suspicious program or command line parameter)
# Converted by: Sigma Universal SIEM/EDR CLI

((((IntegrityLevel = "System" OR IntegrityLevel = "S-1-16-16384") AND (User CONTAIN "AUTHORI" OR User CONTAIN "AUTORI")) AND (((Image="*\\calc.exe" OR Image="*\\cscript.exe" OR Image="*\\forfiles.exe" OR Image="*\\hh.exe" OR Image="*\\mshta.exe" OR Image="*\\ping.exe" OR Image="*\\wscript.exe")) OR (CommandLine=regex("net\\s+user\\s+")) OR ((CommandLine CONTAIN " -NoP " OR CommandLine CONTAIN " -W Hidden " OR CommandLine CONTAIN " -decode " OR CommandLine CONTAIN " /decode " OR CommandLine CONTAIN " /urlcache " OR CommandLine CONTAIN " -urlcache " OR CommandLine CONTAIN " -e* JAB" OR CommandLine CONTAIN " -e* SUVYI" OR CommandLine CONTAIN " -e* SQBFAFgA" OR CommandLine CONTAIN " -e* aWV4I" OR CommandLine CONTAIN " -e* IAB" OR CommandLine CONTAIN " -e* PAA" OR CommandLine CONTAIN " -e* aQBlAHgA" OR CommandLine CONTAIN "vssadmin delete shadows" OR CommandLine CONTAIN "reg SAVE HKLM" OR CommandLine CONTAIN " -ma " OR CommandLine CONTAIN "Microsoft\\Windows\\CurrentVersion\\Run" OR CommandLine CONTAIN ".downloadstring(" OR CommandLine CONTAIN ".downloadfile(" OR CommandLine CONTAIN " /ticket:" OR CommandLine CONTAIN "dpapi::" OR CommandLine CONTAIN "event::clear" OR CommandLine CONTAIN "event::drop" OR CommandLine CONTAIN "id::modify" OR CommandLine CONTAIN "kerberos::" OR CommandLine CONTAIN "lsadump::" OR CommandLine CONTAIN "misc::" OR CommandLine CONTAIN "privilege::" OR CommandLine CONTAIN "rpc::" OR CommandLine CONTAIN "sekurlsa::" OR CommandLine CONTAIN "sid::" OR CommandLine CONTAIN "token::" OR CommandLine CONTAIN "vault::cred" OR CommandLine CONTAIN "vault::list" OR CommandLine CONTAIN " p::d " OR CommandLine CONTAIN ";iex(" OR CommandLine CONTAIN "MiniDump")))) AND NOT (((ParentImage CONTAIN ":\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\") OR ((ParentImage CONTAIN ":\\Program Files (x86)\\Java\\" OR ParentImage CONTAIN ":\\Program Files\\Java\\") AND ParentImage="*\\bin\\javaws.exe" AND (Image CONTAIN ":\\Program Files (x86)\\Java\\" OR Image CONTAIN ":\\Program Files\\Java\\") AND Image="*\\bin\\jp2launcher.exe" AND CommandLine CONTAIN " -ma ") OR ((CommandLine CONTAIN "ping" AND CommandLine CONTAIN "127.0.0.1" AND CommandLine CONTAIN " -n ")) OR (Image="*\\PING.EXE" AND ParentCommandLine CONTAIN "\\DismFoDInstall.cmd"))))
