# Title: Suspicious DNS Query for IP Lookup Service APIs
# ID: ec82e2a5-81ea-4211-a1f8-37a0286df2c2
# Status: test
# Level: medium
# Author: Brandon George (blog post), Thomas Patzke
# Date: 2021-07-08
# Tags: attack.reconnaissance, attack.t1590
# Description: Detects DNS queries for IP lookup services such as "api.ipify.org" originating from a non browser process.
# Converted by: Sigma Universal SIEM/EDR CLI

((((QueryName = "www.ip.cn" OR QueryName = "l2.io")) OR ((QueryName CONTAIN "api.2ip.ua" OR QueryName CONTAIN "api.bigdatacloud.net" OR QueryName CONTAIN "api.ipify.org" OR QueryName CONTAIN "bot.whatismyipaddress.com" OR QueryName CONTAIN "canireachthe.net" OR QueryName CONTAIN "checkip.amazonaws.com" OR QueryName CONTAIN "checkip.dyndns.org" OR QueryName CONTAIN "curlmyip.com" OR QueryName CONTAIN "db-ip.com" OR QueryName CONTAIN "edns.ip-api.com" OR QueryName CONTAIN "eth0.me" OR QueryName CONTAIN "freegeoip.app" OR QueryName CONTAIN "geoipy.com" OR QueryName CONTAIN "getip.pro" OR QueryName CONTAIN "icanhazip.com" OR QueryName CONTAIN "ident.me" OR QueryName CONTAIN "ifconfig.io" OR QueryName CONTAIN "ifconfig.me" OR QueryName CONTAIN "ip-api.com" OR QueryName CONTAIN "ip.360.cn" OR QueryName CONTAIN "ip.anysrc.net" OR QueryName CONTAIN "ip.taobao.com" OR QueryName CONTAIN "ip.tyk.nu" OR QueryName CONTAIN "ipaddressworld.com" OR QueryName CONTAIN "ipapi.co" OR QueryName CONTAIN "ipconfig.io" OR QueryName CONTAIN "ipecho.net" OR QueryName CONTAIN "ipinfo.io" OR QueryName CONTAIN "ipip.net" OR QueryName CONTAIN "ipof.in" OR QueryName CONTAIN "ipv4.icanhazip.com" OR QueryName CONTAIN "ipv4bot.whatismyipaddress.com" OR QueryName CONTAIN "ipv6-test.com" OR QueryName CONTAIN "ipwho.is" OR QueryName CONTAIN "jsonip.com" OR QueryName CONTAIN "myexternalip.com" OR QueryName CONTAIN "seeip.org" OR QueryName CONTAIN "wgetip.com" OR QueryName CONTAIN "whatismyip.akamai.com" OR QueryName CONTAIN "whois.pconline.com.cn" OR QueryName CONTAIN "wtfismyip.com"))) AND NOT (((Image="*\\brave.exe") OR ((Image = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR Image = "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((Image="C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*") OR (Image="*\\WindowsApps\\MicrosoftEdge.exe") OR ((Image = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR Image = "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((Image="C:\\Program Files (x86)\\Microsoft\\EdgeCore\\*" OR Image="C:\\Program Files\\Microsoft\\EdgeCore\\*") AND (Image="*\\msedge.exe" OR Image="*\\msedgewebview2.exe")) OR ((Image = "C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR Image = "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR ((Image = "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR Image = "C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (Image="*\\maxthon.exe") OR (Image="*\\opera.exe") OR (Image="*\\safari.exe") OR (Image="*\\seamonkey.exe") OR (Image="*\\vivaldi.exe") OR (Image="*\\whale.exe"))))
