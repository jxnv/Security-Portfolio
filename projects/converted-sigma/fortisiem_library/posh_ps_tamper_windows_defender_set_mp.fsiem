# Title: Tamper Windows Defender - ScriptBlockLogging
# ID: 14c71865-6cd3-44ae-adaa-1db923fae5f2
# Status: test
# Level: high
# Author: frack113, elhoim, Tim Shelton (fps, alias support), Swachchhanda Shrawan Poudel, Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-01-16
# Tags: attack.defense-impairment, attack.t1685
# Description: Detects PowerShell scripts attempting to disable scheduled scanning and other parts of Windows Defender ATP or set default actions to allow.
# Converted by: Sigma Universal SIEM/EDR CLI

((((ScriptBlockText CONTAIN "-dbaf $true" OR ScriptBlockText CONTAIN "-dbaf 1" OR ScriptBlockText CONTAIN "-dbm $true" OR ScriptBlockText CONTAIN "-dbm 1" OR ScriptBlockText CONTAIN "-dips $true" OR ScriptBlockText CONTAIN "-dips 1" OR ScriptBlockText CONTAIN "-DisableArchiveScanning $true" OR ScriptBlockText CONTAIN "-DisableArchiveScanning 1" OR ScriptBlockText CONTAIN "-DisableBehaviorMonitoring $true" OR ScriptBlockText CONTAIN "-DisableBehaviorMonitoring 1" OR ScriptBlockText CONTAIN "-DisableBlockAtFirstSeen $true" OR ScriptBlockText CONTAIN "-DisableBlockAtFirstSeen 1" OR ScriptBlockText CONTAIN "-DisableCatchupFullScan $true" OR ScriptBlockText CONTAIN "-DisableCatchupFullScan 1" OR ScriptBlockText CONTAIN "-DisableCatchupQuickScan $true" OR ScriptBlockText CONTAIN "-DisableCatchupQuickScan 1" OR ScriptBlockText CONTAIN "-DisableIntrusionPreventionSystem $true" OR ScriptBlockText CONTAIN "-DisableIntrusionPreventionSystem 1" OR ScriptBlockText CONTAIN "-DisableIOAVProtection $true" OR ScriptBlockText CONTAIN "-DisableIOAVProtection 1" OR ScriptBlockText CONTAIN "-DisableRealtimeMonitoring $true" OR ScriptBlockText CONTAIN "-DisableRealtimeMonitoring 1" OR ScriptBlockText CONTAIN "-DisableRemovableDriveScanning $true" OR ScriptBlockText CONTAIN "-DisableRemovableDriveScanning 1" OR ScriptBlockText CONTAIN "-DisableScanningMappedNetworkDrivesForFullScan $true" OR ScriptBlockText CONTAIN "-DisableScanningMappedNetworkDrivesForFullScan 1" OR ScriptBlockText CONTAIN "-DisableScanningNetworkFiles $true" OR ScriptBlockText CONTAIN "-DisableScanningNetworkFiles 1" OR ScriptBlockText CONTAIN "-DisableScriptScanning $true" OR ScriptBlockText CONTAIN "-DisableScriptScanning 1" OR ScriptBlockText CONTAIN "-MAPSReporting $false" OR ScriptBlockText CONTAIN "-MAPSReporting 0" OR ScriptBlockText CONTAIN "-drdsc $true" OR ScriptBlockText CONTAIN "-drdsc 1" OR ScriptBlockText CONTAIN "-drtm $true" OR ScriptBlockText CONTAIN "-drtm 1" OR ScriptBlockText CONTAIN "-dscrptsc $true" OR ScriptBlockText CONTAIN "-dscrptsc 1" OR ScriptBlockText CONTAIN "-dsmndf $true" OR ScriptBlockText CONTAIN "-dsmndf 1" OR ScriptBlockText CONTAIN "-dsnf $true" OR ScriptBlockText CONTAIN "-dsnf 1" OR ScriptBlockText CONTAIN "-dss $true" OR ScriptBlockText CONTAIN "-dss 1")) AND (ScriptBlockText CONTAIN "Set-MpPreference")) OR ((ScriptBlockText CONTAIN "Set-MpPreference") AND ((ScriptBlockText CONTAIN "HighThreatDefaultAction Allow" OR ScriptBlockText CONTAIN "htdefac Allow" OR ScriptBlockText CONTAIN "LowThreatDefaultAction Allow" OR ScriptBlockText CONTAIN "ltdefac Allow" OR ScriptBlockText CONTAIN "ModerateThreatDefaultAction Allow" OR ScriptBlockText CONTAIN "mtdefac Allow" OR ScriptBlockText CONTAIN "SevereThreatDefaultAction Allow" OR ScriptBlockText CONTAIN "stdefac Allow"))))
