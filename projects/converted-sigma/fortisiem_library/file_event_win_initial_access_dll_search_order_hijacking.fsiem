# Title: Potential Initial Access via DLL Search Order Hijacking
# ID: dbbd9f66-2ed3-4ca2-98a4-6ea985dd1a1c
# Status: test
# Level: medium
# Author: Tim Rauch (rule), Elastic (idea)
# Date: 2022-10-21
# Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.stealth, attack.t1566, attack.t1566.001, attack.initial-access, attack.t1574, attack.t1574.001
# Description: Detects attempts to create a DLL file to a known desktop application dependencies folder such as Slack, Teams or OneDrive and by an unusual process. This may indicate an attempt to load a malicious module via DLL search order hijacking.
# Converted by: Sigma Universal SIEM/EDR CLI

(((Image="*\\winword.exe" OR Image="*\\excel.exe" OR Image="*\\powerpnt.exe" OR Image="*\\MSACCESS.EXE" OR Image="*\\MSPUB.EXE" OR Image="*\\fltldr.exe" OR Image="*\\cmd.exe" OR Image="*\\certutil.exe" OR Image="*\\mshta.exe" OR Image="*\\cscript.exe" OR Image="*\\wscript.exe" OR Image="*\\curl.exe" OR Image="*\\powershell.exe" OR Image="*\\pwsh.exe") AND TargetFilename="*.dll" AND (TargetFilename CONTAIN "\\Users\\" AND TargetFilename CONTAIN "\\AppData\\") AND (TargetFilename CONTAIN "\\Microsoft\\OneDrive\\" OR TargetFilename CONTAIN "\\Microsoft OneDrive\\" OR TargetFilename CONTAIN "\\Microsoft\\Teams\\" OR TargetFilename CONTAIN "\\Local\\slack\\app-" OR TargetFilename CONTAIN "\\Local\\Programs\\Microsoft VS Code\\")) AND NOT ((Image="*\\cmd.exe" AND (TargetFilename CONTAIN "\\Users\\" AND TargetFilename CONTAIN "\\AppData\\" AND TargetFilename CONTAIN "\\Microsoft\\OneDrive\\" AND TargetFilename CONTAIN "\\api-ms-win-core-"))))
