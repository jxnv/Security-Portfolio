# Title: Dump Credentials from Windows Credential Manager With PowerShell
# ID: 99c49d9c-34ea-45f7-84a7-4751ae6b2cbc
# Status: test
# Level: medium
# Author: frack113
# Date: 2021-12-20
# Tags: attack.credential-access, attack.t1555
# Description: Adversaries may search for common password storage locations to obtain user credentials.
# Passwords are stored in several places on a system, depending on the operating system or application holding the credentials.
# Converted by: Sigma Universal SIEM/EDR CLI

(((ScriptBlockText CONTAIN "Get-PasswordVaultCredentials" OR ScriptBlockText CONTAIN "Get-CredManCreds")) OR ((ScriptBlockText CONTAIN "New-Object" AND ScriptBlockText CONTAIN "Windows.Security.Credentials.PasswordVault")) OR ((ScriptBlockText CONTAIN "New-Object" AND ScriptBlockText CONTAIN "Microsoft.CSharp.CSharpCodeProvider" AND ScriptBlockText CONTAIN "[System.Runtime.InteropServices.RuntimeEnvironment]::GetRuntimeDirectory())" AND ScriptBlockText CONTAIN "Collections.ArrayList" AND ScriptBlockText CONTAIN "System.CodeDom.Compiler.CompilerParameters")))
