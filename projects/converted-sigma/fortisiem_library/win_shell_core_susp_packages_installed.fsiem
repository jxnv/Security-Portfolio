# Tags: attack.execution
# Description: Detects suspicious application installed by looking at the added shortcut to the app resolver cache
# Converted by: Sigma Universal SIEM/EDR CLI

((EventID = "28115" AND (Name CONTAIN "Zenmap" OR Name CONTAIN "AnyDesk" OR Name CONTAIN "wireshark" OR Name CONTAIN "openvpn")) OR (EventID = "28115" AND (AppID CONTAIN "zenmap.exe" OR AppID CONTAIN "prokzult ad" OR AppID CONTAIN "wireshark" OR AppID CONTAIN "openvpn")))
