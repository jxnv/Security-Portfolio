# Tags: attack.stealth, attack.t1036
# Description: Detects a potentially suspicious execution from an uncommon folder.
# Converted by: Sigma Universal SIEM/EDR CLI

(((Image CONTAIN ":\\Perflogs\\" OR Image CONTAIN ":\\Users\\All Users\\" OR Image CONTAIN ":\\Users\\Default\\" OR Image CONTAIN ":\\Users\\NetworkService\\" OR Image CONTAIN ":\\Windows\\addins\\" OR Image CONTAIN ":\\Windows\\debug\\" OR Image CONTAIN ":\\Windows\\Fonts\\" OR Image CONTAIN ":\\Windows\\Help\\" OR Image CONTAIN ":\\Windows\\IME\\" OR Image CONTAIN ":\\Windows\\Media\\" OR Image CONTAIN ":\\Windows\\repair\\" OR Image CONTAIN ":\\Windows\\security\\" OR Image CONTAIN ":\\Windows\\System32\\Tasks\\" OR Image CONTAIN ":\\Windows\\Tasks\\" OR Image CONTAIN "$Recycle.bin" OR Image CONTAIN "\\config\\systemprofile\\" OR Image CONTAIN "\\Intel\\Logs\\" OR Image CONTAIN "\\RSA\\MachineKeys\\")) AND NOT (((Image="C:\\Windows\\SysWOW64\\config\\systemprofile\\Citrix\\UpdaterBinaries\\*" AND Image="*\\CitrixReceiverUpdater.exe") OR (Image="C:\\Users\\Public\\IBM\\ClientSolutions\\Start_Programs\\*"))))
