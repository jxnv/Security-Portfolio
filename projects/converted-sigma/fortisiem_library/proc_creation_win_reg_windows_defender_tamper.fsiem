# Title: Suspicious Windows Defender Registry Key Tampering Via Reg.EXE
# ID: 452bce90-6fb0-43cc-97a5-affc283139b3
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), Swachchhanda Shrawan Poudel, Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-03-22
# Tags: attack.defense-impairment, attack.t1685
# Description: Detects the usage of "reg.exe" to tamper with different Windows Defender registry keys in order to disable some important features related to protection and detection
# Converted by: Sigma Universal SIEM/EDR CLI

((((Image="*\\reg.exe") OR (OriginalFileName = "reg.exe")) AND ((CommandLine CONTAIN "SOFTWARE\\Microsoft\\Windows Defender\\" OR CommandLine CONTAIN "SOFTWARE\\Policies\\Microsoft\\Windows Defender Security Center" OR CommandLine CONTAIN "SOFTWARE\\Policies\\Microsoft\\Windows Defender\\"))) AND (((CommandLine CONTAIN " add " AND CommandLine CONTAIN "d 0") AND (CommandLine CONTAIN "DisallowExploitProtectionOverride" OR CommandLine CONTAIN "EnableControlledFolderAccess" OR CommandLine CONTAIN "MpEnablePus" OR CommandLine CONTAIN "PUAProtection" OR CommandLine CONTAIN "SpynetReporting" OR CommandLine CONTAIN "SubmitSamplesConsent" OR CommandLine CONTAIN "TamperProtection")) OR ((CommandLine CONTAIN " add " AND CommandLine CONTAIN "d 1") AND (CommandLine CONTAIN "DisableAccess" OR CommandLine CONTAIN "DisableAntiSpyware" OR CommandLine CONTAIN "DisableAntiSpywareRealtimeProtection" OR CommandLine CONTAIN "DisableAntiVirus" OR CommandLine CONTAIN "DisableAntiVirusSignatures" OR CommandLine CONTAIN "DisableArchiveScanning" OR CommandLine CONTAIN "DisableBehaviorMonitoring" OR CommandLine CONTAIN "DisableBlockAtFirstSeen" OR CommandLine CONTAIN "DisableCloudProtection" OR CommandLine CONTAIN "DisableConfig" OR CommandLine CONTAIN "DisableEnhancedNotifications" OR CommandLine CONTAIN "DisableIntrusionPreventionSystem" OR CommandLine CONTAIN "DisableIOAVProtection" OR CommandLine CONTAIN "DisableNetworkProtection" OR CommandLine CONTAIN "DisableOnAccessProtection" OR CommandLine CONTAIN "DisablePrivacyMode" OR CommandLine CONTAIN "DisableRealtimeMonitoring" OR CommandLine CONTAIN "DisableRoutinelyTakingAction" OR CommandLine CONTAIN "DisableScanOnRealtimeEnable" OR CommandLine CONTAIN "DisableScriptScanning" OR CommandLine CONTAIN "DisableSecurityCenter" OR CommandLine CONTAIN "Notification_Suppress" OR CommandLine CONTAIN "SignatureDisableUpdateOnStartupWithoutEngine"))))
