# Title: Disable Important Scheduled Task
# ID: 9ac94dc8-9042-493c-ba45-3b5e7c86b980
# Status: test
# Level: high
# Author: frack113, Nasreddine Bencherchali (Nextron Systems), X__Junior
# Date: 2021-12-26
# Tags: attack.impact, attack.t1489
# Description: Detects when adversaries stop services or processes by disabling their respective scheduled tasks in order to conduct data destructive activities
# Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAIN "/disable" OR CommandLine CONTAIN "-disable")) AND ((CommandLine CONTAIN "\\Windows\\BitLocker" OR CommandLine CONTAIN "\\Windows\\ExploitGuard" OR CommandLine CONTAIN "\\Windows\\ExploitGuard\\ExploitGuard MDM policy Refresh" OR CommandLine CONTAIN "\\Windows\\SystemRestore\\SR" OR CommandLine CONTAIN "\\Windows\\UpdateOrchestrator\\" OR CommandLine CONTAIN "\\Windows\\Windows Defender\\" OR CommandLine CONTAIN "\\Windows\\WindowsBackup\\" OR CommandLine CONTAIN "\\Windows\\WindowsUpdate\\")) AND ((Image="*\\schtasks.exe") OR (OriginalFileName = "schtasks.exe")))
