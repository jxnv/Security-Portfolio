# Title: Kubernetes Potential Enumeration Activity
# ID: 597a7e84-187d-458b-9e4f-2f5a0e676711
# Status: experimental
# Level: medium
# Author: uniqu3-us3r
# Date: 2026-04-28
# Tags: attack.execution, attack.discovery, attack.t1609, attack.t1613
# Description: Detects potential Kubernetes enumeration or attack activity via the audit log.
# This includes the execution of common shells, utilities, or specialized tools like 'Rakkess' (access_matrix) and 'TruffleHog' via Kubernetes API requests.
# Attackers use these methods to perform reconnaissance (enumeration), secret harvesting, or execute code (exec) within a cluster.
# Converted by: Sigma Universal SIEM/EDR CLI

((responseStatus.code = "ALLOW") AND (((requestURI CONTAIN "%2fbin%2fash" OR requestURI CONTAIN "%2fbin%2fbash" OR requestURI CONTAIN "%2fbin%2fbusybox" OR requestURI CONTAIN "%2fbin%2fdash" OR requestURI CONTAIN "%2fbin%2fsh" OR requestURI CONTAIN "%2fbin%2fzsh" OR requestURI CONTAIN "/bin/ash" OR requestURI CONTAIN "/bin/bash" OR requestURI CONTAIN "/bin/busybox" OR requestURI CONTAIN "/bin/dash" OR requestURI CONTAIN "/bin/sh" OR requestURI CONTAIN "/bin/zsh" OR requestURI CONTAIN "%2fusr%2fbin%2fcurl" OR requestURI CONTAIN "%2fusr%2fbin%2fkubectl" OR requestURI CONTAIN "%2fusr%2fbin%2fperl" OR requestURI CONTAIN "%2fusr%2fbin%2fpython" OR requestURI CONTAIN "%2fusr%2fbin%2fwget" OR requestURI CONTAIN "/usr/bin/curl" OR requestURI CONTAIN "/usr/bin/kubectl" OR requestURI CONTAIN "/usr/bin/perl" OR requestURI CONTAIN "/usr/bin/python" OR requestURI CONTAIN "/usr/bin/wget")) OR ((userAgent CONTAIN "access_matrix" OR userAgent CONTAIN "trufflehog" OR userAgent CONTAIN "azurehound" OR userAgent CONTAIN "micro-scanner"))))
