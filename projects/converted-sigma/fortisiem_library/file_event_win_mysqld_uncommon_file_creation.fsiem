# Title: Uncommon File Creation By Mysql Daemon Process
# ID: c61daa90-3c1e-4f18-af62-8f288b5c9aaf
# Status: test
# Level: high
# Author: Joseph Kamau
# Date: 2024-05-27
# Tags: attack.stealth
# Description: Detects the creation of files with scripting or executable extensions by Mysql daemon.
# Which could be an indicator of "User Defined Functions" abuse to download malware.
# Converted by: Sigma Universal SIEM/EDR CLI

((Image="*\\mysqld.exe" OR Image="*\\mysqld-nt.exe") AND (TargetFilename="*.bat" OR TargetFilename="*.dat" OR TargetFilename="*.dll" OR TargetFilename="*.exe" OR TargetFilename="*.ps1" OR TargetFilename="*.psm1" OR TargetFilename="*.vbe" OR TargetFilename="*.vbs"))
