# Title: MacOS Scripting Interpreter AppleScript
# ID: 1bc2e6c5-0885-472b-bed6-be5ea8eace55
# Status: test
# Level: medium
# Author: Alejandro Ortuno, oscd.community
# Date: 2020-10-21
# Tags: attack.execution, attack.t1059.002
# Description: Detects execution of AppleScript of the macOS scripting language AppleScript.
# Converted by: Sigma Universal SIEM/EDR CLI

((Image="*/osascript" AND (CommandLine CONTAIN " -e " OR CommandLine CONTAIN ".scpt" OR CommandLine CONTAIN ".js")) AND NOT ((ParentImage="*opencode" AND (CommandLine CONTAIN "osascript" AND CommandLine CONTAIN " -e " AND CommandLine CONTAIN "set imageData to the clipboard" AND CommandLine CONTAIN "set fileRef"))))
