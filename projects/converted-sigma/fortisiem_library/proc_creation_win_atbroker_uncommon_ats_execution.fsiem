# Title: Uncommon  Assistive Technology Applications Execution Via AtBroker.EXE
# ID: f24bcaea-0cd1-11eb-adc1-0242ac120002
# Status: test
# Level: medium
# Author: Mateusz Wydra, oscd.community
# Date: 2020-10-12
# Tags: attack.stealth, attack.t1218
# Description: Detects the start of a non built-in assistive technology applications via "Atbroker.EXE".
# Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAIN "start") AND ((Image="*\\AtBroker.exe") OR (OriginalFileName = "AtBroker.exe"))) AND NOT (((CommandLine CONTAIN "animations" OR CommandLine CONTAIN "audiodescription" OR CommandLine CONTAIN "caretbrowsing" OR CommandLine CONTAIN "caretwidth" OR CommandLine CONTAIN "colorfiltering" OR CommandLine CONTAIN "cursorindicator" OR CommandLine CONTAIN "cursorscheme" OR CommandLine CONTAIN "filterkeys" OR CommandLine CONTAIN "focusborderheight" OR CommandLine CONTAIN "focusborderwidth" OR CommandLine CONTAIN "highcontrast" OR CommandLine CONTAIN "keyboardcues" OR CommandLine CONTAIN "keyboardpref" OR CommandLine CONTAIN "livecaptions" OR CommandLine CONTAIN "magnifierpane" OR CommandLine CONTAIN "messageduration" OR CommandLine CONTAIN "minimumhitradius" OR CommandLine CONTAIN "mousekeys" OR CommandLine CONTAIN "Narrator" OR CommandLine CONTAIN "osk" OR CommandLine CONTAIN "overlappedcontent" OR CommandLine CONTAIN "showsounds" OR CommandLine CONTAIN "soundsentry" OR CommandLine CONTAIN "speechreco" OR CommandLine CONTAIN "stickykeys" OR CommandLine CONTAIN "togglekeys" OR CommandLine CONTAIN "voiceaccess" OR CommandLine CONTAIN "windowarranging" OR CommandLine CONTAIN "windowtracking" OR CommandLine CONTAIN "windowtrackingtimeout" OR CommandLine CONTAIN "windowtrackingzorder"))) AND NOT ((CommandLine CONTAIN "Oracle_JavaAccessBridge")))
