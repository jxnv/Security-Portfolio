# Title: GUI Input Capture - macOS
# ID: 60f1ce20-484e-41bd-85f4-ac4afec2c541
# Status: test
# Level: low
# Author: remotephone, oscd.community
# Date: 2020-10-13
# Tags: attack.collection, attack.credential-access, attack.t1056.002
# Description: Detects attempts to use system dialog prompts to capture user credentials
# Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAIN "-e" AND CommandLine CONTAIN "display" AND CommandLine CONTAIN "dialog" AND CommandLine CONTAIN "answer")) AND ((CommandLine CONTAIN "admin" OR CommandLine CONTAIN "administrator" OR CommandLine CONTAIN "authenticate" OR CommandLine CONTAIN "authentication" OR CommandLine CONTAIN "credentials" OR CommandLine CONTAIN "pass" OR CommandLine CONTAIN "password" OR CommandLine CONTAIN "unlock")) AND (Image="*/osascript"))
