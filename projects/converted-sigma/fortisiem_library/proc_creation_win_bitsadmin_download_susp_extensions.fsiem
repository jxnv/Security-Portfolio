# Title: File With Suspicious Extension Downloaded Via Bitsadmin
# ID: 5b80a791-ad9b-4b75-bcc1-ad4e1e89c200
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-06-28
# Tags: attack.persistence, attack.execution, attack.stealth, attack.t1197, attack.s0190, attack.t1036.003, attack.command-and-control, attack.t1105
# Description: Detects usage of bitsadmin downloading a file with a suspicious extension
# Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAIN ".7z" OR CommandLine CONTAIN ".asax" OR CommandLine CONTAIN ".ashx" OR CommandLine CONTAIN ".asmx" OR CommandLine CONTAIN ".asp" OR CommandLine CONTAIN ".aspx" OR CommandLine CONTAIN ".bat" OR CommandLine CONTAIN ".cfm" OR CommandLine CONTAIN ".cgi" OR CommandLine CONTAIN ".chm" OR CommandLine CONTAIN ".cmd" OR CommandLine CONTAIN ".dll" OR CommandLine CONTAIN ".gif" OR CommandLine CONTAIN ".jpeg" OR CommandLine CONTAIN ".jpg" OR CommandLine CONTAIN ".jsp" OR CommandLine CONTAIN ".jspx" OR CommandLine CONTAIN ".log" OR CommandLine CONTAIN ".png" OR CommandLine CONTAIN ".ps1" OR CommandLine CONTAIN ".psm1" OR CommandLine CONTAIN ".rar" OR CommandLine CONTAIN ".scf" OR CommandLine CONTAIN ".sct" OR CommandLine CONTAIN ".txt" OR CommandLine CONTAIN ".vbe" OR CommandLine CONTAIN ".vbs" OR CommandLine CONTAIN ".war" OR CommandLine CONTAIN ".wsf" OR CommandLine CONTAIN ".wsh" OR CommandLine CONTAIN ".xll" OR CommandLine CONTAIN ".zip")) AND ((CommandLine CONTAIN " /transfer " OR CommandLine CONTAIN " /create " OR CommandLine CONTAIN " /addfile ")) AND ((Image="*\\bitsadmin.exe") OR (OriginalFileName = "bitsadmin.exe")))
