# Title: Potential Tampering With RDP Related Registry Keys Via Reg.EXE
# ID: 0d5675be-bc88-4172-86d3-1e96a4476536
# Status: test
# Level: high
# Author: pH-T (Nextron Systems), @Kostastsale, TheDFIRReport
# Date: 2022-02-12
# Tags: attack.persistence, attack.lateral-movement, attack.defense-impairment, attack.t1021.001, attack.t1112
# Description: Detects the execution of "reg.exe" for enabling/disabling the RDP service on the host by tampering with the 'CurrentControlSet\Control\Terminal Server' values
# Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine CONTAIN " add " AND CommandLine CONTAIN "\\CurrentControlSet\\Control\\Terminal Server" AND CommandLine CONTAIN "REG_DWORD" AND CommandLine CONTAIN " /f")) AND ((Image="*\\reg.exe") OR (OriginalFileName = "reg.exe"))) AND (((CommandLine CONTAIN "Licensing Core" AND CommandLine CONTAIN "EnableConcurrentSessions")) OR ((CommandLine CONTAIN "AllowTSConnections" OR CommandLine CONTAIN "fDenyTSConnections" OR CommandLine CONTAIN "fEnableWinStation" OR CommandLine CONTAIN "fSingleSessionPerUser" OR CommandLine CONTAIN "IdleWinStationPoolCount" OR CommandLine CONTAIN "MaxInstanceCount" OR CommandLine CONTAIN "SecurityLayer" OR CommandLine CONTAIN "TSAdvertise" OR CommandLine CONTAIN "TSAppCompat" OR CommandLine CONTAIN "TSEnabled" OR CommandLine CONTAIN "TSUserEnabled" OR CommandLine CONTAIN "WinStations\\RDP-Tcp"))) AND NOT (((CommandLine CONTAIN "SecurityLayer" AND CommandLine CONTAIN "02"))))
