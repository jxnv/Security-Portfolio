# Title: Netsh Allow Group Policy on Microsoft Defender Firewall
# ID: 347906f3-e207-4d18-ae5b-a9403d6bcdef
# Status: test
# Level: medium
# Author: frack113
# Date: 2022-01-09
# Tags: attack.defense-impairment, attack.t1686.003
# Description: Adversaries may modify system firewalls in order to bypass controls limiting network usage
# Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAIN "advfirewall" AND CommandLine CONTAIN "firewall" AND CommandLine CONTAIN "set" AND CommandLine CONTAIN "rule" AND CommandLine CONTAIN "group=" AND CommandLine CONTAIN "new" AND CommandLine CONTAIN "enable=Yes")) AND ((Image="*\\netsh.exe") OR (OriginalFileName = "netsh.exe")))
