# Title: Potentially Suspicious EventLog Recon Activity Using Log Query Utilities
# ID: beaa66d6-aa1b-4e3c-80f5-e0145369bfaf
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
# Date: 2022-09-09
# Tags: attack.credential-access, attack.discovery, attack.t1552, attack.t1087
# Description: Detects execution of different log query utilities and commands to search and dump the content of specific event logs or look for specific event IDs.
# This technique is used by threat actors in order to extract sensitive information from events logs such as usernames, IP addresses, hostnames, etc.
# Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine CONTAIN "-InstanceId 462?" OR CommandLine CONTAIN ".eventid -eq 462?" OR CommandLine CONTAIN ".ID -eq 462?" OR CommandLine CONTAIN "EventCode=?462?" OR CommandLine CONTAIN "EventIdentifier=?462?" OR CommandLine CONTAIN "System[EventID=462?]" OR CommandLine CONTAIN "-InstanceId 4778" OR CommandLine CONTAIN ".eventid -eq 4778" OR CommandLine CONTAIN ".ID -eq 4778" OR CommandLine CONTAIN "EventCode=?4778?" OR CommandLine CONTAIN "EventIdentifier=?4778?" OR CommandLine CONTAIN "System[EventID=4778]" OR CommandLine CONTAIN "-InstanceId 25" OR CommandLine CONTAIN ".eventid -eq 25" OR CommandLine CONTAIN ".ID -eq 25" OR CommandLine CONTAIN "EventCode=?25?" OR CommandLine CONTAIN "EventIdentifier=?25?" OR CommandLine CONTAIN "System[EventID=25]" OR CommandLine CONTAIN "-InstanceId 1149" OR CommandLine CONTAIN ".eventid -eq 1149" OR CommandLine CONTAIN ".ID -eq 1149" OR CommandLine CONTAIN "EventCode=?1149?" OR CommandLine CONTAIN "EventIdentifier=?1149?" OR CommandLine CONTAIN "System[EventID=1149]" OR CommandLine CONTAIN "-InstanceId 21" OR CommandLine CONTAIN ".eventid -eq 21" OR CommandLine CONTAIN ".ID -eq 21" OR CommandLine CONTAIN "EventCode=?21?" OR CommandLine CONTAIN "EventIdentifier=?21?" OR CommandLine CONTAIN "System[EventID=21]" OR CommandLine CONTAIN "-InstanceId 22" OR CommandLine CONTAIN ".eventid -eq 22" OR CommandLine CONTAIN ".ID -eq 22" OR CommandLine CONTAIN "EventCode=?22?" OR CommandLine CONTAIN "EventIdentifier=?22?" OR CommandLine CONTAIN "System[EventID=22]")) OR ((CommandLine CONTAIN "Microsoft-Windows-PowerShell" OR CommandLine CONTAIN "Microsoft-Windows-Security-Auditing" OR CommandLine CONTAIN "Microsoft-Windows-TerminalServices-LocalSessionManager" OR CommandLine CONTAIN "Microsoft-Windows-TerminalServices-RemoteConnectionManager" OR CommandLine CONTAIN "Microsoft-Windows-Windows Defender" OR CommandLine CONTAIN "PowerShellCore" OR CommandLine CONTAIN "Security" OR CommandLine CONTAIN "Windows PowerShell"))) AND (((CommandLine CONTAIN "Select" AND CommandLine CONTAIN "Win32_NTLogEvent")) OR (((CommandLine CONTAIN " qe " OR CommandLine CONTAIN " query-events ")) AND ((Image="*\\wevtutil.exe") OR (OriginalFileName = "wevtutil.exe"))) OR ((CommandLine CONTAIN " ntevent") AND ((Image="*\\wmic.exe") OR (OriginalFileName = "wmic.exe"))) OR ((CommandLine CONTAIN "Get-WinEvent " OR CommandLine CONTAIN "get-eventlog "))))
