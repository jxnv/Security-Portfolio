# Title: Execute From Alternate Data Streams
# ID: 7f43c430-5001-4f8b-aaa9-c3b88f18fa5c
# Status: test
# Level: medium
# Author: frack113
# Date: 2021-09-01
# Tags: attack.stealth, attack.t1564.004
# Description: Detects execution from an Alternate Data Stream (ADS). Adversaries may use NTFS file attributes to hide their malicious data in order to evade detection
# Converted by: Sigma Universal SIEM/EDR CLI

((CommandLine CONTAIN "txt:") AND (((CommandLine CONTAIN "esentutl " AND CommandLine CONTAIN " /y " AND CommandLine CONTAIN " /d " AND CommandLine CONTAIN " /o ")) OR ((CommandLine CONTAIN "makecab " AND CommandLine CONTAIN ".cab")) OR ((CommandLine CONTAIN "reg " AND CommandLine CONTAIN " export ")) OR ((CommandLine CONTAIN "regedit " AND CommandLine CONTAIN " /E ")) OR ((CommandLine CONTAIN "type " AND CommandLine CONTAIN " > "))))
