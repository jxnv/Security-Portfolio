(((ScriptBlockText CONTAIN "New-CimInstance " AND ScriptBlockText CONTAIN "-Namespace root/subscription " AND ScriptBlockText CONTAIN "-ClassName __EventFilter " AND ScriptBlockText CONTAIN "-Property ")) OR ((ScriptBlockText CONTAIN "New-CimInstance " AND ScriptBlockText CONTAIN "-Namespace root/subscription " AND ScriptBlockText CONTAIN "-ClassName CommandLineEventConsumer " AND ScriptBlockText CONTAIN "-Property ")))
