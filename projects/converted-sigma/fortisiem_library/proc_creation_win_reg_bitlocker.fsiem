# Title: Suspicious Reg Add BitLocker
# ID: 0e0255bf-2548-47b8-9582-c0955c9283f5
# Status: test
# Level: high
# Author: frack113
# Date: 2021-11-15
# Tags: attack.impact, attack.t1486
# Description: Detects suspicious addition to BitLocker related registry keys via the reg.exe utility
# Converted by: Sigma Universal SIEM/EDR CLI

((CommandLine CONTAIN "REG" AND CommandLine CONTAIN "ADD" AND CommandLine CONTAIN "\\SOFTWARE\\Policies\\Microsoft\\FVE" AND CommandLine CONTAIN "/v" AND CommandLine CONTAIN "/f") AND (CommandLine CONTAIN "EnableBDEWithNoTPM" OR CommandLine CONTAIN "UseAdvancedStartup" OR CommandLine CONTAIN "UseTPM" OR CommandLine CONTAIN "UseTPMKey" OR CommandLine CONTAIN "UseTPMKeyPIN" OR CommandLine CONTAIN "RecoveryKeyMessageSource" OR CommandLine CONTAIN "UseTPMPIN" OR CommandLine CONTAIN "RecoveryKeyMessage"))
