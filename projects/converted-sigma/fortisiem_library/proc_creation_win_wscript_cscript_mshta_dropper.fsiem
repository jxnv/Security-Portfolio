# Title: Potential Dropper Script Execution Via WScript/CScript/MSHTA
# ID: cea72823-df4d-4567-950c-0b579eaf0846
# Status: test
# Level: medium
# Author: Margaritis Dimitrios (idea), Florian Roth (Nextron Systems), oscd.community, Nasreddine Bencherchali (Nextron Systems), Dave Johnson
# Date: 2019-01-16
# Tags: attack.execution, attack.t1059.005, attack.t1059.007
# Description: Detects wscript/cscript/mshta executions of scripts located in user directories
# Converted by: Sigma Universal SIEM/EDR CLI

(((Image="*\\wscript.exe" OR Image="*\\cscript.exe" OR Image="*\\mshta.exe")) AND ((CommandLine CONTAIN ".hta" OR CommandLine CONTAIN ".js" OR CommandLine CONTAIN ".jse" OR CommandLine CONTAIN ".vba" OR CommandLine CONTAIN ".vbe" OR CommandLine CONTAIN ".vbs" OR CommandLine CONTAIN ".wsf" OR CommandLine CONTAIN ".wsh")) AND ((CommandLine CONTAIN ":\\Perflogs\\" OR CommandLine CONTAIN ":\\Temp\\" OR CommandLine CONTAIN ":\\Tmp\\" OR CommandLine CONTAIN ":\\Users\\Public\\" OR CommandLine CONTAIN ":\\Windows\\Temp\\" OR CommandLine CONTAIN "\\AppData\\Local\\Temp\\" OR CommandLine CONTAIN "\\AppData\\Roaming\\Temp\\" OR CommandLine CONTAIN "\\Start Menu\\Programs\\Startup\\" OR CommandLine CONTAIN "\\Temporary Internet" OR CommandLine CONTAIN "\\Windows\\Temp" OR CommandLine CONTAIN "%LocalAppData%\\Temp\\" OR CommandLine CONTAIN "%TEMP%" OR CommandLine CONTAIN "%TMP%")))
