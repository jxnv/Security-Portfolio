# Title: Linux Remote System Discovery
# ID: 11063ec2-de63-4153-935e-b1a8b9e616f1
# Status: test
# Level: low
# Author: Alejandro Ortuno, oscd.community
# Date: 2020-10-22
# Tags: attack.discovery, attack.t1018
# Description: Detects the enumeration of other remote systems.
# Converted by: Sigma Universal SIEM/EDR CLI

((Image="*/arp" AND CommandLine CONTAIN "-a") OR (Image="*/ping" AND (CommandLine CONTAIN " 10." OR CommandLine CONTAIN " 192.168." OR CommandLine CONTAIN " 172.16." OR CommandLine CONTAIN " 172.17." OR CommandLine CONTAIN " 172.18." OR CommandLine CONTAIN " 172.19." OR CommandLine CONTAIN " 172.20." OR CommandLine CONTAIN " 172.21." OR CommandLine CONTAIN " 172.22." OR CommandLine CONTAIN " 172.23." OR CommandLine CONTAIN " 172.24." OR CommandLine CONTAIN " 172.25." OR CommandLine CONTAIN " 172.26." OR CommandLine CONTAIN " 172.27." OR CommandLine CONTAIN " 172.28." OR CommandLine CONTAIN " 172.29." OR CommandLine CONTAIN " 172.30." OR CommandLine CONTAIN " 172.31." OR CommandLine CONTAIN " 127." OR CommandLine CONTAIN " 169.254.")))
