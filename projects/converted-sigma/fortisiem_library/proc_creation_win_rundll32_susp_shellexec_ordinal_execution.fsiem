# Title: Suspicious ShellExec_RunDLL Call Via Ordinal
# ID: 8823e85d-31d8-473e-b7f4-92da070f0fc6
# Status: test
# Level: high
# Author: Swachchhanda Shrawan Poudel
# Date: 2024-12-01
# Tags: attack.stealth, attack.t1218.011
# Description: Detects suspicious call to the "ShellExec_RunDLL" exported function of SHELL32.DLL through the ordinal number to launch other commands.
# Adversary might only use the ordinal number in order to bypass existing detection that alert on usage of ShellExec_RunDLL on CommandLine.
# Converted by: Sigma Universal SIEM/EDR CLI

(((ParentCommandLine CONTAIN "SHELL32.DLL") AND ((ParentCommandLine CONTAIN "#568" OR ParentCommandLine CONTAIN "#570" OR ParentCommandLine CONTAIN "#572" OR ParentCommandLine CONTAIN "#576"))) AND (((Image="*\\bash.exe" OR Image="*\\bitsadmin.exe" OR Image="*\\cmd.exe" OR Image="*\\cscript.exe" OR Image="*\\curl.exe" OR Image="*\\mshta.exe" OR Image="*\\msiexec.exe" OR Image="*\\msxsl.exe" OR Image="*\\odbcconf.exe" OR Image="*\\powershell.exe" OR Image="*\\pwsh.exe" OR Image="*\\regsvr32.exe" OR Image="*\\schtasks.exe" OR Image="*\\wmic.exe" OR Image="*\\wscript.exe")) OR (((ParentCommandLine CONTAIN "comspec" OR ParentCommandLine CONTAIN "iex" OR ParentCommandLine CONTAIN "Invoke-" OR ParentCommandLine CONTAIN "msiexec" OR ParentCommandLine CONTAIN "odbcconf" OR ParentCommandLine CONTAIN "regsvr32")) OR ((ParentCommandLine CONTAIN "\\Desktop\\" OR ParentCommandLine CONTAIN "\\ProgramData\\" OR ParentCommandLine CONTAIN "\\Temp\\" OR ParentCommandLine CONTAIN "\\Users\\Public\\")))))
