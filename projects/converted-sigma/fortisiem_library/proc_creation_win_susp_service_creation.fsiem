# Title: Suspicious New Service Creation
# ID: 17a1be64-8d88-40bf-b5ff-a4f7a50ebcc8
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-07-14
# Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
# Description: Detects creation of a new service via "sc" command or the powershell "new-service" cmdlet with suspicious binary paths
# Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine CONTAIN "New-Service" AND CommandLine CONTAIN "-BinaryPathName")) OR (Image="*\\sc.exe" AND (CommandLine CONTAIN "create" AND CommandLine CONTAIN "binPath="))) AND ((CommandLine CONTAIN "powershell" OR CommandLine CONTAIN "mshta" OR CommandLine CONTAIN "wscript" OR CommandLine CONTAIN "cscript" OR CommandLine CONTAIN "svchost" OR CommandLine CONTAIN "dllhost" OR CommandLine CONTAIN "cmd " OR CommandLine CONTAIN "cmd.exe /c" OR CommandLine CONTAIN "cmd.exe /k" OR CommandLine CONTAIN "cmd.exe /r" OR CommandLine CONTAIN "rundll32" OR CommandLine CONTAIN "C:\\Users\\Public" OR CommandLine CONTAIN "\\Downloads\\" OR CommandLine CONTAIN "\\Desktop\\" OR CommandLine CONTAIN "\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\" OR CommandLine CONTAIN "C:\\Windows\\TEMP\\" OR CommandLine CONTAIN "\\AppData\\Local\\Temp")))
