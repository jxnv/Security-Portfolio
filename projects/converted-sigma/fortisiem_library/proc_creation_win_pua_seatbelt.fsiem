# Title: PUA - Seatbelt Execution
# ID: 38646daa-e78f-4ace-9de0-55547b2d30da
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-10-18
# Tags: attack.discovery, attack.t1526, attack.t1087, attack.t1083
# Description: Detects the execution of the PUA/Recon tool Seatbelt via PE information of command line parameters
# Converted by: Sigma Universal SIEM/EDR CLI

(((Image="*\\Seatbelt.exe") OR (OriginalFileName = "Seatbelt.exe") OR (Description = "Seatbelt") OR ((CommandLine CONTAIN " DpapiMasterKeys" OR CommandLine CONTAIN " InterestingProcesses" OR CommandLine CONTAIN " InterestingFiles" OR CommandLine CONTAIN " CertificateThumbprints" OR CommandLine CONTAIN " ChromiumBookmarks" OR CommandLine CONTAIN " ChromiumHistory" OR CommandLine CONTAIN " ChromiumPresence" OR CommandLine CONTAIN " CloudCredentials" OR CommandLine CONTAIN " CredEnum" OR CommandLine CONTAIN " CredGuard" OR CommandLine CONTAIN " FirefoxHistory" OR CommandLine CONTAIN " ProcessCreationEvents"))) OR (((CommandLine CONTAIN " -group=misc" OR CommandLine CONTAIN " -group=remote" OR CommandLine CONTAIN " -group=chromium" OR CommandLine CONTAIN " -group=slack" OR CommandLine CONTAIN " -group=system" OR CommandLine CONTAIN " -group=user" OR CommandLine CONTAIN " -group=all")) AND (CommandLine CONTAIN " -outputfile=")))
