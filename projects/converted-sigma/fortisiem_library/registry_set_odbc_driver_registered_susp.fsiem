# Title: Potentially Suspicious ODBC Driver Registered
# ID: e4d22291-f3d5-4b78-9a0c-a1fbaf32a6a4
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-05-23
# Tags: attack.credential-access, attack.persistence, attack.t1003
# Description: Detects the registration of a new ODBC driver where the driver is located in a potentially suspicious location
# Converted by: Sigma Universal SIEM/EDR CLI

(TargetObject CONTAIN "\\SOFTWARE\\ODBC\\ODBCINST.INI\\" AND (TargetObject="*\\Driver" OR TargetObject="*\\Setup") AND (Details CONTAIN ":\\PerfLogs\\" OR Details CONTAIN ":\\ProgramData\\" OR Details CONTAIN ":\\Temp\\" OR Details CONTAIN ":\\Users\\Public\\" OR Details CONTAIN ":\\Windows\\Registration\\CRMLog" OR Details CONTAIN ":\\Windows\\System32\\com\\dmp\\" OR Details CONTAIN ":\\Windows\\System32\\FxsTmp\\" OR Details CONTAIN ":\\Windows\\System32\\Microsoft\\Crypto\\RSA\\MachineKeys\\" OR Details CONTAIN ":\\Windows\\System32\\spool\\drivers\\color\\" OR Details CONTAIN ":\\Windows\\System32\\spool\\PRINTERS\\" OR Details CONTAIN ":\\Windows\\System32\\spool\\SERVERS\\" OR Details CONTAIN ":\\Windows\\System32\\Tasks_Migrated\\" OR Details CONTAIN ":\\Windows\\System32\\Tasks\\Microsoft\\Windows\\SyncCenter\\" OR Details CONTAIN ":\\Windows\\SysWOW64\\com\\dmp\\" OR Details CONTAIN ":\\Windows\\SysWOW64\\FxsTmp\\" OR Details CONTAIN ":\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\PLA\\System\\" OR Details CONTAIN ":\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\SyncCenter\\" OR Details CONTAIN ":\\Windows\\Tasks\\" OR Details CONTAIN ":\\Windows\\Temp\\" OR Details CONTAIN ":\\Windows\\Tracing\\" OR Details CONTAIN "\\AppData\\Local\\Temp\\" OR Details CONTAIN "\\AppData\\Roaming\\"))
