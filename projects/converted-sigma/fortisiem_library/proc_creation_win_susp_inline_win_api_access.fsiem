# Title: Potential WinAPI Calls Via CommandLine
# ID: ba3f5c1b-6272-4119-9dbd-0bc8d21c2702
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-09-06
# Tags: attack.execution, attack.t1106
# Description: Detects the use of WinAPI Functions via the commandline. As seen used by threat actors via the tool winapiexec
# Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAIN "AddSecurityPackage" OR CommandLine CONTAIN "AdjustTokenPrivileges" OR CommandLine CONTAIN "Advapi32" OR CommandLine CONTAIN "CloseHandle" OR CommandLine CONTAIN "CreateProcessWithToken" OR CommandLine CONTAIN "CreatePseudoConsole" OR CommandLine CONTAIN "CreateRemoteThread" OR CommandLine CONTAIN "CreateThread" OR CommandLine CONTAIN "CreateUserThread" OR CommandLine CONTAIN "DangerousGetHandle" OR CommandLine CONTAIN "DuplicateTokenEx" OR CommandLine CONTAIN "EnumerateSecurityPackages" OR CommandLine CONTAIN "FreeHGlobal" OR CommandLine CONTAIN "FreeLibrary" OR CommandLine CONTAIN "GetDelegateForFunctionPointer" OR CommandLine CONTAIN "GetLogonSessionData" OR CommandLine CONTAIN "GetModuleHandle" OR CommandLine CONTAIN "GetProcAddress" OR CommandLine CONTAIN "GetProcessHandle" OR CommandLine CONTAIN "GetTokenInformation" OR CommandLine CONTAIN "ImpersonateLoggedOnUser" OR CommandLine CONTAIN "kernel32" OR CommandLine CONTAIN "LoadLibrary" OR CommandLine CONTAIN "memcpy" OR CommandLine CONTAIN "MiniDumpWriteDump" OR CommandLine CONTAIN "ntdll" OR CommandLine CONTAIN "OpenDesktop" OR CommandLine CONTAIN "OpenProcess" OR CommandLine CONTAIN "OpenProcessToken" OR CommandLine CONTAIN "OpenThreadToken" OR CommandLine CONTAIN "OpenWindowStation" OR CommandLine CONTAIN "PtrToString" OR CommandLine CONTAIN "QueueUserApc" OR CommandLine CONTAIN "ReadProcessMemory" OR CommandLine CONTAIN "RevertToSelf" OR CommandLine CONTAIN "RtlCreateUserThread" OR CommandLine CONTAIN "secur32" OR CommandLine CONTAIN "SetThreadToken" OR CommandLine CONTAIN "VirtualAlloc" OR CommandLine CONTAIN "VirtualFree" OR CommandLine CONTAIN "VirtualProtect" OR CommandLine CONTAIN "WaitForSingleObject" OR CommandLine CONTAIN "WriteInt32" OR CommandLine CONTAIN "WriteProcessMemory" OR CommandLine CONTAIN "ZeroFreeGlobalAllocUnicode")) AND NOT (((ParentImage="*\\CompatTelRunner.exe" AND (CommandLine CONTAIN "FreeHGlobal" OR CommandLine CONTAIN "PtrToString" OR CommandLine CONTAIN "kernel32" OR CommandLine CONTAIN "CloseHandle")) OR (Image="*\\MpCmdRun.exe" AND CommandLine CONTAIN "GetLoadLibraryWAddress32"))))
