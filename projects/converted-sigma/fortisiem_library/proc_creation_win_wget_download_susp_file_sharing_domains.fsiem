(((CommandLine="*.ps1" OR CommandLine="*.ps1'" OR CommandLine="*.ps1\"" OR CommandLine="*.dat" OR CommandLine="*.dat'" OR CommandLine="*.dat\"" OR CommandLine="*.msi" OR CommandLine="*.msi'" OR CommandLine="*.msi\"" OR CommandLine="*.bat" OR CommandLine="*.bat'" OR CommandLine="*.bat\"" OR CommandLine="*.exe" OR CommandLine="*.exe'" OR CommandLine="*.exe\"" OR CommandLine="*.vbs" OR CommandLine="*.vbs'" OR CommandLine="*.vbs\"" OR CommandLine="*.vbe" OR CommandLine="*.vbe'" OR CommandLine="*.vbe\"" OR CommandLine="*.hta" OR CommandLine="*.hta'" OR CommandLine="*.hta\"" OR CommandLine="*.dll" OR CommandLine="*.dll'" OR CommandLine="*.dll\"" OR CommandLine="*.psm1" OR CommandLine="*.psm1'" OR CommandLine="*.psm1\"")) AND ((CommandLine=regex("\\s-O\\s")) OR (CommandLine CONTAIN "--output-document")) AND (CommandLine CONTAIN "http") AND ((Image="*\\wget.exe") OR (OriginalFileName = "wget.exe")) AND ((CommandLine CONTAIN ".githubusercontent.com" OR CommandLine CONTAIN "0x0.st" OR CommandLine CONTAIN "anonfiles.com" OR CommandLine CONTAIN "bashupload.com" OR CommandLine CONTAIN "cdn.discordapp.com" OR CommandLine CONTAIN "chunk.io" OR CommandLine CONTAIN "ddns.net" OR CommandLine CONTAIN "dl.dropboxusercontent.com" OR CommandLine CONTAIN "ghostbin.co" OR CommandLine CONTAIN "github.com" OR CommandLine CONTAIN "glitch.me" OR CommandLine CONTAIN "gofile.io" OR CommandLine CONTAIN "hastebin.com" OR CommandLine CONTAIN "mediafire.com" OR CommandLine CONTAIN "mega.nz" OR CommandLine CONTAIN "onrender.com" OR CommandLine CONTAIN "pages.dev" OR CommandLine CONTAIN "paste.ee" OR CommandLine CONTAIN "pastebin.com" OR CommandLine CONTAIN "pastebin.pl" OR CommandLine CONTAIN "pastetext.net" OR CommandLine CONTAIN "pixeldrain.com" OR CommandLine CONTAIN "privatlab.com" OR CommandLine CONTAIN "privatlab.net" OR CommandLine CONTAIN "send.exploit.in" OR CommandLine CONTAIN "sendspace.com" OR CommandLine CONTAIN "storage.googleapis.com" OR CommandLine CONTAIN "storjshare.io" OR CommandLine CONTAIN "supabase.co" OR CommandLine CONTAIN "temp.sh" OR CommandLine CONTAIN "transfer.sh" OR CommandLine CONTAIN "trycloudflare.com" OR CommandLine CONTAIN "ufile.io" OR CommandLine CONTAIN "w3spaces.com" OR CommandLine CONTAIN "workers.dev" OR CommandLine CONTAIN "x0.at")))
