# Title: HackTool - LaZagne Execution
# ID: c2b86e67-b880-4eec-b045-50bc98ef4844
# Status: experimental
# Level: medium
# Author: Nasreddine Bencherchali, Swachchhanda Shrawan Poudel (Nextron Systems)
# Date: 2024-06-24
# Tags: attack.credential-access
# Description: Detects the execution of the LaZagne. A utility used to retrieve multiple types of passwords stored on a local computer.
# LaZagne has been leveraged multiple times by threat actors in order to dump credentials.
# Converted by: Sigma Universal SIEM/EDR CLI

((((Image CONTAIN ":\\PerfLogs\\" OR Image CONTAIN ":\\ProgramData\\" OR Image CONTAIN ":\\Temp\\" OR Image CONTAIN ":\\Tmp\\" OR Image CONTAIN ":\\Users\\Public\\" OR Image CONTAIN ":\\Windows\\Temp\\" OR Image CONTAIN "\\$Recycle.bin" OR Image CONTAIN "\\AppData\\" OR Image CONTAIN "\\Desktop\\" OR Image CONTAIN "\\Downloads\\" OR Image CONTAIN "\\Favorites\\" OR Image CONTAIN "\\Links\\" OR Image CONTAIN "\\Music\\" OR Image CONTAIN "\\Photos\\" OR Image CONTAIN "\\Pictures\\" OR Image CONTAIN "\\Saved Games\\" OR Image CONTAIN "\\Searches\\" OR Image CONTAIN "\\Users\\Contacts\\" OR Image CONTAIN "\\Users\\Default\\" OR Image CONTAIN "\\Users\\Searches\\" OR Image CONTAIN "\\Videos\\" OR Image CONTAIN "\\Windows\\addins\\" OR Image CONTAIN "\\Windows\\Fonts\\" OR Image CONTAIN "\\Windows\\IME\\") AND (CommandLine="*.exe all" OR CommandLine="*.exe browsers" OR CommandLine="*.exe chats" OR CommandLine="*.exe databases" OR CommandLine="*.exe games" OR CommandLine="*.exe git" OR CommandLine="*.exe mails" OR CommandLine="*.exe maven" OR CommandLine="*.exe memory" OR CommandLine="*.exe multimedia" OR CommandLine="*.exe sysadmin" OR CommandLine="*.exe unused" OR CommandLine="*.exe wifi" OR CommandLine="*.exe windows")) OR (Image="*\\lazagne.exe")) OR (((CommandLine CONTAIN " all " OR CommandLine CONTAIN " browsers " OR CommandLine CONTAIN " chats " OR CommandLine CONTAIN " databases " OR CommandLine CONTAIN " games " OR CommandLine CONTAIN " mails " OR CommandLine CONTAIN " maven " OR CommandLine CONTAIN " memory " OR CommandLine CONTAIN " multimedia " OR CommandLine CONTAIN " php " OR CommandLine CONTAIN " svn " OR CommandLine CONTAIN " sysadmin " OR CommandLine CONTAIN " unused " OR CommandLine CONTAIN " wifi ")) AND ((CommandLine CONTAIN "-1Password" OR CommandLine CONTAIN "-apachedirectorystudio" OR CommandLine CONTAIN "-autologon" OR CommandLine CONTAIN "-ChromiumBased" OR CommandLine CONTAIN "-coreftp" OR CommandLine CONTAIN "-credfiles" OR CommandLine CONTAIN "-credman" OR CommandLine CONTAIN "-cyberduck" OR CommandLine CONTAIN "-dbvis" OR CommandLine CONTAIN "-EyeCon" OR CommandLine CONTAIN "-filezilla" OR CommandLine CONTAIN "-filezillaserver" OR CommandLine CONTAIN "-ftpnavigator" OR CommandLine CONTAIN "-galconfusion" OR CommandLine CONTAIN "-gitforwindows" OR CommandLine CONTAIN "-hashdump" OR CommandLine CONTAIN "-iisapppool" OR CommandLine CONTAIN "-IISCentralCertP" OR CommandLine CONTAIN "-kalypsomedia" OR CommandLine CONTAIN "-keepass" OR CommandLine CONTAIN "-keepassconfig" OR CommandLine CONTAIN "-lsa_secrets" OR CommandLine CONTAIN "-mavenrepositories" OR CommandLine CONTAIN "-memory_dump" OR CommandLine CONTAIN "-Mozilla" OR CommandLine CONTAIN "-mRemoteNG" OR CommandLine CONTAIN "-mscache" OR CommandLine CONTAIN "-opensshforwindows" OR CommandLine CONTAIN "-openvpn" OR CommandLine CONTAIN "-outlook" OR CommandLine CONTAIN "-pidgin" OR CommandLine CONTAIN "-postgresql" OR CommandLine CONTAIN "-psi-im" OR CommandLine CONTAIN "-puttycm" OR CommandLine CONTAIN "-pypykatz" OR CommandLine CONTAIN "-Rclone" OR CommandLine CONTAIN "-rdpmanager" OR CommandLine CONTAIN "-robomongo" OR CommandLine CONTAIN "-roguestale" OR CommandLine CONTAIN "-skype" OR CommandLine CONTAIN "-SQLDeveloper" OR CommandLine CONTAIN "-squirrel" OR CommandLine CONTAIN "-tortoise" OR CommandLine CONTAIN "-turba" OR CommandLine CONTAIN "-UCBrowser" OR CommandLine CONTAIN "-unattended" OR CommandLine CONTAIN "-vault" OR CommandLine CONTAIN "-vaultfiles" OR CommandLine CONTAIN "-vnc" OR CommandLine CONTAIN "-winscp"))))
