# Description: Detects suspicious DNS queries to Monero mining pools
# Converted by: Sigma Universal SIEM/EDR CLI

((query CONTAIN "pool.minexmr.com" OR query CONTAIN "fr.minexmr.com" OR query CONTAIN "de.minexmr.com" OR query CONTAIN "sg.minexmr.com" OR query CONTAIN "ca.minexmr.com" OR query CONTAIN "us-west.minexmr.com" OR query CONTAIN "pool.supportxmr.com" OR query CONTAIN "mine.c3pool.com" OR query CONTAIN "xmr-eu1.nanopool.org" OR query CONTAIN "xmr-eu2.nanopool.org" OR query CONTAIN "xmr-us-east1.nanopool.org" OR query CONTAIN "xmr-us-west1.nanopool.org" OR query CONTAIN "xmr-asia1.nanopool.org" OR query CONTAIN "xmr-jp1.nanopool.org" OR query CONTAIN "xmr-au1.nanopool.org" OR query CONTAIN "xmr.2miners.com" OR query CONTAIN "xmr.hashcity.org" OR query CONTAIN "xmr.f2pool.com" OR query CONTAIN "xmrpool.eu" OR query CONTAIN "pool.hashvault.pro"))
