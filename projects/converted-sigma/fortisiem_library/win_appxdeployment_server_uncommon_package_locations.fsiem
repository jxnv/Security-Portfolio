# Title: AppX Located in Uncommon Directory Added to Deployment Pipeline
# ID: c977cb50-3dff-4a9f-b873-9290f56132f1
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-01-11
# Tags: attack.stealth
# Description: Detects an appx package that was added to the pipeline of the "to be processed" packages that is located in uncommon locations.
# Converted by: Sigma Universal SIEM/EDR CLI

((EventID = "854") AND NOT ((((Path CONTAIN ":/Program%20Files" OR Path CONTAIN ":/Windows/System32/" OR Path CONTAIN ":\\Program Files (x86)\\" OR Path CONTAIN ":\\Program Files\\" OR Path CONTAIN ":\\Windows\\ImmersiveControlPanel\\" OR Path CONTAIN ":\\Windows\\PrintDialog\\" OR Path CONTAIN ":\\Windows\\SystemApps\\" OR Path CONTAIN "AppData/Local/Temp/WinGet/Microsoft.Winget.Source" OR Path CONTAIN "x-windowsupdate://")) OR ((Path CONTAIN "https://installer.teams.static.microsoft/" OR Path CONTAIN "https://res.cdn.office.net" OR Path CONTAIN "https://statics.teams.cdn.live.net/" OR Path CONTAIN "https://statics.teams.cdn.office.net/" OR Path CONTAIN "microsoft.com")))) AND NOT (((Path CONTAIN "AppData\\Local\\Microsoft\\OneDrive\\") OR ((Path CONTAIN "AppData/Local/Temp/WinGet/Microsoft.Winget.Source" OR Path CONTAIN "AppData\\Local\\Temp\\WinGet\\Microsoft.Winget.Source")) OR (Path CONTAIN "x-windowsupdate://"))))
