# Title: Security Software Discovery - MacOs
# ID: 0ed75b9c-c73b-424d-9e7d-496cd565fbe0
# Status: test
# Level: medium
# Author: Daniil Yugoslavskiy, oscd.community
# Date: 2020-10-19
# Tags: attack.discovery, attack.t1518.001
# Description: Detects usage of system utilities (only grep for now) to discover security software discovery
# Converted by: Sigma Universal SIEM/EDR CLI

((Image = "/usr/bin/grep") AND (((CommandLine CONTAIN "nessusd" OR CommandLine CONTAIN "santad" OR CommandLine CONTAIN "CbDefense" OR CommandLine CONTAIN "falcond" OR CommandLine CONTAIN "td-agent" OR CommandLine CONTAIN "packetbeat" OR CommandLine CONTAIN "filebeat" OR CommandLine CONTAIN "auditbeat" OR CommandLine CONTAIN "osqueryd" OR CommandLine CONTAIN "BlockBlock" OR CommandLine CONTAIN "LuLu")) OR ((CommandLine CONTAIN "Little" AND CommandLine CONTAIN "Snitch"))))
