# Title: PUA - Suspicious ActiveDirectory Enumeration Via AdFind.EXE
# ID: 455b9d50-15a1-4b99-853f-8d37655a4c1b
# Status: test
# Level: high
# Author: frack113
# Date: 2021-12-13
# Tags: attack.discovery, attack.t1087.002
# Description: Detects active directory enumeration activity using known AdFind CLI flags
# Converted by: Sigma Universal SIEM/EDR CLI

((CommandLine CONTAIN "-sc admincountdmp") OR (CommandLine CONTAIN "-sc exchaddresses") OR ((CommandLine CONTAIN "lockoutduration" OR CommandLine CONTAIN "lockoutthreshold" OR CommandLine CONTAIN "lockoutobservationwindow" OR CommandLine CONTAIN "maxpwdage" OR CommandLine CONTAIN "minpwdage" OR CommandLine CONTAIN "minpwdlength" OR CommandLine CONTAIN "pwdhistorylength" OR CommandLine CONTAIN "pwdproperties")))
