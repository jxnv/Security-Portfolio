# Title: Suspicious Greedy Compression Using Rar.EXE
# ID: afe52666-401e-4a02-b4ff-5d128990b8cb
# Status: test
# Level: high
# Author: X__Junior (Nextron Systems), Florian Roth (Nextron Systems)
# Date: 2022-12-15
# Tags: attack.execution, attack.t1059
# Description: Detects RAR usage that creates an archive from a suspicious folder, either a system folder or one of the folders often used by attackers for staging purposes
# Converted by: Sigma Universal SIEM/EDR CLI

((((Image="*\\rar.exe") OR (Description = "Command line RAR")) OR ((CommandLine CONTAIN ".exe a " OR CommandLine CONTAIN " a -m"))) AND (((CommandLine CONTAIN " -hp" AND CommandLine CONTAIN " -r ")) AND ((CommandLine CONTAIN " ?:\\\\\\*." OR CommandLine CONTAIN " ?:\\\\\\\\\\*." OR CommandLine CONTAIN " ?:\\$Recycle.bin\\" OR CommandLine CONTAIN " ?:\\PerfLogs\\" OR CommandLine CONTAIN " ?:\\Temp" OR CommandLine CONTAIN " ?:\\Users\\Public\\" OR CommandLine CONTAIN " ?:\\Windows\\" OR CommandLine CONTAIN " %public%"))))
