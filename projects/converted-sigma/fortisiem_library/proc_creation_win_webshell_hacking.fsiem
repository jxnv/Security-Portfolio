# Title: Webshell Hacking Activity Patterns
# ID: 4ebc877f-4612-45cb-b3a5-8e3834db36c9
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-03-17
# Tags: attack.persistence, attack.discovery, attack.t1505.003, attack.t1018, attack.t1033, attack.t1087
# Description: Detects certain parent child patterns found in cases in which a web shell is used to perform certain credential dumping or exfiltration activities on a compromised system
# Converted by: Sigma Universal SIEM/EDR CLI

((((ParentImage="*\\java.exe" OR ParentImage="*\\javaw.exe") AND (ParentImage CONTAIN "-tomcat-" OR ParentImage CONTAIN "\\tomcat")) OR ((ParentImage="*\\java.exe" OR ParentImage="*\\javaw.exe") AND (CommandLine CONTAIN "catalina.jar" OR CommandLine CONTAIN "CATALINA_HOME")) OR ((ParentImage="*\\caddy.exe" OR ParentImage="*\\httpd.exe" OR ParentImage="*\\nginx.exe" OR ParentImage="*\\php-cgi.exe" OR ParentImage="*\\w3wp.exe" OR ParentImage="*\\ws_tomcatservice.exe"))) AND (((CommandLine CONTAIN "rundll32" AND CommandLine CONTAIN "comsvcs")) OR ((CommandLine CONTAIN " -hp" AND CommandLine CONTAIN " a " AND CommandLine CONTAIN " -m")) OR ((CommandLine CONTAIN "net" AND CommandLine CONTAIN " user " AND CommandLine CONTAIN " /add")) OR ((CommandLine CONTAIN "net" AND CommandLine CONTAIN " localgroup " AND CommandLine CONTAIN " administrators " AND CommandLine CONTAIN "/add")) OR ((Image="*\\ntdsutil.exe" OR Image="*\\ldifde.exe" OR Image="*\\adfind.exe" OR Image="*\\procdump.exe" OR Image="*\\Nanodump.exe" OR Image="*\\vssadmin.exe" OR Image="*\\fsutil.exe")) OR ((CommandLine CONTAIN " -decode " OR CommandLine CONTAIN " -NoP " OR CommandLine CONTAIN " -W Hidden " OR CommandLine CONTAIN " /decode " OR CommandLine CONTAIN " /ticket:" OR CommandLine CONTAIN " sekurlsa" OR CommandLine CONTAIN ".dmp full" OR CommandLine CONTAIN ".downloadfile(" OR CommandLine CONTAIN ".downloadstring(" OR CommandLine CONTAIN "FromBase64String" OR CommandLine CONTAIN "process call create" OR CommandLine CONTAIN "reg save " OR CommandLine CONTAIN "whoami /priv"))))
