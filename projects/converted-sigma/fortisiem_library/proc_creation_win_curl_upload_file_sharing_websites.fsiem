# Title: Curl File Upload To File Sharing Websites
# ID: e328cc73-f92a-42fb-b3fa-7c2cffda981a
# Status: experimental
# Level: high
# Author: Swachchhanda Shrawan Poudel (Nextron Systems)
# Date: 2026-03-29
# Tags: attack.exfiltration, attack.t1567.002
# Description: Detects usage of curl to upload files to known file sharing domains, which may indicate data exfiltration.
# Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAIN "0x0.st" OR CommandLine CONTAIN "bashupload.com" OR CommandLine CONTAIN "chunk.io" OR CommandLine CONTAIN "file.io" OR CommandLine CONTAIN "filebin.net" OR CommandLine CONTAIN "pastebin" OR CommandLine CONTAIN "send.firefox.com" OR CommandLine CONTAIN "temp.sh" OR CommandLine CONTAIN "transfer.sh" OR CommandLine CONTAIN "ufile.io" OR CommandLine CONTAIN "uploadfiles.io" OR CommandLine CONTAIN "wetransfer.com" OR CommandLine CONTAIN "x0.at")) AND (((CommandLine CONTAIN " --form" OR CommandLine CONTAIN " --upload-file" OR CommandLine CONTAIN " --data" OR CommandLine CONTAIN " -X POST" OR CommandLine CONTAIN " --request POST ")) OR ((CommandLine=regex("\\s-[FTd]\\s") OR CommandLine=regex("\\s-sT\\s")))) AND ((Image="*\\curl.exe") OR (OriginalFileName = "curl.exe")))
