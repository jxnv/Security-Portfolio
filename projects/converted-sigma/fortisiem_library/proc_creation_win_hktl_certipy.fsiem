# Title: HackTool - Certipy Execution
# ID: 6938366d-8954-4ddc-baff-c830b3ba8fcd
# Status: test
# Level: high
# Author: pH-T (Nextron Systems), Sittikorn Sangrattanapitak
# Date: 2023-04-17
# Tags: attack.discovery, attack.credential-access, attack.t1649
# Description: Detects Certipy execution, a tool for Active Directory Certificate Services enumeration and abuse based on PE metadata characteristics and common command line arguments.
# Converted by: Sigma Universal SIEM/EDR CLI

(((Image="*\\Certipy.exe") OR (OriginalFileName = "Certipy.exe") OR (Description CONTAIN "Certipy")) OR (((CommandLine CONTAIN " account " OR CommandLine CONTAIN " auth " OR CommandLine CONTAIN " cert " OR CommandLine CONTAIN " find " OR CommandLine CONTAIN " forge " OR CommandLine CONTAIN " ptt " OR CommandLine CONTAIN " relay " OR CommandLine CONTAIN " req " OR CommandLine CONTAIN " shadow " OR CommandLine CONTAIN " template ")) AND ((CommandLine CONTAIN " -bloodhound" OR CommandLine CONTAIN " -ca-pfx " OR CommandLine CONTAIN " -dc-ip " OR CommandLine CONTAIN " -kirbi" OR CommandLine CONTAIN " -old-bloodhound" OR CommandLine CONTAIN " -pfx " OR CommandLine CONTAIN " -target" OR CommandLine CONTAIN " -template" OR CommandLine CONTAIN " -username " OR CommandLine CONTAIN " -vulnerable" OR CommandLine CONTAIN "auth -pfx" OR CommandLine CONTAIN "shadow auto" OR CommandLine CONTAIN "shadow list"))))
