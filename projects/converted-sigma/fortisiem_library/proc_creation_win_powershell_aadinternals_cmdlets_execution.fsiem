# Title: AADInternals PowerShell Cmdlets Execution - ProccessCreation
# ID: c86500e9-a645-4680-98d7-f882c70c1ea3
# Status: test
# Level: high
# Author: Austin Songer (@austinsonger), Nasreddine Bencherchali (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems)
# Date: 2022-12-23
# Tags: attack.execution, attack.reconnaissance, attack.discovery, attack.credential-access, attack.impact
# Description: Detects ADDInternals Cmdlet execution. A tool for administering Azure AD and Office 365. Which can be abused by threat actors to attack Azure AD or Office 365.
# Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAIN "Add-AADInt" OR CommandLine CONTAIN "ConvertTo-AADInt" OR CommandLine CONTAIN "Disable-AADInt" OR CommandLine CONTAIN "Enable-AADInt" OR CommandLine CONTAIN "Export-AADInt" OR CommandLine CONTAIN "Find-AADInt" OR CommandLine CONTAIN "Get-AADInt" OR CommandLine CONTAIN "Grant-AADInt" OR CommandLine CONTAIN "Initialize-AADInt" OR CommandLine CONTAIN "Install-AADInt" OR CommandLine CONTAIN "Invoke-AADInt" OR CommandLine CONTAIN "Join-AADInt" OR CommandLine CONTAIN "New-AADInt" OR CommandLine CONTAIN "Open-AADInt" OR CommandLine CONTAIN "Read-AADInt" OR CommandLine CONTAIN "Register-AADInt" OR CommandLine CONTAIN "Remove-AADInt" OR CommandLine CONTAIN "Reset-AADInt" OR CommandLine CONTAIN "Resolve-AADInt" OR CommandLine CONTAIN "Restore-AADInt" OR CommandLine CONTAIN "Save-AADInt" OR CommandLine CONTAIN "Search-AADInt" OR CommandLine CONTAIN "Send-AADInt" OR CommandLine CONTAIN "Set-AADInt" OR CommandLine CONTAIN "Start-AADInt" OR CommandLine CONTAIN "Unprotect-AADInt" OR CommandLine CONTAIN "Update-AADInt")) AND (((Image="*\\powershell.exe" OR Image="*\\powershell_ise.exe" OR Image="*\\pwsh.exe")) OR ((OriginalFileName = "PowerShell.Exe" OR OriginalFileName = "pwsh.dll"))))
