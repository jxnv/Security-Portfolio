# Tags: attack.initial-access, attack.t1190
# Description: Detects known suspicious (default) user-agents related to scanning/recon tools
# Converted by: Sigma Universal SIEM/EDR CLI

((cs-user-agent CONTAIN "commix/" OR cs-user-agent CONTAIN "feroxbuster/" OR cs-user-agent CONTAIN "Fuzz Faster U Fool" OR cs-user-agent CONTAIN "GIS - AppSec Team - Project Vision" OR cs-user-agent CONTAIN "gobuster/" OR cs-user-agent CONTAIN "Nikto/" OR cs-user-agent CONTAIN "Nmap Scripting Engine" OR cs-user-agent CONTAIN "Recon-ng/v" OR cs-user-agent CONTAIN "sqlmap/" OR cs-user-agent CONTAIN "WhatWeb/" OR cs-user-agent CONTAIN "Wfuzz/" OR cs-user-agent CONTAIN "WPScan v" OR cs-user-agent CONTAIN "zgrab/"))
