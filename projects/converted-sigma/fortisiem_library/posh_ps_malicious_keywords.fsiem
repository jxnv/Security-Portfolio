# Title: Malicious PowerShell Keywords
# ID: f62176f3-8128-4faa-bf6c-83261322e5eb
# Status: test
# Level: medium
# Author: Sean Metcalf (source), Florian Roth (Nextron Systems)
# Date: 2017-03-05
# Tags: attack.execution, attack.t1059.001
# Description: Detects keywords from well-known PowerShell exploitation frameworks
# Converted by: Sigma Universal SIEM/EDR CLI

((ScriptBlockText CONTAIN "AdjustTokenPrivileges" OR ScriptBlockText CONTAIN "IMAGE_NT_OPTIONAL_HDR64_MAGIC" OR ScriptBlockText CONTAIN "Metasploit" OR ScriptBlockText CONTAIN "Microsoft.Win32.UnsafeNativeMethods" OR ScriptBlockText CONTAIN "Mimikatz" OR ScriptBlockText CONTAIN "MiniDumpWriteDump" OR ScriptBlockText CONTAIN "PAGE_EXECUTE_READ" OR ScriptBlockText CONTAIN "ReadProcessMemory.Invoke" OR ScriptBlockText CONTAIN "SE_PRIVILEGE_ENABLED" OR ScriptBlockText CONTAIN "SECURITY_DELEGATION" OR ScriptBlockText CONTAIN "TOKEN_ADJUST_PRIVILEGES" OR ScriptBlockText CONTAIN "TOKEN_ALL_ACCESS" OR ScriptBlockText CONTAIN "TOKEN_ASSIGN_PRIMARY" OR ScriptBlockText CONTAIN "TOKEN_DUPLICATE" OR ScriptBlockText CONTAIN "TOKEN_ELEVATION" OR ScriptBlockText CONTAIN "TOKEN_IMPERSONATE" OR ScriptBlockText CONTAIN "TOKEN_INFORMATION_CLASS" OR ScriptBlockText CONTAIN "TOKEN_PRIVILEGES" OR ScriptBlockText CONTAIN "TOKEN_QUERY"))
