# Title: Local Accounts Discovery
# ID: 502b42de-4306-40b4-9596-6f590c81f073
# Status: test
# Level: low
# Author: Timur Zinniatullin, Daniil Yugoslavskiy, oscd.community
# Date: 2019-10-21
# Tags: attack.discovery, attack.t1033, attack.t1087.001
# Description: Local accounts, System Owner/User discovery using operating systems utilities
# Converted by: Sigma Universal SIEM/EDR CLI

(((Image="*\\cmd.exe" AND (CommandLine CONTAIN " /c" AND CommandLine CONTAIN "dir " AND CommandLine CONTAIN "\\Users\\")) AND NOT ((CommandLine CONTAIN " rmdir "))) OR (((Image="*\\net.exe" OR Image="*\\net1.exe") AND CommandLine CONTAIN "user") AND NOT (((CommandLine CONTAIN "/domain" OR CommandLine CONTAIN "/add" OR CommandLine CONTAIN "/delete" OR CommandLine CONTAIN "/active" OR CommandLine CONTAIN "/expires" OR CommandLine CONTAIN "/passwordreq" OR CommandLine CONTAIN "/scriptpath" OR CommandLine CONTAIN "/times" OR CommandLine CONTAIN "/workstations")))) OR ((Image="*\\cmdkey.exe" AND CommandLine CONTAIN " /l") OR (((Image="*\\whoami.exe" OR Image="*\\quser.exe" OR Image="*\\qwinsta.exe")) OR ((OriginalFileName = "whoami.exe" OR OriginalFileName = "quser.exe" OR OriginalFileName = "qwinsta.exe"))) OR (Image="*\\wmic.exe" AND (CommandLine CONTAIN "useraccount" AND CommandLine CONTAIN "get"))))
