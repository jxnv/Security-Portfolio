# Title: PUA - Netcat Suspicious Execution
# ID: e31033fc-33f0-4020-9a16-faf9b31cbf08
# Status: test
# Level: high
# Author: frack113, Florian Roth (Nextron Systems)
# Date: 2021-07-21
# Tags: attack.command-and-control, attack.t1095
# Description: Detects execution of Netcat. Adversaries may use a non-application layer protocol for communication between host and C2 server or among infected hosts within a network
# Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAIN " -lvp " OR CommandLine CONTAIN " -lvnp" OR CommandLine CONTAIN " -l -v -p " OR CommandLine CONTAIN " -lv -p " OR CommandLine CONTAIN " -l --proxy-type http " OR CommandLine CONTAIN " -vnl --exec " OR CommandLine CONTAIN " -vnl -e " OR CommandLine CONTAIN " --lua-exec " OR CommandLine CONTAIN " --sh-exec ")) OR ((Image="*\\nc.exe" OR Image="*\\ncat.exe" OR Image="*\\netcat.exe")))
