# Title: Suspicious Package Installed - Linux
# ID: 700fb7e8-2981-401c-8430-be58e189e741
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-01-03
# Tags: attack.defense-impairment, attack.t1553.004
# Description: Detects installation of suspicious packages using system installation utilities
# Converted by: Sigma Universal SIEM/EDR CLI

((((Image="*/apt" OR Image="*/apt-get") AND CommandLine CONTAIN "install") OR (Image="*/dpkg" AND (CommandLine CONTAIN "--install" OR CommandLine CONTAIN "-i")) OR (Image="*/rpm" AND CommandLine CONTAIN "-i") OR (Image="*/yum" AND (CommandLine CONTAIN "localinstall" OR CommandLine CONTAIN "install"))) AND ((CommandLine CONTAIN "nmap" OR CommandLine CONTAIN " nc" OR CommandLine CONTAIN "netcat" OR CommandLine CONTAIN "wireshark" OR CommandLine CONTAIN "tshark" OR CommandLine CONTAIN "openconnect" OR CommandLine CONTAIN "proxychains" OR CommandLine CONTAIN "socat")))
