# Title: Potential Encoded PowerShell Patterns In CommandLine
# ID: cdf05894-89e7-4ead-b2b0-0a5f97a90f2f
# Status: test
# Level: low
# Author: Teymur Kheirkhabarov (idea), Vasiliy Burov (rule), oscd.community, Tim Shelton
# Date: 2020-10-11
# Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
# Description: Detects specific combinations of encoding methods in PowerShell via the commandline
# Converted by: Sigma Universal SIEM/EDR CLI

((((Image="*\\powershell.exe" OR Image="*\\pwsh.exe")) OR ((OriginalFileName = "PowerShell.EXE" OR OriginalFileName = "pwsh.dll"))) AND ((((CommandLine CONTAIN "ToInt" OR CommandLine CONTAIN "ToDecimal" OR CommandLine CONTAIN "ToByte" OR CommandLine CONTAIN "ToUint" OR CommandLine CONTAIN "ToSingle" OR CommandLine CONTAIN "ToSByte")) AND ((CommandLine CONTAIN "ToChar" OR CommandLine CONTAIN "ToString" OR CommandLine CONTAIN "String"))) OR (((CommandLine CONTAIN "char" AND CommandLine CONTAIN "join")) OR ((CommandLine CONTAIN "split" AND CommandLine CONTAIN "join")))))
