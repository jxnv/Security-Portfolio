# Title: Potentially Suspicious File Download From File Sharing Domain Via PowerShell.EXE
# ID: b6e04788-29e1-4557-bb14-77f761848ab8
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2024-02-23
# Tags: attack.execution
# Description: Detects potentially suspicious file downloads from file sharing domains using PowerShell.exe
# Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAIN ".DownloadString(" OR CommandLine CONTAIN ".DownloadFile(" OR CommandLine CONTAIN "Invoke-WebRequest " OR CommandLine CONTAIN "iwr " OR CommandLine CONTAIN "wget ")) AND (((Image="*\\powershell.exe" OR Image="*\\pwsh.exe")) OR ((OriginalFileName = "PowerShell.EXE" OR OriginalFileName = "pwsh.dll"))) AND ((CommandLine CONTAIN "0x0.st" OR CommandLine CONTAIN "anonfiles.com" OR CommandLine CONTAIN "bashupload.com" OR CommandLine CONTAIN "cdn.discordapp.com" OR CommandLine CONTAIN "chunk.io" OR CommandLine CONTAIN "ddns.net" OR CommandLine CONTAIN "dl.dropboxusercontent.com" OR CommandLine CONTAIN "ghostbin.co" OR CommandLine CONTAIN "glitch.me" OR CommandLine CONTAIN "gofile.io" OR CommandLine CONTAIN "hastebin.com" OR CommandLine CONTAIN "mediafire.com" OR CommandLine CONTAIN "mega.nz" OR CommandLine CONTAIN "onrender.com" OR CommandLine CONTAIN "pages.dev" OR CommandLine CONTAIN "paste.ee" OR CommandLine CONTAIN "pastebin.com" OR CommandLine CONTAIN "pastebin.pl" OR CommandLine CONTAIN "pastetext.net" OR CommandLine CONTAIN "pixeldrain.com" OR CommandLine CONTAIN "privatlab.com" OR CommandLine CONTAIN "privatlab.net" OR CommandLine CONTAIN "send.exploit.in" OR CommandLine CONTAIN "sendspace.com" OR CommandLine CONTAIN "storage.googleapis.com" OR CommandLine CONTAIN "storjshare.io" OR CommandLine CONTAIN "supabase.co" OR CommandLine CONTAIN "temp.sh" OR CommandLine CONTAIN "transfer.sh" OR CommandLine CONTAIN "trycloudflare.com" OR CommandLine CONTAIN "ufile.io" OR CommandLine CONTAIN "w3spaces.com" OR CommandLine CONTAIN "workers.dev" OR CommandLine CONTAIN "x0.at")))
