# Title: PUA - PingCastle Execution From Potentially Suspicious Parent
# ID: b37998de-a70b-4f33-b219-ec36bf433dc0
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
# Date: 2024-01-11
# Tags: attack.reconnaissance, attack.t1595
# Description: Detects the execution of PingCastle, a tool designed to quickly assess the Active Directory security level via a script located in a potentially suspicious or uncommon location.
# Converted by: Sigma Universal SIEM/EDR CLI

((((ParentCommandLine CONTAIN ".bat" OR ParentCommandLine CONTAIN ".chm" OR ParentCommandLine CONTAIN ".cmd" OR ParentCommandLine CONTAIN ".hta" OR ParentCommandLine CONTAIN ".htm" OR ParentCommandLine CONTAIN ".html" OR ParentCommandLine CONTAIN ".js" OR ParentCommandLine CONTAIN ".lnk" OR ParentCommandLine CONTAIN ".ps1" OR ParentCommandLine CONTAIN ".vbe" OR ParentCommandLine CONTAIN ".vbs" OR ParentCommandLine CONTAIN ".wsf")) OR ((ParentCommandLine CONTAIN ":\\Perflogs\\" OR ParentCommandLine CONTAIN ":\\Temp\\" OR ParentCommandLine CONTAIN ":\\Users\\Public\\" OR ParentCommandLine CONTAIN ":\\Windows\\Temp\\" OR ParentCommandLine CONTAIN "\\AppData\\Local\\Temp" OR ParentCommandLine CONTAIN "\\AppData\\Roaming\\" OR ParentCommandLine CONTAIN "\\Temporary Internet")) OR (((ParentCommandLine CONTAIN ":\\Users\\" AND ParentCommandLine CONTAIN "\\Favorites\\")) OR ((ParentCommandLine CONTAIN ":\\Users\\" AND ParentCommandLine CONTAIN "\\Favourites\\")) OR ((ParentCommandLine CONTAIN ":\\Users\\" AND ParentCommandLine CONTAIN "\\Contacts\\")))) AND ((ParentCommandLine CONTAIN ".bat" OR ParentCommandLine CONTAIN ".chm" OR ParentCommandLine CONTAIN ".cmd" OR ParentCommandLine CONTAIN ".hta" OR ParentCommandLine CONTAIN ".htm" OR ParentCommandLine CONTAIN ".html" OR ParentCommandLine CONTAIN ".js" OR ParentCommandLine CONTAIN ".lnk" OR ParentCommandLine CONTAIN ".ps1" OR ParentCommandLine CONTAIN ".vbe" OR ParentCommandLine CONTAIN ".vbs" OR ParentCommandLine CONTAIN ".wsf")) AND ((Image="*\\PingCastle.exe") OR (OriginalFileName = "PingCastle.exe") OR (Product = "Ping Castle") OR ((CommandLine CONTAIN "--scanner aclcheck" OR CommandLine CONTAIN "--scanner antivirus" OR CommandLine CONTAIN "--scanner computerversion" OR CommandLine CONTAIN "--scanner foreignusers" OR CommandLine CONTAIN "--scanner laps_bitlocker" OR CommandLine CONTAIN "--scanner localadmin" OR CommandLine CONTAIN "--scanner nullsession" OR CommandLine CONTAIN "--scanner nullsession-trust" OR CommandLine CONTAIN "--scanner oxidbindings" OR CommandLine CONTAIN "--scanner remote" OR CommandLine CONTAIN "--scanner share" OR CommandLine CONTAIN "--scanner smb" OR CommandLine CONTAIN "--scanner smb3querynetwork" OR CommandLine CONTAIN "--scanner spooler" OR CommandLine CONTAIN "--scanner startup" OR CommandLine CONTAIN "--scanner zerologon")) OR (CommandLine CONTAIN "--no-enum-limit") OR ((CommandLine CONTAIN "--healthcheck" AND CommandLine CONTAIN "--level Full")) OR ((CommandLine CONTAIN "--healthcheck" AND CommandLine CONTAIN "--server "))))
