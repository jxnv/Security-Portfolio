# Title: Process Creation Using Sysnative Folder
# ID: 3c1b5fb0-c72f-45ba-abd1-4d4c353144ab
# Status: test
# Level: medium
# Author: Max Altgelt (Nextron Systems)
# Date: 2022-08-23
# Tags: attack.privilege-escalation, attack.stealth, attack.t1055
# Description: Detects process creation events that use the Sysnative folder (common for CobaltStrike spawns)
# Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAIN ":\\Windows\\Sysnative\\") OR (Image CONTAIN ":\\Windows\\Sysnative\\")) AND NOT (((Image CONTAIN "C:\\Windows\\Microsoft.NET\\Framework64\\v" OR Image CONTAIN "C:\\Windows\\Microsoft.NET\\Framework\\v" OR Image CONTAIN "C:\\Windows\\Microsoft.NET\\FrameworkArm\\v" OR Image CONTAIN "C:\\Windows\\Microsoft.NET\\FrameworkArm64\\v") AND Image="*\\ngen.exe" AND CommandLine CONTAIN "install")) AND NOT (((CommandLine CONTAIN "\"C:\\Windows\\sysnative\\cmd.exe\"" AND CommandLine CONTAIN "\\xampp\\" AND CommandLine CONTAIN "\\catalina_start.bat"))))
