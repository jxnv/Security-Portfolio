# Title: HackTool - CrackMapExec Execution
# ID: 42a993dd-bb3e-48c8-b372-4d6684c4106c
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-02-25
# Tags: attack.execution, attack.persistence, attack.privilege-escalation, attack.credential-access, attack.discovery, attack.t1047, attack.t1053, attack.t1059.003, attack.t1059.001, attack.t1110, attack.t1201
# Description: This rule detect common flag combinations used by CrackMapExec in order to detect its use even if the binary has been replaced.
# Converted by: Sigma Universal SIEM/EDR CLI

(((Image="*\\crackmapexec.exe") OR ((CommandLine CONTAIN " --local-auth" AND CommandLine CONTAIN " -u " AND CommandLine CONTAIN " -x ")) OR ((CommandLine CONTAIN " --local-auth" AND CommandLine CONTAIN " -u " AND CommandLine CONTAIN " -p " AND CommandLine CONTAIN " -H 'NTHASH'")) OR ((CommandLine CONTAIN " mssql " AND CommandLine CONTAIN " -u " AND CommandLine CONTAIN " -p " AND CommandLine CONTAIN " -M " AND CommandLine CONTAIN " -d ")) OR ((CommandLine CONTAIN " smb " AND CommandLine CONTAIN " -u " AND CommandLine CONTAIN " -H " AND CommandLine CONTAIN " -M " AND CommandLine CONTAIN " -o ")) OR ((CommandLine CONTAIN " smb " AND CommandLine CONTAIN " -u " AND CommandLine CONTAIN " -p " AND CommandLine CONTAIN " --local-auth")) OR (CommandLine CONTAIN " -M pe_inject ")) OR (((CommandLine CONTAIN " --local-auth" AND CommandLine CONTAIN " -u " AND CommandLine CONTAIN " -p ")) AND ((CommandLine CONTAIN " 10." AND CommandLine CONTAIN " 192.168." AND CommandLine CONTAIN "/24 "))))
