# Title: Potential PowerShell Obfuscation Via Reversed Commands
# ID: b6b49cd1-34d6-4ead-b1bf-176e9edba9a4
# Status: test
# Level: high
# Author: Teymur Kheirkhabarov (idea), Vasiliy Burov (rule), oscd.community, Tim Shelton
# Date: 2020-10-11
# Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
# Description: Detects the presence of reversed PowerShell commands in the CommandLine. This is often used as a method of obfuscation by attackers
# Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine CONTAIN "hctac" OR CommandLine CONTAIN "kaerb" OR CommandLine CONTAIN "dnammoc" OR CommandLine CONTAIN "ekovn" OR CommandLine CONTAIN "eliFd" OR CommandLine CONTAIN "rahc" OR CommandLine CONTAIN "etirw" OR CommandLine CONTAIN "golon" OR CommandLine CONTAIN "tninon" OR CommandLine CONTAIN "eddih" OR CommandLine CONTAIN "tpircS" OR CommandLine CONTAIN "ssecorp" OR CommandLine CONTAIN "llehsrewop" OR CommandLine CONTAIN "esnopser" OR CommandLine CONTAIN "daolnwod" OR CommandLine CONTAIN "tneilCbeW" OR CommandLine CONTAIN "tneilc" OR CommandLine CONTAIN "ptth" OR CommandLine CONTAIN "elifotevas" OR CommandLine CONTAIN "46esab" OR CommandLine CONTAIN "htaPpmeTteG" OR CommandLine CONTAIN "tcejbO" OR CommandLine CONTAIN "maerts" OR CommandLine CONTAIN "hcaerof" OR CommandLine CONTAIN "retupmoc")) AND (((Image="*\\powershell.exe" OR Image="*\\pwsh.exe")) OR ((OriginalFileName = "PowerShell.EXE" OR OriginalFileName = "pwsh.dll")))) AND NOT (((CommandLine CONTAIN " -EncodedCommand " OR CommandLine CONTAIN " -enc "))))
