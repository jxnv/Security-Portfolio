# Title: Regsvr32 Execution From Highly Suspicious Location
# ID: 327ff235-94eb-4f06-b9de-aaee571324be
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-05-26
# Tags: attack.stealth, attack.t1218.010
# Description: Detects execution of regsvr32 where the DLL is located in a highly suspicious locations
# Converted by: Sigma Universal SIEM/EDR CLI

(((Image="*\\regsvr32.exe") OR (OriginalFileName = "REGSVR32.EXE")) AND (((CommandLine CONTAIN ":\\PerfLogs\\" OR CommandLine CONTAIN ":\\Temp\\" OR CommandLine CONTAIN "\\Windows\\Registration\\CRMLog" OR CommandLine CONTAIN "\\Windows\\System32\\com\\dmp\\" OR CommandLine CONTAIN "\\Windows\\System32\\FxsTmp\\" OR CommandLine CONTAIN "\\Windows\\System32\\Microsoft\\Crypto\\RSA\\MachineKeys\\" OR CommandLine CONTAIN "\\Windows\\System32\\spool\\drivers\\color\\" OR CommandLine CONTAIN "\\Windows\\System32\\spool\\PRINTERS\\" OR CommandLine CONTAIN "\\Windows\\System32\\spool\\SERVERS\\" OR CommandLine CONTAIN "\\Windows\\System32\\Tasks_Migrated\\" OR CommandLine CONTAIN "\\Windows\\System32\\Tasks\\Microsoft\\Windows\\SyncCenter\\" OR CommandLine CONTAIN "\\Windows\\SysWOW64\\com\\dmp\\" OR CommandLine CONTAIN "\\Windows\\SysWOW64\\FxsTmp\\" OR CommandLine CONTAIN "\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\PLA\\System\\" OR CommandLine CONTAIN "\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\SyncCenter\\" OR CommandLine CONTAIN "\\Windows\\Tasks\\" OR CommandLine CONTAIN "\\Windows\\Tracing\\")) OR (((CommandLine CONTAIN " \"C:\\" OR CommandLine CONTAIN " C:\\" OR CommandLine CONTAIN " 'C:\\" OR CommandLine CONTAIN "D:\\")) AND NOT (((CommandLine CONTAIN "C:\\Program Files (x86)\\" OR CommandLine CONTAIN "C:\\Program Files\\" OR CommandLine CONTAIN "C:\\ProgramData\\" OR CommandLine CONTAIN "C:\\Users\\" OR CommandLine CONTAIN " C:\\Windows\\" OR CommandLine CONTAIN " \"C:\\Windows\\" OR CommandLine CONTAIN " 'C:\\Windows\\"))))) AND NOT (((CommandLine = "") OR (NOT CommandLine=*))))
