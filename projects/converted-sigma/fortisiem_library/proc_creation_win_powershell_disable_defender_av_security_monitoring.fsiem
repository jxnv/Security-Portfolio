# Title: Disable Windows Defender AV Security Monitoring
# ID: a7ee1722-c3c5-aeff-3212-c777e4733217
# Status: test
# Level: high
# Author: ok @securonix invrep-de, oscd.community, frack113
# Date: 2020-10-12
# Tags: attack.defense-impairment, attack.t1685
# Description: Detects attackers attempting to disable Windows Defender using Powershell
# Converted by: Sigma Universal SIEM/EDR CLI

(((((Image="*\\powershell.exe" OR Image="*\\pwsh.exe")) OR ((OriginalFileName = "PowerShell.EXE" OR OriginalFileName = "pwsh.dll"))) AND ((CommandLine CONTAIN "-DisableBehaviorMonitoring $true" OR CommandLine CONTAIN "-DisableRuntimeMonitoring $true"))) OR (((Image="*\\sc.exe") OR (OriginalFileName = "sc.exe")) AND (((CommandLine CONTAIN "delete" AND CommandLine CONTAIN "WinDefend")) OR ((CommandLine CONTAIN "config" AND CommandLine CONTAIN "WinDefend" AND CommandLine CONTAIN "start=disabled")) OR ((CommandLine CONTAIN "stop" AND CommandLine CONTAIN "WinDefend")))))
