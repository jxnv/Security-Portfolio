# Title: Linux Package Uninstall
# ID: 95d61234-7f56-465c-6f2d-b562c6fedbc4
# Status: test
# Level: low
# Author: Tuan Le (NCSGroup), Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-03-09
# Tags: attack.stealth, attack.t1070
# Description: Detects linux package removal using builtin tools such as "yum", "apt", "apt-get" or "dpkg".
# Converted by: Sigma Universal SIEM/EDR CLI

(((Image="*/apt" OR Image="*/apt-get") AND (CommandLine CONTAIN "remove" OR CommandLine CONTAIN "purge")) OR (Image="*/dpkg" AND (CommandLine CONTAIN "--remove " OR CommandLine CONTAIN " -r ")) OR (Image="*/rpm" AND CommandLine CONTAIN " -e ") OR (Image="*/yum" AND (CommandLine CONTAIN "erase" OR CommandLine CONTAIN "remove")))
