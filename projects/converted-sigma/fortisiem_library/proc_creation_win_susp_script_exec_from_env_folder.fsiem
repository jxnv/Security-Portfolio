# Title: Script Interpreter Execution From Suspicious Folder
# ID: 1228c958-e64e-4e71-92ad-7d429f4138ba
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-02-08
# Tags: attack.execution, attack.t1059
# Description: Detects suspicious script execution from suspicious directories or folders accessible by environment variables that may indicate malware activity.
# Script interpreters (cscript, wscript, mshta, powershell) executing from folders like Temp, Public, or user profile directories may suggest attempts to evade detection or execute malicious scripts.
# Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine CONTAIN " -ep bypass " OR CommandLine CONTAIN " -ExecutionPolicy bypass " OR CommandLine CONTAIN " -w hidden " OR CommandLine CONTAIN "/e:javascript " OR CommandLine CONTAIN "/e:Jscript " OR CommandLine CONTAIN "/e:vbscript ")) OR ((Image="*\\cscript.exe" OR Image="*\\mshta.exe" OR Image="*\\wscript.exe")) OR ((OriginalFileName = "cscript.exe" OR OriginalFileName = "mshta.exe" OR OriginalFileName = "wscript.exe"))) AND (((CommandLine CONTAIN ":\\Perflogs\\" OR CommandLine CONTAIN ":\\Users\\Public\\" OR CommandLine CONTAIN "\\%Public%" OR CommandLine CONTAIN "\\AppData\\Local\\Temp" OR CommandLine CONTAIN "\\AppData\\Roaming\\Temp" OR CommandLine CONTAIN "\\Temporary Internet" OR CommandLine CONTAIN "\\Windows\\Temp" OR CommandLine CONTAIN "\\Start Menu\\Programs\\Startup\\" OR CommandLine CONTAIN "%TEMP%" OR CommandLine CONTAIN "%TMP%" OR CommandLine CONTAIN "%LocalAppData%\\Temp")) OR (((CommandLine CONTAIN ":\\Users\\" AND CommandLine CONTAIN "\\Favorites\\")) OR ((CommandLine CONTAIN ":\\Users\\" AND CommandLine CONTAIN "\\Favourites\\")) OR ((CommandLine CONTAIN ":\\Users\\" AND CommandLine CONTAIN "\\Contacts\\")) OR ((CommandLine CONTAIN ":\\Users\\" AND CommandLine CONTAIN "\\Documents\\")) OR ((CommandLine CONTAIN ":\\Users\\" AND CommandLine CONTAIN "\\Music\\")) OR ((CommandLine CONTAIN ":\\Users\\" AND CommandLine CONTAIN "\\Pictures\\")) OR ((CommandLine CONTAIN ":\\Users\\" AND CommandLine CONTAIN "\\Videos\\")))) AND NOT (((ParentImage = "C:\\Windows\\System32\\Msiexec.exe" OR ParentImage = "C:\\Windows\\SysWOW64\\Msiexec.exe") AND Image="*\\powershell.exe" AND (CommandLine CONTAIN "-NoProfile -ExecutionPolicy Bypass -Command" AND CommandLine CONTAIN "AppData\\Local\\Temp\\" AND CommandLine CONTAIN "Install-Chocolatey.ps1"))))
