# Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
# Description: Detects Obfuscated Powershell via VAR++ LAUNCHER
# Converted by: Sigma Universal SIEM/EDR CLI

((CommandLine CONTAIN "&&set" AND CommandLine CONTAIN "cmd" AND CommandLine CONTAIN "/c" AND CommandLine CONTAIN "-f") AND (CommandLine CONTAIN "{0}" OR CommandLine CONTAIN "{1}" OR CommandLine CONTAIN "{2}" OR CommandLine CONTAIN "{3}" OR CommandLine CONTAIN "{4}" OR CommandLine CONTAIN "{5}"))
