# Title: Syslog Clearing or Removal Via System Utilities
# ID: 3fcc9b35-39e4-44c0-a2ad-9e82b6902b31
# Status: test
# Level: high
# Author: Max Altgelt (Nextron Systems), Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research), MSTIC
# Date: 2021-10-15
# Tags: attack.defense-impairment, attack.t1685.006
# Description: Detects specific commands commonly used to remove or empty the syslog. Which is a technique often used by attacker as a method to hide their tracks
# Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine CONTAIN "/var/log/syslog") AND ((Image="*/cp" AND CommandLine CONTAIN "/dev/null") OR (Image="*/ln" AND (CommandLine CONTAIN "/dev/null " AND CommandLine CONTAIN "/var/log/syslog") AND (CommandLine CONTAIN "-sf " OR CommandLine CONTAIN "-sfn " OR CommandLine CONTAIN "-sfT ")) OR (Image="*/mv") OR (Image="*/rm" AND (CommandLine CONTAIN " -r " OR CommandLine CONTAIN " -f " OR CommandLine CONTAIN " -rf " OR CommandLine CONTAIN "/var/log/syslog")) OR (Image="*/shred" AND CommandLine CONTAIN "-u ") OR (Image="*/truncate" AND (CommandLine CONTAIN "0 " AND CommandLine CONTAIN "/var/log/syslog") AND (CommandLine CONTAIN "-s " OR CommandLine CONTAIN "-c " OR CommandLine CONTAIN "--size")) OR (Image="*/unlink"))) OR (((CommandLine CONTAIN "journalctl --vacuum" OR CommandLine CONTAIN "journalctl --rotate")) OR ((CommandLine CONTAIN " > /var/log/syslog" OR CommandLine CONTAIN " >/var/log/syslog" OR CommandLine CONTAIN " >| /var/log/syslog" OR CommandLine CONTAIN ": > /var/log/syslog" OR CommandLine CONTAIN ":> /var/log/syslog" OR CommandLine CONTAIN ":>/var/log/syslog" OR CommandLine CONTAIN ">|/var/log/syslog"))))
