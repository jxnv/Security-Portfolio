# Title: Suspicious Service Path Modification
# ID: 138d3531-8793-4f50-a2cd-f291b2863d78
# Status: test
# Level: high
# Author: Victor Sergeev, oscd.community, Nasreddine Bencherchali (Nextron Systems)
# Date: 2019-10-21
# Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
# Description: Detects service path modification via the "sc" binary to a suspicious command or path
# Converted by: Sigma Universal SIEM/EDR CLI

(Image="*\\sc.exe" AND (CommandLine CONTAIN "config" AND CommandLine CONTAIN "binPath") AND (CommandLine CONTAIN "powershell" OR CommandLine CONTAIN "cmd " OR CommandLine CONTAIN "mshta" OR CommandLine CONTAIN "wscript" OR CommandLine CONTAIN "cscript" OR CommandLine CONTAIN "rundll32" OR CommandLine CONTAIN "svchost" OR CommandLine CONTAIN "dllhost" OR CommandLine CONTAIN "cmd.exe /c" OR CommandLine CONTAIN "cmd.exe /k" OR CommandLine CONTAIN "cmd.exe /r" OR CommandLine CONTAIN "cmd /c" OR CommandLine CONTAIN "cmd /k" OR CommandLine CONTAIN "cmd /r" OR CommandLine CONTAIN "C:\\Users\\Public" OR CommandLine CONTAIN "\\Downloads\\" OR CommandLine CONTAIN "\\Desktop\\" OR CommandLine CONTAIN "\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\" OR CommandLine CONTAIN "C:\\Windows\\TEMP\\" OR CommandLine CONTAIN "\\AppData\\Local\\Temp"))
