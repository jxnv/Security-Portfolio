# Tags: attack.execution, attack.stealth, attack.t1127
# Description: Detects execution of "aspnet_compiler.exe" with potentially suspicious paths for compilation.
# Converted by: Sigma Universal SIEM/EDR CLI

((Image CONTAIN ":\\Windows\\Microsoft.NET\\Framework\\" OR Image CONTAIN ":\\Windows\\Microsoft.NET\\Framework64\\" OR Image CONTAIN ":\\Windows\\Microsoft.NET\\FrameworkArm\\" OR Image CONTAIN ":\\Windows\\Microsoft.NET\\FrameworkArm64\\") AND Image="*\\aspnet_compiler.exe" AND (CommandLine CONTAIN "\\Users\\Public\\" OR CommandLine CONTAIN "\\AppData\\Local\\Temp\\" OR CommandLine CONTAIN "\\AppData\\Local\\Roaming\\" OR CommandLine CONTAIN ":\\Temp\\" OR CommandLine CONTAIN ":\\Windows\\Temp\\" OR CommandLine CONTAIN ":\\Windows\\System32\\Tasks\\" OR CommandLine CONTAIN ":\\Windows\\Tasks\\"))
