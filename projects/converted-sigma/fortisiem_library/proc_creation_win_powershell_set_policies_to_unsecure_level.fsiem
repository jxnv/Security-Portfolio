# Title: Change PowerShell Policies to an Insecure Level
# ID: 87e3c4e8-a6a8-4ad9-bb4f-46e7ff99a180
# Status: test
# Level: medium
# Author: frack113
# Date: 2021-11-01
# Tags: attack.execution, attack.t1059.001
# Description: Detects changing the PowerShell script execution policy to a potentially insecure level using the "-ExecutionPolicy" flag.
# Converted by: Sigma Universal SIEM/EDR CLI

(((((OriginalFileName = "powershell_ise.exe" OR OriginalFileName = "PowerShell.EXE" OR OriginalFileName = "pwsh.dll")) OR ((Image="*\\powershell_ise.exe" OR Image="*\\powershell.exe" OR Image="*\\pwsh.exe"))) AND ((CommandLine CONTAIN "Bypass" OR CommandLine CONTAIN "Unrestricted")) AND ((CommandLine CONTAIN "-executionpolicy " OR CommandLine CONTAIN " -ep " OR CommandLine CONTAIN " -exec "))) AND NOT (((ParentImage = "C:\\Windows\\SysWOW64\\msiexec.exe" OR ParentImage = "C:\\Windows\\System32\\msiexec.exe") AND (CommandLine CONTAIN "-NoProfile -ExecutionPolicy Bypass -File \"C:\\Program Files\\PowerShell\\7\\" OR CommandLine CONTAIN "-NoProfile -ExecutionPolicy Bypass -File \"C:\\Program Files (x86)\\PowerShell\\7\\"))) AND NOT (((ParentImage CONTAIN "C:\\Program Files\\Avast Software\\Avast\\" OR ParentImage CONTAIN "C:\\Program Files (x86)\\Avast Software\\Avast\\" OR ParentImage CONTAIN "\\instup.exe") AND (CommandLine CONTAIN "-ExecutionPolicy ByPass -File \"C:\\Program Files\\Avast Software\\Avast" OR CommandLine CONTAIN "-ExecutionPolicy ByPass -File \"C:\\Program Files (x86)\\Avast Software\\Avast\\"))))
