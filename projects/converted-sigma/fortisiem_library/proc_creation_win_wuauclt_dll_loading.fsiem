# Title: Proxy Execution Via Wuauclt.EXE
# ID: af77cf95-c469-471c-b6a0-946c685c4798
# Status: test
# Level: high
# Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research), Florian Roth (Nextron Systems), Sreeman, FPT.EagleEye Team
# Date: 2020-10-12
# Tags: attack.stealth, attack.t1218, attack.execution
# Description: Detects the use of the Windows Update Client binary (wuauclt.exe) for proxy execution.
# Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine CONTAIN "UpdateDeploymentProvider" AND CommandLine CONTAIN "RunHandlerComServer")) AND ((Image="*\\wuauclt.exe") OR (OriginalFileName = "wuauclt.exe"))) AND NOT (((CommandLine CONTAIN " /UpdateDeploymentProvider UpdateDeploymentProvider.dll ") OR ((CommandLine CONTAIN ":\\Windows\\UUS\\Packages\\Preview\\amd64\\updatedeploy.dll /ClassId" OR CommandLine CONTAIN ":\\Windows\\UUS\\amd64\\UpdateDeploy.dll /ClassId")) OR ((CommandLine CONTAIN ":\\Windows\\WinSxS\\" AND CommandLine CONTAIN "\\UpdateDeploy.dll /ClassId ")) OR (CommandLine CONTAIN " wuaueng.dll "))))
