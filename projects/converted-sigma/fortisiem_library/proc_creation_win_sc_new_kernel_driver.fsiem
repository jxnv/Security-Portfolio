# Title: New Kernel Driver Via SC.EXE
# ID: 431a1fdb-4799-4f3b-91c3-a683b003fc49
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-07-14
# Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
# Description: Detects creation of a new service (kernel driver) with the type "kernel"
# Converted by: Sigma Universal SIEM/EDR CLI

((Image="*\\sc.exe" AND (CommandLine CONTAIN "create" OR CommandLine CONTAIN "config") AND (CommandLine CONTAIN "binPath" AND CommandLine CONTAIN "type" AND CommandLine CONTAIN "kernel")) AND NOT ((((CommandLine CONTAIN "create netprotection_network_filter" AND CommandLine CONTAIN "type= kernel start= " AND CommandLine CONTAIN "binPath= System32\\drivers\\netprotection_network_filter" AND CommandLine CONTAIN "DisplayName= netprotection_network_filter" AND CommandLine CONTAIN "group= PNP_TDI tag= yes")) OR ((CommandLine CONTAIN "create avelam binpath=C:\\Windows\\system32\\drivers\\avelam.sys" AND CommandLine CONTAIN "type=kernel start=boot error=critical group=Early-Launch")))))
