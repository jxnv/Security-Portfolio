# Title: BITS Transfer Job Download From Direct IP
# ID: 90f138c1-f578-4ac3-8c49-eecfd847c8b7
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-01-11
# Tags: attack.persistence, attack.execution, attack.stealth, attack.t1197
# Description: Detects a BITS transfer job downloading file(s) from a direct IP address.
# Converted by: Sigma Universal SIEM/EDR CLI

((EventID = "16403" AND (RemoteName CONTAIN "http://1" OR RemoteName CONTAIN "http://2" OR RemoteName CONTAIN "http://3" OR RemoteName CONTAIN "http://4" OR RemoteName CONTAIN "http://5" OR RemoteName CONTAIN "http://6" OR RemoteName CONTAIN "http://7" OR RemoteName CONTAIN "http://8" OR RemoteName CONTAIN "http://9" OR RemoteName CONTAIN "https://1" OR RemoteName CONTAIN "https://2" OR RemoteName CONTAIN "https://3" OR RemoteName CONTAIN "https://4" OR RemoteName CONTAIN "https://5" OR RemoteName CONTAIN "https://6" OR RemoteName CONTAIN "https://7" OR RemoteName CONTAIN "https://8" OR RemoteName CONTAIN "https://9")) AND NOT ((((RemoteName CONTAIN "://10." OR RemoteName CONTAIN "://192.168." OR RemoteName CONTAIN "://172.16." OR RemoteName CONTAIN "://172.17." OR RemoteName CONTAIN "://172.18." OR RemoteName CONTAIN "://172.19." OR RemoteName CONTAIN "://172.20." OR RemoteName CONTAIN "://172.21." OR RemoteName CONTAIN "://172.22." OR RemoteName CONTAIN "://172.23." OR RemoteName CONTAIN "://172.24." OR RemoteName CONTAIN "://172.25." OR RemoteName CONTAIN "://172.26." OR RemoteName CONTAIN "://172.27." OR RemoteName CONTAIN "://172.28." OR RemoteName CONTAIN "://172.29." OR RemoteName CONTAIN "://172.30." OR RemoteName CONTAIN "://172.31." OR RemoteName CONTAIN "://127." OR RemoteName CONTAIN "://169.254.")) OR ((RemoteName CONTAIN "https://7-" OR RemoteName CONTAIN "http://7-")))))
