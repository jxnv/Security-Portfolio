// Title: File With Uncommon Extension Created By An Office Application
// ID: c7a74c80-ba5a-486e-9974-ab9e682bc5e4
// Status: test
// Level: high
// Author: Vadim Khrykov (ThreatIntel), Cyb3rEng (Rule), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-08-23
// Tags: attack.t1204.002, attack.execution
// Description: Detects the creation of files with an executable or script extension by an Office application.
// Converted by: Sigma Universal SIEM/EDR CLI

file where ((((process.executable endswith "\\excel.exe" or process.executable endswith "\\msaccess.exe" or process.executable endswith "\\mspub.exe" or process.executable endswith "\\powerpnt.exe" or process.executable endswith "\\visio.exe" or process.executable endswith "\\winword.exe")) and ((file.path endswith ".bat" or file.path endswith ".cmd" or file.path endswith ".com" or file.path endswith ".dll" or file.path endswith ".exe" or file.path endswith ".hta" or file.path endswith ".ocx" or file.path endswith ".proj" or file.path endswith ".ps1" or file.path endswith ".scf" or file.path endswith ".scr" or file.path endswith ".sys" or file.path endswith ".vbe" or file.path endswith ".vbs" or file.path endswith ".wsf" or file.path endswith ".wsh"))) and not ((file.path like "*_\\AppData\\Local\\assembly\\tmp\\*" and file.path endswith ".dll")) and not ((((file.path like "*_C:\\Users\\*" and file.path like "*_\\AppData\\Local\\Microsoft\\Office\\*" and file.path like "*_\\BackstageInAppNavCache\\*") and file.path endswith ".com") or (process.executable endswith "\\winword.exe" and file.path like "*_\\AppData\\Local\\Temp\\webexdelta\\*" and (file.path endswith ".dll" or file.path endswith ".exe")) or ((file.path like "*_C:\\Users\\*" and file.path like "*_\\AppData\\Local\\Microsoft\\Office\\*" and file.path like "*_\\WebServiceCache\\AllUsers*") and file.path endswith ".com"))))
