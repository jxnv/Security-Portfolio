// Title: Azure Virtual Network Modified or Deleted
// ID: bcfcc962-0e4a-4fd9-84bb-a833e672df3f
// Status: test
// Level: medium
// Author: Austin Songer @austinsonger
// Date: 2021-08-08
// Tags: attack.impact
// Description: Identifies when a Virtual Network is modified or deleted in Azure.
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((operationName startswith "MICROSOFT.NETWORK/VIRTUALNETWORKGATEWAYS/" or operationName startswith "MICROSOFT.NETWORK/VIRTUALNETWORKS/") and (operationName endswith "/WRITE" or operationName endswith "/DELETE"))
