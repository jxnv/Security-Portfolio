// Title: New RUN Key Pointing to Suspicious Folder
// ID: 02ee49e2-e294-4d0f-9278-f5b3212fc588
// Status: experimental
// Level: high
// Author: Florian Roth (Nextron Systems), Markus Neis, Sander Wiebing, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2018-08-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects suspicious new RUN key element pointing to an executable in a suspicious folder
// Converted by: Sigma Universal SIEM/EDR CLI

registry where (((registry.path like "*_\\Software\\Microsoft\\Windows\\CurrentVersion\\Run*" or registry.path like "*_\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run*" or registry.path like "*_\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\Run*")) and (((registry.data.strings like "*_:\\Perflogs*" or registry.data.strings like "*_:\\ProgramData'*" or registry.data.strings like "*_:\\Windows\\Temp*" or registry.data.strings like "*_:\\Temp*" or registry.data.strings like "*_\\AppData\\Local\\Temp*" or registry.data.strings like "*_\\AppData\\Roaming*" or registry.data.strings like "*_:\\$Recycle.bin*" or registry.data.strings like "*_:\\Users\\Default*" or registry.data.strings like "*_:\\Users\\public*" or registry.data.strings like "*_%temp%*" or registry.data.strings like "*_%tmp%*" or registry.data.strings like "*_%Public%*" or registry.data.strings like "*_%AppData%*")) or ((registry.data.strings like "*_:\\Users\\*") and ((registry.data.strings like "*_\\Favorites*" or registry.data.strings like "*_\\Favourites*" or registry.data.strings like "*_\\Contacts*" or registry.data.strings like "*_\\Music*" or registry.data.strings like "*_\\Pictures*" or registry.data.strings like "*_\\Documents*" or registry.data.strings like "*_\\Photos*")))) and not ((registry.path like "*_\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\*" and process.executable startswith "C:\\Windows\\SoftwareDistribution\\Download\\" and (registry.data.strings like "*_rundll32.exe *" and registry.data.strings like "*_C:\\WINDOWS\\system32\\advpack.dll,DelNodeRunDLL32*") and (registry.data.strings like "*_\\AppData\\Local\\Temp\\*" or registry.data.strings like "*_C:\\Windows\\Temp\\*"))) and not (((process.executable endswith "C:\\Program Files\\Spotify\\Spotify.exe" or process.executable endswith "C:\\Program Files (x86)\\Spotify\\Spotify.exe" or process.executable endswith "\\AppData\\Roaming\\Spotify\\Spotify.exe") and registry.path endswith "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\\Spotify" and registry.data.strings endswith "Spotify.exe --autostart --minimized")))
