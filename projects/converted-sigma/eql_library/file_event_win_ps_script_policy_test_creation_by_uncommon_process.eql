// Title: PSScriptPolicyTest Creation By Uncommon Process
// ID: 1027d292-dd87-4a1a-8701-2abe04d7783c
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-01
// Tags: attack.stealth
// Description: Detects the creation of the "PSScriptPolicyTest" PowerShell script by an uncommon process. This file is usually generated by Microsoft Powershell to test against Applocker.
// Converted by: Sigma Universal SIEM/EDR CLI

file where ((file.path like "*___PSScriptPolicyTest_*") and not ((((process.executable == "C:\\Windows\\System32\\dsac.exe" or process.executable == "C:\\Windows\\System32\\sdiagnhost.exe" or process.executable == "C:\\Windows\\System32\\ServerManager.exe" or process.executable == "C:\\Windows\\System32\\wsmprovhost.exe" or process.executable == "C:\\Windows\\SysWOW64\\sdiagnhost.exe")) or ((process.executable == "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" or process.executable == "C:\\Program Files\\PowerShell\\7\\pwsh.exe" or process.executable == "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or process.executable == "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" or process.executable == "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or process.executable == "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")) or ((process.executable like "*_C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview*" or process.executable like "*_\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview*") and process.executable endswith "\\pwsh.exe"))) and not ((process.executable startswith "C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_" and process.executable endswith "\\GetHelp.exe")))
