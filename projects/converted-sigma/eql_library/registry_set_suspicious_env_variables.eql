// Title: Suspicious Environment Variable Has Been Registered
// ID: 966315ef-c5e1-4767-ba25-fce9c8de3660
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-20
// Tags: attack.persistence, attack.stealth
// Description: Detects the creation of user-specific or system-wide environment variables via the registry. Which contains suspicious commands and strings
// Converted by: Sigma Universal SIEM/EDR CLI

registry where ((((registry.data.strings == "powershell" or registry.data.strings == "pwsh")) or ((registry.data.strings like "*_\\AppData\\Local\\Temp\\*" or registry.data.strings like "*_C:\\Users\\Public\\*" or registry.data.strings like "*_TVqQAAMAAAAEAAAA*" or registry.data.strings like "*_TVpQAAIAAAAEAA8A*" or registry.data.strings like "*_TVqAAAEAAAAEABAA*" or registry.data.strings like "*_TVoAAAAAAAAAAAAA*" or registry.data.strings like "*_TVpTAQEAAAAEAAAA*" or registry.data.strings like "*_SW52b2tlL*" or registry.data.strings like "*_ludm9rZS*" or registry.data.strings like "*_JbnZva2Ut*" or registry.data.strings like "*_SQBuAHYAbwBrAGUALQ*" or registry.data.strings like "*_kAbgB2AG8AawBlAC0A*" or registry.data.strings like "*_JAG4AdgBvAGsAZQAtA*")) or ((registry.data.strings startswith "SUVY" or registry.data.strings startswith "SQBFAF" or registry.data.strings startswith "SQBuAH" or registry.data.strings startswith "cwBhA" or registry.data.strings startswith "aWV4" or registry.data.strings startswith "aQBlA" or registry.data.strings startswith "R2V0" or registry.data.strings startswith "dmFy" or registry.data.strings startswith "dgBhA" or registry.data.strings startswith "dXNpbm" or registry.data.strings startswith "H4sIA" or registry.data.strings startswith "Y21k" or registry.data.strings startswith "cABhAH" or registry.data.strings startswith "Qzpc" or registry.data.strings startswith "Yzpc"))) and (registry.path like "*_\\Environment\\*"))
