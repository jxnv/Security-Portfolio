// Title: Change Winevt Channel Access Permission Via Registry
// ID: 7d9263bd-dc47-4a58-bc92-5474abab390c
// Status: test
// Level: high
// Author: frack113
// Date: 2022-09-17
// Tags: attack.defense-impairment, attack.t1685.001
// Description: Detects tampering with the "ChannelAccess" registry key in order to change access to Windows event channel.
// Converted by: Sigma Universal SIEM/EDR CLI

registry where ((registry.path like "*_\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\*" and registry.path endswith "\\ChannelAccess" and (registry.data.strings like "*_(A;;0x1;;;LA)*" or registry.data.strings like "*_(A;;0x1;;;SY)*" or registry.data.strings like "*_(A;;0x5;;;BA)*")) and not (((process.executable startswith "C:\\Windows\\WinSxS\\" and process.executable endswith "\\TiWorker.exe") or (process.executable == "C:\\Windows\\servicing\\TrustedInstaller.exe"))))
