// Title: Suspicious File Access to Browser Credential Storage
// ID: a1dfd976-4852-41d4-9507-dc6590a3ccd0
// Status: experimental
// Level: low
// Author: frack113, X__Junior (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems), Parth-FourCore
// Date: 2025-05-22
// Tags: attack.credential-access, attack.t1555.003, attack.discovery, attack.t1217
// Description: Detects file access to browser credential storage paths by non-browser processes, which may indicate credential access attempts.
// Adversaries may attempt to access browser credential storage to extract sensitive information such as usernames and passwords or cookies.
// This behavior is often commonly observed in credential stealing malware.
// Converted by: Sigma Universal SIEM/EDR CLI

file where ((((FileName like "*_\\Sputnik\\Sputnik*" or FileName like "*_\\MapleStudio\\ChromePlus*" or FileName like "*_\\QIP Surf*" or FileName like "*_\\BlackHawk*" or FileName like "*_\\7Star\\7Star*" or FileName like "*_\\CatalinaGroup\\Citrio*" or FileName like "*_\\Google\\Chrome*" or FileName like "*_\\Coowon\\Coowon*" or FileName like "*_\\CocCoc\\Browser*" or FileName like "*_\\uCozMedia\\Uran*" or FileName like "*_\\Tencent\\QQBrowser*" or FileName like "*_\\Orbitum*" or FileName like "*_\\Slimjet*" or FileName like "*_\\Iridium*" or FileName like "*_\\Vivaldi*" or FileName like "*_\\Chromium*" or FileName like "*_\\GhostBrowser*" or FileName like "*_\\CentBrowser*" or FileName like "*_\\Xvast*" or FileName like "*_\\Chedot*" or FileName like "*_\\SuperBird*" or FileName like "*_\\360Browser\\Browser*" or FileName like "*_\\360Chrome\\Chrome*" or FileName like "*_\\Comodo\\Dragon*" or FileName like "*_\\BraveSoftware\\Brave-Browser*" or FileName like "*_\\Torch*" or FileName like "*_\\UCBrowser\\*" or FileName like "*_\\Blisk*" or FileName like "*_\\Epic Privacy Browser*" or FileName like "*_\\Nichrome*" or FileName like "*_\\Amigo*" or FileName like "*_\\Kometa*" or FileName like "*_\\Xpom*" or FileName like "*_\\Microsoft\\Edge*" or FileName like "*_\\Liebao7Default\\EncryptedStorage*" or FileName like "*_\\AVAST Software\\Browser*" or FileName like "*_\\Kinza*" or FileName like "*_\\Mozilla\\SeaMonkey\\*" or FileName like "*_\\Comodo\\IceDragon\\*" or FileName like "*_\\8pecxstudios\\Cyberfox\\*" or FileName like "*_\\FlashPeak\\SlimBrowser\\*" or FileName like "*_\\Moonchild Productions\\Pale Moon\\*")) and ((FileName like "*_\\Profiles\\*" or FileName like "*_\\User Data*")) and (((FileName like "*_\\Login Data*" or FileName like "*_\\Cookies*" or FileName like "*_\\EncryptedStorage*" or FileName like "*_\\WebCache\\*")) or ((FileName endswith "cert9.db" or FileName endswith "cookies.sqlite" or FileName endswith "formhistory.sqlite" or FileName endswith "key3.db" or FileName endswith "key4.db" or FileName endswith "Login Data.sqlite" or FileName endswith "logins.json" or FileName endswith "places.sqlite")))) and not ((((process.executable startswith "C:\\Program Files\\" or process.executable startswith "C:\\Program Files (x86)\\" or process.executable startswith "C:\\Windows\\System32\\" or process.executable startswith "C:\\Windows\\SysWOW64\\")) or ((process.executable endswith "\\Sputnik.exe" or process.executable endswith "\\ChromePlus.exe" or process.executable endswith "\\QIP Surf.exe" or process.executable endswith "\\BlackHawk.exe" or process.executable endswith "\\7Star.exe" or process.executable endswith "\\Sleipnir5.exe" or process.executable endswith "\\Citrio.exe" or process.executable endswith "\\Chrome SxS.exe" or process.executable endswith "\\Chrome.exe" or process.executable endswith "\\Coowon.exe" or process.executable endswith "\\CocCocBrowser.exe" or process.executable endswith "\\Uran.exe" or process.executable endswith "\\QQBrowser.exe" or process.executable endswith "\\Orbitum.exe" or process.executable endswith "\\Slimjet.exe" or process.executable endswith "\\Iridium.exe" or process.executable endswith "\\Vivaldi.exe" or process.executable endswith "\\Chromium.exe" or process.executable endswith "\\GhostBrowser.exe" or process.executable endswith "\\CentBrowser.exe" or process.executable endswith "\\Xvast.exe" or process.executable endswith "\\Chedot.exe" or process.executable endswith "\\SuperBird.exe" or process.executable endswith "\\360Browser.exe" or process.executable endswith "\\360Chrome.exe" or process.executable endswith "\\dragon.exe" or process.executable endswith "\\brave.exe" or process.executable endswith "\\torch.exe" or process.executable endswith "\\UCBrowser.exe" or process.executable endswith "\\BliskBrowser.exe" or process.executable endswith "\\Epic Privacy Browser.exe" or process.executable endswith "\\nichrome.exe" or process.executable endswith "\\AmigoBrowser.exe" or process.executable endswith "\\KometaBrowser.exe" or process.executable endswith "\\XpomBrowser.exe" or process.executable endswith "\\msedge.exe" or process.executable endswith "\\LiebaoBrowser.exe" or process.executable endswith "\\AvastBrowser.exe" or process.executable endswith "\\Kinza.exe" or process.executable endswith "\\seamonkey.exe" or process.executable endswith "\\icedragon.exe" or process.executable endswith "\\cyberfox.exe" or process.executable endswith "\\SlimBrowser.exe" or process.executable endswith "\\palemoon.exe")) or ((process.executable like "*_\\Sputnik\\*" or process.executable like "*_\\MapleStudio\\*" or process.executable like "*_\\QIP Surf\\*" or process.executable like "*_\\BlackHawk\\*" or process.executable like "*_\\7Star\\*" or process.executable like "*_\\Fenrir Inc\\*" or process.executable like "*_\\CatalinaGroup\\*" or process.executable like "*_\\Google\\*" or process.executable like "*_\\Coowon\\*" or process.executable like "*_\\CocCoc\\*" or process.executable like "*_\\uCozMedia\\*" or process.executable like "*_\\Tencent\\*" or process.executable like "*_\\Orbitum\\*" or process.executable like "*_\\Slimjet\\*" or process.executable like "*_\\Iridium\\*" or process.executable like "*_\\Vivaldi\\*" or process.executable like "*_\\Chromium\\*" or process.executable like "*_\\GhostBrowser\\*" or process.executable like "*_\\CentBrowser\\*" or process.executable like "*_\\Xvast\\*" or process.executable like "*_\\Chedot\\*" or process.executable like "*_\\SuperBird\\*" or process.executable like "*_\\360Browser\\*" or process.executable like "*_\\360Chrome\\*" or process.executable like "*_\\Comodo\\*" or process.executable like "*_\\BraveSoftware\\*" or process.executable like "*_\\Torch\\*" or process.executable like "*_\\UCBrowser\\*" or process.executable like "*_\\Blisk\\*" or process.executable like "*_\\Epic Privacy Browser\\*" or process.executable like "*_\\Nichrome\\*" or process.executable like "*_\\Amigo\\*" or process.executable like "*_\\Kometa\\*" or process.executable like "*_\\Xpom\\*" or process.executable like "*_\\Microsoft\\*" or process.executable like "*_\\Liebao7\\*" or process.executable like "*_\\AVAST Software\\*" or process.executable like "*_\\Kinza\\*" or process.executable like "*_\\Mozilla\\*" or process.executable like "*_\\8pecxstudios\\*" or process.executable like "*_\\FlashPeak\\*" or process.executable like "*_\\Moonchild Productions\\*")) or (process.executable == "System" and process.parent.executable == "Idle"))) and not (((process.executable like "*_\\Microsoft\\Windows Defender\\*" and (process.executable endswith "\\MpCopyAccelerator.exe" or process.executable endswith "\\MsMpEng.exe")) or (process.parent.executable == "C:\\Windows\\System32\\msiexec.exe") or (process.executable endswith "\\everything.exe") or ((process.executable endswith "\\thor.exe" or process.executable endswith "\\thor64.exe")))))
