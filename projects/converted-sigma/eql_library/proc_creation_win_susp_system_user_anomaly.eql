// Title: Suspicious SYSTEM User Process Creation
// ID: 2617e7ed-adb7-40ba-b0f3-8f9945fe6c09
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), David ANDRE (additional keywords)
// Date: 2021-12-20
// Tags: attack.credential-access, attack.privilege-escalation, attack.stealth, attack.t1134, attack.t1003, attack.t1027
// Description: Detects a suspicious process creation as SYSTEM user (suspicious program or command line parameter)
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((IntegrityLevel == "System" or IntegrityLevel == "S-1-16-16384") and (user.name like "*_AUTHORI*" or user.name like "*_AUTORI*")) and (((process.executable endswith "\\calc.exe" or process.executable endswith "\\cscript.exe" or process.executable endswith "\\forfiles.exe" or process.executable endswith "\\hh.exe" or process.executable endswith "\\mshta.exe" or process.executable endswith "\\ping.exe" or process.executable endswith "\\wscript.exe")) or (process.command_line regex "net\\s+user\\s+") or ((process.command_line like "*_ -NoP *" or process.command_line like "*_ -W Hidden *" or process.command_line like "*_ -decode *" or process.command_line like "*_ /decode *" or process.command_line like "*_ /urlcache *" or process.command_line like "*_ -urlcache *" or process.command_line like "*_ -e* JAB*" or process.command_line like "*_ -e* SUVYI*" or process.command_line like "*_ -e* SQBFAFgA*" or process.command_line like "*_ -e* aWV4I*" or process.command_line like "*_ -e* IAB*" or process.command_line like "*_ -e* PAA*" or process.command_line like "*_ -e* aQBlAHgA*" or process.command_line like "*_vssadmin delete shadows*" or process.command_line like "*_reg SAVE HKLM*" or process.command_line like "*_ -ma *" or process.command_line like "*_Microsoft\\Windows\\CurrentVersion\\Run*" or process.command_line like "*_.downloadstring(*" or process.command_line like "*_.downloadfile(*" or process.command_line like "*_ /ticket:*" or process.command_line like "*_dpapi::*" or process.command_line like "*_event::clear*" or process.command_line like "*_event::drop*" or process.command_line like "*_id::modify*" or process.command_line like "*_kerberos::*" or process.command_line like "*_lsadump::*" or process.command_line like "*_misc::*" or process.command_line like "*_privilege::*" or process.command_line like "*_rpc::*" or process.command_line like "*_sekurlsa::*" or process.command_line like "*_sid::*" or process.command_line like "*_token::*" or process.command_line like "*_vault::cred*" or process.command_line like "*_vault::list*" or process.command_line like "*_ p::d *" or process.command_line like "*_;iex(*" or process.command_line like "*_MiniDump*")))) and not (((process.parent.executable like "*_:\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\*") or ((process.parent.executable like "*_:\\Program Files (x86)\\Java\\*" or process.parent.executable like "*_:\\Program Files\\Java\\*") and process.parent.executable endswith "\\bin\\javaws.exe" and (process.executable like "*_:\\Program Files (x86)\\Java\\*" or process.executable like "*_:\\Program Files\\Java\\*") and process.executable endswith "\\bin\\jp2launcher.exe" and process.command_line like "*_ -ma *") or ((process.command_line like "*_ping*" and process.command_line like "*_127.0.0.1*" and process.command_line like "*_ -n *")) or (process.executable endswith "\\PING.EXE" and process.parent.command_line like "*_\\DismFoDInstall.cmd*"))))
