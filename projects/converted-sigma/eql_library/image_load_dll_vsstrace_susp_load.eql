// Title: Potentially Suspicious Volume Shadow Copy Vsstrace.dll Load
// ID: 48bfd177-7cf2-412b-ad77-baf923489e82
// Status: test
// Level: medium
// Author: frack113
// Date: 2023-02-17
// Tags: attack.impact, attack.t1490
// Description: Detects the image load of VSS DLL by uncommon executables
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((ImageLoaded endswith "\\vsstrace.dll") and not (((process.executable == null) or ((process.executable startswith "C:\\Program Files\\" or process.executable startswith "C:\\Program Files (x86)\\")) or (((process.executable == "C:\\Windows\\explorer.exe" or process.executable == "C:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe" or process.executable == "C:\\Windows\\servicing\\TrustedInstaller.exe")) or ((process.executable startswith "C:\\Windows\\System32\\" or process.executable startswith "C:\\Windows\\SysWOW64\\" or process.executable startswith "C:\\Windows\\Temp\\{" or process.executable startswith "C:\\Windows\\WinSxS\\" or process.executable startswith "C:\\ProgramData\\Package Cache\\{"))))) and not ((((process.executable like "*_\\temp\\is-*" and process.executable like "*_\\avira_system_speedup.tmp*")) or (process.executable startswith "C:\\$WinREAgent\\Scratch\\"))))
