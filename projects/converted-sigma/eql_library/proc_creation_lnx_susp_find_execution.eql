// Title: Potential Discovery Activity Using Find - Linux
// ID: 8344c0e5-5783-47cc-9cf9-a0f7fd03e6cf
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-28
// Tags: attack.discovery, attack.t1083
// Description: Detects usage of "find" binary in a suspicious manner to perform discovery
// Converted by: Sigma Universal SIEM/EDR CLI

process where (process.executable endswith "/find" and (process.command_line like "*_-perm -4000*" or process.command_line like "*_-perm -2000*" or process.command_line like "*_-perm 0777*" or process.command_line like "*_-perm -222*" or process.command_line like "*_-perm -o w*" or process.command_line like "*_-perm -o x*" or process.command_line like "*_-perm -u=s*" or process.command_line like "*_-perm -g=s*"))
