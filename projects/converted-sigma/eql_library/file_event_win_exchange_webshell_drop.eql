// Title: Suspicious ASPX File Drop by Exchange
// ID: bd1212e5-78da-431e-95fa-c58e3237a8e6
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), MSTI (query, idea)
// Date: 2022-10-01
// Tags: attack.persistence, attack.t1505.003
// Description: Detects suspicious file type dropped by an Exchange component in IIS into a suspicious folder
// Converted by: Sigma Universal SIEM/EDR CLI

file where ((process.executable endswith "\\w3wp.exe" and process.command_line like "*_MSExchange*" and (file.path like "*_FrontEnd\\HttpProxy\\*" or file.path like "*_\\inetpub\\wwwroot\\aspnet_client\\*")) and ((file.path endswith ".aspx" or file.path endswith ".asp" or file.path endswith ".ashx")))
