// Title: MSI Installation From Suspicious Locations
// ID: c7c8aa1c-5aff-408e-828b-998e3620b341
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-31
// Tags: attack.execution
// Description: Detects MSI package installation from suspicious locations
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((winlog.provider_name == "MsiInstaller" and (winlog.event_id == 1040 or winlog.event_id == 1042) and (Data like "*_:\\Windows\\TEMP\\*" or Data like "*_\\\\\\\\*" or Data like "*_\\Desktop\\*" or Data like "*_\\PerfLogs\\*" or Data like "*_\\Users\\Public\\*")) and not (((Data like "*_C:\\Windows\\TEMP\\UpdHealthTools.msi*") or (Data like "*_\\AppData\\Local\\Temp\\WinGet\\*"))))
