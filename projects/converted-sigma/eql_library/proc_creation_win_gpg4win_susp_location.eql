// Title: File Encryption/Decryption Via Gpg4win From Suspicious Locations
// ID: e1e0b7d7-e10b-4ee4-ac49-a4bda05d320d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2022-11-30
// Tags: attack.execution
// Description: Detects usage of Gpg4win to encrypt/decrypt files located in potentially suspicious locations.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.command_line like "*_-passphrase*") and (((process.executable endswith "\\gpg.exe" or process.executable endswith "\\gpg2.exe")) or (Product == "GNU Privacy Guard (GnuPG)") or (Description == "GnuPG’s OpenPGP tool")) and ((process.command_line like "*_:\\PerfLogs\\*" or process.command_line like "*_:\\Temp\\*" or process.command_line like "*_:\\Users\\Public\\*" or process.command_line like "*_:\\Windows\\Temp\\*" or process.command_line like "*_\\AppData\\Local\\Temp\\*" or process.command_line like "*_\\AppData\\Roaming\\*")))
