// Title: Imports Registry Key From a File
// ID: 73bba97f-a82d-42ce-b315-9182e76c57b1
// Status: test
// Level: medium
// Author: Oddvar Moe, Sander Wiebing, oscd.community
// Date: 2020-10-07
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects the import of the specified file to the registry with regedit.exe.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.command_line like "*_ /i *" or process.command_line like "*_ /s *" or process.command_line like "*_.reg*")) and ((process.executable endswith "\\regedit.exe") or (process.pe.original_file_name == "REGEDIT.EXE"))) and not ((((process.command_line like "*_ -e *" or process.command_line like "*_ -a *" or process.command_line like "*_ -c *")) and (process.command_line regex ":[^ \\\\]"))))
