// Title: Scripting/CommandLine Process Spawned Regsvr32
// ID: ab37a6ec-6068-432b-a64e-2c7bf95b1d22
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-26
// Tags: attack.stealth, attack.t1218.010
// Description: Detects various command line and scripting engines/processes such as "PowerShell", "Wscript", "Cmd", etc. spawning a "regsvr32" instance.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.parent.executable endswith "\\cmd.exe" or process.parent.executable endswith "\\cscript.exe" or process.parent.executable endswith "\\mshta.exe" or process.parent.executable endswith "\\powershell_ise.exe" or process.parent.executable endswith "\\powershell.exe" or process.parent.executable endswith "\\pwsh.exe" or process.parent.executable endswith "\\wscript.exe") and process.executable endswith "\\regsvr32.exe") and not ((process.parent.executable == "C:\\Windows\\System32\\cmd.exe" and process.command_line endswith " /s C:\\Windows\\System32\\RpcProxy\\RpcProxy.dll")))
