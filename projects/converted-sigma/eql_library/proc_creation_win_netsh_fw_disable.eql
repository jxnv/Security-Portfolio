// Title: Firewall Disabled via Netsh.EXE
// ID: 57c4bf16-227f-4394-8ec7-1b745ee061c3
// Status: test
// Level: medium
// Author: Fatih Sirin
// Date: 2019-11-01
// Tags: attack.defense-impairment, attack.t1686.003, attack.s0108
// Description: Detects netsh commands that turns off the Windows firewall
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.executable endswith "\\netsh.exe") or (process.pe.original_file_name == "netsh.exe")) and (((process.command_line like "*_firewall*" and process.command_line like "*_set*" and process.command_line like "*_opmode*" and process.command_line like "*_disable*")) or ((process.command_line like "*_advfirewall*" and process.command_line like "*_set*" and process.command_line like "*_state*" and process.command_line like "*_off*"))))
