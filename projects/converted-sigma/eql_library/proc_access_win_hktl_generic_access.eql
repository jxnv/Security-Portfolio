// Tags: attack.credential-access, attack.t1003.001, attack.s0002
// Description: Detects process access requests from hacktool processes based on their default image name
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((SourceImage endswith "\\Akagi.exe" or SourceImage endswith "\\Akagi64.exe" or SourceImage endswith "\\atexec_windows.exe" or SourceImage endswith "\\Certify.exe" or SourceImage endswith "\\Certipy.exe" or SourceImage endswith "\\CoercedPotato.exe" or SourceImage endswith "\\crackmapexec.exe" or SourceImage endswith "\\CreateMiniDump.exe" or SourceImage endswith "\\dcomexec_windows.exe" or SourceImage endswith "\\dpapi_windows.exe" or SourceImage endswith "\\findDelegation_windows.exe" or SourceImage endswith "\\GetADUsers_windows.exe" or SourceImage endswith "\\GetNPUsers_windows.exe" or SourceImage endswith "\\getPac_windows.exe" or SourceImage endswith "\\getST_windows.exe" or SourceImage endswith "\\getTGT_windows.exe" or SourceImage endswith "\\GetUserSPNs_windows.exe" or SourceImage endswith "\\gmer.exe" or SourceImage endswith "\\hashcat.exe" or SourceImage endswith "\\htran.exe" or SourceImage endswith "\\ifmap_windows.exe" or SourceImage endswith "\\impersonate.exe" or SourceImage endswith "\\Inveigh.exe" or SourceImage endswith "\\LocalPotato.exe" or SourceImage endswith "\\mimikatz_windows.exe" or SourceImage endswith "\\mimikatz.exe" or SourceImage endswith "\\netview_windows.exe" or SourceImage endswith "\\nmapAnswerMachine_windows.exe" or SourceImage endswith "\\opdump_windows.exe" or SourceImage endswith "\\PasswordDump.exe" or SourceImage endswith "\\Potato.exe" or SourceImage endswith "\\PowerTool.exe" or SourceImage endswith "\\PowerTool64.exe" or SourceImage endswith "\\psexec_windows.exe" or SourceImage endswith "\\PurpleSharp.exe" or SourceImage endswith "\\pypykatz.exe" or SourceImage endswith "\\QuarksPwDump.exe" or SourceImage endswith "\\rdp_check_windows.exe" or SourceImage endswith "\\Rubeus.exe" or SourceImage endswith "\\SafetyKatz.exe" or SourceImage endswith "\\sambaPipe_windows.exe" or SourceImage endswith "\\SelectMyParent.exe" or SourceImage endswith "\\SharpChisel.exe" or SourceImage endswith "\\SharPersist.exe" or SourceImage endswith "\\SharpEvtMute.exe" or SourceImage endswith "\\SharpImpersonation.exe" or SourceImage endswith "\\SharpLDAPmonitor.exe" or SourceImage endswith "\\SharpLdapWhoami.exe" or SourceImage endswith "\\SharpUp.exe" or SourceImage endswith "\\SharpView.exe" or SourceImage endswith "\\smbclient_windows.exe" or SourceImage endswith "\\smbserver_windows.exe" or SourceImage endswith "\\sniff_windows.exe" or SourceImage endswith "\\sniffer_windows.exe" or SourceImage endswith "\\split_windows.exe" or SourceImage endswith "\\SpoolSample.exe" or SourceImage endswith "\\Stracciatella.exe" or SourceImage endswith "\\SysmonEOP.exe" or SourceImage endswith "\\temp\\rot.exe" or SourceImage endswith "\\ticketer_windows.exe" or SourceImage endswith "\\TruffleSnout.exe" or SourceImage endswith "\\winPEASany_ofs.exe" or SourceImage endswith "\\winPEASany.exe" or SourceImage endswith "\\winPEASx64_ofs.exe" or SourceImage endswith "\\winPEASx64.exe" or SourceImage endswith "\\winPEASx86_ofs.exe" or SourceImage endswith "\\winPEASx86.exe" or SourceImage endswith "\\xordump.exe")) or ((SourceImage like "*_\\goldenPac*" or SourceImage like "*_\\just_dce_*" or SourceImage like "*_\\karmaSMB*" or SourceImage like "*_\\kintercept*" or SourceImage like "*_\\LocalPotato*" or SourceImage like "*_\\ntlmrelayx*" or SourceImage like "*_\\rpcdump*" or SourceImage like "*_\\samrdump*" or SourceImage like "*_\\secretsdump*" or SourceImage like "*_\\smbexec*" or SourceImage like "*_\\smbrelayx*" or SourceImage like "*_\\wmiexec*" or SourceImage like "*_\\wmipersist*" or SourceImage like "*_HotPotato*" or SourceImage like "*_Juicy Potato*" or SourceImage like "*_JuicyPotato*" or SourceImage like "*_PetitPotam*" or SourceImage like "*_RottenPotato*")))
