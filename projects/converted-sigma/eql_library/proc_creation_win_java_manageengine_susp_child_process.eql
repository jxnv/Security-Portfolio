// Title: Suspicious Child Process Of Manage Engine ServiceDesk
// ID: cea2b7ea-792b-405f-95a1-b903ea06458f
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2023-01-18
// Tags: attack.command-and-control, attack.t1102
// Description: Detects suspicious child processes of the "Manage Engine ServiceDesk Plus" Java web service
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.parent.executable like "*_\\ManageEngine\\ServiceDesk\\*" and process.parent.executable like "*_\\java.exe*") and (process.executable endswith "\\AppVLP.exe" or process.executable endswith "\\bash.exe" or process.executable endswith "\\bitsadmin.exe" or process.executable endswith "\\calc.exe" or process.executable endswith "\\certutil.exe" or process.executable endswith "\\cscript.exe" or process.executable endswith "\\curl.exe" or process.executable endswith "\\forfiles.exe" or process.executable endswith "\\mftrace.exe" or process.executable endswith "\\mshta.exe" or process.executable endswith "\\net.exe" or process.executable endswith "\\net1.exe" or process.executable endswith "\\notepad.exe" or process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe" or process.executable endswith "\\query.exe" or process.executable endswith "\\reg.exe" or process.executable endswith "\\schtasks.exe" or process.executable endswith "\\scrcons.exe" or process.executable endswith "\\sh.exe" or process.executable endswith "\\systeminfo.exe" or process.executable endswith "\\whoami.exe" or process.executable endswith "\\wmic.exe" or process.executable endswith "\\wscript.exe")) and not (((process.executable endswith "\\net.exe" or process.executable endswith "\\net1.exe") and process.command_line like "*_ stop*")))
