// Title: Control Panel Items
// ID: 0ba863e6-def5-4e50-9cea-4dd8c7dc46a4
// Status: test
// Level: high
// Author: Kyaw Min Thein, Furkan Caliskan (@caliskanfurkan_)
// Date: 2020-06-22
// Tags: attack.privilege-escalation, attack.execution, attack.stealth, attack.t1218.002, attack.persistence, attack.t1546
// Description: Detects the malicious use of a control panel item
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.command_line like "*_add*" and process.command_line like "*_CurrentVersion\\Control Panel\\CPLs*")) and ((process.executable endswith "\\reg.exe") or (process.pe.original_file_name == "reg.exe"))) or ((process.command_line endswith ".cpl") and not ((((process.command_line like "*_regsvr32 *" and process.command_line like "*_ /s *" and process.command_line like "*_igfxCPL.cpl*")) or ((process.command_line like "*_\\System32\\*" or process.command_line like "*_%System%*" or process.command_line like "*_|C:\\Windows\\system32|*"))))))
