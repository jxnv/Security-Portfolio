// Title: Suspicious Microsoft OneNote Child Process
// ID: c27515df-97a9-4162-8a60-dc0eeb51b775
// Status: test
// Level: high
// Author: Tim Rauch (Nextron Systems), Nasreddine Bencherchali (Nextron Systems), Elastic (idea)
// Date: 2022-10-21
// Tags: attack.t1566, attack.t1566.001, attack.initial-access
// Description: Detects suspicious child processes of the Microsoft OneNote application. This may indicate an attempt to execute malicious embedded objects from a .one file.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.parent.executable endswith "\\onenote.exe") and ((process.executable endswith "\\explorer.exe" and (process.command_line like "*_.hta*" or process.command_line like "*_.vb*" or process.command_line like "*_.wsh*" or process.command_line like "*_.js*" or process.command_line like "*_.ps*" or process.command_line like "*_.scr*" or process.command_line like "*_.pif*" or process.command_line like "*_.bat*" or process.command_line like "*_.cmd*")) or (((process.pe.original_file_name == "bitsadmin.exe" or process.pe.original_file_name == "CertOC.exe" or process.pe.original_file_name == "CertUtil.exe" or process.pe.original_file_name == "Cmd.Exe" or process.pe.original_file_name == "CMSTP.EXE" or process.pe.original_file_name == "cscript.exe" or process.pe.original_file_name == "curl.exe" or process.pe.original_file_name == "HH.exe" or process.pe.original_file_name == "IEExec.exe" or process.pe.original_file_name == "InstallUtil.exe" or process.pe.original_file_name == "javaw.exe" or process.pe.original_file_name == "Microsoft.Workflow.Compiler.exe" or process.pe.original_file_name == "msdt.exe" or process.pe.original_file_name == "MSHTA.EXE" or process.pe.original_file_name == "msiexec.exe" or process.pe.original_file_name == "Msxsl.exe" or process.pe.original_file_name == "odbcconf.exe" or process.pe.original_file_name == "pcalua.exe" or process.pe.original_file_name == "PowerShell.EXE" or process.pe.original_file_name == "RegAsm.exe" or process.pe.original_file_name == "RegSvcs.exe" or process.pe.original_file_name == "REGSVR32.exe" or process.pe.original_file_name == "RUNDLL32.exe" or process.pe.original_file_name == "schtasks.exe" or process.pe.original_file_name == "ScriptRunner.exe" or process.pe.original_file_name == "wmic.exe" or process.pe.original_file_name == "WorkFolders.exe" or process.pe.original_file_name == "wscript.exe")) or ((process.executable endswith "\\AppVLP.exe" or process.executable endswith "\\bash.exe" or process.executable endswith "\\bitsadmin.exe" or process.executable endswith "\\certoc.exe" or process.executable endswith "\\certutil.exe" or process.executable endswith "\\cmd.exe" or process.executable endswith "\\cmstp.exe" or process.executable endswith "\\control.exe" or process.executable endswith "\\cscript.exe" or process.executable endswith "\\curl.exe" or process.executable endswith "\\forfiles.exe" or process.executable endswith "\\hh.exe" or process.executable endswith "\\ieexec.exe" or process.executable endswith "\\installutil.exe" or process.executable endswith "\\javaw.exe" or process.executable endswith "\\mftrace.exe" or process.executable endswith "\\Microsoft.Workflow.Compiler.exe" or process.executable endswith "\\msbuild.exe" or process.executable endswith "\\msdt.exe" or process.executable endswith "\\mshta.exe" or process.executable endswith "\\msidb.exe" or process.executable endswith "\\msiexec.exe" or process.executable endswith "\\msxsl.exe" or process.executable endswith "\\odbcconf.exe" or process.executable endswith "\\pcalua.exe" or process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe" or process.executable endswith "\\regasm.exe" or process.executable endswith "\\regsvcs.exe" or process.executable endswith "\\regsvr32.exe" or process.executable endswith "\\rundll32.exe" or process.executable endswith "\\schtasks.exe" or process.executable endswith "\\scrcons.exe" or process.executable endswith "\\scriptrunner.exe" or process.executable endswith "\\sh.exe" or process.executable endswith "\\svchost.exe" or process.executable endswith "\\verclsid.exe" or process.executable endswith "\\wmic.exe" or process.executable endswith "\\workfolders.exe" or process.executable endswith "\\wscript.exe"))) or ((process.executable like "*_\\AppData\\*" or process.executable like "*_\\Users\\Public\\*" or process.executable like "*_\\ProgramData\\*" or process.executable like "*_\\Windows\\Tasks\\*" or process.executable like "*_\\Windows\\Temp\\*" or process.executable like "*_\\Windows\\System32\\Tasks\\*"))) and not (((process.executable like "*_\\AppData\\Local\\Microsoft\\OneDrive\\*" and process.executable endswith "\\FileCoAuth.exe" and process.command_line endswith "-Embedding") or (process.executable endswith "\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe" and process.command_line endswith "-Embedding"))))
