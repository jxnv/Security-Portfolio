// Title: Msiexec Quiet Installation
// ID: 79a87aa6-e4bd-42fc-a5bb-5e6fbdcd62f5
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-01-16
// Tags: attack.stealth, attack.t1218.007
// Description: Adversaries may abuse msiexec.exe to proxy execution of malicious payloads.
// Msiexec.exe is the command-line utility for the Windows Installer and is thus commonly associated with executing installation packages (.msi)
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.command_line like "*_-i*" or process.command_line like "*_/i*" or process.command_line like "*_-package*" or process.command_line like "*_/package*" or process.command_line like "*_-a*" or process.command_line like "*_/a*" or process.command_line like "*_-j*" or process.command_line like "*_/j*")) and ((process.executable endswith "\\msiexec.exe") or (process.pe.original_file_name == "msiexec.exe")) and ((process.command_line like "*_-q*" or process.command_line like "*_/q*"))) and not (((process.parent.executable == "C:\\Windows\\CCM\\Ccm32BitLauncher.exe" and (IntegrityLevel == "System" or IntegrityLevel == "S-1-16-16384")) or (process.parent.executable startswith "C:\\Windows\\Temp\\"))) and not (((process.parent.executable startswith "C:\\Users\\" and process.parent.executable like "*_\\AppData\\Local\\Temp\\*") or (process.parent.executable endswith "C:\\Windows\\System32\\wsl.exe" and process.executable endswith "C:\\Windows\\System32\\msiexec.exe"))))
