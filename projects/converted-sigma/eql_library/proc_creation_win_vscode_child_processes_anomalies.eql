// Title: Potentially Suspicious Child Process Of VsCode
// ID: 5a3164f2-b373-4152-93cf-090b13c12d27
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-26
// Tags: attack.execution, attack.stealth, attack.t1218, attack.t1202
// Description: Detects uncommon or suspicious child processes spawning from a VsCode "code.exe" process. This could indicate an attempt of persistence via VsCode tasks or terminal profiles.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.parent.executable endswith "\\code.exe") and (((process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe" or process.executable endswith "\\cmd.exe") and (process.command_line like "*_Invoke-Expressions*" or process.command_line like "*_IEX*" or process.command_line like "*_Invoke-Command*" or process.command_line like "*_ICM*" or process.command_line like "*_DownloadString*" or process.command_line like "*_rundll32*" or process.command_line like "*_regsvr32*" or process.command_line like "*_wscript*" or process.command_line like "*_cscript*")) or ((process.executable endswith "\\calc.exe" or process.executable endswith "\\regsvr32.exe" or process.executable endswith "\\rundll32.exe" or process.executable endswith "\\cscript.exe" or process.executable endswith "\\wscript.exe")) or ((process.executable like "*_:\\Users\\Public\\*" or process.executable like "*_:\\Windows\\Temp\\*" or process.executable like "*_:\\Temp\\*"))))
