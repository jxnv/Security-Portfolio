// Title: Invoke-Obfuscation VAR++ LAUNCHER OBFUSCATION
// ID: e9f55347-2928-4c06-88e5-1a7f8169942e
// Status: test
// Level: high
// Author: Timur Zinniatullin, oscd.community
// Date: 2020-10-13
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via VAR++ LAUNCHER
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.command_line like "*_&&set*" and process.command_line like "*_cmd*" and process.command_line like "*_/c*" and process.command_line like "*_-f*") and (process.command_line like "*_{0}*" or process.command_line like "*_{1}*" or process.command_line like "*_{2}*" or process.command_line like "*_{3}*" or process.command_line like "*_{4}*" or process.command_line like "*_{5}*"))
