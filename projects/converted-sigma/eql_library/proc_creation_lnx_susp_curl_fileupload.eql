// Title: Suspicious Curl File Upload - Linux
// ID: 00b90cc1-17ec-402c-96ad-3a8117d7a582
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Cedric MAURUGEON (Update)
// Date: 2022-09-15
// Tags: attack.exfiltration, attack.command-and-control, attack.t1567, attack.t1105
// Description: Detects a suspicious curl process start the adds a file to a web request
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((((process.command_line like "*_ --form*" or process.command_line like "*_ --upload-file *" or process.command_line like "*_ --data *" or process.command_line like "*_ --data-*")) or (process.command_line regex "\\s-[FTd]\\s")) and (process.executable endswith "/curl")) and not (((process.command_line like "*_://localhost*" or process.command_line like "*_://127.0.0.1*"))))
