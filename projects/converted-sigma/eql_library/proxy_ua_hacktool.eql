// Description: Detects suspicious user agent strings user by hack tools in proxy logs
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((c-useragent like "*_(hydra)*" or c-useragent like "*_ arachni/*" or c-useragent like "*_ BFAC *" or c-useragent like "*_ brutus *" or c-useragent like "*_ cgichk *" or c-useragent like "*_core-project/1.0*" or c-useragent like "*_ crimscanner/*" or c-useragent like "*_datacha0s*" or c-useragent like "*_dirbuster*" or c-useragent like "*_domino hunter*" or c-useragent like "*_dotdotpwn*" or c-useragent like "*_FHScan Core*" or c-useragent like "*_floodgate*" or c-useragent like "*_get-minimal*" or c-useragent like "*_gootkit auto-rooter scanner*" or c-useragent like "*_grendel-scan*" or c-useragent like "*_ inspath *" or c-useragent like "*_internet ninja*" or c-useragent like "*_jaascois*" or c-useragent like "*_ zmeu *" or c-useragent like "*_masscan*" or c-useragent like "*_ metis *" or c-useragent like "*_morfeus fucking scanner*" or c-useragent like "*_n-stealth*" or c-useragent like "*_nsauditor*" or c-useragent like "*_pmafind*" or c-useragent like "*_security scan*" or c-useragent like "*_springenwerk*" or c-useragent like "*_teh forest lobster*" or c-useragent like "*_toata dragostea*" or c-useragent like "*_ vega/*" or c-useragent like "*_voideye*" or c-useragent like "*_webshag*" or c-useragent like "*_webvulnscan*" or c-useragent like "*_ whcc/*" or c-useragent like "*_ Havij*" or c-useragent like "*_absinthe*" or c-useragent like "*_bsqlbf*" or c-useragent like "*_mysqloit*" or c-useragent like "*_pangolin*" or c-useragent like "*_sql power injector*" or c-useragent like "*_sqlmap*" or c-useragent like "*_sqlninja*" or c-useragent like "*_uil2pn*" or c-useragent like "*_ruler*" or c-useragent like "*_Mozilla/5.0 (Windows; U; Windows NT 5.1; pt-PT; rv:1.9.1.2) Gecko/20090729 Firefox/3.5.2 (.NET CLR 3.5.30729)*"))
