// Title: Potential Persistence Via GlobalFlags
// ID: 36803969-5421-41ec-b92f-8500f79c23b0
// Status: test
// Level: high
// Author: Karneades, Jonhnathan Ribeiro, Florian Roth
// Date: 2018-04-11
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.012, car.2013-01-002
// Description: Detects registry persistence technique using the GlobalFlags and SilentProcessExit keys
// Converted by: Sigma Universal SIEM/EDR CLI

registry where (((registry.path like "*_\\Microsoft\\Windows NT\\CurrentVersion\\*" and registry.path like "*_\\Image File Execution Options\\*" and registry.path like "*_\\GlobalFlag*")) or ((registry.path like "*_\\Microsoft\\Windows NT\\CurrentVersion\\*" and registry.path like "*_\\SilentProcessExit\\*") and (registry.path like "*_\\ReportingMode*" or registry.path like "*_\\MonitorProcess*")))
