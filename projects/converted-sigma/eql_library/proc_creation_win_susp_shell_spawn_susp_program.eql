// Title: Windows Shell/Scripting Processes Spawning Suspicious Programs
// ID: 3a6586ad-127a-4d3b-a677-1e6eacdf8fde
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Tim Shelton
// Date: 2018-04-06
// Tags: attack.execution, attack.stealth, attack.t1059.005, attack.t1059.001, attack.t1218
// Description: Detects suspicious child processes of a Windows shell and scripting processes such as wscript, rundll32, powershell, mshta...etc.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.parent.executable endswith "\\mshta.exe" or process.parent.executable endswith "\\powershell.exe" or process.parent.executable endswith "\\pwsh.exe" or process.parent.executable endswith "\\rundll32.exe" or process.parent.executable endswith "\\cscript.exe" or process.parent.executable endswith "\\wscript.exe" or process.parent.executable endswith "\\wmiprvse.exe" or process.parent.executable endswith "\\regsvr32.exe") and (process.executable endswith "\\schtasks.exe" or process.executable endswith "\\nslookup.exe" or process.executable endswith "\\certutil.exe" or process.executable endswith "\\bitsadmin.exe" or process.executable endswith "\\mshta.exe")) and not ((((process.parent.command_line like "*_\\Program Files\\Amazon\\WorkSpacesConfig\\Scripts\\setup-scheduledtask.ps1*" or process.parent.command_line like "*_\\Program Files\\Amazon\\WorkSpacesConfig\\Scripts\\set-selfhealing.ps1*" or process.parent.command_line like "*_\\Program Files\\Amazon\\WorkSpacesConfig\\Scripts\\check-workspacehealth.ps1*" or process.parent.command_line like "*_\\nessus_*")) or (CurrentDirectory like "*_\\ccmcache\\*") or (process.command_line like "*_\\nessus_*") or (process.parent.executable endswith "\\mshta.exe" and process.executable endswith "\\mshta.exe" and (process.parent.command_line like "*_C:\\MEM_Configmgr_*" and process.parent.command_line like "*_\\splash.hta*" and process.parent.command_line like "*_{1E460BD7-F1C3-4B2E-88BF-4E770A288AF5}*") and (process.command_line like "*_C:\\MEM_Configmgr_*" and process.command_line like "*_\\SMSSETUP\\BIN\\*" and process.command_line like "*_\\autorun.hta*" and process.command_line like "*_{1E460BD7-F1C3-4B2E-88BF-4E770A288AF5}*")))))
