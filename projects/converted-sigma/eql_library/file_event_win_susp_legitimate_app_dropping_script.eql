// Title: Legitimate Application Dropped Script
// ID: 7d604714-e071-49ff-8726-edeb95a70679
// Status: test
// Level: high
// Author: frack113, Florian Roth (Nextron Systems)
// Date: 2022-08-21
// Tags: attack.stealth, attack.t1218
// Description: Detects LOLBINs and applications that should not legitimately drop script files to disk.
// This may indicate malware staging or abuse of a trusted binary for script-based code execution.
// Converted by: Sigma Universal SIEM/EDR CLI

file where (((process.executable endswith "\\eqnedt32.exe" or process.executable endswith "\\wordpad.exe" or process.executable endswith "\\wordview.exe" or process.executable endswith "\\certutil.exe" or process.executable endswith "\\certoc.exe" or process.executable endswith "\\CertReq.exe" or process.executable endswith "\\Desktopimgdownldr.exe" or process.executable endswith "\\esentutl.exe" or process.executable endswith "\\mshta.exe" or process.executable endswith "\\AcroRd32.exe" or process.executable endswith "\\RdrCEF.exe" or process.executable endswith "\\hh.exe" or process.executable endswith "\\finger.exe") and (file.path endswith ".bat" or file.path endswith ".chm" or file.path endswith ".csproj" or file.path endswith ".hta" or file.path endswith ".js" or file.path endswith ".jse" or file.path endswith ".proj" or file.path endswith ".ps1" or file.path endswith ".py" or file.path endswith ".scf" or file.path endswith ".vbe" or file.path endswith ".vbs" or file.path endswith ".wsf" or file.path endswith ".wsh")) and not ((process.executable endswith "\\mshta.exe" and file.path endswith ".hta")))
