// Title: Process Memory Dump Via Comsvcs.DLL
// ID: 646ea171-dded-4578-8a4d-65e9822892e3
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Modexp, Nasreddine Bencherchali (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2020-02-18
// Tags: attack.credential-access, attack.stealth, attack.t1036, attack.t1003.001, car.2013-05-009
// Description: Detects a process memory dump via "comsvcs.dll" using rundll32, covering multiple different techniques (ordinal, minidump function, etc.)
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.executable endswith "\\rundll32.exe") or (process.pe.original_file_name == "RUNDLL32.EXE") or (process.command_line like "*_rundll32*")) and ((process.command_line like "*_comsvcs*" and process.command_line like "*_full*") and (process.command_line like "*_#-*" or process.command_line like "*_#+*" or process.command_line like "*_#24*" or process.command_line like "*_24 *" or process.command_line like "*_MiniDump*" or process.command_line like "*_#65560*"))) or ((process.command_line like "*_24*" and process.command_line like "*_comsvcs*" and process.command_line like "*_full*") and (process.command_line like "*_ #*" or process.command_line like "*_,#*" or process.command_line like "*_, #*" or process.command_line like "*_\"#*")))
