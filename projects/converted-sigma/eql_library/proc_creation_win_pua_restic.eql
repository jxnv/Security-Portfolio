// Title: PUA - Restic Backup Tool Execution
// ID: 6ddff2e8-ea1a-45d0-8938-93dfc1d67ae7
// Status: experimental
// Level: high
// Author: Nounou Mbeiri, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-10-17
// Tags: attack.exfiltration, attack.t1048, attack.t1567.002
// Description: Detects the execution of the Restic backup tool, which can be used for data exfiltration.
// Threat actors may leverage Restic to back up and exfiltrate sensitive data to remote storage locations, including cloud services.
// If not legitimately used in the enterprise environment, its presence may indicate malicious activity.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_sftp:*" or process.command_line like "*_rest:http*" or process.command_line like "*_s3:s3.*" or process.command_line like "*_s3.http*" or process.command_line like "*_azure:*" or process.command_line like "*_ gs:*" or process.command_line like "*_rclone:*" or process.command_line like "*_swift:*" or process.command_line like "*_ b2:*") and (process.command_line like "*_ init *" and process.command_line like "*_ -r *")) or (((process.command_line like "*_--password-file*" and process.command_line like "*_init*" and process.command_line like "*_ -r *")) or ((process.command_line like "*_--use-fs-snapshot*" and process.command_line like "*_backup*" and process.command_line like "*_ -r *"))))
