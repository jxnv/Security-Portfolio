// Title: File Download Via Nscurl - MacOS
// ID: 6d8a7cf1-8085-423b-b87d-7e880faabbdf
// Status: test
// Level: medium
// Author: Daniel Cortez
// Date: 2024-06-04
// Tags: attack.command-and-control, attack.t1105
// Description: Detects the execution of the nscurl utility in order to download files.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (process.executable endswith "/nscurl" and (process.command_line like "*_--download *" or process.command_line like "*_--download-directory *" or process.command_line like "*_--output *" or process.command_line like "*_-dir *" or process.command_line like "*_-dl *" or process.command_line like "*_-ld*" or process.command_line like "*_-o *"))
