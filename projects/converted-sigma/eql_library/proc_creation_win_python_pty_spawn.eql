// Title: Python Spawning Pretty TTY on Windows
// ID: 480e7e51-e797-47e3-8d72-ebfce65b6d8d
// Status: test
// Level: high
// Author: Nextron Systems
// Date: 2022-06-03
// Tags: attack.execution, attack.t1059
// Description: Detects python spawning a pretty tty
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.executable endswith "python.exe" or process.executable endswith "python3.exe" or process.executable endswith "python2.exe")) and (((process.command_line like "*_import pty*" and process.command_line like "*_.spawn(*")) or (process.command_line like "*_from pty import spawn*")))
