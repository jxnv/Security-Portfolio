// Title: Suspicious WSMAN Provider Image Loads
// ID: ad1f4bb9-8dfb-4765-adb6-2a7cfb6c0f94
// Status: test
// Level: medium
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2020-06-24
// Tags: attack.execution, attack.t1059.001, attack.lateral-movement, attack.t1021.003
// Description: Detects signs of potential use of the WSMAN provider from uncommon processes locally and remote execution.
// Converted by: Sigma Universal SIEM/EDR CLI

any where (((((ImageLoaded endswith "\\WsmSvc.dll" or ImageLoaded endswith "\\WsmAuto.dll" or ImageLoaded endswith "\\Microsoft.WSMan.Management.ni.dll")) or ((process.pe.original_file_name == "WsmSvc.dll" or process.pe.original_file_name == "WSMANAUTOMATION.DLL" or process.pe.original_file_name == "Microsoft.WSMan.Management.dll"))) or (process.executable endswith "\\svchost.exe" and process.pe.original_file_name == "WsmWmiPl.dll")) and not (((process.executable startswith "C:\\Program Files\\Citrix\\") or ((process.executable == "C:\\Program Files (x86)\\PowerShell\\6\\pwsh.exe" or process.executable == "C:\\Program Files (x86)\\PowerShell\\7\\pwsh.exe" or process.executable == "C:\\Program Files\\PowerShell\\6\\pwsh.exe" or process.executable == "C:\\Program Files\\PowerShell\\7\\pwsh.exe" or process.executable == "C:\\Windows\\System32\\sdiagnhost.exe" or process.executable == "C:\\Windows\\System32\\services.exe" or process.executable == "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or process.executable == "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe")) or (process.executable startswith "C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_" and process.executable endswith "\\GetHelp.exe") or (process.executable endswith "\\mmc.exe") or ((process.executable startswith "C:\\Windows\\Microsoft.NET\\Framework64\\v" or process.executable startswith "C:\\Windows\\Microsoft.NET\\Framework\\v" or process.executable startswith "C:\\Windows\\Microsoft.NET\\FrameworkArm\\v" or process.executable startswith "C:\\Windows\\Microsoft.NET\\FrameworkArm64\\v") and process.executable endswith "\\mscorsvw.exe") or (process.executable startswith "C:\\Windows\\Temp\\asgard2-agent\\") or ((process.command_line like "*_svchost.exe -k netsvcs -p -s BITS*" or process.command_line like "*_svchost.exe -k GraphicsPerfSvcGroup -s GraphicsPerfSvc*" or process.command_line like "*_svchost.exe -k NetworkService -p -s Wecsvc*" or process.command_line like "*_svchost.exe -k netsvcs*")) or ((process.executable == "C:\\Windows\\System32\\Configure-SMRemoting.exe" or process.executable == "C:\\Windows\\System32\\ServerManager.exe")) or (process.executable startswith "C:\\$WINDOWS.~BT\\Sources\\"))) and not (((process.executable endswith "\\svchost.exe") and (process.command_line == null))))
