// Title: Potentially Suspicious Child Process Of Regsvr32
// ID: 6f0947a4-1c5e-4e0d-8ac7-53159b8f23ca
// Status: test
// Level: high
// Author: elhoim, Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-05-05
// Tags: attack.stealth, attack.t1218.010
// Description: Detects potentially suspicious child processes of "regsvr32.exe".
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.parent.executable endswith "\\regsvr32.exe" and (process.executable endswith "\\calc.exe" or process.executable endswith "\\cscript.exe" or process.executable endswith "\\explorer.exe" or process.executable endswith "\\mshta.exe" or process.executable endswith "\\net.exe" or process.executable endswith "\\net1.exe" or process.executable endswith "\\nltest.exe" or process.executable endswith "\\notepad.exe" or process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe" or process.executable endswith "\\reg.exe" or process.executable endswith "\\schtasks.exe" or process.executable endswith "\\werfault.exe" or process.executable endswith "\\wscript.exe")) and not ((process.executable endswith "\\werfault.exe" and process.command_line like "*_ -u -p *")))
