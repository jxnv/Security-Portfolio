// Title: FileFix - Command Evidence in TypedPaths
// ID: 4fee3d51-8069-4a4c-a0f7-924fcaff2c70
// Status: experimental
// Level: high
// Author: Alfie Champion (delivr.to), Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-07-05
// Tags: attack.execution, attack.t1204.004
// Description: Detects commonly-used chained commands and strings in the most recent 'url' value of the 'TypedPaths' key, which could be indicative of a user being targeted by the FileFix technique.
// Converted by: Sigma Universal SIEM/EDR CLI

registry where ((registry.path endswith "\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\TypedPaths\\url1" and (registry.data.strings like "*_#*" and registry.data.strings like "*_http*")) and (((registry.data.strings like "*_account*" or registry.data.strings like "*_anti-bot*" or registry.data.strings like "*_botcheck*" or registry.data.strings like "*_captcha*" or registry.data.strings like "*_challenge*" or registry.data.strings like "*_confirmation*" or registry.data.strings like "*_fraud*" or registry.data.strings like "*_human*" or registry.data.strings like "*_identification*" or registry.data.strings like "*_identificator*" or registry.data.strings like "*_identity*" or registry.data.strings like "*_robot*" or registry.data.strings like "*_validation*" or registry.data.strings like "*_verification*" or registry.data.strings like "*_verify*")) or ((registry.data.strings like "*_%comspec%*" or registry.data.strings like "*_bitsadmin*" or registry.data.strings like "*_certutil*" or registry.data.strings like "*_cmd*" or registry.data.strings like "*_cscript*" or registry.data.strings like "*_curl*" or registry.data.strings like "*_finger*" or registry.data.strings like "*_mshta*" or registry.data.strings like "*_powershell*" or registry.data.strings like "*_pwsh*" or registry.data.strings like "*_regsvr32*" or registry.data.strings like "*_rundll32*" or registry.data.strings like "*_schtasks*" or registry.data.strings like "*_wget*" or registry.data.strings like "*_wscript*"))))
