// Title: Suspicious Access to Sensitive File Extensions - Zeek
// ID: 286b47ed-f6fe-40b3-b3a8-35129acd43bc
// Status: test
// Level: medium
// Author: Samir Bousseaden, @neu5ron
// Date: 2020-04-02
// Tags: attack.collection
// Description: Detects known sensitive file extensions via Zeek
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((name endswith ".pst" or name endswith ".ost" or name endswith ".msg" or name endswith ".nst" or name endswith ".oab" or name endswith ".edb" or name endswith ".nsf" or name endswith ".bak" or name endswith ".dmp" or name endswith ".kirbi" or name endswith ".rdp"))
