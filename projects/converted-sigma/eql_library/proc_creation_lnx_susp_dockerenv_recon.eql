// Title: Docker Container Discovery Via Dockerenv Listing
// ID: 11701de9-d5a5-44aa-8238-84252f131895
// Status: test
// Level: low
// Author: Seth Hanford
// Date: 2023-08-23
// Tags: attack.discovery, attack.t1082
// Description: Detects listing or file reading of ".dockerenv" which can be a sing of potential container discovery
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.executable endswith "/cat" or process.executable endswith "/dir" or process.executable endswith "/find" or process.executable endswith "/ls" or process.executable endswith "/stat" or process.executable endswith "/test" or process.executable endswith "grep") and process.command_line endswith ".dockerenv")
