// Title: Potential Arbitrary File Download Using Office Application
// ID: 4ae3e30b-b03f-43aa-87e3-b622f4048eed
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Beyu Denis, oscd.community
// Date: 2022-05-17
// Tags: attack.stealth, attack.t1202
// Description: Detects potential arbitrary file download using a Microsoft Office application
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_http://*" or process.command_line like "*_https://*")) and (((process.executable endswith "\\EXCEL.EXE" or process.executable endswith "\\MSOXMLED.EXE" or process.executable endswith "\\POWERPNT.EXE" or process.executable endswith "\\WINWORD.exe")) or ((process.pe.original_file_name == "Excel.exe" or process.pe.original_file_name == "msoxmled.exe" or process.pe.original_file_name == "POWERPNT.EXE" or process.pe.original_file_name == "WinWord.exe"))))
