// Title: PowerShell Base64 Encoded WMI Classes
// ID: 1816994b-42e1-4fb1-afd2-134d88184f71
// Status: test
// Level: high
// Author: Christian Burkard (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-30
// Tags: attack.execution, attack.stealth, attack.t1059.001, attack.t1027
// Description: Detects calls to base64 encoded WMI class such as "Win32_ShadowCopy", "Win32_ScheduledJob", etc.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe")) or ((process.pe.original_file_name == "PowerShell.EXE" or process.pe.original_file_name == "pwsh.dll"))) and (((process.command_line like "*_VwBpAG4AMwAyAF8ATABvAGcAZwBlAGQATwBuAFUAcwBlAHIA*" or process.command_line like "*_cAaQBuADMAMgBfAEwAbwBnAGcAZQBkAE8AbgBVAHMAZQByA*" or process.command_line like "*_XAGkAbgAzADIAXwBMAG8AZwBnAGUAZABPAG4AVQBzAGUAcg*" or process.command_line like "*_V2luMzJfTG9nZ2VkT25Vc2Vy*" or process.command_line like "*_dpbjMyX0xvZ2dlZE9uVXNlc*" or process.command_line like "*_XaW4zMl9Mb2dnZWRPblVzZX*")) or ((process.command_line like "*_VwBpAG4AMwAyAF8AUAByAG8AYwBlAHMAcw*" or process.command_line like "*_cAaQBuADMAMgBfAFAAcgBvAGMAZQBzAHMA*" or process.command_line like "*_XAGkAbgAzADIAXwBQAHIAbwBjAGUAcwBzA*" or process.command_line like "*_V2luMzJfUHJvY2Vzc*" or process.command_line like "*_dpbjMyX1Byb2Nlc3*" or process.command_line like "*_XaW4zMl9Qcm9jZXNz*")) or ((process.command_line like "*_VwBpAG4AMwAyAF8AUwBjAGgAZQBkAHUAbABlAGQASgBvAGIA*" or process.command_line like "*_cAaQBuADMAMgBfAFMAYwBoAGUAZAB1AGwAZQBkAEoAbwBiA*" or process.command_line like "*_XAGkAbgAzADIAXwBTAGMAaABlAGQAdQBsAGUAZABKAG8AYg*" or process.command_line like "*_V2luMzJfU2NoZWR1bGVkSm9i*" or process.command_line like "*_dpbjMyX1NjaGVkdWxlZEpvY*" or process.command_line like "*_XaW4zMl9TY2hlZHVsZWRKb2*")) or ((process.command_line like "*_VwBpAG4AMwAyAF8AUwBoAGEAZABvAHcAYwBvAHAAeQ*" or process.command_line like "*_cAaQBuADMAMgBfAFMAaABhAGQAbwB3AGMAbwBwAHkA*" or process.command_line like "*_XAGkAbgAzADIAXwBTAGgAYQBkAG8AdwBjAG8AcAB5A*" or process.command_line like "*_V2luMzJfU2hhZG93Y29we*" or process.command_line like "*_dpbjMyX1NoYWRvd2NvcH*" or process.command_line like "*_XaW4zMl9TaGFkb3djb3B5*")) or ((process.command_line like "*_VwBpAG4AMwAyAF8AVQBzAGUAcgBBAGMAYwBvAHUAbgB0A*" or process.command_line like "*_cAaQBuADMAMgBfAFUAcwBlAHIAQQBjAGMAbwB1AG4AdA*" or process.command_line like "*_XAGkAbgAzADIAXwBVAHMAZQByAEEAYwBjAG8AdQBuAHQA*" or process.command_line like "*_V2luMzJfVXNlckFjY291bn*" or process.command_line like "*_dpbjMyX1VzZXJBY2NvdW50*" or process.command_line like "*_XaW4zMl9Vc2VyQWNjb3Vud*"))))
