// Title: Potential CommandLine Obfuscation Using Unicode Characters From Suspicious Image
// ID: 584bca0f-3608-4402-80fd-4075ff6072e3
// Status: test
// Level: high
// Author: frack113, Florian Roth (Nextron Systems), Josh Nickels
// Date: 2024-09-02
// Tags: attack.stealth, attack.t1027
// Description: Detects potential commandline obfuscation using unicode characters.
// Adversaries may attempt to make an executable or file difficult to discover or analyze by encrypting, encoding, or otherwise obfuscating its contents on the system or in transit.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.executable endswith "\\cmd.exe" or process.executable endswith "\\cscript.exe" or process.executable endswith "\\powershell.exe" or process.executable endswith "\\powershell_ise.exe" or process.executable endswith "\\pwsh.exe" or process.executable endswith "\\wscript.exe") and (process.pe.original_file_name == "Cmd.EXE" or process.pe.original_file_name == "cscript.exe" or process.pe.original_file_name == "PowerShell.EXE" or process.pe.original_file_name == "PowerShell_ISE.EXE" or process.pe.original_file_name == "pwsh.dll" or process.pe.original_file_name == "wscript.exe")) and ((process.command_line like "*_ˣ*" or process.command_line like "*_˪*" or process.command_line like "*_ˢ*" or process.command_line like "*_∕*" or process.command_line like "*_⁄*" or process.command_line like "*_―*" or process.command_line like "*_—*" or process.command_line like "*_ *" or process.command_line like "*_¯*" or process.command_line like "*_®*" or process.command_line like "*_¶*" or process.command_line like "*_⠀*")))
