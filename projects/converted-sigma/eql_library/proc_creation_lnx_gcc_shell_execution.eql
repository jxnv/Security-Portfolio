// Title: Shell Execution GCC  - Linux
// ID: 9b5de532-a757-4d70-946c-1f3e44f48b4d
// Status: test
// Level: high
// Author: Li Ling, Andy Parkidomo, Robert Rakowski, Blake Hartstein (Bloomberg L.P.)
// Date: 2024-09-02
// Tags: attack.discovery, attack.t1083
// Description: Detects the use of the "gcc" utility to execute a shell. Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_/bin/bash,-s*" or process.command_line like "*_/bin/dash,-s*" or process.command_line like "*_/bin/fish,-s*" or process.command_line like "*_/bin/sh,-s*" or process.command_line like "*_/bin/zsh,-s*")) and ((process.executable endswith "/c89" or process.executable endswith "/c99" or process.executable endswith "/gcc") and process.command_line like "*_-wrapper*"))
