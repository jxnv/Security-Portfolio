// Title: Suspicious Reg Add BitLocker
// ID: 0e0255bf-2548-47b8-9582-c0955c9283f5
// Status: test
// Level: high
// Author: frack113
// Date: 2021-11-15
// Tags: attack.impact, attack.t1486
// Description: Detects suspicious addition to BitLocker related registry keys via the reg.exe utility
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.command_line like "*_REG*" and process.command_line like "*_ADD*" and process.command_line like "*_\\SOFTWARE\\Policies\\Microsoft\\FVE*" and process.command_line like "*_/v*" and process.command_line like "*_/f*") and (process.command_line like "*_EnableBDEWithNoTPM*" or process.command_line like "*_UseAdvancedStartup*" or process.command_line like "*_UseTPM*" or process.command_line like "*_UseTPMKey*" or process.command_line like "*_UseTPMKeyPIN*" or process.command_line like "*_RecoveryKeyMessageSource*" or process.command_line like "*_UseTPMPIN*" or process.command_line like "*_RecoveryKeyMessage*"))
