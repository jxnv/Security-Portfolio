// Title: Uncommon Userinit Child Process
// ID: 0a98a10c-685d-4ab0-bddc-b6bdd1d48458
// Status: test
// Level: high
// Author: Tom Ueltschi (@c_APT_ure), Tim Shelton
// Date: 2019-01-12
// Tags: attack.privilege-escalation, attack.t1037.001, attack.persistence
// Description: Detects uncommon "userinit.exe" child processes, which could be a sign of uncommon shells or login scripts used for persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.parent.executable endswith "\\userinit.exe") and not ((process.executable endswith ":\\WINDOWS\\explorer.exe")) and not ((((process.executable endswith ":\\Program Files (x86)\\Citrix\\HDX\\bin\\cmstart.exe" or process.executable endswith ":\\Program Files (x86)\\Citrix\\HDX\\bin\\icast.exe" or process.executable endswith ":\\Program Files (x86)\\Citrix\\System32\\icast.exe" or process.executable endswith ":\\Program Files\\Citrix\\HDX\\bin\\cmstart.exe" or process.executable endswith ":\\Program Files\\Citrix\\HDX\\bin\\icast.exe" or process.executable endswith ":\\Program Files\\Citrix\\System32\\icast.exe")) or (process.executable == null) or ((process.command_line like "*_netlogon.bat*" or process.command_line like "*_UsrLogon.cmd*")) or ((process.executable endswith ":\\Windows\\System32\\proquota.exe" or process.executable endswith ":\\Windows\\SysWOW64\\proquota.exe")) or (process.command_line == "PowerShell.exe"))))
