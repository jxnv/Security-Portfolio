// Title: Mstsc.EXE Execution With Local RDP File
// ID: 5fdce3ac-e7f9-4ecd-a3aa-a4d78ebbf0af
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems), Christopher Peacock @securepeacock
// Date: 2023-04-18
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects potential RDP connection via Mstsc using a local ".rdp" file
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.command_line endswith ".rdp" or process.command_line endswith ".rdp\"")) and ((process.executable endswith "\\mstsc.exe") or (process.pe.original_file_name == "mstsc.exe"))) and not ((process.parent.executable == "C:\\Windows\\System32\\lxss\\wslhost.exe" and process.command_line like "*_C:\\ProgramData\\Microsoft\\WSL\\wslg.rdp*")))
