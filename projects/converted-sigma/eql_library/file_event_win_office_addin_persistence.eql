// Title: Potential Persistence Via Microsoft Office Add-In
// ID: 8e1cb247-6cf6-42fa-b440-3f27d57e9936
// Status: test
// Level: high
// Author: NVISO
// Date: 2020-05-11
// Tags: attack.persistence, attack.t1137.006
// Description: Detects potential persistence activity via startup add-ins that load when Microsoft Office starts (.wll/.xll are simply .dll fit for Word or Excel).
// Converted by: Sigma Universal SIEM/EDR CLI

file where ((file.path like "*_\\Microsoft\\Addins\\*" and (file.path endswith ".xlam" or file.path endswith ".xla" or file.path endswith ".ppam")) or (file.path like "*_\\Microsoft\\Word\\Startup\\*" and file.path endswith ".wll") or (file.path like "*_Microsoft\\Excel\\XLSTART\\*" and file.path endswith ".xlam") or (file.path like "*_\\Microsoft\\Excel\\Startup\\*" and file.path endswith ".xll"))
