// Title: Suspicious Mshta.EXE Execution Patterns
// ID: e32f92d1-523e-49c3-9374-bdb13b46a3ba
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-07-17
// Tags: attack.execution, attack.t1106
// Description: Detects suspicious mshta process execution patterns
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.executable endswith "\\mshta.exe") or (process.pe.original_file_name == "MSHTA.EXE")) and ((process.parent.executable endswith "\\cmd.exe" or process.parent.executable endswith "\\cscript.exe" or process.parent.executable endswith "\\powershell.exe" or process.parent.executable endswith "\\pwsh.exe" or process.parent.executable endswith "\\regsvr32.exe" or process.parent.executable endswith "\\rundll32.exe" or process.parent.executable endswith "\\wscript.exe") and (process.command_line like "*_\\AppData\\Local\\*" or process.command_line like "*_C:\\ProgramData\\*" or process.command_line like "*_C:\\Users\\Public\\*" or process.command_line like "*_C:\\Windows\\Temp\\*"))) or (((process.executable endswith "\\mshta.exe") or (process.pe.original_file_name == "MSHTA.EXE")) and not ((((process.executable startswith "C:\\Windows\\System32\\" or process.executable startswith "C:\\Windows\\SysWOW64\\")) or ((process.command_line like "*_.htm*" or process.command_line like "*_.hta*")) or ((process.command_line endswith "mshta.exe" or process.command_line endswith "mshta"))))))
