// Title: Suspicious WmiPrvSE Child Process
// ID: 8a582fe2-0882-4b89-a82a-da6b2dc32937
// Status: test
// Level: high
// Author: Vadim Khrykov (ThreatIntel), Cyb3rEng, Florian Roth (Nextron Systems)
// Date: 2021-08-23
// Tags: attack.execution, attack.stealth, attack.t1047, attack.t1204.002, attack.t1218.010
// Description: Detects suspicious and uncommon child processes of WmiPrvSE
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.parent.executable endswith "\\wbem\\WmiPrvSE.exe") and (((process.executable endswith "\\certutil.exe" or process.executable endswith "\\cscript.exe" or process.executable endswith "\\mshta.exe" or process.executable endswith "\\msiexec.exe" or process.executable endswith "\\regsvr32.exe" or process.executable endswith "\\rundll32.exe" or process.executable endswith "\\verclsid.exe" or process.executable endswith "\\wscript.exe")) or (process.executable endswith "\\cmd.exe" and (process.command_line like "*_cscript*" or process.command_line like "*_mshta*" or process.command_line like "*_powershell*" or process.command_line like "*_pwsh*" or process.command_line like "*_regsvr32*" or process.command_line like "*_rundll32*" or process.command_line like "*_wscript*"))) and not (((process.executable endswith "\\msiexec.exe" and process.command_line like "*_/i *") or (process.executable endswith "\\WerFault.exe") or (process.executable endswith "\\WmiPrvSE.exe"))))
