// Title: System Network Discovery - Linux
// ID: e7bd1cfa-b446-4c88-8afb-403bcd79e3fa
// Status: test
// Level: informational
// Author: Ömer Günal and remotephone, oscd.community
// Date: 2020-10-06
// Tags: attack.discovery, attack.t1016
// Description: Detects enumeration of local network configuration
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.command_line like "*_/etc/resolv.conf*") or ((process.executable endswith "/firewall-cmd" or process.executable endswith "/ufw" or process.executable endswith "/iptables" or process.executable endswith "/netstat" or process.executable endswith "/ss" or process.executable endswith "/ip" or process.executable endswith "/ifconfig" or process.executable endswith "/systemd-resolve" or process.executable endswith "/route")))
