// Title: Schtasks Creation Or Modification With SYSTEM Privileges
// ID: 89ca78fd-b37c-4310-b3d3-81a023f83936
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-28
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053.005
// Description: Detects the creation or update of a scheduled task to run with "NT AUTHORITY\SYSTEM" privileges
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.executable endswith "\\schtasks.exe" and (process.command_line like "*_ /change *" or process.command_line like "*_ /create *")) and (process.command_line like "*_/ru *") and ((process.command_line like "*_NT AUT*" or process.command_line like "*_ SYSTEM *"))) and not ((((process.command_line like "*_/Create /F /RU System /SC WEEKLY /TN AviraSystemSpeedupVerify /TR *" or process.command_line like "*_:\\Program Files (x86)\\Avira\\System Speedup\\setup\\avira_speedup_setup.exe*" or process.command_line like "*_/VERIFY /VERYSILENT /NOSTART /NODOTNET /NORESTART\" /RL HIGHEST*")) or ((process.command_line like "*_Subscription Heartbeat*" and process.command_line like "*_\\HeartbeatConfig.xml*" and process.command_line like "*_\\Microsoft Shared\\OFFICE*")) or (process.executable endswith "\\schtasks.exe" and (process.command_line like "*_/TN TVInstallRestore*" and process.command_line like "*_\\TeamViewer_.exe*")))))
