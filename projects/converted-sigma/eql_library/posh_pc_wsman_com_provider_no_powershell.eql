// Title: Suspicious Non PowerShell WSMAN COM Provider
// ID: df9a0e0e-fedb-4d6c-8668-d765dfc92aa7
// Status: test
// Level: medium
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2020-06-24
// Tags: attack.execution, attack.t1059.001, attack.lateral-movement, attack.t1021.003
// Description: Detects suspicious use of the WSMAN provider without PowerShell.exe as the host application.
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((Data like "*_ProviderName=WSMan*") and not (((Data regex "HostId=[a-zA-Z0-9-]{36}\\s+EngineVersion=") or ((Data like "*_HostApplication=powershell*" or Data like "*_HostApplication=C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell*" or Data like "*_HostApplication=C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell*" or Data like "*_HostApplication=C:/Windows/System32/WindowsPowerShell/v1.0/powershell*" or Data like "*_HostApplication=C:/Windows/SysWOW64/WindowsPowerShell/v1.0/powershell*")))) and not ((Data like "*_HostApplication=C:\\Hexnode\\Hexnode Agent\\Current\\HexnodeAgent.exe*")))
