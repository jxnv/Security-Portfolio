// Title: Suspicious Serv-U Process Pattern
// ID: 58f4ea09-0fc2-4520-ba18-b85c540b0eaf
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-07-14
// Tags: attack.credential-access, attack.t1555, cve.2021-35211
// Description: Detects a suspicious process pattern which could be a sign of an exploited Serv-U service
// Converted by: Sigma Universal SIEM/EDR CLI

process where (process.parent.executable endswith "\\Serv-U.exe" and (process.executable endswith "\\cmd.exe" or process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe" or process.executable endswith "\\wscript.exe" or process.executable endswith "\\cscript.exe" or process.executable endswith "\\sh.exe" or process.executable endswith "\\bash.exe" or process.executable endswith "\\schtasks.exe" or process.executable endswith "\\regsvr32.exe" or process.executable endswith "\\wmic.exe" or process.executable endswith "\\mshta.exe" or process.executable endswith "\\rundll32.exe" or process.executable endswith "\\msiexec.exe" or process.executable endswith "\\forfiles.exe" or process.executable endswith "\\scriptrunner.exe"))
