// Title: Suspicious Msbuild Execution By Uncommon Parent Process
// ID: 33be4333-2c6b-44f4-ae28-102cdbde0a31
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-11-17
// Tags: attack.stealth
// Description: Detects suspicious execution of 'Msbuild.exe' by a uncommon parent process
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.executable endswith "\\MSBuild.exe") or (process.pe.original_file_name == "MSBuild.exe")) and not (((process.parent.executable endswith "\\devenv.exe" or process.parent.executable endswith "\\cmd.exe" or process.parent.executable endswith "\\msbuild.exe" or process.parent.executable endswith "\\python.exe" or process.parent.executable endswith "\\explorer.exe" or process.parent.executable endswith "\\nuget.exe"))))
