// Title: Print History File Contents
// ID: d7821ff1-4527-4e33-9f84-d0d57fa2fb66
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-06-20
// Tags: attack.reconnaissance, attack.t1592.004
// Description: Detects events in which someone prints the contents of history files to the commandline or redirects it to a file for reconnaissance
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.executable endswith "/cat" or process.executable endswith "/head" or process.executable endswith "/tail" or process.executable endswith "/more")) and (((process.command_line like "*_/.bash_history*" or process.command_line like "*_/.zsh_history*")) or ((process.command_line endswith "_history" or process.command_line endswith ".history" or process.command_line endswith "zhistory"))))
