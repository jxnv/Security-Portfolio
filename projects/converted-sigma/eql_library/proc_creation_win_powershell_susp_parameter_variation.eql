// Title: Suspicious PowerShell Parameter Substring
// ID: 36210e0d-5b19-485d-a087-c096088885f0
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Daniel Bohannon (idea), Roberto Rodriguez (Fix)
// Date: 2019-01-16
// Tags: attack.execution, attack.t1059.001
// Description: Detects suspicious PowerShell invocation with a parameter substring
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe") and (process.command_line like "*_ -windowstyle h *" or process.command_line like "*_ -windowstyl h*" or process.command_line like "*_ -windowsty h*" or process.command_line like "*_ -windowst h*" or process.command_line like "*_ -windows h*" or process.command_line like "*_ -windo h*" or process.command_line like "*_ -wind h*" or process.command_line like "*_ -win h*" or process.command_line like "*_ -wi h*" or process.command_line like "*_ -win h *" or process.command_line like "*_ -win hi *" or process.command_line like "*_ -win hid *" or process.command_line like "*_ -win hidd *" or process.command_line like "*_ -win hidde *" or process.command_line like "*_ -NoPr *" or process.command_line like "*_ -NoPro *" or process.command_line like "*_ -NoProf *" or process.command_line like "*_ -NoProfi *" or process.command_line like "*_ -NoProfil *" or process.command_line like "*_ -nonin *" or process.command_line like "*_ -nonint *" or process.command_line like "*_ -noninte *" or process.command_line like "*_ -noninter *" or process.command_line like "*_ -nonintera *" or process.command_line like "*_ -noninterac *" or process.command_line like "*_ -noninteract *" or process.command_line like "*_ -noninteracti *" or process.command_line like "*_ -noninteractiv *" or process.command_line like "*_ -ec *" or process.command_line like "*_ -encodedComman *" or process.command_line like "*_ -encodedComma *" or process.command_line like "*_ -encodedComm *" or process.command_line like "*_ -encodedCom *" or process.command_line like "*_ -encodedCo *" or process.command_line like "*_ -encodedC *" or process.command_line like "*_ -encoded *" or process.command_line like "*_ -encode *" or process.command_line like "*_ -encod *" or process.command_line like "*_ -enco *" or process.command_line like "*_ -en *" or process.command_line like "*_ -executionpolic *" or process.command_line like "*_ -executionpoli *" or process.command_line like "*_ -executionpol *" or process.command_line like "*_ -executionpo *" or process.command_line like "*_ -executionp *" or process.command_line like "*_ -execution bypass*" or process.command_line like "*_ -executio bypass*" or process.command_line like "*_ -executi bypass*" or process.command_line like "*_ -execut bypass*" or process.command_line like "*_ -execu bypass*" or process.command_line like "*_ -exec bypass*" or process.command_line like "*_ -exe bypass*" or process.command_line like "*_ -ex bypass*" or process.command_line like "*_ -ep bypass*" or process.command_line like "*_ /windowstyle h *" or process.command_line like "*_ /windowstyl h*" or process.command_line like "*_ /windowsty h*" or process.command_line like "*_ /windowst h*" or process.command_line like "*_ /windows h*" or process.command_line like "*_ /windo h*" or process.command_line like "*_ /wind h*" or process.command_line like "*_ /win h*" or process.command_line like "*_ /wi h*" or process.command_line like "*_ /win h *" or process.command_line like "*_ /win hi *" or process.command_line like "*_ /win hid *" or process.command_line like "*_ /win hidd *" or process.command_line like "*_ /win hidde *" or process.command_line like "*_ /NoPr *" or process.command_line like "*_ /NoPro *" or process.command_line like "*_ /NoProf *" or process.command_line like "*_ /NoProfi *" or process.command_line like "*_ /NoProfil *" or process.command_line like "*_ /nonin *" or process.command_line like "*_ /nonint *" or process.command_line like "*_ /noninte *" or process.command_line like "*_ /noninter *" or process.command_line like "*_ /nonintera *" or process.command_line like "*_ /noninterac *" or process.command_line like "*_ /noninteract *" or process.command_line like "*_ /noninteracti *" or process.command_line like "*_ /noninteractiv *" or process.command_line like "*_ /ec *" or process.command_line like "*_ /encodedComman *" or process.command_line like "*_ /encodedComma *" or process.command_line like "*_ /encodedComm *" or process.command_line like "*_ /encodedCom *" or process.command_line like "*_ /encodedCo *" or process.command_line like "*_ /encodedC *" or process.command_line like "*_ /encoded *" or process.command_line like "*_ /encode *" or process.command_line like "*_ /encod *" or process.command_line like "*_ /enco *" or process.command_line like "*_ /en *" or process.command_line like "*_ /executionpolic *" or process.command_line like "*_ /executionpoli *" or process.command_line like "*_ /executionpol *" or process.command_line like "*_ /executionpo *" or process.command_line like "*_ /executionp *" or process.command_line like "*_ /execution bypass*" or process.command_line like "*_ /executio bypass*" or process.command_line like "*_ /executi bypass*" or process.command_line like "*_ /execut bypass*" or process.command_line like "*_ /execu bypass*" or process.command_line like "*_ /exec bypass*" or process.command_line like "*_ /exe bypass*" or process.command_line like "*_ /ex bypass*" or process.command_line like "*_ /ep bypass*"))
