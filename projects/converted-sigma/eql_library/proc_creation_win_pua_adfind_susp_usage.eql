// Title: PUA - AdFind Suspicious Execution
// ID: 9a132afa-654e-11eb-ae93-0242ac130002
// Status: test
// Level: high
// Author: Janantha Marasinghe (https://github.com/blueteam0ps), FPT.EagleEye Team, omkar72, oscd.community
// Date: 2021-02-02
// Tags: attack.discovery, attack.t1018, attack.t1087.002, attack.t1482, attack.t1069.002, stp.1u
// Description: Detects AdFind execution with common flags seen used during attacks
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.command_line like "*_domainlist*" or process.command_line like "*_trustdmp*" or process.command_line like "*_dcmodes*" or process.command_line like "*_adinfo*" or process.command_line like "*_-sc dclist*" or process.command_line like "*_computer_pwdnotreqd*" or process.command_line like "*_objectcategory=*" or process.command_line like "*_-subnets -f*" or process.command_line like "*_name=\"Domain Admins\"*" or process.command_line like "*_-sc u:*" or process.command_line like "*_domainncs*" or process.command_line like "*_dompol*" or process.command_line like "*_ oudmp *" or process.command_line like "*_subnetdmp*" or process.command_line like "*_gpodmp*" or process.command_line like "*_fspdmp*" or process.command_line like "*_users_noexpire*" or process.command_line like "*_computers_active*" or process.command_line like "*_computers_pwdnotreqd*"))
