// Tags: attack.exfiltration, attack.t1048
// Description: Identifies IPs performing DNS lookups associated with common Tor proxies.
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((query endswith ".hiddenservice.net" or query endswith ".onion.ca" or query endswith ".onion.cab" or query endswith ".onion.casa" or query endswith ".onion.city" or query endswith ".onion.direct" or query endswith ".onion.dog" or query endswith ".onion.glass" or query endswith ".onion.gq" or query endswith ".onion.guide" or query endswith ".onion.in.net" or query endswith ".onion.ink" or query endswith ".onion.it" or query endswith ".onion.link" or query endswith ".onion.lt" or query endswith ".onion.lu" or query endswith ".onion.ly" or query endswith ".onion.mn" or query endswith ".onion.network" or query endswith ".onion.nu" or query endswith ".onion.pet" or query endswith ".onion.plus" or query endswith ".onion.pt" or query endswith ".onion.pw" or query endswith ".onion.rip" or query endswith ".onion.sh" or query endswith ".onion.si" or query endswith ".onion.to" or query endswith ".onion.top" or query endswith ".onion.ws" or query endswith ".onion" or query endswith ".s1.tor-gateways.de" or query endswith ".s2.tor-gateways.de" or query endswith ".s3.tor-gateways.de" or query endswith ".s4.tor-gateways.de" or query endswith ".s5.tor-gateways.de" or query endswith ".t2w.pw" or query endswith ".tor2web.ae.org" or query endswith ".tor2web.blutmagie.de" or query endswith ".tor2web.com" or query endswith ".tor2web.fi" or query endswith ".tor2web.io" or query endswith ".tor2web.org" or query endswith ".tor2web.xyz" or query endswith ".torlink.co"))
