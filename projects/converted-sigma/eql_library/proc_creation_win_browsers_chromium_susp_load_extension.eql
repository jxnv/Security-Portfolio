// Title: Suspicious Chromium Browser Instance Executed With Custom Extension
// ID: 27ba3207-dd30-4812-abbf-5d20c57d474e
// Status: test
// Level: high
// Author: Aedan Russell, frack113, X__Junior (Nextron Systems)
// Date: 2022-06-19
// Tags: attack.persistence, attack.t1176.001
// Description: Detects a suspicious process spawning a Chromium based browser process with the 'load-extension' flag to start an instance with a custom extension
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.parent.executable endswith "\\cmd.exe" or process.parent.executable endswith "\\cscript.exe" or process.parent.executable endswith "\\mshta.exe" or process.parent.executable endswith "\\powershell.exe" or process.parent.executable endswith "\\pwsh.exe" or process.parent.executable endswith "\\regsvr32.exe" or process.parent.executable endswith "\\rundll32.exe" or process.parent.executable endswith "\\wscript.exe") and (process.executable endswith "\\brave.exe" or process.executable endswith "\\chrome.exe" or process.executable endswith "\\msedge.exe" or process.executable endswith "\\opera.exe" or process.executable endswith "\\vivaldi.exe") and process.command_line like "*_--load-extension=*")
