// Title: Webshell Detection With Command Line Keywords
// ID: bed2a484-9348-4143-8a8a-b801c979301c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Jonhnathan Ribeiro, Anton Kutepov, oscd.community, Chad Hudson, Matt Anderson
// Date: 2017-01-01
// Tags: attack.persistence, attack.discovery, attack.t1505.003, attack.t1018, attack.t1033, attack.t1087
// Description: Detects certain command line parameters often used during reconnaissance activity via web shells
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.parent.executable endswith "\\java.exe" or process.parent.executable endswith "\\javaw.exe") and (process.parent.executable like "*_-tomcat-*" or process.parent.executable like "*_\\tomcat*")) or ((process.parent.executable endswith "\\java.exe" or process.parent.executable endswith "\\javaw.exe") and (process.command_line like "*_catalina.jar*" or process.command_line like "*_CATALINA_HOME*")) or ((process.parent.executable endswith "\\w3wp.exe" or process.parent.executable endswith "\\php-cgi.exe" or process.parent.executable endswith "\\nginx.exe" or process.parent.executable endswith "\\httpd.exe" or process.parent.executable endswith "\\caddy.exe" or process.parent.executable endswith "\\ws_tomcatservice.exe"))) and (((process.command_line like "*_&cd&echo*" or process.command_line like "*_cd /d *")) or (((process.executable endswith "\\dsquery.exe" or process.executable endswith "\\find.exe" or process.executable endswith "\\findstr.exe" or process.executable endswith "\\ipconfig.exe" or process.executable endswith "\\netstat.exe" or process.executable endswith "\\nslookup.exe" or process.executable endswith "\\pathping.exe" or process.executable endswith "\\quser.exe" or process.executable endswith "\\schtasks.exe" or process.executable endswith "\\systeminfo.exe" or process.executable endswith "\\tasklist.exe" or process.executable endswith "\\tracert.exe" or process.executable endswith "\\wevtutil.exe" or process.executable endswith "\\whoami.exe")) or ((process.pe.original_file_name == "dsquery.exe" or process.pe.original_file_name == "find.exe" or process.pe.original_file_name == "findstr.exe" or process.pe.original_file_name == "ipconfig.exe" or process.pe.original_file_name == "netstat.exe" or process.pe.original_file_name == "nslookup.exe" or process.pe.original_file_name == "pathping.exe" or process.pe.original_file_name == "quser.exe" or process.pe.original_file_name == "schtasks.exe" or process.pe.original_file_name == "sysinfo.exe" or process.pe.original_file_name == "tasklist.exe" or process.pe.original_file_name == "tracert.exe" or process.pe.original_file_name == "VSSADMIN.EXE" or process.pe.original_file_name == "wevtutil.exe" or process.pe.original_file_name == "whoami.exe"))) or ((process.command_line like "*_ Test-NetConnection *" or process.command_line like "*_dir \\*")) or ((process.pe.original_file_name == "net.exe" or process.pe.original_file_name == "net1.exe") and (process.command_line like "*_ user *" or process.command_line like "*_ use *" or process.command_line like "*_ group *")) or (process.pe.original_file_name == "ping.exe" and process.command_line like "*_ -n *") or ((process.executable endswith "\\cmd.exe" or process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe") and (process.command_line like "*_ -enc *" or process.command_line like "*_ -EncodedCommand *" or process.command_line like "*_ -w hidden *" or process.command_line like "*_ -windowstyle hidden*" or process.command_line like "*_.WebClient).Download*")) or (process.pe.original_file_name == "wmic.exe" and process.command_line like "*_ /node:*")))
