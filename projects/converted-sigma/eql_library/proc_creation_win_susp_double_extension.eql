// Title: Suspicious Double Extension File Execution
// ID: 1cdd9a09-06c9-4769-99ff-626e2b3991b8
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems), @blu3_team (idea), Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-06-26
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects suspicious use of an .exe extension after a non-executable file extension like .pdf.exe, a set of spaces or underlines to cloak the executable file in spear phishing campaigns
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.executable endswith "      .exe" or process.executable endswith "______.exe" or process.executable endswith ".doc.exe" or process.executable endswith ".doc.js" or process.executable endswith ".docx.exe" or process.executable endswith ".docx.js" or process.executable endswith ".gif.exe" or process.executable endswith ".jpeg.exe" or process.executable endswith ".jpg.exe" or process.executable endswith ".mkv.exe" or process.executable endswith ".mov.exe" or process.executable endswith ".mp3.exe" or process.executable endswith ".mp4.exe" or process.executable endswith ".pdf.exe" or process.executable endswith ".pdf.js" or process.executable endswith ".png.exe" or process.executable endswith ".ppt.exe" or process.executable endswith ".ppt.js" or process.executable endswith ".pptx.exe" or process.executable endswith ".pptx.js" or process.executable endswith ".rtf.exe" or process.executable endswith ".rtf.js" or process.executable endswith ".svg.exe" or process.executable endswith ".txt.exe" or process.executable endswith ".txt.js" or process.executable endswith ".xls.exe" or process.executable endswith ".xls.js" or process.executable endswith ".xlsx.exe" or process.executable endswith ".xlsx.js" or process.executable endswith "⠀⠀⠀⠀⠀⠀.exe") and (process.command_line like "*_      .exe*" or process.command_line like "*_______.exe*" or process.command_line like "*_.doc.exe*" or process.command_line like "*_.doc.js*" or process.command_line like "*_.docx.exe*" or process.command_line like "*_.docx.js*" or process.command_line like "*_.gif.exe*" or process.command_line like "*_.jpeg.exe*" or process.command_line like "*_.jpg.exe*" or process.command_line like "*_.mkv.exe*" or process.command_line like "*_.mov.exe*" or process.command_line like "*_.mp3.exe*" or process.command_line like "*_.mp4.exe*" or process.command_line like "*_.pdf.exe*" or process.command_line like "*_.pdf.js*" or process.command_line like "*_.png.exe*" or process.command_line like "*_.ppt.exe*" or process.command_line like "*_.ppt.js*" or process.command_line like "*_.pptx.exe*" or process.command_line like "*_.pptx.js*" or process.command_line like "*_.rtf.exe*" or process.command_line like "*_.rtf.js*" or process.command_line like "*_.svg.exe*" or process.command_line like "*_.txt.exe*" or process.command_line like "*_.txt.js*" or process.command_line like "*_.xls.exe*" or process.command_line like "*_.xls.js*" or process.command_line like "*_.xlsx.exe*" or process.command_line like "*_.xlsx.js*" or process.command_line like "*_⠀⠀⠀⠀⠀⠀.exe*"))
