// Title: DotNET Assembly DLL Loaded Via Office Application
// ID: ff0f2b05-09db-4095-b96d-1b75ca24894a
// Status: test
// Level: medium
// Author: Antonlovesdnb
// Date: 2020-02-19
// Tags: attack.execution, attack.t1204.002
// Description: Detects any assembly DLL being loaded by an Office Product
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((process.executable endswith "\\excel.exe" or process.executable endswith "\\mspub.exe" or process.executable endswith "\\onenote.exe" or process.executable endswith "\\onenoteim.exe" or process.executable endswith "\\outlook.exe" or process.executable endswith "\\powerpnt.exe" or process.executable endswith "\\winword.exe") and ImageLoaded startswith "C:\\Windows\\assembly\\")
