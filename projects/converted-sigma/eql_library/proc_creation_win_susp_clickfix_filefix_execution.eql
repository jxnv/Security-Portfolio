// Title: Suspicious ClickFix/FileFix Execution Pattern
// ID: d487ed4a-fd24-436d-a0b2-f4e95f7b2635
// Status: experimental
// Level: high
// Author: montysecurity, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-11-19
// Tags: attack.execution, attack.t1204.001, attack.t1204.004
// Description: Detects suspicious execution patterns where users are tricked into running malicious commands via clipboard manipulation, either through the Windows Run dialog (ClickFix) or File Explorer address bar (FileFix).
// Attackers leverage social engineering campaigns—such as fake CAPTCHA challenges or urgent alerts—encouraging victims to paste clipboard contents, often executing mshta.exe, powershell.exe, or similar commands to infect systems.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_account*" or process.command_line like "*_anti-bot*" or process.command_line like "*_botcheck*" or process.command_line like "*_captcha*" or process.command_line like "*_challenge*" or process.command_line like "*_confirmation*" or process.command_line like "*_fraud*" or process.command_line like "*_human*" or process.command_line like "*_identification*" or process.command_line like "*_identificator*" or process.command_line like "*_identity*" or process.command_line like "*_robot*" or process.command_line like "*_validation*" or process.command_line like "*_verification*" or process.command_line like "*_verify*")) and (process.parent.executable endswith "\\explorer.exe" and process.command_line like "*_#*"))
