// Title: Suspicious Extrac32 Execution
// ID: aa8e035d-7be4-48d3-a944-102aec04400d
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-11-26
// Tags: attack.command-and-control, attack.t1105
// Description: Download or Copy file with Extrac32
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.command_line like "*_.cab*") and ((process.command_line like "*_extrac32.exe*") or (process.executable endswith "\\extrac32.exe") or (process.pe.original_file_name == "extrac32.exe")) and ((process.command_line like "*_/C*" or process.command_line like "*_/Y*" or process.command_line like "*_ \\\\\\\\*")))
