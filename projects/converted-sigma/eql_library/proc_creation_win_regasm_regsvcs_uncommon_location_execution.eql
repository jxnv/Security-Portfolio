// Title: Potentially Suspicious Execution Of Regasm/Regsvcs From Uncommon Location
// ID: cc368ed0-2411-45dc-a222-510ace303cb2
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-25
// Tags: attack.stealth, attack.t1218.009
// Description: Detects potentially suspicious execution of the Regasm/Regsvcs utilities from a potentially suspicious location
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_\\AppData\\Local\\Temp\\*" or process.command_line like "*_\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\*" or process.command_line like "*_\\PerfLogs\\*" or process.command_line like "*_\\Users\\Public\\*" or process.command_line like "*_\\Windows\\Temp\\*")) and (((process.executable endswith "\\Regsvcs.exe" or process.executable endswith "\\Regasm.exe")) or ((process.pe.original_file_name == "RegSvcs.exe" or process.pe.original_file_name == "RegAsm.exe"))))
