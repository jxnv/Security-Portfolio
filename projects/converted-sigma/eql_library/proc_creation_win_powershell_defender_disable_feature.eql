// Tags: attack.defense-impairment, attack.t1685
// Description: Detects requests to disable Microsoft Defender features using PowerShell commands
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.command_line like "*_Add-MpPreference *" or process.command_line like "*_Set-MpPreference *")) and ((process.command_line like "*_DisableArchiveScanning *" or process.command_line like "*_DisableRealtimeMonitoring *" or process.command_line like "*_DisableIOAVProtection *" or process.command_line like "*_DisableBehaviorMonitoring *" or process.command_line like "*_DisableBlockAtFirstSeen *" or process.command_line like "*_DisableCatchupFullScan *" or process.command_line like "*_DisableCatchupQuickScan *")) and ((process.command_line like "*_$true*" or process.command_line like "*_ 1 *"))) or (((process.command_line like "*_RABpAHMAYQBiAGwAZQBSAGUAYQBsAHQAaQBtAGUATQBvAG4AaQB0AG8AcgBpAG4AZwAgA*" or process.command_line like "*_QAaQBzAGEAYgBsAGUAUgBlAGEAbAB0AGkAbQBlAE0AbwBuAGkAdABvAHIAaQBuAGcAIA*" or process.command_line like "*_EAGkAcwBhAGIAbABlAFIAZQBhAGwAdABpAG0AZQBNAG8AbgBpAHQAbwByAGkAbgBnACAA*" or process.command_line like "*_RABpAHMAYQBiAGwAZQBJAE8AQQBWAFAAcgBvAHQAZQBjAHQAaQBvAG4AIA*" or process.command_line like "*_QAaQBzAGEAYgBsAGUASQBPAEEAVgBQAHIAbwB0AGUAYwB0AGkAbwBuACAA*" or process.command_line like "*_EAGkAcwBhAGIAbABlAEkATwBBAFYAUAByAG8AdABlAGMAdABpAG8AbgAgA*" or process.command_line like "*_RABpAHMAYQBiAGwAZQBCAGUAaABhAHYAaQBvAHIATQBvAG4AaQB0AG8AcgBpAG4AZwAgA*" or process.command_line like "*_QAaQBzAGEAYgBsAGUAQgBlAGgAYQB2AGkAbwByAE0AbwBuAGkAdABvAHIAaQBuAGcAIA*" or process.command_line like "*_EAGkAcwBhAGIAbABlAEIAZQBoAGEAdgBpAG8AcgBNAG8AbgBpAHQAbwByAGkAbgBnACAA*" or process.command_line like "*_RABpAHMAYQBiAGwAZQBCAGwAbwBjAGsAQQB0AEYAaQByAHMAdABTAGUAZQBuACAA*" or process.command_line like "*_QAaQBzAGEAYgBsAGUAQgBsAG8AYwBrAEEAdABGAGkAcgBzAHQAUwBlAGUAbgAgA*" or process.command_line like "*_EAGkAcwBhAGIAbABlAEIAbABvAGMAawBBAHQARgBpAHIAcwB0AFMAZQBlAG4AIA*" or process.command_line like "*_ZABpAHMAYQBiAGwAZQByAGUAYQBsAHQAaQBtAGUAbQBvAG4AaQB0AG8AcgBpAG4AZwAgA*" or process.command_line like "*_QAaQBzAGEAYgBsAGUAcgBlAGEAbAB0AGkAbQBlAG0A