// Title: Potentially Suspicious Child Process Of ClickOnce Application
// ID: 67bc0e75-c0a9-4cfc-8754-84a505b63c04
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-12
// Tags: attack.execution, attack.stealth
// Description: Detects potentially suspicious child processes of a ClickOnce deployment application
// Converted by: Sigma Universal SIEM/EDR CLI

process where (process.parent.executable like "*_\\AppData\\Local\\Apps\\2.0\\*" and (process.executable endswith "\\calc.exe" or process.executable endswith "\\cmd.exe" or process.executable endswith "\\cscript.exe" or process.executable endswith "\\explorer.exe" or process.executable endswith "\\mshta.exe" or process.executable endswith "\\net.exe" or process.executable endswith "\\net1.exe" or process.executable endswith "\\nltest.exe" or process.executable endswith "\\notepad.exe" or process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe" or process.executable endswith "\\reg.exe" or process.executable endswith "\\regsvr32.exe" or process.executable endswith "\\rundll32.exe" or process.executable endswith "\\schtasks.exe" or process.executable endswith "\\werfault.exe" or process.executable endswith "\\wscript.exe"))
