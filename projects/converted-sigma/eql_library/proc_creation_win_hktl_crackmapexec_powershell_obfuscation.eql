// Title: HackTool - CrackMapExec PowerShell Obfuscation
// ID: 6f8b3439-a203-45dc-a88b-abf57ea15ccf
// Status: test
// Level: high
// Author: Thomas Patzke
// Date: 2020-05-22
// Tags: attack.execution, attack.stealth, attack.t1059.001, attack.t1027.005
// Description: The CrachMapExec pentesting framework implements a PowerShell obfuscation with some static strings detected by this rule.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_join*split*" or process.command_line like "*_( $ShellId[1]+$ShellId[13]+'x')*" or process.command_line like "*_( $PSHome[*]+$PSHOME[*]+*" or process.command_line like "*_( $env:Public[13]+$env:Public[5]+'x')*" or process.command_line like "*_( $env:ComSpec[4,*,25]-Join'')*" or process.command_line like "*_[1,3]+'x'-Join'')*")) and (((process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe")) or ((process.pe.original_file_name == "PowerShell.EXE" or process.pe.original_file_name == "pwsh.dll"))))
