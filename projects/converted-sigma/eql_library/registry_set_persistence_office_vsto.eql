// Title: Potential Persistence Via Visual Studio Tools for Office
// ID: 9d15044a-7cfe-4d23-8085-6ebc11df7685
// Status: test
// Level: medium
// Author: Bhabesh Raj
// Date: 2021-01-10
// Tags: attack.t1137.006, attack.persistence
// Description: Detects persistence via Visual Studio Tools for Office (VSTO) add-ins in Office applications.
// Converted by: Sigma Universal SIEM/EDR CLI

registry where (((registry.path like "*_\\Software\\Microsoft\\Office\\Outlook\\Addins\\*" or registry.path like "*_\\Software\\Microsoft\\Office\\Word\\Addins\\*" or registry.path like "*_\\Software\\Microsoft\\Office\\Excel\\Addins\\*" or registry.path like "*_\\Software\\Microsoft\\Office\\Powerpoint\\Addins\\*" or registry.path like "*_\\Software\\Microsoft\\VSTO\\Security\\Inclusion\\*")) and not ((((process.executable == "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe" or process.executable == "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe")) or ((process.executable startswith "C:\\Program Files\\Microsoft Office\\OFFICE" or process.executable startswith "C:\\Program Files (x86)\\Microsoft Office\\OFFICE" or process.executable startswith "C:\\Program Files\\Microsoft Office\\Root\\OFFICE" or process.executable startswith "C:\\Program Files (x86)\\Microsoft Office\\Root\\OFFICE" or process.executable startswith "C:\\PROGRA~2\\MICROS~2\\Office") and (process.executable endswith "\\excel.exe" or process.executable endswith "\\Integrator.exe" or process.executable endswith "\\OneNote.exe" or process.executable endswith "\\outlook.exe" or process.executable endswith "\\powerpnt.exe" or process.executable endswith "\\Teams.exe" or process.executable endswith "\\visio.exe" or process.executable endswith "\\winword.exe")) or ((process.executable startswith "C:\\Program Files\\Common Files (x86)\\Microsoft Shared\\ClickToRun\\" or process.executable startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\") and process.executable endswith "\\OfficeClickToRun.exe") or ((process.executable == "C:\\Windows\\System32\\msiexec.exe" or process.executable == "C:\\Windows\\SysWOW64\\msiexec.exe" or process.executable == "C:\\Windows\\System32\\regsvr32.exe" or process.executable == "C:\\Windows\\SysWOW64\\regsvr32.exe")) or ((process.executable startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\VSTO\\" or process.executable startswith "C:\\Program Files (x86)\\Microsoft Shared\\VSTO\\") and process.executable endswith "\\VSTOInstaller.exe"))) and not ((((process.executable == "C:\\Program Files\\Avast Software\\Avast\\RegSvr.exe" or process.executable == "C:\\Program Files (x86)\\Avast Software\\Avast\\RegSvr.exe") and registry.path like "*_\\Microsoft\\Office\\Outlook\\Addins\\Avast.AsOutExt\\*") or ((process.executable == "C:\\Program Files\\AVG\\Antivirus\\RegSvr.exe" or process.executable == "C:\\Program Files (x86)\\AVG\\Antivirus\\RegSvr.exe") and registry.path like "*_\\Microsoft\\Office\\Outlook\\Addins\\Antivirus.AsOutExt\\*"))))
