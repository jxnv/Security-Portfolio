// Title: Creation Of a Suspicious ADS File Outside a Browser Download
// ID: 573df571-a223-43bc-846e-3f98da481eca
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-10-22
// Tags: attack.stealth
// Description: Detects the creation of a suspicious ADS (Alternate Data Stream) file by software other than browsers
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((Contents startswith "[ZoneTransfer]  ZoneId=3" and file.path endswith ":Zone.Identifier" and (file.path like "*_.exe*" or file.path like "*_.scr*" or file.path like "*_.bat*" or file.path like "*_.cmd*" or file.path like "*_.docx*" or file.path like "*_.hta*" or file.path like "*_.jse*" or file.path like "*_.lnk*" or file.path like "*_.pptx*" or file.path like "*_.ps*" or file.path like "*_.reg*" or file.path like "*_.sct*" or file.path like "*_.vb*" or file.path like "*_.wsc*" or file.path like "*_.wsf*" or file.path like "*_.xlsx*")) and not (((process.executable endswith "\\brave.exe") or ((process.executable == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or process.executable == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or ((process.executable startswith "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") or (process.executable endswith "\\WindowsApps\\MicrosoftEdge.exe") or ((process.executable == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or process.executable == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((process.executable startswith "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" or process.executable startswith "C:\\Program Files\\Microsoft\\EdgeCore\\") and (process.executable endswith "\\msedge.exe" or process.executable endswith "\\msedgewebview2.exe")) or ((process.executable == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or process.executable == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or ((process.executable == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or process.executable == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (process.executable endswith "\\maxthon.exe") or (process.executable endswith "\\opera.exe") or (process.executable endswith "\\safari.exe") or (process.executable endswith "\\seamonkey.exe") or (process.executable startswith "C:\\Program Files\\WindowsApps\\Microsoft.ScreenSketch_" and process.executable endswith "\\SnippingTool\\SnippingTool.exe" and file.path startswith "C:\\Users\\" and (file.path like "*_\\AppData\\Local\\Packages\\Microsoft.ScreenSketch_*" and file.path like "*_\\TempState\\Screenshot *") and file.path endswith ".png:Zone.Identifier") or (process.executable endswith "\\vivaldi.exe") or (process.executable endswith "\\whale.exe"))))
