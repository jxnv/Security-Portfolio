// Title: Network Connection Initiated To AzureWebsites.NET By Non-Browser Process
// ID: 5c80b618-0dbb-46e6-acbb-03d90bcb6d83
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.command-and-control, attack.t1102, attack.t1102.001
// Description: Detects an initiated network connection by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
// Converted by: Sigma Universal SIEM/EDR CLI

network where ((Initiated == "true" and DestinationHostname endswith "azurewebsites.net") and not ((((process.executable startswith "C:\\Program Files (x86)\\Avant Browser\\" or process.executable startswith "C:\\Program Files\\Avant Browser\\") and process.executable endswith "\\avant.exe") or (process.executable startswith "C:\\Program Files\\BraveSoftware\\" and process.executable endswith "\\brave.exe") or ((process.executable == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or process.executable == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or (process.executable startswith "C:\\Users\\" and process.executable endswith "\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe") or ((process.executable like "*_C:\\Program Files\\Windows Defender Advanced Threat Protection\\*" or process.executable like "*_C:\\Program Files\\Windows Defender\\*" or process.executable like "*_C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*") and (process.executable endswith "\\MsMpEng.exe" or process.executable endswith "\\MsSense.exe")) or (process.executable like "*_\\AppData\\Local\\Discord\\*" and process.executable endswith "\\Discord.exe") or ((process.executable startswith "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") or (process.executable endswith "\\WindowsApps\\MicrosoftEdge.exe") or ((process.executable == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or process.executable == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((process.executable startswith "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" or process.executable startswith "C:\\Program Files\\Microsoft\\EdgeCore\\") and (process.executable endswith "\\msedge.exe" or process.executable endswith "\\msedgewebview2.exe")) or (process.executable == "") or ((process.executable startswith "C:\\Program Files\\Falkon\\" or process.executable startswith "C:\\Program Files (x86)\\Falkon\\") and process.executable endswith "\\falkon.exe") or ((process.executable == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or process.executable == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or (process.executable startswith "C:\\Users\\" and process.executable endswith "\\AppData\\Local\\Mozilla Firefox\\firefox.exe") or (process.executable like "*_\\AppData\\Local\\Flock\\*" and process.executable endswith "\\Flock.exe") or ((process.executable == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or process.executable == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (process.executable like "*_\\AppData\\Local\\Maxthon\\*" and process.executable endswith "\\maxthon.exe") or (process.executable == null) or (process.executable like "*_\\AppData\\Local\\Programs\\Opera\\*" and process.executable endswith "\\opera.exe") or (process.executable like "*_\\AppData\\Local\\Phoebe\\*" and process.executable endswith "\\Phoebe.exe") or ((process.executable endswith "C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe" or process.executable endswith "C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe")) or ((process.executable startswith "C:\\Program Files (x86)\\QtWeb\\" or process.executable startswith "C:\\Program Files\\QtWeb\\") and process.executable endswith "\\QtWeb.exe") or ((process.executable like "*_C:\\Program Files (x86)\\Safari\\*" or process.executable like "*_C:\\Program Files\\Safari\\*") and process.executable endswith "\\safari.exe") or ((process.executable startswith "C:\\Program Files\\SeaMonkey\\" or process.executable startswith "C:\\Program Files (x86)\\SeaMonkey\\") and process.executable endswith "\\seamonkey.exe") or ((process.executable startswith "C:\\Program Files\\SlimBrowser\\" or process.executable startswith "C:\\Program Files (x86)\\SlimBrowser\\") and process.executable endswith "\\slimbrowser.exe") or (process.executable like "*_\\AppData\\Local\\Vivaldi\\*" and process.executable endswith "\\vivaldi.exe") or ((process.executable startswith "C:\\Program Files\\Naver\\Naver Whale\\" or process.executable startswith "C:\\Program Files (x86)\\Naver\\Naver Whale\\") and process.executable endswith "\\whale.exe") or ((process.executable startswith "C:\\Program Files\\Waterfox\\" or process.executable startswith "C:\\Program Files (x86)\\Waterfox\\") and process.executable endswith "\\Waterfox.exe"))))
