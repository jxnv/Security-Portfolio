// Title: Access of Sudoers File Content
// ID: 0f79c4d2-4e1f-4683-9c36-b5469a665e06
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-06-20
// Tags: attack.reconnaissance, attack.t1592.004
// Description: Detects the execution of a text-based file access or inspection utilities to read the content of /etc/sudoers in order to potentially list all users that have sudo rights.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.executable endswith "/cat" or process.executable endswith "/ed" or process.executable endswith "/egrep" or process.executable endswith "/emacs" or process.executable endswith "/fgrep" or process.executable endswith "/grep" or process.executable endswith "/head" or process.executable endswith "/less" or process.executable endswith "/more" or process.executable endswith "/nano" or process.executable endswith "/tail") and process.command_line like "*_ /etc/sudoers*")
