// Title: Suspicious File Encoded To Base64 Via Certutil.EXE
// ID: ea0cdc3e-2239-4f26-a947-4e8f8224e464
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-15
// Tags: attack.stealth, attack.t1027
// Description: Detects the execution of certutil with the "encode" flag to encode a file to base64 where the extensions of the file is suspicious
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_-encode*" or process.command_line like "*_/encode*")) and ((process.command_line like "*_.acl*" or process.command_line like "*_.bat*" or process.command_line like "*_.doc*" or process.command_line like "*_.gif*" or process.command_line like "*_.jpeg*" or process.command_line like "*_.jpg*" or process.command_line like "*_.mp3*" or process.command_line like "*_.pdf*" or process.command_line like "*_.png*" or process.command_line like "*_.ppt*" or process.command_line like "*_.tmp*" or process.command_line like "*_.xls*" or process.command_line like "*_.xml*")) and ((process.executable endswith "\\certutil.exe") or (process.pe.original_file_name == "CertUtil.exe")))
