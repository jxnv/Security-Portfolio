// Title: Potentially Suspicious Execution Of PDQDeployRunner
// ID: 12b8e9f5-96b2-41e1-9a42-8c6779a5c184
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-22
// Tags: attack.execution
// Description: Detects suspicious execution of "PDQDeployRunner" which is part of the PDQDeploy service stack that is responsible for executing commands and packages on a remote machines
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.executable endswith "\\bash.exe" or process.executable endswith "\\certutil.exe" or process.executable endswith "\\cmd.exe" or process.executable endswith "\\csc.exe" or process.executable endswith "\\cscript.exe" or process.executable endswith "\\dllhost.exe" or process.executable endswith "\\mshta.exe" or process.executable endswith "\\msiexec.exe" or process.executable endswith "\\regsvr32.exe" or process.executable endswith "\\rundll32.exe" or process.executable endswith "\\scriptrunner.exe" or process.executable endswith "\\wmic.exe" or process.executable endswith "\\wscript.exe" or process.executable endswith "\\wsl.exe")) or ((process.executable like "*_:\\ProgramData\\*" or process.executable like "*_:\\Users\\Public\\*" or process.executable like "*_:\\Windows\\TEMP\\*" or process.executable like "*_\\AppData\\Local\\Temp*")) or ((process.command_line like "*_ -decode *" or process.command_line like "*_ -enc *" or process.command_line like "*_ -encodedcommand *" or process.command_line like "*_ -w hidden*" or process.command_line like "*_DownloadString*" or process.command_line like "*_FromBase64String*" or process.command_line like "*_http*" or process.command_line like "*_iex *" or process.command_line like "*_Invoke-*"))) and (process.parent.executable like "*_\\PDQDeployRunner-*"))
