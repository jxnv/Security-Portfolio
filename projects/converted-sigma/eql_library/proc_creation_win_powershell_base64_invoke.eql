// Title: PowerShell Base64 Encoded Invoke Keyword
// ID: 6385697e-9f1b-40bd-8817-f4a91f40508e
// Status: test
// Level: high
// Author: pH-T (Nextron Systems), Harjot Singh, @cyb3rjy0t
// Date: 2022-05-20
// Tags: attack.execution, attack.stealth, attack.t1059.001, attack.t1027
// Description: Detects UTF-8 and UTF-16 Base64 encoded powershell 'Invoke-' calls
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.command_line like "*_ -e*") and ((process.command_line like "*_SQBuAHYAbwBrAGUALQ*" or process.command_line like "*_kAbgB2AG8AawBlAC0A*" or process.command_line like "*_JAG4AdgBvAGsAZQAtA*" or process.command_line like "*_SW52b2tlL*" or process.command_line like "*_ludm9rZS*" or process.command_line like "*_JbnZva2Ut*")) and (((process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe")) or ((process.pe.original_file_name == "PowerShell.EXE" or process.pe.original_file_name == "pwsh.dll"))))
