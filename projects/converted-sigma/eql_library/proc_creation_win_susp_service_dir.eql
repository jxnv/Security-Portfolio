// Title: Suspicious Service Binary Directory
// ID: 883faa95-175a-4e22-8181-e5761aeb373c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-03-09
// Tags: attack.stealth, attack.t1202
// Description: Detects a service binary running in a suspicious directory
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.executable like "*_\\Users\\Public\\*" or process.executable like "*_\\$Recycle.bin*" or process.executable like "*_\\Users\\All Users\\*" or process.executable like "*_\\Users\\Default\\*" or process.executable like "*_\\Users\\Contacts\\*" or process.executable like "*_\\Users\\Searches\\*" or process.executable like "*_C:\\Perflogs\\*" or process.executable like "*_\\config\\systemprofile\\*" or process.executable like "*_\\Windows\\Fonts\\*" or process.executable like "*_\\Windows\\IME\\*" or process.executable like "*_\\Windows\\addins\\*") and (process.parent.executable endswith "\\services.exe" or process.parent.executable endswith "\\svchost.exe"))
