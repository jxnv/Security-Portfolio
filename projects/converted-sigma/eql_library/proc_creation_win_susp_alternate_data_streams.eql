// Title: Execute From Alternate Data Streams
// ID: 7f43c430-5001-4f8b-aaa9-c3b88f18fa5c
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-09-01
// Tags: attack.stealth, attack.t1564.004
// Description: Detects execution from an Alternate Data Stream (ADS). Adversaries may use NTFS file attributes to hide their malicious data in order to evade detection
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.command_line like "*_txt:*") and (((process.command_line like "*_esentutl *" and process.command_line like "*_ /y *" and process.command_line like "*_ /d *" and process.command_line like "*_ /o *")) or ((process.command_line like "*_makecab *" and process.command_line like "*_.cab*")) or ((process.command_line like "*_reg *" and process.command_line like "*_ export *")) or ((process.command_line like "*_regedit *" and process.command_line like "*_ /E *")) or ((process.command_line like "*_type *" and process.command_line like "*_ > *"))))
