// Title: Enumeration for 3rd Party Creds From CLI
// ID: 87a476dc-0079-4583-a985-dee7a20a03de
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-20
// Tags: attack.credential-access, attack.t1552.002
// Description: Detects processes that query known 3rd party registry keys that holds credentials via commandline
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_\\Software\\Aerofox\\Foxmail\\V3.1*" or process.command_line like "*_\\Software\\Aerofox\\FoxmailPreview*" or process.command_line like "*_\\Software\\DownloadManager\\Passwords*" or process.command_line like "*_\\Software\\FTPWare\\COREFTP\\Sites*" or process.command_line like "*_\\Software\\IncrediMail\\Identities*" or process.command_line like "*_\\Software\\Martin Prikryl\\WinSCP 2\\Sessions*" or process.command_line like "*_\\Software\\Mobatek\\MobaXterm\\*" or process.command_line like "*_\\Software\\OpenSSH\\Agent\\Keys*" or process.command_line like "*_\\Software\\OpenVPN-GUI\\configs*" or process.command_line like "*_\\Software\\ORL\\WinVNC3\\Password*" or process.command_line like "*_\\Software\\Qualcomm\\Eudora\\CommandLine*" or process.command_line like "*_\\Software\\RealVNC\\WinVNC4*" or process.command_line like "*_\\Software\\RimArts\\B2\\Settings*" or process.command_line like "*_\\Software\\SimonTatham\\PuTTY\\Sessions*" or process.command_line like "*_\\Software\\SimonTatham\\PuTTY\\SshHostKeys\\*" or process.command_line like "*_\\Software\\Sota\\FFFTP*" or process.command_line like "*_\\Software\\TightVNC\\Server*" or process.command_line like "*_\\Software\\WOW6432Node\\Radmin\\v3.0\\Server\\Parameters\\Radmin*")) and not ((process.executable endswith "reg.exe" and (process.command_line like "*_export*" or process.command_line like "*_save*"))))
