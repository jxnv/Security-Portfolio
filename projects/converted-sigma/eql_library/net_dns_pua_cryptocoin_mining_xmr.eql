// Title: Monero Crypto Coin Mining Pool Lookup
// ID: b593fd50-7335-4682-a36c-4edcb68e4641
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-10-24
// Tags: attack.impact, attack.t1496, attack.exfiltration, attack.t1567
// Description: Detects suspicious DNS queries to Monero mining pools
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((query like "*_pool.minexmr.com*" or query like "*_fr.minexmr.com*" or query like "*_de.minexmr.com*" or query like "*_sg.minexmr.com*" or query like "*_ca.minexmr.com*" or query like "*_us-west.minexmr.com*" or query like "*_pool.supportxmr.com*" or query like "*_mine.c3pool.com*" or query like "*_xmr-eu1.nanopool.org*" or query like "*_xmr-eu2.nanopool.org*" or query like "*_xmr-us-east1.nanopool.org*" or query like "*_xmr-us-west1.nanopool.org*" or query like "*_xmr-asia1.nanopool.org*" or query like "*_xmr-jp1.nanopool.org*" or query like "*_xmr-au1.nanopool.org*" or query like "*_xmr.2miners.com*" or query like "*_xmr.hashcity.org*" or query like "*_xmr.f2pool.com*" or query like "*_xmrpool.eu*" or query like "*_pool.hashvault.pro*"))
