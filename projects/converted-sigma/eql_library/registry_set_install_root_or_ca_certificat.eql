// Title: New Root or CA or AuthRoot Certificate to Store
// ID: d223b46b-5621-4037-88fe-fda32eead684
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-04-04
// Tags: attack.impact, attack.t1490
// Description: Detects the addition of new root, CA or AuthRoot certificates to the Windows registry
// Converted by: Sigma Universal SIEM/EDR CLI

registry where ((registry.path like "*_\\SOFTWARE\\Microsoft\\SystemCertificates\\Root\\Certificates\\*" or registry.path like "*_\\SOFTWARE\\Policies\\Microsoft\\SystemCertificates\\Root\\Certificates\\*" or registry.path like "*_\\SOFTWARE\\Microsoft\\EnterpriseCertificates\\Root\\Certificates\\*" or registry.path like "*_\\SOFTWARE\\Microsoft\\SystemCertificates\\CA\\Certificates\\*" or registry.path like "*_\\SOFTWARE\\Policies\\Microsoft\\SystemCertificates\\CA\\Certificates\\*" or registry.path like "*_\\SOFTWARE\\Microsoft\\EnterpriseCertificates\\CA\\Certificates\\*" or registry.path like "*_\\SOFTWARE\\Microsoft\\SystemCertificates\\AuthRoot\\Certificates\\*" or registry.path like "*_\\SOFTWARE\\Policies\\Microsoft\\SystemCertificates\\AuthRoot\\Certificates\\*" or registry.path like "*_\\SOFTWARE\\Microsoft\\EnterpriseCertificates\\AuthRoot\\Certificates\\*") and registry.path endswith "\\Blob" and registry.data.strings == "Binary Data")
