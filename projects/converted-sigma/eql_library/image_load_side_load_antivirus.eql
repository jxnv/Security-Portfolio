any where (((ImageLoaded endswith "\\log.dll") and not ((((ImageLoaded == "C:\\Program Files\\AVAST Software\\Avast\\log.dll" or ImageLoaded == "C:\\Program Files (x86)\\AVAST Software\\Avast\\log.dll")) or ((ImageLoaded == "C:\\Program Files\\AVG\\Antivirus\\log.dll" or ImageLoaded == "C:\\Program Files (x86)\\AVG\\Antivirus\\log.dll")) or ((ImageLoaded startswith "C:\\Program Files\\Bitdefender Antivirus Free\\" or ImageLoaded startswith "C:\\Program Files (x86)\\Bitdefender Antivirus Free\\")) or (ImageLoaded startswith "C:\\Program Files\\Canon\\MyPrinter\\") or (process.executable == "C:\\Program Files\\Dell\\SARemediation\\audit\\TelemetryUtility.exe" and (ImageLoaded == "C:\\Program Files\\Dell\\SARemediation\\plugin\\log.dll" or ImageLoaded == "C:\\Program Files\\Dell\\SARemediation\\audit\\log.dll"))))) or ((ImageLoaded endswith "\\qrt.dll") and not (((ImageLoaded startswith "C:\\Program Files\\F-Secure\\Anti-Virus\\" or ImageLoaded startswith "C:\\Program Files (x86)\\F-Secure\\Anti-Virus\\")))) or (((ImageLoaded endswith "\\ashldres.dll" or ImageLoaded endswith "\\lockdown.dll" or ImageLoaded endswith "\\vsodscpl.dll")) and not (((ImageLoaded startswith "C:\\Program Files\\McAfee\\" or ImageLoaded startswith "C:\\Program Files (x86)\\McAfee\\")))) or ((ImageLoaded endswith "\\vftrace.dll") and not (((ImageLoaded startswith "C:\\Program Files\\CyberArk\\Endpoint Privilege Manager\\Agent\\x32\\" or ImageLoaded startswith "C:\\Program Files (x86)\\CyberArk\\Endpoint Privilege Manager\\Agent\\x32\\")))) or ((ImageLoaded endswith "\\wsc.dll") and not ((((ImageLoaded startswith "C:\\program Files\\AVAST Software\\Avast\\" or ImageLoaded startswith "C:\\program Files (x86)\\AVAST Software\\Avast\\")) or ((ImageLoaded startswith "C:\\Program Files\\AVG\\Antivirus\\" or ImageLoaded startswith "C:\\Program Files (x86)\\AVG\\Antivirus\\"))))) or ((ImageLoaded endswith "\\tmdbglog.dll") and not (((ImageLoaded startswith "C:\\program Files\\Trend Micro\\Titanium\\" or ImageLoaded startswith "C:\\program Files (x86)\\Trend Micro\\Titanium\\")))) or ((ImageLoaded endswith "\\DLPPREM32.dll") and not (((ImageLoaded startswith "C:\\program Files\\ESET" or ImageLoaded startswith "C:\\program Files (x86)\\ESET")))))
