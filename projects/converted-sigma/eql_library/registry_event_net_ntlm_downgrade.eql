// Title: NetNTLM Downgrade Attack - Registry
// ID: d67572a0-e2ec-45d6-b8db-c100d14b8ef2
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), wagga, Nasreddine Bencherchali (Splunk STRT)
// Date: 2018-03-20
// Tags: attack.persistence, attack.defense-impairment, attack.t1685, attack.t1112
// Description: Detects NetNTLM downgrade attack
// Converted by: Sigma Universal SIEM/EDR CLI

registry where (((registry.path like "*_SYSTEM\\*" and registry.path like "*_ControlSet*" and registry.path like "*_\\Control\\Lsa*")) and ((registry.path endswith "\\lmcompatibilitylevel" and (registry.data.strings == "DWORD (0x00000000)" or registry.data.strings == "DWORD (0x00000001)" or registry.data.strings == "DWORD (0x00000002)")) or (registry.path endswith "\\NtlmMinClientSec" and (registry.data.strings == "DWORD (0x00000000)" or registry.data.strings == "DWORD (0x00000010)" or registry.data.strings == "DWORD (0x00000020)" or registry.data.strings == "DWORD (0x00000030)")) or (registry.path endswith "\\RestrictSendingNTLMTraffic")))
