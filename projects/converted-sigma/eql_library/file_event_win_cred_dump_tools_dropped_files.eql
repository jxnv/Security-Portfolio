// Tags: attack.credential-access, attack.t1003.001, attack.t1003.002, attack.t1003.003, attack.t1003.004, attack.t1003.005
// Description: Files with well-known filenames (parts of credential dump software or files produced by them) creation
// Converted by: Sigma Universal SIEM/EDR CLI

file where (((file.path like "*_\\fgdump-log*" or file.path like "*_\\kirbi*" or file.path like "*_\\pwdump*" or file.path like "*_\\pwhashes*" or file.path like "*_\\wce_ccache*" or file.path like "*_\\wce_krbtkts*")) or ((file.path endswith "\\cachedump.exe" or file.path endswith "\\cachedump64.exe" or file.path endswith "\\DumpExt.dll" or file.path endswith "\\DumpSvc.exe" or file.path endswith "\\Dumpy.exe" or file.path endswith "\\fgexec.exe" or file.path endswith "\\lsremora.dll" or file.path endswith "\\lsremora64.dll" or file.path endswith "\\NTDS.out" or file.path endswith "\\procdump.exe" or file.path endswith "\\procdump64.exe" or file.path endswith "\\procdump64a.exe" or file.path endswith "\\pstgdump.exe" or file.path endswith "\\pwdump.exe" or file.path endswith "\\SAM.out" or file.path endswith "\\SECURITY.out" or file.path endswith "\\servpw.exe" or file.path endswith "\\servpw64.exe" or file.path endswith "\\SYSTEM.out" or file.path endswith "\\test.pwd" or file.path endswith "\\wceaux.dll")))
