// Title: Office Autorun Keys Modification
// ID: baecf8fb-edbf-429f-9ade-31fc3f22b970
// Status: test
// Level: medium
// Author: Victor Sergeev, Daniil Yugoslavskiy, Gleb Sukhodolskiy, Timur Zinniatullin, oscd.community, Tim Shelton, frack113 (split)
// Date: 2019-10-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects modification of autostart extensibility point (ASEP) in registry. Adversaries may modify these keys to execute malicious code when Office files are opened.
// There are various legitimate add-ins that also use these keys and this filter list might not be exhaustive.
// Thus, it is recommended to review and tune filters for your environment to reduce false positives before deploying to production.
// Converted by: Sigma Universal SIEM/EDR CLI

registry where ((((registry.path like "*_\\Word\\Addins*" or registry.path like "*_\\PowerPoint\\Addins*" or registry.path like "*_\\Outlook\\Addins*" or registry.path like "*_\\Onenote\\Addins*" or registry.path like "*_\\Excel\\Addins*" or registry.path like "*_\\Access\\Addins*" or registry.path like "*_test\\Special\\Perf*")) and ((registry.path like "*_\\Software\\Wow6432Node\\Microsoft\\Office*" or registry.path like "*_\\Software\\Microsoft\\Office*"))) and not (((registry.data.strings == "(Empty)") or ((process.executable startswith "C:\\Program Files\\Microsoft Office\\" or process.executable startswith "C:\\Program Files (x86)\\Microsoft Office\\" or process.executable startswith "C:\\PROGRA~2\\MICROS~2\\Office" or process.executable startswith "C:\\Windows\\System32\\msiexec.exe" or process.executable startswith "C:\\Windows\\SysWOW64\\msiexec.exe" or process.executable startswith "C:\\Windows\\System32\\regsvr32.exe" or process.executable startswith "C:\\Windows\\SysWOW64\\regsvr32.exe") and (registry.path like "*_\\Excel\\Addins\\AdHocReportingExcelClientLib.AdHocReportingExcelClientAddIn.1\\*" or registry.path like "*_\\Excel\\Addins\\ExcelPlugInShell.PowerMapConnect\\*" or registry.path like "*_\\Excel\\Addins\\NativeShim\\*" or registry.path like "*_\\Excel\\Addins\\NativeShim.InquireConnector.1\\*" or registry.path like "*_\\Excel\\Addins\\PowerPivotExcelClientAddIn.NativeEntry.1\\*" or registry.path like "*_\\Outlook\\AddIns\\AccessAddin.DC\\*" or registry.path like "*_\\Outlook\\AddIns\\ColleagueImport.ColleagueImportAddin\\*" or registry.path like "*_\\Outlook\\AddIns\\EvernoteCC.EvernoteContactConnector\\*" or registry.path like "*_\\Outlook\\AddIns\\EvernoteOLRD.Connect\\*" or registry.path like "*_\\Outlook\\Addins\\OneNote.OutlookAddin*" or registry.path like "*_\\Outlook\\Addins\\DriveFSExtensionLib.Connect\\*" or registry.path like "*_\\Outlook\\Addins\\GoogleAppsSync.Connect\\*" or registry.path like "*_\\Outlook\\Addins\\Microsoft.VbaAddinForOutlook.1\\*" or registry.path like "*_\\Outlook\\Addins\\OcOffice.OcForms\\*" or registry.path like "*_\\Outlook\\Addins\\OscAddin.Connect\\*" or registry.path like "*_\\Outlook\\Addins\\OutlookChangeNotifier.Connect\\*" or registry.path like "*_\\Outlook\\Addins\\UCAddin.LyncAddin.1*" or registry.path like "*_\\Outlook\\Addins\\UCAddin.UCAddin.1*" or registry.path like "*_\\Outlook\\Addins\\UmOutlookAddin.FormRegionAddin\\*" or registry.path like "*_AddinTakeNotesService\\FriendlyName*")) or (registry.data.strings == null) or ((process.executable startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\" or process.executable startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\") and process.executable endswith "\\OfficeClickToRun.exe") or ((process.executable startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\VSTO\\" or process.executable startswith "C:\\Program Files (x86)\\Microsoft Shared\\VSTO\\") and process.executable endswith "\\VSTOInstaller.exe"))) and not ((((process.executable == "C:\\Program Files\\Avast Software\\Avast\\RegSvr.exe" or process.executable == "C:\\Program Files\\Avast Software\\Avast\\x86\\RegSvr.exe") and registry.path like "*_\\Microsoft\\Office\\Outlook\\Addins\\Avast.AsOutExt\\*") or ((process.executable == "C:\\Program Files\\AVG\\Antivirus\\RegSvr.exe" or process.executable == "C:\\Program Files\\AVG\\Antivirus\\x86\\RegSvr.exe") and registry.path like "*_\\Microsoft\\Office\\Outlook\\Addins\\Antivirus.AsOutExt\\*"))))
