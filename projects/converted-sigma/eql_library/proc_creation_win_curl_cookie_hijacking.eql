// Title: Potential Cookies Session Hijacking
// ID: 5a6e1e16-07de-48d8-8aae-faa766c05e88
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-07-27
// Tags: attack.execution
// Description: Detects execution of "curl.exe" with the "-c" flag in order to save cookie data.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line regex "\\s-c\\s") or (process.command_line like "*_--cookie-jar*")) and ((process.executable endswith "\\curl.exe") or (process.pe.original_file_name == "curl.exe")))
