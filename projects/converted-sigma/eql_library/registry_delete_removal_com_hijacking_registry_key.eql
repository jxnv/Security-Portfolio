// Title: Removal of Potential COM Hijacking Registry Keys
// ID: 96f697b0-b499-4e5d-9908-a67bec11cdb6
// Status: test
// Level: medium
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2020-05-02
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects any deletion of entries in ".*\shell\open\command" registry keys.
// These registry keys might have been used for COM hijacking activities by a threat actor or an attacker and the deletion could indicate steps to remove its tracks.
// Converted by: Sigma Universal SIEM/EDR CLI

registry where ((registry.path endswith "\\shell\\open\\command") and not (((process.executable endswith "C:\\Windows\\explorer.exe") or ((process.executable startswith "C:\\Program Files\\" or process.executable startswith "C:\\Program Files (x86)\\")) or ((process.executable == "C:\\Windows\\System32\\msiexec.exe" or process.executable == "C:\\Windows\\SysWOW64\\msiexec.exe")) or (process.executable == "C:\\Windows\\System32\\OpenWith.exe") or (process.executable == "C:\\Windows\\system32\\svchost.exe"))) and not ((((process.executable == "C:\\Program Files (x86)\\Avira\\Antivirus\\" or process.executable == "C:\\Program Files\\Avira\\Antivirus\\") and (registry.path endswith "\\CLSID\\{305CA226-D286-468e-B848-2B2E8E697B74}\\Shell\\Open\\Command" or registry.path endswith "\\AntiVir.Keyfile\\shell\\open\\command")) or (process.executable endswith "\\reg.exe" and registry.path endswith "\\Discord\\shell\\open\\command") or (process.executable endswith "\\Dropbox.exe" and registry.path like "*_\\Dropbox.*") or (process.executable endswith "C:\\eclipse\\eclipse.exe" and registry.path like "*__Classes\\eclipse+*") or (process.executable like "*_\\Microsoft\\EdgeUpdate\\Install*") or (process.executable endswith "\\Everything.exe" and registry.path like "*_\\Everything.*") or (((process.executable like "*_AppData\\Local\\Temp*" and process.executable like "*_\\setup.exe*")) or ((process.executable like "*_\\Temp\\is-*" and process.executable like "*_\\target.tmp*"))) or (process.executable startswith "C:\\Program Files (x86)\\Java\\" and process.executable endswith "\\installer.exe" and registry.path like "*_\\Classes\\WOW6432Node\\CLSID\\{4299124F-F2C3-41b4-9C73-9236B2AD0E8F}*") or (process.executable endswith "\\ninite.exe") or (process.executable like "*_peazip*" and registry.path like "*_\\PeaZip.*") or (process.executable endswith "\\Spotify.exe" and registry.path endswith "\\Spotify\\shell\\open\\command") or ((process.executable like "*_\\Temp*" and process.executable like "*_\\TeamViewer*")) or (process.executable startswith "C:\\Windows\\Installer\\MSI") or (process.executable endswith "\\AppData\\Local\\Temp\\Wireshark_uninstaller.exe" and registry.path like "*_\\wireshark-capture-file\\*"))))
