// Title: Load Of RstrtMgr.DLL By An Uncommon Process
// ID: 3669afd2-9891-4534-a626-e5cf03810a61
// Status: test
// Level: low
// Author: Luc Génaux
// Date: 2023-11-28
// Tags: attack.impact, attack.defense-impairment, attack.t1486, attack.t1685
// Description: Detects the load of RstrtMgr DLL (Restart Manager) by an uncommon process.
// This library has been used during ransomware campaigns to kill processes that would prevent file encryption by locking them (e.g. Conti ransomware, Cactus ransomware). It has also recently been seen used by the BiBi wiper for Windows.
// It could also be used for anti-analysis purposes by shut downing specific processes.
// Converted by: Sigma Universal SIEM/EDR CLI

any where (((ImageLoaded endswith "\\RstrtMgr.dll") or (process.pe.original_file_name == "RstrtMgr.dll")) and not (((process.executable startswith "C:\\Windows\\Temp\\") or ((process.executable startswith "C:\\$WINDOWS.~BT\\" or process.executable startswith "C:\\$WinREAgent\\" or process.executable startswith "C:\\Program Files (x86)\\" or process.executable startswith "C:\\Program Files\\" or process.executable startswith "C:\\ProgramData\\" or process.executable startswith "C:\\Windows\\explorer.exe" or process.executable startswith "C:\\Windows\\SoftwareDistribution\\" or process.executable startswith "C:\\Windows\\SysNative\\" or process.executable startswith "C:\\Windows\\System32\\" or process.executable startswith "C:\\Windows\\SysWOW64\\" or process.executable startswith "C:\\Windows\\WinSxS\\" or process.executable startswith "C:\\WUDownloadCache\\")) or (process.executable startswith "C:\\Users\\" and (process.executable like "*_\\AppData\\Local\\Temp\\is-*" and process.executable like "*_.tmp\\*") and process.executable endswith ".tmp"))) and not (((process.executable startswith "C:\\Users\\" and (process.executable endswith "\\AppData\\Local\\Microsoft\\OneDrive\\OneDrive.exe" or process.executable endswith "\\AppData\\Local\\Microsoft\\OneDrive\\OneDriveStandaloneUpdater.exe")) or (process.executable startswith "C:\\Users\\" and process.executable like "*_\\AppData\\Local\\Microsoft\\OneDrive\\*" and process.executable endswith "\\OneDrive.Sync.Service.exe"))))
