// Tags: attack.stealth, attack.t1027.004
// Description: Detects execution of "csc.exe" to compile .NET code. Attackers often leverage this to compile code on the fly and use it in other stages.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.executable endswith "\\csc.exe") and (((process.command_line like "*_:\\Perflogs\\*" or process.command_line like "*_:\\Users\\Public\\*" or process.command_line like "*_\\AppData\\Local\\Temp\\*" or process.command_line like "*_\\Temporary Internet*" or process.command_line like "*_\\Windows\\Temp\\*")) or (((process.command_line like "*_:\\Users\\*" and process.command_line like "*_\\Favorites\\*")) or ((process.command_line like "*_:\\Users\\*" and process.command_line like "*_\\Favourites\\*")) or ((process.command_line like "*_:\\Users\\*" and process.command_line like "*_\\Contacts\\*")) or ((process.command_line like "*_:\\Users\\*" and process.command_line like "*_\\Pictures\\*"))) or (process.command_line regex "(?:[Pp]rogram[Dd]ata|%(?:[Ll]ocal)?[Aa]pp[Dd]ata%|\\\\[Aa]pp[Dd]ata\\\\(?:[Ll]ocal(?:[Ll]ow)?|[Rr]oaming))\\\\[^\\\\]{1,256}$")) and not ((((process.parent.executable startswith "C:\\Program Files (x86)\\" or process.parent.executable startswith "C:\\Program Files\\")) or (process.parent.executable == "C:\\Windows\\System32\\sdiagnhost.exe") or (process.parent.executable == "C:\\Windows\\System32\\inetsrv\\w3wp.exe"))) and not ((((process.parent.command_line like "*_JwB7ACIAZgBhAGkAbABlAGQAIgA6AHQAcgB1AGUALAAiAG0AcwBnACIAOgAiAEEAbgBzAGkAYgBsAGUAIAByAGUAcQB1AGkAcgBlAHMAIABQAG8AdwBlAHIAUwBoAGUAbABsACAAdgAzAC4AMAAgAG8AcgAgAG4AZQB3AGUAcgAiAH0AJw*" or process.parent.command_line like "*_cAewAiAGYAYQBpAGwAZQBkACIAOgB0AHIAdQBlACwAIgBtAHMAZwAiADoAIgBBAG4AcwBpAGIAbABlACAAcgBlAHEAdQBpAHIAZQBzACAAUABvAHcAZQByAFMAaABlAGwAbAAgAHYAMwAuADAAIABvAHIAIABuAGUAdwBlAHIAIgB9ACcA*" or process.parent.command_line like "*_nAHsAIgBmAGEAaQBsAGUAZAAiADoAdAByAHUAZQAsACIAbQBzAGcAIgA6ACIAQQBuAHMAaQBiAGwAZQAgAHIAZQBxAHUAaQByAGUAcwAgAFAAbwB3AGUAcgBTAGgAZQBsAGwAIAB2ADMALgAwACAAbwByACAAbgBlAHcAZQByACIAfQAnA*")) or ((process.parent.executable == "C:\\ProgramData\\chocolatey\\choco.exe" or process.parent.executable == "C:\\ProgramData\\chocolatey\\tools\\shimgen.exe")) or (process.parent.command_line like "*_\\ProgramData\\Microsoft\\Windows Defender Advanced Threat Protection*"))))
