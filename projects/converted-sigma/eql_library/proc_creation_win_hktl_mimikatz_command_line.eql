// Title: HackTool - Mimikatz Execution
// ID: a642964e-bead-4bed-8910-1bb4d63e3b4d
// Status: test
// Level: high
// Author: Teymur Kheirkhabarov, oscd.community, David ANDRE (additional keywords), Tim Shelton
// Date: 2019-10-22
// Tags: attack.credential-access, attack.t1003.001, attack.t1003.002, attack.t1003.004, attack.t1003.005, attack.t1003.006
// Description: Detection well-known mimikatz command line arguments
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_::aadcookie*" or process.command_line like "*_::detours*" or process.command_line like "*_::memssp*" or process.command_line like "*_::mflt*" or process.command_line like "*_::ncroutemon*" or process.command_line like "*_::ngcsign*" or process.command_line like "*_::printnightmare*" or process.command_line like "*_::skeleton*" or process.command_line like "*_::preshutdown*" or process.command_line like "*_::mstsc*" or process.command_line like "*_::multirdp*")) or ((process.command_line like "*_rpc::*" or process.command_line like "*_token::*" or process.command_line like "*_crypto::*" or process.command_line like "*_dpapi::*" or process.command_line like "*_sekurlsa::*" or process.command_line like "*_kerberos::*" or process.command_line like "*_lsadump::*" or process.command_line like "*_privilege::*" or process.command_line like "*_process::*" or process.command_line like "*_vault::*")) or ((process.command_line like "*_DumpCreds*" or process.command_line like "*_mimikatz*")))
