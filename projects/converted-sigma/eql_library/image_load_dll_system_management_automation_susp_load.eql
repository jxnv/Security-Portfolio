// Title: PowerShell Core DLL Loaded By Non PowerShell Process
// ID: 092bc4b9-3d1d-43b4-a6b4-8c8acd83522f
// Status: test
// Level: medium
// Author: Tom Kern, oscd.community, Natalia Shornikova, Tim Shelton, Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2019-11-14
// Tags: attack.t1059.001, attack.execution
// Description: Detects loading of essential DLLs used by PowerShell by non-PowerShell process.
// Detects behavior similar to meterpreter's "load powershell" extension.
// Converted by: Sigma Universal SIEM/EDR CLI

any where (((Description == "System.Management.Automation") or (process.pe.original_file_name == "System.Management.Automation.dll") or ((ImageLoaded endswith "\\System.Management.Automation.dll" or ImageLoaded endswith "\\System.Management.Automation.ni.dll"))) and not ((((process.executable startswith "C:\\Windows\\Microsoft.NET\\Framework\\" or process.executable startswith "C:\\Windows\\Microsoft.NET\\FrameworkArm\\" or process.executable startswith "C:\\Windows\\Microsoft.NET\\FrameworkArm64\\" or process.executable startswith "C:\\Windows\\Microsoft.NET\\Framework64\\") and process.executable endswith "\\mscorsvw.exe") or ((process.executable == "C:\\Windows\\System32\\dsac.exe" or process.executable == "C:\\WINDOWS\\System32\\RemoteFXvGPUDisablement.exe" or process.executable == "C:\\Windows\\System32\\runscripthelper.exe" or process.executable == "C:\\WINDOWS\\System32\\sdiagnhost.exe" or process.executable == "C:\\Windows\\System32\\ServerManager.exe" or process.executable == "C:\\Windows\\System32\\SyncAppvPublishingServer.exe" or process.executable == "C:\\Windows\\System32\\winrshost.exe" or process.executable == "C:\\Windows\\System32\\wsmprovhost.exe" or process.executable == "C:\\Windows\\SysWOW64\\winrshost.exe" or process.executable == "C:\\Windows\\SysWOW64\\wsmprovhost.exe")) or ((process.executable == "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" or process.executable == "C:\\Program Files\\PowerShell\\7\\pwsh.exe" or process.executable == "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or process.executable == "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" or process.executable == "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or process.executable == "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")) or ((process.executable like "*_C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview*" or process.executable like "*_\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview*") and process.executable endswith "\\pwsh.exe"))) and not (((process.executable == null) or (process.executable startswith "C:\\ProgramData\\chocolatey\\choco.exe") or (process.executable endswith "\\Citrix\\ConfigSync\\ConfigSyncRun.exe") or (process.executable startswith "C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_" and process.executable endswith "\\GetHelp.exe") or (process.executable startswith "C:\\Windows\\Temp\\asgard2-agent\\" and (process.executable endswith "\\thor64.exe" or process.executable endswith "\\thor.exe")) or ((process.executable startswith "C:\\Program Files (x86)\\Microsoft SQL Server Management Studio" or process.executable startswith "C:\\Program Files\\Microsoft SQL Server Management Studio") and process.executable endswith "\\IDE\\Ssms.exe") or ((process.executable startswith "C:\\Program Files (x86)\\Microsoft SQL Server\\" or process.executable startswith "C:\\Program Files\\Microsoft SQL Server\\") and process.executable endswith "\\Tools\\Binn\\SQLPS.exe") or ((process.executable startswith "C:\\Program Files (x86)\\Microsoft Visual Studio\\" or process.executable startswith "C:\\Program Files\\Microsoft Visual Studio\\")))))
