// Title: PsExec/PAExec Escalation to LOCAL SYSTEM
// ID: 8834e2f7-6b4b-4f09-8906-d2276470ee23
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-11-23
// Tags: attack.resource-development, attack.t1587.001
// Description: Detects suspicious commandline flags used by PsExec and PAExec to escalate a command line to LOCAL_SYSTEM rights
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_psexec*" or process.command_line like "*_paexec*" or process.command_line like "*_accepteula*")) and ((process.command_line like "*_ -s cmd*" or process.command_line like "*_ -s -i cmd*" or process.command_line like "*_ -i -s cmd*" or process.command_line like "*_ -s pwsh*" or process.command_line like "*_ -s -i pwsh*" or process.command_line like "*_ -i -s pwsh*" or process.command_line like "*_ -s powershell*" or process.command_line like "*_ -s -i powershell*" or process.command_line like "*_ -i -s powershell*")))
