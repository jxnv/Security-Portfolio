// Title: Remote Access Tool Services Have Been Installed - System
// ID: 1a31b18a-f00c-4061-9900-f735b96c99fc
// Status: test
// Level: medium
// Author: Connor Martin, Nasreddine Bencherchali
// Date: 2022-12-23
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1543.003, attack.t1569.002
// Description: Detects service installation of different remote access tools software. These software are often abused by threat actors to perform
// Converted by: Sigma Universal SIEM/EDR CLI

any where (winlog.provider_name == "Service Control Manager" and (winlog.event_id == 7045 or winlog.event_id == 7036) and (ServiceName like "*_AmmyyAdmin*" or ServiceName like "*_Atera*" or ServiceName like "*_BASupportExpressSrvcUpdater*" or ServiceName like "*_BASupportExpressStandaloneService*" or ServiceName like "*_chromoting*" or ServiceName like "*_GoToAssist*" or ServiceName like "*_GoToMyPC*" or ServiceName like "*_jumpcloud*" or ServiceName like "*_LMIGuardianSvc*" or ServiceName like "*_LogMeIn*" or ServiceName like "*_monblanking*" or ServiceName like "*_Parsec*" or ServiceName like "*_RManService*" or ServiceName like "*_RPCPerformanceService*" or ServiceName like "*_RPCService*" or ServiceName like "*_SplashtopRemoteService*" or ServiceName like "*_SSUService*" or ServiceName like "*_TeamViewer*" or ServiceName like "*_TightVNC*" or ServiceName like "*_vncserver*" or ServiceName like "*_Zoho*"))
