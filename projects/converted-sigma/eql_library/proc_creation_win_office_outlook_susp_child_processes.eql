// Title: Suspicious Outlook Child Process
// ID: 208748f7-881d-47ac-a29c-07ea84bf691d
// Status: test
// Level: high
// Author: Michael Haag, Florian Roth (Nextron Systems), Markus Neis, Elastic, FPT.EagleEye Team
// Date: 2022-02-28
// Tags: attack.execution, attack.t1204.002
// Description: Detects a suspicious process spawning from an Outlook process.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (process.parent.executable endswith "\\OUTLOOK.EXE" and (process.executable endswith "\\AppVLP.exe" or process.executable endswith "\\bash.exe" or process.executable endswith "\\cmd.exe" or process.executable endswith "\\cscript.exe" or process.executable endswith "\\forfiles.exe" or process.executable endswith "\\hh.exe" or process.executable endswith "\\mftrace.exe" or process.executable endswith "\\msbuild.exe" or process.executable endswith "\\msdt.exe" or process.executable endswith "\\mshta.exe" or process.executable endswith "\\msiexec.exe" or process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe" or process.executable endswith "\\regsvr32.exe" or process.executable endswith "\\schtasks.exe" or process.executable endswith "\\scrcons.exe" or process.executable endswith "\\scriptrunner.exe" or process.executable endswith "\\sh.exe" or process.executable endswith "\\svchost.exe" or process.executable endswith "\\wmic.exe" or process.executable endswith "\\wscript.exe"))
