// Title: Suspicious Program Location Whitelisted In Firewall Via Netsh.EXE
// ID: a35f5a72-f347-4e36-8895-9869b0d5fc6d
// Status: test
// Level: high
// Author: Sander Wiebing, Jonhnathan Ribeiro, Daniil Yugoslavskiy, oscd.community
// Date: 2020-05-25
// Tags: attack.defense-impairment, attack.t1686.003
// Description: Detects Netsh command execution that whitelists a program located in a suspicious location in the Windows Firewall
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.command_line like "*_firewall*" and process.command_line like "*_add*" and process.command_line like "*_allowedprogram*")) or ((process.command_line like "*_advfirewall*" and process.command_line like "*_firewall*" and process.command_line like "*_add*" and process.command_line like "*_rule*" and process.command_line like "*_action=allow*" and process.command_line like "*_program=*"))) and ((process.executable endswith "\\netsh.exe") or (process.pe.original_file_name == "netsh.exe")) and ((process.command_line like "*_:\\$Recycle.bin\\*" or process.command_line like "*_:\\RECYCLER.BIN\\*" or process.command_line like "*_:\\RECYCLERS.BIN\\*" or process.command_line like "*_:\\SystemVolumeInformation\\*" or process.command_line like "*_:\\Temp\\*" or process.command_line like "*_:\\Users\\Default\\*" or process.command_line like "*_:\\Users\\Desktop\\*" or process.command_line like "*_:\\Users\\Public\\*" or process.command_line like "*_:\\Windows\\addins\\*" or process.command_line like "*_:\\Windows\\cursors\\*" or process.command_line like "*_:\\Windows\\debug\\*" or process.command_line like "*_:\\Windows\\drivers\\*" or process.command_line like "*_:\\Windows\\fonts\\*" or process.command_line like "*_:\\Windows\\help\\*" or process.command_line like "*_:\\Windows\\system32\\tasks\\*" or process.command_line like "*_:\\Windows\\Tasks\\*" or process.command_line like "*_:\\Windows\\Temp\\*" or process.command_line like "*_\\Downloads\\*" or process.command_line like "*_\\Local Settings\\Temporary Internet Files\\*" or process.command_line like "*_\\Temporary Internet Files\\Content.Outlook\\*" or process.command_line like "*_%Public%\\*" or process.command_line like "*_%TEMP%*" or process.command_line like "*_%TMP%*")))
