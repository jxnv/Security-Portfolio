// Title: Legitimate Application Dropped Executable
// ID: f0540f7e-2db3-4432-b9e0-3965486744bc
// Status: test
// Level: high
// Author: frack113, Florian Roth (Nextron Systems)
// Date: 2022-08-21
// Tags: attack.stealth, attack.t1218
// Description: Detects LOLBINs and applications that should not legitimately drop executable or executable-equivalent files to disk.
// This may indicate malware staging, process injection, or abuse of a trusted binary for payload delivery.
// Converted by: Sigma Universal SIEM/EDR CLI

file where ((process.executable endswith "\\eqnedt32.exe" or process.executable endswith "\\wordpad.exe" or process.executable endswith "\\wordview.exe" or process.executable endswith "\\certutil.exe" or process.executable endswith "\\certoc.exe" or process.executable endswith "\\CertReq.exe" or process.executable endswith "\\Desktopimgdownldr.exe" or process.executable endswith "\\esentutl.exe" or process.executable endswith "\\mshta.exe" or process.executable endswith "\\AcroRd32.exe" or process.executable endswith "\\RdrCEF.exe" or process.executable endswith "\\hh.exe" or process.executable endswith "\\finger.exe") and (file.path endswith ".com" or file.path endswith ".dll" or file.path endswith ".exe" or file.path endswith ".jar" or file.path endswith ".ocx" or file.path endswith ".pyc"))
