// Title: Suspicious Microsoft Office Child Process
// ID: 438025f9-5856-4663-83f7-52f878a70a50
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Markus Neis, FPT.EagleEye Team, Vadim Khrykov, Cyb3rEng, Michael Haag, Christopher Peacock @securepeacock, @scythe_io
// Date: 2018-04-06
// Tags: attack.execution, attack.stealth, attack.t1047, attack.t1204.002, attack.t1218.010
// Description: Detects a suspicious process spawning from one of the Microsoft Office suite products (Word, Excel, PowerPoint, Publisher, Visio, etc.)
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.parent.executable endswith "\\EQNEDT32.EXE" or process.parent.executable endswith "\\EXCEL.EXE" or process.parent.executable endswith "\\MSACCESS.EXE" or process.parent.executable endswith "\\MSPUB.exe" or process.parent.executable endswith "\\ONENOTE.EXE" or process.parent.executable endswith "\\POWERPNT.exe" or process.parent.executable endswith "\\VISIO.exe" or process.parent.executable endswith "\\WINWORD.EXE" or process.parent.executable endswith "\\wordpad.exe" or process.parent.executable endswith "\\wordview.exe")) and ((((process.pe.original_file_name == "bitsadmin.exe" or process.pe.original_file_name == "CertOC.exe" or process.pe.original_file_name == "CertUtil.exe" or process.pe.original_file_name == "Cmd.Exe" or process.pe.original_file_name == "CMSTP.EXE" or process.pe.original_file_name == "cscript.exe" or process.pe.original_file_name == "curl.exe" or process.pe.original_file_name == "HH.exe" or process.pe.original_file_name == "IEExec.exe" or process.pe.original_file_name == "InstallUtil.exe" or process.pe.original_file_name == "javaw.exe" or process.pe.original_file_name == "Microsoft.Workflow.Compiler.exe" or process.pe.original_file_name == "msdt.exe" or process.pe.original_file_name == "MSHTA.EXE" or process.pe.original_file_name == "msiexec.exe" or process.pe.original_file_name == "Msxsl.exe" or process.pe.original_file_name == "odbcconf.exe" or process.pe.original_file_name == "pcalua.exe" or process.pe.original_file_name == "PowerShell.EXE" or process.pe.original_file_name == "RegAsm.exe" or process.pe.original_file_name == "RegSvcs.exe" or process.pe.original_file_name == "REGSVR32.exe" or process.pe.original_file_name == "RUNDLL32.exe" or process.pe.original_file_name == "schtasks.exe" or process.pe.original_file_name == "ScriptRunner.exe" or process.pe.original_file_name == "wmic.exe" or process.pe.original_file_name == "WorkFolders.exe" or process.pe.original_file_name == "wscript.exe")) or ((process.executable endswith "\\AppVLP.exe" or process.executable endswith "\\bash.exe" or process.executable endswith "\\bitsadmin.exe" or process.executable endswith "\\certoc.exe" or process.executable endswith "\\certutil.exe" or process.executable endswith "\\cmd.exe" or process.executable endswith "\\cmstp.exe" or process.executable endswith "\\control.exe" or process.executable endswith "\\cscript.exe" or process.executable endswith "\\curl.exe" or process.executable endswith "\\forfiles.exe" or process.executable endswith "\\hh.exe" or process.executable endswith "\\ieexec.exe" or process.executable endswith "\\installutil.exe" or process.executable endswith "\\javaw.exe" or process.executable endswith "\\mftrace.exe" or process.executable endswith "\\Microsoft.Workflow.Compiler.exe" or process.executable endswith "\\msbuild.exe" or process.executable endswith "\\msdt.exe" or process.executable endswith "\\mshta.exe" or process.executable endswith "\\msidb.exe" or process.executable endswith "\\msiexec.exe" or process.executable endswith "\\msxsl.exe" or process.executable endswith "\\odbcconf.exe" or process.executable endswith "\\pcalua.exe" or process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe" or process.executable endswith "\\regasm.exe" or process.executable endswith "\\regsvcs.exe" or process.executable endswith "\\regsvr32.exe" or process.executable endswith "\\rundll32.exe" or process.executable endswith "\\schtasks.exe" or process.executable endswith "\\scrcons.exe" or process.executable endswith "\\scriptrunner.exe" or process.executable endswith "\\sh.exe" or process.executable endswith "\\svchost.exe" or process.executable endswith "\\verclsid.exe" or process.executable endswith "\\wmic.exe" or process.executable endswith "\\workfolders.exe" or process.executable endswith "\\wscript.exe"))) or ((process.executable like "*_\\AppData\\*" or process.executable like "*_\\Users\\Public\\*" or process.executable like "*_\\ProgramData\\*" or process.executable like "*_\\Windows\\Tasks\\*" or process.executable like "*_\\Windows\\Temp\\*" or process.executable like "*_\\Windows\\System32\\Tasks\\*"))))
