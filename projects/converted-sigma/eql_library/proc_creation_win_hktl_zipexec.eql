// Title: Suspicious ZipExec Execution
// ID: 90dcf730-1b71-4ae7-9ffc-6fcf62bd0132
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-11-07
// Tags: attack.execution, attack.stealth, attack.t1218, attack.t1202
// Description: ZipExec is a Proof-of-Concept (POC) tool to wrap binary-based tools into a password-protected zip file.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_/generic:Microsoft_Windows_Shell_ZipFolder:filename=*" and process.command_line like "*_.zip*" and process.command_line like "*_/pass:*" and process.command_line like "*_/user:*")) or ((process.command_line like "*_/delete*" and process.command_line like "*_Microsoft_Windows_Shell_ZipFolder:filename=*" and process.command_line like "*_.zip*")))
