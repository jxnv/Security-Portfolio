// Title: CurrentVersion NT Autorun Keys Modification
// ID: cbf93e5d-ca6c-4722-8bea-e9119007c248
// Status: test
// Level: medium
// Author: Victor Sergeev, Daniil Yugoslavskiy, Gleb Sukhodolskiy, Timur Zinniatullin, oscd.community, Tim Shelton, frack113 (split)
// Date: 2019-10-25
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects modification of autostart extensibility point (ASEP) in registry.
// Converted by: Sigma Universal SIEM/EDR CLI

registry where ((((registry.path like "*_\\Winlogon\\VmApplet*" or registry.path like "*_\\Winlogon\\Userinit*" or registry.path like "*_\\Winlogon\\Taskman*" or registry.path like "*_\\Winlogon\\Shell*" or registry.path like "*_\\Winlogon\\GpExtensions*" or registry.path like "*_\\Winlogon\\AppSetup*" or registry.path like "*_\\Winlogon\\AlternateShells\\AvailableShells*" or registry.path like "*_\\Windows\\IconServiceLib*" or registry.path like "*_\\Windows\\Appinit_Dlls*" or registry.path like "*_\\Image File Execution Options*" or registry.path like "*_\\Font Drivers*" or registry.path like "*_\\Drivers32*" or registry.path like "*_\\Windows\\Run*" or registry.path like "*_\\Windows\\Load*")) and (registry.path like "*_\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion*")) and not (((registry.data.strings == "(Empty)") or (registry.path like "*_\\Image File Execution Options\\*" and (registry.path endswith "\\DisableExceptionChainValidation" or registry.path endswith "\\MitigationOptions")) or (registry.data.strings == null) or (process.executable == "C:\\Windows\\System32\\poqexec.exe") or (process.executable == "C:\\Windows\\System32\\RuntimeBroker.exe" and registry.path like "*_\\runtimebroker.exe\\Microsoft.Windows.ShellExperienceHost*") or (process.executable == "C:\\Windows\\system32\\svchost.exe" and (registry.path like "*_\\Winlogon\\GPExtensions\\{827D319E-6EAC-11D2-A4EA-00C04F79F83A}\\PreviousPolicyAreas*" or registry.path like "*_\\Winlogon\\GPExtensions\\{827D319E-6EAC-11D2-A4EA-00C04F79F83A}\\MaxNoGPOListChangesInterval*") and (registry.data.strings == "DWORD (0x00000001)" or registry.data.strings == "DWORD (0x00000009)" or registry.data.strings == "DWORD (0x000003c0)")))) and not ((((process.executable startswith "C:\\Program Files (x86)\\Avira\\Antivirus\\avguard.exe" or process.executable startswith "C:\\Program Files\\Avira\\Antivirus\\avguard.exe") and registry.path like "*_SOFTWARE\\WOW6432Node\\Avira\\Antivirus\\Overwrite_Keys\\HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon\\*" and (registry.path endswith "\\userinit\\UseAsDefault" or registry.path endswith "\\shell\\UseAsDefault") and (registry.data.strings == "explorer.exe" or registry.data.strings == "C:\\Windows\\system32\\userinit.exe,")) or (process.executable startswith "C:\\Program Files (x86)\\Microsoft\\Temp\\" and process.executable endswith "\\MicrosoftEdgeUpdate.exe") or (((registry.path like "*_\\ClickToRunStore\\HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\*" or registry.path like "*_\\ClickToRun\\REGISTRY\\MACHINE\\Software\\Microsoft\\Windows NT\\CurrentVersion\\*")) or ((process.executable == "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe" or process.executable == "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe"))) or (process.executable startswith "C:\\Windows\\Microsoft.NET\\Framework" and process.executable endswith "\\ngen.exe") or ((process.executable startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\" or process.executable startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\") and process.executable endswith "\\OfficeClickToRun.exe") or (process.executable endswith "\\AppData\\Local\\Microsoft\\OneDrive\\StandaloneUpdater\\OneDriveSetup.exe" and registry.path endswith "\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\Delete Cached Update Binary" and registry.data.strings startswith "C:\\Windows\\system32\\cmd.exe /q /c del /q \"C:\\Users\\" and registry.data.strings endswith "\\AppData\\Local\\Microsoft\\OneDrive\\Update\\OneDriveSetup.exe\""))))
