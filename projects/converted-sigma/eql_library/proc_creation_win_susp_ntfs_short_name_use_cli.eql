// Title: Use NTFS Short Name in Command Line
// ID: dd6b39d9-d9be-4a3b-8fe0-fe3c6a5c1795
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-05
// Tags: attack.stealth, attack.t1564.004
// Description: Detect use of the Windows 8.3 short name. Which could be used as a method to avoid command-line detection
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_~1.exe*" or process.command_line like "*_~1.bat*" or process.command_line like "*_~1.msi*" or process.command_line like "*_~1.vbe*" or process.command_line like "*_~1.vbs*" or process.command_line like "*_~1.dll*" or process.command_line like "*_~1.ps1*" or process.command_line like "*_~1.js*" or process.command_line like "*_~1.hta*" or process.command_line like "*_~2.exe*" or process.command_line like "*_~2.bat*" or process.command_line like "*_~2.msi*" or process.command_line like "*_~2.vbe*" or process.command_line like "*_~2.vbs*" or process.command_line like "*_~2.dll*" or process.command_line like "*_~2.ps1*" or process.command_line like "*_~2.js*" or process.command_line like "*_~2.hta*")) and not ((((process.parent.executable endswith "\\WebEx\\WebexHost.exe" or process.parent.executable endswith "\\thor\\thor64.exe")) or (process.command_line like "*_C:\\xampp\\vcredist\\VCREDI~1.EXE*"))))
