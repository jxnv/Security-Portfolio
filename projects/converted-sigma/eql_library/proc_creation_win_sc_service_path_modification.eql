// Title: Suspicious Service Path Modification
// ID: 138d3531-8793-4f50-a2cd-f291b2863d78
// Status: test
// Level: high
// Author: Victor Sergeev, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-10-21
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects service path modification via the "sc" binary to a suspicious command or path
// Converted by: Sigma Universal SIEM/EDR CLI

process where (process.executable endswith "\\sc.exe" and (process.command_line like "*_config*" and process.command_line like "*_binPath*") and (process.command_line like "*_powershell*" or process.command_line like "*_cmd *" or process.command_line like "*_mshta*" or process.command_line like "*_wscript*" or process.command_line like "*_cscript*" or process.command_line like "*_rundll32*" or process.command_line like "*_svchost*" or process.command_line like "*_dllhost*" or process.command_line like "*_cmd.exe /c*" or process.command_line like "*_cmd.exe /k*" or process.command_line like "*_cmd.exe /r*" or process.command_line like "*_cmd /c*" or process.command_line like "*_cmd /k*" or process.command_line like "*_cmd /r*" or process.command_line like "*_C:\\Users\\Public*" or process.command_line like "*_\\Downloads\\*" or process.command_line like "*_\\Desktop\\*" or process.command_line like "*_\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\*" or process.command_line like "*_C:\\Windows\\TEMP\\*" or process.command_line like "*_\\AppData\\Local\\Temp*"))
