// Title: Clfs.SYS Loaded By Process Located In a Potential Suspicious Location
// ID: fb4e2211-6d08-426b-8e6f-0d4a161e3b1d
// Status: experimental
// Level: medium
// Author: X__Junior
// Date: 2025-01-20
// Tags: attack.execution, attack.t1059
// Description: Detects Clfs.sys being loaded by a process running from a potentially suspicious location. Clfs.sys is loaded as part of many CVEs exploits that targets Common Log File.
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((ImageLoaded endswith "\\clfs.sys") and (((process.executable like "*_:\\Perflogs\\*" or process.executable like "*_:\\Users\\Public\\*" or process.executable like "*_\\Temporary Internet*" or process.executable like "*_\\Windows\\Temp\\*")) or (((process.executable like "*_:\\Users\\*" and process.executable like "*_\\Favorites\\*")) or ((process.executable like "*_:\\Users\\*" and process.executable like "*_\\Favourites\\*")) or ((process.executable like "*_:\\Users\\*" and process.executable like "*_\\Contacts\\*")) or ((process.executable like "*_:\\Users\\*" and process.executable like "*_\\Pictures\\*")))))
