// Title: Odbcconf.EXE Suspicious DLL Location
// ID: 6b65c28e-11f3-46cb-902a-68f2cafaf474
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-22
// Tags: attack.stealth, attack.t1218.008
// Description: Detects execution of "odbcconf" where the path of the DLL being registered is located in a potentially suspicious location.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_:\\PerfLogs\\*" or process.command_line like "*_:\\ProgramData\\*" or process.command_line like "*_:\\Temp\\*" or process.command_line like "*_:\\Users\\Public\\*" or process.command_line like "*_:\\Windows\\Registration\\CRMLog*" or process.command_line like "*_:\\Windows\\System32\\com\\dmp\\*" or process.command_line like "*_:\\Windows\\System32\\FxsTmp\\*" or process.command_line like "*_:\\Windows\\System32\\Microsoft\\Crypto\\RSA\\MachineKeys\\*" or process.command_line like "*_:\\Windows\\System32\\spool\\drivers\\color\\*" or process.command_line like "*_:\\Windows\\System32\\spool\\PRINTERS\\*" or process.command_line like "*_:\\Windows\\System32\\spool\\SERVERS\\*" or process.command_line like "*_:\\Windows\\System32\\Tasks_Migrated\\*" or process.command_line like "*_:\\Windows\\System32\\Tasks\\Microsoft\\Windows\\SyncCenter\\*" or process.command_line like "*_:\\Windows\\SysWOW64\\com\\dmp\\*" or process.command_line like "*_:\\Windows\\SysWOW64\\FxsTmp\\*" or process.command_line like "*_:\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\PLA\\System\\*" or process.command_line like "*_:\\Windows\\SysWOW64\\Tasks\\Microsoft\\Windows\\SyncCenter\\*" or process.command_line like "*_:\\Windows\\Tasks\\*" or process.command_line like "*_:\\Windows\\Temp\\*" or process.command_line like "*_:\\Windows\\Tracing\\*" or process.command_line like "*_\\AppData\\Local\\Temp\\*" or process.command_line like "*_\\AppData\\Roaming\\*")) and ((process.executable endswith "\\odbcconf.exe") or (process.pe.original_file_name == "odbcconf.exe")))
