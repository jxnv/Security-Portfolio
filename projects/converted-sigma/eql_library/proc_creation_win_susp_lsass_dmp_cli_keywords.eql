// Title: LSASS Dump Keyword In CommandLine
// ID: ffa6861c-4461-4f59-8a41-578c39f3f23e
// Status: test
// Level: high
// Author: E.M. Anhaus, Tony Lambert, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-10-24
// Tags: attack.credential-access, attack.t1003.001
// Description: Detects the presence of the keywords "lsass" and ".dmp" in the commandline, which could indicate a potential attempt to dump or create a dump of the lsass process.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_lsass.dmp*" or process.command_line like "*_lsass.zip*" or process.command_line like "*_lsass.rar*" or process.command_line like "*_Andrew.dmp*" or process.command_line like "*_Coredump.dmp*" or process.command_line like "*_NotLSASS.zip*" or process.command_line like "*_lsass_2*" or process.command_line like "*_lsassdump*" or process.command_line like "*_lsassdmp*")) or ((process.command_line like "*_lsass*" and process.command_line like "*_.dmp*")) or ((process.command_line like "*_SQLDmpr*" and process.command_line like "*_.mdmp*")) or ((process.command_line like "*_nanodump*" and process.command_line like "*_.dmp*")))
