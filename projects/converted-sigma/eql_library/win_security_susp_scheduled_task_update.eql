// Title: Suspicious Scheduled Task Update
// ID: 614cf376-6651-47c4-9dcc-6b9527f749f4
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-05
// Tags: attack.execution, attack.privilege-escalation, attack.persistence, attack.t1053.005
// Description: Detects update to a scheduled task event that contain suspicious keywords.
// Converted by: Sigma Universal SIEM/EDR CLI

any where (((TaskContentNew like "*_regsvr32*" or TaskContentNew like "*_rundll32*" or TaskContentNew like "*_cmd.exe</Command>*" or TaskContentNew like "*_cmd</Command>*" or TaskContentNew like "*_<Arguments>/c *" or TaskContentNew like "*_<Arguments>/k *" or TaskContentNew like "*_<Arguments>/r *" or TaskContentNew like "*_powershell*" or TaskContentNew like "*_pwsh*" or TaskContentNew like "*_mshta*" or TaskContentNew like "*_wscript*" or TaskContentNew like "*_cscript*" or TaskContentNew like "*_certutil*" or TaskContentNew like "*_bitsadmin*" or TaskContentNew like "*_bash.exe*" or TaskContentNew like "*_bash *" or TaskContentNew like "*_scrcons*" or TaskContentNew like "*_wmic *" or TaskContentNew like "*_wmic.exe*" or TaskContentNew like "*_forfiles*" or TaskContentNew like "*_scriptrunner*" or TaskContentNew like "*_hh.exe*")) and (winlog.event_id == 4702) and ((TaskContentNew like "*_\\AppData\\Local\\Temp\\*" or TaskContentNew like "*_\\AppData\\Roaming\\*" or TaskContentNew like "*_\\Users\\Public\\*" or TaskContentNew like "*_\\WINDOWS\\Temp\\*" or TaskContentNew like "*_C:\\Temp\\*" or TaskContentNew like "*_\\Desktop\\*" or TaskContentNew like "*_\\Downloads\\*" or TaskContentNew like "*_\\Temporary Internet*" or TaskContentNew like "*_C:\\ProgramData\\*" or TaskContentNew like "*_C:\\Perflogs\\*")))
