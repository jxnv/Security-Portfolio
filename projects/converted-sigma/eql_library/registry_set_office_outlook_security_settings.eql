// Title: Outlook Security Settings Updated - Registry
// ID: c3cefdf4-6703-4e1c-bad8-bf422fc5015a
// Status: test
// Level: medium
// Author: frack113
// Date: 2021-12-28
// Tags: attack.persistence, attack.t1137
// Description: Detects changes to the registry values related to outlook security settings
// Converted by: Sigma Universal SIEM/EDR CLI

registry where (((registry.path like "*_\\SOFTWARE\\Microsoft\\Office\\*" and registry.path like "*_\\Outlook\\Security\\*")) and not (((process.executable startswith "C:\\Program Files\\Microsoft Office\\" or process.executable startswith "C:\\Program Files (x86)\\Microsoft Office\\") and process.executable endswith "\\OUTLOOK.EXE")))
