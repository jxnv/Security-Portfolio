// Title: Operator Bloopers Cobalt Strike Commands
// ID: 647c7b9e-d784-4fda-b9a0-45c565a7b729
// Status: test
// Level: high
// Author: _pete_0, TheDFIRReport
// Date: 2022-05-06
// Tags: attack.execution, attack.t1059.003, stp.1u
// Description: Detects use of Cobalt Strike commands accidentally entered in the CMD shell
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line startswith "cmd " or process.command_line startswith "cmd.exe" or process.command_line startswith "c:\\windows\\system32\\cmd.exe") and (process.command_line like "*_psinject*" or process.command_line like "*_spawnas*" or process.command_line like "*_make_token*" or process.command_line like "*_remote-exec*" or process.command_line like "*_rev2self*" or process.command_line like "*_dcsync*" or process.command_line like "*_logonpasswords*" or process.command_line like "*_execute-assembly*" or process.command_line like "*_getsystem*")) and ((process.pe.original_file_name == "Cmd.Exe") or (process.executable endswith "\\cmd.exe")))
