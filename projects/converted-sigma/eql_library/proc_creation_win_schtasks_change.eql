// Title: Suspicious Modification Of Scheduled Tasks
// ID: 1c0e41cd-21bb-4433-9acc-4a2cd6367b9b
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-28
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects when an attacker tries to modify an already existing scheduled tasks to run from a suspicious location
// Attackers can create a simple looking task in order to avoid detection on creation as it's often the most focused on
// Instead they modify the task after creation to include their malicious payload
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.executable endswith "\\schtasks.exe" and (process.command_line like "*_ /Change *" and process.command_line like "*_ /TN *")) and ((process.command_line like "*_regsvr32*" or process.command_line like "*_rundll32*" or process.command_line like "*_cmd /c *" or process.command_line like "*_cmd /k *" or process.command_line like "*_cmd /r *" or process.command_line like "*_cmd.exe /c *" or process.command_line like "*_cmd.exe /k *" or process.command_line like "*_cmd.exe /r *" or process.command_line like "*_powershell*" or process.command_line like "*_mshta*" or process.command_line like "*_wscript*" or process.command_line like "*_cscript*" or process.command_line like "*_certutil*" or process.command_line like "*_bitsadmin*" or process.command_line like "*_bash.exe*" or process.command_line like "*_bash *" or process.command_line like "*_scrcons*" or process.command_line like "*_wmic *" or process.command_line like "*_wmic.exe*" or process.command_line like "*_forfiles*" or process.command_line like "*_scriptrunner*" or process.command_line like "*_hh.exe*" or process.command_line like "*_hh *")) and ((process.command_line like "*_\\AppData\\Local\\Temp*" or process.command_line like "*_\\AppData\\Roaming\\*" or process.command_line like "*_\\Users\\Public\\*" or process.command_line like "*_\\WINDOWS\\Temp\\*" or process.command_line like "*_\\Desktop\\*" or process.command_line like "*_\\Downloads\\*" or process.command_line like "*_\\Temporary Internet*" or process.command_line like "*_C:\\ProgramData\\*" or process.command_line like "*_C:\\Perflogs\\*" or process.command_line like "*_%ProgramData%*" or process.command_line like "*_%appdata%*" or process.command_line like "*_%comspec%*" or process.command_line like "*_%localappdata%*")))
