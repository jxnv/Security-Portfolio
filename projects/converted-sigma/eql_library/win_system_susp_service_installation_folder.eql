// Title: Service Installation in Suspicious Folder
// ID: 5e993621-67d4-488a-b9ae-b420d08b96cb
// Status: test
// Level: medium
// Author: pH-T (Nextron Systems)
// Date: 2022-03-18
// Tags: attack.persistence, attack.privilege-escalation, car.2013-09-005, attack.t1543.003
// Description: Detects service installation in suspicious folder appdata
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((winlog.provider_name == "Service Control Manager" and winlog.event_id == 7045 and (ImagePath like "*_\\AppData\\*" or ImagePath like "*_\\\\\\\\127.0.0.1*" or ImagePath like "*_\\\\\\\\localhost*")) and not ((ServiceName == "Zoom Sharing Service" and ImagePath like "*_:\\Program Files\\Common Files\\Zoom\\Support\\CptService.exe*")))
