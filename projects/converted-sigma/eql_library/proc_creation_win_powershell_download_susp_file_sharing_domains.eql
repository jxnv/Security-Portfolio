// Title: Potentially Suspicious File Download From File Sharing Domain Via PowerShell.EXE
// ID: b6e04788-29e1-4557-bb14-77f761848ab8
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-02-23
// Tags: attack.execution
// Description: Detects potentially suspicious file downloads from file sharing domains using PowerShell.exe
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_.DownloadString(*" or process.command_line like "*_.DownloadFile(*" or process.command_line like "*_Invoke-WebRequest *" or process.command_line like "*_iwr *" or process.command_line like "*_wget *")) and (((process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe")) or ((process.pe.original_file_name == "PowerShell.EXE" or process.pe.original_file_name == "pwsh.dll"))) and ((process.command_line like "*_0x0.st*" or process.command_line like "*_anonfiles.com*" or process.command_line like "*_bashupload.com*" or process.command_line like "*_cdn.discordapp.com*" or process.command_line like "*_chunk.io*" or process.command_line like "*_ddns.net*" or process.command_line like "*_dl.dropboxusercontent.com*" or process.command_line like "*_ghostbin.co*" or process.command_line like "*_glitch.me*" or process.command_line like "*_gofile.io*" or process.command_line like "*_hastebin.com*" or process.command_line like "*_mediafire.com*" or process.command_line like "*_mega.nz*" or process.command_line like "*_onrender.com*" or process.command_line like "*_pages.dev*" or process.command_line like "*_paste.ee*" or process.command_line like "*_pastebin.com*" or process.command_line like "*_pastebin.pl*" or process.command_line like "*_pastetext.net*" or process.command_line like "*_pixeldrain.com*" or process.command_line like "*_privatlab.com*" or process.command_line like "*_privatlab.net*" or process.command_line like "*_send.exploit.in*" or process.command_line like "*_sendspace.com*" or process.command_line like "*_storage.googleapis.com*" or process.command_line like "*_storjshare.io*" or process.command_line like "*_supabase.co*" or process.command_line like "*_temp.sh*" or process.command_line like "*_transfer.sh*" or process.command_line like "*_trycloudflare.com*" or process.command_line like "*_ufile.io*" or process.command_line like "*_w3spaces.com*" or process.command_line like "*_workers.dev*" or process.command_line like "*_x0.at*")))
