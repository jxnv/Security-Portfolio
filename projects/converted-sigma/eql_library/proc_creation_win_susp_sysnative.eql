// Title: Process Creation Using Sysnative Folder
// ID: 3c1b5fb0-c72f-45ba-abd1-4d4c353144ab
// Status: test
// Level: medium
// Author: Max Altgelt (Nextron Systems)
// Date: 2022-08-23
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects process creation events that use the Sysnative folder (common for CobaltStrike spawns)
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_:\\Windows\\Sysnative\\*") or (process.executable like "*_:\\Windows\\Sysnative\\*")) and not (((process.executable like "*_C:\\Windows\\Microsoft.NET\\Framework64\\v*" or process.executable like "*_C:\\Windows\\Microsoft.NET\\Framework\\v*" or process.executable like "*_C:\\Windows\\Microsoft.NET\\FrameworkArm\\v*" or process.executable like "*_C:\\Windows\\Microsoft.NET\\FrameworkArm64\\v*") and process.executable endswith "\\ngen.exe" and process.command_line like "*_install*")) and not (((process.command_line like "*_\"C:\\Windows\\sysnative\\cmd.exe\"*" and process.command_line like "*_\\xampp\\*" and process.command_line like "*_\\catalina_start.bat*"))))
