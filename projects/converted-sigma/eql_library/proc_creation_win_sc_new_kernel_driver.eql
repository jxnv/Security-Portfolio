// Title: New Kernel Driver Via SC.EXE
// ID: 431a1fdb-4799-4f3b-91c3-a683b003fc49
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-14
// Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
// Description: Detects creation of a new service (kernel driver) with the type "kernel"
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.executable endswith "\\sc.exe" and (process.command_line like "*_create*" or process.command_line like "*_config*") and (process.command_line like "*_binPath*" and process.command_line like "*_type*" and process.command_line like "*_kernel*")) and not ((((process.command_line like "*_create netprotection_network_filter*" and process.command_line like "*_type= kernel start= *" and process.command_line like "*_binPath= System32\\drivers\\netprotection_network_filter*" and process.command_line like "*_DisplayName= netprotection_network_filter*" and process.command_line like "*_group= PNP_TDI tag= yes*")) or ((process.command_line like "*_create avelam binpath=C:\\Windows\\system32\\drivers\\avelam.sys*" and process.command_line like "*_type=kernel start=boot error=critical group=Early-Launch*")))))
