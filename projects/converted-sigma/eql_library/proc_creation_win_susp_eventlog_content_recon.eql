// Title: Potentially Suspicious EventLog Recon Activity Using Log Query Utilities
// ID: beaa66d6-aa1b-4e3c-80f5-e0145369bfaf
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.credential-access, attack.discovery, attack.t1552, attack.t1087
// Description: Detects execution of different log query utilities and commands to search and dump the content of specific event logs or look for specific event IDs.
// This technique is used by threat actors in order to extract sensitive information from events logs such as usernames, IP addresses, hostnames, etc.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.command_line like "*_-InstanceId 462?*" or process.command_line like "*_.eventid -eq 462?*" or process.command_line like "*_.ID -eq 462?*" or process.command_line like "*_EventCode=?462?*" or process.command_line like "*_EventIdentifier=?462?*" or process.command_line like "*_System[EventID=462?]*" or process.command_line like "*_-InstanceId 4778*" or process.command_line like "*_.eventid -eq 4778*" or process.command_line like "*_.ID -eq 4778*" or process.command_line like "*_EventCode=?4778?*" or process.command_line like "*_EventIdentifier=?4778?*" or process.command_line like "*_System[EventID=4778]*" or process.command_line like "*_-InstanceId 25*" or process.command_line like "*_.eventid -eq 25*" or process.command_line like "*_.ID -eq 25*" or process.command_line like "*_EventCode=?25?*" or process.command_line like "*_EventIdentifier=?25?*" or process.command_line like "*_System[EventID=25]*" or process.command_line like "*_-InstanceId 1149*" or process.command_line like "*_.eventid -eq 1149*" or process.command_line like "*_.ID -eq 1149*" or process.command_line like "*_EventCode=?1149?*" or process.command_line like "*_EventIdentifier=?1149?*" or process.command_line like "*_System[EventID=1149]*" or process.command_line like "*_-InstanceId 21*" or process.command_line like "*_.eventid -eq 21*" or process.command_line like "*_.ID -eq 21*" or process.command_line like "*_EventCode=?21?*" or process.command_line like "*_EventIdentifier=?21?*" or process.command_line like "*_System[EventID=21]*" or process.command_line like "*_-InstanceId 22*" or process.command_line like "*_.eventid -eq 22*" or process.command_line like "*_.ID -eq 22*" or process.command_line like "*_EventCode=?22?*" or process.command_line like "*_EventIdentifier=?22?*" or process.command_line like "*_System[EventID=22]*")) or ((process.command_line like "*_Microsoft-Windows-PowerShell*" or process.command_line like "*_Microsoft-Windows-Security-Auditing*" or process.command_line like "*_Microsoft-Windows-TerminalServices-LocalSessionManager*" or process.command_line like "*_Microsoft-Windows-TerminalServices-RemoteConnectionManager*" or process.command_line like "*_Microsoft-Windows-Windows Defender*" or process.command_line like "*_PowerShellCore*" or process.command_line like "*_Security*" or process.command_line like "*_Windows PowerShell*"))) and (((process.command_line like "*_Select*" and process.command_line like "*_Win32_NTLogEvent*")) or (((process.command_line like "*_ qe *" or process.command_line like "*_ query-events *")) and ((process.executable endswith "\\wevtutil.exe") or (process.pe.original_file_name == "wevtutil.exe"))) or ((process.command_line like "*_ ntevent*") and ((process.executable endswith "\\wmic.exe") or (process.pe.original_file_name == "wmic.exe"))) or ((process.command_line like "*_Get-WinEvent *" or process.command_line like "*_get-eventlog *"))))
