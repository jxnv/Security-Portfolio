// Title: COM Hijacking via TreatAs
// ID: dc5c24af-6995-49b2-86eb-a9ff62199e82
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-08-28
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.015
// Description: Detect modification of TreatAs key to enable "rundll32.exe -sta" command
// Converted by: Sigma Universal SIEM/EDR CLI

registry where ((registry.path endswith "TreatAs\\(Default)") and not ((((process.executable == "C:\\Windows\\system32\\msiexec.exe" or process.executable == "C:\\Windows\\SysWOW64\\msiexec.exe")) or (process.executable startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\" and process.executable endswith "\\OfficeClickToRun.exe") or ((process.executable == "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe" or process.executable == "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe")) or (process.executable == "C:\\Windows\\system32\\svchost.exe"))))
