// Title: HackTool - Rubeus Execution - ScriptBlock
// ID: 3245cd30-e015-40ff-a31d-5cadd5f377ec
// Status: test
// Level: high
// Author: Christian Burkard (Nextron Systems), Florian Roth (Nextron Systems)
// Date: 2023-04-27
// Tags: attack.credential-access, attack.t1003, attack.t1558.003, attack.lateral-movement, attack.t1550.003
// Description: Detects the execution of the hacktool Rubeus using specific command line flags
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((ScriptBlockText like "*_asreproast *" or ScriptBlockText like "*_dump /service:krbtgt *" or ScriptBlockText like "*_dump /luid:0x*" or ScriptBlockText like "*_kerberoast *" or ScriptBlockText like "*_createnetonly /program:*" or ScriptBlockText like "*_ptt /ticket:*" or ScriptBlockText like "*_/impersonateuser:*" or ScriptBlockText like "*_renew /ticket:*" or ScriptBlockText like "*_asktgt /user:*" or ScriptBlockText like "*_harvest /interval:*" or ScriptBlockText like "*_s4u /user:*" or ScriptBlockText like "*_s4u /ticket:*" or ScriptBlockText like "*_hash /password:*" or ScriptBlockText like "*_golden /aes256:*" or ScriptBlockText like "*_silver /user:*"))
