// Title: File Download with Headless Browser
// ID: 0e8cfe08-02c9-4815-a2f8-0d157b7ed33e
// Status: test
// Level: high
// Author: Sreeman, Florian Roth (Nextron Systems)
// Date: 2022-01-04
// Tags: attack.command-and-control, attack.stealth, attack.t1105, attack.t1564.003
// Description: Detects execution of chromium based browser in headless mode using the "dump-dom" command line to download files
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.executable endswith "\\brave.exe" or process.executable endswith "\\chrome.exe" or process.executable endswith "\\msedge.exe" or process.executable endswith "\\opera.exe" or process.executable endswith "\\vivaldi.exe") and (process.command_line like "*_--headless*" and process.command_line like "*_dump-dom*" and process.command_line like "*_http*")) and not ((((process.executable startswith "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\" or process.executable startswith "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" or process.executable startswith "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\" or process.executable startswith "C:\\Program Files\\Microsoft\\Edge\\Application\\" or process.executable startswith "C:\\Program Files\\Microsoft\\EdgeCore\\" or process.executable startswith "C:\\Program Files\\Microsoft\\EdgeWebView\\" or process.executable startswith "C:\\Program Files\\WindowsApps\\Microsoft.MicrosoftEdge") and (process.executable endswith "\\msedge.exe" or process.executable endswith "\\msedgewebview2.exe" or process.executable endswith "\\MicrosoftEdge.exe") and process.command_line like "*_--headless --disable-gpu --disable-extensions --disable-plugins --mute-audio --no-first-run --incognito --aggressive-cache-discard --dump-dom*") or ((process.executable like "*_\\AppData\\Local\\Microsoft\\WindowsApps\\*" or process.executable like "*_\\Windows\\SystemApps\\Microsoft.MicrosoftEdge*") and (process.executable endswith "\\msedge.exe" or process.executable endswith "\\MicrosoftEdge.exe") and process.command_line like "*_--headless --disable-gpu --disable-extensions --disable-plugins --mute-audio --no-first-run --incognito --aggressive-cache-discard --dump-dom*"))))
