// Title: Scheduled Task Creation Masquerading as System Processes
// ID: 9f8573c9-22b4-40e3-89c1-72bc2b8d49ab
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-02-05
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.stealth, attack.t1053.005, attack.t1036.004, attack.t1036.005
// Description: Detects the creation of scheduled tasks that involve system processes, which may indicate malicious actors masquerading as or abusing these processes to execute payloads or maintain persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.command_line like "*_ /create *" and (process.command_line like "*_ audiodg*" or process.command_line like "*_ conhost*" or process.command_line like "*_ dwm.exe*" or process.command_line like "*_ explorer*" or process.command_line like "*_ lsass*" or process.command_line like "*_ lsm*" or process.command_line like "*_ mmc*" or process.command_line like "*_ msiexec*" or process.command_line like "*_ regsvr32*" or process.command_line like "*_ rundll32*" or process.command_line like "*_ services*" or process.command_line like "*_ spoolsv*" or process.command_line like "*_ svchost*" or process.command_line like "*_ taskeng*" or process.command_line like "*_ taskhost*" or process.command_line like "*_ wininit*" or process.command_line like "*_ winlogon*")) and ((process.executable endswith "\\schtasks.exe") or (process.pe.original_file_name == "schtasks.exe")))
