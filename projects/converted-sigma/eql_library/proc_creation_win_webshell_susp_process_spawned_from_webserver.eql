// Title: Suspicious Process By Web Server Process
// ID: 8202070f-edeb-4d31-a010-a26c72ac5600
// Status: test
// Level: high
// Author: Thomas Patzke, Florian Roth (Nextron Systems), Zach Stanford @svch0st, Tim Shelton, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-01-16
// Tags: attack.persistence, attack.initial-access, attack.t1505.003, attack.t1190
// Description: Detects potentially suspicious processes being spawned by a web server process which could be the result of a successfully placed web shell or exploitation
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.parent.executable endswith "\\java.exe" or process.parent.executable endswith "\\javaw.exe") and (process.parent.executable like "*_-tomcat-*" or process.parent.executable like "*_\\tomcat*")) or ((process.parent.executable endswith "\\java.exe" or process.parent.executable endswith "\\javaw.exe") and (process.parent.command_line like "*_CATALINA_HOME*" or process.parent.command_line like "*_catalina.home*" or process.parent.command_line like "*_catalina.jar*")) or ((process.parent.executable endswith "\\caddy.exe" or process.parent.executable endswith "\\httpd.exe" or process.parent.executable endswith "\\nginx.exe" or process.parent.executable endswith "\\php-cgi.exe" or process.parent.executable endswith "\\php.exe" or process.parent.executable endswith "\\tomcat.exe" or process.parent.executable endswith "\\UMWorkerProcess.exe" or process.parent.executable endswith "\\w3wp.exe" or process.parent.executable endswith "\\ws_TomcatService.exe"))) and ((process.executable endswith "\\arp.exe" or process.executable endswith "\\at.exe" or process.executable endswith "\\bash.exe" or process.executable endswith "\\bitsadmin.exe" or process.executable endswith "\\certutil.exe" or process.executable endswith "\\cmd.exe" or process.executable endswith "\\cscript.exe" or process.executable endswith "\\dsget.exe" or process.executable endswith "\\hostname.exe" or process.executable endswith "\\nbtstat.exe" or process.executable endswith "\\net.exe" or process.executable endswith "\\net1.exe" or process.executable endswith "\\netdom.exe" or process.executable endswith "\\netsh.exe" or process.executable endswith "\\nltest.exe" or process.executable endswith "\\ntdsutil.exe" or process.executable endswith "\\powershell_ise.exe" or process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe" or process.executable endswith "\\qprocess.exe" or process.executable endswith "\\query.exe" or process.executable endswith "\\qwinsta.exe" or process.executable endswith "\\reg.exe" or process.executable endswith "\\rundll32.exe" or process.executable endswith "\\sc.exe" or process.executable endswith "\\sh.exe" or process.executable endswith "\\wmic.exe" or process.executable endswith "\\wscript.exe" or process.executable endswith "\\wusa.exe")) and not (((process.parent.executable endswith "\\java.exe" and process.command_line endswith "Windows\\system32\\cmd.exe /c C:\\ManageEngine\\ADManager \"Plus\\ES\\bin\\elasticsearch.bat -Enode.name=RMP-NODE1 -pelasticsearch-pid.txt") or (process.parent.executable endswith "\\java.exe" and (process.command_line like "*_sc query*" and process.command_line like "*_ADManager Plus*")))))
