// Title: Office Macro File Download
// ID: 0e29e3a7-1ad8-40aa-b691-9f82ecd33d66
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-23
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects the creation of a new office macro files on the system via an application (browser, mail client).
// This can help identify potential malicious activity, such as the download of macro-enabled documents that could be used for exploitation.
// Converted by: Sigma Universal SIEM/EDR CLI

file where ((((file.path endswith ".docm" or file.path endswith ".dotm" or file.path endswith ".xlsm" or file.path endswith ".xltm" or file.path endswith ".potm" or file.path endswith ".pptm")) or ((file.path like "*_.docm:Zone*" or file.path like "*_.dotm:Zone*" or file.path like "*_.xlsm:Zone*" or file.path like "*_.xltm:Zone*" or file.path like "*_.potm:Zone*" or file.path like "*_.pptm:Zone*"))) and ((process.executable endswith "\\RuntimeBroker.exe" or process.executable endswith "\\outlook.exe" or process.executable endswith "\\thunderbird.exe" or process.executable endswith "\\brave.exe" or process.executable endswith "\\chrome.exe" or process.executable endswith "\\firefox.exe" or process.executable endswith "\\iexplore.exe" or process.executable endswith "\\maxthon.exe" or process.executable endswith "\\MicrosoftEdge.exe" or process.executable endswith "\\msedge.exe" or process.executable endswith "\\msedgewebview2.exe" or process.executable endswith "\\opera.exe" or process.executable endswith "\\safari.exe" or process.executable endswith "\\seamonkey.exe" or process.executable endswith "\\vivaldi.exe" or process.executable endswith "\\whale.exe")))
