// Title: Local Groups Discovery - MacOs
// ID: 89bb1f97-c7b9-40e8-b52b-7d6afbd67276
// Status: test
// Level: informational
// Author: Ömer Günal, Alejandro Ortuno, oscd.community
// Date: 2020-10-11
// Tags: attack.discovery, attack.t1069.001
// Description: Detects enumeration of local system groups
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.executable endswith "/dscacheutil" and (process.command_line like "*_-q*" and process.command_line like "*_group*")) or (process.executable endswith "/cat" and process.command_line like "*_/etc/group*") or (process.executable endswith "/dscl" and (process.command_line like "*_-list*" and process.command_line like "*_/groups*")))
