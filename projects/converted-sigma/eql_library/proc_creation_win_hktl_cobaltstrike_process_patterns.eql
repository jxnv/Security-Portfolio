// Title: Potential CobaltStrike Process Patterns
// ID: f35c5d71-b489-4e22-a115-f003df287317
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-07-27
// Tags: attack.execution, attack.t1059
// Description: Detects potential process patterns related to Cobalt Strike beacon activity
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.parent.command_line like "*_cmd.exe /C echo*" and process.parent.command_line like "*_ > \\\\\\\\.\\\\pipe*") and process.command_line endswith "conhost.exe 0xffffffff -ForceV1") or (process.parent.command_line endswith "/C whoami" and process.command_line endswith "conhost.exe 0xffffffff -ForceV1") or (process.command_line endswith "cmd.exe /C whoami" and process.parent.executable startswith "C:\\Temp\\") or ((process.parent.executable endswith "\\runonce.exe" or process.parent.executable endswith "\\dllhost.exe") and (process.command_line like "*_cmd.exe /c echo*" and process.command_line like "*_> \\\\\\\\.\\\\pipe*")))
