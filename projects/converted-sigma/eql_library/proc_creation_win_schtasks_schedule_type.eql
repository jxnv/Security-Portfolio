// Title: Suspicious Schtasks Schedule Types
// ID: 24c8392b-aa3c-46b7-a545-43f71657fe98
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-09
// Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
// Description: Detects scheduled task creations or modification on a suspicious schedule type
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.executable endswith "\\schtasks.exe") or (process.pe.original_file_name == "schtasks.exe")) and ((process.command_line like "*_ ONLOGON *" or process.command_line like "*_ ONSTART *" or process.command_line like "*_ ONCE *" or process.command_line like "*_ ONIDLE *"))) and not (((process.command_line like "*_NT AUT*" or process.command_line like "*_ SYSTEM*" or process.command_line like "*_HIGHEST*"))))
