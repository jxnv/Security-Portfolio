// Title: Linux Network Service Scanning - Auditd
// ID: 3761e026-f259-44e6-8826-719ed8079408
// Status: test
// Level: low
// Author: Alejandro Ortuno, oscd.community
// Date: 2020-10-21
// Tags: attack.discovery, attack.t1046
// Description: Detects enumeration of local or remote network services.
// Converted by: Sigma Universal SIEM/EDR CLI

any where (type == "SYSCALL" and (exe endswith "/telnet" or exe endswith "/nmap" or exe endswith "/netcat" or exe endswith "/nc" or exe endswith "/ncat" or exe endswith "/nc.openbsd") and key == "network_connect_4")
