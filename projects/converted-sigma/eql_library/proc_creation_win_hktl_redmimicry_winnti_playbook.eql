process where ((process.executable endswith "\\rundll32.exe" or process.executable endswith "\\cmd.exe") and (process.command_line like "*_gthread-3.6.dll*" or process.command_line like "*_\\Windows\\Temp\\tmp.bat*" or process.command_line like "*_sigcmm-2.4.dll*"))
