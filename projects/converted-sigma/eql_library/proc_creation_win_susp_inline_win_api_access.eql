// Title: Potential WinAPI Calls Via CommandLine
// ID: ba3f5c1b-6272-4119-9dbd-0bc8d21c2702
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-06
// Tags: attack.execution, attack.t1106
// Description: Detects the use of WinAPI Functions via the commandline. As seen used by threat actors via the tool winapiexec
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_AddSecurityPackage*" or process.command_line like "*_AdjustTokenPrivileges*" or process.command_line like "*_Advapi32*" or process.command_line like "*_CloseHandle*" or process.command_line like "*_CreateProcessWithToken*" or process.command_line like "*_CreatePseudoConsole*" or process.command_line like "*_CreateRemoteThread*" or process.command_line like "*_CreateThread*" or process.command_line like "*_CreateUserThread*" or process.command_line like "*_DangerousGetHandle*" or process.command_line like "*_DuplicateTokenEx*" or process.command_line like "*_EnumerateSecurityPackages*" or process.command_line like "*_FreeHGlobal*" or process.command_line like "*_FreeLibrary*" or process.command_line like "*_GetDelegateForFunctionPointer*" or process.command_line like "*_GetLogonSessionData*" or process.command_line like "*_GetModuleHandle*" or process.command_line like "*_GetProcAddress*" or process.command_line like "*_GetProcessHandle*" or process.command_line like "*_GetTokenInformation*" or process.command_line like "*_ImpersonateLoggedOnUser*" or process.command_line like "*_kernel32*" or process.command_line like "*_LoadLibrary*" or process.command_line like "*_memcpy*" or process.command_line like "*_MiniDumpWriteDump*" or process.command_line like "*_ntdll*" or process.command_line like "*_OpenDesktop*" or process.command_line like "*_OpenProcess*" or process.command_line like "*_OpenProcessToken*" or process.command_line like "*_OpenThreadToken*" or process.command_line like "*_OpenWindowStation*" or process.command_line like "*_PtrToString*" or process.command_line like "*_QueueUserApc*" or process.command_line like "*_ReadProcessMemory*" or process.command_line like "*_RevertToSelf*" or process.command_line like "*_RtlCreateUserThread*" or process.command_line like "*_secur32*" or process.command_line like "*_SetThreadToken*" or process.command_line like "*_VirtualAlloc*" or process.command_line like "*_VirtualFree*" or process.command_line like "*_VirtualProtect*" or process.command_line like "*_WaitForSingleObject*" or process.command_line like "*_WriteInt32*" or process.command_line like "*_WriteProcessMemory*" or process.command_line like "*_ZeroFreeGlobalAllocUnicode*")) and not (((process.parent.executable endswith "\\CompatTelRunner.exe" and (process.command_line like "*_FreeHGlobal*" or process.command_line like "*_PtrToString*" or process.command_line like "*_kernel32*" or process.command_line like "*_CloseHandle*")) or (process.executable endswith "\\MpCmdRun.exe" and process.command_line like "*_GetLoadLibraryWAddress32*"))))
