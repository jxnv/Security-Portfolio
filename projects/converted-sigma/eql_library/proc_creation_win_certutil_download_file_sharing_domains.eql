// Title: Suspicious File Downloaded From File-Sharing Website Via Certutil.EXE
// ID: 42a5f1e7-9603-4f6d-97ae-3f37d130d794
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-15
// Tags: attack.stealth, attack.t1027, attack.command-and-control, attack.t1105
// Description: Detects the execution of certutil with certain flags that allow the utility to download files from file-sharing websites.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_urlcache *" or process.command_line like "*_verifyctl *" or process.command_line like "*_URL *")) and ((process.command_line like "*_.githubusercontent.com*" or process.command_line like "*_0x0.st*" or process.command_line like "*_anonfiles.com*" or process.command_line like "*_bashupload.com*" or process.command_line like "*_cdn.discordapp.com*" or process.command_line like "*_chunk.io*" or process.command_line like "*_ddns.net*" or process.command_line like "*_dl.dropboxusercontent.com*" or process.command_line like "*_ghostbin.co*" or process.command_line like "*_github.com*" or process.command_line like "*_glitch.me*" or process.command_line like "*_gofile.io*" or process.command_line like "*_hastebin.com*" or process.command_line like "*_mediafire.com*" or process.command_line like "*_mega.nz*" or process.command_line like "*_onrender.com*" or process.command_line like "*_pages.dev*" or process.command_line like "*_paste.ee*" or process.command_line like "*_pastebin.com*" or process.command_line like "*_pastebin.pl*" or process.command_line like "*_pastetext.net*" or process.command_line like "*_privatlab.com*" or process.command_line like "*_privatlab.net*" or process.command_line like "*_send.exploit.in*" or process.command_line like "*_sendspace.com*" or process.command_line like "*_storage.googleapis.com*" or process.command_line like "*_storjshare.io*" or process.command_line like "*_supabase.co*" or process.command_line like "*_temp.sh*" or process.command_line like "*_transfer.sh*" or process.command_line like "*_trycloudflare.com*" or process.command_line like "*_ufile.io*" or process.command_line like "*_w3spaces.com*" or process.command_line like "*_workers.dev*" or process.command_line like "*_x0.at*")) and ((process.executable endswith "\\certutil.exe") or (process.pe.original_file_name == "CertUtil.exe")))
