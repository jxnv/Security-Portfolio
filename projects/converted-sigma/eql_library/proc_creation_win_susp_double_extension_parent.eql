// Title: Suspicious Parent Double Extension File Execution
// ID: 5e6a80c8-2d45-4633-9ef4-fa2671a39c5c
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-06
// Tags: attack.stealth, attack.t1036.007
// Description: Detect execution of suspicious double extension files in ParentCommandLine
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.parent.executable endswith ".doc.lnk" or process.parent.executable endswith ".docx.lnk" or process.parent.executable endswith ".xls.lnk" or process.parent.executable endswith ".xlsx.lnk" or process.parent.executable endswith ".ppt.lnk" or process.parent.executable endswith ".pptx.lnk" or process.parent.executable endswith ".rtf.lnk" or process.parent.executable endswith ".pdf.lnk" or process.parent.executable endswith ".txt.lnk" or process.parent.executable endswith ".doc.js" or process.parent.executable endswith ".docx.js" or process.parent.executable endswith ".xls.js" or process.parent.executable endswith ".xlsx.js" or process.parent.executable endswith ".ppt.js" or process.parent.executable endswith ".pptx.js" or process.parent.executable endswith ".rtf.js" or process.parent.executable endswith ".pdf.js" or process.parent.executable endswith ".txt.js")) or ((process.parent.command_line like "*_.doc.lnk*" or process.parent.command_line like "*_.docx.lnk*" or process.parent.command_line like "*_.xls.lnk*" or process.parent.command_line like "*_.xlsx.lnk*" or process.parent.command_line like "*_.ppt.lnk*" or process.parent.command_line like "*_.pptx.lnk*" or process.parent.command_line like "*_.rtf.lnk*" or process.parent.command_line like "*_.pdf.lnk*" or process.parent.command_line like "*_.txt.lnk*" or process.parent.command_line like "*_.doc.js*" or process.parent.command_line like "*_.docx.js*" or process.parent.command_line like "*_.xls.js*" or process.parent.command_line like "*_.xlsx.js*" or process.parent.command_line like "*_.ppt.js*" or process.parent.command_line like "*_.pptx.js*" or process.parent.command_line like "*_.rtf.js*" or process.parent.command_line like "*_.pdf.js*" or process.parent.command_line like "*_.txt.js*")))
