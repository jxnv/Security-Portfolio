// Title: New Port Forwarding Rule Added Via Netsh.EXE
// ID: 322ed9ec-fcab-4f67-9a34-e7c6aef43614
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), omkar72, oscd.community, Swachchhanda Shrawan Poudel
// Date: 2019-01-29
// Tags: attack.lateral-movement, attack.command-and-control, attack.t1090
// Description: Detects the execution of netsh commands that configure a new port forwarding (PortProxy) rule
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.executable endswith "\\netsh.exe") or (process.pe.original_file_name == "netsh.exe")) and (((process.command_line like "*_interface*" and process.command_line like "*_portproxy*" and process.command_line like "*_add*" and process.command_line like "*_v4tov4*")) or ((process.command_line like "*_i *" and process.command_line like "*_p *" and process.command_line like "*_a *" and process.command_line like "*_v *")) or ((process.command_line like "*_connectp*" and process.command_line like "*_listena*" and process.command_line like "*_c=*"))))
