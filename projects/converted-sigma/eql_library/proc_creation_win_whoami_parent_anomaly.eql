// Title: Whoami.EXE Execution Anomaly
// ID: 8de1cbe8-d6f5-496d-8237-5f44a721c7a0
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2021-08-12
// Tags: attack.discovery, attack.t1033, car.2016-03-001
// Description: Detects the execution of whoami.exe with suspicious parent processes.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.executable endswith "\\whoami.exe") or (process.pe.original_file_name == "whoami.exe")) and not ((((process.parent.executable endswith "\\cmd.exe" or process.parent.executable endswith "\\powershell_ise.exe" or process.parent.executable endswith "\\powershell.exe" or process.parent.executable endswith "\\pwsh.exe")) or ((process.parent.executable == "" or process.parent.executable == "-")) or (process.parent.executable == null))) and not ((process.parent.executable endswith ":\\Program Files\\Microsoft Monitoring Agent\\Agent\\MonitoringHost.exe")))
