// Title: Potentially Suspicious Rundll32 Activity
// ID: e593cf51-88db-4ee1-b920-37e89012a3c9
// Status: test
// Level: medium
// Author: juju4, Jonhnathan Ribeiro, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2019-01-16
// Tags: attack.stealth, attack.t1218.011
// Description: Detects suspicious execution of rundll32, with specific calls to some DLLs with known LOLBIN functionalities
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.command_line like "*_javascript:*" and process.command_line like "*_.RegisterXLL*")) or ((process.command_line like "*_url.dll*" and process.command_line like "*_OpenURL*")) or ((process.command_line like "*_url.dll*" and process.command_line like "*_OpenURLA*")) or ((process.command_line like "*_url.dll*" and process.command_line like "*_FileProtocolHandler*")) or ((process.command_line like "*_zipfldr.dll*" and process.command_line like "*_RouteTheCall*")) or ((process.command_line like "*_shell32.dll*" and process.command_line like "*_Control_RunDLL*")) or ((process.command_line like "*_shell32.dll*" and process.command_line like "*_ShellExec_RunDLL*")) or ((process.command_line like "*_mshtml.dll*" and process.command_line like "*_PrintHTML*")) or ((process.command_line like "*_advpack.dll*" and process.command_line like "*_LaunchINFSection*")) or ((process.command_line like "*_advpack.dll*" and process.command_line like "*_RegisterOCX*")) or ((process.command_line like "*_ieadvpack.dll*" and process.command_line like "*_LaunchINFSection*")) or ((process.command_line like "*_ieadvpack.dll*" and process.command_line like "*_RegisterOCX*")) or ((process.command_line like "*_ieframe.dll*" and process.command_line like "*_OpenURL*")) or ((process.command_line like "*_shdocvw.dll*" and process.command_line like "*_OpenURL*")) or ((process.command_line like "*_syssetup.dll*" and process.command_line like "*_SetupInfObjectInstallAction*")) or ((process.command_line like "*_setupapi.dll*" and process.command_line like "*_InstallHinfSection*")) or ((process.command_line like "*_pcwutl.dll*" and process.command_line like "*_LaunchApplication*")) or ((process.command_line like "*_dfshim.dll*" and process.command_line like "*_ShOpenVerbApplication*")) or ((process.command_line like "*_dfshim.dll*" and process.command_line like "*_ShOpenVerbShortcut*")) or ((process.command_line like "*_scrobj.dll*" and process.command_line like "*_GenerateTypeLib*" and process.command_line like "*_http*")) or ((process.command_line like "*_shimgvw.dll*" and process.command_line like "*_ImageView_Fullscreen*" and process.command_line like "*_http*")) or ((process.command_line like "*_comsvcs.dll*" and process.command_line like "*_MiniDump*"))) and not (((process.parent.executable == "C:\\Windows\\System32\\control.exe" and process.parent.command_line like "*_.cpl*" and (process.command_line like "*_Shell32.dll*" and process.command_line like "*_Control_RunDLL*" and process.command_line like "*_.cpl*")) or (process.command_line like "*_shell32.dll,Control_RunDLL desk.cpl,screensaver,@screensaver*") or (process.parent.executable == "C:\\Windows\\System32\\control.exe" and process.command_line startswith "\"C:\\Windows\\system32\\rundll32.exe\" Shell32.dll,Control_RunDLL \"C:\\Windows\\System32\\" and process.command_line endswith ".cpl\","))))
