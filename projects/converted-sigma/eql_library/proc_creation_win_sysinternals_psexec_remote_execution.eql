// Title: Potential PsExec Remote Execution
// ID: ea011323-7045-460b-b2d7-0f7442ea6b38
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-28
// Tags: attack.resource-development, attack.t1587.001
// Description: Detects potential psexec command that initiate execution on a remote systems via common commandline flags used by the utility
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_accepteula*" and process.command_line like "*_ -u *" and process.command_line like "*_ -p *" and process.command_line like "*_ \\\\\\\\*")) and not (((process.command_line like "*_\\\\\\\\localhost*" or process.command_line like "*_\\\\\\\\127.*"))))
