// Title: GAC DLL Loaded Via Office Applications
// ID: 90217a70-13fc-48e4-b3db-0d836c5824ac
// Status: test
// Level: high
// Author: Antonlovesdnb
// Date: 2020-02-19
// Tags: attack.execution, attack.t1204.002
// Description: Detects any GAC DLL being loaded by an Office Product
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((process.executable endswith "\\excel.exe" or process.executable endswith "\\mspub.exe" or process.executable endswith "\\onenote.exe" or process.executable endswith "\\onenoteim.exe" or process.executable endswith "\\outlook.exe" or process.executable endswith "\\powerpnt.exe" or process.executable endswith "\\winword.exe") and ImageLoaded startswith "C:\\Windows\\Microsoft.NET\\assembly\\GAC_MSIL")
