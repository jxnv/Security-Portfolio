// Title: Tamper With Sophos AV Registry Keys
// ID: 9f4662ac-17ca-43aa-8f12-5d7b989d0101
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-02
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects tamper attempts to sophos av functionality via registry key modification
// Converted by: Sigma Universal SIEM/EDR CLI

registry where ((registry.path like "*_\\Sophos Endpoint Defense\\TamperProtection\\Config\\SAVEnabled*" or registry.path like "*_\\Sophos Endpoint Defense\\TamperProtection\\Config\\SEDEnabled*" or registry.path like "*_\\Sophos\\SAVService\\TamperProtection\\Enabled*") and registry.data.strings == "DWORD (0x00000000)")
