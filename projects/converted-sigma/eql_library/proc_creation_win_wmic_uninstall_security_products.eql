// Title: Potential Tampering With Security Products Via WMIC
// ID: 847d5ff3-8a31-4737-a970-aeae8fe21765
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-01-30
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects uninstallation or termination of security products using the WMIC utility
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.command_line like "*_wmic*" and process.command_line like "*_product *" and process.command_line like "*_uninstall*") and (process.command_line like "*_/nointeractive*" or process.command_line like "*_-nointeractive*")) or ((process.command_line like "*_wmic*" and process.command_line like "*_caption like *") and (process.command_line like "*_call delete*" or process.command_line like "*_call terminate*")) or ((process.command_line like "*_process *" and process.command_line like "*_where *" and process.command_line like "*_delete*"))) and ((process.command_line like "*_%carbon%*" or process.command_line like "*_%cylance%*" or process.command_line like "*_%endpoint%*" or process.command_line like "*_%eset%*" or process.command_line like "*_%malware%*" or process.command_line like "*_%Sophos%*" or process.command_line like "*_%symantec%*" or process.command_line like "*_Antivirus*" or process.command_line like "*_AVG *" or process.command_line like "*_Carbon Black*" or process.command_line like "*_CarbonBlack*" or process.command_line like "*_Cb Defense Sensor 64-bit*" or process.command_line like "*_Crowdstrike Sensor*" or process.command_line like "*_Cylance *" or process.command_line like "*_Dell Threat Defense*" or process.command_line like "*_DLP Endpoint*" or process.command_line like "*_Endpoint Detection*" or process.command_line like "*_Endpoint Protection*" or process.command_line like "*_Endpoint Security*" or process.command_line like "*_Endpoint Sensor*" or process.command_line like "*_ESET File Security*" or process.command_line like "*_LogRhythm System Monitor Service*" or process.command_line like "*_Malwarebytes*" or process.command_line like "*_McAfee Agent*" or process.command_line like "*_Microsoft Security Client*" or process.command_line like "*_Sophos Anti-Virus*" or process.command_line like "*_Sophos AutoUpdate*" or process.command_line like "*_Sophos Credential Store*" or process.command_line like "*_Sophos Management Console*" or process.command_line like "*_Sophos Management Database*" or process.command_line like "*_Sophos Management Server*" or process.command_line like "*_Sophos Remote Management System*" or process.command_line like "*_Sophos Update Manager*" or process.command_line like "*_Threat Protection*" or process.command_line like "*_VirusScan*" or process.command_line like "*_Webroot SecureAnywhere*" or process.command_line like "*_Windows Defender*")))
