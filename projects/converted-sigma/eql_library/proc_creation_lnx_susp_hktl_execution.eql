// Description: Detects known hacktool execution based on image name.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.executable like "*_/cobaltstrike*" or process.executable like "*_/teamserver*")) or ((process.executable endswith "/crackmapexec" or process.executable endswith "/havoc" or process.executable endswith "/merlin-agent" or process.executable endswith "/merlinServer-Linux-x64" or process.executable endswith "/msfconsole" or process.executable endswith "/msfvenom" or process.executable endswith "/ps-empire server" or process.executable endswith "/ps-empire" or process.executable endswith "/sliver-client" or process.executable endswith "/sliver-server" or process.executable endswith "/Villain.py")) or ((process.executable endswith "/aircrack-ng" or process.executable endswith "/bloodhound-python" or process.executable endswith "/bpfdos" or process.executable endswith "/ebpfki" or process.executable endswith "/evil-winrm" or process.executable endswith "/hashcat" or process.executable endswith "/hoaxshell.py" or process.executable endswith "/hydra" or process.executable endswith "/john" or process.executable endswith "/ncrack" or process.executable endswith "/nxc-ubuntu-latest" or process.executable endswith "/pidhide" or process.executable endswith "/pspy32" or process.executable endswith "/pspy32s" or process.executable endswith "/pspy64" or process.executable endswith "/pspy64s" or process.executable endswith "/setoolkit" or process.executable endswith "/sqlmap" or process.executable endswith "/writeblocker")) or (process.executable like "*_/linpeas*") or ((process.executable endswith "/autorecon" or process.executable endswith "/httpx" or process.executable endswith "/legion" or process.executable endswith "/naabu" or process.executable endswith "/netdiscover" or process.executable endswith "/nuclei" or process.executable endswith "/recon-ng")) or (process.executable like "*_/sniper*") or ((process.executable endswith "/dirb" or process.executable endswith "/dirbuster" or process.executable endswith "/eyewitness" or process.executable endswith "/feroxbuster" or process.executable endswith "/ffuf" or process.executable endswith "/gobuster" or process.executable endswith "/wfuzz" or process.executable endswith "/whatweb")) or ((process.executable endswith "/joomscan" or process.executable endswith "/nikto" or process.executable endswith "/wpscan")))
