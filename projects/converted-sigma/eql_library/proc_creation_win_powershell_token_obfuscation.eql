// Title: Powershell Token Obfuscation - Process Creation
// ID: deb9b646-a508-44ee-b7c9-d8965921c6b6
// Status: test
// Level: high
// Author: frack113
// Date: 2022-12-27
// Tags: attack.stealth, attack.t1027.009
// Description: Detects TOKEN OBFUSCATION technique from Invoke-Obfuscation
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line regex "\\w+`(?:\\w+|-|.)`[\\w+|\\s]") or (process.command_line regex "\"(?:\\{\\d\\})+\"\\s*-f") or (process.command_line regex "(?i)\\$\\{`?e`?n`?v`?:`?p`?a`?t`?h`?\\}")) and not ((process.command_line like "*_${env:path}*")))
