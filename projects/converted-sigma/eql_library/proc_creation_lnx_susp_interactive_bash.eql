// Title: Interactive Bash Suspicious Children
// ID: ea3ecad2-db86-4a89-ad0b-132a10d2db55
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-14
// Tags: attack.execution, attack.stealth, attack.t1059.004, attack.t1036
// Description: Detects suspicious interactive bash as a parent to rather uncommon child processes
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.parent.command_line == "bash -i") and (((process.command_line like "*_-c import *" or process.command_line like "*_base64*" or process.command_line like "*_pty.spawn*")) or ((process.executable endswith "whoami" or process.executable endswith "iptables" or process.executable endswith "/ncat" or process.executable endswith "/nc" or process.executable endswith "/netcat"))))
