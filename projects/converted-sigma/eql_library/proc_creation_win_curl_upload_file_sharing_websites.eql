// Title: Curl File Upload To File Sharing Websites
// ID: e328cc73-f92a-42fb-b3fa-7c2cffda981a
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-03-29
// Tags: attack.exfiltration, attack.t1567.002
// Description: Detects usage of curl to upload files to known file sharing domains, which may indicate data exfiltration.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_0x0.st*" or process.command_line like "*_bashupload.com*" or process.command_line like "*_chunk.io*" or process.command_line like "*_file.io*" or process.command_line like "*_filebin.net*" or process.command_line like "*_pastebin*" or process.command_line like "*_send.firefox.com*" or process.command_line like "*_temp.sh*" or process.command_line like "*_transfer.sh*" or process.command_line like "*_ufile.io*" or process.command_line like "*_uploadfiles.io*" or process.command_line like "*_wetransfer.com*" or process.command_line like "*_x0.at*")) and (((process.command_line like "*_ --form*" or process.command_line like "*_ --upload-file*" or process.command_line like "*_ --data*" or process.command_line like "*_ -X POST*" or process.command_line like "*_ --request POST *")) or ((process.command_line regex "\\s-[FTd]\\s" or process.command_line regex "\\s-sT\\s"))) and ((process.executable endswith "\\curl.exe") or (process.pe.original_file_name == "curl.exe")))
