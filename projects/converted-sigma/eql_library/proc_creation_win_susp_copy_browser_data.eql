// Title: Potential Browser Data Stealing
// ID: 47147b5b-9e17-4d76-b8d2-7bac24c5ce1b
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-23
// Tags: attack.credential-access, attack.t1555.003
// Description: Adversaries may acquire credentials from web browsers by reading files specific to the target browser.
// Web browsers commonly save credentials such as website usernames and passwords so that they do not need to be entered manually in the future.
// Web browsers typically store the credentials in an encrypted format within a credential store.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.command_line like "*_copy-item*" or process.command_line like "*_copy *" or process.command_line like "*_cpi *" or process.command_line like "*_ cp *" or process.command_line like "*_move *" or process.command_line like "*_move-item*" or process.command_line like "*_ mi *" or process.command_line like "*_ mv *")) or ((process.executable endswith "\\esentutl.exe" or process.executable endswith "\\xcopy.exe" or process.executable endswith "\\robocopy.exe")) or ((process.pe.original_file_name == "esentutl.exe" or process.pe.original_file_name == "XCOPY.EXE" or process.pe.original_file_name == "robocopy.exe"))) and ((process.command_line like "*_\\Amigo\\User Data*" or process.command_line like "*_\\BraveSoftware\\Brave-Browser\\User Data*" or process.command_line like "*_\\CentBrowser\\User Data*" or process.command_line like "*_\\Chromium\\User Data*" or process.command_line like "*_\\CocCoc\\Browser\\User Data*" or process.command_line like "*_\\Comodo\\Dragon\\User Data*" or process.command_line like "*_\\Elements Browser\\User Data*" or process.command_line like "*_\\Epic Privacy Browser\\User Data*" or process.command_line like "*_\\Google\\Chrome Beta\\User Data*" or process.command_line like "*_\\Google\\Chrome SxS\\User Data*" or process.command_line like "*_\\Google\\Chrome\\User Data\\*" or process.command_line like "*_\\Kometa\\User Data*" or process.command_line like "*_\\Maxthon5\\Users*" or process.command_line like "*_\\Microsoft\\Edge\\User Data*" or process.command_line like "*_\\Mozilla\\Firefox\\Profiles*" or process.command_line like "*_\\Nichrome\\User Data*" or process.command_line like "*_\\Opera Software\\Opera GX Stable\\*" or process.command_line like "*_\\Opera Software\\Opera Neon\\User Data*" or process.command_line like "*_\\Opera Software\\Opera Stable\\*" or process.command_line like "*_\\Orbitum\\User Data*" or process.command_line like "*_\\QIP Surf\\User Data*" or process.command_line like "*_\\Sputnik\\User Data*" or process.command_line like "*_\\Torch\\User Data*" or process.command_line like "*_\\uCozMedia\\Uran\\User Data*" or process.command_line like "*_\\Vivaldi\\User Data*")))
