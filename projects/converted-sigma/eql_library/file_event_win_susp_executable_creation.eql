// Title: Suspicious Executable File Creation
// ID: 74babdd6-a758-4549-9632-26535279e654
// Status: test
// Level: high
// Author: frack113
// Date: 2022-09-05
// Tags: attack.stealth, attack.t1564
// Description: Detect creation of suspicious executable file names.
// Some strings look for suspicious file extensions, others look for filenames that exploit unquoted service paths.
// Converted by: Sigma Universal SIEM/EDR CLI

file where ((file.path endswith ":\\$Recycle.Bin.exe" or file.path endswith ":\\Documents and Settings.exe" or file.path endswith ":\\MSOCache.exe" or file.path endswith ":\\PerfLogs.exe" or file.path endswith ":\\Recovery.exe" or file.path endswith ".bat.exe" or file.path endswith ".sys.exe"))
