// Title: Credentials from Password Stores - Keychain
// ID: b120b587-a4c2-4b94-875d-99c9807d6955
// Status: test
// Level: medium
// Author: Tim Ismilyaev, oscd.community, Florian Roth (Nextron Systems)
// Date: 2020-10-19
// Tags: attack.credential-access, attack.t1555.001
// Description: Detects passwords dumps from Keychain
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.executable == "/usr/bin/security" and (process.command_line like "*_find-certificate*" or process.command_line like "*_ export *")) or ((process.command_line like "*_ dump-keychain *" or process.command_line like "*_ login-keychain *")))
