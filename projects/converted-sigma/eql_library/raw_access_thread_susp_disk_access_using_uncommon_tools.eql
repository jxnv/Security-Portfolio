// Title: Potential Defense Evasion Via Raw Disk Access By Uncommon Tools
// ID: db809f10-56ce-4420-8c86-d6a7d793c79c
// Status: test
// Level: low
// Author: Teymur Kheirkhabarov, oscd.community
// Date: 2019-10-22
// Tags: attack.stealth, attack.t1006
// Description: Detects raw disk access using uncommon tools or tools that are located in suspicious locations (heavy filtering is required), which could indicate possible defense evasion attempts
// Converted by: Sigma Universal SIEM/EDR CLI

any where (not (((Device like "*_floppy*") or ((process.executable startswith "C:\\$WINDOWS.~BT\\" or process.executable startswith "C:\\Program Files (x86)\\" or process.executable startswith "C:\\Program Files\\" or process.executable startswith "C:\\Windows\\CCM\\" or process.executable startswith "C:\\Windows\\explorer.exe" or process.executable startswith "C:\\Windows\\servicing\\" or process.executable startswith "C:\\Windows\\SoftwareDistribution\\" or process.executable startswith "C:\\Windows\\System32\\" or process.executable startswith "C:\\Windows\\SystemApps\\" or process.executable startswith "C:\\Windows\\SysWOW64\\" or process.executable startswith "C:\\Windows\\uus\\" or process.executable startswith "C:\\Windows\\WinSxS\\")) or (process.executable startswith "C:\\Users\\" and (process.executable like "*_\\AppData\\*" and process.executable like "*_\\Microsoft\\*")) or (process.executable == null) or (process.executable startswith "C:\\Windows\\Temp\\" and (process.executable endswith "\\Executables\\SSDUpdate.exe" or process.executable endswith "\\HostMetadata\\NVMEHostmetadata.exe")) or ((process.executable == "Registry" or process.executable == "System")) or (process.executable == "C:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe") or (process.executable startswith "C:\\$WinREAgent\\Scratch\\") or (process.executable startswith "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\" and (process.executable endswith "\\MsMpEng.exe" or process.executable endswith "\\MpDefenderCoreService.exe")))) and not (((process.executable startswith "C:\\Users\\" and process.executable like "*_\\AppData\\Local\\Keybase\\upd.exe*") or (process.executable startswith "C:\\Users\\" and process.executable like "*_\\AppData\\Local\\GitHubDesktop\\app-*" and process.executable endswith "\\resources\\app\\git\\mingw64\\bin\\git.exe") or (process.executable startswith "C:\\Windows\\Temp\\asgard2-agent\\" and process.executable endswith "\\thor.exe"))))
