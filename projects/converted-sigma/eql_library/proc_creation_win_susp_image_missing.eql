// Title: Execution Of Non-Existing File
// ID: 71158e3f-df67-472b-930e-7d287acaa3e1
// Status: test
// Level: high
// Author: Max Altgelt (Nextron Systems)
// Date: 2021-12-09
// Tags: attack.stealth, attack.privilege-escalation, attack.t1055
// Description: Detects process creation events where the Image field lacks an absolute path,
// which occurs when the backing file no longer exists on disk at the time of
// logging - commonly caused by Process Ghosting or other unorthodox process creation techniques.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (not ((process.executable like "*_\\*")) and not (((((process.executable == "MemCompression" or process.executable == "Registry" or process.executable == "System" or process.executable == "vmmem" or process.executable == "vmmemWSL")) or ((process.command_line == "MemCompression" or process.command_line == "Registry" or process.command_line == "vmmem" or process.command_line == "vmmemWSL"))) or ((process.executable == "-" or process.executable == "")) or (process.executable == null))))
