// Title: Potential Suspicious Winget Package Installation
// ID: a3f5c081-e75b-43a0-9f5b-51f26fe5dba2
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.persistence, attack.stealth
// Description: Detects potential suspicious winget package installation from a suspicious source.
// Converted by: Sigma Universal SIEM/EDR CLI

any where (Contents startswith "[ZoneTransfer]  ZoneId=3" and (Contents like "*_://1*" or Contents like "*_://2*" or Contents like "*_://3*" or Contents like "*_://4*" or Contents like "*_://5*" or Contents like "*_://6*" or Contents like "*_://7*" or Contents like "*_://8*" or Contents like "*_://9*") and file.path endswith ":Zone.Identifier" and file.path like "*_\\AppData\\Local\\Temp\\WinGet\\*")
