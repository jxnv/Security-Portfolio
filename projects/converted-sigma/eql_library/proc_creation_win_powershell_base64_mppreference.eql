// Title: Powershell Base64 Encoded MpPreference Cmdlet
// ID: c6fb44c6-71f5-49e6-9462-1425d328aee3
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-04
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects base64 encoded "MpPreference" PowerShell cmdlet code that tries to modifies or tamper with Windows Defender AV
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_QWRkLU1wUHJlZmVyZW5jZS*" or process.command_line like "*_FkZC1NcFByZWZlcmVuY2Ug*" or process.command_line like "*_BZGQtTXBQcmVmZXJlbmNlI*" or process.command_line like "*_U2V0LU1wUHJlZmVyZW5jZS*" or process.command_line like "*_NldC1NcFByZWZlcmVuY2Ug*" or process.command_line like "*_TZXQtTXBQcmVmZXJlbmNlI*" or process.command_line like "*_YWRkLW1wcHJlZmVyZW5jZS*" or process.command_line like "*_FkZC1tcHByZWZlcmVuY2Ug*" or process.command_line like "*_hZGQtbXBwcmVmZXJlbmNlI*" or process.command_line like "*_c2V0LW1wcHJlZmVyZW5jZS*" or process.command_line like "*_NldC1tcHByZWZlcmVuY2Ug*" or process.command_line like "*_zZXQtbXBwcmVmZXJlbmNlI*")) or ((process.command_line like "*_QQBkAGQALQBNAHAAUAByAGUAZgBlAHIAZQBuAGMAZQAgA*" or process.command_line like "*_EAZABkAC0ATQBwAFAAcgBlAGYAZQByAGUAbgBjAGUAIA*" or process.command_line like "*_BAGQAZAAtAE0AcABQAHIAZQBmAGUAcgBlAG4AYwBlACAA*" or process.command_line like "*_UwBlAHQALQBNAHAAUAByAGUAZgBlAHIAZQBuAGMAZQAgA*" or process.command_line like "*_MAZQB0AC0ATQBwAFAAcgBlAGYAZQByAGUAbgBjAGUAIA*" or process.command_line like "*_TAGUAdAAtAE0AcABQAHIAZQBmAGUAcgBlAG4AYwBlACAA*" or process.command_line like "*_YQBkAGQALQBtAHAAcAByAGUAZgBlAHIAZQBuAGMAZQAgA*" or process.command_line like "*_EAZABkAC0AbQBwAHAAcgBlAGYAZQByAGUAbgBjAGUAIA*" or process.command_line like "*_hAGQAZAAtAG0AcABwAHIAZQBmAGUAcgBlAG4AYwBlACAA*" or process.command_line like "*_cwBlAHQALQBtAHAAcAByAGUAZgBlAHIAZQBuAGMAZQAgA*" or process.command_line like "*_MAZQB0AC0AbQBwAHAAcgBlAGYAZQByAGUAbgBjAGUAIA*" or process.command_line like "*_zAGUAdAAtAG0AcABwAHIAZQBmAGUAcgBlAG4AYwBlACAA*")))
