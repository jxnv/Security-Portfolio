// Title: Potential Credential Dumping Via WER
// ID: 9a4ccd1a-3526-4d99-b980-9f9c5d3a6ff3
// Status: test
// Level: high
// Author: @pbssubhash , Nasreddine Bencherchali
// Date: 2022-12-08
// Tags: attack.credential-access, attack.t1003.001
// Description: Detects potential credential dumping via Windows Error Reporting LSASS Shtinkering technique which uses the Windows Error Reporting to dump lsass
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((ParentUser like "*_AUTHORI*" or ParentUser like "*_AUTORI*") and (user.name like "*_AUTHORI*" or user.name like "*_AUTORI*") and (process.command_line like "*_ -u -p *" and process.command_line like "*_ -ip *" and process.command_line like "*_ -s *")) and ((process.executable endswith "\\Werfault.exe") or (process.pe.original_file_name == "WerFault.exe"))) and not ((process.parent.executable == "C:\\Windows\\System32\\lsass.exe")))
