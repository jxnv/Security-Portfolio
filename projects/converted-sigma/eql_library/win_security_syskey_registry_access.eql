// Title: SysKey Registry Keys Access
// ID: 9a4ff3b8-6187-4fd2-8e8b-e0eae1129495
// Status: test
// Level: high
// Author: Roberto Rodriguez @Cyb3rWard0g
// Date: 2019-08-12
// Tags: attack.discovery, attack.t1012
// Description: Detects handle requests and access operations to specific registry keys to calculate the SysKey
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((winlog.event_id == 4656 or winlog.event_id == 4663) and ObjectType == "key" and (ObjectName endswith "lsa\\JD" or ObjectName endswith "lsa\\GBG" or ObjectName endswith "lsa\\Skew1" or ObjectName endswith "lsa\\Data"))
