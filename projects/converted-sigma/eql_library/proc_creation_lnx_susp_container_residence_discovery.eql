// Title: Container Residence Discovery Via Proc Virtual FS
// ID: 746c86fb-ccda-4816-8997-01386263acc4
// Status: test
// Level: low
// Author: Seth Hanford
// Date: 2023-08-23
// Tags: attack.discovery, attack.t1082
// Description: Detects potential container discovery via listing of certain kernel features in the "/proc" virtual filesystem
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.executable endswith "awk" or process.executable endswith "/cat" or process.executable endswith "grep" or process.executable endswith "/head" or process.executable endswith "/less" or process.executable endswith "/more" or process.executable endswith "/nl" or process.executable endswith "/tail")) and ((process.command_line like "*_/proc/2/*") or (process.command_line like "*_/proc/*" and (process.command_line endswith "/cgroup" or process.command_line endswith "/sched"))))
