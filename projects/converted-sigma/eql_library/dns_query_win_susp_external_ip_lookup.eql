// Title: Suspicious DNS Query for IP Lookup Service APIs
// ID: ec82e2a5-81ea-4211-a1f8-37a0286df2c2
// Status: test
// Level: medium
// Author: Brandon George (blog post), Thomas Patzke
// Date: 2021-07-08
// Tags: attack.reconnaissance, attack.t1590
// Description: Detects DNS queries for IP lookup services such as "api.ipify.org" originating from a non browser process.
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((((QueryName == "www.ip.cn" or QueryName == "l2.io")) or ((QueryName like "*_api.2ip.ua*" or QueryName like "*_api.bigdatacloud.net*" or QueryName like "*_api.ipify.org*" or QueryName like "*_bot.whatismyipaddress.com*" or QueryName like "*_canireachthe.net*" or QueryName like "*_checkip.amazonaws.com*" or QueryName like "*_checkip.dyndns.org*" or QueryName like "*_curlmyip.com*" or QueryName like "*_db-ip.com*" or QueryName like "*_edns.ip-api.com*" or QueryName like "*_eth0.me*" or QueryName like "*_freegeoip.app*" or QueryName like "*_geoipy.com*" or QueryName like "*_getip.pro*" or QueryName like "*_icanhazip.com*" or QueryName like "*_ident.me*" or QueryName like "*_ifconfig.io*" or QueryName like "*_ifconfig.me*" or QueryName like "*_ip-api.com*" or QueryName like "*_ip.360.cn*" or QueryName like "*_ip.anysrc.net*" or QueryName like "*_ip.taobao.com*" or QueryName like "*_ip.tyk.nu*" or QueryName like "*_ipaddressworld.com*" or QueryName like "*_ipapi.co*" or QueryName like "*_ipconfig.io*" or QueryName like "*_ipecho.net*" or QueryName like "*_ipinfo.io*" or QueryName like "*_ipip.net*" or QueryName like "*_ipof.in*" or QueryName like "*_ipv4.icanhazip.com*" or QueryName like "*_ipv4bot.whatismyipaddress.com*" or QueryName like "*_ipv6-test.com*" or QueryName like "*_ipwho.is*" or QueryName like "*_jsonip.com*" or QueryName like "*_myexternalip.com*" or QueryName like "*_seeip.org*" or QueryName like "*_wgetip.com*" or QueryName like "*_whatismyip.akamai.com*" or QueryName like "*_whois.pconline.com.cn*" or QueryName like "*_wtfismyip.com*"))) and not (((process.executable endswith "\\brave.exe") or ((process.executable == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or process.executable == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or ((process.executable startswith "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") or (process.executable endswith "\\WindowsApps\\MicrosoftEdge.exe") or ((process.executable == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or process.executable == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((process.executable startswith "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" or process.executable startswith "C:\\Program Files\\Microsoft\\EdgeCore\\") and (process.executable endswith "\\msedge.exe" or process.executable endswith "\\msedgewebview2.exe")) or ((process.executable == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or process.executable == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or ((process.executable == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or process.executable == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (process.executable endswith "\\maxthon.exe") or (process.executable endswith "\\opera.exe") or (process.executable endswith "\\safari.exe") or (process.executable endswith "\\seamonkey.exe") or (process.executable endswith "\\vivaldi.exe") or (process.executable endswith "\\whale.exe"))))
