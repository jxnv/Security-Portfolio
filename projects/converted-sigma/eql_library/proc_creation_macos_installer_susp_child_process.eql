// Title: Suspicious Installer Package Child Process
// ID: e0cfaecd-602d-41af-988d-f6ccebb2af26
// Status: test
// Level: medium
// Author: Sohan G (D4rkCiph3r)
// Date: 2023-02-18
// Tags: attack.t1059, attack.t1059.007, attack.t1071, attack.t1071.001, attack.execution, attack.command-and-control
// Description: Detects the execution of suspicious child processes from macOS installer package parent process. This includes osascript, JXA, curl and wget amongst other interpreters
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.parent.executable endswith "/package_script_service" or process.parent.executable endswith "/installer") and (process.executable endswith "/sh" or process.executable endswith "/bash" or process.executable endswith "/dash" or process.executable endswith "/python" or process.executable endswith "/ruby" or process.executable endswith "/perl" or process.executable endswith "/php" or process.executable endswith "/javascript" or process.executable endswith "/osascript" or process.executable endswith "/tclsh" or process.executable endswith "/curl" or process.executable endswith "/wget") and (process.command_line like "*_preinstall*" or process.command_line like "*_postinstall*"))
