// Title: Persistence Via New SIP Provider
// ID: 5a2b21ee-6aaa-4234-ac9d-59a59edf90a1
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-21
// Tags: attack.persistence, attack.defense-impairment, attack.t1553.003
// Description: Detects when an attacker register a new SIP provider for persistence and defense evasion
// Converted by: Sigma Universal SIEM/EDR CLI

registry where ((((registry.path like "*_\\Dll*" or registry.path like "*_\\$DLL*")) and ((registry.path like "*_\\SOFTWARE\\Microsoft\\Cryptography\\Providers\\*" or registry.path like "*_\\SOFTWARE\\Microsoft\\Cryptography\\OID\\EncodingType*" or registry.path like "*_\\SOFTWARE\\WOW6432Node\\Microsoft\\Cryptography\\Providers\\*" or registry.path like "*_\\SOFTWARE\\WOW6432Node\\Microsoft\\Cryptography\\OID\\EncodingType*"))) and not ((((registry.data.strings == "WINTRUST.DLL" or registry.data.strings == "mso.dll")) or (process.executable == "C:\\Windows\\System32\\poqexec.exe" and registry.path like "*_\\CryptSIPDll*" and registry.data.strings == "C:\\Windows\\System32\\PsfSip.dll"))))
