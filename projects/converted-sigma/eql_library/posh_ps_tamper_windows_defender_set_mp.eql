// Title: Tamper Windows Defender - ScriptBlockLogging
// ID: 14c71865-6cd3-44ae-adaa-1db923fae5f2
// Status: test
// Level: high
// Author: frack113, elhoim, Tim Shelton (fps, alias support), Swachchhanda Shrawan Poudel, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-16
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects PowerShell scripts attempting to disable scheduled scanning and other parts of Windows Defender ATP or set default actions to allow.
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((((ScriptBlockText like "*_-dbaf $true*" or ScriptBlockText like "*_-dbaf 1*" or ScriptBlockText like "*_-dbm $true*" or ScriptBlockText like "*_-dbm 1*" or ScriptBlockText like "*_-dips $true*" or ScriptBlockText like "*_-dips 1*" or ScriptBlockText like "*_-DisableArchiveScanning $true*" or ScriptBlockText like "*_-DisableArchiveScanning 1*" or ScriptBlockText like "*_-DisableBehaviorMonitoring $true*" or ScriptBlockText like "*_-DisableBehaviorMonitoring 1*" or ScriptBlockText like "*_-DisableBlockAtFirstSeen $true*" or ScriptBlockText like "*_-DisableBlockAtFirstSeen 1*" or ScriptBlockText like "*_-DisableCatchupFullScan $true*" or ScriptBlockText like "*_-DisableCatchupFullScan 1*" or ScriptBlockText like "*_-DisableCatchupQuickScan $true*" or ScriptBlockText like "*_-DisableCatchupQuickScan 1*" or ScriptBlockText like "*_-DisableIntrusionPreventionSystem $true*" or ScriptBlockText like "*_-DisableIntrusionPreventionSystem 1*" or ScriptBlockText like "*_-DisableIOAVProtection $true*" or ScriptBlockText like "*_-DisableIOAVProtection 1*" or ScriptBlockText like "*_-DisableRealtimeMonitoring $true*" or ScriptBlockText like "*_-DisableRealtimeMonitoring 1*" or ScriptBlockText like "*_-DisableRemovableDriveScanning $true*" or ScriptBlockText like "*_-DisableRemovableDriveScanning 1*" or ScriptBlockText like "*_-DisableScanningMappedNetworkDrivesForFullScan $true*" or ScriptBlockText like "*_-DisableScanningMappedNetworkDrivesForFullScan 1*" or ScriptBlockText like "*_-DisableScanningNetworkFiles $true*" or ScriptBlockText like "*_-DisableScanningNetworkFiles 1*" or ScriptBlockText like "*_-DisableScriptScanning $true*" or ScriptBlockText like "*_-DisableScriptScanning 1*" or ScriptBlockText like "*_-MAPSReporting $false*" or ScriptBlockText like "*_-MAPSReporting 0*" or ScriptBlockText like "*_-drdsc $true*" or ScriptBlockText like "*_-drdsc 1*" or ScriptBlockText like "*_-drtm $true*" or ScriptBlockText like "*_-drtm 1*" or ScriptBlockText like "*_-dscrptsc $true*" or ScriptBlockText like "*_-dscrptsc 1*" or ScriptBlockText like "*_-dsmndf $true*" or ScriptBlockText like "*_-dsmndf 1*" or ScriptBlockText like "*_-dsnf $true*" or ScriptBlockText like "*_-dsnf 1*" or ScriptBlockText like "*_-dss $true*" or ScriptBlockText like "*_-dss 1*")) and (ScriptBlockText like "*_Set-MpPreference*")) or ((ScriptBlockText like "*_Set-MpPreference*") and ((ScriptBlockText like "*_HighThreatDefaultAction Allow*" or ScriptBlockText like "*_htdefac Allow*" or ScriptBlockText like "*_LowThreatDefaultAction Allow*" or ScriptBlockText like "*_ltdefac Allow*" or ScriptBlockText like "*_ModerateThreatDefaultAction Allow*" or ScriptBlockText like "*_mtdefac Allow*" or ScriptBlockText like "*_SevereThreatDefaultAction Allow*" or ScriptBlockText like "*_stdefac Allow*"))))
