// Title: ShimCache Flush
// ID: b0524451-19af-4efa-a46f-562a977f792e
// Status: stable
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-02-01
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects actions that clear the local ShimCache and remove forensic evidence
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.command_line like "*_rundll32*" and process.command_line like "*_apphelp.dll*")) and ((process.command_line like "*_ShimFlushCache*" or process.command_line like "*_#250*"))) or (((process.command_line like "*_rundll32*" and process.command_line like "*_kernel32.dll*")) and ((process.command_line like "*_BaseFlushAppcompatCache*" or process.command_line like "*_#46*"))))
