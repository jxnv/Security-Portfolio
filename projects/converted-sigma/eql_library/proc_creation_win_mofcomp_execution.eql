// Title: Potentially Suspicious Mofcomp Execution
// ID: 1dd05363-104e-4b4a-b963-196a534b03a1
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-12
// Tags: attack.stealth, attack.t1218
// Description: Detects execution of the "mofcomp" utility as a child of a suspicious shell or script running utility or by having a suspicious path in the commandline.
// The "mofcomp" utility parses a file containing MOF statements and adds the classes and class instances defined in the file to the WMI repository.
// Attackers abuse this utility to install malicious MOF scripts
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((((process.parent.executable endswith "\\cmd.exe" or process.parent.executable endswith "\\powershell.exe" or process.parent.executable endswith "\\pwsh.exe" or process.parent.executable endswith "\\wsl.exe" or process.parent.executable endswith "\\wscript.exe" or process.parent.executable endswith "\\cscript.exe")) or ((process.command_line like "*_\\AppData\\Local\\Temp*" or process.command_line like "*_\\Contacts\\*" or process.command_line like "*_\\Favorites\\*" or process.command_line like "*_\\Favourites\\*" or process.command_line like "*_\\Music\\*" or process.command_line like "*_\\Pictures\\*" or process.command_line like "*_\\Users\\Public\\*" or process.command_line like "*_\\Videos\\*" or process.command_line like "*_\\WINDOWS\\Temp\\*" or process.command_line like "*_%appdata%*" or process.command_line like "*_%temp%*" or process.command_line like "*_%tmp%*"))) and ((process.executable endswith "\\mofcomp.exe") or (process.pe.original_file_name == "mofcomp.exe"))) and not (((process.parent.command_line endswith "\\InstallUtil.exe /Uninstall C:\\Windows\\CCM\\Microsoft.ConfigurationManager.SVProvider.dll" and process.parent.executable endswith "\\InstallUtil.exe" and (process.command_line like "*_C:\\Windows\\TEMP*" and process.command_line like "*_.tmp*")) or (process.parent.executable == "C:\\Windows\\System32\\wbem\\WmiPrvSE.exe" and process.command_line like "*_C:\\Windows\\TEMP\\*" and process.command_line endswith ".mof"))) and not ((process.parent.command_line == null)))
