// Title: Suspicious Non-Browser Network Communication With Google API
// ID: 7e9cf7b6-e827-11ed-a05b-0242ac120003
// Status: experimental
// Level: medium
// Author: Gavin Knapp
// Date: 2023-05-01
// Tags: attack.command-and-control, attack.t1102
// Description: Detects a non-browser process interacting with the Google API which could indicate the use of a covert C2 such as Google Sheet C2 (GC2-sheet)
// Converted by: Sigma Universal SIEM/EDR CLI

network where (((DestinationHostname like "*_drive.googleapis.com*" or DestinationHostname like "*_oauth2.googleapis.com*" or DestinationHostname like "*_sheets.googleapis.com*" or DestinationHostname like "*_www.googleapis.com*")) and not (((process.executable == "") or (process.executable == null))) and not (((process.executable endswith "\\brave.exe") or ((process.executable endswith ":\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or process.executable endswith ":\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or ((process.executable like "*_:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*") or ((process.executable endswith ":\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or process.executable endswith ":\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe" or process.executable endswith "\\WindowsApps\\MicrosoftEdge.exe"))) or ((process.executable like "*_:\\Program Files (x86)\\Microsoft\\EdgeCore\\*" or process.executable like "*_:\\Program Files\\Microsoft\\EdgeCore\\*") and (process.executable endswith "\\msedge.exe" or process.executable endswith "\\msedgewebview2.exe")) or ((process.executable endswith ":\\Program Files\\Mozilla Firefox\\firefox.exe" or process.executable endswith ":\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or (process.executable like "*_:\\Program Files\\Google\\Drive File Stream\\*" and process.executable endswith "\\GoogleDriveFS.exe") or (process.executable endswith "\\GoogleUpdate.exe") or ((process.executable endswith ":\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or process.executable endswith ":\\Program Files\\Internet Explorer\\iexplore.exe")) or (process.executable endswith "\\maxthon.exe") or (process.executable endswith "\\opera.exe") or (process.executable endswith "\\outlook.exe") or (process.executable endswith "\\safari.exe") or (process.executable endswith "\\seamonkey.exe") or (process.executable endswith "\\vivaldi.exe") or (process.executable endswith "\\whale.exe"))))
