// Title: PowerShell Script Dropped Via PowerShell.EXE
// ID: 576426ad-0131-4001-ae01-be175da0c108
// Status: test
// Level: low
// Author: frack113
// Date: 2023-05-09
// Tags: attack.persistence
// Description: Detects PowerShell creating a PowerShell file (.ps1). While often times this behavior is benign, sometimes it can be a sign of a dropper script trying to achieve persistence.
// Converted by: Sigma Universal SIEM/EDR CLI

file where (((process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe") and file.path endswith ".ps1") and not (((file.path startswith "C:\\Users\\" and file.path like "*_\\AppData\\Local\\Temp\\*") or (file.path like "*___PSScriptPolicyTest_*") or (file.path startswith "C:\\Windows\\Temp\\"))))
