// Title: Potential Binary Impersonating Sysinternals Tools
// ID: 7cce6fc8-a07f-4d84-a53e-96e1879843c9
// Status: test
// Level: medium
// Author: frack113, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2021-12-20
// Tags: attack.execution, attack.stealth, attack.t1218, attack.t1202, attack.t1036.005
// Description: Detects binaries that use the same name as legitimate sysinternals tools to evade detection.
// This rule looks for the execution of binaries that are named similarly to Sysinternals tools.
// Adversary may rename their malicious tools as legitimate Sysinternals tools to evade detection.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.executable endswith "\\accesschk64a.exe" or process.executable endswith "\\ADExplorer64a.exe" or process.executable endswith "\\ADInsight64a.exe" or process.executable endswith "\\adrestore64a.exe" or process.executable endswith "\\Autologon64a.exe" or process.executable endswith "\\Autoruns64a.exe" or process.executable endswith "\\autorunsc64a.exe" or process.executable endswith "\\Clockres64a.exe" or process.executable endswith "\\Contig64a.exe" or process.executable endswith "\\Coreinfo64a.exe" or process.executable endswith "\\Dbgview64a.exe" or process.executable endswith "\\disk2vhd64a.exe" or process.executable endswith "\\diskext64a.exe" or process.executable endswith "\\DiskView64a.exe" or process.executable endswith "\\du64a.exe" or process.executable endswith "\\FindLinks64a.exe" or process.executable endswith "\\handle64a.exe" or process.executable endswith "\\hex2dec64a.exe" or process.executable endswith "\\junction64a.exe" or process.executable endswith "\\LoadOrd64a.exe" or process.executable endswith "\\LoadOrdC64a.exe" or process.executable endswith "\\logonsessions64a.exe" or process.executable endswith "\\movefile64a.exe" or process.executable endswith "\\notmyfault64a.exe" or process.executable endswith "\\notmyfaultc64a.exe" or process.executable endswith "\\pendmoves64a.exe" or process.executable endswith "\\pipelist64a.exe" or process.executable endswith "\\procdump64a.exe" or process.executable endswith "\\procexp64a.exe" or process.executable endswith "\\Procmon64a.exe" or process.executable endswith "\\PsExec64a.exe" or process.executable endswith "\\psfile64a.exe" or process.executable endswith "\\PsGetsid64a.exe" or process.executable endswith "\\PsInfo64a.exe" or process.executable endswith "\\pskill64a.exe" or process.executable endswith "\\psloglist64a.exe" or process.executable endswith "\\pspasswd64a.exe" or process.executable endswith "\\psping64a.exe" or process.executable endswith "\\PsService64a.exe" or process.executable endswith "\\pssuspend64a.exe" or process.executable endswith "\\RAMMap64a.exe" or process.executable endswith "\\RegDelNull64a.exe" or process.executable endswith "\\ru64a.exe" or process.executable endswith "\\sdelete64a.exe" or process.executable endswith "\\sigcheck64a.exe" or process.executable endswith "\\streams64a.exe" or process.executable endswith "\\strings64a.exe" or process.executable endswith "\\sync64a.exe" or process.executable endswith "\\Sysmon64a.exe" or process.executable endswith "\\tcpvcon64a.exe" or process.executable endswith "\\tcpview64a.exe" or process.executable endswith "\\vmmap64a.exe" or process.executable endswith "\\whois64a.exe" or process.executable endswith "\\Winobj64a.exe" or process.executable endswith "\\ZoomIt64a.exe")) or ((process.executable endswith "\\accesschk.exe" or process.executable endswith "\\accesschk64.exe" or process.executable endswith "\\AccessEnum.exe" or process.executable endswith "\\ADExplorer.exe" or process.executable endswith "\\ADExplorer64.exe" or process.executable endswith "\\ADInsight.exe" or process.executable endswith "\\ADInsight64.exe" or process.executable endswith "\\adrestore.exe" or process.executable endswith "\\adrestore64.exe" or process.executable endswith "\\Autologon.exe" or process.executable endswith "\\Autologon64.exe" or process.executable endswith "\\Autoruns.exe" or process.executable endswith "\\Autoruns64.exe" or process.executable endswith "\\autorunsc.exe" or process.executable endswith "\\autorunsc64.exe" or process.executable endswith "\\Bginfo.exe" or process.executable endswith "\\Bginfo64.exe" or process.executable endswith "\\Cacheset.exe" or process.executable endswith "\\Cacheset64.exe" or process.executable endswith "\\Clockres.exe" or process.executable endswith "\\Clockres64.exe" or process.executable endswith "\\Contig.exe" or process.executable endswith "\\Contig64.exe" or process.executable endswith "\\Coreinfo.exe" or process.executable end