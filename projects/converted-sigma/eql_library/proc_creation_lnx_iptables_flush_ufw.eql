// Title: Flush Iptables Ufw Chain
// ID: 3be619f4-d9ec-4ea8-a173-18fdd01996ab
// Status: test
// Level: medium
// Author: Joseliyo Sanchez, @Joseliyo_Jstnk
// Date: 2023-01-18
// Tags: attack.defense-impairment, attack.t1686
// Description: Detect use of iptables to flush all firewall rules, tables and chains and allow all network traffic
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.executable endswith "/iptables" or process.executable endswith "/xtables-legacy-multi" or process.executable endswith "/iptables-legacy-multi" or process.executable endswith "/ip6tables" or process.executable endswith "/ip6tables-legacy-multi")) and ((process.command_line like "*_-F*" or process.command_line like "*_-Z*" or process.command_line like "*_-X*")) and ((process.command_line like "*_ufw-logging-deny*" or process.command_line like "*_ufw-logging-allow*" or process.command_line like "*_ufw6-logging-deny*" or process.command_line like "*_ufw6-logging-allow*")))
