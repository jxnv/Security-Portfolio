// Title: HackTool - KrbRelay Execution
// ID: e96253b8-6b3b-4f90-9e59-3b24b99cf9b4
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-04-27
// Tags: attack.credential-access, attack.t1558.003
// Description: Detects the use of KrbRelay, a Kerberos relaying tool
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_ -spn *" and process.command_line like "*_ -clsid *" and process.command_line like "*_ -rbcd *")) or ((process.command_line like "*_shadowcred*" and process.command_line like "*_clsid*" and process.command_line like "*_spn*")) or ((process.command_line like "*_spn *" and process.command_line like "*_session *" and process.command_line like "*_clsid *")) or ((process.executable endswith "\\KrbRelay.exe") or (process.pe.original_file_name == "KrbRelay.exe")))
