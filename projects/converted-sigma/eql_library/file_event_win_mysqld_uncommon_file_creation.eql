// Title: Uncommon File Creation By Mysql Daemon Process
// ID: c61daa90-3c1e-4f18-af62-8f288b5c9aaf
// Status: test
// Level: high
// Author: Joseph Kamau
// Date: 2024-05-27
// Tags: attack.stealth
// Description: Detects the creation of files with scripting or executable extensions by Mysql daemon.
// Which could be an indicator of "User Defined Functions" abuse to download malware.
// Converted by: Sigma Universal SIEM/EDR CLI

file where ((process.executable endswith "\\mysqld.exe" or process.executable endswith "\\mysqld-nt.exe") and (file.path endswith ".bat" or file.path endswith ".dat" or file.path endswith ".dll" or file.path endswith ".exe" or file.path endswith ".ps1" or file.path endswith ".psm1" or file.path endswith ".vbe" or file.path endswith ".vbs"))
