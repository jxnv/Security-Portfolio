// Title: Potential Command Line Path Traversal Evasion Attempt
// ID: 1327381e-6ab0-4f38-b583-4c1b8346a56b
// Status: test
// Level: medium
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-10-26
// Tags: attack.stealth, attack.t1036
// Description: Detects potential evasion or obfuscation attempts using bogus path traversal via the commandline
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.executable like "*_\\Windows\\*" and (process.command_line like "*_\\..\\Windows\\*" or process.command_line like "*_\\..\\System32\\*" or process.command_line like "*_\\..\\..\\*")) or (process.command_line like "*_.exe\\..\\*")) and not (((process.command_line like "*_\\Citrix\\Virtual Smart Card\\Citrix.Authentication.VirtualSmartcard.Launcher.exe\\..\\*") or (process.command_line like "*_\\Google\\Drive\\googledrivesync.exe\\..\\*"))))
