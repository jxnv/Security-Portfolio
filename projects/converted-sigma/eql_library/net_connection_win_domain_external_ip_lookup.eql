// Title: Suspicious Network Connection to IP Lookup Service APIs
// ID: edf3485d-dac4-4d50-90e4-b0e5813f7e60
// Status: test
// Level: medium
// Author: Janantha Marasinghe, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-24
// Tags: attack.discovery, attack.t1016
// Description: Detects external IP address lookups by non-browser processes via services such as "api.ipify.org". This could be indicative of potential post compromise internet test activity.
// Converted by: Sigma Universal SIEM/EDR CLI

network where ((((DestinationHostname == "www.ip.cn" or DestinationHostname == "l2.io")) or ((DestinationHostname like "*_api.2ip.ua*" or DestinationHostname like "*_api.bigdatacloud.net*" or DestinationHostname like "*_api.ipify.org*" or DestinationHostname like "*_bot.whatismyipaddress.com*" or DestinationHostname like "*_canireachthe.net*" or DestinationHostname like "*_checkip.amazonaws.com*" or DestinationHostname like "*_checkip.dyndns.org*" or DestinationHostname like "*_curlmyip.com*" or DestinationHostname like "*_db-ip.com*" or DestinationHostname like "*_edns.ip-api.com*" or DestinationHostname like "*_eth0.me*" or DestinationHostname like "*_freegeoip.app*" or DestinationHostname like "*_geoipy.com*" or DestinationHostname like "*_getip.pro*" or DestinationHostname like "*_icanhazip.com*" or DestinationHostname like "*_ident.me*" or DestinationHostname like "*_ifconfig.io*" or DestinationHostname like "*_ifconfig.me*" or DestinationHostname like "*_ip-api.com*" or DestinationHostname like "*_ip.360.cn*" or DestinationHostname like "*_ip.anysrc.net*" or DestinationHostname like "*_ip.taobao.com*" or DestinationHostname like "*_ip.tyk.nu*" or DestinationHostname like "*_ipaddressworld.com*" or DestinationHostname like "*_ipapi.co*" or DestinationHostname like "*_ipconfig.io*" or DestinationHostname like "*_ipecho.net*" or DestinationHostname like "*_ipinfo.io*" or DestinationHostname like "*_ipip.net*" or DestinationHostname like "*_ipof.in*" or DestinationHostname like "*_ipv4.icanhazip.com*" or DestinationHostname like "*_ipv4bot.whatismyipaddress.com*" or DestinationHostname like "*_ipv6-test.com*" or DestinationHostname like "*_ipwho.is*" or DestinationHostname like "*_jsonip.com*" or DestinationHostname like "*_myexternalip.com*" or DestinationHostname like "*_seeip.org*" or DestinationHostname like "*_wgetip.com*" or DestinationHostname like "*_whatismyip.akamai.com*" or DestinationHostname like "*_whois.pconline.com.cn*" or DestinationHostname like "*_wtfismyip.com*"))) and not (((process.executable endswith "\\brave.exe") or ((process.executable == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or process.executable == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or ((process.executable startswith "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") or (process.executable endswith "\\WindowsApps\\MicrosoftEdge.exe") or ((process.executable == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or process.executable == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((process.executable startswith "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" or process.executable startswith "C:\\Program Files\\Microsoft\\EdgeCore\\") and (process.executable endswith "\\msedge.exe" or process.executable endswith "\\msedgewebview2.exe")) or ((process.executable == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or process.executable == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or ((process.executable == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or process.executable == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (process.executable endswith "\\maxthon.exe") or (process.executable endswith "\\opera.exe") or (process.executable endswith "\\safari.exe") or (process.executable endswith "\\seamonkey.exe") or (process.executable endswith "\\vivaldi.exe") or (process.executable endswith "\\whale.exe"))))
