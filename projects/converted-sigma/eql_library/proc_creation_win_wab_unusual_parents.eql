// Title: Wab/Wabmig Unusual Parent Or Child Processes
// ID: 63d1ccc0-2a43-4f4b-9289-361b308991ff
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-12
// Tags: attack.execution, attack.stealth
// Description: Detects unusual parent or children of the wab.exe (Windows Contacts) and Wabmig.exe (Microsoft Address Book Import Tool) processes as seen being used with bumblebee activity
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.parent.executable endswith "\\wab.exe" or process.parent.executable endswith "\\wabmig.exe")) or ((process.parent.executable endswith "\\WmiPrvSE.exe" or process.parent.executable endswith "\\svchost.exe" or process.parent.executable endswith "\\dllhost.exe") and (process.executable endswith "\\wab.exe" or process.executable endswith "\\wabmig.exe")))
