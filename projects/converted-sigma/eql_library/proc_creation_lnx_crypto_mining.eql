// Title: Linux Crypto Mining Indicators
// ID: 9069ea3c-b213-4c52-be13-86506a227ab1
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-10-26
// Tags: attack.impact, attack.t1496
// Description: Detects command line parameters or strings often used by crypto miners
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.command_line like "*_ --cpu-priority=*" or process.command_line like "*_--donate-level=0*" or process.command_line like "*_ -o pool.*" or process.command_line like "*_ --nicehash*" or process.command_line like "*_ --algo=rx/0 *" or process.command_line like "*_stratum+tcp://*" or process.command_line like "*_stratum+udp://*" or process.command_line like "*_sh -c /sbin/modprobe msr allow_writes=on*" or process.command_line like "*_LS1kb25hdGUtbGV2ZWw9*" or process.command_line like "*_0tZG9uYXRlLWxldmVsP*" or process.command_line like "*_tLWRvbmF0ZS1sZXZlbD*" or process.command_line like "*_c3RyYXR1bSt0Y3A6Ly*" or process.command_line like "*_N0cmF0dW0rdGNwOi8v*" or process.command_line like "*_zdHJhdHVtK3RjcDovL*" or process.command_line like "*_c3RyYXR1bSt1ZHA6Ly*" or process.command_line like "*_N0cmF0dW0rdWRwOi8v*" or process.command_line like "*_zdHJhdHVtK3VkcDovL*"))
