// Title: Invoke-Obfuscation VAR++ LAUNCHER OBFUSCATION - Security
// ID: 4c54ba8f-73d2-4d40-8890-d9cf1dca3d30
// Status: test
// Level: high
// Author: Timur Zinniatullin, oscd.community
// Date: 2020-10-13
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via VAR++ LAUNCHER
// Converted by: Sigma Universal SIEM/EDR CLI

any where (winlog.event_id == 4697 and (ServiceFileName like "*_&&set*" and ServiceFileName like "*_cmd*" and ServiceFileName like "*_/c*" and ServiceFileName like "*_-f*") and (ServiceFileName like "*_{0}*" or ServiceFileName like "*_{1}*" or ServiceFileName like "*_{2}*" or ServiceFileName like "*_{3}*" or ServiceFileName like "*_{4}*" or ServiceFileName like "*_{5}*"))
