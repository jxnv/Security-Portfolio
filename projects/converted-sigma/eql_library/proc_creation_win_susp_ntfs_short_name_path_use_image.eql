// Title: Use Short Name Path in Image
// ID: a96970af-f126-420d-90e1-d37bf25e50e1
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali
// Date: 2022-08-07
// Tags: attack.stealth, attack.t1564.004
// Description: Detect use of the Windows 8.3 short name. Which could be used as a method to avoid Image detection
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.executable like "*_~1\\*" or process.executable like "*_~2\\*")) and not (((((process.executable like "*_\\AppData\\*" and process.executable like "*_\\Temp\\*")) or ((process.executable endswith "~1\\unzip.exe" or process.executable endswith "~1\\7zG.exe"))) or ((process.parent.executable == "C:\\Windows\\System32\\Dism.exe" or process.parent.executable == "C:\\Windows\\System32\\cleanmgr.exe")))) and not ((((Product == "InstallShield (R)") or (Description == "InstallShield (R) Setup Engine") or (Company == "InstallShield Software Corporation")) or (process.parent.executable endswith "\\thor\\thor64.exe") or (process.parent.executable endswith "\\WebEx\\WebexHost.exe"))))
