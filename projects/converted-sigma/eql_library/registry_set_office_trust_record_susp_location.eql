// Title: Macro Enabled In A Potentially Suspicious Document
// ID: a166f74e-bf44-409d-b9ba-ea4b2dd8b3cd
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-21
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects registry changes to Office trust records where the path is located in a potentially suspicious location
// Converted by: Sigma Universal SIEM/EDR CLI

registry where (((registry.path like "*_/AppData/Local/Microsoft/Windows/INetCache/*" or registry.path like "*_/AppData/Local/Temp/*" or registry.path like "*_/PerfLogs/*" or registry.path like "*_C:/Users/Public/*" or registry.path like "*_file:///D:/*" or registry.path like "*_file:///E:/*")) and (registry.path like "*_\\Security\\Trusted Documents\\TrustRecords*"))
