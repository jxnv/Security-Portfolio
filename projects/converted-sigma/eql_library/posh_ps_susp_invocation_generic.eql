// Title: Suspicious PowerShell Invocations - Generic
// ID: ed965133-513f-41d9-a441-e38076a0798f
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2017-03-12
// Tags: attack.execution, attack.t1059.001
// Description: Detects suspicious PowerShell invocation command parameters
// Converted by: Sigma Universal SIEM/EDR CLI

any where (((ScriptBlockText like "*_ -enc *" or ScriptBlockText like "*_ -EncodedCommand *" or ScriptBlockText like "*_ -ec *")) and ((ScriptBlockText like "*_ -w hidden *" or ScriptBlockText like "*_ -window hidden *" or ScriptBlockText like "*_ -windowstyle hidden *" or ScriptBlockText like "*_ -w 1 *")) and ((ScriptBlockText like "*_ -noni *" or ScriptBlockText like "*_ -noninteractive *")))
