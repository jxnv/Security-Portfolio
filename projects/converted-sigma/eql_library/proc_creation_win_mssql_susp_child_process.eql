// Title: Suspicious Child Process Of SQL Server
// ID: 869b9ca7-9ea2-4a5a-8325-e80e62f75445
// Status: test
// Level: high
// Author: FPT.EagleEye Team, wagga
// Date: 2020-12-11
// Tags: attack.t1505.003, attack.t1190, attack.initial-access, attack.persistence, attack.privilege-escalation
// Description: Detects suspicious child processes of the SQLServer process. This could indicate potential RCE or SQL Injection.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.parent.executable endswith "\\sqlservr.exe" and (process.executable endswith "\\bash.exe" or process.executable endswith "\\bitsadmin.exe" or process.executable endswith "\\cmd.exe" or process.executable endswith "\\netstat.exe" or process.executable endswith "\\nltest.exe" or process.executable endswith "\\ping.exe" or process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe" or process.executable endswith "\\regsvr32.exe" or process.executable endswith "\\rundll32.exe" or process.executable endswith "\\sh.exe" or process.executable endswith "\\systeminfo.exe" or process.executable endswith "\\tasklist.exe" or process.executable endswith "\\wsl.exe")) and not ((process.parent.executable startswith "C:\\Program Files\\Microsoft SQL Server\\" and process.parent.executable endswith "DATEV_DBENGINE\\MSSQL\\Binn\\sqlservr.exe" and process.executable == "C:\\Windows\\System32\\cmd.exe" and process.command_line startswith "\"C:\\Windows\\system32\\cmd.exe\" ")))
