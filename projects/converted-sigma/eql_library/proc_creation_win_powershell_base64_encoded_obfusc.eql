// Title: Suspicious Obfuscated PowerShell Code
// ID: 8d01b53f-456f-48ee-90f6-bc28e67d4e35
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-07-11
// Tags: attack.stealth
// Description: Detects suspicious UTF16 and base64 encoded and often obfuscated PowerShell code often used in command lines
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.command_line like "*_IAAtAGIAeABvAHIAIAAwAHgA*" or process.command_line like "*_AALQBiAHgAbwByACAAMAB4A*" or process.command_line like "*_gAC0AYgB4AG8AcgAgADAAeA*" or process.command_line like "*_AC4ASQBuAHYAbwBrAGUAKAApACAAfAAg*" or process.command_line like "*_AuAEkAbgB2AG8AawBlACgAKQAgAHwAI*" or process.command_line like "*_ALgBJAG4AdgBvAGsAZQAoACkAIAB8AC*" or process.command_line like "*_AHsAMQB9AHsAMAB9ACIAIAAtAGYAI*" or process.command_line like "*_B7ADEAfQB7ADAAfQAiACAALQBmAC*" or process.command_line like "*_AewAxAH0AewAwAH0AIgAgAC0AZgAg*" or process.command_line like "*_AHsAMAB9AHsAMwB9ACIAIAAtAGYAI*" or process.command_line like "*_B7ADAAfQB7ADMAfQAiACAALQBmAC*" or process.command_line like "*_AewAwAH0AewAzAH0AIgAgAC0AZgAg*" or process.command_line like "*_AHsAMgB9AHsAMAB9ACIAIAAtAGYAI*" or process.command_line like "*_B7ADIAfQB7ADAAfQAiACAALQBmAC*" or process.command_line like "*_AewAyAH0AewAwAH0AIgAgAC0AZgAg*" or process.command_line like "*_AHsAMQB9AHsAMAB9ACcAIAAtAGYAI*" or process.command_line like "*_B7ADEAfQB7ADAAfQAnACAALQBmAC*" or process.command_line like "*_AewAxAH0AewAwAH0AJwAgAC0AZgAg*" or process.command_line like "*_AHsAMAB9AHsAMwB9ACcAIAAtAGYAI*" or process.command_line like "*_B7ADAAfQB7ADMAfQAnACAALQBmAC*" or process.command_line like "*_AewAwAH0AewAzAH0AJwAgAC0AZgAg*" or process.command_line like "*_AHsAMgB9AHsAMAB9ACcAIAAtAGYAI*" or process.command_line like "*_B7ADIAfQB7ADAAfQAnACAALQBmAC*" or process.command_line like "*_AewAyAH0AewAwAH0AJwAgAC0AZgAg*"))
