// Title: .RDP File Created By Uncommon Application
// ID: fccfb43e-09a7-4bd2-8b37-a5a7df33386d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.stealth
// Description: Detects creation of a file with an ".rdp" extension by an application that doesn't commonly create such files.
// Converted by: Sigma Universal SIEM/EDR CLI

file where (file.path endswith ".rdp" and (process.executable endswith "\\brave.exe" or process.executable endswith "\\CCleaner Browser\\Application\\CCleanerBrowser.exe" or process.executable endswith "\\chromium.exe" or process.executable endswith "\\firefox.exe" or process.executable endswith "\\Google\\Chrome\\Application\\chrome.exe" or process.executable endswith "\\iexplore.exe" or process.executable endswith "\\microsoftedge.exe" or process.executable endswith "\\msedge.exe" or process.executable endswith "\\Opera.exe" or process.executable endswith "\\Vivaldi.exe" or process.executable endswith "\\Whale.exe" or process.executable endswith "\\olk.exe" or process.executable endswith "\\Outlook.exe" or process.executable endswith "\\RuntimeBroker.exe" or process.executable endswith "\\Thunderbird.exe" or process.executable endswith "\\Discord.exe" or process.executable endswith "\\Keybase.exe" or process.executable endswith "\\msteams.exe" or process.executable endswith "\\Slack.exe" or process.executable endswith "\\teams.exe"))
