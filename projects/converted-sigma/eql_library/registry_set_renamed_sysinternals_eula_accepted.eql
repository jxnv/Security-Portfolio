// Title: Usage of Renamed Sysinternals Tools - RegistrySet
// ID: 8023f872-3f1d-4301-a384-801889917ab4
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-24
// Tags: attack.resource-development, attack.t1588.002
// Description: Detects non-sysinternals tools setting the "accepteula" key which normally is set on sysinternals tool execution
// Converted by: Sigma Universal SIEM/EDR CLI

registry where (((registry.path like "*_\\PsExec*" or registry.path like "*_\\ProcDump*" or registry.path like "*_\\Handle*" or registry.path like "*_\\LiveKd*" or registry.path like "*_\\Process Explorer*" or registry.path like "*_\\PsLoglist*" or registry.path like "*_\\PsPasswd*" or registry.path like "*_\\Active Directory Explorer*") and registry.path endswith "\\EulaAccepted") and not (((process.executable endswith "\\PsExec.exe" or process.executable endswith "\\PsExec64.exe" or process.executable endswith "\\PsExec64a.exe" or process.executable endswith "\\procdump.exe" or process.executable endswith "\\procdump64.exe" or process.executable endswith "\\procdump64a.exe" or process.executable endswith "\\handle.exe" or process.executable endswith "\\handle64.exe" or process.executable endswith "\\handle64a.exe" or process.executable endswith "\\livekd.exe" or process.executable endswith "\\livekd64.exe" or process.executable endswith "\\procexp.exe" or process.executable endswith "\\procexp64.exe" or process.executable endswith "\\procexp64a.exe" or process.executable endswith "\\psloglist.exe" or process.executable endswith "\\psloglist64.exe" or process.executable endswith "\\psloglist64a.exe" or process.executable endswith "\\pspasswd.exe" or process.executable endswith "\\pspasswd64.exe" or process.executable endswith "\\pspasswd64a.exe" or process.executable endswith "\\ADExplorer.exe" or process.executable endswith "\\ADExplorer64.exe" or process.executable endswith "\\ADExplorer64a.exe"))) and not ((process.executable == null)))
