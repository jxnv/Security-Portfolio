// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of "7za.dll"
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((ImageLoaded endswith "\\7za.dll") and not (((process.executable startswith "C:\\Program Files (x86)\\" or process.executable startswith "C:\\Program Files\\") and (ImageLoaded startswith "C:\\Program Files (x86)\\" or ImageLoaded startswith "C:\\Program Files\\"))))
