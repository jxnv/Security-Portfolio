// Title: Webshell Hacking Activity Patterns
// ID: 4ebc877f-4612-45cb-b3a5-8e3834db36c9
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-17
// Tags: attack.persistence, attack.discovery, attack.t1505.003, attack.t1018, attack.t1033, attack.t1087
// Description: Detects certain parent child patterns found in cases in which a web shell is used to perform certain credential dumping or exfiltration activities on a compromised system
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.parent.executable endswith "\\java.exe" or process.parent.executable endswith "\\javaw.exe") and (process.parent.executable like "*_-tomcat-*" or process.parent.executable like "*_\\tomcat*")) or ((process.parent.executable endswith "\\java.exe" or process.parent.executable endswith "\\javaw.exe") and (process.command_line like "*_catalina.jar*" or process.command_line like "*_CATALINA_HOME*")) or ((process.parent.executable endswith "\\caddy.exe" or process.parent.executable endswith "\\httpd.exe" or process.parent.executable endswith "\\nginx.exe" or process.parent.executable endswith "\\php-cgi.exe" or process.parent.executable endswith "\\w3wp.exe" or process.parent.executable endswith "\\ws_tomcatservice.exe"))) and (((process.command_line like "*_rundll32*" and process.command_line like "*_comsvcs*")) or ((process.command_line like "*_ -hp*" and process.command_line like "*_ a *" and process.command_line like "*_ -m*")) or ((process.command_line like "*_net*" and process.command_line like "*_ user *" and process.command_line like "*_ /add*")) or ((process.command_line like "*_net*" and process.command_line like "*_ localgroup *" and process.command_line like "*_ administrators *" and process.command_line like "*_/add*")) or ((process.executable endswith "\\ntdsutil.exe" or process.executable endswith "\\ldifde.exe" or process.executable endswith "\\adfind.exe" or process.executable endswith "\\procdump.exe" or process.executable endswith "\\Nanodump.exe" or process.executable endswith "\\vssadmin.exe" or process.executable endswith "\\fsutil.exe")) or ((process.command_line like "*_ -decode *" or process.command_line like "*_ -NoP *" or process.command_line like "*_ -W Hidden *" or process.command_line like "*_ /decode *" or process.command_line like "*_ /ticket:*" or process.command_line like "*_ sekurlsa*" or process.command_line like "*_.dmp full*" or process.command_line like "*_.downloadfile(*" or process.command_line like "*_.downloadstring(*" or process.command_line like "*_FromBase64String*" or process.command_line like "*_process call create*" or process.command_line like "*_reg save *" or process.command_line like "*_whoami /priv*"))))
