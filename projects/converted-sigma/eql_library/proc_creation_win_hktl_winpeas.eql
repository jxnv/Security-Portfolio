// Tags: attack.privilege-escalation, attack.discovery, attack.t1082, attack.t1087, attack.t1046
// Description: WinPEAS is a script that search for possible paths to escalate privileges on Windows hosts. The checks are explained on book.hacktricks.xyz
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.command_line like "*_https://github.com/carlospolop/PEASS-ng/releases/latest/download/*") or ((process.command_line like "*_ applicationsinfo*" or process.command_line like "*_ browserinfo*" or process.command_line like "*_ eventsinfo*" or process.command_line like "*_ fileanalysis*" or process.command_line like "*_ filesinfo*" or process.command_line like "*_ processinfo*" or process.command_line like "*_ servicesinfo*" or process.command_line like "*_ windowscreds*")) or ((process.parent.command_line endswith " -linpeas") or (process.command_line endswith " -linpeas")) or ((process.pe.original_file_name == "winPEAS.exe") or ((process.executable endswith "\\winPEASany_ofs.exe" or process.executable endswith "\\winPEASany.exe" or process.executable endswith "\\winPEASx64_ofs.exe" or process.executable endswith "\\winPEASx64.exe" or process.executable endswith "\\winPEASx86_ofs.exe" or process.executable endswith "\\winPEASx86.exe"))))
