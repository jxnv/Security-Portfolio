// Title: Chromium Browser Headless Execution To Mockbin Like Site
// ID: 1c526788-0abe-4713-862f-b520da5e5316
// Status: test
// Level: high
// Author: X__Junior (Nextron Systems)
// Date: 2023-09-11
// Tags: attack.execution
// Description: Detects the execution of a Chromium based browser process with the "headless" flag and a URL pointing to the mockbin.org service (which can be used to exfiltrate data).
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.command_line like "*_--headless*") and ((process.executable endswith "\\brave.exe" or process.executable endswith "\\chrome.exe" or process.executable endswith "\\msedge.exe" or process.executable endswith "\\opera.exe" or process.executable endswith "\\vivaldi.exe")) and ((process.command_line like "*_://run.mocky*" or process.command_line like "*_://mockbin*")))
