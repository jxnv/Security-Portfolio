// Title: Suspicious Msiexec Quiet Install From Remote Location
// ID: 8150732a-0c9d-4a99-82b9-9efb9b90c40c
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-28
// Tags: attack.stealth, attack.t1218.007
// Description: Detects usage of Msiexec.exe to install packages hosted remotely quietly
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.command_line like "*_-i*" or process.command_line like "*_/i*" or process.command_line like "*_-package*" or process.command_line like "*_/package*" or process.command_line like "*_-a*" or process.command_line like "*_/a*" or process.command_line like "*_-j*" or process.command_line like "*_/j*")) and ((process.executable endswith "\\msiexec.exe") or (process.pe.original_file_name == "msiexec.exe")) and ((process.command_line like "*_-q*" or process.command_line like "*_/q*")) and ((process.command_line like "*_http*" or process.command_line like "*_\\\\\\\\*"))) and not (((process.command_line like "*_\\AppData\\Local\\Temp\\OpenOffice*" and process.command_line like "*_Installation Files\\openoffice*"))))
