// Title: Execution Of Script Located In Potentially Suspicious Directory
// ID: 30bcce26-51c5-49f2-99c8-7b59e3af36c7
// Status: test
// Level: medium
// Author: Joseliyo Sanchez, @Joseliyo_Jstnk
// Date: 2023-06-02
// Tags: attack.execution
// Description: Detects executions of scripts located in potentially suspicious locations such as "/tmp" via a shell such as "bash", "sh", etc.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.command_line like "*_ -c *") and ((process.executable endswith "/bash" or process.executable endswith "/csh" or process.executable endswith "/dash" or process.executable endswith "/fish" or process.executable endswith "/ksh" or process.executable endswith "/sh" or process.executable endswith "/zsh")) and (process.command_line like "*_/tmp/*"))
