registry where (((registry.path like "*_\\SOFTWARE\\Wow6432Node\\Microsoft\\Windows\\CurrentVersion*") and ((registry.path like "*_\\ShellServiceObjectDelayLoad*" or registry.path like "*_\\Run\\*" or registry.path like "*_\\RunOnce\\*" or registry.path like "*_\\RunOnceEx\\*" or registry.path like "*_\\RunServices\\*" or registry.path like "*_\\RunServicesOnce\\*" or registry.path like "*_\\Explorer\\ShellServiceObjects*" or registry.path like "*_\\Explorer\\ShellIconOverlayIdentifiers*" or registry.path like "*_\\Explorer\\ShellExecuteHooks*" or registry.path like "*_\\Explorer\\SharedTaskScheduler*" or registry.path like "*_\\Explorer\\Browser Helper Objects*"))) and not ((((process.executable like "*_C:\\Program Files (x86)\\Microsoft\\EdgeUpdate\\Install\\{*" and process.executable like "*_\\setup.exe*")) or (registry.data.strings == "(Empty)") or (registry.data.strings startswith "\"C:\\ProgramData\\Package Cache\\{d21a4f20-968a-4b0c-bf04-a38da5f06e41}\\windowsdesktop-runtime-") or (process.executable == "C:\\WINDOWS\\system32\\msiexec.exe" and registry.path like "*_\\SOFTWARE\\Wow6432Node\\Microsoft\\Windows\\CurrentVersion\\Run\\*") or (registry.data.strings == null) or (process.executable startswith "C:\\Windows\\Installer\\MSI" and registry.path like "*_\\Explorer\\Browser Helper Objects*") or ((process.executable startswith "C:\\ProgramData\\Package Cache" or process.executable startswith "C:\\Windows\\Temp\\") and (process.executable like "*_\\winsdksetup.exe*" or process.executable like "*_\\windowsdesktop-runtime-*" or process.executable like "*_\\AspNetCoreSharedFrameworkBundle-*") and registry.data.strings endswith " /burn.runonce") or (process.executable endswith "\\VC_redist.x64.exe" and registry.data.strings endswith "}\\VC_redist.x64.exe\" /burn.runonce"))) and not (((process.executable endswith "\\instup.exe" and registry.path endswith "\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\AvRepair" and registry.data.strings endswith "instup.exe\" /instop:repair /wait") or (process.executable endswith "\\instup.exe" and (registry.path endswith "\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Explorer\\ShellIconOverlayIdentifiers\\00avg\\(Default)" or registry.path endswith "\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Explorer\\ShellIconOverlayIdentifiers\\00asw\\(Default)") and (registry.data.strings == "{472083B1-C522-11CF-8763-00608CC02F24}" or registry.data.strings == "{472083B0-C522-11CF-8763-00608CC02F24}")) or (registry.data.strings endswith "\\Avira.OE.Setup.Bundle.exe\" /burn.runonce" and process.executable endswith "\\Avira.OE.Setup.Bundle.exe") or (registry.path endswith "\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run\\Discord" and registry.data.strings endswith "Discord.exe --checkInstall") or (process.executable like "*_\\windowsdesktop-runtime-*" and (registry.path endswith "\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\{e2d1ae32-dd1d-4ad7-a298-10e42e7840fc}" or registry.path endswith "\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\{7037b699-7382-448c-89a7-4765961d2537}") and registry.data.strings startswith "\"C:\\ProgramData\\Package Cache\\" and registry.data.strings endswith ".exe\" /burn.runonce") or ((registry.data.strings endswith "-A251-47B7-93E1-CDD82E34AF8B}") or (registry.data.strings == "grpconv -o") or ((registry.data.strings like "*_C:\\Program Files*" and registry.data.strings like "*_\\Dropbox\\Client\\Dropbox.exe*" and registry.data.strings like "*_ /systemstartup*"))) or (registry.path endswith "\\Explorer\\Browser Helper Objects\\{92EF2EAD-A7CE-4424-B0DB-499CF856608E}\\NoExplorer") or (process.executable == "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\OfficeClickToRun.exe" and registry.path like "*_\\Office\\ClickToRun\\REGISTRY\\MACHINE\\Software\\Wow6432Node\\*") or ((process.executable == "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe" or process.executable == "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe") and registry.path like "*_\\Explorer\\Browser Helper Objects\\{31D09BA0-12F5-4CCE-BE8A-2923E76605DA}\\*") or ((process.executable startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\" or process.executable startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\") and process.executable endswith "\\OfficeClickToRun.exe"))))
