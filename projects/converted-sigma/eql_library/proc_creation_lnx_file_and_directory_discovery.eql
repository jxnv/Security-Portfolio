// Title: File and Directory Discovery - Linux
// ID: d3feb4ee-ff1d-4d3d-bd10-5b28a238cc72
// Status: test
// Level: informational
// Author: Daniil Yugoslavskiy, oscd.community, CheraghiMilad
// Date: 2020-10-19
// Tags: attack.discovery, attack.t1083
// Description: Detects usage of system utilities such as "find", "tree", "findmnt", etc, to discover files, directories and network shares.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.executable endswith "/file" and process.command_line regex "(.){200,}") or (process.executable endswith "/find") or (process.executable endswith "/findmnt") or (process.executable endswith "/mlocate") or (process.executable endswith "/ls" and process.command_line like "*_-R*") or (process.executable endswith "/tree"))
