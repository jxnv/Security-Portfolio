// Title: Suspicious Program Names
// ID: efdd8dd5-cee8-4e59-9390-7d4d5e4dd6f6
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-11
// Tags: attack.execution, attack.t1059
// Description: Detects suspicious patterns in program names or folders that are often found in malicious samples or hacktools
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_inject.ps1*" or process.command_line like "*_Invoke-CVE*" or process.command_line like "*_pupy.ps1*" or process.command_line like "*_payload.ps1*" or process.command_line like "*_beacon.ps1*" or process.command_line like "*_PowerView.ps1*" or process.command_line like "*_bypass.ps1*" or process.command_line like "*_obfuscated.ps1*" or process.command_line like "*_obfusc.ps1*" or process.command_line like "*_obfus.ps1*" or process.command_line like "*_obfs.ps1*" or process.command_line like "*_evil.ps1*" or process.command_line like "*_MiniDogz.ps1*" or process.command_line like "*__enc.ps1*" or process.command_line like "*_\\shell.ps1*" or process.command_line like "*_\\rshell.ps1*" or process.command_line like "*_revshell.ps1*" or process.command_line like "*_\\av.ps1*" or process.command_line like "*_\\av_test.ps1*" or process.command_line like "*_adrecon.ps1*" or process.command_line like "*_mimikatz.ps1*" or process.command_line like "*_\\PowerUp_*" or process.command_line like "*_powerup.ps1*" or process.command_line like "*_\\Temp\\a.ps1*" or process.command_line like "*_\\Temp\\p.ps1*" or process.command_line like "*_\\Temp\\1.ps1*" or process.command_line like "*_Hound.ps1*" or process.command_line like "*_encode.ps1*" or process.command_line like "*_powercat.ps1*")) or (((process.executable like "*_\\CVE-202*" or process.executable like "*_\\CVE202*")) or ((process.executable endswith "\\poc.exe" or process.executable endswith "\\artifact.exe" or process.executable endswith "\\artifact64.exe" or process.executable endswith "\\artifact_protected.exe" or process.executable endswith "\\artifact32.exe" or process.executable endswith "\\artifact32big.exe" or process.executable endswith "obfuscated.exe" or process.executable endswith "obfusc.exe" or process.executable endswith "\\meterpreter"))))
