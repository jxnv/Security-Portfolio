// Title: Linux Remote System Discovery
// ID: 11063ec2-de63-4153-935e-b1a8b9e616f1
// Status: test
// Level: low
// Author: Alejandro Ortuno, oscd.community
// Date: 2020-10-22
// Tags: attack.discovery, attack.t1018
// Description: Detects the enumeration of other remote systems.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.executable endswith "/arp" and process.command_line like "*_-a*") or (process.executable endswith "/ping" and (process.command_line like "*_ 10.*" or process.command_line like "*_ 192.168.*" or process.command_line like "*_ 172.16.*" or process.command_line like "*_ 172.17.*" or process.command_line like "*_ 172.18.*" or process.command_line like "*_ 172.19.*" or process.command_line like "*_ 172.20.*" or process.command_line like "*_ 172.21.*" or process.command_line like "*_ 172.22.*" or process.command_line like "*_ 172.23.*" or process.command_line like "*_ 172.24.*" or process.command_line like "*_ 172.25.*" or process.command_line like "*_ 172.26.*" or process.command_line like "*_ 172.27.*" or process.command_line like "*_ 172.28.*" or process.command_line like "*_ 172.29.*" or process.command_line like "*_ 172.30.*" or process.command_line like "*_ 172.31.*" or process.command_line like "*_ 127.*" or process.command_line like "*_ 169.254.*")))
