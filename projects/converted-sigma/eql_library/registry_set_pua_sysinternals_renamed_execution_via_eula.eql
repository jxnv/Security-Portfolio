// Title: Suspicious Execution Of Renamed Sysinternals Tools - Registry
// ID: f50f3c09-557d-492d-81db-9064a8d4e211
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-24
// Tags: attack.resource-development, attack.t1588.002
// Description: Detects the creation of the "accepteula" key related to the Sysinternals tools being created from executables with the wrong name (e.g. a renamed Sysinternals tool)
// Converted by: Sigma Universal SIEM/EDR CLI

registry where (((registry.path like "*_\\Active Directory Explorer*" or registry.path like "*_\\Handle*" or registry.path like "*_\\LiveKd*" or registry.path like "*_\\ProcDump*" or registry.path like "*_\\Process Explorer*" or registry.path like "*_\\PsExec*" or registry.path like "*_\\PsLoggedon*" or registry.path like "*_\\PsLoglist*" or registry.path like "*_\\PsPasswd*" or registry.path like "*_\\PsPing*" or registry.path like "*_\\PsService*" or registry.path like "*_\\SDelete*") and registry.path endswith "\\EulaAccepted") and not (((process.executable endswith "\\ADExplorer.exe" or process.executable endswith "\\ADExplorer64.exe" or process.executable endswith "\\ADExplorer64a.exe" or process.executable endswith "\\handle.exe" or process.executable endswith "\\handle64.exe" or process.executable endswith "\\handle64a.exe" or process.executable endswith "\\livekd.exe" or process.executable endswith "\\livekd64.exe" or process.executable endswith "\\procdump.exe" or process.executable endswith "\\procdump64.exe" or process.executable endswith "\\procdump64a.exe" or process.executable endswith "\\procexp.exe" or process.executable endswith "\\procexp64.exe" or process.executable endswith "\\procexp64a.exe" or process.executable endswith "\\PsExec.exe" or process.executable endswith "\\PsExec64.exe" or process.executable endswith "\\PsExec64a.exe" or process.executable endswith "\\PsLoggedon.exe" or process.executable endswith "\\PsLoggedon64.exe" or process.executable endswith "\\psloglist.exe" or process.executable endswith "\\psloglist64.exe" or process.executable endswith "\\psloglist64a.exe" or process.executable endswith "\\pspasswd.exe" or process.executable endswith "\\pspasswd64.exe" or process.executable endswith "\\pspasswd64a.exe" or process.executable endswith "\\PsPing.exe" or process.executable endswith "\\PsPing64.exe" or process.executable endswith "\\PsPing64a.exe" or process.executable endswith "\\PsService.exe" or process.executable endswith "\\PsService64.exe" or process.executable endswith "\\PsService64a.exe" or process.executable endswith "\\sdelete.exe"))))
