// Title: PowerShell Base64 Encoded IEX Cmdlet
// ID: 88f680b8-070e-402c-ae11-d2914f2257f1
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2019-08-23
// Tags: attack.execution, attack.t1059.001
// Description: Detects usage of a base64 encoded "IEX" cmdlet in a process command line
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_SUVYIChb*" or process.command_line like "*_lFWCAoW*" or process.command_line like "*_JRVggKF*" or process.command_line like "*_aWV4IChb*" or process.command_line like "*_lleCAoW*" or process.command_line like "*_pZXggKF*" or process.command_line like "*_aWV4IChOZX*" or process.command_line like "*_lleCAoTmV3*" or process.command_line like "*_pZXggKE5ld*" or process.command_line like "*_SUVYIChOZX*" or process.command_line like "*_lFWCAoTmV3*" or process.command_line like "*_JRVggKE5ld*" or process.command_line like "*_SUVYKF*" or process.command_line like "*_lFWChb*" or process.command_line like "*_JRVgoW*" or process.command_line like "*_aWV4KF*" or process.command_line like "*_lleChb*" or process.command_line like "*_pZXgoW*" or process.command_line like "*_aWV4KE5ld*" or process.command_line like "*_lleChOZX*" or process.command_line like "*_pZXgoTmV3*" or process.command_line like "*_SUVYKE5ld*" or process.command_line like "*_lFWChOZX*" or process.command_line like "*_JRVgoTmV3*" or process.command_line like "*_SUVYKCgn*" or process.command_line like "*_lFWCgoJ*" or process.command_line like "*_JRVgoKC*" or process.command_line like "*_aWV4KCgn*" or process.command_line like "*_lleCgoJ*" or process.command_line like "*_pZXgoKC*")) or ((process.command_line like "*_SQBFAFgAIAAoAFsA*" or process.command_line like "*_kARQBYACAAKABbA*" or process.command_line like "*_JAEUAWAAgACgAWw*" or process.command_line like "*_aQBlAHgAIAAoAFsA*" or process.command_line like "*_kAZQB4ACAAKABbA*" or process.command_line like "*_pAGUAeAAgACgAWw*" or process.command_line like "*_aQBlAHgAIAAoAE4AZQB3A*" or process.command_line like "*_kAZQB4ACAAKABOAGUAdw*" or process.command_line like "*_pAGUAeAAgACgATgBlAHcA*" or process.command_line like "*_SQBFAFgAIAAoAE4AZQB3A*" or process.command_line like "*_kARQBYACAAKABOAGUAdw*" or process.command_line like "*_JAEUAWAAgACgATgBlAHcA*")))
