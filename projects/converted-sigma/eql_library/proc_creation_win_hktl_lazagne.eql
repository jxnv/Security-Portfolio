// Title: HackTool - LaZagne Execution
// ID: c2b86e67-b880-4eec-b045-50bc98ef4844
// Status: experimental
// Level: medium
// Author: Nasreddine Bencherchali, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.credential-access
// Description: Detects the execution of the LaZagne. A utility used to retrieve multiple types of passwords stored on a local computer.
// LaZagne has been leveraged multiple times by threat actors in order to dump credentials.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.executable like "*_:\\PerfLogs\\*" or process.executable like "*_:\\ProgramData\\*" or process.executable like "*_:\\Temp\\*" or process.executable like "*_:\\Tmp\\*" or process.executable like "*_:\\Users\\Public\\*" or process.executable like "*_:\\Windows\\Temp\\*" or process.executable like "*_\\$Recycle.bin*" or process.executable like "*_\\AppData\\*" or process.executable like "*_\\Desktop\\*" or process.executable like "*_\\Downloads\\*" or process.executable like "*_\\Favorites\\*" or process.executable like "*_\\Links\\*" or process.executable like "*_\\Music\\*" or process.executable like "*_\\Photos\\*" or process.executable like "*_\\Pictures\\*" or process.executable like "*_\\Saved Games\\*" or process.executable like "*_\\Searches\\*" or process.executable like "*_\\Users\\Contacts\\*" or process.executable like "*_\\Users\\Default\\*" or process.executable like "*_\\Users\\Searches\\*" or process.executable like "*_\\Videos\\*" or process.executable like "*_\\Windows\\addins\\*" or process.executable like "*_\\Windows\\Fonts\\*" or process.executable like "*_\\Windows\\IME\\*") and (process.command_line endswith ".exe all" or process.command_line endswith ".exe browsers" or process.command_line endswith ".exe chats" or process.command_line endswith ".exe databases" or process.command_line endswith ".exe games" or process.command_line endswith ".exe git" or process.command_line endswith ".exe mails" or process.command_line endswith ".exe maven" or process.command_line endswith ".exe memory" or process.command_line endswith ".exe multimedia" or process.command_line endswith ".exe sysadmin" or process.command_line endswith ".exe unused" or process.command_line endswith ".exe wifi" or process.command_line endswith ".exe windows")) or (process.executable endswith "\\lazagne.exe")) or (((process.command_line like "*_ all *" or process.command_line like "*_ browsers *" or process.command_line like "*_ chats *" or process.command_line like "*_ databases *" or process.command_line like "*_ games *" or process.command_line like "*_ mails *" or process.command_line like "*_ maven *" or process.command_line like "*_ memory *" or process.command_line like "*_ multimedia *" or process.command_line like "*_ php *" or process.command_line like "*_ svn *" or process.command_line like "*_ sysadmin *" or process.command_line like "*_ unused *" or process.command_line like "*_ wifi *")) and ((process.command_line like "*_-1Password*" or process.command_line like "*_-apachedirectorystudio*" or process.command_line like "*_-autologon*" or process.command_line like "*_-ChromiumBased*" or process.command_line like "*_-coreftp*" or process.command_line like "*_-credfiles*" or process.command_line like "*_-credman*" or process.command_line like "*_-cyberduck*" or process.command_line like "*_-dbvis*" or process.command_line like "*_-EyeCon*" or process.command_line like "*_-filezilla*" or process.command_line like "*_-filezillaserver*" or process.command_line like "*_-ftpnavigator*" or process.command_line like "*_-galconfusion*" or process.command_line like "*_-gitforwindows*" or process.command_line like "*_-hashdump*" or process.command_line like "*_-iisapppool*" or process.command_line like "*_-IISCentralCertP*" or process.command_line like "*_-kalypsomedia*" or process.command_line like "*_-keepass*" or process.command_line like "*_-keepassconfig*" or process.command_line like "*_-lsa_secrets*" or process.command_line like "*_-mavenrepositories*" or process.command_line like "*_-memory_dump*" or process.command_line like "*_-Mozilla*" or process.command_line like "*_-mRemoteNG*" or process.command_line like "*_-mscache*" or process.command_line like "*_-opensshforwindows*" or process.command_line like "*_-openvpn*" or process.command_line like "*_-outlook*" or process.command_line like "*_-pidgin*" or process.command_line like "*_-postgresql*" or process.command_line like "*_-psi-im*" or process.command_line like "*_-puttycm*" or process.command_line like "*_-pypykatz*" or process.command_line like "*_-Rclone*" or process.command_line like "*_-rdpmanager*" or process.command_line like "*_-robomongo*" or process.command_line like "*_-roguestale*" or process.command_line like "*_-skype*" or process.command_line like "*_-SQLDeveloper*" or process.command_line like "*_-squirrel*" or process.command_line like "*_-tortoise*" or process.command_line like "*_-turba*" or process.command_line like "*_-UCBrowser*" or process.command_line like "*_-unattended*" or process.command_line like "*_-vault*" or process.command_line like "*_-vaultfiles*" or process.command_line like "*_-vnc*" or process.command_line like "*_-winscp*"))))
