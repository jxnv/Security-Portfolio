// Title: Potentially Suspicious GoogleUpdate Child Process
// ID: 84b1ecf9-6eff-4004-bafb-bae5c0e251b2
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-15
// Tags: attack.stealth
// Description: Detects potentially suspicious child processes of "GoogleUpdate.exe"
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.parent.executable endswith "\\GoogleUpdate.exe") and not (((process.executable == null) or ((process.executable like "*_\\Google*") or ((process.executable endswith "\\setup.exe" or process.executable endswith "chrome_updater.exe" or process.executable endswith "chrome_installer.exe"))))))
