// Title: Potentially Suspicious Network Connection To Notion API
// ID: 7e9cf7b6-e827-11ed-a05b-15959c120003
// Status: test
// Level: low
// Author: Gavin Knapp
// Date: 2023-05-03
// Tags: attack.command-and-control, attack.t1102
// Description: Detects a non-browser process communicating with the Notion API. This could indicate potential use of a covert C2 channel such as "OffensiveNotion C2"
// Converted by: Sigma Universal SIEM/EDR CLI

network where ((DestinationHostname like "*_api.notion.com*") and not (((process.executable endswith "\\brave.exe") or ((process.executable == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or process.executable == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or ((process.executable startswith "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") or (process.executable endswith "\\WindowsApps\\MicrosoftEdge.exe") or ((process.executable == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or process.executable == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((process.executable startswith "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" or process.executable startswith "C:\\Program Files\\Microsoft\\EdgeCore\\") and (process.executable endswith "\\msedge.exe" or process.executable endswith "\\msedgewebview2.exe")) or ((process.executable == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or process.executable == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or ((process.executable == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or process.executable == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (process.executable endswith "\\maxthon.exe") or (process.executable endswith "\\AppData\\Local\\Programs\\Notion\\Notion.exe") or (process.executable endswith "\\opera.exe") or (process.executable endswith "\\safari.exe") or (process.executable endswith "\\seamonkey.exe") or (process.executable endswith "\\vivaldi.exe") or (process.executable endswith "\\whale.exe"))))
