// Title: Registry Export of Third-Party Credentials
// ID: cc1abf27-78a3-4ac5-a51c-f3070b1d8e40
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-05-22
// Tags: attack.credential-access, attack.t1552.002
// Description: Detects the use of reg.exe to export registry paths associated with third-party credentials.
// Credential stealers have been known to use this technique to extract sensitive information from the registry.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_\\Software\\Aerofox\\Foxmail\\V3.1*" or process.command_line like "*_\\Software\\Aerofox\\FoxmailPreview*" or process.command_line like "*_\\Software\\DownloadManager\\Passwords*" or process.command_line like "*_\\Software\\FTPWare\\COREFTP\\Sites*" or process.command_line like "*_\\Software\\IncrediMail\\Identities*" or process.command_line like "*_\\Software\\Martin Prikryl\\WinSCP 2\\Sessions*" or process.command_line like "*_\\Software\\Mobatek\\MobaXterm*" or process.command_line like "*_\\Software\\OpenSSH\\Agent\\Keys*" or process.command_line like "*_\\Software\\OpenVPN-GUI\\configs*" or process.command_line like "*_\\Software\\ORL\\WinVNC3\\Password*" or process.command_line like "*_\\Software\\Qualcomm\\Eudora\\CommandLine*" or process.command_line like "*_\\Software\\RealVNC\\WinVNC4*" or process.command_line like "*_\\Software\\RimArts\\B2\\Settings*" or process.command_line like "*_\\Software\\SimonTatham\\PuTTY\\Sessions*" or process.command_line like "*_\\Software\\SimonTatham\\PuTTY\\SshHostKeys*" or process.command_line like "*_\\Software\\Sota\\FFFTP*" or process.command_line like "*_\\Software\\TightVNC\\Server*" or process.command_line like "*_\\Software\\WOW6432Node\\Radmin\\v3.0\\Server\\Parameters\\Radmin*")) and ((process.command_line like "*_save*" or process.command_line like "*_export*")) and ((process.executable endswith "\\reg.exe") or (process.pe.original_file_name == "reg.exe")))
