// Title: Suspicious Autorun Registry Modified via WMI
// ID: c80e66d8-1780-48a9-b412-46663fd21ac0
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-02-17
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1547.001, attack.t1047
// Description: Detects suspicious activity where the WMIC process is used to create an autorun registry entry via reg.exe, which is often indicative of persistence mechanisms employed by malware.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.command_line like "*_reg*" and process.command_line like "*_ add *") and (process.command_line like "*_\\Software\\Microsoft\\Windows\\CurrentVersion\\Run*" or process.command_line like "*_\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run*" or process.command_line like "*_\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\Run*")) and ((process.executable endswith "\\wmic.exe") or (process.pe.original_file_name == "wmic.exe") or (process.parent.executable endswith "\\wmiprvse.exe"))) and (((process.command_line like "*_:\\Perflogs*" or process.command_line like "*_:\\ProgramData'*" or process.command_line like "*_:\\Windows\\Temp*" or process.command_line like "*_:\\Temp*" or process.command_line like "*_\\AppData\\Local\\Temp*" or process.command_line like "*_\\AppData\\Roaming*" or process.command_line like "*_:\\$Recycle.bin*" or process.command_line like "*_:\\Users\\Default*" or process.command_line like "*_:\\Users\\public*" or process.command_line like "*_%temp%*" or process.command_line like "*_%tmp%*" or process.command_line like "*_%Public%*" or process.command_line like "*_%AppData%*")) or ((process.command_line like "*_:\\Users\\*") and ((process.command_line like "*_\\Favorites*" or process.command_line like "*_\\Favourites*" or process.command_line like "*_\\Contacts*" or process.command_line like "*_\\Music*" or process.command_line like "*_\\Pictures*" or process.command_line like "*_\\Documents*" or process.command_line like "*_\\Photos*")))))
