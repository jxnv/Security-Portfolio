// Title: Potentially Suspicious WDAC Policy File Creation
// ID: 1d2de8a6-4803-4fde-b85b-f58f3aa7a705
// Status: experimental
// Level: medium
// Author: X__Junior
// Date: 2025-02-07
// Tags: attack.defense-impairment
// Description: Detects suspicious Windows Defender Application Control (WDAC) policy file creation from abnormal processes that could be abused by attacker to block EDR/AV components while allowing their own malicious code to run on the system.
// Converted by: Sigma Universal SIEM/EDR CLI

file where ((file.path like "*_\\Windows\\System32\\CodeIntegrity\\*") and not (((((process.command_line like "*_ConvertFrom-CIPolicy -XmlFilePath*" and process.command_line like "*_-BinaryFilePath *")) or (process.command_line like "*_CiTool --update-policy*") or ((process.command_line like "*_Copy-Item -Path*" and process.command_line like "*_-Destination*"))) or ((process.executable endswith "\\Microsoft.ConfigurationManagement.exe" or process.executable endswith "\\WDAC Wizard.exe" or process.executable endswith "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" or process.executable endswith "C:\\Program Files\\PowerShell\\7\\pwsh.exe" or process.executable endswith "C:\\Windows\\System32\\dllhost.exe" or process.executable endswith "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or process.executable endswith "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" or process.executable endswith "C:\\Windows\\SysWOW64\\dllhost.exe" or process.executable endswith "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or process.executable endswith "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")) or (process.executable == "System") or (process.executable == "C:\\Windows\\System32\\wuauclt.exe") or ((process.executable == "C:\\Windows\\UUS\\arm64\\wuaucltcore.exe" or process.executable == "C:\\Windows\\UUS\\Packages\\Preview\\arm64\\wuaucltcore.exe")))))
