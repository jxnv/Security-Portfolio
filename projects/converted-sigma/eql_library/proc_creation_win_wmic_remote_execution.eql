// Title: WMIC Remote Command Execution
// ID: 7773b877-5abb-4a3e-b9c9-fd0369b59b00
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-14
// Tags: attack.execution, attack.t1047
// Description: Detects the execution of WMIC to query information on a remote system
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.command_line like "*_/node:*" or process.command_line like "*_-node:*")) and ((process.executable endswith "\\WMIC.exe") or (process.pe.original_file_name == "wmic.exe"))) and not (((process.command_line like "*_localhost*" or process.command_line like "*_127.0.0.1*"))))
