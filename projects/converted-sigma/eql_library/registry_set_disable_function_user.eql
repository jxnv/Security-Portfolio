// Title: Disable Internal Tools or Feature in Registry
// ID: e2482f8d-3443-4237-b906-cc145d87a076
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems), CrimpSec
// Date: 2022-03-18
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects registry modifications that change features of internal Windows tools (malware like Agent Tesla uses this technique)
// Converted by: Sigma Universal SIEM/EDR CLI

registry where (((registry.path endswith "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\ConsentPromptBehaviorAdmin" or registry.path endswith "Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\InactivityTimeoutSecs" or registry.path endswith "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\shutdownwithoutlogon" or registry.path endswith "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\PushNotifications\\ToastEnabled" or registry.path endswith "SYSTEM\\CurrentControlSet\\Control\\Storage\\Write Protection" or registry.path endswith "SYSTEM\\CurrentControlSet\\Control\\StorageDevicePolicies\\WriteProtect") and registry.data.strings == "DWORD (0x00000000)") or ((registry.path endswith "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\DisableCMD" or registry.path endswith "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\NoControlPanel" or registry.path endswith "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\NoRun" or registry.path endswith "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\StartMenuLogOff" or registry.path endswith "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\DisableChangePassword" or registry.path endswith "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\DisableLockWorkstation" or registry.path endswith "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\DisableRegistryTools" or registry.path endswith "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\DisableTaskmgr" or registry.path endswith "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\NoDispBackgroundPage" or registry.path endswith "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\NoDispCPL" or registry.path endswith "SOFTWARE\\Policies\\Microsoft\\Windows\\Explorer\\DisableNotificationCenter" or registry.path endswith "SOFTWARE\\Policies\\Microsoft\\Windows\\System\\DisableCMD") and registry.data.strings == "DWORD (0x00000001)"))
