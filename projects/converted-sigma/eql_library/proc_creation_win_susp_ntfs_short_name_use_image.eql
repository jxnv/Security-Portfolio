// Title: Use NTFS Short Name in Image
// ID: 3ef5605c-9eb9-47b0-9a71-b727e6aa5c3b
// Status: test
// Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-06
// Tags: attack.stealth, attack.t1564.004
// Description: Detect use of the Windows 8.3 short name. Which could be used as a method to avoid Image based detection
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.executable like "*_~1.bat*" or process.executable like "*_~1.dll*" or process.executable like "*_~1.exe*" or process.executable like "*_~1.hta*" or process.executable like "*_~1.js*" or process.executable like "*_~1.msi*" or process.executable like "*_~1.ps1*" or process.executable like "*_~1.tmp*" or process.executable like "*_~1.vbe*" or process.executable like "*_~1.vbs*" or process.executable like "*_~2.bat*" or process.executable like "*_~2.dll*" or process.executable like "*_~2.exe*" or process.executable like "*_~2.hta*" or process.executable like "*_~2.js*" or process.executable like "*_~2.msi*" or process.executable like "*_~2.ps1*" or process.executable like "*_~2.tmp*" or process.executable like "*_~2.vbe*" or process.executable like "*_~2.vbs*")) and not ((process.parent.executable == "C:\\Windows\\explorer.exe")) and not (((process.parent.executable endswith "\\thor\\thor64.exe") or (process.executable endswith "\\VCREDI~1.EXE") or (process.parent.executable endswith "\\WebEx\\WebexHost.exe") or (process.executable == "C:\\PROGRA~1\\WinZip\\WZPREL~1.EXE"))))
