// Title: Python Inline Command Execution
// ID: 899133d5-4d7c-4a7f-94ee-27355c879d90
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-02
// Tags: attack.execution, attack.t1059
// Description: Detects execution of python using the "-c" flag. This is could be used as a way to launch a reverse shell or execute live python code.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_ -c*") and ((process.pe.original_file_name == "python.exe") or ((process.executable endswith "python.exe" or process.executable endswith "python3.exe" or process.executable endswith "python2.exe")))) and not ((((process.parent.executable startswith "C:\\Program Files\\Python" or process.parent.executable startswith "C:\\Program Files (x86)\\Python") and process.parent.executable endswith "\\python.exe" and process.parent.command_line like "*_-E -s -m ensurepip -U --default-pip*") or ((process.parent.executable startswith "C:\\Program Files\\Python" or process.parent.executable startswith "C:\\Program Files (x86)\\Python") and (process.command_line like "*_-W ignore::DeprecationWarning*" and process.command_line like "*_['install', '--no-cache-dir', '--no-index', '--find-links',*" and process.command_line like "*_'--upgrade', 'pip'*")))) and not ((((process.command_line like "*_<pip-setuptools-caller>*" and process.command_line like "*_exec(compile(*")) or ((process.parent.executable endswith "\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe") or ((process.parent.executable == "C:\\Program Files\\Microsoft VS Code\\Code.exe" or process.parent.executable == "C:\\Program Files (x86)\\Microsoft VS Code\\Code.exe"))))))
