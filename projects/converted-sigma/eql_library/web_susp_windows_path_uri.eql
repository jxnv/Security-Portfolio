// Title: Suspicious Windows Strings In URI
// ID: 9f6a34b4-2688-4eb7-a7f5-e39fef573d0e
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-06
// Tags: attack.persistence, attack.exfiltration, attack.t1505.003
// Description: Detects suspicious Windows strings in URI which could indicate possible exfiltration or webshell communication
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((cs-uri-query like "*_=C:/Users*" or cs-uri-query like "*_=C:/Program%20Files*" or cs-uri-query like "*_=C:/Windows*" or cs-uri-query like "*_=C%3A%5CUsers*" or cs-uri-query like "*_=C%3A%5CProgram%20Files*" or cs-uri-query like "*_=C%3A%5CWindows*"))
