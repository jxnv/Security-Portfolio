// Title: SQLite Chromium Profile Data DB Access
// ID: 24c77512-782b-448a-8950-eddb0785fc71
// Status: test
// Level: high
// Author: TropChaud
// Date: 2022-12-19
// Tags: attack.credential-access, attack.t1539, attack.t1555.003, attack.collection, attack.t1005
// Description: Detect usage of the "sqlite" binary to query databases in Chromium-based browsers for potential data stealing.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_\\User Data\\*" or process.command_line like "*_\\Opera Software\\*" or process.command_line like "*_\\ChromiumViewer\\*")) and ((process.command_line like "*_Login Data*" or process.command_line like "*_Cookies*" or process.command_line like "*_Web Data*" or process.command_line like "*_History*" or process.command_line like "*_Bookmarks*")) and ((Product == "SQLite") or ((process.executable endswith "\\sqlite.exe" or process.executable endswith "\\sqlite3.exe"))))
