// Title: Potentially Suspicious File Download From ZIP TLD
// ID: 0bb4bbeb-fe52-4044-b40c-430a04577ebe
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2023-05-18
// Tags: attack.stealth
// Description: Detects the download of a file with a potentially suspicious extension from a .zip top level domain.
// Converted by: Sigma Universal SIEM/EDR CLI

any where (Contents like "*_.zip/*" and (file.path like "*_.bat:Zone*" or file.path like "*_.dat:Zone*" or file.path like "*_.dll:Zone*" or file.path like "*_.doc:Zone*" or file.path like "*_.docm:Zone*" or file.path like "*_.exe:Zone*" or file.path like "*_.hta:Zone*" or file.path like "*_.pptm:Zone*" or file.path like "*_.ps1:Zone*" or file.path like "*_.rar:Zone*" or file.path like "*_.rtf:Zone*" or file.path like "*_.sct:Zone*" or file.path like "*_.vbe:Zone*" or file.path like "*_.vbs:Zone*" or file.path like "*_.ws:Zone*" or file.path like "*_.wsf:Zone*" or file.path like "*_.xll:Zone*" or file.path like "*_.xls:Zone*" or file.path like "*_.xlsm:Zone*" or file.path like "*_.zip:Zone*"))
