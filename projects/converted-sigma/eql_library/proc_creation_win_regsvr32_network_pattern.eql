// Title: Potentially Suspicious Regsvr32 HTTP/FTP Pattern
// ID: 867356ee-9352-41c9-a8f2-1be690d78216
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2023-05-24
// Tags: attack.stealth, attack.t1218.010
// Description: Detects regsvr32 execution to download/install/register new DLLs that are hosted on Web or FTP servers.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_ /i*" or process.command_line like "*_ -i*")) and ((process.executable endswith "\\regsvr32.exe") or (process.pe.original_file_name == "REGSVR32.EXE")) and ((process.command_line like "*_ftp*" or process.command_line like "*_http*")))
