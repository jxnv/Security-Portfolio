// Title: ADFS Database Named Pipe Connection By Uncommon Tool
// ID: 1ea13e8c-03ea-409b-877d-ce5c3d2c1cb3
// Status: test
// Level: medium
// Author: Roberto Rodriguez @Cyb3rWard0g
// Date: 2021-10-08
// Tags: attack.collection, attack.t1005
// Description: Detects suspicious local connections via a named pipe to the AD FS configuration database (Windows Internal Database).
// Used to access information such as the AD FS configuration settings which contains sensitive information used to sign SAML tokens.
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((PipeName == "\\MICROSOFT##WID\\tsql\\query") and not (((process.executable endswith ":\\Windows\\System32\\mmc.exe" or process.executable endswith ":\\Windows\\system32\\svchost.exe" or process.executable endswith ":\\Windows\\System32\\wsmprovhost.exe" or process.executable endswith ":\\Windows\\SysWOW64\\mmc.exe" or process.executable endswith ":\\Windows\\SysWOW64\\wsmprovhost.exe" or process.executable endswith ":\\Windows\\WID\\Binn\\sqlwriter.exe" or process.executable endswith "\\AzureADConnect.exe" or process.executable endswith "\\Microsoft.Identity.Health.Adfs.PshSurrogate.exe" or process.executable endswith "\\Microsoft.IdentityServer.ServiceHost.exe" or process.executable endswith "\\Microsoft.Tri.Sensor.exe" or process.executable endswith "\\sqlservr.exe" or process.executable endswith "\\tssdis.exe"))))
