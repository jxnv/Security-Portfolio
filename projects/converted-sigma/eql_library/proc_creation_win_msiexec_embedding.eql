// Title: Suspicious MsiExec Embedding Parent
// ID: 4a2a2c3e-209f-4d01-b513-4155a540b469
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-04-16
// Tags: attack.stealth, attack.t1218.007
// Description: Adversaries may abuse msiexec.exe to proxy the execution of malicious payloads
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe" or process.executable endswith "\\cmd.exe") and (process.parent.command_line like "*_MsiExec.exe*" and process.parent.command_line like "*_-Embedding *")) and not (((process.executable endswith ":\\Windows\\System32\\cmd.exe" and process.command_line like "*_C:\\Program Files\\SplunkUniversalForwarder\\bin\\*") or ((process.command_line like "*_\\DismFoDInstall.cmd*") or ((process.parent.command_line like "*_\\MsiExec.exe -Embedding *" and process.parent.command_line like "*_Global\\MSI0000*"))))))
