// Title: HackTool Service Registration or Execution
// ID: d26ce60c-2151-403c-9a42-49420d87b5e4
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-21
// Tags: attack.execution, attack.t1569.002, attack.s0029
// Description: Detects installation or execution of services
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((winlog.provider_name == "Service Control Manager" and (winlog.event_id == 7045 or winlog.event_id == 7036)) and ((ImagePath like "*_bypass*") or ((ServiceName like "*_cachedump*" or ServiceName like "*_DumpSvc*" or ServiceName like "*_gsecdump*" or ServiceName like "*_pwdump*" or ServiceName like "*_UACBypassedService*" or ServiceName like "*_WCE SERVICE*" or ServiceName like "*_WCESERVICE*" or ServiceName like "*_winexesvc*"))))
