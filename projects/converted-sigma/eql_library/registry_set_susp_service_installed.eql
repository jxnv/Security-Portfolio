// Title: Suspicious Service Installed
// ID: f2485272-a156-4773-82d7-1d178bc4905b
// Status: test
// Level: medium
// Author: xknow (@xknow_infosec), xorxes (@xor_xes)
// Date: 2019-04-08
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects installation of NalDrv or PROCEXP152 services via registry-keys to non-system32 folders.
// Both services are used in the tool Ghost-In-The-Logs (https://github.com/bats3c/Ghost-In-The-Logs), which uses KDU (https://github.com/hfiref0x/KDU)
// Converted by: Sigma Universal SIEM/EDR CLI

registry where (((registry.path == "HKLM\\System\\CurrentControlSet\\Services\\NalDrv\\ImagePath" or registry.path == "HKLM\\System\\CurrentControlSet\\Services\\PROCEXP152\\ImagePath")) and not (((process.executable endswith "\\procexp64.exe" or process.executable endswith "\\procexp64a.exe" or process.executable endswith "\\procexp.exe" or process.executable endswith "\\procmon64.exe" or process.executable endswith "\\procmon64a.exe" or process.executable endswith "\\procmon.exe" or process.executable endswith "\\handle.exe" or process.executable endswith "\\handle64.exe" or process.executable endswith "\\handle64a.exe") and registry.data.strings like "*_\\WINDOWS\\system32\\Drivers\\PROCEXP152.SYS*")))
