// Title: UAC Bypass via ICMLuaUtil
// ID: 49f2f17b-b4c8-4172-a68b-d5bf95d05130
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Elastic (idea)
// Date: 2022-09-13
// Tags: attack.privilege-escalation, attack.t1548.002
// Description: Detects the pattern of UAC Bypass using ICMLuaUtil Elevated COM interface
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.parent.executable endswith "\\dllhost.exe" and (process.parent.command_line like "*_/Processid:{3E5FC7F9-9A51-4367-9063-A120244FBEC7}*" or process.parent.command_line like "*_/Processid:{D2E7041B-2927-42FB-8E9F-7CE93B6DC937}*")) and not (((process.executable endswith "\\WerFault.exe") or (process.pe.original_file_name == "WerFault.exe"))))
