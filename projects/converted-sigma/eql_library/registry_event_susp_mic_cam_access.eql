// Title: Suspicious Camera and Microphone Access
// ID: 62120148-6b7a-42be-8b91-271c04e281a3
// Status: test
// Level: high
// Author: Den Iuzvyk
// Date: 2020-06-07
// Tags: attack.collection, attack.t1125, attack.t1123
// Description: Detects Processes accessing the camera and microphone from suspicious folder
// Converted by: Sigma Universal SIEM/EDR CLI

registry where (((registry.path like "*_\\Software\\Microsoft\\Windows\\CurrentVersion\\CapabilityAccessManager\\ConsentStore\\*" and registry.path like "*_\\NonPackaged*")) and ((registry.path like "*_microphone*" or registry.path like "*_webcam*")) and ((registry.path like "*_:#Windows#Temp#*" or registry.path like "*_:#$Recycle.bin#*" or registry.path like "*_:#Temp#*" or registry.path like "*_:#Users#Public#*" or registry.path like "*_:#Users#Default#*" or registry.path like "*_:#Users#Desktop#*")))
