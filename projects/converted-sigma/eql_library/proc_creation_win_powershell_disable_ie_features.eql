// Title: Disabled IE Security Features
// ID: fb50eb7a-5ab1-43ae-bcc9-091818cb8424
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2020-06-19
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects command lines that indicate unwanted modifications to registry keys that disable important Internet Explorer security features
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_ -name IEHarden *" and process.command_line like "*_ -value 0 *")) or ((process.command_line like "*_ -name DEPOff *" and process.command_line like "*_ -value 1 *")) or ((process.command_line like "*_ -name DisableFirstRunCustomize *" and process.command_line like "*_ -value 2 *")))
