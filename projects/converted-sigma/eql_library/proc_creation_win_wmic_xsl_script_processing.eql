// Title: XSL Script Execution Via WMIC.EXE
// ID: 05c36dd6-79d6-4a9a-97da-3db20298ab2d
// Status: test
// Level: medium
// Author: Timur Zinniatullin, oscd.community, Swachchhanda Shrawan Poudel
// Date: 2019-10-21
// Tags: attack.stealth, attack.t1047, attack.t1220, attack.execution, attack.t1059.005, attack.t1059.007
// Description: Detects the execution of WMIC with the "format" flag to potentially load local XSL files.
// Adversaries abuse this functionality to execute arbitrary files while potentially bypassing application whitelisting defenses.
// Extensible Stylesheet Language (XSL) files are commonly used to describe the processing and rendering of data within XML files.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.command_line like "*_-format:*" or process.command_line like "*_/format:*")) and ((process.executable endswith "\\wmic.exe") or (process.pe.original_file_name == "wmic.exe") or ((Hashes like "*_IMPHASH=1B1A3F43BF37B5BFE60751F2EE2F326E*" or Hashes like "*_IMPHASH=37777A96245A3C74EB217308F3546F4C*" or Hashes like "*_IMPHASH=9D87C9D67CE724033C0B40CC4CA1B206*" or Hashes like "*_IMPHASH=B12619881D79C3ACADF45E752A58554A*" or Hashes like "*_IMPHASH=16A48C3CABF98A9DC1BF02C07FE1EA00*")))) and not ((((process.command_line like "*_Format:List*" or process.command_line like "*_Format:htable*" or process.command_line like "*_Format:hform*" or process.command_line like "*_Format:table*" or process.command_line like "*_Format:mof*" or process.command_line like "*_Format:value*" or process.command_line like "*_Format:rawxml*" or process.command_line like "*_Format:xml*" or process.command_line like "*_Format:csv*")) or ((process.command_line like "*_://*" or process.command_line like "*_\\\\\\\\*")))))
