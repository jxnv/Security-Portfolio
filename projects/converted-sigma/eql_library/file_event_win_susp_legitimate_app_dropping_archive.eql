// Title: Legitimate Application Dropped Archive
// ID: 654fcc6d-840d-4844-9b07-2c3300e54a26
// Status: test
// Level: high
// Author: frack113, Florian Roth
// Date: 2022-08-21
// Tags: attack.stealth, attack.t1218
// Description: Detects programs on a Windows system that should not write an archive to disk
// Converted by: Sigma Universal SIEM/EDR CLI

file where ((process.executable endswith "\\winword.exe" or process.executable endswith "\\excel.exe" or process.executable endswith "\\powerpnt.exe" or process.executable endswith "\\msaccess.exe" or process.executable endswith "\\mspub.exe" or process.executable endswith "\\eqnedt32.exe" or process.executable endswith "\\visio.exe" or process.executable endswith "\\wordpad.exe" or process.executable endswith "\\wordview.exe" or process.executable endswith "\\certutil.exe" or process.executable endswith "\\certoc.exe" or process.executable endswith "\\CertReq.exe" or process.executable endswith "\\Desktopimgdownldr.exe" or process.executable endswith "\\esentutl.exe" or process.executable endswith "\\finger.exe" or process.executable endswith "\\notepad.exe" or process.executable endswith "\\AcroRd32.exe" or process.executable endswith "\\RdrCEF.exe" or process.executable endswith "\\mshta.exe" or process.executable endswith "\\hh.exe") and (file.path endswith ".zip" or file.path endswith ".rar" or file.path endswith ".7z" or file.path endswith ".diagcab" or file.path endswith ".appx"))
