// Title: Suspicious Network Connection Binary No CommandLine
// ID: 20384606-a124-4fec-acbb-8bd373728613
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-07-03
// Tags: attack.stealth
// Description: Detects suspicious network connections made by a well-known Windows binary run with no command line parameters
// Converted by: Sigma Universal SIEM/EDR CLI

network where ((Initiated == "true" and (process.executable endswith "\\regsvr32.exe" or process.executable endswith "\\rundll32.exe" or process.executable endswith "\\dllhost.exe") and (process.command_line endswith "\\regsvr32.exe" or process.command_line endswith "\\rundll32.exe" or process.command_line endswith "\\dllhost.exe")) and not (((process.command_line == "") or (process.command_line == null))))
