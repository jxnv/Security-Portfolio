// Title: PowerShell Module File Created By Non-PowerShell Process
// ID: e3845023-ca9a-4024-b2b2-5422156d5527
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-09
// Tags: attack.persistence
// Description: Detects the creation of a new PowerShell module ".psm1", ".psd1", ".dll", ".ps1", etc. by a non-PowerShell process
// Converted by: Sigma Universal SIEM/EDR CLI

file where (((file.path like "*_\\WindowsPowerShell\\Modules\\*" or file.path like "*_\\PowerShell\\7\\Modules\\*")) and not ((((process.executable == "C:\\Windows\\System32\\msiexec.exe" or process.executable == "C:\\Windows\\SysWOW64\\msiexec.exe")) or ((process.executable endswith ":\\Program Files\\PowerShell\\7-preview\\pwsh.exe" or process.executable endswith ":\\Program Files\\PowerShell\\7\\pwsh.exe" or process.executable endswith ":\\Windows\\System32\\poqexec.exe" or process.executable endswith ":\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or process.executable endswith ":\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" or process.executable endswith ":\\Windows\\SysWOW64\\poqexec.exe" or process.executable endswith ":\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or process.executable endswith ":\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")))))
