// Description: Detects wmiexec/dcomexec/atexec/smbexec from Impacket framework
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.parent.command_line like "*_svchost.exe -k netsvcs*" or process.parent.command_line like "*_taskeng.exe*") and (process.command_line like "*_cmd.exe*" and process.command_line like "*_/C*" and process.command_line like "*_Windows\\Temp\\*" and process.command_line like "*_&1*")) or ((process.parent.executable endswith "\\wmiprvse.exe" or process.parent.executable endswith "\\mmc.exe" or process.parent.executable endswith "\\explorer.exe" or process.parent.executable endswith "\\services.exe") and (process.command_line like "*_cmd.exe*" and process.command_line like "*_/Q*" and process.command_line like "*_/c*" and process.command_line like "*_\\\\\\\\127.0.0.1\\\\*" and process.command_line like "*_&1*")))
