// Title: AADInternals PowerShell Cmdlets Execution - ProccessCreation
// ID: c86500e9-a645-4680-98d7-f882c70c1ea3
// Status: test
// Level: high
// Author: Austin Songer (@austinsonger), Nasreddine Bencherchali (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2022-12-23
// Tags: attack.execution, attack.reconnaissance, attack.discovery, attack.credential-access, attack.impact
// Description: Detects ADDInternals Cmdlet execution. A tool for administering Azure AD and Office 365. Which can be abused by threat actors to attack Azure AD or Office 365.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_Add-AADInt*" or process.command_line like "*_ConvertTo-AADInt*" or process.command_line like "*_Disable-AADInt*" or process.command_line like "*_Enable-AADInt*" or process.command_line like "*_Export-AADInt*" or process.command_line like "*_Find-AADInt*" or process.command_line like "*_Get-AADInt*" or process.command_line like "*_Grant-AADInt*" or process.command_line like "*_Initialize-AADInt*" or process.command_line like "*_Install-AADInt*" or process.command_line like "*_Invoke-AADInt*" or process.command_line like "*_Join-AADInt*" or process.command_line like "*_New-AADInt*" or process.command_line like "*_Open-AADInt*" or process.command_line like "*_Read-AADInt*" or process.command_line like "*_Register-AADInt*" or process.command_line like "*_Remove-AADInt*" or process.command_line like "*_Reset-AADInt*" or process.command_line like "*_Resolve-AADInt*" or process.command_line like "*_Restore-AADInt*" or process.command_line like "*_Save-AADInt*" or process.command_line like "*_Search-AADInt*" or process.command_line like "*_Send-AADInt*" or process.command_line like "*_Set-AADInt*" or process.command_line like "*_Start-AADInt*" or process.command_line like "*_Unprotect-AADInt*" or process.command_line like "*_Update-AADInt*")) and (((process.executable endswith "\\powershell.exe" or process.executable endswith "\\powershell_ise.exe" or process.executable endswith "\\pwsh.exe")) or ((process.pe.original_file_name == "PowerShell.Exe" or process.pe.original_file_name == "pwsh.dll"))))
