// Title: smbexec.py Service Installation
// ID: 52a85084-6989-40c3-8f32-091e12e13f09
// Status: test
// Level: high
// Author: Omer Faruk Celik
// Date: 2018-03-20
// Tags: attack.lateral-movement, attack.execution, attack.t1021.002, attack.t1569.002
// Description: Detects the use of smbexec.py tool by detecting a specific service installation
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((winlog.provider_name == "Service Control Manager" and winlog.event_id == 7045) and (((ImagePath like "*_.bat & del *" or ImagePath like "*___output 2^>^&1 >*")) or (ServiceName == "BTOBTO")))
