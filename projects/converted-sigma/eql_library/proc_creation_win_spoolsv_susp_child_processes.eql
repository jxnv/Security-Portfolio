// Title: Suspicious Spool Service Child Process
// ID: dcdbc940-0bff-46b2-95f3-2d73f848e33b
// Status: test
// Level: high
// Author: Justin C. (@endisphotic), @dreadphones (detection), Thomas Patzke (Sigma rule)
// Date: 2021-07-11
// Tags: attack.execution, attack.t1203, attack.privilege-escalation, attack.t1068
// Description: Detects suspicious print spool service (spoolsv.exe) child processes.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.parent.executable endswith "\\spoolsv.exe" and (IntegrityLevel == "System" or IntegrityLevel == "S-1-16-16384")) and (((process.executable endswith "\\gpupdate.exe" or process.executable endswith "\\whoami.exe" or process.executable endswith "\\nltest.exe" or process.executable endswith "\\taskkill.exe" or process.executable endswith "\\wmic.exe" or process.executable endswith "\\taskmgr.exe" or process.executable endswith "\\sc.exe" or process.executable endswith "\\findstr.exe" or process.executable endswith "\\curl.exe" or process.executable endswith "\\wget.exe" or process.executable endswith "\\certutil.exe" or process.executable endswith "\\bitsadmin.exe" or process.executable endswith "\\accesschk.exe" or process.executable endswith "\\wevtutil.exe" or process.executable endswith "\\bcdedit.exe" or process.executable endswith "\\fsutil.exe" or process.executable endswith "\\cipher.exe" or process.executable endswith "\\schtasks.exe" or process.executable endswith "\\write.exe" or process.executable endswith "\\wuauclt.exe" or process.executable endswith "\\systeminfo.exe" or process.executable endswith "\\reg.exe" or process.executable endswith "\\query.exe")) or (((process.executable endswith "\\net.exe" or process.executable endswith "\\net1.exe")) and not ((process.command_line like "*_start*"))) or ((process.executable endswith "\\cmd.exe") and not (((process.command_line like "*_.spl*" or process.command_line like "*_route add*" or process.command_line like "*_program files*")))) or ((process.executable endswith "\\netsh.exe") and not (((process.command_line like "*_add portopening*" or process.command_line like "*_rule name*")))) or (((process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe")) and not ((process.command_line like "*_.spl*"))) or ((process.command_line endswith "rundll32.exe") and ((process.executable endswith "\\rundll32.exe") or (process.pe.original_file_name == "RUNDLL32.EXE")))))
