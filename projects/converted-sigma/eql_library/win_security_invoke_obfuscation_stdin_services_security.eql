// Title: Invoke-Obfuscation STDIN+ Launcher - Security
// ID: 0c718a5e-4284-4fb9-b4d9-b9a50b3a1974
// Status: test
// Level: high
// Author: Jonathan Cheong, oscd.community
// Date: 2020-10-15
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated use of stdin to execute PowerShell
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((winlog.event_id == 4697 and (ServiceFileName like "*_cmd*" and ServiceFileName like "*_powershell*")) and ((ServiceFileName like "*_${input}*" or ServiceFileName like "*_noexit*")) and ((ServiceFileName like "*_ /c *" or ServiceFileName like "*_ /r *")))
