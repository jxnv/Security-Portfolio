// Title: Suspicious Use of PsLogList
// ID: aae1243f-d8af-40d8-ab20-33fc6d0c55bc
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-12-18
// Tags: attack.discovery, attack.t1087, attack.t1087.001, attack.t1087.002
// Description: Detects usage of the PsLogList utility to dump event log in order to extract admin accounts and perform account discovery or delete events logs
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_ security*" or process.command_line like "*_ application*" or process.command_line like "*_ system*")) and ((process.command_line like "*_ -d*" or process.command_line like "*_ -x*" or process.command_line like "*_ -s*" or process.command_line like "*_ -c*" or process.command_line like "*_ -g*")) and ((process.pe.original_file_name == "psloglist.exe") or ((process.executable endswith "\\psloglist.exe" or process.executable endswith "\\psloglist64.exe" or process.executable endswith "\\psloglist64a.exe"))))
