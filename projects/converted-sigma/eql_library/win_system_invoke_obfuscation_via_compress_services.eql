// Title: Invoke-Obfuscation COMPRESS OBFUSCATION - System
// ID: 175997c5-803c-4b08-8bb0-70b099f47595
// Status: test
// Level: medium
// Author: Timur Zinniatullin, oscd.community
// Date: 2020-10-18
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via COMPRESS OBFUSCATION
// Converted by: Sigma Universal SIEM/EDR CLI

any where (winlog.provider_name == "Service Control Manager" and winlog.event_id == 7045 and (ImagePath like "*_new-object*" and ImagePath like "*_text.encoding]::ascii*" and ImagePath like "*_readtoend*") and (ImagePath like "*_:system.io.compression.deflatestream*" or ImagePath like "*_system.io.streamreader*"))
