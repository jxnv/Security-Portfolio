// Title: Suspicious Process Start Locations
// ID: 15b75071-74cc-47e0-b4c6-b43744a62a2b
// Status: test
// Level: medium
// Author: juju4, Jonhnathan Ribeiro, oscd.community
// Date: 2019-01-16
// Tags: attack.stealth, attack.t1036, car.2013-05-002
// Description: Detects suspicious process run from unusual locations
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.executable like "*_:\\RECYCLER\\*" or process.executable like "*_:\\SystemVolumeInformation\\*")) or ((process.executable startswith "C:\\Windows\\Tasks\\" or process.executable startswith "C:\\Windows\\debug\\" or process.executable startswith "C:\\Windows\\fonts\\" or process.executable startswith "C:\\Windows\\help\\" or process.executable startswith "C:\\Windows\\drivers\\" or process.executable startswith "C:\\Windows\\addins\\" or process.executable startswith "C:\\Windows\\cursors\\" or process.executable startswith "C:\\Windows\\system32\\tasks\\")))
