// Title: Potential Direct Syscall of NtOpenProcess
// ID: 3f3f3506-1895-401b-9cc3-e86b16e630d0
// Status: test
// Level: medium
// Author: Christian Burkard (Nextron Systems), Tim Shelton (FP)
// Date: 2021-07-28
// Tags: attack.execution, attack.t1106
// Description: Detects potential calls to NtOpenProcess directly from NTDLL.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((CallTrace startswith "UNKNOWN") and not ((((SourceImage like "*_:\\Program Files (x86)\\*" or SourceImage like "*_:\\Program Files\\*" or SourceImage like "*_:\\Windows\\System32\\*" or SourceImage like "*_:\\Windows\\SysWOW64\\*" or SourceImage like "*_:\\Windows\\WinSxS\\*") and (TargetImage like "*_:\\Program Files (x86)\\*" or TargetImage like "*_:\\Program Files\\*" or TargetImage like "*_:\\Windows\\System32\\*" or TargetImage like "*_:\\Windows\\SysWOW64\\*" or TargetImage like "*_:\\Windows\\WinSxS\\*")) or (winlog.provider_name == "Microsoft-Windows-Kernel-Audit-API-Calls") or (TargetImage endswith "vcredist_x64.exe" and SourceImage endswith "vcredist_x64.exe"))) and not (((SourceImage like "*_:\\Program Files\\Adobe\\Acrobat DC\\Acrobat\\*" and SourceImage endswith "\\AcroCEF.exe" and TargetImage like "*_:\\Program Files\\Adobe\\Acrobat DC\\Acrobat\\*" and TargetImage endswith "\\AcroCEF.exe") or (SourceImage endswith "AmazonSSMAgentSetup.exe" and TargetImage endswith "AmazonSSMAgentSetup.exe") or (SourceImage endswith ":\\Windows\\Explorer.EXE" and TargetImage endswith ":\\Program Files\\Cylance\\Desktop\\CylanceUI.exe") or (TargetImage like "*_\\AppData\\Local\\Discord\\*" and TargetImage endswith "\\Discord.exe") or (TargetImage endswith "\\Evernote\\Evernote.exe") or (TargetImage endswith "\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe" and SourceImage endswith "\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe") or (TargetImage endswith ":\\Windows\\system32\\systeminfo.exe" and SourceImage endswith "setup64.exe") or (SourceImage endswith "\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe" and TargetImage endswith "\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe") or (SourceImage like "*_\\AppData\\Local\\yammerdesktop\\app-*" and SourceImage endswith "\\Yammer.exe" and TargetImage like "*_\\AppData\\Local\\yammerdesktop\\app-*" and TargetImage endswith "\\Yammer.exe" and GrantedAccess == "0x1000"))))
