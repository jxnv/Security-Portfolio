// Title: Metasploit SMB Authentication
// ID: 72124974-a68b-4366-b990-d30e0b2a190d
// Status: test
// Level: high
// Author: Chakib Gzenayi (@Chak092), Hosni Mribah
// Date: 2020-05-06
// Tags: attack.lateral-movement, attack.t1021.002
// Description: Alerts on Metasploit host's authentications on the domain.
// Converted by: Sigma Universal SIEM/EDR CLI

any where (((winlog.event_id == 4625 or winlog.event_id == 4624) and LogonType == 3 and AuthenticationPackageName == "NTLM" and WorkstationName regex "^[A-Za-z0-9]{16}$") or (winlog.event_id == 4776 and Workstation regex "^[A-Za-z0-9]{16}$"))
