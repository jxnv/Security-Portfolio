// Title: Potential Homoglyph Attack Using Lookalike Characters
// ID: 32e280f1-8ad4-46ef-9e80-910657611fbc
// Status: test
// Level: medium
// Author: Micah Babinski, @micahbabinski
// Date: 2023-05-07
// Tags: attack.stealth, attack.t1036, attack.t1036.003
// Description: Detects the presence of unicode characters which are homoglyphs, or identical in appearance, to ASCII letter characters.
// This is used as an obfuscation and masquerading techniques. Only "perfect" homoglyphs are included; these are characters that
// are indistinguishable from ASCII characters and thus may make excellent candidates for homoglyph attack characters.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_а*" or process.command_line like "*_е*" or process.command_line like "*_о*" or process.command_line like "*_р*" or process.command_line like "*_с*" or process.command_line like "*_х*" or process.command_line like "*_ѕ*" or process.command_line like "*_і*" or process.command_line like "*_ӏ*" or process.command_line like "*_ј*" or process.command_line like "*_һ*" or process.command_line like "*_ԁ*" or process.command_line like "*_ԛ*" or process.command_line like "*_ԝ*" or process.command_line like "*_ο*")) or ((process.command_line like "*_А*" or process.command_line like "*_В*" or process.command_line like "*_Е*" or process.command_line like "*_К*" or process.command_line like "*_М*" or process.command_line like "*_Н*" or process.command_line like "*_О*" or process.command_line like "*_Р*" or process.command_line like "*_С*" or process.command_line like "*_Т*" or process.command_line like "*_Х*" or process.command_line like "*_Ѕ*" or process.command_line like "*_І*" or process.command_line like "*_Ј*" or process.command_line like "*_Ү*" or process.command_line like "*_Ӏ*" or process.command_line like "*_Ԍ*" or process.command_line like "*_Ԛ*" or process.command_line like "*_Ԝ*" or process.command_line like "*_Α*" or process.command_line like "*_Β*" or process.command_line like "*_Ε*" or process.command_line like "*_Ζ*" or process.command_line like "*_Η*" or process.command_line like "*_Ι*" or process.command_line like "*_Κ*" or process.command_line like "*_Μ*" or process.command_line like "*_Ν*" or process.command_line like "*_Ο*" or process.command_line like "*_Ρ*" or process.command_line like "*_Τ*" or process.command_line like "*_Υ*" or process.command_line like "*_Χ*")))
