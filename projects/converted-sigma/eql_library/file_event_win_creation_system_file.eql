// Title: Files With System Process Name In Unsuspected Locations
// ID: d5866ddf-ce8f-4aea-b28e-d96485a20d3d
// Status: test
// Level: medium
// Author: Sander Wiebing, Tim Shelton, Nasreddine Bencherchali (Nextron Systems)
// Date: 2020-05-26
// Tags: attack.stealth, attack.t1036.005
// Description: Detects the creation of an executable with a system process name in folders other than the system ones (System32, SysWOW64, etc.).
// It is highly recommended to perform an initial baseline before using this rule in production.
// Converted by: Sigma Universal SIEM/EDR CLI

file where (((file.path endswith "\\AtBroker.exe" or file.path endswith "\\audiodg.exe" or file.path endswith "\\backgroundTaskHost.exe" or file.path endswith "\\bcdedit.exe" or file.path endswith "\\bitsadmin.exe" or file.path endswith "\\cmdl32.exe" or file.path endswith "\\cmstp.exe" or file.path endswith "\\conhost.exe" or file.path endswith "\\csrss.exe" or file.path endswith "\\dasHost.exe" or file.path endswith "\\dfrgui.exe" or file.path endswith "\\dllhost.exe" or file.path endswith "\\dwm.exe" or file.path endswith "\\eventcreate.exe" or file.path endswith "\\eventvwr.exe" or file.path endswith "\\explorer.exe" or file.path endswith "\\extrac32.exe" or file.path endswith "\\fontdrvhost.exe" or file.path endswith "\\fsquirt.exe" or file.path endswith "\\ipconfig.exe" or file.path endswith "\\iscsicli.exe" or file.path endswith "\\iscsicpl.exe" or file.path endswith "\\logman.exe" or file.path endswith "\\LogonUI.exe" or file.path endswith "\\LsaIso.exe" or file.path endswith "\\lsass.exe" or file.path endswith "\\lsm.exe" or file.path endswith "\\msiexec.exe" or file.path endswith "\\msinfo32.exe" or file.path endswith "\\mstsc.exe" or file.path endswith "\\nbtstat.exe" or file.path endswith "\\odbcconf.exe" or file.path endswith "\\powershell.exe" or file.path endswith "\\pwsh.exe" or file.path endswith "\\regini.exe" or file.path endswith "\\regsvr32.exe" or file.path endswith "\\rundll32.exe" or file.path endswith "\\RuntimeBroker.exe" or file.path endswith "\\schtasks.exe" or file.path endswith "\\SearchFilterHost.exe" or file.path endswith "\\SearchIndexer.exe" or file.path endswith "\\SearchProtocolHost.exe" or file.path endswith "\\SecurityHealthService.exe" or file.path endswith "\\SecurityHealthSystray.exe" or file.path endswith "\\services.exe" or file.path endswith "\\ShellAppRuntime.exe" or file.path endswith "\\sihost.exe" or file.path endswith "\\smartscreen.exe" or file.path endswith "\\smss.exe" or file.path endswith "\\spoolsv.exe" or file.path endswith "\\svchost.exe" or file.path endswith "\\SystemSettingsBroker.exe" or file.path endswith "\\taskhost.exe" or file.path endswith "\\taskhostw.exe" or file.path endswith "\\Taskmgr.exe" or file.path endswith "\\TiWorker.exe" or file.path endswith "\\vssadmin.exe" or file.path endswith "\\w32tm.exe" or file.path endswith "\\WerFault.exe" or file.path endswith "\\WerFaultSecure.exe" or file.path endswith "\\wermgr.exe" or file.path endswith "\\wevtutil.exe" or file.path endswith "\\wininit.exe" or file.path endswith "\\winlogon.exe" or file.path endswith "\\winrshost.exe" or file.path endswith "\\WinRTNetMUAHostServer.exe" or file.path endswith "\\wlanext.exe" or file.path endswith "\\wlrmdr.exe" or file.path endswith "\\WmiPrvSE.exe" or file.path endswith "\\wslhost.exe" or file.path endswith "\\WSReset.exe" or file.path endswith "\\WUDFHost.exe" or file.path endswith "\\WWAHost.exe")) and not (((file.path endswith "C:\\Windows\\explorer.exe") or ((file.path like "*_C:\\$WINDOWS.~BT\\*" or file.path like "*_C:\\$WinREAgent\\*" or file.path like "*_C:\\Windows\\SoftwareDistribution\\*" or file.path like "*_C:\\Windows\\System32\\*" or file.path like "*_C:\\Windows\\SysWOW64\\*" or file.path like "*_C:\\Windows\\WinSxS\\*" or file.path like "*_C:\\Windows\\uus\\*")) or (file.path like "*_C:\\Windows\\System32\\SecurityHealth\\*" and file.path endswith "\\SecurityHealthSystray.exe" and process.executable endswith "\\SecurityHealthSetup.exe") or ((process.executable endswith "C:\\WINDOWS\\system32\\msiexec.exe" or process.executable endswith "C:\\WINDOWS\\SysWOW64\\msiexec.exe") and (file.path startswith "C:\\Program Files\\PowerShell\\7\\pwsh.exe" or file.path startswith "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" or file.path startswith "C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview\\")) or ((process.executable endswith "C:\\Windows\\system32\\svchost.exe" or process.executable endswith "C:\\Windows\\SysWOW64\\svchost.exe") and (file.path like "*_C:\\Program Files\\WindowsApps\\*" or file.path like "*_C:\\Program Files (x86)\\WindowsApps\\*" or file.path like "*_\\AppData\\Local\\Microsoft\\WindowsApps\\*")) or ((process.executable endswith "\\TiWorker.exe" or process.executable endswith "\\wuaucltcore.exe") and file.path startswith "C:\\Windows\\Temp\\") or ((process.executable == "C:\\Windows\\System32\\wuauclt.exe" or process.executable == "C:\\Windows\\SysWOW64\\wuauclt.exe" or process.executable == "C:\\Windows\\UUS\\arm64\\wuaucltcore.exe")))) and not (((file.path == "C:\\Program Files\\WSL\\wslhost.exe") or ((file.path like "*_C:\\Program Files\\WindowsApps\\MicrosoftCorporationII.WindowsSubsystemForLinux_*" and file.path like "*_\\wslhost.exe*")) or ((file.path like "*_C:\\Users\\*" and file.path like "*_\\AppData\\Local\\Microsoft\\WindowsApps\\*" and file.path like "*_\\wslhost.exe*")))))
