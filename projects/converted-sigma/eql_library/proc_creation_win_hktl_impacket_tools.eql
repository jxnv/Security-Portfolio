// Title: HackTool - Impacket Tools Execution
// ID: 4627c6ae-6899-46e2-aa0c-6ebcb1becd19
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2021-07-24
// Tags: attack.collection, attack.execution, attack.credential-access, attack.t1557.001
// Description: Detects the execution of different compiled Windows binaries of the impacket toolset (based on names or part of their names - could lead to false positives)
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.executable like "*_\\goldenPac*" or process.executable like "*_\\karmaSMB*" or process.executable like "*_\\kintercept*" or process.executable like "*_\\ntlmrelayx*" or process.executable like "*_\\rpcdump*" or process.executable like "*_\\samrdump*" or process.executable like "*_\\secretsdump*" or process.executable like "*_\\smbexec*" or process.executable like "*_\\smbrelayx*" or process.executable like "*_\\wmiexec*" or process.executable like "*_\\wmipersist*")) or ((process.executable endswith "\\atexec_windows.exe" or process.executable endswith "\\dcomexec_windows.exe" or process.executable endswith "\\dpapi_windows.exe" or process.executable endswith "\\findDelegation_windows.exe" or process.executable endswith "\\GetADUsers_windows.exe" or process.executable endswith "\\GetNPUsers_windows.exe" or process.executable endswith "\\getPac_windows.exe" or process.executable endswith "\\getST_windows.exe" or process.executable endswith "\\getTGT_windows.exe" or process.executable endswith "\\GetUserSPNs_windows.exe" or process.executable endswith "\\ifmap_windows.exe" or process.executable endswith "\\mimikatz_windows.exe" or process.executable endswith "\\netview_windows.exe" or process.executable endswith "\\nmapAnswerMachine_windows.exe" or process.executable endswith "\\opdump_windows.exe" or process.executable endswith "\\psexec_windows.exe" or process.executable endswith "\\rdp_check_windows.exe" or process.executable endswith "\\sambaPipe_windows.exe" or process.executable endswith "\\smbclient_windows.exe" or process.executable endswith "\\smbserver_windows.exe" or process.executable endswith "\\sniff_windows.exe" or process.executable endswith "\\sniffer_windows.exe" or process.executable endswith "\\split_windows.exe" or process.executable endswith "\\ticketer_windows.exe")))
