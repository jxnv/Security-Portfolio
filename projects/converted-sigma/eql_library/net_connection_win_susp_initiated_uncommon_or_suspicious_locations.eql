// Title: Network Connection Initiated From Process Located In Potentially Suspicious Or Uncommon Location
// ID: 7b434893-c57d-4f41-908d-6a17bf1ae98f
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2017-03-19
// Tags: attack.command-and-control, attack.t1105
// Description: Detects a network connection initiated by programs or processes running from suspicious or uncommon files system locations.
// Converted by: Sigma Universal SIEM/EDR CLI

network where ((Initiated == "true" and (process.executable like "*_:\\$Recycle.bin*" or process.executable like "*_:\\Perflogs\\*" or process.executable like "*_:\\Temp\\*" or process.executable like "*_:\\Users\\Default\\*" or process.executable like "*_:\\Users\\Public\\*" or process.executable like "*_:\\Windows\\Fonts\\*" or process.executable like "*_:\\Windows\\IME\\*" or process.executable like "*_:\\Windows\\System32\\Tasks\\*" or process.executable like "*_:\\Windows\\Tasks\\*" or process.executable like "*_\\config\\systemprofile\\*" or process.executable like "*_\\Contacts\\*" or process.executable like "*_\\Favorites\\*" or process.executable like "*_\\Favourites\\*" or process.executable like "*_\\Music\\*" or process.executable like "*_\\Pictures\\*" or process.executable like "*_\\Videos\\*" or process.executable like "*_\\Windows\\addins\\*")) and not (((DestinationHostname endswith ".githubusercontent.com" or DestinationHostname endswith "0x0.st" or DestinationHostname endswith "anonfiles.com" or DestinationHostname endswith "bashupload.com" or DestinationHostname endswith "cdn.discordapp.com" or DestinationHostname endswith "chunk.io" or DestinationHostname endswith "ddns.net" or DestinationHostname endswith "dl.dropboxusercontent.com" or DestinationHostname endswith "ghostbin.co" or DestinationHostname endswith "github.com" or DestinationHostname endswith "glitch.me" or DestinationHostname endswith "gofile.io" or DestinationHostname endswith "hastebin.com" or DestinationHostname endswith "mediafire.com" or DestinationHostname endswith "mega.co.nz" or DestinationHostname endswith "mega.nz" or DestinationHostname endswith "onrender.com" or DestinationHostname endswith "pages.dev" or DestinationHostname endswith "paste.ee" or DestinationHostname endswith "pastebin.com" or DestinationHostname endswith "pastebin.pl" or DestinationHostname endswith "pastetext.net" or DestinationHostname endswith "portmap.io" or DestinationHostname endswith "privatlab.com" or DestinationHostname endswith "privatlab.net" or DestinationHostname endswith "send.exploit.in" or DestinationHostname endswith "sendspace.com" or DestinationHostname endswith "storage.googleapis.com" or DestinationHostname endswith "storjshare.io" or DestinationHostname endswith "supabase.co" or DestinationHostname endswith "temp.sh" or DestinationHostname endswith "transfer.sh" or DestinationHostname endswith "trycloudflare.com" or DestinationHostname endswith "ufile.io" or DestinationHostname endswith "w3spaces.com" or DestinationHostname endswith "workers.dev" or DestinationHostname endswith "x0.at"))))
