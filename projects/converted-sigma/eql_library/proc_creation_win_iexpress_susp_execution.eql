// Title: Self Extracting Package Creation Via Iexpress.EXE From Potentially Suspicious Location
// ID: b2b048b0-7857-4380-b0fb-d3f0ab820b71
// Status: test
// Level: high
// Author: Joseliyo Sanchez, @Joseliyo_Jstnk, Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-02-05
// Tags: attack.stealth, attack.t1218
// Description: Detects the use of iexpress.exe to create binaries via Self Extraction Directive (SED) files located in potentially suspicious locations.
// This behavior has been observed in-the-wild by different threat actors.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.command_line like "*_ /n *") and ((process.executable endswith "\\iexpress.exe") or (process.pe.original_file_name == "IEXPRESS.exe")) and ((process.command_line like "*_:\\ProgramData\\*" or process.command_line like "*_:\\Temp\\*" or process.command_line like "*_:\\Windows\\System32\\Tasks\\*" or process.command_line like "*_:\\Windows\\Tasks\\*" or process.command_line like "*_:\\Windows\\Temp\\*" or process.command_line like "*_\\AppData\\Local\\Temp\\*")))
