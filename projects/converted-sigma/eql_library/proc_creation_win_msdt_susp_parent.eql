// Title: Suspicious MSDT Parent Process
// ID: 7a74da6b-ea76-47db-92cc-874ad90df734
// Status: test
// Level: high
// Author: Nextron Systems
// Date: 2022-06-01
// Tags: attack.stealth, attack.t1036, attack.t1218
// Description: Detects msdt.exe executed by a suspicious parent as seen in CVE-2022-30190 / Follina exploitation
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.executable endswith "\\msdt.exe") or (process.pe.original_file_name == "msdt.exe")) and ((process.parent.executable endswith "\\cmd.exe" or process.parent.executable endswith "\\cscript.exe" or process.parent.executable endswith "\\mshta.exe" or process.parent.executable endswith "\\powershell.exe" or process.parent.executable endswith "\\pwsh.exe" or process.parent.executable endswith "\\regsvr32.exe" or process.parent.executable endswith "\\rundll32.exe" or process.parent.executable endswith "\\schtasks.exe" or process.parent.executable endswith "\\wmic.exe" or process.parent.executable endswith "\\wscript.exe" or process.parent.executable endswith "\\wsl.exe")))
