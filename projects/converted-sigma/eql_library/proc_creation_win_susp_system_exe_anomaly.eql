// Title: System File Execution Location Anomaly
// ID: e4a6b256-3e47-40fc-89d2-7a477edd6915
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Patrick Bareiss, Anton Kutepov, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2017-11-27
// Tags: attack.stealth, attack.t1036
// Description: Detects the execution of a Windows system binary that is usually located in the system folder from an uncommon location.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.executable endswith "\\atbroker.exe" or process.executable endswith "\\audiodg.exe" or process.executable endswith "\\bcdedit.exe" or process.executable endswith "\\bitsadmin.exe" or process.executable endswith "\\certreq.exe" or process.executable endswith "\\certutil.exe" or process.executable endswith "\\cmstp.exe" or process.executable endswith "\\conhost.exe" or process.executable endswith "\\consent.exe" or process.executable endswith "\\cscript.exe" or process.executable endswith "\\csrss.exe" or process.executable endswith "\\dashost.exe" or process.executable endswith "\\defrag.exe" or process.executable endswith "\\dfrgui.exe" or process.executable endswith "\\dism.exe" or process.executable endswith "\\dllhost.exe" or process.executable endswith "\\dllhst3g.exe" or process.executable endswith "\\dwm.exe" or process.executable endswith "\\eventvwr.exe" or process.executable endswith "\\fsquirt.exe" or process.executable endswith "\\finger.exe" or process.executable endswith "\\logonui.exe" or process.executable endswith "\\LsaIso.exe" or process.executable endswith "\\lsass.exe" or process.executable endswith "\\lsm.exe" or process.executable endswith "\\msiexec.exe" or process.executable endswith "\\ntoskrnl.exe" or process.executable endswith "\\powershell_ise.exe" or process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe" or process.executable endswith "\\regsvr32.exe" or process.executable endswith "\\rundll32.exe" or process.executable endswith "\\runonce.exe" or process.executable endswith "\\RuntimeBroker.exe" or process.executable endswith "\\schtasks.exe" or process.executable endswith "\\services.exe" or process.executable endswith "\\sihost.exe" or process.executable endswith "\\smartscreen.exe" or process.executable endswith "\\smss.exe" or process.executable endswith "\\spoolsv.exe" or process.executable endswith "\\svchost.exe" or process.executable endswith "\\taskhost.exe" or process.executable endswith "\\taskhostw.exe" or process.executable endswith "\\Taskmgr.exe" or process.executable endswith "\\userinit.exe" or process.executable endswith "\\werfault.exe" or process.executable endswith "\\werfaultsecure.exe" or process.executable endswith "\\wininit.exe" or process.executable endswith "\\winlogon.exe" or process.executable endswith "\\winver.exe" or process.executable endswith "\\wlanext.exe" or process.executable endswith "\\wmic.exe" or process.executable endswith "\\wscript.exe" or process.executable endswith "\\wsl.exe" or process.executable endswith "\\wsmprovhost.exe")) and not ((((process.executable startswith "C:\\$WINDOWS.~BT\\" or process.executable startswith "C:\\$WinREAgent\\" or process.executable startswith "C:\\Windows\\SoftwareDistribution\\" or process.executable startswith "C:\\Windows\\System32\\" or process.executable startswith "C:\\Windows\\SystemTemp\\" or process.executable startswith "C:\\Windows\\SysWOW64\\" or process.executable startswith "C:\\Windows\\uus\\" or process.executable startswith "C:\\Windows\\WinSxS\\")) or ((process.executable like "*_C:\\Program Files\\PowerShell\\7\\*" or process.executable like "*_C:\\Program Files\\PowerShell\\7-preview\\*" or process.executable like "*_C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview*" or process.executable like "*_\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview*") and process.executable endswith "\\pwsh.exe") or (process.executable startswith "C:\\Users\\" and process.executable like "*_\\AppData\\Local\\Microsoft\\WindowsApps\\*" and process.executable endswith "\\wsl.exe") or ((process.executable startswith "C:\\Program Files\\WindowsApps\\MicrosoftCorporationII.WindowsSubsystemForLinux" or process.executable startswith "C:\\Program Files\\WSL\\") and process.executable endswith "\\wsl.exe"))) and not ((process.executable like "*_\\SystemRoot\\System32\\*")))
