// Title: Suspicious Browser Child Process - MacOS
// ID: 0250638a-2b28-4541-86fc-ea4c558fa0c6
// Status: test
// Level: medium
// Author: Sohan G (D4rkCiph3r)
// Date: 2023-04-05
// Tags: attack.initial-access, attack.execution, attack.t1189, attack.t1203, attack.t1059
// Description: Detects suspicious child processes spawned from browsers. This could be a result of a potential web browser exploitation.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.parent.executable like "*_com.apple.WebKit.WebContent*" or process.parent.executable like "*_firefox*" or process.parent.executable like "*_Google Chrome Helper*" or process.parent.executable like "*_Google Chrome*" or process.parent.executable like "*_Microsoft Edge*" or process.parent.executable like "*_Opera*" or process.parent.executable like "*_Safari*" or process.parent.executable like "*_Tor Browser*") and (process.executable endswith "/bash" or process.executable endswith "/curl" or process.executable endswith "/dash" or process.executable endswith "/ksh" or process.executable endswith "/osascript" or process.executable endswith "/perl" or process.executable endswith "/php" or process.executable endswith "/pwsh" or process.executable endswith "/python" or process.executable endswith "/sh" or process.executable endswith "/tcsh" or process.executable endswith "/wget" or process.executable endswith "/zsh")) and not ((((process.parent.executable like "*_Google Chrome Helper*" or process.parent.executable like "*_Google Chrome*") and (process.command_line like "*_/Volumes/Google Chrome/Google Chrome.app/Contents/Frameworks/*/Resources/install.sh*" or process.command_line like "*_/Applications/Google Chrome.app/Contents/Frameworks/Google Chrome Framework.framework/*/Resources/keystone_promote_preflight.sh*" or process.command_line like "*_/Applications/Google Chrome.app/Contents/Frameworks/Google Chrome Framework.framework/*/Resources/keystone_promote_postflight.sh*")) or ((process.parent.executable like "*_Google Chrome Helper*" or process.parent.executable like "*_Google Chrome*") and (process.command_line like "*_/Users/*" and process.command_line like "*_/Library/Application Support/Google/Chrome/recovery/*" and process.command_line like "*_/ChromeRecovery*")) or (process.command_line like "*_--defaults-torrc*") or (process.command_line like "*_/Library/Application Support/Microsoft/MAU*/Microsoft AutoUpdate.app/Contents/MacOS/msupdate*") or (process.parent.executable like "*_Microsoft Edge*" and (process.command_line like "*_IOPlatformExpertDevice*" or process.command_line like "*_hw.model*")))) and not (((process.command_line == "") or (process.command_line == null))))
