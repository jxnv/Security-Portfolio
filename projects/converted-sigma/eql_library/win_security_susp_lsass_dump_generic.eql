// Title: Potentially Suspicious AccessMask Requested From LSASS
// ID: 4a1b6da0-d94f-4fc3-98fc-2d9cb9e5ee76
// Status: test
// Level: medium
// Author: Roberto Rodriguez, Teymur Kheirkhabarov, Dimitrios Slamaris, Mark Russinovich, Aleksey Potapov, oscd.community (update)
// Date: 2019-11-01
// Tags: attack.credential-access, car.2019-04-004, attack.t1003.001
// Description: Detects process handle on LSASS process with certain access mask
// Converted by: Sigma Universal SIEM/EDR CLI

any where (((winlog.event_id == 4656 and ObjectName endswith "\\lsass.exe" and (AccessMask like "*_0x40*" or AccessMask like "*_0x1400*" or AccessMask like "*_0x100000*" or AccessMask like "*_0x1410*" or AccessMask like "*_0x1010*" or AccessMask like "*_0x1438*" or AccessMask like "*_0x143a*" or AccessMask like "*_0x1418*" or AccessMask like "*_0x1f0fff*" or AccessMask like "*_0x1f1fff*" or AccessMask like "*_0x1f2fff*" or AccessMask like "*_0x1f3fff*")) or (winlog.event_id == 4663 and ObjectName endswith "\\lsass.exe" and (AccessList like "*_4484*" or AccessList like "*_4416*"))) and not (((ProcessName like "*_:\\Windows\\Temp\\asgard2-agent-sc\\aurora\\*" and ProcessName endswith "\\aurora-agent-64.exe" and AccessList like "*_%%4484*") or ((ProcessName like "*_:\\Users\\*" and ProcessName like "*_\\AppData\\Local\\Temp\\is-*") and ProcessName endswith "\\avira_system_speedup.tmp" and AccessList like "*_%%4484*") or (ProcessName like "*_:\\Windows\\Temp\\*" and ProcessName endswith "\\avira_speedup_setup_update.tmp" and AccessList like "*_%%4484*") or ((ProcessName endswith ":\\Windows\\System32\\taskhostw.exe" or ProcessName endswith ":\\Windows\\System32\\msiexec.exe" or ProcessName endswith ":\\Windows\\CCM\\CcmExec.exe")) or (ProcessName like "*_:\\Program Files*") or (ProcessName like "*_:\\Windows\\SystemTemp\\*" and ProcessName endswith "\\GoogleUpdate.exe" and AccessList like "*_%%4484*") or (ProcessName endswith "\\x64\\SCENARIOENGINE.EXE" and AccessList like "*_%%4484*") or (ProcessName endswith ":\\Windows\\System32\\snmp.exe" and AccessList like "*_%%4484*") or ((ProcessName endswith "\\csrss.exe" or ProcessName endswith "\\GamingServices.exe" or ProcessName endswith "\\lsm.exe" or ProcessName endswith "\\MicrosoftEdgeUpdate.exe" or ProcessName endswith "\\minionhost.exe" or ProcessName endswith "\\MRT.exe" or ProcessName endswith "\\MsMpEng.exe" or ProcessName endswith "\\perfmon.exe" or ProcessName endswith "\\procexp.exe" or ProcessName endswith "\\procexp64.exe" or ProcessName endswith "\\procexp64a.exe" or ProcessName endswith "\\svchost.exe" or ProcessName endswith "\\taskmgr.exe" or ProcessName endswith "\\thor.exe" or ProcessName endswith "\\thor64.exe" or ProcessName endswith "\\vmtoolsd.exe" or ProcessName endswith "\\VsTskMgr.exe" or ProcessName endswith "\\wininit.exe" or ProcessName endswith "\\wmiprvse.exe" or ProcessName endswith "RtkAudUService64") and (ProcessName like "*_:\\Program Files (x86)\\*" or ProcessName like "*_:\\Program Files\\*" or ProcessName like "*_:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*" or ProcessName like "*_:\\Windows\\SysNative\\*" or ProcessName like "*_:\\Windows\\System32\\*" or ProcessName like "*_:\\Windows\\SysWow64\\*" or ProcessName like "*_:\\Windows\\Temp\\asgard2-agent\\*")) or ((ProcessName endswith ":\\Windows\\Sysmon64.exe" or ProcessName endswith ":\\Windows\\Sysmon64a.exe") and AccessList like "*_%%4484*"))) and not (((ProcessName endswith "\\procmon64.exe" or ProcessName endswith "\\procmon64a.exe" or ProcessName endswith "\\procmon.exe") and AccessList like "*_%%4484*")))
