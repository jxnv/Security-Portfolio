// Title: PUA - CleanWipe Execution
// ID: f44800ac-38ec-471f-936e-3fa7d9c53100
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-12-18
// Tags: attack.defense-impairment, attack.t1685
// Description: Detects the use of CleanWipe a tool usually used to delete Symantec antivirus.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.executable endswith "\\SepRemovalToolNative_x64.exe") or (process.executable endswith "\\CATClean.exe" and process.command_line like "*_--uninstall*") or (process.executable endswith "\\NetInstaller.exe" and process.command_line like "*_-r*") or (process.executable endswith "\\WFPUnins.exe" and (process.command_line like "*_/uninstall*" and process.command_line like "*_/enterprise*")))
