// Tags: attack.reconnaissance, attack.t1595
// Description: Detects the execution of PingCastle, a tool designed to quickly assess the Active Directory security level via a script located in a potentially suspicious or uncommon location.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.parent.command_line like "*_.bat*" or process.parent.command_line like "*_.chm*" or process.parent.command_line like "*_.cmd*" or process.parent.command_line like "*_.hta*" or process.parent.command_line like "*_.htm*" or process.parent.command_line like "*_.html*" or process.parent.command_line like "*_.js*" or process.parent.command_line like "*_.lnk*" or process.parent.command_line like "*_.ps1*" or process.parent.command_line like "*_.vbe*" or process.parent.command_line like "*_.vbs*" or process.parent.command_line like "*_.wsf*")) or ((process.parent.command_line like "*_:\\Perflogs\\*" or process.parent.command_line like "*_:\\Temp\\*" or process.parent.command_line like "*_:\\Users\\Public\\*" or process.parent.command_line like "*_:\\Windows\\Temp\\*" or process.parent.command_line like "*_\\AppData\\Local\\Temp*" or process.parent.command_line like "*_\\AppData\\Roaming\\*" or process.parent.command_line like "*_\\Temporary Internet*")) or (((process.parent.command_line like "*_:\\Users\\*" and process.parent.command_line like "*_\\Favorites\\*")) or ((process.parent.command_line like "*_:\\Users\\*" and process.parent.command_line like "*_\\Favourites\\*")) or ((process.parent.command_line like "*_:\\Users\\*" and process.parent.command_line like "*_\\Contacts\\*")))) and ((process.parent.command_line like "*_.bat*" or process.parent.command_line like "*_.chm*" or process.parent.command_line like "*_.cmd*" or process.parent.command_line like "*_.hta*" or process.parent.command_line like "*_.htm*" or process.parent.command_line like "*_.html*" or process.parent.command_line like "*_.js*" or process.parent.command_line like "*_.lnk*" or process.parent.command_line like "*_.ps1*" or process.parent.command_line like "*_.vbe*" or process.parent.command_line like "*_.vbs*" or process.parent.command_line like "*_.wsf*")) and ((process.executable endswith "\\PingCastle.exe") or (process.pe.original_file_name == "PingCastle.exe") or (Product == "Ping Castle") or ((process.command_line like "*_--scanner aclcheck*" or process.command_line like "*_--scanner antivirus*" or process.command_line like "*_--scanner computerversion*" or process.command_line like "*_--scanner foreignusers*" or process.command_line like "*_--scanner laps_bitlocker*" or process.command_line like "*_--scanner localadmin*" or process.command_line like "*_--scanner nullsession*" or process.command_line like "*_--scanner nullsession-trust*" or process.command_line like "*_--scanner oxidbindings*" or process.command_line like "*_--scanner remote*" or process.command_line like "*_--scanner share*" or process.command_line like "*_--scanner smb*" or process.command_line like "*_--scanner smb3querynetwork*" or process.command_line like "*_--scanner spooler*" or process.command_line like "*_--scanner startup*" or process.command_line like "*_--scanner zerologon*")) or (process.command_line like "*_--no-enum-limit*") or ((process.command_line like "*_--healthcheck*" and process.command_line like "*_--level Full*")) or ((process.command_line like "*_--healthcheck*" and process.command_line like "*_--server *"))))
