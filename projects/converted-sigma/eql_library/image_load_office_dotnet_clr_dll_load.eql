// Title: CLR DLL Loaded Via Office Applications
// ID: d13c43f0-f66b-4279-8b2c-5912077c1780
// Status: test
// Level: medium
// Author: Antonlovesdnb
// Date: 2020-02-19
// Tags: attack.execution, attack.t1204.002
// Description: Detects CLR DLL being loaded by an Office Product
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((process.executable endswith "\\excel.exe" or process.executable endswith "\\mspub.exe" or process.executable endswith "\\outlook.exe" or process.executable endswith "\\onenote.exe" or process.executable endswith "\\onenoteim.exe" or process.executable endswith "\\powerpnt.exe" or process.executable endswith "\\winword.exe") and ImageLoaded like "*_\\clr.dll*")
