// Title: Potential Defense Evasion Via Rename Of Highly Relevant Binaries
// ID: 0ba1da6d-b6ce-4366-828c-18826c9de23e
// Status: test
// Level: high
// Author: Matthew Green - @mgreen27, Florian Roth (Nextron Systems), frack113
// Date: 2019-06-15
// Tags: attack.stealth, attack.t1036.003, car.2013-05-009
// Description: Detects the execution of a renamed binary often used by attackers or malware leveraging new Sysmon OriginalFileName datapoint.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((Description == "Execute processes remotely") or (Product == "Sysinternals PsExec") or ((Description startswith "Windows PowerShell" or Description startswith "pwsh")) or ((process.pe.original_file_name == "certutil.exe" or process.pe.original_file_name == "cmstp.exe" or process.pe.original_file_name == "cscript.exe" or process.pe.original_file_name == "IE4UINIT.EXE" or process.pe.original_file_name == "finger.exe" or process.pe.original_file_name == "mshta.exe" or process.pe.original_file_name == "msiexec.exe" or process.pe.original_file_name == "msxsl.exe" or process.pe.original_file_name == "powershell_ise.exe" or process.pe.original_file_name == "powershell.exe" or process.pe.original_file_name == "psexec.c" or process.pe.original_file_name == "psexec.exe" or process.pe.original_file_name == "psexesvc.exe" or process.pe.original_file_name == "pwsh.dll" or process.pe.original_file_name == "reg.exe" or process.pe.original_file_name == "regsvr32.exe" or process.pe.original_file_name == "rundll32.exe" or process.pe.original_file_name == "WerMgr" or process.pe.original_file_name == "wmic.exe" or process.pe.original_file_name == "wscript.exe"))) and not (((process.executable endswith "\\certutil.exe" or process.executable endswith "\\cmstp.exe" or process.executable endswith "\\cscript.exe" or process.executable endswith "\\ie4uinit.exe" or process.executable endswith "\\finger.exe" or process.executable endswith "\\mshta.exe" or process.executable endswith "\\msiexec.exe" or process.executable endswith "\\msxsl.exe" or process.executable endswith "\\powershell_ise.exe" or process.executable endswith "\\powershell.exe" or process.executable endswith "\\psexec.exe" or process.executable endswith "\\psexec64.exe" or process.executable endswith "\\psexec64a.exe" or process.executable endswith "\\PSEXESVC.exe" or process.executable endswith "\\pwsh.exe" or process.executable endswith "\\reg.exe" or process.executable endswith "\\regsvr32.exe" or process.executable endswith "\\rundll32.exe" or process.executable endswith "\\wermgr.exe" or process.executable endswith "\\wmic.exe" or process.executable endswith "\\wscript.exe"))))
