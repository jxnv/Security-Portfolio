// Title: Suspicious File Download From File Sharing Domain Via Curl.EXE
// ID: 56454143-524f-49fb-b1c6-3fb8b1ad41fb
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-05
// Tags: attack.execution
// Description: Detects potentially suspicious file download from file sharing domains using curl.exe
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line endswith ".ps1" or process.command_line endswith ".ps1'" or process.command_line endswith ".ps1\"" or process.command_line endswith ".dat" or process.command_line endswith ".dat'" or process.command_line endswith ".dat\"" or process.command_line endswith ".msi" or process.command_line endswith ".msi'" or process.command_line endswith ".msi\"" or process.command_line endswith ".bat" or process.command_line endswith ".bat'" or process.command_line endswith ".bat\"" or process.command_line endswith ".exe" or process.command_line endswith ".exe'" or process.command_line endswith ".exe\"" or process.command_line endswith ".vbs" or process.command_line endswith ".vbs'" or process.command_line endswith ".vbs\"" or process.command_line endswith ".vbe" or process.command_line endswith ".vbe'" or process.command_line endswith ".vbe\"" or process.command_line endswith ".hta" or process.command_line endswith ".hta'" or process.command_line endswith ".hta\"" or process.command_line endswith ".dll" or process.command_line endswith ".dll'" or process.command_line endswith ".dll\"" or process.command_line endswith ".psm1" or process.command_line endswith ".psm1'" or process.command_line endswith ".psm1\"")) and ((process.command_line like "*_ -O*" or process.command_line like "*_--remote-name*" or process.command_line like "*_--output*")) and (process.command_line like "*_http*") and ((process.executable endswith "\\curl.exe") or (process.pe.original_file_name == "curl.exe")) and ((process.command_line like "*_.githubusercontent.com*" or process.command_line like "*_0x0.st*" or process.command_line like "*_anonfiles.com*" or process.command_line like "*_bashupload.com*" or process.command_line like "*_cdn.discordapp.com*" or process.command_line like "*_chunk.io*" or process.command_line like "*_ddns.net*" or process.command_line like "*_dl.dropboxusercontent.com*" or process.command_line like "*_ghostbin.co*" or process.command_line like "*_github.com*" or process.command_line like "*_glitch.me*" or process.command_line like "*_gofile.io*" or process.command_line like "*_hastebin.com*" or process.command_line like "*_mediafire.com*" or process.command_line like "*_mega.nz*" or process.command_line like "*_onrender.com*" or process.command_line like "*_pages.dev*" or process.command_line like "*_paste.ee*" or process.command_line like "*_pastebin.com*" or process.command_line like "*_pastebin.pl*" or process.command_line like "*_pastetext.net*" or process.command_line like "*_pixeldrain.com*" or process.command_line like "*_privatlab.com*" or process.command_line like "*_privatlab.net*" or process.command_line like "*_send.exploit.in*" or process.command_line like "*_sendspace.com*" or process.command_line like "*_storage.googleapis.com*" or process.command_line like "*_storjshare.io*" or process.command_line like "*_supabase.co*" or process.command_line like "*_temp.sh*" or process.command_line like "*_transfer.sh*" or process.command_line like "*_trycloudflare.com*" or process.command_line like "*_ufile.io*" or process.command_line like "*_w3spaces.com*" or process.command_line like "*_workers.dev*" or process.command_line like "*_x0.at*")))
