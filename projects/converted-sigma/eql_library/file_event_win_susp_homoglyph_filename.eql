// Title: Potential Homoglyph Attack Using Lookalike Characters in Filename
// ID: 4f1707b1-b50b-45b4-b5a2-3978b5a5d0d6
// Status: test
// Level: medium
// Author: Micah Babinski, @micahbabinski
// Date: 2023-05-08
// Tags: attack.stealth, attack.t1036, attack.t1036.003
// Description: Detects the presence of unicode characters which are homoglyphs, or identical in appearance, to ASCII letter characters.
// This is used as an obfuscation and masquerading techniques. Only "perfect" homoglyphs are included; these are characters that
// are indistinguishable from ASCII characters and thus may make excellent candidates for homoglyph attack characters.
// Converted by: Sigma Universal SIEM/EDR CLI

file where (((file.path like "*_а*" or file.path like "*_е*" or file.path like "*_о*" or file.path like "*_р*" or file.path like "*_с*" or file.path like "*_х*" or file.path like "*_ѕ*" or file.path like "*_і*" or file.path like "*_ӏ*" or file.path like "*_ј*" or file.path like "*_һ*" or file.path like "*_ԁ*" or file.path like "*_ԛ*" or file.path like "*_ԝ*" or file.path like "*_ο*")) or ((file.path like "*_А*" or file.path like "*_В*" or file.path like "*_Е*" or file.path like "*_К*" or file.path like "*_М*" or file.path like "*_Н*" or file.path like "*_О*" or file.path like "*_Р*" or file.path like "*_С*" or file.path like "*_Т*" or file.path like "*_Х*" or file.path like "*_Ѕ*" or file.path like "*_І*" or file.path like "*_Ј*" or file.path like "*_Ү*" or file.path like "*_Ӏ*" or file.path like "*_Ԍ*" or file.path like "*_Ԛ*" or file.path like "*_Ԝ*" or file.path like "*_Α*" or file.path like "*_Β*" or file.path like "*_Ε*" or file.path like "*_Ζ*" or file.path like "*_Η*" or file.path like "*_Ι*" or file.path like "*_Κ*" or file.path like "*_Μ*" or file.path like "*_Ν*" or file.path like "*_Ο*" or file.path like "*_Ρ*" or file.path like "*_Τ*" or file.path like "*_Υ*" or file.path like "*_Χ*")))
