// Title: Suspicious Greedy Compression Using Rar.EXE
// ID: afe52666-401e-4a02-b4ff-5d128990b8cb
// Status: test
// Level: high
// Author: X__Junior (Nextron Systems), Florian Roth (Nextron Systems)
// Date: 2022-12-15
// Tags: attack.execution, attack.t1059
// Description: Detects RAR usage that creates an archive from a suspicious folder, either a system folder or one of the folders often used by attackers for staging purposes
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.executable endswith "\\rar.exe") or (Description == "Command line RAR")) or ((process.command_line like "*_.exe a *" or process.command_line like "*_ a -m*"))) and (((process.command_line like "*_ -hp*" and process.command_line like "*_ -r *")) and ((process.command_line like "*_ ?:\\\\\\*.*" or process.command_line like "*_ ?:\\\\\\\\\\*.*" or process.command_line like "*_ ?:\\$Recycle.bin\\*" or process.command_line like "*_ ?:\\PerfLogs\\*" or process.command_line like "*_ ?:\\Temp*" or process.command_line like "*_ ?:\\Users\\Public\\*" or process.command_line like "*_ ?:\\Windows\\*" or process.command_line like "*_ %public%*"))))
