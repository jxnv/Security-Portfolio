// Title: Suspicious Child Process Of BgInfo.EXE
// ID: 811f459f-9231-45d4-959a-0266c6311987
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-08-16
// Tags: attack.execution, attack.stealth, attack.t1059.005, attack.t1218, attack.t1202
// Description: Detects suspicious child processes of "BgInfo.exe" which could be a sign of potential abuse of the binary to proxy execution via external VBScript
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.executable endswith "\\calc.exe" or process.executable endswith "\\cmd.exe" or process.executable endswith "\\cscript.exe" or process.executable endswith "\\mshta.exe" or process.executable endswith "\\notepad.exe" or process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe" or process.executable endswith "\\wscript.exe")) or ((process.executable like "*_\\AppData\\Local\\*" or process.executable like "*_\\AppData\\Roaming\\*" or process.executable like "*_:\\Users\\Public\\*" or process.executable like "*_:\\Temp\\*" or process.executable like "*_:\\Windows\\Temp\\*" or process.executable like "*_:\\PerfLogs\\*"))) and ((process.parent.executable endswith "\\bginfo.exe" or process.parent.executable endswith "\\bginfo64.exe")))
