// Title: DNS Server Discovery Via LDAP Query
// ID: a21bcd7e-38ec-49ad-b69a-9ea17e69509e
// Status: test
// Level: low
// Author: frack113
// Date: 2022-08-20
// Tags: attack.discovery, attack.t1482
// Description: Detects DNS server discovery via LDAP query requests from uncommon applications
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((QueryName startswith "_ldap.") and not (((process.executable like "*_:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*" and process.executable endswith "\\MsMpEng.exe") or ((process.executable like "*_:\\Program Files\\*" or process.executable like "*_:\\Program Files (x86)\\*" or process.executable like "*_:\\Windows\\*")) or (process.executable == null) or (process.executable == "<unknown process>"))) and not (((process.executable startswith "C:\\WindowsAzure\\GuestAgent") or ((process.executable endswith "\\chrome.exe" or process.executable endswith "\\firefox.exe" or process.executable endswith "\\opera.exe")))))
