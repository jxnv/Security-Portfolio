\{9459C573-B17A-45AE-9F64-1857B5D58CEE}*") or ((process.executable == "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe" or process.executable == "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe")) or (((registry.path like "*_\\Office\\ClickToRun\\REGISTRY\\MACHINE\\Software\\Classes\\PROTOCOLS\\Handler\\*" or registry.path like "*_\\ClickToRunStore\\HKMU\\SOFTWARE\\Classes\\PROTOCOLS\\Handler\\*")) or ((registry.data.strings == "{314111c7-a502-11d2-bbca-00c04f8ec294}" or registry.data.strings == "{3459B272-CC19-4448-86C9-DDC3B4B2FAD3}" or registry.data.strings == "{42089D2D-912D-4018-9087-2B87803E93FB}" or registry.data.strings == "{5504BE45-A83B-4808-900A-3A5C36E7F77A}" or registry.data.strings == "{807583E5-5146-11D5-A672-00B0D022E945}"))) or ((process.executable startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\" or process.executable startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\") and process.executable endswith "\\OfficeClickToRun.exe"))))
