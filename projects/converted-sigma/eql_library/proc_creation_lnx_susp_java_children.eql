// Title: Suspicious Java Children Processes
// ID: d292e0af-9a18-420c-9525-ec0ac3936892
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-03
// Tags: attack.execution, attack.t1059
// Description: Detects java process spawning suspicious children
// Converted by: Sigma Universal SIEM/EDR CLI

process where (process.parent.executable endswith "/java" and (process.command_line like "*_/bin/sh*" or process.command_line like "*_bash*" or process.command_line like "*_dash*" or process.command_line like "*_ksh*" or process.command_line like "*_zsh*" or process.command_line like "*_csh*" or process.command_line like "*_fish*" or process.command_line like "*_curl*" or process.command_line like "*_wget*" or process.command_line like "*_python*"))
