// Title: Suspicious PowerShell In Registry Run Keys
// ID: 8d85cf08-bf97-4260-ba49-986a2a65129c
// Status: test
// Level: medium
// Author: frack113, Florian Roth (Nextron Systems)
// Date: 2022-03-17
// Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
// Description: Detects potential PowerShell commands or code within registry run keys
// Converted by: Sigma Universal SIEM/EDR CLI

registry where ((registry.path like "*_\\Software\\Microsoft\\Windows\\CurrentVersion\\Run*" or registry.path like "*_\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run*" or registry.path like "*_\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\Run*") and (registry.data.strings like "*_powershell*" or registry.data.strings like "*_pwsh *" or registry.data.strings like "*_FromBase64String*" or registry.data.strings like "*_.DownloadFile(*" or registry.data.strings like "*_.DownloadString(*" or registry.data.strings like "*_ -w hidden *" or registry.data.strings like "*_ -w 1 *" or registry.data.strings like "*_-windowstyle hidden*" or registry.data.strings like "*_-window hidden*" or registry.data.strings like "*_ -nop *" or registry.data.strings like "*_ -encodedcommand *" or registry.data.strings like "*_-ExecutionPolicy Bypass*" or registry.data.strings like "*_Invoke-Expression*" or registry.data.strings like "*_IEX (*" or registry.data.strings like "*_Invoke-Command*" or registry.data.strings like "*_ICM -*" or registry.data.strings like "*_Invoke-WebRequest*" or registry.data.strings like "*_IWR *" or registry.data.strings like "*_Invoke-RestMethod*" or registry.data.strings like "*_IRM *" or registry.data.strings like "*_ -noni *" or registry.data.strings like "*_ -noninteractive *"))
