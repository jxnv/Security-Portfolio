// Title: Suspicious DLL Loaded via CertOC.EXE
// ID: 84232095-ecca-4015-b0d7-7726507ee793
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-15
// Tags: attack.stealth, attack.t1218
// Description: Detects when a user installs certificates by using CertOC.exe to load the target DLL file.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.command_line like "*_ -LoadDLL *") and ((process.executable endswith "\\certoc.exe") or (process.pe.original_file_name == "CertOC.exe")) and ((process.command_line like "*_\\Appdata\\Local\\Temp\\*" or process.command_line like "*_\\Desktop\\*" or process.command_line like "*_\\Downloads\\*" or process.command_line like "*_\\Users\\Public\\*" or process.command_line like "*_C:\\Windows\\Tasks\\*" or process.command_line like "*_C:\\Windows\\Temp\\*")))
