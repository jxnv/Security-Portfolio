// Title: Potential Goopdate.DLL Sideloading
// ID: b6188d2f-b3c4-4d2c-a17d-9706e0851af0
// Status: test
// Level: medium
// Author: X__Junior (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-15
// Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
// Description: Detects potential DLL sideloading of "goopdate.dll", a DLL used by googleupdate.exe
// Converted by: Sigma Universal SIEM/EDR CLI

any where ((ImageLoaded endswith "\\goopdate.dll") and not (((ImageLoaded startswith "C:\\Program Files (x86)\\" or ImageLoaded startswith "C:\\Program Files\\"))) and not ((((process.executable like "*_\\AppData\\Local\\Temp\\GUM*" and process.executable like "*_.tmp\\Dropbox*") and (ImageLoaded like "*_\\AppData\\Local\\Temp\\GUM*" and ImageLoaded like "*_.tmp\\goopdate.dll*")) or ((process.executable like "*_\\AppData\\Local\\Temp\\GUM*" or process.executable like "*_:\\Windows\\SystemTemp\\GUM*") and process.executable endswith ".tmp\\GoogleUpdate.exe" and (ImageLoaded like "*_\\AppData\\Local\\Temp\\GUM*" or ImageLoaded like "*_:\\Windows\\SystemTemp\\GUM*")))))
