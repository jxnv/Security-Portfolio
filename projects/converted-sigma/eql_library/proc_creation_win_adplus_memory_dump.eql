// Title: Potential Adplus.EXE Abuse
// ID: 2f869d59-7f6a-4931-992c-cce556ff2d53
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-09
// Tags: attack.execution, attack.credential-access, attack.t1003.001
// Description: Detects execution of "AdPlus.exe", a binary that is part of the Windows SDK that can be used as a LOLBIN in order to dump process memory and execute arbitrary commands.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_ -hang *" or process.command_line like "*_ -pn *" or process.command_line like "*_ -pmn *" or process.command_line like "*_ -p *" or process.command_line like "*_ -po *" or process.command_line like "*_ -c *" or process.command_line like "*_ -sc *")) and ((process.executable endswith "\\adplus.exe") or (process.pe.original_file_name == "Adplus.exe")))
