// Title: Registry Disable System Restore
// ID: 5de03871-5d46-4539-a82d-3aa992a69a83
// Status: test
// Level: high
// Author: frack113
// Date: 2022-04-04
// Tags: attack.impact, attack.t1490
// Description: Detects the modification of the registry to disable a system restore on the computer
// Converted by: Sigma Universal SIEM/EDR CLI

registry where ((registry.path like "*_\\Policies\\Microsoft\\Windows NT\\SystemRestore*" or registry.path like "*_\\Microsoft\\Windows NT\\CurrentVersion\\SystemRestore*") and (registry.path endswith "DisableConfig" or registry.path endswith "DisableSR") and registry.data.strings == "DWORD (0x00000001)")
