// Title: Suspicious PowerShell Invocations - Specific - ProcessCreation
// ID: 536e2947-3729-478c-9903-745aaffe60d2
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-05
// Tags: attack.stealth
// Description: Detects suspicious PowerShell invocation command parameters
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.command_line like "*_-nop*" and process.command_line like "*_ -w *" and process.command_line like "*_hidden*" and process.command_line like "*_ -c *" and process.command_line like "*_[Convert]::FromBase64String*")) or ((process.command_line like "*_ -w *" and process.command_line like "*_hidden*" and process.command_line like "*_-ep*" and process.command_line like "*_bypass*" and process.command_line like "*_-Enc*")) or ((process.command_line like "*_ -w *" and process.command_line like "*_hidden*" and process.command_line like "*_-noni*" and process.command_line like "*_-nop*" and process.command_line like "*_ -c *" and process.command_line like "*_iex*" and process.command_line like "*_New-Object*")) or ((process.command_line like "*_iex*" and process.command_line like "*_New-Object*" and process.command_line like "*_Net.WebClient*" and process.command_line like "*_.Download*")) or ((process.command_line like "*_powershell*" and process.command_line like "*_reg*" and process.command_line like "*_add*" and process.command_line like "*_\\software\\*")) or ((process.command_line like "*_bypass*" and process.command_line like "*_-noprofile*" and process.command_line like "*_-windowstyle*" and process.command_line like "*_hidden*" and process.command_line like "*_new-object*" and process.command_line like "*_system.net.webclient*" and process.command_line like "*_.download*"))) and not (((process.command_line like "*_(New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1*" or process.command_line like "*_Write-ChocolateyWarning*"))))
