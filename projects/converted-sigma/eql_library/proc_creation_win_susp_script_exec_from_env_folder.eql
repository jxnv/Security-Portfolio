// Title: Script Interpreter Execution From Suspicious Folder
// ID: 1228c958-e64e-4e71-92ad-7d429f4138ba
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-02-08
// Tags: attack.execution, attack.t1059
// Description: Detects suspicious script execution from suspicious directories or folders accessible by environment variables that may indicate malware activity.
// Script interpreters (cscript, wscript, mshta, powershell) executing from folders like Temp, Public, or user profile directories may suggest attempts to evade detection or execute malicious scripts.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.command_line like "*_ -ep bypass *" or process.command_line like "*_ -ExecutionPolicy bypass *" or process.command_line like "*_ -w hidden *" or process.command_line like "*_/e:javascript *" or process.command_line like "*_/e:Jscript *" or process.command_line like "*_/e:vbscript *")) or ((process.executable endswith "\\cscript.exe" or process.executable endswith "\\mshta.exe" or process.executable endswith "\\wscript.exe")) or ((process.pe.original_file_name == "cscript.exe" or process.pe.original_file_name == "mshta.exe" or process.pe.original_file_name == "wscript.exe"))) and (((process.command_line like "*_:\\Perflogs\\*" or process.command_line like "*_:\\Users\\Public\\*" or process.command_line like "*_\\%Public%*" or process.command_line like "*_\\AppData\\Local\\Temp*" or process.command_line like "*_\\AppData\\Roaming\\Temp*" or process.command_line like "*_\\Temporary Internet*" or process.command_line like "*_\\Windows\\Temp*" or process.command_line like "*_\\Start Menu\\Programs\\Startup\\*" or process.command_line like "*_%TEMP%*" or process.command_line like "*_%TMP%*" or process.command_line like "*_%LocalAppData%\\Temp*")) or (((process.command_line like "*_:\\Users\\*" and process.command_line like "*_\\Favorites\\*")) or ((process.command_line like "*_:\\Users\\*" and process.command_line like "*_\\Favourites\\*")) or ((process.command_line like "*_:\\Users\\*" and process.command_line like "*_\\Contacts\\*")) or ((process.command_line like "*_:\\Users\\*" and process.command_line like "*_\\Documents\\*")) or ((process.command_line like "*_:\\Users\\*" and process.command_line like "*_\\Music\\*")) or ((process.command_line like "*_:\\Users\\*" and process.command_line like "*_\\Pictures\\*")) or ((process.command_line like "*_:\\Users\\*" and process.command_line like "*_\\Videos\\*")))) and not (((process.parent.executable == "C:\\Windows\\System32\\Msiexec.exe" or process.parent.executable == "C:\\Windows\\SysWOW64\\Msiexec.exe") and process.executable endswith "\\powershell.exe" and (process.command_line like "*_-NoProfile -ExecutionPolicy Bypass -Command*" and process.command_line like "*_AppData\\Local\\Temp\\*" and process.command_line like "*_Install-Chocolatey.ps1*"))))
