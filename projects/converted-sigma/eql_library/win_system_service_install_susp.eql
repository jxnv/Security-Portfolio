// Title: Suspicious Service Installation
// ID: 1d61f71d-59d2-479e-9562-4ff5f4ead16b
// Status: test
// Level: high
// Author: pH-T (Nextron Systems), Florian Roth (Nextron Systems)
// Date: 2022-03-18
// Tags: attack.persistence, attack.privilege-escalation, car.2013-09-005, attack.t1543.003
// Description: Detects suspicious service installation commands
// Converted by: Sigma Universal SIEM/EDR CLI

any where (winlog.provider_name == "Service Control Manager" and winlog.event_id == 7045 and (ImagePath like "*_ -nop *" or ImagePath like "*_ -sta *" or ImagePath like "*_ -w hidden *" or ImagePath like "*_:\\Temp\\*" or ImagePath like "*_.downloadfile(*" or ImagePath like "*_.downloadstring(*" or ImagePath like "*_\\ADMIN$\\*" or ImagePath like "*_\\Perflogs\\*" or ImagePath like "*_&&*"))
