// Title: PowerShell Script Run in AppData
// ID: ac175779-025a-4f12-98b0-acdaeb77ea85
// Status: test
// Level: medium
// Author: Florian Roth (Nextron Systems), Jonhnathan Ribeiro, oscd.community
// Date: 2019-01-09
// Tags: attack.execution, attack.t1059.001
// Description: Detects a suspicious command line execution that invokes PowerShell with reference to an AppData folder
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_powershell.exe*" or process.command_line like "*_\\powershell*" or process.command_line like "*_\\pwsh*" or process.command_line like "*_pwsh.exe*")) and ((process.command_line like "*_/c *" and process.command_line like "*_\\AppData\\*") and (process.command_line like "*_Local\\*" or process.command_line like "*_Roaming\\*")))
