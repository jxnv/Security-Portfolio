// Title: Malicious Base64 Encoded PowerShell Keywords in Command Lines
// ID: f26c6093-6f14-4b12-800f-0fcb46f5ffd0
// Status: test
// Level: high
// Author: John Lambert (rule)
// Date: 2019-01-16
// Tags: attack.execution, attack.t1059.001
// Description: Detects base64 encoded strings used in hidden malicious PowerShell command lines
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line like "*_AGkAdABzAGEAZABtAGkAbgAgAC8AdAByAGEAbgBzAGYAZQByA*" or process.command_line like "*_aXRzYWRtaW4gL3RyYW5zZmVy*" or process.command_line like "*_IAaQB0AHMAYQBkAG0AaQBuACAALwB0AHIAYQBuAHMAZgBlAHIA*" or process.command_line like "*_JpdHNhZG1pbiAvdHJhbnNmZX*" or process.command_line like "*_YgBpAHQAcwBhAGQAbQBpAG4AIAAvAHQAcgBhAG4AcwBmAGUAcg*" or process.command_line like "*_Yml0c2FkbWluIC90cmFuc2Zlc*" or process.command_line like "*_AGMAaAB1AG4AawBfAHMAaQB6AGUA*" or process.command_line like "*_JABjAGgAdQBuAGsAXwBzAGkAegBlA*" or process.command_line like "*_JGNodW5rX3Npem*" or process.command_line like "*_QAYwBoAHUAbgBrAF8AcwBpAHoAZQ*" or process.command_line like "*_RjaHVua19zaXpl*" or process.command_line like "*_Y2h1bmtfc2l6Z*" or process.command_line like "*_AE8ALgBDAG8AbQBwAHIAZQBzAHMAaQBvAG4A*" or process.command_line like "*_kATwAuAEMAbwBtAHAAcgBlAHMAcwBpAG8Abg*" or process.command_line like "*_lPLkNvbXByZXNzaW9u*" or process.command_line like "*_SQBPAC4AQwBvAG0AcAByAGUAcwBzAGkAbwBuA*" or process.command_line like "*_SU8uQ29tcHJlc3Npb2*" or process.command_line like "*_Ty5Db21wcmVzc2lvb*" or process.command_line like "*_AE8ALgBNAGUAbQBvAHIAeQBTAHQAcgBlAGEAbQ*" or process.command_line like "*_kATwAuAE0AZQBtAG8AcgB5AFMAdAByAGUAYQBtA*" or process.command_line like "*_lPLk1lbW9yeVN0cmVhb*" or process.command_line like "*_SQBPAC4ATQBlAG0AbwByAHkAUwB0AHIAZQBhAG0A*" or process.command_line like "*_SU8uTWVtb3J5U3RyZWFt*" or process.command_line like "*_Ty5NZW1vcnlTdHJlYW*" or process.command_line like "*_4ARwBlAHQAQwBoAHUAbgBrA*" or process.command_line like "*_5HZXRDaHVua*" or process.command_line like "*_AEcAZQB0AEMAaAB1AG4Aaw*" or process.command_line like "*_LgBHAGUAdABDAGgAdQBuAGsA*" or process.command_line like "*_LkdldENodW5r*" or process.command_line like "*_R2V0Q2h1bm*" or process.command_line like "*_AEgAUgBFAEEARABfAEkATgBGAE8ANgA0A*" or process.command_line like "*_QASABSAEUAQQBEAF8ASQBOAEYATwA2ADQA*" or process.command_line like "*_RIUkVBRF9JTkZPNj*" or process.command_line like "*_SFJFQURfSU5GTzY0*" or process.command_line like "*_VABIAFIARQBBAEQAXwBJAE4ARgBPADYANA*" or process.command_line like "*_VEhSRUFEX0lORk82N*" or process.command_line like "*_AHIAZQBhAHQAZQBSAGUAbQBvAHQAZQBUAGgAcgBlAGEAZA*" or process.command_line like "*_cmVhdGVSZW1vdGVUaHJlYW*" or process.command_line like "*_MAcgBlAGEAdABlAFIAZQBtAG8AdABlAFQAaAByAGUAYQBkA*" or process.command_line like "*_NyZWF0ZVJlbW90ZVRocmVhZ*" or process.command_line like "*_Q3JlYXRlUmVtb3RlVGhyZWFk*" or process.command_line like "*_QwByAGUAYQB0AGUAUgBlAG0AbwB0AGUAVABoAHIAZQBhAGQA*" or process.command_line like "*_0AZQBtAG0AbwB2AGUA*" or process.command_line like "*_1lbW1vdm*" or process.command_line like "*_AGUAbQBtAG8AdgBlA*" or process.command_line like "*_bQBlAG0AbQBvAHYAZQ*" or process.command_line like "*_bWVtbW92Z*" or process.command_line like "*_ZW1tb3Zl*")) and (process.command_line like "*_ hidden *") and (((process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe")) or ((process.pe.original_file_name == "PowerShell.EXE" or process.pe.original_file_name == "pwsh.dll"))))
