// Title: Unusual Parent Process For Cmd.EXE
// ID: 4b991083-3d0e-44ce-8fc4-b254025d8d4b
// Status: test
// Level: medium
// Author: Tim Rauch, Elastic (idea)
// Date: 2022-09-21
// Tags: attack.execution, attack.t1059
// Description: Detects suspicious parent process for cmd.exe
// Converted by: Sigma Universal SIEM/EDR CLI

process where (process.executable endswith "\\cmd.exe" and (process.parent.executable endswith "\\csrss.exe" or process.parent.executable endswith "\\ctfmon.exe" or process.parent.executable endswith "\\dllhost.exe" or process.parent.executable endswith "\\epad.exe" or process.parent.executable endswith "\\FlashPlayerUpdateService.exe" or process.parent.executable endswith "\\GoogleUpdate.exe" or process.parent.executable endswith "\\jucheck.exe" or process.parent.executable endswith "\\jusched.exe" or process.parent.executable endswith "\\LogonUI.exe" or process.parent.executable endswith "\\lsass.exe" or process.parent.executable endswith "\\regsvr32.exe" or process.parent.executable endswith "\\SearchIndexer.exe" or process.parent.executable endswith "\\SearchProtocolHost.exe" or process.parent.executable endswith "\\SIHClient.exe" or process.parent.executable endswith "\\sihost.exe" or process.parent.executable endswith "\\slui.exe" or process.parent.executable endswith "\\spoolsv.exe" or process.parent.executable endswith "\\sppsvc.exe" or process.parent.executable endswith "\\taskhostw.exe" or process.parent.executable endswith "\\unsecapp.exe" or process.parent.executable endswith "\\WerFault.exe" or process.parent.executable endswith "\\wermgr.exe" or process.parent.executable endswith "\\wlanext.exe" or process.parent.executable endswith "\\WUDFHost.exe"))
