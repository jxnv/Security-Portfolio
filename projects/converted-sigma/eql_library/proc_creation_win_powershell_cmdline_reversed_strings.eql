// Title: Potential PowerShell Obfuscation Via Reversed Commands
// ID: b6b49cd1-34d6-4ead-b1bf-176e9edba9a4
// Status: test
// Level: high
// Author: Teymur Kheirkhabarov (idea), Vasiliy Burov (rule), oscd.community, Tim Shelton
// Date: 2020-10-11
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects the presence of reversed PowerShell commands in the CommandLine. This is often used as a method of obfuscation by attackers
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((((process.command_line like "*_hctac*" or process.command_line like "*_kaerb*" or process.command_line like "*_dnammoc*" or process.command_line like "*_ekovn*" or process.command_line like "*_eliFd*" or process.command_line like "*_rahc*" or process.command_line like "*_etirw*" or process.command_line like "*_golon*" or process.command_line like "*_tninon*" or process.command_line like "*_eddih*" or process.command_line like "*_tpircS*" or process.command_line like "*_ssecorp*" or process.command_line like "*_llehsrewop*" or process.command_line like "*_esnopser*" or process.command_line like "*_daolnwod*" or process.command_line like "*_tneilCbeW*" or process.command_line like "*_tneilc*" or process.command_line like "*_ptth*" or process.command_line like "*_elifotevas*" or process.command_line like "*_46esab*" or process.command_line like "*_htaPpmeTteG*" or process.command_line like "*_tcejbO*" or process.command_line like "*_maerts*" or process.command_line like "*_hcaerof*" or process.command_line like "*_retupmoc*")) and (((process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe")) or ((process.pe.original_file_name == "PowerShell.EXE" or process.pe.original_file_name == "pwsh.dll")))) and not (((process.command_line like "*_ -EncodedCommand *" or process.command_line like "*_ -enc *"))))
