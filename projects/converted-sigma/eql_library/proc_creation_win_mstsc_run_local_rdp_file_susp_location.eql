// Title: Suspicious Mstsc.EXE Execution With Local RDP File
// ID: 6e22722b-dfb1-4508-a911-49ac840b40f8
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-18
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects potential RDP connection via Mstsc using a local ".rdp" file located in suspicious locations.
// Converted by: Sigma Universal SIEM/EDR CLI

process where (((process.command_line endswith ".rdp" or process.command_line endswith ".rdp\"")) and ((process.executable endswith "\\mstsc.exe") or (process.pe.original_file_name == "mstsc.exe")) and ((process.command_line like "*_:\\Users\\Public\\*" or process.command_line like "*_:\\Windows\\System32\\spool\\drivers\\color*" or process.command_line like "*_:\\Windows\\System32\\Tasks_Migrated *" or process.command_line like "*_:\\Windows\\Tasks\\*" or process.command_line like "*_:\\Windows\\Temp\\*" or process.command_line like "*_:\\Windows\\Tracing\\*" or process.command_line like "*_\\AppData\\Local\\Temp\\*" or process.command_line like "*_\\Downloads\\*")))
