// Title: Potential COM Object Hijacking Via TreatAs Subkey - Registry
// ID: 9b0f8a61-91b2-464f-aceb-0527e0a45020
// Status: test
// Level: medium
// Author: Kutepov Anton, oscd.community
// Date: 2019-10-23
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.015
// Description: Detects COM object hijacking via TreatAs subkey
// Converted by: Sigma Universal SIEM/EDR CLI

registry where (((registry.path like "*_HKU\\*" and registry.path like "*_Classes\\CLSID\\*" and registry.path like "*_\\TreatAs*")) and not ((process.executable == "C:\\WINDOWS\\system32\\svchost.exe")))
