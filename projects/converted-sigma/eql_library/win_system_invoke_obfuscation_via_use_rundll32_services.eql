// Title: Invoke-Obfuscation Via Use Rundll32 - System
// ID: 641a4bfb-c017-44f7-800c-2aee0184ce9b
// Status: test
// Level: high
// Author: Nikita Nazarov, oscd.community
// Date: 2020-10-09
// Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
// Description: Detects Obfuscated Powershell via use Rundll32 in Scripts
// Converted by: Sigma Universal SIEM/EDR CLI

any where (winlog.provider_name == "Service Control Manager" and winlog.event_id == 7045 and (ImagePath like "*_&&*" and ImagePath like "*_rundll32*" and ImagePath like "*_shell32.dll*" and ImagePath like "*_shellexec_rundll*") and (ImagePath like "*_value*" or ImagePath like "*_invoke*" or ImagePath like "*_comspec*" or ImagePath like "*_iex*"))
