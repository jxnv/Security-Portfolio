// Title: Potential Persistence Via App Paths Default Property
// ID: 707e097c-e20f-4f67-8807-1f72ff4500d6
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-10
// Tags: attack.privilege-escalation, attack.persistence, attack.t1546.012
// Description: Detects changes to the "Default" property for keys located in the \Software\Microsoft\Windows\CurrentVersion\App Paths\ registry. Which might be used as a method of persistence
// The entries found under App Paths are used primarily for the following purposes.
// First, to map an application's executable file name to that file's fully qualified path.
// Second, to prepend information to the PATH environment variable on a per-application, per-process basis.
// Converted by: Sigma Universal SIEM/EDR CLI

registry where (registry.path like "*_\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths*" and (registry.path endswith "(Default)" or registry.path endswith "Path") and (registry.data.strings like "*_\\Users\\Public*" or registry.data.strings like "*_\\AppData\\Local\\Temp\\*" or registry.data.strings like "*_\\Windows\\Temp\\*" or registry.data.strings like "*_\\Desktop\\*" or registry.data.strings like "*_\\Downloads\\*" or registry.data.strings like "*_%temp%*" or registry.data.strings like "*_%tmp%*" or registry.data.strings like "*_iex*" or registry.data.strings like "*_Invoke-*" or registry.data.strings like "*_rundll32*" or registry.data.strings like "*_regsvr32*" or registry.data.strings like "*_mshta*" or registry.data.strings like "*_cscript*" or registry.data.strings like "*_wscript*" or registry.data.strings like "*_.bat*" or registry.data.strings like "*_.hta*" or registry.data.strings like "*_.dll*" or registry.data.strings like "*_.ps1*"))
