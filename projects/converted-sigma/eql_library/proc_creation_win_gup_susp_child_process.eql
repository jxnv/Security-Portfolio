// Title: Suspicious Child Process of Notepad++ Updater - GUP.Exe
// ID: bb0e87ce-c89f-4857-84fa-095e4483e9cb
// Status: experimental
// Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-02-03
// Tags: attack.collection, attack.credential-access, attack.t1195.002, attack.initial-access, attack.t1557
// Description: Detects suspicious child process creation by the Notepad++ updater process (gup.exe).
// This could indicate potential exploitation of the updater component to deliver unwanted malware.
// Converted by: Sigma Universal SIEM/EDR CLI

process where ((process.parent.executable endswith "\\gup.exe") and (((process.command_line like "*_bitsadmin*" or process.command_line like "*_certutil*" or process.command_line like "*_curl*" or process.command_line like "*_finger*" or process.command_line like "*_forfiles*" or process.command_line like "*_regsvr32*" or process.command_line like "*_rundll32*" or process.command_line like "*_wget*")) or ((process.executable endswith "\\cmd.exe" or process.executable endswith "\\powershell.exe" or process.executable endswith "\\pwsh.exe" or process.executable endswith "\\cscript.exe" or process.executable endswith "\\wscript.exe" or process.executable endswith "\\mshta.exe"))))
