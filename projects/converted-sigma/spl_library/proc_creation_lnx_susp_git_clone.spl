# Title: Suspicious Git Clone - Linux
# ID: cfec9d29-64ec-4a0f-9ffe-0fdb856d5446
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-01-03
# Tags: attack.reconnaissance, attack.t1593.003
# Description: Detects execution of "git" in order to clone a remote repository that contain suspicious keywords which might be suspicious
# Converted by: Sigma Universal SIEM/EDR CLI

index=* sourcetype="syslog" ((process_path="*/git" AND process_exec="* clone *") AND ((process_exec="*exploit*" OR process_exec="*Vulns*" OR process_exec="*vulnerability*" OR process_exec="*RCE*" OR process_exec="*RemoteCodeExecution*" OR process_exec="*Invoke-*" OR process_exec="*CVE-*" OR process_exec="*poc-*" OR process_exec="*ProofOfConcept*" OR process_exec="*proxyshell*" OR process_exec="*log4shell*" OR process_exec="*eternalblue*" OR process_exec="*eternal-blue*" OR process_exec="*MS17-*")))
