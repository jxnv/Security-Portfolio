# Title: Suspicious Processes Spawned by Java.EXE
# ID: 0d34ed8b-1c12-4ff2-828c-16fc860b766d
# Status: test
# Level: high
# Author: Andreas Hunkeler (@Karneades), Florian Roth
# Date: 2021-12-17
# Tags: attack.initial-access, attack.persistence, attack.privilege-escalation
# Description: Detects suspicious processes spawned from a Java host process which could indicate a sign of exploitation (e.g. log4j)
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (parent_process_path="*\\java.exe" AND (process_path="*\\AppVLP.exe" OR process_path="*\\bitsadmin.exe" OR process_path="*\\certutil.exe" OR process_path="*\\cscript.exe" OR process_path="*\\curl.exe" OR process_path="*\\forfiles.exe" OR process_path="*\\hh.exe" OR process_path="*\\mftrace.exe" OR process_path="*\\mshta.exe" OR process_path="*\\net.exe" OR process_path="*\\net1.exe" OR process_path="*\\query.exe" OR process_path="*\\reg.exe" OR process_path="*\\regsvr32.exe" OR process_path="*\\rundll32.exe" OR process_path="*\\schtasks.exe" OR process_path="*\\scrcons.exe" OR process_path="*\\scriptrunner.exe" OR process_path="*\\sh.exe" OR process_path="*\\systeminfo.exe" OR process_path="*\\whoami.exe" OR process_path="*\\wmic.exe" OR process_path="*\\wscript.exe"))
