# Title: Execution Of Script Located In Potentially Suspicious Directory
# ID: 30bcce26-51c5-49f2-99c8-7b59e3af36c7
# Status: test
# Level: medium
# Author: Joseliyo Sanchez, @Joseliyo_Jstnk
# Date: 2023-06-02
# Tags: attack.execution
# Description: Detects executions of scripts located in potentially suspicious locations such as "/tmp" via a shell such as "bash", "sh", etc.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* sourcetype="syslog" ((process_exec="* -c *") AND ((process_path="*/bash" OR process_path="*/csh" OR process_path="*/dash" OR process_path="*/fish" OR process_path="*/ksh" OR process_path="*/sh" OR process_path="*/zsh")) AND (process_exec="*/tmp/*"))
