# Title: Execute From Alternate Data Streams
# ID: 7f43c430-5001-4f8b-aaa9-c3b88f18fa5c
# Status: test
# Level: medium
# Author: frack113
# Date: 2021-09-01
# Tags: attack.stealth, attack.t1564.004
# Description: Detects execution from an Alternate Data Stream (ADS). Adversaries may use NTFS file attributes to hide their malicious data in order to evade detection
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((process_exec="*txt:*") AND (((process_exec="*esentutl *" AND process_exec="* /y *" AND process_exec="* /d *" AND process_exec="* /o *")) OR ((process_exec="*makecab *" AND process_exec="*.cab*")) OR ((process_exec="*reg *" AND process_exec="* export *")) OR ((process_exec="*regedit *" AND process_exec="* /E *")) OR ((process_exec="*type *" AND process_exec="* > *"))))
