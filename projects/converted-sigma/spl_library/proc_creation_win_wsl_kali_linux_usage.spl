# Title: WSL Kali-Linux Usage
# ID: 6f1a11aa-4b8a-4b7f-9e13-4d3e4ff0e0d4
# Status: experimental
# Level: high
# Author: Swachchhanda Shrawan Poudel (Nextron Systems)
# Date: 2025-10-10
# Tags: attack.stealth, attack.t1202
# Description: Detects the use of Kali Linux through Windows Subsystem for Linux
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((((process_path="*:\\Users\\*" AND process_path="*\\AppData\\Local\\packages\\KaliLinux*")) OR ((process_path="*:\\Users\\*" AND process_path="*\\AppData\\Local\\Microsoft\\WindowsApps\\kali.exe*"))) OR (process_path="*:\\Program Files\\WindowsApps\\KaliLinux.*" AND process_path="*\\kali.exe")) OR (((((process_path="*\\kali.exe*" OR process_path="*\\KaliLinux*")) OR ((process_exec="*Kali.exe*" OR process_exec="*Kali-linux*" OR process_exec="*kalilinux*"))) AND ((parent_process_path="*\\wsl.exe" OR parent_process_path="*\\wslhost.exe"))) AND NOT (((process_exec="* -i *" OR process_exec="* --install *" OR process_exec="* --unregister *")))))
