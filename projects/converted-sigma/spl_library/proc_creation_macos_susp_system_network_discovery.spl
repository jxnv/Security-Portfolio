# Tags: attack.discovery, attack.t1016
# Description: Detects enumeration of local network configuration
# Converted by: Sigma Universal SIEM/EDR CLI

index=* ((((process_path="*/arp" OR process_path="*/ifconfig" OR process_path="*/netstat" OR process_path="*/networksetup" OR process_path="*/socketfilterfw")) OR (process_path="/usr/bin/defaults" AND (process_exec="*/Library/Preferences/com.apple.alf*" AND process_exec="*read*"))) AND NOT ((parent_process_path="*/wifivelocityd")))
