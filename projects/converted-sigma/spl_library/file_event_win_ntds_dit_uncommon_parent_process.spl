# Title: NTDS.DIT Creation By Uncommon Parent Process
# ID: 4e7050dd-e548-483f-b7d6-527ab4fa784d
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-03-11
# Tags: attack.credential-access, attack.t1003.003
# Description: Detects creation of a file named "ntds.dit" (Active Directory Database) by an uncommon parent process or directory
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((file_name="*\\ntds.dit") AND (((parent_process_path="*\\cscript.exe" OR parent_process_path="*\\httpd.exe" OR parent_process_path="*\\nginx.exe" OR parent_process_path="*\\php-cgi.exe" OR parent_process_path="*\\powershell.exe" OR parent_process_path="*\\pwsh.exe" OR parent_process_path="*\\w3wp.exe" OR parent_process_path="*\\wscript.exe")) OR ((parent_process_path="*\\apache*" OR parent_process_path="*\\tomcat*" OR parent_process_path="*\\AppData\\*" OR parent_process_path="*\\Temp\\*" OR parent_process_path="*\\Public\\*" OR parent_process_path="*\\PerfLogs\\*"))))
