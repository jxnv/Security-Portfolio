# Title: Alternate PowerShell Hosts Pipe
# ID: 58cb02d5-78ce-4692-b3e1-dce850aae41a
# Status: test
# Level: medium
# Author: Roberto Rodriguez @Cyb3rWard0g, Tim Shelton
# Date: 2019-09-12
# Tags: attack.execution, attack.t1059.001
# Description: Detects alternate PowerShell hosts potentially bypassing detections looking for powershell.exe
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((PipeName="\\PSHost*") AND NOT (((((process_path="*:\\Program Files\\PowerShell\\7-preview\\pwsh.exe*" OR process_path="*:\\Program Files\\PowerShell\\7\\pwsh.exe*" OR process_path="*:\\Windows\\system32\\dsac.exe*" OR process_path="*:\\Windows\\system32\\inetsrv\\w3wp.exe*" OR process_path="*:\\Windows\\System32\\sdiagnhost.exe*" OR process_path="*:\\Windows\\system32\\ServerManager.exe*" OR process_path="*:\\Windows\\system32\\wbem\\wmiprvse.exe*" OR process_path="*:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe*" OR process_path="*:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe*" OR process_path="*:\\Windows\\System32\\wsmprovhost.exe*" OR process_path="*:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe*" OR process_path="*:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe*")) OR ((process_path="*C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview*" AND process_path="*\\pwsh.exe*")) OR ((process_path="*\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview*" AND process_path="*\\pwsh.exe*"))) OR (NOT process_path=*))) AND NOT (((process_path="C:\\Program Files\\AzureConnectedMachineAgent\\GCArcService*" AND process_path="*\\GC\\gc_worker.exe") OR (process_path="C:\\Program Files\\Citrix\\*") OR (process_path="C:\\Program Files\\Microsoft\\Exchange Server\\*") OR ((process_path="C:\\Program Files (x86)\\*" OR process_path="C:\\Program Files\\*") AND process_path="*\\Microsoft SQL Server\\*" AND process_path="*\\Tools\\Binn\\SQLPS.exe"))))
