# Title: Suspicious Curl.EXE Download
# ID: e218595b-bbe7-4ee5-8a96-f32a24ad3468
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
# Date: 2020-07-03
# Tags: attack.command-and-control, attack.t1105
# Description: Detects a suspicious curl process start on Windows and outputs the requested document to a local file
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_path="*\\curl.exe") OR (Product="The curl executable")) AND (((process_exec="*.dll" OR process_exec="*.gif" OR process_exec="*.jpeg" OR process_exec="*.jpg" OR process_exec="*.png" OR process_exec="*.temp" OR process_exec="*.tmp" OR process_exec="*.txt" OR process_exec="*.vbe" OR process_exec="*.vbs")) OR ((process_exec="*%AppData%*" OR process_exec="*%Public%*" OR process_exec="*%Temp%*" OR process_exec="*%tmp%*" OR process_exec="*\\AppData\\*" OR process_exec="*\\Desktop\\*" OR process_exec="*\\Temp\\*" OR process_exec="*\\Users\\Public\\*" OR process_exec="*C:\\PerfLogs\\*" OR process_exec="*C:\\ProgramData\\*" OR process_exec="*C:\\Windows\\Temp\\*"))) AND NOT ((parent_process_path="C:\\Program Files\\Git\\usr\\bin\\sh.exe" AND process_path="C:\\Program Files\\Git\\mingw64\\bin\\curl.exe" AND (process_exec="*--silent --show-error --output *" AND process_exec="*gfw-httpget-*" AND process_exec="*AppData*"))))
