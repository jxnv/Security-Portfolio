# Title: Files With System Process Name In Unsuspected Locations
# ID: d5866ddf-ce8f-4aea-b28e-d96485a20d3d
# Status: test
# Level: medium
# Author: Sander Wiebing, Tim Shelton, Nasreddine Bencherchali (Nextron Systems)
# Date: 2020-05-26
# Tags: attack.stealth, attack.t1036.005
# Description: Detects the creation of an executable with a system process name in folders other than the system ones (System32, SysWOW64, etc.).
# It is highly recommended to perform an initial baseline before using this rule in production.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((file_name="*\\AtBroker.exe" OR file_name="*\\audiodg.exe" OR file_name="*\\backgroundTaskHost.exe" OR file_name="*\\bcdedit.exe" OR file_name="*\\bitsadmin.exe" OR file_name="*\\cmdl32.exe" OR file_name="*\\cmstp.exe" OR file_name="*\\conhost.exe" OR file_name="*\\csrss.exe" OR file_name="*\\dasHost.exe" OR file_name="*\\dfrgui.exe" OR file_name="*\\dllhost.exe" OR file_name="*\\dwm.exe" OR file_name="*\\eventcreate.exe" OR file_name="*\\eventvwr.exe" OR file_name="*\\explorer.exe" OR file_name="*\\extrac32.exe" OR file_name="*\\fontdrvhost.exe" OR file_name="*\\fsquirt.exe" OR file_name="*\\ipconfig.exe" OR file_name="*\\iscsicli.exe" OR file_name="*\\iscsicpl.exe" OR file_name="*\\logman.exe" OR file_name="*\\LogonUI.exe" OR file_name="*\\LsaIso.exe" OR file_name="*\\lsass.exe" OR file_name="*\\lsm.exe" OR file_name="*\\msiexec.exe" OR file_name="*\\msinfo32.exe" OR file_name="*\\mstsc.exe" OR file_name="*\\nbtstat.exe" OR file_name="*\\odbcconf.exe" OR file_name="*\\powershell.exe" OR file_name="*\\pwsh.exe" OR file_name="*\\regini.exe" OR file_name="*\\regsvr32.exe" OR file_name="*\\rundll32.exe" OR file_name="*\\RuntimeBroker.exe" OR file_name="*\\schtasks.exe" OR file_name="*\\SearchFilterHost.exe" OR file_name="*\\SearchIndexer.exe" OR file_name="*\\SearchProtocolHost.exe" OR file_name="*\\SecurityHealthService.exe" OR file_name="*\\SecurityHealthSystray.exe" OR file_name="*\\services.exe" OR file_name="*\\ShellAppRuntime.exe" OR file_name="*\\sihost.exe" OR file_name="*\\smartscreen.exe" OR file_name="*\\smss.exe" OR file_name="*\\spoolsv.exe" OR file_name="*\\svchost.exe" OR file_name="*\\SystemSettingsBroker.exe" OR file_name="*\\taskhost.exe" OR file_name="*\\taskhostw.exe" OR file_name="*\\Taskmgr.exe" OR file_name="*\\TiWorker.exe" OR file_name="*\\vssadmin.exe" OR file_name="*\\w32tm.exe" OR file_name="*\\WerFault.exe" OR file_name="*\\WerFaultSecure.exe" OR file_name="*\\wermgr.exe" OR file_name="*\\wevtutil.exe" OR file_name="*\\wininit.exe" OR file_name="*\\winlogon.exe" OR file_name="*\\winrshost.exe" OR file_name="*\\WinRTNetMUAHostServer.exe" OR file_name="*\\wlanext.exe" OR file_name="*\\wlrmdr.exe" OR file_name="*\\WmiPrvSE.exe" OR file_name="*\\wslhost.exe" OR file_name="*\\WSReset.exe" OR file_name="*\\WUDFHost.exe" OR file_name="*\\WWAHost.exe")) AND NOT (((file_name="*C:\\Windows\\explorer.exe") OR ((file_name="*C:\\$WINDOWS.~BT\\*" OR file_name="*C:\\$WinREAgent\\*" OR file_name="*C:\\Windows\\SoftwareDistribution\\*" OR file_name="*C:\\Windows\\System32\\*" OR file_name="*C:\\Windows\\SysWOW64\\*" OR file_name="*C:\\Windows\\WinSxS\\*" OR file_name="*C:\\Windows\\uus\\*")) OR (file_name="*C:\\Windows\\System32\\SecurityHealth\\*" AND file_name="*\\SecurityHealthSystray.exe" AND process_path="*\\SecurityHealthSetup.exe") OR ((process_path="*C:\\WINDOWS\\system32\\msiexec.exe" OR process_path="*C:\\WINDOWS\\SysWOW64\\msiexec.exe") AND (file_name="C:\\Program Files\\PowerShell\\7\\pwsh.exe*" OR file_name="C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe*" OR file_name="C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview\\*")) OR ((process_path="*C:\\Windows\\system32\\svchost.exe" OR process_path="*C:\\Windows\\SysWOW64\\svchost.exe") AND (file_name="*C:\\Program Files\\WindowsApps\\*" OR file_name="*C:\\Program Files (x86)\\WindowsApps\\*" OR file_name="*\\AppData\\Local\\Microsoft\\WindowsApps\\*")) OR ((process_path="*\\TiWorker.exe" OR process_path="*\\wuaucltcore.exe") AND file_name="C:\\Windows\\Temp\\*") OR ((process_path="C:\\Windows\\System32\\wuauclt.exe" OR process_path="C:\\Windows\\SysWOW64\\wuauclt.exe" OR process_path="C:\\Windows\\UUS\\arm64\\wuaucltcore.exe")))) AND NOT (((file_name="C:\\Program Files\\WSL\\wslhost.exe") OR ((file_name="*C:\\Program Files\\WindowsApps\\MicrosoftCorporationII.WindowsSubsystemForLinux_*" AND file_name="*\\wslhost.exe*")) OR ((file_name="*C:\\Users\\*" AND file_name="*\\AppData\\Local\\Microsoft\\WindowsApps\\*" AND file_name="*\\wslhost.exe*")))))
