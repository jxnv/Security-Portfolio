# Title: Process Creation Using Sysnative Folder
# ID: 3c1b5fb0-c72f-45ba-abd1-4d4c353144ab
# Status: test
# Level: medium
# Author: Max Altgelt (Nextron Systems)
# Date: 2022-08-23
# Tags: attack.privilege-escalation, attack.stealth, attack.t1055
# Description: Detects process creation events that use the Sysnative folder (common for CobaltStrike spawns)
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="*:\\Windows\\Sysnative\\*") OR (process_path="*:\\Windows\\Sysnative\\*")) AND NOT (((process_path="*C:\\Windows\\Microsoft.NET\\Framework64\\v*" OR process_path="*C:\\Windows\\Microsoft.NET\\Framework\\v*" OR process_path="*C:\\Windows\\Microsoft.NET\\FrameworkArm\\v*" OR process_path="*C:\\Windows\\Microsoft.NET\\FrameworkArm64\\v*") AND process_path="*\\ngen.exe" AND process_exec="*install*")) AND NOT (((process_exec="*\"C:\\Windows\\sysnative\\cmd.exe\"*" AND process_exec="*\\xampp\\*" AND process_exec="*\\catalina_start.bat*"))))
