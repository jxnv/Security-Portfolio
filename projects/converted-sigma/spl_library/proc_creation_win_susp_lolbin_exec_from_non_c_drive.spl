# Title: LOLBIN Execution From Abnormal Drive
# ID: d4ca7c59-e9e4-42d8-bf57-91a776efcb87
# Status: test
# Level: medium
# Author: Christopher Peacock '@securepeacock', SCYTHE '@scythe_io', Angelo Violetti - SEC Consult '@angelo_violetti', Aaron Herman
# Date: 2022-01-25
# Tags: attack.stealth
# Description: Detects LOLBINs executing from an abnormal or uncommon drive such as a mounted ISO.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((process_path="*\\calc.exe" OR process_path="*\\certutil.exe" OR process_path="*\\cmstp.exe" OR process_path="*\\cscript.exe" OR process_path="*\\installutil.exe" OR process_path="*\\mshta.exe" OR process_path="*\\regsvr32.exe" OR process_path="*\\rundll32.exe" OR process_path="*\\wscript.exe")) OR ((process_name="CALC.EXE" OR process_name="CertUtil.exe" OR process_name="CMSTP.EXE" OR process_name="cscript.exe" OR process_name="installutil.exe" OR process_name="MSHTA.EXE" OR process_name="REGSVR32.EXE" OR process_name="RUNDLL32.EXE" OR process_name="wscript.exe"))) AND NOT (((CurrentDirectory="*C:\\*") OR (CurrentDirectory="") OR (NOT CurrentDirectory=*))))
