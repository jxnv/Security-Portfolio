# Title: Suspicious Parent Double Extension File Execution
# ID: 5e6a80c8-2d45-4633-9ef4-fa2671a39c5c
# Status: test
# Level: high
# Author: frack113, Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-01-06
# Tags: attack.stealth, attack.t1036.007
# Description: Detect execution of suspicious double extension files in ParentCommandLine
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((parent_process_path="*.doc.lnk" OR parent_process_path="*.docx.lnk" OR parent_process_path="*.xls.lnk" OR parent_process_path="*.xlsx.lnk" OR parent_process_path="*.ppt.lnk" OR parent_process_path="*.pptx.lnk" OR parent_process_path="*.rtf.lnk" OR parent_process_path="*.pdf.lnk" OR parent_process_path="*.txt.lnk" OR parent_process_path="*.doc.js" OR parent_process_path="*.docx.js" OR parent_process_path="*.xls.js" OR parent_process_path="*.xlsx.js" OR parent_process_path="*.ppt.js" OR parent_process_path="*.pptx.js" OR parent_process_path="*.rtf.js" OR parent_process_path="*.pdf.js" OR parent_process_path="*.txt.js")) OR ((parent_process_exec="*.doc.lnk*" OR parent_process_exec="*.docx.lnk*" OR parent_process_exec="*.xls.lnk*" OR parent_process_exec="*.xlsx.lnk*" OR parent_process_exec="*.ppt.lnk*" OR parent_process_exec="*.pptx.lnk*" OR parent_process_exec="*.rtf.lnk*" OR parent_process_exec="*.pdf.lnk*" OR parent_process_exec="*.txt.lnk*" OR parent_process_exec="*.doc.js*" OR parent_process_exec="*.docx.js*" OR parent_process_exec="*.xls.js*" OR parent_process_exec="*.xlsx.js*" OR parent_process_exec="*.ppt.js*" OR parent_process_exec="*.pptx.js*" OR parent_process_exec="*.rtf.js*" OR parent_process_exec="*.pdf.js*" OR parent_process_exec="*.txt.js*")))
