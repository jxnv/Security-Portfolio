# Title: PUA - PingCastle Execution From Potentially Suspicious Parent
# ID: b37998de-a70b-4f33-b219-ec36bf433dc0
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
# Date: 2024-01-11
# Tags: attack.reconnaissance, attack.t1595
# Description: Detects the execution of PingCastle, a tool designed to quickly assess the Active Directory security level via a script located in a potentially suspicious or uncommon location.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((parent_process_exec="*.bat*" OR parent_process_exec="*.chm*" OR parent_process_exec="*.cmd*" OR parent_process_exec="*.hta*" OR parent_process_exec="*.htm*" OR parent_process_exec="*.html*" OR parent_process_exec="*.js*" OR parent_process_exec="*.lnk*" OR parent_process_exec="*.ps1*" OR parent_process_exec="*.vbe*" OR parent_process_exec="*.vbs*" OR parent_process_exec="*.wsf*")) OR ((parent_process_exec="*:\\Perflogs\\*" OR parent_process_exec="*:\\Temp\\*" OR parent_process_exec="*:\\Users\\Public\\*" OR parent_process_exec="*:\\Windows\\Temp\\*" OR parent_process_exec="*\\AppData\\Local\\Temp*" OR parent_process_exec="*\\AppData\\Roaming\\*" OR parent_process_exec="*\\Temporary Internet*")) OR (((parent_process_exec="*:\\Users\\*" AND parent_process_exec="*\\Favorites\\*")) OR ((parent_process_exec="*:\\Users\\*" AND parent_process_exec="*\\Favourites\\*")) OR ((parent_process_exec="*:\\Users\\*" AND parent_process_exec="*\\Contacts\\*")))) AND ((parent_process_exec="*.bat*" OR parent_process_exec="*.chm*" OR parent_process_exec="*.cmd*" OR parent_process_exec="*.hta*" OR parent_process_exec="*.htm*" OR parent_process_exec="*.html*" OR parent_process_exec="*.js*" OR parent_process_exec="*.lnk*" OR parent_process_exec="*.ps1*" OR parent_process_exec="*.vbe*" OR parent_process_exec="*.vbs*" OR parent_process_exec="*.wsf*")) AND ((process_path="*\\PingCastle.exe") OR (process_name="PingCastle.exe") OR (Product="Ping Castle") OR ((process_exec="*--scanner aclcheck*" OR process_exec="*--scanner antivirus*" OR process_exec="*--scanner computerversion*" OR process_exec="*--scanner foreignusers*" OR process_exec="*--scanner laps_bitlocker*" OR process_exec="*--scanner localadmin*" OR process_exec="*--scanner nullsession*" OR process_exec="*--scanner nullsession-trust*" OR process_exec="*--scanner oxidbindings*" OR process_exec="*--scanner remote*" OR process_exec="*--scanner share*" OR process_exec="*--scanner smb*" OR process_exec="*--scanner smb3querynetwork*" OR process_exec="*--scanner spooler*" OR process_exec="*--scanner startup*" OR process_exec="*--scanner zerologon*")) OR (process_exec="*--no-enum-limit*") OR ((process_exec="*--healthcheck*" AND process_exec="*--level Full*")) OR ((process_exec="*--healthcheck*" AND process_exec="*--server *"))))
