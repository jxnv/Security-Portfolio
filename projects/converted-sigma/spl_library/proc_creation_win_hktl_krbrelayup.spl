# Title: HackTool - KrbRelayUp Execution
# ID: 12827a56-61a4-476a-a9cb-f3068f191073
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-04-26
# Tags: attack.credential-access, attack.t1558.003, attack.lateral-movement, attack.t1550.003
# Description: Detects KrbRelayUp used to perform a universal no-fix local privilege escalation in Windows domain environments where LDAP signing is not enforced
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="* relay *" AND process_exec="* -Domain *" AND process_exec="* -ComputerName *")) OR ((process_exec="* krbscm *" AND process_exec="* -sc *")) OR ((process_exec="* spawn *" AND process_exec="* -d *" AND process_exec="* -cn *" AND process_exec="* -cp *")) OR ((process_path="*\\KrbRelayUp.exe") OR (process_name="KrbRelayUp.exe")))
