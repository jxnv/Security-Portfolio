# Title: New RUN Key Pointing to Suspicious Folder
# ID: 02ee49e2-e294-4d0f-9278-f5b3212fc588
# Status: experimental
# Level: high
# Author: Florian Roth (Nextron Systems), Markus Neis, Sander Wiebing, Swachchhanda Shrawan Poudel (Nextron Systems)
# Date: 2018-08-25
# Tags: attack.privilege-escalation, attack.persistence, attack.t1547.001
# Description: Detects suspicious new RUN key element pointing to an executable in a suspicious folder
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((registry_key_name="*\\Software\\Microsoft\\Windows\\CurrentVersion\\Run*" OR registry_key_name="*\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run*" OR registry_key_name="*\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\Run*")) AND (((Details="*:\\Perflogs*" OR Details="*:\\ProgramData'*" OR Details="*:\\Windows\\Temp*" OR Details="*:\\Temp*" OR Details="*\\AppData\\Local\\Temp*" OR Details="*\\AppData\\Roaming*" OR Details="*:\\$Recycle.bin*" OR Details="*:\\Users\\Default*" OR Details="*:\\Users\\public*" OR Details="*%temp%*" OR Details="*%tmp%*" OR Details="*%Public%*" OR Details="*%AppData%*")) OR ((Details="*:\\Users\\*") AND ((Details="*\\Favorites*" OR Details="*\\Favourites*" OR Details="*\\Contacts*" OR Details="*\\Music*" OR Details="*\\Pictures*" OR Details="*\\Documents*" OR Details="*\\Photos*")))) AND NOT ((registry_key_name="*\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\*" AND process_path="C:\\Windows\\SoftwareDistribution\\Download\\*" AND (Details="*rundll32.exe *" AND Details="*C:\\WINDOWS\\system32\\advpack.dll,DelNodeRunDLL32*") AND (Details="*\\AppData\\Local\\Temp\\*" OR Details="*C:\\Windows\\Temp\\*"))) AND NOT (((process_path="*C:\\Program Files\\Spotify\\Spotify.exe" OR process_path="*C:\\Program Files (x86)\\Spotify\\Spotify.exe" OR process_path="*\\AppData\\Roaming\\Spotify\\Spotify.exe") AND registry_key_name="*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\\Spotify" AND Details="*Spotify.exe --autostart --minimized")))
