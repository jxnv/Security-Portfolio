# Title: Schtasks From Suspicious Folders
# ID: 8a8379b8-780b-4dbf-b1e9-31c8d112fefb
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-04-15
# Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
# Description: Detects scheduled task creations that have suspicious action command and folder combinations
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="*C:\\ProgramData\\*" OR process_exec="*%ProgramData%*")) AND ((process_exec="*powershell*" OR process_exec="*pwsh*" OR process_exec="*cmd /c *" OR process_exec="*cmd /k *" OR process_exec="*cmd /r *" OR process_exec="*cmd.exe /c *" OR process_exec="*cmd.exe /k *" OR process_exec="*cmd.exe /r *")) AND (process_exec="* /create *") AND ((process_path="*\\schtasks.exe") OR (process_name="schtasks.exe")))
