# Title: Suspicious Greedy Compression Using Rar.EXE
# ID: afe52666-401e-4a02-b4ff-5d128990b8cb
# Status: test
# Level: high
# Author: X__Junior (Nextron Systems), Florian Roth (Nextron Systems)
# Date: 2022-12-15
# Tags: attack.execution, attack.t1059
# Description: Detects RAR usage that creates an archive from a suspicious folder, either a system folder or one of the folders often used by attackers for staging purposes
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((process_path="*\\rar.exe") OR (Description="Command line RAR")) OR ((process_exec="*.exe a *" OR process_exec="* a -m*"))) AND (((process_exec="* -hp*" AND process_exec="* -r *")) AND ((process_exec="* ?:\\\\\\*.*" OR process_exec="* ?:\\\\\\\\\\*.*" OR process_exec="* ?:\\$Recycle.bin\\*" OR process_exec="* ?:\\PerfLogs\\*" OR process_exec="* ?:\\Temp*" OR process_exec="* ?:\\Users\\Public\\*" OR process_exec="* ?:\\Windows\\*" OR process_exec="* %public%*"))))
