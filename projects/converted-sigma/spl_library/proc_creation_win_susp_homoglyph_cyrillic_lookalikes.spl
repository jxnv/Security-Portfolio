# Title: Potential Homoglyph Attack Using Lookalike Characters
# ID: 32e280f1-8ad4-46ef-9e80-910657611fbc
# Status: test
# Level: medium
# Author: Micah Babinski, @micahbabinski
# Date: 2023-05-07
# Tags: attack.stealth, attack.t1036, attack.t1036.003
# Description: Detects the presence of unicode characters which are homoglyphs, or identical in appearance, to ASCII letter characters.
# This is used as an obfuscation and masquerading techniques. Only "perfect" homoglyphs are included; these are characters that
# are indistinguishable from ASCII characters and thus may make excellent candidates for homoglyph attack characters.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="*а*" OR process_exec="*е*" OR process_exec="*о*" OR process_exec="*р*" OR process_exec="*с*" OR process_exec="*х*" OR process_exec="*ѕ*" OR process_exec="*і*" OR process_exec="*ӏ*" OR process_exec="*ј*" OR process_exec="*һ*" OR process_exec="*ԁ*" OR process_exec="*ԛ*" OR process_exec="*ԝ*" OR process_exec="*ο*")) OR ((process_exec="*А*" OR process_exec="*В*" OR process_exec="*Е*" OR process_exec="*К*" OR process_exec="*М*" OR process_exec="*Н*" OR process_exec="*О*" OR process_exec="*Р*" OR process_exec="*С*" OR process_exec="*Т*" OR process_exec="*Х*" OR process_exec="*Ѕ*" OR process_exec="*І*" OR process_exec="*Ј*" OR process_exec="*Ү*" OR process_exec="*Ӏ*" OR process_exec="*Ԍ*" OR process_exec="*Ԛ*" OR process_exec="*Ԝ*" OR process_exec="*Α*" OR process_exec="*Β*" OR process_exec="*Ε*" OR process_exec="*Ζ*" OR process_exec="*Η*" OR process_exec="*Ι*" OR process_exec="*Κ*" OR process_exec="*Μ*" OR process_exec="*Ν*" OR process_exec="*Ο*" OR process_exec="*Ρ*" OR process_exec="*Τ*" OR process_exec="*Υ*" OR process_exec="*Χ*")))
