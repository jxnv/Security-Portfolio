# Title: Potential Tampering With Security Products Via WMIC
# ID: 847d5ff3-8a31-4737-a970-aeae8fe21765
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
# Date: 2021-01-30
# Tags: attack.defense-impairment, attack.t1685
# Description: Detects uninstallation or termination of security products using the WMIC utility
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((process_exec="*wmic*" AND process_exec="*product *" AND process_exec="*uninstall*") AND (process_exec="*/nointeractive*" OR process_exec="*-nointeractive*")) OR ((process_exec="*wmic*" AND process_exec="*caption like *") AND (process_exec="*call delete*" OR process_exec="*call terminate*")) OR ((process_exec="*process *" AND process_exec="*where *" AND process_exec="*delete*"))) AND ((process_exec="*%carbon%*" OR process_exec="*%cylance%*" OR process_exec="*%endpoint%*" OR process_exec="*%eset%*" OR process_exec="*%malware%*" OR process_exec="*%Sophos%*" OR process_exec="*%symantec%*" OR process_exec="*Antivirus*" OR process_exec="*AVG *" OR process_exec="*Carbon Black*" OR process_exec="*CarbonBlack*" OR process_exec="*Cb Defense Sensor 64-bit*" OR process_exec="*Crowdstrike Sensor*" OR process_exec="*Cylance *" OR process_exec="*Dell Threat Defense*" OR process_exec="*DLP Endpoint*" OR process_exec="*Endpoint Detection*" OR process_exec="*Endpoint Protection*" OR process_exec="*Endpoint Security*" OR process_exec="*Endpoint Sensor*" OR process_exec="*ESET File Security*" OR process_exec="*LogRhythm System Monitor Service*" OR process_exec="*Malwarebytes*" OR process_exec="*McAfee Agent*" OR process_exec="*Microsoft Security Client*" OR process_exec="*Sophos Anti-Virus*" OR process_exec="*Sophos AutoUpdate*" OR process_exec="*Sophos Credential Store*" OR process_exec="*Sophos Management Console*" OR process_exec="*Sophos Management Database*" OR process_exec="*Sophos Management Server*" OR process_exec="*Sophos Remote Management System*" OR process_exec="*Sophos Update Manager*" OR process_exec="*Threat Protection*" OR process_exec="*VirusScan*" OR process_exec="*Webroot SecureAnywhere*" OR process_exec="*Windows Defender*")))
