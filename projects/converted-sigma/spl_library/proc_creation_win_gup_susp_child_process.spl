# Title: Suspicious Child Process of Notepad++ Updater - GUP.Exe
# ID: bb0e87ce-c89f-4857-84fa-095e4483e9cb
# Status: experimental
# Level: high
# Author: Swachchhanda Shrawan Poudel (Nextron Systems)
# Date: 2026-02-03
# Tags: attack.collection, attack.credential-access, attack.t1195.002, attack.initial-access, attack.t1557
# Description: Detects suspicious child process creation by the Notepad++ updater process (gup.exe).
# This could indicate potential exploitation of the updater component to deliver unwanted malware.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((parent_process_path="*\\gup.exe") AND (((process_exec="*bitsadmin*" OR process_exec="*certutil*" OR process_exec="*curl*" OR process_exec="*finger*" OR process_exec="*forfiles*" OR process_exec="*regsvr32*" OR process_exec="*rundll32*" OR process_exec="*wget*")) OR ((process_path="*\\cmd.exe" OR process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe" OR process_path="*\\cscript.exe" OR process_path="*\\wscript.exe" OR process_path="*\\mshta.exe"))))
