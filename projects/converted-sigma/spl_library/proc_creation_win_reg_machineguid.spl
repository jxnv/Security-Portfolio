# Date: 2022-01-01
# Tags: attack.discovery, attack.t1082
# Description: Use of reg to get MachineGuid information
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (process_path="*\\reg.exe" AND (process_exec="*SOFTWARE\\Microsoft\\Cryptography*" AND process_exec="*/v *" AND process_exec="*MachineGuid*"))
