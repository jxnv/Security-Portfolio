# Title: Potential Crypto Mining Activity
# ID: 66c3b204-9f88-4d0a-a7f7-8a57d521ca55
# Status: stable
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2021-10-26
# Tags: attack.impact, attack.t1496
# Description: Detects command line parameters or strings often used by crypto miners
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="* --cpu-priority=*" OR process_exec="*--donate-level=0*" OR process_exec="* -o pool.*" OR process_exec="* --nicehash*" OR process_exec="* --algo=rx/0 *" OR process_exec="*stratum+tcp://*" OR process_exec="*stratum+udp://*" OR process_exec="*LS1kb25hdGUtbGV2ZWw9*" OR process_exec="*0tZG9uYXRlLWxldmVsP*" OR process_exec="*tLWRvbmF0ZS1sZXZlbD*" OR process_exec="*c3RyYXR1bSt0Y3A6Ly*" OR process_exec="*N0cmF0dW0rdGNwOi8v*" OR process_exec="*zdHJhdHVtK3RjcDovL*" OR process_exec="*c3RyYXR1bSt1ZHA6Ly*" OR process_exec="*N0cmF0dW0rdWRwOi8v*" OR process_exec="*zdHJhdHVtK3VkcDovL*")) AND NOT (((process_exec="* pool.c *" OR process_exec="* pool.o *" OR process_exec="*gcc -*"))))
