# Title: PUA - Suspicious ActiveDirectory Enumeration Via AdFind.EXE
# ID: 455b9d50-15a1-4b99-853f-8d37655a4c1b
# Status: test
# Level: high
# Author: frack113
# Date: 2021-12-13
# Tags: attack.discovery, attack.t1087.002
# Description: Detects active directory enumeration activity using known AdFind CLI flags
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((process_exec="*-sc admincountdmp*") OR (process_exec="*-sc exchaddresses*") OR ((process_exec="*lockoutduration*" OR process_exec="*lockoutthreshold*" OR process_exec="*lockoutobservationwindow*" OR process_exec="*maxpwdage*" OR process_exec="*minpwdage*" OR process_exec="*minpwdlength*" OR process_exec="*pwdhistorylength*" OR process_exec="*pwdproperties*")))
