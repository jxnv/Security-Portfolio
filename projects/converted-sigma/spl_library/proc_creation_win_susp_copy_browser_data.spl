# Title: Potential Browser Data Stealing
# ID: 47147b5b-9e17-4d76-b8d2-7bac24c5ce1b
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-12-23
# Tags: attack.credential-access, attack.t1555.003
# Description: Adversaries may acquire credentials from web browsers by reading files specific to the target browser.
# Web browsers commonly save credentials such as website usernames and passwords so that they do not need to be entered manually in the future.
# Web browsers typically store the credentials in an encrypted format within a credential store.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((process_exec="*copy-item*" OR process_exec="*copy *" OR process_exec="*cpi *" OR process_exec="* cp *" OR process_exec="*move *" OR process_exec="*move-item*" OR process_exec="* mi *" OR process_exec="* mv *")) OR ((process_path="*\\esentutl.exe" OR process_path="*\\xcopy.exe" OR process_path="*\\robocopy.exe")) OR ((process_name="esentutl.exe" OR process_name="XCOPY.EXE" OR process_name="robocopy.exe"))) AND ((process_exec="*\\Amigo\\User Data*" OR process_exec="*\\BraveSoftware\\Brave-Browser\\User Data*" OR process_exec="*\\CentBrowser\\User Data*" OR process_exec="*\\Chromium\\User Data*" OR process_exec="*\\CocCoc\\Browser\\User Data*" OR process_exec="*\\Comodo\\Dragon\\User Data*" OR process_exec="*\\Elements Browser\\User Data*" OR process_exec="*\\Epic Privacy Browser\\User Data*" OR process_exec="*\\Google\\Chrome Beta\\User Data*" OR process_exec="*\\Google\\Chrome SxS\\User Data*" OR process_exec="*\\Google\\Chrome\\User Data\\*" OR process_exec="*\\Kometa\\User Data*" OR process_exec="*\\Maxthon5\\Users*" OR process_exec="*\\Microsoft\\Edge\\User Data*" OR process_exec="*\\Mozilla\\Firefox\\Profiles*" OR process_exec="*\\Nichrome\\User Data*" OR process_exec="*\\Opera Software\\Opera GX Stable\\*" OR process_exec="*\\Opera Software\\Opera Neon\\User Data*" OR process_exec="*\\Opera Software\\Opera Stable\\*" OR process_exec="*\\Orbitum\\User Data*" OR process_exec="*\\QIP Surf\\User Data*" OR process_exec="*\\Sputnik\\User Data*" OR process_exec="*\\Torch\\User Data*" OR process_exec="*\\uCozMedia\\Uran\\User Data*" OR process_exec="*\\Vivaldi\\User Data*")))
