# Title: Suspicious Obfuscated PowerShell Code
# ID: 8d01b53f-456f-48ee-90f6-bc28e67d4e35
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-07-11
# Tags: attack.stealth
# Description: Detects suspicious UTF16 and base64 encoded and often obfuscated PowerShell code often used in command lines
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((process_exec="*IAAtAGIAeABvAHIAIAAwAHgA*" OR process_exec="*AALQBiAHgAbwByACAAMAB4A*" OR process_exec="*gAC0AYgB4AG8AcgAgADAAeA*" OR process_exec="*AC4ASQBuAHYAbwBrAGUAKAApACAAfAAg*" OR process_exec="*AuAEkAbgB2AG8AawBlACgAKQAgAHwAI*" OR process_exec="*ALgBJAG4AdgBvAGsAZQAoACkAIAB8AC*" OR process_exec="*AHsAMQB9AHsAMAB9ACIAIAAtAGYAI*" OR process_exec="*B7ADEAfQB7ADAAfQAiACAALQBmAC*" OR process_exec="*AewAxAH0AewAwAH0AIgAgAC0AZgAg*" OR process_exec="*AHsAMAB9AHsAMwB9ACIAIAAtAGYAI*" OR process_exec="*B7ADAAfQB7ADMAfQAiACAALQBmAC*" OR process_exec="*AewAwAH0AewAzAH0AIgAgAC0AZgAg*" OR process_exec="*AHsAMgB9AHsAMAB9ACIAIAAtAGYAI*" OR process_exec="*B7ADIAfQB7ADAAfQAiACAALQBmAC*" OR process_exec="*AewAyAH0AewAwAH0AIgAgAC0AZgAg*" OR process_exec="*AHsAMQB9AHsAMAB9ACcAIAAtAGYAI*" OR process_exec="*B7ADEAfQB7ADAAfQAnACAALQBmAC*" OR process_exec="*AewAxAH0AewAwAH0AJwAgAC0AZgAg*" OR process_exec="*AHsAMAB9AHsAMwB9ACcAIAAtAGYAI*" OR process_exec="*B7ADAAfQB7ADMAfQAnACAALQBmAC*" OR process_exec="*AewAwAH0AewAzAH0AJwAgAC0AZgAg*" OR process_exec="*AHsAMgB9AHsAMAB9ACcAIAAtAGYAI*" OR process_exec="*B7ADIAfQB7ADAAfQAnACAALQBmAC*" OR process_exec="*AewAyAH0AewAwAH0AJwAgAC0AZgAg*"))
