# Title: Potential Mpclient.DLL Sideloading
# ID: 418dc89a-9808-4b87-b1d7-e5ae0cb6effc
# Status: test
# Level: high
# Author: Bhabesh Raj
# Date: 2022-08-02
# Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.stealth, attack.t1574.001
# Description: Detects potential sideloading of "mpclient.dll" by Windows Defender processes ("MpCmdRun" and "NisSrv") from their non-default directory.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((ImageLoaded="*\\mpclient.dll" AND (process_path="*\\MpCmdRun.exe" OR process_path="*\\NisSrv.exe")) AND NOT (((process_path="C:\\Program Files (x86)\\Windows Defender\\*" OR process_path="C:\\Program Files\\Microsoft Security Client\\*" OR process_path="C:\\Program Files\\Windows Defender\\*" OR process_path="C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*" OR process_path="C:\\Windows\\WinSxS\\*"))))
