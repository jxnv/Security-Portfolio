# Title: Suspicious Mstsc.EXE Execution With Local RDP File
# ID: 6e22722b-dfb1-4508-a911-49ac840b40f8
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-04-18
# Tags: attack.command-and-control, attack.t1219.002
# Description: Detects potential RDP connection via Mstsc using a local ".rdp" file located in suspicious locations.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="*.rdp" OR process_exec="*.rdp\"")) AND ((process_path="*\\mstsc.exe") OR (process_name="mstsc.exe")) AND ((process_exec="*:\\Users\\Public\\*" OR process_exec="*:\\Windows\\System32\\spool\\drivers\\color*" OR process_exec="*:\\Windows\\System32\\Tasks_Migrated *" OR process_exec="*:\\Windows\\Tasks\\*" OR process_exec="*:\\Windows\\Temp\\*" OR process_exec="*:\\Windows\\Tracing\\*" OR process_exec="*\\AppData\\Local\\Temp\\*" OR process_exec="*\\Downloads\\*")))
