# Description: Detects macOS Gatekeeper bypass via xattr utility
# Converted by: Sigma Universal SIEM/EDR CLI

index=* (process_path="*/xattr" AND (process_exec="*-d*" AND process_exec="*com.apple.quarantine*"))
