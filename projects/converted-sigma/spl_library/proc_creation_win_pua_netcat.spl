# Title: PUA - Netcat Suspicious Execution
# ID: e31033fc-33f0-4020-9a16-faf9b31cbf08
# Status: test
# Level: high
# Author: frack113, Florian Roth (Nextron Systems)
# Date: 2021-07-21
# Tags: attack.command-and-control, attack.t1095
# Description: Detects execution of Netcat. Adversaries may use a non-application layer protocol for communication between host and C2 server or among infected hosts within a network
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="* -lvp *" OR process_exec="* -lvnp*" OR process_exec="* -l -v -p *" OR process_exec="* -lv -p *" OR process_exec="* -l --proxy-type http *" OR process_exec="* -vnl --exec *" OR process_exec="* -vnl -e *" OR process_exec="* --lua-exec *" OR process_exec="* --sh-exec *")) OR ((process_path="*\\nc.exe" OR process_path="*\\ncat.exe" OR process_path="*\\netcat.exe")))
