# Title: Dumping of Sensitive Hives Via Reg.EXE
# ID: fd877b94-9bb5-4191-bb25-d79cbd93c167
# Status: test
# Level: high
# Author: Teymur Kheirkhabarov, Endgame, JHasenbusch, Daniil Yugoslavskiy, oscd.community, frack113
# Date: 2019-10-22
# Tags: attack.credential-access, attack.t1003.002, attack.t1003.004, attack.t1003.005, car.2013-07-001
# Description: Detects the usage of "reg.exe" in order to dump sensitive registry hives. This includes SAM, SYSTEM and SECURITY hives.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="* save *" OR process_exec="* export *" OR process_exec="* ˢave *" OR process_exec="* eˣport *")) AND ((process_exec="*\\system*" OR process_exec="*\\sam*" OR process_exec="*\\security*" OR process_exec="*\\ˢystem*" OR process_exec="*\\syˢtem*" OR process_exec="*\\ˢyˢtem*" OR process_exec="*\\ˢam*" OR process_exec="*\\ˢecurity*")) AND ((process_exec="*hklm*" OR process_exec="*hk˪m*" OR process_exec="*hkey_local_machine*" OR process_exec="*hkey_˪ocal_machine*" OR process_exec="*hkey_loca˪_machine*" OR process_exec="*hkey_˪oca˪_machine*")) AND ((process_path="*\\reg.exe") OR (process_name="reg.exe")))
