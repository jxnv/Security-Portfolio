# Title: Suspicious DLL Loaded via CertOC.EXE
# ID: 84232095-ecca-4015-b0d7-7726507ee793
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-02-15
# Tags: attack.stealth, attack.t1218
# Description: Detects when a user installs certificates by using CertOC.exe to load the target DLL file.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((process_exec="* -LoadDLL *") AND ((process_path="*\\certoc.exe") OR (process_name="CertOC.exe")) AND ((process_exec="*\\Appdata\\Local\\Temp\\*" OR process_exec="*\\Desktop\\*" OR process_exec="*\\Downloads\\*" OR process_exec="*\\Users\\Public\\*" OR process_exec="*C:\\Windows\\Tasks\\*" OR process_exec="*C:\\Windows\\Temp\\*")))
