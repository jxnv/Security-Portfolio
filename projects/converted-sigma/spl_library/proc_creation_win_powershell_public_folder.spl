# Title: Execution of Powershell Script in Public Folder
# ID: fb9d3ff7-7348-46ab-af8c-b55f5fbf39b4
# Status: test
# Level: high
# Author: Max Altgelt (Nextron Systems)
# Date: 2022-04-06
# Tags: attack.execution, attack.t1059.001
# Description: This rule detects execution of PowerShell scripts located in the "C:\Users\Public" folder
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe") AND (process_exec="*-f C:\\Users\\Public*" OR process_exec="*-f \"C:\\Users\\Public*" OR process_exec="*-f %Public%*" OR process_exec="*-fi C:\\Users\\Public*" OR process_exec="*-fi \"C:\\Users\\Public*" OR process_exec="*-fi %Public%*" OR process_exec="*-fil C:\\Users\\Public*" OR process_exec="*-fil \"C:\\Users\\Public*" OR process_exec="*-fil %Public%*" OR process_exec="*-file C:\\Users\\Public*" OR process_exec="*-file \"C:\\Users\\Public*" OR process_exec="*-file %Public%*"))
