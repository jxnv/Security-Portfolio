# Title: Obfuscated IP Download Activity
# ID: cb5a2333-56cf-4562-8fcb-22ba1bca728d
# Status: test
# Level: medium
# Author: Florian Roth (Nextron Systems), X__Junior (Nextron Systems)
# Date: 2022-08-03
# Tags: attack.discovery
# Description: Detects use of an encoded/obfuscated version of an IP address (hex, octal...) in an URL combined with a download command
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="*Invoke-WebRequest*" OR process_exec="*iwr *" OR process_exec="*Invoke-RestMethod*" OR process_exec="*irm *" OR process_exec="*wget *" OR process_exec="*curl *" OR process_exec="*DownloadFile*" OR process_exec="*DownloadString*")) AND (((process_exec="* 0x*" OR process_exec="*//0x*" OR process_exec="*.0x*" OR process_exec="*.00x*")) OR ((process_exec="*http://%*" AND process_exec="*%2e*")) OR ((regex process_exec="(?i)https?://[0-9]{1,3}\\.[0-9]{1,3}\\.0[0-9]{3,4}") OR (regex process_exec="(?i)https?://[0-9]{1,3}\\.0[0-9]{3,7}") OR (regex process_exec="(?i)https?://0[0-9]{3,11}") OR (regex process_exec="(?i)https?://(?:0[0-9]{1,11}\\.){3}0[0-9]{1,11}") OR (regex process_exec="(?i)https?://0[0-9]{1,11}") OR (regex process_exec="(?i) [0-7]{7,13}"))) AND NOT ((regex process_exec="(?i)https?://(?:(?:25[0-5]|(?:2[0-4]|1\\d|[1-9])?\\d)(?:\\.|\\b)){4}")))
