# Title: Potential CommandLine Obfuscation Using Unicode Characters From Suspicious Image
# ID: 584bca0f-3608-4402-80fd-4075ff6072e3
# Status: test
# Level: high
# Author: frack113, Florian Roth (Nextron Systems), Josh Nickels
# Date: 2024-09-02
# Tags: attack.stealth, attack.t1027
# Description: Detects potential commandline obfuscation using unicode characters.
# Adversaries may attempt to make an executable or file difficult to discover or analyze by encrypting, encoding, or otherwise obfuscating its contents on the system or in transit.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_path="*\\cmd.exe" OR process_path="*\\cscript.exe" OR process_path="*\\powershell.exe" OR process_path="*\\powershell_ise.exe" OR process_path="*\\pwsh.exe" OR process_path="*\\wscript.exe") AND (process_name="Cmd.EXE" OR process_name="cscript.exe" OR process_name="PowerShell.EXE" OR process_name="PowerShell_ISE.EXE" OR process_name="pwsh.dll" OR process_name="wscript.exe")) AND ((process_exec="*ˣ*" OR process_exec="*˪*" OR process_exec="*ˢ*" OR process_exec="*∕*" OR process_exec="*⁄*" OR process_exec="*―*" OR process_exec="*—*" OR process_exec="* *" OR process_exec="*¯*" OR process_exec="*®*" OR process_exec="*¶*" OR process_exec="*⠀*")))
