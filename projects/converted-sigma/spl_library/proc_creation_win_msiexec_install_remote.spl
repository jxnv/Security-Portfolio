# Title: Suspicious Msiexec Quiet Install From Remote Location
# ID: 8150732a-0c9d-4a99-82b9-9efb9b90c40c
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-10-28
# Tags: attack.stealth, attack.t1218.007
# Description: Detects usage of Msiexec.exe to install packages hosted remotely quietly
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((process_exec="*-i*" OR process_exec="*/i*" OR process_exec="*-package*" OR process_exec="*/package*" OR process_exec="*-a*" OR process_exec="*/a*" OR process_exec="*-j*" OR process_exec="*/j*")) AND ((process_path="*\\msiexec.exe") OR (process_name="msiexec.exe")) AND ((process_exec="*-q*" OR process_exec="*/q*")) AND ((process_exec="*http*" OR process_exec="*\\\\\\\\*"))) AND NOT (((process_exec="*\\AppData\\Local\\Temp\\OpenOffice*" AND process_exec="*Installation Files\\openoffice*"))))
