# Title: Vim GTFOBin Abuse - Linux
# ID: 7ab8f73a-fcff-428b-84aa-6a5ff7877dea
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems), Luc Génaux
# Date: 2022-12-28
# Tags: attack.execution, attack.discovery, attack.t1059, attack.t1083
# Description: Detects the use of "vim" and it's siblings commands to execute a shell or proxy commands.
# Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* sourcetype="syslog" (((process_exec="*:!/*" OR process_exec="*:!$*" OR process_exec="*:!..*" OR process_exec="*:lua *" OR process_exec="*:py *" OR process_exec="*:shell*" OR process_exec="*/bin/bash*" OR process_exec="*/bin/dash*" OR process_exec="*/bin/fish*" OR process_exec="*/bin/sh*" OR process_exec="*/bin/csh*" OR process_exec="*/bin/ksh*" OR process_exec="*/bin/zsh*" OR process_exec="*/bin/tmux*")) AND ((process_path="*/rvim" OR process_path="*/vi" OR process_path="*/vim" OR process_path="*/vimdiff") AND (process_exec="* --cmd *" OR process_exec="* -c*")))
