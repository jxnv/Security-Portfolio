index=* eventtype=wineventlog (((process_exec="*.doc*" OR process_exec="*.docx*" OR process_exec="*.xls*" OR process_exec="*.xlsx*" OR process_exec="*.ppt*" OR process_exec="*.pptx*" OR process_exec="*.rtf*" OR process_exec="*.pdf*" OR process_exec="*.txt*")) AND (((process_exec="*dir *" AND process_exec="* /b *" AND process_exec="* /s *")) OR (process_name="FINDSTR.EXE" AND (process_exec="* /e *" OR process_exec="* /si *"))))
