# Title: Potentially Suspicious WDAC Policy File Creation
# ID: 1d2de8a6-4803-4fde-b85b-f58f3aa7a705
# Status: experimental
# Level: medium
# Author: X__Junior
# Date: 2025-02-07
# Tags: attack.defense-impairment
# Description: Detects suspicious Windows Defender Application Control (WDAC) policy file creation from abnormal processes that could be abused by attacker to block EDR/AV components while allowing their own malicious code to run on the system.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((file_name="*\\Windows\\System32\\CodeIntegrity\\*") AND NOT (((((process_exec="*ConvertFrom-CIPolicy -XmlFilePath*" AND process_exec="*-BinaryFilePath *")) OR (process_exec="*CiTool --update-policy*") OR ((process_exec="*Copy-Item -Path*" AND process_exec="*-Destination*"))) OR ((process_path="*\\Microsoft.ConfigurationManagement.exe" OR process_path="*\\WDAC Wizard.exe" OR process_path="*C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" OR process_path="*C:\\Program Files\\PowerShell\\7\\pwsh.exe" OR process_path="*C:\\Windows\\System32\\dllhost.exe" OR process_path="*C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" OR process_path="*C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" OR process_path="*C:\\Windows\\SysWOW64\\dllhost.exe" OR process_path="*C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" OR process_path="*C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")) OR (process_path="System") OR (process_path="C:\\Windows\\System32\\wuauclt.exe") OR ((process_path="C:\\Windows\\UUS\\arm64\\wuaucltcore.exe" OR process_path="C:\\Windows\\UUS\\Packages\\Preview\\arm64\\wuaucltcore.exe")))))
