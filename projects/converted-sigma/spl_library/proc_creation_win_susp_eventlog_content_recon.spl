# Title: Potentially Suspicious EventLog Recon Activity Using Log Query Utilities
# ID: beaa66d6-aa1b-4e3c-80f5-e0145369bfaf
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
# Date: 2022-09-09
# Tags: attack.credential-access, attack.discovery, attack.t1552, attack.t1087
# Description: Detects execution of different log query utilities and commands to search and dump the content of specific event logs or look for specific event IDs.
# This technique is used by threat actors in order to extract sensitive information from events logs such as usernames, IP addresses, hostnames, etc.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((process_exec="*-InstanceId 462?*" OR process_exec="*.eventid -eq 462?*" OR process_exec="*.ID -eq 462?*" OR process_exec="*EventCode=?462?*" OR process_exec="*EventIdentifier=?462?*" OR process_exec="*System[EventID=462?]*" OR process_exec="*-InstanceId 4778*" OR process_exec="*.eventid -eq 4778*" OR process_exec="*.ID -eq 4778*" OR process_exec="*EventCode=?4778?*" OR process_exec="*EventIdentifier=?4778?*" OR process_exec="*System[EventID=4778]*" OR process_exec="*-InstanceId 25*" OR process_exec="*.eventid -eq 25*" OR process_exec="*.ID -eq 25*" OR process_exec="*EventCode=?25?*" OR process_exec="*EventIdentifier=?25?*" OR process_exec="*System[EventID=25]*" OR process_exec="*-InstanceId 1149*" OR process_exec="*.eventid -eq 1149*" OR process_exec="*.ID -eq 1149*" OR process_exec="*EventCode=?1149?*" OR process_exec="*EventIdentifier=?1149?*" OR process_exec="*System[EventID=1149]*" OR process_exec="*-InstanceId 21*" OR process_exec="*.eventid -eq 21*" OR process_exec="*.ID -eq 21*" OR process_exec="*EventCode=?21?*" OR process_exec="*EventIdentifier=?21?*" OR process_exec="*System[EventID=21]*" OR process_exec="*-InstanceId 22*" OR process_exec="*.eventid -eq 22*" OR process_exec="*.ID -eq 22*" OR process_exec="*EventCode=?22?*" OR process_exec="*EventIdentifier=?22?*" OR process_exec="*System[EventID=22]*")) OR ((process_exec="*Microsoft-Windows-PowerShell*" OR process_exec="*Microsoft-Windows-Security-Auditing*" OR process_exec="*Microsoft-Windows-TerminalServices-LocalSessionManager*" OR process_exec="*Microsoft-Windows-TerminalServices-RemoteConnectionManager*" OR process_exec="*Microsoft-Windows-Windows Defender*" OR process_exec="*PowerShellCore*" OR process_exec="*Security*" OR process_exec="*Windows PowerShell*"))) AND (((process_exec="*Select*" AND process_exec="*Win32_NTLogEvent*")) OR (((process_exec="* qe *" OR process_exec="* query-events *")) AND ((process_path="*\\wevtutil.exe") OR (process_name="wevtutil.exe"))) OR ((process_exec="* ntevent*") AND ((process_path="*\\wmic.exe") OR (process_name="wmic.exe"))) OR ((process_exec="*Get-WinEvent *" OR process_exec="*get-eventlog *"))))
