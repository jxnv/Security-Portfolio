# Tags: attack.execution, attack.stealth, attack.t1127
# Description: Detects execution of "aspnet_compiler.exe" with potentially suspicious paths for compilation.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((process_path="*:\\Windows\\Microsoft.NET\\Framework\\*" OR process_path="*:\\Windows\\Microsoft.NET\\Framework64\\*" OR process_path="*:\\Windows\\Microsoft.NET\\FrameworkArm\\*" OR process_path="*:\\Windows\\Microsoft.NET\\FrameworkArm64\\*") AND process_path="*\\aspnet_compiler.exe" AND (process_exec="*\\Users\\Public\\*" OR process_exec="*\\AppData\\Local\\Temp\\*" OR process_exec="*\\AppData\\Local\\Roaming\\*" OR process_exec="*:\\Temp\\*" OR process_exec="*:\\Windows\\Temp\\*" OR process_exec="*:\\Windows\\System32\\Tasks\\*" OR process_exec="*:\\Windows\\Tasks\\*"))
