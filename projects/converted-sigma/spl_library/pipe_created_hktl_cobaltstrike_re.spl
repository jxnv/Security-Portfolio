# Title: CobaltStrike Named Pipe Pattern Regex
# ID: 0e7163d4-9e19-4fa7-9be6-000c61aad77a
# Status: test
# Level: critical
# Author: Florian Roth (Nextron Systems)
# Date: 2021-07-30
# Tags: attack.privilege-escalation, attack.stealth, attack.t1055
# Description: Detects the creation of a named pipe matching a pattern used by CobaltStrike Malleable C2 profiles
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((regex PipeName="(?i)\\\\mojo\\.5688\\.8052\\.(?:183894939787088877|35780273329370473)[0-9a-f]{2}") OR (regex PipeName="(?i)\\\\wkssvc_?[0-9a-f]{2}") OR (regex PipeName="(?i)\\\\ntsvcs[0-9a-f]{2}") OR (regex PipeName="(?i)\\\\DserNamePipe[0-9a-f]{2}") OR (regex PipeName="(?i)\\\\SearchTextHarvester[0-9a-f]{2}") OR (regex PipeName="(?i)\\\\mypipe-(?:f|h)[0-9a-f]{2}") OR (regex PipeName="(?i)\\\\windows\\.update\\.manager[0-9a-f]{2,3}") OR (regex PipeName="(?i)\\\\ntsvcs_[0-9a-f]{2}") OR (regex PipeName="(?i)\\\\scerpc_?[0-9a-f]{2}") OR (regex PipeName="(?i)\\\\PGMessagePipe[0-9a-f]{2}") OR (regex PipeName="(?i)\\\\MsFteWds[0-9a-f]{2}") OR (regex PipeName="(?i)\\\\f4c3[0-9a-f]{2}") OR (regex PipeName="(?i)\\\\fullduplex_[0-9a-f]{2}") OR (regex PipeName="(?i)\\\\msrpc_[0-9a-f]{4}") OR (regex PipeName="(?i)\\\\win\\\\msrpc_[0-9a-f]{2}") OR (regex PipeName="(?i)\\\\f53f[0-9a-f]{2}$") OR (regex PipeName="(?i)\\\\rpc_[0-9a-f]{2}") OR (regex PipeName="(?i)\\\\spoolss_[0-9a-f]{2}") OR (regex PipeName="(?i)\\\\Winsock2\\\\CatalogChangeListener-[0-9a-f]{3}-0,"))
