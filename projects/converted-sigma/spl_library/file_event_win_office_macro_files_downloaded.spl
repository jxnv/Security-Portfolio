# Title: Office Macro File Download
# ID: 0e29e3a7-1ad8-40aa-b691-9f82ecd33d66
# Status: test
# Level: low
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-01-23
# Tags: attack.initial-access, attack.t1566.001
# Description: Detects the creation of a new office macro files on the system via an application (browser, mail client).
# This can help identify potential malicious activity, such as the download of macro-enabled documents that could be used for exploitation.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((file_name="*.docm" OR file_name="*.dotm" OR file_name="*.xlsm" OR file_name="*.xltm" OR file_name="*.potm" OR file_name="*.pptm")) OR ((file_name="*.docm:Zone*" OR file_name="*.dotm:Zone*" OR file_name="*.xlsm:Zone*" OR file_name="*.xltm:Zone*" OR file_name="*.potm:Zone*" OR file_name="*.pptm:Zone*"))) AND ((process_path="*\\RuntimeBroker.exe" OR process_path="*\\outlook.exe" OR process_path="*\\thunderbird.exe" OR process_path="*\\brave.exe" OR process_path="*\\chrome.exe" OR process_path="*\\firefox.exe" OR process_path="*\\iexplore.exe" OR process_path="*\\maxthon.exe" OR process_path="*\\MicrosoftEdge.exe" OR process_path="*\\msedge.exe" OR process_path="*\\msedgewebview2.exe" OR process_path="*\\opera.exe" OR process_path="*\\safari.exe" OR process_path="*\\seamonkey.exe" OR process_path="*\\vivaldi.exe" OR process_path="*\\whale.exe")))
