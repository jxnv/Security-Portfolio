# Title: Potentially Suspicious Child Process Of ClickOnce Application
# ID: 67bc0e75-c0a9-4cfc-8754-84a505b63c04
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-06-12
# Tags: attack.execution, attack.stealth
# Description: Detects potentially suspicious child processes of a ClickOnce deployment application
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (parent_process_path="*\\AppData\\Local\\Apps\\2.0\\*" AND (process_path="*\\calc.exe" OR process_path="*\\cmd.exe" OR process_path="*\\cscript.exe" OR process_path="*\\explorer.exe" OR process_path="*\\mshta.exe" OR process_path="*\\net.exe" OR process_path="*\\net1.exe" OR process_path="*\\nltest.exe" OR process_path="*\\notepad.exe" OR process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe" OR process_path="*\\reg.exe" OR process_path="*\\regsvr32.exe" OR process_path="*\\rundll32.exe" OR process_path="*\\schtasks.exe" OR process_path="*\\werfault.exe" OR process_path="*\\wscript.exe"))
