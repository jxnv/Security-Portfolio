# Title: Potential SAM Database Dump
# ID: 4e87b8e2-2ee9-4b2a-a715-4727d297ece0
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-02-11
# Tags: attack.credential-access, attack.t1003.002
# Description: Detects the creation of files that look like exports of the local SAM (Security Account Manager)
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((file_name="*\\Temp\\sam" OR file_name="*\\sam.sav" OR file_name="*\\Intel\\sam" OR file_name="*\\sam.hive" OR file_name="*\\Perflogs\\sam" OR file_name="*\\ProgramData\\sam" OR file_name="*\\Users\\Public\\sam" OR file_name="*\\AppData\\Local\\sam" OR file_name="*\\AppData\\Roaming\\sam" OR file_name="*_ShadowSteal.zip" OR file_name="*\\Documents\\SAM.export" OR file_name="*:\\sam")) OR ((file_name="*\\hive_sam_*" OR file_name="*\\sam.save*" OR file_name="*\\sam.export*" OR file_name="*\\~reg_sam.save*" OR file_name="*\\sam_backup*" OR file_name="*\\sam.bck*" OR file_name="*\\sam.backup*")))
