# Title: Potentially Suspicious Desktop Background Change Via Registry
# ID: 85b88e05-dadc-430b-8a9e-53ff1cd30aae
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems), Stephen Lincoln @slincoln-aiq (AttackIQ)
# Date: 2023-12-21
# Tags: attack.persistence, attack.impact, attack.defense-impairment, attack.t1112, attack.t1491.001
# Description: Detects registry value settings that would replace the user's desktop background.
# This is a common technique used by malware to change the desktop background to a ransom note or other image.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((registry_key_name="*Control Panel\\Desktop*" OR registry_key_name="*CurrentVersion\\Policies\\ActiveDesktop*" OR registry_key_name="*CurrentVersion\\Policies\\System*")) AND ((registry_key_name="*NoChangingWallpaper" AND Details="DWORD (0x00000001)") OR (registry_key_name="*\\Wallpaper") OR (registry_key_name="*\\WallpaperStyle" AND Details="2")) AND NOT (((registry_key_name="*\\Control Panel\\Desktop\\Wallpaper" AND Details="(Empty)") OR (process_path="*C:\\Windows\\Explorer.EXE") OR (process_path="*\\svchost.exe"))) AND NOT (((process_path="C:\\Program Files\\Amazon\\EC2Launch\\EC2Launch.exe" OR process_path="C:\\Program Files (x86)\\Amazon\\EC2Launch\\EC2Launch.exe") AND registry_key_name="*\\Control Panel\\Desktop\\Wallpaper")))
