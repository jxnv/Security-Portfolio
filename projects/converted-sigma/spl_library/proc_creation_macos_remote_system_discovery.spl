# Title: Macos Remote System Discovery
# ID: 10227522-8429-47e6-a301-f2b2d014e7ad
# Status: test
# Level: informational
# Author: Alejandro Ortuno, oscd.community
# Date: 2020-10-22
# Tags: attack.discovery, attack.t1018
# Description: Detects the enumeration of other remote systems.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* ((process_path="*/arp" AND process_exec="*-a*") OR (process_path="*/ping" AND (process_exec="* 10.*" OR process_exec="* 192.168.*" OR process_exec="* 172.16.*" OR process_exec="* 172.17.*" OR process_exec="* 172.18.*" OR process_exec="* 172.19.*" OR process_exec="* 172.20.*" OR process_exec="* 172.21.*" OR process_exec="* 172.22.*" OR process_exec="* 172.23.*" OR process_exec="* 172.24.*" OR process_exec="* 172.25.*" OR process_exec="* 172.26.*" OR process_exec="* 172.27.*" OR process_exec="* 172.28.*" OR process_exec="* 172.29.*" OR process_exec="* 172.30.*" OR process_exec="* 172.31.*" OR process_exec="* 127.*" OR process_exec="* 169.254.*")))
