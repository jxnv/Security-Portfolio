# Description: Detects remote thread creation from CACTUSTORCH as described in references.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((source_process_path="*\\System32\\cscript.exe" OR source_process_path="*\\System32\\wscript.exe" OR source_process_path="*\\System32\\mshta.exe" OR source_process_path="*\\winword.exe" OR source_process_path="*\\excel.exe") AND target_process_path="*\\SysWOW64\\*" AND NOT StartModule=*)
