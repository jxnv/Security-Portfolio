# Title: Suspicious MSDT Parent Process
# ID: 7a74da6b-ea76-47db-92cc-874ad90df734
# Status: test
# Level: high
# Author: Nextron Systems
# Date: 2022-06-01
# Tags: attack.stealth, attack.t1036, attack.t1218
# Description: Detects msdt.exe executed by a suspicious parent as seen in CVE-2022-30190 / Follina exploitation
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_path="*\\msdt.exe") OR (process_name="msdt.exe")) AND ((parent_process_path="*\\cmd.exe" OR parent_process_path="*\\cscript.exe" OR parent_process_path="*\\mshta.exe" OR parent_process_path="*\\powershell.exe" OR parent_process_path="*\\pwsh.exe" OR parent_process_path="*\\regsvr32.exe" OR parent_process_path="*\\rundll32.exe" OR parent_process_path="*\\schtasks.exe" OR parent_process_path="*\\wmic.exe" OR parent_process_path="*\\wscript.exe" OR parent_process_path="*\\wsl.exe")))
