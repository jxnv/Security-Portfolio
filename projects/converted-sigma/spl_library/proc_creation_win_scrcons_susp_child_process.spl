# Title: Script Event Consumer Spawning Process
# ID: f6d1dd2f-b8ce-40ca-bc23-062efb686b34
# Status: test
# Level: high
# Author: Sittikorn S
# Date: 2021-06-21
# Tags: attack.execution, attack.t1047
# Description: Detects a suspicious child process of Script Event Consumer (scrcons.exe).
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (parent_process_path="*\\scrcons.exe" AND (process_path="*\\svchost.exe" OR process_path="*\\dllhost.exe" OR process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe" OR process_path="*\\wscript.exe" OR process_path="*\\cscript.exe" OR process_path="*\\schtasks.exe" OR process_path="*\\regsvr32.exe" OR process_path="*\\mshta.exe" OR process_path="*\\rundll32.exe" OR process_path="*\\msiexec.exe" OR process_path="*\\msbuild.exe"))
