# Title: Uncommon  Assistive Technology Applications Execution Via AtBroker.EXE
# ID: f24bcaea-0cd1-11eb-adc1-0242ac120002
# Status: test
# Level: medium
# Author: Mateusz Wydra, oscd.community
# Date: 2020-10-12
# Tags: attack.stealth, attack.t1218
# Description: Detects the start of a non built-in assistive technology applications via "Atbroker.EXE".
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="*start*") AND ((process_path="*\\AtBroker.exe") OR (process_name="AtBroker.exe"))) AND NOT (((process_exec="*animations*" OR process_exec="*audiodescription*" OR process_exec="*caretbrowsing*" OR process_exec="*caretwidth*" OR process_exec="*colorfiltering*" OR process_exec="*cursorindicator*" OR process_exec="*cursorscheme*" OR process_exec="*filterkeys*" OR process_exec="*focusborderheight*" OR process_exec="*focusborderwidth*" OR process_exec="*highcontrast*" OR process_exec="*keyboardcues*" OR process_exec="*keyboardpref*" OR process_exec="*livecaptions*" OR process_exec="*magnifierpane*" OR process_exec="*messageduration*" OR process_exec="*minimumhitradius*" OR process_exec="*mousekeys*" OR process_exec="*Narrator*" OR process_exec="*osk*" OR process_exec="*overlappedcontent*" OR process_exec="*showsounds*" OR process_exec="*soundsentry*" OR process_exec="*speechreco*" OR process_exec="*stickykeys*" OR process_exec="*togglekeys*" OR process_exec="*voiceaccess*" OR process_exec="*windowarranging*" OR process_exec="*windowtracking*" OR process_exec="*windowtrackingtimeout*" OR process_exec="*windowtrackingzorder*"))) AND NOT ((process_exec="*Oracle_JavaAccessBridge*")))
