# Title: Suspicious Microsoft Office Child Process
# ID: 438025f9-5856-4663-83f7-52f878a70a50
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), Markus Neis, FPT.EagleEye Team, Vadim Khrykov, Cyb3rEng, Michael Haag, Christopher Peacock @securepeacock, @scythe_io
# Date: 2018-04-06
# Tags: attack.execution, attack.stealth, attack.t1047, attack.t1204.002, attack.t1218.010
# Description: Detects a suspicious process spawning from one of the Microsoft Office suite products (Word, Excel, PowerPoint, Publisher, Visio, etc.)
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((parent_process_path="*\\EQNEDT32.EXE" OR parent_process_path="*\\EXCEL.EXE" OR parent_process_path="*\\MSACCESS.EXE" OR parent_process_path="*\\MSPUB.exe" OR parent_process_path="*\\ONENOTE.EXE" OR parent_process_path="*\\POWERPNT.exe" OR parent_process_path="*\\VISIO.exe" OR parent_process_path="*\\WINWORD.EXE" OR parent_process_path="*\\wordpad.exe" OR parent_process_path="*\\wordview.exe")) AND ((((process_name="bitsadmin.exe" OR process_name="CertOC.exe" OR process_name="CertUtil.exe" OR process_name="Cmd.Exe" OR process_name="CMSTP.EXE" OR process_name="cscript.exe" OR process_name="curl.exe" OR process_name="HH.exe" OR process_name="IEExec.exe" OR process_name="InstallUtil.exe" OR process_name="javaw.exe" OR process_name="Microsoft.Workflow.Compiler.exe" OR process_name="msdt.exe" OR process_name="MSHTA.EXE" OR process_name="msiexec.exe" OR process_name="Msxsl.exe" OR process_name="odbcconf.exe" OR process_name="pcalua.exe" OR process_name="PowerShell.EXE" OR process_name="RegAsm.exe" OR process_name="RegSvcs.exe" OR process_name="REGSVR32.exe" OR process_name="RUNDLL32.exe" OR process_name="schtasks.exe" OR process_name="ScriptRunner.exe" OR process_name="wmic.exe" OR process_name="WorkFolders.exe" OR process_name="wscript.exe")) OR ((process_path="*\\AppVLP.exe" OR process_path="*\\bash.exe" OR process_path="*\\bitsadmin.exe" OR process_path="*\\certoc.exe" OR process_path="*\\certutil.exe" OR process_path="*\\cmd.exe" OR process_path="*\\cmstp.exe" OR process_path="*\\control.exe" OR process_path="*\\cscript.exe" OR process_path="*\\curl.exe" OR process_path="*\\forfiles.exe" OR process_path="*\\hh.exe" OR process_path="*\\ieexec.exe" OR process_path="*\\installutil.exe" OR process_path="*\\javaw.exe" OR process_path="*\\mftrace.exe" OR process_path="*\\Microsoft.Workflow.Compiler.exe" OR process_path="*\\msbuild.exe" OR process_path="*\\msdt.exe" OR process_path="*\\mshta.exe" OR process_path="*\\msidb.exe" OR process_path="*\\msiexec.exe" OR process_path="*\\msxsl.exe" OR process_path="*\\odbcconf.exe" OR process_path="*\\pcalua.exe" OR process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe" OR process_path="*\\regasm.exe" OR process_path="*\\regsvcs.exe" OR process_path="*\\regsvr32.exe" OR process_path="*\\rundll32.exe" OR process_path="*\\schtasks.exe" OR process_path="*\\scrcons.exe" OR process_path="*\\scriptrunner.exe" OR process_path="*\\sh.exe" OR process_path="*\\svchost.exe" OR process_path="*\\verclsid.exe" OR process_path="*\\wmic.exe" OR process_path="*\\workfolders.exe" OR process_path="*\\wscript.exe"))) OR ((process_path="*\\AppData\\*" OR process_path="*\\Users\\Public\\*" OR process_path="*\\ProgramData\\*" OR process_path="*\\Windows\\Tasks\\*" OR process_path="*\\Windows\\Temp\\*" OR process_path="*\\Windows\\System32\\Tasks\\*"))))
