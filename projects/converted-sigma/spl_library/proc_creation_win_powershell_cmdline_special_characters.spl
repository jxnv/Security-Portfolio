# Title: Potential PowerShell Command Line Obfuscation
# ID: d7bcd677-645d-4691-a8d4-7a5602b780d1
# Status: test
# Level: high
# Author: Teymur Kheirkhabarov (idea), Vasiliy Burov (rule), oscd.community, Tim Shelton (fp)
# Date: 2020-10-15
# Tags: attack.execution, attack.stealth, attack.t1027, attack.t1059.001
# Description: Detects the PowerShell command lines with special characters
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((((process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe")) OR ((process_name="PowerShell.EXE" OR process_name="pwsh.dll"))) AND ((regex process_exec="(?i)\\+.*\\+.*\\+.*\\+.*\\+.*\\+.*\\+.*\\+.*\\+.*\\+.*\\+.*\\+.*\\+.*\\+") OR (regex process_exec="(?i)\\{.*\\{.*\\{.*\\{.*\\{.*\\{.*\\{.*\\{.*\\{.*\\{") OR (regex process_exec="(?i)\\^.*\\^.*\\^.*\\^.*\\^") OR (regex process_exec="(?i)`.*`.*`.*`.*`"))) AND NOT (((parent_process_path="C:\\Program Files\\Amazon\\SSM\\ssm-document-worker.exe") OR ((process_exec="*new EventSource(\"Microsoft.Windows.Sense.Client.Management\"*" OR process_exec="*public static extern bool InstallELAMCertificateInfo(SafeFileHandle handle);*")))))
