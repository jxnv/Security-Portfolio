# Title: Potentially Suspicious Child Processes Spawned by ConHost
# ID: dfa03a09-8b92-4d83-8e74-f72839b1c407
# Status: experimental
# Level: high
# Author: Swachchhanda Shrawan Poudel (Nextron Systems)
# Date: 2025-02-05
# Tags: attack.stealth, attack.t1202, attack.t1218
# Description: Detects suspicious child processes related to Windows Shell utilities spawned by `conhost.exe`, which could indicate malicious activity using trusted system components.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((process_path="*\\cmd.exe" OR process_path="*\\cscript.exe" OR process_path="*\\mshta.exe" OR process_path="*\\powershell_ise.exe" OR process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe" OR process_path="*\\regsvr32.exe" OR process_path="*\\wscript.exe")) OR ((process_name="cmd.exe" OR process_name="cscript.exe" OR process_name="mshta.exe" OR process_name="powershell_ise.exe" OR process_name="powershell.exe" OR process_name="pwsh.dll" OR process_name="regsvr32.exe" OR process_name="wscript.exe"))) AND (parent_process_path="*\\conhost.exe"))
