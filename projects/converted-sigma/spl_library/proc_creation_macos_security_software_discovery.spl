# Title: Security Software Discovery - MacOs
# ID: 0ed75b9c-c73b-424d-9e7d-496cd565fbe0
# Status: test
# Level: medium
# Author: Daniil Yugoslavskiy, oscd.community
# Date: 2020-10-19
# Tags: attack.discovery, attack.t1518.001
# Description: Detects usage of system utilities (only grep for now) to discover security software discovery
# Converted by: Sigma Universal SIEM/EDR CLI

index=* ((process_path="/usr/bin/grep") AND (((process_exec="*nessusd*" OR process_exec="*santad*" OR process_exec="*CbDefense*" OR process_exec="*falcond*" OR process_exec="*td-agent*" OR process_exec="*packetbeat*" OR process_exec="*filebeat*" OR process_exec="*auditbeat*" OR process_exec="*osqueryd*" OR process_exec="*BlockBlock*" OR process_exec="*LuLu*")) OR ((process_exec="*Little*" AND process_exec="*Snitch*"))))
