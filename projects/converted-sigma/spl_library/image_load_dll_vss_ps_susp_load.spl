# Title: Suspicious Volume Shadow Copy VSS_PS.dll Load
# ID: 333cdbe8-27bb-4246-bf82-b41a0dca4b70
# Status: test
# Level: high
# Author: Markus Neis, @markus_neis
# Date: 2021-07-07
# Tags: attack.impact, attack.t1490
# Description: Detects the image load of vss_ps.dll by uncommon executables. This DLL is used by the Volume Shadow Copy Service (VSS) to manage shadow copies of files and volumes.
# It is often abused by attackers to delete or manipulate shadow copies, which can hinder forensic investigations and data recovery efforts.
# The fact that it is loaded by processes that are not typically associated with VSS operations can indicate suspicious activity.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((ImageLoaded="*\\vss_ps.dll") AND NOT (((NOT process_path=*) OR (process_path="C:\\Windows\\*" AND (process_path="*\\clussvc.exe" OR process_path="*\\dismhost.exe" OR process_path="*\\dllhost.exe" OR process_path="*\\inetsrv\\appcmd.exe" OR process_path="*\\inetsrv\\iissetup.exe" OR process_path="*\\msiexec.exe" OR process_path="*\\rundll32.exe" OR process_path="*\\searchindexer.exe" OR process_path="*\\srtasks.exe" OR process_path="*\\svchost.exe" OR process_path="*\\System32\\SystemPropertiesAdvanced.exe" OR process_path="*\\taskhostw.exe" OR process_path="*\\thor.exe" OR process_path="*\\thor64.exe" OR process_path="*\\tiworker.exe" OR process_path="*\\vssvc.exe" OR process_path="*\\vssadmin.exe" OR process_path="*\\WmiPrvSE.exe" OR process_path="*\\wsmprovhost.exe")) OR (process_exec="C:\\$WinREAgent\\Scratch\\*" AND process_exec="*\\dismhost.exe {*"))) AND NOT (((process_path="C:\\Program Files\\*" OR process_path="C:\\Program Files (x86)\\*"))))
