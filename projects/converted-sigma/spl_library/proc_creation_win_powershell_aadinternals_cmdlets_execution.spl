# Title: AADInternals PowerShell Cmdlets Execution - ProccessCreation
# ID: c86500e9-a645-4680-98d7-f882c70c1ea3
# Status: test
# Level: high
# Author: Austin Songer (@austinsonger), Nasreddine Bencherchali (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems)
# Date: 2022-12-23
# Tags: attack.execution, attack.reconnaissance, attack.discovery, attack.credential-access, attack.impact
# Description: Detects ADDInternals Cmdlet execution. A tool for administering Azure AD and Office 365. Which can be abused by threat actors to attack Azure AD or Office 365.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="*Add-AADInt*" OR process_exec="*ConvertTo-AADInt*" OR process_exec="*Disable-AADInt*" OR process_exec="*Enable-AADInt*" OR process_exec="*Export-AADInt*" OR process_exec="*Find-AADInt*" OR process_exec="*Get-AADInt*" OR process_exec="*Grant-AADInt*" OR process_exec="*Initialize-AADInt*" OR process_exec="*Install-AADInt*" OR process_exec="*Invoke-AADInt*" OR process_exec="*Join-AADInt*" OR process_exec="*New-AADInt*" OR process_exec="*Open-AADInt*" OR process_exec="*Read-AADInt*" OR process_exec="*Register-AADInt*" OR process_exec="*Remove-AADInt*" OR process_exec="*Reset-AADInt*" OR process_exec="*Resolve-AADInt*" OR process_exec="*Restore-AADInt*" OR process_exec="*Save-AADInt*" OR process_exec="*Search-AADInt*" OR process_exec="*Send-AADInt*" OR process_exec="*Set-AADInt*" OR process_exec="*Start-AADInt*" OR process_exec="*Unprotect-AADInt*" OR process_exec="*Update-AADInt*")) AND (((process_path="*\\powershell.exe" OR process_path="*\\powershell_ise.exe" OR process_path="*\\pwsh.exe")) OR ((process_name="PowerShell.Exe" OR process_name="pwsh.dll"))))
