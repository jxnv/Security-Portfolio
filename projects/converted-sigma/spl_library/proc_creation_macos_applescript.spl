# Title: MacOS Scripting Interpreter AppleScript
# ID: 1bc2e6c5-0885-472b-bed6-be5ea8eace55
# Status: test
# Level: medium
# Author: Alejandro Ortuno, oscd.community
# Date: 2020-10-21
# Tags: attack.execution, attack.t1059.002
# Description: Detects execution of AppleScript of the macOS scripting language AppleScript.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* ((process_path="*/osascript" AND (process_exec="* -e *" OR process_exec="*.scpt*" OR process_exec="*.js*")) AND NOT ((parent_process_path="*opencode" AND (process_exec="*osascript*" AND process_exec="* -e *" AND process_exec="*set imageData to the clipboard*" AND process_exec="*set fileRef*"))))
