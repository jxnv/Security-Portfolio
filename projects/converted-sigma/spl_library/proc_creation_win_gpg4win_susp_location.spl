# Title: File Encryption/Decryption Via Gpg4win From Suspicious Locations
# ID: e1e0b7d7-e10b-4ee4-ac49-a4bda05d320d
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
# Date: 2022-11-30
# Tags: attack.execution
# Description: Detects usage of Gpg4win to encrypt/decrypt files located in potentially suspicious locations.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((process_exec="*-passphrase*") AND (((process_path="*\\gpg.exe" OR process_path="*\\gpg2.exe")) OR (Product="GNU Privacy Guard (GnuPG)") OR (Description="GnuPG’s OpenPGP tool")) AND ((process_exec="*:\\PerfLogs\\*" OR process_exec="*:\\Temp\\*" OR process_exec="*:\\Users\\Public\\*" OR process_exec="*:\\Windows\\Temp\\*" OR process_exec="*\\AppData\\Local\\Temp\\*" OR process_exec="*\\AppData\\Roaming\\*")))
