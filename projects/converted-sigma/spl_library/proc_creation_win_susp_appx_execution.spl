# Title: Potentially Suspicious Windows App Activity
# ID: f91ed517-a6ba-471d-9910-b3b4a398c0f3
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-01-12
# Tags: attack.stealth
# Description: Detects potentially suspicious child process of applications launched from inside the WindowsApps directory. This could be a sign of a rogue ".appx" package installation/execution
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((parent_process_path="*C:\\Program Files\\WindowsApps\\*") AND (((process_exec="*cmd /c*" OR process_exec="*Invoke-*" OR process_exec="*Base64*")) OR ((process_path="*\\cmd.exe" OR process_path="*\\cscript.exe" OR process_path="*\\mshta.exe" OR process_path="*\\powershell.exe" OR process_path="*\\powershell_ise.exe" OR process_path="*\\pwsh.exe" OR process_path="*\\regsvr32.exe" OR process_path="*\\rundll32.exe" OR process_path="*\\wscript.exe"))) AND NOT (((parent_process_path="C:\\Program Files\\WindowsApps\\Microsoft.SysinternalsSuite*" AND process_path="*\\cmd.exe") OR (parent_process_path="*:\\Program Files\\WindowsApps\\Microsoft.WindowsTerminal*" AND parent_process_path="*\\WindowsTerminal.exe" AND (process_path="*\\powershell.exe" OR process_path="*\\cmd.exe" OR process_path="*\\pwsh.exe")))))
