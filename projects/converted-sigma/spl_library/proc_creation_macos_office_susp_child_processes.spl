# Title: Suspicious Microsoft Office Child Process - MacOS
# ID: 69483748-1525-4a6c-95ca-90dc8d431b68
# Status: test
# Level: high
# Author: Sohan G (D4rkCiph3r)
# Date: 2023-01-31
# Tags: attack.execution, attack.persistence, attack.t1059.002, attack.t1137.002, attack.t1204.002
# Description: Detects suspicious child processes spawning from microsoft office suite applications such as word or excel. This could indicates malicious macro execution
# Converted by: Sigma Universal SIEM/EDR CLI

index=* ((parent_process_path="*Microsoft Word*" OR parent_process_path="*Microsoft Excel*" OR parent_process_path="*Microsoft PowerPoint*" OR parent_process_path="*Microsoft OneNote*") AND (process_path="*/bash" OR process_path="*/curl" OR process_path="*/dash" OR process_path="*/fish" OR process_path="*/osacompile" OR process_path="*/osascript" OR process_path="*/sh" OR process_path="*/zsh" OR process_path="*/python" OR process_path="*/python3" OR process_path="*/wget"))
