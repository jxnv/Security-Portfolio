# Title: Suspicious File Downloaded From Direct IP Via Certutil.EXE
# ID: 13e6fe51-d478-4c7e-b0f2-6da9b400a829
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-02-15
# Tags: attack.stealth, attack.t1027, attack.command-and-control, attack.t1105
# Description: Detects the execution of certutil with certain flags that allow the utility to download files from direct IPs.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((process_exec="*urlcache *" OR process_exec="*verifyctl *" OR process_exec="*URL *")) AND ((process_exec="*://1*" OR process_exec="*://2*" OR process_exec="*://3*" OR process_exec="*://4*" OR process_exec="*://5*" OR process_exec="*://6*" OR process_exec="*://7*" OR process_exec="*://8*" OR process_exec="*://9*")) AND ((process_path="*\\certutil.exe") OR (process_name="CertUtil.exe"))) AND NOT ((process_exec="*://7-*")))
