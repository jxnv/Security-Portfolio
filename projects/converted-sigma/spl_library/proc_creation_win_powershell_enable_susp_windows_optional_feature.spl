# Title: Potential Suspicious Windows Feature Enabled - ProcCreation
# ID: c740d4cf-a1e9-41de-bb16-8a46a4f57918
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-12-29
# Tags: attack.stealth
# Description: Detects usage of the built-in PowerShell cmdlet "Enable-WindowsOptionalFeature" used as a Deployment Image Servicing and Management tool.
# Similar to DISM.exe, this cmdlet is used to enumerate, install, uninstall, configure, and update features and packages in Windows images
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="*Enable-WindowsOptionalFeature*" AND process_exec="*-Online*" AND process_exec="*-FeatureName*")) AND ((process_exec="*TelnetServer*" OR process_exec="*Internet-Explorer-Optional-amd64*" OR process_exec="*TFTP*" OR process_exec="*SMB1Protocol*" OR process_exec="*Client-ProjFS*" OR process_exec="*Microsoft-Windows-Subsystem-Linux*")))
