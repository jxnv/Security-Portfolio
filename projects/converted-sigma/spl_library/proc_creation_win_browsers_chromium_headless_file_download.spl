# Title: File Download with Headless Browser
# ID: 0e8cfe08-02c9-4815-a2f8-0d157b7ed33e
# Status: test
# Level: high
# Author: Sreeman, Florian Roth (Nextron Systems)
# Date: 2022-01-04
# Tags: attack.command-and-control, attack.stealth, attack.t1105, attack.t1564.003
# Description: Detects execution of chromium based browser in headless mode using the "dump-dom" command line to download files
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_path="*\\brave.exe" OR process_path="*\\chrome.exe" OR process_path="*\\msedge.exe" OR process_path="*\\opera.exe" OR process_path="*\\vivaldi.exe") AND (process_exec="*--headless*" AND process_exec="*dump-dom*" AND process_exec="*http*")) AND NOT ((((process_path="C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\*" OR process_path="C:\\Program Files (x86)\\Microsoft\\EdgeCore\\*" OR process_path="C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\*" OR process_path="C:\\Program Files\\Microsoft\\Edge\\Application\\*" OR process_path="C:\\Program Files\\Microsoft\\EdgeCore\\*" OR process_path="C:\\Program Files\\Microsoft\\EdgeWebView\\*" OR process_path="C:\\Program Files\\WindowsApps\\Microsoft.MicrosoftEdge*") AND (process_path="*\\msedge.exe" OR process_path="*\\msedgewebview2.exe" OR process_path="*\\MicrosoftEdge.exe") AND process_exec="*--headless --disable-gpu --disable-extensions --disable-plugins --mute-audio --no-first-run --incognito --aggressive-cache-discard --dump-dom*") OR ((process_path="*\\AppData\\Local\\Microsoft\\WindowsApps\\*" OR process_path="*\\Windows\\SystemApps\\Microsoft.MicrosoftEdge*") AND (process_path="*\\msedge.exe" OR process_path="*\\MicrosoftEdge.exe") AND process_exec="*--headless --disable-gpu --disable-extensions --disable-plugins --mute-audio --no-first-run --incognito --aggressive-cache-discard --dump-dom*"))))
