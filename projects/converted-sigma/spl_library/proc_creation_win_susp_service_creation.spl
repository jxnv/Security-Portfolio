# Title: Suspicious New Service Creation
# ID: 17a1be64-8d88-40bf-b5ff-a4f7a50ebcc8
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-07-14
# Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
# Description: Detects creation of a new service via "sc" command or the powershell "new-service" cmdlet with suspicious binary paths
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((((process_exec="*New-Service*" AND process_exec="*-BinaryPathName*")) OR (process_path="*\\sc.exe" AND (process_exec="*create*" AND process_exec="*binPath=*"))) AND ((process_exec="*powershell*" OR process_exec="*mshta*" OR process_exec="*wscript*" OR process_exec="*cscript*" OR process_exec="*svchost*" OR process_exec="*dllhost*" OR process_exec="*cmd *" OR process_exec="*cmd.exe /c*" OR process_exec="*cmd.exe /k*" OR process_exec="*cmd.exe /r*" OR process_exec="*rundll32*" OR process_exec="*C:\\Users\\Public*" OR process_exec="*\\Downloads\\*" OR process_exec="*\\Desktop\\*" OR process_exec="*\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\*" OR process_exec="*C:\\Windows\\TEMP\\*" OR process_exec="*\\AppData\\Local\\Temp*")))
