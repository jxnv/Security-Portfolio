# Title: Suspicious Git Clone
# ID: aef9d1f1-7396-4e92-a927-4567c7a495c1
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-01-03
# Tags: attack.reconnaissance, attack.t1593.003
# Description: Detects execution of "git" in order to clone a remote repository that contain suspicious keywords which might be suspicious
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog (((process_exec="* clone *" OR process_exec="*git-remote-https *")) AND (((process_path="*\\git.exe" OR process_path="*\\git-remote-https.exe")) OR (process_name="git.exe")) AND ((process_exec="*exploit*" OR process_exec="*Vulns*" OR process_exec="*vulnerability*" OR process_exec="*RemoteCodeExecution*" OR process_exec="*Invoke-*" OR process_exec="*CVE-*" OR process_exec="*poc-*" OR process_exec="*ProofOfConcept*" OR process_exec="*proxyshell*" OR process_exec="*log4shell*" OR process_exec="*eternalblue*" OR process_exec="*eternal-blue*" OR process_exec="*MS17-*")))
