# Title: Chmod Targeting Sensitive Directories
# ID: 6419afd1-3742-47a5-a7e6-b50386cd15f8
# Status: test
# Level: medium
# Author: Christopher Peacock @SecurePeacock, SCYTHE @scythe_io
# Date: 2022-06-03
# Tags: attack.defense-impairment, attack.t1222.002
# Description: Detects chmod targeting files in sensitive directory paths on Linux systems.
# Attackers may use chmod to change permissions of files in these directories to maintain persistence, escalate privileges, or disrupt system operations.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* sourcetype="syslog" ((process_path="*/chmod" AND (process_exec="*/tmp/*" OR process_exec="*/.Library/*" OR process_exec="*/etc/*" OR process_exec="*/opt/*")) AND NOT (((process_exec="chmod 700 /tmp/apt-key-gpghome.*") OR (process_exec="chmod 0775 /etc/landscape/") OR (process_exec="chmod 755 /var/tmp/mkinitramfs*") OR (process_exec="*/etc/*" AND (parent_process_exec="*/var/lib/dpkg/info/*" AND parent_process_exec="*.postinst configure*")) OR (process_exec="chmod 644 /etc/apparmor.d/tunables/home.d/ubuntu") OR (process_exec="*chmod --reference=/etc/shells*" AND parent_process_exec="*/update-shells"))))
