# Title: Suspicious Microsoft OneNote Child Process
# ID: c27515df-97a9-4162-8a60-dc0eeb51b775
# Status: test
# Level: high
# Author: Tim Rauch (Nextron Systems), Nasreddine Bencherchali (Nextron Systems), Elastic (idea)
# Date: 2022-10-21
# Tags: attack.t1566, attack.t1566.001, attack.initial-access
# Description: Detects suspicious child processes of the Microsoft OneNote application. This may indicate an attempt to execute malicious embedded objects from a .one file.
# Converted by: Sigma Universal SIEM/EDR CLI

index=* eventtype=wineventlog ((parent_process_path="*\\onenote.exe") AND ((process_path="*\\explorer.exe" AND (process_exec="*.hta*" OR process_exec="*.vb*" OR process_exec="*.wsh*" OR process_exec="*.js*" OR process_exec="*.ps*" OR process_exec="*.scr*" OR process_exec="*.pif*" OR process_exec="*.bat*" OR process_exec="*.cmd*")) OR (((process_name="bitsadmin.exe" OR process_name="CertOC.exe" OR process_name="CertUtil.exe" OR process_name="Cmd.Exe" OR process_name="CMSTP.EXE" OR process_name="cscript.exe" OR process_name="curl.exe" OR process_name="HH.exe" OR process_name="IEExec.exe" OR process_name="InstallUtil.exe" OR process_name="javaw.exe" OR process_name="Microsoft.Workflow.Compiler.exe" OR process_name="msdt.exe" OR process_name="MSHTA.EXE" OR process_name="msiexec.exe" OR process_name="Msxsl.exe" OR process_name="odbcconf.exe" OR process_name="pcalua.exe" OR process_name="PowerShell.EXE" OR process_name="RegAsm.exe" OR process_name="RegSvcs.exe" OR process_name="REGSVR32.exe" OR process_name="RUNDLL32.exe" OR process_name="schtasks.exe" OR process_name="ScriptRunner.exe" OR process_name="wmic.exe" OR process_name="WorkFolders.exe" OR process_name="wscript.exe")) OR ((process_path="*\\AppVLP.exe" OR process_path="*\\bash.exe" OR process_path="*\\bitsadmin.exe" OR process_path="*\\certoc.exe" OR process_path="*\\certutil.exe" OR process_path="*\\cmd.exe" OR process_path="*\\cmstp.exe" OR process_path="*\\control.exe" OR process_path="*\\cscript.exe" OR process_path="*\\curl.exe" OR process_path="*\\forfiles.exe" OR process_path="*\\hh.exe" OR process_path="*\\ieexec.exe" OR process_path="*\\installutil.exe" OR process_path="*\\javaw.exe" OR process_path="*\\mftrace.exe" OR process_path="*\\Microsoft.Workflow.Compiler.exe" OR process_path="*\\msbuild.exe" OR process_path="*\\msdt.exe" OR process_path="*\\mshta.exe" OR process_path="*\\msidb.exe" OR process_path="*\\msiexec.exe" OR process_path="*\\msxsl.exe" OR process_path="*\\odbcconf.exe" OR process_path="*\\pcalua.exe" OR process_path="*\\powershell.exe" OR process_path="*\\pwsh.exe" OR process_path="*\\regasm.exe" OR process_path="*\\regsvcs.exe" OR process_path="*\\regsvr32.exe" OR process_path="*\\rundll32.exe" OR process_path="*\\schtasks.exe" OR process_path="*\\scrcons.exe" OR process_path="*\\scriptrunner.exe" OR process_path="*\\sh.exe" OR process_path="*\\svchost.exe" OR process_path="*\\verclsid.exe" OR process_path="*\\wmic.exe" OR process_path="*\\workfolders.exe" OR process_path="*\\wscript.exe"))) OR ((process_path="*\\AppData\\*" OR process_path="*\\Users\\Public\\*" OR process_path="*\\ProgramData\\*" OR process_path="*\\Windows\\Tasks\\*" OR process_path="*\\Windows\\Temp\\*" OR process_path="*\\Windows\\System32\\Tasks\\*"))) AND NOT (((process_path="*\\AppData\\Local\\Microsoft\\OneDrive\\*" AND process_path="*\\FileCoAuth.exe" AND process_exec="*-Embedding") OR (process_path="*\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe" AND process_exec="*-Embedding"))))
