# Title: Potential Defense Evasion Via Rename Of Highly Relevant Binaries
# ID: 0ba1da6d-b6ce-4366-828c-18826c9de23e
# Status: test
# Level: high
# Author: Matthew Green - @mgreen27, Florian Roth (Nextron Systems), frack113
# Date: 2019-06-15
# Tags: attack.stealth, attack.t1036.003, car.2013-05-009
# Description: Detects the execution of a renamed binary often used by attackers or malware leveraging new Sysmon OriginalFileName datapoint.
# Converted by: Sigma Universal SIEM/EDR CLI

(((Description equals "Execute processes remotely") OR (Product equals "Sysinternals PsExec") OR ((Description="Windows PowerShell*" OR Description="pwsh*")) OR ((OriginalFileName equals "certutil.exe" OR OriginalFileName equals "cmstp.exe" OR OriginalFileName equals "cscript.exe" OR OriginalFileName equals "IE4UINIT.EXE" OR OriginalFileName equals "finger.exe" OR OriginalFileName equals "mshta.exe" OR OriginalFileName equals "msiexec.exe" OR OriginalFileName equals "msxsl.exe" OR OriginalFileName equals "powershell_ise.exe" OR OriginalFileName equals "powershell.exe" OR OriginalFileName equals "psexec.c" OR OriginalFileName equals "psexec.exe" OR OriginalFileName equals "psexesvc.exe" OR OriginalFileName equals "pwsh.dll" OR OriginalFileName equals "reg.exe" OR OriginalFileName equals "regsvr32.exe" OR OriginalFileName equals "rundll32.exe" OR OriginalFileName equals "WerMgr" OR OriginalFileName equals "wmic.exe" OR OriginalFileName equals "wscript.exe"))) AND NOT (((Image="*\\certutil.exe" OR Image="*\\cmstp.exe" OR Image="*\\cscript.exe" OR Image="*\\ie4uinit.exe" OR Image="*\\finger.exe" OR Image="*\\mshta.exe" OR Image="*\\msiexec.exe" OR Image="*\\msxsl.exe" OR Image="*\\powershell_ise.exe" OR Image="*\\powershell.exe" OR Image="*\\psexec.exe" OR Image="*\\psexec64.exe" OR Image="*\\psexec64a.exe" OR Image="*\\PSEXESVC.exe" OR Image="*\\pwsh.exe" OR Image="*\\reg.exe" OR Image="*\\regsvr32.exe" OR Image="*\\rundll32.exe" OR Image="*\\wermgr.exe" OR Image="*\\wmic.exe" OR Image="*\\wscript.exe"))))
