# Title: Potential Dosfuscation Activity
# ID: a77c1610-fc73-4019-8e29-0f51efc04a51
# Status: test
# Level: medium
# Author: frack113, Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-02-15
# Tags: attack.execution, attack.t1059
# Description: Detects possible payload obfuscation via the commandline
# Converted by: Sigma Universal SIEM/EDR CLI

((CommandLine contains "^^" OR CommandLine contains "^|^" OR CommandLine contains ",;," OR CommandLine contains ";;;;" OR CommandLine contains ";; ;;" OR CommandLine contains "(,(," OR CommandLine contains "%COMSPEC:~" OR CommandLine contains " c^m^d" OR CommandLine contains "^c^m^d" OR CommandLine contains " c^md" OR CommandLine contains " cm^d" OR CommandLine contains "^cm^d" OR CommandLine contains " s^et " OR CommandLine contains " s^e^t " OR CommandLine contains " se^t "))
