# Title: Password Policy Discovery - Linux
# ID: ca94a6db-8106-4737-9ed2-3e3bb826af0a
# Status: stable
# Level: low
# Author: Ömer Günal, oscd.community, Pawel Mazur
# Date: 2020-10-08
# Tags: attack.discovery, attack.t1201
# Description: Detects password policy discovery commands
# Converted by: Sigma Universal SIEM/EDR CLI

((type equals "EXECVE" AND a0 equals "chage" AND (a1 equals "--list" OR a1 equals "-l")) OR (type equals "PATH" AND (name equals "/etc/login.defs" OR name equals "/etc/pam.d/auth" OR name equals "/etc/pam.d/common-account" OR name equals "/etc/pam.d/common-auth" OR name equals "/etc/pam.d/common-password" OR name equals "/etc/pam.d/system-auth" OR name equals "/etc/security/pwquality.conf")) OR (type equals "EXECVE" AND a0 equals "passwd" AND (a1 equals "-S" OR a1 equals "--status")))
