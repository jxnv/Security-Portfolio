tails equals "explorer.exe" OR Details equals "C:\\Windows\\system32\\userinit.exe,")) OR (Image="C:\\Program Files (x86)\\Microsoft\\Temp\\*" AND Image="*\\MicrosoftEdgeUpdate.exe") OR (((TargetObject contains "\\ClickToRunStore\\HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\" OR TargetObject contains "\\ClickToRun\\REGISTRY\\MACHINE\\Software\\Microsoft\\Windows NT\\CurrentVersion\\")) OR ((Image equals "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe" OR Image equals "C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe"))) OR (Image="C:\\Windows\\Microsoft.NET\\Framework*" AND Image="*\\ngen.exe") OR ((Image="C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\*" OR Image="C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\*") AND Image="*\\OfficeClickToRun.exe") OR (Image="*\\AppData\\Local\\Microsoft\\OneDrive\\StandaloneUpdater\\OneDriveSetup.exe" AND TargetObject="*\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\Delete Cached Update Binary" AND Details="C:\\Windows\\system32\\cmd.exe /q /c del /q \"C:\\Users\\*" AND Details="*\\AppData\\Local\\Microsoft\\OneDrive\\Update\\OneDriveSetup.exe\""))))
