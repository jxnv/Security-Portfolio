# Title: Suspicious Microsoft Office Child Process
# ID: 438025f9-5856-4663-83f7-52f878a70a50
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), Markus Neis, FPT.EagleEye Team, Vadim Khrykov, Cyb3rEng, Michael Haag, Christopher Peacock @securepeacock, @scythe_io
# Date: 2018-04-06
# Tags: attack.execution, attack.stealth, attack.t1047, attack.t1204.002, attack.t1218.010
# Description: Detects a suspicious process spawning from one of the Microsoft Office suite products (Word, Excel, PowerPoint, Publisher, Visio, etc.)
# Converted by: Sigma Universal SIEM/EDR CLI

(((ParentImage="*\\EQNEDT32.EXE" OR ParentImage="*\\EXCEL.EXE" OR ParentImage="*\\MSACCESS.EXE" OR ParentImage="*\\MSPUB.exe" OR ParentImage="*\\ONENOTE.EXE" OR ParentImage="*\\POWERPNT.exe" OR ParentImage="*\\VISIO.exe" OR ParentImage="*\\WINWORD.EXE" OR ParentImage="*\\wordpad.exe" OR ParentImage="*\\wordview.exe")) AND ((((OriginalFileName equals "bitsadmin.exe" OR OriginalFileName equals "CertOC.exe" OR OriginalFileName equals "CertUtil.exe" OR OriginalFileName equals "Cmd.Exe" OR OriginalFileName equals "CMSTP.EXE" OR OriginalFileName equals "cscript.exe" OR OriginalFileName equals "curl.exe" OR OriginalFileName equals "HH.exe" OR OriginalFileName equals "IEExec.exe" OR OriginalFileName equals "InstallUtil.exe" OR OriginalFileName equals "javaw.exe" OR OriginalFileName equals "Microsoft.Workflow.Compiler.exe" OR OriginalFileName equals "msdt.exe" OR OriginalFileName equals "MSHTA.EXE" OR OriginalFileName equals "msiexec.exe" OR OriginalFileName equals "Msxsl.exe" OR OriginalFileName equals "odbcconf.exe" OR OriginalFileName equals "pcalua.exe" OR OriginalFileName equals "PowerShell.EXE" OR OriginalFileName equals "RegAsm.exe" OR OriginalFileName equals "RegSvcs.exe" OR OriginalFileName equals "REGSVR32.exe" OR OriginalFileName equals "RUNDLL32.exe" OR OriginalFileName equals "schtasks.exe" OR OriginalFileName equals "ScriptRunner.exe" OR OriginalFileName equals "wmic.exe" OR OriginalFileName equals "WorkFolders.exe" OR OriginalFileName equals "wscript.exe")) OR ((Image="*\\AppVLP.exe" OR Image="*\\bash.exe" OR Image="*\\bitsadmin.exe" OR Image="*\\certoc.exe" OR Image="*\\certutil.exe" OR Image="*\\cmd.exe" OR Image="*\\cmstp.exe" OR Image="*\\control.exe" OR Image="*\\cscript.exe" OR Image="*\\curl.exe" OR Image="*\\forfiles.exe" OR Image="*\\hh.exe" OR Image="*\\ieexec.exe" OR Image="*\\installutil.exe" OR Image="*\\javaw.exe" OR Image="*\\mftrace.exe" OR Image="*\\Microsoft.Workflow.Compiler.exe" OR Image="*\\msbuild.exe" OR Image="*\\msdt.exe" OR Image="*\\mshta.exe" OR Image="*\\msidb.exe" OR Image="*\\msiexec.exe" OR Image="*\\msxsl.exe" OR Image="*\\odbcconf.exe" OR Image="*\\pcalua.exe" OR Image="*\\powershell.exe" OR Image="*\\pwsh.exe" OR Image="*\\regasm.exe" OR Image="*\\regsvcs.exe" OR Image="*\\regsvr32.exe" OR Image="*\\rundll32.exe" OR Image="*\\schtasks.exe" OR Image="*\\scrcons.exe" OR Image="*\\scriptrunner.exe" OR Image="*\\sh.exe" OR Image="*\\svchost.exe" OR Image="*\\verclsid.exe" OR Image="*\\wmic.exe" OR Image="*\\workfolders.exe" OR Image="*\\wscript.exe"))) OR ((Image contains "\\AppData\\" OR Image contains "\\Users\\Public\\" OR Image contains "\\ProgramData\\" OR Image contains "\\Windows\\Tasks\\" OR Image contains "\\Windows\\Temp\\" OR Image contains "\\Windows\\System32\\Tasks\\"))))
