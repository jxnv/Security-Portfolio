# Description: Detects potential suspicious behaviour using secedit.exe. Such as exporting or modifying the security policy
# Converted by: Sigma Universal SIEM/EDR CLI

(((Image="*\\secedit.exe") OR (OriginalFileName equals "SeCEdit")) AND (((CommandLine contains "/configure" AND CommandLine contains "/db")) OR ((CommandLine contains "/export" AND CommandLine contains "/cfg"))))
