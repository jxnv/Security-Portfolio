# Title: Potentially Suspicious Rundll32 Activity
# ID: e593cf51-88db-4ee1-b920-37e89012a3c9
# Status: test
# Level: medium
# Author: juju4, Jonhnathan Ribeiro, oscd.community, Nasreddine Bencherchali (Nextron Systems)
# Date: 2019-01-16
# Tags: attack.stealth, attack.t1218.011
# Description: Detects suspicious execution of rundll32, with specific calls to some DLLs with known LOLBIN functionalities
# Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine contains "javascript:" AND CommandLine contains ".RegisterXLL")) OR ((CommandLine contains "url.dll" AND CommandLine contains "OpenURL")) OR ((CommandLine contains "url.dll" AND CommandLine contains "OpenURLA")) OR ((CommandLine contains "url.dll" AND CommandLine contains "FileProtocolHandler")) OR ((CommandLine contains "zipfldr.dll" AND CommandLine contains "RouteTheCall")) OR ((CommandLine contains "shell32.dll" AND CommandLine contains "Control_RunDLL")) OR ((CommandLine contains "shell32.dll" AND CommandLine contains "ShellExec_RunDLL")) OR ((CommandLine contains "mshtml.dll" AND CommandLine contains "PrintHTML")) OR ((CommandLine contains "advpack.dll" AND CommandLine contains "LaunchINFSection")) OR ((CommandLine contains "advpack.dll" AND CommandLine contains "RegisterOCX")) OR ((CommandLine contains "ieadvpack.dll" AND CommandLine contains "LaunchINFSection")) OR ((CommandLine contains "ieadvpack.dll" AND CommandLine contains "RegisterOCX")) OR ((CommandLine contains "ieframe.dll" AND CommandLine contains "OpenURL")) OR ((CommandLine contains "shdocvw.dll" AND CommandLine contains "OpenURL")) OR ((CommandLine contains "syssetup.dll" AND CommandLine contains "SetupInfObjectInstallAction")) OR ((CommandLine contains "setupapi.dll" AND CommandLine contains "InstallHinfSection")) OR ((CommandLine contains "pcwutl.dll" AND CommandLine contains "LaunchApplication")) OR ((CommandLine contains "dfshim.dll" AND CommandLine contains "ShOpenVerbApplication")) OR ((CommandLine contains "dfshim.dll" AND CommandLine contains "ShOpenVerbShortcut")) OR ((CommandLine contains "scrobj.dll" AND CommandLine contains "GenerateTypeLib" AND CommandLine contains "http")) OR ((CommandLine contains "shimgvw.dll" AND CommandLine contains "ImageView_Fullscreen" AND CommandLine contains "http")) OR ((CommandLine contains "comsvcs.dll" AND CommandLine contains "MiniDump"))) AND NOT (((ParentImage equals "C:\\Windows\\System32\\control.exe" AND ParentCommandLine contains ".cpl" AND (CommandLine contains "Shell32.dll" AND CommandLine contains "Control_RunDLL" AND CommandLine contains ".cpl")) OR (CommandLine contains "shell32.dll,Control_RunDLL desk.cpl,screensaver,@screensaver") OR (ParentImage equals "C:\\Windows\\System32\\control.exe" AND CommandLine="\"C:\\Windows\\system32\\rundll32.exe\" Shell32.dll,Control_RunDLL \"C:\\Windows\\System32\\*" AND CommandLine="*.cpl\","))))
