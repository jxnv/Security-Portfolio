# Title: Mstsc.EXE Execution From Uncommon Parent
# ID: ff3b6b39-e765-42f9-bb2c-ea6761e0e0f6
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-04-18
# Tags: attack.lateral-movement
# Description: Detects potential RDP connection via Mstsc using a local ".rdp" file located in suspicious locations.
# Converted by: Sigma Universal SIEM/EDR CLI

(((Image="*\\mstsc.exe") OR (OriginalFileName equals "mstsc.exe")) AND ((ParentImage="*\\brave.exe" OR ParentImage="*\\CCleanerBrowser.exe" OR ParentImage="*\\chrome.exe" OR ParentImage="*\\chromium.exe" OR ParentImage="*\\firefox.exe" OR ParentImage="*\\iexplore.exe" OR ParentImage="*\\microsoftedge.exe" OR ParentImage="*\\msedge.exe" OR ParentImage="*\\opera.exe" OR ParentImage="*\\vivaldi.exe" OR ParentImage="*\\whale.exe" OR ParentImage="*\\outlook.exe")))
