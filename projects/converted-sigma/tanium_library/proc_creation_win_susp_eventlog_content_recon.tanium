# Title: Potentially Suspicious EventLog Recon Activity Using Log Query Utilities
# ID: beaa66d6-aa1b-4e3c-80f5-e0145369bfaf
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
# Date: 2022-09-09
# Tags: attack.credential-access, attack.discovery, attack.t1552, attack.t1087
# Description: Detects execution of different log query utilities and commands to search and dump the content of specific event logs or look for specific event IDs.
# This technique is used by threat actors in order to extract sensitive information from events logs such as usernames, IP addresses, hostnames, etc.
# Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine contains "-InstanceId 462?" OR CommandLine contains ".eventid -eq 462?" OR CommandLine contains ".ID -eq 462?" OR CommandLine contains "EventCode=?462?" OR CommandLine contains "EventIdentifier=?462?" OR CommandLine contains "System[EventID=462?]" OR CommandLine contains "-InstanceId 4778" OR CommandLine contains ".eventid -eq 4778" OR CommandLine contains ".ID -eq 4778" OR CommandLine contains "EventCode=?4778?" OR CommandLine contains "EventIdentifier=?4778?" OR CommandLine contains "System[EventID=4778]" OR CommandLine contains "-InstanceId 25" OR CommandLine contains ".eventid -eq 25" OR CommandLine contains ".ID -eq 25" OR CommandLine contains "EventCode=?25?" OR CommandLine contains "EventIdentifier=?25?" OR CommandLine contains "System[EventID=25]" OR CommandLine contains "-InstanceId 1149" OR CommandLine contains ".eventid -eq 1149" OR CommandLine contains ".ID -eq 1149" OR CommandLine contains "EventCode=?1149?" OR CommandLine contains "EventIdentifier=?1149?" OR CommandLine contains "System[EventID=1149]" OR CommandLine contains "-InstanceId 21" OR CommandLine contains ".eventid -eq 21" OR CommandLine contains ".ID -eq 21" OR CommandLine contains "EventCode=?21?" OR CommandLine contains "EventIdentifier=?21?" OR CommandLine contains "System[EventID=21]" OR CommandLine contains "-InstanceId 22" OR CommandLine contains ".eventid -eq 22" OR CommandLine contains ".ID -eq 22" OR CommandLine contains "EventCode=?22?" OR CommandLine contains "EventIdentifier=?22?" OR CommandLine contains "System[EventID=22]")) OR ((CommandLine contains "Microsoft-Windows-PowerShell" OR CommandLine contains "Microsoft-Windows-Security-Auditing" OR CommandLine contains "Microsoft-Windows-TerminalServices-LocalSessionManager" OR CommandLine contains "Microsoft-Windows-TerminalServices-RemoteConnectionManager" OR CommandLine contains "Microsoft-Windows-Windows Defender" OR CommandLine contains "PowerShellCore" OR CommandLine contains "Security" OR CommandLine contains "Windows PowerShell"))) AND (((CommandLine contains "Select" AND CommandLine contains "Win32_NTLogEvent")) OR (((CommandLine contains " qe " OR CommandLine contains " query-events ")) AND ((Image="*\\wevtutil.exe") OR (OriginalFileName equals "wevtutil.exe"))) OR ((CommandLine contains " ntevent") AND ((Image="*\\wmic.exe") OR (OriginalFileName equals "wmic.exe"))) OR ((CommandLine contains "Get-WinEvent " OR CommandLine contains "get-eventlog "))))
