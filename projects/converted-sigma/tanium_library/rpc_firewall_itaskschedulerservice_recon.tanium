# Tags: attack.discovery
# Description: Detects remote RPC calls to read information about scheduled tasks
# Converted by: Sigma Universal SIEM/EDR CLI

((EventLog equals "RPCFW" AND EventID equals "3" AND InterfaceUuid equals "86d35949-83c9-4044-b424-db363231fd0c") AND NOT (((OpNum equals "1" OR OpNum equals "3" OR OpNum equals "4" OR OpNum equals "10" OR OpNum equals "11" OR OpNum equals "12" OR OpNum equals "13" OR OpNum equals "14" OR OpNum equals "15"))))
