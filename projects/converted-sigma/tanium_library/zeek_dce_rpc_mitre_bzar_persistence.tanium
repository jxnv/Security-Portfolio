# Description: Windows DCE-RPC functions which indicate a persistence techniques on the remote system. All credit for the Zeek mapping of the suspicious endpoint/operation field goes to MITRE.
# Converted by: Sigma Universal SIEM/EDR CLI

((endpoint equals "spoolss" AND operation equals "RpcAddMonitor") OR (endpoint equals "spoolss" AND operation equals "RpcAddPrintProcessor") OR (endpoint equals "IRemoteWinspool" AND operation equals "RpcAsyncAddMonitor") OR (endpoint equals "IRemoteWinspool" AND operation equals "RpcAsyncAddPrintProcessor") OR (endpoint equals "ISecLogon" AND operation equals "SeclCreateProcessWithLogonW") OR (endpoint equals "ISecLogon" AND operation equals "SeclCreateProcessWithLogonExW"))
