# Title: HackTool Service Registration or Execution
# ID: d26ce60c-2151-403c-9a42-49420d87b5e4
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-03-21
# Tags: attack.execution, attack.t1569.002, attack.s0029
# Description: Detects installation or execution of services
# Converted by: Sigma Universal SIEM/EDR CLI

((Provider_Name equals "Service Control Manager" AND (EventID equals "7045" OR EventID equals "7036")) AND ((ImagePath contains "bypass") OR ((ServiceName contains "cachedump" OR ServiceName contains "DumpSvc" OR ServiceName contains "gsecdump" OR ServiceName contains "pwdump" OR ServiceName contains "UACBypassedService" OR ServiceName contains "WCE SERVICE" OR ServiceName contains "WCESERVICE" OR ServiceName contains "winexesvc"))))
