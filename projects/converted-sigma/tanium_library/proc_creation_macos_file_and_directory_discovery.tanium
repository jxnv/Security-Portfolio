# Title: File and Directory Discovery - MacOS
# ID: 089dbdf6-b960-4bcc-90e3-ffc3480c20f6
# Status: test
# Level: informational
# Author: Daniil Yugoslavskiy, oscd.community
# Date: 2020-10-19
# Tags: attack.discovery, attack.t1083
# Description: Detects usage of system utilities to discover files and directories
# Converted by: Sigma Universal SIEM/EDR CLI

((Image equals "/usr/bin/file" AND CommandLine=regex("(.){200,}")) OR (Image equals "/usr/bin/find") OR (Image equals "/usr/bin/mdfind") OR (Image equals "/bin/ls" AND CommandLine contains "-R") OR 1=1)
