# Description: Detects Obfuscated Powershell via VAR++ LAUNCHER
# Converted by: Sigma Universal SIEM/EDR CLI

(Provider_Name equals "Service Control Manager" AND EventID equals "7045" AND (ImagePath contains "&&set" AND ImagePath contains "cmd" AND ImagePath contains "/c" AND ImagePath contains "-f") AND (ImagePath contains "{0}" OR ImagePath contains "{1}" OR ImagePath contains "{2}" OR ImagePath contains "{3}" OR ImagePath contains "{4}" OR ImagePath contains "{5}"))
