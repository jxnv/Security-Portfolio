# Title: NetNTLM Downgrade Attack
# ID: d3abac66-f11c-4ed0-8acb-50cc29c97eed
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), wagga
# Date: 2018-03-20
# Tags: attack.persistence, attack.defense-impairment, attack.t1685, attack.t1112
# Description: Detects NetNTLM downgrade attack
# Converted by: Sigma Universal SIEM/EDR CLI

(EventID equals "4657" AND (ObjectName contains "\\REGISTRY\\MACHINE\\SYSTEM" AND ObjectName contains "ControlSet" AND ObjectName contains "\\Control\\Lsa") AND (ObjectValueName equals "LmCompatibilityLevel" OR ObjectValueName equals "NtlmMinClientSec" OR ObjectValueName equals "RestrictSendingNTLMTraffic"))
