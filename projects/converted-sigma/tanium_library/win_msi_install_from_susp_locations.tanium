# Title: MSI Installation From Suspicious Locations
# ID: c7c8aa1c-5aff-408e-828b-998e3620b341
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-08-31
# Tags: attack.execution
# Description: Detects MSI package installation from suspicious locations
# Converted by: Sigma Universal SIEM/EDR CLI

((Provider_Name equals "MsiInstaller" AND (EventID equals "1040" OR EventID equals "1042") AND (Data contains ":\\Windows\\TEMP\\" OR Data contains "\\\\\\\\" OR Data contains "\\Desktop\\" OR Data contains "\\PerfLogs\\" OR Data contains "\\Users\\Public\\")) AND NOT (((Data contains "C:\\Windows\\TEMP\\UpdHealthTools.msi") OR (Data contains "\\AppData\\Local\\Temp\\WinGet\\"))))
