# Title: Potential SMB Relay Attack Tool Execution
# ID: 5589ab4f-a767-433c-961d-c91f3f704db1
# Status: test
# Level: critical
# Author: Florian Roth (Nextron Systems)
# Date: 2021-07-24
# Tags: attack.collection, attack.execution, attack.credential-access, attack.t1557.001
# Description: Detects different hacktools used for relay attacks on Windows for privilege escalation
# Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine contains ".exe -c \"{" AND CommandLine="*}\" -z") OR ((Image contains "PetitPotam" OR Image contains "RottenPotato" OR Image contains "HotPotato" OR Image contains "JuicyPotato" OR Image contains "\\just_dce_" OR Image contains "Juicy Potato" OR Image contains "\\temp\\rot.exe" OR Image contains "\\Potato.exe" OR Image contains "\\SpoolSample.exe" OR Image contains "\\Responder.exe" OR Image contains "\\smbrelayx" OR Image contains "\\ntlmrelayx" OR Image contains "\\LocalPotato")) OR ((CommandLine contains "Invoke-Tater" OR CommandLine contains " smbrelay" OR CommandLine contains " ntlmrelay" OR CommandLine contains "cme smb " OR CommandLine contains " /ntlm:NTLMhash " OR CommandLine contains "Invoke-PetitPotam" OR CommandLine contains ".exe -t * -p "))) AND NOT (((Image contains "HotPotatoes6" OR Image contains "HotPotatoes7" OR Image contains "HotPotatoes "))))
