# Title: Python Initiated Connection
# ID: bef0bc5a-b9ae-425d-85c6-7b2d705980c6
# Status: test
# Level: medium
# Author: frack113
# Date: 2021-12-10
# Tags: attack.discovery, attack.t1046
# Description: Detects a Python process initiating a network connection. While this often relates to package installation, it can also indicate a potential malicious script communicating with a C&C server.
# Converted by: Sigma Universal SIEM/EDR CLI

((Initiated equals "true" AND (Image contains "\\python" AND Image contains ".exe")) AND NOT (((DestinationIp equals "127.0.0.1" AND SourceIp equals "127.0.0.1") OR ((CommandLine contains "pip.exe" AND CommandLine contains "install")))) AND NOT (((ParentImage equals "C:\\ProgramData\\Anaconda3\\Scripts\\conda.exe" AND (CommandLine contains ":\\ProgramData\\Anaconda3\\Scripts\\conda-script.py" AND CommandLine contains "update")) OR (ParentImage equals "C:\\ProgramData\\Anaconda3\\python.exe" AND CommandLine contains "C:\\ProgramData\\Anaconda3\\Scripts\\jupyter-notebook-script.py"))))
