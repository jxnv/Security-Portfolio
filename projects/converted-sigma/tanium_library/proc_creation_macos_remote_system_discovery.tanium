# Title: Macos Remote System Discovery
# ID: 10227522-8429-47e6-a301-f2b2d014e7ad
# Status: test
# Level: informational
# Author: Alejandro Ortuno, oscd.community
# Date: 2020-10-22
# Tags: attack.discovery, attack.t1018
# Description: Detects the enumeration of other remote systems.
# Converted by: Sigma Universal SIEM/EDR CLI

((Image="*/arp" AND CommandLine contains "-a") OR (Image="*/ping" AND (CommandLine contains " 10." OR CommandLine contains " 192.168." OR CommandLine contains " 172.16." OR CommandLine contains " 172.17." OR CommandLine contains " 172.18." OR CommandLine contains " 172.19." OR CommandLine contains " 172.20." OR CommandLine contains " 172.21." OR CommandLine contains " 172.22." OR CommandLine contains " 172.23." OR CommandLine contains " 172.24." OR CommandLine contains " 172.25." OR CommandLine contains " 172.26." OR CommandLine contains " 172.27." OR CommandLine contains " 172.28." OR CommandLine contains " 172.29." OR CommandLine contains " 172.30." OR CommandLine contains " 172.31." OR CommandLine contains " 127." OR CommandLine contains " 169.254.")))
