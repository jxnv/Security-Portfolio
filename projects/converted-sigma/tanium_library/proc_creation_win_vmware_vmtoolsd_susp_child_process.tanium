# Title: VMToolsd Suspicious Child Process
# ID: 5687f942-867b-4578-ade7-1e341c46e99a
# Status: test
# Level: high
# Author: bohops, Bhabesh Raj
# Date: 2021-10-08
# Tags: attack.execution, attack.persistence, attack.t1059
# Description: Detects suspicious child process creations of VMware Tools process which may indicate persistence setup
# Converted by: Sigma Universal SIEM/EDR CLI

(((((Image="*\\cmd.exe" OR Image="*\\cscript.exe" OR Image="*\\mshta.exe" OR Image="*\\powershell.exe" OR Image="*\\pwsh.exe" OR Image="*\\regsvr32.exe" OR Image="*\\rundll32.exe" OR Image="*\\wscript.exe")) OR ((OriginalFileName equals "Cmd.Exe" OR OriginalFileName equals "cscript.exe" OR OriginalFileName equals "MSHTA.EXE" OR OriginalFileName equals "PowerShell.EXE" OR OriginalFileName equals "pwsh.dll" OR OriginalFileName equals "REGSVR32.EXE" OR OriginalFileName equals "RUNDLL32.EXE" OR OriginalFileName equals "wscript.exe"))) AND (ParentImage="*\\vmtoolsd.exe")) AND NOT (((Image="*\\cmd.exe" AND CommandLine equals "") OR (Image="*\\cmd.exe" AND NOT CommandLine=*) OR (Image="*\\cmd.exe" AND (CommandLine contains "\\VMware\\VMware Tools\\poweron-vm-default.bat" OR CommandLine contains "\\VMware\\VMware Tools\\poweroff-vm-default.bat" OR CommandLine contains "\\VMware\\VMware Tools\\resume-vm-default.bat" OR CommandLine contains "\\VMware\\VMware Tools\\suspend-vm-default.bat")))))
