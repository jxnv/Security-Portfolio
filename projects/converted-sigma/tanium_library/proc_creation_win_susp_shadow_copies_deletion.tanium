# Title: Shadow Copies Deletion Using Operating Systems Utilities
# ID: c947b146-0abc-4c87-9c64-b17e9d7274a2
# Status: stable
# Level: high
# Author: Florian Roth (Nextron Systems), Michael Haag, Teymur Kheirkhabarov, Daniil Yugoslavskiy, oscd.community, Andreas Hunkeler (@Karneades)
# Date: 2019-10-22
# Tags: attack.impact, attack.stealth, attack.t1070, attack.t1490
# Description: Shadow Copies deletion using operating systems utilities
# Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine contains "shadow" AND CommandLine contains "delete")) AND (((Image="*\\powershell.exe" OR Image="*\\pwsh.exe" OR Image="*\\wmic.exe" OR Image="*\\vssadmin.exe" OR Image="*\\diskshadow.exe")) OR ((OriginalFileName equals "PowerShell.EXE" OR OriginalFileName equals "pwsh.dll" OR OriginalFileName equals "wmic.exe" OR OriginalFileName equals "VSSADMIN.EXE" OR OriginalFileName equals "diskshadow.exe")))) OR (((CommandLine contains "delete" AND CommandLine contains "catalog" AND CommandLine contains "quiet")) AND ((Image="*\\wbadmin.exe") OR (OriginalFileName equals "WBADMIN.EXE"))) OR (((CommandLine contains "resize" AND CommandLine contains "shadowstorage") AND (CommandLine contains "unbounded" OR CommandLine contains "/MaxSize=")) AND ((Image="*\\vssadmin.exe") OR (OriginalFileName equals "VSSADMIN.EXE"))))
