# Title: PowerShell Core DLL Loaded By Non PowerShell Process
# ID: 092bc4b9-3d1d-43b4-a6b4-8c8acd83522f
# Status: test
# Level: medium
# Author: Tom Kern, oscd.community, Natalia Shornikova, Tim Shelton, Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
# Date: 2019-11-14
# Tags: attack.t1059.001, attack.execution
# Description: Detects loading of essential DLLs used by PowerShell by non-PowerShell process.
# Detects behavior similar to meterpreter's "load powershell" extension.
# Converted by: Sigma Universal SIEM/EDR CLI

(((Description equals "System.Management.Automation") OR (OriginalFileName equals "System.Management.Automation.dll") OR ((ImageLoaded="*\\System.Management.Automation.dll" OR ImageLoaded="*\\System.Management.Automation.ni.dll"))) AND NOT ((((Image="C:\\Windows\\Microsoft.NET\\Framework\\*" OR Image="C:\\Windows\\Microsoft.NET\\FrameworkArm\\*" OR Image="C:\\Windows\\Microsoft.NET\\FrameworkArm64\\*" OR Image="C:\\Windows\\Microsoft.NET\\Framework64\\*") AND Image="*\\mscorsvw.exe") OR ((Image equals "C:\\Windows\\System32\\dsac.exe" OR Image equals "C:\\WINDOWS\\System32\\RemoteFXvGPUDisablement.exe" OR Image equals "C:\\Windows\\System32\\runscripthelper.exe" OR Image equals "C:\\WINDOWS\\System32\\sdiagnhost.exe" OR Image equals "C:\\Windows\\System32\\ServerManager.exe" OR Image equals "C:\\Windows\\System32\\SyncAppvPublishingServer.exe" OR Image equals "C:\\Windows\\System32\\winrshost.exe" OR Image equals "C:\\Windows\\System32\\wsmprovhost.exe" OR Image equals "C:\\Windows\\SysWOW64\\winrshost.exe" OR Image equals "C:\\Windows\\SysWOW64\\wsmprovhost.exe")) OR ((Image equals "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" OR Image equals "C:\\Program Files\\PowerShell\\7\\pwsh.exe" OR Image equals "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" OR Image equals "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" OR Image equals "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" OR Image equals "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")) OR ((Image contains "C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview" OR Image contains "\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview") AND Image="*\\pwsh.exe"))) AND NOT (((NOT Image=*) OR (Image="C:\\ProgramData\\chocolatey\\choco.exe*") OR (Image="*\\Citrix\\ConfigSync\\ConfigSyncRun.exe") OR (Image="C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_*" AND Image="*\\GetHelp.exe") OR (Image="C:\\Windows\\Temp\\asgard2-agent\\*" AND (Image="*\\thor64.exe" OR Image="*\\thor.exe")) OR ((Image="C:\\Program Files (x86)\\Microsoft SQL Server Management Studio*" OR Image="C:\\Program Files\\Microsoft SQL Server Management Studio*") AND Image="*\\IDE\\Ssms.exe") OR ((Image="C:\\Program Files (x86)\\Microsoft SQL Server\\*" OR Image="C:\\Program Files\\Microsoft SQL Server\\*") AND Image="*\\Tools\\Binn\\SQLPS.exe") OR ((Image="C:\\Program Files (x86)\\Microsoft Visual Studio\\*" OR Image="C:\\Program Files\\Microsoft Visual Studio\\*")))))
