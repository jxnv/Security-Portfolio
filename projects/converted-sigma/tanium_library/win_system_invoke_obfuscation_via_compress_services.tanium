# Description: Detects Obfuscated Powershell via COMPRESS OBFUSCATION
# Converted by: Sigma Universal SIEM/EDR CLI

(Provider_Name equals "Service Control Manager" AND EventID equals "7045" AND (ImagePath contains "new-object" AND ImagePath contains "text.encoding]::ascii" AND ImagePath contains "readtoend") AND (ImagePath contains ":system.io.compression.deflatestream" OR ImagePath contains "system.io.streamreader"))
