(((Image="*\\powershell.exe" OR Image="*\\pwsh.exe") AND (CommandLine contains " -e " OR CommandLine contains " -en " OR CommandLine contains " -enc " OR CommandLine contains " -enco" OR CommandLine contains " -ec ")) AND NOT ((((ParentImage contains "C:\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\" OR ParentImage contains "\\gc_worker.exe")) OR (CommandLine contains " -Encoding "))))
