# Tags: attack.impact, attack.t1490
# Description: Detects the image load of VSS DLL by uncommon executables
# Converted by: Sigma Universal SIEM/EDR CLI

((ImageLoaded="*\\vsstrace.dll") AND NOT (((NOT Image=*) OR ((Image="C:\\Program Files\\*" OR Image="C:\\Program Files (x86)\\*")) OR (((Image equals "C:\\Windows\\explorer.exe" OR Image equals "C:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe" OR Image equals "C:\\Windows\\servicing\\TrustedInstaller.exe")) OR ((Image="C:\\Windows\\System32\\*" OR Image="C:\\Windows\\SysWOW64\\*" OR Image="C:\\Windows\\Temp\\{*" OR Image="C:\\Windows\\WinSxS\\*" OR Image="C:\\ProgramData\\Package Cache\\{*"))))) AND NOT ((((Image contains "\\temp\\is-" AND Image contains "\\avira_system_speedup.tmp")) OR (Image="C:\\$WinREAgent\\Scratch\\*"))))
