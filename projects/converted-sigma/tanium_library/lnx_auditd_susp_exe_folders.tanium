# Title: Program Executions in Suspicious Folders
# ID: a39d7fa7-3fbd-4dc2-97e1-d87f546b1bbc
# Status: test
# Level: medium
# Author: Florian Roth (Nextron Systems)
# Date: 2018-01-23
# Tags: attack.t1587, attack.t1584, attack.resource-development
# Description: Detects program executions in suspicious non-program folders related to malware or hacking activity
# Converted by: Sigma Universal SIEM/EDR CLI

(type equals "SYSCALL" AND (exe="/tmp/*" OR exe="/var/www/*" OR exe="/home/*/public_html/*" OR exe="/usr/local/apache2/*" OR exe="/usr/local/httpd/*" OR exe="/var/apache/*" OR exe="/srv/www/*" OR exe="/home/httpd/html/*" OR exe="/srv/http/*" OR exe="/usr/share/nginx/html/*" OR exe="/var/lib/pgsql/data/*" OR exe="/usr/local/mysql/data/*" OR exe="/var/lib/mysql/*" OR exe="/var/vsftpd/*" OR exe="/etc/bind/*" OR exe="/var/named/*"))
