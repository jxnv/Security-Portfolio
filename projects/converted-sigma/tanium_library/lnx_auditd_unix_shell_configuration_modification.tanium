# Title: Unix Shell Configuration Modification
# ID: a94cdd87-6c54-4678-a6cc-2814ffe5a13d
# Status: test
# Level: medium
# Author: Peter Matkovski, IAI
# Date: 2023-03-06
# Tags: attack.privilege-escalation, attack.persistence, attack.t1546.004
# Description: Detect unix shell configuration modification. Adversaries may establish persistence through executing malicious commands triggered when a new shell is opened.
# Converted by: Sigma Universal SIEM/EDR CLI

(type equals "PATH" AND (name equals "/etc/shells" OR name equals "/etc/profile" OR name equals "/etc/profile.d/*" OR name equals "/etc/bash.bashrc" OR name equals "/etc/bashrc" OR name equals "/etc/zsh/zprofile" OR name equals "/etc/zsh/zshrc" OR name equals "/etc/zsh/zlogin" OR name equals "/etc/zsh/zlogout" OR name equals "/etc/csh.cshrc" OR name equals "/etc/csh.login" OR name equals "/root/.bashrc" OR name equals "/root/.bash_profile" OR name equals "/root/.profile" OR name equals "/root/.zshrc" OR name equals "/root/.zprofile" OR name equals "/home/*/.bashrc" OR name equals "/home/*/.zshrc" OR name equals "/home/*/.bash_profile" OR name equals "/home/*/.zprofile" OR name equals "/home/*/.profile" OR name equals "/home/*/.bash_login" OR name equals "/home/*/.bash_logout" OR name equals "/home/*/.zlogin" OR name equals "/home/*/.zlogout"))
