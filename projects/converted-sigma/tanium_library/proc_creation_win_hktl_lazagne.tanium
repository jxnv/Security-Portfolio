# Title: HackTool - LaZagne Execution
# ID: c2b86e67-b880-4eec-b045-50bc98ef4844
# Status: experimental
# Level: medium
# Author: Nasreddine Bencherchali, Swachchhanda Shrawan Poudel (Nextron Systems)
# Date: 2024-06-24
# Tags: attack.credential-access
# Description: Detects the execution of the LaZagne. A utility used to retrieve multiple types of passwords stored on a local computer.
# LaZagne has been leveraged multiple times by threat actors in order to dump credentials.
# Converted by: Sigma Universal SIEM/EDR CLI

((((Image contains ":\\PerfLogs\\" OR Image contains ":\\ProgramData\\" OR Image contains ":\\Temp\\" OR Image contains ":\\Tmp\\" OR Image contains ":\\Users\\Public\\" OR Image contains ":\\Windows\\Temp\\" OR Image contains "\\$Recycle.bin" OR Image contains "\\AppData\\" OR Image contains "\\Desktop\\" OR Image contains "\\Downloads\\" OR Image contains "\\Favorites\\" OR Image contains "\\Links\\" OR Image contains "\\Music\\" OR Image contains "\\Photos\\" OR Image contains "\\Pictures\\" OR Image contains "\\Saved Games\\" OR Image contains "\\Searches\\" OR Image contains "\\Users\\Contacts\\" OR Image contains "\\Users\\Default\\" OR Image contains "\\Users\\Searches\\" OR Image contains "\\Videos\\" OR Image contains "\\Windows\\addins\\" OR Image contains "\\Windows\\Fonts\\" OR Image contains "\\Windows\\IME\\") AND (CommandLine="*.exe all" OR CommandLine="*.exe browsers" OR CommandLine="*.exe chats" OR CommandLine="*.exe databases" OR CommandLine="*.exe games" OR CommandLine="*.exe git" OR CommandLine="*.exe mails" OR CommandLine="*.exe maven" OR CommandLine="*.exe memory" OR CommandLine="*.exe multimedia" OR CommandLine="*.exe sysadmin" OR CommandLine="*.exe unused" OR CommandLine="*.exe wifi" OR CommandLine="*.exe windows")) OR (Image="*\\lazagne.exe")) OR (((CommandLine contains " all " OR CommandLine contains " browsers " OR CommandLine contains " chats " OR CommandLine contains " databases " OR CommandLine contains " games " OR CommandLine contains " mails " OR CommandLine contains " maven " OR CommandLine contains " memory " OR CommandLine contains " multimedia " OR CommandLine contains " php " OR CommandLine contains " svn " OR CommandLine contains " sysadmin " OR CommandLine contains " unused " OR CommandLine contains " wifi ")) AND ((CommandLine contains "-1Password" OR CommandLine contains "-apachedirectorystudio" OR CommandLine contains "-autologon" OR CommandLine contains "-ChromiumBased" OR CommandLine contains "-coreftp" OR CommandLine contains "-credfiles" OR CommandLine contains "-credman" OR CommandLine contains "-cyberduck" OR CommandLine contains "-dbvis" OR CommandLine contains "-EyeCon" OR CommandLine contains "-filezilla" OR CommandLine contains "-filezillaserver" OR CommandLine contains "-ftpnavigator" OR CommandLine contains "-galconfusion" OR CommandLine contains "-gitforwindows" OR CommandLine contains "-hashdump" OR CommandLine contains "-iisapppool" OR CommandLine contains "-IISCentralCertP" OR CommandLine contains "-kalypsomedia" OR CommandLine contains "-keepass" OR CommandLine contains "-keepassconfig" OR CommandLine contains "-lsa_secrets" OR CommandLine contains "-mavenrepositories" OR CommandLine contains "-memory_dump" OR CommandLine contains "-Mozilla" OR CommandLine contains "-mRemoteNG" OR CommandLine contains "-mscache" OR CommandLine contains "-opensshforwindows" OR CommandLine contains "-openvpn" OR CommandLine contains "-outlook" OR CommandLine contains "-pidgin" OR CommandLine contains "-postgresql" OR CommandLine contains "-psi-im" OR CommandLine contains "-puttycm" OR CommandLine contains "-pypykatz" OR CommandLine contains "-Rclone" OR CommandLine contains "-rdpmanager" OR CommandLine contains "-robomongo" OR CommandLine contains "-roguestale" OR CommandLine contains "-skype" OR CommandLine contains "-SQLDeveloper" OR CommandLine contains "-squirrel" OR CommandLine contains "-tortoise" OR CommandLine contains "-turba" OR CommandLine contains "-UCBrowser" OR CommandLine contains "-unattended" OR CommandLine contains "-vault" OR CommandLine contains "-vaultfiles" OR CommandLine contains "-vnc" OR CommandLine contains "-winscp"))))
