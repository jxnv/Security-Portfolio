# Title: Modify Group Policy Settings
# ID: ada4b0c4-758b-46ac-9033-9004613a150d
# Status: test
# Level: medium
# Author: frack113
# Date: 2022-08-19
# Tags: attack.privilege-escalation, attack.defense-impairment, attack.t1484.001
# Description: Detect malicious GPO modifications can be used to implement many other malicious behaviors.
# Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine contains "GroupPolicyRefreshTimeDC" OR CommandLine contains "GroupPolicyRefreshTimeOffsetDC" OR CommandLine contains "GroupPolicyRefreshTime" OR CommandLine contains "GroupPolicyRefreshTimeOffset" OR CommandLine contains "EnableSmartScreen" OR CommandLine contains "ShellSmartScreenLevel")) AND (CommandLine contains "\\SOFTWARE\\Policies\\Microsoft\\Windows\\System") AND ((Image="*\\reg.exe") OR (OriginalFileName equals "reg.exe")))
