# Title: DLL Loaded From Suspicious Location Via Cmspt.EXE
# ID: 75e508f7-932d-4ebc-af77-269237a84ce1
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-08-30
# Tags: attack.stealth, attack.t1218.003
# Description: Detects cmstp loading "dll" or "ocx" files from suspicious locations
# Converted by: Sigma Universal SIEM/EDR CLI

(Image="*\\cmstp.exe" AND (ImageLoaded contains "\\PerfLogs\\" OR ImageLoaded contains "\\ProgramData\\" OR ImageLoaded contains "\\Users\\" OR ImageLoaded contains "\\Windows\\Temp\\" OR ImageLoaded contains "C:\\Temp\\") AND (ImageLoaded="*.dll" OR ImageLoaded="*.ocx"))
