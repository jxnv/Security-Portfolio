# Title: Use NTFS Short Name in Image
# ID: 3ef5605c-9eb9-47b0-9a71-b727e6aa5c3b
# Status: test
# Level: medium
# Author: frack113, Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-08-06
# Tags: attack.stealth, attack.t1564.004
# Description: Detect use of the Windows 8.3 short name. Which could be used as a method to avoid Image based detection
# Converted by: Sigma Universal SIEM/EDR CLI

(((Image contains "~1.bat" OR Image contains "~1.dll" OR Image contains "~1.exe" OR Image contains "~1.hta" OR Image contains "~1.js" OR Image contains "~1.msi" OR Image contains "~1.ps1" OR Image contains "~1.tmp" OR Image contains "~1.vbe" OR Image contains "~1.vbs" OR Image contains "~2.bat" OR Image contains "~2.dll" OR Image contains "~2.exe" OR Image contains "~2.hta" OR Image contains "~2.js" OR Image contains "~2.msi" OR Image contains "~2.ps1" OR Image contains "~2.tmp" OR Image contains "~2.vbe" OR Image contains "~2.vbs")) AND NOT ((ParentImage equals "C:\\Windows\\explorer.exe")) AND NOT (((ParentImage="*\\thor\\thor64.exe") OR (Image="*\\VCREDI~1.EXE") OR (ParentImage="*\\WebEx\\WebexHost.exe") OR (Image equals "C:\\PROGRA~1\\WinZip\\WZPREL~1.EXE"))))
