# Title: BPFDoor Abnormal Process ID or Lock File Accessed
# ID: 808146b2-9332-4d78-9416-d7e47012d83d
# Status: test
# Level: high
# Author: Rafal Piasecki
# Date: 2022-08-10
# Tags: attack.execution, attack.t1106, attack.t1059
# Description: detects BPFDoor .lock and .pid files access in temporary file storage facility
# Converted by: Sigma Universal SIEM/EDR CLI

(type equals "PATH" AND (name equals "/var/run/aepmonend.pid" OR name equals "/var/run/auditd.lock" OR name equals "/var/run/cma.lock" OR name equals "/var/run/console-kit.pid" OR name equals "/var/run/consolekit.pid" OR name equals "/var/run/daemon.pid" OR name equals "/var/run/hald-addon.pid" OR name equals "/var/run/hald-smartd.pid" OR name equals "/var/run/haldrund.pid" OR name equals "/var/run/hp-health.pid" OR name equals "/var/run/hpasmlit.lock" OR name equals "/var/run/hpasmlited.pid" OR name equals "/var/run/kdevrund.pid" OR name equals "/var/run/lldpad.lock" OR name equals "/var/run/mcelog.pid" OR name equals "/var/run/system.pid" OR name equals "/var/run/uvp-srv.pid" OR name equals "/var/run/vmtoolagt.pid" OR name equals "/var/run/xinetd.lock"))
