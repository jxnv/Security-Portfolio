# Description: One of the Windows Eventlogs has been cleared. e.g. caused by "wevtutil cl" command execution
# Converted by: Sigma Universal SIEM/EDR CLI

((EventID equals "104" AND Provider_Name equals "Microsoft-Windows-Eventlog") AND NOT (((Channel equals "Microsoft-Windows-PowerShell/Operational" OR Channel equals "Microsoft-Windows-Sysmon/Operational" OR Channel equals "PowerShellCore/Operational" OR Channel equals "Security" OR Channel equals "System" OR Channel equals "Windows PowerShell"))))
