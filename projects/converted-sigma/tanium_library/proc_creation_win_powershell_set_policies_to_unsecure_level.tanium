# Title: Change PowerShell Policies to an Insecure Level
# ID: 87e3c4e8-a6a8-4ad9-bb4f-46e7ff99a180
# Status: test
# Level: medium
# Author: frack113
# Date: 2021-11-01
# Tags: attack.execution, attack.t1059.001
# Description: Detects changing the PowerShell script execution policy to a potentially insecure level using the "-ExecutionPolicy" flag.
# Converted by: Sigma Universal SIEM/EDR CLI

(((((OriginalFileName equals "powershell_ise.exe" OR OriginalFileName equals "PowerShell.EXE" OR OriginalFileName equals "pwsh.dll")) OR ((Image="*\\powershell_ise.exe" OR Image="*\\powershell.exe" OR Image="*\\pwsh.exe"))) AND ((CommandLine contains "Bypass" OR CommandLine contains "Unrestricted")) AND ((CommandLine contains "-executionpolicy " OR CommandLine contains " -ep " OR CommandLine contains " -exec "))) AND NOT (((ParentImage equals "C:\\Windows\\SysWOW64\\msiexec.exe" OR ParentImage equals "C:\\Windows\\System32\\msiexec.exe") AND (CommandLine contains "-NoProfile -ExecutionPolicy Bypass -File \"C:\\Program Files\\PowerShell\\7\\" OR CommandLine contains "-NoProfile -ExecutionPolicy Bypass -File \"C:\\Program Files (x86)\\PowerShell\\7\\"))) AND NOT (((ParentImage contains "C:\\Program Files\\Avast Software\\Avast\\" OR ParentImage contains "C:\\Program Files (x86)\\Avast Software\\Avast\\" OR ParentImage contains "\\instup.exe") AND (CommandLine contains "-ExecutionPolicy ByPass -File \"C:\\Program Files\\Avast Software\\Avast" OR CommandLine contains "-ExecutionPolicy ByPass -File \"C:\\Program Files (x86)\\Avast Software\\Avast\\"))))
