# Title: Renamed Office Binary Execution
# ID: 0b0cd537-fc77-4e6e-a973-e53495c1083d
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-12-20
# Tags: attack.stealth, attack.t1036.003
# Description: Detects the execution of a renamed office binary
# Converted by: Sigma Universal SIEM/EDR CLI

((((OriginalFileName equals "Excel.exe" OR OriginalFileName equals "MSACCESS.EXE" OR OriginalFileName equals "MSPUB.EXE" OR OriginalFileName equals "OneNote.exe" OR OriginalFileName equals "OneNoteM.exe" OR OriginalFileName equals "OUTLOOK.EXE" OR OriginalFileName equals "POWERPNT.EXE" OR OriginalFileName equals "WinWord.exe" OR OriginalFileName equals "Olk.exe")) OR ((Description equals "Microsoft Access" OR Description equals "Microsoft Excel" OR Description equals "Microsoft OneNote" OR Description equals "Microsoft Outlook" OR Description equals "Microsoft PowerPoint" OR Description equals "Microsoft Publisher" OR Description equals "Microsoft Word" OR Description equals "Sent to OneNote Tool"))) AND NOT (((Image="*\\EXCEL.exe" OR Image="*\\excelcnv.exe" OR Image="*\\MSACCESS.exe" OR Image="*\\MSPUB.EXE" OR Image="*\\ONENOTE.EXE" OR Image="*\\ONENOTEM.EXE" OR Image="*\\OUTLOOK.EXE" OR Image="*\\POWERPNT.EXE" OR Image="*\\WINWORD.exe" OR Image="*\\OLK.EXE"))))
