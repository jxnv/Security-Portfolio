# Title: Potentially Suspicious Electron Application CommandLine
# ID: 378a05d8-963c-46c9-bcce-13c7657eac99
# Status: test
# Level: medium
# Author: frack113, Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-09-05
# Tags: attack.execution
# Description: Detects potentially suspicious CommandLine of electron apps (teams, discord, slack, etc.). This could be a sign of abuse to proxy execution through a signed binary.
# Converted by: Sigma Universal SIEM/EDR CLI

(((CommandLine contains "--browser-subprocess-path" OR CommandLine contains "--gpu-launcher" OR CommandLine contains "--renderer-cmd-prefix" OR CommandLine contains "--utility-cmd-prefix")) AND (((Image="*\\chrome.exe" OR Image="*\\code.exe" OR Image="*\\discord.exe" OR Image="*\\GitHubDesktop.exe" OR Image="*\\keybase.exe" OR Image="*\\msedge_proxy.exe" OR Image="*\\msedge.exe" OR Image="*\\msedgewebview2.exe" OR Image="*\\msteams.exe" OR Image="*\\slack.exe" OR Image="*\\Teams.exe")) OR ((OriginalFileName equals "chrome.exe" OR OriginalFileName equals "code.exe" OR OriginalFileName equals "discord.exe" OR OriginalFileName equals "GitHubDesktop.exe" OR OriginalFileName equals "keybase.exe" OR OriginalFileName equals "msedge_proxy.exe" OR OriginalFileName equals "msedge.exe" OR OriginalFileName equals "msedgewebview2.exe" OR OriginalFileName equals "msteams.exe" OR OriginalFileName equals "slack.exe" OR OriginalFileName equals "Teams.exe"))))
