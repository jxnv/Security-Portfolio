# Description: Detects the pattern of UAC Bypass using IEInstal.exe (UACMe 64)
# Converted by: Sigma Universal SIEM/EDR CLI

(Image equals "C:\\Program Files\\Internet Explorer\\IEInstal.exe" AND TargetFilename="C:\\Users\\*" AND TargetFilename contains "\\AppData\\Local\\Temp\\" AND TargetFilename="*consent.exe")
