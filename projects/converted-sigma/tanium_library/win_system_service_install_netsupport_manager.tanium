# Tags: attack.persistence
# Description: Detects NetSupport Manager service installation on the target system.
# Converted by: Sigma Universal SIEM/EDR CLI

((Provider_Name equals "Service Control Manager" AND EventID equals "7045") AND ((ImagePath contains "\\NetSupport Manager\\client32.exe") OR (ServiceName equals "Client32")))
