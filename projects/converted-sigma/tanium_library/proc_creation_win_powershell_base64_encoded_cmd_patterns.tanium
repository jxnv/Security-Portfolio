# Title: Suspicious PowerShell Encoded Command Patterns
# ID: b9d9cc83-380b-4ba3-8d8f-60c0e7e2930c
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-05-24
# Tags: attack.execution, attack.t1059.001
# Description: Detects PowerShell command line patterns in combincation with encoded commands that often appear in malware infection chains
# Converted by: Sigma Universal SIEM/EDR CLI

((((CommandLine contains " JAB" OR CommandLine contains " SUVYI" OR CommandLine contains " SQBFAFgA" OR CommandLine contains " aWV4I" OR CommandLine contains " IAB" OR CommandLine contains " PAA" OR CommandLine contains " aQBlAHgA")) AND ((CommandLine contains " -e " OR CommandLine contains " -en " OR CommandLine contains " -enc " OR CommandLine contains " -enco")) AND (((Image="*\\powershell.exe" OR Image="*\\pwsh.exe")) OR ((OriginalFileName equals "PowerShell.Exe" OR OriginalFileName equals "pwsh.dll")))) AND NOT (((ParentImage contains "C:\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\" OR ParentImage contains "\\gc_worker.exe"))))
