# Title: System and Hardware Information Discovery
# ID: 1f358e2e-cb63-43c3-b575-dfb072a6814f
# Status: stable
# Level: informational
# Author: Ömer Günal, oscd.community
# Date: 2020-10-08
# Tags: attack.discovery, attack.t1082
# Description: Detects system information discovery commands
# Converted by: Sigma Universal SIEM/EDR CLI

(type equals "PATH" AND (name equals "/sys/class/dmi/id/bios_version" OR name equals "/sys/class/dmi/id/product_name" OR name equals "/sys/class/dmi/id/chassis_vendor" OR name equals "/proc/scsi/scsi" OR name equals "/proc/ide/hd0/model" OR name equals "/proc/version" OR name equals "/etc/*version" OR name equals "/etc/*release" OR name equals "/etc/issue"))
