# Title: Execution of Suspicious File Type Extension
# ID: c09dad97-1c78-4f71-b127-7edb2b8e491a
# Status: test
# Level: medium
# Author: Max Altgelt (Nextron Systems)
# Date: 2021-12-09
# Tags: attack.stealth
# Description: Detects whether the image specified in a process creation event doesn't refer to an ".exe" (or other known executable extension) file. This can be caused by process ghosting or other unorthodox methods to start a process.
# This rule might require some initial baselining to align with some third party tooling in the user environment.
# Converted by: Sigma Universal SIEM/EDR CLI

(NOT (((Image="*.bin" OR Image="*.cgi" OR Image="*.com" OR Image="*.exe" OR Image="*.scr" OR Image="*.tmp"))) AND NOT (((Image contains ":\\$Extend\\$Deleted\\") OR (Image contains ":\\Windows\\System32\\DriverStore\\FileRepository\\") OR ((Image equals "-" OR Image equals "")) OR ((Image equals "System" OR Image equals "Registry" OR Image equals "MemCompression" OR Image equals "vmmem")) OR (Image contains ":\\Windows\\Installer\\MSI") OR (Image contains ":\\Config.Msi\\" AND (Image="*.rbf" OR Image="*.rbs")) OR (NOT Image=*) OR ((ParentImage contains ":\\Windows\\Temp\\") OR (Image contains ":\\Windows\\Temp\\")))) AND NOT (((ParentImage contains ":\\ProgramData\\Avira\\") OR (ParentImage equals "C:\\Windows\\System32\\services.exe" AND Image="*com.docker.service") OR (Image contains ":\\Program Files\\Mozilla Firefox\\") OR (Image="*\\LZMA_EXE") OR ((Image="*:\\Program Files (x86)\\MyQ\\Server\\pcltool.dll" OR Image="*:\\Program Files\\MyQ\\Server\\pcltool.dll")) OR (Image contains "NVIDIA\\NvBackend\\" AND Image="*.dat") OR ((Image contains ":\\Program Files (x86)\\WINPAKPRO\\" OR Image contains ":\\Program Files\\WINPAKPRO\\") AND Image="*.ngn") OR ((Image contains "\\AppData\\Local\\Packages\\" AND Image contains "\\LocalState\\rootfs\\")))))
