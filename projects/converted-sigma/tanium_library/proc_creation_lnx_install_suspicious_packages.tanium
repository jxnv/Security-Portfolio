# Title: Suspicious Package Installed - Linux
# ID: 700fb7e8-2981-401c-8430-be58e189e741
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-01-03
# Tags: attack.defense-impairment, attack.t1553.004
# Description: Detects installation of suspicious packages using system installation utilities
# Converted by: Sigma Universal SIEM/EDR CLI

((((Image="*/apt" OR Image="*/apt-get") AND CommandLine contains "install") OR (Image="*/dpkg" AND (CommandLine contains "--install" OR CommandLine contains "-i")) OR (Image="*/rpm" AND CommandLine contains "-i") OR (Image="*/yum" AND (CommandLine contains "localinstall" OR CommandLine contains "install"))) AND ((CommandLine contains "nmap" OR CommandLine contains " nc" OR CommandLine contains "netcat" OR CommandLine contains "wireshark" OR CommandLine contains "tshark" OR CommandLine contains "openconnect" OR CommandLine contains "proxychains" OR CommandLine contains "socat")))
