# Title: WSL Kali-Linux Usage
# ID: 6f1a11aa-4b8a-4b7f-9e13-4d3e4ff0e0d4
# Status: experimental
# Level: high
# Author: Swachchhanda Shrawan Poudel (Nextron Systems)
# Date: 2025-10-10
# Tags: attack.stealth, attack.t1202
# Description: Detects the use of Kali Linux through Windows Subsystem for Linux
# Converted by: Sigma Universal SIEM/EDR CLI

(((((Image contains ":\\Users\\" AND Image contains "\\AppData\\Local\\packages\\KaliLinux")) OR ((Image contains ":\\Users\\" AND Image contains "\\AppData\\Local\\Microsoft\\WindowsApps\\kali.exe"))) OR (Image contains ":\\Program Files\\WindowsApps\\KaliLinux." AND Image="*\\kali.exe")) OR (((((Image contains "\\kali.exe" OR Image contains "\\KaliLinux")) OR ((CommandLine contains "Kali.exe" OR CommandLine contains "Kali-linux" OR CommandLine contains "kalilinux"))) AND ((ParentImage="*\\wsl.exe" OR ParentImage="*\\wslhost.exe"))) AND NOT (((CommandLine contains " -i " OR CommandLine contains " --install " OR CommandLine contains " --unregister ")))))
