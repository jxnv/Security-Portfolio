-- Title: 7Zip Compressing Dump Files
-- ID: ec570e53-4c76-45a9-804d-dc3f355ff7a7
-- Status: test
-- Level: medium
-- Author: Nasreddine Bencherchali (Nextron Systems)
-- Date: 2022-09-27
-- Tags: attack.collection, attack.t1560.001
-- Description: Detects execution of 7z in order to compress a file with a ".dmp"/".dump" extension, which could be a step in a process of dump file exfiltration.
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (((CommandLine ILIKE '%.dmp%' OR CommandLine ILIKE '%.dump%' OR CommandLine ILIKE '%.hdmp%')) AND ((Description ILIKE '%7-Zip%') OR ((Image ILIKE '%\\7z.exe' OR Image ILIKE '%\\7zr.exe' OR Image ILIKE '%\\7za.exe')) OR ((OriginalFileName = '7z.exe' OR OriginalFileName = '7za.exe' OR OriginalFileName = '7zr.exe'))))
