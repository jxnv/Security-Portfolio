-- Title: Suspicious Installer Package Child Process
-- ID: e0cfaecd-602d-41af-988d-f6ccebb2af26
-- Status: test
-- Level: medium
-- Author: Sohan G (D4rkCiph3r)
-- Date: 2023-02-18
-- Tags: attack.t1059, attack.t1059.007, attack.t1071, attack.t1071.001, attack.execution, attack.command-and-control
-- Description: Detects the execution of suspicious child processes from macOS installer package parent process. This includes osascript, JXA, curl and wget amongst other interpreters
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((ParentImage ILIKE '%/package_script_service' OR ParentImage ILIKE '%/installer') AND (Image ILIKE '%/sh' OR Image ILIKE '%/bash' OR Image ILIKE '%/dash' OR Image ILIKE '%/python' OR Image ILIKE '%/ruby' OR Image ILIKE '%/perl' OR Image ILIKE '%/php' OR Image ILIKE '%/javascript' OR Image ILIKE '%/osascript' OR Image ILIKE '%/tclsh' OR Image ILIKE '%/curl' OR Image ILIKE '%/wget') AND (CommandLine ILIKE '%preinstall%' OR CommandLine ILIKE '%postinstall%'))
