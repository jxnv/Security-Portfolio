-- Title: Suspicious Executable File Creation
-- ID: 74babdd6-a758-4549-9632-26535279e654
-- Status: test
-- Level: high
-- Author: frack113
-- Date: 2022-09-05
-- Tags: attack.stealth, attack.t1564
-- Description: Detect creation of suspicious executable file names.
-- Some strings look for suspicious file extensions, others look for filenames that exploit unquoted service paths.
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((TargetFilename ILIKE '%:\\$Recycle.Bin.exe' OR TargetFilename ILIKE '%:\\Documents and Settings.exe' OR TargetFilename ILIKE '%:\\MSOCache.exe' OR TargetFilename ILIKE '%:\\PerfLogs.exe' OR TargetFilename ILIKE '%:\\Recovery.exe' OR TargetFilename ILIKE '%.bat.exe' OR TargetFilename ILIKE '%.sys.exe'))
