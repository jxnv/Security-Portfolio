SELECT * FROM events WHERE (TEXT SEARCH 'Trojan*FOUND' OR TEXT SEARCH 'VirTool*FOUND' OR TEXT SEARCH 'Webshell*FOUND' OR TEXT SEARCH 'Rootkit*FOUND' OR TEXT SEARCH 'Htran*FOUND')
