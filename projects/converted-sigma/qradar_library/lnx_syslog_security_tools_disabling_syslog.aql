SELECT * FROM events WHERE (TEXT SEARCH 'stopping iptables' OR TEXT SEARCH 'stopping ip6tables' OR TEXT SEARCH 'stopping firewalld' OR TEXT SEARCH 'stopping cbdaemon' OR TEXT SEARCH 'stopping falcon-sensor')
