-- Author: Mauricio Velazco, Michael Haag
-- Date: 2021-09-02
-- Tags: attack.credential-access, attack.t1187
-- Description: Detect PetitPotam coerced authentication activity.
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (EventID = 5145 AND ShareName ILIKE '\\\\\\\\%' AND ShareName ILIKE '%\\IPC$' AND RelativeTargetName = 'lsarpc' AND SubjectUserName = 'ANONYMOUS LOGON')
