-- Title: Suspicious Uninstall of Windows Defender Feature via PowerShell
-- ID: c443012c-7928-43bf-ac20-7eda5efe61ad
-- Status: experimental
-- Level: high
-- Author: yxinmiracle
-- Date: 2025-08-22
-- Tags: attack.defense-impairment, attack.t1685
-- Description: Detects the use of PowerShell with Uninstall-WindowsFeature or Remove-WindowsFeature cmdlets to disable or remove the Windows Defender GUI feature, a common technique used by adversaries to evade defenses.
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((CommandLine ILIKE '%Windows-Defender%') AND ((CommandLine ILIKE '%Uninstall-WindowsFeature%' OR CommandLine ILIKE '%Remove-WindowsFeature%')) AND (((Image ILIKE '%\\powershell_ise.exe' OR Image ILIKE '%\\powershell.exe' OR Image ILIKE '%\\pwsh.exe')) OR ((OriginalFileName = 'PowerShell_ISE.EXE' OR OriginalFileName = 'PowerShell.EXE' OR OriginalFileName = 'pwsh.dll'))))
