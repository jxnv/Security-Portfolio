-- Title: Azure Kubernetes Sensitive Role Access
-- ID: 818fee0c-e0ec-4e45-824e-83e4817b0887
-- Status: test
-- Level: medium
-- Author: Austin Songer @austinsonger
-- Date: 2021-08-07
-- Tags: attack.impact, attack.t1485, attack.t1496, attack.t1489
-- Description: Identifies when ClusterRoles/Roles are being modified or deleted.
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((operationName = 'MICROSOFT.KUBERNETES/CONNECTEDCLUSTERS/RBAC.AUTHORIZATION.K8S.IO/ROLES/WRITE' OR operationName = 'MICROSOFT.KUBERNETES/CONNECTEDCLUSTERS/RBAC.AUTHORIZATION.K8S.IO/ROLES/DELETE' OR operationName = 'MICROSOFT.KUBERNETES/CONNECTEDCLUSTERS/RBAC.AUTHORIZATION.K8S.IO/ROLES/BIND/ACTION' OR operationName = 'MICROSOFT.KUBERNETES/CONNECTEDCLUSTERS/RBAC.AUTHORIZATION.K8S.IO/ROLES/ESCALATE/ACTION' OR operationName = 'MICROSOFT.KUBERNETES/CONNECTEDCLUSTERS/RBAC.AUTHORIZATION.K8S.IO/CLUSTERROLES/WRITE' OR operationName = 'MICROSOFT.KUBERNETES/CONNECTEDCLUSTERS/RBAC.AUTHORIZATION.K8S.IO/CLUSTERROLES/DELETE' OR operationName = 'MICROSOFT.KUBERNETES/CONNECTEDCLUSTERS/RBAC.AUTHORIZATION.K8S.IO/CLUSTERROLES/BIND/ACTION' OR operationName = 'MICROSOFT.KUBERNETES/CONNECTEDCLUSTERS/RBAC.AUTHORIZATION.K8S.IO/CLUSTERROLES/ESCALATE/ACTION'))
