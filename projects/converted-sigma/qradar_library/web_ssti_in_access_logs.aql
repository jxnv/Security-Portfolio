-- Title: Server Side Template Injection Strings
-- ID: ada3bc4f-f0fd-42b9-ba91-e105e8af7342
-- Status: test
-- Level: high
-- Author: Nasreddine Bencherchali (Nextron Systems)
-- Date: 2022-06-14
-- Tags: attack.stealth, attack.t1221
-- Description: Detects SSTI attempts sent via GET requests in access logs
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((cs-method = 'GET') AND (TEXT SEARCH '={{' OR TEXT SEARCH '=%7B%7B' OR TEXT SEARCH '=${' OR TEXT SEARCH '=$%7B' OR TEXT SEARCH '=<%=' OR TEXT SEARCH '=%3C%25=' OR TEXT SEARCH '=@(' OR TEXT SEARCH 'freemarker.template.utility.Execute' OR TEXT SEARCH '.getClass().forName('javax.script.ScriptEngineManager')' OR TEXT SEARCH 'T(org.apache.commons.io.IOUtils)') AND NOT ((sc-status = 404)))
