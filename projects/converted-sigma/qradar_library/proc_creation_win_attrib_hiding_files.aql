-- Title: Hiding Files with Attrib.exe
-- ID: 4281cb20-2994-4580-aa63-c8b86d019934
-- Status: test
-- Level: medium
-- Author: Sami Ruohonen
-- Date: 2019-01-16
-- Tags: attack.stealth, attack.t1564.001
-- Description: Detects usage of attrib.exe to hide files from users.
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (((CommandLine ILIKE '% +h %') AND ((Image ILIKE '%\\attrib.exe') OR (OriginalFileName = 'ATTRIB.EXE'))) AND NOT ((CommandLine ILIKE '%\\desktop.ini %')) AND NOT ((ParentImage ILIKE '%\\cmd.exe' AND CommandLine = '+R +H +S +A \\\\\\*.cui' AND ParentCommandLine = 'C:\\\\WINDOWS\\\\system32\\\\\\*.bat')))
