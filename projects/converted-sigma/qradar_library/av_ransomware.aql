-- Title: Antivirus - Ransomware Signature
-- ID: 4c6ca276-d4d0-4a8c-9e4c-d69832f8671f
-- Status: test
-- Level: critical
-- Author: Florian Roth (Nextron Systems), Arnim Rupp
-- Date: 2022-05-12
-- Tags: attack.t1486, attack.impact
-- Description: Detects a highly relevant Antivirus alert that reports ransomware.
-- This event must not be ignored just because the AV has blocked the malware but investigate, how it came there in the first place.
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((Signature ILIKE '%Babuk%' OR Signature ILIKE '%Babyk%' OR Signature ILIKE '%BlackWorm%' OR Signature ILIKE '%Chaos%' OR Signature ILIKE '%Cobra%' OR Signature ILIKE '%ContiCrypt%' OR Signature ILIKE '%Crypter%' OR Signature ILIKE '%Cryptes%' OR Signature ILIKE '%Cryptor%' OR Signature ILIKE '%CylanCrypt%' OR Signature ILIKE '%DelShad%' OR Signature ILIKE '%Destructor%' OR Signature ILIKE '%Filecoder%' OR Signature ILIKE '%GandCrab%' OR Signature ILIKE '%GrandCrab%' OR Signature ILIKE '%Haperlock%' OR Signature ILIKE '%Hiddentear%' OR Signature ILIKE '%HydraCrypt%' OR Signature ILIKE '%Krypt%' OR Signature ILIKE '%Lockbit%' OR Signature ILIKE '%Locker%' OR Signature ILIKE '%Mallox%' OR Signature ILIKE '%Medusa%' OR Signature ILIKE '%Phobos%' OR Signature ILIKE '%Ransom%' OR Signature ILIKE '%Rook%' OR Signature ILIKE '%Ryuk%' OR Signature ILIKE '%Ryzerlo%' OR Signature ILIKE '%Stopcrypt%' OR Signature ILIKE '%Tescrypt%' OR Signature ILIKE '%TeslaCrypt%' OR Signature ILIKE '%WannaCry%' OR Signature ILIKE '%Xorist%'))
