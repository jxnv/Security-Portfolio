-- Title: Potential DLL Sideloading Via ClassicExplorer32.dll
-- ID: caa02837-f659-466f-bca6-48bde2826ab4
-- Status: test
-- Level: medium
-- Author: frack113
-- Date: 2022-12-13
-- Tags: attack.persistence, attack.privilege-escalation, attack.execution, attack.stealth, attack.t1574.001
-- Description: Detects potential DLL sideloading using ClassicExplorer32.dll from the Classic Shell software
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((ImageLoaded ILIKE '%\\ClassicExplorer32.dll') AND NOT ((ImageLoaded ILIKE 'C:\\Program Files\\Classic Shell\\%')))
