-- Title: Security Software Discovery Via Powershell Script
-- ID: 904e8e61-8edf-4350-b59c-b905fc8e810c
-- Status: test
-- Level: medium
-- Author: frack113, Anish Bogati, Nasreddine Bencherchali (Nextron Systems)
-- Date: 2021-12-16
-- Tags: attack.discovery, attack.t1518.001
-- Description: Detects calls to "get-process" where the output is piped to a "where-object" filter to search for security solution processes.
-- Adversaries may attempt to get a listing of security software, configurations, defensive tools, and sensors that are installed on a system or in a cloud environment. This may include things such as firewall rules and anti-virus
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (((ScriptBlockText ILIKE '%get-process | \\?%' OR ScriptBlockText ILIKE '%get-process | where%' OR ScriptBlockText ILIKE '%gps | \\?%' OR ScriptBlockText ILIKE '%gps | where%')) AND ((ScriptBlockText ILIKE '%Company -like%' OR ScriptBlockText ILIKE '%Description -like%' OR ScriptBlockText ILIKE '%Name -like%' OR ScriptBlockText ILIKE '%Path -like%' OR ScriptBlockText ILIKE '%Product -like%')) AND ((ScriptBlockText ILIKE '%\\*avira\\*%' OR ScriptBlockText ILIKE '%\\*carbonblack\\*%' OR ScriptBlockText ILIKE '%\\*cylance\\*%' OR ScriptBlockText ILIKE '%\\*defender\\*%' OR ScriptBlockText ILIKE '%\\*kaspersky\\*%' OR ScriptBlockText ILIKE '%\\*malware\\*%' OR ScriptBlockText ILIKE '%\\*sentinel\\*%' OR ScriptBlockText ILIKE '%\\*symantec\\*%' OR ScriptBlockText ILIKE '%\\*virus\\*%')))
