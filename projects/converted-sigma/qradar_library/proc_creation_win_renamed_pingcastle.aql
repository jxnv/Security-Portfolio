-- Title: Renamed PingCastle Binary Execution
-- ID: 2433a154-bb3d-42e4-86c3-a26bdac91c45
-- Status: test
-- Level: high
-- Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
-- Date: 2024-01-11
-- Tags: attack.execution, attack.stealth, attack.t1059, attack.t1202
-- Description: Detects the execution of a renamed "PingCastle" binary based on the PE metadata fields.
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((((OriginalFileName = 'PingCastleReporting.exe' OR OriginalFileName = 'PingCastleCloud.exe' OR OriginalFileName = 'PingCastle.exe')) OR ((CommandLine ILIKE '%--scanner aclcheck%' OR CommandLine ILIKE '%--scanner antivirus%' OR CommandLine ILIKE '%--scanner computerversion%' OR CommandLine ILIKE '%--scanner foreignusers%' OR CommandLine ILIKE '%--scanner laps_bitlocker%' OR CommandLine ILIKE '%--scanner localadmin%' OR CommandLine ILIKE '%--scanner nullsession%' OR CommandLine ILIKE '%--scanner nullsession-trust%' OR CommandLine ILIKE '%--scanner oxidbindings%' OR CommandLine ILIKE '%--scanner remote%' OR CommandLine ILIKE '%--scanner share%' OR CommandLine ILIKE '%--scanner smb%' OR CommandLine ILIKE '%--scanner smb3querynetwork%' OR CommandLine ILIKE '%--scanner spooler%' OR CommandLine ILIKE '%--scanner startup%' OR CommandLine ILIKE '%--scanner zerologon%')) OR (CommandLine ILIKE '%--no-enum-limit%') OR ((CommandLine ILIKE '%--healthcheck%' AND CommandLine ILIKE '%--level Full%')) OR ((CommandLine ILIKE '%--healthcheck%' AND CommandLine ILIKE '%--server %'))) AND NOT (((Image ILIKE '%\\PingCastleReporting.exe' OR Image ILIKE '%\\PingCastleCloud.exe' OR Image ILIKE '%\\PingCastle.exe'))))
