-- Title: CobaltStrike Load by Rundll32
-- ID: ae9c6a7c-9521-42a6-915e-5aaa8689d529
-- Status: test
-- Level: high
-- Author: Wojciech Lesicki
-- Date: 2021-06-01
-- Tags: attack.stealth, attack.t1218.011
-- Description: Rundll32 can be use by Cobalt Strike with StartW function to load DLLs from the command line.
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((CommandLine ILIKE '%.dll%' AND (CommandLine ILIKE '% StartW' OR CommandLine ILIKE '%,StartW')) AND ((Image ILIKE '%\\rundll32.exe') OR (OriginalFileName = 'RUNDLL32.EXE') OR ((CommandLine ILIKE '%rundll32.exe%' OR CommandLine ILIKE '%rundll32 %'))))
