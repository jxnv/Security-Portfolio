-- Title: Django Framework Exceptions
-- ID: fd435618-981e-4a7c-81f8-f78ce480d616
-- Status: stable
-- Level: medium
-- Author: Thomas Patzke
-- Date: 2017-08-05
-- Tags: attack.initial-access, attack.t1190
-- Description: Detects suspicious Django web application framework exceptions that could indicate exploitation attempts
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (TEXT SEARCH 'SuspiciousOperation' OR TEXT SEARCH 'DisallowedHost' OR TEXT SEARCH 'DisallowedModelAdminLookup' OR TEXT SEARCH 'DisallowedModelAdminToField' OR TEXT SEARCH 'DisallowedRedirect' OR TEXT SEARCH 'InvalidSessionKey' OR TEXT SEARCH 'RequestDataTooBig' OR TEXT SEARCH 'SuspiciousFileOperation' OR TEXT SEARCH 'SuspiciousMultipartForm' OR TEXT SEARCH 'SuspiciousSession' OR TEXT SEARCH 'TooManyFieldsSent' OR TEXT SEARCH 'PermissionDenied')
