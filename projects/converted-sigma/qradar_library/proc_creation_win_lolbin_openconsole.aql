-- Title: Use of OpenConsole
-- ID: 814c95cc-8192-4378-a70a-f1aafd877af1
-- Status: test
-- Level: medium
-- Author: Nasreddine Bencherchali (Nextron Systems)
-- Date: 2022-06-16
-- Tags: attack.execution, attack.t1059
-- Description: Detects usage of OpenConsole binary as a LOLBIN to launch other binaries to bypass application Whitelisting
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (((OriginalFileName = 'OpenConsole.exe') OR (Image ILIKE '%\\OpenConsole.exe')) AND NOT ((Image ILIKE 'C:\\Program Files\\WindowsApps\\Microsoft.WindowsTerminal%')))
