-- Title: Relevant Anti-Virus Signature Keywords In Application Log
-- ID: 78bc5783-81d9-4d73-ac97-59f6db4f72a8
-- Status: test
-- Level: high
-- Author: Florian Roth (Nextron Systems), Arnim Rupp
-- Date: 2017-02-19
-- Tags: attack.resource-development, attack.t1588
-- Description: Detects potentially highly relevant antivirus events in the application log based on known virus signature names and malware keywords.
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((TEXT SEARCH 'Adfind' OR TEXT SEARCH 'ASP/BackDoor ' OR TEXT SEARCH 'ATK/' OR TEXT SEARCH 'Backdoor.ASP' OR TEXT SEARCH 'Backdoor.Cobalt' OR TEXT SEARCH 'Backdoor.JSP' OR TEXT SEARCH 'Backdoor.PHP' OR TEXT SEARCH 'Blackworm' OR TEXT SEARCH 'Brutel' OR TEXT SEARCH 'BruteR' OR TEXT SEARCH 'Chopper' OR TEXT SEARCH 'Cobalt' OR TEXT SEARCH 'COBEACON' OR TEXT SEARCH 'Cometer' OR TEXT SEARCH 'CRYPTES' OR TEXT SEARCH 'Cryptor' OR TEXT SEARCH 'Destructor' OR TEXT SEARCH 'DumpCreds' OR TEXT SEARCH 'Exploit.Script.CVE' OR TEXT SEARCH 'FastReverseProxy' OR TEXT SEARCH 'Filecoder' OR TEXT SEARCH 'GrandCrab ' OR TEXT SEARCH 'HackTool' OR TEXT SEARCH 'HKTL' OR TEXT SEARCH 'HTool-' OR TEXT SEARCH '/HTool' OR TEXT SEARCH '.HTool' OR TEXT SEARCH 'IISExchgSpawnCMD' OR TEXT SEARCH 'Impacket' OR TEXT SEARCH 'JSP/BackDoor ' OR TEXT SEARCH 'Keylogger' OR TEXT SEARCH 'Koadic' OR TEXT SEARCH 'Krypt' OR TEXT SEARCH 'Lazagne' OR TEXT SEARCH 'Metasploit' OR TEXT SEARCH 'Meterpreter' OR TEXT SEARCH 'MeteTool' OR TEXT SEARCH 'mikatz' OR TEXT SEARCH 'Mimikatz' OR TEXT SEARCH 'Mpreter' OR TEXT SEARCH 'MsfShell' OR TEXT SEARCH 'Nighthawk' OR TEXT SEARCH 'Packed.Generic.347' OR TEXT SEARCH 'PentestPowerShell' OR TEXT SEARCH 'Phobos' OR TEXT SEARCH 'PHP/BackDoor ' OR TEXT SEARCH 'Potato' OR TEXT SEARCH 'PowerSploit' OR TEXT SEARCH 'PowerSSH' OR TEXT SEARCH 'PshlSpy' OR TEXT SEARCH 'PSWTool' OR TEXT SEARCH 'PWCrack' OR TEXT SEARCH 'PWDump' OR TEXT SEARCH 'Ransom' OR TEXT SEARCH 'Rozena' OR TEXT SEARCH 'Ryzerlo' OR TEXT SEARCH 'Sbelt' OR TEXT SEARCH 'Seatbelt' OR TEXT SEARCH 'SecurityTool ' OR TEXT SEARCH 'SharpDump' OR TEXT SEARCH 'Shellcode' OR TEXT SEARCH 'Sliver' OR TEXT SEARCH 'Splinter' OR TEXT SEARCH 'Swrort' OR TEXT SEARCH 'Tescrypt' OR TEXT SEARCH 'TeslaCrypt' OR TEXT SEARCH 'TurtleLoader' OR TEXT SEARCH 'Valyria' OR TEXT SEARCH 'Webshell') AND NOT (((TEXT SEARCH 'anti_ransomware_service.exe' OR TEXT SEARCH 'Anti-Ransomware' OR TEXT SEARCH 'Crack' OR TEXT SEARCH 'cyber-protect-service.exe' OR TEXT SEARCH 'encryptor' OR TEXT SEARCH 'Keygen') OR (Level = 4) OR (Provider_Name = 'Microsoft-Windows-RestartManager'))))
