-- Tags: attack.privilege-escalation, attack.stealth, attack.t1055
-- Description: Detects the use of CoercedPotato, a tool for privilege escalation
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((Image ILIKE '%\\CoercedPotato.exe') OR ((Hashes ILIKE '%IMPHASH=A75D7669DB6B2E107A44C4057FF7F7D6%' OR Hashes ILIKE '%IMPHASH=F91624350E2C678C5DCBE5E1F24E22C9%' OR Hashes ILIKE '%IMPHASH=14C81850A079A87E83D50CA41C709A15%')) OR (CommandLine ILIKE '% --exploitId %'))
