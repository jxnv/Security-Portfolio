-- Title: Powershell Local Email Collection
-- ID: 2837e152-93c8-43d2-85ba-c3cd3c2ae614
-- Status: test
-- Level: medium
-- Author: frack113
-- Date: 2021-07-21
-- Tags: attack.collection, attack.t1114.001
-- Description: Adversaries may target user email on local systems to collect sensitive information.
-- Files containing email data can be acquired from a users local system, such as Outlook storage or cache files.
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((ScriptBlockText ILIKE '%Get-Inbox.ps1%' OR ScriptBlockText ILIKE '%Microsoft.Office.Interop.Outlook%' OR ScriptBlockText ILIKE '%Microsoft.Office.Interop.Outlook.olDefaultFolders%' OR ScriptBlockText ILIKE '%-comobject outlook.application%'))
