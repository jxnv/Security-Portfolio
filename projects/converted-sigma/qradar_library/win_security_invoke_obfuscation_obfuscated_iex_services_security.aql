-- Title: Invoke-Obfuscation Obfuscated IEX Invocation - Security
-- ID: fd0f5778-d3cb-4c9a-9695-66759d04702a
-- Status: test
-- Level: high
-- Author: Daniel Bohannon (@Mandiant/@FireEye), oscd.community
-- Date: 2019-11-08
-- Tags: attack.stealth, attack.t1027
-- Description: Detects all variations of obfuscated powershell IEX invocation code generated by Invoke-Obfuscation framework from the code block linked in the references
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((EventID = 4697) AND ((ServiceFileName MATCHES '\$PSHome\[\s*\d{1,3}\s*\]\s*\+\s*\$PSHome\[') OR (ServiceFileName MATCHES '\$ShellId\[\s*\d{1,3}\s*\]\s*\+\s*\$ShellId\[') OR (ServiceFileName MATCHES '\$env:Public\[\s*\d{1,3}\s*\]\s*\+\s*\$env:Public\[') OR (ServiceFileName MATCHES '\$env:ComSpec\[(\s*\d{1,3}\s*,){2}') OR (ServiceFileName MATCHES '\\*mdr\*\W\s*\)\.Name') OR (ServiceFileName MATCHES '\$VerbosePreference\.ToString\(') OR (ServiceFileName MATCHES '\String\]\s*\$VerbosePreference')))
