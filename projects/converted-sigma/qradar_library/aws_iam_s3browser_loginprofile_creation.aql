-- Title: AWS IAM S3Browser LoginProfile Creation
-- ID: db014773-b1d3-46bd-ba26-133337c0ffee
-- Status: test
-- Level: high
-- Author: daniel.bohannon@permiso.io (@danielhbohannon)
-- Date: 2023-05-17
-- Tags: attack.execution, attack.persistence, attack.initial-access, attack.privilege-escalation, attack.stealth, attack.t1059.009, attack.t1078.004
-- Description: Detects S3 Browser utility performing reconnaissance looking for existing IAM Users without a LoginProfile defined then (when found) creating a LoginProfile.
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (eventSource = 'iam.amazonaws.com' AND (eventName = 'GetLoginProfile' OR eventName = 'CreateLoginProfile') AND userAgent ILIKE '%S3 Browser%')
