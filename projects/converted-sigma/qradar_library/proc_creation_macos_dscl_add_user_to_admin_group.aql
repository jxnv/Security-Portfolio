-- Title: User Added To Admin Group Via Dscl
-- ID: b743623c-2776-40e0-87b1-682b975d0ca5
-- Status: test
-- Level: medium
-- Author: Sohan G (D4rkCiph3r)
-- Date: 2023-03-19
-- Tags: attack.persistence, attack.initial-access, attack.privilege-escalation, attack.stealth, attack.t1078.003
-- Description: Detects attempts to create and add an account to the admin group via "dscl"
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (Image ILIKE '%/dscl' AND (CommandLine ILIKE '% -append %' AND CommandLine ILIKE '% /Groups/admin %' AND CommandLine ILIKE '% GroupMembership %'))
