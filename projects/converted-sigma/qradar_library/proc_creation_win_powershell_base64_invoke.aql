-- Title: PowerShell Base64 Encoded Invoke Keyword
-- ID: 6385697e-9f1b-40bd-8817-f4a91f40508e
-- Status: test
-- Level: high
-- Author: pH-T (Nextron Systems), Harjot Singh, @cyb3rjy0t
-- Date: 2022-05-20
-- Tags: attack.execution, attack.stealth, attack.t1059.001, attack.t1027
-- Description: Detects UTF-8 and UTF-16 Base64 encoded powershell 'Invoke-' calls
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((CommandLine ILIKE '% -e%') AND ((CommandLine ILIKE '%SQBuAHYAbwBrAGUALQ%' OR CommandLine ILIKE '%kAbgB2AG8AawBlAC0A%' OR CommandLine ILIKE '%JAG4AdgBvAGsAZQAtA%' OR CommandLine ILIKE '%SW52b2tlL%' OR CommandLine ILIKE '%ludm9rZS%' OR CommandLine ILIKE '%JbnZva2Ut%')) AND (((Image ILIKE '%\\powershell.exe' OR Image ILIKE '%\\pwsh.exe')) OR ((OriginalFileName = 'PowerShell.EXE' OR OriginalFileName = 'pwsh.dll'))))
