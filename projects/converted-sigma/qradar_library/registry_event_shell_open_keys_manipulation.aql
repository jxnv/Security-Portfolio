-- Title: Shell Open Registry Keys Manipulation
-- ID: 152f3630-77c1-4284-bcc0-4cc68ab2f6e7
-- Status: test
-- Level: high
-- Author: Christian Burkard (Nextron Systems)
-- Date: 2021-08-30
-- Tags: attack.persistence, attack.privilege-escalation, attack.t1548.002, attack.t1546.001
-- Description: Detects manipulation of shell open command registry keys such as "ms-settings" and "exefile",
-- which are commonly abused to achieve UAC bypass (e.g. via fodhelper.exe) or establish persistence
-- through file association hijacking.
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (((EventType = 'SetValue' AND TargetObject ILIKE '%Classes\\ms-settings\\shell\\open\\command\\SymbolicLinkValue' AND Details ILIKE '%\\Software\\Classes\\{%') OR (TargetObject ILIKE '%Classes\\ms-settings\\shell\\open\\command\\DelegateExecute') OR (EventType = 'SetValue' AND (TargetObject ILIKE '%Classes\\ms-settings\\shell\\open\\command\\(Default)' OR TargetObject ILIKE '%Classes\\exefile\\shell\\open\\command\\(Default)'))) AND NOT ((((Details = '{4813071a-41ad-44a2-9835-886d2f63ca30}' OR Details = '{A56A841F-E974-45C1-8001-7E3F8A085917}' OR Details = '{4ED3A719-CEA8-4BD9-910D-E252F997AFC2}' OR Details = '{BFEC0C93-0B7D-4F2C-B09C-AFFFC4BDAE78}')) OR (Details = '(Empty)'))))
