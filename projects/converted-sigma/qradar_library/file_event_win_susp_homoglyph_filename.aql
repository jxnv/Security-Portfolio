-- Title: Potential Homoglyph Attack Using Lookalike Characters in Filename
-- ID: 4f1707b1-b50b-45b4-b5a2-3978b5a5d0d6
-- Status: test
-- Level: medium
-- Author: Micah Babinski, @micahbabinski
-- Date: 2023-05-08
-- Tags: attack.stealth, attack.t1036, attack.t1036.003
-- Description: Detects the presence of unicode characters which are homoglyphs, or identical in appearance, to ASCII letter characters.
-- This is used as an obfuscation and masquerading techniques. Only "perfect" homoglyphs are included; these are characters that
-- are indistinguishable from ASCII characters and thus may make excellent candidates for homoglyph attack characters.
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (((TargetFilename ILIKE '%а%' OR TargetFilename ILIKE '%е%' OR TargetFilename ILIKE '%о%' OR TargetFilename ILIKE '%р%' OR TargetFilename ILIKE '%с%' OR TargetFilename ILIKE '%х%' OR TargetFilename ILIKE '%ѕ%' OR TargetFilename ILIKE '%і%' OR TargetFilename ILIKE '%ӏ%' OR TargetFilename ILIKE '%ј%' OR TargetFilename ILIKE '%һ%' OR TargetFilename ILIKE '%ԁ%' OR TargetFilename ILIKE '%ԛ%' OR TargetFilename ILIKE '%ԝ%' OR TargetFilename ILIKE '%ο%')) OR ((TargetFilename ILIKE '%А%' OR TargetFilename ILIKE '%В%' OR TargetFilename ILIKE '%Е%' OR TargetFilename ILIKE '%К%' OR TargetFilename ILIKE '%М%' OR TargetFilename ILIKE '%Н%' OR TargetFilename ILIKE '%О%' OR TargetFilename ILIKE '%Р%' OR TargetFilename ILIKE '%С%' OR TargetFilename ILIKE '%Т%' OR TargetFilename ILIKE '%Х%' OR TargetFilename ILIKE '%Ѕ%' OR TargetFilename ILIKE '%І%' OR TargetFilename ILIKE '%Ј%' OR TargetFilename ILIKE '%Ү%' OR TargetFilename ILIKE '%Ӏ%' OR TargetFilename ILIKE '%Ԍ%' OR TargetFilename ILIKE '%Ԛ%' OR TargetFilename ILIKE '%Ԝ%' OR TargetFilename ILIKE '%Α%' OR TargetFilename ILIKE '%Β%' OR TargetFilename ILIKE '%Ε%' OR TargetFilename ILIKE '%Ζ%' OR TargetFilename ILIKE '%Η%' OR TargetFilename ILIKE '%Ι%' OR TargetFilename ILIKE '%Κ%' OR TargetFilename ILIKE '%Μ%' OR TargetFilename ILIKE '%Ν%' OR TargetFilename ILIKE '%Ο%' OR TargetFilename ILIKE '%Ρ%' OR TargetFilename ILIKE '%Τ%' OR TargetFilename ILIKE '%Υ%' OR TargetFilename ILIKE '%Χ%')))
