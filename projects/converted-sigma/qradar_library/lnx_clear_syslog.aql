-- Title: Commands to Clear or Remove the Syslog - Builtin
-- ID: e09eb557-96d2-4de9-ba2d-30f712a5afd3
-- Status: test
-- Level: high
-- Author: Max Altgelt (Nextron Systems)
-- Date: 2021-09-10
-- Tags: attack.impact, attack.t1565.001
-- Description: Detects specific commands commonly used to remove or empty the syslog
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((TEXT SEARCH 'rm /var/log/syslog' OR TEXT SEARCH 'rm -r /var/log/syslog' OR TEXT SEARCH 'rm -f /var/log/syslog' OR TEXT SEARCH 'rm -rf /var/log/syslog' OR TEXT SEARCH 'mv /var/log/syslog' OR TEXT SEARCH ' >/var/log/syslog' OR TEXT SEARCH ' > /var/log/syslog') AND NOT ((TEXT SEARCH '/syslog.')))
