-- Title: Suspicious ScreenSave Change by Reg.exe
-- ID: 0fc35fc3-efe6-4898-8a37-0b233339524f
-- Status: test
-- Level: medium
-- Author: frack113
-- Date: 2021-08-19
-- Tags: attack.persistence, attack.privilege-escalation, attack.t1546.002
-- Description: Adversaries may establish persistence by executing malicious content triggered by user inactivity.
-- Screensavers are programs that execute after a configurable time of user inactivity and consist of Portable Executable (PE) files with a .scr file extension
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((Image ILIKE '%\\reg.exe' AND (CommandLine ILIKE '%HKEY_CURRENT_USER\\Control Panel\\Desktop%' OR CommandLine ILIKE '%HKCU\\Control Panel\\Desktop%')) AND (((CommandLine ILIKE '%/v ScreenSaveActive%' AND CommandLine ILIKE '%/t REG_SZ%' AND CommandLine ILIKE '%/d 1%' AND CommandLine ILIKE '%/f%')) OR ((CommandLine ILIKE '%/v ScreenSaveTimeout%' AND CommandLine ILIKE '%/t REG_SZ%' AND CommandLine ILIKE '%/d %' AND CommandLine ILIKE '%/f%')) OR ((CommandLine ILIKE '%/v ScreenSaverIsSecure%' AND CommandLine ILIKE '%/t REG_SZ%' AND CommandLine ILIKE '%/d 0%' AND CommandLine ILIKE '%/f%')) OR ((CommandLine ILIKE '%/v SCRNSAVE.EXE%' AND CommandLine ILIKE '%/t REG_SZ%' AND CommandLine ILIKE '%/d %' AND CommandLine ILIKE '%.scr%' AND CommandLine ILIKE '%/f%'))))
