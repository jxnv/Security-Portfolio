-- Title: Suspicious WSMAN Provider Image Loads
-- ID: ad1f4bb9-8dfb-4765-adb6-2a7cfb6c0f94
-- Status: test
-- Level: medium
-- Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
-- Date: 2020-06-24
-- Tags: attack.execution, attack.t1059.001, attack.lateral-movement, attack.t1021.003
-- Description: Detects signs of potential use of the WSMAN provider from uncommon processes locally and remote execution.
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (((((ImageLoaded ILIKE '%\\WsmSvc.dll' OR ImageLoaded ILIKE '%\\WsmAuto.dll' OR ImageLoaded ILIKE '%\\Microsoft.WSMan.Management.ni.dll')) OR ((OriginalFileName = 'WsmSvc.dll' OR OriginalFileName = 'WSMANAUTOMATION.DLL' OR OriginalFileName = 'Microsoft.WSMan.Management.dll'))) OR (Image ILIKE '%\\svchost.exe' AND OriginalFileName = 'WsmWmiPl.dll')) AND NOT (((Image ILIKE 'C:\\Program Files\\Citrix\\%') OR ((Image = 'C:\\Program Files (x86)\\PowerShell\\6\\pwsh.exe' OR Image = 'C:\\Program Files (x86)\\PowerShell\\7\\pwsh.exe' OR Image = 'C:\\Program Files\\PowerShell\\6\\pwsh.exe' OR Image = 'C:\\Program Files\\PowerShell\\7\\pwsh.exe' OR Image = 'C:\\Windows\\System32\\sdiagnhost.exe' OR Image = 'C:\\Windows\\System32\\services.exe' OR Image = 'C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe' OR Image = 'C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe')) OR (Image ILIKE 'C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_%' AND Image ILIKE '%\\GetHelp.exe') OR (Image ILIKE '%\\mmc.exe') OR ((Image ILIKE 'C:\\Windows\\Microsoft.NET\\Framework64\\v%' OR Image ILIKE 'C:\\Windows\\Microsoft.NET\\Framework\\v%' OR Image ILIKE 'C:\\Windows\\Microsoft.NET\\FrameworkArm\\v%' OR Image ILIKE 'C:\\Windows\\Microsoft.NET\\FrameworkArm64\\v%') AND Image ILIKE '%\\mscorsvw.exe') OR (Image ILIKE 'C:\\Windows\\Temp\\asgard2-agent\\%') OR ((CommandLine ILIKE '%svchost.exe -k netsvcs -p -s BITS%' OR CommandLine ILIKE '%svchost.exe -k GraphicsPerfSvcGroup -s GraphicsPerfSvc%' OR CommandLine ILIKE '%svchost.exe -k NetworkService -p -s Wecsvc%' OR CommandLine ILIKE '%svchost.exe -k netsvcs%')) OR ((Image = 'C:\\Windows\\System32\\Configure-SMRemoting.exe' OR Image = 'C:\\Windows\\System32\\ServerManager.exe')) OR (Image ILIKE 'C:\\$WINDOWS.~BT\\Sources\\%'))) AND NOT (((Image ILIKE '%\\svchost.exe') AND (CommandLine IS NULL))))
