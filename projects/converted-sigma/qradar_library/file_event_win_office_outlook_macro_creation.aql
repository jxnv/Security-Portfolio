-- Description: Detects the creation of a macro file for Outlook.
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (Image ILIKE '%\\outlook.exe' AND TargetFilename ILIKE '%\\Microsoft\\Outlook\\VbaProject.OTM')
