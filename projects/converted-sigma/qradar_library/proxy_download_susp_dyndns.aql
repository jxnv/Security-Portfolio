-- Title: Download from Suspicious Dyndns Hosts
-- ID: 195c1119-ef07-4909-bb12-e66f5e07bf3c
-- Status: test
-- Level: medium
-- Author: Florian Roth (Nextron Systems)
-- Date: 2017-11-08
-- Tags: attack.command-and-control, attack.t1105, attack.t1568
-- Description: Detects download of certain file types from hosts with dynamic DNS names (selected list)
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((c-uri-extension = 'exe' OR c-uri-extension = 'vbs' OR c-uri-extension = 'bat' OR c-uri-extension = 'rar' OR c-uri-extension = 'ps1' OR c-uri-extension = 'doc' OR c-uri-extension = 'docm' OR c-uri-extension = 'xls' OR c-uri-extension = 'xlsm' OR c-uri-extension = 'pptm' OR c-uri-extension = 'rtf' OR c-uri-extension = 'hta' OR c-uri-extension = 'dll' OR c-uri-extension = 'ws' OR c-uri-extension = 'wsf' OR c-uri-extension = 'sct' OR c-uri-extension = 'zip') AND (cs-host ILIKE '%.hopto.org' OR cs-host ILIKE '%.no-ip.org' OR cs-host ILIKE '%.no-ip.info' OR cs-host ILIKE '%.no-ip.biz' OR cs-host ILIKE '%.no-ip.com' OR cs-host ILIKE '%.noip.com' OR cs-host ILIKE '%.ddns.name' OR cs-host ILIKE '%.myftp.org' OR cs-host ILIKE '%.myftp.biz' OR cs-host ILIKE '%.serveblog.net' OR cs-host ILIKE '%.servebeer.com' OR cs-host ILIKE '%.servemp3.com' OR cs-host ILIKE '%.serveftp.com' OR cs-host ILIKE '%.servequake.com' OR cs-host ILIKE '%.servehalflife.com' OR cs-host ILIKE '%.servehttp.com' OR cs-host ILIKE '%.servegame.com' OR cs-host ILIKE '%.servepics.com' OR cs-host ILIKE '%.myvnc.com' OR cs-host ILIKE '%.ignorelist.com' OR cs-host ILIKE '%.jkub.com' OR cs-host ILIKE '%.dlinkddns.com' OR cs-host ILIKE '%.jumpingcrab.com' OR cs-host ILIKE '%.ddns.info' OR cs-host ILIKE '%.mooo.com' OR cs-host ILIKE '%.dns-dns.com' OR cs-host ILIKE '%.strangled.net' OR cs-host ILIKE '%.adultdns.net' OR cs-host ILIKE '%.craftx.biz' OR cs-host ILIKE '%.ddns01.com' OR cs-host ILIKE '%.dns53.biz' OR cs-host ILIKE '%.dnsapi.info' OR cs-host ILIKE '%.dnsd.info' OR cs-host ILIKE '%.dnsdynamic.com' OR cs-host ILIKE '%.dnsdynamic.net' OR cs-host ILIKE '%.dnsget.org' OR cs-host ILIKE '%.fe100.net' OR cs-host ILIKE '%.flashserv.net' OR cs-host ILIKE '%.ftp21.net' OR cs-host ILIKE '%.http01.com' OR cs-host ILIKE '%.http80.info' OR cs-host ILIKE '%.https443.com' OR cs-host ILIKE '%.imap01.com' OR cs-host ILIKE '%.kadm5.com' OR cs-host ILIKE '%.mysq1.net' OR cs-host ILIKE '%.ns360.info' OR cs-host ILIKE '%.ntdll.net' OR cs-host ILIKE '%.ole32.com' OR cs-host ILIKE '%.proxy8080.com' OR cs-host ILIKE '%.sql01.com' OR cs-host ILIKE '%.ssh01.com' OR cs-host ILIKE '%.ssh22.net' OR cs-host ILIKE '%.tempors.com' OR cs-host ILIKE '%.tftpd.net' OR cs-host ILIKE '%.ttl60.com' OR cs-host ILIKE '%.ttl60.org' OR cs-host ILIKE '%.user32.com' OR cs-host ILIKE '%.voip01.com' OR cs-host ILIKE '%.wow64.net' OR cs-host ILIKE '%.x64.me' OR cs-host ILIKE '%.xns01.com' OR cs-host ILIKE '%.dyndns.org' OR cs-host ILIKE '%.dyndns.info' OR cs-host ILIKE '%.dyndns.tv' OR cs-host ILIKE '%.dyndns-at-home.com' OR cs-host ILIKE '%.dnsomatic.com' OR cs-host ILIKE '%.zapto.org' OR cs-host ILIKE '%.webhop.net' OR cs-host ILIKE '%.25u.com' OR cs-host ILIKE '%.slyip.net'))
