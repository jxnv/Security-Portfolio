-- Title: Java Running with Remote Debugging
-- ID: 8f88e3f6-2a49-48f5-a5c4-2f7eedf78710
-- Status: test
-- Level: medium
-- Author: Florian Roth (Nextron Systems)
-- Date: 2019-01-16
-- Tags: attack.t1203, attack.execution
-- Description: Detects a JAVA process running with remote debugging allowing more than just localhost to connect
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (((CommandLine ILIKE '%transport=dt_socket,address=%') AND ((CommandLine ILIKE '%jre1.%' OR CommandLine ILIKE '%jdk1.%'))) AND NOT (((CommandLine ILIKE '%address=127.0.0.1%' OR CommandLine ILIKE '%address=localhost%'))))
