-- Title: HackTool - Generic Process Access
-- ID: d0d2f720-d14f-448d-8242-51ff396a334e
-- Status: test
-- Level: high
-- Author: Nasreddine Bencherchali (Nextron Systems), Swachchhanda Shrawan Poudel
-- Date: 2023-11-27
-- Tags: attack.credential-access, attack.t1003.001, attack.s0002
-- Description: Detects process access requests from hacktool processes based on their default image name
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (((SourceImage ILIKE '%\\Akagi.exe' OR SourceImage ILIKE '%\\Akagi64.exe' OR SourceImage ILIKE '%\\atexec_windows.exe' OR SourceImage ILIKE '%\\Certify.exe' OR SourceImage ILIKE '%\\Certipy.exe' OR SourceImage ILIKE '%\\CoercedPotato.exe' OR SourceImage ILIKE '%\\crackmapexec.exe' OR SourceImage ILIKE '%\\CreateMiniDump.exe' OR SourceImage ILIKE '%\\dcomexec_windows.exe' OR SourceImage ILIKE '%\\dpapi_windows.exe' OR SourceImage ILIKE '%\\findDelegation_windows.exe' OR SourceImage ILIKE '%\\GetADUsers_windows.exe' OR SourceImage ILIKE '%\\GetNPUsers_windows.exe' OR SourceImage ILIKE '%\\getPac_windows.exe' OR SourceImage ILIKE '%\\getST_windows.exe' OR SourceImage ILIKE '%\\getTGT_windows.exe' OR SourceImage ILIKE '%\\GetUserSPNs_windows.exe' OR SourceImage ILIKE '%\\gmer.exe' OR SourceImage ILIKE '%\\hashcat.exe' OR SourceImage ILIKE '%\\htran.exe' OR SourceImage ILIKE '%\\ifmap_windows.exe' OR SourceImage ILIKE '%\\impersonate.exe' OR SourceImage ILIKE '%\\Inveigh.exe' OR SourceImage ILIKE '%\\LocalPotato.exe' OR SourceImage ILIKE '%\\mimikatz_windows.exe' OR SourceImage ILIKE '%\\mimikatz.exe' OR SourceImage ILIKE '%\\netview_windows.exe' OR SourceImage ILIKE '%\\nmapAnswerMachine_windows.exe' OR SourceImage ILIKE '%\\opdump_windows.exe' OR SourceImage ILIKE '%\\PasswordDump.exe' OR SourceImage ILIKE '%\\Potato.exe' OR SourceImage ILIKE '%\\PowerTool.exe' OR SourceImage ILIKE '%\\PowerTool64.exe' OR SourceImage ILIKE '%\\psexec_windows.exe' OR SourceImage ILIKE '%\\PurpleSharp.exe' OR SourceImage ILIKE '%\\pypykatz.exe' OR SourceImage ILIKE '%\\QuarksPwDump.exe' OR SourceImage ILIKE '%\\rdp_check_windows.exe' OR SourceImage ILIKE '%\\Rubeus.exe' OR SourceImage ILIKE '%\\SafetyKatz.exe' OR SourceImage ILIKE '%\\sambaPipe_windows.exe' OR SourceImage ILIKE '%\\SelectMyParent.exe' OR SourceImage ILIKE '%\\SharpChisel.exe' OR SourceImage ILIKE '%\\SharPersist.exe' OR SourceImage ILIKE '%\\SharpEvtMute.exe' OR SourceImage ILIKE '%\\SharpImpersonation.exe' OR SourceImage ILIKE '%\\SharpLDAPmonitor.exe' OR SourceImage ILIKE '%\\SharpLdapWhoami.exe' OR SourceImage ILIKE '%\\SharpUp.exe' OR SourceImage ILIKE '%\\SharpView.exe' OR SourceImage ILIKE '%\\smbclient_windows.exe' OR SourceImage ILIKE '%\\smbserver_windows.exe' OR SourceImage ILIKE '%\\sniff_windows.exe' OR SourceImage ILIKE '%\\sniffer_windows.exe' OR SourceImage ILIKE '%\\split_windows.exe' OR SourceImage ILIKE '%\\SpoolSample.exe' OR SourceImage ILIKE '%\\Stracciatella.exe' OR SourceImage ILIKE '%\\SysmonEOP.exe' OR SourceImage ILIKE '%\\temp\\rot.exe' OR SourceImage ILIKE '%\\ticketer_windows.exe' OR SourceImage ILIKE '%\\TruffleSnout.exe' OR SourceImage ILIKE '%\\winPEASany_ofs.exe' OR SourceImage ILIKE '%\\winPEASany.exe' OR SourceImage ILIKE '%\\winPEASx64_ofs.exe' OR SourceImage ILIKE '%\\winPEASx64.exe' OR SourceImage ILIKE '%\\winPEASx86_ofs.exe' OR SourceImage ILIKE '%\\winPEASx86.exe' OR SourceImage ILIKE '%\\xordump.exe')) OR ((SourceImage ILIKE '%\\goldenPac%' OR SourceImage ILIKE '%\\just_dce_%' OR SourceImage ILIKE '%\\karmaSMB%' OR SourceImage ILIKE '%\\kintercept%' OR SourceImage ILIKE '%\\LocalPotato%' OR SourceImage ILIKE '%\\ntlmrelayx%' OR SourceImage ILIKE '%\\rpcdump%' OR SourceImage ILIKE '%\\samrdump%' OR SourceImage ILIKE '%\\secretsdump%' OR SourceImage ILIKE '%\\smbexec%' OR SourceImage ILIKE '%\\smbrelayx%' OR SourceImage ILIKE '%\\wmiexec%' OR SourceImage ILIKE '%\\wmipersist%' OR SourceImage ILIKE '%HotPotato%' OR SourceImage ILIKE '%Juicy Potato%' OR SourceImage ILIKE '%JuicyPotato%' OR SourceImage ILIKE '%PetitPotam%' OR SourceImage ILIKE '%RottenPotato%')))
