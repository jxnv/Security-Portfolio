-- Title: HackTool - Impacket Tools Execution
-- ID: 4627c6ae-6899-46e2-aa0c-6ebcb1becd19
-- Status: test
-- Level: high
-- Author: Florian Roth (Nextron Systems)
-- Date: 2021-07-24
-- Tags: attack.collection, attack.execution, attack.credential-access, attack.t1557.001
-- Description: Detects the execution of different compiled Windows binaries of the impacket toolset (based on names or part of their names - could lead to false positives)
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (((Image ILIKE '%\\goldenPac%' OR Image ILIKE '%\\karmaSMB%' OR Image ILIKE '%\\kintercept%' OR Image ILIKE '%\\ntlmrelayx%' OR Image ILIKE '%\\rpcdump%' OR Image ILIKE '%\\samrdump%' OR Image ILIKE '%\\secretsdump%' OR Image ILIKE '%\\smbexec%' OR Image ILIKE '%\\smbrelayx%' OR Image ILIKE '%\\wmiexec%' OR Image ILIKE '%\\wmipersist%')) OR ((Image ILIKE '%\\atexec_windows.exe' OR Image ILIKE '%\\dcomexec_windows.exe' OR Image ILIKE '%\\dpapi_windows.exe' OR Image ILIKE '%\\findDelegation_windows.exe' OR Image ILIKE '%\\GetADUsers_windows.exe' OR Image ILIKE '%\\GetNPUsers_windows.exe' OR Image ILIKE '%\\getPac_windows.exe' OR Image ILIKE '%\\getST_windows.exe' OR Image ILIKE '%\\getTGT_windows.exe' OR Image ILIKE '%\\GetUserSPNs_windows.exe' OR Image ILIKE '%\\ifmap_windows.exe' OR Image ILIKE '%\\mimikatz_windows.exe' OR Image ILIKE '%\\netview_windows.exe' OR Image ILIKE '%\\nmapAnswerMachine_windows.exe' OR Image ILIKE '%\\opdump_windows.exe' OR Image ILIKE '%\\psexec_windows.exe' OR Image ILIKE '%\\rdp_check_windows.exe' OR Image ILIKE '%\\sambaPipe_windows.exe' OR Image ILIKE '%\\smbclient_windows.exe' OR Image ILIKE '%\\smbserver_windows.exe' OR Image ILIKE '%\\sniff_windows.exe' OR Image ILIKE '%\\sniffer_windows.exe' OR Image ILIKE '%\\split_windows.exe' OR Image ILIKE '%\\ticketer_windows.exe')))
