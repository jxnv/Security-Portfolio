-- Title: Powershell Inline Execution From A File
-- ID: ee218c12-627a-4d27-9e30-d6fb2fe22ed2
-- Status: test
-- Level: medium
-- Author: frack113
-- Date: 2022-12-25
-- Tags: attack.execution, attack.t1059.001
-- Description: Detects inline execution of PowerShell code from a file
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (((CommandLine ILIKE '%iex %' OR CommandLine ILIKE '%Invoke-Expression %' OR CommandLine ILIKE '%Invoke-Command %' OR CommandLine ILIKE '%icm %')) AND (CommandLine ILIKE '% -raw%') AND ((CommandLine ILIKE '%cat %' OR CommandLine ILIKE '%get-content %' OR CommandLine ILIKE '%type %')))
