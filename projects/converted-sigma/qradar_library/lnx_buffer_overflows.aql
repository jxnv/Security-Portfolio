-- Title: Buffer Overflow Attempts
-- ID: 18b042f0-2ecd-4b6e-9f8d-aa7a7e7de781
-- Status: test
-- Level: high
-- Author: Florian Roth (Nextron Systems)
-- Date: 2017-03-01
-- Tags: attack.t1068, attack.privilege-escalation
-- Description: Detects buffer overflow attempts in Unix system log files
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (TEXT SEARCH 'attempt to execute code on stack by' OR TEXT SEARCH '0bin0sh1' OR TEXT SEARCH 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA' OR TEXT SEARCH 'stack smashing detected')
