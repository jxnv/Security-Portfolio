-- Title: Potential Encoded PowerShell Patterns In CommandLine
-- ID: cdf05894-89e7-4ead-b2b0-0a5f97a90f2f
-- Status: test
-- Level: low
-- Author: Teymur Kheirkhabarov (idea), Vasiliy Burov (rule), oscd.community, Tim Shelton
-- Date: 2020-10-11
-- Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
-- Description: Detects specific combinations of encoding methods in PowerShell via the commandline
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((((Image ILIKE '%\\powershell.exe' OR Image ILIKE '%\\pwsh.exe')) OR ((OriginalFileName = 'PowerShell.EXE' OR OriginalFileName = 'pwsh.dll'))) AND ((((CommandLine ILIKE '%ToInt%' OR CommandLine ILIKE '%ToDecimal%' OR CommandLine ILIKE '%ToByte%' OR CommandLine ILIKE '%ToUint%' OR CommandLine ILIKE '%ToSingle%' OR CommandLine ILIKE '%ToSByte%')) AND ((CommandLine ILIKE '%ToChar%' OR CommandLine ILIKE '%ToString%' OR CommandLine ILIKE '%String%'))) OR (((CommandLine ILIKE '%char%' AND CommandLine ILIKE '%join%')) OR ((CommandLine ILIKE '%split%' AND CommandLine ILIKE '%join%')))))
