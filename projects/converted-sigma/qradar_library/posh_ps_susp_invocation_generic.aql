-- Title: Suspicious PowerShell Invocations - Generic
-- ID: ed965133-513f-41d9-a441-e38076a0798f
-- Status: test
-- Level: high
-- Author: Florian Roth (Nextron Systems)
-- Date: 2017-03-12
-- Tags: attack.execution, attack.t1059.001
-- Description: Detects suspicious PowerShell invocation command parameters
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (((ScriptBlockText ILIKE '% -enc %' OR ScriptBlockText ILIKE '% -EncodedCommand %' OR ScriptBlockText ILIKE '% -ec %')) AND ((ScriptBlockText ILIKE '% -w hidden %' OR ScriptBlockText ILIKE '% -window hidden %' OR ScriptBlockText ILIKE '% -windowstyle hidden %' OR ScriptBlockText ILIKE '% -w 1 %')) AND ((ScriptBlockText ILIKE '% -noni %' OR ScriptBlockText ILIKE '% -noninteractive %')))
