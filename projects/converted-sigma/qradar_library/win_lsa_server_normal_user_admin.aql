-- Title: Standard User In High Privileged Group
-- ID: 7ac407cc-0f48-4328-aede-de1d2e6fef41
-- Status: test
-- Level: medium
-- Author: frack113
-- Date: 2023-01-13
-- Tags: attack.credential-access, attack.privilege-escalation
-- Description: Detect standard users login that are part of high privileged groups such as the Administrator group
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((EventID = 300 AND TargetUserSid ILIKE 'S-1-5-21-%' AND (SidList ILIKE '%S-1-5-32-544%' OR SidList ILIKE '%-500}%' OR SidList ILIKE '%-518}%' OR SidList ILIKE '%-519}%')) AND NOT (((TargetUserSid ILIKE '%-500' OR TargetUserSid ILIKE '%-518' OR TargetUserSid ILIKE '%-519'))))
