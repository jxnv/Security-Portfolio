-- Title: Potentially Suspicious Rundll32 Activity
-- ID: e593cf51-88db-4ee1-b920-37e89012a3c9
-- Status: test
-- Level: medium
-- Author: juju4, Jonhnathan Ribeiro, oscd.community, Nasreddine Bencherchali (Nextron Systems)
-- Date: 2019-01-16
-- Tags: attack.stealth, attack.t1218.011
-- Description: Detects suspicious execution of rundll32, with specific calls to some DLLs with known LOLBIN functionalities
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((((CommandLine ILIKE '%javascript:%' AND CommandLine ILIKE '%.RegisterXLL%')) OR ((CommandLine ILIKE '%url.dll%' AND CommandLine ILIKE '%OpenURL%')) OR ((CommandLine ILIKE '%url.dll%' AND CommandLine ILIKE '%OpenURLA%')) OR ((CommandLine ILIKE '%url.dll%' AND CommandLine ILIKE '%FileProtocolHandler%')) OR ((CommandLine ILIKE '%zipfldr.dll%' AND CommandLine ILIKE '%RouteTheCall%')) OR ((CommandLine ILIKE '%shell32.dll%' AND CommandLine ILIKE '%Control_RunDLL%')) OR ((CommandLine ILIKE '%shell32.dll%' AND CommandLine ILIKE '%ShellExec_RunDLL%')) OR ((CommandLine ILIKE '%mshtml.dll%' AND CommandLine ILIKE '%PrintHTML%')) OR ((CommandLine ILIKE '%advpack.dll%' AND CommandLine ILIKE '%LaunchINFSection%')) OR ((CommandLine ILIKE '%advpack.dll%' AND CommandLine ILIKE '%RegisterOCX%')) OR ((CommandLine ILIKE '%ieadvpack.dll%' AND CommandLine ILIKE '%LaunchINFSection%')) OR ((CommandLine ILIKE '%ieadvpack.dll%' AND CommandLine ILIKE '%RegisterOCX%')) OR ((CommandLine ILIKE '%ieframe.dll%' AND CommandLine ILIKE '%OpenURL%')) OR ((CommandLine ILIKE '%shdocvw.dll%' AND CommandLine ILIKE '%OpenURL%')) OR ((CommandLine ILIKE '%syssetup.dll%' AND CommandLine ILIKE '%SetupInfObjectInstallAction%')) OR ((CommandLine ILIKE '%setupapi.dll%' AND CommandLine ILIKE '%InstallHinfSection%')) OR ((CommandLine ILIKE '%pcwutl.dll%' AND CommandLine ILIKE '%LaunchApplication%')) OR ((CommandLine ILIKE '%dfshim.dll%' AND CommandLine ILIKE '%ShOpenVerbApplication%')) OR ((CommandLine ILIKE '%dfshim.dll%' AND CommandLine ILIKE '%ShOpenVerbShortcut%')) OR ((CommandLine ILIKE '%scrobj.dll%' AND CommandLine ILIKE '%GenerateTypeLib%' AND CommandLine ILIKE '%http%')) OR ((CommandLine ILIKE '%shimgvw.dll%' AND CommandLine ILIKE '%ImageView_Fullscreen%' AND CommandLine ILIKE '%http%')) OR ((CommandLine ILIKE '%comsvcs.dll%' AND CommandLine ILIKE '%MiniDump%'))) AND NOT (((ParentImage = 'C:\\Windows\\System32\\control.exe' AND ParentCommandLine ILIKE '%.cpl%' AND (CommandLine ILIKE '%Shell32.dll%' AND CommandLine ILIKE '%Control_RunDLL%' AND CommandLine ILIKE '%.cpl%')) OR (CommandLine ILIKE '%shell32.dll,Control_RunDLL desk.cpl,screensaver,@screensaver%') OR (ParentImage = 'C:\\Windows\\System32\\control.exe' AND CommandLine ILIKE '\"C:\\Windows\\system32\\rundll32.exe\" Shell32.dll,Control_RunDLL \"C:\\Windows\\System32\\%' AND CommandLine ILIKE '%.cpl\",'))))
