-- Title: Invoke-Obfuscation Via Use Rundll32 - PowerShell
-- ID: a5a30a6e-75ca-4233-8b8c-42e0f2037d3b
-- Status: test
-- Level: high
-- Author: Nikita Nazarov, oscd.community
-- Date: 2019-10-08
-- Tags: attack.stealth, attack.t1027, attack.execution, attack.t1059.001
-- Description: Detects Obfuscated Powershell via use Rundll32 in Scripts
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((ScriptBlockText ILIKE '%&&%' AND ScriptBlockText ILIKE '%rundll32%' AND ScriptBlockText ILIKE '%shell32.dll%' AND ScriptBlockText ILIKE '%shellexec_rundll%') AND (ScriptBlockText ILIKE '%value%' OR ScriptBlockText ILIKE '%invoke%' OR ScriptBlockText ILIKE '%comspec%' OR ScriptBlockText ILIKE '%iex%'))
