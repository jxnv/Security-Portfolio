-- Title: Local Groups Discovery - Linux
-- ID: 676381a6-15ca-4d73-a9c8-6a22e970b90d
-- Status: test
-- Level: low
-- Author: Ömer Günal, Alejandro Ortuno, oscd.community
-- Date: 2020-10-11
-- Tags: attack.discovery, attack.t1069.001
-- Description: Detects enumeration of local system groups. Adversaries may attempt to find local system groups and permission settings
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((Image ILIKE '%/groups') OR ((Image ILIKE '%/cat' OR Image ILIKE '%/ed' OR Image ILIKE '%/head' OR Image ILIKE '%/less' OR Image ILIKE '%/more' OR Image ILIKE '%/nano' OR Image ILIKE '%/tail' OR Image ILIKE '%/vi' OR Image ILIKE '%/vim') AND CommandLine ILIKE '%/etc/group%'))
