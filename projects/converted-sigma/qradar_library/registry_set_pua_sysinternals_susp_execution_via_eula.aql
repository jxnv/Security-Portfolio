-- Title: PUA - Sysinternals Tools Execution - Registry
-- ID: c7da8edc-49ae-45a2-9e61-9fd860e4e73d
-- Status: test
-- Level: medium
-- Author: Nasreddine Bencherchali (Nextron Systems)
-- Date: 2022-08-24
-- Tags: attack.resource-development, attack.t1588.002
-- Description: Detects the execution of some potentially unwanted tools such as PsExec, Procdump, etc. (part of the Sysinternals suite) via the creation of the "accepteula" registry key.
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((TargetObject ILIKE '%\\Active Directory Explorer%' OR TargetObject ILIKE '%\\Handle%' OR TargetObject ILIKE '%\\LiveKd%' OR TargetObject ILIKE '%\\Process Explorer%' OR TargetObject ILIKE '%\\ProcDump%' OR TargetObject ILIKE '%\\PsExec%' OR TargetObject ILIKE '%\\PsLoglist%' OR TargetObject ILIKE '%\\PsPasswd%' OR TargetObject ILIKE '%\\SDelete%' OR TargetObject ILIKE '%\\Sysinternals%') AND TargetObject ILIKE '%\\EulaAccepted')
