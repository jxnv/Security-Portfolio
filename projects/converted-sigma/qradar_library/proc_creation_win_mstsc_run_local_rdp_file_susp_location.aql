-- Title: Suspicious Mstsc.EXE Execution With Local RDP File
-- ID: 6e22722b-dfb1-4508-a911-49ac840b40f8
-- Status: test
-- Level: high
-- Author: Nasreddine Bencherchali (Nextron Systems)
-- Date: 2023-04-18
-- Tags: attack.command-and-control, attack.t1219.002
-- Description: Detects potential RDP connection via Mstsc using a local ".rdp" file located in suspicious locations.
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (((CommandLine ILIKE '%.rdp' OR CommandLine ILIKE '%.rdp\"')) AND ((Image ILIKE '%\\mstsc.exe') OR (OriginalFileName = 'mstsc.exe')) AND ((CommandLine ILIKE '%:\\Users\\Public\\%' OR CommandLine ILIKE '%:\\Windows\\System32\\spool\\drivers\\color%' OR CommandLine ILIKE '%:\\Windows\\System32\\Tasks_Migrated %' OR CommandLine ILIKE '%:\\Windows\\Tasks\\%' OR CommandLine ILIKE '%:\\Windows\\Temp\\%' OR CommandLine ILIKE '%:\\Windows\\Tracing\\%' OR CommandLine ILIKE '%\\AppData\\Local\\Temp\\%' OR CommandLine ILIKE '%\\Downloads\\%')))
