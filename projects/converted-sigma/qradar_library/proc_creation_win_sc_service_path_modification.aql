-- Title: Suspicious Service Path Modification
-- ID: 138d3531-8793-4f50-a2cd-f291b2863d78
-- Status: test
-- Level: high
-- Author: Victor Sergeev, oscd.community, Nasreddine Bencherchali (Nextron Systems)
-- Date: 2019-10-21
-- Tags: attack.persistence, attack.privilege-escalation, attack.t1543.003
-- Description: Detects service path modification via the "sc" binary to a suspicious command or path
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (Image ILIKE '%\\sc.exe' AND (CommandLine ILIKE '%config%' AND CommandLine ILIKE '%binPath%') AND (CommandLine ILIKE '%powershell%' OR CommandLine ILIKE '%cmd %' OR CommandLine ILIKE '%mshta%' OR CommandLine ILIKE '%wscript%' OR CommandLine ILIKE '%cscript%' OR CommandLine ILIKE '%rundll32%' OR CommandLine ILIKE '%svchost%' OR CommandLine ILIKE '%dllhost%' OR CommandLine ILIKE '%cmd.exe /c%' OR CommandLine ILIKE '%cmd.exe /k%' OR CommandLine ILIKE '%cmd.exe /r%' OR CommandLine ILIKE '%cmd /c%' OR CommandLine ILIKE '%cmd /k%' OR CommandLine ILIKE '%cmd /r%' OR CommandLine ILIKE '%C:\\Users\\Public%' OR CommandLine ILIKE '%\\Downloads\\%' OR CommandLine ILIKE '%\\Desktop\\%' OR CommandLine ILIKE '%\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\%' OR CommandLine ILIKE '%C:\\Windows\\TEMP\\%' OR CommandLine ILIKE '%\\AppData\\Local\\Temp%'))
