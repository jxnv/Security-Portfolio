-- Title: Windows Webshell Strings
-- ID: 7ff9db12-1b94-4a79-ba68-a2402c5d6729
-- Status: test
-- Level: high
-- Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
-- Date: 2017-02-19
-- Tags: attack.persistence, attack.t1505.003
-- Description: Detects common commands used in Windows webshells
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((TEXT SEARCH '=whoami' OR TEXT SEARCH '=net%20user' OR TEXT SEARCH '=net+user' OR TEXT SEARCH '=net%2Buser' OR TEXT SEARCH '=cmd%20/c%' OR TEXT SEARCH '=cmd+/c+' OR TEXT SEARCH '=cmd%2B/c%' OR TEXT SEARCH '=cmd%20/r%' OR TEXT SEARCH '=cmd+/r+' OR TEXT SEARCH '=cmd%2B/r%' OR TEXT SEARCH '=cmd%20/k%' OR TEXT SEARCH '=cmd+/k+' OR TEXT SEARCH '=cmd%2B/k%' OR TEXT SEARCH '=powershell%' OR TEXT SEARCH '=powershell+' OR TEXT SEARCH '=tasklist%' OR TEXT SEARCH '=tasklist+' OR TEXT SEARCH '=wmic%' OR TEXT SEARCH '=wmic+' OR TEXT SEARCH '=ssh%' OR TEXT SEARCH '=ssh+' OR TEXT SEARCH '=python%' OR TEXT SEARCH '=python+' OR TEXT SEARCH '=python3%' OR TEXT SEARCH '=python3+' OR TEXT SEARCH '=ipconfig' OR TEXT SEARCH '=wget%' OR TEXT SEARCH '=wget+' OR TEXT SEARCH '=curl%' OR TEXT SEARCH '=curl+' OR TEXT SEARCH '=certutil' OR TEXT SEARCH '=copy%20%5C%5C' OR TEXT SEARCH '=dsquery%' OR TEXT SEARCH '=dsquery+' OR TEXT SEARCH '=nltest%' OR TEXT SEARCH '=nltest+') AND (cs-method = 'GET'))
