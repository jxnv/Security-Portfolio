-- Title: JAMF MDM Execution
-- ID: be2e3a5c-9cc7-4d02-842a-68e9cb26ec49
-- Status: test
-- Level: low
-- Author: Jay Pandit
-- Date: 2023-08-22
-- Tags: attack.execution
-- Description: Detects execution of the "jamf" binary to create user accounts and run commands. For example, the binary can be abused by attackers on the system in order to bypass security controls or remove application control polices.
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (Image ILIKE '%/jamf' AND (CommandLine ILIKE '%createAccount%' OR CommandLine ILIKE '%manage%' OR CommandLine ILIKE '%removeFramework%' OR CommandLine ILIKE '%removeMdmProfile%' OR CommandLine ILIKE '%resetPassword%' OR CommandLine ILIKE '%setComputerName%'))
