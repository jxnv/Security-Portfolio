-- Title: Potential Tampering With RDP Related Registry Keys Via Reg.EXE
-- ID: 0d5675be-bc88-4172-86d3-1e96a4476536
-- Status: test
-- Level: high
-- Author: pH-T (Nextron Systems), @Kostastsale, TheDFIRReport
-- Date: 2022-02-12
-- Tags: attack.persistence, attack.lateral-movement, attack.defense-impairment, attack.t1021.001, attack.t1112
-- Description: Detects the execution of "reg.exe" for enabling/disabling the RDP service on the host by tampering with the 'CurrentControlSet\Control\Terminal Server' values
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((((CommandLine ILIKE '% add %' AND CommandLine ILIKE '%\\CurrentControlSet\\Control\\Terminal Server%' AND CommandLine ILIKE '%REG_DWORD%' AND CommandLine ILIKE '% /f%')) AND ((Image ILIKE '%\\reg.exe') OR (OriginalFileName = 'reg.exe'))) AND (((CommandLine ILIKE '%Licensing Core%' AND CommandLine ILIKE '%EnableConcurrentSessions%')) OR ((CommandLine ILIKE '%AllowTSConnections%' OR CommandLine ILIKE '%fDenyTSConnections%' OR CommandLine ILIKE '%fEnableWinStation%' OR CommandLine ILIKE '%fSingleSessionPerUser%' OR CommandLine ILIKE '%IdleWinStationPoolCount%' OR CommandLine ILIKE '%MaxInstanceCount%' OR CommandLine ILIKE '%SecurityLayer%' OR CommandLine ILIKE '%TSAdvertise%' OR CommandLine ILIKE '%TSAppCompat%' OR CommandLine ILIKE '%TSEnabled%' OR CommandLine ILIKE '%TSUserEnabled%' OR CommandLine ILIKE '%WinStations\\RDP-Tcp%'))) AND NOT (((CommandLine ILIKE '%SecurityLayer%' AND CommandLine ILIKE '%02%'))))
