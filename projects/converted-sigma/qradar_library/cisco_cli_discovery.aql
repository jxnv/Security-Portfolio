-- Tags: attack.discovery, attack.t1083, attack.t1201, attack.t1057, attack.t1018, attack.t1082, attack.t1016, attack.t1049, attack.t1033, attack.t1124
-- Description: Find information about network devices that is not stored in config files
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE (TEXT SEARCH 'dir' OR TEXT SEARCH 'show arp' OR TEXT SEARCH 'show cdp' OR TEXT SEARCH 'show clock' OR TEXT SEARCH 'show ip interface' OR TEXT SEARCH 'show ip route' OR TEXT SEARCH 'show ip sockets' OR TEXT SEARCH 'show processes' OR TEXT SEARCH 'show ssh' OR TEXT SEARCH 'show users' OR TEXT SEARCH 'show version')
