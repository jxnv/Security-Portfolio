-- Title: CobaltStrike Named Pipe Pattern Regex
-- ID: 0e7163d4-9e19-4fa7-9be6-000c61aad77a
-- Status: test
-- Level: critical
-- Author: Florian Roth (Nextron Systems)
-- Date: 2021-07-30
-- Tags: attack.privilege-escalation, attack.stealth, attack.t1055
-- Description: Detects the creation of a named pipe matching a pattern used by CobaltStrike Malleable C2 profiles
-- Converted by: Sigma Universal SIEM/EDR CLI

SELECT * FROM events WHERE ((PipeName MATCHES '\\mojo\.5688\.8052\.(?:183894939787088877|35780273329370473)[0-9a-f]{2}') OR (PipeName MATCHES '\\wkssvc_?[0-9a-f]{2}') OR (PipeName MATCHES '\\ntsvcs[0-9a-f]{2}') OR (PipeName MATCHES '\\DserNamePipe[0-9a-f]{2}') OR (PipeName MATCHES '\\SearchTextHarvester[0-9a-f]{2}') OR (PipeName MATCHES '\\mypipe-(?:f|h)[0-9a-f]{2}') OR (PipeName MATCHES '\\windows\.update\.manager[0-9a-f]{2,3}') OR (PipeName MATCHES '\\ntsvcs_[0-9a-f]{2}') OR (PipeName MATCHES '\\scerpc_?[0-9a-f]{2}') OR (PipeName MATCHES '\\PGMessagePipe[0-9a-f]{2}') OR (PipeName MATCHES '\\MsFteWds[0-9a-f]{2}') OR (PipeName MATCHES '\\f4c3[0-9a-f]{2}') OR (PipeName MATCHES '\\fullduplex_[0-9a-f]{2}') OR (PipeName MATCHES '\\msrpc_[0-9a-f]{4}') OR (PipeName MATCHES '\\win\\msrpc_[0-9a-f]{2}') OR (PipeName MATCHES '\\f53f[0-9a-f]{2}$') OR (PipeName MATCHES '\\rpc_[0-9a-f]{2}') OR (PipeName MATCHES '\\spoolss_[0-9a-f]{2}') OR (PipeName MATCHES '\\Winsock2\\CatalogChangeListener-[0-9a-f]{3}-0,'))
