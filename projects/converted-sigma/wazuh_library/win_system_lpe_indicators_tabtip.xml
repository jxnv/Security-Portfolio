<!--
  Title: Local Privilege Escalation Indicator TabTip
  ID: bc2e25ed-b92b-4daa-b074-b502bdd1982b
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems)
  Date: 2022-10-07
  Description: Detects the invocation of TabTip via CLSID as seen when JuicyPotatoNG is used on a system in brute force mode
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Local Privilege Escalation Indicator TabTip</description>
    <match>(Provider_Name=\"Microsoft-Windows-DistributedCOM\" AND EventID=\"10001\" AND param1=\"C:\\\\Program Files\\\\Common Files\\\\micro</match>
  </rule>
</group>
