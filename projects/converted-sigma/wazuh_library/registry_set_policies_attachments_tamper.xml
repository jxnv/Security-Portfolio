<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potential Attachment Manager Settings Attachments Tamper</description>
    <match>((TargetObject=\"*\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Policies\\\\Attachments\\\\*\") AND ((TargetObject=\"*\\\\HideZ</match>
  </rule>
</group>
