<!--
  Title: File Download via CertOC.EXE
  ID: 70ad0861-d1fe-491c-a45f-fa48148a300d
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-05-16
  Description: Detects when a user downloads a file by using CertOC.exe
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>File Download via CertOC.EXE</description>
    <match>(((CommandLine=\"*-GetCACAPS*\" AND CommandLine=\"*http*\")) AND ((Image=\"*\\\\certoc.exe\") OR (OriginalFileName=\"CertOC.exe\")</match>
  </rule>
</group>
