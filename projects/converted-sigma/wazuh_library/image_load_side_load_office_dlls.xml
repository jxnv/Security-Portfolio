    <description>Microsoft Office DLL Sideload</description>
    <match>((ImageLoaded=\"*\\\\outllib.dll\") AND NOT (((ImageLoaded=\"C:\\\\Program Files\\\\Microsoft Office\\\\OFFICE*\" OR ImageLoaded=\"C:</match>
  </rule>
</group>
