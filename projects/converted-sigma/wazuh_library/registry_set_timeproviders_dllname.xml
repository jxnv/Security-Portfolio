<!--
  Title: New TimeProviders Registered With Uncommon DLL Name
  ID: e88a6ddc-74f7-463b-9b26-f69fc0d2ce85
  Status: test
  Level: high
  Author: frack113
  Date: 2022-06-19
  Description: Detects processes setting a new DLL in DllName in under HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\W32Time\TimeProvider. Adversaries may abuse time providers to execute DLLs when the system boots. The Windows Time service (W32Time) enables time synchronization across and within domains.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>New TimeProviders Registered With Uncommon DLL Name</description>
    <match>((TargetObject=\"*\\\\Services\\\\W32Time\\\\TimeProviders*\" AND TargetObject=\"*\\\\DllName\") AND NOT (((Details=\"%SystemRoot%\\\\S</match>
  </rule>
</group>
