<!--
  Title: DLL Execution Via Register-cimprovider.exe
  ID: a2910908-e86f-4687-aeba-76a5f996e652
  Status: test
  Level: medium
  Author: Ivan Dyachkov, Yulia Fomina, oscd.community
  Date: 2020-10-07
  Description: Detects using register-cimprovider.exe to execute arbitrary dll file.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>DLL Execution Via Register-cimprovider.exe</description>
    <match>(Image=\"*\\\\register-cimprovider.exe\" AND (CommandLine=\"*-path*\" AND CommandLine=\"*dll*\"))</match>
  </rule>
</group>
