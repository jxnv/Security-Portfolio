<!--
  Title: Potential Arbitrary Command Execution Via FTP.EXE
  ID: 06b401f4-107c-4ff9-947f-9ec1e7649f1e
  Status: test
  Level: medium
  Author: Victor Sergeev, oscd.community
  Date: 2020-10-09
  Description: Detects execution of "ftp.exe" script with the "-s" or "/s" flag and any child processes ran by "ftp.exe".
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential Arbitrary Command Execution Via FTP.EXE</description>
    <match>((ParentImage=\"*\\\\ftp.exe\") OR (((CommandLine=\"*-s:*\" OR CommandLine=\"*/s:*\")) AND ((Image=\"*\\\\ftp.exe\") OR (OriginalFil</match>
  </rule>
</group>
