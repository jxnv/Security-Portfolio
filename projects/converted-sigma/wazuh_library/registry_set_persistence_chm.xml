<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potential Persistence Via CHM Helper DLL</description>
    <match>((TargetObject=\"*\\\\Software\\\\Microsoft\\\\HtmlHelp Author\\\\Location*\" OR TargetObject=\"*\\\\Software\\\\WOW6432Node\\\\Microsoft</match>
  </rule>
</group>
