<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Execution Location Of Wermgr.EXE</description>
    <match>((Image=\"*\\\\wermgr.exe\") AND NOT (((Image=\"C:\\\\Windows\\\\System32\\\\*\" OR Image=\"C:\\\\Windows\\\\SysWOW64\\\\*\" OR Image=\"C:\\\\W</match>
  </rule>
</group>
