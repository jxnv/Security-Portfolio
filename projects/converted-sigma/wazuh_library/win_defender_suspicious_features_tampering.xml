<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Windows Defender Configuration Changes</description>
    <match>(EventID=\"5007\" AND (NewValue=\"*\\\\Windows Defender\\\\DisableAntiSpyware *\" OR NewValue=\"*\\\\Windows Defender\\\\Scan\\\\Disabl</match>
  </rule>
</group>
