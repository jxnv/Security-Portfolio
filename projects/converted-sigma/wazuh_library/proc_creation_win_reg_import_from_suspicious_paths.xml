  Date: 2022-08-01
  Description: Detects the import of '.reg' files from suspicious paths using the 'reg.exe' utility
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential Suspicious Registry File Imported Via Reg.EXE</description>
    <match>((CommandLine=\"* import *\") AND ((Image=\"*\\\\reg.exe\") OR (OriginalFileName=\"reg.exe\")) AND ((CommandLine=\"*C:\\\\Users\\\\*\"</match>
  </rule>
</group>
