<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>PowerShell ShellCode</description>
    <match>((ScriptBlockText=\"*OiCAAAAYInlM*\" OR ScriptBlockText=\"*OiJAAAAYInlM*\"))</match>
  </rule>
</group>
