<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Execute Files with Msdeploy.exe</description>
    <match>((CommandLine=\"*verb:sync*\" AND CommandLine=\"*-source:RunCommand*\" AND CommandLine=\"*-dest:runCommand*\") AND Image=\"*\\\\m</match>
  </rule>
</group>
