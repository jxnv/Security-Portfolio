<!--
  Title: Suspicious Plink Port Forwarding
  ID: 48a61b29-389f-4032-b317-b30de6b95314
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems)
  Date: 2021-01-19
  Description: Detects suspicious Plink tunnel port forwarding to a local port
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Plink Port Forwarding</description>
    <match>(Description=\"Command-line SSH, Telnet, and Rlogin client\" AND CommandLine=\"* -R *\")</match>
  </rule>
</group>
