<!--
  Title: Potential Container Discovery Via Inodes Listing
  ID: 43e26eb5-cd58-48d1-8ce9-a273f5d298d8
  Status: test
  Level: low
  Author: Seth Hanford
  Date: 2023-08-23
  Description: Detects listing of the inodes of the "/" directory to determine if the we are running inside of a container.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential Container Discovery Via Inodes Listing</description>
    <match>(((CommandLine=\"* /\") OR (CommandLine=\"* / *\")) AND (Image=\"*/ls\") AND (CommandLine=regex(\"(?:\\\\s-[^-\\\\s]{0,20}d|\\\\s--di</match>
  </rule>
</group>
