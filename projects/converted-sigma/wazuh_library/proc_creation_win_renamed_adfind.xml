    <description>Renamed AdFind Execution</description>
    <match>((((CommandLine=\"*domainlist*\" OR CommandLine=\"*trustdmp*\" OR CommandLine=\"*dcmodes*\" OR CommandLine=\"*adinfo*\" OR Comma</match>
  </rule>
</group>
