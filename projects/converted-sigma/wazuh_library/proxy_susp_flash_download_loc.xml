<!--
  Title: Flash Player Update from Suspicious Location
  ID: 4922a5dd-6743-4fc2-8e81-144374280997
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems)
  Date: 2017-10-25
  Description: Detects a flashplayer update from an unofficial location
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Flash Player Update from Suspicious Location</description>
    <match>(((c-uri=\"*/flash_install.php*\") OR (c-uri=\"*/install_flash_player.exe\")) AND NOT ((cs-host=\"*.adobe.com\")))</match>
  </rule>
</group>
