<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>UAC Bypass Using Consent and Comctl32 - File</description>
    <match>(TargetFilename=\"C:\\\\Windows\\\\System32\\\\consent.exe.@*\" AND TargetFilename=\"*\\\\comctl32.dll\")</match>
  </rule>
</group>
