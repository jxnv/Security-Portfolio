<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Renamed Jusched.EXE Execution</description>
    <match>(((Description=\"Java Update Scheduler\" OR Description=\"Java(TM) Update Scheduler\")) AND NOT ((Image=\"*\\\\jusched.exe\")))</match>
  </rule>
</group>
