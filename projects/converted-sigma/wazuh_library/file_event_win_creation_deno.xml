<!--
  Title: Suspicious Deno File Written from Remote Source
  ID: 6c0ce3b6-85e2-49d4-9c3f-6e008ce9796e
  Status: experimental
  Level: low
  Author: Josh Nickels, Michael Taggart
  Date: 2025-05-22
  Description: Detects Deno writing a file from a direct HTTP(s) call and writing to the appdata folder or bringing it's own malicious DLL. This behavior may indicate an attempt to execute remotely hosted, potentially malicious files through deno.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious Deno File Written from Remote Source</description>
    <match>((TargetFilename=\"*\\\\deno\\\\gen\\\\*\" OR TargetFilename=\"*\\\\deno\\\\remote\\\\https\\\\*\") AND (TargetFilename=\"*:\\\\Users\\\\*\" AND</match>
  </rule>
</group>
