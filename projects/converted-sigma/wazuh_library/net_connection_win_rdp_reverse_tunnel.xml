<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>RDP Over Reverse SSH Tunnel</description>
    <match>(((cidrmatch(\"127.0.0.0/8\", DestinationIp) OR cidrmatch(\"::1/128\", DestinationIp))) AND (Image=\"*\\\\svchost.exe\" AND Init</match>
  </rule>
</group>
