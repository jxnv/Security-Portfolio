    <description>Linux Network Service Scanning Tools Execution</description>
    <match>((((Image=\"*/nc\" OR Image=\"*/ncat\" OR Image=\"*/netcat\" OR Image=\"*/socat\")) AND NOT (((CommandLine=\"* --listen *\" OR Com</match>
  </rule>
</group>
