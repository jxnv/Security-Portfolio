  Date: 2024-01-26
  Description: Detects uncommon network connections to the Active Directory Web Services (ADWS) from processes not typically associated with ADWS management.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Uncommon Connection to Active Directory Web Services</description>
    <match>((Initiated=\"True\" AND DestinationPort=\"9389\") AND NOT (((Image=\"C:\\\\Windows\\\\system32\\\\dsac.exe\") OR (Image=\"C:\\\\Progra</match>
  </rule>
</group>
