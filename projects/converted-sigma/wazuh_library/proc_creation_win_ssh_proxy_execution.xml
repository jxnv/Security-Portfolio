<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Program Executed Using Proxy/Local Command Via SSH.EXE</description>
    <match>((ParentImage=\"C:\\\\Windows\\\\System32\\\\OpenSSH\\\\sshd.exe\") OR (((CommandLine=\"*ProxyCommand=*\") OR ((CommandLine=\"*Permit</match>
  </rule>
</group>
