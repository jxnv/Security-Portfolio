<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential Antivirus Software DLL Sideloading</description>
    <match>(((ImageLoaded=\"*\\\\log.dll\") AND NOT ((((ImageLoaded=\"C:\\\\Program Files\\\\AVAST Software\\\\Avast\\\\log.dll\" OR ImageLoaded=</match>
  </rule>
</group>
