<!--
  Title: Invoke-Obfuscation VAR+ Launcher - PowerShell Module
  ID: 6bfb8fa7-b2e7-4f6c-8d9d-824e5d06ea9e
  Status: test
  Level: high
  Author: Jonathan Cheong, oscd.community
  Date: 2020-10-15
  Description: Detects Obfuscated use of Environment Variables to execute PowerShell
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Invoke-Obfuscation VAR+ Launcher - PowerShell Module</description>
    <match>(Payload=regex(\"cmd.{0,5}(?:/c|/r)(?:\\\\s|)\\\"set\\\\s[a-zA-Z]{3,6}.*(?:\\\\{\\\\d\\\\}){1,}\\\\\\\\\\\"\\\\s+?-f(?:.*\\\\)){1,}.*\\\"\"))</match>
  </rule>
</group>
