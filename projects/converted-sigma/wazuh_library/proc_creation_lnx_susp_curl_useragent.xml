<!--
  Title: Suspicious Curl Change User Agents - Linux
  ID: b86d356d-6093-443d-971c-9b07db583c68
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-09-15
  Description: Detects a suspicious curl process start on linux with set useragent options
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious Curl Change User Agents - Linux</description>
    <match>(Image=\"*/curl\" AND (CommandLine=\"* -A *\" OR CommandLine=\"* --user-agent *\"))</match>
  </rule>
</group>
