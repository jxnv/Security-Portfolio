<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Local Accounts Discovery</description>
    <match>(((Image=\"*\\\\cmd.exe\" AND (CommandLine=\"* /c*\" AND CommandLine=\"*dir *\" AND CommandLine=\"*\\\\Users\\\\*\")) AND NOT ((Comman</match>
  </rule>
</group>
