<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>File Decryption Using Gpg4win</description>
    <match>(((CommandLine=\"* -d *\" AND CommandLine=\"*passphrase*\")) AND (((Image=\"*\\\\gpg.exe\" OR Image=\"*\\\\gpg2.exe\")) OR (Descript</match>
  </rule>
</group>
