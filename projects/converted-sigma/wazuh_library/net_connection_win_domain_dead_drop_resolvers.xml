<!--
  Title: New Connection Initiated To Potential Dead Drop Resolver Domain
  ID: 297ae038-edc2-4b2e-bb3e-7c5fc94dd5c7
  Status: test
  Level: high
  Author: Sorina Ionescu, X__Junior (Nextron Systems)
  Date: 2022-08-17
  Description: Detects an executable, which is not an internet browser or known application, initiating network connections to legit popular websites, which were seen to be used as dead drop resolvers in previous attacks. In this context attackers leverage known websites such as "facebook", "youtube", etc. In order to pass through undetected.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>New Connection Initiated To Potential Dead Drop Resolver Domain</description>
    <match>((Initiated=\"true\" AND (DestinationHostname=\"*.t.me\" OR DestinationHostname=\"*0x0.st\" OR DestinationHostname=\"*4shared.c</match>
  </rule>
</group>
