-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>VHD Image Download Via Browser</description>
    <match>((Image=\"*\\\\brave.exe\" OR Image=\"*\\\\chrome.exe\" OR Image=\"*\\\\firefox.exe\" OR Image=\"*\\\\iexplore.exe\" OR Image=\"*\\\\maxtho</match>
  </rule>
</group>
