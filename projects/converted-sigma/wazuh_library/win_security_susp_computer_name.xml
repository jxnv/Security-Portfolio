<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Win Susp Computer Name Containing Samtheadmin</description>
    <match>((SamAccountName=\"SAMTHEADMIN-*\" AND SamAccountName=\"*$\") OR (TargetUserName=\"SAMTHEADMIN-*\" AND TargetUserName=\"*$\"))</match>
  </rule>
</group>
