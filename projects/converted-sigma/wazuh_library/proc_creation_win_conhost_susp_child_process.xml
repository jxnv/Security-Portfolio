<!--
  Title: Uncommon Child Process Of Conhost.EXE
  ID: 7dc2dedd-7603-461a-bc13-15803d132355
  Status: test
  Level: medium
  Author: omkar72
  Date: 2020-10-25
  Description: Detects uncommon "conhost" child processes. This could be a sign of "conhost" usage as a LOLBIN or potential process injection activity.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Uncommon Child Process Of Conhost.EXE</description>
    <match>((ParentImage=\"*\\\\conhost.exe\") AND NOT (((Image=\"*:\\\\Windows\\\\System32\\\\conhost.exe\") OR (Image=\"\") OR (NOT Image=*))) </match>
  </rule>
</group>
