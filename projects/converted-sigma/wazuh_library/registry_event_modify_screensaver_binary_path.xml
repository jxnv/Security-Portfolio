<!--
  Title: Path To Screensaver Binary Modified
  ID: 67a6c006-3fbe-46a7-9074-2ba3b82c3000
  Status: test
  Level: medium
  Author: Bartlomiej Czyz @bczyz1, oscd.community
  Date: 2020-10-11
  Description: Detects value modification of registry key containing path to binary used as screensaver.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Path To Screensaver Binary Modified</description>
    <match>((TargetObject=\"*\\\\Control Panel\\\\Desktop\\\\SCRNSAVE.EXE\") AND NOT (((Image=\"*\\\\rundll32.exe\" OR Image=\"*\\\\explorer.exe\")</match>
  </rule>
</group>
