<!--
  Title: Potential ShellDispatch.DLL Functionality Abuse
  ID: 82343930-652f-43f5-ab70-2ee9fdd6d5e9
  Status: test
  Level: medium
  Author: X__Junior (Nextron Systems)
  Date: 2023-06-20
  Description: Detects potential "ShellDispatch.dll" functionality abuse to execute arbitrary binaries via "ShellExecute"
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential ShellDispatch.DLL Functionality Abuse</description>
    <match>((CommandLine=\"*RunDll_ShellExecuteW*\") AND ((Image=\"*\\\\rundll32.exe\") OR (OriginalFileName=\"RUNDLL32.EXE\")))</match>
  </rule>
</group>
