<!--
  Title: Azure DNS Zone Modified or Deleted
  ID: af6925b0-8826-47f1-9324-337507a0babd
  Status: test
  Level: medium
  Author: Austin Songer @austinsonger
  Date: 2021-08-08
  Description: Identifies when DNS zone is modified or deleted.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Azure DNS Zone Modified or Deleted</description>
    <match>(operationName=\"MICROSOFT.NETWORK/DNSZONES*\" AND (operationName=\"*/WRITE\" OR operationName=\"*/DELETE\"))</match>
  </rule>
</group>
