<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious PowerShell In Registry Run Keys</description>
    <match>((TargetObject=\"*\\\\Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Run*\" OR TargetObject=\"*\\\\Software\\\\WOW6432Node\\\\Micros</match>
  </rule>
</group>
