<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Obfuscated PowerShell Code</description>
    <match>((CommandLine=\"*IAAtAGIAeABvAHIAIAAwAHgA*\" OR CommandLine=\"*AALQBiAHgAbwByACAAMAB4A*\" OR CommandLine=\"*gAC0AYgB4AG8AcgAg</match>
  </rule>
</group>
