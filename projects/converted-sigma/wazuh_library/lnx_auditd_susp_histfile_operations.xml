<!--
  Title: Suspicious History File Operations - Linux
  ID: eae8ce9f-bde9-47a6-8e79-f20d18419910
  Status: test
  Level: medium
  Author: Mikhail Larin, oscd.community
  Date: 2020-10-17
  Description: Detects commandline operations on shell history files
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious History File Operations - Linux</description>
    <match>((type=\"EXECVE\") AND (\".bash_history\" OR \".zsh_history\" OR \".zhistory\" OR \".history\" OR \".sh_history\" OR \"fish_history\")</match>
  </rule>
</group>
