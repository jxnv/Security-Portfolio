<!--
  Title: Potential Linux Process Code Injection Via DD Utility
  ID: 4cad6c64-d6df-42d6-8dae-eb78defdc415
  Status: test
  Level: medium
  Author: Joseph Kamau
  Date: 2023-12-01
  Description: Detects the injection of code by overwriting the memory map of a Linux process using the "dd" Linux command.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential Linux Process Code Injection Via DD Utility</description>
    <match>(Image=\"*/dd\" AND (CommandLine=\"*of=*\" AND CommandLine=\"*/proc/*\" AND CommandLine=\"*/mem*\"))</match>
  </rule>
</group>
