  Description: Detects update to a scheduled task event that contain suspicious keywords.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Scheduled Task Update</description>
    <match>(((TaskContentNew=\"*regsvr32*\" OR TaskContentNew=\"*rundll32*\" OR TaskContentNew=\"*cmd.exe</Command>*\" OR TaskContentNew=</match>
  </rule>
</group>
