  Level: high
  Author: yxinmiracle
  Date: 2025-08-22
  Description: Detects the use of PowerShell with Uninstall-WindowsFeature or Remove-WindowsFeature cmdlets to disable or remove the Windows Defender GUI feature, a common technique used by adversaries to evade defenses.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Uninstall of Windows Defender Feature via PowerShell</description>
    <match>((CommandLine=\"*Windows-Defender*\") AND ((CommandLine=\"*Uninstall-WindowsFeature*\" OR CommandLine=\"*Remove-WindowsFeatur</match>
  </rule>
</group>
