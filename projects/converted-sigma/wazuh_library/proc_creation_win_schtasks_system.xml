<!--
  Title: Schtasks Creation Or Modification With SYSTEM Privileges
  ID: 89ca78fd-b37c-4310-b3d3-81a023f83936
  Status: test
  Level: high
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-07-28
  Description: Detects the creation or update of a scheduled task to run with "NT AUTHORITY\SYSTEM" privileges
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Schtasks Creation Or Modification With SYSTEM Privileges</description>
    <match>(((Image=\"*\\\\schtasks.exe\" AND (CommandLine=\"* /change *\" OR CommandLine=\"* /create *\")) AND (CommandLine=\"*/ru *\") AND </match>
  </rule>
</group>
