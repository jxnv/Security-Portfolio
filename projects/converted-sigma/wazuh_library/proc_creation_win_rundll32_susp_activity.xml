<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potentially Suspicious Rundll32 Activity</description>
    <match>((((CommandLine=\"*javascript:*\" AND CommandLine=\"*.RegisterXLL*\")) OR ((CommandLine=\"*url.dll*\" AND CommandLine=\"*OpenUR</match>
  </rule>
</group>
