<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Windows Credential Manager Access via VaultCmd</description>
    <match>((CommandLine=\"*/listcreds:*\") AND ((Image=\"*\\\\VaultCmd.exe\") OR (OriginalFileName=\"VAULTCMD.EXE\")))</match>
  </rule>
</group>
