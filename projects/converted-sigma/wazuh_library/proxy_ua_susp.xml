    <match>((((c-useragent=\"user-agent*\" OR c-useragent=\"Mozilla/3.0 *\" OR c-useragent=\"Mozilla/2.0 *\" OR c-useragent=\"Mozilla/1.0 </match>
  </rule>
</group>
