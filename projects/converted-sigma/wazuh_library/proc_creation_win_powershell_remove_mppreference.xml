<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Tamper Windows Defender Remove-MpPreference</description>
    <match>((CommandLine=\"*Remove-MpPreference*\") AND ((CommandLine=\"*-ControlledFolderAccessProtectedFolders *\" OR CommandLine=\"*-</match>
  </rule>
</group>
