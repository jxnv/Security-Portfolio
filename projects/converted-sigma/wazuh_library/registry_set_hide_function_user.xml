<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Registry Hide Function from User</description>
    <match>(((TargetObject=\"*SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Explorer\\\\Advanced\\\\ShowInfoTip\" OR TargetObject=\"*SOFTW</match>
  </rule>
</group>
