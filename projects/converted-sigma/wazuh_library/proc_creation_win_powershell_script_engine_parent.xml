<!--
  Title: Suspicious PowerShell Invocation From Script Engines
  ID: 95eadcb2-92e4-4ed1-9031-92547773a6db
  Status: test
  Level: medium
  Author: Florian Roth (Nextron Systems)
  Date: 2019-01-16
  Description: Detects suspicious powershell invocations from interpreters or unusual programs
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious PowerShell Invocation From Script Engines</description>
    <match>(((ParentImage=\"*\\\\wscript.exe\" OR ParentImage=\"*\\\\cscript.exe\") AND (Image=\"*\\\\powershell.exe\" OR Image=\"*\\\\pwsh.exe\"))</match>
  </rule>
</group>
