    <description>New User Created Via Net.EXE</description>
    <match>(((CommandLine=\"*user*\" AND CommandLine=\"*add*\")) AND (((Image=\"*\\\\net.exe\" OR Image=\"*\\\\net1.exe\")) OR ((OriginalFileNa</match>
  </rule>
</group>
