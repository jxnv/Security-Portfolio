<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Cobalt Strike DNS Beaconing - DNS Client</description>
    <match>((EventID=\"3008\") AND (((QueryName=\"aaa.stage.*\" OR QueryName=\"post.1*\")) OR (QueryName=\"*.stage.123456.*\")))</match>
  </rule>
</group>
