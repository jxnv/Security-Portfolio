<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Windows Webshell Strings</description>
    <match>((\"=whoami\" OR \"=net%20user\" OR \"=net+user\" OR \"=net%2Buser\" OR \"=cmd%20/c%\" OR \"=cmd+/c+\" OR \"=cmd%2B/c%\" OR \"=cmd%20/r</match>
  </rule>
</group>
