<!--
  Title: Service StartupType Change Via Sc.EXE
  ID: 85c312b7-f44d-4a51-a024-d671c40b49fc
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-08-01
  Description: Detect the use of "sc.exe" to change the startup type of a service to "disabled" or "demand"
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Service StartupType Change Via Sc.EXE</description>
    <match>(((CommandLine=\"* config *\" AND CommandLine=\"*start*\") AND (CommandLine=\"*disabled*\" OR CommandLine=\"*demand*\")) AND ((I</match>
  </rule>
</group>
