  Description: Detects the execution of WMIC to query information on a remote system
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>WMIC Remote Command Execution</description>
    <match>((((CommandLine=\"*/node:*\" OR CommandLine=\"*-node:*\")) AND ((Image=\"*\\\\WMIC.exe\") OR (OriginalFileName=\"wmic.exe\"))) AND</match>
  </rule>
</group>
