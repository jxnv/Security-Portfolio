<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>ESXi Account Creation Via ESXCLI</description>
    <match>(Image=\"*/esxcli\" AND (CommandLine=\"*system *\" AND CommandLine=\"*account *\" AND CommandLine=\"*add *\"))</match>
  </rule>
</group>
