<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Whoami.EXE Execution From Privileged Process</description>
    <match>(((OriginalFileName=\"whoami.exe\") OR (Image=\"*\\\\whoami.exe\")) AND ((User=\"*AUTHORI*\" OR User=\"*AUTORI*\" OR User=\"*Truste</match>
  </rule>
</group>
