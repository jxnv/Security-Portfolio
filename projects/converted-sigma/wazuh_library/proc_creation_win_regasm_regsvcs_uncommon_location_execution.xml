<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potentially Suspicious Execution Of Regasm/Regsvcs From Uncommon Location</description>
    <match>(((CommandLine=\"*\\\\AppData\\\\Local\\\\Temp\\\\*\" OR CommandLine=\"*\\\\Microsoft\\\\Windows\\\\Start Menu\\\\Programs\\\\Startup\\\\*\" OR </match>
  </rule>
</group>
