<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Kerberos Manipulation</description>
    <match>((EventID=\"675\" OR EventID=\"4768\" OR EventID=\"4769\" OR EventID=\"4771\") AND (Status=\"0x9\" OR Status=\"0xA\" OR Status=\"0xB\"</match>
  </rule>
</group>
