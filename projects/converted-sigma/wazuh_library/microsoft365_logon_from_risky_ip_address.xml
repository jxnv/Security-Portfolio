<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Logon from a Risky IP Address</description>
    <match>(eventSource=\"SecurityComplianceCenter\" AND eventName=\"Log on from a risky IP address\" AND status=\"success\")</match>
  </rule>
</group>
