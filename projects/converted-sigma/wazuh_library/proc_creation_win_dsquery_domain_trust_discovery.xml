<!--
  Title: Domain Trust Discovery Via Dsquery
  ID: 3bad990e-4848-4a78-9530-b427d854aac0
  Status: test
  Level: medium
  Author: E.M. Anhaus, Tony Lambert, oscd.community, omkar72
  Date: 2019-10-24
  Description: Detects execution of "dsquery.exe" for domain trust discovery
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Domain Trust Discovery Via Dsquery</description>
    <match>((CommandLine=\"*trustedDomain*\") AND ((Image=\"*\\\\dsquery.exe\") OR (OriginalFileName=\"dsquery.exe\")))</match>
  </rule>
</group>
