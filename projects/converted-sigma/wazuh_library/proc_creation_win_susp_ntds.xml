<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Process Patterns NTDS.DIT Exfil</description>
    <match>((((CommandLine=\"*ac i ntds*\" AND CommandLine=\"*create full*\")) OR ((CommandLine=\"*/c copy *\" AND CommandLine=\"*\\\\window</match>
  </rule>
</group>
