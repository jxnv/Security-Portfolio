<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Filter Driver Unloaded Via Fltmc.EXE</description>
    <match>(((CommandLine=\"*unload*\") AND ((Image=\"*\\\\fltMC.exe\") OR (OriginalFileName=\"fltMC.exe\"))) AND NOT ((((ParentImage=\"*\\\\A</match>
  </rule>
</group>
