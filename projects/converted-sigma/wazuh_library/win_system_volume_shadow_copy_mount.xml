  Description: Detects volume shadow copy mount via Windows event log
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Volume Shadow Copy Mount</description>
    <match>(Provider_Name=\"Microsoft-Windows-Ntfs\" AND EventID=\"98\" AND DeviceName=\"*HarddiskVolumeShadowCopy*\")</match>
  </rule>
</group>
