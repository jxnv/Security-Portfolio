<!--
  Title: Suspicious File Write to Webapps Root Directory
  ID: 89c42960-f244-4dad-9151-ae9b1a3287a2
  Status: experimental
  Level: medium
  Author: Swachchhanda Shrawan Poudel (Nextron Systems)
  Date: 2025-10-20
  Description: Detects suspicious file writes to the root directory of web applications, particularly Apache web servers or Tomcat servers. This may indicate an attempt to deploy malicious files such as web shells or other unauthorized scripts.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious File Write to Webapps Root Directory</description>
    <match>((TargetFilename=\"*\\\\webapps\\\\ROOT\\\\*\") AND ((TargetFilename=\"*\\\\apache*\" OR TargetFilename=\"*\\\\tomcat*\")) AND (TargetFi</match>
  </rule>
</group>
