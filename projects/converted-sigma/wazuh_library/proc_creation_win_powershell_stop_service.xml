    <description>Stop Windows Service Via PowerShell Stop-Service</description>
    <match>((CommandLine=\"*Stop-Service *\") AND (((OriginalFileName=\"PowerShell.EXE\" OR OriginalFileName=\"pwsh.dll\")) OR ((Image=\"*</match>
  </rule>
</group>
