<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>EventLog EVTX File Deleted</description>
    <match>(TargetFilename=\"C:\\\\Windows\\\\System32\\\\winevt\\\\Logs\\\\*\" AND TargetFilename=\"*.evtx\")</match>
  </rule>
</group>
