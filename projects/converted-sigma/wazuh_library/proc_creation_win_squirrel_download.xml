-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Arbitrary File Download Via Squirrel.EXE</description>
    <match>(((CommandLine=\"* --download *\" OR CommandLine=\"* --update *\" OR CommandLine=\"* --updateRollback=*\")) AND (CommandLine=\"</match>
  </rule>
</group>
