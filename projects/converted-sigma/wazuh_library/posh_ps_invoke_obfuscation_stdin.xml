<!--
  Title: Invoke-Obfuscation STDIN+ Launcher - Powershell
  ID: 779c8c12-0eb1-11eb-adc1-0242ac120002
  Status: test
  Level: high
  Author: Jonathan Cheong, oscd.community
  Date: 2020-10-15
  Description: Detects Obfuscated use of stdin to execute PowerShell
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Invoke-Obfuscation STDIN+ Launcher - Powershell</description>
    <match>(ScriptBlockText=regex(\"cmd.{0,5}(?:/c|/r).+powershell.+(?:\\\\$?\\\\{?input\\\\}?|noexit).+\\\"\"))</match>
  </rule>
</group>
