<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Diagnostic Library Sdiageng.DLL Loaded By Msdt.EXE</description>
    <match>(Image=\"*\\\\msdt.exe\" AND ImageLoaded=\"*\\\\sdiageng.dll\")</match>
  </rule>
</group>
