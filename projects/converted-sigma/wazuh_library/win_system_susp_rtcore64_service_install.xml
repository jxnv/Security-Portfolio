<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>RTCore Suspicious Service Installation</description>
    <match>(Provider_Name=\"Service Control Manager\" AND EventID=\"7045\" AND ServiceName=\"RTCore64\")</match>
  </rule>
</group>
