<!--
  Title: Abusing Print Executable
  ID: bafac3d6-7de9-4dd9-8874-4a1194b493ed
  Status: test
  Level: medium
  Author: Furkan CALISKAN, @caliskanfurkan_, @oscd_initiative
  Date: 2020-10-05
  Description: Attackers can use print.exe for remote file copy
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Abusing Print Executable</description>
    <match>((Image=\"*\\\\print.exe\" AND CommandLine=\"print*\" AND (CommandLine=\"*/D*\" AND CommandLine=\"*.exe*\")) AND NOT ((CommandLine</match>
  </rule>
</group>
