<!--
  Title: Suspicious Regsvr32 Execution From Remote Share
  ID: 88a87a10-384b-4ad7-8871-2f9bf9259ce5
  Status: test
  Level: high
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-10-31
  Description: Detects REGSVR32.exe to execute DLL hosted on remote shares
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Regsvr32 Execution From Remote Share</description>
    <match>((CommandLine=\"* \\\\\\\\\\\\\\\\*\") AND ((Image=\"*\\\\regsvr32.exe\") OR (OriginalFileName=\"\\\\REGSVR32.EXE\")))</match>
  </rule>
</group>
