<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Invoke-Obfuscation RUNDLL LAUNCHER - PowerShell Module</description>
    <match>((Payload=\"*rundll32.exe*\" AND Payload=\"*shell32.dll*\" AND Payload=\"*shellexec_rundll*\" AND Payload=\"*powershell*\"))</match>
  </rule>
</group>
