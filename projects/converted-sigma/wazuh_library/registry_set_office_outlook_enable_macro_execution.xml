<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Outlook Macro Execution Without Warning Setting Enabled</description>
    <match>(TargetObject=\"*\\\\Outlook\\\\Security\\\\Level\" AND Details=\"*0x00000001*\")</match>
  </rule>
</group>
