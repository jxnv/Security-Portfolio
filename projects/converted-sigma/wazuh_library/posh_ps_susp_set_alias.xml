    <description>Potential PowerShell Obfuscation Using Alias Cmdlets</description>
    <match>(((ScriptBlockText=\"*Set-Alias *\" OR ScriptBlockText=\"*New-Alias *\")) AND NOT (((ScriptBlockText=\"Set-Alias -Name ncms -</match>
  </rule>
</group>
