<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Powershell Defender Exclusion</description>
    <match>(((CommandLine=\"*Add-MpPreference *\" OR CommandLine=\"*Set-MpPreference *\")) AND ((CommandLine=\"* -ExclusionPath *\" OR Co</match>
  </rule>
</group>
