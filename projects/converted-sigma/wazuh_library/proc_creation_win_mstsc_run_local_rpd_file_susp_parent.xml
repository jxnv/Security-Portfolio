<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Mstsc.EXE Execution From Uncommon Parent</description>
    <match>(((Image=\"*\\\\mstsc.exe\") OR (OriginalFileName=\"mstsc.exe\")) AND ((ParentImage=\"*\\\\brave.exe\" OR ParentImage=\"*\\\\CCleaner</match>
  </rule>
</group>
