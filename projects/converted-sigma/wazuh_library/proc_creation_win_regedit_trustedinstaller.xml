<!--
  Title: Regedit as Trusted Installer
  ID: 883835a7-df45-43e4-bf1d-4268768afda4
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems)
  Date: 2021-05-27
  Description: Detects a regedit started with TrustedInstaller privileges or by ProcessHacker.exe
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Regedit as Trusted Installer</description>
    <match>(Image=\"*\\\\regedit.exe\" AND (ParentImage=\"*\\\\TrustedInstaller.exe\" OR ParentImage=\"*\\\\ProcessHacker.exe\"))</match>
  </rule>
</group>
