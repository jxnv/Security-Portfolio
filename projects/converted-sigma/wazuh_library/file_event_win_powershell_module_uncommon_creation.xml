<!--
  Title: PowerShell Module File Created By Non-PowerShell Process
  ID: e3845023-ca9a-4024-b2b2-5422156d5527
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2023-05-09
  Description: Detects the creation of a new PowerShell module ".psm1", ".psd1", ".dll", ".ps1", etc. by a non-PowerShell process
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>PowerShell Module File Created By Non-PowerShell Process</description>
    <match>(((TargetFilename=\"*\\\\WindowsPowerShell\\\\Modules\\\\*\" OR TargetFilename=\"*\\\\PowerShell\\\\7\\\\Modules\\\\*\")) AND NOT ((((Imag</match>
  </rule>
</group>
