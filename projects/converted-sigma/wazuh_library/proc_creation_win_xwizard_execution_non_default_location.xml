  Level: high
  Author: Christian Burkard (Nextron Systems)
  Date: 2021-09-20
  Description: Detects the execution of Xwizard tool from a non-default directory. When executed from a non-default directory, this utility can be abused in order to side load a custom version of "xwizards.dll".
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Xwizard.EXE Execution From Non-Default Location</description>
    <match>(((Image=\"*\\\\xwizard.exe\") OR (OriginalFileName=\"xwizard.exe\")) AND NOT (((Image=\"C:\\\\Windows\\\\System32\\\\*\" OR Image=\"C:</match>
  </rule>
</group>
