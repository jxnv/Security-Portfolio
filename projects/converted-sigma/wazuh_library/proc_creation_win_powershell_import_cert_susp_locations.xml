<!--
  Title: Root Certificate Installed From Susp Locations
  ID: 5f6a601c-2ecb-498b-9c33-660362323afa
  Status: test
  Level: high
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-09-09
  Description: Adversaries may install a root certificate on a compromised system to avoid warnings when connecting to adversary controlled web servers.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Root Certificate Installed From Susp Locations</description>
    <match>((CommandLine=\"*Import-Certificate*\" AND CommandLine=\"* -FilePath *\" AND CommandLine=\"*Cert:\\\\LocalMachine\\\\Root*\") AND </match>
  </rule>
</group>
