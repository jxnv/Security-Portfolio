<!--
  Title: AWS New Lambda Layer Attached
  ID: 97fbabf8-8e1b-47a2-b7d5-a418d2b95e3d
  Status: test
  Level: low
  Author: Austin Songer
  Date: 2021-09-23
  Description: Detects when a user attached a Lambda layer to an existing Lambda function. A malicious Lambda layer could execute arbitrary code in the context of the function's IAM role. This would give an adversary access to resources that the function has access to.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>AWS New Lambda Layer Attached</description>
    <match>(eventSource=\"lambda.amazonaws.com\" AND eventName=\"UpdateFunctionConfiguration*\" AND requestParameters.layers=\"***\")</match>
  </rule>
</group>
