<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Renamed CreateDump Utility Execution</description>
    <match>(((((CommandLine=\"* -u *\" AND CommandLine=\"* -f *\" AND CommandLine=\"*.dmp*\")) OR ((CommandLine=\"* --full *\" AND CommandL</match>
  </rule>
</group>
