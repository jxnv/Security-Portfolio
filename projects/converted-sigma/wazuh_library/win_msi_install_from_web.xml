<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>MSI Installation From Web</description>
    <match>(Provider_Name=\"MsiInstaller\" AND (EventID=\"1040\" OR EventID=\"1042\") AND Data=\"*://*\")</match>
  </rule>
</group>
