<!--
  Title: APT User Agent
  ID: 6ec820f2-e963-4801-9127-d8b2dce4d31b
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems), Markus Neis
  Date: 2019-11-12
  Description: Detects suspicious user agent strings used in APT malware in proxy logs
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>APT User Agent</description>
    <match>((c-useragent=\"SJZJ (compatible; MSIE 6.0; Win32)\" OR c-useragent=\"Mozilla/5.0 (Windows NT 6.; WOW64; rv:20.0) Gecko/201</match>
  </rule>
</group>
