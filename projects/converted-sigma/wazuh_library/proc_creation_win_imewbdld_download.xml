<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Arbitrary File Download Via IMEWDBLD.EXE</description>
    <match>(((CommandLine=\"*http://*\" OR CommandLine=\"*https://*\")) AND ((Image=\"*\\\\IMEWDBLD.exe\") OR (OriginalFileName=\"imewdbld.e</match>
  </rule>
</group>
