<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>WinDivert Driver Load</description>
    <match>(((ImageLoaded=\"*\\\\WinDivert.sys*\" OR ImageLoaded=\"*\\\\WinDivert64.sys*\" OR ImageLoaded=\"*\\\\NordDivert.sys*\" OR ImageLoad</match>
  </rule>
</group>
