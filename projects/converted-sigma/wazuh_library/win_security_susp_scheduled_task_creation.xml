<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Scheduled Task Creation</description>
    <match>(((TaskContent=\"*regsvr32*\" OR TaskContent=\"*rundll32*\" OR TaskContent=\"*cmd.exe</Command>*\" OR TaskContent=\"*cmd</Comma</match>
  </rule>
</group>
