<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>New Application in AppCompat</description>
    <match>(TargetObject=\"*\\\\AppCompatFlags\\\\Compatibility Assistant\\\\Store\\\\*\")</match>
  </rule>
</group>
