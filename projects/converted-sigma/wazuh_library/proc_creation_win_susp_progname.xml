<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Program Names</description>
    <match>(((CommandLine=\"*inject.ps1*\" OR CommandLine=\"*Invoke-CVE*\" OR CommandLine=\"*pupy.ps1*\" OR CommandLine=\"*payload.ps1*\" O</match>
  </rule>
</group>
