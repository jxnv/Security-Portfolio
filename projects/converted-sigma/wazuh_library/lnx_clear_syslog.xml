  Description: Detects specific commands commonly used to remove or empty the syslog
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Commands to Clear or Remove the Syslog - Builtin</description>
    <match>((\"rm /var/log/syslog\" OR \"rm -r /var/log/syslog\" OR \"rm -f /var/log/syslog\" OR \"rm -rf /var/log/syslog\" OR \"mv /var/log</match>
  </rule>
</group>
