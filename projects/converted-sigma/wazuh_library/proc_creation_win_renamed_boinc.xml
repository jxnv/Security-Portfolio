<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Renamed BOINC Client Execution</description>
    <match>((OriginalFileName=\"BOINC.exe\") AND NOT ((Image=\"*\\\\BOINC.exe\")))</match>
  </rule>
</group>
