  Description: Detects a potentially suspicious execution of a parent process located in the "\Users\Public" folder executing a child process containing references to shell or scripting binaries and commandlines.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potentially Suspicious Execution From Parent Process In Public Folder</description>
    <match>((((Image=\"*\\\\bitsadmin.exe\" OR Image=\"*\\\\certutil.exe\" OR Image=\"*\\\\cmd.exe\" OR Image=\"*\\\\cscript.exe\" OR Image=\"*\\\\msh</match>
  </rule>
</group>
