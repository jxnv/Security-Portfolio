<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Active Directory Certificate Services Denied Certificate Enrollment Request</description>
    <match>(Provider_Name=\"Microsoft-Windows-CertificationAuthority\" AND EventID=\"53\")</match>
  </rule>
</group>
