<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Execute Invoke-command on Remote Host</description>
    <match>((ScriptBlockText=\"*invoke-command *\" AND ScriptBlockText=\"* -ComputerName *\"))</match>
  </rule>
</group>
