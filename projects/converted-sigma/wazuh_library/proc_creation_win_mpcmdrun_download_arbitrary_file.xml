<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>File Download Via Windows Defender MpCmpRun.EXE</description>
    <match>(((CommandLine=\"*DownloadFile*\" AND CommandLine=\"*url*\")) AND ((OriginalFileName=\"MpCmdRun.exe\") OR (Image=\"*\\\\MpCmdRun.</match>
  </rule>
</group>
