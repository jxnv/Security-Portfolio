<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>External Disk Drive Or USB Storage Device Was Recognized By The System</description>
    <match>((EventID=\"6416\") AND ((ClassName=\"DiskDrive\") OR (DeviceDescription=\"USB Mass Storage Device\")))</match>
  </rule>
</group>
