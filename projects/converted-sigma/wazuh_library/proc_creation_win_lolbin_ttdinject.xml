<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Use of TTDInject.exe</description>
    <match>((Image=\"*ttdinject.exe\") OR (OriginalFileName=\"TTDInject.EXE\"))</match>
  </rule>
</group>
