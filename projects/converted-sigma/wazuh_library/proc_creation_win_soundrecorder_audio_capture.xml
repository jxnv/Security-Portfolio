<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Audio Capture via SoundRecorder</description>
    <match>(Image=\"*\\\\SoundRecorder.exe\" AND CommandLine=\"*/FILE*\")</match>
  </rule>
</group>
