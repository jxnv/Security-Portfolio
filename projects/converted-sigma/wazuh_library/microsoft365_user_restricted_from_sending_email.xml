<!--
  Title: Microsoft 365 - User Restricted from Sending Email
  ID: ff246f56-7f24-402a-baca-b86540e3925c
  Status: test
  Level: medium
  Author: austinsonger
  Date: 2021-08-19
  Description: Detects when a Security Compliance Center reported a user who exceeded sending limits of the service policies and because of this has been restricted from sending email.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Microsoft 365 - User Restricted from Sending Email</description>
    <match>(eventSource=\"SecurityComplianceCenter\" AND eventName=\"User restricted from sending email\" AND status=\"success\")</match>
  </rule>
</group>
