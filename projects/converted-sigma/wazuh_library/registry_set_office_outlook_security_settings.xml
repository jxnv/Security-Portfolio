<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Outlook Security Settings Updated - Registry</description>
    <match>(((TargetObject=\"*\\\\SOFTWARE\\\\Microsoft\\\\Office\\\\*\" AND TargetObject=\"*\\\\Outlook\\\\Security\\\\*\")) AND NOT (((Image=\"C:\\\\P</match>
  </rule>
</group>
