<!--
  Title: Program Executions in Suspicious Folders
  ID: a39d7fa7-3fbd-4dc2-97e1-d87f546b1bbc
  Status: test
  Level: medium
  Author: Florian Roth (Nextron Systems)
  Date: 2018-01-23
  Description: Detects program executions in suspicious non-program folders related to malware or hacking activity
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Program Executions in Suspicious Folders</description>
    <match>(type=\"SYSCALL\" AND (exe=\"/tmp/*\" OR exe=\"/var/www/*\" OR exe=\"/home/*/public_html/*\" OR exe=\"/usr/local/apache2/*\" OR ex</match>
  </rule>
</group>
