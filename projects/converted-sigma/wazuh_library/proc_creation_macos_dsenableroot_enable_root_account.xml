<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Root Account Enable Via Dsenableroot</description>
    <match>((Image=\"*/dsenableroot\") AND NOT ((CommandLine=\"* -d *\")))</match>
  </rule>
</group>
