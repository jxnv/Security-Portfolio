  Level: high
  Author: frack113, Nasreddine Bencherchali (Nextron Systems)
  Date: 2021-06-08
  Description: Detects changes to Microsoft Office protected view registry keys with which the attacker disables this feature.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Microsoft Office Protected View Disabled</description>
    <match>(((TargetObject=\"*\\\\SOFTWARE\\\\Microsoft\\\\Office\\\\*\" AND TargetObject=\"*\\\\Security\\\\ProtectedView\\\\*\")) AND ((Details=\"DW</match>
  </rule>
</group>
