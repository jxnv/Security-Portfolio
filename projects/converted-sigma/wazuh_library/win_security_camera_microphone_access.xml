<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Processes Accessing the Microphone and Webcam</description>
    <match>((EventID=\"4657\" OR EventID=\"4656\" OR EventID=\"4663\") AND (ObjectName=\"*\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\</match>
  </rule>
</group>
