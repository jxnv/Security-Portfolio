<!--
  Title: MSSQL XPCmdshell Suspicious Execution
  ID: 7f103213-a04e-4d59-8261-213dddf22314
  Status: test
  Level: high
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-07-12
  Description: Detects when the MSSQL "xp_cmdshell" stored procedure is used to execute commands
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>MSSQL XPCmdshell Suspicious Execution</description>
    <match>(Provider_Name=\"*MSSQL*\" AND EventID=\"33205\" AND (Data=\"*object_name:xp_cmdshell*\" AND Data=\"*statement:EXEC*\"))</match>
  </rule>
</group>
