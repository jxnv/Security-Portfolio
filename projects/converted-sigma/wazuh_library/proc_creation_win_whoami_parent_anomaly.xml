  Description: Detects the execution of whoami.exe with suspicious parent processes.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Whoami.EXE Execution Anomaly</description>
    <match>(((Image=\"*\\\\whoami.exe\") OR (OriginalFileName=\"whoami.exe\")) AND NOT ((((ParentImage=\"*\\\\cmd.exe\" OR ParentImage=\"*\\\\po</match>
  </rule>
</group>
