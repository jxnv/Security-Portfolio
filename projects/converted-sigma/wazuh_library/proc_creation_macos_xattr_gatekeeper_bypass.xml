<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Gatekeeper Bypass via Xattr</description>
    <match>(Image=\"*/xattr\" AND (CommandLine=\"*-d*\" AND CommandLine=\"*com.apple.quarantine*\"))</match>
  </rule>
</group>
