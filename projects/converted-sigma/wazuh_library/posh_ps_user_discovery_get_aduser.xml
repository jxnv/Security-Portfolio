<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>User Discovery And Export Via Get-ADUser Cmdlet - PowerShell</description>
    <match>((ScriptBlockText=\"*Get-ADUser *\" AND ScriptBlockText=\"* -Filter \\\\**\") AND (ScriptBlockText=\"* > *\" OR ScriptBlockText=</match>
  </rule>
</group>
