  Date: 2023-06-02
  Description: Detects the use of grep to identify information about the operating system architecture. Often combined beforehand with the execution of "uname" or "cat /proc/cpuinfo"
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>OS Architecture Discovery Via Grep</description>
    <match>(((CommandLine=\"*aarch64\" OR CommandLine=\"*arm\" OR CommandLine=\"*i386\" OR CommandLine=\"*i686\" OR CommandLine=\"*mips\" OR </match>
  </rule>
</group>
