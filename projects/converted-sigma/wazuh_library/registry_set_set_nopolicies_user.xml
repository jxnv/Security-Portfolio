<!--
  Title: Registry Explorer Policy Modification
  ID: 1c3121ed-041b-4d97-a075-07f54f20fb4a
  Status: test
  Level: medium
  Author: frack113
  Date: 2022-03-18
  Description: Detects registry modifications that disable internal tools or functions in explorer (malware like Agent Tesla uses this technique)
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Registry Explorer Policy Modification</description>
    <match>((TargetObject=\"*SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Policies\\\\Explorer\\\\NoLogOff\" OR TargetObject=\"*SOFTWARE\\</match>
  </rule>
</group>
