  Date: 2019-10-25
  Description: Detects modification of autostart extensibility point (ASEP) in registry.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>CurrentControlSet Autorun Keys Modification</description>
    <match>(((TargetObject=\"*\\\\SYSTEM\\\\CurrentControlSet\\\\Control*\") AND ((TargetObject=\"*\\\\Terminal Server\\\\WinStations\\\\RDP-Tcp\\\\</match>
  </rule>
</group>
