  Description: Detects the execution of the nscurl utility in order to download files.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>File Download Via Nscurl - MacOS</description>
    <match>(Image=\"*/nscurl\" AND (CommandLine=\"*--download *\" OR CommandLine=\"*--download-directory *\" OR CommandLine=\"*--output *\"</match>
  </rule>
</group>
