<!--
  Title: Sysmon Driver Unloaded Via Fltmc.EXE
  ID: 4d7cda18-1b12-4e52-b45c-d28653210df8
  Status: test
  Level: high
  Author: Kirill Kiryanov, oscd.community
  Date: 2019-10-23
  Description: Detects possible Sysmon filter driver unloaded via fltmc.exe
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Sysmon Driver Unloaded Via Fltmc.EXE</description>
    <match>(((CommandLine=\"*unload*\" AND CommandLine=\"*sysmon*\")) AND ((Image=\"*\\\\fltMC.exe\") OR (OriginalFileName=\"fltMC.exe\")))</match>
  </rule>
</group>
