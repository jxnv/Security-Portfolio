<!--
  Title: PSExec and WMI Process Creations Block
  ID: 97b9ce1e-c5ab-11ea-87d0-0242ac130003
  Status: test
  Level: high
  Author: Bhabesh Raj
  Date: 2020-07-14
  Description: Detects blocking of process creations originating from PSExec and WMI commands
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>PSExec and WMI Process Creations Block</description>
    <match>(EventID=\"1121\" AND (ProcessName=\"*\\\\wmiprvse.exe\" OR ProcessName=\"*\\\\psexesvc.exe\"))</match>
  </rule>
</group>
