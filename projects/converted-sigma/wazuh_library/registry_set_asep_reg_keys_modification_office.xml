<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Office Autorun Keys Modification</description>
    <match>((((TargetObject=\"*\\\\Word\\\\Addins*\" OR TargetObject=\"*\\\\PowerPoint\\\\Addins*\" OR TargetObject=\"*\\\\Outlook\\\\Addins*\" OR Ta</match>
  </rule>
</group>
