<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potential PowerShell Command Line Obfuscation</description>
    <match>(((((Image=\"*\\\\powershell.exe\" OR Image=\"*\\\\pwsh.exe\")) OR ((OriginalFileName=\"PowerShell.EXE\" OR OriginalFileName=\"pwsh</match>
  </rule>
</group>
