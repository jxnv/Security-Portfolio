<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Legitimate Application Dropped Script</description>
    <match>(((Image=\"*\\\\eqnedt32.exe\" OR Image=\"*\\\\wordpad.exe\" OR Image=\"*\\\\wordview.exe\" OR Image=\"*\\\\certutil.exe\" OR Image=\"*\\\\</match>
  </rule>
</group>
