<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>AppLocker Prevented Application or Script from Running</description>
    <match>((EventID=\"8004\" OR EventID=\"8007\" OR EventID=\"8022\" OR EventID=\"8025\"))</match>
  </rule>
</group>
