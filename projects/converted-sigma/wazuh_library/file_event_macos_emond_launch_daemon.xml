<!--
  Title: MacOS Emond Launch Daemon
  ID: 23c43900-e732-45a4-8354-63e4a6c187ce
  Status: test
  Level: medium
  Author: Alejandro Ortuno, oscd.community
  Date: 2020-10-23
  Description: Detects additions to the Emond Launch Daemon that adversaries may use to gain persistence and elevate privileges.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>MacOS Emond Launch Daemon</description>
    <match>((TargetFilename=\"*/etc/emond.d/rules/*\" AND TargetFilename=\"*.plist\") OR (TargetFilename=\"*/private/var/db/emondClients</match>
  </rule>
</group>
