<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Execution From Outlook Temporary Folder</description>
    <match>(Image=\"*\\\\Temporary Internet Files\\\\Content.Outlook\\\\*\")</match>
  </rule>
</group>
