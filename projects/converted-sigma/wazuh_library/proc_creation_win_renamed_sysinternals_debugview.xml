<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Renamed SysInternals DebugView Execution</description>
    <match>((Product=\"Sysinternals DebugView\") AND NOT ((OriginalFileName=\"Dbgview.exe\" AND Image=\"*\\\\Dbgview.exe\")))</match>
  </rule>
</group>
