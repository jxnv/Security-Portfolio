  Date: 2019-10-24
  Description: Detects uncommon outbound network activity via Kerberos default port indicating possible lateral movement or first stage PrivEsc via delegation.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Uncommon Outbound Kerberos Connection - Security</description>
    <match>((EventID=\"5156\" AND DestPort=\"88\") AND NOT (((Application=\"\\\\device\\\\harddiskvolume*\" OR Application=\"C:*\") AND Applica</match>
  </rule>
</group>
