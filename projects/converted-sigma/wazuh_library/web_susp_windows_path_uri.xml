<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Windows Strings In URI</description>
    <match>((cs-uri-query=\"*=C:/Users*\" OR cs-uri-query=\"*=C:/Program%20Files*\" OR cs-uri-query=\"*=C:/Windows*\" OR cs-uri-query=\"*=</match>
  </rule>
</group>
