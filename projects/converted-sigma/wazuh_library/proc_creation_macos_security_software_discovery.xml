<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Security Software Discovery - MacOs</description>
    <match>((Image=\"/usr/bin/grep\") AND (((CommandLine=\"*nessusd*\" OR CommandLine=\"*santad*\" OR CommandLine=\"*CbDefense*\" OR Comman</match>
  </rule>
</group>
