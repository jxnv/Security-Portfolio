<!--
  Title: Suspicious Start-Process PassThru
  ID: 0718cd72-f316-4aa2-988f-838ea8533277
  Status: test
  Level: medium
  Author: frack113
  Date: 2022-01-15
  Description: Powershell use PassThru option to start in background
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious Start-Process PassThru</description>
    <match>(((ScriptBlockText=\"*Start-Process *\" OR ScriptBlockText=\"*saps *\")) AND ((ScriptBlockText=\"*-PassThru *\" AND ScriptBloc</match>
  </rule>
</group>
