<!--
  Title: Setuid and Setgid
  ID: c21c4eaa-ba2e-419a-92b2-8371703cbe21
  Status: test
  Level: low
  Author: Ömer Günal
  Date: 2020-06-16
  Description: Detects suspicious change of file privileges with chown and chmod commands
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Setuid and Setgid</description>
    <match>(((CommandLine=\"* chmod u+s*\" OR CommandLine=\"* chmod g+s*\")) AND (CommandLine=\"*chown root*\"))</match>
  </rule>
</group>
