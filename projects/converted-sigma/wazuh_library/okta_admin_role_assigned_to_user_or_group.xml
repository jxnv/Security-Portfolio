<!--
  Title: Okta Admin Role Assigned to an User or Group
  ID: 413d4a81-6c98-4479-9863-014785fd579c
  Status: test
  Level: medium
  Author: Austin Songer @austinsonger
  Date: 2021-09-12
  Description: Detects when an the Administrator role is assigned to an user or group.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Okta Admin Role Assigned to an User or Group</description>
    <match>((eventType=\"group.privilege.grant\" OR eventType=\"user.account.privilege.grant\"))</match>
  </rule>
</group>
