<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>File Download From IP Based URL Via CertOC.EXE</description>
    <match>((CommandLine=\"*-GetCACAPS*\") AND ((Image=\"*\\\\certoc.exe\") OR (OriginalFileName=\"CertOC.exe\")) AND (CommandLine=regex(\":</match>
  </rule>
</group>
