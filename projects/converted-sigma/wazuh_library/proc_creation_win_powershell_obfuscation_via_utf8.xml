<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potential PowerShell Obfuscation Via WCHAR/CHAR</description>
    <match>((CommandLine=\"*[char]0x*\" OR CommandLine=\"*(WCHAR)0x*\"))</match>
  </rule>
</group>
