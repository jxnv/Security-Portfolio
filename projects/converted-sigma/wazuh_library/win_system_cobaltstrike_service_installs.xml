<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>CobaltStrike Service Installations - System</description>
    <match>((Provider_Name=\"Service Control Manager\" AND EventID=\"7045\") AND (((ImagePath=\"*ADMIN$*\" AND ImagePath=\"*.exe*\")) OR ((</match>
  </rule>
</group>
