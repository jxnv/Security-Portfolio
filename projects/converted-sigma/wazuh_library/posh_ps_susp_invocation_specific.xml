<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious PowerShell Invocations - Specific</description>
    <match>((((ScriptBlockText=\"*-nop*\" AND ScriptBlockText=\"* -w *\" AND ScriptBlockText=\"*hidden*\" AND ScriptBlockText=\"* -c *\" AN</match>
  </rule>
</group>
