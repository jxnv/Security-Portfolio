<!--
  Title: Reconnaissance Activity
  ID: 968eef52-9cff-4454-8992-1e74b9cbad6c
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems), Jack Croock (method), Jonhnathan Ribeiro (improvements), oscd.community
  Date: 2017-03-07
  Description: Detects activity as "net user administrator /domain" and "net group domain admins /domain"
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Reconnaissance Activity</description>
    <match>(EventID=\"4661\" AND AccessMask=\"0x2d\" AND (ObjectType=\"SAM_USER\" OR ObjectType=\"SAM_GROUP\") AND ObjectName=\"S-1-5-21-*\" </match>
  </rule>
</group>
