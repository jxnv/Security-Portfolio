<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential Direct Syscall of NtOpenProcess</description>
    <match>((CallTrace=\"UNKNOWN*\") AND NOT ((((SourceImage=\"*:\\\\Program Files (x86)\\\\*\" OR SourceImage=\"*:\\\\Program Files\\\\*\" OR So</match>
  </rule>
</group>
