<!--
  Title: Suspicious Interactive PowerShell as SYSTEM
  ID: 5b40a734-99b6-4b98-a1d0-1cea51a08ab2
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems)
  Date: 2021-12-07
  Description: Detects the creation of files that indicator an interactive use of PowerShell in the SYSTEM user context
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Interactive PowerShell as SYSTEM</description>
    <match>((TargetFilename=\"C:\\\\Windows\\\\System32\\\\config\\\\systemprofile\\\\AppData\\\\Roaming\\\\Microsoft\\\\Windows\\\\PowerShell\\\\PSRead</match>
  </rule>
</group>
