<!--
  Title: Screen Capture Activity Via Psr.EXE
  ID: 2158f96f-43c2-43cb-952a-ab4580f32382
  Status: test
  Level: medium
  Author: Beyu Denis, oscd.community
  Date: 2019-10-12
  Description: Detects execution of Windows Problem Steps Recorder (psr.exe), a utility used to record the user screen and clicks.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Screen Capture Activity Via Psr.EXE</description>
    <match>(Image=\"*\\\\Psr.exe\" AND (CommandLine=\"*/start*\" OR CommandLine=\"*-start*\"))</match>
  </rule>
</group>
