<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Indirect Inline Command Execution Via Bash.EXE</description>
    <match>((CommandLine=\"* -c *\") AND (((Image=\"*:\\\\Windows\\\\System32\\\\bash.exe\" OR Image=\"*:\\\\Windows\\\\SysWOW64\\\\bash.exe\")) OR (</match>
  </rule>
</group>
