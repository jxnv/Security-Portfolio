<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Registry Persistence via Service in Safe Mode</description>
    <match>(((TargetObject=\"*\\\\Control\\\\SafeBoot\\\\Minimal\\\\*\" OR TargetObject=\"*\\\\Control\\\\SafeBoot\\\\Network\\\\*\") AND TargetObject=</match>
  </rule>
</group>
