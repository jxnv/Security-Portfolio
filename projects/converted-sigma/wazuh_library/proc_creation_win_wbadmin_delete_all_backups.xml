<!--
  Title: All Backups Deleted Via Wbadmin.EXE
  ID: 639c9081-f482-47d3-a0bd-ddee3d4ecd76
  Status: test
  Level: high
  Author: frack113, Nasreddine Bencherchali (Nextron Systems)
  Date: 2021-12-13
  Description: Detects the deletion of all backups or system state backups via "wbadmin.exe". This technique is used by numerous ransomware families and actors. This may only be successful on server platforms that have Windows Backup enabled.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>All Backups Deleted Via Wbadmin.EXE</description>
    <match>(((CommandLine=\"*delete*\" AND CommandLine=\"*backup*\") AND CommandLine=\"*keepVersions:0*\") AND ((Image=\"*\\\\wbadmin.exe\") </match>
  </rule>
</group>
