<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Security Eventlog Cleared</description>
    <match>((EventID=\"1102\" AND Provider_Name=\"Microsoft-Windows-Eventlog\") OR (EventID=\"517\" AND Provider_Name=\"Security\"))</match>
  </rule>
</group>
