<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>RDP Sensitive Settings Changed to Zero</description>
    <match>((TargetObject=\"*\\\\fDenyTSConnections\" OR TargetObject=\"*\\\\fSingleSessionPerUser\" OR TargetObject=\"*\\\\UserAuthentication</match>
  </rule>
</group>
