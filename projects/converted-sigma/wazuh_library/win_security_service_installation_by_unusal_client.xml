<!--
  Title: Service Installed By Unusual Client - Security
  ID: c4e92a97-a9ff-4392-9d2d-7a4c642768ca
  Status: test
  Level: high
  Author: Tim Rauch (Nextron Systems), Elastic (idea)
  Date: 2022-09-15
  Description: Detects a service installed by a client which has PID 0 or whose parent has PID 0
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Service Installed By Unusual Client - Security</description>
    <match>((EventID=\"4697\") AND ((ClientProcessId=\"0\") OR (ParentProcessId=\"0\")))</match>
  </rule>
</group>
