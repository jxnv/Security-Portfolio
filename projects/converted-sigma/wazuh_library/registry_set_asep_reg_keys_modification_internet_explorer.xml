    <description>Internet Explorer Autorun Keys Modification</description>
    <match>(((TargetObject=\"*\\\\Software\\\\Wow6432Node\\\\Microsoft\\\\Internet Explorer*\" OR TargetObject=\"*\\\\Software\\\\Microsoft\\\\Inter</match>
  </rule>
</group>
