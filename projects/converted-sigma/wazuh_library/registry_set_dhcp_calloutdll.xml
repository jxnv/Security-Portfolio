<!--
  Title: DHCP Callout DLL Installation
  ID: 9d3436ef-9476-4c43-acca-90ce06bdf33a
  Status: test
  Level: high
  Author: Dimitrios Slamaris
  Date: 2017-05-15
  Description: Detects the installation of a Callout DLL via CalloutDlls and CalloutEnabled parameter in Registry, which can be used to execute code in context of the DHCP server (restart required)
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>DHCP Callout DLL Installation</description>
    <match>((TargetObject=\"*\\\\Services\\\\DHCPServer\\\\Parameters\\\\CalloutDlls\" OR TargetObject=\"*\\\\Services\\\\DHCPServer\\\\Parameters\\\\</match>
  </rule>
</group>
