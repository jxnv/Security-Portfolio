<!--
  Title: Powershell Install a DLL in System Directory
  ID: 63bf8794-9917-45bc-88dd-e1b5abc0ecfd
  Status: test
  Level: high
  Author: frack113, Nasreddine Bencherchali (Nextron Systems)
  Date: 2021-12-27
  Description: Uses PowerShell to install/copy a file into a system directory such as "System32" or "SysWOW64"
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Powershell Install a DLL in System Directory</description>
    <match>(ScriptBlockText=regex(\"(Copy-Item|cpi) .{2,128} -Destination .{1,32}\\\\\\\\Windows\\\\\\\\(System32|SysWOW64)\"))</match>
  </rule>
</group>
