<!--
  Title: Renamed ProcDump Execution
  ID: 4a0b2c7e-7cb2-495d-8b63-5f268e7bfd67
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
  Date: 2019-11-18
  Description: Detects the execution of a renamed ProcDump executable. This often done by attackers or malware in order to evade defensive mechanisms.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Renamed ProcDump Execution</description>
    <match>(((OriginalFileName=\"procdump\") OR (((CommandLine=\"* -ma *\" OR CommandLine=\"* -mp *\")) AND (CommandLine=\"* /accepteula*\"</match>
  </rule>
</group>
