<!--
  Title: Execution Of Non-Existing File
  ID: 71158e3f-df67-472b-930e-7d287acaa3e1
  Status: test
  Level: high
  Author: Max Altgelt (Nextron Systems)
  Date: 2021-12-09
  Description: Detects process creation events where the Image field lacks an absolute path, which occurs when the backing file no longer exists on disk at the time of logging - commonly caused by Process Ghosting or other unorthodox process creation techniques.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Execution Of Non-Existing File</description>
    <match>(NOT ((Image=\"*\\\\*\")) AND NOT (((((Image=\"MemCompression\" OR Image=\"Registry\" OR Image=\"System\" OR Image=\"vmmem\" OR Imag</match>
  </rule>
</group>
