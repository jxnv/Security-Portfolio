  Author: Sohan G (D4rkCiph3r)
  Date: 2023-02-18
  Description: Detects attempts to enable the guest account using the sysadminctl utility
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Guest Account Enabled Via Sysadminctl</description>
    <match>(Image=\"*/sysadminctl\" AND (CommandLine=\"* -guestAccount*\" AND CommandLine=\"* on*\"))</match>
  </rule>
</group>
