<!--
  Title: Overwriting the File with Dev Zero or Null
  ID: 37222991-11e9-4b6d-8bdf-60fbe48f753e
  Status: stable
  Level: low
  Author: Jakob Weinzettl, oscd.community
  Date: 2019-10-23
  Description: Detects overwriting (effectively wiping/deleting) of a file.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Overwriting the File with Dev Zero or Null</description>
    <match>(type=\"EXECVE\" AND a0=\"*dd*\" AND (a1=\"*if=/dev/null*\" OR a1=\"*if=/dev/zero*\"))</match>
  </rule>
</group>
