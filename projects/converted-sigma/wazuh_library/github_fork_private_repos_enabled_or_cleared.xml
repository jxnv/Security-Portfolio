<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Github Fork Private Repositories Setting Enabled/Cleared</description>
    <match>((action=\"private_repository_forking.clear\" OR action=\"private_repository_forking.enable\"))</match>
  </rule>
</group>
