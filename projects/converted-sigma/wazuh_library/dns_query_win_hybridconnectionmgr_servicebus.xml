<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>DNS HybridConnectionManager Service Bus</description>
    <match>(QueryName=\"*servicebus.windows.net*\" AND Image=\"*HybridConnectionManager*\")</match>
  </rule>
</group>
