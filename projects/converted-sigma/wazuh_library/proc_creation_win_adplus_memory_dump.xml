  Level: high
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-06-09
  Description: Detects execution of "AdPlus.exe", a binary that is part of the Windows SDK that can be used as a LOLBIN in order to dump process memory and execute arbitrary commands.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potential Adplus.EXE Abuse</description>
    <match>(((CommandLine=\"* -hang *\" OR CommandLine=\"* -pn *\" OR CommandLine=\"* -pmn *\" OR CommandLine=\"* -p *\" OR CommandLine=\"* </match>
  </rule>
</group>
