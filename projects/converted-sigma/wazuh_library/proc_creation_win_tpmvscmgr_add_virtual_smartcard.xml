<!--
  Title: New Virtual Smart Card Created Via TpmVscMgr.EXE
  ID: c633622e-cab9-4eaa-bb13-66a1d68b3e47
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2023-06-15
  Description: Detects execution of "Tpmvscmgr.exe" to create a new virtual smart card.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>New Virtual Smart Card Created Via TpmVscMgr.EXE</description>
    <match>((CommandLine=\"*create*\") AND (Image=\"*\\\\tpmvscmgr.exe\" AND OriginalFileName=\"TpmVscMgr.exe\"))</match>
  </rule>
</group>
