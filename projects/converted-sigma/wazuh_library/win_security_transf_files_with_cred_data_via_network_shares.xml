  Description: Transferring files with well-known filenames (sensitive files with credential data) using network shares
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Transferring Files with Credential Data via Network Shares</description>
    <match>((EventID=\"5145\") AND (((RelativeTargetName=\"*\\\\mimidrv*\" OR RelativeTargetName=\"*\\\\lsass*\" OR RelativeTargetName=\"*\\\\wi</match>
  </rule>
</group>
