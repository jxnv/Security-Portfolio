<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Remote DLL Load Via Rundll32.EXE</description>
    <match>(Image=\"*\\\\rundll32.exe\" AND ImageLoaded=\"\\\\\\\\\\\\\\\\*\")</match>
  </rule>
</group>
