<!--
  Title: Privileged User Has Been Created
  ID: 0ac15ec3-d24f-4246-aa2a-3077bb1cf90e
  Status: test
  Level: high
  Author: Pawel Mazur
  Date: 2022-12-21
  Description: Detects the addition of a new user to a privileged group such as "root" or "sudo"
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Privileged User Has Been Created</description>
    <match>((\"new user\") AND (\"GID=0,\" OR \"UID=0,\" OR \"GID=10,\" OR \"GID=27,\"))</match>
  </rule>
</group>
