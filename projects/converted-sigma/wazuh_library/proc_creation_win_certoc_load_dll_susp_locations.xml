<!--
  Title: Suspicious DLL Loaded via CertOC.EXE
  ID: 84232095-ecca-4015-b0d7-7726507ee793
  Status: test
  Level: high
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2023-02-15
  Description: Detects when a user installs certificates by using CertOC.exe to load the target DLL file.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious DLL Loaded via CertOC.EXE</description>
    <match>((CommandLine=\"* -LoadDLL *\") AND ((Image=\"*\\\\certoc.exe\") OR (OriginalFileName=\"CertOC.exe\")) AND ((CommandLine=\"*\\\\App</match>
  </rule>
</group>
