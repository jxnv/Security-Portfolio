<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>AWS Config Disabling Channel/Recorder</description>
    <match>(eventSource=\"config.amazonaws.com\" AND (eventName=\"DeleteDeliveryChannel\" OR eventName=\"StopConfigurationRecorder\"))</match>
  </rule>
</group>
