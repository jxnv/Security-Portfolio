<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>WMI ActiveScriptEventConsumers Activity Via Scrcons.EXE DLL Load</description>
    <match>(Image=\"*\\\\scrcons.exe\" AND (ImageLoaded=\"*\\\\vbscript.dll\" OR ImageLoaded=\"*\\\\wbemdisp.dll\" OR ImageLoaded=\"*\\\\wshom.ocx</match>
  </rule>
</group>
