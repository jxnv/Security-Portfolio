    <description>Invoke-Obfuscation Obfuscated IEX Invocation</description>
    <match>((CommandLine=regex(\"\\\\$PSHome\\\\[\\\\s*\\\\d{1,3}\\\\s*\\\\]\\\\s*\\\\+\\\\s*\\\\$PSHome\\\\[\")) OR (CommandLine=regex(\"\\\\$ShellId\\\\[\\\\s*\\</match>
  </rule>
</group>
