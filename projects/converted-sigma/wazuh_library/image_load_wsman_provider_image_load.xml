<!--
  Title: Suspicious WSMAN Provider Image Loads
  ID: ad1f4bb9-8dfb-4765-adb6-2a7cfb6c0f94
  Status: test
  Level: medium
  Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
  Date: 2020-06-24
  Description: Detects signs of potential use of the WSMAN provider from uncommon processes locally and remote execution.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious WSMAN Provider Image Loads</description>
    <match>(((((ImageLoaded=\"*\\\\WsmSvc.dll\" OR ImageLoaded=\"*\\\\WsmAuto.dll\" OR ImageLoaded=\"*\\\\Microsoft.WSMan.Management.ni.dll\"))</match>
  </rule>
</group>
