    <description>Potential Remote SquiblyTwo Technique Execution</description>
    <match>(((CommandLine=\"*/format:*\" OR CommandLine=\"*-format:*\") AND (CommandLine=\"*://*\" OR CommandLine=\"*\\\\\\\\\\\\\\\\*\")) AND ((Im</match>
  </rule>
</group>
