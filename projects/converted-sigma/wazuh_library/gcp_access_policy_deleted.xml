<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>GCP Access Policy Deleted</description>
    <match>((data.protoPayload.authorizationInfo.permission=\"accesscontextmanager.accessPolicies.delete\" OR data.protoPayload.autho</match>
  </rule>
</group>
