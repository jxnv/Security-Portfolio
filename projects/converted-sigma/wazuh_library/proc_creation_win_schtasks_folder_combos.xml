<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Schtasks From Suspicious Folders</description>
    <match>(((CommandLine=\"*C:\\\\ProgramData\\\\*\" OR CommandLine=\"*%ProgramData%*\")) AND ((CommandLine=\"*powershell*\" OR CommandLine=</match>
  </rule>
</group>
