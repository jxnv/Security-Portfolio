<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious Non PowerShell WSMAN COM Provider</description>
    <match>((Data=\"*ProviderName=WSMan*\") AND NOT (((Data=regex(\"HostId=[a-zA-Z0-9-]{36}\\\\s+EngineVersion=\")) OR ((Data=\"*HostAppli</match>
  </rule>
</group>
