<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Invoke-Obfuscation CLIP+ Launcher - PowerShell</description>
    <match>(ScriptBlockText=regex(\"cmd.{0,5}(?:/c|/r).+clip(?:\\\\.exe)?.{0,4}&&.+clipboard]::\\\\(\\\\s\\\\\\\\\\\"\\\\{\\\\d\\\\}.+-f.+\\\"\"))</match>
  </rule>
</group>
