<!--
  Title: Systemd Service Creation
  ID: 1bac86ba-41aa-4f62-9d6b-405eac99b485
  Status: test
  Level: medium
  Author: Pawel Mazur
  Date: 2022-02-03
  Description: Detects a creation of systemd services which could be used by adversaries to execute malicious code.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Systemd Service Creation</description>
    <match>((type=\"PATH\" AND nametype=\"CREATE\") AND (((name=\"/usr/lib/systemd/system/*\" OR name=\"/etc/systemd/system/*\")) OR (name=</match>
  </rule>
</group>
