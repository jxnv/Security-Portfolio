<!--
  Title: Unsigned Module Loaded by ClickOnce Application
  ID: 060d5ad4-3153-47bb-8382-43e5e29eda92
  Status: test
  Level: medium
  Author: @SerkinValery
  Date: 2023-06-08
  Description: Detects unsigned module load by ClickOnce application.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Unsigned Module Loaded by ClickOnce Application</description>
    <match>((Image=\"*\\\\AppData\\\\Local\\\\Apps\\\\2.0\\\\*\") AND ((Signed=\"false\") OR (SignatureStatus=\"Expired\")))</match>
  </rule>
</group>
