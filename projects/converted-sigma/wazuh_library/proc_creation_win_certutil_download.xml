<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious Download Via Certutil.EXE</description>
    <match>(((CommandLine=\"*urlcache *\" OR CommandLine=\"*verifyctl *\" OR CommandLine=\"*URL *\")) AND (CommandLine=\"*http*\") AND ((Im</match>
  </rule>
</group>
