<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Boot Configuration Tampering Via Bcdedit.EXE</description>
    <match>((((CommandLine=\"*bootstatuspolicy*\" AND CommandLine=\"*ignoreallfailures*\")) OR ((CommandLine=\"*recoveryenabled*\" AND Co</match>
  </rule>
</group>
