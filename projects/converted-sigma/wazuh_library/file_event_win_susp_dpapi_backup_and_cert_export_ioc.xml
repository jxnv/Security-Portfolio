  Description: Detects file names with specific patterns seen generated and used by tools such as Mimikatz and DSInternals related to exported or stolen DPAPI backup keys and certificates.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>DPAPI Backup Keys And Certificate Export Activity IOC</description>
    <match>((TargetFilename=\"*ntds_capi_*\" OR TargetFilename=\"*ntds_legacy_*\" OR TargetFilename=\"*ntds_unknown_*\") AND (TargetFilen</match>
  </rule>
</group>
