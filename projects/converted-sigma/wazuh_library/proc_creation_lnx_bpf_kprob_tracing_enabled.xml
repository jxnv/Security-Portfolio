<!--
  Title: Enable BPF Kprobes Tracing
  ID: 7692f583-bd30-4008-8615-75dab3f08a99
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2023-01-25
  Description: Detects common command used to enable bpf kprobes tracing
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Enable BPF Kprobes Tracing</description>
    <match>((CommandLine=\"*echo 1 >*\" AND CommandLine=\"*/sys/kernel/debug/tracing/events/kprobes/*\") AND (CommandLine=\"*/myprobe/en</match>
  </rule>
</group>
