<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious LDAP-Attributes Used</description>
    <match>(EventID=\"5136\" AND AttributeValue=\"***\" AND (AttributeLDAPDisplayName=\"primaryInternationalISDNNumber\" OR AttributeLDAP</match>
  </rule>
</group>
