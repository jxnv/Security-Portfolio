<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Windows Firewall Profile Disabled</description>
    <match>(((ScriptBlockText=\"*Set-NetFirewallProfile *\" AND ScriptBlockText=\"* -Enabled *\" AND ScriptBlockText=\"* False*\")) AND (</match>
  </rule>
</group>
