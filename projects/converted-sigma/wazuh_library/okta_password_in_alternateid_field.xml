<!--
  Title: Potential Okta Password in AlternateID Field
  ID: 91b76b84-8589-47aa-9605-c837583b82a9
  Status: test
  Level: high
  Author: kelnage
  Date: 2023-04-03
  Description: Detects when a user has potentially entered their password into the username field, which will cause the password to be retained in log files.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potential Okta Password in AlternateID Field</description>
    <match>((legacyEventType=\"core.user_auth.login_failed\") AND NOT ((actor.alternateId=regex(\"(^0oa.*|[a-zA-Z0-9._%+-]+@[a-zA-Z0-9</match>
  </rule>
</group>
