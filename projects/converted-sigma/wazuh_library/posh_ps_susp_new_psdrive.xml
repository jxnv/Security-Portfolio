<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious New-PSDrive to Admin Share</description>
    <match>((ScriptBlockText=\"*New-PSDrive*\" AND ScriptBlockText=\"*-psprovider *\" AND ScriptBlockText=\"*filesystem*\" AND ScriptBloc</match>
  </rule>
</group>
