<!--
  Title: Communication To LocaltoNet Tunneling Service Initiated
  ID: 3ab65069-d82a-4d44-a759-466661a082d1
  Status: test
  Level: high
  Author: Andreas Braathen (mnemonic.io)
  Date: 2024-06-17
  Description: Detects an executable initiating a network connection to "LocaltoNet" tunneling sub-domains. LocaltoNet is a reverse proxy that enables localhost services to be exposed to the Internet. Attackers have been seen to use this service for command-and-control activities to bypass MFA and perimeter controls.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Communication To LocaltoNet Tunneling Service Initiated</description>
    <match>((DestinationHostname=\"*.localto.net\" OR DestinationHostname=\"*.localtonet.com\") AND Initiated=\"true\")</match>
  </rule>
</group>
