  Description: Detects the creation of a new PowerShell module ".psm1", ".psd1", ".dll", ".ps1", etc.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>PowerShell Module File Created</description>
    <match>((Image=\"*\\\\powershell.exe\" OR Image=\"*\\\\pwsh.exe\") AND (TargetFilename=\"*\\\\WindowsPowerShell\\\\Modules\\\\*\" OR TargetFile</match>
  </rule>
</group>
