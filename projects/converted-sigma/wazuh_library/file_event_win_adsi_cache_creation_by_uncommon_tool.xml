<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>ADSI-Cache File Creation By Uncommon Tool</description>
    <match>((TargetFilename=\"*\\\\Local\\\\Microsoft\\\\Windows\\\\SchCache\\\\*\" AND TargetFilename=\"*.sch\") AND NOT (((((Image=\"*:\\\\Program</match>
  </rule>
</group>
