<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential Libvlc.DLL Sideloading</description>
    <match>((ImageLoaded=\"*\\\\libvlc.dll\") AND NOT (((ImageLoaded=\"C:\\\\Program Files (x86)\\\\VideoLAN\\\\VLC\\\\*\" OR ImageLoaded=\"C:\\\\Pr</match>
  </rule>
</group>
