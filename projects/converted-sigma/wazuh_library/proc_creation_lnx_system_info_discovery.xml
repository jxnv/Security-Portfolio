<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>System Information Discovery</description>
    <match>((Image=\"*/uname\" OR Image=\"*/hostname\" OR Image=\"*/uptime\" OR Image=\"*/lspci\" OR Image=\"*/dmidecode\" OR Image=\"*/lscpu\"</match>
  </rule>
</group>
