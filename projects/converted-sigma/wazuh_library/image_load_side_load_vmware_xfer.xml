<!--
  Title: Potential DLL Sideloading Via VMware Xfer
  ID: 9313dc13-d04c-46d8-af4a-a930cc55d93b
  Status: test
  Level: high
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-08-02
  Description: Detects loading of a DLL by the VMware Xfer utility from the non-default directory which may be an attempt to sideload arbitrary DLL
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potential DLL Sideloading Via VMware Xfer</description>
    <match>((Image=\"*\\\\VMwareXferlogs.exe\" AND ImageLoaded=\"*\\\\glib-2.0.dll\") AND NOT ((ImageLoaded=\"C:\\\\Program Files\\\\VMware\\\\*\")</match>
  </rule>
</group>
