<!--
  Title: Registry Entries For Azorult Malware
  ID: f7f9ab88-7557-4a69-b30e-0a8f91b3a0e7
  Status: test
  Level: critical
  Author: Trent Liffick
  Date: 2020-05-08
  Description: Detects the presence of a registry key created during Azorult execution
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Registry Entries For Azorult Malware</description>
    <match>((EventID=\"12\" OR EventID=\"13\") AND TargetObject=\"*SYSTEM\\\\*\" AND TargetObject=\"*\\\\services\\\\localNETService\")</match>
  </rule>
</group>
