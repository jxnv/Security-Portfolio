<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Shell32 DLL Execution in Suspicious Directory</description>
    <match>(((CommandLine=\"*shell32.dll*\" AND CommandLine=\"*Control_RunDLL*\") AND (CommandLine=\"*%AppData%*\" OR CommandLine=\"*%Loca</match>
  </rule>
</group>
