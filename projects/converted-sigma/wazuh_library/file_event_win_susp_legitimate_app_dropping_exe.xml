  Description: Detects LOLBINs and applications that should not legitimately drop executable or executable-equivalent files to disk. This may indicate malware staging, process injection, or abuse of a trusted binary for payload delivery.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Legitimate Application Dropped Executable</description>
    <match>((Image=\"*\\\\eqnedt32.exe\" OR Image=\"*\\\\wordpad.exe\" OR Image=\"*\\\\wordview.exe\" OR Image=\"*\\\\certutil.exe\" OR Image=\"*\\\\c</match>
  </rule>
</group>
