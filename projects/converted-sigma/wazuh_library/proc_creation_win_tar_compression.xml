<!--
  Title: Compressed File Creation Via Tar.EXE
  ID: 418a3163-3247-4b7b-9933-dcfcb7c52ea9
  Status: test
  Level: low
  Author: Nasreddine Bencherchali (Nextron Systems), AdmU3
  Date: 2023-12-19
  Description: Detects execution of "tar.exe" in order to create a compressed file. Adversaries may abuse various utilities to compress or encrypt data before exfiltration.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Compressed File Creation Via Tar.EXE</description>
    <match>(((CommandLine=\"*-c*\" OR CommandLine=\"*-r*\" OR CommandLine=\"*-u*\")) AND ((Image=\"*\\\\tar.exe\") OR (OriginalFileName=\"bsdt</match>
  </rule>
</group>
