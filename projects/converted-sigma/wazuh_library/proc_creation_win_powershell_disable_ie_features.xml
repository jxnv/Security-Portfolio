<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Disabled IE Security Features</description>
    <match>(((CommandLine=\"* -name IEHarden *\" AND CommandLine=\"* -value 0 *\")) OR ((CommandLine=\"* -name DEPOff *\" AND CommandLine</match>
  </rule>
</group>
