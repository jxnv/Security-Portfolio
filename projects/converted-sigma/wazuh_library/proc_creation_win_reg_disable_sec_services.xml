<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Security Service Disabled Via Reg.EXE</description>
    <match>(((CommandLine=\"*d 4*\" AND CommandLine=\"*v Start*\") AND (CommandLine=\"*\\\\AppIDSvc*\" OR CommandLine=\"*\\\\MsMpSvc*\" OR Comm</match>
  </rule>
</group>
