<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Console CodePage Lookup Via CHCP</description>
    <match>(ParentImage=\"*\\\\cmd.exe\" AND (ParentCommandLine=\"* -c *\" OR ParentCommandLine=\"* -r *\" OR ParentCommandLine=\"* -k *\") A</match>
  </rule>
</group>
