<!--
  Title: Cisco Denial of Service
  ID: d94a35f0-7a29-45f6-90a0-80df6159967c
  Status: test
  Level: medium
  Author: Austin Clark
  Date: 2019-08-15
  Description: Detect a system being shutdown or put into different boot mode
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Cisco Denial of Service</description>
    <match>(\"shutdown\" OR \"config-register 0x2100\" OR \"config-register 0x2142\")</match>
  </rule>
</group>
