<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Disable of ETW Trace - Powershell</description>
    <match>((ScriptBlockText=\"*Remove-EtwTraceProvider *\") OR ((ScriptBlockText=\"*Set-EtwTraceProvider *\" AND ScriptBlockText=\"*0x1</match>
  </rule>
</group>
