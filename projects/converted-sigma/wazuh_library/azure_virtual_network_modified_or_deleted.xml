  Description: Identifies when a Virtual Network is modified or deleted in Azure.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Azure Virtual Network Modified or Deleted</description>
    <match>((operationName=\"MICROSOFT.NETWORK/VIRTUALNETWORKGATEWAYS/*\" OR operationName=\"MICROSOFT.NETWORK/VIRTUALNETWORKS/*\") AND</match>
  </rule>
</group>
