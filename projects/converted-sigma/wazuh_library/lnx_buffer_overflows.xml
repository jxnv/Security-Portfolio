<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Buffer Overflow Attempts</description>
    <match>(\"attempt to execute code on stack by\" OR \"0bin0sh1\" OR \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA</match>
  </rule>
</group>
