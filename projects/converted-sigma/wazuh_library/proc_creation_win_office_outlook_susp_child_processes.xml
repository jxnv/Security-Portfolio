<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Outlook Child Process</description>
    <match>(ParentImage=\"*\\\\OUTLOOK.EXE\" AND (Image=\"*\\\\AppVLP.exe\" OR Image=\"*\\\\bash.exe\" OR Image=\"*\\\\cmd.exe\" OR Image=\"*\\\\cscri</match>
  </rule>
</group>
