<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potentially Suspicious GoogleUpdate Child Process</description>
    <match>((ParentImage=\"*\\\\GoogleUpdate.exe\") AND NOT (((NOT Image=*) OR ((Image=\"*\\\\Google*\") OR ((Image=\"*\\\\setup.exe\" OR Image</match>
  </rule>
</group>
