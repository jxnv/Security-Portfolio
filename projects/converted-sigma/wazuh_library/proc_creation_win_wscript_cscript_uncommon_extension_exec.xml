  Description: Detects Wscript/Cscript executing a file with an uncommon (i.e. non-script) extension
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Cscript/Wscript Uncommon Script Extension Execution</description>
    <match>(((CommandLine=\"*.csv*\" OR CommandLine=\"*.dat*\" OR CommandLine=\"*.doc*\" OR CommandLine=\"*.gif*\" OR CommandLine=\"*.jpeg*\"</match>
  </rule>
</group>
