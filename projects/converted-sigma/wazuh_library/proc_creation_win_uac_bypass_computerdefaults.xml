<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>UAC Bypass Tools Using ComputerDefaults</description>
    <match>(((IntegrityLevel=\"High\" OR IntegrityLevel=\"System\" OR IntegrityLevel=\"S-1-16-16384\" OR IntegrityLevel=\"S-1-16-12288\") A</match>
  </rule>
</group>
