<!--
  Title: Import PowerShell Modules From Suspicious Directories
  ID: 21f9162c-5f5d-4b01-89a8-b705bd7d10ab
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-07-07
  Description: Detects powershell scripts that import modules from suspicious directories
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Import PowerShell Modules From Suspicious Directories</description>
    <match>((ScriptBlockText=\"*Import-Module \\\"$Env:Temp\\\\*\" OR ScriptBlockText=\"*Import-Module '$Env:Temp\\\\*\" OR ScriptBlockText=\"</match>
  </rule>
</group>
