<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>F5 BIG-IP iControl Rest API Command Execution - Webserver</description>
    <match>(cs-method=\"POST\" AND cs-uri-query=\"*/mgmt/tm/util/bash\")</match>
  </rule>
</group>
