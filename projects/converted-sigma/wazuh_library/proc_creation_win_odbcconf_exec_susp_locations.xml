  Description: Detects execution of "odbcconf" where the path of the DLL being registered is located in a potentially suspicious location.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Odbcconf.EXE Suspicious DLL Location</description>
    <match>(((CommandLine=\"*:\\\\PerfLogs\\\\*\" OR CommandLine=\"*:\\\\ProgramData\\\\*\" OR CommandLine=\"*:\\\\Temp\\\\*\" OR CommandLine=\"*:\\\\Us</match>
  </rule>
</group>
