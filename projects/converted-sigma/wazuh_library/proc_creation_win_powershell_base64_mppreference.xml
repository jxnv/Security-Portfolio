<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Powershell Base64 Encoded MpPreference Cmdlet</description>
    <match>(((CommandLine=\"*QWRkLU1wUHJlZmVyZW5jZS*\" OR CommandLine=\"*FkZC1NcFByZWZlcmVuY2Ug*\" OR CommandLine=\"*BZGQtTXBQcmVmZXJlbm</match>
  </rule>
</group>
