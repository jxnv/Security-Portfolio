<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>VMGuestLib DLL Sideload</description>
    <match>(((ImageLoaded=\"*\\\\VMware\\\\VMware Tools\\\\vmStatsProvider\\\\win32*\" AND ImageLoaded=\"*\\\\vmGuestLib.dll*\") AND Image=\"*\\\\Wi</match>
  </rule>
</group>
