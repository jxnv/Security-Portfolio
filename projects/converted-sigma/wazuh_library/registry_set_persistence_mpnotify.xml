    <description>Potential Persistence Via Mpnotify</description>
    <match>(TargetObject=\"*\\\\SOFTWARE\\\\Microsoft\\\\Windows NT\\\\CurrentVersion\\\\Winlogon\\\\mpnotify*\")</match>
  </rule>
</group>
