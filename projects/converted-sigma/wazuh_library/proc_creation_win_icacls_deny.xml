<!--
  Title: Use Icacls to Hide File to Everyone
  ID: 4ae81040-fc1c-4249-bfa3-938d260214d9
  Status: test
  Level: medium
  Author: frack113
  Date: 2022-07-18
  Description: Detect use of icacls to deny access for everyone in Users folder sometimes used to hide malicious files
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Use Icacls to Hide File to Everyone</description>
    <match>(((CommandLine=\"*/deny*\" AND CommandLine=\"**S-1-1-0:*\")) AND ((OriginalFileName=\"iCACLS.EXE\") OR (Image=\"*\\\\icacls.exe\")</match>
  </rule>
</group>
