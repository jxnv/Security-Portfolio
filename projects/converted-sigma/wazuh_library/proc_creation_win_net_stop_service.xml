-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Stop Windows Service Via Net.EXE</description>
    <match>((CommandLine=\"* stop *\") AND (((OriginalFileName=\"net.exe\" OR OriginalFileName=\"net1.exe\")) OR ((Image=\"*\\\\net.exe\" OR </match>
  </rule>
</group>
