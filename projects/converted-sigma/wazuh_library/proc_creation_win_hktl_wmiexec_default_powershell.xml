<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>HackTool - Wmiexec Default Powershell Command</description>
    <match>(CommandLine=\"*-NoP -NoL -sta -NonI -W Hidden -Exec Bypass -Enc*\")</match>
  </rule>
</group>
