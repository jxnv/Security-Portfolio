  ID: 2625cc59-0634-40d0-821e-cb67382a3dd7
  Status: test
  Level: low
  Author: Jakob Weinzettl, oscd.community, CheraghiMilad
  Date: 2019-09-23
  Description: Detects the start, reload or restart of a service.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Service Reload or Start - Linux</description>
    <match>(type=\"EXECVE\" AND (a0=\"*systemctl*\" OR a0=\"*service*\") AND (a1=\"*reload*\" OR a1=\"*start*\"))</match>
  </rule>
</group>
