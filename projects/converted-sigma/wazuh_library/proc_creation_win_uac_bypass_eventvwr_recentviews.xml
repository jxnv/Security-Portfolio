<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>UAC Bypass Using Event Viewer RecentViews</description>
    <match>(((CommandLine=\"*\\\\Event Viewer\\\\RecentViews*\" OR CommandLine=\"*\\\\EventV~1\\\\RecentViews*\")) AND (CommandLine=\"*>*\"))</match>
  </rule>
</group>
