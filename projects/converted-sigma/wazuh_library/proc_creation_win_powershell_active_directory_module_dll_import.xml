<!--
  Title: Potential Active Directory Enumeration Using AD Module - ProcCreation
  ID: 70bc5215-526f-4477-963c-a47a5c9ebd12
  Status: test
  Level: medium
  Author: frack113
  Date: 2023-01-22
  Description: Detects usage of the "Import-Module" cmdlet to load the "Microsoft.ActiveDirectory.Management.dl" DLL. Which is often used by attackers to perform AD enumeration.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential Active Directory Enumeration Using AD Module - ProcCreation</description>
    <match>(((CommandLine=\"*Import-Module *\" OR CommandLine=\"*ipmo *\")) AND (CommandLine=\"*Microsoft.ActiveDirectory.Management.dll</match>
  </rule>
</group>
