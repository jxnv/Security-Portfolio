<!--
  Title: Potential Malicious Usage of CloudTrail System Manager
  ID: 38e7f511-3f74-41d4-836e-f57dfa18eead
  Status: test
  Level: high
  Author: jamesc-grafana
  Date: 2024-07-11
  Description: Detect when System Manager successfully executes commands against an instance.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potential Malicious Usage of CloudTrail System Manager</description>
    <match>((eventName=\"SendCommand\" AND eventSource=\"ssm.amazonaws.com\") AND ((NOT errorCode=*) OR (errorCode=\"Success\")))</match>
  </rule>
</group>
