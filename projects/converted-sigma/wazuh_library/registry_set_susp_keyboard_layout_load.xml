<!--
  Title: Suspicious Keyboard Layout Load
  ID: 34aa0252-6039-40ff-951f-939fd6ce47d8
  Status: test
  Level: medium
  Author: Florian Roth (Nextron Systems)
  Date: 2019-10-12
  Description: Detects the keyboard preload installation with a suspicious keyboard layout, e.g. Chinese, Iranian or Vietnamese layout load in user session on systems maintained by US staff only
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious Keyboard Layout Load</description>
    <match>((TargetObject=\"*\\\\Keyboard Layout\\\\Preload\\\\*\" OR TargetObject=\"*\\\\Keyboard Layout\\\\Substitutes\\\\*\") AND (Details=\"*000</match>
  </rule>
</group>
