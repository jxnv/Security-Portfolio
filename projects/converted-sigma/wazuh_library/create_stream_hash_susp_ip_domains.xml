<!--
  Title: Unusual File Download from Direct IP Address
  ID: 025bd229-fd1f-4fdb-97ab-20006e1a5368
  Status: test
  Level: high
  Author: Nasreddine Bencherchali (Nextron Systems), Florian Roth (Nextron Systems)
  Date: 2022-09-07
  Description: Detects the download of suspicious file type from URLs with IP
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Unusual File Download from Direct IP Address</description>
    <match>(Contents=regex(\"http[s]?://[0-9]{1,3}\\\\.[0-9]{1,3}\\\\.[0-9]{1,3}\\\\.[0-9]{1,3}\") AND (TargetFilename=\"*.ps1:Zone*\" OR Tar</match>
  </rule>
</group>
