<!--
  Title: Driver/DLL Installation Via Odbcconf.EXE
  ID: 3f5491e2-8db8-496b-9e95-1029fce852d4
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2023-05-22
  Description: Detects execution of "odbcconf" with "INSTALLDRIVER" which installs a new ODBC driver. Attackers abuse this to install and run malicious DLLs.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Driver/DLL Installation Via Odbcconf.EXE</description>
    <match>(((CommandLine=\"*INSTALLDRIVER *\" AND CommandLine=\"*.dll*\")) AND ((Image=\"*\\\\odbcconf.exe\") OR (OriginalFileName=\"odbcco</match>
  </rule>
</group>
