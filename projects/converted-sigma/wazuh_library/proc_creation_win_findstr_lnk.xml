<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Findstr Launching .lnk File</description>
    <match>(((CommandLine=\"*.lnk\" OR CommandLine=\"*.lnk\\\"\" OR CommandLine=\"*.lnk'\")) AND (((Image=\"*\\\\find.exe\" OR Image=\"*\\\\findst</match>
  </rule>
</group>
