<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Use of Legacy Authentication Protocols</description>
    <match>(ActivityDetails=\"Sign-ins\" AND (ClientApp=\"Other client\" OR ClientApp=\"IMAP\" OR ClientApp=\"POP3\" OR ClientApp=\"MAPI\" OR</match>
  </rule>
</group>
