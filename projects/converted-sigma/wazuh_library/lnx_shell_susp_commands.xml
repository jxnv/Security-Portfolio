<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Activity in Shell Commands</description>
    <match>(\"wget * - http* | perl\" OR \"wget * - http* | sh\" OR \"wget * - http* | bash\" OR \"python -m SimpleHTTPServer\" OR \"-m http</match>
  </rule>
</group>
