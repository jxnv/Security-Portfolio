  Description: Detects the use of "Ilasm.EXE" in order to compile C# intermediate (IL) code to EXE or DLL.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>C# IL Code Compilation Via Ilasm.EXE</description>
    <match>(((CommandLine=\"* /dll*\" OR CommandLine=\"* /exe*\")) AND ((Image=\"*\\\\ilasm.exe\") OR (OriginalFileName=\"ilasm.exe\")))</match>
  </rule>
</group>
