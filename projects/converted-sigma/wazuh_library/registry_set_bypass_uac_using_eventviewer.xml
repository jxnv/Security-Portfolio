<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Bypass UAC Using Event Viewer</description>
    <match>((TargetObject=\"*_Classes\\\\mscfile\\\\shell\\\\open\\\\command\\\\(Default)\") AND NOT ((Details=\"%SystemRoot%\\\\system32\\\\mmc.exe</match>
  </rule>
</group>
