<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Use of OpenConsole</description>
    <match>(((OriginalFileName=\"OpenConsole.exe\") OR (Image=\"*\\\\OpenConsole.exe\")) AND NOT ((Image=\"C:\\\\Program Files\\\\WindowsApps\\</match>
  </rule>
</group>
