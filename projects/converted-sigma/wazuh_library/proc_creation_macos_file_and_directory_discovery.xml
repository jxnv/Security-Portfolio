<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>File and Directory Discovery - MacOS</description>
    <match>((Image=\"/usr/bin/file\" AND CommandLine=regex(\"(.){200,}\")) OR (Image=\"/usr/bin/find\") OR (Image=\"/usr/bin/mdfind\") OR (</match>
  </rule>
</group>
