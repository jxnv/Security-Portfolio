<!--
  Title: Credential Dumping Attempt Via Svchost
  ID: 174afcfa-6e40-4ae9-af64-496546389294
  Status: test
  Level: high
  Author: Florent Labouyrie
  Date: 2021-04-30
  Description: Detects when a process tries to access the memory of svchost to potentially dump credentials.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Credential Dumping Attempt Via Svchost</description>
    <match>((TargetImage=\"*\\\\svchost.exe\" AND GrantedAccess=\"0x143a\") AND NOT (((SourceImage=\"*\\\\services.exe\" OR SourceImage=\"*\\\\m</match>
  </rule>
</group>
