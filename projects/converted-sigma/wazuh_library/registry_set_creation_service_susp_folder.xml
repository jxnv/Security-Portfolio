<!--
  Title: Service Binary in Suspicious Folder
  ID: a07f0359-4c90-4dc4-a681-8ffea40b4f47
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems), frack113
  Date: 2022-05-02
  Description: Detect the creation of a service with a service binary located in a suspicious directory
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Service Binary in Suspicious Folder</description>
    <match>(((TargetObject=\"HKLM\\\\System\\\\CurrentControlSet\\\\Services\\\\*\" AND TargetObject=\"*\\\\ImagePath\" AND (Details=\"*\\\\Users\\\\P</match>
  </rule>
</group>
