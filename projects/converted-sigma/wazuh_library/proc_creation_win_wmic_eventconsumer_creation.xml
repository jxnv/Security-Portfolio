<!--
  Title: NewActiveScriptEventConsumer Creation Attempt via Wmic.EXE
  ID: ebef4391-1a81-4761-a40a-1db446c0e625
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems)
  Date: 2021-06-25
  Description: Detects the attempt to create an ActiveScriptEventConsumer via WMIC.EXE. An ActiveScriptEventConsumer is a built-in Windows Management Instrumentation (WMI) class that automatically executes a predefined script (in VBScript or JScript) whenever a specific system event occurs. Adversaries often abuse ActiveScriptEventConsumer to maintain persistence on a compromised host by executing a malicious script whenever a specific event occurs.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>NewActiveScriptEventConsumer Creation Attempt via Wmic.EXE</description>
    <match>(((CommandLine=\"*ActiveScriptEventConsumer*\" AND CommandLine=\"* CREATE *\")) AND ((OriginalFileName=\"wmic.exe\") OR (Image</match>
  </rule>
</group>
