<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Sliver C2 Default Service Installation</description>
    <match>((Provider_Name=\"Service Control Manager\" AND EventID=\"7045\") AND ((ImagePath=regex(\"^[a-zA-Z]:\\\\\\\\windows\\\\\\\\temp\\\\\\\\[a</match>
  </rule>
</group>
