<!--
  Title: Kubernetes Secrets Modified or Deleted
  ID: 58d31a75-a4f8-4c40-985b-373d58162ca2
  Status: test
  Level: medium
  Author: kelnage
  Date: 2024-07-11
  Description: Detects when Kubernetes Secrets are Modified or Deleted.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Kubernetes Secrets Modified or Deleted</description>
    <match>(objectRef.resource=\"secrets\" AND (verb=\"create\" OR verb=\"delete\" OR verb=\"patch\" OR verb=\"replace\" OR verb=\"update\"))</match>
  </rule>
</group>
