  ID: ae2bdd58-0681-48ac-be7f-58ab4e593458
  Status: test
  Level: high
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-08-05
  Description: Detects attempts to remove Windows Defender configuration using the 'MpPreference' cmdlet
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Tamper Windows Defender Remove-MpPreference - ScriptBlockLogging</description>
    <match>((ScriptBlockText=\"*Remove-MpPreference*\") AND ((ScriptBlockText=\"*-ControlledFolderAccessProtectedFolders *\" OR ScriptB</match>
  </rule>
</group>
