<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Common Autorun Keys Modification</description>
    <match>(((TargetObject=\"*\\\\SOFTWARE\\\\Wow6432Node\\\\Microsoft\\\\Windows CE Services\\\\AutoStart*\" OR TargetObject=\"*\\\\Software\\\\Wow</match>
  </rule>
</group>
