<!--
  Title: PowerShell Script Change Permission Via Set-Acl
  ID: bdeb2cff-af74-4094-8426-724dc937f20a
  Status: test
  Level: high
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-10-18
  Description: Detects PowerShell execution to set the ACL of a file or a folder
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>PowerShell Script Change Permission Via Set-Acl</description>
    <match>(((CommandLine=\"*Set-Acl *\" AND CommandLine=\"*-AclObject *\" AND CommandLine=\"*-Path *\")) AND (((OriginalFileName=\"PowerS</match>
  </rule>
</group>
