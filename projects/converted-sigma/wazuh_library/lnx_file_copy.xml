<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Remote File Copy</description>
    <match>((\"scp \" OR \"rsync \" OR \"sftp \") AND (\"@\" OR \":\"))</match>
  </rule>
</group>
