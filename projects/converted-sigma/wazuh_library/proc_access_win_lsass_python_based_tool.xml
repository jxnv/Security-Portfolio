<!--
  Title: Credential Dumping Activity By Python Based Tool
  ID: f8be3e82-46a3-4e4e-ada5-8e538ae8b9c9
  Status: stable
  Level: high
  Author: Bhabesh Raj, Jonhnathan Ribeiro
  Date: 2023-11-27
  Description: Detects LSASS process access for potential credential dumping by a Python-like tool such as LaZagne or Pypykatz.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Credential Dumping Activity By Python Based Tool</description>
    <match>(TargetImage=\"*\\\\lsass.exe\" AND (CallTrace=\"*_ctypes.pyd+*\" AND CallTrace=\"*:\\\\Windows\\\\System32\\\\KERNELBASE.dll+*\" AND </match>
  </rule>
</group>
