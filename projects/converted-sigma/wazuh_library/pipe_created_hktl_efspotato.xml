  Description: Detects the pattern of a pipe name as used by the hack tool EfsPotato
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>HackTool - EfsPotato Named Pipe Creation</description>
    <match>(((PipeName=\"*\\\\pipe\\\\*\" OR PipeName=\"*\\\\pipe\\\\srvsvc*\")) AND NOT (((PipeName=\"*\\\\CtxShare*\") OR (PipeName=\"\\\\pipe\\\\*\"))</match>
  </rule>
</group>
