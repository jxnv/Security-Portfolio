  Date: 2019-10-25
  Description: Detects modification of autostart extensibility point (ASEP) in registry.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>System Scripts Autorun Keys Modification</description>
    <match>((TargetObject=\"*\\\\Software\\\\Policies\\\\Microsoft\\\\Windows\\\\System\\\\Scripts*\") AND ((TargetObject=\"*\\\\Startup*\" OR Target</match>
  </rule>
</group>
