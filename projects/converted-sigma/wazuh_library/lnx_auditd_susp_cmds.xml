    <description>Suspicious Commands Linux</description>
    <match>((type=\"EXECVE\" AND a0=\"chmod\" AND a1=\"777\") OR (type=\"EXECVE\" AND a0=\"chmod\" AND a1=\"u+s\") OR (type=\"EXECVE\" AND a0=\"cp</match>
  </rule>
</group>
