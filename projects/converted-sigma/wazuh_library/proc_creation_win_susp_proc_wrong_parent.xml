<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Windows Processes Suspicious Parent Directory</description>
    <match>(((Image=\"*\\\\svchost.exe\" OR Image=\"*\\\\taskhost.exe\" OR Image=\"*\\\\lsm.exe\" OR Image=\"*\\\\lsass.exe\" OR Image=\"*\\\\services</match>
  </rule>
</group>
