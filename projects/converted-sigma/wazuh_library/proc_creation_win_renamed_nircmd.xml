<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Renamed NirCmd.EXE Execution</description>
    <match>((OriginalFileName=\"NirCmd.exe\") AND NOT (((Image=\"*\\\\nircmd.exe\" OR Image=\"*\\\\nircmdc.exe\"))))</match>
  </rule>
</group>
