<!--
  Title: Potentially Suspicious Child Process Of ClickOnce Application
  ID: 67bc0e75-c0a9-4cfc-8754-84a505b63c04
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2023-06-12
  Description: Detects potentially suspicious child processes of a ClickOnce deployment application
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potentially Suspicious Child Process Of ClickOnce Application</description>
    <match>(ParentImage=\"*\\\\AppData\\\\Local\\\\Apps\\\\2.0\\\\*\" AND (Image=\"*\\\\calc.exe\" OR Image=\"*\\\\cmd.exe\" OR Image=\"*\\\\cscript.exe\" </match>
  </rule>
</group>
