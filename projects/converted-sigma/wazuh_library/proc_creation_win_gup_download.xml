<!--
  Title: File Download Using Notepad++ GUP Utility
  ID: 44143844-0631-49ab-97a0-96387d6b2d7c
  Status: test
  Level: high
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-06-10
  Description: Detects execution of the Notepad++ updater (gup) from a process other than Notepad++ to download files.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>File Download Using Notepad++ GUP Utility</description>
    <match>((((CommandLine=\"* -unzipTo *\" AND CommandLine=\"*http*\")) AND ((Image=\"*\\\\GUP.exe\") OR (OriginalFileName=\"gup.exe\"))) AN</match>
  </rule>
</group>
