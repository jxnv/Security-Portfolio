<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>System Shutdown/Reboot - MacOs</description>
    <match>((Image=\"*/shutdown\" OR Image=\"*/reboot\" OR Image=\"*/halt\"))</match>
  </rule>
</group>
