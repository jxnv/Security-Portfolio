  Description: Detects registry modifications that change features of internal Windows tools (malware like Agent Tesla uses this technique)
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Disable Internal Tools or Feature in Registry</description>
    <match>(((TargetObject=\"*SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Policies\\\\System\\\\ConsentPromptBehaviorAdmin\" OR TargetO</match>
  </rule>
</group>
