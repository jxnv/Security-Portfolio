<!--
  Title: AWS STS AssumeRole Misuse
  ID: 905d389b-b853-46d0-9d3d-dea0d3a3cd49
  Status: test
  Level: low
  Author: Austin Songer @austinsonger
  Date: 2021-07-24
  Description: Identifies the suspicious use of AssumeRole. Attackers could move laterally and escalate privileges.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>AWS STS AssumeRole Misuse</description>
    <match>(userIdentity.type=\"AssumedRole\" AND userIdentity.sessionContext.sessionIssuer.type=\"Role\")</match>
  </rule>
</group>
