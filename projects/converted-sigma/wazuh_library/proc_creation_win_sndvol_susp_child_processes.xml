<!--
  Title: Uncommon Child Processes Of SndVol.exe
  ID: ba42babc-0666-4393-a4f7-ceaf5a69191e
  Status: test
  Level: medium
  Author: X__Junior (Nextron Systems)
  Date: 2023-06-09
  Description: Detects potentially uncommon child processes of SndVol.exe (the Windows volume mixer)
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Uncommon Child Processes Of SndVol.exe</description>
    <match>((ParentImage=\"*\\\\SndVol.exe\") AND NOT ((Image=\"*\\\\rundll32.exe\" AND CommandLine=\"* shell32.dll,Control_RunDLL *\")))</match>
  </rule>
</group>
