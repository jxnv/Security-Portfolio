<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>DD File Overwrite</description>
    <match>(((Image=\"/bin/dd\" OR Image=\"/usr/bin/dd\")) AND (CommandLine=\"*of=*\") AND ((CommandLine=\"*if=/dev/zero*\" OR CommandLine=</match>
  </rule>
</group>
