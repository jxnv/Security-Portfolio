<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Disable Windows Firewall by Registry</description>
    <match>((TargetObject=\"*\\\\SOFTWARE\\\\Policies\\\\Microsoft\\\\WindowsFirewall\\\\StandardProfile\\\\EnableFirewall\" OR TargetObject=\"*\\\\</match>
  </rule>
</group>
