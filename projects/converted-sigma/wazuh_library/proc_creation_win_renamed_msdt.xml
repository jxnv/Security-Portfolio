<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Renamed Msdt.EXE Execution</description>
    <match>((OriginalFileName=\"msdt.exe\") AND NOT ((Image=\"*\\\\msdt.exe\")))</match>
  </rule>
</group>
