<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Using SettingSyncHost.exe as LOLBin</description>
    <match>(NOT (((Image=\"C:\\\\Windows\\\\System32\\\\*\" OR Image=\"C:\\\\Windows\\\\SysWOW64\\\\*\"))) AND ((ParentCommandLine=\"*cmd.exe /c*\" A</match>
  </rule>
</group>
