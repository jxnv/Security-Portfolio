<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Insecure Transfer Via Curl.EXE</description>
    <match>(((CommandLine=regex(\"\\\\s-k\\\\s\")) OR (CommandLine=\"*--insecure*\")) AND ((Image=\"*\\\\curl.exe\") OR (OriginalFileName=\"curl</match>
  </rule>
</group>
