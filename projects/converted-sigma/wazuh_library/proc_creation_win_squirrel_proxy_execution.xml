<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Process Proxy Execution Via Squirrel.EXE</description>
    <match>((((CommandLine=\"*--processStart*\" OR CommandLine=\"*--processStartAndWait*\" OR CommandLine=\"*--createShortcut*\")) AND ((</match>
  </rule>
</group>
