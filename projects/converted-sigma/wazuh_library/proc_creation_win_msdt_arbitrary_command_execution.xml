    <description>Potential Arbitrary Command Execution Using Msdt.EXE</description>
    <match>(((Image=\"*\\\\msdt.exe\") OR (OriginalFileName=\"msdt.exe\")) AND ((CommandLine=\"*IT_BrowseForFile=*\") OR ((CommandLine=\"* P</match>
  </rule>
</group>
