<!--
  Title: Change PowerShell Policies to an Insecure Level - PowerShell
  ID: 61d0475c-173f-4844-86f7-f3eebae1c66b
  Status: test
  Level: medium
  Author: frack113
  Date: 2021-10-20
  Description: Detects changing the PowerShell script execution policy to a potentially insecure level using the "Set-ExecutionPolicy" cmdlet.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Change PowerShell Policies to an Insecure Level - PowerShell</description>
    <match>(((ScriptBlockText=\"*Set-ExecutionPolicy*\") AND ((ScriptBlockText=\"*Unrestricted*\" OR ScriptBlockText=\"*bypass*\"))) AND </match>
  </rule>
</group>
