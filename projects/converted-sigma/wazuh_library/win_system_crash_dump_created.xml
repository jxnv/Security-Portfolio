<!--
  Title: Crash Dump Created By Operating System
  ID: 882fbe50-d8d7-4e29-ae80-0648a8556866
  Status: experimental
  Level: medium
  Author: Jason Mull
  Date: 2025-05-12
  Description: Detects "BugCheck" errors indicating the system rebooted due to a crash, capturing the bugcheck code, dump file path, and report ID.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Crash Dump Created By Operating System</description>
    <match>(Provider_Name=\"Microsoft-Windows-WER-SystemErrorReporting\" AND EventID=\"1001\")</match>
  </rule>
</group>
