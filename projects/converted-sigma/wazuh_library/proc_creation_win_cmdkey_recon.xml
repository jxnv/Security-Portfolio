<!--
  Title: Potential Reconnaissance For Cached Credentials Via Cmdkey.EXE
  ID: 07f8bdc2-c9b3-472a-9817-5a670b872f53
  Status: test
  Level: high
  Author: jmallette, Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
  Date: 2019-01-16
  Description: Detects usage of cmdkey to look for cached credentials on the system
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potential Reconnaissance For Cached Credentials Via Cmdkey.EXE</description>
    <match>((CommandLine=\"* -l*\") AND ((Image=\"*\\\\cmdkey.exe\") OR (OriginalFileName=\"cmdkey.exe\")))</match>
  </rule>
</group>
