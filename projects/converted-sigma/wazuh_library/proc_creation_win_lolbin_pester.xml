<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Execute Code with Pester.bat as Parent</description>
    <match>(((ParentCommandLine=\"*{ Invoke-Pester -EnableExit ;*\" OR ParentCommandLine=\"*{ Get-Help \\\"*\")) AND ((ParentImage=\"*\\\\po</match>
  </rule>
</group>
