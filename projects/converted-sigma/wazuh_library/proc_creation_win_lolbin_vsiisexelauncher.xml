<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Use of VSIISExeLauncher.exe</description>
    <match>(((CommandLine=\"* -p *\" OR CommandLine=\"* -a *\")) AND ((Image=\"*\\\\VSIISExeLauncher.exe\") OR (OriginalFileName=\"VSIISExeL</match>
  </rule>
</group>
