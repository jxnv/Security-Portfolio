<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>DLL Loaded From Suspicious Location Via Cmspt.EXE</description>
    <match>(Image=\"*\\\\cmstp.exe\" AND (ImageLoaded=\"*\\\\PerfLogs\\\\*\" OR ImageLoaded=\"*\\\\ProgramData\\\\*\" OR ImageLoaded=\"*\\\\Users\\\\*\" </match>
  </rule>
</group>
