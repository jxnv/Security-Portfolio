  Date: 2020-05-23
  Description: Detects usage of the netsh command to open and allow connections to port 3389 (RDP). As seen used by Sarwent Malware
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>RDP Connection Allowed Via Netsh.EXE</description>
    <match>(((CommandLine=\"*firewall *\" AND CommandLine=\"*add *\" AND CommandLine=\"*tcp *\" AND CommandLine=\"*3389*\") AND (CommandLin</match>
  </rule>
</group>
