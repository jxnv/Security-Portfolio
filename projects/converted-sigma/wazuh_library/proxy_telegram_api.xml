<!--
  Title: Telegram API Access
  ID: b494b165-6634-483d-8c47-2026a6c52372
  Status: test
  Level: medium
  Author: Florian Roth (Nextron Systems)
  Date: 2018-06-05
  Description: Detects suspicious requests to Telegram API without the usual Telegram User-Agent
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Telegram API Access</description>
    <match>((cs-host=\"api.telegram.org\") AND NOT (((c-useragent=\"*Telegram*\" OR c-useragent=\"*Bot*\"))))</match>
  </rule>
</group>
