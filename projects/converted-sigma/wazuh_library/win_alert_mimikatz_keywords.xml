    <match>((\"dpapi::masterkey\" OR \"eo.oe.kiwi\" OR \"event::clear\" OR \"event::drop\" OR \"gentilkiwi.com\" OR \"kerberos::golden\" OR \"ke</match>
  </rule>
</group>
