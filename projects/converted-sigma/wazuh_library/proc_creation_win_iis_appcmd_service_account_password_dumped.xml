<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Microsoft IIS Service Account Password Dumped</description>
    <match>(((CommandLine=\"*list *\") AND ((Image=\"*\\\\appcmd.exe\") OR (OriginalFileName=\"appcmd.exe\"))) AND (((CommandLine=\"* /confi</match>
  </rule>
</group>
