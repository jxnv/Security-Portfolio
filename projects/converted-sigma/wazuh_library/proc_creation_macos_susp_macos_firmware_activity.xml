<!--
  Title: Suspicious MacOS Firmware Activity
  ID: 7ed2c9f7-c59d-4c82-a7e2-f859aa676099
  Status: test
  Level: medium
  Author: Austin Songer @austinsonger
  Date: 2021-09-30
  Description: Detects when a user manipulates with Firmward Password on MacOS. NOTE - this command has been disabled on silicon-based apple computers.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious MacOS Firmware Activity</description>
    <match>(Image=\"/usr/sbin/firmwarepasswd\" AND (CommandLine=\"*setpasswd*\" OR CommandLine=\"*full*\" OR CommandLine=\"*delete*\" OR Co</match>
  </rule>
</group>
