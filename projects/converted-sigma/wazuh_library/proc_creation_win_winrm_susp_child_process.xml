<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Processes Spawned by WinRM</description>
    <match>(ParentImage=\"*\\\\wsmprovhost.exe\" AND (Image=\"*\\\\cmd.exe\" OR Image=\"*\\\\sh.exe\" OR Image=\"*\\\\bash.exe\" OR Image=\"*\\\\power</match>
  </rule>
</group>
