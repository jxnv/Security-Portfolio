<!--
  Title: Scheduled TaskCache Change by Uncommon Program
  ID: 4720b7df-40c3-48fd-bbdf-fd4b3c464f0d
  Status: test
  Level: high
  Author: Syed Hasan (@syedhasan009)
  Date: 2021-06-18
  Description: Monitor the creation of a new key under 'TaskCache' when a new scheduled task is registered by a process that is not svchost.exe, which is suspicious
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Scheduled TaskCache Change by Uncommon Program</description>
    <match>((TargetObject=\"*SOFTWARE\\\\Microsoft\\\\Windows NT\\\\CurrentVersion\\\\Schedule\\\\TaskCache\\\\*\") AND NOT (((Details=\"(Empty)\")</match>
  </rule>
</group>
