<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Windows Firewall Disabled via PowerShell</description>
    <match>(((CommandLine=\"*Set-NetFirewallProfile *\" AND CommandLine=\"* -Enabled *\" AND CommandLine=\"* False*\")) AND (((Image=\"*\\\\</match>
  </rule>
</group>
