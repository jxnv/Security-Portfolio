    <match>((ImageLoaded=\"*\\\\wfshbr64.sys\" OR ImageLoaded=\"*\\\\ktmutil7odm.sys\" OR ImageLoaded=\"*\\\\ktes.sys\" OR ImageLoaded=\"*\\\\a263</match>
