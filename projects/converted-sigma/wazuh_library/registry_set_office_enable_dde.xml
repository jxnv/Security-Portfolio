<!--
  Title: Enable Microsoft Dynamic Data Exchange
  ID: 63647769-326d-4dde-a419-b925cc0caf42
  Status: test
  Level: medium
  Author: frack113
  Date: 2022-02-26
  Description: Enable Dynamic Data Exchange protocol (DDE) in all supported editions of Microsoft Word or Excel.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Enable Microsoft Dynamic Data Exchange</description>
    <match>(((TargetObject=\"*\\\\Excel\\\\Security\\\\DisableDDEServerLaunch\" OR TargetObject=\"*\\\\Excel\\\\Security\\\\DisableDDEServerLookup</match>
  </rule>
</group>
