<!--
  Title: Suspicious File Download From IP Via Wget.EXE - Paths
  ID: 40aa399c-7b02-4715-8e5f-73572b493f33
  Status: test
  Level: high
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2024-02-23
  Description: Detects potentially suspicious file downloads directly from IP addresses and stored in suspicious locations using Wget.exe
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious File Download From IP Via Wget.EXE - Paths</description>
    <match>(((CommandLine=regex(\"\\\\s-O\\\\s\")) OR (CommandLine=\"*--output-document*\")) AND (CommandLine=\"*http*\") AND ((Image=\"*\\\\wge</match>
  </rule>
</group>
