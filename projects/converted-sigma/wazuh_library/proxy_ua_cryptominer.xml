<!--
  Title: Crypto Miner User Agent
  ID: fa935401-513b-467b-81f4-f9e77aa0dd78
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems)
  Date: 2019-10-21
  Description: Detects suspicious user agent strings used by crypto miners in proxy logs
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Crypto Miner User Agent</description>
    <match>((c-useragent=\"XMRig *\" OR c-useragent=\"ccminer*\"))</match>
  </rule>
</group>
