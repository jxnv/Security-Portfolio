<!--
  Title: Gpscript Execution
  ID: 1e59c230-6670-45bf-83b0-98903780607e
  Status: test
  Level: medium
  Author: frack113
  Date: 2022-05-16
  Description: Detects the execution of the LOLBIN gpscript, which executes logon or startup scripts configured in Group Policy
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Gpscript Execution</description>
    <match>((((CommandLine=\"* /logon*\" OR CommandLine=\"* /startup*\")) AND ((Image=\"*\\\\gpscript.exe\") OR (OriginalFileName=\"GPSCRIPT</match>
  </rule>
</group>
