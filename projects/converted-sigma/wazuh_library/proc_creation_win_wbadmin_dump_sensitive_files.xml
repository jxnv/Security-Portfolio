<!--
  Title: Sensitive File Dump Via Wbadmin.EXE
  ID: 8b93a509-1cb8-42e1-97aa-ee24224cdc15
  Status: test
  Level: high
  Author: Nasreddine Bencherchali (Nextron Systems), frack113
  Date: 2024-05-10
  Description: Detects the dump of highly sensitive files such as "NTDS.DIT" and "SECURITY" hive. Attackers can leverage the "wbadmin" utility in order to dump sensitive files that might contain credential or sensitive information.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Sensitive File Dump Via Wbadmin.EXE</description>
    <match>(((CommandLine=\"*start*\" OR CommandLine=\"*backup*\")) AND ((Image=\"*\\\\wbadmin.exe\") OR (OriginalFileName=\"WBADMIN.EXE\")) </match>
  </rule>
</group>
