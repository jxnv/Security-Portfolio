<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Activate Suppression of Windows Security Center Notifications</description>
    <match>(TargetObject=\"*SOFTWARE\\\\Policies\\\\Microsoft\\\\Windows Defender\\\\UX Configuration\\\\Notification_Suppress\" AND Details=\"D</match>
  </rule>
</group>
