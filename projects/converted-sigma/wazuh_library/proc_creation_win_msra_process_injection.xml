<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potential Process Injection Via Msra.EXE</description>
    <match>(ParentImage=\"*\\\\msra.exe\" AND ParentCommandLine=\"*msra.exe\" AND (Image=\"*\\\\arp.exe\" OR Image=\"*\\\\cmd.exe\" OR Image=\"*\\\\</match>
  </rule>
</group>
