<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potential PowerShell Execution Policy Tampering - ProcCreation</description>
    <match>(((CommandLine=\"*\\\\ShellIds\\\\Microsoft.PowerShell\\\\ExecutionPolicy*\" OR CommandLine=\"*\\\\Policies\\\\Microsoft\\\\Windows\\\\Po</match>
  </rule>
</group>
