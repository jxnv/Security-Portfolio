<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Add New Download Source To Winget</description>
    <match>(((CommandLine=\"*source *\" AND CommandLine=\"*add *\")) AND ((Image=\"*\\\\winget.exe\") OR (OriginalFileName=\"winget.exe\")))</match>
  </rule>
</group>
