<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Created Files by Microsoft Sync Center</description>
    <match>((Image=\"*\\\\mobsync.exe\") AND ((TargetFilename=\"*.dll\" OR TargetFilename=\"*.exe\")))</match>
  </rule>
</group>
