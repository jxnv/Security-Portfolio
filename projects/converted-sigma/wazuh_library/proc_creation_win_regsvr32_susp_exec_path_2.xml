<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Regsvr32 Execution From Highly Suspicious Location</description>
    <match>(((Image=\"*\\\\regsvr32.exe\") OR (OriginalFileName=\"REGSVR32.EXE\")) AND (((CommandLine=\"*:\\\\PerfLogs\\\\*\" OR CommandLine=\"*</match>
  </rule>
</group>
