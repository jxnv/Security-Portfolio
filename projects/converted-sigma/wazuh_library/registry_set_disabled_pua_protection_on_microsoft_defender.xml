<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Disable PUA Protection on Windows Defender</description>
    <match>(TargetObject=\"*\\\\Policies\\\\Microsoft\\\\Windows Defender\\\\PUAProtection*\" AND Details=\"DWORD (0x00000000)\")</match>
  </rule>
</group>
