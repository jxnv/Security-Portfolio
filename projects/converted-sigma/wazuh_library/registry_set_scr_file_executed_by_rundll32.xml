<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>ScreenSaver Registry Key Set</description>
    <match>((Image=\"*\\\\rundll32.exe\") AND (TargetObject=\"*\\\\Control Panel\\\\Desktop\\\\SCRNSAVE.EXE*\" AND Details=\"*.scr\") AND NOT (((</match>
  </rule>
</group>
