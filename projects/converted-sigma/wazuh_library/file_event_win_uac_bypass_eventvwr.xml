<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>UAC Bypass Using EventVwr</description>
    <match>(((TargetFilename=\"*\\\\Microsoft\\\\Event Viewer\\\\RecentViews\" OR TargetFilename=\"*\\\\Microsoft\\\\EventV~1\\\\RecentViews\")) AN</match>
  </rule>
</group>
