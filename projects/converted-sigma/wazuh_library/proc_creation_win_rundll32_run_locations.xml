<!--
  Title: Suspicious Process Start Locations
  ID: 15b75071-74cc-47e0-b4c6-b43744a62a2b
  Status: test
  Level: medium
  Author: juju4, Jonhnathan Ribeiro, oscd.community
  Date: 2019-01-16
  Description: Detects suspicious process run from unusual locations
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious Process Start Locations</description>
    <match>(((Image=\"*:\\\\RECYCLER\\\\*\" OR Image=\"*:\\\\SystemVolumeInformation\\\\*\")) OR ((Image=\"C:\\\\Windows\\\\Tasks\\\\*\" OR Image=\"C:\\\\</match>
  </rule>
</group>
