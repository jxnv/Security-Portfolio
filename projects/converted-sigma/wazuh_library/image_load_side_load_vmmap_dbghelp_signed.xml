<!--
  Title: VMMap Signed Dbghelp.DLL Potential Sideloading
  ID: 98ffaed4-aec2-4e04-9b07-31492fe68b3d
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2023-09-05
  Description: Detects potential DLL sideloading of a signed dbghelp.dll by the Sysinternals VMMap.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>VMMap Signed Dbghelp.DLL Potential Sideloading</description>
    <match>(ImageLoaded=\"*C:\\\\Debuggers\\\\dbghelp.dll*\" AND (Image=\"*\\\\vmmap.exe\" OR Image=\"*\\\\vmmap64.exe\") AND Signed=\"true\")</match>
  </rule>
</group>
