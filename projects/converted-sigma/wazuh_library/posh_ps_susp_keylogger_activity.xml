<!--
  Title: Potential Keylogger Activity
  ID: 965e2db9-eddb-4cf6-a986-7a967df651e4
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2023-01-04
  Description: Detects PowerShell scripts that contains reference to keystroke capturing functions
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential Keylogger Activity</description>
    <match>(ScriptBlockText=\"*[Windows.Input.Keyboard]::IsKeyDown([System.Windows.Input.Key]::*\")</match>
  </rule>
</group>
