<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Splwow64 Without Params</description>
    <match>(Image=\"*\\\\splwow64.exe\" AND CommandLine=\"*splwow64.exe\")</match>
  </rule>
</group>
