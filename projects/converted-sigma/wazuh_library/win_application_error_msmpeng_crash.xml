<!--
  Title: Microsoft Malware Protection Engine Crash
  ID: 545a5da6-f103-4919-a519-e9aec1026ee4
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems)
  Date: 2017-05-09
  Description: This rule detects a suspicious crash of the Microsoft Malware Protection Engine
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Microsoft Malware Protection Engine Crash</description>
    <match>(Provider_Name=\"Application Error\" AND EventID=\"1000\" AND (Data=\"*MsMpEng.exe*\" AND Data=\"*mpengine.dll*\"))</match>
  </rule>
</group>
