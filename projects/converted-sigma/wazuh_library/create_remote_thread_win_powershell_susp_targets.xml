  Description: Detects the creation of a remote thread from a Powershell process in an uncommon target process
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Remote Thread Creation Via PowerShell In Uncommon Target</description>
    <match>((SourceImage=\"*\\\\powershell.exe\" OR SourceImage=\"*\\\\pwsh.exe\") AND (TargetImage=\"*\\\\rundll32.exe\" OR TargetImage=\"*\\\\re</match>
  </rule>
</group>
