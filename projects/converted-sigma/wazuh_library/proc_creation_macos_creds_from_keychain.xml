<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Credentials from Password Stores - Keychain</description>
    <match>((Image=\"/usr/bin/security\" AND (CommandLine=\"*find-certificate*\" OR CommandLine=\"* export *\")) OR ((CommandLine=\"* dump</match>
  </rule>
</group>
