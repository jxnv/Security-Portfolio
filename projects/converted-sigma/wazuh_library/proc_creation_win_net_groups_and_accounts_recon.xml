<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious Group And Account Reconnaissance Activity Using Net.EXE</description>
    <match>((((Image=\"*\\\\net.exe\" OR Image=\"*\\\\net1.exe\")) OR ((OriginalFileName=\"net.exe\" OR OriginalFileName=\"net1.exe\"))) AND ((</match>
  </rule>
</group>
