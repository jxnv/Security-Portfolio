<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>New ODBC Driver Registered</description>
    <match>((TargetObject=\"*\\\\SOFTWARE\\\\ODBC\\\\ODBCINST.INI\\\\*\" AND TargetObject=\"*\\\\Driver\") AND NOT ((TargetObject=\"*\\\\SQL Server\\</match>
  </rule>
</group>
