<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential Unconstrained Delegation Discovery Via Get-ADComputer - ScriptBlock</description>
    <match>((ScriptBlockText=\"*-Properties*TrustedForDelegation*\" OR ScriptBlockText=\"*-Properties*TrustedToAuthForDelegation*\" OR </match>
  </rule>
</group>
