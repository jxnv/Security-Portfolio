<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Child Process Of Wermgr.EXE</description>
    <match>((ParentImage=\"*\\\\wermgr.exe\" AND (Image=\"*\\\\cmd.exe\" OR Image=\"*\\\\cscript.exe\" OR Image=\"*\\\\ipconfig.exe\" OR Image=\"*\\\\</match>
  </rule>
</group>
