<!--
  Title: Creation of a Local Hidden User Account by Registry
  ID: 460479f3-80b7-42da-9c43-2cc1d54dbccd
  Status: test
  Level: high
  Author: Christian Burkard (Nextron Systems)
  Date: 2021-05-03
  Description: Sysmon registry detection of a local hidden user account.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Creation of a Local Hidden User Account by Registry</description>
    <match>(TargetObject=\"*\\\\SAM\\\\SAM\\\\Domains\\\\Account\\\\Users\\\\Names\\\\*\" AND TargetObject=\"*$\\\\(Default)\" AND Image=\"*\\\\lsass.exe\"</match>
  </rule>
</group>
