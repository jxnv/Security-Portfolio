<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Windows Share Mount Via Net.EXE</description>
    <match>(((CommandLine=\"* use *\" OR CommandLine=\"* \\\\\\\\\\\\\\\\*\")) AND (((Image=\"*\\\\net.exe\" OR Image=\"*\\\\net1.exe\")) OR ((Original</match>
  </rule>
</group>
