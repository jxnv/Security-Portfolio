<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential Binary Proxy Execution Via VSDiagnostics.EXE</description>
    <match>(((CommandLine=\"* /launch:*\" OR CommandLine=\"* -launch:*\")) AND (CommandLine=\"*start*\") AND ((Image=\"*\\\\VSDiagnostics.ex</match>
  </rule>
</group>
