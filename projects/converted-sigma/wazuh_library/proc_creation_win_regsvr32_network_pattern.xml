<!--
  Title: Potentially Suspicious Regsvr32 HTTP/FTP Pattern
  ID: 867356ee-9352-41c9-a8f2-1be690d78216
  Status: test
  Level: medium
  Author: Florian Roth (Nextron Systems)
  Date: 2023-05-24
  Description: Detects regsvr32 execution to download/install/register new DLLs that are hosted on Web or FTP servers.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potentially Suspicious Regsvr32 HTTP/FTP Pattern</description>
    <match>(((CommandLine=\"* /i*\" OR CommandLine=\"* -i*\")) AND ((Image=\"*\\\\regsvr32.exe\") OR (OriginalFileName=\"REGSVR32.EXE\")) AND</match>
  </rule>
</group>
