<!--
  Title: ServiceDll Hijack
  ID: 612e47e9-8a59-43a6-b404-f48683f45bd6
  Status: test
  Level: medium
  Author: frack113
  Date: 2022-02-04
  Description: Detects changes to the "ServiceDLL" value related to a service in the registry. This is often used as a method of persistence.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>ServiceDll Hijack</description>
    <match>(((TargetObject=\"*\\\\System\\\\*\" AND TargetObject=\"*ControlSet*\" AND TargetObject=\"*\\\\Services\\\\*\") AND TargetObject=\"*\\\\P</match>
  </rule>
</group>
