<!--
  Title: Network Connection Initiated By AddinUtil.EXE
  ID: 5205613d-2a63-4412-a895-3a2458b587b3
  Status: test
  Level: high
  Author: Michael McKinley (@McKinleyMike), Tony Latteri (@TheLatteri)
  Date: 2023-09-18
  Description: Detects a network connection initiated by the Add-In deployment cache updating utility "AddInutil.exe". This could indicate a potential command and control communication as this tool doesn't usually initiate network activity.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Network Connection Initiated By AddinUtil.EXE</description>
    <match>(Initiated=\"true\" AND Image=\"*\\\\addinutil.exe\")</match>
  </rule>
</group>
