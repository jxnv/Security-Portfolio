<!--
  Title: Potential Arbitrary DLL Load Using Winword
  ID: f7375e28-5c14-432f-b8d1-1db26c832df3
  Status: test
  Level: medium
  Author: Victor Sergeev, oscd.community
  Date: 2020-10-09
  Description: Detects potential DLL sideloading using the Microsoft Office winword process via the '/l' flag.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential Arbitrary DLL Load Using Winword</description>
    <match>(((CommandLine=\"*/l *\" AND CommandLine=\"*.dll*\")) AND ((Image=\"*\\\\WINWORD.exe\") OR (OriginalFileName=\"WinWord.exe\")))</match>
  </rule>
</group>
