<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>NTDS Exfiltration Filename Patterns</description>
    <match>((TargetFilename=\"*\\\\All.cab\" OR TargetFilename=\"*.ntds.cleartext\"))</match>
  </rule>
</group>
