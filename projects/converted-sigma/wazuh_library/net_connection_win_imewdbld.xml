<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Network Connection Initiated By IMEWDBLD.EXE</description>
    <match>(Initiated=\"true\" AND Image=\"*\\\\IMEWDBLD.exe\")</match>
  </rule>
</group>
