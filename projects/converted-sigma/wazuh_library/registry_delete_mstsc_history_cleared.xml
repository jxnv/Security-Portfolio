<!--
  Title: Terminal Server Client Connection History Cleared - Registry
  ID: 07bdd2f5-9c58-4f38-aec8-e101bb79ef8d
  Status: test
  Level: high
  Author: Christian Burkard (Nextron Systems)
  Date: 2021-10-19
  Description: Detects the deletion of registry keys containing the MSTSC connection history
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Terminal Server Client Connection History Cleared - Registry</description>
    <match>((EventType=\"DeleteValue\" AND TargetObject=\"*\\\\Microsoft\\\\Terminal Server Client\\\\Default\\\\MRU*\") OR (EventType=\"DeleteK</match>
  </rule>
</group>
