<!--
  Title: Lolbin Unregmp2.exe Use As Proxy
  ID: 727454c0-d851-48b0-8b89-385611ab0704
  Status: test
  Level: medium
  Author: frack113
  Date: 2022-12-29
  Description: Detect usage of the "unregmp2.exe" binary as a proxy to launch a custom version of "wmpnscfg.exe"
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Lolbin Unregmp2.exe Use As Proxy</description>
    <match>((CommandLine=\"* /HideWMP*\") AND ((Image=\"*\\\\unregmp2.exe\") OR (OriginalFileName=\"unregmp2.exe\")))</match>
  </rule>
</group>
