<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Binary Proxy Execution Via Dotnet-Trace.EXE</description>
    <match>(((CommandLine=\"*-- *\" AND CommandLine=\"*collect*\")) AND ((Image=\"*\\\\dotnet-trace.exe\") OR (OriginalFileName=\"dotnet-tra</match>
  </rule>
</group>
