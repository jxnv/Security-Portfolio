<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>File or Folder Permissions Change</description>
    <match>(type=\"EXECVE\" AND (a0=\"*chmod*\" OR a0=\"*chown*\"))</match>
  </rule>
</group>
