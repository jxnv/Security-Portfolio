  Description: Detects the usage of the "Accesschk" utility, an access and privilege audit tool developed by SysInternal and often being abused by attacker to verify process privileges
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Permission Check Via Accesschk.EXE</description>
    <match>(((CommandLine=\"*uwcqv *\" OR CommandLine=\"*kwsu *\" OR CommandLine=\"*qwsu *\" OR CommandLine=\"*uwdqs *\")) AND ((Product=\"*</match>
  </rule>
</group>
