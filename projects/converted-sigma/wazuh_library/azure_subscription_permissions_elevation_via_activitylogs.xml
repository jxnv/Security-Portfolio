<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Azure Subscription Permission Elevation Via ActivityLogs</description>
    <match>(operationName=\"MICROSOFT.AUTHORIZATION/ELEVATEACCESS/ACTION\")</match>
  </rule>
</group>
