<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious PowerShell Download - Powershell Script</description>
    <match>((ScriptBlockText=\"*System.Net.WebClient*\") AND ((ScriptBlockText=\"*.DownloadFile(*\" OR ScriptBlockText=\"*.DownloadFileA</match>
  </rule>
</group>
