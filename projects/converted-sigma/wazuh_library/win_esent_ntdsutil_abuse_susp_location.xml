  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-08-14
  Description: Detects potential abuse of ntdsutil to dump ntds.dit database to a suspicious location
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Dump Ntds.dit To Suspicious Location</description>
    <match>(((Data=\"*:\\\\ntds.dit*\" OR Data=\"*\\\\Appdata\\\\*\" OR Data=\"*\\\\Desktop\\\\*\" OR Data=\"*\\\\Downloads\\\\*\" OR Data=\"*\\\\Perflogs\\\\</match>
  </rule>
</group>
