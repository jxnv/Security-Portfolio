<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Mesh Agent Service Installation</description>
    <match>((Provider_Name=\"Service Control Manager\" AND EventID=\"7045\") AND ((ImagePath=\"*MeshAgent.exe*\") OR (ServiceName=\"*Mesh </match>
  </rule>
</group>
