<!--
  Title: Nslookup PowerShell Download Cradle - ProcessCreation
  ID: 1b3b01c7-84e9-4072-86e5-fc285a41ff23
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-09-05
  Description: Detects suspicious powershell download cradle using nslookup. This cradle uses nslookup to extract payloads from DNS records
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Nslookup PowerShell Download Cradle - ProcessCreation</description>
    <match>(((ParentImage=\"*\\\\powershell.exe\" OR ParentImage=\"*\\\\pwsh.exe\") AND (CommandLine=\"* -q=txt *\" OR CommandLine=\"* -queryt</match>
  </rule>
</group>
