  Description: Detects suspicious PowerShell download command
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious PowerShell Download - PoshModule</description>
    <match>(((ContextInfo=\"*.DownloadFile(*\" OR ContextInfo=\"*.DownloadString(*\")) AND (ContextInfo=\"*System.Net.WebClient*\"))</match>
  </rule>
</group>
