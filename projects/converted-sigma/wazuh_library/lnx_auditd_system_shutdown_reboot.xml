<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>System Shutdown/Reboot - Linux</description>
    <match>((type=\"EXECVE\") AND ((\"shutdown\" OR \"reboot\" OR \"halt\" OR \"poweroff\") OR ((\"init\" OR \"telinit\") AND (\"0\" OR \"6\"))))</match>
  </rule>
</group>
