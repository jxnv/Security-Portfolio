<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>WmiPrvSE Spawned A Process</description>
    <match>((ParentImage=\"*\\\\WmiPrvSe.exe\") AND NOT ((((LogonId=\"0x3e7\" OR LogonId=\"null\")) OR (NOT LogonId=*) OR ((User=\"*AUTHORI*</match>
  </rule>
</group>
