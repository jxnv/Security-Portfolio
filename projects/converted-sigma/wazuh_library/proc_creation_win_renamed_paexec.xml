<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Renamed PAExec Execution</description>
    <match>(((Description=\"PAExec Application\") OR (OriginalFileName=\"PAExec.exe\") OR (Product=\"*PAExec*\") OR ((Hashes=\"*IMPHASH=11</match>
  </rule>
</group>
