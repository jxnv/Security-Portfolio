<!--
  Title: Prefetch File Deleted
  ID: 0a1f9d29-6465-4776-b091-7f43b26e4c89
  Status: test
  Level: high
  Author: Cedric MAURUGEON
  Date: 2021-09-29
  Description: Detects the deletion of a prefetch file which may indicate an attempt to destroy forensic evidence
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Prefetch File Deleted</description>
    <match>((TargetFilename=\"*:\\\\Windows\\\\Prefetch\\\\*\" AND TargetFilename=\"*.pf\") AND NOT ((Image=\"*:\\\\windows\\\\system32\\\\svchost.e</match>
  </rule>
</group>
