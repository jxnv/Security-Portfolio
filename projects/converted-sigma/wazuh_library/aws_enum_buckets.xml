<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential Bucket Enumeration on AWS</description>
    <match>((eventSource=\"s3.amazonaws.com\" AND eventName=\"ListBuckets\") AND NOT ((userIdentity.type=\"AssumedRole\")))</match>
  </rule>
</group>
