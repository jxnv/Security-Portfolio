<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Encoded Scripts in a WMI Consumer</description>
    <match>((Destination=\"*V3JpdGVQcm9jZXNzTWVtb3J5*\" OR Destination=\"*dyaXRlUHJvY2Vzc01lbW9ye*\" OR Destination=\"*Xcml0ZVByb2Nlc3NN</match>
  </rule>
</group>
