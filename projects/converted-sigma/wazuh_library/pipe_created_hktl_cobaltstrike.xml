<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>CobaltStrike Named Pipe</description>
    <match>(((PipeName=\"*\\\\MSSE-*\" AND PipeName=\"*-server*\")) OR (PipeName=\"\\\\interprocess_*\") OR (PipeName=\"\\\\lsarpc_*\") OR (PipeN</match>
  </rule>
</group>
