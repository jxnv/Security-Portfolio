<!--
  Title: ETW Logging Disabled For SCM
  ID: 4f281b83-0200-4b34-bf35-d24687ea57c2
  Status: test
  Level: low
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-12-09
  Description: Detects changes to the "TracingDisabled" key in order to disable ETW logging for services.exe (SCM)
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>ETW Logging Disabled For SCM</description>
    <match>(TargetObject=\"*Software\\\\Microsoft\\\\Windows NT\\\\CurrentVersion\\\\Tracing\\\\SCM\\\\Regular\\\\TracingDisabled\" AND Details=\"DW</match>
  </rule>
</group>
