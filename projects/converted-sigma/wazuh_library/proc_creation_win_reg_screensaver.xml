<!--
  Title: Suspicious ScreenSave Change by Reg.exe
  ID: 0fc35fc3-efe6-4898-8a37-0b233339524f
  Status: test
  Level: medium
  Author: frack113
  Date: 2021-08-19
  Description: Adversaries may establish persistence by executing malicious content triggered by user inactivity. Screensavers are programs that execute after a configurable time of user inactivity and consist of Portable Executable (PE) files with a .scr file extension
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious ScreenSave Change by Reg.exe</description>
    <match>((Image=\"*\\\\reg.exe\" AND (CommandLine=\"*HKEY_CURRENT_USER\\\\Control Panel\\\\Desktop*\" OR CommandLine=\"*HKCU\\\\Control Panel</match>
  </rule>
</group>
