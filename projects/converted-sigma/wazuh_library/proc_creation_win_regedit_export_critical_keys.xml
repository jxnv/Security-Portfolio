<!--
  Title: Exports Critical Registry Keys To a File
  ID: 82880171-b475-4201-b811-e9c826cd5eaa
  Status: test
  Level: high
  Author: Oddvar Moe, Sander Wiebing, oscd.community
  Date: 2020-10-12
  Description: Detects the export of a crital Registry key to a file.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Exports Critical Registry Keys To a File</description>
    <match>((CommandLine=\"* -E *\") AND ((CommandLine=\"*hklm*\" OR CommandLine=\"*hkey_local_machine*\")) AND ((CommandLine=\"*\\\\system\"</match>
  </rule>
</group>
