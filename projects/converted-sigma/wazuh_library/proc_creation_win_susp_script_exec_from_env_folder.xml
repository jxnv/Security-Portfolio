<!--
  Title: Script Interpreter Execution From Suspicious Folder
  ID: 1228c958-e64e-4e71-92ad-7d429f4138ba
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-02-08
  Description: Detects suspicious script execution from suspicious directories or folders accessible by environment variables that may indicate malware activity. Script interpreters (cscript, wscript, mshta, powershell) executing from folders like Temp, Public, or user profile directories may suggest attempts to evade detection or execute malicious scripts.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Script Interpreter Execution From Suspicious Folder</description>
    <match>((((CommandLine=\"* -ep bypass *\" OR CommandLine=\"* -ExecutionPolicy bypass *\" OR CommandLine=\"* -w hidden *\" OR CommandL</match>
  </rule>
</group>
