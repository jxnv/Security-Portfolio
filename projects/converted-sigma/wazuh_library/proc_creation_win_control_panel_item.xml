<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Control Panel Items</description>
    <match>((((CommandLine=\"*add*\" AND CommandLine=\"*CurrentVersion\\\\Control Panel\\\\CPLs*\")) AND ((Image=\"*\\\\reg.exe\") OR (Original</match>
  </rule>
</group>
