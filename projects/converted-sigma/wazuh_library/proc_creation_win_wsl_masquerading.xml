<!--
  Title: Suspicious WSL Binary Masquerading
  ID: 530576ee-3b62-4bce-9a03-9aac6c61788a
  Status: experimental
  Level: high
  Author: Swachchhanda Shrawan Poudel (Nextron Systems)
  Date: 2026-05-05
  Description: Detects execution of masqueraded wsl.exe binary. Attackers can rename a malicious payload to wsl.exe to masquerade as the legitimate Windows Subsystem for Linux binary, bypassing detection based on image name alone and abusing user trust in the WSL process name.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious WSL Binary Masquerading</description>
    <match>((Image=\"*\\\\wsl.exe\") AND NOT (((OriginalFileName=\"wsl.exe\") OR (NOT OriginalFileName=*))))</match>
  </rule>
</group>
