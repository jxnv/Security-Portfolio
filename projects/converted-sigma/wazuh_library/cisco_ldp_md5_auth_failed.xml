<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Cisco LDP Authentication Failures</description>
    <match>((\"LDP\") AND (\"SOCKET_TCP_PACKET_MD5_AUTHEN_FAIL\" OR \"TCPMD5AuthenFail\"))</match>
  </rule>
</group>
