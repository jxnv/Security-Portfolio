  Level: high
  Author: Nextron Systems, @Kostastsale
  Date: 2022-06-01
  Description: Detects sdiagnhost.exe calling a suspicious child process (e.g. used in exploits for Follina / CVE-2022-30190)
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Sdiagnhost Calling Suspicious Child Process</description>
    <match>((ParentImage=\"*\\\\sdiagnhost.exe\" AND (Image=\"*\\\\powershell.exe\" OR Image=\"*\\\\pwsh.exe\" OR Image=\"*\\\\cmd.exe\" OR Image=\"</match>
  </rule>
</group>
