  Description: Detects potential DLL sideloading of "roboform.dll", a DLL used by RoboForm Password Manager
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential RoboForm.DLL Sideloading</description>
    <match>(((ImageLoaded=\"*\\\\roboform.dll\" OR ImageLoaded=\"*\\\\roboform-x64.dll\")) AND NOT (((Image=\" C:\\\\Program Files (x86)\\\\Sibe</match>
  </rule>
</group>
