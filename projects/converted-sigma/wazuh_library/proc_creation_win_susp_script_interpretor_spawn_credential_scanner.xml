<!--
  Title: Script Interpreter Spawning Credential Scanner - Windows
  ID: 0f60b28c-64dd-4e2c-9a63-5334d3e3a6e6
  Status: experimental
  Level: high
  Author: Swachchhanda Shrawan Poudel (Nextron Systems)
  Date: 2025-11-25
  Description: Detects a script interpreter process (like node.js or bun) spawning a known credential scanning tool (e.g., trufflehog, gitleaks). This behavior is indicative of an attempt to find and steal secrets, as seen in the "Shai-Hulud: The Second Coming" campaign.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Script Interpreter Spawning Credential Scanner - Windows</description>
    <match>((((Image=\"*trufflehog.exe\" OR Image=\"*gitleaks.exe\")) OR ((CommandLine=\"*trufflehog*\" OR CommandLine=\"*gitleaks*\"))) AN</match>
  </rule>
</group>
