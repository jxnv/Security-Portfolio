<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Dism Remove Online Package</description>
    <match>((Image=\"*\\\\Dism.exe\" AND (CommandLine=\"*/Online*\" AND CommandLine=\"*/Disable-Feature*\")) OR (Image=\"*\\\\DismHost.exe\" AN</match>
  </rule>
</group>
