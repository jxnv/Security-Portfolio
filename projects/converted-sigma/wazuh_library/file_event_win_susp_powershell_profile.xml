<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>PowerShell Profile Modification</description>
    <match>((TargetFilename=\"*\\\\Microsoft.PowerShell_profile.ps1\" OR TargetFilename=\"*\\\\PowerShell\\\\profile.ps1\" OR TargetFilename=</match>
  </rule>
</group>
