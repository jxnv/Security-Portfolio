<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Script Interpreter Spawning Credential Scanner - Linux</description>
    <match>((((Image=\"*/trufflehog\" OR Image=\"*/gitleaks\")) OR ((CommandLine=\"*trufflehog*\" OR CommandLine=\"*gitleaks*\"))) AND ((Pa</match>
  </rule>
</group>
