<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Usage Of Web Request Commands And Cmdlets</description>
    <match>((CommandLine=\"*[System.Net.WebRequest]::create*\" OR CommandLine=\"*curl *\" OR CommandLine=\"*Invoke-RestMethod*\" OR Comma</match>
  </rule>
</group>
