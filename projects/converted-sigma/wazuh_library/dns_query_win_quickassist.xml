<!--
  Title: DNS Query Request By QuickAssist.EXE
  ID: 882e858a-3233-4ba8-855e-2f3d3575803d
  Status: experimental
  Level: low
  Author: Muhammad Faisal (@faisalusuf)
  Date: 2024-12-19
  Description: Detects DNS queries initiated by "QuickAssist.exe" to Microsoft Quick Assist primary endpoint that is used to establish a session.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>DNS Query Request By QuickAssist.EXE</description>
    <match>(Image=\"*\\\\QuickAssist.exe\" AND QueryName=\"*remoteassistance.support.services.microsoft.com\")</match>
  </rule>
</group>
