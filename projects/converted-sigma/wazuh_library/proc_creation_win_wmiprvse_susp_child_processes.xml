  Description: Detects suspicious and uncommon child processes of WmiPrvSE
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious WmiPrvSE Child Process</description>
    <match>((ParentImage=\"*\\\\wbem\\\\WmiPrvSE.exe\") AND (((Image=\"*\\\\certutil.exe\" OR Image=\"*\\\\cscript.exe\" OR Image=\"*\\\\mshta.exe\" </match>
  </rule>
</group>
