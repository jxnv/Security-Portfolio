<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>WinSock2 Autorun Keys Modification</description>
    <match>((TargetObject=\"*\\\\System\\\\CurrentControlSet\\\\Services\\\\WinSock2\\\\Parameters*\") AND ((TargetObject=\"*\\\\Protocol_Catalog9</match>
  </rule>
</group>
