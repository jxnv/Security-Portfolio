<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potentially Suspicious Execution Of PDQDeployRunner</description>
    <match>((((Image=\"*\\\\bash.exe\" OR Image=\"*\\\\certutil.exe\" OR Image=\"*\\\\cmd.exe\" OR Image=\"*\\\\csc.exe\" OR Image=\"*\\\\cscript.exe\"</match>
  </rule>
</group>
