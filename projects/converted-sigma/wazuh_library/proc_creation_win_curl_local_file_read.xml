<!--
  Title: Local File Read Using Curl.EXE
  ID: aa6f6ea6-0676-40dd-b510-6e46f02d8867
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2023-07-27
  Description: Detects execution of "curl.exe" with the "file://" protocol handler in order to read local files.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Local File Read Using Curl.EXE</description>
    <match>((CommandLine=\"*file:///*\") AND ((Image=\"*\\\\curl.exe\") OR (OriginalFileName=\"curl.exe\")))</match>
  </rule>
</group>
