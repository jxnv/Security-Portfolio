<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>DNS Query To Visual Studio Code Tunnels Domain</description>
    <match>(QueryName=\"*.tunnels.api.visualstudio.com\")</match>
  </rule>
</group>
