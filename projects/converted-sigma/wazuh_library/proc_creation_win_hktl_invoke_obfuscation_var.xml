<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Invoke-Obfuscation VAR+ Launcher</description>
    <match>(CommandLine=regex(\"cmd.{0,5}(?:/c|/r)(?:\\\\s|)\\\\\\\"set\\\\s[a-zA-Z]{3,6}.*(?:\\\\{\\\\d\\\\}){1,}\\\\\\\\\\\\\\\"\\\\s+?\\\\-f(?:.*\\\\)){1,}.*</match>
  </rule>
</group>
