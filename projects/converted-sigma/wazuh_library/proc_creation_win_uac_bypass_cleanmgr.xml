<!--
  Title: UAC Bypass Using Disk Cleanup
  ID: b697e69c-746f-4a86-9f59-7bfff8eab881
  Status: test
  Level: high
  Author: Christian Burkard (Nextron Systems)
  Date: 2021-08-30
  Description: Detects the pattern of UAC Bypass using scheduled tasks and variable expansion of cleanmgr.exe (UACMe 34)
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>UAC Bypass Using Disk Cleanup</description>
    <match>(CommandLine=\"*\\\"\\\\system32\\\\cleanmgr.exe /autoclean /d C:\" AND ParentCommandLine=\"C:\\\\Windows\\\\system32\\\\svchost.exe -k</match>
  </rule>
</group>
