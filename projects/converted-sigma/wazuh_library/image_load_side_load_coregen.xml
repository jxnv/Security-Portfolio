<!--
  Title: Potential DLL Sideloading Using Coregen.exe
  ID: 0fa66f66-e3f6-4a9c-93f8-4f2610b00171
  Status: test
  Level: medium
  Author: frack113
  Date: 2022-12-31
  Description: Detect usage of the "coregen.exe" (Microsoft CoreCLR Native Image Generator) binary to sideload arbitrary DLLs.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential DLL Sideloading Using Coregen.exe</description>
    <match>((Image=\"*\\\\coregen.exe\") AND NOT (((ImageLoaded=\"C:\\\\Program Files (x86)\\\\Microsoft Silverlight\\\\*\" OR ImageLoaded=\"C:\\</match>
  </rule>
</group>
