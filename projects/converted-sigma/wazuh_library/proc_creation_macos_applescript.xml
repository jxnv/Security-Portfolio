    <description>MacOS Scripting Interpreter AppleScript</description>
    <match>((Image=\"*/osascript\" AND (CommandLine=\"* -e *\" OR CommandLine=\"*.scpt*\" OR CommandLine=\"*.js*\")) AND NOT ((ParentImage=</match>
  </rule>
</group>
