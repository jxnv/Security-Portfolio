<!--
  Title: Rundll32 Execution Without CommandLine Parameters
  ID: 1775e15e-b61b-4d14-a1a3-80981298085a
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems)
  Date: 2021-05-27
  Description: Detects suspicious start of rundll32.exe without any parameters as found in CobaltStrike beacon activity
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Rundll32 Execution Without CommandLine Parameters</description>
    <match>(((CommandLine=\"*\\\\rundll32.exe\" OR CommandLine=\"*\\\\rundll32.exe\\\"\" OR CommandLine=\"*\\\\rundll32\")) AND NOT (((ParentImag</match>
  </rule>
</group>
