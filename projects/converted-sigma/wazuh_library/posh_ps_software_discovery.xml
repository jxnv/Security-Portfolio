<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Detected Windows Software Discovery - PowerShell</description>
    <match>((ScriptBlockText=\"*get-itemProperty*\" AND ScriptBlockText=\"*\\\\software\\\\*\" AND ScriptBlockText=\"*select-object*\" AND Sc</match>
  </rule>
</group>
