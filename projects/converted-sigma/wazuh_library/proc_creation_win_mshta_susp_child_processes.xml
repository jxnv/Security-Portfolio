<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious MSHTA Child Process</description>
    <match>((((Image=\"*\\\\cmd.exe\" OR Image=\"*\\\\powershell.exe\" OR Image=\"*\\\\pwsh.exe\" OR Image=\"*\\\\wscript.exe\" OR Image=\"*\\\\cscrip</match>
  </rule>
</group>
