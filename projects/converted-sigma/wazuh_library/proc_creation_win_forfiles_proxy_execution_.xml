<!--
  Title: Forfiles Command Execution
  ID: 9aa5106d-bce3-4b13-86df-3a20f1d5cf0b
  Status: test
  Level: medium
  Author: Tim Rauch, Elastic, E.M. Anhaus (originally from Atomic Blue Detections, Endgame), oscd.community
  Date: 2022-06-14
  Description: Detects the execution of "forfiles" with the "/c" flag. While this is an expected behavior of the tool, it can be abused in order to proxy execution through it with any binary. Can be used to bypass application whitelisting.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Forfiles Command Execution</description>
    <match>((CommandLine=\"* -c *\") AND ((Image=\"*\\\\forfiles.exe\") OR (OriginalFileName=\"forfiles.exe\")))</match>
  </rule>
</group>
