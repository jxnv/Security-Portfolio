  Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
  Date: 2023-12-04
  Description: Detects the execution of "whoami.exe" with the "/all" flag
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Enumerate All Information With Whoami.EXE</description>
    <match>((CommandLine=\"* -all*\") AND ((Image=\"*\\\\whoami.exe\") OR (OriginalFileName=\"whoami.exe\")))</match>
  </rule>
</group>
