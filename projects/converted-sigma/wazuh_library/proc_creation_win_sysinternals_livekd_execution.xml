<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential Memory Dumping Activity Via LiveKD</description>
    <match>(((Image=\"*\\\\livekd.exe\" OR Image=\"*\\\\livekd64.exe\")) OR (OriginalFileName=\"livekd.exe\"))</match>
  </rule>
</group>
