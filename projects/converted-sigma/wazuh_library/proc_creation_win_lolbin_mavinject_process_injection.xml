<!--
  Title: Mavinject Inject DLL Into Running Process
  ID: 4f73421b-5a0b-4bbf-a892-5a7fb99bea66
  Status: test
  Level: high
  Author: frack113, Florian Roth
  Date: 2021-07-12
  Description: Detects process injection using the signed Windows tool "Mavinject" via the "INJECTRUNNING" flag
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Mavinject Inject DLL Into Running Process</description>
    <match>((CommandLine=\"* /INJECTRUNNING *\") AND NOT ((ParentImage=\"C:\\\\Windows\\\\System32\\\\AppVClient.exe\")))</match>
  </rule>
</group>
