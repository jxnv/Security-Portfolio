<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Serv-U Process Pattern</description>
    <match>(ParentImage=\"*\\\\Serv-U.exe\" AND (Image=\"*\\\\cmd.exe\" OR Image=\"*\\\\powershell.exe\" OR Image=\"*\\\\pwsh.exe\" OR Image=\"*\\\\ws</match>
  </rule>
</group>
