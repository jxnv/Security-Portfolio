<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Use of Remote.exe</description>
    <match>((Image=\"*\\\\remote.exe\") OR (OriginalFileName=\"remote.exe\"))</match>
  </rule>
</group>
