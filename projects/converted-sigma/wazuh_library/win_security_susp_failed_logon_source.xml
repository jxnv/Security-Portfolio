<!--
  Title: Failed Logon From Public IP
  ID: f88e112a-21aa-44bd-9b01-6ee2a2bbbed1
  Status: test
  Level: medium
  Author: NVISO
  Date: 2020-05-06
  Description: Detects a failed logon attempt from a public IP. A login from a public IP can indicate a misconfigured firewall or network boundary.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Failed Logon From Public IP</description>
    <match>((EventID=\"4625\") AND NOT (((IpAddress=\"*-*\") OR ((cidrmatch(\"::1/128\", IpAddress) OR cidrmatch(\"10.0.0.0/8\", IpAddress)</match>
  </rule>
</group>
