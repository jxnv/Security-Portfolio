<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Registry Modification to Hidden File Extension</description>
    <match>((TargetObject=\"*\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Explorer\\\\Advanced\\\\Hidden\" AND Details=\"DWORD (0x00000</match>
  </rule>
</group>
