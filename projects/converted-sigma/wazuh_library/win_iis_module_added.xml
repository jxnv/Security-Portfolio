<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>New Module Module Added To IIS Server</description>
    <match>((EventID=\"29\" AND Configuration=\"*/system.webServer/modules/add*\") AND NOT ((((NewValue=\"AnonymousAuthenticationModule\"</match>
  </rule>
</group>
