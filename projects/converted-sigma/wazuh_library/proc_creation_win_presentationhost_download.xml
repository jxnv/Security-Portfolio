<!--
  Title: Arbitrary File Download Via PresentationHost.EXE
  ID: b124ddf4-778d-418e-907f-6dd3fc0d31cd
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-08-19
  Description: Detects usage of "PresentationHost" which is a utility that runs ".xbap" (Browser Applications) files to download arbitrary files
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Arbitrary File Download Via PresentationHost.EXE</description>
    <match>(((CommandLine=\"*http://*\" OR CommandLine=\"*https://*\" OR CommandLine=\"*ftp://*\")) AND ((Image=\"*\\\\presentationhost.exe\"</match>
  </rule>
</group>
