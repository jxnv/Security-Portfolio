<!--
  Title: Process Explorer Driver Creation By Non-Sysinternals Binary
  ID: de46c52b-0bf8-4936-a327-aace94f94ac6
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems)
  Date: 2023-05-05
  Description: Detects creation of the Process Explorer drivers by processes other than Process Explorer (procexp) itself. Hack tools or malware may use the Process Explorer driver to elevate privileges, drops it to disk for a few moments, runs a service using that driver and removes it afterwards.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Process Explorer Driver Creation By Non-Sysinternals Binary</description>
    <match>((TargetFilename=\"*\\\\PROCEXP*\" AND TargetFilename=\"*.sys\") AND NOT (((Image=\"*\\\\procexp.exe\" OR Image=\"*\\\\procexp64.exe\"</match>
  </rule>
</group>
