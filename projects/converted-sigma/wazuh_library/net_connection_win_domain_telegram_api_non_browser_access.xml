<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious Non-Browser Network Communication With Telegram API</description>
    <match>((DestinationHostname=\"*api.telegram.org*\") AND NOT (((Image=\"*\\\\brave.exe\") OR ((Image=\"C:\\\\Program Files\\\\Google\\\\Chro</match>
  </rule>
</group>
