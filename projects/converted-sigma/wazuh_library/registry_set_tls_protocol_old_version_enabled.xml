<!--
  Title: Old TLS1.0/TLS1.1 Protocol Version Enabled
  ID: 439957a7-ad86-4a8f-9705-a28131c6821b
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2023-09-05
  Description: Detects applications or users re-enabling old TLS versions by setting the "Enabled" value to "1" for the "Protocols" registry key.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Old TLS1.0/TLS1.1 Protocol Version Enabled</description>
    <match>((TargetObject=\"*\\\\Control\\\\SecurityProviders\\\\SCHANNEL\\\\Protocols\\\\TLS 1.0\\\\*\" OR TargetObject=\"*\\\\Control\\\\SecurityPro</match>
  </rule>
</group>
