<!--
  Title: Suspicious Schtasks Schedule Types
  ID: 24c8392b-aa3c-46b7-a545-43f71657fe98
  Status: test
  Level: high
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-09-09
  Description: Detects scheduled task creations or modification on a suspicious schedule type
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Schtasks Schedule Types</description>
    <match>((((Image=\"*\\\\schtasks.exe\") OR (OriginalFileName=\"schtasks.exe\")) AND ((CommandLine=\"* ONLOGON *\" OR CommandLine=\"* ONS</match>
  </rule>
</group>
