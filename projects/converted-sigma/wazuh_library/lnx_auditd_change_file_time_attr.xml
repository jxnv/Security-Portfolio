<!--
  Title: File Time Attribute Change - Linux
  ID: b3cec4e7-6901-4b0d-a02d-8ab2d8eb818b
  Status: test
  Level: medium
  Author: Igor Fits, oscd.community
  Date: 2020-10-15
  Description: Detect file time attribute change to hide new or changes to existing files.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>File Time Attribute Change - Linux</description>
    <match>((type=\"EXECVE\") AND (\"touch\") AND (\"-t\" OR \"-acmr\" OR \"-d\" OR \"-r\"))</match>
  </rule>
</group>
