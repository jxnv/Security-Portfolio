<!--
  Title: Potential Credential Dumping Attempt Via PowerShell Remote Thread
  ID: fb656378-f909-47c1-8747-278bf09f4f4f
  Status: test
  Level: high
  Author: oscd.community, Natalia Shornikova
  Date: 2020-10-06
  Description: Detects remote thread creation by PowerShell processes into "lsass.exe"
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potential Credential Dumping Attempt Via PowerShell Remote Thread</description>
    <match>((SourceImage=\"*\\\\powershell.exe\" OR SourceImage=\"*\\\\pwsh.exe\") AND TargetImage=\"*\\\\lsass.exe\")</match>
  </rule>
</group>
