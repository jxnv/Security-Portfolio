    <description>Exports Registry Key To a File</description>
    <match>(((CommandLine=\"* -E *\") AND ((Image=\"*\\\\regedit.exe\") OR (OriginalFileName=\"REGEDIT.EXE\"))) AND NOT ((((CommandLine=\"*h</match>
