<!--
  Title: Potential PowerShell Console History Access Attempt via History File
  ID: f4ff7323-b5fc-4323-8b52-6b9408e15788
  Status: experimental
  Level: medium
  Author: Luc Génaux
  Date: 2025-04-03
  Description: Detects potential access attempts to the PowerShell console history directly via history file (ConsoleHost_history.txt). This can give access to plaintext passwords used in PowerShell commands or used for general reconnaissance.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential PowerShell Console History Access Attempt via History File</description>
    <match>((CommandLine=\"*ConsoleHost_history.txt*\" OR CommandLine=\"*(Get-PSReadLineOption).HistorySavePath*\"))</match>
  </rule>
</group>
