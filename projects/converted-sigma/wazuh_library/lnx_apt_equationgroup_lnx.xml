  Title: Equation Group Indicators
  ID: 41e5c73d-9983-4b69-bd03-e13b67e9623c
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems)
  Date: 2017-04-09
  Description: Detects suspicious shell commands used in various Equation Group scripts and tools
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Equation Group Indicators</description>
    <match>(\"chown root*chmod 4777 \" OR \"cp /bin/sh .;chown\" OR \"chmod 4777 /tmp/.scsi/dev/bin/gsh\" OR \"chown root:root /tmp/.scsi/</match>
  </rule>
</group>
