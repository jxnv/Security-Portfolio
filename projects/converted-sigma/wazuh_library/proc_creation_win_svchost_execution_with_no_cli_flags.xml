    <description>Suspect Svchost Activity</description>
    <match>((CommandLine=\"*svchost.exe\" AND Image=\"*\\\\svchost.exe\") AND NOT ((((ParentImage=\"*\\\\rpcnet.exe\" OR ParentImage=\"*\\\\rpcn</match>
  </rule>
</group>
