  Author: Florian Roth (Nextron Systems), Tom Ueltschi, Jonhnathan Ribeiro, oscd.community
  Date: 2017-11-10
  Description: Detects javaw.exe in AppData folder as used by Adwind / JRAT
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Adwind RAT / JRAT File Artifact</description>
    <match>(((TargetFilename=\"*\\\\AppData\\\\Roaming\\\\Oracle\\\\bin\\\\java*\" AND TargetFilename=\"*.exe*\")) OR ((TargetFilename=\"*\\\\Retriv</match>
  </rule>
</group>
