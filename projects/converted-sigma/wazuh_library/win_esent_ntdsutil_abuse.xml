<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Ntdsutil Abuse</description>
    <match>(Provider_Name=\"ESENT\" AND (EventID=\"216\" OR EventID=\"325\" OR EventID=\"326\" OR EventID=\"327\") AND Data=\"*ntds.dit*\")</match>
  </rule>
</group>
