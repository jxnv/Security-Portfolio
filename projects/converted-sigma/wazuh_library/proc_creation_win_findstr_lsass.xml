<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>LSASS Process Reconnaissance Via Findstr.EXE</description>
    <match>(((CommandLine=\"*lsass*\") AND (((Image=\"*\\\\find.exe\" OR Image=\"*\\\\findstr.exe\")) OR ((OriginalFileName=\"FIND.EXE\" OR Ori</match>
  </rule>
</group>
