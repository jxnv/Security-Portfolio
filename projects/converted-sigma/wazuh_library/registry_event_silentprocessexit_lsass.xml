    <description>Potential Credential Dumping Via LSASS SilentProcessExit Technique</description>
    <match>(TargetObject=\"*Microsoft\\\\Windows NT\\\\CurrentVersion\\\\SilentProcessExit\\\\lsass.exe*\")</match>
  </rule>
</group>
