<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Cross Site Scripting Strings</description>
    <match>((cs-method=\"GET\") AND (\"=<script>\" OR \"=%3Cscript%3E\" OR \"=%253Cscript%253E\" OR \"<iframe \" OR \"%3Ciframe \" OR \"<svg \" O</match>
  </rule>
</group>
