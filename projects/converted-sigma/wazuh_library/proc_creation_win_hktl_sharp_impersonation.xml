<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>HackTool - SharpImpersonation Execution</description>
    <match>((((CommandLine=\"* user:*\" AND CommandLine=\"* binary:*\")) OR ((CommandLine=\"* user:*\" AND CommandLine=\"* shellcode:*\")) </match>
  </rule>
</group>
