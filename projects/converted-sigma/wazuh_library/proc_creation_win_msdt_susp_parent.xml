<!--
  Title: Suspicious MSDT Parent Process
  ID: 7a74da6b-ea76-47db-92cc-874ad90df734
  Status: test
  Level: high
  Author: Nextron Systems
  Date: 2022-06-01
  Description: Detects msdt.exe executed by a suspicious parent as seen in CVE-2022-30190 / Follina exploitation
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious MSDT Parent Process</description>
    <match>(((Image=\"*\\\\msdt.exe\") OR (OriginalFileName=\"msdt.exe\")) AND ((ParentImage=\"*\\\\cmd.exe\" OR ParentImage=\"*\\\\cscript.exe\"</match>
  </rule>
</group>
