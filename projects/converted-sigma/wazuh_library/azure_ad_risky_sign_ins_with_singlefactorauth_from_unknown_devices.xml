<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious SignIns From A Non Registered Device</description>
    <match>((Status=\"Success\" AND AuthenticationRequirement=\"singleFactorAuthentication\" AND RiskState=\"atRisk\") AND ((DeviceDetail</match>
  </rule>
</group>
