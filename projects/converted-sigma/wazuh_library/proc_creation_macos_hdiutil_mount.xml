<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Disk Image Mounting Via Hdiutil - MacOS</description>
    <match>(Image=\"*/hdiutil\" AND (CommandLine=\"*attach *\" OR CommandLine=\"*mount *\"))</match>
  </rule>
</group>
