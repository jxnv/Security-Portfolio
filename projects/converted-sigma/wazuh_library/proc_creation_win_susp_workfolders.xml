<!--
  Title: Execution via WorkFolders.exe
  ID: 0bbc6369-43e3-453d-9944-cae58821c173
  Status: test
  Level: high
  Author: Maxime Thiebaut (@0xThiebaut)
  Date: 2021-10-21
  Description: Detects using WorkFolders.exe to execute an arbitrary control.exe
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Execution via WorkFolders.exe</description>
    <match>((Image=\"*\\\\control.exe\" AND ParentImage=\"*\\\\WorkFolders.exe\") AND NOT ((Image=\"C:\\\\Windows\\\\System32\\\\control.exe\")))</match>
  </rule>
</group>
