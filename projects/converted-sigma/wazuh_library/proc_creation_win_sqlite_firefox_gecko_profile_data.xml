<!--
  Title: SQLite Firefox Profile Data DB Access
  ID: 4833155a-4053-4c9c-a997-777fcea0baa7
  Status: test
  Level: high
  Author: frack113
  Date: 2022-04-08
  Description: Detect usage of the "sqlite" binary to query databases in Firefox and other Gecko-based browsers for potential data stealing.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>SQLite Firefox Profile Data DB Access</description>
    <match>(((CommandLine=\"*cookies.sqlite*\" OR CommandLine=\"*places.sqlite*\")) AND ((Product=\"SQLite\") OR ((Image=\"*\\\\sqlite.exe\" </match>
  </rule>
</group>
