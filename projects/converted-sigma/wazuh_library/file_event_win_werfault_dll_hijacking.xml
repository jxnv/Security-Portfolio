<!--
  Title: Creation of WerFault.exe/Wer.dll in Unusual Folder
  ID: 28a452f3-786c-4fd8-b8f2-bddbe9d616d1
  Status: test
  Level: medium
  Author: frack113
  Date: 2022-05-09
  Description: Detects the creation of a file named "WerFault.exe" or "wer.dll" in an uncommon folder, which could be a sign of WerFault DLL hijacking.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Creation of WerFault.exe/Wer.dll in Unusual Folder</description>
    <match>(((TargetFilename=\"*\\\\WerFault.exe\" OR TargetFilename=\"*\\\\wer.dll\")) AND NOT ((((TargetFilename=\"C:\\\\Windows\\\\SoftwareDi</match>
  </rule>
</group>
