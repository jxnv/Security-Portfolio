<!--
  Title: PUA - RunXCmd Execution
  ID: 93199800-b52a-4dec-b762-75212c196542
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems)
  Date: 2022-01-24
  Description: Detects the use of the RunXCmd tool to execute commands with System or TrustedInstaller accounts
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>PUA - RunXCmd Execution</description>
    <match>(((CommandLine=\"* /account=system *\" OR CommandLine=\"* /account=ti *\")) AND (CommandLine=\"*/exec=*\"))</match>
  </rule>
</group>
