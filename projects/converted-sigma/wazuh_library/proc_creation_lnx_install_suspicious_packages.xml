<!--
  Title: Suspicious Package Installed - Linux
  ID: 700fb7e8-2981-401c-8430-be58e189e741
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2023-01-03
  Description: Detects installation of suspicious packages using system installation utilities
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious Package Installed - Linux</description>
    <match>((((Image=\"*/apt\" OR Image=\"*/apt-get\") AND CommandLine=\"*install*\") OR (Image=\"*/dpkg\" AND (CommandLine=\"*--install*\" O</match>
  </rule>
</group>
