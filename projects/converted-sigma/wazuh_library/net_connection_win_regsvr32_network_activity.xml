<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Network Connection Initiated By Regsvr32.EXE</description>
    <match>(Initiated=\"true\" AND Image=\"*\\\\regsvr32.exe\")</match>
  </rule>
</group>
