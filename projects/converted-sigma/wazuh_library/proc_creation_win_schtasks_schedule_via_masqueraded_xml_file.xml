<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious Scheduled Task Creation via Masqueraded XML File</description>
    <match>((((CommandLine=\"*/create*\" OR CommandLine=\"*-create*\")) AND ((CommandLine=\"*/xml*\" OR CommandLine=\"*-xml*\")) AND ((Imag</match>
  </rule>
</group>
