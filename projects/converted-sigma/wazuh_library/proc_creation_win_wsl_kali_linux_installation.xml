<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Installation of WSL Kali-Linux</description>
    <match>(((Image=\"*\\\\wsl.exe\") OR (OriginalFileName=\"wsl\")) AND ((CommandLine=\"* --install *\" OR CommandLine=\"* -i *\")) AND (Com</match>
  </rule>
</group>
