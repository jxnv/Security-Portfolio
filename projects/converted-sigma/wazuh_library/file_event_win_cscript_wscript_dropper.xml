  Date: 2022-01-10
  Description: Detects a file ending in jse, vbe, js, vba, vbs, wsf, wsh written by cscript.exe or wscript.exe
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>WScript or CScript Dropper - File</description>
    <match>((Image=\"*\\\\wscript.exe\" OR Image=\"*\\\\cscript.exe\") AND (TargetFilename=\"*:\\\\Perflogs\\\\*\" OR TargetFilename=\"*:\\\\Program</match>
  </rule>
</group>
