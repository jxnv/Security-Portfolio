<!--
  Title: DNS TXT Answer with Possible Execution Strings
  ID: 8ae51330-899c-4641-8125-e39f2e07da72
  Status: test
  Level: high
  Author: Markus Neis
  Date: 2018-08-08
  Description: Detects strings used in command execution in DNS TXT Answer
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>DNS TXT Answer with Possible Execution Strings</description>
    <match>(record_type=\"TXT\" AND (answer=\"*IEX*\" OR answer=\"*Invoke-Expression*\" OR answer=\"*cmd.exe*\"))</match>
  </rule>
</group>
