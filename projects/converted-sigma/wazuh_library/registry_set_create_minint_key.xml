<!--
  Title: Security Event Logging Disabled via MiniNt Registry Key - Registry Set
  ID: 8839e550-52d7-4958-9f2f-e13c1e736838
  Status: experimental
  Level: high
  Author: Swachchhanda Shrawan Poudel (Nextron Systems)
  Date: 2025-04-09
  Description: Detects the addition of the 'MiniNt' key to the registry. Upon a reboot, Windows Event Log service will stop writing events. Windows Event Log is a service that collects and stores event logs from the operating system and applications. It is an important component of Windows security and auditing. Adversary may want to disable this service to disable logging of security events which could be used to detect their activities.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Security Event Logging Disabled via MiniNt Registry Key - Registry Set</description>
    <match>(TargetObject=\"HKLM\\\\System\\\\CurrentControlSet\\\\Control\\\\MiniNt\\\\(Default)\")</match>
  </rule>
</group>
