<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Windows WebDAV User Agent</description>
    <match>(c-useragent=\"Microsoft-WebDAV-MiniRedir/*\" AND cs-method=\"GET\")</match>
  </rule>
</group>
