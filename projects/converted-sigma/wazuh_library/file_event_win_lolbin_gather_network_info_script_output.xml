  Description: Detects creation of files which are the results of executing the built-in reconnaissance script "C:\Windows\System32\gatherNetworkInfo.vbs".
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>GatherNetworkInfo.VBS Reconnaissance Script Output</description>
    <match>(TargetFilename=\"C:\\\\Windows\\\\System32\\\\config*\" AND (TargetFilename=\"*\\\\Hotfixinfo.txt\" OR TargetFilename=\"*\\\\netiostat</match>
  </rule>
</group>
