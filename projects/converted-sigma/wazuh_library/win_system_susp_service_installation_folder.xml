<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Service Installation in Suspicious Folder</description>
    <match>((Provider_Name=\"Service Control Manager\" AND EventID=\"7045\" AND (ImagePath=\"*\\\\AppData\\\\*\" OR ImagePath=\"*\\\\\\\\\\\\\\\\127.0</match>
  </rule>
</group>
