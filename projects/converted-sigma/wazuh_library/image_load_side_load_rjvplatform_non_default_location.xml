<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potential RjvPlatform.DLL Sideloading From Non-Default Location</description>
    <match>((ImageLoaded=\"*\\\\RjvPlatform.dll\" AND Image=\"\\\\SystemResetPlatform.exe\") AND NOT ((Image=\"C:\\\\Windows\\\\System32\\\\System</match>
  </rule>
</group>
