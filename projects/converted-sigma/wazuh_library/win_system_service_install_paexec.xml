<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>PAExec Service Installation</description>
    <match>((Provider_Name=\"Service Control Manager\" AND EventID=\"7045\") AND ((ServiceName=\"PAExec-*\") OR (ImagePath=\"C:\\\\WINDOWS\\\\</match>
  </rule>
</group>
