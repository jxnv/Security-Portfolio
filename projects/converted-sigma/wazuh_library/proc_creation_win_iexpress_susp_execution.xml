<!--
  Title: Self Extracting Package Creation Via Iexpress.EXE From Potentially Suspicious Location
  ID: b2b048b0-7857-4380-b0fb-d3f0ab820b71
  Status: test
  Level: high
  Author: Joseliyo Sanchez, @Joseliyo_Jstnk, Nasreddine Bencherchali (Nextron Systems)
  Date: 2024-02-05
  Description: Detects the use of iexpress.exe to create binaries via Self Extraction Directive (SED) files located in potentially suspicious locations. This behavior has been observed in-the-wild by different threat actors.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Self Extracting Package Creation Via Iexpress.EXE From Potentially Suspicious Location</description>
    <match>((CommandLine=\"* /n *\") AND ((Image=\"*\\\\iexpress.exe\") OR (OriginalFileName=\"IEXPRESS.exe\")) AND ((CommandLine=\"*:\\\\Prog</match>
  </rule>
</group>
