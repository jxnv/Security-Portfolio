<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>HackTool - Htran/NATBypass Execution</description>
    <match>(((CommandLine=\"*.exe -tran *\" OR CommandLine=\"*.exe -slave *\")) OR ((Image=\"*\\\\htran.exe\" OR Image=\"*\\\\lcx.exe\")))</match>
  </rule>
</group>
