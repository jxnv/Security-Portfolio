<!--
  Title: Potentially Suspicious Event Viewer Child Process
  ID: be344333-921d-4c4d-8bb8-e584cf584780
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems)
  Date: 2017-03-19
  Description: Detects uncommon or suspicious child processes of "eventvwr.exe" which might indicate a UAC bypass attempt
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potentially Suspicious Event Viewer Child Process</description>
    <match>((ParentImage=\"*\\\\eventvwr.exe\") AND NOT (((Image=\"*:\\\\Windows\\\\System32\\\\mmc.exe\" OR Image=\"*:\\\\Windows\\\\System32\\\\WerF</match>
  </rule>
</group>
