<!--
  Title: Potential Application Whitelisting Bypass via Dnx.EXE
  ID: 81ebd28b-9607-4478-bf06-974ed9d53ed7
  Status: test
  Level: medium
  Author: Beyu Denis, oscd.community
  Date: 2019-10-26
  Description: Detects the execution of Dnx.EXE. The Dnx utility allows for the execution of C# code. Attackers might abuse this in order to bypass application whitelisting.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential Application Whitelisting Bypass via Dnx.EXE</description>
    <match>(Image=\"*\\\\dnx.exe\")</match>
  </rule>
</group>
