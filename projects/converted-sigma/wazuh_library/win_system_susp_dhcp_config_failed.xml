<!--
  Title: DHCP Server Error Failed Loading the CallOut DLL
  ID: 75edd3fd-7146-48e5-9848-3013d7f0282c
  Status: test
  Level: high
  Author: Dimitrios Slamaris, @atc_project (fix)
  Date: 2017-05-15
  Description: This rule detects a DHCP server error in which a specified Callout DLL (in registry) could not be loaded
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>DHCP Server Error Failed Loading the CallOut DLL</description>
    <match>((EventID=\"1031\" OR EventID=\"1032\" OR EventID=\"1034\") AND Provider_Name=\"Microsoft-Windows-DHCP-Server\")</match>
  </rule>
</group>
