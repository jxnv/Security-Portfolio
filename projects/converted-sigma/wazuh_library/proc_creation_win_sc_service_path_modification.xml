    <description>Suspicious Service Path Modification</description>
    <match>(Image=\"*\\\\sc.exe\" AND (CommandLine=\"*config*\" AND CommandLine=\"*binPath*\") AND (CommandLine=\"*powershell*\" OR CommandLi</match>
  </rule>
</group>
