<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Bitbucket User Login Failure Via SSH</description>
    <match>(auditType.category=\"Authentication\" AND auditType.action=\"User login failed(SSH)\")</match>
  </rule>
</group>
