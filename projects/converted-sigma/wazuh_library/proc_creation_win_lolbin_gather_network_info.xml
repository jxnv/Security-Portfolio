<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential Reconnaissance Activity Via GatherNetworkInfo.VBS</description>
    <match>((CommandLine=\"*gatherNetworkInfo.vbs*\") AND (((Image=\"*\\\\cscript.exe\" OR Image=\"*\\\\wscript.exe\")) OR ((OriginalFileName</match>
  </rule>
</group>
