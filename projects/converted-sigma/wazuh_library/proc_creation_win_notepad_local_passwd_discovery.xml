<!--
  Title: Notepad Password Files Discovery
  ID: 3b4e950b-a3ea-44d3-877e-432071990709
  Status: experimental
  Level: low
  Author: The DFIR Report
  Date: 2025-02-21
  Description: Detects the execution of Notepad to open a file that has the string "password" which may indicate unauthorized access to credentials or suspicious activity.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Notepad Password Files Discovery</description>
    <match>(ParentImage=\"*\\\\explorer.exe\" AND Image=\"*\\\\notepad.exe\" AND (CommandLine=\"*password*.txt\" OR CommandLine=\"*password*.c</match>
  </rule>
</group>
