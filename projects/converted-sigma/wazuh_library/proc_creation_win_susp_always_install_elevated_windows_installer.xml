-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Always Install Elevated Windows Installer</description>
    <match>((((Image=\"*\\\\Windows\\\\Installer\\\\*\" AND Image=\"*msi*\") AND Image=\"*tmp\") OR (Image=\"*\\\\msiexec.exe\" AND (IntegrityLevel</match>
  </rule>
</group>
