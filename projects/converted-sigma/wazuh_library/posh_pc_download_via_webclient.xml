<!--
  Title: PowerShell Download Via Net.WebClient - PowerShell Classic
  ID: 3236fcd0-b7e3-4433-b4f8-86ad61a9af2d
  Status: test
  Level: low
  Author: Florian Roth (Nextron Systems)
  Date: 2017-03-05
  Description: Detects PowerShell download activity, via the .DownloadFile() or .DownloadString() methods of the Net.WebClient class. This technique is often abused by attackers to download additional payloads.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>PowerShell Download Via Net.WebClient - PowerShell Classic</description>
    <match>(((Data=\"*.DownloadFile(*\" OR Data=\"*.DownloadString(*\")) AND (Data=\"*Net.WebClient*\"))</match>
  </rule>
</group>
