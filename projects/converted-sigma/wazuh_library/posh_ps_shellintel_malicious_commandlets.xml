<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Malicious ShellIntel PowerShell Commandlets</description>
    <match>((ScriptBlockText=\"*Invoke-SMBAutoBrute*\" OR ScriptBlockText=\"*Invoke-GPOLinks*\" OR ScriptBlockText=\"*Invoke-Potato*\"))</match>
  </rule>
</group>
