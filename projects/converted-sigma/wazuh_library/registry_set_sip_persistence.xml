<!--
  Title: Persistence Via New SIP Provider
  ID: 5a2b21ee-6aaa-4234-ac9d-59a59edf90a1
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-07-21
  Description: Detects when an attacker register a new SIP provider for persistence and defense evasion
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Persistence Via New SIP Provider</description>
    <match>((((TargetObject=\"*\\\\Dll*\" OR TargetObject=\"*\\\\$DLL*\")) AND ((TargetObject=\"*\\\\SOFTWARE\\\\Microsoft\\\\Cryptography\\\\Provid</match>
  </rule>
</group>
