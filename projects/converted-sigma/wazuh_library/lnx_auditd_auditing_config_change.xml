<!--
  Title: Auditing Configuration Changes on Linux Host
  ID: 977ef627-4539-4875-adf4-ed8f780c4922
  Status: test
  Level: high
  Author: Mikhail Larin, oscd.community
  Date: 2019-10-25
  Description: Detect changes in auditd configuration files
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Auditing Configuration Changes on Linux Host</description>
    <match>(type=\"PATH\" AND (name=\"/etc/audit/*\" OR name=\"/etc/libaudit.conf\" OR name=\"/etc/audisp/*\"))</match>
  </rule>
</group>
