<!--
  Title: Active Directory Structure Export Via Csvde.EXE
  ID: e5d36acd-acb4-4c6f-a13f-9eb203d50099
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2023-03-14
  Description: Detects the execution of "csvde.exe" in order to export organizational Active Directory structure.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Active Directory Structure Export Via Csvde.EXE</description>
    <match>((((Image=\"*\\\\csvde.exe\") OR (OriginalFileName=\"csvde.exe\")) AND (CommandLine=\"* -f*\")) AND NOT ((CommandLine=\"* -i*\")))</match>
  </rule>
</group>
