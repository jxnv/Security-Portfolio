<!--
  Title: Compressed File Extraction Via Tar.EXE
  ID: bf361876-6620-407a-812f-bfe11e51e924
  Status: test
  Level: low
  Author: AdmU3
  Date: 2023-12-19
  Description: Detects execution of "tar.exe" in order to extract compressed file. Adversaries may abuse various utilities in order to decompress data to avoid detection.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Compressed File Extraction Via Tar.EXE</description>
    <match>((CommandLine=\"*-x*\") AND ((Image=\"*\\\\tar.exe\") OR (OriginalFileName=\"bsdtar\")))</match>
  </rule>
</group>
