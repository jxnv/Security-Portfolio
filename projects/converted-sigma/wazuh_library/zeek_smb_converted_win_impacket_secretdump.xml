<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Possible Impacket SecretDump Remote Activity - Zeek</description>
    <match>((path=\"*\\\\*\" AND path=\"*ADMIN$*\") AND name=\"*SYSTEM32\\\\*\" AND name=\"*.tmp\")</match>
  </rule>
</group>
