<!--
  Title: PowerShell Set-Acl On Windows Folder - PsScript
  ID: 3bf1d859-3a7e-44cb-8809-a99e066d3478
  Status: test
  Level: high
  Author: frack113, Nasreddine Bencherchali (Nextron Systems)
  Date: 2023-07-18
  Description: Detects PowerShell scripts to set the ACL to a file in the Windows folder
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>PowerShell Set-Acl On Windows Folder - PsScript</description>
    <match>(((ScriptBlockText=\"*Set-Acl *\" AND ScriptBlockText=\"*-AclObject *\")) AND ((ScriptBlockText=\"*-Path \\\"C:\\\\Windows*\" OR S</match>
  </rule>
</group>
