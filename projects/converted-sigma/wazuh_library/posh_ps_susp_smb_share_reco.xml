<!--
  Title: Suspicious Get Information for SMB Share
  ID: 95f0643a-ed40-467c-806b-aac9542ec5ab
  Status: test
  Level: low
  Author: frack113
  Date: 2021-12-15
  Description: Adversaries may look for folders and drives shared on remote systems as a means of identifying sources of information to gather as a precursor for Collection and to identify potential systems of interest for Lateral Movement. Networks often contain shared network drives and folders that enable users to access file directories on various systems across a network.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious Get Information for SMB Share</description>
    <match>(ScriptBlockText=\"*get-smbshare*\")</match>
  </rule>
</group>
