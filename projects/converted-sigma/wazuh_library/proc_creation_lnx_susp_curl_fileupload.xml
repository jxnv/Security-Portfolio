<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious Curl File Upload - Linux</description>
    <match>(((((CommandLine=\"* --form*\" OR CommandLine=\"* --upload-file *\" OR CommandLine=\"* --data *\" OR CommandLine=\"* --data-*\")</match>
  </rule>
</group>
