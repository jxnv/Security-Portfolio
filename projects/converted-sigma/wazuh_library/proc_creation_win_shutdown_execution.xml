<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious Execution of Shutdown</description>
    <match>(Image=\"*\\\\shutdown.exe\" AND (CommandLine=\"*/r *\" OR CommandLine=\"*/s *\"))</match>
  </rule>
</group>
