<!--
  Title: Kerberos Network Traffic RC4 Ticket Encryption
  ID: 503fe26e-b5f2-4944-a126-eab405cc06e5
  Status: test
  Level: medium
  Author: sigma
  Date: 2020-02-12
  Description: Detects kerberos TGS request using RC4 encryption which may be indicative of kerberoasting
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Kerberos Network Traffic RC4 Ticket Encryption</description>
    <match>((request_type=\"TGS\" AND cipher=\"rc4-hmac\") AND NOT ((service=\"$*\")))</match>
  </rule>
</group>
