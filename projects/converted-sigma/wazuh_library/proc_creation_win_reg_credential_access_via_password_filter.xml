<!--
  Title: Dropping Of Password Filter DLL
  ID: b7966f4a-b333-455b-8370-8ca53c229762
  Status: test
  Level: medium
  Author: Sreeman
  Date: 2020-10-29
  Description: Detects dropping of dll files in system32 that may be used to retrieve user credentials from LSASS
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Dropping Of Password Filter DLL</description>
    <match>((CommandLine=\"*HKLM\\\\SYSTEM\\\\CurrentControlSet\\\\Control\\\\Lsa*\" AND CommandLine=\"*scecli\\\\0**\" AND CommandLine=\"*reg add</match>
  </rule>
</group>
