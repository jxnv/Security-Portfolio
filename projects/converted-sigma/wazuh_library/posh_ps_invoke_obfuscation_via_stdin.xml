<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Invoke-Obfuscation Via Stdin - Powershell</description>
    <match>(ScriptBlockText=regex(\"(?i)(set).*&&\\\\s?set.*(environment|invoke|\\\\$\\\\{?input).*&&.*\\\"\"))</match>
  </rule>
</group>
