<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>New Root or CA or AuthRoot Certificate to Store</description>
    <match>((TargetObject=\"*\\\\SOFTWARE\\\\Microsoft\\\\SystemCertificates\\\\Root\\\\Certificates\\\\*\" OR TargetObject=\"*\\\\SOFTWARE\\\\Policie</match>
  </rule>
</group>
