<!--
  Title: Potential Discovery Activity Via Dnscmd.EXE
  ID: b6457d63-d2a2-4e29-859d-4e7affc153d1
  Status: test
  Level: medium
  Author: @gott_cyber
  Date: 2022-07-31
  Description: Detects an attempt to leverage dnscmd.exe to enumerate the DNS zones of a domain. DNS zones used to host the DNS records for a particular domain.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential Discovery Activity Via Dnscmd.EXE</description>
    <match>(((CommandLine=\"*/enumrecords*\" OR CommandLine=\"*/enumzones*\" OR CommandLine=\"*/ZonePrint*\" OR CommandLine=\"*/info*\")) A</match>
  </rule>
</group>
