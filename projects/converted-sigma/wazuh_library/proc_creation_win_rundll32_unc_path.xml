    <match>((((CommandLine=\"* \\\\\\\\\\\\\\\\*\" OR CommandLine=\"* '\\\\\\\\\\\\\\\\*\" OR CommandLine=\"* \\\"\\\\\\\\\\\\\\\\*\")) AND ((Image=\"*\\\\rundll32.ex</match>
  </rule>
