<!--
  Title: Run PowerShell Script from ADS
  ID: 45a594aa-1fbd-4972-a809-ff5a99dd81b8
  Status: test
  Level: high
  Author: Sergey Soldatov, Kaspersky Lab, oscd.community
  Date: 2019-10-30
  Description: Detects PowerShell script execution from Alternate Data Stream (ADS)
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Run PowerShell Script from ADS</description>
    <match>((ParentImage=\"*\\\\powershell.exe\" OR ParentImage=\"*\\\\pwsh.exe\") AND (Image=\"*\\\\powershell.exe\" OR Image=\"*\\\\pwsh.exe\") A</match>
  </rule>
</group>
