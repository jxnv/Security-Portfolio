<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Email Exifiltration Via Powershell</description>
    <match>((Image=\"*\\\\powershell.exe\" OR Image=\"*\\\\pwsh.exe\") AND (CommandLine=\"*Add-PSSnapin*\" AND CommandLine=\"*Get-Recipient*\" </match>
  </rule>
</group>
