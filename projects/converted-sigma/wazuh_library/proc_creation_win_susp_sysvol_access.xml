<!--
  Title: Suspicious SYSVOL Domain Group Policy Access
  ID: 05f3c945-dcc8-4393-9f3d-af65077a8f86
  Status: test
  Level: medium
  Author: Markus Neis, Jonhnathan Ribeiro, oscd.community
  Date: 2018-04-09
  Description: Detects Access to Domain Group Policies stored in SYSVOL
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious SYSVOL Domain Group Policy Access</description>
    <match>((CommandLine=\"*\\\\SYSVOL\\\\*\" AND CommandLine=\"*\\\\policies\\\\*\"))</match>
  </rule>
</group>
