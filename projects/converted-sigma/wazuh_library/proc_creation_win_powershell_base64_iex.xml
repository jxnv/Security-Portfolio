<!--
  Title: PowerShell Base64 Encoded IEX Cmdlet
  ID: 88f680b8-070e-402c-ae11-d2914f2257f1
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems)
  Date: 2019-08-23
  Description: Detects usage of a base64 encoded "IEX" cmdlet in a process command line
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>PowerShell Base64 Encoded IEX Cmdlet</description>
    <match>(((CommandLine=\"*SUVYIChb*\" OR CommandLine=\"*lFWCAoW*\" OR CommandLine=\"*JRVggKF*\" OR CommandLine=\"*aWV4IChb*\" OR Command</match>
  </rule>
</group>
