<!--
  Title: Potential Rundll32 Execution With DLL Stored In ADS
  ID: 9248c7e1-2bf3-4661-a22c-600a8040b446
  Status: test
  Level: high
  Author: Harjot Singh, '@cyb3rjy0t'
  Date: 2023-01-21
  Description: Detects execution of rundll32 where the DLL being called is stored in an Alternate Data Stream (ADS).
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potential Rundll32 Execution With DLL Stored In ADS</description>
    <match>((CommandLine=regex(\"[Rr][Uu][Nn][Dd][Ll][Ll]32(?:\\\\.[Ee][Xx][Ee])? \\\\S+?\\\\w:\\\\S+?:\")) AND ((Image=\"*\\\\rundll32.exe\") OR</match>
  </rule>
</group>
