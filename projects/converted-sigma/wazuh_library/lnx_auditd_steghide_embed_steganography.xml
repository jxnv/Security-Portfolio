<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Steganography Hide Files with Steghide</description>
    <match>(type=\"EXECVE\" AND a0=\"steghide\" AND a1=\"embed\" AND (a2=\"-cf\" OR a2=\"-ef\") AND (a4=\"-cf\" OR a4=\"-ef\"))</match>
  </rule>
</group>
