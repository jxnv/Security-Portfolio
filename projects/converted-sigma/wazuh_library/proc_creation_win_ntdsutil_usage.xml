<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Invocation of Active Directory Diagnostic Tool (ntdsutil.exe)</description>
    <match>(Image=\"*\\\\ntdsutil.exe\")</match>
  </rule>
</group>
