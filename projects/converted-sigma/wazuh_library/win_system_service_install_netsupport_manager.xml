<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>NetSupport Manager Service Install</description>
    <match>((Provider_Name=\"Service Control Manager\" AND EventID=\"7045\") AND ((ImagePath=\"*\\\\NetSupport Manager\\\\client32.exe*\") OR</match>
  </rule>
</group>
