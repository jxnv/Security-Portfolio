    <match>((CommandLine=\"*REG*\" AND CommandLine=\"*ADD*\" AND CommandLine=\"*\\\\SOFTWARE\\\\Policies\\\\Microsoft\\\\FVE*\" AND CommandLine=\"</match>
  </rule>
</group>
