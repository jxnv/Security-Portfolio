<!--
  Title: MacOS Network Service Scanning
  ID: 84bae5d4-b518-4ae0-b331-6d4afd34d00f
  Status: test
  Level: low
  Author: Alejandro Ortuno, oscd.community
  Date: 2020-10-21
  Description: Detects enumeration of local or remote network services.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>MacOS Network Service Scanning</description>
    <match>((((Image=\"*/nc\" OR Image=\"*/netcat\")) AND NOT ((CommandLine=\"*l*\"))) OR ((Image=\"*/nmap\" OR Image=\"*/telnet\")))</match>
  </rule>
</group>
