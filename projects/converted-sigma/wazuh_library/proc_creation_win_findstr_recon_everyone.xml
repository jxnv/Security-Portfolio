<!--
  Title: Permission Misconfiguration Reconnaissance Via Findstr.EXE
  ID: 47e4bab7-c626-47dc-967b-255608c9a920
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-08-12
  Description: Detects usage of findstr with the "EVERYONE" or "BUILTIN" keywords. This was seen being used in combination with "icacls" and other utilities to spot misconfigured files or folders permissions.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Permission Misconfiguration Reconnaissance Via Findstr.EXE</description>
    <match>((((CommandLine=\"*\\\"Everyone\\\"*\" OR CommandLine=\"*'Everyone'*\" OR CommandLine=\"*\\\"BUILTIN\\\\\\\\\\\"*\" OR CommandLine=\"*'BUIL</match>
  </rule>
</group>
