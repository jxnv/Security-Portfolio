<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious PowerShell Parameter Substring</description>
    <match>((Image=\"*\\\\powershell.exe\" OR Image=\"*\\\\pwsh.exe\") AND (CommandLine=\"* -windowstyle h *\" OR CommandLine=\"* -windowstyl </match>
  </rule>
</group>
