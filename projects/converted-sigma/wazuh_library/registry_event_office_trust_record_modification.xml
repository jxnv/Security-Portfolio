<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Windows Registry Trust Record Modification</description>
    <match>(TargetObject=\"*\\\\Security\\\\Trusted Documents\\\\TrustRecords*\")</match>
  </rule>
</group>
