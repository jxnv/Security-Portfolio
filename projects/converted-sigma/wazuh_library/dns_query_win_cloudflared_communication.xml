<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Cloudflared Tunnels Related DNS Requests</description>
    <match>((QueryName=\"*.v2.argotunnel.com\" OR QueryName=\"*protocol-v2.argotunnel.com\" OR QueryName=\"*trycloudflare.com\" OR QueryN</match>
  </rule>
</group>
