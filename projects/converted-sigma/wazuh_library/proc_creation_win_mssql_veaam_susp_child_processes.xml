<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Child Process Of Veeam Dabatase</description>
    <match>((ParentImage=\"*\\\\sqlservr.exe\" AND ParentCommandLine=\"*VEEAMSQL*\") AND (((Image=\"*\\\\cmd.exe\" OR Image=\"*\\\\powershell.ex</match>
  </rule>
</group>
