<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Disable Important Scheduled Task</description>
    <match>(((CommandLine=\"*/disable*\" OR CommandLine=\"*-disable*\")) AND ((CommandLine=\"*\\\\Windows\\\\BitLocker*\" OR CommandLine=\"*\\\\</match>
  </rule>
</group>
