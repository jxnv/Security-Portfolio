<!--
  Title: Potential PHP Reverse Shell
  ID: c6714a24-d7d5-4283-a36b-3ffd091d5f7e
  Status: test
  Level: high
  Author: @d4ns4n_
  Date: 2023-04-07
  Description: Detects usage of the PHP CLI with the "-r" flag which allows it to run inline PHP code. The rule looks for calls to the "fsockopen" function which allows the creation of sockets. Attackers often leverage this in combination with functions such as "exec" or "fopen" to initiate a reverse shell connection.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potential PHP Reverse Shell</description>
    <match>(Image=\"*/php*\" AND (CommandLine=\"* -r *\" AND CommandLine=\"*fsockopen*\") AND (CommandLine=\"*ash*\" OR CommandLine=\"*bash*</match>
  </rule>
</group>
