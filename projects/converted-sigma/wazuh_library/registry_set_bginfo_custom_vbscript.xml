<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>New BgInfo.EXE Custom VBScript Registry Configuration</description>
    <match>(TargetObject=\"*\\\\Software\\\\Winternals\\\\BGInfo\\\\UserFields\\\\*\" AND Details=\"4*\")</match>
  </rule>
</group>
