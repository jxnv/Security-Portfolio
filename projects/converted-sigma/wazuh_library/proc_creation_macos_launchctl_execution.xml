  Date: 2024-05-13
  Description: Detects the execution of programs as Launch Agents or Launch Daemons using launchctl on macOS.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Launch Agent/Daemon Execution Via Launchctl</description>
    <match>(Image=\"*/launchctl\" AND (CommandLine=\"*submit*\" OR CommandLine=\"*load*\" OR CommandLine=\"*start*\"))</match>
  </rule>
</group>
