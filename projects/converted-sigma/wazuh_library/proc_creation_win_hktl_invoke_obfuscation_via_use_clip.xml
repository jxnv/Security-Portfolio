<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Invoke-Obfuscation Via Use Clip</description>
    <match>(CommandLine=regex(\"(?i)echo.*clip.*&&.*(?:Clipboard|i`?n`?v`?o`?k`?e`?)\"))</match>
  </rule>
</group>
