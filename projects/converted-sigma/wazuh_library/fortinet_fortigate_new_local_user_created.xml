  Description: Detects the creation of a new local user on a Fortinet FortiGate Firewall. The new local user could be used for VPN connections.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>FortiGate - New Local User Created</description>
    <match>(action=\"Add\" AND cfgpath=\"user.local\")</match>
  </rule>
</group>
