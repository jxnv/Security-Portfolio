<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious SSL Connection</description>
    <match>((ScriptBlockText=\"*System.Net.Security.SslStream*\" AND ScriptBlockText=\"*Net.Security.RemoteCertificateValidationCallba</match>
  </rule>
</group>
