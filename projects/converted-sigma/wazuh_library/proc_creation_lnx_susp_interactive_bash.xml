<!--
  Title: Interactive Bash Suspicious Children
  ID: ea3ecad2-db86-4a89-ad0b-132a10d2db55
  Status: test
  Level: medium
  Author: Florian Roth (Nextron Systems)
  Date: 2022-03-14
  Description: Detects suspicious interactive bash as a parent to rather uncommon child processes
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Interactive Bash Suspicious Children</description>
    <match>((ParentCommandLine=\"bash -i\") AND (((CommandLine=\"*-c import *\" OR CommandLine=\"*base64*\" OR CommandLine=\"*pty.spawn*\")</match>
  </rule>
</group>
