<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>System File Execution Location Anomaly</description>
    <match>(((Image=\"*\\\\atbroker.exe\" OR Image=\"*\\\\audiodg.exe\" OR Image=\"*\\\\bcdedit.exe\" OR Image=\"*\\\\bitsadmin.exe\" OR Image=\"*\\\\</match>
  </rule>
</group>
