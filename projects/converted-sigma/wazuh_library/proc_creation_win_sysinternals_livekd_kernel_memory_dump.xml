<!--
  Title: Kernel Memory Dump Via LiveKD
  ID: c7746f1c-47d3-43d6-8c45-cd1e54b6b0a2
  Status: test
  Level: high
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2023-05-16
  Description: Detects execution of LiveKD with the "-m" flag to potentially dump the kernel memory
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Kernel Memory Dump Via LiveKD</description>
    <match>((CommandLine=\"* -m*\") AND (((Image=\"*\\\\livekd.exe\" OR Image=\"*\\\\livekd64.exe\")) OR (OriginalFileName=\"livekd.exe\")))</match>
  </rule>
</group>
