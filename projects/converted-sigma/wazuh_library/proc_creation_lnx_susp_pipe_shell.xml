<!--
  Title: Linux Shell Pipe to Shell
  ID: 880973f3-9708-491c-a77b-2a35a1921158
  Status: test
  Level: medium
  Author: Florian Roth (Nextron Systems)
  Date: 2022-03-14
  Description: Detects suspicious process command line that starts with a shell that executes something and finally gets piped into another shell
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Linux Shell Pipe to Shell</description>
    <match>(((CommandLine=\"sh -c *\" OR CommandLine=\"bash -c *\")) AND (((CommandLine=\"*| bash *\" OR CommandLine=\"*| sh *\" OR Command</match>
  </rule>
</group>
