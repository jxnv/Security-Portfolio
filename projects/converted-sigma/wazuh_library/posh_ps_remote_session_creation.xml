<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>PowerShell Remote Session Creation</description>
    <match>((ScriptBlockText=\"*New-PSSession*\" AND ScriptBlockText=\"*-ComputerName *\"))</match>
  </rule>
</group>
