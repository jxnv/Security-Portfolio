  Description: Detects UTF-8 and UTF-16 Base64 encoded powershell 'Invoke-' calls
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>PowerShell Base64 Encoded Invoke Keyword</description>
    <match>((CommandLine=\"* -e*\") AND ((CommandLine=\"*SQBuAHYAbwBrAGUALQ*\" OR CommandLine=\"*kAbgB2AG8AawBlAC0A*\" OR CommandLine=\"*J</match>
  </rule>
</group>
