<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Renamed Microsoft Teams Execution</description>
    <match>(((OriginalFileName=\"msteams.exe\" OR OriginalFileName=\"teams.exe\")) AND NOT (((Image=\"*\\\\msteams.exe\" OR Image=\"*\\\\teams</match>
  </rule>
</group>
