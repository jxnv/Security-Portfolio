<!--
  Title: Registry Modification of MS-settings Protocol Handler
  ID: dd3ee8cc-f751-41c9-ba53-5a32ed47e563
  Status: test
  Level: medium
  Author: frack113, Swachchhanda Shrawan Poudel (Nextron Systems)
  Date: 2021-12-20
  Description: Detects registry modifications to the 'ms-settings' protocol handler, which is frequently targeted for UAC bypass or persistence. Attackers can modify this registry to execute malicious code with elevated privileges by hijacking the command execution path.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Registry Modification of MS-settings Protocol Handler</description>
    <match>((((CommandLine=\"*add*\") AND ((Image=\"*\\\\reg.exe\") OR (OriginalFileName=\"reg.exe\"))) OR (((CommandLine=\"*New-ItemPropert</match>
  </rule>
</group>
