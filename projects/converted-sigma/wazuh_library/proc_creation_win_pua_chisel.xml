<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>PUA - Chisel Tunneling Tool Execution</description>
    <match>((Image=\"*\\\\chisel.exe\") OR (((CommandLine=\"*exe client *\" OR CommandLine=\"*exe server *\")) AND ((CommandLine=\"*-socks5*</match>
  </rule>
</group>
