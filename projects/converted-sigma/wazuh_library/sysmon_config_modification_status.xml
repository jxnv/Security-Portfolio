<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Sysmon Configuration Modification</description>
    <match>(((\"Sysmon config state changed\") OR (State=\"Stopped\")) AND NOT ((State=\"Started\")))</match>
  </rule>
</group>
