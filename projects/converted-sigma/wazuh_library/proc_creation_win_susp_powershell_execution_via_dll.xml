  Description: Detects potential PowerShell execution from a DLL instead of the usual PowerShell process as seen used in PowerShdll. This detection assumes that PowerShell commands are passed via the CommandLine.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potential PowerShell Execution Via DLL</description>
    <match>(((CommandLine=\"*Default.GetString*\" OR CommandLine=\"*DownloadString*\" OR CommandLine=\"*FromBase64String*\" OR CommandLin</match>
  </rule>
</group>
