<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Bypass UAC via CMSTP</description>
    <match>(((CommandLine=\"*/s*\" OR CommandLine=\"*-s*\" OR CommandLine=\"*/au*\" OR CommandLine=\"*-au*\" OR CommandLine=\"*/ni*\" OR Comm</match>
  </rule>
</group>
