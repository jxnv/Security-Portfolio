<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Schtasks Execution AppData Folder</description>
    <match>((Image=\"*\\\\schtasks.exe\" AND (CommandLine=\"*/Create*\" AND CommandLine=\"*/RU*\" AND CommandLine=\"*/TR*\" AND CommandLine=\"</match>
  </rule>
</group>
