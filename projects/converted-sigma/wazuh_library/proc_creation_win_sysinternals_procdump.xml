<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Procdump Execution</description>
    <match>((Image=\"*\\\\procdump.exe\" OR Image=\"*\\\\procdump64.exe\" OR Image=\"*\\\\procdump64a.exe\"))</match>
  </rule>
</group>
