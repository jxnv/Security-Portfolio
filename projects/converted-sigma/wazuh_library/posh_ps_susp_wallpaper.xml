<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Replace Desktop Wallpaper by Powershell</description>
    <match>(((ScriptBlockText=\"*Get-ItemProperty*\" AND ScriptBlockText=\"*Registry::*\" AND ScriptBlockText=\"*HKEY_CURRENT_USER\\\\Cont</match>
  </rule>
</group>
