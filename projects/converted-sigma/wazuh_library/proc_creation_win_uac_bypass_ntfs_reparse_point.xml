<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>UAC Bypass Using NTFS Reparse Point - Process</description>
    <match>((CommandLine=\"\\\"C:\\\\Windows\\\\system32\\\\wusa.exe\\\"  /quiet C:\\\\Users\\\\*\" AND CommandLine=\"*\\\\AppData\\\\Local\\\\Temp\\\\updat</match>
  </rule>
</group>
