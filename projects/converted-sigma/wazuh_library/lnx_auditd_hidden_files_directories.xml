<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Hidden Files and Directories</description>
    <match>(((a1=regex(\"(^|\\\\/)\\\\.[^.\\\\/]\")) OR (a2=regex(\"(^|\\\\/)\\\\.[^.\\\\/]\"))) AND (type=\"EXECVE\" AND (a0=\"mkdir\" OR a0=\"nano\" OR</match>
  </rule>
</group>
