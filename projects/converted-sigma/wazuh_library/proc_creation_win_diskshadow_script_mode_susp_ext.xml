<!--
  Title: Diskshadow Script Mode - Uncommon Script Extension Execution
  ID: 1dde5376-a648-492e-9e54-4241dd9b0c7f
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2023-09-15
  Description: Detects execution of "Diskshadow.exe" in script mode to execute an script with a potentially uncommon extension. Initial baselining of the allowed extension list is required.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Diskshadow Script Mode - Uncommon Script Extension Execution</description>
    <match>((((CommandLine=\"*-s *\" OR CommandLine=\"*/s *\")) AND ((OriginalFileName=\"diskshadow.exe\") OR (Image=\"*\\\\diskshadow.exe\")</match>
  </rule>
</group>
