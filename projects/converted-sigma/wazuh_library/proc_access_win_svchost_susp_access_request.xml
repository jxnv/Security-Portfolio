<!--
  Title: Suspicious Svchost Process Access
  ID: 166e9c50-8cd9-44af-815d-d1f0c0e90dde
  Status: test
  Level: high
  Author: Tim Burrell
  Date: 2020-01-02
  Description: Detects suspicious access to the "svchost" process such as that used by Invoke-Phantom to kill the thread of the Windows event logging service.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Svchost Process Access</description>
    <match>((TargetImage=\"*:\\\\Windows\\\\System32\\\\svchost.exe\" AND GrantedAccess=\"0x1F3FFF\" AND CallTrace=\"*UNKNOWN*\") AND NOT ((Sou</match>
  </rule>
</group>
