<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential Secure Deletion with SDelete</description>
    <match>((EventID=\"4656\" OR EventID=\"4663\" OR EventID=\"4658\") AND (ObjectName=\"*.AAA\" OR ObjectName=\"*.ZZZ\"))</match>
  </rule>
</group>
