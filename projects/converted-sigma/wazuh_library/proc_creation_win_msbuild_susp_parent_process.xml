<!--
  Title: Suspicious Msbuild Execution By Uncommon Parent Process
  ID: 33be4333-2c6b-44f4-ae28-102cdbde0a31
  Status: test
  Level: medium
  Author: frack113
  Date: 2022-11-17
  Description: Detects suspicious execution of 'Msbuild.exe' by a uncommon parent process
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious Msbuild Execution By Uncommon Parent Process</description>
    <match>(((Image=\"*\\\\MSBuild.exe\") OR (OriginalFileName=\"MSBuild.exe\")) AND NOT (((ParentImage=\"*\\\\devenv.exe\" OR ParentImage=\"*</match>
  </rule>
</group>
