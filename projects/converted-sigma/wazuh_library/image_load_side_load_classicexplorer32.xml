<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential DLL Sideloading Via ClassicExplorer32.dll</description>
    <match>((ImageLoaded=\"*\\\\ClassicExplorer32.dll\") AND NOT ((ImageLoaded=\"C:\\\\Program Files\\\\Classic Shell\\\\*\")))</match>
  </rule>
</group>
