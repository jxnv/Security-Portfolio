<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Access To ADMIN$ Network Share</description>
    <match>((EventID=\"5140\" AND ShareName=\"Admin$\") AND NOT ((SubjectUserName=\"*$\")))</match>
  </rule>
</group>
