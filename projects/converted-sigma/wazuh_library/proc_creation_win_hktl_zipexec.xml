<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious ZipExec Execution</description>
    <match>(((CommandLine=\"*/generic:Microsoft_Windows_Shell_ZipFolder:filename=*\" AND CommandLine=\"*.zip*\" AND CommandLine=\"*/pass</match>
  </rule>
</group>
