<!--
  Title: Potential SentinelOne Shell Context Menu Scan Command Tampering
  ID: 6c304b02-06e6-402d-8be4-d5833cdf8198
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2024-03-06
  Description: Detects potentially suspicious changes to the SentinelOne context menu scan command by a process other than SentinelOne.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential SentinelOne Shell Context Menu Scan Command Tampering</description>
    <match>((TargetObject=\"*\\\\shell\\\\SentinelOneScan\\\\command\\\\*\") AND NOT ((((Image=\"*C:\\\\Program Files\\\\SentinelOne\\\\\" OR Image=\"</match>
  </rule>
</group>
