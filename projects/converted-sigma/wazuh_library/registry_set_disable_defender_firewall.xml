<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Disable Microsoft Defender Firewall via Registry</description>
    <match>(TargetObject=\"*\\\\Services\\\\SharedAccess\\\\Parameters\\\\FirewallPolicy\\\\*\" AND TargetObject=\"*\\\\EnableFirewall\" AND Detail</match>
  </rule>
</group>
