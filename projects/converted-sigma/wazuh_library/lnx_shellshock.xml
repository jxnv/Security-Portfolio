<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Shellshock Expression</description>
    <match>(\"(){:;};\" OR \"() {:;};\" OR \"() { :;};\" OR \"() { :; };\")</match>
  </rule>
</group>
