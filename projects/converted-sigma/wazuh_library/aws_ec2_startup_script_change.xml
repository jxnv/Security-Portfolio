<!--
  Title: AWS EC2 Startup Shell Script Change
  ID: 1ab3c5ed-5baf-417b-bb6b-78ca33f6c3df
  Status: test
  Level: high
  Author: faloker
  Date: 2020-02-12
  Description: Detects changes to the EC2 instance startup script. The shell script will be executed as root/SYSTEM every time the specific instances are booted up.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>AWS EC2 Startup Shell Script Change</description>
    <match>(eventSource=\"ec2.amazonaws.com\" AND requestParameters.attribute=\"userData\" AND eventName=\"ModifyInstanceAttribute\")</match>
  </rule>
</group>
