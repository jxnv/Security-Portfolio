<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potential File Extension Spoofing Using Right-to-Left Override</description>
    <match>(((TargetFilename=\"*3pm.*\" OR TargetFilename=\"*4pm.*\" OR TargetFilename=\"*cod.*\" OR TargetFilename=\"*fdp.*\" OR TargetFil</match>
  </rule>
</group>
