    <description>Remote PowerShell Session (PS Module)</description>
    <match>(((ContextInfo=\"* = ServerRemoteHost *\" AND ContextInfo=\"*wsmprovhost.exe*\")) AND NOT ((ContextInfo=\"*\\\\Windows\\\\system3</match>
  </rule>
</group>
