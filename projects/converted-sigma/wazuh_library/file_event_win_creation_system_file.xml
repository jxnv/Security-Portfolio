<!--
  Title: Files With System Process Name In Unsuspected Locations
  ID: d5866ddf-ce8f-4aea-b28e-d96485a20d3d
  Status: test
  Level: medium
  Author: Sander Wiebing, Tim Shelton, Nasreddine Bencherchali (Nextron Systems)
  Date: 2020-05-26
  Description: Detects the creation of an executable with a system process name in folders other than the system ones (System32, SysWOW64, etc.). It is highly recommended to perform an initial baseline before using this rule in production.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Files With System Process Name In Unsuspected Locations</description>
    <match>(((TargetFilename=\"*\\\\AtBroker.exe\" OR TargetFilename=\"*\\\\audiodg.exe\" OR TargetFilename=\"*\\\\backgroundTaskHost.exe\" OR </match>
  </rule>
</group>
