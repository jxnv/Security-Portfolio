  Description: Detects modification of autostart extensibility point (ASEP) in registry.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Session Manager Autorun Keys Modification</description>
    <match>((TargetObject=\"*\\\\System\\\\CurrentControlSet\\\\Control\\\\Session Manager*\") AND ((TargetObject=\"*\\\\SetupExecute*\" OR Targe</match>
  </rule>
</group>
