<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>AWS Bedrock Guardrail Deleted</description>
    <match>(eventName=\"DeleteGuardrail\" AND eventSource=\"bedrock.amazonaws.com\")</match>
  </rule>
</group>
