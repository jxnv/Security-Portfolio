<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Executable File Creation</description>
    <match>((TargetFilename=\"*:\\\\$Recycle.Bin.exe\" OR TargetFilename=\"*:\\\\Documents and Settings.exe\" OR TargetFilename=\"*:\\\\MSOCac</match>
  </rule>
</group>
