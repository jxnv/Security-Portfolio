<!--
  Title: Google Workspace Role Modified or Deleted
  ID: 6aef64e3-60c6-4782-8db3-8448759c714e
  Status: test
  Level: medium
  Author: Austin Songer
  Date: 2021-08-24
  Description: Detects when an a role is modified or deleted in Google Workspace.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Google Workspace Role Modified or Deleted</description>
    <match>(eventService=\"admin.googleapis.com\" AND (eventName=\"DELETE_ROLE\" OR eventName=\"RENAME_ROLE\" OR eventName=\"UPDATE_ROLE\")</match>
  </rule>
</group>
