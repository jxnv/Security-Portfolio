<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Powershell WMI Persistence</description>
    <match>(((ScriptBlockText=\"*New-CimInstance *\" AND ScriptBlockText=\"*-Namespace root/subscription *\" AND ScriptBlockText=\"*-Cla</match>
  </rule>
</group>
