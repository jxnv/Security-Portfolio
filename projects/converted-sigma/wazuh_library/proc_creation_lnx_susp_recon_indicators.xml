<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Linux Recon Indicators</description>
    <match>((CommandLine=\"* -name .htpasswd*\" OR CommandLine=\"* -perm -4000 *\"))</match>
  </rule>
</group>
