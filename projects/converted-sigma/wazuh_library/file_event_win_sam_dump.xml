<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potential SAM Database Dump</description>
    <match>(((TargetFilename=\"*\\\\Temp\\\\sam\" OR TargetFilename=\"*\\\\sam.sav\" OR TargetFilename=\"*\\\\Intel\\\\sam\" OR TargetFilename=\"*\\\\</match>
  </rule>
</group>
