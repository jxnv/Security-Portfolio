<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Invoke-WebRequest Execution</description>
    <match>(((CommandLine=\"*curl *\" OR CommandLine=\"*Invoke-WebRequest*\" OR CommandLine=\"*iwr *\" OR CommandLine=\"*wget *\")) AND ((C</match>
  </rule>
</group>
