<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potential Persistence Via Powershell Search Order Hijacking - Task</description>
    <match>(ParentImage=\"C:\\\\WINDOWS\\\\System32\\\\svchost.exe\" AND (ParentCommandLine=\"*-k netsvcs*\" AND ParentCommandLine=\"*-s Sched</match>
  </rule>
</group>
