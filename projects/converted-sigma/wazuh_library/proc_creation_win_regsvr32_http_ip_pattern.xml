<!--
  Title: Potentially Suspicious Regsvr32 HTTP IP Pattern
  ID: 2dd2c217-bf68-437a-b57c-fe9fd01d5de8
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems)
  Date: 2022-01-11
  Description: Detects regsvr32 execution to download and install DLLs located remotely where the address is an IP address.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potentially Suspicious Regsvr32 HTTP IP Pattern</description>
    <match>(((Image=\"*\\\\regsvr32.exe\") OR (OriginalFileName=\"REGSVR32.EXE\")) AND ((CommandLine=\"* /i:http://1*\" OR CommandLine=\"* /</match>
  </rule>
</group>
