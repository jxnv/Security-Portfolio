<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potentially Suspicious DLL Registered Via Odbcconf.EXE</description>
    <match>(((CommandLine=\"*REGSVR *\") AND ((Image=\"*\\\\odbcconf.exe\") OR (OriginalFileName=\"odbcconf.exe\"))) AND NOT ((CommandLine=</match>
  </rule>
</group>
