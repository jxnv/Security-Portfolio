<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>HackTool - Empire PowerShell Launch Parameters</description>
    <match>((CommandLine=\"* -NoP -sta -NonI -W Hidden -Enc *\" OR CommandLine=\"* -noP -sta -w 1 -enc *\" OR CommandLine=\"* -NoP -NonI</match>
  </rule>
</group>
