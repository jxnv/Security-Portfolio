<!--
  Title: MSSQL Destructive Query
  ID: 00321fee-ca72-4cce-b011-5415af3b9960
  Status: experimental
  Level: medium
  Author: Daniel Degasperi '@d4ns4n_'
  Date: 2025-06-04
  Description: Detects the invocation of MS SQL transactions that are destructive towards table or database data, such as "DROP TABLE" or "DROP DATABASE".
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>MSSQL Destructive Query</description>
    <match>(Provider_Name=\"MSSQLSERVER$AUDIT\" AND EventID=\"33205\" AND (Data=\"*statement:TRUNCATE TABLE*\" OR Data=\"*statement:DROP T</match>
  </rule>
</group>
