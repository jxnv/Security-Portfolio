<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Access To Crypto Currency Wallets By Uncommon Applications</description>
    <match>((((FileName=\"*\\\\AppData\\\\Roaming\\\\Ethereum\\\\keystore\\\\*\" OR FileName=\"*\\\\AppData\\\\Roaming\\\\EthereumClassic\\\\keystore\\\\*</match>
  </rule>
</group>
