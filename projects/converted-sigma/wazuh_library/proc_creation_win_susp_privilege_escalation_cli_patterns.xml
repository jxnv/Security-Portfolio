<!--
  Title: Suspicious RunAs-Like Flag Combination
  ID: 50d66fb0-03f8-4da0-8add-84e77d12a020
  Status: test
  Level: medium
  Author: Florian Roth (Nextron Systems)
  Date: 2022-11-11
  Description: Detects suspicious command line flags that let the user set a target user and command as e.g. seen in PsExec-like tools
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious RunAs-Like Flag Combination</description>
    <match>(((CommandLine=\"* -c cmd*\" OR CommandLine=\"* -c \\\"cmd*\" OR CommandLine=\"* -c powershell*\" OR CommandLine=\"* -c \\\"powersh</match>
  </rule>
</group>
