<!--
  Title: Potential Recon Activity Via Nltest.EXE
  ID: 5cc90652-4cbd-4241-aa3b-4b462fa5a248
  Status: test
  Level: medium
  Author: Craig Young, oscd.community, Georg Lauenstein
  Date: 2021-07-24
  Description: Detects nltest commands that can be used for information discovery
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential Recon Activity Via Nltest.EXE</description>
    <match>(((Image=\"*\\\\nltest.exe\") OR (OriginalFileName=\"nltestrk.exe\")) AND (((CommandLine=\"*server*\" AND CommandLine=\"*query*\")</match>
  </rule>
</group>
