<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Sysinternals PsService Execution</description>
    <match>((OriginalFileName=\"psservice.exe\") OR ((Image=\"*\\\\PsService.exe\" OR Image=\"*\\\\PsService64.exe\" OR Image=\"*\\\\PsService64</match>
  </rule>
</group>
