<!--
  Title: Use of Scriptrunner.exe
  ID: 64760eef-87f7-4ed3-93fd-655668ea9420
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-07-01
  Description: The "ScriptRunner.exe" binary can be abused to proxy execution through it and bypass possible whitelisting
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Use of Scriptrunner.exe</description>
    <match>((CommandLine=\"* -appvscript *\") AND ((Image=\"*\\\\ScriptRunner.exe\") OR (OriginalFileName=\"ScriptRunner.exe\")))</match>
  </rule>
</group>
