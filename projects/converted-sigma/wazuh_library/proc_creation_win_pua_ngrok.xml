<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>PUA - Ngrok Execution</description>
    <match>(((CommandLine=\"* tcp 139*\" OR CommandLine=\"* tcp 445*\" OR CommandLine=\"* tcp 3389*\" OR CommandLine=\"* tcp 5985*\" OR Com</match>
  </rule>
</group>
