<!--
  Title: Fsutil Drive Enumeration
  ID: 63de06b9-a385-40b5-8b32-73f2b9ef84b6
  Status: test
  Level: low
  Author: Christopher Peacock '@securepeacock', SCYTHE '@scythe_io'
  Date: 2022-03-29
  Description: Attackers may leverage fsutil to enumerated connected drives.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Fsutil Drive Enumeration</description>
    <match>((CommandLine=\"*drives*\") AND ((Image=\"*\\\\fsutil.exe\") OR (OriginalFileName=\"fsutil.exe\")))</match>
  </rule>
</group>
