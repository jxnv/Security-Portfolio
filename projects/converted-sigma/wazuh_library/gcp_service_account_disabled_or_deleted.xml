<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Google Cloud Service Account Disabled or Deleted</description>
    <match>((gcp.audit.method_name=\"*.serviceAccounts.disable\" OR gcp.audit.method_name=\"*.serviceAccounts.delete\"))</match>
  </rule>
</group>
