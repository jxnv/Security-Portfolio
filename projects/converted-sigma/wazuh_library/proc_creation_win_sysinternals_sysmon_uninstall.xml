<!--
  Title: Uninstall Sysinternals Sysmon
  ID: 6a5f68d1-c4b5-46b9-94ee-5324892ea939
  Status: test
  Level: high
  Author: frack113
  Date: 2022-01-12
  Description: Detects the removal of Sysmon, which could be a potential attempt at defense evasion
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Uninstall Sysinternals Sysmon</description>
    <match>(((CommandLine=\"*-u*\" OR CommandLine=\"*/u*\")) AND (((Image=\"*\\\\Sysmon64.exe\" OR Image=\"*\\\\Sysmon64a.exe\" OR Image=\"*\\\\Sy</match>
  </rule>
</group>
