  Date: 2025-11-01
  Description: Detects the modification of a user group on a Fortinet FortiGate Firewall. The group could be used to grant VPN access to a network.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>FortiGate - User Group Modified</description>
    <match>(action=\"Edit\" AND cfgpath=\"user.group\")</match>
  </rule>
</group>
