<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Touch Suspicious Service File</description>
    <match>(Image=\"*/touch\" AND CommandLine=\"* -t *\" AND CommandLine=\"*.service\")</match>
  </rule>
</group>
