<!--
  Title: Renamed CURL.EXE Execution
  ID: 7530cd3d-7671-43e3-b209-976966f6ea48
  Status: test
  Level: medium
  Author: X__Junior (Nextron Systems)
  Date: 2023-09-11
  Description: Detects the execution of a renamed "CURL.exe" binary based on the PE metadata fields
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Renamed CURL.EXE Execution</description>
    <match>(((OriginalFileName=\"curl.exe\") OR (Description=\"The curl executable\")) AND NOT ((Image=\"*\\\\curl*\")))</match>
  </rule>
</group>
