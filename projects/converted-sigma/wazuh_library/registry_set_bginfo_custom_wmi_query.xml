<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>New BgInfo.EXE Custom WMI Query Registry Configuration</description>
    <match>(TargetObject=\"*\\\\Software\\\\Winternals\\\\BGInfo\\\\UserFields\\\\*\" AND Details=\"6*\")</match>
  </rule>
</group>
