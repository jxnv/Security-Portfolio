  <rule id="100001" level="5">
    <description>PUA - Process Hacker Execution</description>
    <match>((Image=\"*\\\\ProcessHacker_*\") OR (Image=\"*\\\\ProcessHacker.exe\") OR ((OriginalFileName=\"ProcessHacker.exe\" OR OriginalFil</match>
  </rule>
</group>
