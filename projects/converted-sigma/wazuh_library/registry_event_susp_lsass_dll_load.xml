    <description>DLL Load via LSASS</description>
    <match>(((TargetObject=\"*\\\\CurrentControlSet\\\\Services\\\\NTDS\\\\DirectoryServiceExtPt*\" OR TargetObject=\"*\\\\CurrentControlSet\\\\Se</match>
