<!--
  Title: New Process Created Via Taskmgr.EXE
  ID: 3d7679bd-0c00-440c-97b0-3f204273e6c7
  Status: test
  Level: low
  Author: Florian Roth (Nextron Systems)
  Date: 2018-03-13
  Description: Detects the creation of a process via the Windows task manager. This might be an attempt to bypass UAC
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>New Process Created Via Taskmgr.EXE</description>
    <match>((ParentImage=\"*\\\\taskmgr.exe\") AND NOT (((Image=\"*:\\\\Windows\\\\System32\\\\mmc.exe\" OR Image=\"*:\\\\Windows\\\\System32\\\\resmo</match>
  </rule>
</group>
