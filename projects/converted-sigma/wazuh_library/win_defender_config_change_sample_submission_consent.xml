<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Windows Defender Submit Sample Feature Disabled</description>
    <match>(EventID=\"5007\" AND NewValue=\"*\\\\Real-Time Protection\\\\SubmitSamplesConsent = 0x0*\")</match>
  </rule>
</group>
