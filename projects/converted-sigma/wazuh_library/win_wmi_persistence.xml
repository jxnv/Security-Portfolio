  <rule id="100001" level="5">
    <description>WMI Persistence</description>
    <match>((((EventID=\"5861\") AND (\"ActiveScriptEventConsumer\" OR \"CommandLineEventConsumer\" OR \"CommandLineTemplate\")) OR (EventI</match>
  </rule>
</group>
