<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>System Network Connections Discovery - MacOs</description>
    <match>((Image=\"*/who\" OR Image=\"*/w\" OR Image=\"*/last\" OR Image=\"*/lsof\" OR Image=\"*/netstat\"))</match>
  </rule>
</group>
