<!--
  Title: Suspicious Child Process of Notepad++ Updater - GUP.Exe
  ID: bb0e87ce-c89f-4857-84fa-095e4483e9cb
  Status: experimental
  Level: high
  Author: Swachchhanda Shrawan Poudel (Nextron Systems)
  Date: 2026-02-03
  Description: Detects suspicious child process creation by the Notepad++ updater process (gup.exe). This could indicate potential exploitation of the updater component to deliver unwanted malware.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Child Process of Notepad++ Updater - GUP.Exe</description>
    <match>((ParentImage=\"*\\\\gup.exe\") AND (((CommandLine=\"*bitsadmin*\" OR CommandLine=\"*certutil*\" OR CommandLine=\"*curl*\" OR Comm</match>
  </rule>
</group>
