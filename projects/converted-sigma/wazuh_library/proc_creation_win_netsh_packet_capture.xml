<!--
  Title: New Network Trace Capture Started Via Netsh.EXE
  ID: d3c3861d-c504-4c77-ba55-224ba82d0118
  Status: test
  Level: medium
  Author: Kutepov Anton, oscd.community
  Date: 2019-10-24
  Description: Detects the execution of netsh with the "trace" flag in order to start a network capture
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>New Network Trace Capture Started Via Netsh.EXE</description>
    <match>(((CommandLine=\"*trace*\" AND CommandLine=\"*start*\")) AND ((Image=\"*\\\\netsh.exe\") OR (OriginalFileName=\"netsh.exe\")))</match>
  </rule>
</group>
