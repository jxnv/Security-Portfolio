<!--
  Title: Suspicious TSCON Start as SYSTEM
  ID: 9847f263-4a81-424f-970c-875dab15b79b
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems)
  Date: 2018-03-17
  Description: Detects a tscon.exe start as LOCAL SYSTEM
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious TSCON Start as SYSTEM</description>
    <match>((User=\"*AUTHORI*\" OR User=\"*AUTORI*\") AND Image=\"*\\\\tscon.exe\")</match>
  </rule>
</group>
