  Description: Detects base64 encoded strings used in hidden malicious PowerShell command lines
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Malicious Base64 Encoded PowerShell Keywords in Command Lines</description>
    <match>(((CommandLine=\"*AGkAdABzAGEAZABtAGkAbgAgAC8AdAByAGEAbgBzAGYAZQByA*\" OR CommandLine=\"*aXRzYWRtaW4gL3RyYW5zZmVy*\" OR Comm</match>
  </rule>
</group>
