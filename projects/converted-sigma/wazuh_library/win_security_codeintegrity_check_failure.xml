<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Failed Code Integrity Checks</description>
    <match>(((EventID=\"5038\" OR EventID=\"6281\")) AND NOT ((((param1=\"*\\\\CSFalconServiceUninstallTool_*\" OR param1=\"*\\\\Program Files</match>
  </rule>
</group>
