  Description: Detects usage of the "usermod" binary to add users add users to the root or suoders groups
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>User Added To Root/Sudoers Group Using Usermod</description>
    <match>(Image=\"*/usermod\" AND (CommandLine=\"*-aG root*\" OR CommandLine=\"*-aG sudoers*\"))</match>
  </rule>
</group>
