<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Rundll32 InstallScreenSaver Execution</description>
    <match>((CommandLine=\"*InstallScreenSaver*\") AND ((Image=\"*\\\\rundll32.exe\") OR (OriginalFileName=\"RUNDLL32.EXE\")))</match>
  </rule>
</group>
