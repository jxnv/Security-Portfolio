  Description: Detects when a new credential is added to an existing application. Any additional credentials added outside of expected processes could be a malicious actor using those credentials.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Added Credentials to Existing Application</description>
    <match>((properties.message=\"Update application - Certificates and secrets management\" OR properties.message=\"Update Service pr</match>
  </rule>
</group>
