<!--
  Title: DLL Loaded via CertOC.EXE
  ID: 242301bc-f92f-4476-8718-78004a6efd9f
  Status: test
  Level: medium
  Author: Austin Songer @austinsonger
  Date: 2021-10-23
  Description: Detects when a user installs certificates by using CertOC.exe to loads the target DLL file.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>DLL Loaded via CertOC.EXE</description>
    <match>((CommandLine=\"* -LoadDLL *\") AND ((Image=\"*\\\\certoc.exe\") OR (OriginalFileName=\"CertOC.exe\")))</match>
  </rule>
</group>
