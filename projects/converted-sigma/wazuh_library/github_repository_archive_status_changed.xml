<!--
  Title: GitHub Repository Archive Status Changed
  ID: dca8991c-cb16-4128-abf8-6b11e5cd156f
  Status: experimental
  Level: low
  Author: Ivan Saakov
  Date: 2025-10-18
  Description: Detects when a GitHub repository is archived or unarchived, which may indicate unauthorized changes to repository status.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>GitHub Repository Archive Status Changed</description>
    <match>((action=\"repo.archived\" OR action=\"repo.unarchived\"))</match>
  </rule>
</group>
