<!--
  Title: Webshell Remote Command Execution
  ID: c0d3734d-330f-4a03-aae2-65dacc6a8222
  Status: test
  Level: critical
  Author: Ilyas Ochkov, Beyu Denis, oscd.community
  Date: 2019-10-12
  Description: Detects possible command execution by web application/web shell
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Webshell Remote Command Execution</description>
    <match>(type=\"SYSCALL\" AND (SYSCALL=\"execve\" OR SYSCALL=\"execveat\") AND euid=\"33\")</match>
  </rule>
</group>
