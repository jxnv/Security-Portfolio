<!--
  Title: User Added to Local Administrator Group
  ID: c265cf08-3f99-46c1-8d59-328247057d57
  Status: stable
  Level: medium
  Author: Florian Roth (Nextron Systems)
  Date: 2017-03-14
  Description: Detects the addition of a new member to the local administrator group, which could be legitimate activity or a sign of privilege escalation activity
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>User Added to Local Administrator Group</description>
    <match>(((EventID=\"4732\") AND ((TargetUserName=\"Administr*\") OR (TargetSid=\"S-1-5-32-544\"))) AND NOT ((SubjectUserName=\"*$\")))</match>
  </rule>
</group>
