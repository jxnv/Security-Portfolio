<!--
  Title: Potential Cookies Session Hijacking
  ID: 5a6e1e16-07de-48d8-8aae-faa766c05e88
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2023-07-27
  Description: Detects execution of "curl.exe" with the "-c" flag in order to save cookie data.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential Cookies Session Hijacking</description>
    <match>(((CommandLine=regex(\"\\\\s-c\\\\s\")) OR (CommandLine=\"*--cookie-jar*\")) AND ((Image=\"*\\\\curl.exe\") OR (OriginalFileName=\"cu</match>
  </rule>
</group>
