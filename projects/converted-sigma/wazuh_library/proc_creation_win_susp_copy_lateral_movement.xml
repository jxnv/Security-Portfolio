<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Copy From Or To Admin Share Or Sysvol Folder</description>
    <match>(((CommandLine=\"*\\\\\\\\\\\\\\\\*\\\\\\\\*$*\" OR CommandLine=\"*\\\\Sysvol\\\\*\")) AND ((((Image=\"*\\\\robocopy.exe\" OR Image=\"*\\\\xcopy.ex</match>
  </rule>
</group>
