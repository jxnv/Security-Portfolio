  Description: Detects file access to browser credential storage paths by non-browser processes, which may indicate credential access attempts. Adversaries may attempt to access browser credential storage to extract sensitive information such as usernames and passwords or cookies. This behavior is often commonly observed in credential stealing malware.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious File Access to Browser Credential Storage</description>
    <match>((((FileName=\"*\\\\Sputnik\\\\Sputnik*\" OR FileName=\"*\\\\MapleStudio\\\\ChromePlus*\" OR FileName=\"*\\\\QIP Surf*\" OR FileName=\"*\\</match>
  </rule>
</group>
