<!--
  Title: Linux Keylogging with Pam.d
  ID: 49aae26c-450e-448b-911d-b3c13d178dfc
  Status: test
  Level: high
  Author: Pawel Mazur
  Date: 2021-05-24
  Description: Detect attempt to enable auditing of TTY input
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Linux Keylogging with Pam.d</description>
    <match>((type=\"PATH\" AND (name=\"/etc/pam.d/system-auth\" OR name=\"/etc/pam.d/password-auth\")) OR ((type=\"TTY\" OR type=\"USER_TTY\"</match>
  </rule>
</group>
