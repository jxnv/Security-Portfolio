<!--
  Title: CodeIntegrity - Unmet Signing Level Requirements By File Under Validation
  ID: f8931561-97f5-4c46-907f-0a4a592e47a7
  Status: experimental
  Level: low
  Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-01-20
  Description: Detects attempted file load events that did not meet the signing level requirements. It often means the file's signature is revoked or a signature with the Lifetime Signing EKU has expired. This event is best correlated with EID 3089 to determine the error of the validation.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>CodeIntegrity - Unmet Signing Level Requirements By File Under Validation</description>
    <match>(((EventID=\"3033\" OR EventID=\"3034\")) AND NOT ((FileNameBuffer=\"*\\\\Windows\\\\assembly\\\\GAC\\\\*\" AND ProcessNameBuffer=\"*\\\\</match>
  </rule>
</group>
