<!--
  Title: Stop Windows Service Via Sc.EXE
  ID: 81bcb81b-5b1f-474b-b373-52c871aaa7b1
  Status: test
  Level: low
  Author: Jakob Weinzettl, oscd.community, Nasreddine Bencherchali (Nextron Systems)
  Date: 2023-03-05
  Description: Detects the stopping of a Windows service via the "sc.exe" utility
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Stop Windows Service Via Sc.EXE</description>
    <match>((CommandLine=\"* stop *\") AND ((OriginalFileName=\"sc.exe\") OR (Image=\"*\\\\sc.exe\")))</match>
  </rule>
</group>
