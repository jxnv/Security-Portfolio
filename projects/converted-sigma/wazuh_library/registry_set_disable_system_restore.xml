    <description>Registry Disable System Restore</description>
    <match>((TargetObject=\"*\\\\Policies\\\\Microsoft\\\\Windows NT\\\\SystemRestore*\" OR TargetObject=\"*\\\\Microsoft\\\\Windows NT\\\\CurrentVe</match>
  </rule>
</group>
