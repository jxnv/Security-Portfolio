<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>MMC Spawning Windows Shell</description>
    <match>((ParentImage=\"*\\\\mmc.exe\") AND (((Image=\"*\\\\cmd.exe\" OR Image=\"*\\\\powershell.exe\" OR Image=\"*\\\\pwsh.exe\" OR Image=\"*\\\\w</match>
  </rule>
</group>
