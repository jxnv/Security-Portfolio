<!--
  Title: Disable Macro Runtime Scan Scope
  ID: ab871450-37dc-4a3a-997f-6662aa8ae0f1
  Status: test
  Level: high
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-10-25
  Description: Detects tampering with the MacroRuntimeScanScope registry key to disable runtime scanning of enabled macros
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Disable Macro Runtime Scan Scope</description>
    <match>((TargetObject=\"*\\\\SOFTWARE\\\\*\" AND TargetObject=\"*\\\\Microsoft\\\\Office\\\\*\" AND TargetObject=\"*\\\\Common\\\\Security*\") AND </match>
  </rule>
</group>
