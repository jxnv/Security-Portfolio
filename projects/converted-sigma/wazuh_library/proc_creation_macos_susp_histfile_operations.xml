<!--
  Title: Suspicious History File Operations
  ID: 508a9374-ad52-4789-b568-fc358def2c65
  Status: test
  Level: medium
  Author: Mikhail Larin, oscd.community
  Date: 2020-10-17
  Description: Detects commandline operations on shell history files
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious History File Operations</description>
    <match>((CommandLine=\"*.bash_history*\" OR CommandLine=\"*.zsh_history*\" OR CommandLine=\"*.zhistory*\" OR CommandLine=\"*.history*\"</match>
  </rule>
</group>
