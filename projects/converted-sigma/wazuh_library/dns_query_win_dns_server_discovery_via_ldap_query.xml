<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>DNS Server Discovery Via LDAP Query</description>
    <match>((QueryName=\"_ldap.*\") AND NOT (((Image=\"*:\\\\ProgramData\\\\Microsoft\\\\Windows Defender\\\\Platform\\\\*\" AND Image=\"*\\\\MsMpEn</match>
  </rule>
</group>
