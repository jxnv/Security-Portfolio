<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Dump Credentials from Windows Credential Manager With PowerShell</description>
    <match>(((ScriptBlockText=\"*Get-PasswordVaultCredentials*\" OR ScriptBlockText=\"*Get-CredManCreds*\")) OR ((ScriptBlockText=\"*New</match>
  </rule>
</group>
