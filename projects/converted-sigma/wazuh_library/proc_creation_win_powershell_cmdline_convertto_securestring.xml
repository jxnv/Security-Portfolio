<!--
  Title: ConvertTo-SecureString Cmdlet Usage Via CommandLine
  ID: 74403157-20f5-415d-89a7-c505779585cf
  Status: test
  Level: medium
  Author: Teymur Kheirkhabarov (idea), Vasiliy Burov (rule), oscd.community, Tim Shelton
  Date: 2020-10-11
  Description: Detects usage of the "ConvertTo-SecureString" cmdlet via the commandline. Which is fairly uncommon and could indicate potential suspicious activity
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>ConvertTo-SecureString Cmdlet Usage Via CommandLine</description>
    <match>((CommandLine=\"*ConvertTo-SecureString*\") AND (((Image=\"*\\\\powershell.exe\" OR Image=\"*\\\\pwsh.exe\")) OR ((OriginalFileNam</match>
  </rule>
</group>
