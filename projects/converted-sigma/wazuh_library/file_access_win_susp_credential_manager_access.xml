<!--
  Title: Credential Manager Access By Uncommon Applications
  ID: 407aecb1-e762-4acf-8c7b-d087bcff3bb6
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-10-11
  Description: Detects suspicious processes based on name and location that access the windows credential manager and vault. Which can be a sign of credential stealing. Example case would be usage of mimikatz "dpapi::cred" function
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Credential Manager Access By Uncommon Applications</description>
    <match>(((FileName=\"*\\\\AppData\\\\Local\\\\Microsoft\\\\Credentials\\\\*\" OR FileName=\"*\\\\AppData\\\\Roaming\\\\Microsoft\\\\Credentials\\\\*\" </match>
  </rule>
</group>
