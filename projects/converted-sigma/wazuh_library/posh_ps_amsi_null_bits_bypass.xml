<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential AMSI Bypass Script Using NULL Bits</description>
    <match>((ScriptBlockText=\"*if(0){{{0}}}' -f $(0 -as [char]) +*\" OR ScriptBlockText=\"*#<NULL>*\"))</match>
  </rule>
</group>
