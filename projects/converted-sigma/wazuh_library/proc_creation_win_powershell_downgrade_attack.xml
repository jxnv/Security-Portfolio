<!--
  Title: Potential PowerShell Downgrade Attack
  ID: b3512211-c67e-4707-bedc-66efc7848863
  Status: test
  Level: medium
  Author: Harish Segar (rule)
  Date: 2020-03-20
  Description: Detects PowerShell downgrade attack by comparing the host versions with the actually used engine version 2.0
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential PowerShell Downgrade Attack</description>
    <match>(Image=\"*\\\\powershell.exe\" AND (CommandLine=\"* -version 2 *\" OR CommandLine=\"* -versio 2 *\" OR CommandLine=\"* -versi 2 *</match>
  </rule>
</group>
