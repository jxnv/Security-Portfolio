  Date: 2024-08-21
  Description: Detects changes to the "StrongAuthenticationRequirement" value, where the state is set to "0" or "Disabled". Threat actors were seen disabling multi factor authentication for users in order to maintain or achieve access to the account. Also see in SIM Swap attacks.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Multi Factor Authentication Disabled For User Account</description>
    <match>(LoggedByService=\"Core Directory\" AND Category=\"UserManagement\" AND OperationName=\"Update user\" AND TargetResources.Modi</match>
  </rule>
</group>
