<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Custom File Open Handler Executes PowerShell</description>
    <match>(TargetObject=\"*shell\\\\open\\\\command\\\\*\" AND (Details=\"*powershell*\" AND Details=\"*-command*\"))</match>
  </rule>
</group>
