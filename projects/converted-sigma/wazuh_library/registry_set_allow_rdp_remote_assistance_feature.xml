<!--
  Title: Allow RDP Remote Assistance Feature
  ID: 37b437cf-3fc5-4c8e-9c94-1d7c9aff842b
  Status: test
  Level: medium
  Author: frack113
  Date: 2022-08-19
  Description: Detect enable rdp feature to allow specific user to rdp connect on the targeted machine
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Allow RDP Remote Assistance Feature</description>
    <match>(TargetObject=\"*System\\\\CurrentControlSet\\\\Control\\\\Terminal Server\\\\fAllowToGetHelp\" AND Details=\"DWORD (0x00000001)\")</match>
  </rule>
</group>
