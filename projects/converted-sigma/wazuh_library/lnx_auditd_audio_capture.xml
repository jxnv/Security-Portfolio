<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Audio Capture</description>
    <match>((type=\"EXECVE\" AND a0=\"arecord\" AND a1=\"-vv\" AND a2=\"-fdat\") OR (type=\"SYSCALL\" AND exe=\"*/ecasound\" AND SYSCALL=\"memfd</match>
  </rule>
</group>
