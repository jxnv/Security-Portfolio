<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>TacticalRMM Service Installation</description>
    <match>((Provider_Name=\"Service Control Manager\" AND EventID=\"7045\") AND ((ImagePath=\"*tacticalrmm.exe*\") OR (ServiceName=\"*Tac</match>
  </rule>
</group>
