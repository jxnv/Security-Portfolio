<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Macos Remote System Discovery</description>
    <match>((Image=\"*/arp\" AND CommandLine=\"*-a*\") OR (Image=\"*/ping\" AND (CommandLine=\"* 10.*\" OR CommandLine=\"* 192.168.*\" OR Com</match>
  </rule>
</group>
