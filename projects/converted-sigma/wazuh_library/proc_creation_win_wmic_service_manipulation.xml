<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Service Started/Stopped Via Wmic.EXE</description>
    <match>(((CommandLine=\"* service *\" AND CommandLine=\"* call *\") AND (CommandLine=\"*stopservice*\" OR CommandLine=\"*startservice*</match>
  </rule>
</group>
