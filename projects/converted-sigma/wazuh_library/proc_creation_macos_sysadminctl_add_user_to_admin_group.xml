  Date: 2023-03-19
  Description: Detects attempts to create and add an account to the admin group via "sysadminctl"
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>User Added To Admin Group Via Sysadminctl</description>
    <match>(Image=\"*/sysadminctl\" AND (CommandLine=\"* -addUser *\" AND CommandLine=\"* -admin *\"))</match>
  </rule>
</group>
