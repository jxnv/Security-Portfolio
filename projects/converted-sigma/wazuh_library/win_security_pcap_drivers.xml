<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Windows Pcap Drivers</description>
    <match>(EventID=\"4697\" AND (ServiceFileName=\"*pcap*\" OR ServiceFileName=\"*npcap*\" OR ServiceFileName=\"*npf*\" OR ServiceFileName</match>
  </rule>
</group>
