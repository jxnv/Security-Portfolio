<!--
  Title: Suspicious File Created by ArcSOC.exe
  ID: e890acee-d488-420e-8f20-d9b19b3c3d43
  Status: experimental
  Level: high
  Author: Micah Babinski
  Date: 2025-11-25
  Description: Detects instances where the ArcGIS Server process ArcSOC.exe, which hosts REST services running on an ArcGIS server, creates a file with suspicious file type, indicating that it may be an executable, script file, or otherwise unusual.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious File Created by ArcSOC.exe</description>
    <match>(Image=\"*\\\\ArcSOC.exe\" AND (TargetFilename=\"*.ahk\" OR TargetFilename=\"*.aspx\" OR TargetFilename=\"*.au3\" OR TargetFilenam</match>
  </rule>
</group>
