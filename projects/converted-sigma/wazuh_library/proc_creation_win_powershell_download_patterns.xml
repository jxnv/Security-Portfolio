<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>PowerShell Download Pattern</description>
    <match>(((CommandLine=\"*new-object*\" AND CommandLine=\"*net.webclient).*\" AND CommandLine=\"*download*\") AND (CommandLine=\"*strin</match>
  </rule>
</group>
