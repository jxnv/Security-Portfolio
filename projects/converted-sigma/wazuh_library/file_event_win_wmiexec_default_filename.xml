<!--
  Title: Wmiexec Default Output File
  ID: 8d5aca11-22b3-4f22-b7ba-90e60533e1fb
  Status: test
  Level: critical
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-06-02
  Description: Detects the creation of the default output filename used by the wmiexec tool
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Wmiexec Default Output File</description>
    <match>((TargetFilename=regex(\"\\\\\\\\Windows\\\\\\\\__1\\\\d{9}\\\\.\\\\d{1,7}$\")) OR (TargetFilename=regex(\"C:\\\\\\\\__1\\\\d{9}\\\\.\\\\d{1,7}$\"))</match>
  </rule>
</group>
