<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious External WebDAV Execution</description>
    <match>((((c-uri=\"*.7z\" OR c-uri=\"*.bat\" OR c-uri=\"*.dat\" OR c-uri=\"*.cmd\" OR c-uri=\"*.exe\" OR c-uri=\"*.js\" OR c-uri=\"*.lnk\" OR</match>
  </rule>
</group>
