<!--
  Title: Security Event Logging Disabled via MiniNt Registry Key - Process
  ID: 1a4bd6af-99ac-4466-b5b2-7b72b4a05462
  Status: experimental
  Level: high
  Author: Swachchhanda Shrawan Poudel (Nextron Systems)
  Date: 2025-04-09
  Description: Detects attempts to disable security event logging by adding the `MiniNt` registry key. This key is used to disable the Windows Event Log service, which collects and stores event logs from the operating system and applications. Adversaries may want to disable this service to prevent logging of security events that could be used to detect their activities.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Security Event Logging Disabled via MiniNt Registry Key - Process</description>
    <match>((((CommandLine=\"* add *\" AND CommandLine=\"*\\\\SYSTEM\\\\CurrentControlSet\\\\Control\\\\MiniNt*\")) AND ((Image=\"*\\\\reg.exe\") O</match>
  </rule>
</group>
