<!--
  Title: Suspicious HH.EXE Execution
  ID: e8a95b5e-c891-46e2-b33a-93937d3abc31
  Status: test
  Level: high
  Author: Maxim Pavlunin
  Date: 2020-04-01
  Description: Detects a suspicious execution of a Microsoft HTML Help (HH.exe)
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious HH.EXE Execution</description>
    <match>(((OriginalFileName=\"HH.exe\") OR (Image=\"*\\\\hh.exe\")) AND ((CommandLine=\"*.application*\" OR CommandLine=\"*\\\\AppData\\\\Loc</match>
  </rule>
</group>
