<!--
  Title: Suspicious Space Characters in TypedPaths Registry Path - FileFix
  ID: 8f2a5c3d-9e4b-4a7c-8d1f-2e5a6b9c3d7e
  Status: experimental
  Level: high
  Author: Swachchhanda Shrawan Poudel (Nextron Systems)
  Date: 2025-11-04
  Description: Detects the occurrence of numerous space characters in TypedPaths registry paths, which may indicate execution via phishing lures using file-fix techniques to hide malicious commands.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Space Characters in TypedPaths Registry Path - FileFix</description>
    <match>((TargetObject=\"*\\\\Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Explorer\\\\TypedPaths\\\\url1\" AND Details=\"*#*\") AND ((De</match>
  </rule>
</group>
