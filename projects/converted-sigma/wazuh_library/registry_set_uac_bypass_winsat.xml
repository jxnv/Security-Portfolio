  Description: Detects the pattern of UAC Bypass using a path parsing issue in winsat.exe (UACMe 52)
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>UAC Bypass Abusing Winsat Path Parsing - Registry</description>
    <match>(TargetObject=\"*\\\\Root\\\\InventoryApplicationFile\\\\winsat.exe|*\" AND TargetObject=\"*\\\\LowerCaseLongPath\" AND Details=\"c:\\</match>
  </rule>
</group>
