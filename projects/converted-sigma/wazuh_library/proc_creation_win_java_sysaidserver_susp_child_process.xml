<!--
  Title: Suspicious SysAidServer Child
  ID: 60bfeac3-0d35-4302-8efb-1dd16f715bc6
  Status: test
  Level: medium
  Author: Florian Roth (Nextron Systems)
  Date: 2022-08-26
  Description: Detects suspicious child processes of SysAidServer (as seen in MERCURY threat actor intrusions)
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious SysAidServer Child</description>
    <match>((ParentImage=\"*\\\\java.exe\" OR ParentImage=\"*\\\\javaw.exe\") AND ParentCommandLine=\"*SysAidServer*\")</match>
  </rule>
</group>
