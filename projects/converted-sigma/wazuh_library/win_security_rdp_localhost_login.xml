<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>RDP Login from Localhost</description>
    <match>(EventID=\"4624\" AND LogonType=\"10\" AND (IpAddress=\"::1\" OR IpAddress=\"127.0.0.1\"))</match>
  </rule>
</group>
