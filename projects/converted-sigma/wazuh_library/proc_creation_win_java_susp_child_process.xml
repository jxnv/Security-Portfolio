<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Processes Spawned by Java.EXE</description>
    <match>(ParentImage=\"*\\\\java.exe\" AND (Image=\"*\\\\AppVLP.exe\" OR Image=\"*\\\\bitsadmin.exe\" OR Image=\"*\\\\certutil.exe\" OR Image=\"*</match>
  </rule>
</group>
