<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Outlook Macro Created</description>
    <match>((TargetFilename=\"*\\\\Microsoft\\\\Outlook\\\\VbaProject.OTM\") AND NOT ((Image=\"*\\\\outlook.exe\")))</match>
  </rule>
</group>
