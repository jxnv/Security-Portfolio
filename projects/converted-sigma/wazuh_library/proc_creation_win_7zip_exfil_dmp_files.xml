<!--
  Title: 7Zip Compressing Dump Files
  ID: ec570e53-4c76-45a9-804d-dc3f355ff7a7
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-09-27
  Description: Detects execution of 7z in order to compress a file with a ".dmp"/".dump" extension, which could be a step in a process of dump file exfiltration.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>7Zip Compressing Dump Files</description>
    <match>(((CommandLine=\"*.dmp*\" OR CommandLine=\"*.dump*\" OR CommandLine=\"*.hdmp*\")) AND ((Description=\"*7-Zip*\") OR ((Image=\"*\\\\</match>
  </rule>
</group>
