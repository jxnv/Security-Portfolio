<!--
  Title: Windows Default Domain GPO Modification
  ID: e5ac86dd-2da1-454b-be74-05d26c769d7d
  Status: experimental
  Level: medium
  Author: Swachchhanda Shrawan Poudel (Nextron Systems)
  Date: 2025-11-22
  Description: Detects modifications to Default Domain or Default Domain Controllers Group Policy Objects (GPOs). Adversaries may modify these default GPOs to deploy malicious configurations across the domain.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Windows Default Domain GPO Modification</description>
    <match>(EventID=\"5136\" AND ObjectClass=\"groupPolicyContainer\" AND (ObjectDN=\"CN={31B2F340-016D-11D2-945F-00C04FB984F9},CN=POLIC</match>
  </rule>
</group>
