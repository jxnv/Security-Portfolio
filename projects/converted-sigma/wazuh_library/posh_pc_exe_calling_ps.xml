  Description: Detects PowerShell called from an executable by the version mismatch method
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>PowerShell Called from an Executable Version Mismatch</description>
    <match>(((Data=\"*EngineVersion=2.*\" OR Data=\"*EngineVersion=4.*\" OR Data=\"*EngineVersion=5.*\")) AND (Data=\"*HostVersion=3.*\"))</match>
  </rule>
</group>
