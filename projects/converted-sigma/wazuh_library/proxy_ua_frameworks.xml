<!--
  Title: Exploit Framework User Agent
  ID: fdd1bfb5-f60b-4a35-910e-f36ed3d0b32f
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems)
  Date: 2017-07-08
  Description: Detects suspicious user agent strings used by exploit / pentest frameworks like Metasploit in proxy logs
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Exploit Framework User Agent</description>
    <match>((c-useragent=\"Internet Explorer *\" OR c-useragent=\"Mozilla/4.0 (compatible; MSIE 6.0; Windows NT 5.1; SV1; InfoPath.2)\"</match>
  </rule>
</group>
