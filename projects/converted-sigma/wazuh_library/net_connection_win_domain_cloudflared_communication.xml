<!--
  Title: Network Connection Initiated To Cloudflared Tunnels Domains
  ID: 7cd1dcdc-6edf-4896-86dc-d1f19ad64903
  Status: test
  Level: medium
  Author: Kamran Saifullah, Nasreddine Bencherchali (Nextron Systems)
  Date: 2024-05-27
  Description: Detects network connections to Cloudflared tunnels domains initiated by a process on the system. Attackers can abuse that feature to establish a reverse shell or persistence on a machine.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Network Connection Initiated To Cloudflared Tunnels Domains</description>
    <match>(Initiated=\"true\" AND (DestinationHostname=\"*.v2.argotunnel.com\" OR DestinationHostname=\"*protocol-v2.argotunnel.com\" OR</match>
  </rule>
</group>
