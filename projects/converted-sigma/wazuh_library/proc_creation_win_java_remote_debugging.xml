<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Java Running with Remote Debugging</description>
    <match>(((CommandLine=\"*transport=dt_socket,address=*\") AND ((CommandLine=\"*jre1.*\" OR CommandLine=\"*jdk1.*\"))) AND NOT (((Comm</match>
  </rule>
</group>
