<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Activity from Infrequent Country</description>
    <match>(eventSource=\"SecurityComplianceCenter\" AND eventName=\"Activity from infrequent country\" AND status=\"success\")</match>
  </rule>
</group>
