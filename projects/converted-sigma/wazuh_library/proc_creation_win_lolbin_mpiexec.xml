<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>MpiExec Lolbin</description>
    <match>(((Image=\"*\\\\mpiexec.exe\") OR (Hashes=\"*IMPHASH=d8b52ef6aaa3a81501bdfff9dbb96217*\")) AND ((CommandLine=\"* /n 1 *\" OR Com</match>
  </rule>
</group>
