<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Remote Access Tool - ScreenConnect Remote Command Execution</description>
    <match>((CommandLine=\"*\\\\TEMP\\\\ScreenConnect\\\\*\") AND ((Image=\"*\\\\cmd.exe\") OR (OriginalFileName=\"Cmd.Exe\")) AND (ParentImage=\"</match>
  </rule>
</group>
