<!--
  Title: Active Directory Structure Export Via Ldifde.EXE
  ID: 4f7a6757-ff79-46db-9687-66501a02d9ec
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2023-03-14
  Description: Detects the execution of "ldifde.exe" in order to export organizational Active Directory structure.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Active Directory Structure Export Via Ldifde.EXE</description>
    <match>(((CommandLine=\"*-f*\") AND ((Image=\"*\\\\ldifde.exe\") OR (OriginalFileName=\"ldifde.exe\"))) AND NOT ((CommandLine=\"* -i*\"))</match>
  </rule>
</group>
