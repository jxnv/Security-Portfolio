  Description: Detects password change for the logged-on user's via "ksetup.exe"
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Logged-On User Password Change Via Ksetup.EXE</description>
    <match>((CommandLine=\"* /ChangePassword *\") AND ((Image=\"*\\\\ksetup.exe\") OR (OriginalFileName=\"ksetup.exe\")))</match>
  </rule>
</group>
