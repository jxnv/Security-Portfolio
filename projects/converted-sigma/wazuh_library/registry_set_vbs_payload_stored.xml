    <description>VBScript Payload Stored in Registry</description>
    <match>((TargetObject=\"*Software\\\\Microsoft\\\\Windows\\\\CurrentVersion*\" AND (Details=\"*vbscript:*\" OR Details=\"*jscript:*\" OR De</match>
  </rule>
</group>
