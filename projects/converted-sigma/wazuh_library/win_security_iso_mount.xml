<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>ISO Image Mounted</description>
    <match>((EventID=\"4663\" AND ObjectServer=\"Security\" AND ObjectType=\"File\" AND ObjectName=\"\\\\Device\\\\CdRom*\") AND NOT (((ObjectN</match>
