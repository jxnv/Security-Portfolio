<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential PowerShell Obfuscation Using Character Join</description>
    <match>((ScriptBlockText=\"*-Alias*\" AND ScriptBlockText=\"* -Value (-join(*\"))</match>
  </rule>
</group>
