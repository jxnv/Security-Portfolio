<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Linux Network Service Scanning - Auditd</description>
    <match>(type=\"SYSCALL\" AND (exe=\"*/telnet\" OR exe=\"*/nmap\" OR exe=\"*/netcat\" OR exe=\"*/nc\" OR exe=\"*/ncat\" OR exe=\"*/nc.openbsd</match>
  </rule>
</group>
