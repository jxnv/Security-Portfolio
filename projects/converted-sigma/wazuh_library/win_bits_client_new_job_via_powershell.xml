<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>New BITS Job Created Via PowerShell</description>
    <match>(EventID=\"3\" AND (processPath=\"*\\\\powershell.exe\" OR processPath=\"*\\\\pwsh.exe\"))</match>
  </rule>
</group>
