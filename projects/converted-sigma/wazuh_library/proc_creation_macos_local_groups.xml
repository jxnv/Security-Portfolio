<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Local Groups Discovery - MacOs</description>
    <match>((Image=\"*/dscacheutil\" AND (CommandLine=\"*-q*\" AND CommandLine=\"*group*\")) OR (Image=\"*/cat\" AND CommandLine=\"*/etc/gro</match>
  </rule>
</group>
