  Date: 2023-05-16
  Description: Detects the creation of the LiveKD driver, which is used for live kernel debugging
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>LiveKD Driver Creation</description>
    <match>(TargetFilename=\"C:\\\\Windows\\\\System32\\\\drivers\\\\LiveKdD.SYS\" AND (Image=\"*\\\\livekd.exe\" OR Image=\"*\\\\livek64.exe\"))</match>
  </rule>
</group>
