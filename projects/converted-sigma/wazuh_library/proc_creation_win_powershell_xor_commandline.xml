<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious XOR Encoded PowerShell Command</description>
    <match>(((CommandLine=\"*ForEach*\" OR CommandLine=\"*for(*\" OR CommandLine=\"*for *\" OR CommandLine=\"*-join *\" OR CommandLine=\"*-j</match>
  </rule>
</group>
