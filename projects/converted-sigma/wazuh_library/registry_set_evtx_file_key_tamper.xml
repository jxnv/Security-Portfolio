  Date: 2023-01-02
  Description: Detects tampering with EventLog service "file" key. In order to change the default location of an Evtx file. This technique is used to tamper with log collection and alerting
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Potential EventLog File Location Tampering</description>
    <match>((TargetObject=\"*\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\EventLog\\\\*\" AND TargetObject=\"*\\\\File\") AND NOT ((Details=\"*\\\\S</match>
  </rule>
</group>
