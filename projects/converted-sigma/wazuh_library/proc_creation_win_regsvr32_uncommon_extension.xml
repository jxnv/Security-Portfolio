<!--
  Title: Regsvr32 DLL Execution With Uncommon Extension
  ID: 50919691-7302-437f-8e10-1fe088afa145
  Status: test
  Level: medium
  Author: Florian Roth (Nextron Systems)
  Date: 2019-07-17
  Description: Detects a "regsvr32" execution where the DLL doesn't contain a common file extension.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Regsvr32 DLL Execution With Uncommon Extension</description>
    <match>(((Image=\"*\\\\regsvr32.exe\") OR (OriginalFileName=\"REGSVR32.EXE\")) AND NOT (((CommandLine=\"\") OR ((CommandLine=\"*.ax*\" OR</match>
  </rule>
</group>
