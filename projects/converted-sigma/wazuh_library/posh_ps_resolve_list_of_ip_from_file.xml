<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>PowerShell Script With File Hostname Resolving Capabilities</description>
    <match>((ScriptBlockText=\"*Get-content *\" AND ScriptBlockText=\"*foreach*\" AND ScriptBlockText=\"*[System.Net.Dns]::GetHostEntry*</match>
  </rule>
</group>
