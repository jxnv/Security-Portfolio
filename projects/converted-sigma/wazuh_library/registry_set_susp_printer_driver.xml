<!--
  Title: Suspicious Printer Driver Empty Manufacturer
  ID: e0813366-0407-449a-9869-a2db1119dc41
  Status: test
  Level: high
  Author: Florian Roth (Nextron Systems)
  Date: 2020-07-01
  Description: Detects a suspicious printer driver installation with an empty Manufacturer value
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Printer Driver Empty Manufacturer</description>
    <match>(((TargetObject=\"*\\\\Control\\\\Print\\\\Environments\\\\Windows x64\\\\Drivers*\" AND TargetObject=\"*\\\\Manufacturer*\") AND Detail</match>
  </rule>
</group>
