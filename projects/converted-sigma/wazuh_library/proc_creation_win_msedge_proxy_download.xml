<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Arbitrary File Download Via MSEDGE_PROXY.EXE</description>
    <match>(((CommandLine=\"*http://*\" OR CommandLine=\"*https://*\")) AND ((Image=\"*\\\\msedge_proxy.exe\") OR (OriginalFileName=\"msedge</match>
  </rule>
</group>
