  Description: Detects loading and execution of an unsigned thor scanner binary.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Unsigned Thor Scanner Execution</description>
    <match>(((Image=\"*\\\\thor.exe\" OR Image=\"*\\\\thor64.exe\") AND (ImageLoaded=\"*\\\\thor.exe\" OR ImageLoaded=\"*\\\\thor64.exe\")) AND NOT</match>
  </rule>
</group>
