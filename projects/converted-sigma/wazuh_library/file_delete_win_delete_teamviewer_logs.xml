<!--
  Title: TeamViewer Log File Deleted
  ID: b1decb61-ed83-4339-8e95-53ea51901720
  Status: test
  Level: low
  Author: frack113
  Date: 2022-01-16
  Description: Detects the deletion of the TeamViewer log files which may indicate an attempt to destroy forensic evidence
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>TeamViewer Log File Deleted</description>
    <match>((TargetFilename=\"*\\\\TeamViewer_*\" AND TargetFilename=\"*.log\") AND NOT ((Image=\"C:\\\\Windows\\\\system32\\\\svchost.exe\")))</match>
  </rule>
</group>
