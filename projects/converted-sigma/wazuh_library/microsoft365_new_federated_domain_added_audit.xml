<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>New Federated Domain Added</description>
    <match>((Operation=\"*domain*\") AND ((Operation=\"*add*\" OR Operation=\"*new*\")))</match>
  </rule>
</group>
