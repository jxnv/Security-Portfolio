  Description: Detects potential DLL sideloading of an unsigned dbghelp.dll by the Sysinternals VMMap.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>VMMap Unsigned Dbghelp.DLL Potential Sideloading</description>
    <match>((ImageLoaded=\"*C:\\\\Debuggers\\\\dbghelp.dll*\" AND (Image=\"*\\\\vmmap.exe\" OR Image=\"*\\\\vmmap64.exe\")) AND NOT ((Signed=\"tru</match>
  </rule>
</group>
