<!--
  Title: Potential Password Spraying Attempt Using Dsacls.EXE
  ID: bac9fb54-2da7-44e9-988f-11e9a5edbc0c
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-06-20
  Description: Detects possible password spraying attempts using Dsacls
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potential Password Spraying Attempt Using Dsacls.EXE</description>
    <match>(((CommandLine=\"*/user:*\" AND CommandLine=\"*/passwd:*\")) AND ((Image=\"*\\\\dsacls.exe\") OR (OriginalFileName=\"DSACLS.EXE\")</match>
  </rule>
</group>
