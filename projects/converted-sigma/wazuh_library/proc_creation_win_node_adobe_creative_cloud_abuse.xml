<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Node Process Executions</description>
    <match>((Image=\"*\\\\Adobe Creative Cloud Experience\\\\libs\\\\node.exe\") AND NOT ((CommandLine=\"*Adobe Creative Cloud Experience\\\\j</match>
  </rule>
</group>
