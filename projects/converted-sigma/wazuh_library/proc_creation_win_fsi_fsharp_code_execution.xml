  Description: Detects the execution of FSharp Interpreters "FsiAnyCpu.exe" and "FSi.exe" Both can be used for AWL bypass and to execute F# code via scripts or inline.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Use of FSharp Interpreters</description>
    <match>(((Image=\"*\\\\fsi.exe\" OR Image=\"*\\\\fsianycpu.exe\")) OR ((OriginalFileName=\"fsi.exe\" OR OriginalFileName=\"fsianycpu.exe\")</match>
  </rule>
</group>
