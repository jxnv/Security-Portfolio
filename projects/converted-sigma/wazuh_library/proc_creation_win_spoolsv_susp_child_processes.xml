<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Spool Service Child Process</description>
    <match>((ParentImage=\"*\\\\spoolsv.exe\" AND (IntegrityLevel=\"System\" OR IntegrityLevel=\"S-1-16-16384\")) AND (((Image=\"*\\\\gpupdate</match>
  </rule>
</group>
