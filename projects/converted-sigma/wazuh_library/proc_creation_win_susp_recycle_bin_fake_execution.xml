<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Process Execution From Fake Recycle.Bin Folder</description>
    <match>((Image=\"*RECYCLERS.BIN\\\\*\" OR Image=\"*RECYCLER.BIN\\\\*\"))</match>
  </rule>
</group>
