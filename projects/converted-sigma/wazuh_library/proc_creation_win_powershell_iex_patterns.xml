<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious PowerShell IEX Execution Patterns</description>
    <match>((((Image=\"*\\\\powershell.exe\" OR Image=\"*\\\\pwsh.exe\") AND (CommandLine=\"* | iex;*\" OR CommandLine=\"* | iex *\" OR Command</match>
  </rule>
</group>
