<!--
  Title: Suspicious Use of /dev/tcp
  ID: 6cc5fceb-9a71-4c23-aeeb-963abe0b279c
  Status: test
  Level: medium
  Author: frack113
  Date: 2021-12-10
  Description: Detects suspicious command with /dev/tcp
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Suspicious Use of /dev/tcp</description>
    <match>(\"cat </dev/tcp/\" OR \"exec 3<>/dev/tcp/\" OR \"echo >/dev/tcp/\" OR \"bash -i >& /dev/tcp/\" OR \"sh -i >& /dev/udp/\" OR \"0<&1</match>
  </rule>
</group>
