<!--
  Title: Potentially Suspicious Desktop Background Change Via Registry
  ID: 85b88e05-dadc-430b-8a9e-53ff1cd30aae
  Status: test
  Level: medium
  Author: Nasreddine Bencherchali (Nextron Systems), Stephen Lincoln @slincoln-aiq (AttackIQ)
  Date: 2023-12-21
  Description: Detects registry value settings that would replace the user's desktop background. This is a common technique used by malware to change the desktop background to a ransom note or other image.
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potentially Suspicious Desktop Background Change Via Registry</description>
    <match>(((TargetObject=\"*Control Panel\\\\Desktop*\" OR TargetObject=\"*CurrentVersion\\\\Policies\\\\ActiveDesktop*\" OR TargetObject=\"</match>
  </rule>
</group>
