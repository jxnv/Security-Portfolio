<!--
  Title: HTTP Logging Disabled On IIS Server
  ID: e8ebd53a-30c2-45bd-81bb-74befba07bdb
  Status: test
  Level: high
  Author: frack113
  Date: 2024-10-06
  Description: Detects changes to of the IIS server configuration in order to disable HTTP logging for successful requests.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>HTTP Logging Disabled On IIS Server</description>
    <match>(EventID=\"29\" AND Configuration=\"/system.webServer/httpLogging/@dontLog\" AND NewValue=\"true\")</match>
  </rule>
</group>
