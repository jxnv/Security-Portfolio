  Status: test
  Level: medium
  Author: Joseliyo Sanchez, @Joseliyo_Jstnk
  Date: 2023-06-02
  Description: Detects a potentially suspicious execution of a process located in the '/tmp/' folder
-->

<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Potentially Suspicious Execution From Tmp Folder</description>
    <match>((Image=\"/tmp/*\") AND NOT ((Image=\"*/usr/bin/nextcloud\")))</match>
  </rule>
</group>
