<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>ShimCache Flush</description>
    <match>((((CommandLine=\"*rundll32*\" AND CommandLine=\"*apphelp.dll*\")) AND ((CommandLine=\"*ShimFlushCache*\" OR CommandLine=\"*#25</match>
  </rule>
</group>
