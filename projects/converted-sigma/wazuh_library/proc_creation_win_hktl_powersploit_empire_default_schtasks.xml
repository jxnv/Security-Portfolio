<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>HackTool - Default PowerSploit/Empire Scheduled Task Creation</description>
    <match>((ParentImage=\"*\\\\powershell.exe\" OR ParentImage=\"*\\\\pwsh.exe\") AND Image=\"*\\\\schtasks.exe\" AND (CommandLine=\"*/Create*\"</match>
  </rule>
</group>
