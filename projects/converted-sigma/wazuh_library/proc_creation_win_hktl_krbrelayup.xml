<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>HackTool - KrbRelayUp Execution</description>
    <match>(((CommandLine=\"* relay *\" AND CommandLine=\"* -Domain *\" AND CommandLine=\"* -ComputerName *\")) OR ((CommandLine=\"* krbsc</match>
  </rule>
</group>
