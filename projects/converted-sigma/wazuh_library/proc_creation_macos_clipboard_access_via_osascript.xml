<group name="sigma_converted,">
  <rule id="100001" level="5">
    <description>Clipboard Access Via OSAScript</description>
    <match>((Image=\"*/osascript\" AND (CommandLine=\"* -e *\" AND CommandLine=\"*clipboard*\")) AND NOT ((ParentImage=\"*opencode\" AND (C</match>
  </rule>
</group>
