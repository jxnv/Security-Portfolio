<!--
  Title: Suspicious Environment Variable Has Been Registered
  ID: 966315ef-c5e1-4767-ba25-fce9c8de3660
  Status: test
  Level: high
  Author: Nasreddine Bencherchali (Nextron Systems)
  Date: 2022-12-20
  Description: Detects the creation of user-specific or system-wide environment variables via the registry. Which contains suspicious commands and strings
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious Environment Variable Has Been Registered</description>
    <match>((((Details=\"powershell\" OR Details=\"pwsh\")) OR ((Details=\"*\\\\AppData\\\\Local\\\\Temp\\\\*\" OR Details=\"*C:\\\\Users\\\\Public\\\\*</match>
  </rule>
</group>
