    <match>(TargetFilename=\"*.rdp\" AND (Image=\"*\\\\brave.exe\" OR Image=\"*\\\\CCleaner Browser\\\\Application\\\\CCleanerBrowser.exe\" OR Im</match>
  </rule>
</group>
