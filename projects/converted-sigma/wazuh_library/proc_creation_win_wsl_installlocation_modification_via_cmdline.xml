<!--
  Title: Suspicious WSL InstallLocation Registry Key Modification Via CommandLine
  ID: f9f62824-de4e-40ca-afe7-8358f76a876d
  Status: experimental
  Level: high
  Author: Swachchhanda Shrawan Poudel (Nextron Systems)
  Date: 2026-05-05
  Description: Detects the use of reg.exe or PowerShell to modify the WSL InstallLocation registry key via command-line arguments. Legitimate modifications to this key are performed exclusively by the Windows Installer (msiexec.exe) during WSL package installation or update. Manual use of reg.exe or PowerShell to set this value strongly indicates an attempt to redirect WSL execution to a malicious binary.
-->

<group name="sigma_converted,">
  <rule id="100001" level="10">
    <description>Suspicious WSL InstallLocation Registry Key Modification Via CommandLine</description>
    <match>(((CommandLine=\"* add *\" OR CommandLine=\"*New-ItemProperty*\" OR CommandLine=\"*Set-ItemProperty*\" OR CommandLine=\"*sp *\")</match>
  </rule>
</group>
