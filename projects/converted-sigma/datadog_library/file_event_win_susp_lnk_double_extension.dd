# Title: Suspicious LNK Double Extension File Created
# ID: 3215aa19-f060-4332-86d5-5602511f3ca8
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems), frack113
# Date: 2022-11-07
# Tags: attack.stealth, attack.t1036.007
# Description: Detects the creation of files with an "LNK" as a second extension. This is sometimes used by malware as a method to abuse the fact that Windows hides the "LNK" extension by default.
# Converted by: Sigma Universal SIEM/EDR CLI

((@TargetFilename:*.lnk AND (@TargetFilename:*.doc.* OR @TargetFilename:*.docx.* OR @TargetFilename:*.jpg.* OR @TargetFilename:*.pdf.* OR @TargetFilename:*.ppt.* OR @TargetFilename:*.pptx.* OR @TargetFilename:*.xls.* OR @TargetFilename:*.xlsx.*)) AND -((@TargetFilename:*\\AppData\\Roaming\\Microsoft\\Windows\\Recent\\*)) AND -(((@Image:*\\excel.exe AND @TargetFilename:*\\AppData\\Roaming\\Microsoft\\Excel*) OR (@Image:*\\powerpnt.exe AND @TargetFilename:*\\AppData\\Roaming\\Microsoft\\PowerPoint*) OR ((@Image:*\\excel.exe OR @Image:*\\powerpnt.exe OR @Image:*\\winword.exe) AND @TargetFilename:*\\AppData\\Roaming\\Microsoft\\Office\\Recent\\*) OR (@Image:*\\winword.exe AND @TargetFilename:*\\AppData\\Roaming\\Microsoft\\Word*))))
