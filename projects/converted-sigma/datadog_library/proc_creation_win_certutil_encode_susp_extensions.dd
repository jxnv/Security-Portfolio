# Title: Suspicious File Encoded To Base64 Via Certutil.EXE
# ID: ea0cdc3e-2239-4f26-a947-4e8f8224e464
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-05-15
# Tags: attack.stealth, attack.t1027
# Description: Detects the execution of certutil with the "encode" flag to encode a file to base64 where the extensions of the file is suspicious
# Converted by: Sigma Universal SIEM/EDR CLI

(((@CommandLine:*-encode* OR @CommandLine:*/encode*)) AND ((@CommandLine:*.acl* OR @CommandLine:*.bat* OR @CommandLine:*.doc* OR @CommandLine:*.gif* OR @CommandLine:*.jpeg* OR @CommandLine:*.jpg* OR @CommandLine:*.mp3* OR @CommandLine:*.pdf* OR @CommandLine:*.png* OR @CommandLine:*.ppt* OR @CommandLine:*.tmp* OR @CommandLine:*.xls* OR @CommandLine:*.xml*)) AND ((@Image:*\\certutil.exe) OR (@OriginalFileName:"CertUtil.exe")))
