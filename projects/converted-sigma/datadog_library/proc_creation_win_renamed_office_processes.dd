# Title: Renamed Office Binary Execution
# ID: 0b0cd537-fc77-4e6e-a973-e53495c1083d
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-12-20
# Tags: attack.stealth, attack.t1036.003
# Description: Detects the execution of a renamed office binary
# Converted by: Sigma Universal SIEM/EDR CLI

((((@OriginalFileName:"Excel.exe" OR @OriginalFileName:"MSACCESS.EXE" OR @OriginalFileName:"MSPUB.EXE" OR @OriginalFileName:"OneNote.exe" OR @OriginalFileName:"OneNoteM.exe" OR @OriginalFileName:"OUTLOOK.EXE" OR @OriginalFileName:"POWERPNT.EXE" OR @OriginalFileName:"WinWord.exe" OR @OriginalFileName:"Olk.exe")) OR ((@Description:"Microsoft Access" OR @Description:"Microsoft Excel" OR @Description:"Microsoft OneNote" OR @Description:"Microsoft Outlook" OR @Description:"Microsoft PowerPoint" OR @Description:"Microsoft Publisher" OR @Description:"Microsoft Word" OR @Description:"Sent to OneNote Tool"))) AND -(((@Image:*\\EXCEL.exe OR @Image:*\\excelcnv.exe OR @Image:*\\MSACCESS.exe OR @Image:*\\MSPUB.EXE OR @Image:*\\ONENOTE.EXE OR @Image:*\\ONENOTEM.EXE OR @Image:*\\OUTLOOK.EXE OR @Image:*\\POWERPNT.EXE OR @Image:*\\WINWORD.exe OR @Image:*\\OLK.EXE))))
