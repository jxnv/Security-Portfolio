# Title: Invoke-Obfuscation Obfuscated IEX Invocation - System
# ID: 51aa9387-1c53-4153-91cc-d73c59ae1ca9
# Status: test
# Level: high
# Author: Daniel Bohannon (@Mandiant/@FireEye), oscd.community
# Date: 2019-11-08
# Tags: attack.stealth, attack.t1027
# Description: Detects all variations of obfuscated powershell IEX invocation code generated by Invoke-Obfuscation framework from the code block linked in the references
# Converted by: Sigma Universal SIEM/EDR CLI

((@EventID:"7045") AND ((ImagePath=regex("\\$PSHome\\[\\s*\\d{1,3}\\s*\\]\\s*\\+\\s*\\$PSHome\\[")) OR (ImagePath=regex("\\$ShellId\\[\\s*\\d{1,3}\\s*\\]\\s*\\+\\s*\\$ShellId\\[")) OR (ImagePath=regex("\\$env:Public\\[\\s*\\d{1,3}\\s*\\]\\s*\\+\\s*\\$env:Public\\[")) OR (ImagePath=regex("\\$env:ComSpec\\[(\\s*\\d{1,3}\\s*,){2}")) OR (ImagePath=regex("\\\\*mdr\\*\\W\\s*\\)\\.Name")) OR (ImagePath=regex("\\$VerbosePreference\\.ToString\\(")) OR (ImagePath=regex("\\String\\]\\s*\\$VerbosePreference"))))
