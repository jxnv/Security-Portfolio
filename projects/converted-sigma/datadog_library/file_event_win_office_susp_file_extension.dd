# Title: File With Uncommon Extension Created By An Office Application
# ID: c7a74c80-ba5a-486e-9974-ab9e682bc5e4
# Status: test
# Level: high
# Author: Vadim Khrykov (ThreatIntel), Cyb3rEng (Rule), Nasreddine Bencherchali (Nextron Systems)
# Date: 2021-08-23
# Tags: attack.t1204.002, attack.execution
# Description: Detects the creation of files with an executable or script extension by an Office application.
# Converted by: Sigma Universal SIEM/EDR CLI

((((@Image:*\\excel.exe OR @Image:*\\msaccess.exe OR @Image:*\\mspub.exe OR @Image:*\\powerpnt.exe OR @Image:*\\visio.exe OR @Image:*\\winword.exe)) AND ((@TargetFilename:*.bat OR @TargetFilename:*.cmd OR @TargetFilename:*.com OR @TargetFilename:*.dll OR @TargetFilename:*.exe OR @TargetFilename:*.hta OR @TargetFilename:*.ocx OR @TargetFilename:*.proj OR @TargetFilename:*.ps1 OR @TargetFilename:*.scf OR @TargetFilename:*.scr OR @TargetFilename:*.sys OR @TargetFilename:*.vbe OR @TargetFilename:*.vbs OR @TargetFilename:*.wsf OR @TargetFilename:*.wsh))) AND -((@TargetFilename:*\\AppData\\Local\\assembly\\tmp\\* AND @TargetFilename:*.dll)) AND -((((@TargetFilename:*C:\\Users\\* AND @TargetFilename:*\\AppData\\Local\\Microsoft\\Office\\* AND @TargetFilename:*\\BackstageInAppNavCache\\*) AND @TargetFilename:*.com) OR (@Image:*\\winword.exe AND @TargetFilename:*\\AppData\\Local\\Temp\\webexdelta\\* AND (@TargetFilename:*.dll OR @TargetFilename:*.exe)) OR ((@TargetFilename:*C:\\Users\\* AND @TargetFilename:*\\AppData\\Local\\Microsoft\\Office\\* AND @TargetFilename:*\\WebServiceCache\\AllUsers*) AND @TargetFilename:*.com))))
