# Tags: attack.credential-access
# Description: Detects the execution of the LaZagne. A utility used to retrieve multiple types of passwords stored on a local computer.
# LaZagne has been leveraged multiple times by threat actors in order to dump credentials.
# Converted by: Sigma Universal SIEM/EDR CLI

((((process.executable:*:\\PerfLogs\\* OR process.executable:*:\\ProgramData\\* OR process.executable:*:\\Temp\\* OR process.executable:*:\\Tmp\\* OR process.executable:*:\\Users\\Public\\* OR process.executable:*:\\Windows\\Temp\\* OR process.executable:*\\$Recycle.bin* OR process.executable:*\\AppData\\* OR process.executable:*\\Desktop\\* OR process.executable:*\\Downloads\\* OR process.executable:*\\Favorites\\* OR process.executable:*\\Links\\* OR process.executable:*\\Music\\* OR process.executable:*\\Photos\\* OR process.executable:*\\Pictures\\* OR process.executable:*\\Saved Games\\* OR process.executable:*\\Searches\\* OR process.executable:*\\Users\\Contacts\\* OR process.executable:*\\Users\\Default\\* OR process.executable:*\\Users\\Searches\\* OR process.executable:*\\Videos\\* OR process.executable:*\\Windows\\addins\\* OR process.executable:*\\Windows\\Fonts\\* OR process.executable:*\\Windows\\IME\\*) AND (process.command_line:*.exe all OR process.command_line:*.exe browsers OR process.command_line:*.exe chats OR process.command_line:*.exe databases OR process.command_line:*.exe games OR process.command_line:*.exe git OR process.command_line:*.exe mails OR process.command_line:*.exe maven OR process.command_line:*.exe memory OR process.command_line:*.exe multimedia OR process.command_line:*.exe sysadmin OR process.command_line:*.exe unused OR process.command_line:*.exe wifi OR process.command_line:*.exe windows)) OR (process.executable:*\\lazagne.exe)) OR (((process.command_line:* all * OR process.command_line:* browsers * OR process.command_line:* chats * OR process.command_line:* databases * OR process.command_line:* games * OR process.command_line:* mails * OR process.command_line:* maven * OR process.command_line:* memory * OR process.command_line:* multimedia * OR process.command_line:* php * OR process.command_line:* svn * OR process.command_line:* sysadmin * OR process.command_line:* unused * OR process.command_line:* wifi *)) AND ((process.command_line:*-1Password* OR process.command_line:*-apachedirectorystudio* OR process.command_line:*-autologon* OR process.command_line:*-ChromiumBased* OR process.command_line:*-coreftp* OR process.command_line:*-credfiles* OR process.command_line:*-credman* OR process.command_line:*-cyberduck* OR process.command_line:*-dbvis* OR process.command_line:*-EyeCon* OR process.command_line:*-filezilla* OR process.command_line:*-filezillaserver* OR process.command_line:*-ftpnavigator* OR process.command_line:*-galconfusion* OR process.command_line:*-gitforwindows* OR process.command_line:*-hashdump* OR process.command_line:*-iisapppool* OR process.command_line:*-IISCentralCertP* OR process.command_line:*-kalypsomedia* OR process.command_line:*-keepass* OR process.command_line:*-keepassconfig* OR process.command_line:*-lsa_secrets* OR process.command_line:*-mavenrepositories* OR process.command_line:*-memory_dump* OR process.command_line:*-Mozilla* OR process.command_line:*-mRemoteNG* OR process.command_line:*-mscache* OR process.command_line:*-opensshforwindows* OR process.command_line:*-openvpn* OR process.command_line:*-outlook* OR process.command_line:*-pidgin* OR process.command_line:*-postgresql* OR process.command_line:*-psi-im* OR process.command_line:*-puttycm* OR process.command_line:*-pypykatz* OR process.command_line:*-Rclone* OR process.command_line:*-rdpmanager* OR process.command_line:*-robomongo* OR process.command_line:*-roguestale* OR process.command_line:*-skype* OR process.command_line:*-SQLDeveloper* OR process.command_line:*-squirrel* OR process.command_line:*-tortoise* OR process.command_line:*-turba* OR process.command_line:*-UCBrowser* OR process.command_line:*-unattended* OR process.command_line:*-vault* OR process.command_line:*-vaultfiles* OR process.command_line:*-vnc* OR process.command_line:*-winscp*))))
