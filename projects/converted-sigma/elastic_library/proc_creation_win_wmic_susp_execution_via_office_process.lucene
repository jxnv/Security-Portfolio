(((process.parent.executable:*\\WINWORD.EXE OR process.parent.executable:*\\EXCEL.EXE OR process.parent.executable:*\\POWERPNT.exe OR process.parent.executable:*\\MSPUB.exe OR process.parent.executable:*\\VISIO.exe OR process.parent.executable:*\\MSACCESS.EXE OR process.parent.executable:*\\EQNEDT32.EXE OR process.parent.executable:*\\ONENOTE.EXE OR process.parent.executable:*\\wordpad.exe OR process.parent.executable:*\\wordview.exe)) AND ((process.command_line:*process* AND process.command_line:*create* AND process.command_line:*call*) AND (process.command_line:*regsvr32* OR process.command_line:*rundll32* OR process.command_line:*msiexec* OR process.command_line:*mshta* OR process.command_line:*verclsid* OR process.command_line:*wscript* OR process.command_line:*cscript*)) AND ((process.executable:*\\wbem\\WMIC.exe) OR (process.pe.original_file_name:"wmic.exe")))
