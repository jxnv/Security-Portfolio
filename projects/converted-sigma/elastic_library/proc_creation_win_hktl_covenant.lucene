(((process.command_line:*-Sta* AND process.command_line:*-Nop* AND process.command_line:*-Window* AND process.command_line:*Hidden*) AND (process.command_line:*-Command* OR process.command_line:*-EncodedCommand*)) OR ((process.command_line:*sv o (New-Object IO.MemorySteam);sv d * OR process.command_line:*mshta file.hta* OR process.command_line:*GruntHTTP* OR process.command_line:*-EncodedCommand cwB2ACAAbwAgA*)))
