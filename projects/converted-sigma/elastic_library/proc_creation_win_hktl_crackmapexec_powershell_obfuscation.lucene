# Description: The CrachMapExec pentesting framework implements a PowerShell obfuscation with some static strings detected by this rule.
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.command_line:*join*split* OR process.command_line:*( $ShellId[1]+$ShellId[13]+'x')* OR process.command_line:*( $PSHome[*]+$PSHOME[*]+* OR process.command_line:*( $env:Public[13]+$env:Public[5]+'x')* OR process.command_line:*( $env:ComSpec[4,*,25]-Join'')* OR process.command_line:*[1,3]+'x'-Join'')*)) AND (((process.executable:*\\powershell.exe OR process.executable:*\\pwsh.exe)) OR ((process.pe.original_file_name:"PowerShell.EXE" OR process.pe.original_file_name:"pwsh.dll"))))
