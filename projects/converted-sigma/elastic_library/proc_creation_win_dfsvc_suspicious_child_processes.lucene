# Title: Potentially Suspicious Child Process Of ClickOnce Application
# ID: 67bc0e75-c0a9-4cfc-8754-84a505b63c04
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-06-12
# Tags: attack.execution, attack.stealth
# Description: Detects potentially suspicious child processes of a ClickOnce deployment application
# Converted by: Sigma Universal SIEM/EDR CLI

(process.parent.executable:*\\AppData\\Local\\Apps\\2.0\\* AND (process.executable:*\\calc.exe OR process.executable:*\\cmd.exe OR process.executable:*\\cscript.exe OR process.executable:*\\explorer.exe OR process.executable:*\\mshta.exe OR process.executable:*\\net.exe OR process.executable:*\\net1.exe OR process.executable:*\\nltest.exe OR process.executable:*\\notepad.exe OR process.executable:*\\powershell.exe OR process.executable:*\\pwsh.exe OR process.executable:*\\reg.exe OR process.executable:*\\regsvr32.exe OR process.executable:*\\rundll32.exe OR process.executable:*\\schtasks.exe OR process.executable:*\\werfault.exe OR process.executable:*\\wscript.exe))
