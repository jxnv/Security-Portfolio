# Title: Execution of Suspicious File Type Extension
# ID: c09dad97-1c78-4f71-b127-7edb2b8e491a
# Status: test
# Level: medium
# Author: Max Altgelt (Nextron Systems)
# Date: 2021-12-09
# Tags: attack.stealth
# Description: Detects whether the image specified in a process creation event doesn't refer to an ".exe" (or other known executable extension) file. This can be caused by process ghosting or other unorthodox methods to start a process.
# This rule might require some initial baselining to align with some third party tooling in the user environment.
# Converted by: Sigma Universal SIEM/EDR CLI

(NOT (((process.executable:*.bin OR process.executable:*.cgi OR process.executable:*.com OR process.executable:*.exe OR process.executable:*.scr OR process.executable:*.tmp))) AND NOT (((process.executable:*:\\$Extend\\$Deleted\\*) OR (process.executable:*:\\Windows\\System32\\DriverStore\\FileRepository\\*) OR ((process.executable:"-" OR process.executable:"")) OR ((process.executable:"System" OR process.executable:"Registry" OR process.executable:"MemCompression" OR process.executable:"vmmem")) OR (process.executable:*:\\Windows\\Installer\\MSI*) OR (process.executable:*:\\Config.Msi\\* AND (process.executable:*.rbf OR process.executable:*.rbs)) OR (NOT _exists_:process.executable) OR ((process.parent.executable:*:\\Windows\\Temp\\*) OR (process.executable:*:\\Windows\\Temp\\*)))) AND NOT (((process.parent.executable:*:\\ProgramData\\Avira\\*) OR (process.parent.executable:"C:\\Windows\\System32\\services.exe" AND process.executable:*com.docker.service) OR (process.executable:*:\\Program Files\\Mozilla Firefox\\*) OR (process.executable:*\\LZMA_EXE) OR ((process.executable:*:\\Program Files (x86)\\MyQ\\Server\\pcltool.dll OR process.executable:*:\\Program Files\\MyQ\\Server\\pcltool.dll)) OR (process.executable:*NVIDIA\\NvBackend\\* AND process.executable:*.dat) OR ((process.executable:*:\\Program Files (x86)\\WINPAKPRO\\* OR process.executable:*:\\Program Files\\WINPAKPRO\\*) AND process.executable:*.ngn) OR ((process.executable:*\\AppData\\Local\\Packages\\* AND process.executable:*\\LocalState\\rootfs\\*)))))
