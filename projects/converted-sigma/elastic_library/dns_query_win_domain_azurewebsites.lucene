# Title: DNS Query To AzureWebsites.NET By Non-Browser Process
# ID: e043f529-8514-4205-8ab0-7f7d2927b400
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2024-06-24
# Tags: attack.command-and-control, attack.t1219.002
# Description: Detects a DNS query by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
# Converted by: Sigma Universal SIEM/EDR CLI

((QueryName:*azurewebsites.net) AND NOT ((((process.executable:C:\\Program Files (x86)\\Avant Browser\\* OR process.executable:C:\\Program Files\\Avant Browser\\*) AND process.executable:*\\avant.exe) OR (process.executable:*\\brave.exe AND process.executable:C:\\Program Files\\BraveSoftware\\*) OR ((process.executable:"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR process.executable:"C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((process.executable:*\\MsMpEng.exe OR process.executable:*\\MsSense.exe)) OR ((process.executable:C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*) OR (process.executable:*\\WindowsApps\\MicrosoftEdge.exe) OR ((process.executable:"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR process.executable:"C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process.executable:C:\\Program Files (x86)\\Microsoft\\EdgeCore\\* OR process.executable:C:\\Program Files\\Microsoft\\EdgeCore\\*) AND (process.executable:*\\msedge.exe OR process.executable:*\\msedgewebview2.exe)) OR ((process.executable:C:\\Program Files\\Falkon\\* OR process.executable:C:\\Program Files (x86)\\Falkon\\*) AND process.executable:*\\falkon.exe) OR ((process.executable:"C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR process.executable:"C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR (process.executable:*\\AppData\\Local\\Flock\\* AND process.executable:*\\Flock.exe) OR ((process.executable:"C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR process.executable:"C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process.executable:*\\AppData\\Local\\Maxthon\\* AND process.executable:*\\maxthon.exe) OR (process.executable:*\\AppData\\Local\\Programs\\midori-ng\\* AND process.executable:*\\Midori Next Generation.exe) OR (process.executable:*\\AppData\\Local\\Programs\\Opera\\* AND process.executable:*\\opera.exe) OR (process.executable:*\\AppData\\Local\\Phoebe\\* AND process.executable:*\\Phoebe.exe) OR (process.executable:*\\safari.exe) OR ((process.executable:C:\\Program Files\\SeaMonkey\\* OR process.executable:C:\\Program Files (x86)\\SeaMonkey\\*) AND process.executable:*\\seamonkey.exe) OR ((process.executable:C:\\Program Files\\SlimBrowser\\* OR process.executable:C:\\Program Files (x86)\\SlimBrowser\\*) AND process.executable:*\\slimbrowser.exe) OR (process.executable:*\\Tor Browser\\*) OR (process.executable:*\\AppData\\Local\\Vivaldi\\* AND process.executable:*\\vivaldi.exe) OR ((process.executable:C:\\Program Files\\Naver\\Naver Whale\\* OR process.executable:C:\\Program Files (x86)\\Naver\\Naver Whale\\*) AND process.executable:*\\whale.exe) OR ((process.executable:C:\\Program Files\\Waterfox\\* OR process.executable:C:\\Program Files (x86)\\Waterfox\\*) AND process.executable:*\\Waterfox.exe))))
