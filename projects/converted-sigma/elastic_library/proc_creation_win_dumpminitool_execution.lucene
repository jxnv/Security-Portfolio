# Title: DumpMinitool Execution
# ID: dee0a7a3-f200-4112-a99b-952196d81e42
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems), Florian Roth (Nextron Systems)
# Date: 2022-04-06
# Tags: attack.stealth, attack.t1036, attack.t1003.001, attack.credential-access
# Description: Detects the use of "DumpMinitool.exe" a tool that allows the dump of process memory via the use of the "MiniDumpWriteDump"
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.command_line:* Full* OR process.command_line:* Mini* OR process.command_line:* WithHeap*)) AND (((process.executable:*\\DumpMinitool.exe OR process.executable:*\\DumpMinitool.x86.exe OR process.executable:*\\DumpMinitool.arm64.exe)) OR ((process.pe.original_file_name:"DumpMinitool.exe" OR process.pe.original_file_name:"DumpMinitool.x86.exe" OR process.pe.original_file_name:"DumpMinitool.arm64.exe"))))
