# Title: Suspicious Windows Defender Registry Key Tampering Via Reg.EXE
# ID: 452bce90-6fb0-43cc-97a5-affc283139b3
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems), Swachchhanda Shrawan Poudel, Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-03-22
# Tags: attack.defense-impairment, attack.t1685
# Description: Detects the usage of "reg.exe" to tamper with different Windows Defender registry keys in order to disable some important features related to protection and detection
# Converted by: Sigma Universal SIEM/EDR CLI

((((process.executable:*\\reg.exe) OR (process.pe.original_file_name:"reg.exe")) AND ((process.command_line:*SOFTWARE\\Microsoft\\Windows Defender\\* OR process.command_line:*SOFTWARE\\Policies\\Microsoft\\Windows Defender Security Center* OR process.command_line:*SOFTWARE\\Policies\\Microsoft\\Windows Defender\\*))) AND (((process.command_line:* add * AND process.command_line:*d 0*) AND (process.command_line:*DisallowExploitProtectionOverride* OR process.command_line:*EnableControlledFolderAccess* OR process.command_line:*MpEnablePus* OR process.command_line:*PUAProtection* OR process.command_line:*SpynetReporting* OR process.command_line:*SubmitSamplesConsent* OR process.command_line:*TamperProtection*)) OR ((process.command_line:* add * AND process.command_line:*d 1*) AND (process.command_line:*DisableAccess* OR process.command_line:*DisableAntiSpyware* OR process.command_line:*DisableAntiSpywareRealtimeProtection* OR process.command_line:*DisableAntiVirus* OR process.command_line:*DisableAntiVirusSignatures* OR process.command_line:*DisableArchiveScanning* OR process.command_line:*DisableBehaviorMonitoring* OR process.command_line:*DisableBlockAtFirstSeen* OR process.command_line:*DisableCloudProtection* OR process.command_line:*DisableConfig* OR process.command_line:*DisableEnhancedNotifications* OR process.command_line:*DisableIntrusionPreventionSystem* OR process.command_line:*DisableIOAVProtection* OR process.command_line:*DisableNetworkProtection* OR process.command_line:*DisableOnAccessProtection* OR process.command_line:*DisablePrivacyMode* OR process.command_line:*DisableRealtimeMonitoring* OR process.command_line:*DisableRoutinelyTakingAction* OR process.command_line:*DisableScanOnRealtimeEnable* OR process.command_line:*DisableScriptScanning* OR process.command_line:*DisableSecurityCenter* OR process.command_line:*Notification_Suppress* OR process.command_line:*SignatureDisableUpdateOnStartupWithoutEngine*))))
