# Title: Use NTFS Short Name in Image
# ID: 3ef5605c-9eb9-47b0-9a71-b727e6aa5c3b
# Status: test
# Level: medium
# Author: frack113, Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-08-06
# Tags: attack.stealth, attack.t1564.004
# Description: Detect use of the Windows 8.3 short name. Which could be used as a method to avoid Image based detection
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.executable:*~1.bat* OR process.executable:*~1.dll* OR process.executable:*~1.exe* OR process.executable:*~1.hta* OR process.executable:*~1.js* OR process.executable:*~1.msi* OR process.executable:*~1.ps1* OR process.executable:*~1.tmp* OR process.executable:*~1.vbe* OR process.executable:*~1.vbs* OR process.executable:*~2.bat* OR process.executable:*~2.dll* OR process.executable:*~2.exe* OR process.executable:*~2.hta* OR process.executable:*~2.js* OR process.executable:*~2.msi* OR process.executable:*~2.ps1* OR process.executable:*~2.tmp* OR process.executable:*~2.vbe* OR process.executable:*~2.vbs*)) AND NOT ((process.parent.executable:"C:\\Windows\\explorer.exe")) AND NOT (((process.parent.executable:*\\thor\\thor64.exe) OR (process.executable:*\\VCREDI~1.EXE) OR (process.parent.executable:*\\WebEx\\WebexHost.exe) OR (process.executable:"C:\\PROGRA~1\\WinZip\\WZPREL~1.EXE"))))
