# Title: Powershell Create Scheduled Task
# ID: 363eccc0-279a-4ccf-a3ab-24c2e63b11fb
# Status: test
# Level: medium
# Author: frack113
# Date: 2021-12-28
# Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053.005
# Description: Adversaries may abuse the Windows Task Scheduler to perform task scheduling for initial or recurring execution of malicious code
# Converted by: Sigma Universal SIEM/EDR CLI

((((ScriptBlockText:*Invoke-CimMethod* AND ScriptBlockText:*-ClassName* AND ScriptBlockText:*PS_ScheduledTask* AND ScriptBlockText:*-NameSpace* AND ScriptBlockText:*Root\\Microsoft\\Windows\\TaskScheduler*)) OR ((ScriptBlockText:*New-ScheduledTaskAction* OR ScriptBlockText:*New-ScheduledTaskTrigger* OR ScriptBlockText:*New-ScheduledTaskPrincipal* OR ScriptBlockText:*New-ScheduledTaskSettingsSet* OR ScriptBlockText:*New-ScheduledTask* OR ScriptBlockText:*Register-ScheduledTask*))) AND NOT (((ScriptBlockText:*Microsoft.PowerShell.Core\\Export-ModuleMember* AND ScriptBlockText:*Microsoft.Management.Infrastructure.CimInstance* AND ScriptBlockText:*__cmdletization_methodParameter*))))
