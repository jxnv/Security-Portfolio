# Title: Suspicious MSDT Parent Process
# ID: 7a74da6b-ea76-47db-92cc-874ad90df734
# Status: test
# Level: high
# Author: Nextron Systems
# Date: 2022-06-01
# Tags: attack.stealth, attack.t1036, attack.t1218
# Description: Detects msdt.exe executed by a suspicious parent as seen in CVE-2022-30190 / Follina exploitation
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.executable:*\\msdt.exe) OR (process.pe.original_file_name:"msdt.exe")) AND ((process.parent.executable:*\\cmd.exe OR process.parent.executable:*\\cscript.exe OR process.parent.executable:*\\mshta.exe OR process.parent.executable:*\\powershell.exe OR process.parent.executable:*\\pwsh.exe OR process.parent.executable:*\\regsvr32.exe OR process.parent.executable:*\\rundll32.exe OR process.parent.executable:*\\schtasks.exe OR process.parent.executable:*\\wmic.exe OR process.parent.executable:*\\wscript.exe OR process.parent.executable:*\\wsl.exe)))
