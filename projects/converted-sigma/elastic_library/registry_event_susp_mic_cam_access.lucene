# Title: Suspicious Camera and Microphone Access
# ID: 62120148-6b7a-42be-8b91-271c04e281a3
# Status: test
# Level: high
# Author: Den Iuzvyk
# Date: 2020-06-07
# Tags: attack.collection, attack.t1125, attack.t1123
# Description: Detects Processes accessing the camera and microphone from suspicious folder
# Converted by: Sigma Universal SIEM/EDR CLI

(((registry.path:*\\Software\\Microsoft\\Windows\\CurrentVersion\\CapabilityAccessManager\\ConsentStore\\* AND registry.path:*\\NonPackaged*)) AND ((registry.path:*microphone* OR registry.path:*webcam*)) AND ((registry.path:*:#Windows#Temp#* OR registry.path:*:#$Recycle.bin#* OR registry.path:*:#Temp#* OR registry.path:*:#Users#Public#* OR registry.path:*:#Users#Default#* OR registry.path:*:#Users#Desktop#*)))
