# Title: Vim GTFOBin Abuse - Linux
# ID: 7ab8f73a-fcff-428b-84aa-6a5ff7877dea
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems), Luc Génaux
# Date: 2022-12-28
# Tags: attack.execution, attack.discovery, attack.t1059, attack.t1083
# Description: Detects the use of "vim" and it's siblings commands to execute a shell or proxy commands.
# Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments.
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.command_line:*:!/* OR process.command_line:*:!$* OR process.command_line:*:!..* OR process.command_line:*:lua * OR process.command_line:*:py * OR process.command_line:*:shell* OR process.command_line:*/bin/bash* OR process.command_line:*/bin/dash* OR process.command_line:*/bin/fish* OR process.command_line:*/bin/sh* OR process.command_line:*/bin/csh* OR process.command_line:*/bin/ksh* OR process.command_line:*/bin/zsh* OR process.command_line:*/bin/tmux*)) AND ((process.executable:*/rvim OR process.executable:*/vi OR process.executable:*/vim OR process.executable:*/vimdiff) AND (process.command_line:* --cmd * OR process.command_line:* -c*)))
