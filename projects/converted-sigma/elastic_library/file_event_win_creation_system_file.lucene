(((file.path:*\\AtBroker.exe OR file.path:*\\audiodg.exe OR file.path:*\\backgroundTaskHost.exe OR file.path:*\\bcdedit.exe OR file.path:*\\bitsadmin.exe OR file.path:*\\cmdl32.exe OR file.path:*\\cmstp.exe OR file.path:*\\conhost.exe OR file.path:*\\csrss.exe OR file.path:*\\dasHost.exe OR file.path:*\\dfrgui.exe OR file.path:*\\dllhost.exe OR file.path:*\\dwm.exe OR file.path:*\\eventcreate.exe OR file.path:*\\eventvwr.exe OR file.path:*\\explorer.exe OR file.path:*\\extrac32.exe OR file.path:*\\fontdrvhost.exe OR file.path:*\\fsquirt.exe OR file.path:*\\ipconfig.exe OR file.path:*\\iscsicli.exe OR file.path:*\\iscsicpl.exe OR file.path:*\\logman.exe OR file.path:*\\LogonUI.exe OR file.path:*\\LsaIso.exe OR file.path:*\\lsass.exe OR file.path:*\\lsm.exe OR file.path:*\\msiexec.exe OR file.path:*\\msinfo32.exe OR file.path:*\\mstsc.exe OR file.path:*\\nbtstat.exe OR file.path:*\\odbcconf.exe OR file.path:*\\powershell.exe OR file.path:*\\pwsh.exe OR file.path:*\\regini.exe OR file.path:*\\regsvr32.exe OR file.path:*\\rundll32.exe OR file.path:*\\RuntimeBroker.exe OR file.path:*\\schtasks.exe OR file.path:*\\SearchFilterHost.exe OR file.path:*\\SearchIndexer.exe OR file.path:*\\SearchProtocolHost.exe OR file.path:*\\SecurityHealthService.exe OR file.path:*\\SecurityHealthSystray.exe OR file.path:*\\services.exe OR file.path:*\\ShellAppRuntime.exe OR file.path:*\\sihost.exe OR file.path:*\\smartscreen.exe OR file.path:*\\smss.exe OR file.path:*\\spoolsv.exe OR file.path:*\\svchost.exe OR file.path:*\\SystemSettingsBroker.exe OR file.path:*\\taskhost.exe OR file.path:*\\taskhostw.exe OR file.path:*\\Taskmgr.exe OR file.path:*\\TiWorker.exe OR file.path:*\\vssadmin.exe OR file.path:*\\w32tm.exe OR file.path:*\\WerFault.exe OR file.path:*\\WerFaultSecure.exe OR file.path:*\\wermgr.exe OR file.path:*\\wevtutil.exe OR file.path:*\\wininit.exe OR file.path:*\\winlogon.exe OR file.path:*\\winrshost.exe OR file.path:*\\WinRTNetMUAHostServer.exe OR file.path:*\\wlanext.exe OR file.path:*\\wlrmdr.exe OR file.path:*\\WmiPrvSE.exe OR file.path:*\\wslhost.exe OR file.path:*\\WSReset.exe OR file.path:*\\WUDFHost.exe OR file.path:*\\WWAHost.exe)) AND NOT (((file.path:*C:\\Windows\\explorer.exe) OR ((file.path:*C:\\$WINDOWS.~BT\\* OR file.path:*C:\\$WinREAgent\\* OR file.path:*C:\\Windows\\SoftwareDistribution\\* OR file.path:*C:\\Windows\\System32\\* OR file.path:*C:\\Windows\\SysWOW64\\* OR file.path:*C:\\Windows\\WinSxS\\* OR file.path:*C:\\Windows\\uus\\*)) OR (file.path:*C:\\Windows\\System32\\SecurityHealth\\* AND file.path:*\\SecurityHealthSystray.exe AND process.executable:*\\SecurityHealthSetup.exe) OR ((process.executable:*C:\\WINDOWS\\system32\\msiexec.exe OR process.executable:*C:\\WINDOWS\\SysWOW64\\msiexec.exe) AND (file.path:C:\\Program Files\\PowerShell\\7\\pwsh.exe* OR file.path:C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe* OR file.path:C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview\\*)) OR ((process.executable:*C:\\Windows\\system32\\svchost.exe OR process.executable:*C:\\Windows\\SysWOW64\\svchost.exe) AND (file.path:*C:\\Program Files\\WindowsApps\\* OR file.path:*C:\\Program Files (x86)\\WindowsApps\\* OR file.path:*\\AppData\\Local\\Microsoft\\WindowsApps\\*)) OR ((process.executable:*\\TiWorker.exe OR process.executable:*\\wuaucltcore.exe) AND file.path:C:\\Windows\\Temp\\*) OR ((process.executable:"C:\\Windows\\System32\\wuauclt.exe" OR process.executable:"C:\\Windows\\SysWOW64\\wuauclt.exe" OR process.executable:"C:\\Windows\\UUS\\arm64\\wuaucltcore.exe")))) AND NOT (((file.path:"C:\\Program Files\\WSL\\wslhost.exe") OR ((file.path:*C:\\Program Files\\WindowsApps\\MicrosoftCorporationII.WindowsSubsystemForLinux_* AND file.path:*\\wslhost.exe*)) OR ((file.path:*C:\\Users\\* AND file.path:*\\AppData\\Local\\Microsoft\\WindowsApps\\* AND file.path:*\\wslhost.exe*)))))
