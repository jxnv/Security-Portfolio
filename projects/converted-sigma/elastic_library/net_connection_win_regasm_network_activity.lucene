# Tags: attack.stealth, attack.t1218.009
# Description: Detects "RegAsm.exe" initiating a network connection to public IP adresses
# Converted by: Sigma Universal SIEM/EDR CLI

((Initiated:"true" AND process.executable:*\\regasm.exe) AND NOT (((destination.ip:"127.0.0.0/8" OR destination.ip:"10.0.0.0/8" OR destination.ip:"172.16.0.0/12" OR destination.ip:"192.168.0.0/16" OR destination.ip:"169.254.0.0/16" OR destination.ip:"::1/128" OR destination.ip:"fe80::/10" OR destination.ip:"fc00::/7"))))
