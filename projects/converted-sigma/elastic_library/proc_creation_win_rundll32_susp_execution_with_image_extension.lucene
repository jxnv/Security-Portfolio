# Title: Suspicious Rundll32 Execution With Image Extension
# ID: 4aa6040b-3f28-44e3-a769-9208e5feb5ec
# Status: test
# Level: high
# Author: Hieu Tran
# Date: 2023-03-13
# Tags: attack.stealth, attack.t1218.011
# Description: Detects the execution of Rundll32.exe with DLL files masquerading as image files
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.command_line:*.bmp* OR process.command_line:*.cr2* OR process.command_line:*.eps* OR process.command_line:*.gif* OR process.command_line:*.ico* OR process.command_line:*.jpeg* OR process.command_line:*.jpg* OR process.command_line:*.nef* OR process.command_line:*.orf* OR process.command_line:*.png* OR process.command_line:*.raw* OR process.command_line:*.sr2* OR process.command_line:*.tif* OR process.command_line:*.tiff*)) AND ((process.executable:*\\rundll32.exe) OR (process.pe.original_file_name:"RUNDLL32.exe")))
