# Title: Suspicious Msbuild Execution By Uncommon Parent Process
# ID: 33be4333-2c6b-44f4-ae28-102cdbde0a31
# Status: test
# Level: medium
# Author: frack113
# Date: 2022-11-17
# Tags: attack.stealth
# Description: Detects suspicious execution of 'Msbuild.exe' by a uncommon parent process
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.executable:*\\MSBuild.exe) OR (process.pe.original_file_name:"MSBuild.exe")) AND NOT (((process.parent.executable:*\\devenv.exe OR process.parent.executable:*\\cmd.exe OR process.parent.executable:*\\msbuild.exe OR process.parent.executable:*\\python.exe OR process.parent.executable:*\\explorer.exe OR process.parent.executable:*\\nuget.exe))))
