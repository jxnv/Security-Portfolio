# Title: Outbound Network Connection To Public IP Via Winlogon
# ID: 7610a4ea-c06d-495f-a2ac-0a696abcfd3b
# Status: test
# Level: medium
# Author: Christopher Peacock @securepeacock, SCYTHE @scythe_io
# Date: 2023-04-28
# Tags: attack.execution, attack.command-and-control, attack.stealth, attack.t1218.011
# Description: Detects a "winlogon.exe" process that initiate network communications with public IP addresses
# Converted by: Sigma Universal SIEM/EDR CLI

((process.executable:*\\winlogon.exe AND Initiated:"true") AND NOT (((destination.ip:"127.0.0.0/8" OR destination.ip:"10.0.0.0/8" OR destination.ip:"172.16.0.0/12" OR destination.ip:"192.168.0.0/16" OR destination.ip:"169.254.0.0/16" OR destination.ip:"::1/128" OR destination.ip:"fe80::/10" OR destination.ip:"fc00::/7"))))
