((((process.parent.executable:*\\java.exe OR process.parent.executable:*\\javaw.exe) AND (process.parent.executable:*-tomcat-* OR process.parent.executable:*\\tomcat*)) OR ((process.parent.executable:*\\java.exe OR process.parent.executable:*\\javaw.exe) AND (process.command_line:*catalina.jar* OR process.command_line:*CATALINA_HOME*)) OR ((process.parent.executable:*\\caddy.exe OR process.parent.executable:*\\httpd.exe OR process.parent.executable:*\\nginx.exe OR process.parent.executable:*\\php-cgi.exe OR process.parent.executable:*\\w3wp.exe OR process.parent.executable:*\\ws_tomcatservice.exe))) AND (((process.command_line:*rundll32* AND process.command_line:*comsvcs*)) OR ((process.command_line:* -hp* AND process.command_line:* a * AND process.command_line:* -m*)) OR ((process.command_line:*net* AND process.command_line:* user * AND process.command_line:* /add*)) OR ((process.command_line:*net* AND process.command_line:* localgroup * AND process.command_line:* administrators * AND process.command_line:*/add*)) OR ((process.executable:*\\ntdsutil.exe OR process.executable:*\\ldifde.exe OR process.executable:*\\adfind.exe OR process.executable:*\\procdump.exe OR process.executable:*\\Nanodump.exe OR process.executable:*\\vssadmin.exe OR process.executable:*\\fsutil.exe)) OR ((process.command_line:* -decode * OR process.command_line:* -NoP * OR process.command_line:* -W Hidden * OR process.command_line:* /decode * OR process.command_line:* /ticket:* OR process.command_line:* sekurlsa* OR process.command_line:*.dmp full* OR process.command_line:*.downloadfile(* OR process.command_line:*.downloadstring(* OR process.command_line:*FromBase64String* OR process.command_line:*process call create* OR process.command_line:*reg save * OR process.command_line:*whoami /priv*))))
