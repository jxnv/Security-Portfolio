# Title: Suspicious Msiexec Quiet Install From Remote Location
# ID: 8150732a-0c9d-4a99-82b9-9efb9b90c40c
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-10-28
# Tags: attack.stealth, attack.t1218.007
# Description: Detects usage of Msiexec.exe to install packages hosted remotely quietly
# Converted by: Sigma Universal SIEM/EDR CLI

((((process.command_line:*-i* OR process.command_line:*/i* OR process.command_line:*-package* OR process.command_line:*/package* OR process.command_line:*-a* OR process.command_line:*/a* OR process.command_line:*-j* OR process.command_line:*/j*)) AND ((process.executable:*\\msiexec.exe) OR (process.pe.original_file_name:"msiexec.exe")) AND ((process.command_line:*-q* OR process.command_line:*/q*)) AND ((process.command_line:*http* OR process.command_line:*\\\\\\\\*))) AND NOT (((process.command_line:*\\AppData\\Local\\Temp\\OpenOffice* AND process.command_line:*Installation Files\\openoffice*))))
