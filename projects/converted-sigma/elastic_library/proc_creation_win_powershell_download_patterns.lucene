# Title: PowerShell Download Pattern
# ID: 3b6ab547-8ec2-4991-b9d2-2b06702a48d7
# Status: test
# Level: medium
# Author: Florian Roth (Nextron Systems), oscd.community, Jonhnathan Ribeiro
# Date: 2019-01-16
# Tags: attack.execution, attack.t1059.001
# Description: Detects a Powershell process that contains download commands in its command line string
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.command_line:*new-object* AND process.command_line:*net.webclient).* AND process.command_line:*download*) AND (process.command_line:*string(* OR process.command_line:*file(*)) AND (((process.executable:*\\powershell_ise.exe OR process.executable:*\\powershell.exe OR process.executable:*\\pwsh.exe)) OR ((process.pe.original_file_name:"PowerShell_ISE.EXE" OR process.pe.original_file_name:"PowerShell.EXE" OR process.pe.original_file_name:"pwsh.dll"))))
