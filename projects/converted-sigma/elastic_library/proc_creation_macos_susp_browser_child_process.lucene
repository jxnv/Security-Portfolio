(((process.parent.executable:*com.apple.WebKit.WebContent* OR process.parent.executable:*firefox* OR process.parent.executable:*Google Chrome Helper* OR process.parent.executable:*Google Chrome* OR process.parent.executable:*Microsoft Edge* OR process.parent.executable:*Opera* OR process.parent.executable:*Safari* OR process.parent.executable:*Tor Browser*) AND (process.executable:*/bash OR process.executable:*/curl OR process.executable:*/dash OR process.executable:*/ksh OR process.executable:*/osascript OR process.executable:*/perl OR process.executable:*/php OR process.executable:*/pwsh OR process.executable:*/python OR process.executable:*/sh OR process.executable:*/tcsh OR process.executable:*/wget OR process.executable:*/zsh)) AND NOT ((((process.parent.executable:*Google Chrome Helper* OR process.parent.executable:*Google Chrome*) AND (process.command_line:*/Volumes/Google Chrome/Google Chrome.app/Contents/Frameworks/*/Resources/install.sh* OR process.command_line:*/Applications/Google Chrome.app/Contents/Frameworks/Google Chrome Framework.framework/*/Resources/keystone_promote_preflight.sh* OR process.command_line:*/Applications/Google Chrome.app/Contents/Frameworks/Google Chrome Framework.framework/*/Resources/keystone_promote_postflight.sh*)) OR ((process.parent.executable:*Google Chrome Helper* OR process.parent.executable:*Google Chrome*) AND (process.command_line:*/Users/* AND process.command_line:*/Library/Application Support/Google/Chrome/recovery/* AND process.command_line:*/ChromeRecovery*)) OR (process.command_line:*--defaults-torrc*) OR (process.command_line:*/Library/Application Support/Microsoft/MAU*/Microsoft AutoUpdate.app/Contents/MacOS/msupdate*) OR (process.parent.executable:*Microsoft Edge* AND (process.command_line:*IOPlatformExpertDevice* OR process.command_line:*hw.model*)))) AND NOT (((process.command_line:"") OR (NOT _exists_:process.command_line))))
