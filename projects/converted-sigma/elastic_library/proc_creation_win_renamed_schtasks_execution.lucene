# Title: Renamed Schtasks Execution
# ID: f91e51c9-f344-4b32-969b-0b6f6b8537d4
# Status: experimental
# Level: high
# Author: Swachchhanda Shrawan Poudel (Nextron Systems)
# Date: 2025-11-27
# Tags: attack.execution, attack.persistence, attack.privilege-escalation, attack.stealth, attack.t1036.003, attack.t1053.005
# Description: Detects the execution of renamed schtasks.exe binary, which is a legitimate Windows utility used for scheduling tasks.
# One of the very common persistence techniques is schedule malicious tasks using schtasks.exe.
# Since, it is heavily abused, it is also heavily monitored by security products. To evade detection, threat actors may rename the schtasks.exe binary to schedule their malicious tasks.
# Converted by: Sigma Universal SIEM/EDR CLI

(((((process.command_line:* /tn * OR process.command_line:* /tr * OR process.command_line:* /sc * OR process.command_line:* /st * OR process.command_line:* /ru * OR process.command_line:* /fo *)) AND ((process.command_line:* /create * OR process.command_line:* /delete * OR process.command_line:* /query * OR process.command_line:* /change * OR process.command_line:* /run * OR process.command_line:* /end *))) AND NOT ((process.command_line:*schtasks*)) AND NOT (((process.command_line:*openfiles* AND process.command_line:* /query * AND process.command_line:* /fo*)))) OR ((process.pe.original_file_name:"schtasks.exe") AND NOT ((process.executable:*\\schtasks.exe))))
