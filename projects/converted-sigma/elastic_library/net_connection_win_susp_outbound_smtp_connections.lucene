(((destination.port:"25" OR destination.port:"587" OR destination.port:"465" OR destination.port:"2525") AND Initiated:"true") AND NOT ((((process.executable:*\\thunderbird.exe OR process.executable:*\\outlook.exe)) OR (process.executable:C:\\Program Files\\Microsoft\\Exchange Server\\*) OR (process.executable:C:\\Program Files\\WindowsApps\\microsoft.windowscommunicationsapps_* AND process.executable:*\\HxTsr.exe))))
