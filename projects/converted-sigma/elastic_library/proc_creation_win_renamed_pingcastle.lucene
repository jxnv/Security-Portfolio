# Title: Renamed PingCastle Binary Execution
# ID: 2433a154-bb3d-42e4-86c3-a26bdac91c45
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
# Date: 2024-01-11
# Tags: attack.execution, attack.stealth, attack.t1059, attack.t1202
# Description: Detects the execution of a renamed "PingCastle" binary based on the PE metadata fields.
# Converted by: Sigma Universal SIEM/EDR CLI

((((process.pe.original_file_name:"PingCastleReporting.exe" OR process.pe.original_file_name:"PingCastleCloud.exe" OR process.pe.original_file_name:"PingCastle.exe")) OR ((process.command_line:*--scanner aclcheck* OR process.command_line:*--scanner antivirus* OR process.command_line:*--scanner computerversion* OR process.command_line:*--scanner foreignusers* OR process.command_line:*--scanner laps_bitlocker* OR process.command_line:*--scanner localadmin* OR process.command_line:*--scanner nullsession* OR process.command_line:*--scanner nullsession-trust* OR process.command_line:*--scanner oxidbindings* OR process.command_line:*--scanner remote* OR process.command_line:*--scanner share* OR process.command_line:*--scanner smb* OR process.command_line:*--scanner smb3querynetwork* OR process.command_line:*--scanner spooler* OR process.command_line:*--scanner startup* OR process.command_line:*--scanner zerologon*)) OR (process.command_line:*--no-enum-limit*) OR ((process.command_line:*--healthcheck* AND process.command_line:*--level Full*)) OR ((process.command_line:*--healthcheck* AND process.command_line:*--server *))) AND NOT (((process.executable:*\\PingCastleReporting.exe OR process.executable:*\\PingCastleCloud.exe OR process.executable:*\\PingCastle.exe))))
