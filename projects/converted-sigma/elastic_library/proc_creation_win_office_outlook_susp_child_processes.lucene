# Title: Suspicious Outlook Child Process
# ID: 208748f7-881d-47ac-a29c-07ea84bf691d
# Status: test
# Level: high
# Author: Michael Haag, Florian Roth (Nextron Systems), Markus Neis, Elastic, FPT.EagleEye Team
# Date: 2022-02-28
# Tags: attack.execution, attack.t1204.002
# Description: Detects a suspicious process spawning from an Outlook process.
# Converted by: Sigma Universal SIEM/EDR CLI

(process.parent.executable:*\\OUTLOOK.EXE AND (process.executable:*\\AppVLP.exe OR process.executable:*\\bash.exe OR process.executable:*\\cmd.exe OR process.executable:*\\cscript.exe OR process.executable:*\\forfiles.exe OR process.executable:*\\hh.exe OR process.executable:*\\mftrace.exe OR process.executable:*\\msbuild.exe OR process.executable:*\\msdt.exe OR process.executable:*\\mshta.exe OR process.executable:*\\msiexec.exe OR process.executable:*\\powershell.exe OR process.executable:*\\pwsh.exe OR process.executable:*\\regsvr32.exe OR process.executable:*\\schtasks.exe OR process.executable:*\\scrcons.exe OR process.executable:*\\scriptrunner.exe OR process.executable:*\\sh.exe OR process.executable:*\\svchost.exe OR process.executable:*\\wmic.exe OR process.executable:*\\wscript.exe))
