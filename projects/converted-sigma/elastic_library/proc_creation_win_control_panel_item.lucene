# Title: Control Panel Items
# ID: 0ba863e6-def5-4e50-9cea-4dd8c7dc46a4
# Status: test
# Level: high
# Author: Kyaw Min Thein, Furkan Caliskan (@caliskanfurkan_)
# Date: 2020-06-22
# Tags: attack.privilege-escalation, attack.execution, attack.stealth, attack.t1218.002, attack.persistence, attack.t1546
# Description: Detects the malicious use of a control panel item
# Converted by: Sigma Universal SIEM/EDR CLI

((((process.command_line:*add* AND process.command_line:*CurrentVersion\\Control Panel\\CPLs*)) AND ((process.executable:*\\reg.exe) OR (process.pe.original_file_name:"reg.exe"))) OR ((process.command_line:*.cpl) AND NOT ((((process.command_line:*regsvr32 * AND process.command_line:* /s * AND process.command_line:*igfxCPL.cpl*)) OR ((process.command_line:*\\System32\\* OR process.command_line:*%System%* OR process.command_line:*|C:\\Windows\\system32|*))))))
