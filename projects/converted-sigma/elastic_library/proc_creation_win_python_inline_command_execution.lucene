# Title: Python Inline Command Execution
# ID: 899133d5-4d7c-4a7f-94ee-27355c879d90
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-01-02
# Tags: attack.execution, attack.t1059
# Description: Detects execution of python using the "-c" flag. This is could be used as a way to launch a reverse shell or execute live python code.
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.command_line:* -c*) AND ((process.pe.original_file_name:"python.exe") OR ((process.executable:*python.exe OR process.executable:*python3.exe OR process.executable:*python2.exe)))) AND NOT ((((process.parent.executable:C:\\Program Files\\Python* OR process.parent.executable:C:\\Program Files (x86)\\Python*) AND process.parent.executable:*\\python.exe AND process.parent.command_line:*-E -s -m ensurepip -U --default-pip*) OR ((process.parent.executable:C:\\Program Files\\Python* OR process.parent.executable:C:\\Program Files (x86)\\Python*) AND (process.command_line:*-W ignore::DeprecationWarning* AND process.command_line:*['install', '--no-cache-dir', '--no-index', '--find-links',* AND process.command_line:*'--upgrade', 'pip'*)))) AND NOT ((((process.command_line:*<pip-setuptools-caller>* AND process.command_line:*exec(compile(*)) OR ((process.parent.executable:*\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe) OR ((process.parent.executable:"C:\\Program Files\\Microsoft VS Code\\Code.exe" OR process.parent.executable:"C:\\Program Files (x86)\\Microsoft VS Code\\Code.exe"))))))
