# Title: Schtasks Creation Or Modification With SYSTEM Privileges
# ID: 89ca78fd-b37c-4310-b3d3-81a023f83936
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-07-28
# Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053.005
# Description: Detects the creation or update of a scheduled task to run with "NT AUTHORITY\SYSTEM" privileges
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.executable:*\\schtasks.exe AND (process.command_line:* /change * OR process.command_line:* /create *)) AND (process.command_line:*/ru *) AND ((process.command_line:*NT AUT* OR process.command_line:* SYSTEM *))) AND NOT ((((process.command_line:*/Create /F /RU System /SC WEEKLY /TN AviraSystemSpeedupVerify /TR * OR process.command_line:*:\\Program Files (x86)\\Avira\\System Speedup\\setup\\avira_speedup_setup.exe* OR process.command_line:*/VERIFY /VERYSILENT /NOSTART /NODOTNET /NORESTART\" /RL HIGHEST*)) OR ((process.command_line:*Subscription Heartbeat* AND process.command_line:*\\HeartbeatConfig.xml* AND process.command_line:*\\Microsoft Shared\\OFFICE*)) OR (process.executable:*\\schtasks.exe AND (process.command_line:*/TN TVInstallRestore* AND process.command_line:*\\TeamViewer_.exe*)))))
