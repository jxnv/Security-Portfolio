# Description: Detects the creation of files that look like exports of the local SAM (Security Account Manager)
# Converted by: Sigma Universal SIEM/EDR CLI

(((file.path:*\\Temp\\sam OR file.path:*\\sam.sav OR file.path:*\\Intel\\sam OR file.path:*\\sam.hive OR file.path:*\\Perflogs\\sam OR file.path:*\\ProgramData\\sam OR file.path:*\\Users\\Public\\sam OR file.path:*\\AppData\\Local\\sam OR file.path:*\\AppData\\Roaming\\sam OR file.path:*_ShadowSteal.zip OR file.path:*\\Documents\\SAM.export OR file.path:*:\\sam)) OR ((file.path:*\\hive_sam_* OR file.path:*\\sam.save* OR file.path:*\\sam.export* OR file.path:*\\~reg_sam.save* OR file.path:*\\sam_backup* OR file.path:*\\sam.bck* OR file.path:*\\sam.backup*)))
