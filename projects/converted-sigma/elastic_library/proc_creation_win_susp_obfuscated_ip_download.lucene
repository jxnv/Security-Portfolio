# Title: Obfuscated IP Download Activity
# ID: cb5a2333-56cf-4562-8fcb-22ba1bca728d
# Status: test
# Level: medium
# Author: Florian Roth (Nextron Systems), X__Junior (Nextron Systems)
# Date: 2022-08-03
# Tags: attack.discovery
# Description: Detects use of an encoded/obfuscated version of an IP address (hex, octal...) in an URL combined with a download command
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.command_line:*Invoke-WebRequest* OR process.command_line:*iwr * OR process.command_line:*Invoke-RestMethod* OR process.command_line:*irm * OR process.command_line:*wget * OR process.command_line:*curl * OR process.command_line:*DownloadFile* OR process.command_line:*DownloadString*)) AND (((process.command_line:* 0x* OR process.command_line:*//0x* OR process.command_line:*.0x* OR process.command_line:*.00x*)) OR ((process.command_line:*http://%* AND process.command_line:*%2e*)) OR ((process.command_line:/https?://[0-9]{1,3}\.[0-9]{1,3}\.0[0-9]{3,4}/) OR (process.command_line:/https?://[0-9]{1,3}\.0[0-9]{3,7}/) OR (process.command_line:/https?://0[0-9]{3,11}/) OR (process.command_line:/https?://(?:0[0-9]{1,11}\.){3}0[0-9]{1,11}/) OR (process.command_line:/https?://0[0-9]{1,11}/) OR (process.command_line:/ [0-7]{7,13}/))) AND NOT ((process.command_line:/https?://(?:(?:25[0-5]|(?:2[0-4]|1\d|[1-9])?\d)(?:\.|\b)){4}/)))
