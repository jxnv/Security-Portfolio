# Title: Security Software Discovery - MacOs
# ID: 0ed75b9c-c73b-424d-9e7d-496cd565fbe0
# Status: test
# Level: medium
# Author: Daniil Yugoslavskiy, oscd.community
# Date: 2020-10-19
# Tags: attack.discovery, attack.t1518.001
# Description: Detects usage of system utilities (only grep for now) to discover security software discovery
# Converted by: Sigma Universal SIEM/EDR CLI

((process.executable:"/usr/bin/grep") AND (((process.command_line:*nessusd* OR process.command_line:*santad* OR process.command_line:*CbDefense* OR process.command_line:*falcond* OR process.command_line:*td-agent* OR process.command_line:*packetbeat* OR process.command_line:*filebeat* OR process.command_line:*auditbeat* OR process.command_line:*osqueryd* OR process.command_line:*BlockBlock* OR process.command_line:*LuLu*)) OR ((process.command_line:*Little* AND process.command_line:*Snitch*))))
