# Title: Potentially Suspicious Execution Of PDQDeployRunner
# ID: 12b8e9f5-96b2-41e1-9a42-8c6779a5c184
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-07-22
# Tags: attack.execution
# Description: Detects suspicious execution of "PDQDeployRunner" which is part of the PDQDeploy service stack that is responsible for executing commands and packages on a remote machines
# Converted by: Sigma Universal SIEM/EDR CLI

((((process.executable:*\\bash.exe OR process.executable:*\\certutil.exe OR process.executable:*\\cmd.exe OR process.executable:*\\csc.exe OR process.executable:*\\cscript.exe OR process.executable:*\\dllhost.exe OR process.executable:*\\mshta.exe OR process.executable:*\\msiexec.exe OR process.executable:*\\regsvr32.exe OR process.executable:*\\rundll32.exe OR process.executable:*\\scriptrunner.exe OR process.executable:*\\wmic.exe OR process.executable:*\\wscript.exe OR process.executable:*\\wsl.exe)) OR ((process.executable:*:\\ProgramData\\* OR process.executable:*:\\Users\\Public\\* OR process.executable:*:\\Windows\\TEMP\\* OR process.executable:*\\AppData\\Local\\Temp*)) OR ((process.command_line:* -decode * OR process.command_line:* -enc * OR process.command_line:* -encodedcommand * OR process.command_line:* -w hidden* OR process.command_line:*DownloadString* OR process.command_line:*FromBase64String* OR process.command_line:*http* OR process.command_line:*iex * OR process.command_line:*Invoke-*))) AND (process.parent.executable:*\\PDQDeployRunner-*))
