# Title: LOL-Binary Copied From System Directory
# ID: f5d19838-41b5-476c-98d8-ba8af4929ee2
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-08-29
# Tags: attack.stealth, attack.t1036.003
# Description: Detects a suspicious copy operation that tries to copy a known LOLBIN from system (System32, SysWOW64, WinSxS) directories to another on disk in order to bypass detections based on locations.
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.executable:*\\cmd.exe AND process.command_line:*copy *) OR (((process.executable:*\\robocopy.exe OR process.executable:*\\xcopy.exe)) OR ((process.pe.original_file_name:"robocopy.exe" OR process.pe.original_file_name:"XCOPY.EXE"))) OR ((process.executable:*\\powershell.exe OR process.executable:*\\pwsh.exe) AND (process.command_line:*copy-item* OR process.command_line:* copy * OR process.command_line:*cpi * OR process.command_line:* cp *))) AND (((process.command_line:*\\bitsadmin.exe* OR process.command_line:*\\calc.exe* OR process.command_line:*\\certutil.exe* OR process.command_line:*\\cmdl32.exe* OR process.command_line:*\\cscript.exe* OR process.command_line:*\\mshta.exe* OR process.command_line:*\\rundll32.exe* OR process.command_line:*\\wscript.exe* OR process.command_line:*\\ie4uinit.exe*)) AND ((process.command_line:*\\System32* OR process.command_line:*\\SysWOW64* OR process.command_line:*\\WinSxS*))))
