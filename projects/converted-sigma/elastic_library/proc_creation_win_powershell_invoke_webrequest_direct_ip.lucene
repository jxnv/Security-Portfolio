# Title: Suspicious Invoke-WebRequest Execution With DirectIP
# ID: 1edff897-9146-48d2-9066-52e8d8f80a2f
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-04-21
# Tags: attack.command-and-control, attack.t1105
# Description: Detects calls to PowerShell with Invoke-WebRequest cmdlet using direct IP access
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.command_line:*curl * OR process.command_line:*Invoke-RestMethod* OR process.command_line:*Invoke-WebRequest* OR process.command_line:* irm * OR process.command_line:*iwr * OR process.command_line:*wget *)) AND (((process.executable:*\\powershell_ise.exe OR process.executable:*\\powershell.exe OR process.executable:*\\pwsh.exe)) OR ((process.pe.original_file_name:"powershell_ise.EXE" OR process.pe.original_file_name:"PowerShell.EXE" OR process.pe.original_file_name:"pwsh.dll"))) AND ((process.command_line:*://1* OR process.command_line:*://2* OR process.command_line:*://3* OR process.command_line:*://4* OR process.command_line:*://5* OR process.command_line:*://6* OR process.command_line:*://7* OR process.command_line:*://8* OR process.command_line:*://9*)))
