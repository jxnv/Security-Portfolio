# Title: MacOS Scripting Interpreter AppleScript
# ID: 1bc2e6c5-0885-472b-bed6-be5ea8eace55
# Status: test
# Level: medium
# Author: Alejandro Ortuno, oscd.community
# Date: 2020-10-21
# Tags: attack.execution, attack.t1059.002
# Description: Detects execution of AppleScript of the macOS scripting language AppleScript.
# Converted by: Sigma Universal SIEM/EDR CLI

((process.executable:*/osascript AND (process.command_line:* -e * OR process.command_line:*.scpt* OR process.command_line:*.js*)) AND NOT ((process.parent.executable:*opencode AND (process.command_line:*osascript* AND process.command_line:* -e * AND process.command_line:*set imageData to the clipboard* AND process.command_line:*set fileRef*))))
