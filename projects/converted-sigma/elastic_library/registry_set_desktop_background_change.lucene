# Title: Potentially Suspicious Desktop Background Change Via Registry
# ID: 85b88e05-dadc-430b-8a9e-53ff1cd30aae
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems), Stephen Lincoln @slincoln-aiq (AttackIQ)
# Date: 2023-12-21
# Tags: attack.persistence, attack.impact, attack.defense-impairment, attack.t1112, attack.t1491.001
# Description: Detects registry value settings that would replace the user's desktop background.
# This is a common technique used by malware to change the desktop background to a ransom note or other image.
# Converted by: Sigma Universal SIEM/EDR CLI

(((registry.path:*Control Panel\\Desktop* OR registry.path:*CurrentVersion\\Policies\\ActiveDesktop* OR registry.path:*CurrentVersion\\Policies\\System*)) AND ((registry.path:*NoChangingWallpaper AND registry.data.strings:"DWORD (0x00000001)") OR (registry.path:*\\Wallpaper) OR (registry.path:*\\WallpaperStyle AND registry.data.strings:"2")) AND NOT (((registry.path:*\\Control Panel\\Desktop\\Wallpaper AND registry.data.strings:"(Empty)") OR (process.executable:*C:\\Windows\\Explorer.EXE) OR (process.executable:*\\svchost.exe))) AND NOT (((process.executable:"C:\\Program Files\\Amazon\\EC2Launch\\EC2Launch.exe" OR process.executable:"C:\\Program Files (x86)\\Amazon\\EC2Launch\\EC2Launch.exe") AND registry.path:*\\Control Panel\\Desktop\\Wallpaper)))
