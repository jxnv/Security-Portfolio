# Title: Suspicious File Downloaded From File-Sharing Website Via Certutil.EXE
# ID: 42a5f1e7-9603-4f6d-97ae-3f37d130d794
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-02-15
# Tags: attack.stealth, attack.t1027, attack.command-and-control, attack.t1105
# Description: Detects the execution of certutil with certain flags that allow the utility to download files from file-sharing websites.
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.command_line:*urlcache * OR process.command_line:*verifyctl * OR process.command_line:*URL *)) AND ((process.command_line:*.githubusercontent.com* OR process.command_line:*0x0.st* OR process.command_line:*anonfiles.com* OR process.command_line:*bashupload.com* OR process.command_line:*cdn.discordapp.com* OR process.command_line:*chunk.io* OR process.command_line:*ddns.net* OR process.command_line:*dl.dropboxusercontent.com* OR process.command_line:*ghostbin.co* OR process.command_line:*github.com* OR process.command_line:*glitch.me* OR process.command_line:*gofile.io* OR process.command_line:*hastebin.com* OR process.command_line:*mediafire.com* OR process.command_line:*mega.nz* OR process.command_line:*onrender.com* OR process.command_line:*pages.dev* OR process.command_line:*paste.ee* OR process.command_line:*pastebin.com* OR process.command_line:*pastebin.pl* OR process.command_line:*pastetext.net* OR process.command_line:*privatlab.com* OR process.command_line:*privatlab.net* OR process.command_line:*send.exploit.in* OR process.command_line:*sendspace.com* OR process.command_line:*storage.googleapis.com* OR process.command_line:*storjshare.io* OR process.command_line:*supabase.co* OR process.command_line:*temp.sh* OR process.command_line:*transfer.sh* OR process.command_line:*trycloudflare.com* OR process.command_line:*ufile.io* OR process.command_line:*w3spaces.com* OR process.command_line:*workers.dev* OR process.command_line:*x0.at*)) AND ((process.executable:*\\certutil.exe) OR (process.pe.original_file_name:"CertUtil.exe")))
