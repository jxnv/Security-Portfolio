# Title: Suspicious Non-Browser Network Communication With Telegram API
# ID: c3dbbc9f-ef1d-470a-a90a-d343448d5875
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-05-19
# Tags: attack.command-and-control, attack.exfiltration, attack.t1102, attack.t1567, attack.t1105
# Description: Detects an a non-browser process interacting with the Telegram API which could indicate use of a covert C2
# Converted by: Sigma Universal SIEM/EDR CLI

((DestinationHostname:*api.telegram.org*) AND NOT (((process.executable:*\\brave.exe) OR ((process.executable:"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR process.executable:"C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) OR ((process.executable:C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*) OR (process.executable:*\\WindowsApps\\MicrosoftEdge.exe) OR ((process.executable:"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" OR process.executable:"C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process.executable:C:\\Program Files (x86)\\Microsoft\\EdgeCore\\* OR process.executable:C:\\Program Files\\Microsoft\\EdgeCore\\*) AND (process.executable:*\\msedge.exe OR process.executable:*\\msedgewebview2.exe)) OR ((process.executable:"C:\\Program Files\\Mozilla Firefox\\firefox.exe" OR process.executable:"C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) OR ((process.executable:"C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" OR process.executable:"C:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process.executable:*\\maxthon.exe) OR (process.executable:*\\opera.exe) OR (process.executable:*\\safari.exe) OR (process.executable:*\\seamonkey.exe) OR (process.executable:*\\vivaldi.exe) OR (process.executable:*\\whale.exe))))
