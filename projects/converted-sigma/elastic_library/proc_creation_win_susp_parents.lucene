(((process.parent.executable:*\\minesweeper.exe OR process.parent.executable:*\\winver.exe OR process.parent.executable:*\\bitsadmin.exe)) OR (((process.parent.executable:*\\csrss.exe OR process.parent.executable:*\\certutil.exe OR process.parent.executable:*\\eventvwr.exe OR process.parent.executable:*\\calc.exe OR process.parent.executable:*\\notepad.exe)) AND NOT (((NOT _exists_:process.executable) OR ((process.executable:*\\WerFault.exe OR process.executable:*\\wermgr.exe OR process.executable:*\\conhost.exe OR process.executable:*\\mmc.exe OR process.executable:*\\win32calc.exe OR process.executable:*\\notepad.exe))))))
