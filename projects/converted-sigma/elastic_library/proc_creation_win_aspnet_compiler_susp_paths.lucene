# Tags: attack.execution, attack.stealth, attack.t1127
# Description: Detects execution of "aspnet_compiler.exe" with potentially suspicious paths for compilation.
# Converted by: Sigma Universal SIEM/EDR CLI

((process.executable:*:\\Windows\\Microsoft.NET\\Framework\\* OR process.executable:*:\\Windows\\Microsoft.NET\\Framework64\\* OR process.executable:*:\\Windows\\Microsoft.NET\\FrameworkArm\\* OR process.executable:*:\\Windows\\Microsoft.NET\\FrameworkArm64\\*) AND process.executable:*\\aspnet_compiler.exe AND (process.command_line:*\\Users\\Public\\* OR process.command_line:*\\AppData\\Local\\Temp\\* OR process.command_line:*\\AppData\\Local\\Roaming\\* OR process.command_line:*:\\Temp\\* OR process.command_line:*:\\Windows\\Temp\\* OR process.command_line:*:\\Windows\\System32\\Tasks\\* OR process.command_line:*:\\Windows\\Tasks\\*))
