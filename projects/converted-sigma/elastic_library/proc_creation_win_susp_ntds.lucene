# Description: Detects suspicious process patterns used in NTDS.DIT exfiltration
# Converted by: Sigma Universal SIEM/EDR CLI

((((process.command_line:*ac i ntds* AND process.command_line:*create full*)) OR ((process.command_line:*/c copy * AND process.command_line:*\\windows\\ntds\\ntds.dit*)) OR ((process.command_line:*activate instance ntds* AND process.command_line:*create full*)) OR ((process.command_line:*powershell* AND process.command_line:*ntds.dit*)) OR (((process.executable:*\\NTDSDump.exe OR process.executable:*\\NTDSDumpEx.exe)) OR ((process.command_line:*ntds.dit* AND process.command_line:*system.hiv*)) OR (process.command_line:*NTDSgrab.ps1*))) OR ((((process.parent.executable:*\\apache* OR process.parent.executable:*\\tomcat* OR process.parent.executable:*\\AppData\\* OR process.parent.executable:*\\Temp\\* OR process.parent.executable:*\\Public\\* OR process.parent.executable:*\\PerfLogs\\*)) OR ((process.executable:*\\apache* OR process.executable:*\\tomcat* OR process.executable:*\\AppData\\* OR process.executable:*\\Temp\\* OR process.executable:*\\Public\\* OR process.executable:*\\PerfLogs\\*))) AND (process.command_line:*ntds.dit*)))
