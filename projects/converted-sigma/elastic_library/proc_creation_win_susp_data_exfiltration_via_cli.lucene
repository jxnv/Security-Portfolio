# Title: Potential Data Exfiltration Activity Via CommandLine Tools
# ID: 7d1aaf3d-4304-425c-b7c3-162055e0b3ab
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-08-02
# Tags: attack.execution, attack.t1059.001
# Description: Detects the use of various CLI utilities exfiltrating data via web requests
# Converted by: Sigma Universal SIEM/EDR CLI

((((process.executable:*\\powershell_ise.exe OR process.executable:*\\powershell.exe OR process.executable:*\\pwsh.exe OR process.executable:*\\cmd.exe) AND (process.command_line:*curl * OR process.command_line:*Invoke-RestMethod* OR process.command_line:*Invoke-WebRequest* OR process.command_line:*irm * OR process.command_line:*iwr * OR process.command_line:*wget *) AND (process.command_line:* -ur* AND process.command_line:* -me* AND process.command_line:* -b* AND process.command_line:* POST *)) OR ((process.executable:*\\curl.exe AND process.command_line:*--ur*) AND ((process.command_line:* -d * OR process.command_line:* --data *))) OR (process.executable:*\\wget.exe AND (process.command_line:*--post-data* OR process.command_line:*--post-file*))) AND (((process.command_line:/net\s+view/ OR process.command_line:/sc\s+query/)) OR ((process.command_line:*Get-Content* OR process.command_line:*GetBytes* OR process.command_line:*hostname* OR process.command_line:*ifconfig* OR process.command_line:*ipconfig* OR process.command_line:*netstat* OR process.command_line:*nltest* OR process.command_line:*qprocess* OR process.command_line:*systeminfo* OR process.command_line:*tasklist* OR process.command_line:*ToBase64String* OR process.command_line:*whoami*)) OR ((process.command_line:*type * AND process.command_line:* > * AND process.command_line:* C:\\*))))
