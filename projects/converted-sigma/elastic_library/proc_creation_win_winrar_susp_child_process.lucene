# Title: Potentially Suspicious Child Process Of WinRAR.EXE
# ID: 146aace8-9bd6-42ba-be7a-0070d8027b76
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-08-31
# Tags: attack.execution, attack.t1203
# Description: Detects potentially suspicious child processes of WinRAR.exe.
# Converted by: Sigma Universal SIEM/EDR CLI

((((process.executable:*\\cmd.exe OR process.executable:*\\cscript.exe OR process.executable:*\\mshta.exe OR process.executable:*\\powershell.exe OR process.executable:*\\pwsh.exe OR process.executable:*\\regsvr32.exe OR process.executable:*\\rundll32.exe OR process.executable:*\\wscript.exe)) OR ((process.pe.original_file_name:"Cmd.Exe" OR process.pe.original_file_name:"cscript.exe" OR process.pe.original_file_name:"mshta.exe" OR process.pe.original_file_name:"PowerShell.EXE" OR process.pe.original_file_name:"pwsh.dll" OR process.pe.original_file_name:"regsvr32.exe" OR process.pe.original_file_name:"RUNDLL32.EXE" OR process.pe.original_file_name:"wscript.exe"))) AND (process.parent.executable:*\\WinRAR.exe))
