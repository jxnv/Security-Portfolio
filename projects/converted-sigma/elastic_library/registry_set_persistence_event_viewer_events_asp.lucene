# Description: Detects potential registry persistence technique using the Event Viewer "Events.asp" technique
# Converted by: Sigma Universal SIEM/EDR CLI

(((registry.path:*\\Microsoft\\Windows NT\\CurrentVersion\\Event Viewer\\MicrosoftRedirectionProgram* OR registry.path:*\\Microsoft\\Windows NT\\CurrentVersion\\Event Viewer\\MicrosoftRedirectionURL*)) AND NOT (((registry.data.strings:"(Empty)") OR (process.executable:*C:\\WINDOWS\\system32\\svchost.exe AND registry.path:*\\Microsoft\\Windows NT\\CurrentVersion\\Event Viewer\\MicrosoftRedirectionProgram AND registry.data.strings:"%%SystemRoot%%\\PCHealth\\HelpCtr\\Binaries\\HelpCtr.exe") OR (process.executable:*C:\\WINDOWS\\system32\\svchost.exe AND registry.path:*\\Microsoft\\Windows NT\\CurrentVersion\\Event Viewer\\MicrosoftRedirectionProgramCommandLineParameters AND registry.data.strings:"-url hcp://services/centers/support?topic=%%s") OR (registry.data.strings:"http://go.microsoft.com/fwlink/events.asp"))))
