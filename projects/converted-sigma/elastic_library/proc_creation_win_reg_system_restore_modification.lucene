# Title: System Restore Registry Modification via CommandLine
# ID: 7c06ab9b-b1d2-4ba9-b06e-09491ded20d9
# Status: experimental
# Level: high
# Author: Swachchhanda Shrawan Poudel (Nextron Systems)
# Date: 2026-03-11
# Tags: attack.impact, attack.t1490
# Description: Detects system restore registry modification via command line, which can be used by adversaries to disable system restore on the computer.
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.command_line:* add * OR process.command_line:*Set-ItemProperty* OR process.command_line:*New-ItemProperty*)) AND ((process.command_line:*DisableConfig* OR process.command_line:*DisableSR*)) AND ((process.command_line:*\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\SystemRestore* OR process.command_line:*\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\SystemRestore*)) AND (((process.executable:*\\powershell.exe OR process.executable:*\\pwsh.exe OR process.executable:*\\reg.exe)) OR ((process.pe.original_file_name:"powershell.exe" OR process.pe.original_file_name:"pwsh.dll" OR process.pe.original_file_name:"reg.exe"))))
