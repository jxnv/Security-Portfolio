# Title: Suspicious DLL Loaded via CertOC.EXE
# ID: 84232095-ecca-4015-b0d7-7726507ee793
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-02-15
# Tags: attack.stealth, attack.t1218
# Description: Detects when a user installs certificates by using CertOC.exe to load the target DLL file.
# Converted by: Sigma Universal SIEM/EDR CLI

((process.command_line:* -LoadDLL *) AND ((process.executable:*\\certoc.exe) OR (process.pe.original_file_name:"CertOC.exe")) AND ((process.command_line:*\\Appdata\\Local\\Temp\\* OR process.command_line:*\\Desktop\\* OR process.command_line:*\\Downloads\\* OR process.command_line:*\\Users\\Public\\* OR process.command_line:*C:\\Windows\\Tasks\\* OR process.command_line:*C:\\Windows\\Temp\\*)))
