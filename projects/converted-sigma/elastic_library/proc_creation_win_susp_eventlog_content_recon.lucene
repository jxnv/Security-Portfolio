# Title: Potentially Suspicious EventLog Recon Activity Using Log Query Utilities
# ID: beaa66d6-aa1b-4e3c-80f5-e0145369bfaf
# Status: test
# Level: medium
# Author: Nasreddine Bencherchali (Nextron Systems), X__Junior (Nextron Systems)
# Date: 2022-09-09
# Tags: attack.credential-access, attack.discovery, attack.t1552, attack.t1087
# Description: Detects execution of different log query utilities and commands to search and dump the content of specific event logs or look for specific event IDs.
# This technique is used by threat actors in order to extract sensitive information from events logs such as usernames, IP addresses, hostnames, etc.
# Converted by: Sigma Universal SIEM/EDR CLI

((((process.command_line:*-InstanceId 462?* OR process.command_line:*.eventid -eq 462?* OR process.command_line:*.ID -eq 462?* OR process.command_line:*EventCode=?462?* OR process.command_line:*EventIdentifier=?462?* OR process.command_line:*System[EventID=462?]* OR process.command_line:*-InstanceId 4778* OR process.command_line:*.eventid -eq 4778* OR process.command_line:*.ID -eq 4778* OR process.command_line:*EventCode=?4778?* OR process.command_line:*EventIdentifier=?4778?* OR process.command_line:*System[EventID=4778]* OR process.command_line:*-InstanceId 25* OR process.command_line:*.eventid -eq 25* OR process.command_line:*.ID -eq 25* OR process.command_line:*EventCode=?25?* OR process.command_line:*EventIdentifier=?25?* OR process.command_line:*System[EventID=25]* OR process.command_line:*-InstanceId 1149* OR process.command_line:*.eventid -eq 1149* OR process.command_line:*.ID -eq 1149* OR process.command_line:*EventCode=?1149?* OR process.command_line:*EventIdentifier=?1149?* OR process.command_line:*System[EventID=1149]* OR process.command_line:*-InstanceId 21* OR process.command_line:*.eventid -eq 21* OR process.command_line:*.ID -eq 21* OR process.command_line:*EventCode=?21?* OR process.command_line:*EventIdentifier=?21?* OR process.command_line:*System[EventID=21]* OR process.command_line:*-InstanceId 22* OR process.command_line:*.eventid -eq 22* OR process.command_line:*.ID -eq 22* OR process.command_line:*EventCode=?22?* OR process.command_line:*EventIdentifier=?22?* OR process.command_line:*System[EventID=22]*)) OR ((process.command_line:*Microsoft-Windows-PowerShell* OR process.command_line:*Microsoft-Windows-Security-Auditing* OR process.command_line:*Microsoft-Windows-TerminalServices-LocalSessionManager* OR process.command_line:*Microsoft-Windows-TerminalServices-RemoteConnectionManager* OR process.command_line:*Microsoft-Windows-Windows Defender* OR process.command_line:*PowerShellCore* OR process.command_line:*Security* OR process.command_line:*Windows PowerShell*))) AND (((process.command_line:*Select* AND process.command_line:*Win32_NTLogEvent*)) OR (((process.command_line:* qe * OR process.command_line:* query-events *)) AND ((process.executable:*\\wevtutil.exe) OR (process.pe.original_file_name:"wevtutil.exe"))) OR ((process.command_line:* ntevent*) AND ((process.executable:*\\wmic.exe) OR (process.pe.original_file_name:"wmic.exe"))) OR ((process.command_line:*Get-WinEvent * OR process.command_line:*get-eventlog *))))
