# Tags: attack.reconnaissance, attack.t1595
# Description: Detects the execution of PingCastle, a tool designed to quickly assess the Active Directory security level via a script located in a potentially suspicious or uncommon location.
# Converted by: Sigma Universal SIEM/EDR CLI

((((process.parent.command_line:*.bat* OR process.parent.command_line:*.chm* OR process.parent.command_line:*.cmd* OR process.parent.command_line:*.hta* OR process.parent.command_line:*.htm* OR process.parent.command_line:*.html* OR process.parent.command_line:*.js* OR process.parent.command_line:*.lnk* OR process.parent.command_line:*.ps1* OR process.parent.command_line:*.vbe* OR process.parent.command_line:*.vbs* OR process.parent.command_line:*.wsf*)) OR ((process.parent.command_line:*:\\Perflogs\\* OR process.parent.command_line:*:\\Temp\\* OR process.parent.command_line:*:\\Users\\Public\\* OR process.parent.command_line:*:\\Windows\\Temp\\* OR process.parent.command_line:*\\AppData\\Local\\Temp* OR process.parent.command_line:*\\AppData\\Roaming\\* OR process.parent.command_line:*\\Temporary Internet*)) OR (((process.parent.command_line:*:\\Users\\* AND process.parent.command_line:*\\Favorites\\*)) OR ((process.parent.command_line:*:\\Users\\* AND process.parent.command_line:*\\Favourites\\*)) OR ((process.parent.command_line:*:\\Users\\* AND process.parent.command_line:*\\Contacts\\*)))) AND ((process.parent.command_line:*.bat* OR process.parent.command_line:*.chm* OR process.parent.command_line:*.cmd* OR process.parent.command_line:*.hta* OR process.parent.command_line:*.htm* OR process.parent.command_line:*.html* OR process.parent.command_line:*.js* OR process.parent.command_line:*.lnk* OR process.parent.command_line:*.ps1* OR process.parent.command_line:*.vbe* OR process.parent.command_line:*.vbs* OR process.parent.command_line:*.wsf*)) AND ((process.executable:*\\PingCastle.exe) OR (process.pe.original_file_name:"PingCastle.exe") OR (Product:"Ping Castle") OR ((process.command_line:*--scanner aclcheck* OR process.command_line:*--scanner antivirus* OR process.command_line:*--scanner computerversion* OR process.command_line:*--scanner foreignusers* OR process.command_line:*--scanner laps_bitlocker* OR process.command_line:*--scanner localadmin* OR process.command_line:*--scanner nullsession* OR process.command_line:*--scanner nullsession-trust* OR process.command_line:*--scanner oxidbindings* OR process.command_line:*--scanner remote* OR process.command_line:*--scanner share* OR process.command_line:*--scanner smb* OR process.command_line:*--scanner smb3querynetwork* OR process.command_line:*--scanner spooler* OR process.command_line:*--scanner startup* OR process.command_line:*--scanner zerologon*)) OR (process.command_line:*--no-enum-limit*) OR ((process.command_line:*--healthcheck* AND process.command_line:*--level Full*)) OR ((process.command_line:*--healthcheck* AND process.command_line:*--server *))))
