# Title: LSASS Dump Keyword In CommandLine
# ID: ffa6861c-4461-4f59-8a41-578c39f3f23e
# Status: test
# Level: high
# Author: E.M. Anhaus, Tony Lambert, oscd.community, Nasreddine Bencherchali (Nextron Systems)
# Date: 2019-10-24
# Tags: attack.credential-access, attack.t1003.001
# Description: Detects the presence of the keywords "lsass" and ".dmp" in the commandline, which could indicate a potential attempt to dump or create a dump of the lsass process.
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.command_line:*lsass.dmp* OR process.command_line:*lsass.zip* OR process.command_line:*lsass.rar* OR process.command_line:*Andrew.dmp* OR process.command_line:*Coredump.dmp* OR process.command_line:*NotLSASS.zip* OR process.command_line:*lsass_2* OR process.command_line:*lsassdump* OR process.command_line:*lsassdmp*)) OR ((process.command_line:*lsass* AND process.command_line:*.dmp*)) OR ((process.command_line:*SQLDmpr* AND process.command_line:*.mdmp*)) OR ((process.command_line:*nanodump* AND process.command_line:*.dmp*)))
