# Title: Office Macro File Download
# ID: 0e29e3a7-1ad8-40aa-b691-9f82ecd33d66
# Status: test
# Level: low
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-01-23
# Tags: attack.initial-access, attack.t1566.001
# Description: Detects the creation of a new office macro files on the system via an application (browser, mail client).
# This can help identify potential malicious activity, such as the download of macro-enabled documents that could be used for exploitation.
# Converted by: Sigma Universal SIEM/EDR CLI

((((file.path:*.docm OR file.path:*.dotm OR file.path:*.xlsm OR file.path:*.xltm OR file.path:*.potm OR file.path:*.pptm)) OR ((file.path:*.docm:Zone* OR file.path:*.dotm:Zone* OR file.path:*.xlsm:Zone* OR file.path:*.xltm:Zone* OR file.path:*.potm:Zone* OR file.path:*.pptm:Zone*))) AND ((process.executable:*\\RuntimeBroker.exe OR process.executable:*\\outlook.exe OR process.executable:*\\thunderbird.exe OR process.executable:*\\brave.exe OR process.executable:*\\chrome.exe OR process.executable:*\\firefox.exe OR process.executable:*\\iexplore.exe OR process.executable:*\\maxthon.exe OR process.executable:*\\MicrosoftEdge.exe OR process.executable:*\\msedge.exe OR process.executable:*\\msedgewebview2.exe OR process.executable:*\\opera.exe OR process.executable:*\\safari.exe OR process.executable:*\\seamonkey.exe OR process.executable:*\\vivaldi.exe OR process.executable:*\\whale.exe)))
