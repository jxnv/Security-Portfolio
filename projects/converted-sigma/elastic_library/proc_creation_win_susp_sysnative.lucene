# Title: Process Creation Using Sysnative Folder
# ID: 3c1b5fb0-c72f-45ba-abd1-4d4c353144ab
# Status: test
# Level: medium
# Author: Max Altgelt (Nextron Systems)
# Date: 2022-08-23
# Tags: attack.privilege-escalation, attack.stealth, attack.t1055
# Description: Detects process creation events that use the Sysnative folder (common for CobaltStrike spawns)
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.command_line:*:\\Windows\\Sysnative\\*) OR (process.executable:*:\\Windows\\Sysnative\\*)) AND NOT (((process.executable:*C:\\Windows\\Microsoft.NET\\Framework64\\v* OR process.executable:*C:\\Windows\\Microsoft.NET\\Framework\\v* OR process.executable:*C:\\Windows\\Microsoft.NET\\FrameworkArm\\v* OR process.executable:*C:\\Windows\\Microsoft.NET\\FrameworkArm64\\v*) AND process.executable:*\\ngen.exe AND process.command_line:*install*)) AND NOT (((process.command_line:*\"C:\\Windows\\sysnative\\cmd.exe\"* AND process.command_line:*\\xampp\\* AND process.command_line:*\\catalina_start.bat*))))
