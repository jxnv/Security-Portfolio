# Tags: attack.execution, attack.t1569.002, attack.s0029
# Description: Detects installation or execution of services
# Converted by: Sigma Universal SIEM/EDR CLI

((winlog.provider_name:"Service Control Manager" AND (winlog.event_id:"7045" OR winlog.event_id:"7036")) AND ((ImagePath:*bypass*) OR ((ServiceName:*cachedump* OR ServiceName:*DumpSvc* OR ServiceName:*gsecdump* OR ServiceName:*pwdump* OR ServiceName:*UACBypassedService* OR ServiceName:*WCE SERVICE* OR ServiceName:*WCESERVICE* OR ServiceName:*winexesvc*))))
