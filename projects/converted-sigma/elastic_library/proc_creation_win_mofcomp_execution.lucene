# Title: Potentially Suspicious Mofcomp Execution
# ID: 1dd05363-104e-4b4a-b963-196a534b03a1
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-07-12
# Tags: attack.stealth, attack.t1218
# Description: Detects execution of the "mofcomp" utility as a child of a suspicious shell or script running utility or by having a suspicious path in the commandline.
# The "mofcomp" utility parses a file containing MOF statements and adds the classes and class instances defined in the file to the WMI repository.
# Attackers abuse this utility to install malicious MOF scripts
# Converted by: Sigma Universal SIEM/EDR CLI

(((((process.parent.executable:*\\cmd.exe OR process.parent.executable:*\\powershell.exe OR process.parent.executable:*\\pwsh.exe OR process.parent.executable:*\\wsl.exe OR process.parent.executable:*\\wscript.exe OR process.parent.executable:*\\cscript.exe)) OR ((process.command_line:*\\AppData\\Local\\Temp* OR process.command_line:*\\Contacts\\* OR process.command_line:*\\Favorites\\* OR process.command_line:*\\Favourites\\* OR process.command_line:*\\Music\\* OR process.command_line:*\\Pictures\\* OR process.command_line:*\\Users\\Public\\* OR process.command_line:*\\Videos\\* OR process.command_line:*\\WINDOWS\\Temp\\* OR process.command_line:*%appdata%* OR process.command_line:*%temp%* OR process.command_line:*%tmp%*))) AND ((process.executable:*\\mofcomp.exe) OR (process.pe.original_file_name:"mofcomp.exe"))) AND NOT (((process.parent.command_line:*\\InstallUtil.exe /Uninstall C:\\Windows\\CCM\\Microsoft.ConfigurationManager.SVProvider.dll AND process.parent.executable:*\\InstallUtil.exe AND (process.command_line:*C:\\Windows\\TEMP* AND process.command_line:*.tmp*)) OR (process.parent.executable:"C:\\Windows\\System32\\wbem\\WmiPrvSE.exe" AND process.command_line:*C:\\Windows\\TEMP\\* AND process.command_line:*.mof))) AND NOT ((NOT _exists_:process.parent.command_line)))
