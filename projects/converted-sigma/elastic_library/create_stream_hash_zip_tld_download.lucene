# Title: Potentially Suspicious File Download From ZIP TLD
# ID: 0bb4bbeb-fe52-4044-b40c-430a04577ebe
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2023-05-18
# Tags: attack.stealth
# Description: Detects the download of a file with a potentially suspicious extension from a .zip top level domain.
# Converted by: Sigma Universal SIEM/EDR CLI

(Contents:*.zip/* AND (file.path:*.bat:Zone* OR file.path:*.dat:Zone* OR file.path:*.dll:Zone* OR file.path:*.doc:Zone* OR file.path:*.docm:Zone* OR file.path:*.exe:Zone* OR file.path:*.hta:Zone* OR file.path:*.pptm:Zone* OR file.path:*.ps1:Zone* OR file.path:*.rar:Zone* OR file.path:*.rtf:Zone* OR file.path:*.sct:Zone* OR file.path:*.vbe:Zone* OR file.path:*.vbs:Zone* OR file.path:*.ws:Zone* OR file.path:*.wsf:Zone* OR file.path:*.xll:Zone* OR file.path:*.xls:Zone* OR file.path:*.xlsm:Zone* OR file.path:*.zip:Zone*))
