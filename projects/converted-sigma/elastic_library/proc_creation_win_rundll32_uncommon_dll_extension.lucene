# Description: Detects the execution of rundll32 with a command line that doesn't contain a common extension
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.executable:*\\rundll32.exe) OR (process.pe.original_file_name:"RUNDLL32.EXE")) AND NOT (((process.command_line:"") OR (((process.command_line:*.cpl * OR process.command_line:*.cpl,* OR process.command_line:*.cpl\"* OR process.command_line:*.cpl'* OR process.command_line:*.dll * OR process.command_line:*.dll,* OR process.command_line:*.dll\"* OR process.command_line:*.dll'* OR process.command_line:*.inf * OR process.command_line:*.inf,* OR process.command_line:*.inf\"* OR process.command_line:*.inf'*)) OR ((process.command_line:*.cpl OR process.command_line:*.dll OR process.command_line:*.inf))) OR (process.command_line:* -localserver *) OR (NOT _exists_:process.command_line) OR (process.parent.executable:*\\msiexec.exe AND (process.command_line:*:\\Windows\\Installer\\* AND process.command_line:*.tmp* AND process.command_line:*zzzzInvokeManagedCustomActionOutOfProc*)))) AND NOT (((process.parent.command_line:*:\\Users\\* AND process.parent.command_line:*\\AppData\\Local\\Microsoft\\EdgeUpdate\\Install\\{* AND process.parent.command_line:*\\EDGEMITMP_* AND process.parent.command_line:*.tmp\\setup.exe* AND process.parent.command_line:*--install-archive=* AND process.parent.command_line:*--previous-version=* AND process.parent.command_line:*--msedgewebview --verbose-logging --do-not-launch-msedge --user-level*))))
