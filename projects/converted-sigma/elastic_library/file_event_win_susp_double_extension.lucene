# Title: Suspicious Double Extension Files
# ID: b4926b47-a9d7-434c-b3a0-adc3fa0bd13e
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems), frack113
# Date: 2022-06-19
# Tags: attack.stealth, attack.t1036.007
# Description: Detects dropped files with double extensions, which is often used by malware as a method to abuse the fact that Windows hide default extensions by default.
# Converted by: Sigma Universal SIEM/EDR CLI

((((file.path:*.rar.exe OR file.path:*.zip.exe)) OR ((file.path:*.exe OR file.path:*.iso OR file.path:*.rar OR file.path:*.svg OR file.path:*.zip) AND (file.path:*.doc.* OR file.path:*.docx.* OR file.path:*.gif.* OR file.path:*.jpeg.* OR file.path:*.jpg.* OR file.path:*.mp3.* OR file.path:*.mp4.* OR file.path:*.pdf.* OR file.path:*.png.* OR file.path:*.ppt.* OR file.path:*.pptx.* OR file.path:*.rtf.* OR file.path:*.svg.* OR file.path:*.txt.* OR file.path:*.xls.* OR file.path:*.xlsx.*))) AND NOT ((file.path:/usr/share/icons/*)))
