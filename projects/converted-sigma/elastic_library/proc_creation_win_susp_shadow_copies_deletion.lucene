((((process.command_line:*shadow* AND process.command_line:*delete*)) AND (((process.executable:*\\powershell.exe OR process.executable:*\\pwsh.exe OR process.executable:*\\wmic.exe OR process.executable:*\\vssadmin.exe OR process.executable:*\\diskshadow.exe)) OR ((process.pe.original_file_name:"PowerShell.EXE" OR process.pe.original_file_name:"pwsh.dll" OR process.pe.original_file_name:"wmic.exe" OR process.pe.original_file_name:"VSSADMIN.EXE" OR process.pe.original_file_name:"diskshadow.exe")))) OR (((process.command_line:*delete* AND process.command_line:*catalog* AND process.command_line:*quiet*)) AND ((process.executable:*\\wbadmin.exe) OR (process.pe.original_file_name:"WBADMIN.EXE"))) OR (((process.command_line:*resize* AND process.command_line:*shadowstorage*) AND (process.command_line:*unbounded* OR process.command_line:*/MaxSize=*)) AND ((process.executable:*\\vssadmin.exe) OR (process.pe.original_file_name:"VSSADMIN.EXE"))))
