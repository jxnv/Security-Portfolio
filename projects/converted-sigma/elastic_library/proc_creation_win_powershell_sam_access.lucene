# Title: PowerShell SAM Copy
# ID: 1af57a4b-460a-4738-9034-db68b880c665
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2021-07-29
# Tags: attack.credential-access, attack.t1003.002
# Description: Detects suspicious PowerShell scripts accessing SAM hives
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.command_line:*\\HarddiskVolumeShadowCopy* AND process.command_line:*System32\\config\\sam*)) AND ((process.command_line:*Copy-Item* OR process.command_line:*cp $_.* OR process.command_line:*cpi $_.* OR process.command_line:*copy $_.* OR process.command_line:*.File]::Copy(*)))
