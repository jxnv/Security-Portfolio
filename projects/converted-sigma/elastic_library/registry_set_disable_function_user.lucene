# Title: Disable Internal Tools or Feature in Registry
# ID: e2482f8d-3443-4237-b906-cc145d87a076
# Status: test
# Level: medium
# Author: frack113, Nasreddine Bencherchali (Nextron Systems), CrimpSec
# Date: 2022-03-18
# Tags: attack.persistence, attack.defense-impairment, attack.t1112
# Description: Detects registry modifications that change features of internal Windows tools (malware like Agent Tesla uses this technique)
# Converted by: Sigma Universal SIEM/EDR CLI

(((registry.path:*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\ConsentPromptBehaviorAdmin OR registry.path:*Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\InactivityTimeoutSecs OR registry.path:*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\shutdownwithoutlogon OR registry.path:*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\PushNotifications\\ToastEnabled OR registry.path:*SYSTEM\\CurrentControlSet\\Control\\Storage\\Write Protection OR registry.path:*SYSTEM\\CurrentControlSet\\Control\\StorageDevicePolicies\\WriteProtect) AND registry.data.strings:"DWORD (0x00000000)") OR ((registry.path:*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\DisableCMD OR registry.path:*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\NoControlPanel OR registry.path:*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\NoRun OR registry.path:*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\StartMenuLogOff OR registry.path:*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\DisableChangePassword OR registry.path:*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\DisableLockWorkstation OR registry.path:*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\DisableRegistryTools OR registry.path:*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\DisableTaskmgr OR registry.path:*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\NoDispBackgroundPage OR registry.path:*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\NoDispCPL OR registry.path:*SOFTWARE\\Policies\\Microsoft\\Windows\\Explorer\\DisableNotificationCenter OR registry.path:*SOFTWARE\\Policies\\Microsoft\\Windows\\System\\DisableCMD) AND registry.data.strings:"DWORD (0x00000001)"))
