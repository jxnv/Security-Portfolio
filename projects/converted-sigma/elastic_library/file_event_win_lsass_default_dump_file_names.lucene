# Tags: attack.credential-access, attack.t1003.001
# Description: Detects creation of files with names used by different memory dumping tools to create a memory dump of the LSASS process memory, which contains user credentials.
# Converted by: Sigma Universal SIEM/EDR CLI

(((file.path:*\\Andrew.dmp OR file.path:*\\Coredump.dmp OR file.path:*\\lsass.dmp OR file.path:*\\lsass.rar OR file.path:*\\lsass.zip OR file.path:*\\NotLSASS.zip OR file.path:*\\PPLBlade.dmp OR file.path:*\\rustive.dmp)) OR ((file.path:*\\lsass_2* OR file.path:*\\lsassdmp* OR file.path:*\\lsassdump*)) OR ((file.path:*\\lsass* AND file.path:*.dmp*)) OR (file.path:*SQLDmpr* AND file.path:*.mdmp) OR ((file.path:*\\nanodump* OR file.path:*\\proc_*) AND file.path:*.dmp))
