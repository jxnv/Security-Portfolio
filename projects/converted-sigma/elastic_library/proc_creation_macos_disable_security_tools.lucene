# Title: Disable Security Tools
# ID: ff39f1a6-84ac-476f-a1af-37fcdf53d7c0
# Status: test
# Level: medium
# Author: Daniil Yugoslavskiy, oscd.community
# Date: 2020-10-19
# Tags: attack.defense-impairment, attack.t1685
# Description: Detects disabling security tools
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.executable:"/bin/launchctl" AND process.command_line:*unload*) AND ((process.command_line:*com.objective-see.lulu.plist* OR process.command_line:*com.objective-see.blockblock.plist* OR process.command_line:*com.google.santad.plist* OR process.command_line:*com.carbonblack.defense.daemon.plist* OR process.command_line:*com.carbonblack.daemon.plist* OR process.command_line:*at.obdev.littlesnitchd.plist* OR process.command_line:*com.tenablesecurity.nessusagent.plist* OR process.command_line:*com.opendns.osx.RoamingClientConfigUpdater.plist* OR process.command_line:*com.crowdstrike.falcond.plist* OR process.command_line:*com.crowdstrike.userdaemon.plist* OR process.command_line:*osquery* OR process.command_line:*filebeat* OR process.command_line:*auditbeat* OR process.command_line:*packetbeat* OR process.command_line:*td-agent*))) OR (process.executable:"/usr/sbin/spctl" AND process.command_line:*disable*))
