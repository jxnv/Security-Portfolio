# Title: Legitimate Application Dropped Archive
# ID: 654fcc6d-840d-4844-9b07-2c3300e54a26
# Status: test
# Level: high
# Author: frack113, Florian Roth
# Date: 2022-08-21
# Tags: attack.stealth, attack.t1218
# Description: Detects programs on a Windows system that should not write an archive to disk
# Converted by: Sigma Universal SIEM/EDR CLI

((process.executable:*\\winword.exe OR process.executable:*\\excel.exe OR process.executable:*\\powerpnt.exe OR process.executable:*\\msaccess.exe OR process.executable:*\\mspub.exe OR process.executable:*\\eqnedt32.exe OR process.executable:*\\visio.exe OR process.executable:*\\wordpad.exe OR process.executable:*\\wordview.exe OR process.executable:*\\certutil.exe OR process.executable:*\\certoc.exe OR process.executable:*\\CertReq.exe OR process.executable:*\\Desktopimgdownldr.exe OR process.executable:*\\esentutl.exe OR process.executable:*\\finger.exe OR process.executable:*\\notepad.exe OR process.executable:*\\AcroRd32.exe OR process.executable:*\\RdrCEF.exe OR process.executable:*\\mshta.exe OR process.executable:*\\hh.exe) AND (file.path:*.zip OR file.path:*.rar OR file.path:*.7z OR file.path:*.diagcab OR file.path:*.appx))
