# Title: Suspicious File Download From IP Via Wget.EXE
# ID: 17f0c0a8-8bd5-4ee0-8c5f-a342c0199f35
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-07-27
# Tags: attack.execution
# Description: Detects potentially suspicious file downloads directly from IP addresses using Wget.exe
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.command_line:*.ps1 OR process.command_line:*.ps1' OR process.command_line:*.ps1\" OR process.command_line:*.dat OR process.command_line:*.dat' OR process.command_line:*.dat\" OR process.command_line:*.msi OR process.command_line:*.msi' OR process.command_line:*.msi\" OR process.command_line:*.bat OR process.command_line:*.bat' OR process.command_line:*.bat\" OR process.command_line:*.exe OR process.command_line:*.exe' OR process.command_line:*.exe\" OR process.command_line:*.vbs OR process.command_line:*.vbs' OR process.command_line:*.vbs\" OR process.command_line:*.vbe OR process.command_line:*.vbe' OR process.command_line:*.vbe\" OR process.command_line:*.hta OR process.command_line:*.hta' OR process.command_line:*.hta\" OR process.command_line:*.dll OR process.command_line:*.dll' OR process.command_line:*.dll\" OR process.command_line:*.psm1 OR process.command_line:*.psm1' OR process.command_line:*.psm1\")) AND ((process.command_line:/\s-O\s/) OR (process.command_line:*--output-document*)) AND (process.command_line:*http*) AND ((process.executable:*\\wget.exe) OR (process.pe.original_file_name:"wget.exe")) AND (process.command_line:/://[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}/))
