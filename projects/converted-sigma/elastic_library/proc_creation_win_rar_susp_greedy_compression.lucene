# Title: Suspicious Greedy Compression Using Rar.EXE
# ID: afe52666-401e-4a02-b4ff-5d128990b8cb
# Status: test
# Level: high
# Author: X__Junior (Nextron Systems), Florian Roth (Nextron Systems)
# Date: 2022-12-15
# Tags: attack.execution, attack.t1059
# Description: Detects RAR usage that creates an archive from a suspicious folder, either a system folder or one of the folders often used by attackers for staging purposes
# Converted by: Sigma Universal SIEM/EDR CLI

((((process.executable:*\\rar.exe) OR (Description:"Command line RAR")) OR ((process.command_line:*.exe a * OR process.command_line:* a -m*))) AND (((process.command_line:* -hp* AND process.command_line:* -r *)) AND ((process.command_line:* ?:\\\\\\*.* OR process.command_line:* ?:\\\\\\\\\\*.* OR process.command_line:* ?:\\$Recycle.bin\\* OR process.command_line:* ?:\\PerfLogs\\* OR process.command_line:* ?:\\Temp* OR process.command_line:* ?:\\Users\\Public\\* OR process.command_line:* ?:\\Windows\\* OR process.command_line:* %public%*))))
