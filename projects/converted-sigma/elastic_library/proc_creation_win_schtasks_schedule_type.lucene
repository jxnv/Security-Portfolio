# Title: Suspicious Schtasks Schedule Types
# ID: 24c8392b-aa3c-46b7-a545-43f71657fe98
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-09-09
# Tags: attack.privilege-escalation, attack.persistence, attack.execution, attack.t1053.005
# Description: Detects scheduled task creations or modification on a suspicious schedule type
# Converted by: Sigma Universal SIEM/EDR CLI

((((process.executable:*\\schtasks.exe) OR (process.pe.original_file_name:"schtasks.exe")) AND ((process.command_line:* ONLOGON * OR process.command_line:* ONSTART * OR process.command_line:* ONCE * OR process.command_line:* ONIDLE *))) AND NOT (((process.command_line:*NT AUT* OR process.command_line:* SYSTEM* OR process.command_line:*HIGHEST*))))
