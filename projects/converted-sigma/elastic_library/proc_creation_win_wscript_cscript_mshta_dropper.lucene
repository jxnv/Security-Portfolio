# Title: Potential Dropper Script Execution Via WScript/CScript/MSHTA
# ID: cea72823-df4d-4567-950c-0b579eaf0846
# Status: test
# Level: medium
# Author: Margaritis Dimitrios (idea), Florian Roth (Nextron Systems), oscd.community, Nasreddine Bencherchali (Nextron Systems), Dave Johnson
# Date: 2019-01-16
# Tags: attack.execution, attack.t1059.005, attack.t1059.007
# Description: Detects wscript/cscript/mshta executions of scripts located in user directories
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.executable:*\\wscript.exe OR process.executable:*\\cscript.exe OR process.executable:*\\mshta.exe)) AND ((process.command_line:*.hta* OR process.command_line:*.js* OR process.command_line:*.jse* OR process.command_line:*.vba* OR process.command_line:*.vbe* OR process.command_line:*.vbs* OR process.command_line:*.wsf* OR process.command_line:*.wsh*)) AND ((process.command_line:*:\\Perflogs\\* OR process.command_line:*:\\Temp\\* OR process.command_line:*:\\Tmp\\* OR process.command_line:*:\\Users\\Public\\* OR process.command_line:*:\\Windows\\Temp\\* OR process.command_line:*\\AppData\\Local\\Temp\\* OR process.command_line:*\\AppData\\Roaming\\Temp\\* OR process.command_line:*\\Start Menu\\Programs\\Startup\\* OR process.command_line:*\\Temporary Internet* OR process.command_line:*\\Windows\\Temp* OR process.command_line:*%LocalAppData%\\Temp\\* OR process.command_line:*%TEMP%* OR process.command_line:*%TMP%*)))
