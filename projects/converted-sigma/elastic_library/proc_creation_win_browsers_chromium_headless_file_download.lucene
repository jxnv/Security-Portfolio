# Title: File Download with Headless Browser
# ID: 0e8cfe08-02c9-4815-a2f8-0d157b7ed33e
# Status: test
# Level: high
# Author: Sreeman, Florian Roth (Nextron Systems)
# Date: 2022-01-04
# Tags: attack.command-and-control, attack.stealth, attack.t1105, attack.t1564.003
# Description: Detects execution of chromium based browser in headless mode using the "dump-dom" command line to download files
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.executable:*\\brave.exe OR process.executable:*\\chrome.exe OR process.executable:*\\msedge.exe OR process.executable:*\\opera.exe OR process.executable:*\\vivaldi.exe) AND (process.command_line:*--headless* AND process.command_line:*dump-dom* AND process.command_line:*http*)) AND NOT ((((process.executable:C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\* OR process.executable:C:\\Program Files (x86)\\Microsoft\\EdgeCore\\* OR process.executable:C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\* OR process.executable:C:\\Program Files\\Microsoft\\Edge\\Application\\* OR process.executable:C:\\Program Files\\Microsoft\\EdgeCore\\* OR process.executable:C:\\Program Files\\Microsoft\\EdgeWebView\\* OR process.executable:C:\\Program Files\\WindowsApps\\Microsoft.MicrosoftEdge*) AND (process.executable:*\\msedge.exe OR process.executable:*\\msedgewebview2.exe OR process.executable:*\\MicrosoftEdge.exe) AND process.command_line:*--headless --disable-gpu --disable-extensions --disable-plugins --mute-audio --no-first-run --incognito --aggressive-cache-discard --dump-dom*) OR ((process.executable:*\\AppData\\Local\\Microsoft\\WindowsApps\\* OR process.executable:*\\Windows\\SystemApps\\Microsoft.MicrosoftEdge*) AND (process.executable:*\\msedge.exe OR process.executable:*\\MicrosoftEdge.exe) AND process.command_line:*--headless --disable-gpu --disable-extensions --disable-plugins --mute-audio --no-first-run --incognito --aggressive-cache-discard --dump-dom*))))
