# Title: Delete Important Scheduled Task
# ID: dbc1f800-0fe0-4bc0-9c66-292c2abe3f78
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2022-09-09
# Tags: attack.impact, attack.t1489
# Description: Detects when adversaries stop services or processes by deleting their respective scheduled tasks in order to conduct data destructive activities
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.command_line:*/delete* OR process.command_line:*-delete*)) AND ((process.command_line:*\\Windows\\BitLocker* OR process.command_line:*\\Windows\\ExploitGuard* OR process.command_line:*\\Windows\\SystemRestore\\SR* OR process.command_line:*\\Windows\\UpdateOrchestrator\\* OR process.command_line:*\\Windows\\Windows Defender\\* OR process.command_line:*\\Windows\\WindowsBackup\\* OR process.command_line:*\\Windows\\WindowsUpdate\\*)) AND ((process.executable:*\\schtasks.exe) OR (process.pe.original_file_name:"schtasks.exe")))
