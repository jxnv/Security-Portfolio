# Title: LSASS Process Reconnaissance Via Findstr.EXE
# ID: fe63010f-8823-4864-a96b-a7b4a0f7b929
# Status: test
# Level: high
# Author: Florian Roth (Nextron Systems)
# Date: 2022-08-12
# Tags: attack.credential-access, attack.t1552.006
# Description: Detects findstring commands that include the keyword lsass, which indicates recon actviity for the LSASS process PID
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.command_line:*lsass*) AND (((process.executable:*\\find.exe OR process.executable:*\\findstr.exe)) OR ((process.pe.original_file_name:"FIND.EXE" OR process.pe.original_file_name:"FINDSTR.EXE")))) OR ((process.command_line:* /i \"lsass* OR process.command_line:* /i lsass.exe* OR process.command_line:*findstr \"lsass* OR process.command_line:*findstr lsass* OR process.command_line:*findstr.exe \"lsass* OR process.command_line:*findstr.exe lsass*)))
