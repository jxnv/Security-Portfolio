# Title: Curl File Upload To File Sharing Websites
# ID: e328cc73-f92a-42fb-b3fa-7c2cffda981a
# Status: experimental
# Level: high
# Author: Swachchhanda Shrawan Poudel (Nextron Systems)
# Date: 2026-03-29
# Tags: attack.exfiltration, attack.t1567.002
# Description: Detects usage of curl to upload files to known file sharing domains, which may indicate data exfiltration.
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.command_line:*0x0.st* OR process.command_line:*bashupload.com* OR process.command_line:*chunk.io* OR process.command_line:*file.io* OR process.command_line:*filebin.net* OR process.command_line:*pastebin* OR process.command_line:*send.firefox.com* OR process.command_line:*temp.sh* OR process.command_line:*transfer.sh* OR process.command_line:*ufile.io* OR process.command_line:*uploadfiles.io* OR process.command_line:*wetransfer.com* OR process.command_line:*x0.at*)) AND (((process.command_line:* --form* OR process.command_line:* --upload-file* OR process.command_line:* --data* OR process.command_line:* -X POST* OR process.command_line:* --request POST *)) OR ((process.command_line:/\s-[FTd]\s/ OR process.command_line:/\s-sT\s/))) AND ((process.executable:*\\curl.exe) OR (process.pe.original_file_name:"curl.exe")))
