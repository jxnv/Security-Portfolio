# Title: Suspicious Provlaunch.EXE Child Process
# ID: f9999590-1f94-4a34-a91e-951e47bedefd
# Status: test
# Level: high
# Author: Nasreddine Bencherchali (Nextron Systems)
# Date: 2023-08-08
# Tags: attack.stealth, attack.t1218
# Description: Detects suspicious child processes of "provlaunch.exe" which might indicate potential abuse to proxy execution.
# Converted by: Sigma Universal SIEM/EDR CLI

((((process.executable:*\\calc.exe OR process.executable:*\\cmd.exe OR process.executable:*\\cscript.exe OR process.executable:*\\mshta.exe OR process.executable:*\\notepad.exe OR process.executable:*\\powershell.exe OR process.executable:*\\pwsh.exe OR process.executable:*\\regsvr32.exe OR process.executable:*\\rundll32.exe OR process.executable:*\\wscript.exe)) OR ((process.executable:*:\\PerfLogs\\* OR process.executable:*:\\Temp\\* OR process.executable:*:\\Users\\Public\\* OR process.executable:*\\AppData\\Temp\\* OR process.executable:*\\Windows\\System32\\Tasks\\* OR process.executable:*\\Windows\\Tasks\\* OR process.executable:*\\Windows\\Temp\\*))) AND (process.parent.executable:*\\provlaunch.exe))
