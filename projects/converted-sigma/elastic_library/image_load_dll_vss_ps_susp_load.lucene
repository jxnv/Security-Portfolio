# Title: Suspicious Volume Shadow Copy VSS_PS.dll Load
# ID: 333cdbe8-27bb-4246-bf82-b41a0dca4b70
# Status: test
# Level: high
# Author: Markus Neis, @markus_neis
# Date: 2021-07-07
# Tags: attack.impact, attack.t1490
# Description: Detects the image load of vss_ps.dll by uncommon executables. This DLL is used by the Volume Shadow Copy Service (VSS) to manage shadow copies of files and volumes.
# It is often abused by attackers to delete or manipulate shadow copies, which can hinder forensic investigations and data recovery efforts.
# The fact that it is loaded by processes that are not typically associated with VSS operations can indicate suspicious activity.
# Converted by: Sigma Universal SIEM/EDR CLI

((ImageLoaded:*\\vss_ps.dll) AND NOT (((NOT _exists_:process.executable) OR (process.executable:C:\\Windows\\* AND (process.executable:*\\clussvc.exe OR process.executable:*\\dismhost.exe OR process.executable:*\\dllhost.exe OR process.executable:*\\inetsrv\\appcmd.exe OR process.executable:*\\inetsrv\\iissetup.exe OR process.executable:*\\msiexec.exe OR process.executable:*\\rundll32.exe OR process.executable:*\\searchindexer.exe OR process.executable:*\\srtasks.exe OR process.executable:*\\svchost.exe OR process.executable:*\\System32\\SystemPropertiesAdvanced.exe OR process.executable:*\\taskhostw.exe OR process.executable:*\\thor.exe OR process.executable:*\\thor64.exe OR process.executable:*\\tiworker.exe OR process.executable:*\\vssvc.exe OR process.executable:*\\vssadmin.exe OR process.executable:*\\WmiPrvSE.exe OR process.executable:*\\wsmprovhost.exe)) OR (process.command_line:C:\\$WinREAgent\\Scratch\\* AND process.command_line:*\\dismhost.exe {*))) AND NOT (((process.executable:C:\\Program Files\\* OR process.executable:C:\\Program Files (x86)\\*))))
