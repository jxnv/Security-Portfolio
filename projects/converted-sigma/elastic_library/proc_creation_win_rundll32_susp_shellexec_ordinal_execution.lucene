# Title: Suspicious ShellExec_RunDLL Call Via Ordinal
# ID: 8823e85d-31d8-473e-b7f4-92da070f0fc6
# Status: test
# Level: high
# Author: Swachchhanda Shrawan Poudel
# Date: 2024-12-01
# Tags: attack.stealth, attack.t1218.011
# Description: Detects suspicious call to the "ShellExec_RunDLL" exported function of SHELL32.DLL through the ordinal number to launch other commands.
# Adversary might only use the ordinal number in order to bypass existing detection that alert on usage of ShellExec_RunDLL on CommandLine.
# Converted by: Sigma Universal SIEM/EDR CLI

(((process.parent.command_line:*SHELL32.DLL*) AND ((process.parent.command_line:*#568* OR process.parent.command_line:*#570* OR process.parent.command_line:*#572* OR process.parent.command_line:*#576*))) AND (((process.executable:*\\bash.exe OR process.executable:*\\bitsadmin.exe OR process.executable:*\\cmd.exe OR process.executable:*\\cscript.exe OR process.executable:*\\curl.exe OR process.executable:*\\mshta.exe OR process.executable:*\\msiexec.exe OR process.executable:*\\msxsl.exe OR process.executable:*\\odbcconf.exe OR process.executable:*\\powershell.exe OR process.executable:*\\pwsh.exe OR process.executable:*\\regsvr32.exe OR process.executable:*\\schtasks.exe OR process.executable:*\\wmic.exe OR process.executable:*\\wscript.exe)) OR (((process.parent.command_line:*comspec* OR process.parent.command_line:*iex* OR process.parent.command_line:*Invoke-* OR process.parent.command_line:*msiexec* OR process.parent.command_line:*odbcconf* OR process.parent.command_line:*regsvr32*)) OR ((process.parent.command_line:*\\Desktop\\* OR process.parent.command_line:*\\ProgramData\\* OR process.parent.command_line:*\\Temp\\* OR process.parent.command_line:*\\Users\\Public\\*)))))
