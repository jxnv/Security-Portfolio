# Title: Suspicious Reg Add BitLocker
# ID: 0e0255bf-2548-47b8-9582-c0955c9283f5
# Status: test
# Level: high
# Author: frack113
# Date: 2021-11-15
# Tags: attack.impact, attack.t1486
# Description: Detects suspicious addition to BitLocker related registry keys via the reg.exe utility
# Converted by: Sigma Universal SIEM/EDR CLI

((process.command_line:*REG* AND process.command_line:*ADD* AND process.command_line:*\\SOFTWARE\\Policies\\Microsoft\\FVE* AND process.command_line:*/v* AND process.command_line:*/f*) AND (process.command_line:*EnableBDEWithNoTPM* OR process.command_line:*UseAdvancedStartup* OR process.command_line:*UseTPM* OR process.command_line:*UseTPMKey* OR process.command_line:*UseTPMKeyPIN* OR process.command_line:*RecoveryKeyMessageSource* OR process.command_line:*UseTPMPIN* OR process.command_line:*RecoveryKeyMessage*))
