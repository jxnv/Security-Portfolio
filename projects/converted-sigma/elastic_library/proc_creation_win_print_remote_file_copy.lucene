# Tags: attack.stealth, attack.t1218
# Description: Attackers can use print.exe for remote file copy
# Converted by: Sigma Universal SIEM/EDR CLI

((process.executable:*\\print.exe AND process.command_line:print* AND (process.command_line:*/D* AND process.command_line:*.exe*)) AND NOT ((process.command_line:*print.exe*)))
