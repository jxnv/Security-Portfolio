// Title: Network Connection Initiated To AzureWebsites.NET By Non-Browser Process
// ID: 5c80b618-0dbb-46e6-acbb-03d90bcb6d83
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.command-and-control, attack.t1102, attack.t1102.001
// Description: Detects an initiated network connection by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where ((Initiated == "true" and DestinationHostname endswith "azurewebsites.net") and not((((FolderPath startswith "C:\\Program Files (x86)\\Avant Browser\\" or FolderPath startswith "C:\\Program Files\\Avant Browser\\") and FolderPath endswith "\\avant.exe") or (FolderPath startswith "C:\\Program Files\\BraveSoftware\\" and FolderPath endswith "\\brave.exe") or ((FolderPath == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or FolderPath == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or (FolderPath startswith "C:\\Users\\" and FolderPath endswith "\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe") or ((FolderPath contains "C:\\Program Files\\Windows Defender Advanced Threat Protection\\" or FolderPath contains "C:\\Program Files\\Windows Defender\\" or FolderPath contains "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\") and (FolderPath endswith "\\MsMpEng.exe" or FolderPath endswith "\\MsSense.exe")) or (FolderPath contains "\\AppData\\Local\\Discord\\" and FolderPath endswith "\\Discord.exe") or ((FolderPath startswith "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") or (FolderPath endswith "\\WindowsApps\\MicrosoftEdge.exe") or ((FolderPath == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or FolderPath == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((FolderPath startswith "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" or FolderPath startswith "C:\\Program Files\\Microsoft\\EdgeCore\\") and (FolderPath endswith "\\msedge.exe" or FolderPath endswith "\\msedgewebview2.exe")) or (FolderPath == "") or ((FolderPath startswith "C:\\Program Files\\Falkon\\" or FolderPath startswith "C:\\Program Files (x86)\\Falkon\\") and FolderPath endswith "\\falkon.exe") or ((FolderPath == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or FolderPath == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or (FolderPath startswith "C:\\Users\\" and FolderPath endswith "\\AppData\\Local\\Mozilla Firefox\\firefox.exe") or (FolderPath contains "\\AppData\\Local\\Flock\\" and FolderPath endswith "\\Flock.exe") or ((FolderPath == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or FolderPath == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (FolderPath contains "\\AppData\\Local\\Maxthon\\" and FolderPath endswith "\\maxthon.exe") or ((isempty(FolderPath) or isnull(FolderPath))) or (FolderPath contains "\\AppData\\Local\\Programs\\Opera\\" and FolderPath endswith "\\opera.exe") or (FolderPath contains "\\AppData\\Local\\Phoebe\\" and FolderPath endswith "\\Phoebe.exe") or ((FolderPath endswith "C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe" or FolderPath endswith "C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe")) or ((FolderPath startswith "C:\\Program Files (x86)\\QtWeb\\" or FolderPath startswith "C:\\Program Files\\QtWeb\\") and FolderPath endswith "\\QtWeb.exe") or ((FolderPath contains "C:\\Program Files (x86)\\Safari\\" or FolderPath contains "C:\\Program Files\\Safari\\") and FolderPath endswith "\\safari.exe") or ((FolderPath startswith "C:\\Program Files\\SeaMonkey\\" or FolderPath startswith "C:\\Program Files (x86)\\SeaMonkey\\") and FolderPath endswith "\\seamonkey.exe") or ((FolderPath startswith "C:\\Program Files\\SlimBrowser\\" or FolderPath startswith "C:\\Program Files (x86)\\SlimBrowser\\") and FolderPath endswith "\\slimbrowser.exe") or (FolderPath contains "\\AppData\\Local\\Vivaldi\\" and FolderPath endswith "\\vivaldi.exe") or ((FolderPath startswith "C:\\Program Files\\Naver\\Naver Whale\\" or FolderPath startswith "C:\\Program Files (x86)\\Naver\\Naver Whale\\") and FolderPath endswith "\\whale.exe") or ((FolderPath startswith "C:\\Program Files\\Waterfox\\" or FolderPath startswith "C:\\Program Files (x86)\\Waterfox\\") and FolderPath endswith "\\Waterfox.exe"))))
