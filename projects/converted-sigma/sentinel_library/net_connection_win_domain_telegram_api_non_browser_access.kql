// Title: Suspicious Non-Browser Network Communication With Telegram API
// ID: c3dbbc9f-ef1d-470a-a90a-d343448d5875
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-19
// Tags: attack.command-and-control, attack.exfiltration, attack.t1102, attack.t1567, attack.t1105
// Description: Detects an a non-browser process interacting with the Telegram API which could indicate use of a covert C2
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where ((DestinationHostname contains "api.telegram.org") and not(((FolderPath endswith "\\brave.exe") or ((FolderPath == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or FolderPath == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or ((FolderPath startswith "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") or (FolderPath endswith "\\WindowsApps\\MicrosoftEdge.exe") or ((FolderPath == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or FolderPath == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((FolderPath startswith "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" or FolderPath startswith "C:\\Program Files\\Microsoft\\EdgeCore\\") and (FolderPath endswith "\\msedge.exe" or FolderPath endswith "\\msedgewebview2.exe")) or ((FolderPath == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or FolderPath == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or ((FolderPath == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or FolderPath == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (FolderPath endswith "\\maxthon.exe") or (FolderPath endswith "\\opera.exe") or (FolderPath endswith "\\safari.exe") or (FolderPath endswith "\\seamonkey.exe") or (FolderPath endswith "\\vivaldi.exe") or (FolderPath endswith "\\whale.exe"))))
