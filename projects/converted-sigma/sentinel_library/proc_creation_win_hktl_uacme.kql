// Tags: attack.privilege-escalation, attack.t1548.002
// Description: Detects the execution of UACMe, a tool used for UAC bypasses, via default PE metadata
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where (((SHA256 contains "IMPHASH=767637C23BB42CD5D7397CF58B0BE688" or SHA256 contains "IMPHASH=14C4E4C72BA075E9069EE67F39188AD8" or SHA256 contains "IMPHASH=3C782813D4AFCE07BBFC5A9772ACDBDC" or SHA256 contains "IMPHASH=7D010C6BB6A3726F327F7E239166D127" or SHA256 contains "IMPHASH=89159BA4DD04E4CE5559F132A9964EB3" or SHA256 contains "IMPHASH=6F33F4A5FC42B8CEC7314947BD13F30F" or SHA256 contains "IMPHASH=5834ED4291BDEB928270428EBBAF7604" or SHA256 contains "IMPHASH=5A8A8A43F25485E7EE1B201EDCBC7A38" or SHA256 contains "IMPHASH=DC7D30B90B2D8ABF664FBED2B1B59894" or SHA256 contains "IMPHASH=41923EA1F824FE63EA5BEB84DB7A3E74" or SHA256 contains "IMPHASH=3DE09703C8E79ED2CA3F01074719906B")) or ((FolderPath endswith "\\Akagi64.exe" or FolderPath endswith "\\Akagi.exe")) or ((Product == "UACMe") or ((Company == "REvol Corp" or Company == "APT 92" or Company == "UG North" or Company == "Hazardous Environments" or Company == "CD Project Rekt")) or ((Description == "UACMe main module" or Description == "Pentesting utility")) or ((ProcessVersionInfoOriginalFileName == "Akagi.exe" or ProcessVersionInfoOriginalFileName == "Akagi64.exe"))))
