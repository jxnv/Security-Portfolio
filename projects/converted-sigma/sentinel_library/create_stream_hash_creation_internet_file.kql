// Title: Creation Of a Suspicious ADS File Outside a Browser Download
// ID: 573df571-a223-43bc-846e-3f98da481eca
// Status: test
// Level: medium
// Author: frack113
// Date: 2022-10-22
// Tags: attack.stealth
// Description: Detects the creation of a suspicious ADS (Alternate Data Stream) file by software other than browsers
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where ((Contents startswith "[ZoneTransfer]  ZoneId=3" and FileName endswith ":Zone.Identifier" and (FileName contains ".exe" or FileName contains ".scr" or FileName contains ".bat" or FileName contains ".cmd" or FileName contains ".docx" or FileName contains ".hta" or FileName contains ".jse" or FileName contains ".lnk" or FileName contains ".pptx" or FileName contains ".ps" or FileName contains ".reg" or FileName contains ".sct" or FileName contains ".vb" or FileName contains ".wsc" or FileName contains ".wsf" or FileName contains ".xlsx")) and not(((FolderPath endswith "\\brave.exe") or ((FolderPath == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or FolderPath == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or ((FolderPath startswith "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") or (FolderPath endswith "\\WindowsApps\\MicrosoftEdge.exe") or ((FolderPath == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or FolderPath == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((FolderPath startswith "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" or FolderPath startswith "C:\\Program Files\\Microsoft\\EdgeCore\\") and (FolderPath endswith "\\msedge.exe" or FolderPath endswith "\\msedgewebview2.exe")) or ((FolderPath == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or FolderPath == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or ((FolderPath == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or FolderPath == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (FolderPath endswith "\\maxthon.exe") or (FolderPath endswith "\\opera.exe") or (FolderPath endswith "\\safari.exe") or (FolderPath endswith "\\seamonkey.exe") or (FolderPath startswith "C:\\Program Files\\WindowsApps\\Microsoft.ScreenSketch_" and FolderPath endswith "\\SnippingTool\\SnippingTool.exe" and FileName startswith "C:\\Users\\" and (FileName contains "\\AppData\\Local\\Packages\\Microsoft.ScreenSketch_" and FileName contains "\\TempState\\Screenshot ") and FileName endswith ".png:Zone.Identifier") or (FolderPath endswith "\\vivaldi.exe") or (FolderPath endswith "\\whale.exe"))))
