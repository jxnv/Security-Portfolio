// Title: Remote Thread Creation By Uncommon Source Image
// ID: 66d31e5f-52d6-40a4-9615-002d3789a119
// Status: test
// Level: medium
// Author: Perez Diego (@darkquassar), oscd.community
// Date: 2019-10-27
// Tags: attack.privilege-escalation, attack.stealth, attack.t1055
// Description: Detects uncommon processes creating remote threads.
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where (((SourceImage endswith "\\explorer.exe" or SourceImage endswith "\\iexplore.exe" or SourceImage endswith "\\msiexec.exe" or SourceImage endswith "\\powerpnt.exe" or SourceImage endswith "\\schtasks.exe" or SourceImage endswith "\\winlogon.exe")) and not(((TargetImage == "") or (SourceImage == "C:\\Windows\\explorer.exe" and (TargetImage startswith "C:\\Program Files (x86)\\" or TargetImage startswith "C:\\Program Files\\" or TargetImage startswith "C:\\Windows\\System32\\" or TargetImage startswith "C:\\Windows\\SysWOW64\\")) or (SourceImage == "C:\\Program Files\\Internet Explorer\\iexplore.exe" and (TargetImage == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or TargetImage == "C:\\Windows\\System32\\rundll32.exe")) or (SourceImage endswith "\\msiexec.exe" and (TargetImage contains "\\AppData\\Local\\" or TargetImage contains "C:\\Program Files (x86)\\" or TargetImage contains "C:\\Program Files\\" or TargetImage contains "C:\\Windows\\Microsoft.NET\\Framework64\\")) or (SourceImage endswith "\\msiexec.exe" and (TargetImage == "C:\\Windows\\System32\\msiexec.exe" or TargetImage == "C:\\Windows\\SysWOW64\\msiexec.exe")) or ((isempty(TargetImage) or isnull(TargetImage))) or (SourceImage endswith "\\POWERPNT.EXE" and (TargetImage contains "C:\\Program Files\\Microsoft Office\\" or TargetImage contains "C:\\Program Files (x86)\\Microsoft Office\\")) or ((SourceImage == "C:\\Windows\\System32\\schtasks.exe" or SourceImage == "C:\\Windows\\SysWOW64\\schtasks.exe") and TargetImage == "C:\\Windows\\System32\\conhost.exe") or (TargetImage == "System") or (SourceImage == "C:\\Windows\\System32\\winlogon.exe" and (TargetImage == "C:\\Windows\\System32\\services.exe" or TargetImage == "C:\\Windows\\System32\\wininit.exe" or TargetImage == "C:\\Windows\\System32\\csrss.exe" or TargetImage == "C:\\Windows\\System32\\LogonUI.exe" or TargetImage == "C:\\Windows\\System32\\wlrmdr.exe" or TargetImage == "C:\\Windows\\System32\\AtBroker.exe" or TargetImage == "C:\\Windows\\System32\\dwm.exe" or TargetImage == "C:\\Windows\\System32\\fontdrvhost.exe" or TargetImage == "C:\\Windows\\System32\\userinit.exe")) or (SourceImage == "C:\\Windows\\System32\\winlogon.exe" and TargetParentProcessId == 4))) and not(((SourceImage == "C:\\Windows\\explorer.exe" and TargetImage endswith "\\aurora-dashboard.exe") or (SourceImage == "C:\\Program Files\\internet explorer\\iexplore.exe" and (SourceCommandLine contains "https://" and SourceCommandLine contains ".checkpoint.com/documents/" and SourceCommandLine contains "SmartConsole_OLH/" and SourceCommandLine contains "default.htm#cshid=")) or (SourceImage == "C:\\Program Files\\internet explorer\\iexplore.exe" and (SourceParentImage startswith "C:\\Program Files\\" or SourceParentImage startswith "C:\\Program Files (x86)\\") and (SourceParentImage contains "\\CheckPoint\\SmartConsole\\" and SourceParentImage contains "\\SmartConsole.exe")) or (SourceImage == "C:\\Windows\\explorer.exe" and TargetImage endswith "\\OfficeSetup.exe") or (SourceImage == "C:\\Windows\\explorer.exe" and TargetImage endswith "\\AppData\\Local\\Microsoft\\OneDrive\\OneDrive.exe") or (SourceImage contains "\\Microsoft Office\\" and SourceImage endswith "\\POWERPNT.EXE" and TargetImage == "C:\\Windows\\System32\\csrss.exe"))))
