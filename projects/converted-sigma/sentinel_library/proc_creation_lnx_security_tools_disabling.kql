// Title: Disabling Security Tools
// ID: e3a8a052-111f-4606-9aee-f28ebeb76776
// Status: test
// Level: medium
// Author: Ömer Günal, Alejandro Ortuno, oscd.community
// Date: 2020-06-17
// Tags: attack.defense-impairment, attack.t1686
// Description: Detects disabling security tools
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where ((FolderPath endswith "/service" and (ProcessCommandLine contains "cbdaemon" and ProcessCommandLine contains "stop")) or (FolderPath endswith "/chkconfig" and (ProcessCommandLine contains "cbdaemon" and ProcessCommandLine contains "off")) or (FolderPath endswith "/systemctl" and (ProcessCommandLine contains "cbdaemon" and ProcessCommandLine contains "stop")) or (FolderPath endswith "/systemctl" and (ProcessCommandLine contains "cbdaemon" and ProcessCommandLine contains "disable")) or (FolderPath endswith "/systemctl" and (ProcessCommandLine contains "stop" and ProcessCommandLine contains "falcon-sensor")) or (FolderPath endswith "/systemctl" and (ProcessCommandLine contains "disable" and ProcessCommandLine contains "falcon-sensor")) or (FolderPath endswith "/systemctl" and (ProcessCommandLine contains "firewalld" and ProcessCommandLine contains "stop")) or (FolderPath endswith "/systemctl" and (ProcessCommandLine contains "firewalld" and ProcessCommandLine contains "disable")) or (FolderPath endswith "/service" and (ProcessCommandLine contains "iptables" and ProcessCommandLine contains "stop")) or (FolderPath endswith "/service" and (ProcessCommandLine contains "ip6tables" and ProcessCommandLine contains "stop")) or (FolderPath endswith "/chkconfig" and (ProcessCommandLine contains "iptables" and ProcessCommandLine contains "stop")) or (FolderPath endswith "/chkconfig" and (ProcessCommandLine contains "ip6tables" and ProcessCommandLine contains "stop")) or (FolderPath endswith "/setenforce" and ProcessCommandLine contains "0"))
