// Title: Files With System Process Name In Unsuspected Locations
// ID: d5866ddf-ce8f-4aea-b28e-d96485a20d3d
// Status: test
// Level: medium
// Author: Sander Wiebing, Tim Shelton, Nasreddine Bencherchali (Nextron Systems)
// Date: 2020-05-26
// Tags: attack.stealth, attack.t1036.005
// Description: Detects the creation of an executable with a system process name in folders other than the system ones (System32, SysWOW64, etc.).
// It is highly recommended to perform an initial baseline before using this rule in production.
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where (((FileName endswith "\\AtBroker.exe" or FileName endswith "\\audiodg.exe" or FileName endswith "\\backgroundTaskHost.exe" or FileName endswith "\\bcdedit.exe" or FileName endswith "\\bitsadmin.exe" or FileName endswith "\\cmdl32.exe" or FileName endswith "\\cmstp.exe" or FileName endswith "\\conhost.exe" or FileName endswith "\\csrss.exe" or FileName endswith "\\dasHost.exe" or FileName endswith "\\dfrgui.exe" or FileName endswith "\\dllhost.exe" or FileName endswith "\\dwm.exe" or FileName endswith "\\eventcreate.exe" or FileName endswith "\\eventvwr.exe" or FileName endswith "\\explorer.exe" or FileName endswith "\\extrac32.exe" or FileName endswith "\\fontdrvhost.exe" or FileName endswith "\\fsquirt.exe" or FileName endswith "\\ipconfig.exe" or FileName endswith "\\iscsicli.exe" or FileName endswith "\\iscsicpl.exe" or FileName endswith "\\logman.exe" or FileName endswith "\\LogonUI.exe" or FileName endswith "\\LsaIso.exe" or FileName endswith "\\lsass.exe" or FileName endswith "\\lsm.exe" or FileName endswith "\\msiexec.exe" or FileName endswith "\\msinfo32.exe" or FileName endswith "\\mstsc.exe" or FileName endswith "\\nbtstat.exe" or FileName endswith "\\odbcconf.exe" or FileName endswith "\\powershell.exe" or FileName endswith "\\pwsh.exe" or FileName endswith "\\regini.exe" or FileName endswith "\\regsvr32.exe" or FileName endswith "\\rundll32.exe" or FileName endswith "\\RuntimeBroker.exe" or FileName endswith "\\schtasks.exe" or FileName endswith "\\SearchFilterHost.exe" or FileName endswith "\\SearchIndexer.exe" or FileName endswith "\\SearchProtocolHost.exe" or FileName endswith "\\SecurityHealthService.exe" or FileName endswith "\\SecurityHealthSystray.exe" or FileName endswith "\\services.exe" or FileName endswith "\\ShellAppRuntime.exe" or FileName endswith "\\sihost.exe" or FileName endswith "\\smartscreen.exe" or FileName endswith "\\smss.exe" or FileName endswith "\\spoolsv.exe" or FileName endswith "\\svchost.exe" or FileName endswith "\\SystemSettingsBroker.exe" or FileName endswith "\\taskhost.exe" or FileName endswith "\\taskhostw.exe" or FileName endswith "\\Taskmgr.exe" or FileName endswith "\\TiWorker.exe" or FileName endswith "\\vssadmin.exe" or FileName endswith "\\w32tm.exe" or FileName endswith "\\WerFault.exe" or FileName endswith "\\WerFaultSecure.exe" or FileName endswith "\\wermgr.exe" or FileName endswith "\\wevtutil.exe" or FileName endswith "\\wininit.exe" or FileName endswith "\\winlogon.exe" or FileName endswith "\\winrshost.exe" or FileName endswith "\\WinRTNetMUAHostServer.exe" or FileName endswith "\\wlanext.exe" or FileName endswith "\\wlrmdr.exe" or FileName endswith "\\WmiPrvSE.exe" or FileName endswith "\\wslhost.exe" or FileName endswith "\\WSReset.exe" or FileName endswith "\\WUDFHost.exe" or FileName endswith "\\WWAHost.exe")) and not(((FileName endswith "C:\\Windows\\explorer.exe") or ((FileName contains "C:\\$WINDOWS.~BT\\" or FileName contains "C:\\$WinREAgent\\" or FileName contains "C:\\Windows\\SoftwareDistribution\\" or FileName contains "C:\\Windows\\System32\\" or FileName contains "C:\\Windows\\SysWOW64\\" or FileName contains "C:\\Windows\\WinSxS\\" or FileName contains "C:\\Windows\\uus\\")) or (FileName contains "C:\\Windows\\System32\\SecurityHealth\\" and FileName endswith "\\SecurityHealthSystray.exe" and FolderPath endswith "\\SecurityHealthSetup.exe") or ((FolderPath endswith "C:\\WINDOWS\\system32\\msiexec.exe" or FolderPath endswith "C:\\WINDOWS\\SysWOW64\\msiexec.exe") and (FileName startswith "C:\\Program Files\\PowerShell\\7\\pwsh.exe" or FileName startswith "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" or FileName startswith "C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview\\")) or ((FolderPath endswith "C:\\Windows\\system32\\svchost.exe" or FolderPath endswith "C:\\Windows\\SysWOW64\\svchost.exe") and (FileName contains "C:\\Program Files\\WindowsApps\\" or FileName contains "C:\\Program Files (x86)\\WindowsApps\\" or FileName contains "\\AppData\\Local\\Microsoft\\WindowsApps\\")) or ((FolderPath endswith "\\TiWorker.exe" or FolderPath endswith "\\wuaucltcore.exe") and FileName startswith "C:\\Windows\\Temp\\") or ((FolderPath == "C:\\Windows\\System32\\wuauclt.exe" or FolderPath == "C:\\Windows\\SysWOW64\\wuauclt.exe" or FolderPath == "C:\\Windows\\UUS\\arm64\\wuaucltcore.exe")))) and not(((FileName == "C:\\Program Files\\WSL\\wslhost.exe") or ((FileName contains "C:\\Program Files\\WindowsApps\\MicrosoftCorporationII.WindowsSubsystemForLinux_" and FileName contains "\\wslhost.exe")) or ((FileName contains "C:\\Users\\" and FileName contains "\\AppData\\Local\\Microsoft\\WindowsApps\\" and FileName contains "\\wslhost.exe")))))
