// Title: Potential Direct Syscall of NtOpenProcess
// ID: 3f3f3506-1895-401b-9cc3-e86b16e630d0
// Status: test
// Level: medium
// Author: Christian Burkard (Nextron Systems), Tim Shelton (FP)
// Date: 2021-07-28
// Tags: attack.execution, attack.t1106
// Description: Detects potential calls to NtOpenProcess directly from NTDLL.
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where ((CallTrace startswith "UNKNOWN") and not((((SourceImage contains ":\\Program Files (x86)\\" or SourceImage contains ":\\Program Files\\" or SourceImage contains ":\\Windows\\System32\\" or SourceImage contains ":\\Windows\\SysWOW64\\" or SourceImage contains ":\\Windows\\WinSxS\\") and (TargetImage contains ":\\Program Files (x86)\\" or TargetImage contains ":\\Program Files\\" or TargetImage contains ":\\Windows\\System32\\" or TargetImage contains ":\\Windows\\SysWOW64\\" or TargetImage contains ":\\Windows\\WinSxS\\")) or (Provider_Name == "Microsoft-Windows-Kernel-Audit-API-Calls") or (TargetImage endswith "vcredist_x64.exe" and SourceImage endswith "vcredist_x64.exe"))) and not(((SourceImage contains ":\\Program Files\\Adobe\\Acrobat DC\\Acrobat\\" and SourceImage endswith "\\AcroCEF.exe" and TargetImage contains ":\\Program Files\\Adobe\\Acrobat DC\\Acrobat\\" and TargetImage endswith "\\AcroCEF.exe") or (SourceImage endswith "AmazonSSMAgentSetup.exe" and TargetImage endswith "AmazonSSMAgentSetup.exe") or (SourceImage endswith ":\\Windows\\Explorer.EXE" and TargetImage endswith ":\\Program Files\\Cylance\\Desktop\\CylanceUI.exe") or (TargetImage contains "\\AppData\\Local\\Discord\\" and TargetImage endswith "\\Discord.exe") or (TargetImage endswith "\\Evernote\\Evernote.exe") or (TargetImage endswith "\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe" and SourceImage endswith "\\AppData\\Local\\Microsoft\\Teams\\current\\Teams.exe") or (TargetImage endswith ":\\Windows\\system32\\systeminfo.exe" and SourceImage endswith "setup64.exe") or (SourceImage endswith "\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe" and TargetImage endswith "\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe") or (SourceImage contains "\\AppData\\Local\\yammerdesktop\\app-" and SourceImage endswith "\\Yammer.exe" and TargetImage contains "\\AppData\\Local\\yammerdesktop\\app-" and TargetImage endswith "\\Yammer.exe" and GrantedAccess == "0x1000"))))
