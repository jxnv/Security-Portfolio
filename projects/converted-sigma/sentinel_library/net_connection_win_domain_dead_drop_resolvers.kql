// Title: New Connection Initiated To Potential Dead Drop Resolver Domain
// ID: 297ae038-edc2-4b2e-bb3e-7c5fc94dd5c7
// Status: test
// Level: high
// Author: Sorina Ionescu, X__Junior (Nextron Systems)
// Date: 2022-08-17
// Tags: attack.command-and-control, attack.t1102, attack.t1102.001
// Description: Detects an executable, which is not an internet browser or known application, initiating network connections to legit popular websites, which were seen to be used as dead drop resolvers in previous attacks.
// In this context attackers leverage known websites such as "facebook", "youtube", etc. In order to pass through undetected.
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where ((Initiated == "true" and (DestinationHostname endswith ".t.me" or DestinationHostname endswith "0x0.st" or DestinationHostname endswith "4shared.com" or DestinationHostname endswith "abuse.ch" or DestinationHostname endswith "anonfiles.com" or DestinationHostname endswith "bashupload.com" or DestinationHostname endswith "cdn.discordapp.com" or DestinationHostname endswith "chunk.io" or DestinationHostname endswith "cloudflare.com" or DestinationHostname endswith "ddns.net" or DestinationHostname endswith "discord.com" or DestinationHostname endswith "docs.google.com" or DestinationHostname endswith "drive.google.com" or DestinationHostname endswith "dropbox.com" or DestinationHostname endswith "dropmefiles.com" or DestinationHostname endswith "facebook.com" or DestinationHostname endswith "feeds.rapidfeeds.com" or DestinationHostname endswith "fotolog.com" or DestinationHostname endswith "ghostbin.co/" or DestinationHostname endswith "githubusercontent.com" or DestinationHostname endswith "gofile.io" or DestinationHostname endswith "hastebin.com" or DestinationHostname endswith "imgur.com" or DestinationHostname endswith "livejournal.com" or DestinationHostname endswith "mediafire.com" or DestinationHostname endswith "mega.co.nz" or DestinationHostname endswith "mega.nz" or DestinationHostname endswith "onedrive.com" or DestinationHostname endswith "pages.dev" or DestinationHostname endswith "paste.ee" or DestinationHostname endswith "pastebin.com" or DestinationHostname endswith "pastebin.pl" or DestinationHostname endswith "pastetext.net" or DestinationHostname endswith "pixeldrain.com" or DestinationHostname endswith "privatlab.com" or DestinationHostname endswith "privatlab.net" or DestinationHostname endswith "reddit.com" or DestinationHostname endswith "send.exploit.in" or DestinationHostname endswith "sendspace.com" or DestinationHostname endswith "steamcommunity.com" or DestinationHostname endswith "storage.googleapis.com" or DestinationHostname endswith "technet.microsoft.com" or DestinationHostname endswith "temp.sh" or DestinationHostname endswith "transfer.sh" or DestinationHostname endswith "trycloudflare.com" or DestinationHostname endswith "twitter.com" or DestinationHostname endswith "ufile.io" or DestinationHostname endswith "vimeo.com" or DestinationHostname endswith "w3spaces.com" or DestinationHostname endswith "wetransfer.com" or DestinationHostname endswith "workers.dev" or DestinationHostname endswith "x0.at" or DestinationHostname endswith "youtube.com")) and not((((FolderPath startswith "C:\\Program Files (x86)\\Avant Browser\\" or FolderPath startswith "C:\\Program Files\\Avant Browser\\") and FolderPath endswith "\\avant.exe") or (FolderPath startswith "C:\\Program Files\\BraveSoftware\\" and FolderPath endswith "\\brave.exe") or ((FolderPath == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or FolderPath == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or (FolderPath startswith "C:\\Users\\" and FolderPath endswith "\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe") or ((FolderPath contains "C:\\Program Files\\Windows Defender Advanced Threat Protection\\" or FolderPath contains "C:\\Program Files\\Windows Defender\\" or FolderPath contains "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\") and (FolderPath endswith "\\MsMpEng.exe" or FolderPath endswith "\\MsSense.exe")) or (FolderPath contains "\\AppData\\Local\\Discord\\" and FolderPath endswith "\\Discord.exe" and (DestinationHostname endswith "discord.com" or DestinationHostname endswith "cdn.discordapp.com")) or ((FolderPath startswith "C:\\Program Files (x86)\\Dropbox\\Client\\" or FolderPath startswith "C:\\Program Files\\Dropbox\\Client\\") and (FolderPath endswith "\\Dropbox.exe" or FolderPath endswith "\\DropboxInstaller.exe") and DestinationHostname endswith "dropbox.com") or ((FolderPath startswith "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") or (FolderPath endswith "\\WindowsApps\\MicrosoftEdge.exe") or ((FolderPath == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or FolderPath == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((FolderPath startswith "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" or FolderPath startswith "C:\\Program Files\\Microsoft\\EdgeCore\\") and (FolderPath endswith "\\msedge.exe" or FolderPath endswith "\\msedgewebview2.exe")) or (FolderPath == "") or ((FolderPath startswith "C:\\Program Files\\Falkon\\" or FolderPath startswith "C:\\Program Files (x86)\\Falkon\\") and FolderPath endswith "\\falkon.exe") or ((FolderPath == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or FolderPath == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or (FolderPath startswith "C:\\Users\\" and FolderPath endswith "\\AppData\\Local\\Mozilla Firefox\\firefox.exe") or (FolderPath contains "\\AppData\\Local\\Flock\\" and FolderPath endswith "\\Flock.exe") or ((FolderPath contains "C:\\Program Files\\Google\\Drive File Stream\\" or FolderPath contains "C:\\Program Files (x86)\\Google\\Drive File Stream\\") and FolderPath endswith "GoogleDriveFS.exe" and DestinationHostname endswith "drive.google.com") or ((FolderPath == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or FolderPath == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (FolderPath contains "\\AppData\\Local\\Maxthon\\" and FolderPath endswith "\\maxthon.exe") or ((FolderPath endswith "\\MEGAsync.exe" or FolderPath endswith "\\MEGAsyncSetup32_*RC.exe" or FolderPath endswith "\\MEGAsyncSetup32.exe" or FolderPath endswith "\\MEGAsyncSetup64.exe" or FolderPath endswith "\\MEGAupdater.exe") and (DestinationHostname endswith "mega.co.nz" or DestinationHostname endswith "mega.nz")) or (FolderPath contains "\\AppData\\Local\\Programs\\midori-ng\\" and FolderPath endswith "\\Midori Next Generation.exe") or ((isempty(FolderPath) or isnull(FolderPath))) or (FolderPath contains "\\AppData\\Local\\Microsoft\\OneDrive\\" and FolderPath endswith "\\OneDrive.exe" and DestinationHostname endswith "onedrive.com") or (FolderPath contains "\\AppData\\Local\\Programs\\Opera\\" and FolderPath endswith "\\opera.exe") or (FolderPath contains "\\AppData\\Local\\Phoebe\\" and FolderPath endswith "\\Phoebe.exe") or ((FolderPath endswith "C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe" or FolderPath endswith "C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe")) or ((FolderPath startswith "C:\\Program Files (x86)\\QtWeb\\" or FolderPath startswith "C:\\Program Files\\QtWeb\\") and FolderPath endswith "\\QtWeb.exe") or ((FolderPath contains "C:\\Program Files (x86)\\Safari\\" or FolderPath contains "C:\\Program Files\\Safari\\") and FolderPath endswith "\\safari.exe") or ((FolderPath startswith "C:\\Program Files\\SeaMonkey\\" or FolderPath startswith "C:\\Program Files (x86)\\SeaMonkey\\") and FolderPath endswith "\\seamonkey.exe") or ((FolderPath startswith "C:\\Program Files\\SlimBrowser\\" or FolderPath startswith "C:\\Program Files (x86)\\SlimBrowser\\") and FolderPath endswith "\\slimbrowser.exe") or (FolderPath contains "\\AppData\\Roaming\\Telegram Desktop\\" and FolderPath endswith "\\Telegram.exe" and DestinationHostname endswith ".t.me") or (FolderPath contains "\\AppData\\Local\\Vivaldi\\" and FolderPath endswith "\\vivaldi.exe") or ((FolderPath startswith "C:\\Program Files\\Naver\\Naver Whale\\" or FolderPath startswith "C:\\Program Files (x86)\\Naver\\Naver Whale\\") and FolderPath endswith "\\whale.exe") or ((FolderPath startswith "C:\\Program Files\\Waterfox\\" or FolderPath startswith "C:\\Program Files (x86)\\Waterfox\\") and FolderPath endswith "\\Waterfox.exe") or ((FolderPath startswith "C:\\Program Files (x86)\\WindowsApps\\" or FolderPath startswith "C:\\Program Files\\WindowsApps\\") and FolderPath endswith "\\WhatsApp.exe" and DestinationHostname endswith "facebook.com"))))
