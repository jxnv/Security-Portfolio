// Title: Uncommon File Created In Office Startup Folder
// ID: a10a2c40-2c4d-49f8-b557-1a946bc55d9d
// Status: test
// Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-05
// Tags: attack.resource-development, attack.t1587.001
// Description: Detects the creation of a file with an uncommon extension in an Office application startup folder
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where (((((FileName contains "\\Microsoft\\Word\\STARTUP") or ((FileName contains "\\Office" and FileName contains "\\Program Files" and FileName contains "\\STARTUP"))) and not(((FileName endswith ".docb" or FileName endswith ".docm" or FileName endswith ".docx" or FileName endswith ".dotm" or FileName endswith ".mdb" or FileName endswith ".mdw" or FileName endswith ".pdf" or FileName endswith ".wll" or FileName endswith ".wwl")))) or (((FileName contains "\\Microsoft\\Excel\\XLSTART") or ((FileName contains "\\Office" and FileName contains "\\Program Files" and FileName contains "\\XLSTART"))) and not(((FileName endswith ".xll" or FileName endswith ".xls" or FileName endswith ".xlsm" or FileName endswith ".xlsx" or FileName endswith ".xlt" or FileName endswith ".xltm" or FileName endswith ".xlw"))))) and not((((FolderPath contains ":\\Program Files\\Microsoft Office\\" or FolderPath contains ":\\Program Files (x86)\\Microsoft Office\\") and (FolderPath endswith "\\winword.exe" or FolderPath endswith "\\excel.exe")) or (FolderPath contains ":\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\" and FolderPath endswith "\\OfficeClickToRun.exe"))))
