// Title: Scheduled TaskCache Change by Uncommon Program
// ID: 4720b7df-40c3-48fd-bbdf-fd4b3c464f0d
// Status: test
// Level: high
// Author: Syed Hasan (@syedhasan009)
// Date: 2021-06-18
// Tags: attack.privilege-escalation, attack.execution, attack.persistence, attack.t1053, attack.t1053.005
// Description: Monitor the creation of a new key under 'TaskCache' when a new scheduled task is registered by a process that is not svchost.exe, which is suspicious
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where ((RegistryKey contains "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Schedule\\TaskCache\\") and not(((RegistryValueData == "(Empty)") or (FolderPath == "C:\\Windows\\explorer.exe" and RegistryKey contains "\\Microsoft\\Windows NT\\CurrentVersion\\Schedule\\TaskCache\\Tree\\Microsoft\\Windows\\PLA\\Server Manager Performance Monitor\\") or (FolderPath endswith "C:\\Windows\\System32\\MoUsoCoreWorker.exe") or (FolderPath == "C:\\Windows\\System32\\msiexec.exe") or (FolderPath startswith "C:\\Windows\\Microsoft.NET\\Framework" and FolderPath endswith "\\ngen.exe" and (RegistryKey contains "\\Microsoft\\Windows NT\\CurrentVersion\\Schedule\\TaskCache\\Tasks\\{B66B135D-DA06-4FC4-95F8-7458E1D10129}" or RegistryKey contains "\\Microsoft\\Windows NT\\CurrentVersion\\Schedule\\TaskCache\\Tree\\Microsoft\\Windows\\.NET Framework\\.NET Framework NGEN")) or ((isempty(RegistryValueData) or isnull(RegistryValueData))) or ((FolderPath == "C:\\Program Files\\Microsoft Office\\root\\Integration\\Integrator.exe" or FolderPath == "C:\\Program Files (x86)\\Microsoft Office\\root\\Integration\\Integrator.exe" or FolderPath == "C:\\Program Files\\Common Files\\microsoft shared\\ClickToRun\\OfficeC2RClient.exe" or FolderPath == "C:\\Program Files (x86)\\Common Files\\microsoft shared\\ClickToRun\\OfficeC2RClient.exe")) or ((RegistryKey contains "Microsoft\\Windows\\UpdateOrchestrator" or RegistryKey contains "Microsoft\\Windows\\SoftwareProtectionPlatform\\SvcRestartTask\\Index" or RegistryKey contains "Microsoft\\Windows\\Flighting\\OneSettings\\RefreshCache\\Index")) or (FolderPath == "C:\\Windows\\System32\\RuntimeBroker.exe") or (FolderPath endswith "C:\\Windows\\System32\\services.exe") or (FolderPath == "C:\\WINDOWS\\system32\\svchost.exe") or (FolderPath == "System") or (FolderPath startswith "C:\\Windows\\" and FolderPath endswith "\\TiWorker.exe"))) and not((((FolderPath == "C:\\Program Files (x86)\\Dropbox\\Update\\DropboxUpdate.exe" or FolderPath == "C:\\Program Files\\Dropbox\\Update\\DropboxUpdate.exe")) or ((FolderPath endswith "C:\\Program Files (x86)\\Microsoft\\EdgeUpdate\\MicrosoftEdgeUpdate.exe" or FolderPath endswith "C:\\Program Files\\Microsoft\\EdgeUpdate\\MicrosoftEdgeUpdate.exe")) or ((FolderPath endswith "C:\\Program Files (x86)\\Microsoft OneDrive\\OneDrive.exe" or FolderPath endswith "C:\\Program Files\\Microsoft OneDrive\\OneDrive.exe")))))
