// Title: PSScriptPolicyTest Creation By Uncommon Process
// ID: 1027d292-dd87-4a1a-8701-2abe04d7783c
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-06-01
// Tags: attack.stealth
// Description: Detects the creation of the "PSScriptPolicyTest" PowerShell script by an uncommon process. This file is usually generated by Microsoft Powershell to test against Applocker.
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where ((FileName contains "__PSScriptPolicyTest_") and not((((FolderPath == "C:\\Windows\\System32\\dsac.exe" or FolderPath == "C:\\Windows\\System32\\sdiagnhost.exe" or FolderPath == "C:\\Windows\\System32\\ServerManager.exe" or FolderPath == "C:\\Windows\\System32\\wsmprovhost.exe" or FolderPath == "C:\\Windows\\SysWOW64\\sdiagnhost.exe")) or ((FolderPath == "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" or FolderPath == "C:\\Program Files\\PowerShell\\7\\pwsh.exe" or FolderPath == "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or FolderPath == "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" or FolderPath == "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or FolderPath == "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")) or ((FolderPath contains "C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview" or FolderPath contains "\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview") and FolderPath endswith "\\pwsh.exe"))) and not((FolderPath startswith "C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_" and FolderPath endswith "\\GetHelp.exe")))
