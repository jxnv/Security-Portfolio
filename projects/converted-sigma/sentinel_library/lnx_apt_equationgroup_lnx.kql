// Title: Equation Group Indicators
// ID: 41e5c73d-9983-4b69-bd03-e13b67e9623c
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2017-04-09
// Tags: attack.execution, attack.g0020, attack.t1059.004
// Description: Detects suspicious shell commands used in various Equation Group scripts and tools
// Converted by: Sigma Universal SIEM/EDR CLI

SecurityEvent | where (* has "chown root*chmod 4777 " or * has "cp /bin/sh .;chown" or * has "chmod 4777 /tmp/.scsi/dev/bin/gsh" or * has "chown root:root /tmp/.scsi/dev/bin/" or * has "chown root:root x;" or * has "/bin/telnet locip locport < /dev/console | /bin/sh" or * has "/tmp/ratload" or * has "ewok -t " or * has "xspy -display " or * has "cat > /dev/tcp/127.0.0.1/80 <<END" or * has "rm -f /current/tmp/ftshell.latest" or * has "ghost_* -v " or * has " --wipe > /dev/null" or * has "ping -c 2 *; grep * /proc/net/arp >/tmp/gx" or * has "iptables * OUTPUT -p tcp -d 127.0.0.1 --tcp-flags RST RST -j DROP;" or * has "> /var/log/audit/audit.log; rm -f ." or * has "cp /var/log/audit/audit.log .tmp" or * has "sh >/dev/tcp/* <&1 2>&1" or * has "ncat -vv -l -p * <" or * has "nc -vv -l -p * <" or * has "< /dev/console | uudecode && uncompress" or * has "sendmail -osendmail;chmod +x sendmail" or * has "/usr/bin/wget -O /tmp/a http* && chmod 755 /tmp/cron" or * has "chmod 666 /var/run/utmp~" or * has "chmod 700 nscd crond" or * has "cp /etc/shadow /tmp/." or * has "</dev/console |uudecode > /dev/null 2>&1 && uncompress" or * has "chmod 700 jp&&netstat -an|grep" or * has "uudecode > /dev/null 2>&1 && uncompress -f * && chmod 755" or * has "chmod 700 crond" or * has "wget http*; chmod +x /tmp/sendmail" or * has "chmod 700 fp sendmail pt" or * has "chmod 755 /usr/vmsys/bin/pipe" or * has "chmod -R 755 /usr/vmsys" or * has "chmod 755 $opbin/*tunnel" or * has "chmod 700 sendmail" or * has "chmod 0700 sendmail" or * has "/usr/bin/wget http*sendmail;chmod +x sendmail;" or * has "&& telnet * 2>&1 </dev/console")
