// Title: Potentially Suspicious WDAC Policy File Creation
// ID: 1d2de8a6-4803-4fde-b85b-f58f3aa7a705
// Status: experimental
// Level: medium
// Author: X__Junior
// Date: 2025-02-07
// Tags: attack.defense-impairment
// Description: Detects suspicious Windows Defender Application Control (WDAC) policy file creation from abnormal processes that could be abused by attacker to block EDR/AV components while allowing their own malicious code to run on the system.
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where ((FileName contains "\\Windows\\System32\\CodeIntegrity\\") and not(((((ProcessCommandLine contains "ConvertFrom-CIPolicy -XmlFilePath" and ProcessCommandLine contains "-BinaryFilePath ")) or (ProcessCommandLine contains "CiTool --update-policy") or ((ProcessCommandLine contains "Copy-Item -Path" and ProcessCommandLine contains "-Destination"))) or ((FolderPath endswith "\\Microsoft.ConfigurationManagement.exe" or FolderPath endswith "\\WDAC Wizard.exe" or FolderPath endswith "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" or FolderPath endswith "C:\\Program Files\\PowerShell\\7\\pwsh.exe" or FolderPath endswith "C:\\Windows\\System32\\dllhost.exe" or FolderPath endswith "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or FolderPath endswith "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" or FolderPath endswith "C:\\Windows\\SysWOW64\\dllhost.exe" or FolderPath endswith "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or FolderPath endswith "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")) or (FolderPath == "System") or (FolderPath == "C:\\Windows\\System32\\wuauclt.exe") or ((FolderPath == "C:\\Windows\\UUS\\arm64\\wuaucltcore.exe" or FolderPath == "C:\\Windows\\UUS\\Packages\\Preview\\arm64\\wuaucltcore.exe")))))
