// Title: Suspicious Network Connection to IP Lookup Service APIs
// ID: edf3485d-dac4-4d50-90e4-b0e5813f7e60
// Status: test
// Level: medium
// Author: Janantha Marasinghe, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-04-24
// Tags: attack.discovery, attack.t1016
// Description: Detects external IP address lookups by non-browser processes via services such as "api.ipify.org". This could be indicative of potential post compromise internet test activity.
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where ((((DestinationHostname == "www.ip.cn" or DestinationHostname == "l2.io")) or ((DestinationHostname contains "api.2ip.ua" or DestinationHostname contains "api.bigdatacloud.net" or DestinationHostname contains "api.ipify.org" or DestinationHostname contains "bot.whatismyipaddress.com" or DestinationHostname contains "canireachthe.net" or DestinationHostname contains "checkip.amazonaws.com" or DestinationHostname contains "checkip.dyndns.org" or DestinationHostname contains "curlmyip.com" or DestinationHostname contains "db-ip.com" or DestinationHostname contains "edns.ip-api.com" or DestinationHostname contains "eth0.me" or DestinationHostname contains "freegeoip.app" or DestinationHostname contains "geoipy.com" or DestinationHostname contains "getip.pro" or DestinationHostname contains "icanhazip.com" or DestinationHostname contains "ident.me" or DestinationHostname contains "ifconfig.io" or DestinationHostname contains "ifconfig.me" or DestinationHostname contains "ip-api.com" or DestinationHostname contains "ip.360.cn" or DestinationHostname contains "ip.anysrc.net" or DestinationHostname contains "ip.taobao.com" or DestinationHostname contains "ip.tyk.nu" or DestinationHostname contains "ipaddressworld.com" or DestinationHostname contains "ipapi.co" or DestinationHostname contains "ipconfig.io" or DestinationHostname contains "ipecho.net" or DestinationHostname contains "ipinfo.io" or DestinationHostname contains "ipip.net" or DestinationHostname contains "ipof.in" or DestinationHostname contains "ipv4.icanhazip.com" or DestinationHostname contains "ipv4bot.whatismyipaddress.com" or DestinationHostname contains "ipv6-test.com" or DestinationHostname contains "ipwho.is" or DestinationHostname contains "jsonip.com" or DestinationHostname contains "myexternalip.com" or DestinationHostname contains "seeip.org" or DestinationHostname contains "wgetip.com" or DestinationHostname contains "whatismyip.akamai.com" or DestinationHostname contains "whois.pconline.com.cn" or DestinationHostname contains "wtfismyip.com"))) and not(((FolderPath endswith "\\brave.exe") or ((FolderPath == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or FolderPath == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or ((FolderPath startswith "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") or (FolderPath endswith "\\WindowsApps\\MicrosoftEdge.exe") or ((FolderPath == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or FolderPath == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((FolderPath startswith "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" or FolderPath startswith "C:\\Program Files\\Microsoft\\EdgeCore\\") and (FolderPath endswith "\\msedge.exe" or FolderPath endswith "\\msedgewebview2.exe")) or ((FolderPath == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or FolderPath == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or ((FolderPath == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or FolderPath == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (FolderPath endswith "\\maxthon.exe") or (FolderPath endswith "\\opera.exe") or (FolderPath endswith "\\safari.exe") or (FolderPath endswith "\\seamonkey.exe") or (FolderPath endswith "\\vivaldi.exe") or (FolderPath endswith "\\whale.exe"))))
