// Title: Potentially Suspicious GrantedAccess Flags On LSASS
// ID: a18dd26b-6450-46de-8c91-9659150cf088
// Status: test
// Level: medium
// Author: Florian Roth, Roberto Rodriguez, Dimitrios Slamaris, Mark Russinovich, Thomas Patzke, Teymur Kheirkhabarov, Sherif Eldeeb, James Dickenson, Aleksey Potapov, oscd.community
// Date: 2021-11-22
// Tags: attack.credential-access, attack.t1003.001, attack.s0002
// Description: Detects process access requests to LSASS process with potentially suspicious access flags
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where (((((GrantedAccess endswith "30" or GrantedAccess endswith "50" or GrantedAccess endswith "70" or GrantedAccess endswith "90" or GrantedAccess endswith "B0" or GrantedAccess endswith "D0" or GrantedAccess endswith "F0" or GrantedAccess endswith "18" or GrantedAccess endswith "38" or GrantedAccess endswith "58" or GrantedAccess endswith "78" or GrantedAccess endswith "98" or GrantedAccess endswith "B8" or GrantedAccess endswith "D8" or GrantedAccess endswith "F8" or GrantedAccess endswith "1A" or GrantedAccess endswith "3A" or GrantedAccess endswith "5A" or GrantedAccess endswith "7A" or GrantedAccess endswith "9A" or GrantedAccess endswith "BA" or GrantedAccess endswith "DA" or GrantedAccess endswith "FA" or GrantedAccess endswith "0x14C2")) or ((GrantedAccess startswith "0x100000" or GrantedAccess startswith "0x1418" or GrantedAccess startswith "0x1438" or GrantedAccess startswith "0x143a" or GrantedAccess startswith "0x1f0fff" or GrantedAccess startswith "0x1f1fff" or GrantedAccess startswith "0x1f2fff" or GrantedAccess startswith "0x1f3fff" or GrantedAccess startswith "0x40"))) and (TargetImage endswith "\\lsass.exe")) and not(((SourceImage endswith "\\explorer.exe" and GrantedAccess == "0x401") or ((SourceImage contains ":\\Program Files (x86)\\" or SourceImage contains ":\\Program Files\\" or SourceImage contains ":\\Windows\\System32\\" or SourceImage contains ":\\Windows\\SysWOW64\\")) or (SourceImage contains ":\\ProgramData\\Microsoft\\Windows Defender\\" and SourceImage endswith "\\MsMpEng.exe") or ((CallTrace contains "|?:\\ProgramData\\Microsoft\\Windows Defender\\Definition Updates\\{" and CallTrace contains "}\\mpengine.dll+") and GrantedAccess == "0x1418") or ((CallTrace contains "|c:\\program files\\windows defender\\mprtp.dll" or CallTrace contains "|c:\\program files\\windows defender\\MpClient.dll")))) and not(((SourceImage endswith ":\\ProgramData\\MALWAREBYTES\\MBAMSERVICE\\ctlrupdate\\mbupdatr.exe") or (SourceImage endswith "\\MBAMInstallerService.exe" and GrantedAccess == "0x40") or ((SourceImage endswith "\\aurora-agent-64.exe" or SourceImage endswith "\\aurora-agent.exe" or SourceImage endswith "\\thor.exe" or SourceImage endswith "\\thor64.exe") and GrantedAccess == "0x40") or (SourceImage contains "\\SteamLibrary\\steamapps\\") or ((SourceImage endswith "\\handle.exe" or SourceImage endswith "\\handle64.exe" or SourceImage endswith "\\handle64a.exe") and GrantedAccess == "0x40") or ((SourceImage endswith "\\PROCEXP64.EXE" or SourceImage endswith "\\PROCEXP.EXE") and GrantedAccess == "0x40") or (SourceImage contains ":\\ProgramData\\VMware\\VMware Tools\\" and SourceImage endswith "\\vmtoolsd.exe") or (SourceImage endswith "\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe") or (SourceImage endswith "\\AppData\\Local\\WebEx\\WebexHost.exe" and GrantedAccess == "0x401"))))
