// Title: File With Uncommon Extension Created By An Office Application
// ID: c7a74c80-ba5a-486e-9974-ab9e682bc5e4
// Status: test
// Level: high
// Author: Vadim Khrykov (ThreatIntel), Cyb3rEng (Rule), Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-08-23
// Tags: attack.t1204.002, attack.execution
// Description: Detects the creation of files with an executable or script extension by an Office application.
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where ((((FolderPath endswith "\\excel.exe" or FolderPath endswith "\\msaccess.exe" or FolderPath endswith "\\mspub.exe" or FolderPath endswith "\\powerpnt.exe" or FolderPath endswith "\\visio.exe" or FolderPath endswith "\\winword.exe")) and ((FileName endswith ".bat" or FileName endswith ".cmd" or FileName endswith ".com" or FileName endswith ".dll" or FileName endswith ".exe" or FileName endswith ".hta" or FileName endswith ".ocx" or FileName endswith ".proj" or FileName endswith ".ps1" or FileName endswith ".scf" or FileName endswith ".scr" or FileName endswith ".sys" or FileName endswith ".vbe" or FileName endswith ".vbs" or FileName endswith ".wsf" or FileName endswith ".wsh"))) and not((FileName contains "\\AppData\\Local\\assembly\\tmp\\" and FileName endswith ".dll")) and not((((FileName contains "C:\\Users\\" and FileName contains "\\AppData\\Local\\Microsoft\\Office\\" and FileName contains "\\BackstageInAppNavCache\\") and FileName endswith ".com") or (FolderPath endswith "\\winword.exe" and FileName contains "\\AppData\\Local\\Temp\\webexdelta\\" and (FileName endswith ".dll" or FileName endswith ".exe")) or ((FileName contains "C:\\Users\\" and FileName contains "\\AppData\\Local\\Microsoft\\Office\\" and FileName contains "\\WebServiceCache\\AllUsers") and FileName endswith ".com"))))
