// Title: Relevant Anti-Virus Signature Keywords In Application Log
// ID: 78bc5783-81d9-4d73-ac97-59f6db4f72a8
// Status: test
// Level: high
// Author: Florian Roth (Nextron Systems), Arnim Rupp
// Date: 2017-02-19
// Tags: attack.resource-development, attack.t1588
// Description: Detects potentially highly relevant antivirus events in the application log based on known virus signature names and malware keywords.
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where ((* has "Adfind" or * has "ASP/BackDoor " or * has "ATK/" or * has "Backdoor.ASP" or * has "Backdoor.Cobalt" or * has "Backdoor.JSP" or * has "Backdoor.PHP" or * has "Blackworm" or * has "Brutel" or * has "BruteR" or * has "Chopper" or * has "Cobalt" or * has "COBEACON" or * has "Cometer" or * has "CRYPTES" or * has "Cryptor" or * has "Destructor" or * has "DumpCreds" or * has "Exploit.Script.CVE" or * has "FastReverseProxy" or * has "Filecoder" or * has "GrandCrab " or * has "HackTool" or * has "HKTL" or * has "HTool-" or * has "/HTool" or * has ".HTool" or * has "IISExchgSpawnCMD" or * has "Impacket" or * has "JSP/BackDoor " or * has "Keylogger" or * has "Koadic" or * has "Krypt" or * has "Lazagne" or * has "Metasploit" or * has "Meterpreter" or * has "MeteTool" or * has "mikatz" or * has "Mimikatz" or * has "Mpreter" or * has "MsfShell" or * has "Nighthawk" or * has "Packed.Generic.347" or * has "PentestPowerShell" or * has "Phobos" or * has "PHP/BackDoor " or * has "Potato" or * has "PowerSploit" or * has "PowerSSH" or * has "PshlSpy" or * has "PSWTool" or * has "PWCrack" or * has "PWDump" or * has "Ransom" or * has "Rozena" or * has "Ryzerlo" or * has "Sbelt" or * has "Seatbelt" or * has "SecurityTool " or * has "SharpDump" or * has "Shellcode" or * has "Sliver" or * has "Splinter" or * has "Swrort" or * has "Tescrypt" or * has "TeslaCrypt" or * has "TurtleLoader" or * has "Valyria" or * has "Webshell") and not(((* has "anti_ransomware_service.exe" or * has "Anti-Ransomware" or * has "Crack" or * has "cyber-protect-service.exe" or * has "encryptor" or * has "Keygen") or (Level == 4) or (Provider_Name == "Microsoft-Windows-RestartManager"))))
