// Title: PowerShell Core DLL Loaded By Non PowerShell Process
// ID: 092bc4b9-3d1d-43b4-a6b4-8c8acd83522f
// Status: test
// Level: medium
// Author: Tom Kern, oscd.community, Natalia Shornikova, Tim Shelton, Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2019-11-14
// Tags: attack.t1059.001, attack.execution
// Description: Detects loading of essential DLLs used by PowerShell by non-PowerShell process.
// Detects behavior similar to meterpreter's "load powershell" extension.
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where (((Description == "System.Management.Automation") or (ProcessVersionInfoOriginalFileName == "System.Management.Automation.dll") or ((ImageLoaded endswith "\\System.Management.Automation.dll" or ImageLoaded endswith "\\System.Management.Automation.ni.dll"))) and not((((FolderPath startswith "C:\\Windows\\Microsoft.NET\\Framework\\" or FolderPath startswith "C:\\Windows\\Microsoft.NET\\FrameworkArm\\" or FolderPath startswith "C:\\Windows\\Microsoft.NET\\FrameworkArm64\\" or FolderPath startswith "C:\\Windows\\Microsoft.NET\\Framework64\\") and FolderPath endswith "\\mscorsvw.exe") or ((FolderPath == "C:\\Windows\\System32\\dsac.exe" or FolderPath == "C:\\WINDOWS\\System32\\RemoteFXvGPUDisablement.exe" or FolderPath == "C:\\Windows\\System32\\runscripthelper.exe" or FolderPath == "C:\\WINDOWS\\System32\\sdiagnhost.exe" or FolderPath == "C:\\Windows\\System32\\ServerManager.exe" or FolderPath == "C:\\Windows\\System32\\SyncAppvPublishingServer.exe" or FolderPath == "C:\\Windows\\System32\\winrshost.exe" or FolderPath == "C:\\Windows\\System32\\wsmprovhost.exe" or FolderPath == "C:\\Windows\\SysWOW64\\winrshost.exe" or FolderPath == "C:\\Windows\\SysWOW64\\wsmprovhost.exe")) or ((FolderPath == "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe" or FolderPath == "C:\\Program Files\\PowerShell\\7\\pwsh.exe" or FolderPath == "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or FolderPath == "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" or FolderPath == "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or FolderPath == "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe")) or ((FolderPath contains "C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview" or FolderPath contains "\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShellPreview") and FolderPath endswith "\\pwsh.exe"))) and not((((isempty(FolderPath) or isnull(FolderPath))) or (FolderPath startswith "C:\\ProgramData\\chocolatey\\choco.exe") or (FolderPath endswith "\\Citrix\\ConfigSync\\ConfigSyncRun.exe") or (FolderPath startswith "C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_" and FolderPath endswith "\\GetHelp.exe") or (FolderPath startswith "C:\\Windows\\Temp\\asgard2-agent\\" and (FolderPath endswith "\\thor64.exe" or FolderPath endswith "\\thor.exe")) or ((FolderPath startswith "C:\\Program Files (x86)\\Microsoft SQL Server Management Studio" or FolderPath startswith "C:\\Program Files\\Microsoft SQL Server Management Studio") and FolderPath endswith "\\IDE\\Ssms.exe") or ((FolderPath startswith "C:\\Program Files (x86)\\Microsoft SQL Server\\" or FolderPath startswith "C:\\Program Files\\Microsoft SQL Server\\") and FolderPath endswith "\\Tools\\Binn\\SQLPS.exe") or ((FolderPath startswith "C:\\Program Files (x86)\\Microsoft Visual Studio\\" or FolderPath startswith "C:\\Program Files\\Microsoft Visual Studio\\")))))
