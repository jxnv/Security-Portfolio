// Title: Removal of Potential COM Hijacking Registry Keys
// ID: 96f697b0-b499-4e5d-9908-a67bec11cdb6
// Status: test
// Level: medium
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2020-05-02
// Tags: attack.persistence, attack.defense-impairment, attack.t1112
// Description: Detects any deletion of entries in ".*\shell\open\command" registry keys.
// These registry keys might have been used for COM hijacking activities by a threat actor or an attacker and the deletion could indicate steps to remove its tracks.
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where ((RegistryKey endswith "\\shell\\open\\command") and not(((FolderPath endswith "C:\\Windows\\explorer.exe") or ((FolderPath startswith "C:\\Program Files\\" or FolderPath startswith "C:\\Program Files (x86)\\")) or ((FolderPath == "C:\\Windows\\System32\\msiexec.exe" or FolderPath == "C:\\Windows\\SysWOW64\\msiexec.exe")) or (FolderPath == "C:\\Windows\\System32\\OpenWith.exe") or (FolderPath == "C:\\Windows\\system32\\svchost.exe"))) and not((((FolderPath == "C:\\Program Files (x86)\\Avira\\Antivirus\\" or FolderPath == "C:\\Program Files\\Avira\\Antivirus\\") and (RegistryKey endswith "\\CLSID\\{305CA226-D286-468e-B848-2B2E8E697B74}\\Shell\\Open\\Command" or RegistryKey endswith "\\AntiVir.Keyfile\\shell\\open\\command")) or (FolderPath endswith "\\reg.exe" and RegistryKey endswith "\\Discord\\shell\\open\\command") or (FolderPath endswith "\\Dropbox.exe" and RegistryKey contains "\\Dropbox.") or (FolderPath endswith "C:\\eclipse\\eclipse.exe" and RegistryKey contains "_Classes\\eclipse+") or (FolderPath contains "\\Microsoft\\EdgeUpdate\\Install") or (FolderPath endswith "\\Everything.exe" and RegistryKey contains "\\Everything.") or (((FolderPath contains "AppData\\Local\\Temp" and FolderPath contains "\\setup.exe")) or ((FolderPath contains "\\Temp\\is-" and FolderPath contains "\\target.tmp"))) or (FolderPath startswith "C:\\Program Files (x86)\\Java\\" and FolderPath endswith "\\installer.exe" and RegistryKey contains "\\Classes\\WOW6432Node\\CLSID\\{4299124F-F2C3-41b4-9C73-9236B2AD0E8F}") or (FolderPath endswith "\\ninite.exe") or (FolderPath contains "peazip" and RegistryKey contains "\\PeaZip.") or (FolderPath endswith "\\Spotify.exe" and RegistryKey endswith "\\Spotify\\shell\\open\\command") or ((FolderPath contains "\\Temp" and FolderPath contains "\\TeamViewer")) or (FolderPath startswith "C:\\Windows\\Installer\\MSI") or (FolderPath endswith "\\AppData\\Local\\Temp\\Wireshark_uninstaller.exe" and RegistryKey contains "\\wireshark-capture-file\\"))))
