// Title: Suspicious WSMAN Provider Image Loads
// ID: ad1f4bb9-8dfb-4765-adb6-2a7cfb6c0f94
// Status: test
// Level: medium
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2020-06-24
// Tags: attack.execution, attack.t1059.001, attack.lateral-movement, attack.t1021.003
// Description: Detects signs of potential use of the WSMAN provider from uncommon processes locally and remote execution.
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where (((((ImageLoaded endswith "\\WsmSvc.dll" or ImageLoaded endswith "\\WsmAuto.dll" or ImageLoaded endswith "\\Microsoft.WSMan.Management.ni.dll")) or ((ProcessVersionInfoOriginalFileName == "WsmSvc.dll" or ProcessVersionInfoOriginalFileName == "WSMANAUTOMATION.DLL" or ProcessVersionInfoOriginalFileName == "Microsoft.WSMan.Management.dll"))) or (FolderPath endswith "\\svchost.exe" and ProcessVersionInfoOriginalFileName == "WsmWmiPl.dll")) and not(((FolderPath startswith "C:\\Program Files\\Citrix\\") or ((FolderPath == "C:\\Program Files (x86)\\PowerShell\\6\\pwsh.exe" or FolderPath == "C:\\Program Files (x86)\\PowerShell\\7\\pwsh.exe" or FolderPath == "C:\\Program Files\\PowerShell\\6\\pwsh.exe" or FolderPath == "C:\\Program Files\\PowerShell\\7\\pwsh.exe" or FolderPath == "C:\\Windows\\System32\\sdiagnhost.exe" or FolderPath == "C:\\Windows\\System32\\services.exe" or FolderPath == "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell_ise.exe" or FolderPath == "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe")) or (FolderPath startswith "C:\\Program Files\\WindowsApps\\Microsoft.GetHelp_" and FolderPath endswith "\\GetHelp.exe") or (FolderPath endswith "\\mmc.exe") or ((FolderPath startswith "C:\\Windows\\Microsoft.NET\\Framework64\\v" or FolderPath startswith "C:\\Windows\\Microsoft.NET\\Framework\\v" or FolderPath startswith "C:\\Windows\\Microsoft.NET\\FrameworkArm\\v" or FolderPath startswith "C:\\Windows\\Microsoft.NET\\FrameworkArm64\\v") and FolderPath endswith "\\mscorsvw.exe") or (FolderPath startswith "C:\\Windows\\Temp\\asgard2-agent\\") or ((ProcessCommandLine contains "svchost.exe -k netsvcs -p -s BITS" or ProcessCommandLine contains "svchost.exe -k GraphicsPerfSvcGroup -s GraphicsPerfSvc" or ProcessCommandLine contains "svchost.exe -k NetworkService -p -s Wecsvc" or ProcessCommandLine contains "svchost.exe -k netsvcs")) or ((FolderPath == "C:\\Windows\\System32\\Configure-SMRemoting.exe" or FolderPath == "C:\\Windows\\System32\\ServerManager.exe")) or (FolderPath startswith "C:\\$WINDOWS.~BT\\Sources\\"))) and not(((FolderPath endswith "\\svchost.exe") and ((isempty(ProcessCommandLine) or isnull(ProcessCommandLine))))))
