// Title: Office Macro File Download
// ID: 0e29e3a7-1ad8-40aa-b691-9f82ecd33d66
// Status: test
// Level: low
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-01-23
// Tags: attack.initial-access, attack.t1566.001
// Description: Detects the creation of a new office macro files on the system via an application (browser, mail client).
// This can help identify potential malicious activity, such as the download of macro-enabled documents that could be used for exploitation.
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where ((((FileName endswith ".docm" or FileName endswith ".dotm" or FileName endswith ".xlsm" or FileName endswith ".xltm" or FileName endswith ".potm" or FileName endswith ".pptm")) or ((FileName contains ".docm:Zone" or FileName contains ".dotm:Zone" or FileName contains ".xlsm:Zone" or FileName contains ".xltm:Zone" or FileName contains ".potm:Zone" or FileName contains ".pptm:Zone"))) and ((FolderPath endswith "\\RuntimeBroker.exe" or FolderPath endswith "\\outlook.exe" or FolderPath endswith "\\thunderbird.exe" or FolderPath endswith "\\brave.exe" or FolderPath endswith "\\chrome.exe" or FolderPath endswith "\\firefox.exe" or FolderPath endswith "\\iexplore.exe" or FolderPath endswith "\\maxthon.exe" or FolderPath endswith "\\MicrosoftEdge.exe" or FolderPath endswith "\\msedge.exe" or FolderPath endswith "\\msedgewebview2.exe" or FolderPath endswith "\\opera.exe" or FolderPath endswith "\\safari.exe" or FolderPath endswith "\\seamonkey.exe" or FolderPath endswith "\\vivaldi.exe" or FolderPath endswith "\\whale.exe")))
