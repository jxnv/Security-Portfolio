// Title: Renamed Office Binary Execution
// ID: 0b0cd537-fc77-4e6e-a973-e53495c1083d
// Status: test
// Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-12-20
// Tags: attack.stealth, attack.t1036.003
// Description: Detects the execution of a renamed office binary
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where ((((ProcessVersionInfoOriginalFileName == "Excel.exe" or ProcessVersionInfoOriginalFileName == "MSACCESS.EXE" or ProcessVersionInfoOriginalFileName == "MSPUB.EXE" or ProcessVersionInfoOriginalFileName == "OneNote.exe" or ProcessVersionInfoOriginalFileName == "OneNoteM.exe" or ProcessVersionInfoOriginalFileName == "OUTLOOK.EXE" or ProcessVersionInfoOriginalFileName == "POWERPNT.EXE" or ProcessVersionInfoOriginalFileName == "WinWord.exe" or ProcessVersionInfoOriginalFileName == "Olk.exe")) or ((Description == "Microsoft Access" or Description == "Microsoft Excel" or Description == "Microsoft OneNote" or Description == "Microsoft Outlook" or Description == "Microsoft PowerPoint" or Description == "Microsoft Publisher" or Description == "Microsoft Word" or Description == "Sent to OneNote Tool"))) and not(((FolderPath endswith "\\EXCEL.exe" or FolderPath endswith "\\excelcnv.exe" or FolderPath endswith "\\MSACCESS.exe" or FolderPath endswith "\\MSPUB.EXE" or FolderPath endswith "\\ONENOTE.EXE" or FolderPath endswith "\\ONENOTEM.EXE" or FolderPath endswith "\\OUTLOOK.EXE" or FolderPath endswith "\\POWERPNT.EXE" or FolderPath endswith "\\WINWORD.exe" or FolderPath endswith "\\OLK.EXE"))))
