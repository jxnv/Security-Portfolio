// Title: DNS Query To AzureWebsites.NET By Non-Browser Process
// ID: e043f529-8514-4205-8ab0-7f7d2927b400
// Status: test
// Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-06-24
// Tags: attack.command-and-control, attack.t1219.002
// Description: Detects a DNS query by a non browser process on the system to "azurewebsites.net". The latter was often used by threat actors as a malware hosting and exfiltration site.
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where ((QueryName endswith "azurewebsites.net") and not((((FolderPath startswith "C:\\Program Files (x86)\\Avant Browser\\" or FolderPath startswith "C:\\Program Files\\Avant Browser\\") and FolderPath endswith "\\avant.exe") or (FolderPath endswith "\\brave.exe" and FolderPath startswith "C:\\Program Files\\BraveSoftware\\") or ((FolderPath == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or FolderPath == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or ((FolderPath endswith "\\MsMpEng.exe" or FolderPath endswith "\\MsSense.exe")) or ((FolderPath startswith "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") or (FolderPath endswith "\\WindowsApps\\MicrosoftEdge.exe") or ((FolderPath == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or FolderPath == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((FolderPath startswith "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" or FolderPath startswith "C:\\Program Files\\Microsoft\\EdgeCore\\") and (FolderPath endswith "\\msedge.exe" or FolderPath endswith "\\msedgewebview2.exe")) or ((FolderPath startswith "C:\\Program Files\\Falkon\\" or FolderPath startswith "C:\\Program Files (x86)\\Falkon\\") and FolderPath endswith "\\falkon.exe") or ((FolderPath == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or FolderPath == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or (FolderPath contains "\\AppData\\Local\\Flock\\" and FolderPath endswith "\\Flock.exe") or ((FolderPath == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or FolderPath == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (FolderPath contains "\\AppData\\Local\\Maxthon\\" and FolderPath endswith "\\maxthon.exe") or (FolderPath contains "\\AppData\\Local\\Programs\\midori-ng\\" and FolderPath endswith "\\Midori Next Generation.exe") or (FolderPath contains "\\AppData\\Local\\Programs\\Opera\\" and FolderPath endswith "\\opera.exe") or (FolderPath contains "\\AppData\\Local\\Phoebe\\" and FolderPath endswith "\\Phoebe.exe") or (FolderPath endswith "\\safari.exe") or ((FolderPath startswith "C:\\Program Files\\SeaMonkey\\" or FolderPath startswith "C:\\Program Files (x86)\\SeaMonkey\\") and FolderPath endswith "\\seamonkey.exe") or ((FolderPath startswith "C:\\Program Files\\SlimBrowser\\" or FolderPath startswith "C:\\Program Files (x86)\\SlimBrowser\\") and FolderPath endswith "\\slimbrowser.exe") or (FolderPath contains "\\Tor Browser\\") or (FolderPath contains "\\AppData\\Local\\Vivaldi\\" and FolderPath endswith "\\vivaldi.exe") or ((FolderPath startswith "C:\\Program Files\\Naver\\Naver Whale\\" or FolderPath startswith "C:\\Program Files (x86)\\Naver\\Naver Whale\\") and FolderPath endswith "\\whale.exe") or ((FolderPath startswith "C:\\Program Files\\Waterfox\\" or FolderPath startswith "C:\\Program Files (x86)\\Waterfox\\") and FolderPath endswith "\\Waterfox.exe"))))
