// Title: Potentially Suspicious Network Connection To Notion API
// ID: 7e9cf7b6-e827-11ed-a05b-15959c120003
// Status: test
// Level: low
// Author: Gavin Knapp
// Date: 2023-05-03
// Tags: attack.command-and-control, attack.t1102
// Description: Detects a non-browser process communicating with the Notion API. This could indicate potential use of a covert C2 channel such as "OffensiveNotion C2"
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where ((DestinationHostname contains "api.notion.com") and not(((FolderPath endswith "\\brave.exe") or ((FolderPath == "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" or FolderPath == "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or ((FolderPath startswith "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") or (FolderPath endswith "\\WindowsApps\\MicrosoftEdge.exe") or ((FolderPath == "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" or FolderPath == "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((FolderPath startswith "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\" or FolderPath startswith "C:\\Program Files\\Microsoft\\EdgeCore\\") and (FolderPath endswith "\\msedge.exe" or FolderPath endswith "\\msedgewebview2.exe")) or ((FolderPath == "C:\\Program Files\\Mozilla Firefox\\firefox.exe" or FolderPath == "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or ((FolderPath == "C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe" or FolderPath == "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or (FolderPath endswith "\\maxthon.exe") or (FolderPath endswith "\\AppData\\Local\\Programs\\Notion\\Notion.exe") or (FolderPath endswith "\\opera.exe") or (FolderPath endswith "\\safari.exe") or (FolderPath endswith "\\seamonkey.exe") or (FolderPath endswith "\\vivaldi.exe") or (FolderPath endswith "\\whale.exe"))))
