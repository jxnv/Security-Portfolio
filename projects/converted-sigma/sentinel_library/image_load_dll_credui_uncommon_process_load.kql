// Title: CredUI.DLL Loaded By Uncommon Process
// ID: 9ae01559-cf7e-4f8e-8e14-4c290a1b4784
// Status: test
// Level: medium
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research)
// Date: 2020-10-20
// Tags: attack.credential-access, attack.collection, attack.t1056.002
// Description: Detects loading of "credui.dll" and related DLLs by an uncommon process. Attackers might leverage this DLL for potential use of "CredUIPromptForCredentials" or "CredUnPackAuthenticationBufferW".
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where ((((ImageLoaded endswith "\\credui.dll" or ImageLoaded endswith "\\wincredui.dll")) or ((ProcessVersionInfoOriginalFileName == "credui.dll" or ProcessVersionInfoOriginalFileName == "wincredui.dll"))) and not((((FolderPath == "C:\\Windows\\explorer.exe" or FolderPath == "C:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe" or FolderPath == "C:\\Windows\\regedit.exe")) or ((FolderPath startswith "C:\\Program Files (x86)\\" or FolderPath startswith "C:\\Program Files\\" or FolderPath startswith "C:\\Windows\\System32\\" or FolderPath startswith "C:\\Windows\\SysWOW64\\" or FolderPath startswith "C:\\Windows\\SystemApps\\")))) and not(((FolderPath startswith "C:\\Users\\" and FolderPath contains "\\AppData\\Local\\Microsoft\\OneDrive\\") or (FolderPath endswith "\\opera_autoupdate.exe") or ((FolderPath endswith "\\procexp64.exe" or FolderPath endswith "\\procexp64a.exe" or FolderPath endswith "\\procexp.exe")) or (FolderPath startswith "C:\\Users\\" and FolderPath contains "\\AppData\\Local\\Microsoft\\Teams\\" and FolderPath endswith "\\Teams.exe"))))
