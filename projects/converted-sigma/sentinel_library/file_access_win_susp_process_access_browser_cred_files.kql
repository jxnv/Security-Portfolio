// Title: Suspicious File Access to Browser Credential Storage
// ID: a1dfd976-4852-41d4-9507-dc6590a3ccd0
// Status: experimental
// Level: low
// Author: frack113, X__Junior (Nextron Systems), Swachchhanda Shrawan Poudel (Nextron Systems), Parth-FourCore
// Date: 2025-05-22
// Tags: attack.credential-access, attack.t1555.003, attack.discovery, attack.t1217
// Description: Detects file access to browser credential storage paths by non-browser processes, which may indicate credential access attempts.
// Adversaries may attempt to access browser credential storage to extract sensitive information such as usernames and passwords or cookies.
// This behavior is often commonly observed in credential stealing malware.
// Converted by: Sigma Universal SIEM/EDR CLI

DeviceProcessEvents | where ((((FileName contains "\\Sputnik\\Sputnik" or FileName contains "\\MapleStudio\\ChromePlus" or FileName contains "\\QIP Surf" or FileName contains "\\BlackHawk" or FileName contains "\\7Star\\7Star" or FileName contains "\\CatalinaGroup\\Citrio" or FileName contains "\\Google\\Chrome" or FileName contains "\\Coowon\\Coowon" or FileName contains "\\CocCoc\\Browser" or FileName contains "\\uCozMedia\\Uran" or FileName contains "\\Tencent\\QQBrowser" or FileName contains "\\Orbitum" or FileName contains "\\Slimjet" or FileName contains "\\Iridium" or FileName contains "\\Vivaldi" or FileName contains "\\Chromium" or FileName contains "\\GhostBrowser" or FileName contains "\\CentBrowser" or FileName contains "\\Xvast" or FileName contains "\\Chedot" or FileName contains "\\SuperBird" or FileName contains "\\360Browser\\Browser" or FileName contains "\\360Chrome\\Chrome" or FileName contains "\\Comodo\\Dragon" or FileName contains "\\BraveSoftware\\Brave-Browser" or FileName contains "\\Torch" or FileName contains "\\UCBrowser\\" or FileName contains "\\Blisk" or FileName contains "\\Epic Privacy Browser" or FileName contains "\\Nichrome" or FileName contains "\\Amigo" or FileName contains "\\Kometa" or FileName contains "\\Xpom" or FileName contains "\\Microsoft\\Edge" or FileName contains "\\Liebao7Default\\EncryptedStorage" or FileName contains "\\AVAST Software\\Browser" or FileName contains "\\Kinza" or FileName contains "\\Mozilla\\SeaMonkey\\" or FileName contains "\\Comodo\\IceDragon\\" or FileName contains "\\8pecxstudios\\Cyberfox\\" or FileName contains "\\FlashPeak\\SlimBrowser\\" or FileName contains "\\Moonchild Productions\\Pale Moon\\")) and ((FileName contains "\\Profiles\\" or FileName contains "\\User Data")) and (((FileName contains "\\Login Data" or FileName contains "\\Cookies" or FileName contains "\\EncryptedStorage" or FileName contains "\\WebCache\\")) or ((FileName endswith "cert9.db" or FileName endswith "cookies.sqlite" or FileName endswith "formhistory.sqlite" or FileName endswith "key3.db" or FileName endswith "key4.db" or FileName endswith "Login Data.sqlite" or FileName endswith "logins.json" or FileName endswith "places.sqlite")))) and not((((FolderPath startswith "C:\\Program Files\\" or FolderPath startswith "C:\\Program Files (x86)\\" or FolderPath startswith "C:\\Windows\\System32\\" or FolderPath startswith "C:\\Windows\\SysWOW64\\")) or ((FolderPath endswith "\\Sputnik.exe" or FolderPath endswith "\\ChromePlus.exe" or FolderPath endswith "\\QIP Surf.exe" or FolderPath endswith "\\BlackHawk.exe" or FolderPath endswith "\\7Star.exe" or FolderPath endswith "\\Sleipnir5.exe" or FolderPath endswith "\\Citrio.exe" or FolderPath endswith "\\Chrome SxS.exe" or FolderPath endswith "\\Chrome.exe" or FolderPath endswith "\\Coowon.exe" or FolderPath endswith "\\CocCocBrowser.exe" or FolderPath endswith "\\Uran.exe" or FolderPath endswith "\\QQBrowser.exe" or FolderPath endswith "\\Orbitum.exe" or FolderPath endswith "\\Slimjet.exe" or FolderPath endswith "\\Iridium.exe" or FolderPath endswith "\\Vivaldi.exe" or FolderPath endswith "\\Chromium.exe" or FolderPath endswith "\\GhostBrowser.exe" or FolderPath endswith "\\CentBrowser.exe" or FolderPath endswith "\\Xvast.exe" or FolderPath endswith "\\Chedot.exe" or FolderPath endswith "\\SuperBird.exe" or FolderPath endswith "\\360Browser.exe" or FolderPath endswith "\\360Chrome.exe" or FolderPath endswith "\\dragon.exe" or FolderPath endswith "\\brave.exe" or FolderPath endswith "\\torch.exe" or FolderPath endswith "\\UCBrowser.exe" or FolderPath endswith "\\BliskBrowser.exe" or FolderPath endswith "\\Epic Privacy Browser.exe" or FolderPath endswith "\\nichrome.exe" or FolderPath endswith "\\AmigoBrowser.exe" or FolderPath endswith "\\KometaBrowser.exe" or FolderPath endswith "\\XpomBrowser.exe" or FolderPath endswith "\\msedge.exe" or FolderPath endswith "\\LiebaoBrowser.exe" or FolderPath endswith "\\AvastBrowser.exe" or FolderPath endswith "\\Kinza.exe" or FolderPath endswith "\\seamonkey.exe" or FolderPath endswith "\\icedragon.exe" or FolderPath endswith "\\cyberfox.exe" or FolderPath endswith "\\SlimBrowser.exe" or FolderPath endswith "\\palemoon.exe")) or ((FolderPath contains "\\Sputnik\\" or FolderPath contains "\\MapleStudio\\" or FolderPath contains "\\QIP Surf\\" or FolderPath contains "\\BlackHawk\\" or FolderPath contains "\\7Star\\" or FolderPath contains "\\Fenrir Inc\\" or FolderPath contains "\\CatalinaGroup\\" or FolderPath contains "\\Google\\" or FolderPath contains "\\Coowon\\" or FolderPath contains "\\CocCoc\\" or FolderPath contains "\\uCozMedia\\" or FolderPath contains "\\Tencent\\" or FolderPath contains "\\Orbitum\\" or FolderPath contains "\\Slimjet\\" or FolderPath contains "\\Iridium\\" or FolderPath contains "\\Vivaldi\\" or FolderPath contains "\\Chromium\\" or FolderPath contains "\\GhostBrowser\\" or FolderPath contains "\\CentBrowser\\" or FolderPath contains "\\Xvast\\" or FolderPath contains "\\Chedot\\" or FolderPath contains "\\SuperBird\\" or FolderPath contains "\\360Browser\\" or FolderPath contains "\\360Chrome\\" or FolderPath contains "\\Comodo\\" or FolderPath contains "\\BraveSoftware\\" or FolderPath contains "\\Torch\\" or FolderPath contains "\\UCBrowser\\" or FolderPath contains "\\Blisk\\" or FolderPath contains "\\Epic Privacy Browser\\" or FolderPath contains "\\Nichrome\\" or FolderPath contains "\\Amigo\\" or FolderPath contains "\\Kometa\\" or FolderPath contains "\\Xpom\\" or FolderPath contains "\\Microsoft\\" or FolderPath contains "\\Liebao7\\" or FolderPath contains "\\AVAST Software\\" or FolderPath contains "\\Kinza\\" or FolderPath contains "\\Mozilla\\" or FolderPath contains "\\8pecxstudios\\" or FolderPath contains "\\FlashPeak\\" or FolderPath contains "\\Moonchild Productions\\")) or (FolderPath == "System" and InitiatingProcessFolderPath == "Idle"))) and not(((FolderPath contains "\\Microsoft\\Windows Defender\\" and (FolderPath endswith "\\MpCopyAccelerator.exe" or FolderPath endswith "\\MsMpEng.exe")) or (InitiatingProcessFolderPath == "C:\\Windows\\System32\\msiexec.exe") or (FolderPath endswith "\\everything.exe") or ((FolderPath endswith "\\thor.exe" or FolderPath endswith "\\thor64.exe")))))
